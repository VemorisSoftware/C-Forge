// runtime/sys_windows_ext.cfv — funciones de sistema de Windows para los
// programas del lenguaje (tiempo, directorios, bibliotecas, hilos, red).

// Nanosegundos desde 1970 (GetSystemTimePreciseAsFileTime: 100 ns desde 1601).
funcion sys_reloj_ns() {
    sea ft = sys_casilla()
    __winapi("kernel32.dll", "GetSystemTimePreciseAsFileTime", ft)
    retornar (__cargar64(ft) - 116444736000000000) * 100
}

funcion sys_dormir_ms(n) {
    __winapi("kernel32.dll", "Sleep", n)
    retornar 0
}

funcion sys_nucleos() {
    sea info = mem_reservar(64)
    mem_llenar(info, 0, 64)
    __winapi("kernel32.dll", "GetSystemInfo", info)
    sea n = __y_bits(__cargar64(info + 32), 4294967295)       // dwNumberOfProcessors
    mem_liberar(info)
    si (n < 1) { n = 1 }
    retornar n
}

// Espera activa breve: Windows no tiene futex; WaitOnAddress llega con la
// fase de hilos nativos.
funcion sys_futex_esperar(direccion, valor, ms, op) {
    si (__y_bits(__cargar64(direccion), 4294967295) == __y_bits(valor, 4294967295)) { __winapi("kernel32.dll", "Sleep", 1) }
    retornar 0
}

funcion sys_futex_despertar(direccion) { retornar 0 }

// Hilo con CreateThread: el trampolín del compilador cambia a la pila
// [base, base + tam) y llama a dyn_hilo_inicio(t); al terminar pone en 0
// [base + 16] (esperar() lo observa).
funcion sys_hilo_crear(base, tam, t) {
    __guardar64(base + 24, t)
    __guardar64(base + 32, __dir("dyn_hilo_inicio"))
    sea h = __winapi("kernel32.dll", "CreateThread", 0, 65536, __trampolin_hilo(), base, 0, 0)
    si (h == 0) { retornar 0 - 1 }
    __winapi("kernel32.dll", "CloseHandle", h)
    retornar 0
}

funcion sys_dl_disponible() { retornar 1 }
funcion sys_cargar_biblioteca(nombre) { retornar __winapi("kernel32.dll", "LoadLibraryA", str_c(nombre)) }
funcion sys_simbolo(h, nombre) { retornar __winapi("kernel32.dll", "GetProcAddress", h, str_c(nombre)) }

// ── Red con Winsock (ws2_32.dll) ──────────────────────────────────────────

funcion sys_i32(x) {
    sea v = __y_bits(x, 4294967295)
    si (v >= 2147483648) { retornar v - 4294967296 }
    retornar v
}

funcion sys_winsock() {
    si (__cargar64(__globales() + 224) == 0) {
        sea datos = mem_reservar(512)
        __winapi("ws2_32.dll", "WSAStartup", 514, datos)      // versión 2.2
        mem_liberar(datos)
        __guardar64(__globales() + 224, 1)
    }
    retornar 0
}

funcion sys_red_escuchar(puerto, ip) {
    sys_winsock()
    sea fd = __winapi("ws2_32.dll", "socket", 2, 1, 6)        // AF_INET, SOCK_STREAM, TCP
    si (fd == 0 - 1 o fd == 0) { retornar 0 - 1 }
    sea dir = mem_reservar(16)
    mem_llenar(dir, 0, 16)
    __guardar8(dir, 2)
    __guardar8(dir + 2, __desplazar_der(puerto, 8))
    __guardar8(dir + 3, __y_bits(puerto, 255))
    __guardar8(dir + 4, __y_bits(__desplazar_der(ip, 24), 255))   // dirección IPv4 (0 = todas)
    __guardar8(dir + 5, __y_bits(__desplazar_der(ip, 16), 255))
    __guardar8(dir + 6, __y_bits(__desplazar_der(ip, 8), 255))
    __guardar8(dir + 7, __y_bits(ip, 255))
    sea r = sys_i32(__winapi("ws2_32.dll", "bind", fd, dir, 16))
    mem_liberar(dir)
    si (r != 0) { retornar 0 - 2 }
    si (sys_i32(__winapi("ws2_32.dll", "listen", fd, 64)) != 0) { retornar 0 - 3 }
    retornar fd
}

funcion sys_red_aceptar(fd, dir, largo_dir) {
    sea c = __winapi("ws2_32.dll", "accept", fd, dir, largo_dir)
    si (c == 0 - 1) { retornar 0 - 1 }
    retornar c
}

funcion sys_red_leer(fd, buf, n) { retornar sys_i32(__winapi("ws2_32.dll", "recv", fd, buf, n, 0)) }
funcion sys_red_escribir(fd, buf, n) { retornar sys_i32(__winapi("ws2_32.dll", "send", fd, buf, n, 0)) }
funcion sys_red_cerrar(fd) { __winapi("ws2_32.dll", "closesocket", fd) retornar 0 }

// Bytes aleatorios del sistema (BCryptGenRandom con el RNG preferido).
funcion sys_aleatorio(buf, n) {
    si (sys_i32(__winapi("bcrypt.dll", "BCryptGenRandom", 0, buf, n, 2)) != 0) { retornar 0 - 1 }
    retornar 0
}

// ── Cliente TCP y UDP (IPv4; ip = a·2^24 + b·2^16 + c·2^8 + d) ────────────

funcion sys_dir_ipv4(dir, ip, puerto) {
    mem_llenar(dir, 0, 16)
    __guardar8(dir, 2)
    __guardar8(dir + 2, __desplazar_der(puerto, 8))
    __guardar8(dir + 3, __y_bits(puerto, 255))
    __guardar8(dir + 4, __y_bits(__desplazar_der(ip, 24), 255))
    __guardar8(dir + 5, __y_bits(__desplazar_der(ip, 16), 255))
    __guardar8(dir + 6, __y_bits(__desplazar_der(ip, 8), 255))
    __guardar8(dir + 7, __y_bits(ip, 255))
    retornar dir
}

funcion sys_red_conectar(ip, puerto) {
    sys_winsock()
    sea fd = __winapi("ws2_32.dll", "socket", 2, 1, 6)
    si (fd == 0 - 1 o fd == 0) { retornar 0 - 1 }
    sea dir = sys_dir_ipv4(mem_reservar(16), ip, puerto)
    sea r = sys_i32(__winapi("ws2_32.dll", "connect", fd, dir, 16))
    mem_liberar(dir)
    si (r != 0) {
        __winapi("ws2_32.dll", "closesocket", fd)
        retornar 0 - 2
    }
    retornar fd
}

funcion sys_red_espera(fd, ms) {
    sea v = mem_reservar(8)
    __guardar64(v, ms)
    __winapi("ws2_32.dll", "setsockopt", fd, 65535, 4102, v, 4)
    __winapi("ws2_32.dll", "setsockopt", fd, 65535, 4101, v, 4)
    mem_liberar(v)
    retornar 0
}

funcion sys_udp_crear(puerto) {
    sys_winsock()
    sea fd = __winapi("ws2_32.dll", "socket", 2, 2, 17)
    si (fd == 0 - 1 o fd == 0) { retornar 0 - 1 }
    si (puerto > 0) {
        sea uno = mem_reservar(8)
        __guardar64(uno, 1)
        __winapi("ws2_32.dll", "setsockopt", fd, 65535, 4, uno, 4)
        mem_liberar(uno)
        sea dir = sys_dir_ipv4(mem_reservar(16), 0, puerto)
        sea r = sys_i32(__winapi("ws2_32.dll", "bind", fd, dir, 16))
        mem_liberar(dir)
        si (r != 0) {
            __winapi("ws2_32.dll", "closesocket", fd)
            retornar 0 - 2
        }
    }
    retornar fd
}

funcion sys_udp_enviar(fd, ip, puerto, buf, n) {
    sea dir = sys_dir_ipv4(mem_reservar(16), ip, puerto)
    sea r = sys_i32(__winapi("ws2_32.dll", "sendto", fd, buf, n, 0, dir, 16))
    mem_liberar(dir)
    retornar r
}

funcion sys_udp_recibir(fd, buf, n, dir, bloquear) {
    sea modo = mem_reservar(8)
    __guardar64(modo, 1)
    si (bloquear) { __guardar64(modo, 0) }
    __winapi("ws2_32.dll", "ioctlsocket", fd, 2147772030, modo)   // FIONBIO
    mem_liberar(modo)
    sea largo = mem_reservar(8)
    __guardar64(largo, 16)
    sea r = sys_i32(__winapi("ws2_32.dll", "recvfrom", fd, buf, n, 0, dir, largo))
    mem_liberar(largo)
    retornar r
}

// getaddrinfo (IPv4): la dirección en addrinfo.ai_addr (+32).
funcion sys_resolver(nombre) {
    sys_winsock()
    sea pistas = mem_reservar(48)
    mem_llenar(pistas, 0, 48)
    __guardar8(pistas + 4, 2)
    __guardar8(pistas + 8, 1)
    sea res = mem_reservar(8)
    __guardar64(res, 0)
    sea ip = 0
    si (sys_i32(__winapi("ws2_32.dll", "getaddrinfo", nombre, 0, pistas, res)) == 0 y __cargar64(res) != 0) {
        sea dir = __cargar64(__cargar64(res) + 32)
        ip = __cargar8(dir + 4) * 16777216 + __cargar8(dir + 5) * 65536 + __cargar8(dir + 6) * 256 + __cargar8(dir + 7)
        __winapi("ws2_32.dll", "freeaddrinfo", __cargar64(res))
    }
    mem_liberar(res)
    mem_liberar(pistas)
    retornar ip
}

// ── TLS con Schannel (SSPI) ───────────────────────────────────────────────
// Bloque de 128 bytes en estado + 32:
//   0 CredHandle (16) · 16 CtxtHandle (16) · 32 SecPkgContext_StreamSizes
//   (20: cabecera, cola, mensaje máximo, buffers, bloque) · 56 entrada
//   cifrada pendiente (texto) · 64 datos descifrados sobrantes (texto)

funcion sys_g32(p, v) {
    __guardar8(p, __y_bits(v, 255))
    __guardar8(p + 1, __y_bits(__desplazar_der(v, 8), 255))
    __guardar8(p + 2, __y_bits(__desplazar_der(v, 16), 255))
    __guardar8(p + 3, __y_bits(__desplazar_der(v, 24), 255))
    retornar 0
}
funcion sys_c32(p) { retornar __y_bits(__cargar64(p), 4294967295) }

// SecBuffer i del arreglo: cbBuffer (4) · BufferType (4) · pvBuffer (8).
funcion sys_secbuf(arreglo, i, tipo, tam, dato) {
    sea b = arreglo + i * 16
    sys_g32(b, tam)
    sys_g32(b + 4, tipo)
    __guardar64(b + 8, dato)
    retornar b
}

// SecBufferDesc: ulVersion (0) · cBuffers · pBuffers.
funcion sys_secdesc(desc, n, arreglo) {
    sys_g32(desc, 0)
    sys_g32(desc + 4, n)
    __guardar64(desc + 8, arreglo)
    retornar desc
}

funcion sys_tls_mandar(fd, p, n) {
    sea hecho = 0
    mientras (hecho < n) {
        sea r = sys_red_escribir(fd, p + hecho, n - hecho)
        si (r <= 0) { retornar 0 - 1 }
        hecho = hecho + r
    }
    retornar 0
}

// Agrega al texto lo que llegue del socket; 0 si se cerró.
funcion sys_tls_leer_mas(fd, entrada) {
    str_asegurar(entrada, str_largo(entrada) + 16384)
    sea n = sys_red_leer(fd, str_datos(entrada) + str_largo(entrada), 16384)
    si (n <= 0) { retornar 0 }
    __guardar64(entrada, str_largo(entrada) + n)
    retornar n
}

// Deja en entrada solo sus últimos n bytes (SECBUFFER_EXTRA).
funcion sys_tls_conservar_final(entrada, n) {
    sea inicio = str_largo(entrada) - n
    sea i = 0
    mientras (i < n) {
        __guardar8(str_datos(entrada) + i, __cargar8(str_datos(entrada) + inicio + i))
        i = i + 1
    }
    __guardar64(entrada, n)
    retornar 0
}

// Una vuelta de InitializeSecurityContext con lo que hay en entrada.
// Devuelve el estado SSPI (entero de 32 bits con signo).
funcion sys_tls_paso(b, host, fd, primero) {
    sea entrada = __cargar64(b + 56)
    sea bufs_in = mem_reservar(32)
    sea desc_in = mem_reservar(16)
    sea bufs_out = mem_reservar(16)
    sea desc_out = mem_reservar(16)
    sea atributos = mem_reservar(8)
    sys_secbuf(bufs_out, 0, 2, 0, 0)                           // SECBUFFER_TOKEN
    sys_secdesc(desc_out, 1, bufs_out)
    sea banderas = 49436                                       // SEQUENCE|REPLAY|CONFIDENTIALITY|ALLOCATE_MEMORY|EXTENDED_ERROR|STREAM
    sea r = 0
    si (primero) {
        r = sys_i32(__winapi("secur32.dll", "InitializeSecurityContextA", b, 0, host, banderas, 0, 0, 0, 0, b + 16, desc_out, atributos, 0))
    } sino {
        sys_secbuf(bufs_in, 0, 2, str_largo(entrada), str_datos(entrada))
        sys_secbuf(bufs_in, 1, 0, 0, 0)                        // SECBUFFER_EMPTY
        sys_secdesc(desc_in, 2, bufs_in)
        r = sys_i32(__winapi("secur32.dll", "InitializeSecurityContextA", b, b + 16, host, banderas, 0, 0, desc_in, 0, 0, desc_out, atributos, 0))
    }
    sea token = __cargar64(bufs_out + 8)
    sea largo_token = sys_c32(bufs_out)
    si (token != 0) {
        si (largo_token > 0) { sys_tls_mandar(fd, token, largo_token) }
        __winapi("secur32.dll", "FreeContextBuffer", token)
    }
    si (primero == 0 y r != 0 - 2146893032) {                  // != SEC_E_INCOMPLETE_MESSAGE
        si (sys_c32(bufs_in + 20) == 5) {                      // SECBUFFER_EXTRA
            sys_tls_conservar_final(entrada, sys_c32(bufs_in + 16))
        } sino {
            __guardar64(entrada, 0)
        }
    }
    mem_liberar(bufs_in)
    mem_liberar(desc_in)
    mem_liberar(bufs_out)
    mem_liberar(desc_out)
    mem_liberar(atributos)
    retornar r
}

// SCH_CREDENTIALS (versión 5) con TLS_PARAMETERS: el sistema elige TLS 1.3
// o 1.2 (cifrados AEAD con USE_STRONG_CRYPTO) y quedan desactivados SSL 2/3
// y TLS 1.0/1.1. Diseño x64: dwVersion 0, dwFlags 52, cTlsParameters 56,
// pTlsParameters 64; TLS_PARAMETERS.grbitDisabledProtocols en 16.
funcion sys_tls_credenciales_modernas(b) {
    sea cred = mem_reservar(72)
    mem_llenar(cred, 0, 72)
    sea param = mem_reservar(40)
    mem_llenar(param, 0, 40)
    sys_g32(param + 16, 680)                                   // 0x2A8: SSL2|SSL3|TLS1.0|TLS1.1 (cliente)
    sys_g32(cred, 5)                                           // SCH_CREDENTIALS_VERSION
    sys_g32(cred + 52, 4194352)                                // AUTO_CRED_VALIDATION | NO_DEFAULT_CREDS | USE_STRONG_CRYPTO
    sys_g32(cred + 56, 1)
    __guardar64(cred + 64, param)
    sea expira = mem_reservar(8)
    sea r = sys_i32(__winapi("secur32.dll", "AcquireCredentialsHandleA", 0, str_c("Microsoft Unified Security Protocol Provider"), 2, 0, cred, 0, 0, b, expira))
    mem_liberar(cred)
    mem_liberar(param)
    mem_liberar(expira)
    retornar r
}

// Respaldo para Windows anteriores a 1809: SCHANNEL_CRED, solo TLS 1.2.
funcion sys_tls_credenciales_clasicas(b) {
    sea cred = mem_reservar(80)
    mem_llenar(cred, 0, 80)
    sys_g32(cred, 4)                                           // SCHANNEL_CRED_VERSION
    sys_g32(cred + 56, 2048)                                   // grbitEnabledProtocols: TLS 1.2 (cliente)
    sys_g32(cred + 72, 4194352)                                // AUTO_CRED_VALIDATION | NO_DEFAULT_CREDS | USE_STRONG_CRYPTO
    sea expira = mem_reservar(8)
    sea r = sys_i32(__winapi("secur32.dll", "AcquireCredentialsHandleA", 0, str_c("Microsoft Unified Security Protocol Provider"), 2, 0, cred, 0, 0, b, expira))
    mem_liberar(cred)
    mem_liberar(expira)
    retornar r
}

// 0 si la sesión quedó lista; si no, el código SSPI (negativo).
funcion sys_tls_abrir(estado, host) {
    sea fd = __cargar64(estado + 16)
    sea b = mem_reservar(128)
    mem_llenar(b, 0, 128)
    __guardar64(estado + 32, b)
    __guardar64(b + 56, str_nuevo(16384))
    __guardar64(b + 64, str_nuevo(16))
    // TLS 1.3 + 1.2 con SCH_CREDENTIALS (Windows 10 1809+ / 11 / Server 2022);
    // en sistemas que no lo entienden, SCHANNEL_CRED solo con TLS 1.2.
    sea r = sys_tls_credenciales_modernas(b)
    si (r != 0) { r = sys_tls_credenciales_clasicas(b) }
    si (r != 0) { retornar r }
    sea host_c = str_c(host)
    __guardar64(b + 72, host_c)                                // para los mensajes de sesión de TLS 1.3
    r = sys_tls_paso(b, host_c, fd, 1)
    mientras (r == 590610 o r == 0 - 2146893032) {             // SEC_I_CONTINUE_NEEDED / INCOMPLETE
        si (str_largo(__cargar64(b + 56)) == 0 o r == 0 - 2146893032) {
            si (sys_tls_leer_mas(fd, __cargar64(b + 56)) == 0) { retornar 0 - 1 }
        }
        r = sys_tls_paso(b, host_c, fd, 0)
    }
    si (r != 0) { retornar r }
    si (sys_i32(__winapi("secur32.dll", "QueryContextAttributesA", b + 16, 4, b + 32)) != 0) { retornar 0 - 2 }
    retornar 0
}

funcion sys_tls_enviar(estado, p, n) {
    sea b = __cargar64(estado + 32)
    sea fd = __cargar64(estado + 16)
    sea cabecera = sys_c32(b + 32)
    sea cola = sys_c32(b + 36)
    sea maximo = sys_c32(b + 40)
    sea bloque = mem_reservar(cabecera + maximo + cola)
    sea bufs = mem_reservar(64)
    sea desc = mem_reservar(16)
    sea hecho = 0
    sea r = 0
    mientras (hecho < n y r == 0) {
        sea parte = n - hecho
        si (parte > maximo) { parte = maximo }
        sea i = 0
        mientras (i < parte) {
            __guardar8(bloque + cabecera + i, __cargar8(p + hecho + i))
            i = i + 1
        }
        sys_secbuf(bufs, 0, 7, cabecera, bloque)               // STREAM_HEADER
        sys_secbuf(bufs, 1, 1, parte, bloque + cabecera)       // DATA
        sys_secbuf(bufs, 2, 6, cola, bloque + cabecera + parte) // STREAM_TRAILER
        sys_secbuf(bufs, 3, 0, 0, 0)
        sys_secdesc(desc, 4, bufs)
        r = sys_i32(__winapi("secur32.dll", "EncryptMessage", b + 16, 0, desc, 0))
        si (r == 0) {
            si (sys_tls_mandar(fd, bloque, sys_c32(bufs) + sys_c32(bufs + 16) + sys_c32(bufs + 32)) != 0) { r = 0 - 1 }
        }
        hecho = hecho + parte
    }
    mem_liberar(bloque)
    mem_liberar(bufs)
    mem_liberar(desc)
    retornar r
}

// Todo lo que envíe el servidor hasta cerrar la sesión.
funcion sys_tls_recibir_todo(estado) {
    sea b = __cargar64(estado + 32)
    sea fd = __cargar64(estado + 16)
    sea entrada = __cargar64(b + 56)
    sea salida = str_nuevo(16384)
    sea bufs = mem_reservar(64)
    sea desc = mem_reservar(16)
    sea seguir = 1
    mientras (seguir) {
        si (str_largo(entrada) == 0) {
            si (sys_tls_leer_mas(fd, entrada) == 0) { seguir = 0 }
        }
        si (seguir) {
            sys_secbuf(bufs, 0, 1, str_largo(entrada), str_datos(entrada))
            sys_secbuf(bufs, 1, 0, 0, 0)
            sys_secbuf(bufs, 2, 0, 0, 0)
            sys_secbuf(bufs, 3, 0, 0, 0)
            sys_secdesc(desc, 4, bufs)
            sea r = sys_i32(__winapi("secur32.dll", "DecryptMessage", b + 16, desc, 0, 0))
            si (r == 0 - 2146893032) {                         // SEC_E_INCOMPLETE_MESSAGE
                si (sys_tls_leer_mas(fd, entrada) == 0) { seguir = 0 }
            } sino {
                si (r == 0 o r == 590625) {                    // SEC_E_OK / SEC_I_RENEGOTIATE
                    sea extra = 0
                    sea k = 1
                    mientras (k < 4) {
                        sea t = sys_c32(bufs + k * 16 + 4)
                        si (t == 1) {
                            sea d = __cargar64(bufs + k * 16 + 8)
                            sea m = sys_c32(bufs + k * 16)
                            sea j = 0
                            mientras (j < m) {
                                str_agregar_byte(salida, __cargar8(d + j))
                                j = j + 1
                            }
                        }
                        si (t == 5) { extra = sys_c32(bufs + k * 16) }
                        k = k + 1
                    }
                    si (extra > 0) { sys_tls_conservar_final(entrada, extra) } sino { __guardar64(entrada, 0) }
                    si (r == 590625) {
                        // Mensajes de sesión de TLS 1.3: se le entregan a ISC.
                        sea rr = sys_tls_paso(b, __cargar64(b + 72), fd, 0)
                        si (rr != 0 y rr != 590610) { seguir = 0 }
                    }
                } sino {
                    seguir = 0                                 // cierre (SEC_I_CONTEXT_EXPIRED) o error
                }
            }
        }
    }
    mem_liberar(bufs)
    mem_liberar(desc)
    retornar salida
}

// SECPKG_ATTR_CONNECTION_INFO (90): dwProtocol en el desplazamiento 0.
funcion sys_tls_version(estado) {
    sea b = __cargar64(estado + 32)
    sea info = mem_reservar(64)
    mem_llenar(info, 0, 64)
    sea r = sys_i32(__winapi("secur32.dll", "QueryContextAttributesA", b + 16, 90, info))
    sea p = sys_c32(info)
    mem_liberar(info)
    si (r != 0) { retornar "desconocida" }
    si (__y_bits(p, 12288) != 0) { retornar "TLSv1.3" }        // SP_PROT_TLS1_3 (0x3000)
    si (__y_bits(p, 3072) != 0) { retornar "TLSv1.2" }         // SP_PROT_TLS1_2 (0xC00)
    si (__y_bits(p, 768) != 0) { retornar "TLSv1.1" }
    retornar "TLSv1.0"
}

funcion sys_tls_cerrar(estado) {
    sea b = __cargar64(estado + 32)
    si (b != 0) {
        __winapi("secur32.dll", "DeleteSecurityContext", b + 16)
        __winapi("secur32.dll", "FreeCredentialsHandle", b)
    }
    retornar 0
}
