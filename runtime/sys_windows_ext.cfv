// runtime/sys_windows_ext.cfv — funciones de sistema de Windows para los
// programas del lenguaje (tiempo, directorios, bibliotecas, hilos, red).

// Nanosegundos desde 1970 (GetSystemTimePreciseAsFileTime: 100 ns desde 1601).
funcion sys_reloj_ns() {
    sea ft = sys_casilla()
    __winapi("kernel32.dll", "GetSystemTimePreciseAsFileTime", ft)
    retornar (__cargar64(ft) - 116444736000000000) * 100
}

funcion sys_dormir_ms(n) {
    __winapi("kernel32.dll", "Sleep", n)
    retornar 0
}

funcion sys_nucleos() {
    sea info = mem_reservar(64)
    mem_llenar(info, 0, 64)
    __winapi("kernel32.dll", "GetSystemInfo", info)
    sea n = __y_bits(__cargar64(info + 32), 4294967295)       // dwNumberOfProcessors
    mem_liberar(info)
    si (n < 1) { n = 1 }
    retornar n
}

// Espera activa breve: Windows no tiene futex; WaitOnAddress llega con la
// fase de hilos nativos.
funcion sys_futex_esperar(direccion, valor, ms, op) {
    si (__y_bits(__cargar64(direccion), 4294967295) == __y_bits(valor, 4294967295)) { __winapi("kernel32.dll", "Sleep", 1) }
    retornar 0
}

funcion sys_futex_despertar(direccion) { retornar 0 }

// Hilo con CreateThread: el trampolín del compilador cambia a la pila
// [base, base + tam) y llama a dyn_hilo_inicio(t); al terminar pone en 0
// [base + 16] (esperar() lo observa).
funcion sys_hilo_crear(base, tam, t) {
    __guardar64(base + 24, t)
    __guardar64(base + 32, __dir("dyn_hilo_inicio"))
    sea h = __winapi("kernel32.dll", "CreateThread", 0, 65536, __trampolin_hilo(), base, 0, 0)
    si (h == 0) { retornar 0 - 1 }
    __winapi("kernel32.dll", "CloseHandle", h)
    retornar 0
}

funcion sys_dl_disponible() { retornar 1 }
funcion sys_cargar_biblioteca(nombre) { retornar __winapi("kernel32.dll", "LoadLibraryA", str_c(nombre)) }
funcion sys_simbolo(h, nombre) { retornar __winapi("kernel32.dll", "GetProcAddress", h, str_c(nombre)) }

// ── Red con Winsock (ws2_32.dll) ──────────────────────────────────────────

funcion sys_i32(x) {
    sea v = __y_bits(x, 4294967295)
    si (v >= 2147483648) { retornar v - 4294967296 }
    retornar v
}

funcion sys_winsock() {
    si (__cargar64(__globales() + 224) == 0) {
        sea datos = mem_reservar(512)
        __winapi("ws2_32.dll", "WSAStartup", 514, datos)      // versión 2.2
        mem_liberar(datos)
        __guardar64(__globales() + 224, 1)
    }
    retornar 0
}

funcion sys_red_escuchar(puerto) {
    sys_winsock()
    sea fd = __winapi("ws2_32.dll", "socket", 2, 1, 6)        // AF_INET, SOCK_STREAM, TCP
    si (fd == 0 - 1 o fd == 0) { retornar 0 - 1 }
    sea dir = mem_reservar(16)
    mem_llenar(dir, 0, 16)
    __guardar8(dir, 2)
    __guardar8(dir + 2, __desplazar_der(puerto, 8))
    __guardar8(dir + 3, __y_bits(puerto, 255))
    sea r = sys_i32(__winapi("ws2_32.dll", "bind", fd, dir, 16))
    mem_liberar(dir)
    si (r != 0) { retornar 0 - 2 }
    si (sys_i32(__winapi("ws2_32.dll", "listen", fd, 64)) != 0) { retornar 0 - 3 }
    retornar fd
}

funcion sys_red_aceptar(fd, dir, largo_dir) {
    sea c = __winapi("ws2_32.dll", "accept", fd, dir, largo_dir)
    si (c == 0 - 1) { retornar 0 - 1 }
    retornar c
}

funcion sys_red_leer(fd, buf, n) { retornar sys_i32(__winapi("ws2_32.dll", "recv", fd, buf, n, 0)) }
funcion sys_red_escribir(fd, buf, n) { retornar sys_i32(__winapi("ws2_32.dll", "send", fd, buf, n, 0)) }
funcion sys_red_cerrar(fd) { __winapi("ws2_32.dll", "closesocket", fd) retornar 0 }

// Bytes aleatorios del sistema (BCryptGenRandom con el RNG preferido).
funcion sys_aleatorio(buf, n) {
    si (sys_i32(__winapi("bcrypt.dll", "BCryptGenRandom", 0, buf, n, 2)) != 0) { retornar 0 - 1 }
    retornar 0
}
