// runtime/io.cfv — salida, archivos y argumentos del programa.

funcion rt_escribir_texto(fd, s) {
    sea escritos = 0
    sea largo = str_largo(s)
    mientras (escritos < largo) {
        sea n = sys_escribir(fd, str_datos(s) + escritos, largo - escritos)
        si (n <= 0) { retornar 0 - 1 }
        escritos = escritos + n
    }
    retornar escritos
}

// mostrar(texto) del programa llama aquí.
funcion rt_mostrar(s) {
    rt_escribir_texto(1, s)
    rt_escribir_texto(1, "\n")
    retornar 0
}

funcion rt_panico(mensaje) {
    rt_escribir_texto(2, "[C-Forge] ")
    rt_escribir_texto(2, mensaje)
    rt_escribir_texto(2, "\n")
    sys_salir(1)
    retornar 0
}

funcion rt_argc() { retornar sys_argc() }

funcion rt_argumento(i) {
    si (i < 0 o i >= sys_argc()) { rt_panico("argumento inexistente") }
    retornar str_desde_c(sys_argv(i))
}

funcion archivo_leer(ruta) {
    sea fd = sys_abrir(str_c(ruta), sys_abrir_lectura(), 0)
    si (fd < 0) { rt_panico(str_concatenar("no se pudo abrir ", ruta)) }
    sea contenido = str_nuevo(4096)
    sea seguir = 1
    mientras (seguir) {
        str_asegurar(contenido, str_largo(contenido) + 65536)
        sea n = sys_leer(fd, str_datos(contenido) + str_largo(contenido), 65536)
        si (n < 0) { rt_panico(str_concatenar("error al leer ", ruta)) }
        si (n == 0) {
            seguir = 0
        } sino {
            __guardar64(contenido, str_largo(contenido) + n)
        }
    }
    __guardar8(str_datos(contenido) + str_largo(contenido), 0)
    sys_cerrar(fd)
    retornar contenido
}

funcion archivo_escribir(ruta, contenido) {
    sea fd = sys_abrir(str_c(ruta), sys_abrir_escritura(), sys_modo_archivo())
    si (fd < 0) { rt_panico(str_concatenar("no se pudo escribir ", ruta)) }
    sea n = rt_escribir_texto(fd, contenido)
    sys_cerrar(fd)
    si (n < 0) { rt_panico(str_concatenar("escritura incompleta en ", ruta)) }
    retornar n
}
