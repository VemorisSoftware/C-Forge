// runtime/dyn.cfv — valores dinámicos del lenguaje C-Forge completo.
//
// Escrito en el dialecto nativo, pero con la convención de valores del
// lenguaje (el compilador lo carga en modo "puente"). Cada valor es una
// palabra de 64 bits con etiqueta:
//
//   0           nulo
//   2 / 4       falso / verdadero
//   impar       entero: n * 2 + 1
//   puntero     caja de 16 bytes [tipo][dato]:
//                 1 texto (dato: texto del runtime)
//                 2 lista (dato: vec del runtime)
//                 3 mapa  (dato: map del runtime)
//                 4 flotante (dato: bits IEEE-754)
//                 7 función (dato: [código][aridad][n][celdas capturadas]*)
//                 8 puntero (dato: [bloque (lista)][desplazamiento])
//
// Los números siguen la semántica del intérprete: un resultado con valor
// entero se representa como entero; si no, como flotante.

// ── Construcción y consulta ───────────────────────────────────────────────

funcion dyn_caja(tipo, dato) {
    sea c = mem_reservar(16)
    __guardar64(c, tipo)
    __guardar64(c + 8, dato)
    retornar c
}

// 0 nulo · 1 texto · 2 lista · 3 mapa · 4 flotante · 5 booleano · 6 entero
funcion dyn_tipo(v) {
    si (v == 0) { retornar 0 }
    si (__y_bits(v, 1) == 1) { retornar 6 }
    si (v == 2 o v == 4) { retornar 5 }
    retornar __cargar64(v)
}

funcion dyn_dato(v) { retornar __cargar64(v + 8) }
funcion dyn_entero(n) { retornar n * 2 + 1 }
funcion dyn_valor_entero(v) { retornar (v - 1) / 2 }
funcion dyn_bool(b) { si (b) { retornar 4 } retornar 2 }
funcion dyn_texto(s) { retornar dyn_caja(1, s) }
funcion dyn_lista_nueva() { retornar dyn_caja(2, vec_nuevo()) }
funcion dyn_mapa_nuevo() { retornar dyn_caja(3, map_nuevo()) }

funcion dyn_nombre_tipo(v) {
    sea t = dyn_tipo(v)
    si (t == 0) { retornar "nulo" }
    si (t == 1) { retornar "texto" }
    si (t == 2) { retornar "lista" }
    si (t == 3) { retornar "mapa" }
    si (t == 5) { retornar "booleano" }
    si (t == 7) { retornar "funcion" }
    si (t == 8) { retornar "puntero" }
    si (t == 11) { retornar "puntero" }
    si (t == 9) { retornar "canal" }
    si (t == 10) { retornar "mutex" }
    retornar "numero"
}

funcion dyn_error_tipo(operacion, v) {
    sea m = str_concatenar(operacion, ": valor de tipo ")
    str_agregar(m, dyn_nombre_tipo(v))
    dyn_error(m)
    retornar 0
}

funcion dyn_verdad(v) {
    si (v == 4) { retornar 1 }
    si (v == 2) { retornar 0 }
    dyn_error("se esperaba verdadero o falso")
    retornar 0
}

// ── Errores: intentar / capturar / lanzar ────────────────────────────────
// Global 21: pila de manejadores [rsp][rbp][dirección de captura].

// Cada hilo tiene su pila de manejadores: el hilo principal usa la global
// 21; un hilo creado por tarea() la guarda en su registro (base de su pila).
funcion dyn_manejadores() {
    sea registro = dyn_registro_hilo()
    sea casilla = __globales() + 168
    si (registro != 0) { casilla = registro + 8 }
    sea h = __cargar64(casilla)
    si (h == 0) {
        h = vec_nuevo()
        __guardar64(casilla, h)
    }
    retornar h
}

// Registro del hilo actual (base alineada de su pila de 8 MiB) o 0 si es el
// hilo principal. Las bases de los hilos creados por tarea() se anotan en la
// global 34; así no se lee memoria que podría no estar asignada.
funcion dyn_registro_hilo() {
    sea bases = __cargar64(__globales() + 272)
    si (bases == 0) { retornar 0 }
    sea base = __y_bits(__pila(), 0 - 8388608)
    sea i = 0
    mientras (i < vec_largo(bases)) {
        si (vec_obtener(bases, i) == base) { retornar base }
        i = i + 1
    }
    retornar 0
}

funcion dyn_anotar_hilo(base) {
    sea cerrojo = __globales() + 280
    mientras (__intercambiar(cerrojo, 1) != 0) { sys_ceder() }
    sea bases = __cargar64(__globales() + 272)
    si (bases == 0) {
        bases = vec_nuevo()
        __guardar64(__globales() + 272, bases)
    }
    vec_agregar(bases, base)
    __guardar64(cerrojo, 0)
    retornar 0
}

funcion dyn_intentar_entrar(pila, marco, destino) {
    sea r = mem_reservar(24)
    __guardar64(r, pila)
    __guardar64(r + 8, marco)
    __guardar64(r + 16, destino)
    vec_agregar(dyn_manejadores(), r)
    retornar 0
}

funcion dyn_intentar_salir() {
    mem_liberar(vec_quitar_ultimo(dyn_manejadores()))
    retornar 0
}

funcion dyn_lanzar(v) {
    sea h = dyn_manejadores()
    si (vec_largo(h) == 0) {
        rt_panico(str_concatenar("error no capturado: ", dyn_a_str(v)))
    }
    sea r = vec_quitar_ultimo(h)
    __saltar(__cargar64(r + 8), __cargar64(r), __cargar64(r + 16), v)
    retornar 0
}

// Error del lenguaje: se puede capturar con intentar/capturar.
funcion dyn_error(mensaje) {
    si (vec_largo(dyn_manejadores()) > 0) { dyn_lanzar(dyn_texto(mensaje)) }
    rt_panico(mensaje)
    retornar 0
}

// ── Funciones anónimas y celdas ──────────────────────────────────────────

funcion dyn_celda_nueva(v) {
    sea celda = mem_reservar(8)
    __guardar64(celda, v)
    retornar celda
}

funcion dyn_cierre_nuevo(codigo, aridad, capturas) {
    sea r = mem_reservar(24 + capturas * 8)
    __guardar64(r, codigo)
    __guardar64(r + 8, aridad)
    __guardar64(r + 16, capturas)
    retornar dyn_caja(7, r)
}

funcion dyn_cierre_fijar(f, i, celda) {
    __guardar64(dyn_dato(f) + 24 + i * 8, celda)
    retornar f
}

// Dirección del código de f para una llamada con n argumentos.
funcion dyn_codigo_cierre(f, n) {
    si (dyn_tipo(f) != 7) { dyn_error_tipo("no se puede llamar", f) }
    sea r = dyn_dato(f)
    si (__cargar64(r + 8) != n) {
        sea m = str_concatenar("la función espera ", str_desde_entero(__cargar64(r + 8)))
        str_agregar(m, " argumentos y recibió ")
        str_agregar(m, str_desde_entero(n))
        dyn_error(m)
    }
    retornar __cargar64(r)
}

// ── Números ───────────────────────────────────────────────────────────────

funcion dyn_es_numero(v) {
    sea t = dyn_tipo(v)
    retornar t == 6 o t == 4 o t == 12
}

funcion dyn_a_f64(v) {
    sea t = dyn_tipo(v)
    si (t == 6) { retornar __f64_desde_entero(dyn_valor_entero(v)) }
    si (t == 4) { retornar dyn_dato(v) }
    si (t == 12) { retornar dyn_gr_a_f64(dyn_dato(v)) }
    dyn_error_tipo("se esperaba un número", v)
    retornar 0
}

// Normaliza: un flotante con valor entero exacto vuelve a ser entero.
funcion dyn_desde_f64(bits) {
    sea e = __f64_a_entero(bits)
    si (e > 0 - 4503599627370496 y e < 4503599627370496) {
        si (__f64_desde_entero(e) == bits) { retornar dyn_entero(e) }
        // -0.0 también es el entero 0.
        si (__desplazar_izq(bits, 1) == 0) { retornar dyn_entero(0) }
    }
    retornar dyn_caja(4, bits)
}

funcion dyn_flotante(bits) { retornar dyn_desde_f64(bits) }

// Parámetros anotados: se comprueban una vez al entrar a la función.
funcion dyn_parametro_mal(v, nombre, esperado) {
    sea m = str_concatenar("error de tipos: el parámetro ", dyn_a_str(nombre))
    str_agregar(m, " espera ")
    str_agregar(m, esperado)
    str_agregar(m, " y recibe ")
    str_agregar(m, dyn_nombre_tipo(v))
    dyn_error(m)
    retornar v
}

funcion dyn_parametro_entero(v, nombre) {
    si (__y_bits(v, 1) == 1 o dyn_tipo(v) == 12) { retornar v }
    retornar dyn_parametro_mal(v, nombre, "entero")
}

funcion dyn_parametro_numero(v, nombre) {
    si (dyn_es_numero(v)) { retornar v }
    retornar dyn_parametro_mal(v, nombre, "decimal")
}

funcion dyn_ambos_enteros(a, b) {
    retornar __y_bits(__y_bits(a, b), 1) == 1
}

// Recolector de basura (runtime/mem.cfv): raíces en las casillas globales
// y las variables de nivel superior. La cantidad de globales está después
// de la tabla de clases: [n][registro]*[globales].
funcion dyn_gc_iniciar() {
    si (sys_variable_entorno("CFORGE_GC") != 0) {
        si (str_igual(sys_variable_entorno("CFORGE_GC"), "0")) { retornar 0 }
    }
    sea tabla = __clases()
    sea cantidad = __cargar64(tabla + 8 + __cargar64(tabla) * 8)
    // CFORGE_GC_ESTRES=1: recolectar cada 64 KiB (pruebas del recolector).
    sea minimo = 8388608
    si (sys_variable_entorno("CFORGE_GC_ESTRES") != 0) { minimo = 65536 }
    gc_activar(__globales() + 512 + cantidad * 8, minimo)
    retornar 0
}

// Programa escrito en inglés: valores impresos en inglés (global 20).
funcion dyn_fijar_ingles() { mem_fijar_global(20, 1) retornar 0 }
funcion dyn_ingles() { retornar mem_global(20) == 1 }

// ── Clases ────────────────────────────────────────────────────────────────
// El compilador deja en datos la tabla __clases(): [n][registro]*, con cada
// registro [nombre][padre o 0][n métodos]([nombre][código][aridad])*.
// Una instancia es un mapa con la clave "__clase".

funcion dyn_registro_clase(nombre) {
    sea tabla = __clases()
    sea i = 0
    mientras (i < __cargar64(tabla)) {
        sea r = __cargar64(tabla + 8 + i * 8)
        si (str_igual(__cargar64(r), nombre)) { retornar r }
        i = i + 1
    }
    retornar 0
}

// Dirección del método (o 0) para objeto.nombre(...) con aridad total n.
funcion dyn_buscar_metodo(objeto, nombre, n) {
    si (dyn_tipo(objeto) != 3) { retornar 0 }
    sea m = dyn_dato(objeto)
    sea e = map_buscar(m, "__clase")
    si (e < 0) { retornar 0 }
    sea clase = map_valor_en(m, e)
    si (dyn_tipo(clase) != 1) { retornar 0 }
    sea r = dyn_registro_clase(dyn_dato(clase))
    mientras (r != 0) {
        sea cantidad = __cargar64(r + 16)
        sea i = 0
        mientras (i < cantidad) {
            sea entrada = r + 24 + i * 24
            si (str_igual(__cargar64(entrada), nombre)) {
                si (__cargar64(entrada + 16) != n) {
                    dyn_error(str_concatenar("cantidad de argumentos incorrecta en el método ", nombre))
                }
                retornar __cargar64(entrada + 8)
            }
            i = i + 1
        }
        si (__cargar64(r + 8) == 0) { r = 0 } sino { r = dyn_registro_clase(__cargar64(r + 8)) }
    }
    retornar 0
}

funcion dyn_metodo_desconocido(objeto, nombre) {
    sea m = str_concatenar("método desconocido '", nombre)
    str_agregar(m, "' para un valor de tipo ")
    str_agregar(m, dyn_nombre_tipo(objeto))
    dyn_error(m)
    retornar 0
}

// ── Claves ordenadas (como el intérprete: orden por bytes) ───────────────

funcion dyn_str_comparar(x, y) {
    sea i = 0
    mientras (i < str_largo(x) y i < str_largo(y)) {
        sea cx = str_byte(x, i)
        sea cy = str_byte(y, i)
        si (cx < cy) { retornar 0 - 1 }
        si (cx > cy) { retornar 1 }
        i = i + 1
    }
    si (str_largo(x) < str_largo(y)) { retornar 0 - 1 }
    si (str_largo(x) > str_largo(y)) { retornar 1 }
    retornar 0
}

// Ordena por mezcla el tramo [desde, hasta) de v usando aux.
funcion dyn_ordenar_tramo(v, aux, desde, hasta) {
    si (hasta - desde < 2) { retornar 0 }
    sea medio = (desde + hasta) / 2
    dyn_ordenar_tramo(v, aux, desde, medio)
    dyn_ordenar_tramo(v, aux, medio, hasta)
    sea i = desde
    sea j = medio
    sea k = desde
    mientras (k < hasta) {
        si (j >= hasta o (i < medio y dyn_str_comparar(vec_obtener(v, i), vec_obtener(v, j)) <= 0)) {
            vec_fijar(aux, k, vec_obtener(v, i))
            i = i + 1
        } sino {
            vec_fijar(aux, k, vec_obtener(v, j))
            j = j + 1
        }
        k = k + 1
    }
    k = desde
    mientras (k < hasta) {
        vec_fijar(v, k, vec_obtener(aux, k))
        k = k + 1
    }
    retornar 0
}

// Claves del mapa (textos del runtime) en orden.
funcion dyn_claves_ordenadas(m) {
    sea v = map_claves(m)
    sea aux = vec_nuevo()
    sea i = 0
    mientras (i < vec_largo(v)) {
        vec_agregar(aux, 0)
        i = i + 1
    }
    dyn_ordenar_tramo(v, aux, 0, vec_largo(v))
    vec_liberar(aux)
    retornar v
}

// ── Texto ─────────────────────────────────────────────────────────────────

funcion dyn_agregar_valor(r, v, comillas) {
    sea t = dyn_tipo(v)
    si (t == 1 y comillas) {
        str_agregar_byte(r, 34)
        str_agregar(r, dyn_dato(v))
        str_agregar_byte(r, 34)
        retornar 0
    }
    si (t == 1) { str_agregar(r, dyn_dato(v)) retornar 0 }
    si (t == 0) {
        si (dyn_ingles()) { str_agregar(r, "null") } sino { str_agregar(r, "nulo") }
        retornar 0
    }
    si (t == 5) {
        si (dyn_ingles()) {
            si (v == 4) { str_agregar(r, "true") } sino { str_agregar(r, "false") }
        } sino {
            si (v == 4) { str_agregar(r, "verdadero") } sino { str_agregar(r, "falso") }
        }
        retornar 0
    }
    si (t == 6) {
        str_agregar_entero(r, dyn_valor_entero(v))
        retornar 0
    }
    si (t == 4) {
        dyn_formato_g(r, dyn_dato(v))
        retornar 0
    }
    si (t == 12) {
        dyn_gr_agregar_texto(r, dyn_dato(v))
        retornar 0
    }
    si (t == 2) {
        sea l = dyn_dato(v)
        str_agregar_byte(r, 91)
        sea i = 0
        mientras (i < vec_largo(l)) {
            si (i > 0) { str_agregar(r, ", ") }
            dyn_agregar_valor(r, vec_obtener(l, i), 0)
            i = i + 1
        }
        str_agregar_byte(r, 93)
        retornar 0
    }
    si (t == 3) {
        sea m = dyn_dato(v)
        str_agregar_byte(r, 123)
        sea orden = dyn_claves_ordenadas(m)
        sea j = 0
        mientras (j < vec_largo(orden)) {
            sea k = vec_obtener(orden, j)
            si (j > 0) { str_agregar(r, ", ") }
            str_agregar_byte(r, 34)
            str_agregar(r, k)
            str_agregar(r, "\": ")
            dyn_agregar_valor(r, map_obtener(m, k), 0)
            j = j + 1
        }
        vec_liberar(orden)
        str_agregar_byte(r, 125)
        retornar 0
    }
    si (t == 7) { str_agregar(r, "<funcion>") retornar 0 }
    si (t == 9) { str_agregar(r, "<canal>") retornar 0 }
    si (t == 10) { str_agregar(r, "<mutex>") retornar 0 }
    si (t == 8) { str_agregar(r, "<puntero>") retornar 0 }
    si (t == 11) { str_agregar(r, "<puntero>") retornar 0 }
    dyn_error("valor desconocido")
    retornar 0
}

// Texto del runtime con la representación del valor.
funcion dyn_a_str(v) {
    si (dyn_tipo(v) == 1) { retornar dyn_dato(v) }
    sea r = str_nuevo(16)
    dyn_agregar_valor(r, v, 0)
    retornar r
}

funcion dyn_texto_de(v, operacion) {
    si (dyn_tipo(v) != 1) { dyn_error_tipo(operacion, v) }
    retornar dyn_dato(v)
}

// ── Operadores ────────────────────────────────────────────────────────────

// a + b con a y b enteros chicos; si no cabe, entero grande.
funcion dyn_suma_entera(a, b) {
    sea r = a - 1 + b
    si (__y_bits(__xo_bits(a - 1, r), __xo_bits(b, r)) < 0) { retornar dyn_gr_op_suma(a, b) }
    retornar r
}

funcion dyn_resta_entera(a, b) {
    sea b2 = b - 1
    sea r = a - b2
    si (__y_bits(__xo_bits(a, b2), __xo_bits(a, r)) < 0) { retornar dyn_gr_op_resta(a, b) }
    retornar r
}

funcion dyn_mul_entera(a, b) {
    sea x = dyn_valor_entero(a)
    sea y2 = b - 1
    sea r = x * y2
    si (x != 0) {
        si ((x == 0 - 1 y y2 == __desplazar_izq(1, 63)) o (x != 0 - 1 y r / x != y2)) { retornar dyn_gr_op_mul(a, b) }
    }
    retornar r + 1
}

funcion dyn_ambos_enteros_gr(a, b) { retornar dyn_gr_es_entero(a) y dyn_gr_es_entero(b) }

funcion dyn_suma(a, b) {
    si (dyn_ambos_enteros(a, b)) { retornar dyn_suma_entera(a, b) }
    si (dyn_ambos_enteros_gr(a, b)) { retornar dyn_gr_op_suma(a, b) }
    si (dyn_tipo(a) == 8 y __y_bits(b, 1) == 1) { retornar dyn_puntero(__cargar64(dyn_dato(a)), __cargar64(dyn_dato(a) + 8) + dyn_valor_entero(b)) }
    // Puntero de C + desplazamiento (memoria de c_reservar).
    si (dyn_tipo(a) == 11 y __y_bits(b, 1) == 1) { retornar dyn_caja(11, dyn_dato(a) + dyn_valor_entero(b)) }
    si (dyn_tipo(a) == 2 y dyn_tipo(b) == 2) {
        // lista + lista: una lista nueva con los elementos de ambas.
        sea r = vec_nuevo()
        sea x = dyn_dato(a)
        sea y = dyn_dato(b)
        sea i = 0
        mientras (i < vec_largo(x)) {
            vec_agregar(r, vec_obtener(x, i))
            i = i + 1
        }
        i = 0
        mientras (i < vec_largo(y)) {
            vec_agregar(r, vec_obtener(y, i))
            i = i + 1
        }
        retornar dyn_caja(2, r)
    }
    si (dyn_tipo(a) == 1) { retornar dyn_texto_sumar(a, b) }
    si (dyn_tipo(b) == 1) {
        sea r = str_nuevo(16)
        dyn_agregar_valor(r, a, 0)
        dyn_agregar_valor(r, b, 0)
        retornar dyn_texto(r)
    }
    retornar dyn_desde_f64(__f64_suma(dyn_a_f64(a), dyn_a_f64(b)))
}

funcion dyn_resta(a, b) {
    si (dyn_ambos_enteros(a, b)) { retornar dyn_resta_entera(a, b) }
    si (dyn_ambos_enteros_gr(a, b)) { retornar dyn_gr_op_resta(a, b) }
    si (dyn_tipo(a) == 8 y __y_bits(b, 1) == 1) { retornar dyn_puntero(__cargar64(dyn_dato(a)), __cargar64(dyn_dato(a) + 8) - dyn_valor_entero(b)) }
    retornar dyn_desde_f64(__f64_resta(dyn_a_f64(a), dyn_a_f64(b)))
}

funcion dyn_mul(a, b) {
    si (dyn_ambos_enteros(a, b)) { retornar dyn_mul_entera(a, b) }
    si (dyn_ambos_enteros_gr(a, b)) { retornar dyn_gr_op_mul(a, b) }
    retornar dyn_desde_f64(__f64_mul(dyn_a_f64(a), dyn_a_f64(b)))
}

funcion dyn_div(a, b) {
    si (dyn_ambos_enteros(a, b)) {
        sea x = dyn_valor_entero(a)
        sea y = dyn_valor_entero(b)
        si (y == 0) { dyn_error("división por cero") }
        si (x % y == 0) { retornar cociente(a, b) }
    }
    si (dyn_ambos_enteros(a, b) == 0 y dyn_ambos_enteros_gr(a, b)) {
        // Exacta si el resto es cero; si no, como siempre, decimal.
        si (dyn_gr_op_dividir(a, b, 1) == 1) { retornar dyn_gr_op_dividir(a, b, 0) }
    }
    retornar dyn_desde_f64(__f64_div(dyn_a_f64(a), dyn_a_f64(b)))
}

funcion dyn_mod(a, b) {
    si (dyn_ambos_enteros(a, b)) {
        sea y = dyn_valor_entero(b)
        si (y == 0) { dyn_error("división por cero") }
        retornar dyn_entero(dyn_valor_entero(a) % y)
    }
    si (dyn_ambos_enteros_gr(a, b)) { retornar dyn_gr_op_dividir(a, b, 1) }
    // fmod: a - trunc(a / b) * b
    sea x = dyn_a_f64(a)
    sea y = dyn_a_f64(b)
    sea cociente = __f64_desde_entero(__f64_a_entero(__f64_div(x, y)))
    retornar dyn_desde_f64(__f64_resta(x, __f64_mul(cociente, y)))
}

funcion dyn_neg(a) {
    si (__y_bits(a, 1) == 1) { retornar dyn_resta_entera(1, a) }
    si (dyn_tipo(a) == 12) { retornar dyn_gr_negar(a) }
    retornar dyn_desde_f64(__f64_resta(__f64_desde_entero(0), dyn_a_f64(a)))
}

funcion dyn_no(a) { retornar dyn_bool(dyn_verdad(a) == 0) }

funcion dyn_igual_crudo(a, b) { retornar dyn_igual_prof(a, b, 0) }

// Listas y mapas se comparan por contenido (como en Python o JavaScript con
// deepEqual); las instancias de clase, por identidad. prof corta los ciclos.
funcion dyn_igual_prof(a, b, prof) {
    si (a == b) { retornar 1 }
    sea ta = dyn_tipo(a)
    sea tb = dyn_tipo(b)
    si (ta == 1 y tb == 1) { retornar str_igual(dyn_dato(a), dyn_dato(b)) }
    si (ta == 2 y tb == 2) {
        si (prof > 200) { retornar 0 }
        sea x = dyn_dato(a)
        sea y = dyn_dato(b)
        sea n = vec_largo(x)
        si (n != vec_largo(y)) { retornar 0 }
        sea i = 0
        mientras (i < n) {
            si (dyn_igual_prof(vec_obtener(x, i), vec_obtener(y, i), prof + 1) == 0) { retornar 0 }
            i = i + 1
        }
        retornar 1
    }
    si (ta == 3 y tb == 3) {
        si (prof > 200) { retornar 0 }
        sea x = dyn_dato(a)
        sea y = dyn_dato(b)
        si (map_buscar(x, "__clase") >= 0 o map_buscar(y, "__clase") >= 0) { retornar 0 }
        si (map_tamano(x) != map_tamano(y)) { retornar 0 }
        sea i = 0
        sea n = map_entradas(x)
        mientras (i < n) {
            sea k = map_clave_en(x, i)
            si (k != 0) {
                sea e = map_buscar(y, k)
                si (e < 0) { retornar 0 }
                si (dyn_igual_prof(map_valor_en(x, i), map_valor_en(y, e), prof + 1) == 0) { retornar 0 }
            }
            i = i + 1
        }
        retornar 1
    }
    si (ta == 11 y tb == 11) { retornar dyn_dato(a) == dyn_dato(b) }
    si (dyn_es_numero(a) y dyn_es_numero(b)) {
        si (ta == 6 y tb == 6) { retornar 0 }
        si ((ta == 6 o ta == 12) y (tb == 6 o tb == 12)) { retornar dyn_gr_op_comparar(a, b) == 0 }
        sea x = dyn_a_f64(a)
        sea y = dyn_a_f64(b)
        retornar __f64_menor(x, y) == 0 y __f64_menor(y, x) == 0
    }
    retornar 0
}

funcion dyn_igual(a, b) { retornar dyn_bool(dyn_igual_crudo(a, b)) }
// ¿Son el mismo objeto? (identidad: la lista o el mapa exactos, no una copia).
funcion es_mismo(a, b) { retornar dyn_bool(a == b) }
funcion dyn_distinto(a, b) { retornar dyn_bool(dyn_igual_crudo(a, b) == 0) }

// -1, 0 o 1 para números o textos.
funcion dyn_comparar(a, b) {
    si (dyn_ambos_enteros(a, b)) {
        si (a < b) { retornar 0 - 1 }
        si (a > b) { retornar 1 }
        retornar 0
    }
    si (dyn_ambos_enteros_gr(a, b)) { retornar dyn_gr_op_comparar(a, b) }
    si (dyn_tipo(a) == 1 y dyn_tipo(b) == 1) {
        sea x = dyn_dato(a)
        sea y = dyn_dato(b)
        sea i = 0
        mientras (i < str_largo(x) y i < str_largo(y)) {
            sea cx = str_byte(x, i)
            sea cy = str_byte(y, i)
            si (cx < cy) { retornar 0 - 1 }
            si (cx > cy) { retornar 1 }
            i = i + 1
        }
        si (str_largo(x) < str_largo(y)) { retornar 0 - 1 }
        si (str_largo(x) > str_largo(y)) { retornar 1 }
        retornar 0
    }
    sea fx = dyn_a_f64(a)
    sea fy = dyn_a_f64(b)
    si (__f64_menor(fx, fy)) { retornar 0 - 1 }
    si (__f64_menor(fy, fx)) { retornar 1 }
    retornar 0
}

funcion dyn_menor(a, b) { retornar dyn_bool(dyn_comparar(a, b) < 0) }
funcion dyn_menor_igual(a, b) { retornar dyn_bool(dyn_comparar(a, b) <= 0) }
funcion dyn_mayor(a, b) { retornar dyn_bool(dyn_comparar(a, b) > 0) }
funcion dyn_mayor_igual(a, b) { retornar dyn_bool(dyn_comparar(a, b) >= 0) }

// ── Indexación e iteración ────────────────────────────────────────────────

funcion dyn_indice_lista(l, i) {
    si (dyn_tipo(i) == 12) { dyn_error("índice de lista inválido") }
    si (__y_bits(i, 1) != 1) { dyn_error("el índice de lista debe ser un número entero") }
    sea n = dyn_valor_entero(i)
    si (n < 0 o n >= vec_largo(l)) { dyn_error("índice de lista inválido") }
    retornar n
}

funcion dyn_clave(k) {
    si (dyn_tipo(k) != 1) { dyn_error("la clave debe ser texto") }
    retornar dyn_dato(k)
}

funcion dyn_indice(c, k) {
    sea t = dyn_tipo(c)
    si (t == 2) {
        sea l = dyn_dato(c)
        retornar vec_obtener(l, dyn_indice_lista(l, k))
    }
    si (t == 3) {
        sea m = dyn_dato(c)
        sea e = map_buscar(m, dyn_clave(k))
        si (e < 0) { dyn_error("clave inexistente") }
        retornar map_valor_en(m, e)
    }
    si (t == 1) {
        sea s = dyn_dato(c)
        si (__y_bits(k, 1) != 1) { dyn_error("el índice de texto debe ser un número entero") }
        sea n = dyn_valor_entero(k)
        si (n < 0 o n >= str_largo(s)) { dyn_error("índice de texto inválido") }
        retornar dyn_texto(str_rebanar(s, n, n + 1))
    }
    dyn_error_tipo("no se puede indexar", c)
    retornar 0
}

// c[k] seguido de ??: nulo si el contenedor es nulo, la clave no existe o el
// índice está fuera de rango.
funcion dyn_indice_opcional(c, k) {
    si (c == 0) { retornar 0 }
    sea t = dyn_tipo(c)
    si (t == 3) {
        sea m = dyn_dato(c)
        sea e = map_buscar(m, dyn_clave(k))
        si (e < 0) { retornar 0 }
        retornar map_valor_en(m, e)
    }
    si (t == 2) {
        sea l = dyn_dato(c)
        si (__y_bits(k, 1) == 1) {
            sea n = dyn_valor_entero(k)
            si (n < 0 o n >= vec_largo(l)) { retornar 0 }
        }
    }
    retornar dyn_indice(c, k)
}

// valor.campo: campo de un mapa/instancia; .longitud de listas y textos.
funcion dyn_campo(c, k) {
    sea t = dyn_tipo(c)
    si (t == 3) { retornar dyn_indice(c, k) }
    si ((t == 1 o t == 2) y (str_igual(dyn_dato(k), "longitud") o str_igual(dyn_dato(k), "largo") o str_igual(dyn_dato(k), "length"))) {
        retornar longitud(c)
    }
    si (t == 0) { dyn_error(str_concatenar("acceso a campo de nulo: ", dyn_dato(k))) }
    dyn_error_tipo(str_concatenar("no tiene el campo ", dyn_dato(k)), c)
    retornar 0
}

// Resultado/Opción: ¿es un fallo? (raw 0/1) — {"ok": falso} o {"presente": falso}
funcion dyn_es_fallo(v) {
    si (dyn_tipo(v) != 3) { retornar 0 }
    sea m = dyn_dato(v)
    si (map_obtener_o(m, "ok", 0) == 2) { retornar 1 }
    si (map_obtener_o(m, "presente", 0) == 2) { retornar 1 }
    retornar 0
}

// coincidir: ¿v es la variante k? (1 Ok, 2 Error, 3 Alguno, 4 Ninguno).
// Devuelve 0/1 crudo.
funcion dyn_variante(v, k) {
    si (dyn_tipo(v) != 3) { retornar 0 }
    sea m = dyn_dato(v)
    si (k <= 2) {
        si (map_tiene(m, "ok") == 0) { retornar 0 }
        sea ok = map_obtener(m, "ok") == 4
        si (k == 1) { retornar ok }
        retornar ok == 0
    }
    si (map_tiene(m, "presente") == 0) { retornar 0 }
    sea p = map_obtener(m, "presente") == 4
    si (k == 3) { retornar p }
    retornar p == 0
}

// Lo que envuelve la variante: el error para Error(e), el valor si no.
funcion dyn_variante_valor(v, k) {
    sea m = dyn_dato(v)
    si (k == 2) { retornar map_obtener_o(m, "error", 0) }
    retornar map_obtener_o(m, "valor", 0)
}

funcion dyn_desenvolver(v) {
    si (dyn_tipo(v) != 3) { retornar v }
    sea m = dyn_dato(v)
    si (map_tiene(m, "valor") y (map_tiene(m, "ok") o map_tiene(m, "presente"))) { retornar map_obtener(m, "valor") }
    retornar v
}

funcion dyn_fijar_indice(c, k, v) {
    sea t = dyn_tipo(c)
    si (t == 2) {
        sea l = dyn_dato(c)
        vec_fijar(l, dyn_indice_lista(l, k), v)
        retornar 0
    }
    si (t == 3) {
        map_fijar(dyn_dato(c), dyn_clave(k), v)
        retornar 0
    }
    dyn_error_tipo("no se puede asignar por índice", c)
    retornar 0
}

// Para "para x en c": cantidad de elementos (entero crudo) y elemento i.
funcion dyn_iter_largo(c) {
    sea t = dyn_tipo(c)
    si (t == 2) { retornar vec_largo(dyn_dato(c)) }
    si (t == 1) { retornar str_largo(dyn_dato(c)) }
    dyn_error_tipo("no se puede recorrer", c)
    retornar 0
}

funcion dyn_iter_obtener(c, i) {
    si (dyn_tipo(c) == 2) { retornar vec_obtener(dyn_dato(c), i) }
    retornar dyn_texto(str_rebanar(dyn_dato(c), i, i + 1))
}

// ── Funciones del lenguaje ────────────────────────────────────────────────

funcion mostrar(v) {
    rt_mostrar(dyn_a_str(v))
    retornar 0
}

// Como mostrar, pero sin salto de línea (barras de progreso, prompts…).
funcion escribir(v) {
    rt_escribir_texto(1, dyn_a_str(v))
    retornar 0
}

funcion afirmar(condicion, mensaje) {
    si (dyn_verdad(condicion) == 0) { dyn_error(dyn_a_str(mensaje)) }
    retornar 0
}

funcion a_texto(v) {
    si (dyn_tipo(v) == 1) { retornar v }
    retornar dyn_texto(dyn_a_str(v))
}

funcion longitud(v) {
    sea t = dyn_tipo(v)
    si (t == 2) { retornar dyn_entero(vec_largo(dyn_dato(v))) }
    si (t == 1) { retornar dyn_entero(str_largo(dyn_dato(v))) }
    si (t == 3) { retornar dyn_entero(map_tamano(dyn_dato(v))) }
    dyn_error_tipo("longitud", v)
    retornar 0
}

funcion agregar(l, v) {
    si (dyn_tipo(l) != 2) { dyn_error_tipo("agregar", l) }
    vec_agregar(dyn_dato(l), v)
    retornar 0
}

funcion claves(m) {
    si (dyn_tipo(m) != 3) { dyn_error_tipo("claves", m) }
    sea crudas = dyn_claves_ordenadas(dyn_dato(m))
    sea r = vec_nuevo()
    sea i = 0
    mientras (i < vec_largo(crudas)) {
        vec_agregar(r, dyn_texto(vec_obtener(crudas, i)))
        i = i + 1
    }
    vec_liberar(crudas)
    retornar dyn_caja(2, r)
}

funcion tiene_clave(m, k) {
    si (dyn_tipo(m) != 3) { dyn_error_tipo("tiene_clave", m) }
    retornar dyn_bool(map_tiene(dyn_dato(m), dyn_clave(k)))
}

funcion quitar_clave(m, k) {
    si (dyn_tipo(m) != 3) { dyn_error_tipo("quitar_clave", m) }
    retornar dyn_bool(map_quitar(dyn_dato(m), dyn_clave(k)))
}

funcion lista_rango(inicio, fin) {
    si (__y_bits(inicio, 1) != 1 o __y_bits(fin, 1) != 1) { dyn_error("lista_rango: se esperaban enteros") }
    sea r = vec_nuevo()
    sea i = dyn_valor_entero(inicio)
    sea n = dyn_valor_entero(fin)
    si (n - i > dyn_max_elementos()) { dyn_error("lista_rango: demasiados elementos") }
    mientras (i < n) {
        vec_agregar(r, dyn_entero(i))
        i = i + 1
    }
    retornar dyn_caja(2, r)
}

funcion lista_invertir(l) {
    si (dyn_tipo(l) != 2) { dyn_error_tipo("lista_invertir", l) }
    sea origen = dyn_dato(l)
    sea r = vec_nuevo()
    sea i = vec_largo(origen) - 1
    mientras (i >= 0) {
        vec_agregar(r, vec_obtener(origen, i))
        i = i - 1
    }
    retornar dyn_caja(2, r)
}

funcion lista_contiene(l, v) {
    si (dyn_tipo(l) != 2) { dyn_error_tipo("lista_contiene", l) }
    sea origen = dyn_dato(l)
    sea i = 0
    mientras (i < vec_largo(origen)) {
        si (dyn_igual_crudo(vec_obtener(origen, i), v)) { retornar 4 }
        i = i + 1
    }
    retornar 2
}

funcion quitar_ultimo(l) {
    si (dyn_tipo(l) != 2) { dyn_error_tipo("quitar_ultimo", l) }
    si (vec_largo(dyn_dato(l)) == 0) { dyn_error("quitar_ultimo: la lista está vacía") }
    retornar vec_quitar_ultimo(dyn_dato(l))
}

funcion piso(v) {
    si (dyn_gr_es_entero(v)) { retornar v }
    sea x = dyn_a_f64(v)
    sea e = __f64_a_entero(x)
    si (__f64_menor(x, __f64_desde_entero(e))) { e = e - 1 }
    retornar dyn_entero(e)
}

funcion techo(v) {
    si (dyn_gr_es_entero(v)) { retornar v }
    sea x = dyn_a_f64(v)
    sea e = __f64_a_entero(x)
    si (__f64_menor(__f64_desde_entero(e), x)) { e = e + 1 }
    retornar dyn_entero(e)
}

funcion a_numero(v) {
    si (dyn_es_numero(v)) { retornar v }
    sea s = dyn_texto_de(v, "a_numero")
    sea i = 0
    sea n = str_largo(s)
    sea negativo = 0
    si (n > 0 y (str_byte(s, 0) == 45 o str_byte(s, 0) == 43)) {
        negativo = str_byte(s, 0) == 45
        i = 1
    }
    // Solo cifras y más de 18: entero exacto (sin límite).
    si (n - i > 18) {
        sea todas = 1
        sea k = i
        mientras (k < n y todas) {
            si (str_byte(s, k) < 48 o str_byte(s, k) > 57) { todas = 0 }
            k = k + 1
        }
        si (todas) { retornar dyn_gr_desde_cifras(s, i, n, negativo) }
    }
    // M con hasta 18 cifras significativas y exponente decimal E.
    sea m = 0
    sea e = 0
    sea cifras = 0
    sea digitos = 0
    mientras (i < n y str_byte(s, i) >= 48 y str_byte(s, i) <= 57) {
        si (cifras < 18) {
            m = m * 10 + str_byte(s, i) - 48
            si (m > 0) { cifras = cifras + 1 }
        } sino { e = e + 1 }
        digitos = digitos + 1
        i = i + 1
    }
    si (i < n y str_byte(s, i) == 46) {
        i = i + 1
        mientras (i < n y str_byte(s, i) >= 48 y str_byte(s, i) <= 57) {
            si (cifras < 18) {
                m = m * 10 + str_byte(s, i) - 48
                e = e - 1
                si (m > 0) { cifras = cifras + 1 }
            }
            digitos = digitos + 1
            i = i + 1
        }
    }
    si (digitos > 0 y i < n y (str_byte(s, i) == 101 o str_byte(s, i) == 69)) {
        sea j = i + 1
        sea signo = 1
        si (j < n y (str_byte(s, j) == 45 o str_byte(s, j) == 43)) {
            si (str_byte(s, j) == 45) { signo = 0 - 1 }
            j = j + 1
        }
        sea x = 0
        sea hay = 0
        mientras (j < n y str_byte(s, j) >= 48 y str_byte(s, j) <= 57) {
            si (x < 100000) { x = x * 10 + str_byte(s, j) - 48 }
            hay = 1
            j = j + 1
        }
        si (hay) {
            e = e + signo * x
            i = j
        }
    }
    si (digitos == 0 o i != n) { dyn_error(str_concatenar("no es un número: ", s)) }
    sea valor = rt_decimal_a_f64(m, e)
    si (negativo) { valor = __f64_resta(__f64_desde_entero(0), valor) }
    retornar dyn_desde_f64(valor)
}

// cociente(a, b): división entera truncada (7, 2 → 3; -7, 2 → -3). El
// compilador la hace en línea cuando los dos son enteros.
funcion cociente(a, b) {
    si (__y_bits(a, 1) == 1 y __y_bits(b, 1) == 1) {
        si (dyn_valor_entero(b) == 0) { dyn_error("división por cero") }
        sea x = dyn_valor_entero(a)
        sea y = dyn_valor_entero(b)
        si (y == 0 - 1) { retornar dyn_resta_entera(1, a) }       // -MIN no cabe
        retornar dyn_entero(x / y)
    }
    si (dyn_ambos_enteros_gr(a, b)) { retornar dyn_gr_op_dividir(a, b, 0) }
    sea x = dyn_a_f64(a)
    sea y = dyn_a_f64(b)
    retornar dyn_entero(__f64_a_entero(__f64_div(x, y)))
}

// Operaciones de bits entre enteros (el compilador las hace en línea).
funcion bits_entero(v, que) {
    // Entero grande: sus 64 bits bajos en complemento a dos (como el
    // desborde de antes), para que el código de hash y cifrado que hace
    // x * y y luego enmascara con bits_y siga dando lo mismo.
    si (dyn_tipo(v) == 12) { retornar dyn_gr_bajos64(dyn_dato(v)) }
    si (__y_bits(v, 1) != 1) { dyn_error(str_concatenar(que, ": se esperaban enteros")) }
    retornar dyn_valor_entero(v)
}
funcion bits_y(a, b) { retornar dyn_entero_de_crudo(__y_bits(bits_entero(a, "bits_y"), bits_entero(b, "bits_y"))) }
funcion bits_o(a, b) { retornar dyn_entero_de_crudo(__o_bits(bits_entero(a, "bits_o"), bits_entero(b, "bits_o"))) }
funcion bits_xo(a, b) { retornar dyn_entero_de_crudo(__xo_bits(bits_entero(a, "bits_xo"), bits_entero(b, "bits_xo"))) }

// Entero crudo de 64 bits → valor del lenguaje (chico o grande).
funcion dyn_entero_de_crudo(x) {
    si (x >= 0 - 4611686018427387904 y x < 4611686018427387904) { retornar dyn_entero(x) }
    retornar dyn_gr_valor(dyn_gr_desde_crudo(x))
}

funcion tipo_de(v) { retornar dyn_texto(dyn_nombre_tipo(v)) }

funcion dyn_cambiar_letras(v, desde, hasta, operacion) {
    sea s = dyn_texto_de(v, operacion)
    sea r = str_nuevo(str_largo(s))
    sea i = 0
    mientras (i < str_largo(s)) {
        sea b = str_byte(s, i)
        si (b >= desde y b <= hasta) { b = __xo_bits(b, 32) }
        str_agregar_byte(r, b)
        i = i + 1
    }
    retornar dyn_texto(r)
}

funcion texto_mayusculas(v) { retornar dyn_cambiar_letras(v, 97, 122, "texto_mayusculas") }
funcion texto_minusculas(v) { retornar dyn_cambiar_letras(v, 65, 90, "texto_minusculas") }

// ── Punteros de bloques inseguro (con límites verificados) ───────────────

funcion dyn_puntero(bloque, desplazamiento) {
    sea r = mem_reservar(16)
    __guardar64(r, bloque)
    __guardar64(r + 8, desplazamiento)
    retornar dyn_caja(8, r)
}

// @x: puntero al inicio de un bloque (lista) o el mismo puntero.
funcion dyn_direccion(v) {
    si (dyn_tipo(v) == 8) { retornar v }
    si (dyn_tipo(v) != 2) { dyn_error_tipo("@ requiere un bloque de memoria", v) }
    retornar dyn_puntero(v, 0)
}

funcion dyn_posicion_puntero(p) {
    si (dyn_tipo(p) != 8) { dyn_error_tipo("* requiere un puntero", p) }
    sea bloque = __cargar64(dyn_dato(p))
    sea i = __cargar64(dyn_dato(p) + 8)
    si (i < 0 o i >= vec_largo(dyn_dato(bloque))) { dyn_error("acceso inseguro fuera del bloque de memoria") }
    retornar i
}

funcion dyn_leer_puntero(p) {
    sea i = dyn_posicion_puntero(p)
    retornar vec_obtener(dyn_dato(__cargar64(dyn_dato(p))), i)
}

funcion dyn_escribir_puntero(p, v) {
    sea i = dyn_posicion_puntero(p)
    vec_fijar(dyn_dato(__cargar64(dyn_dato(p))), i, v)
    retornar 0
}

funcion memoria_asignar(n) {
    sea r = vec_nuevo()
    sea i = 0
    mientras (i < dyn_valor_entero(n)) {
        vec_agregar(r, 1)
        i = i + 1
    }
    retornar dyn_caja(2, r)
}

funcion memoria_liberar(bloque) {
    si (dyn_tipo(bloque) == 2) { __guardar64(dyn_dato(bloque), 0) }
    retornar 0
}

// ── comptime ──────────────────────────────────────────────────────────────
// El compilador ejecuta comptime(expr) en un subproceso; el valor vuelve como
// un literal del lenguaje (nulo, booleano, número, texto, lista o mapa).

funcion comptime_literal(v) {
    sea s = str_nuevo(64)
    comptime_escribir(s, v)
    retornar dyn_texto(s)
}

funcion comptime_escribir(s, v) {
    sea t = dyn_tipo(v)
    si (t == 0) { str_agregar(s, "nulo") retornar 0 }
    si (v == 4) { str_agregar(s, "verdadero") retornar 0 }
    si (v == 2) { str_agregar(s, "falso") retornar 0 }
    si (t == 6 o t == 12) { str_agregar(s, dyn_a_str(v)) retornar 0 }
    si (t == 4) {
        sea n = dyn_a_str(v)
        sea i = 0
        sea decimal = 0
        mientras (i < str_largo(n)) {
            sea b = str_byte(n, i)
            si (b == 46 o b == 101 o b == 69) { decimal = 1 }
            si (b == 110 o b == 105) { dyn_error("comptime: un número no finito no se puede escribir como literal") }
            i = i + 1
        }
        str_agregar(s, n)
        si (decimal == 0) { str_agregar(s, ".0") }
        retornar 0
    }
    si (t == 1) {
        sea x = dyn_dato(v)
        str_agregar_byte(s, 34)
        sea i = 0
        mientras (i < str_largo(x)) {
            sea b = str_byte(x, i)
            si (b == 34 o b == 92 o b == 123) {
                str_agregar_byte(s, 92)
                str_agregar_byte(s, b)
            } sino {
                si (b == 10) { str_agregar(s, "\\n") } sino {
                    si (b == 9) { str_agregar(s, "\\t") } sino {
                        si (b == 13) { str_agregar(s, "\\r") } sino { str_agregar_byte(s, b) }
                    }
                }
            }
            i = i + 1
        }
        str_agregar_byte(s, 34)
        retornar 0
    }
    si (t == 2) {
        sea l = dyn_dato(v)
        str_agregar(s, "[")
        sea i = 0
        mientras (i < vec_largo(l)) {
            si (i > 0) { str_agregar(s, ", ") }
            comptime_escribir(s, vec_obtener(l, i))
            i = i + 1
        }
        str_agregar(s, "]")
        retornar 0
    }
    si (t == 3) {
        sea m = dyn_dato(v)
        si (map_tiene(m, "__clase")) { dyn_error("comptime: un objeto no se puede escribir como literal (usa listas o mapas)") }
        sea k = dyn_claves_ordenadas(m)
        str_agregar(s, "{")
        sea i = 0
        mientras (i < vec_largo(k)) {
            si (i > 0) { str_agregar(s, ", ") }
            comptime_escribir(s, dyn_texto(vec_obtener(k, i)))
            str_agregar(s, ": ")
            comptime_escribir(s, map_obtener(m, vec_obtener(k, i)))
            i = i + 1
        }
        str_agregar(s, "}")
        retornar 0
    }
    dyn_error_tipo("comptime: no se puede escribir como literal", v)
    retornar 0
}

// ── Enteros sin límite ───────────────────────────────────────────────────
// Un entero chico es una palabra etiquetada (n·2+1, rango [-2^62, 2^62)).
// Si una operación no cabe, el resultado es una caja de tipo 12 con
// [signo (1 o -1)][n][cifras]* en base 10^9, de la menos significativa a la
// más significativa y sin ceros a la izquierda. Al volver a caber, el
// resultado se normaliza a entero chico: un mismo número tiene siempre una
// sola representación.

funcion dyn_gr_base() { retornar 1000000000 }

funcion dyn_gr_nuevo(n) {
    sea g = mem_reservar(16 + n * 8)
    __guardar64(g, 1)
    __guardar64(g + 8, n)
    sea i = 0
    mientras (i < n) {
        __guardar64(g + 16 + i * 8, 0)
        i = i + 1
    }
    retornar g
}
funcion dyn_gr_signo(g) { retornar __cargar64(g) }
funcion dyn_gr_largo(g) { retornar __cargar64(g + 8) }
funcion dyn_gr_cifra(g, i) {
    si (i >= __cargar64(g + 8)) { retornar 0 }
    retornar __cargar64(g + 16 + i * 8)
}
funcion dyn_gr_fijar(g, i, d) { __guardar64(g + 16 + i * 8, d) retornar 0 }

// Entero crudo de 64 bits (incluido el mínimo) → grande.
funcion dyn_gr_desde_crudo(x) {
    sea g = dyn_gr_nuevo(3)
    si (x < 0) { __guardar64(g, 0 - 1) }
    sea i = 0
    mientras (x != 0) {
        sea d = x % 1000000000
        si (d < 0) { d = 0 - d }
        dyn_gr_fijar(g, i, d)
        x = x / 1000000000
        i = i + 1
    }
    __guardar64(g + 8, i)
    retornar g
}

// ¿Es un entero del lenguaje (chico o grande)?
funcion dyn_gr_es_entero(v) {
    si (__y_bits(v, 1) == 1) { retornar 1 }
    retornar dyn_tipo(v) == 12
}

funcion dyn_gr_de(v) {
    si (__y_bits(v, 1) == 1) { retornar dyn_gr_desde_crudo(dyn_valor_entero(v)) }
    retornar dyn_dato(v)
}

// Quita ceros a la izquierda y devuelve el valor del lenguaje: entero chico
// si cabe, si no la caja.
funcion dyn_gr_valor(g) {
    sea n = dyn_gr_largo(g)
    mientras (n > 0 y dyn_gr_cifra(g, n - 1) == 0) { n = n - 1 }
    __guardar64(g + 8, n)
    si (n == 0) { retornar 1 }
    si (n <= 3 y dyn_gr_cifra(g, 2) <= 4) {
        sea m = dyn_gr_cifra(g, 2) * 1000000000000000000 + dyn_gr_cifra(g, 1) * 1000000000 + dyn_gr_cifra(g, 0)
        sea limite = 4611686018427387904
        si (dyn_gr_signo(g) > 0 y m < limite) { retornar dyn_entero(m) }
        si (dyn_gr_signo(g) < 0 y m <= limite) { retornar dyn_entero(0 - m) }
    }
    retornar dyn_caja(12, g)
}

// Compara magnitudes: -1, 0 o 1.
funcion dyn_gr_comparar_mag(a, b) {
    sea na = dyn_gr_largo(a)
    sea nb = dyn_gr_largo(b)
    si (na != nb) {
        si (na < nb) { retornar 0 - 1 }
        retornar 1
    }
    sea i = na - 1
    mientras (i >= 0) {
        sea x = dyn_gr_cifra(a, i)
        sea y = dyn_gr_cifra(b, i)
        si (x < y) { retornar 0 - 1 }
        si (x > y) { retornar 1 }
        i = i - 1
    }
    retornar 0
}

funcion dyn_gr_es_cero(g) { retornar dyn_gr_largo(g) == 0 }

funcion dyn_gr_comparar(a, b) {
    sea sa = dyn_gr_signo(a)
    sea sb = dyn_gr_signo(b)
    si (dyn_gr_es_cero(a)) { sa = 0 }
    si (dyn_gr_es_cero(b)) { sb = 0 }
    si (sa != sb) {
        si (sa < sb) { retornar 0 - 1 }
        retornar 1
    }
    si (sa == 0) { retornar 0 }
    retornar dyn_gr_comparar_mag(a, b) * sa
}

// |a| + |b| con signo s.
funcion dyn_gr_sumar_mag(a, b, s) {
    sea n = dyn_gr_maximo(dyn_gr_largo(a), dyn_gr_largo(b)) + 1
    sea r = dyn_gr_nuevo(n)
    __guardar64(r, s)
    sea acarreo = 0
    sea i = 0
    mientras (i < n) {
        sea t = dyn_gr_cifra(a, i) + dyn_gr_cifra(b, i) + acarreo
        acarreo = 0
        si (t >= 1000000000) {
            t = t - 1000000000
            acarreo = 1
        }
        dyn_gr_fijar(r, i, t)
        i = i + 1
    }
    retornar r
}

// |a| - |b| (|a| >= |b|) con signo s.
funcion dyn_gr_restar_mag(a, b, s) {
    sea n = dyn_gr_largo(a)
    sea r = dyn_gr_nuevo(n)
    __guardar64(r, s)
    sea prestamo = 0
    sea i = 0
    mientras (i < n) {
        sea t = dyn_gr_cifra(a, i) - dyn_gr_cifra(b, i) - prestamo
        prestamo = 0
        si (t < 0) {
            t = t + 1000000000
            prestamo = 1
        }
        dyn_gr_fijar(r, i, t)
        i = i + 1
    }
    retornar r
}

funcion dyn_gr_maximo(a, b) {
    si (a > b) { retornar a }
    retornar b
}

// a + b·sb (sb = 1 suma, -1 resta).
funcion dyn_gr_sumar(a, b, sb) {
    sea signo_b = dyn_gr_signo(b) * sb
    si (dyn_gr_signo(a) == signo_b) { retornar dyn_gr_sumar_mag(a, b, dyn_gr_signo(a)) }
    sea c = dyn_gr_comparar_mag(a, b)
    si (c == 0) { retornar dyn_gr_nuevo(0) }
    si (c > 0) { retornar dyn_gr_restar_mag(a, b, dyn_gr_signo(a)) }
    retornar dyn_gr_restar_mag(b, a, signo_b)
}

// Multiplicación de magnitudes sobre cifras crudas (base 10^9).
// r[0..na+nb) = a[0..na) · b[0..nb). Escolar para operandos chicos y
// Karatsuba para los grandes; tmp es memoria de trabajo (≥ 4·max + 256).
funcion dyn_gr_mul_escolar(r, a, na, b, nb) {
    // Por columnas: cada producto (< 2^60) se parte en 32 bits altos y bajos
    // y la división por 10^9 se hace una vez por columna, no por producto.
    // Requiere min(na, nb) < 2^20 (aquí siempre es < 64).
    si (na < nb) { retornar dyn_gr_mul_escolar(r, b, nb, a, na) }
    sea mascara = 4294967295
    sea acarreo = 0
    sea n = na + nb
    sea k = 0
    mientras (k < n - 1) {
        sea lo = acarreo
        sea hi = 0
        sea i = 0
        si (k >= nb) { i = k - nb + 1 }
        sea fin = k
        si (fin > na - 1) { fin = na - 1 }
        sea pa = a + i * 8
        sea pb = b + (k - i) * 8
        mientras (i <= fin) {
            sea p = __cargar64(pa) * __cargar64(pb)
            lo = lo + __y_bits(p, mascara)
            hi = hi + __desplazar_der(p, 32)
            pa = pa + 8
            pb = pb - 8
            i = i + 1
        }
        hi = hi + __desplazar_der(lo, 32)
        lo = __y_bits(lo, mascara)
        sea hq = hi / 1000000000
        sea medio = (hi - hq * 1000000000) * 4294967296 + lo
        sea mq = medio / 1000000000
        __guardar64(r + k * 8, medio - mq * 1000000000)
        acarreo = hq * 4294967296 + mq
        k = k + 1
    }
    __guardar64(r + (n - 1) * 8, acarreo)
    retornar 0
}

// r[0..n) += x[0..nx) (nx <= n); el acarreo que sobra se descarta.
funcion dyn_gr_sumar_en(r, n, x, nx) {
    sea acarreo = 0
    sea i = 0
    mientras (i < nx o (acarreo != 0 y i < n)) {
        sea t = __cargar64(r + i * 8) + acarreo
        si (i < nx) { t = t + __cargar64(x + i * 8) }
        acarreo = 0
        si (t >= 1000000000) {
            t = t - 1000000000
            acarreo = 1
        }
        __guardar64(r + i * 8, t)
        i = i + 1
    }
    retornar 0
}

// r[0..n) -= x[0..nx) (el resultado no es negativo).
funcion dyn_gr_restar_en(r, n, x, nx) {
    sea prestamo = 0
    sea i = 0
    mientras (i < nx o (prestamo != 0 y i < n)) {
        sea t = __cargar64(r + i * 8) - prestamo
        si (i < nx) { t = t - __cargar64(x + i * 8) }
        prestamo = 0
        si (t < 0) {
            t = t + 1000000000
            prestamo = 1
        }
        __guardar64(r + i * 8, t)
        i = i + 1
    }
    retornar 0
}

// s[0..m+1) = x[0..m) + y[0..ny) (ny <= m).
funcion dyn_gr_sumar_mitades(s, x, m, y, ny) {
    sea acarreo = 0
    sea i = 0
    mientras (i < m) {
        sea t = __cargar64(x + i * 8) + acarreo
        si (i < ny) { t = t + __cargar64(y + i * 8) }
        acarreo = 0
        si (t >= 1000000000) {
            t = t - 1000000000
            acarreo = 1
        }
        __guardar64(s + i * 8, t)
        i = i + 1
    }
    __guardar64(s + m * 8, acarreo)
    retornar 0
}

funcion dyn_gr_kara(r, a, na, b, nb, tmp) {
    si (na < nb) { retornar dyn_gr_kara(r, b, nb, a, na, tmp) }
    si (nb < 48) { retornar dyn_gr_mul_escolar(r, a, na, b, nb) }
    si (na >= 2 * nb) {
        // Desbalanceado: a por trozos del largo de b.
        sea i = 0
        mientras (i < na + nb) {
            __guardar64(r + i * 8, 0)
            i = i + 1
        }
        sea prod = tmp
        sea resto = tmp + (2 * nb + 2) * 8
        sea off = 0
        mientras (off < na) {
            sea largo = nb
            si (na - off < largo) { largo = na - off }
            dyn_gr_kara(prod, a + off * 8, largo, b, nb, resto)
            dyn_gr_sumar_en(r + off * 8, na + nb - off, prod, largo + nb)
            off = off + nb
        }
        retornar 0
    }
    sea m = (na + 1) / 2
    // z0 en r[0..2m), z2 en r[2m..na+nb)
    dyn_gr_kara(r, a, m, b, m, tmp)
    dyn_gr_kara(r + 2 * m * 8, a + m * 8, na - m, b + m * 8, nb - m, tmp)
    sea sa = tmp
    sea sb = tmp + (m + 1) * 8
    sea z1 = tmp + (2 * m + 2) * 8
    dyn_gr_sumar_mitades(sa, a, m, a + m * 8, na - m)
    dyn_gr_sumar_mitades(sb, b, m, b + m * 8, nb - m)
    dyn_gr_kara(z1, sa, m + 1, sb, m + 1, tmp + (4 * m + 4) * 8)
    dyn_gr_restar_en(z1, 2 * m + 2, r, 2 * m)
    dyn_gr_restar_en(z1, 2 * m + 2, r + 2 * m * 8, na + nb - 2 * m)
    // z1 cabe en na + nb - m cifras (las de arriba son cero)
    sea nz = 2 * m + 2
    si (nz > na + nb - m) { nz = na + nb - m }
    dyn_gr_sumar_en(r + m * 8, na + nb - m, z1, nz)
    retornar 0
}

// ── Multiplicación por NTT (operandos muy grandes) ───────────────────────
// Convolución exacta con tres primos p = c·2^k + 1 (< 2^30) y reconstrucción
// por CRT (Garner) a base 10^9. Los productos modulares usan Montgomery con
// R = 2^32 (sin divisiones). Cota: cada coeficiente < 10^18 · min(na, nb)
// < p1·p2·p3 ≈ 5,9·10^25 mientras min(na, nb) < 5·10^7 cifras.

// Montgomery: a·b·2^-32 mod p (a, b < p < 2^30).
funcion dyn_gr_mont(a, b, p, np) {
    sea t = a * b
    sea m = __y_bits(__y_bits(t, 4294967295) * np, 4294967295)
    t = __desplazar_der(t + m * p, 32)
    si (t >= p) { t = t - p }
    retornar t
}

// -p^-1 mod 2^32 (p impar).
funcion dyn_gr_mont_np(p) {
    sea inv = p
    sea i = 0
    mientras (i < 5) {
        sea x = __y_bits(p * inv, 4294967295)
        inv = __y_bits(inv * __y_bits(2 - x, 4294967295), 4294967295)
        i = i + 1
    }
    retornar __y_bits(4294967296 - inv, 4294967295)
}

funcion dyn_gr_potmod(b, e, p) {
    sea r = 1
    b = b % p
    mientras (e > 0) {
        si (__y_bits(e, 1) == 1) { r = r * b % p }
        b = b * b % p
        e = __desplazar_der(e, 1)
    }
    retornar r
}

// Transformada en el sitio de x[0..n) (n potencia de 2). raices[j] = w^j·R,
// j < n/2, con w raíz n-ésima primitiva (o su inversa), en forma Montgomery.
funcion dyn_gr_ntt(x, n, p, np, raices) {
    // permutación por inversión de bits
    sea j = 0
    sea i = 1
    mientras (i < n) {
        sea bit = __desplazar_der(n, 1)
        mientras (__y_bits(j, bit) != 0) {
            j = j - bit
            bit = __desplazar_der(bit, 1)
        }
        j = j + bit
        si (i < j) {
            sea t = __cargar64(x + i * 8)
            __guardar64(x + i * 8, __cargar64(x + j * 8))
            __guardar64(x + j * 8, t)
        }
        i = i + 1
    }
    sea largo = 2
    mientras (largo <= n) {
        sea mitad = __desplazar_der(largo, 1)
        sea paso = (n / largo) * 8
        sea bloque = 0
        mientras (bloque < n) {
            sea pu = x + bloque * 8
            sea pv = pu + mitad * 8
            sea pw = raices
            sea k = 0
            mientras (k < mitad) {
                sea u = __cargar64(pu)
                sea t = __cargar64(pv) * __cargar64(pw)
                sea m = __y_bits(__y_bits(t, 4294967295) * np, 4294967295)
                sea v = __desplazar_der(t + m * p, 32)
                si (v >= p) { v = v - p }
                sea s = u + v
                si (s >= p) { s = s - p }
                sea d = u - v
                si (d < 0) { d = d + p }
                __guardar64(pu, s)
                __guardar64(pv, d)
                pu = pu + 8
                pv = pv + 8
                pw = pw + paso
                k = k + 1
            }
            bloque = bloque + largo
        }
        largo = largo * 2
    }
    retornar 0
}

funcion dyn_gr_raices(raices, n, p, w) {
    sea r = 4294967296 % p
    sea j = 0
    mientras (j < __desplazar_der(n, 1)) {
        __guardar64(raices + j * 8, r)
        r = r * w % p
        j = j + 1
    }
    retornar 0
}

// Convolución de a y b (cifras crudas) módulo p en sal[0..n).
funcion dyn_gr_conv_mod(sal, a, na, b, nb, n, p, g, aux, raices) {
    sea i = 0
    mientras (i < n) {
        sea v = 0
        si (i < na) { v = __cargar64(a + i * 8) % p }
        __guardar64(sal + i * 8, v)
        i = i + 1
    }
    sea np = dyn_gr_mont_np(p)
    sea w = dyn_gr_potmod(g, (p - 1) / n, p)
    dyn_gr_raices(raices, n, p, w)
    dyn_gr_ntt(sal, n, p, np, raices)
    si (a == b y na == nb) {
        i = 0
        mientras (i < n) {
            sea v = __cargar64(sal + i * 8)
            __guardar64(sal + i * 8, dyn_gr_mont(v, v, p, np))
            i = i + 1
        }
    } sino {
        i = 0
        mientras (i < n) {
            sea v = 0
            si (i < nb) { v = __cargar64(b + i * 8) % p }
            __guardar64(aux + i * 8, v)
            i = i + 1
        }
        dyn_gr_ntt(aux, n, p, np, raices)
        i = 0
        mientras (i < n) {
            __guardar64(sal + i * 8, dyn_gr_mont(__cargar64(sal + i * 8), __cargar64(aux + i * 8), p, np))
            i = i + 1
        }
    }
    dyn_gr_raices(raices, n, p, dyn_gr_potmod(w, p - 2, p))
    dyn_gr_ntt(sal, n, p, np, raices)
    // valores = n·conv·R^-1: se escalan por n^-1·R² con un producto Montgomery
    sea rr = 4294967296 % p
    sea escala = dyn_gr_potmod(n, p - 2, p) * (rr * rr % p) % p
    i = 0
    mientras (i < n) {
        __guardar64(sal + i * 8, dyn_gr_mont(__cargar64(sal + i * 8), escala, p, np))
        i = i + 1
    }
    retornar 0
}

// r[0..na+nb) = a · b por NTT.
funcion dyn_gr_mul_ntt(r, a, na, b, nb) {
    sea n = 1
    mientras (n < na + nb) { n = n * 2 }
    sea p1 = 469762049
    sea p2 = 754974721
    sea p3 = 167772161
    sea bloque = mem_reservar(n * 8 * 5)
    sea c1 = bloque
    sea c2 = bloque + n * 8
    sea c3 = bloque + n * 16
    sea aux = bloque + n * 24
    sea raices = bloque + n * 32
    dyn_gr_conv_mod(c1, a, na, b, nb, n, p1, 3, aux, raices)
    dyn_gr_conv_mod(c2, a, na, b, nb, n, p2, 11, aux, raices)
    dyn_gr_conv_mod(c3, a, na, b, nb, n, p3, 3, aux, raices)
    // Garner: x = r1 + p1·(t2 + p2·t3)
    sea inv_p1_p2 = dyn_gr_potmod(p1 % p2, p2 - 2, p2)
    sea p1p2_p3 = (p1 % p3) * (p2 % p3) % p3
    sea inv_p1p2_p3 = dyn_gr_potmod(p1p2_p3, p3 - 2, p3)
    sea base = 1000000000
    // p1 = p1_hi·10^9 + p1_lo ; p1·p2 = q_hi·10^9 + q_lo
    sea p1p2 = p1 * p2
    sea q_hi = p1p2 / base
    sea q_lo = p1p2 - q_hi * base
    // acarreo de 3 cifras en base 10^9 (c0 + c1·B + c2·B²)
    sea k0 = 0
    sea k1 = 0
    sea k2 = 0
    sea total = na + nb
    sea i = 0
    mientras (i < total) {
        sea r1 = __cargar64(c1 + i * 8)
        sea r2 = __cargar64(c2 + i * 8)
        sea r3 = __cargar64(c3 + i * 8)
        sea t2 = (r2 - r1 % p2 + p2) % p2 * inv_p1_p2 % p2
        // x mod p3 con lo ya conocido
        sea y = (r1 % p3 + (p1 % p3) * t2) % p3
        sea t3 = (r3 - y + p3) % p3 * inv_p1p2_p3 % p3
        // x = r1 + p1·t2 + p1p2·t3  (en base 10^9 sumado al acarreo)
        sea x01 = r1 + p1 * t2
        sea d0 = k0 + x01 % base + q_lo * (t3 % base)
        sea d1 = k1 + x01 / base + q_hi * (t3 % base) + q_lo * (t3 / base)
        sea d2 = k2 + q_hi * (t3 / base)
        // normalizar: d0 → cifra
        sea c = d0 / base
        __guardar64(r + i * 8, d0 - c * base)
        d1 = d1 + c
        c = d1 / base
        k0 = d1 - c * base
        d2 = d2 + c
        c = d2 / base
        k1 = d2 - c * base
        k2 = c
        i = i + 1
    }
    mem_liberar(bloque)
    retornar 0
}

funcion dyn_gr_multiplicar(a, b) {
    sea na = dyn_gr_largo(a)
    sea nb = dyn_gr_largo(b)
    sea r = dyn_gr_nuevo(na + nb)
    __guardar64(r, dyn_gr_signo(a) * dyn_gr_signo(b))
    si (na == 0 o nb == 0) { retornar r }
    sea mayor = na
    si (nb > mayor) { mayor = nb }
    si (na < 48 o nb < 48) {
        dyn_gr_mul_escolar(r + 16, a + 16, na, b + 16, nb)
        retornar r
    }
    si (na >= 1500 y nb >= 1500) {
        dyn_gr_mul_ntt(r + 16, a + 16, na, b + 16, nb)
        retornar r
    }
    sea tmp = mem_reservar((4 * mayor + 256) * 8)
    dyn_gr_kara(r + 16, a + 16, na, b + 16, nb, tmp)
    mem_liberar(tmp)
    retornar r
}

// |g| · d + k con d, k < 10^9 (en una caja nueva, signo 1).
funcion dyn_gr_mul_chico(g, d) {
    sea n = dyn_gr_largo(g)
    sea r = dyn_gr_nuevo(n + 1)
    sea acarreo = 0
    sea i = 0
    mientras (i < n) {
        sea t = dyn_gr_cifra(g, i) * d + acarreo
        acarreo = t / 1000000000
        dyn_gr_fijar(r, i, t % 1000000000)
        i = i + 1
    }
    dyn_gr_fijar(r, n, acarreo)
    sea m = n + 1
    mientras (m > 0 y dyn_gr_cifra(r, m - 1) == 0) { m = m - 1 }
    __guardar64(r + 8, m)
    retornar r
}

// División truncada de magnitudes: devuelve [cociente][resto] (signo 1).
// División larga en base 10^9; cada cifra del cociente se busca por
// bisección (30 pasos), simple y exacta.
funcion dyn_gr_dividir_mag(a, b) {
    sea na = dyn_gr_largo(a)
    sea q = dyn_gr_nuevo(na)
    sea resto = dyn_gr_nuevo(0)
    sea i = na - 1
    mientras (i >= 0) {
        // resto = resto · 10^9 + a[i]
        sea nr = dyn_gr_nuevo(dyn_gr_largo(resto) + 1)
        dyn_gr_fijar(nr, 0, dyn_gr_cifra(a, i))
        sea j = 0
        mientras (j < dyn_gr_largo(resto)) {
            dyn_gr_fijar(nr, j + 1, dyn_gr_cifra(resto, j))
            j = j + 1
        }
        sea m = dyn_gr_largo(nr)
        mientras (m > 0 y dyn_gr_cifra(nr, m - 1) == 0) { m = m - 1 }
        __guardar64(nr + 8, m)
        resto = nr
        // mayor d con b·d <= resto
        sea bajo = 0
        sea alto = 999999999
        mientras (bajo < alto) {
            sea medio = (bajo + alto + 1) / 2
            si (dyn_gr_comparar_mag(dyn_gr_mul_chico(b, medio), resto) <= 0) { bajo = medio } sino { alto = medio - 1 }
        }
        si (bajo > 0) { resto = dyn_gr_restar_mag(resto, dyn_gr_mul_chico(b, bajo), 1) }
        sea mr = dyn_gr_largo(resto)
        mientras (mr > 0 y dyn_gr_cifra(resto, mr - 1) == 0) { mr = mr - 1 }
        __guardar64(resto + 8, mr)
        dyn_gr_fijar(q, i, bajo)
        i = i - 1
    }
    sea par = mem_reservar(16)
    __guardar64(par, q)
    __guardar64(par + 8, resto)
    retornar par
}

// Operaciones con valores del lenguaje (al menos uno grande o desbordado).
funcion dyn_gr_op_suma(a, b) { retornar dyn_gr_valor(dyn_gr_sumar(dyn_gr_de(a), dyn_gr_de(b), 1)) }
funcion dyn_gr_op_resta(a, b) { retornar dyn_gr_valor(dyn_gr_sumar(dyn_gr_de(a), dyn_gr_de(b), 0 - 1)) }
funcion dyn_gr_op_mul(a, b) { retornar dyn_gr_valor(dyn_gr_multiplicar(dyn_gr_de(a), dyn_gr_de(b))) }

// que: 0 cociente truncado · 1 resto (signo del dividendo).
funcion dyn_gr_op_dividir(a, b, que) {
    sea x = dyn_gr_de(a)
    sea y = dyn_gr_de(b)
    si (dyn_gr_es_cero(y)) { dyn_error("división por cero") }
    sea par = dyn_gr_dividir_mag(x, y)
    sea q = __cargar64(par)
    sea r = __cargar64(par + 8)
    __guardar64(q, dyn_gr_signo(x) * dyn_gr_signo(y))
    __guardar64(r, dyn_gr_signo(x))
    si (que == 0) { retornar dyn_gr_valor(q) }
    retornar dyn_gr_valor(r)
}

funcion dyn_gr_op_comparar(a, b) { retornar dyn_gr_comparar(dyn_gr_de(a), dyn_gr_de(b)) }

funcion dyn_gr_negar(v) {
    sea g = dyn_gr_de(v)
    sea r = dyn_gr_nuevo(dyn_gr_largo(g))
    __guardar64(r, 0 - dyn_gr_signo(g))
    sea i = 0
    mientras (i < dyn_gr_largo(g)) {
        dyn_gr_fijar(r, i, dyn_gr_cifra(g, i))
        i = i + 1
    }
    retornar dyn_gr_valor(r)
}

funcion dyn_gr_agregar_texto(s, g) {
    sea n = dyn_gr_largo(g)
    si (n == 0) {
        str_agregar_byte(s, 48)
        retornar 0
    }
    si (dyn_gr_signo(g) < 0) { str_agregar_byte(s, 45) }
    str_agregar_entero(s, dyn_gr_cifra(g, n - 1))
    sea i = n - 2
    mientras (i >= 0) {
        sea d = dyn_gr_cifra(g, i)
        sea p = 100000000
        mientras (p > 0) {
            str_agregar_byte(s, 48 + (d / p) % 10)
            p = p / 10
        }
        i = i - 1
    }
    retornar 0
}

funcion dyn_gr_a_f64(g) {
    sea x = __f64_desde_entero(0)
    sea base = __f64_desde_entero(1000000000)
    sea i = dyn_gr_largo(g) - 1
    mientras (i >= 0) {
        x = __f64_suma(__f64_mul(x, base), __f64_desde_entero(dyn_gr_cifra(g, i)))
        i = i - 1
    }
    si (dyn_gr_signo(g) < 0) { x = __f64_resta(__f64_desde_entero(0), x) }
    retornar x
}

// Cifras decimales s[desde, hasta) → valor del lenguaje (entero exacto).
funcion dyn_gr_desde_cifras(s, desde, hasta, negativo) {
    sea n = (hasta - desde + 8) / 9
    sea g = dyn_gr_nuevo(n)
    si (negativo) { __guardar64(g, 0 - 1) }
    sea i = 0
    sea fin = hasta
    mientras (i < n) {
        sea ini = fin - 9
        si (ini < desde) { ini = desde }
        sea d = 0
        sea k = ini
        mientras (k < fin) {
            d = d * 10 + str_byte(s, k) - 48
            k = k + 1
        }
        dyn_gr_fijar(g, i, d)
        fin = ini
        i = i + 1
    }
    retornar dyn_gr_valor(g)
}

// Literal entero del código fuente que no cabe en un entero chico (el
// compilador lo deja como texto de cifras).
funcion dyn_entero_literal(v) {
    sea s = dyn_dato(v)
    retornar dyn_gr_desde_cifras(s, 0, str_largo(s), 0)
}

// 64 bits bajos (complemento a dos) de un entero grande: la aritmética
// nativa ya trabaja módulo 2^64.
funcion dyn_gr_bajos64(g) {
    sea r = 0
    sea i = dyn_gr_largo(g) - 1
    mientras (i >= 0) {
        r = r * 1000000000 + dyn_gr_cifra(g, i)
        i = i - 1
    }
    si (dyn_gr_signo(g) < 0) { r = 0 - r }
    retornar r
}

// Tope de elementos para crear de una vez (listas y textos): por encima la
// memoria se agotaría igual, así que mejor un error claro que colgarse.
funcion dyn_max_elementos() { retornar 268435456 }

// Ruta lenta de la comprobación de pila del compilador (comprobar_pila):
// decide con precisión si la pila se acabó. Pilas ajenas (llamadas desde C
// en hilos que no creó tarea()) no se comprueban.
funcion dyn_pila_lenta() {
    sea sp = __pila()
    sea registro = dyn_registro_hilo()
    si (registro != 0) {
        si (__y_bits(sp, 8388607) < 1048576) { dyn_error("desbordamiento de pila: recursión demasiado profunda") }
        retornar 0
    }
    sea base = mem_global(63)
    si (sp <= base y base - sp < 67108864) { dyn_error("desbordamiento de pila: recursión demasiado profunda") }
    retornar 0
}

// ── Ordenamiento natural (ordenar sin función) ───────────────────────────
// Mergesort estable de abajo arriba sobre las palabras crudas, con tramos
// iniciales por inserción. Si todos son enteros chicos se comparan las
// palabras directamente (la etiqueta n·2+1 conserva el orden). Para listas
// mixtas hay un orden total: nulo < booleanos < números < textos < listas <
// mapas < lo demás; dentro de un mismo tipo sin orden natural (listas,
// mapas, funciones) se conserva el orden original.

funcion dyn_ord_rango(v) {
    sea t = dyn_tipo(v)
    si (t == 0) { retornar 0 }
    si (t == 5) { retornar 1 }
    si (t == 6 o t == 4 o t == 12) { retornar 2 }
    si (t == 1) { retornar 3 }
    si (t == 2) { retornar 4 }
    si (t == 3) { retornar 5 }
    retornar 6
}

funcion dyn_ord_comparar(a, b) {
    si (__y_bits(a, 1) == 1 y __y_bits(b, 1) == 1) {
        si (a < b) { retornar 0 - 1 }
        si (a > b) { retornar 1 }
        retornar 0
    }
    sea ra = dyn_ord_rango(a)
    sea rb = dyn_ord_rango(b)
    si (ra != rb) {
        si (ra < rb) { retornar 0 - 1 }
        retornar 1
    }
    si (ra == 1) {
        si (a < b) { retornar 0 - 1 }
        si (a > b) { retornar 1 }
        retornar 0
    }
    si (ra == 2 o ra == 3) { retornar dyn_comparar(a, b) }
    retornar 0
}

// Inserción estable de x[desde..hasta).
funcion dyn_ord_insercion(x, desde, hasta, enteros) {
    sea i = desde + 1
    mientras (i < hasta) {
        sea v = __cargar64(x + i * 8)
        sea j = i - 1
        si (enteros == 1) {
            mientras (j >= desde y __cargar64(x + j * 8) > v) {
                __guardar64(x + (j + 1) * 8, __cargar64(x + j * 8))
                j = j - 1
            }
        } sino {
            mientras (j >= desde y dyn_ord_comparar(__cargar64(x + j * 8), v) > 0) {
                __guardar64(x + (j + 1) * 8, __cargar64(x + j * 8))
                j = j - 1
            }
        }
        __guardar64(x + (j + 1) * 8, v)
        i = i + 1
    }
    retornar 0
}

// Mezcla estable de x[a..m) y x[m..b) en y[a..b).
funcion dyn_ord_mezclar(x, y, a, m, b, enteros) {
    sea i = a
    sea j = m
    sea k = a
    mientras (i < m y j < b) {
        sea u = __cargar64(x + i * 8)
        sea v = __cargar64(x + j * 8)
        sea tomar_derecha = 0
        si (enteros == 1) {
            si (v < u) { tomar_derecha = 1 }
        } sino {
            si (dyn_ord_comparar(u, v) > 0) { tomar_derecha = 1 }
        }
        si (tomar_derecha == 1) {
            __guardar64(y + k * 8, v)
            j = j + 1
        } sino {
            __guardar64(y + k * 8, u)
            i = i + 1
        }
        k = k + 1
    }
    mientras (i < m) {
        __guardar64(y + k * 8, __cargar64(x + i * 8))
        i = i + 1
        k = k + 1
    }
    mientras (j < b) {
        __guardar64(y + k * 8, __cargar64(x + j * 8))
        j = j + 1
        k = k + 1
    }
    retornar 0
}

funcion dyn_ordenar_natural(l) {
    si (dyn_tipo(l) != 2) { dyn_error_tipo("ordenar", l) }
    sea origen = dyn_dato(l)
    sea n = vec_largo(origen)
    // resultado: un vec propio con capacidad exacta
    sea r = vec_nuevo()
    sea cap = n
    si (cap < 8) { cap = 8 }
    mem_liberar(__cargar64(r + 16))
    __guardar64(r + 16, mem_reservar(cap * 8))
    __guardar64(r + 8, cap)
    sea x = __cargar64(r + 16)
    mem_copiar(x, __cargar64(origen + 16), n * 8)
    __guardar64(r, n)
    si (n < 2) { retornar dyn_caja(2, r) }
    sea enteros = 1
    sea i = 0
    mientras (i < n) {
        si (__y_bits(__cargar64(x + i * 8), 1) != 1) {
            enteros = 0
            romper
        }
        i = i + 1
    }
    // ¿ya ordenada? (caso común y barato de detectar)
    sea ordenada = 1
    i = 1
    mientras (i < n) {
        sea u = __cargar64(x + (i - 1) * 8)
        sea v = __cargar64(x + i * 8)
        si (enteros == 1) {
            si (v < u) { ordenada = 0 }
        } sino {
            si (dyn_ord_comparar(u, v) > 0) { ordenada = 0 }
        }
        si (ordenada == 0) { romper }
        i = i + 1
    }
    si (ordenada == 1) { retornar dyn_caja(2, r) }
    // enteros chicos: la etiqueta (x·2 + 1) conserva el orden con signo
    si (enteros == 1 y dyn_radix64(x, n)) { retornar dyn_caja(2, r) }
    sea tramo = 24
    i = 0
    mientras (i < n) {
        sea fin = i + tramo
        si (fin > n) { fin = n }
        dyn_ord_insercion(x, i, fin, enteros)
        i = fin
    }
    sea y = mem_reservar(n * 8)
    sea a = x
    sea b = y
    sea ancho = tramo
    mientras (ancho < n) {
        sea inicio = 0
        mientras (inicio < n) {
            sea medio = inicio + ancho
            sea fin = inicio + 2 * ancho
            si (medio > n) { medio = n }
            si (fin > n) { fin = n }
            dyn_ord_mezclar(a, b, inicio, medio, fin, enteros)
            inicio = fin
        }
        sea t = a
        a = b
        b = t
        ancho = ancho * 2
    }
    si (a != x) { mem_copiar(x, a, n * 8) }
    mem_liberar(y)
    retornar dyn_caja(2, r)
}

// ── Concatenación de textos con búfer compartido ─────────────────────────
// a + b copia a y b; en un bucle (t = t + x) eso es cuadrático. Cuando el
// resultado pasa de 32 bytes se guarda en un búfer con el doble de
// capacidad, marcado como compartido (propio = 2) y con un contador de bytes
// usados al final del bloque. Si después se suma algo a un texto cuyo largo
// coincide con lo usado del búfer (nadie escribió más allá), los bytes se
// agregan en el mismo búfer y el texto nuevo es otra cabecera sobre él: los
// textos anteriores siguen viendo solo su prefijo, que no cambia. Así una
// cadena de sumas cuesta O(n) amortizado. str_c repone el 0 final si hace
// falta (str_c_propio) y str_asegurar copia antes de modificar.

funcion dyn_cat_usado_dir(datos, cap) { retornar datos + __y_bits(cap + 8, 0 - 8) }

funcion dyn_cat_nuevo(cap) {
    sea s = mem_reservar(32)
    sea datos = mem_reservar(__y_bits(cap + 8, 0 - 8) + 8)
    __guardar64(s, 0)
    __guardar64(s + 8, cap)
    __guardar64(s + 16, datos)
    __guardar64(s + 24, 2)
    __guardar64(dyn_cat_usado_dir(datos, cap), 0)
    retornar s
}

funcion dyn_texto_sumar(a, b) {
    // b como bytes (los números, nulo, etc. se escriben como en a_texto)
    sea sb = 0
    si (dyn_tipo(b) == 1) {
        sb = dyn_dato(b)
    } sino {
        sb = str_nuevo(16)
        dyn_agregar_valor(sb, b, 0)
    }
    sea sa = dyn_dato(a)
    sea la = __cargar64(sa)
    sea lb = __cargar64(sb)
    sea total = la + lb
    si (mem_global(34) == 0) {
        // Agregar en el sitio: búfer compartido, nadie más allá de a, cabe.
        si (__cargar64(sa + 24) == 2) {
            sea cap = __cargar64(sa + 8)
            sea datos = __cargar64(sa + 16)
            sea usado = dyn_cat_usado_dir(datos, cap)
            si (__cargar64(usado) == la y total <= cap) {
                mem_copiar(datos + la, __cargar64(sb + 16), lb)
                __guardar8(datos + total, 0)
                __guardar64(usado, total)
                sea r = mem_reservar(32)
                __guardar64(r, total)
                __guardar64(r + 8, cap)
                __guardar64(r + 16, datos)
                __guardar64(r + 24, 2)
                retornar dyn_texto(r)
            }
        }
        si (total >= 32) {
            sea r = dyn_cat_nuevo(total * 2)
            sea datos = __cargar64(r + 16)
            mem_copiar(datos, __cargar64(sa + 16), la)
            mem_copiar(datos + la, __cargar64(sb + 16), lb)
            __guardar8(datos + total, 0)
            __guardar64(r, total)
            __guardar64(dyn_cat_usado_dir(datos, total * 2), total)
            retornar dyn_texto(r)
        }
    }
    sea r = str_nuevo(total)
    str_agregar(r, sa)
    str_agregar(r, sb)
    retornar dyn_texto(r)
}

// lista_repetir con n entero chico: un vec del tamaño justo, sin crecer.
// Devuelve nulo si n no es un entero chico (lista_repetir sigue por la vía
// general).
funcion dyn_lista_repetir_rapido(v, n) {
    si (__y_bits(n, 1) != 1) { retornar 0 }
    sea k = dyn_valor_entero(n)
    si (k < 0) { k = 0 }
    sea r = vec_nuevo()
    sea cap = k
    si (cap < 8) { cap = 8 }
    mem_liberar(__cargar64(r + 16))
    sea datos = mem_reservar(cap * 8)
    __guardar64(r + 16, datos)
    __guardar64(r + 8, cap)
    si (k > 0) { __llenar64(datos, v, k) }
    __guardar64(r, k)
    retornar dyn_caja(2, r)
}

// ── Listas crudas del modo turbo ─────────────────────────────────────────
// Cabecera {largo, capacidad, datos, ancho}: elementos i64 sin etiqueta
// (ancho 8) o bytes (ancho 1). Solo viven dentro de una función turbo.

funcion dyn_crudo_cabecera(cap, ancho) {
    sea h = mem_reservar(32)
    __guardar64(h, 0)
    __guardar64(h + 8, cap)
    __guardar64(h + 16, mem_reservar(cap * ancho))
    __guardar64(h + 24, ancho)
    retornar h
}

funcion dyn_crudo_nueva(ancho) { retornar dyn_crudo_cabecera(8, ancho) }

funcion dyn_crudo_repetir(v, n, ancho) {
    sea cap = n
    si (cap < 8) { cap = 8 }
    sea h = dyn_crudo_cabecera(cap, ancho)
    sea d = __cargar64(h + 16)
    // con el recolector, la memoria nueva ya viene en cero
    si (v != 0 o __cargar64(__globales() + 144) == 0) {
        si (ancho == 8) { __llenar64(d, v, n) } sino { mem_llenar(d, v, n) }
    }
    __guardar64(h, n)
    retornar h
}

funcion dyn_crudo_crecer(h) {
    sea cap = __cargar64(h + 8)
    sea ancho = __cargar64(h + 24)
    __guardar64(h + 16, mem_redimensionar(__cargar64(h + 16), __cargar64(h) * ancho, cap * 2 * ancho))
    __guardar64(h + 8, cap * 2)
    retornar 0
}

// Copia de h para ordenar: si es de bytes o corta, ya sale ordenada; si no,
// la ordena el código nativo del modo turbo con dyn_crudo_temporal.
funcion dyn_crudo_copia(h) {
    sea n = __cargar64(h)
    si (__cargar64(h + 24) == 1 o n < 64) { retornar dyn_crudo_ordenar(h) }
    sea r = dyn_crudo_cabecera(n, 8)
    mem_copiar(__cargar64(r + 16), __cargar64(h + 16), n * 8)
    __guardar64(r, n)
    retornar r
}

// Como dyn_crudo_copia, pero ordenando h misma (h ya no se usa después).
funcion dyn_crudo_en_sitio(h) {
    si (__cargar64(h + 24) == 1 o __cargar64(h) < 64) { retornar dyn_crudo_ordenar(h) }
    retornar h
}

// Agrega v cuantos veces (v ya cabe en el ancho de la lista).
funcion dyn_crudo_llenar(h, v, cuantos) {
    dyn_crudo_reservar(h, cuantos)
    sea n = __cargar64(h)
    sea ancho = __cargar64(h + 24)
    sea d = __cargar64(h + 16)
    // con el recolector, la capacidad nueva ya viene en cero
    si (v != 0 o __cargar64(__globales() + 144) == 0 o n > 0) {
        si (ancho == 8) { __llenar64(d + n * 8, v, cuantos) } sino { mem_llenar(d + n, v, cuantos) }
    }
    __guardar64(h, n + cuantos)
    retornar 0
}

// Capacidad para cuantos elementos más (una sola reserva).
funcion dyn_crudo_reservar(h, cuantos) {
    sea quiere = __cargar64(h) + cuantos
    sea cap = __cargar64(h + 8)
    si (quiere <= cap) { retornar 0 }
    sea ancho = __cargar64(h + 24)
    __guardar64(h + 16, mem_redimensionar(__cargar64(h + 16), __cargar64(h) * ancho, quiere * ancho))
    __guardar64(h + 8, quiere)
    retornar 0
}

// Búfer auxiliar (n palabras + 6·2048 contadores) o 0 si r ya está ordenada.
// Con el recolector, el búfer (fuera del montón) se guarda para el próximo
// orden: [tamaño][-] y los datos, en la casilla 200 del recolector; se toma
// y se devuelve con intercambios atómicos (los hilos no lo comparten).
funcion dyn_crudo_temporal(r) {
    sea n = __cargar64(r)
    si (__cargar64(r + 24) == 1 o n < 64) { retornar 0 }
    sea necesita = n * 8 + 98304
    sea gc = __cargar64(__globales() + 144)
    si (gc == 0) { retornar mem_reservar(necesita) }
    sea b = __intercambiar(gc + 200, 0)
    si (b != 0) {
        si (__cargar64(b) >= necesita) { retornar b + 16 }
        sys_desmapear(b, __cargar64(b) + 16)
    }
    sea tam = (necesita + 16 + 4095) / 4096 * 4096
    b = sys_mapear(tam)
    si (b < 0) { rt_panico("sin memoria") }
    __guardar64(b, tam - 16)
    retornar b + 16
}

funcion dyn_crudo_soltar(t) {
    sea gc = __cargar64(__globales() + 144)
    si (gc == 0) {
        mem_liberar(t)
        retornar 0
    }
    sea viejo = __intercambiar(gc + 200, t - 16)
    si (viejo != 0) { sys_desmapear(viejo, __cargar64(viejo) + 16) }
    retornar 0
}

funcion dyn_crudo_ordenar(h) {
    sea n = __cargar64(h)
    sea ancho = __cargar64(h + 24)
    sea cap = n
    si (cap < 8) { cap = 8 }
    sea r = dyn_crudo_cabecera(cap, ancho)
    sea x = __cargar64(r + 16)
    __guardar64(r, n)
    si (ancho == 1) {
        // conteo de bytes
        sea cuenta = mem_reservar(2048)
        mem_poner_cero(cuenta, 2048)
        sea d = __cargar64(h + 16)
        sea i = 0
        mientras (i < n) {
            sea k = __cargar8(d + i) * 8
            __guardar64(cuenta + k, __cargar64(cuenta + k) + 1)
            i = i + 1
        }
        sea j = 0
        i = 0
        mientras (j < 256) {
            mem_llenar(x + i, j, __cargar64(cuenta + j * 8))
            i = i + __cargar64(cuenta + j * 8)
            j = j + 1
        }
        mem_liberar(cuenta)
        retornar r
    }
    mem_copiar(x, __cargar64(h + 16), n * 8)
    dyn_radix64(x, n)
    retornar r
}

// Ordena n palabras con signo en x (radix LSD de 16 bits sobre x - mínimo;
// solo las pasadas que cubren el rango). 0 si el rango no cabe (desborde).
funcion dyn_radix64(x, n) {
    si (n < 2) { retornar 1 }
    sea mn = __cargar64(x)
    sea mx = mn
    sea ordenada = 1
    sea i = 1
    mientras (i < n) {
        sea v = __cargar64(x + i * 8)
        si (v < mn) { mn = v }
        si (v > mx) { mx = v }
        si (v < __cargar64(x + i * 8 - 8)) { ordenada = 0 }
        i = i + 1
    }
    si (ordenada) { retornar 1 }
    si (n < 64) {
        dyn_ord_crudo(x, n)
        retornar 1
    }
    sea rango = mx - mn
    si (rango < 0) {
        // rango de más de 63 bits: clave = v con el bit de signo invertido
        mn = 0 - 9223372036854775807 - 1
        rango = 0 - 1
    }
    sea y = mem_reservar(n * 8)
    sea cuenta = mem_reservar(524288)
    sea a = x
    sea b = y
    sea corrimiento = 0
    mientras (corrimiento < 64 y __desplazar_der(rango, corrimiento) != 0) {
        mem_poner_cero(cuenta, 524288)
        i = 0
        mientras (i < n) {
            sea k = __y_bits(__desplazar_der(__cargar64(a + i * 8) - mn, corrimiento), 65535) * 8
            __guardar64(cuenta + k, __cargar64(cuenta + k) + 1)
            i = i + 1
        }
        sea suma = 0
        sea j = 0
        mientras (j < 524288) {
            sea c = __cargar64(cuenta + j)
            __guardar64(cuenta + j, suma)
            suma = suma + c
            j = j + 8
        }
        i = 0
        mientras (i < n) {
            sea v = __cargar64(a + i * 8)
            sea k = __y_bits(__desplazar_der(v - mn, corrimiento), 65535) * 8
            sea pos = __cargar64(cuenta + k)
            __guardar64(b + pos * 8, v)
            __guardar64(cuenta + k, pos + 1)
            i = i + 1
        }
        sea t = a
        a = b
        b = t
        corrimiento = corrimiento + 16
    }
    si (a != x) { mem_copiar(x, a, n * 8) }
    mem_liberar(cuenta)
    mem_liberar(y)
    retornar 1
}

// Inserción (listas cortas).
funcion dyn_ord_crudo(x, n) {
    sea i = 1
    mientras (i < n) {
        sea v = __cargar64(x + i * 8)
        sea j = i - 1
        mientras (j >= 0 y __cargar64(x + j * 8) > v) {
            __guardar64(x + j * 8 + 8, __cargar64(x + j * 8))
            j = j - 1
        }
        __guardar64(x + j * 8 + 8, v)
        i = i + 1
    }
    retornar 0
}

// Resultado crudo (i64) de una función turbo → valor del lenguaje.
funcion dyn_turbo_entero(x) {
    si (x >= 0 - 4611686018427387904 y x <= 4611686018427387903) { retornar x * 2 + 1 }
    retornar dyn_gr_valor(dyn_gr_desde_crudo(x))
}
