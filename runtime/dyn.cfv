// runtime/dyn.cfv — valores dinámicos del lenguaje C-Forge completo.
//
// Escrito en el dialecto nativo, pero con la convención de valores del
// lenguaje (el compilador lo carga en modo "puente"). Cada valor es una
// palabra de 64 bits con etiqueta:
//
//   0           nulo
//   2 / 4       falso / verdadero
//   impar       entero: n * 2 + 1
//   puntero     caja de 16 bytes [tipo][dato]:
//                 1 texto (dato: texto del runtime)
//                 2 lista (dato: vec del runtime)
//                 3 mapa  (dato: map del runtime)
//                 4 flotante (dato: bits IEEE-754)
//                 7 función (dato: [código][aridad][n][celdas capturadas]*)
//                 8 puntero (dato: [bloque (lista)][desplazamiento])
//
// Los números siguen la semántica del intérprete: un resultado con valor
// entero se representa como entero; si no, como flotante.

// ── Construcción y consulta ───────────────────────────────────────────────

funcion dyn_caja(tipo, dato) {
    sea c = mem_reservar(16)
    __guardar64(c, tipo)
    __guardar64(c + 8, dato)
    retornar c
}

// 0 nulo · 1 texto · 2 lista · 3 mapa · 4 flotante · 5 booleano · 6 entero
funcion dyn_tipo(v) {
    si (v == 0) { retornar 0 }
    si (__y_bits(v, 1) == 1) { retornar 6 }
    si (v == 2 o v == 4) { retornar 5 }
    retornar __cargar64(v)
}

funcion dyn_dato(v) { retornar __cargar64(v + 8) }
funcion dyn_entero(n) { retornar n * 2 + 1 }
funcion dyn_valor_entero(v) { retornar (v - 1) / 2 }
funcion dyn_bool(b) { si (b) { retornar 4 } retornar 2 }
funcion dyn_texto(s) { retornar dyn_caja(1, s) }
funcion dyn_lista_nueva() { retornar dyn_caja(2, vec_nuevo()) }
funcion dyn_mapa_nuevo() { retornar dyn_caja(3, map_nuevo()) }

funcion dyn_nombre_tipo(v) {
    sea t = dyn_tipo(v)
    si (t == 0) { retornar "nulo" }
    si (t == 1) { retornar "texto" }
    si (t == 2) { retornar "lista" }
    si (t == 3) { retornar "mapa" }
    si (t == 5) { retornar "booleano" }
    si (t == 7) { retornar "funcion" }
    si (t == 8) { retornar "puntero" }
    si (t == 11) { retornar "puntero" }
    si (t == 9) { retornar "canal" }
    si (t == 10) { retornar "mutex" }
    retornar "numero"
}

funcion dyn_error_tipo(operacion, v) {
    sea m = str_concatenar(operacion, ": valor de tipo ")
    str_agregar(m, dyn_nombre_tipo(v))
    dyn_error(m)
    retornar 0
}

funcion dyn_verdad(v) {
    si (v == 4) { retornar 1 }
    si (v == 2) { retornar 0 }
    dyn_error("se esperaba verdadero o falso")
    retornar 0
}

// ── Errores: intentar / capturar / lanzar ────────────────────────────────
// Global 21: pila de manejadores [rsp][rbp][dirección de captura].

// Cada hilo tiene su pila de manejadores: el hilo principal usa la global
// 21; un hilo creado por tarea() la guarda en su registro (base de su pila).
funcion dyn_manejadores() {
    sea registro = dyn_registro_hilo()
    sea casilla = __globales() + 168
    si (registro != 0) { casilla = registro + 8 }
    sea h = __cargar64(casilla)
    si (h == 0) {
        h = vec_nuevo()
        __guardar64(casilla, h)
    }
    retornar h
}

// Registro del hilo actual (base alineada de su pila de 8 MiB) o 0 si es el
// hilo principal. Las bases de los hilos creados por tarea() se anotan en la
// global 34; así no se lee memoria que podría no estar asignada.
funcion dyn_registro_hilo() {
    sea bases = __cargar64(__globales() + 272)
    si (bases == 0) { retornar 0 }
    sea base = __y_bits(__pila(), 0 - 8388608)
    sea i = 0
    mientras (i < vec_largo(bases)) {
        si (vec_obtener(bases, i) == base) { retornar base }
        i = i + 1
    }
    retornar 0
}

funcion dyn_anotar_hilo(base) {
    sea cerrojo = __globales() + 280
    mientras (__intercambiar(cerrojo, 1) != 0) { sys_ceder() }
    sea bases = __cargar64(__globales() + 272)
    si (bases == 0) {
        bases = vec_nuevo()
        __guardar64(__globales() + 272, bases)
    }
    vec_agregar(bases, base)
    __guardar64(cerrojo, 0)
    retornar 0
}

funcion dyn_intentar_entrar(pila, marco, destino) {
    sea r = mem_reservar(24)
    __guardar64(r, pila)
    __guardar64(r + 8, marco)
    __guardar64(r + 16, destino)
    vec_agregar(dyn_manejadores(), r)
    retornar 0
}

funcion dyn_intentar_salir() {
    mem_liberar(vec_quitar_ultimo(dyn_manejadores()))
    retornar 0
}

funcion dyn_lanzar(v) {
    sea h = dyn_manejadores()
    si (vec_largo(h) == 0) {
        rt_panico(str_concatenar("error no capturado: ", dyn_a_str(v)))
    }
    sea r = vec_quitar_ultimo(h)
    __saltar(__cargar64(r + 8), __cargar64(r), __cargar64(r + 16), v)
    retornar 0
}

// Error del lenguaje: se puede capturar con intentar/capturar.
funcion dyn_error(mensaje) {
    si (vec_largo(dyn_manejadores()) > 0) { dyn_lanzar(dyn_texto(mensaje)) }
    rt_panico(mensaje)
    retornar 0
}

// ── Funciones anónimas y celdas ──────────────────────────────────────────

funcion dyn_celda_nueva(v) {
    sea celda = mem_reservar(8)
    __guardar64(celda, v)
    retornar celda
}

funcion dyn_cierre_nuevo(codigo, aridad, capturas) {
    sea r = mem_reservar(24 + capturas * 8)
    __guardar64(r, codigo)
    __guardar64(r + 8, aridad)
    __guardar64(r + 16, capturas)
    retornar dyn_caja(7, r)
}

funcion dyn_cierre_fijar(f, i, celda) {
    __guardar64(dyn_dato(f) + 24 + i * 8, celda)
    retornar f
}

// Dirección del código de f para una llamada con n argumentos.
funcion dyn_codigo_cierre(f, n) {
    si (dyn_tipo(f) != 7) { dyn_error_tipo("no se puede llamar", f) }
    sea r = dyn_dato(f)
    si (__cargar64(r + 8) != n) {
        sea m = str_concatenar("la función espera ", str_desde_entero(__cargar64(r + 8)))
        str_agregar(m, " argumentos y recibió ")
        str_agregar(m, str_desde_entero(n))
        dyn_error(m)
    }
    retornar __cargar64(r)
}

// ── Números ───────────────────────────────────────────────────────────────

funcion dyn_es_numero(v) {
    sea t = dyn_tipo(v)
    retornar t == 6 o t == 4
}

funcion dyn_a_f64(v) {
    sea t = dyn_tipo(v)
    si (t == 6) { retornar __f64_desde_entero(dyn_valor_entero(v)) }
    si (t == 4) { retornar dyn_dato(v) }
    dyn_error_tipo("se esperaba un número", v)
    retornar 0
}

// Normaliza: un flotante con valor entero exacto vuelve a ser entero.
funcion dyn_desde_f64(bits) {
    sea e = __f64_a_entero(bits)
    si (e > 0 - 4503599627370496 y e < 4503599627370496) {
        si (__f64_desde_entero(e) == bits) { retornar dyn_entero(e) }
        // -0.0 también es el entero 0.
        si (__desplazar_izq(bits, 1) == 0) { retornar dyn_entero(0) }
    }
    retornar dyn_caja(4, bits)
}

funcion dyn_flotante(bits) { retornar dyn_desde_f64(bits) }

funcion dyn_ambos_enteros(a, b) {
    retornar __y_bits(__y_bits(a, b), 1) == 1
}

// Recolector de basura (runtime/mem.cfv): raíces en las casillas globales
// y las variables de nivel superior. La cantidad de globales está después
// de la tabla de clases: [n][registro]*[globales].
funcion dyn_gc_iniciar() {
    si (sys_variable_entorno("CFORGE_GC") != 0) {
        si (str_igual(sys_variable_entorno("CFORGE_GC"), "0")) { retornar 0 }
    }
    sea tabla = __clases()
    sea cantidad = __cargar64(tabla + 8 + __cargar64(tabla) * 8)
    // CFORGE_GC_ESTRES=1: recolectar cada 64 KiB (pruebas del recolector).
    sea minimo = 8388608
    si (sys_variable_entorno("CFORGE_GC_ESTRES") != 0) { minimo = 65536 }
    gc_activar(__globales() + 512 + cantidad * 8, minimo)
    retornar 0
}

// Programa escrito en inglés: valores impresos en inglés (global 20).
funcion dyn_fijar_ingles() { mem_fijar_global(20, 1) retornar 0 }
funcion dyn_ingles() { retornar mem_global(20) == 1 }

// ── Clases ────────────────────────────────────────────────────────────────
// El compilador deja en datos la tabla __clases(): [n][registro]*, con cada
// registro [nombre][padre o 0][n métodos]([nombre][código][aridad])*.
// Una instancia es un mapa con la clave "__clase".

funcion dyn_registro_clase(nombre) {
    sea tabla = __clases()
    sea i = 0
    mientras (i < __cargar64(tabla)) {
        sea r = __cargar64(tabla + 8 + i * 8)
        si (str_igual(__cargar64(r), nombre)) { retornar r }
        i = i + 1
    }
    retornar 0
}

// Dirección del método (o 0) para objeto.nombre(...) con aridad total n.
funcion dyn_buscar_metodo(objeto, nombre, n) {
    si (dyn_tipo(objeto) != 3) { retornar 0 }
    sea m = dyn_dato(objeto)
    sea e = map_buscar(m, "__clase")
    si (e < 0) { retornar 0 }
    sea clase = map_valor_en(m, e)
    si (dyn_tipo(clase) != 1) { retornar 0 }
    sea r = dyn_registro_clase(dyn_dato(clase))
    mientras (r != 0) {
        sea cantidad = __cargar64(r + 16)
        sea i = 0
        mientras (i < cantidad) {
            sea entrada = r + 24 + i * 24
            si (str_igual(__cargar64(entrada), nombre)) {
                si (__cargar64(entrada + 16) != n) {
                    dyn_error(str_concatenar("cantidad de argumentos incorrecta en el método ", nombre))
                }
                retornar __cargar64(entrada + 8)
            }
            i = i + 1
        }
        si (__cargar64(r + 8) == 0) { r = 0 } sino { r = dyn_registro_clase(__cargar64(r + 8)) }
    }
    retornar 0
}

funcion dyn_metodo_desconocido(objeto, nombre) {
    sea m = str_concatenar("método desconocido '", nombre)
    str_agregar(m, "' para un valor de tipo ")
    str_agregar(m, dyn_nombre_tipo(objeto))
    dyn_error(m)
    retornar 0
}

// ── Claves ordenadas (como el intérprete: orden por bytes) ───────────────

funcion dyn_str_comparar(x, y) {
    sea i = 0
    mientras (i < str_largo(x) y i < str_largo(y)) {
        sea cx = str_byte(x, i)
        sea cy = str_byte(y, i)
        si (cx < cy) { retornar 0 - 1 }
        si (cx > cy) { retornar 1 }
        i = i + 1
    }
    si (str_largo(x) < str_largo(y)) { retornar 0 - 1 }
    si (str_largo(x) > str_largo(y)) { retornar 1 }
    retornar 0
}

// Ordena por mezcla el tramo [desde, hasta) de v usando aux.
funcion dyn_ordenar_tramo(v, aux, desde, hasta) {
    si (hasta - desde < 2) { retornar 0 }
    sea medio = (desde + hasta) / 2
    dyn_ordenar_tramo(v, aux, desde, medio)
    dyn_ordenar_tramo(v, aux, medio, hasta)
    sea i = desde
    sea j = medio
    sea k = desde
    mientras (k < hasta) {
        si (j >= hasta o (i < medio y dyn_str_comparar(vec_obtener(v, i), vec_obtener(v, j)) <= 0)) {
            vec_fijar(aux, k, vec_obtener(v, i))
            i = i + 1
        } sino {
            vec_fijar(aux, k, vec_obtener(v, j))
            j = j + 1
        }
        k = k + 1
    }
    k = desde
    mientras (k < hasta) {
        vec_fijar(v, k, vec_obtener(aux, k))
        k = k + 1
    }
    retornar 0
}

// Claves del mapa (textos del runtime) en orden.
funcion dyn_claves_ordenadas(m) {
    sea v = map_claves(m)
    sea aux = vec_nuevo()
    sea i = 0
    mientras (i < vec_largo(v)) {
        vec_agregar(aux, 0)
        i = i + 1
    }
    dyn_ordenar_tramo(v, aux, 0, vec_largo(v))
    vec_liberar(aux)
    retornar v
}

// ── Texto ─────────────────────────────────────────────────────────────────

funcion dyn_agregar_valor(r, v, comillas) {
    sea t = dyn_tipo(v)
    si (t == 1 y comillas) {
        str_agregar_byte(r, 34)
        str_agregar(r, dyn_dato(v))
        str_agregar_byte(r, 34)
        retornar 0
    }
    si (t == 1) { str_agregar(r, dyn_dato(v)) retornar 0 }
    si (t == 0) {
        si (dyn_ingles()) { str_agregar(r, "null") } sino { str_agregar(r, "nulo") }
        retornar 0
    }
    si (t == 5) {
        si (dyn_ingles()) {
            si (v == 4) { str_agregar(r, "true") } sino { str_agregar(r, "false") }
        } sino {
            si (v == 4) { str_agregar(r, "verdadero") } sino { str_agregar(r, "falso") }
        }
        retornar 0
    }
    si (t == 6) {
        str_agregar_entero(r, dyn_valor_entero(v))
        retornar 0
    }
    si (t == 4) {
        dyn_formato_g(r, dyn_dato(v))
        retornar 0
    }
    si (t == 2) {
        sea l = dyn_dato(v)
        str_agregar_byte(r, 91)
        sea i = 0
        mientras (i < vec_largo(l)) {
            si (i > 0) { str_agregar(r, ", ") }
            dyn_agregar_valor(r, vec_obtener(l, i), 0)
            i = i + 1
        }
        str_agregar_byte(r, 93)
        retornar 0
    }
    si (t == 3) {
        sea m = dyn_dato(v)
        str_agregar_byte(r, 123)
        sea orden = dyn_claves_ordenadas(m)
        sea j = 0
        mientras (j < vec_largo(orden)) {
            sea k = vec_obtener(orden, j)
            si (j > 0) { str_agregar(r, ", ") }
            str_agregar_byte(r, 34)
            str_agregar(r, k)
            str_agregar(r, "\": ")
            dyn_agregar_valor(r, map_obtener(m, k), 0)
            j = j + 1
        }
        vec_liberar(orden)
        str_agregar_byte(r, 125)
        retornar 0
    }
    si (t == 7) { str_agregar(r, "<funcion>") retornar 0 }
    si (t == 9) { str_agregar(r, "<canal>") retornar 0 }
    si (t == 10) { str_agregar(r, "<mutex>") retornar 0 }
    si (t == 8) { str_agregar(r, "<puntero>") retornar 0 }
    si (t == 11) { str_agregar(r, "<puntero>") retornar 0 }
    dyn_error("valor desconocido")
    retornar 0
}

// Texto del runtime con la representación del valor.
funcion dyn_a_str(v) {
    si (dyn_tipo(v) == 1) { retornar dyn_dato(v) }
    sea r = str_nuevo(16)
    dyn_agregar_valor(r, v, 0)
    retornar r
}

funcion dyn_texto_de(v, operacion) {
    si (dyn_tipo(v) != 1) { dyn_error_tipo(operacion, v) }
    retornar dyn_dato(v)
}

// ── Operadores ────────────────────────────────────────────────────────────

funcion dyn_suma(a, b) {
    si (dyn_ambos_enteros(a, b)) { retornar a + b - 1 }
    si (dyn_tipo(a) == 8 y __y_bits(b, 1) == 1) { retornar dyn_puntero(__cargar64(dyn_dato(a)), __cargar64(dyn_dato(a) + 8) + dyn_valor_entero(b)) }
    // Puntero de C + desplazamiento (memoria de c_reservar).
    si (dyn_tipo(a) == 11 y __y_bits(b, 1) == 1) { retornar dyn_caja(11, dyn_dato(a) + dyn_valor_entero(b)) }
    si (dyn_tipo(a) == 2 y dyn_tipo(b) == 2) {
        // lista + lista: una lista nueva con los elementos de ambas.
        sea r = vec_nuevo()
        sea x = dyn_dato(a)
        sea y = dyn_dato(b)
        sea i = 0
        mientras (i < vec_largo(x)) {
            vec_agregar(r, vec_obtener(x, i))
            i = i + 1
        }
        i = 0
        mientras (i < vec_largo(y)) {
            vec_agregar(r, vec_obtener(y, i))
            i = i + 1
        }
        retornar dyn_caja(2, r)
    }
    si (dyn_tipo(a) == 1 o dyn_tipo(b) == 1) {
        sea r = str_nuevo(16)
        dyn_agregar_valor(r, a, 0)
        dyn_agregar_valor(r, b, 0)
        retornar dyn_texto(r)
    }
    retornar dyn_desde_f64(__f64_suma(dyn_a_f64(a), dyn_a_f64(b)))
}

funcion dyn_resta(a, b) {
    si (dyn_ambos_enteros(a, b)) { retornar a - b + 1 }
    si (dyn_tipo(a) == 8 y __y_bits(b, 1) == 1) { retornar dyn_puntero(__cargar64(dyn_dato(a)), __cargar64(dyn_dato(a) + 8) - dyn_valor_entero(b)) }
    retornar dyn_desde_f64(__f64_resta(dyn_a_f64(a), dyn_a_f64(b)))
}

funcion dyn_mul(a, b) {
    si (dyn_ambos_enteros(a, b)) {
        retornar dyn_entero(dyn_valor_entero(a) * dyn_valor_entero(b))
    }
    retornar dyn_desde_f64(__f64_mul(dyn_a_f64(a), dyn_a_f64(b)))
}

funcion dyn_div(a, b) {
    si (dyn_ambos_enteros(a, b)) {
        sea x = dyn_valor_entero(a)
        sea y = dyn_valor_entero(b)
        si (y == 0) { dyn_error("división por cero") }
        si (x % y == 0) { retornar dyn_entero(x / y) }
    }
    retornar dyn_desde_f64(__f64_div(dyn_a_f64(a), dyn_a_f64(b)))
}

funcion dyn_mod(a, b) {
    si (dyn_ambos_enteros(a, b)) {
        sea y = dyn_valor_entero(b)
        si (y == 0) { dyn_error("división por cero") }
        retornar dyn_entero(dyn_valor_entero(a) % y)
    }
    // fmod: a - trunc(a / b) * b
    sea x = dyn_a_f64(a)
    sea y = dyn_a_f64(b)
    sea cociente = __f64_desde_entero(__f64_a_entero(__f64_div(x, y)))
    retornar dyn_desde_f64(__f64_resta(x, __f64_mul(cociente, y)))
}

funcion dyn_neg(a) {
    si (__y_bits(a, 1) == 1) { retornar 2 - a }
    retornar dyn_desde_f64(__f64_resta(__f64_desde_entero(0), dyn_a_f64(a)))
}

funcion dyn_no(a) { retornar dyn_bool(dyn_verdad(a) == 0) }

funcion dyn_igual_crudo(a, b) {
    si (a == b) { retornar 1 }
    sea ta = dyn_tipo(a)
    sea tb = dyn_tipo(b)
    si (ta == 1 y tb == 1) { retornar str_igual(dyn_dato(a), dyn_dato(b)) }
    si (ta == 11 y tb == 11) { retornar dyn_dato(a) == dyn_dato(b) }
    si (dyn_es_numero(a) y dyn_es_numero(b)) {
        si (ta == 6 y tb == 6) { retornar 0 }
        sea x = dyn_a_f64(a)
        sea y = dyn_a_f64(b)
        retornar __f64_menor(x, y) == 0 y __f64_menor(y, x) == 0
    }
    retornar 0
}

funcion dyn_igual(a, b) { retornar dyn_bool(dyn_igual_crudo(a, b)) }
funcion dyn_distinto(a, b) { retornar dyn_bool(dyn_igual_crudo(a, b) == 0) }

// -1, 0 o 1 para números o textos.
funcion dyn_comparar(a, b) {
    si (dyn_ambos_enteros(a, b)) {
        si (a < b) { retornar 0 - 1 }
        si (a > b) { retornar 1 }
        retornar 0
    }
    si (dyn_tipo(a) == 1 y dyn_tipo(b) == 1) {
        sea x = dyn_dato(a)
        sea y = dyn_dato(b)
        sea i = 0
        mientras (i < str_largo(x) y i < str_largo(y)) {
            sea cx = str_byte(x, i)
            sea cy = str_byte(y, i)
            si (cx < cy) { retornar 0 - 1 }
            si (cx > cy) { retornar 1 }
            i = i + 1
        }
        si (str_largo(x) < str_largo(y)) { retornar 0 - 1 }
        si (str_largo(x) > str_largo(y)) { retornar 1 }
        retornar 0
    }
    sea fx = dyn_a_f64(a)
    sea fy = dyn_a_f64(b)
    si (__f64_menor(fx, fy)) { retornar 0 - 1 }
    si (__f64_menor(fy, fx)) { retornar 1 }
    retornar 0
}

funcion dyn_menor(a, b) { retornar dyn_bool(dyn_comparar(a, b) < 0) }
funcion dyn_menor_igual(a, b) { retornar dyn_bool(dyn_comparar(a, b) <= 0) }
funcion dyn_mayor(a, b) { retornar dyn_bool(dyn_comparar(a, b) > 0) }
funcion dyn_mayor_igual(a, b) { retornar dyn_bool(dyn_comparar(a, b) >= 0) }

// ── Indexación e iteración ────────────────────────────────────────────────

funcion dyn_indice_lista(l, i) {
    si (__y_bits(i, 1) != 1) { dyn_error("el índice de lista debe ser un número entero") }
    sea n = dyn_valor_entero(i)
    si (n < 0 o n >= vec_largo(l)) { dyn_error("índice de lista inválido") }
    retornar n
}

funcion dyn_clave(k) {
    si (dyn_tipo(k) != 1) { dyn_error("la clave debe ser texto") }
    retornar dyn_dato(k)
}

funcion dyn_indice(c, k) {
    sea t = dyn_tipo(c)
    si (t == 2) {
        sea l = dyn_dato(c)
        retornar vec_obtener(l, dyn_indice_lista(l, k))
    }
    si (t == 3) {
        sea m = dyn_dato(c)
        sea e = map_buscar(m, dyn_clave(k))
        si (e < 0) { dyn_error("clave inexistente") }
        retornar map_valor_en(m, e)
    }
    si (t == 1) {
        sea s = dyn_dato(c)
        si (__y_bits(k, 1) != 1) { dyn_error("el índice de texto debe ser un número entero") }
        sea n = dyn_valor_entero(k)
        si (n < 0 o n >= str_largo(s)) { dyn_error("índice de texto inválido") }
        retornar dyn_texto(str_rebanar(s, n, n + 1))
    }
    dyn_error_tipo("no se puede indexar", c)
    retornar 0
}

// c[k] seguido de ??: nulo si el contenedor es nulo, la clave no existe o el
// índice está fuera de rango.
funcion dyn_indice_opcional(c, k) {
    si (c == 0) { retornar 0 }
    sea t = dyn_tipo(c)
    si (t == 3) {
        sea m = dyn_dato(c)
        sea e = map_buscar(m, dyn_clave(k))
        si (e < 0) { retornar 0 }
        retornar map_valor_en(m, e)
    }
    si (t == 2) {
        sea l = dyn_dato(c)
        si (__y_bits(k, 1) == 1) {
            sea n = dyn_valor_entero(k)
            si (n < 0 o n >= vec_largo(l)) { retornar 0 }
        }
    }
    retornar dyn_indice(c, k)
}

// valor.campo: campo de un mapa/instancia; .longitud de listas y textos.
funcion dyn_campo(c, k) {
    sea t = dyn_tipo(c)
    si (t == 3) { retornar dyn_indice(c, k) }
    si ((t == 1 o t == 2) y (str_igual(dyn_dato(k), "longitud") o str_igual(dyn_dato(k), "largo") o str_igual(dyn_dato(k), "length"))) {
        retornar longitud(c)
    }
    si (t == 0) { dyn_error(str_concatenar("acceso a campo de nulo: ", dyn_dato(k))) }
    dyn_error_tipo(str_concatenar("no tiene el campo ", dyn_dato(k)), c)
    retornar 0
}

// Resultado/Opción: ¿es un fallo? (raw 0/1) — {"ok": falso} o {"presente": falso}
funcion dyn_es_fallo(v) {
    si (dyn_tipo(v) != 3) { retornar 0 }
    sea m = dyn_dato(v)
    si (map_obtener_o(m, "ok", 0) == 2) { retornar 1 }
    si (map_obtener_o(m, "presente", 0) == 2) { retornar 1 }
    retornar 0
}

// coincidir: ¿v es la variante k? (1 Ok, 2 Error, 3 Alguno, 4 Ninguno).
// Devuelve 0/1 crudo.
funcion dyn_variante(v, k) {
    si (dyn_tipo(v) != 3) { retornar 0 }
    sea m = dyn_dato(v)
    si (k <= 2) {
        si (map_tiene(m, "ok") == 0) { retornar 0 }
        sea ok = map_obtener(m, "ok") == 4
        si (k == 1) { retornar ok }
        retornar ok == 0
    }
    si (map_tiene(m, "presente") == 0) { retornar 0 }
    sea p = map_obtener(m, "presente") == 4
    si (k == 3) { retornar p }
    retornar p == 0
}

// Lo que envuelve la variante: el error para Error(e), el valor si no.
funcion dyn_variante_valor(v, k) {
    sea m = dyn_dato(v)
    si (k == 2) { retornar map_obtener_o(m, "error", 0) }
    retornar map_obtener_o(m, "valor", 0)
}

funcion dyn_desenvolver(v) {
    si (dyn_tipo(v) != 3) { retornar v }
    sea m = dyn_dato(v)
    si (map_tiene(m, "valor") y (map_tiene(m, "ok") o map_tiene(m, "presente"))) { retornar map_obtener(m, "valor") }
    retornar v
}

funcion dyn_fijar_indice(c, k, v) {
    sea t = dyn_tipo(c)
    si (t == 2) {
        sea l = dyn_dato(c)
        vec_fijar(l, dyn_indice_lista(l, k), v)
        retornar 0
    }
    si (t == 3) {
        map_fijar(dyn_dato(c), dyn_clave(k), v)
        retornar 0
    }
    dyn_error_tipo("no se puede asignar por índice", c)
    retornar 0
}

// Para "para x en c": cantidad de elementos (entero crudo) y elemento i.
funcion dyn_iter_largo(c) {
    sea t = dyn_tipo(c)
    si (t == 2) { retornar vec_largo(dyn_dato(c)) }
    si (t == 1) { retornar str_largo(dyn_dato(c)) }
    dyn_error_tipo("no se puede recorrer", c)
    retornar 0
}

funcion dyn_iter_obtener(c, i) {
    si (dyn_tipo(c) == 2) { retornar vec_obtener(dyn_dato(c), i) }
    retornar dyn_texto(str_rebanar(dyn_dato(c), i, i + 1))
}

// ── Funciones del lenguaje ────────────────────────────────────────────────

funcion mostrar(v) {
    rt_mostrar(dyn_a_str(v))
    retornar 0
}

funcion afirmar(condicion, mensaje) {
    si (dyn_verdad(condicion) == 0) { dyn_error(dyn_a_str(mensaje)) }
    retornar 0
}

funcion a_texto(v) {
    si (dyn_tipo(v) == 1) { retornar v }
    retornar dyn_texto(dyn_a_str(v))
}

funcion longitud(v) {
    sea t = dyn_tipo(v)
    si (t == 2) { retornar dyn_entero(vec_largo(dyn_dato(v))) }
    si (t == 1) { retornar dyn_entero(str_largo(dyn_dato(v))) }
    si (t == 3) { retornar dyn_entero(map_tamano(dyn_dato(v))) }
    dyn_error_tipo("longitud", v)
    retornar 0
}

funcion agregar(l, v) {
    si (dyn_tipo(l) != 2) { dyn_error_tipo("agregar", l) }
    vec_agregar(dyn_dato(l), v)
    retornar 0
}

funcion claves(m) {
    si (dyn_tipo(m) != 3) { dyn_error_tipo("claves", m) }
    sea crudas = dyn_claves_ordenadas(dyn_dato(m))
    sea r = vec_nuevo()
    sea i = 0
    mientras (i < vec_largo(crudas)) {
        vec_agregar(r, dyn_texto(vec_obtener(crudas, i)))
        i = i + 1
    }
    vec_liberar(crudas)
    retornar dyn_caja(2, r)
}

funcion tiene_clave(m, k) {
    si (dyn_tipo(m) != 3) { dyn_error_tipo("tiene_clave", m) }
    retornar dyn_bool(map_tiene(dyn_dato(m), dyn_clave(k)))
}

funcion quitar_clave(m, k) {
    si (dyn_tipo(m) != 3) { dyn_error_tipo("quitar_clave", m) }
    retornar dyn_bool(map_quitar(dyn_dato(m), dyn_clave(k)))
}

funcion lista_rango(inicio, fin) {
    sea r = vec_nuevo()
    sea i = dyn_valor_entero(inicio)
    sea n = dyn_valor_entero(fin)
    mientras (i < n) {
        vec_agregar(r, dyn_entero(i))
        i = i + 1
    }
    retornar dyn_caja(2, r)
}

funcion lista_invertir(l) {
    si (dyn_tipo(l) != 2) { dyn_error_tipo("lista_invertir", l) }
    sea origen = dyn_dato(l)
    sea r = vec_nuevo()
    sea i = vec_largo(origen) - 1
    mientras (i >= 0) {
        vec_agregar(r, vec_obtener(origen, i))
        i = i - 1
    }
    retornar dyn_caja(2, r)
}

funcion lista_contiene(l, v) {
    si (dyn_tipo(l) != 2) { dyn_error_tipo("lista_contiene", l) }
    sea origen = dyn_dato(l)
    sea i = 0
    mientras (i < vec_largo(origen)) {
        si (dyn_igual_crudo(vec_obtener(origen, i), v)) { retornar 4 }
        i = i + 1
    }
    retornar 2
}

funcion quitar_ultimo(l) {
    si (dyn_tipo(l) != 2) { dyn_error_tipo("quitar_ultimo", l) }
    retornar vec_quitar_ultimo(dyn_dato(l))
}

funcion piso(v) {
    si (__y_bits(v, 1) == 1) { retornar v }
    sea x = dyn_a_f64(v)
    sea e = __f64_a_entero(x)
    si (__f64_menor(x, __f64_desde_entero(e))) { e = e - 1 }
    retornar dyn_entero(e)
}

funcion techo(v) {
    si (__y_bits(v, 1) == 1) { retornar v }
    sea x = dyn_a_f64(v)
    sea e = __f64_a_entero(x)
    si (__f64_menor(__f64_desde_entero(e), x)) { e = e + 1 }
    retornar dyn_entero(e)
}

funcion a_numero(v) {
    si (dyn_es_numero(v)) { retornar v }
    sea s = dyn_texto_de(v, "a_numero")
    sea i = 0
    sea n = str_largo(s)
    sea negativo = 0
    si (n > 0 y str_byte(s, 0) == 45) {
        negativo = 1
        i = 1
    }
    sea entero = 0
    sea digitos = 0
    mientras (i < n y str_byte(s, i) >= 48 y str_byte(s, i) <= 57) {
        entero = entero * 10 + str_byte(s, i) - 48
        digitos = digitos + 1
        i = i + 1
    }
    sea valor = __f64_desde_entero(entero)
    si (i < n y str_byte(s, i) == 46) {
        i = i + 1
        sea fraccion = 0
        sea escala = 1
        mientras (i < n y str_byte(s, i) >= 48 y str_byte(s, i) <= 57) {
            fraccion = fraccion * 10 + str_byte(s, i) - 48
            escala = escala * 10
            digitos = digitos + 1
            i = i + 1
        }
        valor = __f64_suma(valor, __f64_div(__f64_desde_entero(fraccion), __f64_desde_entero(escala)))
    }
    si (digitos == 0 o i != n) { dyn_error(str_concatenar("no es un número: ", s)) }
    si (negativo) { valor = __f64_resta(__f64_desde_entero(0), valor) }
    retornar dyn_desde_f64(valor)
}

// cociente(a, b): división entera truncada (7, 2 → 3; -7, 2 → -3). El
// compilador la hace en línea cuando los dos son enteros.
funcion cociente(a, b) {
    si (__y_bits(a, 1) == 1 y __y_bits(b, 1) == 1) {
        si (dyn_valor_entero(b) == 0) { dyn_error("división por cero") }
        retornar dyn_entero(dyn_valor_entero(a) / dyn_valor_entero(b))
    }
    sea x = dyn_a_f64(a)
    sea y = dyn_a_f64(b)
    retornar dyn_entero(__f64_a_entero(__f64_div(x, y)))
}

// Operaciones de bits entre enteros (el compilador las hace en línea).
funcion bits_entero(v, que) {
    si (__y_bits(v, 1) != 1) { dyn_error(str_concatenar(que, ": se esperaban enteros")) }
    retornar dyn_valor_entero(v)
}
funcion bits_y(a, b) { retornar dyn_entero(__y_bits(bits_entero(a, "bits_y"), bits_entero(b, "bits_y"))) }
funcion bits_o(a, b) { retornar dyn_entero(__o_bits(bits_entero(a, "bits_o"), bits_entero(b, "bits_o"))) }
funcion bits_xo(a, b) { retornar dyn_entero(__xo_bits(bits_entero(a, "bits_xo"), bits_entero(b, "bits_xo"))) }

funcion tipo_de(v) { retornar dyn_texto(dyn_nombre_tipo(v)) }

funcion dyn_cambiar_letras(v, desde, hasta, operacion) {
    sea s = dyn_texto_de(v, operacion)
    sea r = str_nuevo(str_largo(s))
    sea i = 0
    mientras (i < str_largo(s)) {
        sea b = str_byte(s, i)
        si (b >= desde y b <= hasta) { b = __xo_bits(b, 32) }
        str_agregar_byte(r, b)
        i = i + 1
    }
    retornar dyn_texto(r)
}

funcion texto_mayusculas(v) { retornar dyn_cambiar_letras(v, 97, 122, "texto_mayusculas") }
funcion texto_minusculas(v) { retornar dyn_cambiar_letras(v, 65, 90, "texto_minusculas") }

// ── Punteros de bloques inseguro (con límites verificados) ───────────────

funcion dyn_puntero(bloque, desplazamiento) {
    sea r = mem_reservar(16)
    __guardar64(r, bloque)
    __guardar64(r + 8, desplazamiento)
    retornar dyn_caja(8, r)
}

// @x: puntero al inicio de un bloque (lista) o el mismo puntero.
funcion dyn_direccion(v) {
    si (dyn_tipo(v) == 8) { retornar v }
    si (dyn_tipo(v) != 2) { dyn_error_tipo("@ requiere un bloque de memoria", v) }
    retornar dyn_puntero(v, 0)
}

funcion dyn_posicion_puntero(p) {
    si (dyn_tipo(p) != 8) { dyn_error_tipo("* requiere un puntero", p) }
    sea bloque = __cargar64(dyn_dato(p))
    sea i = __cargar64(dyn_dato(p) + 8)
    si (i < 0 o i >= vec_largo(dyn_dato(bloque))) { dyn_error("acceso inseguro fuera del bloque de memoria") }
    retornar i
}

funcion dyn_leer_puntero(p) {
    sea i = dyn_posicion_puntero(p)
    retornar vec_obtener(dyn_dato(__cargar64(dyn_dato(p))), i)
}

funcion dyn_escribir_puntero(p, v) {
    sea i = dyn_posicion_puntero(p)
    vec_fijar(dyn_dato(__cargar64(dyn_dato(p))), i, v)
    retornar 0
}

funcion memoria_asignar(n) {
    sea r = vec_nuevo()
    sea i = 0
    mientras (i < dyn_valor_entero(n)) {
        vec_agregar(r, 1)
        i = i + 1
    }
    retornar dyn_caja(2, r)
}

funcion memoria_liberar(bloque) {
    si (dyn_tipo(bloque) == 2) { __guardar64(dyn_dato(bloque), 0) }
    retornar 0
}

// ── comptime ──────────────────────────────────────────────────────────────
// El compilador ejecuta comptime(expr) en un subproceso; el valor vuelve como
// un literal del lenguaje (nulo, booleano, número, texto, lista o mapa).

funcion comptime_literal(v) {
    sea s = str_nuevo(64)
    comptime_escribir(s, v)
    retornar dyn_texto(s)
}

funcion comptime_escribir(s, v) {
    sea t = dyn_tipo(v)
    si (t == 0) { str_agregar(s, "nulo") retornar 0 }
    si (v == 4) { str_agregar(s, "verdadero") retornar 0 }
    si (v == 2) { str_agregar(s, "falso") retornar 0 }
    si (t == 6) { str_agregar(s, dyn_a_str(v)) retornar 0 }
    si (t == 4) {
        sea n = dyn_a_str(v)
        sea i = 0
        sea decimal = 0
        mientras (i < str_largo(n)) {
            sea b = str_byte(n, i)
            si (b == 46 o b == 101 o b == 69) { decimal = 1 }
            si (b == 110 o b == 105) { dyn_error("comptime: un número no finito no se puede escribir como literal") }
            i = i + 1
        }
        str_agregar(s, n)
        si (decimal == 0) { str_agregar(s, ".0") }
        retornar 0
    }
    si (t == 1) {
        sea x = dyn_dato(v)
        str_agregar_byte(s, 34)
        sea i = 0
        mientras (i < str_largo(x)) {
            sea b = str_byte(x, i)
            si (b == 34 o b == 92 o b == 123) {
                str_agregar_byte(s, 92)
                str_agregar_byte(s, b)
            } sino {
                si (b == 10) { str_agregar(s, "\\n") } sino {
                    si (b == 9) { str_agregar(s, "\\t") } sino {
                        si (b == 13) { str_agregar(s, "\\r") } sino { str_agregar_byte(s, b) }
                    }
                }
            }
            i = i + 1
        }
        str_agregar_byte(s, 34)
        retornar 0
    }
    si (t == 2) {
        sea l = dyn_dato(v)
        str_agregar(s, "[")
        sea i = 0
        mientras (i < vec_largo(l)) {
            si (i > 0) { str_agregar(s, ", ") }
            comptime_escribir(s, vec_obtener(l, i))
            i = i + 1
        }
        str_agregar(s, "]")
        retornar 0
    }
    si (t == 3) {
        sea m = dyn_dato(v)
        si (map_tiene(m, "__clase")) { dyn_error("comptime: un objeto no se puede escribir como literal (usa listas o mapas)") }
        sea k = dyn_claves_ordenadas(m)
        str_agregar(s, "{")
        sea i = 0
        mientras (i < vec_largo(k)) {
            si (i > 0) { str_agregar(s, ", ") }
            comptime_escribir(s, dyn_texto(vec_obtener(k, i)))
            str_agregar(s, ": ")
            comptime_escribir(s, map_obtener(m, vec_obtener(k, i)))
            i = i + 1
        }
        str_agregar(s, "}")
        retornar 0
    }
    dyn_error_tipo("comptime: no se puede escribir como literal", v)
    retornar 0
}
