// runtime/cripto.cfv — criptografía moderna en C-Forge puro (puente).
//
// SHA-512 / SHA-384, HMAC (SHA-256 y SHA-512), HKDF, comparación en tiempo
// constante, AES-256-GCM, X25519 y Ed25519 (aritmética de TweetNaCl: campo
// 2^255 - 19 en 16 cifras de 16 bits) y RSA-OAEP (Montgomery con cifras de
// 16 bits). Los textos son bytes; las funciones del lenguaje reciben y
// devuelven textos (bytes crudos) salvo las que dicen "hex".

// ── SHA-512 ──────────────────────────────────────────────────────────────

funcion cr_hex64(s, i) {
    sea v = 0
    sea k = 0
    mientras (k < 16) {
        v = __o_bits(__desplazar_izq(v, 4), valor_hex(str_byte(s, i + k)))
        k = k + 1
    }
    retornar v
}

funcion sha512_k() {
    sea k = mem_global(29)
    si (k != 0) { retornar k }
    sea t = "428a2f98d728ae22 7137449123ef65cd b5c0fbcfec4d3b2f e9b5dba58189dbbc 3956c25bf348b538 59f111f1b605d019 923f82a4af194f9b ab1c5ed5da6d8118 d807aa98a3030242 12835b0145706fbe 243185be4ee4b28c 550c7dc3d5ffb4e2 72be5d74f27b896f 80deb1fe3b1696b1 9bdc06a725c71235 c19bf174cf692694 e49b69c19ef14ad2 efbe4786384f25e3 0fc19dc68b8cd5b5 240ca1cc77ac9c65 2de92c6f592b0275 4a7484aa6ea6e483 5cb0a9dcbd41fbd4 76f988da831153b5 983e5152ee66dfab a831c66d2db43210 b00327c898fb213f bf597fc7beef0ee4 c6e00bf33da88fc2 d5a79147930aa725 06ca6351e003826f 142929670a0e6e70 27b70a8546d22ffc 2e1b21385c26c926 4d2c6dfc5ac42aed 53380d139d95b3df 650a73548baf63de 766a0abb3c77b2a8 81c2c92e47edaee6 92722c851482353b a2bfe8a14cf10364 a81a664bbc423001 c24b8b70d0f89791 c76c51a30654be30 d192e819d6ef5218 d69906245565a910 f40e35855771202a 106aa07032bbd1b8 19a4c116b8d2d0c8 1e376c085141ab53 2748774cdf8eeb99 34b0bcb5e19b48a8 391c0cb3c5c95a63 4ed8aa4ae3418acb 5b9cca4f7763e373 682e6ff3d6b2b8a3 748f82ee5defb2fc 78a5636f43172f60 84c87814a1f0ab72 8cc702081a6439ec 90befffa23631e28 a4506cebde82bde9 bef9a3f7b2c67915 c67178f2e372532b ca273eceea26619c d186b8c721c0c207 eada7dd6cde0eb1e f57d4f7fee6ed178 06f067aa72176fba 0a637dc5a2c898a6 113f9804bef90dae 1b710b35131c471b 28db77f523047d84 32caab7b40c72493 3c9ebe0a15c9bebc 431d67c49c100d4c 4cc5d4becb3e42b6 597f299cfc657e2a 5fcb6fab3ad6faec 6c44198c4a475817"
    k = mem_reservar(80 * 8)
    sea i = 0
    mientras (i < 80) {
        __guardar64(k + i * 8, cr_hex64(t, i * 17))
        i = i + 1
    }
    mem_fijar_global(29, k)
    retornar k
}

funcion rotd64(x, n) { retornar __o_bits(__desplazar_der(x, n), __desplazar_izq(x, 64 - n)) }

// Bytes crudos → resumen de 64 bytes (o 48 con sha384).
funcion sha512_crudo(m, es384) {
    sea h = mem_reservar(64)
    si (es384) {
        __guardar64(h, cr_hex64("cbbb9d5dc1059ed8", 0))
        __guardar64(h + 8, cr_hex64("629a292a367cd507", 0))
        __guardar64(h + 16, cr_hex64("9159015a3070dd17", 0))
        __guardar64(h + 24, cr_hex64("152fecd8f70e5939", 0))
        __guardar64(h + 32, cr_hex64("67332667ffc00b31", 0))
        __guardar64(h + 40, cr_hex64("8eb44a8768581511", 0))
        __guardar64(h + 48, cr_hex64("db0c2e0d64f98fa7", 0))
        __guardar64(h + 56, cr_hex64("47b5481dbefa4fa4", 0))
    } sino {
        __guardar64(h, cr_hex64("6a09e667f3bcc908", 0))
        __guardar64(h + 8, cr_hex64("bb67ae8584caa73b", 0))
        __guardar64(h + 16, cr_hex64("3c6ef372fe94f82b", 0))
        __guardar64(h + 24, cr_hex64("a54ff53a5f1d36f1", 0))
        __guardar64(h + 32, cr_hex64("510e527fade682d1", 0))
        __guardar64(h + 40, cr_hex64("9b05688c2b3e6c1f", 0))
        __guardar64(h + 48, cr_hex64("1f83d9abfb41bd6b", 0))
        __guardar64(h + 56, cr_hex64("5be0cd19137e2179", 0))
    }
    // Relleno a bloques de 128 bytes con la longitud (128 bits) al final.
    sea s = str_nuevo(str_largo(m) + 144)
    str_agregar(s, m)
    str_agregar_byte(s, 128)
    mientras (str_largo(s) % 128 != 112) { str_agregar_byte(s, 0) }
    sea bits = str_largo(m) * 8
    sea i = 0
    mientras (i < 8) {
        str_agregar_byte(s, 0)
        i = i + 1
    }
    i = 0
    mientras (i < 8) {
        str_agregar_byte(s, __y_bits(__desplazar_der(bits, (7 - i) * 8), 255))
        i = i + 1
    }
    sea k = sha512_k()
    sea w = mem_reservar(80 * 8)
    sea bloque = 0
    mientras (bloque < str_largo(s)) {
        i = 0
        mientras (i < 16) {
            sea v = 0
            sea j = 0
            mientras (j < 8) {
                v = __o_bits(__desplazar_izq(v, 8), str_byte(s, bloque + i * 8 + j))
                j = j + 1
            }
            __guardar64(w + i * 8, v)
            i = i + 1
        }
        mientras (i < 80) {
            sea w15 = __cargar64(w + (i - 15) * 8)
            sea w2 = __cargar64(w + (i - 2) * 8)
            sea s0 = __xo_bits(__xo_bits(rotd64(w15, 1), rotd64(w15, 8)), __desplazar_der(w15, 7))
            sea s1 = __xo_bits(__xo_bits(rotd64(w2, 19), rotd64(w2, 61)), __desplazar_der(w2, 6))
            __guardar64(w + i * 8, __cargar64(w + (i - 16) * 8) + s0 + __cargar64(w + (i - 7) * 8) + s1)
            i = i + 1
        }
        sea a = __cargar64(h)
        sea b = __cargar64(h + 8)
        sea c = __cargar64(h + 16)
        sea d = __cargar64(h + 24)
        sea e = __cargar64(h + 32)
        sea f = __cargar64(h + 40)
        sea g = __cargar64(h + 48)
        sea hh = __cargar64(h + 56)
        i = 0
        mientras (i < 80) {
            sea S1 = __xo_bits(__xo_bits(rotd64(e, 14), rotd64(e, 18)), rotd64(e, 41))
            sea ch = __xo_bits(__y_bits(e, f), __y_bits(__xo_bits(e, 0 - 1), g))
            sea t1 = hh + S1 + ch + __cargar64(k + i * 8) + __cargar64(w + i * 8)
            sea S0 = __xo_bits(__xo_bits(rotd64(a, 28), rotd64(a, 34)), rotd64(a, 39))
            sea mayoria = __xo_bits(__xo_bits(__y_bits(a, b), __y_bits(a, c)), __y_bits(b, c))
            sea t2 = S0 + mayoria
            hh = g
            g = f
            f = e
            e = d + t1
            d = c
            c = b
            b = a
            a = t1 + t2
            i = i + 1
        }
        __guardar64(h, __cargar64(h) + a)
        __guardar64(h + 8, __cargar64(h + 8) + b)
        __guardar64(h + 16, __cargar64(h + 16) + c)
        __guardar64(h + 24, __cargar64(h + 24) + d)
        __guardar64(h + 32, __cargar64(h + 32) + e)
        __guardar64(h + 40, __cargar64(h + 40) + f)
        __guardar64(h + 48, __cargar64(h + 48) + g)
        __guardar64(h + 56, __cargar64(h + 56) + hh)
        bloque = bloque + 128
    }
    sea largo = 64
    si (es384) { largo = 48 }
    sea r = str_nuevo(64)
    i = 0
    mientras (i < largo) {
        str_agregar_byte(r, __y_bits(__desplazar_der(__cargar64(h + (i / 8) * 8), (7 - i % 8) * 8), 255))
        i = i + 1
    }
    mem_liberar(w)
    mem_liberar(h)
    retornar r
}

funcion sha256_crudo(m) { retornar hex_a_bytes(dyn_texto_de(cfv_sha256(dyn_texto(m)), "sha256")) }
funcion sha1_crudo_bytes(m) { retornar hex_a_bytes(sha1_crudo(m)) }

// Resumen por nombre: 1 sha1 · 256 sha256 · 384 · 512.
funcion cr_resumen(alg, m) {
    si (alg == 1) { retornar sha1_crudo_bytes(m) }
    si (alg == 256) { retornar sha256_crudo(m) }
    si (alg == 384) { retornar sha512_crudo(m, 1) }
    retornar sha512_crudo(m, 0)
}

funcion cr_bloque(alg) {
    si (alg == 384 o alg == 512) { retornar 128 }
    retornar 64
}

funcion cr_hex(s) {
    sea r = str_nuevo(str_largo(s) * 2)
    hex_de_memoria(r, str_datos(s), str_largo(s))
    retornar r
}

// HMAC (RFC 2104) con bytes crudos.
funcion hmac_crudo(alg, k, m) {
    sea b = cr_bloque(alg)
    si (str_largo(k) > b) { k = cr_resumen(alg, k) }
    sea interno = str_nuevo(b + str_largo(m))
    sea externo = str_nuevo(b + 64)
    sea i = 0
    mientras (i < b) {
        sea x = 0
        si (i < str_largo(k)) { x = str_byte(k, i) }
        str_agregar_byte(interno, __xo_bits(x, 54))
        str_agregar_byte(externo, __xo_bits(x, 92))
        i = i + 1
    }
    str_agregar(interno, m)
    str_agregar(externo, cr_resumen(alg, interno))
    retornar cr_resumen(alg, externo)
}

// HKDF (RFC 5869): extraer y expandir.
funcion hkdf_crudo(alg, ikm, sal, info, largo) {
    sea hlen = str_largo(cr_resumen(alg, ""))
    si (str_largo(sal) == 0) {
        sal = str_nuevo(hlen)
        sea z = 0
        mientras (z < hlen) {
            str_agregar_byte(sal, 0)
            z = z + 1
        }
    }
    sea prk = hmac_crudo(alg, sal, ikm)
    sea r = str_nuevo(largo + hlen)
    sea t = ""
    sea n = 1
    mientras (str_largo(r) < largo) {
        sea entrada = str_nuevo(str_largo(t) + str_largo(info) + 1)
        str_agregar(entrada, t)
        str_agregar(entrada, info)
        str_agregar_byte(entrada, n)
        t = hmac_crudo(alg, prk, entrada)
        str_agregar(r, t)
        n = n + 1
    }
    retornar str_rebanar(r, 0, largo)
}

// ── Funciones del lenguaje (hash y MAC) ──
funcion sha512(t) { retornar dyn_texto(cr_hex(sha512_crudo(dyn_a_str(t), 0))) }
funcion sha384(t) { retornar dyn_texto(cr_hex(sha512_crudo(dyn_a_str(t), 1))) }
funcion sha512_bytes(t) { retornar dyn_texto(sha512_crudo(dyn_a_str(t), 0)) }
funcion hmac_sha512(clave, mensaje) { retornar dyn_texto(cr_hex(hmac_crudo(512, dyn_a_str(clave), dyn_a_str(mensaje)))) }
funcion hmac_sha512_bytes(clave, mensaje) { retornar dyn_texto(hmac_crudo(512, dyn_a_str(clave), dyn_a_str(mensaje))) }
funcion hkdf_sha256(ikm, sal, info, largo) { retornar dyn_texto(hkdf_crudo(256, dyn_a_str(ikm), dyn_a_str(sal), dyn_a_str(info), dyn_valor_entero(largo))) }
funcion hkdf_sha512(ikm, sal, info, largo) { retornar dyn_texto(hkdf_crudo(512, dyn_a_str(ikm), dyn_a_str(sal), dyn_a_str(info), dyn_valor_entero(largo))) }

// Igualdad en tiempo constante (para comparar firmas, MAC, tokens).
funcion comparar_seguro(a, b) {
    sea x = dyn_a_str(a)
    sea y = dyn_a_str(b)
    sea d = __xo_bits(str_largo(x), str_largo(y))
    sea n = str_largo(x)
    si (str_largo(y) < n) { n = str_largo(y) }
    sea i = 0
    mientras (i < n) {
        d = __o_bits(d, __xo_bits(str_byte(x, i), str_byte(y, i)))
        i = i + 1
    }
    retornar dyn_bool(d == 0)
}

funcion bytes_aleatorios(n) {
    sea k = dyn_valor_entero(n)
    si (k < 0 o k > 65536) { dyn_error("bytes_aleatorios: n debe ser 0..65536") }
    sea r = str_nuevo(k)
    si (k > 0 y sys_aleatorio(str_datos(r), k) != 0) { dyn_error("bytes_aleatorios: el sistema no entregó bytes aleatorios") }
    __guardar64(r, k)
    retornar dyn_texto(r)
}

// ── AES-256-GCM (NIST SP 800-38D) ───────────────────────────────────────

funcion cr_be64(s, i) {
    sea v = 0
    sea k = 0
    mientras (k < 8) {
        v = __o_bits(__desplazar_izq(v, 8), str_byte(s, i + k))
        k = k + 1
    }
    retornar v
}

funcion cr_poner_be64(p, v) {
    sea k = 0
    mientras (k < 8) {
        __guardar8(p + k, __y_bits(__desplazar_der(v, (7 - k) * 8), 255))
        k = k + 1
    }
    retornar 0
}

// GHASH: y ← (y ⊕ bloque) · h en GF(2^128); y y h como [alto][bajo].
funcion ghash_bloque(y, h, bloque, i) {
    sea x_alto = __xo_bits(__cargar64(y), cr_be64(bloque, i))
    sea x_bajo = __xo_bits(__cargar64(y + 8), cr_be64(bloque, i + 8))
    sea z_alto = 0
    sea z_bajo = 0
    sea v_alto = __cargar64(h)
    sea v_bajo = __cargar64(h + 8)
    sea r = __desplazar_izq(225, 56)
    sea k = 0
    mientras (k < 128) {
        sea bit = 0
        si (k < 64) { bit = __y_bits(__desplazar_der(x_alto, 63 - k), 1) } sino { bit = __y_bits(__desplazar_der(x_bajo, 127 - k), 1) }
        // Sin ramas sobre datos secretos: máscaras.
        sea mascara = 0 - bit
        z_alto = __xo_bits(z_alto, __y_bits(v_alto, mascara))
        z_bajo = __xo_bits(z_bajo, __y_bits(v_bajo, mascara))
        sea lsb = 0 - __y_bits(v_bajo, 1)
        v_bajo = __o_bits(__desplazar_der(v_bajo, 1), __desplazar_izq(v_alto, 63))
        v_alto = __xo_bits(__desplazar_der(v_alto, 1), __y_bits(r, lsb))
        k = k + 1
    }
    __guardar64(y, z_alto)
    __guardar64(y + 8, z_bajo)
    retornar 0
}

funcion ghash_texto(y, h, s) {
    sea i = 0
    mientras (i < str_largo(s)) {
        sea b = str_nuevo(16)
        sea k = 0
        mientras (k < 16) {
            si (i + k < str_largo(s)) { str_agregar_byte(b, str_byte(s, i + k)) } sino { str_agregar_byte(b, 0) }
            k = k + 1
        }
        ghash_bloque(y, h, b, 0)
        i = i + 16
    }
    retornar 0
}

// Contador de 32 bits del bloque (bytes 12..15) + 1.
funcion gcm_incrementar(p) {
    sea v = __o_bits(__o_bits(__desplazar_izq(__cargar8(p + 12), 24), __desplazar_izq(__cargar8(p + 13), 16)), __o_bits(__desplazar_izq(__cargar8(p + 14), 8), __cargar8(p + 15)))
    v = __y_bits(v + 1, 4294967295)
    __guardar8(p + 12, __y_bits(__desplazar_der(v, 24), 255))
    __guardar8(p + 13, __y_bits(__desplazar_der(v, 16), 255))
    __guardar8(p + 14, __y_bits(__desplazar_der(v, 8), 255))
    __guardar8(p + 15, __y_bits(v, 255))
    retornar 0
}

// cifrar: texto → cifrado || etiqueta (16); descifrar: lo inverso (o -1).
funcion gcm_crudo(clave, nonce, texto, aad, cifrar) {
    si (str_largo(clave) != 32) { dyn_error("aes_gcm: la clave debe tener 32 bytes") }
    si (str_largo(nonce) != 12) { dyn_error("aes_gcm: el nonce debe tener 12 bytes") }
    sea w = aes_expandir(str_datos(clave))
    sea h = mem_reservar(16)
    mem_llenar(h, 0, 16)
    aes_bloque_cifrar(h, w)
    sea hs = str_nuevo(16)
    sea k = 0
    mientras (k < 16) {
        str_agregar_byte(hs, __cargar8(h + k))
        k = k + 1
    }
    __guardar64(h, cr_be64(hs, 0))
    __guardar64(h + 8, cr_be64(hs, 8))
    sea j0 = mem_reservar(16)
    k = 0
    mientras (k < 12) {
        __guardar8(j0 + k, str_byte(nonce, k))
        k = k + 1
    }
    __guardar8(j0 + 12, 0)
    __guardar8(j0 + 13, 0)
    __guardar8(j0 + 14, 0)
    __guardar8(j0 + 15, 1)
    sea etiqueta_rec = ""
    sea n = str_largo(texto)
    si (cifrar == 0) {
        si (n < 16) { retornar 0 - 1 }
        etiqueta_rec = str_rebanar(texto, n - 16, n)
        texto = str_rebanar(texto, 0, n - 16)
        n = n - 16
    }
    // CTR desde J0 + 1.
    sea contador = mem_reservar(16)
    sea flujo = mem_reservar(16)
    k = 0
    mientras (k < 16) {
        __guardar8(contador + k, __cargar8(j0 + k))
        k = k + 1
    }
    sea salida = str_nuevo(n + 16)
    sea i = 0
    mientras (i < n) {
        gcm_incrementar(contador)
        k = 0
        mientras (k < 16) {
            __guardar8(flujo + k, __cargar8(contador + k))
            k = k + 1
        }
        aes_bloque_cifrar(flujo, w)
        k = 0
        mientras (k < 16 y i + k < n) {
            str_agregar_byte(salida, __xo_bits(str_byte(texto, i + k), __cargar8(flujo + k)))
            k = k + 1
        }
        i = i + 16
    }
    // Etiqueta: GHASH(aad, cifrado, longitudes) ⊕ AES(J0).
    sea cifrado = salida
    si (cifrar == 0) { cifrado = texto }
    sea y = mem_reservar(16)
    mem_llenar(y, 0, 16)
    ghash_texto(y, h, aad)
    ghash_texto(y, h, cifrado)
    sea largos = str_nuevo(16)
    sea lp = mem_reservar(16)
    cr_poner_be64(lp, str_largo(aad) * 8)
    cr_poner_be64(lp + 8, n * 8)
    k = 0
    mientras (k < 16) {
        str_agregar_byte(largos, __cargar8(lp + k))
        k = k + 1
    }
    ghash_bloque(y, h, largos, 0)
    aes_bloque_cifrar(j0, w)
    sea etiqueta = str_nuevo(16)
    cr_poner_be64(lp, __cargar64(y))
    cr_poner_be64(lp + 8, __cargar64(y + 8))
    k = 0
    mientras (k < 16) {
        str_agregar_byte(etiqueta, __xo_bits(__cargar8(lp + k), __cargar8(j0 + k)))
        k = k + 1
    }
    mem_liberar(w)
    si (cifrar) {
        str_agregar(salida, etiqueta)
        retornar salida
    }
    sea d = 0
    k = 0
    mientras (k < 16) {
        d = __o_bits(d, __xo_bits(str_byte(etiqueta, k), str_byte(etiqueta_rec, k)))
        k = k + 1
    }
    si (d != 0) { retornar 0 - 1 }
    retornar salida
}

funcion aes_gcm_cifrar(clave, nonce, texto, aad) {
    sea a = ""
    si (aad != 0) { a = dyn_a_str(aad) }
    retornar dyn_texto(gcm_crudo(dyn_a_str(clave), dyn_a_str(nonce), dyn_a_str(texto), a, 1))
}

funcion aes_gcm_descifrar(clave, nonce, cifrado, aad) {
    sea a = ""
    si (aad != 0) { a = dyn_a_str(aad) }
    sea r = gcm_crudo(dyn_a_str(clave), dyn_a_str(nonce), dyn_a_str(cifrado), a, 0)
    si (r == 0 - 1) { dyn_error("aes_gcm_descifrar: la etiqueta no coincide (clave, nonce o datos alterados)") }
    retornar dyn_texto(r)
}

// ── Curva 25519 (X25519 y Ed25519), aritmética de TweetNaCl ──────────────
// gf: 16 cifras de 16 bits con signo en enteros de 64 bits.

funcion gf_nuevo() {
    sea p = mem_reservar(128)
    mem_llenar(p, 0, 128)
    retornar p
}
funcion gf(p, i) { retornar __cargar64(p + i * 8) }
funcion gf_fijar(p, i, v) {
    __guardar64(p + i * 8, v)
    retornar 0
}
funcion gf_de(valores) {
    // valores: texto de 16 cifras hex de 4 dígitos separadas por espacio.
    sea p = gf_nuevo()
    sea i = 0
    mientras (i < 16) {
        sea v = 0
        sea k = 0
        mientras (k < 4) {
            v = v * 16 + valor_hex(str_byte(valores, i * 5 + k))
            k = k + 1
        }
        gf_fijar(p, i, v)
        i = i + 1
    }
    retornar p
}
funcion gf_copiar(r, a) {
    sea i = 0
    mientras (i < 16) {
        gf_fijar(r, i, gf(a, i))
        i = i + 1
    }
    retornar 0
}

funcion car25519(o) {
    sea i = 0
    mientras (i < 16) {
        gf_fijar(o, i, gf(o, i) + 65536)
        sea c = __desplazar_aritmetico(gf(o, i), 16)
        si (i < 15) {
            gf_fijar(o, i + 1, gf(o, i + 1) + c - 1)
        } sino {
            gf_fijar(o, 0, gf(o, 0) + c - 1 + 37 * (c - 1))
        }
        gf_fijar(o, i, gf(o, i) - __desplazar_izq(c, 16))
        i = i + 1
    }
    retornar 0
}

// Intercambio condicional sin ramas (b = 0 o 1).
funcion sel25519(p, q, b) {
    sea c = 0 - b
    sea i = 0
    mientras (i < 16) {
        sea t = __y_bits(c, __xo_bits(gf(p, i), gf(q, i)))
        gf_fijar(p, i, __xo_bits(gf(p, i), t))
        gf_fijar(q, i, __xo_bits(gf(q, i), t))
        i = i + 1
    }
    retornar 0
}

funcion pack25519(o, n) {
    sea m = gf_nuevo()
    sea t = gf_nuevo()
    gf_copiar(t, n)
    car25519(t)
    car25519(t)
    car25519(t)
    sea j = 0
    mientras (j < 2) {
        gf_fijar(m, 0, gf(t, 0) - 65517)
        sea i = 1
        mientras (i < 15) {
            gf_fijar(m, i, gf(t, i) - 65535 - __y_bits(__desplazar_aritmetico(gf(m, i - 1), 16), 1))
            gf_fijar(m, i - 1, __y_bits(gf(m, i - 1), 65535))
            i = i + 1
        }
        gf_fijar(m, 15, gf(t, 15) - 32767 - __y_bits(__desplazar_aritmetico(gf(m, 14), 16), 1))
        sea b = __y_bits(__desplazar_aritmetico(gf(m, 15), 16), 1)
        gf_fijar(m, 14, __y_bits(gf(m, 14), 65535))
        sel25519(t, m, 1 - b)
        j = j + 1
    }
    sea i = 0
    mientras (i < 16) {
        __guardar8(o + 2 * i, __y_bits(gf(t, i), 255))
        __guardar8(o + 2 * i + 1, __y_bits(__desplazar_aritmetico(gf(t, i), 8), 255))
        i = i + 1
    }
    mem_liberar(m)
    mem_liberar(t)
    retornar 0
}

funcion iguales32(a, b) {
    sea d = 0
    sea i = 0
    mientras (i < 32) {
        d = __o_bits(d, __xo_bits(__cargar8(a + i), __cargar8(b + i)))
        i = i + 1
    }
    retornar d == 0
}

funcion neq25519(a, b) {
    sea c = mem_reservar(32)
    sea d = mem_reservar(32)
    pack25519(c, a)
    pack25519(d, b)
    sea r = iguales32(c, d) == 0
    mem_liberar(c)
    mem_liberar(d)
    retornar r
}

funcion par25519(a) {
    sea d = mem_reservar(32)
    pack25519(d, a)
    sea r = __y_bits(__cargar8(d), 1)
    mem_liberar(d)
    retornar r
}

funcion unpack25519(o, n) {
    sea i = 0
    mientras (i < 16) {
        gf_fijar(o, i, __cargar8(n + 2 * i) + __desplazar_izq(__cargar8(n + 2 * i + 1), 8))
        i = i + 1
    }
    gf_fijar(o, 15, __y_bits(gf(o, 15), 32767))
    retornar 0
}

funcion gf_A(o, a, b) {
    sea i = 0
    mientras (i < 16) {
        gf_fijar(o, i, gf(a, i) + gf(b, i))
        i = i + 1
    }
    retornar 0
}
funcion gf_Z(o, a, b) {
    sea i = 0
    mientras (i < 16) {
        gf_fijar(o, i, gf(a, i) - gf(b, i))
        i = i + 1
    }
    retornar 0
}
funcion gf_M(o, a, b) {
    sea t = mem_reservar(31 * 8)
    mem_llenar(t, 0, 31 * 8)
    sea i = 0
    mientras (i < 16) {
        sea ai = gf(a, i)
        sea j = 0
        mientras (j < 16) {
            __guardar64(t + (i + j) * 8, __cargar64(t + (i + j) * 8) + ai * gf(b, j))
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    mientras (i < 15) {
        __guardar64(t + i * 8, __cargar64(t + i * 8) + 38 * __cargar64(t + (i + 16) * 8))
        i = i + 1
    }
    i = 0
    mientras (i < 16) {
        gf_fijar(o, i, __cargar64(t + i * 8))
        i = i + 1
    }
    mem_liberar(t)
    car25519(o)
    car25519(o)
    retornar 0
}
funcion gf_S(o, a) { retornar gf_M(o, a, a) }

funcion inv25519(o, entrada) {
    sea c = gf_nuevo()
    gf_copiar(c, entrada)
    sea a = 253
    mientras (a >= 0) {
        gf_S(c, c)
        si (a != 2 y a != 4) { gf_M(c, c, entrada) }
        a = a - 1
    }
    gf_copiar(o, c)
    mem_liberar(c)
    retornar 0
}

funcion pow2523(o, entrada) {
    sea c = gf_nuevo()
    gf_copiar(c, entrada)
    sea a = 250
    mientras (a >= 0) {
        gf_S(c, c)
        si (a != 1) { gf_M(c, c, entrada) }
        a = a - 1
    }
    gf_copiar(o, c)
    mem_liberar(c)
    retornar 0
}

// X25519 (RFC 7748): q ← n · p (32 bytes cada uno).
funcion x25519_crudo(q, n, p) {
    sea z = mem_reservar(32)
    sea i = 0
    mientras (i < 32) {
        __guardar8(z + i, __cargar8(n + i))
        i = i + 1
    }
    __guardar8(z + 31, __o_bits(__y_bits(__cargar8(n + 31), 127), 64))
    __guardar8(z, __y_bits(__cargar8(z), 248))
    sea x = gf_nuevo()
    unpack25519(x, p)
    sea a = gf_nuevo()
    sea b = gf_nuevo()
    sea c = gf_nuevo()
    sea d = gf_nuevo()
    sea e = gf_nuevo()
    sea f = gf_nuevo()
    sea k121665 = gf_de("db41 0001 0000 0000 0000 0000 0000 0000 0000 0000 0000 0000 0000 0000 0000 0000")
    gf_copiar(b, x)
    gf_fijar(a, 0, 1)
    gf_fijar(d, 0, 1)
    i = 254
    mientras (i >= 0) {
        sea r = __y_bits(__desplazar_der(__cargar8(z + __desplazar_der(i, 3)), __y_bits(i, 7)), 1)
        sel25519(a, b, r)
        sel25519(c, d, r)
        gf_A(e, a, c)
        gf_Z(a, a, c)
        gf_A(c, b, d)
        gf_Z(b, b, d)
        gf_S(d, e)
        gf_S(f, a)
        gf_M(a, c, a)
        gf_M(c, b, e)
        gf_A(e, a, c)
        gf_Z(a, a, c)
        gf_S(b, a)
        gf_Z(c, d, f)
        gf_M(a, c, k121665)
        gf_A(a, a, d)
        gf_M(c, c, a)
        gf_M(a, d, f)
        gf_M(d, b, x)
        gf_S(b, e)
        sel25519(a, b, r)
        sel25519(c, d, r)
        i = i - 1
    }
    inv25519(c, c)
    gf_M(a, a, c)
    pack25519(q, a)
    retornar 0
}

funcion cr_memoria_de(s, n) {
    si (str_largo(s) != n) { retornar 0 }
    sea p = mem_reservar(n)
    sea i = 0
    mientras (i < n) {
        __guardar8(p + i, str_byte(s, i))
        i = i + 1
    }
    retornar p
}

funcion cr_texto_de(p, n) {
    sea r = str_nuevo(n)
    sea i = 0
    mientras (i < n) {
        str_agregar_byte(r, __cargar8(p + i))
        i = i + 1
    }
    retornar r
}

funcion x25519(escalar, punto) {
    sea n = cr_memoria_de(dyn_a_str(escalar), 32)
    sea p = cr_memoria_de(dyn_a_str(punto), 32)
    si (n == 0 o p == 0) { dyn_error("x25519: el escalar y el punto deben tener 32 bytes") }
    sea q = mem_reservar(32)
    x25519_crudo(q, n, p)
    retornar dyn_texto(cr_texto_de(q, 32))
}

funcion x25519_base(escalar) {
    sea nueve = str_nuevo(32)
    str_agregar_byte(nueve, 9)
    sea i = 1
    mientras (i < 32) {
        str_agregar_byte(nueve, 0)
        i = i + 1
    }
    retornar x25519(escalar, dyn_texto(nueve))
}

// ── Ed25519 (RFC 8032) ──
// Punto: 4 gf seguidos (x, y, z, t) en 512 bytes.
funcion ed_punto() {
    sea p = mem_reservar(512)
    mem_llenar(p, 0, 512)
    retornar p
}
funcion ed_c(p, k) { retornar p + k * 128 }

funcion ed_D2() { retornar gf_de("f159 26b2 9b94 ebd6 b156 8283 149a 00e0 d130 eef3 80f2 198e fce7 56df d9dc 2406") }
funcion ed_D() { retornar gf_de("78a3 1359 4dca 75eb d8ab 4141 0a4d 0070 e898 7779 4079 8cc7 fe73 2b6f 6cee 5203") }

funcion ed_sumar(p, q) {
    sea a = gf_nuevo()
    sea b = gf_nuevo()
    sea c = gf_nuevo()
    sea d = gf_nuevo()
    sea t = gf_nuevo()
    sea e = gf_nuevo()
    sea f = gf_nuevo()
    sea g = gf_nuevo()
    sea h = gf_nuevo()
    gf_Z(a, ed_c(p, 1), ed_c(p, 0))
    gf_Z(t, ed_c(q, 1), ed_c(q, 0))
    gf_M(a, a, t)
    gf_A(b, ed_c(p, 0), ed_c(p, 1))
    gf_A(t, ed_c(q, 0), ed_c(q, 1))
    gf_M(b, b, t)
    gf_M(c, ed_c(p, 3), ed_c(q, 3))
    sea d2 = ed_D2()
    gf_M(c, c, d2)
    gf_M(d, ed_c(p, 2), ed_c(q, 2))
    gf_A(d, d, d)
    gf_Z(e, b, a)
    gf_Z(f, d, c)
    gf_A(g, d, c)
    gf_A(h, b, a)
    gf_M(ed_c(p, 0), e, f)
    gf_M(ed_c(p, 1), h, g)
    gf_M(ed_c(p, 2), g, f)
    gf_M(ed_c(p, 3), e, h)
    mem_liberar(a) mem_liberar(b) mem_liberar(c) mem_liberar(d) mem_liberar(t)
    mem_liberar(e) mem_liberar(f) mem_liberar(g) mem_liberar(h) mem_liberar(d2)
    retornar 0
}

funcion ed_cswap(p, q, b) {
    sea i = 0
    mientras (i < 4) {
        sel25519(ed_c(p, i), ed_c(q, i), b)
        i = i + 1
    }
    retornar 0
}

funcion ed_empaquetar(r, p) {
    sea tx = gf_nuevo()
    sea ty = gf_nuevo()
    sea zi = gf_nuevo()
    inv25519(zi, ed_c(p, 2))
    gf_M(tx, ed_c(p, 0), zi)
    gf_M(ty, ed_c(p, 1), zi)
    pack25519(r, ty)
    __guardar8(r + 31, __xo_bits(__cargar8(r + 31), __desplazar_izq(par25519(tx), 7)))
    mem_liberar(tx) mem_liberar(ty) mem_liberar(zi)
    retornar 0
}

funcion ed_multiplicar(p, q, s) {
    gf_fijar(ed_c(p, 0), 0, 0)
    gf_fijar(ed_c(p, 1), 0, 1)
    gf_fijar(ed_c(p, 2), 0, 1)
    gf_fijar(ed_c(p, 3), 0, 0)
    sea i = 255
    mientras (i >= 0) {
        sea b = __y_bits(__desplazar_der(__cargar8(s + i / 8), __y_bits(i, 7)), 1)
        ed_cswap(p, q, b)
        ed_sumar(q, p)
        ed_sumar(p, p)
        ed_cswap(p, q, b)
        i = i - 1
    }
    retornar 0
}

funcion ed_base(p, s) {
    sea q = ed_punto()
    sea x = gf_de("d51a 8f25 2d60 c956 a7b2 9525 c760 692c dc5c fdd6 e231 c0a4 53fe cd6e 36d3 2169")
    sea y = gf_de("6658 6666 6666 6666 6666 6666 6666 6666 6666 6666 6666 6666 6666 6666 6666 6666")
    gf_copiar(ed_c(q, 0), x)
    gf_copiar(ed_c(q, 1), y)
    gf_fijar(ed_c(q, 2), 0, 1)
    gf_M(ed_c(q, 3), x, y)
    ed_multiplicar(p, q, s)
    mem_liberar(q) mem_liberar(x) mem_liberar(y)
    retornar 0
}

// L = 2^252 + 27742317777372353535851937790883648493 (orden del grupo).
funcion ed_L(j) {
    si (j == 31) { retornar 16 }
    si (j >= 16) { retornar 0 }
    sea t = "edd3f55c1a631258d69cf7a2def9de14"
    retornar valor_hex(str_byte(t, j * 2)) * 16 + valor_hex(str_byte(t, j * 2 + 1))
}

// r (32 bytes) ← x (64 cifras en enteros) mod L.
funcion ed_modL(r, x) {
    sea i = 63
    mientras (i >= 32) {
        sea carry = 0
        sea j = i - 32
        mientras (j < i - 12) {
            __guardar64(x + j * 8, __cargar64(x + j * 8) + carry - 16 * __cargar64(x + i * 8) * ed_L(j - (i - 32)))
            carry = __desplazar_aritmetico(__cargar64(x + j * 8) + 128, 8)
            __guardar64(x + j * 8, __cargar64(x + j * 8) - __desplazar_izq(carry, 8))
            j = j + 1
        }
        __guardar64(x + j * 8, __cargar64(x + j * 8) + carry)
        __guardar64(x + i * 8, 0)
        i = i - 1
    }
    sea carry = 0
    sea j = 0
    mientras (j < 32) {
        __guardar64(x + j * 8, __cargar64(x + j * 8) + carry - __desplazar_aritmetico(__cargar64(x + 31 * 8), 4) * ed_L(j))
        carry = __desplazar_aritmetico(__cargar64(x + j * 8), 8)
        __guardar64(x + j * 8, __y_bits(__cargar64(x + j * 8), 255))
        j = j + 1
    }
    j = 0
    mientras (j < 32) {
        __guardar64(x + j * 8, __cargar64(x + j * 8) - carry * ed_L(j))
        j = j + 1
    }
    i = 0
    mientras (i < 32) {
        __guardar64(x + (i + 1) * 8, __cargar64(x + (i + 1) * 8) + __desplazar_aritmetico(__cargar64(x + i * 8), 8))
        __guardar8(r + i, __y_bits(__cargar64(x + i * 8), 255))
        i = i + 1
    }
    retornar 0
}

// r (64 bytes) → r mod L en los primeros 32.
funcion ed_reducir(r) {
    sea x = mem_reservar(65 * 8)
    mem_llenar(x, 0, 65 * 8)
    sea i = 0
    mientras (i < 64) {
        __guardar64(x + i * 8, __cargar8(r + i))
        __guardar8(r + i, 0)
        i = i + 1
    }
    ed_modL(r, x)
    mem_liberar(x)
    retornar 0
}

// Semilla de 32 bytes → d = SHA-512(semilla) recortado; publica = d·B.
funcion ed_clave(semilla) {
    sea d = sha512_crudo(semilla, 0)
    sea dp = cr_memoria_de(d, 64)
    __guardar8(dp, __y_bits(__cargar8(dp), 248))
    __guardar8(dp + 31, __o_bits(__y_bits(__cargar8(dp + 31), 127), 64))
    retornar dp
}

funcion ed25519_crudo_publica(dp) {
    sea p = ed_punto()
    sea pk = mem_reservar(32)
    ed_base(p, dp)
    ed_empaquetar(pk, p)
    mem_liberar(p)
    retornar pk
}

funcion ed25519_publica(semilla) {
    sea s = dyn_a_str(semilla)
    si (str_largo(s) != 32) { dyn_error("ed25519_publica: la semilla debe tener 32 bytes") }
    retornar dyn_texto(cr_texto_de(ed25519_crudo_publica(ed_clave(s)), 32))
}

funcion ed25519_firmar(semilla, mensaje) {
    sea s = dyn_a_str(semilla)
    sea m = dyn_a_str(mensaje)
    si (str_largo(s) != 32) { dyn_error("ed25519_firmar: la semilla debe tener 32 bytes") }
    sea dp = ed_clave(s)
    sea pk = ed25519_crudo_publica(dp)
    // r = SHA-512(prefijo || m) mod L
    sea entrada = str_nuevo(32 + str_largo(m))
    str_agregar(entrada, cr_texto_de(dp + 32, 32))
    str_agregar(entrada, m)
    sea rp = cr_memoria_de(sha512_crudo(entrada, 0), 64)
    ed_reducir(rp)
    sea p = ed_punto()
    ed_base(p, rp)
    sea firma = mem_reservar(64)
    ed_empaquetar(firma, p)
    // h = SHA-512(R || A || m) mod L
    sea entrada2 = str_nuevo(64 + str_largo(m))
    str_agregar(entrada2, cr_texto_de(firma, 32))
    str_agregar(entrada2, cr_texto_de(pk, 32))
    str_agregar(entrada2, m)
    sea hp = cr_memoria_de(sha512_crudo(entrada2, 0), 64)
    ed_reducir(hp)
    // S = (r + h·d) mod L
    sea x = mem_reservar(65 * 8)
    mem_llenar(x, 0, 65 * 8)
    sea i = 0
    mientras (i < 32) {
        __guardar64(x + i * 8, __cargar8(rp + i))
        i = i + 1
    }
    i = 0
    mientras (i < 32) {
        sea j = 0
        mientras (j < 32) {
            __guardar64(x + (i + j) * 8, __cargar64(x + (i + j) * 8) + __cargar8(hp + i) * __cargar8(dp + j))
            j = j + 1
        }
        i = i + 1
    }
    ed_modL(firma + 32, x)
    retornar dyn_texto(cr_texto_de(firma, 64))
}

// r ← -A desde la clave pública (32 bytes); 0 si es válida.
funcion ed_desempaquetar_negativo(r, p) {
    sea t = gf_nuevo()
    sea chk = gf_nuevo()
    sea num = gf_nuevo()
    sea den = gf_nuevo()
    sea den2 = gf_nuevo()
    sea den4 = gf_nuevo()
    sea den6 = gf_nuevo()
    sea d = ed_D()
    sea uno = gf_nuevo()
    gf_fijar(uno, 0, 1)
    gf_copiar(ed_c(r, 2), uno)
    unpack25519(ed_c(r, 1), p)
    gf_S(num, ed_c(r, 1))
    gf_M(den, num, d)
    gf_Z(num, num, ed_c(r, 2))
    gf_A(den, ed_c(r, 2), den)
    gf_S(den2, den)
    gf_S(den4, den2)
    gf_M(den6, den4, den2)
    gf_M(t, den6, num)
    gf_M(t, t, den)
    pow2523(t, t)
    gf_M(t, t, num)
    gf_M(t, t, den)
    gf_M(t, t, den)
    gf_M(ed_c(r, 0), t, den)
    gf_S(chk, ed_c(r, 0))
    gf_M(chk, chk, den)
    si (neq25519(chk, num)) {
        sea raiz_i = gf_de("a0b0 4a0e 1b27 c4ee e478 ad2f 1806 2f43 d7a7 3dfb 0099 2b4d df0b 4fc1 2480 2b83")
        gf_M(ed_c(r, 0), ed_c(r, 0), raiz_i)
    }
    gf_S(chk, ed_c(r, 0))
    gf_M(chk, chk, den)
    si (neq25519(chk, num)) { retornar 0 - 1 }
    si (par25519(ed_c(r, 0)) == __desplazar_der(__cargar8(p + 31), 7)) {
        sea cero = gf_nuevo()
        gf_Z(ed_c(r, 0), cero, ed_c(r, 0))
    }
    gf_M(ed_c(r, 3), ed_c(r, 0), ed_c(r, 1))
    retornar 0
}

funcion ed25519_verificar(publica, mensaje, firma) {
    sea pk_s = dyn_a_str(publica)
    sea f_s = dyn_a_str(firma)
    sea m = dyn_a_str(mensaje)
    si (str_largo(pk_s) != 32 o str_largo(f_s) != 64) { retornar dyn_bool(0) }
    sea pk = cr_memoria_de(pk_s, 32)
    sea sm = cr_memoria_de(f_s, 64)
    // S debe ser menor que L (sin maleabilidad).
    sea i = 31
    sea decidido = 0
    mientras (i >= 0 y decidido == 0) {
        sea a = __cargar8(sm + 32 + i)
        sea b = ed_L(i)
        si (a < b) { decidido = 1 }
        si (a > b) { retornar dyn_bool(0) }
        i = i - 1
    }
    si (decidido == 0) { retornar dyn_bool(0) }
    sea q = ed_punto()
    si (ed_desempaquetar_negativo(q, pk) != 0) { retornar dyn_bool(0) }
    sea entrada = str_nuevo(64 + str_largo(m))
    str_agregar(entrada, cr_texto_de(sm, 32))
    str_agregar(entrada, pk_s)
    str_agregar(entrada, m)
    sea hp = cr_memoria_de(sha512_crudo(entrada, 0), 64)
    ed_reducir(hp)
    sea p = ed_punto()
    ed_multiplicar(p, q, hp)
    sea q2 = ed_punto()
    ed_base(q2, sm + 32)
    ed_sumar(p, q2)
    sea t = mem_reservar(32)
    ed_empaquetar(t, p)
    retornar dyn_bool(iguales32(sm, t))
}

// ── RSA-OAEP (cifrar con una clave pública PEM) ─────────────────────────
// Números: [cifras][16 bits por cifra, little endian] en enteros de 64 bits.

funcion bn_nuevo(k) {
    sea p = mem_reservar(k * 8 + 8)
    mem_llenar(p, 0, k * 8 + 8)
    retornar p
}
funcion bn(p, i) { retornar __cargar64(p + i * 8) }
funcion bn_fijar(p, i, v) {
    __guardar64(p + i * 8, v)
    retornar 0
}

// Bytes big endian → número de k cifras.
funcion bn_de_bytes(s, k) {
    sea p = bn_nuevo(k)
    sea n = str_largo(s)
    sea i = 0
    mientras (i < n) {
        sea b = str_byte(s, n - 1 - i)
        sea cifra = i / 2
        si (cifra < k) {
            si (i % 2 == 0) { bn_fijar(p, cifra, bn(p, cifra) + b) } sino { bn_fijar(p, cifra, bn(p, cifra) + b * 256) }
        }
        i = i + 1
    }
    retornar p
}

funcion bn_a_bytes(p, k, largo) {
    sea r = str_nuevo(largo)
    sea i = largo - 1
    mientras (i >= 0) {
        sea cifra = i / 2
        sea v = 0
        si (cifra < k) { v = bn(p, cifra) }
        si (i % 2 == 0) { str_agregar_byte(r, __y_bits(v, 255)) } sino { str_agregar_byte(r, __y_bits(__desplazar_der(v, 8), 255)) }
        i = i - 1
    }
    retornar r
}

// a >= b (k cifras)
funcion bn_mayor_igual(a, b, k) {
    sea i = k - 1
    mientras (i >= 0) {
        si (bn(a, i) > bn(b, i)) { retornar 1 }
        si (bn(a, i) < bn(b, i)) { retornar 0 }
        i = i - 1
    }
    retornar 1
}

funcion bn_restar(a, b, k) {
    sea prestamo = 0
    sea i = 0
    mientras (i < k) {
        sea v = bn(a, i) - bn(b, i) - prestamo
        prestamo = 0
        si (v < 0) {
            v = v + 65536
            prestamo = 1
        }
        bn_fijar(a, i, v)
        i = i + 1
    }
    retornar 0
}

// Montgomery: r = a · b · R^-1 mod n (R = 2^(16k)); ni = -n^-1 mod 2^16.
funcion bn_mont(r, a, b, n, ni, k) {
    sea t = bn_nuevo(k + 2)
    sea i = 0
    mientras (i < k) {
        sea ai = bn(a, i)
        sea carry = 0
        sea j = 0
        mientras (j < k) {
            sea v = bn(t, j) + ai * bn(b, j) + carry
            bn_fijar(t, j, __y_bits(v, 65535))
            carry = __desplazar_der(v, 16)
            j = j + 1
        }
        sea v2 = bn(t, k) + carry
        bn_fijar(t, k, __y_bits(v2, 65535))
        bn_fijar(t, k + 1, bn(t, k + 1) + __desplazar_der(v2, 16))
        sea m = __y_bits(bn(t, 0) * ni, 65535)
        carry = 0
        j = 0
        mientras (j < k) {
            sea v = bn(t, j) + m * bn(n, j) + carry
            bn_fijar(t, j, __y_bits(v, 65535))
            carry = __desplazar_der(v, 16)
            j = j + 1
        }
        v2 = bn(t, k) + carry
        bn_fijar(t, k, __y_bits(v2, 65535))
        bn_fijar(t, k + 1, bn(t, k + 1) + __desplazar_der(v2, 16))
        // t ← t / 2^16
        j = 0
        mientras (j <= k) {
            bn_fijar(t, j, bn(t, j + 1))
            j = j + 1
        }
        bn_fijar(t, k + 1, 0)
        i = i + 1
    }
    si (bn(t, k) != 0 o bn_mayor_igual(t, n, k)) { bn_restar(t, n, k + 1) }
    i = 0
    mientras (i < k) {
        bn_fijar(r, i, bn(t, i))
        i = i + 1
    }
    mem_liberar(t)
    retornar 0
}

// m^e mod n (bytes big endian); el largo del resultado es el de n.
funcion rsa_crudo(mensaje, n_bytes, e_bytes) {
    sea largo = str_largo(n_bytes)
    sea k = (largo + 1) / 2 + 1
    sea n = bn_de_bytes(n_bytes, k)
    // ni = -n^-1 mod 2^16 (Newton sobre el inverso).
    sea x = 1
    sea it = 0
    mientras (it < 5) {
        x = __y_bits(x * (2 - __y_bits(bn(n, 0) * x, 65535)), 65535)
        it = it + 1
    }
    sea ni = __y_bits(65536 - x, 65535)
    // R^2 mod n por duplicaciones.
    sea r2 = bn_nuevo(k + 1)
    bn_fijar(r2, 0, 1)
    sea paso = 0
    mientras (paso < 2 * 16 * k) {
        sea carry = 0
        sea j = 0
        mientras (j <= k) {
            sea v = bn(r2, j) * 2 + carry
            bn_fijar(r2, j, __y_bits(v, 65535))
            carry = __desplazar_der(v, 16)
            j = j + 1
        }
        si (bn(r2, k) != 0 o bn_mayor_igual(r2, n, k)) { bn_restar(r2, n, k + 1) }
        paso = paso + 1
    }
    sea m = bn_de_bytes(mensaje, k)
    sea mm = bn_nuevo(k)
    bn_mont(mm, m, r2, n, ni, k)
    sea uno = bn_nuevo(k)
    bn_fijar(uno, 0, 1)
    sea acc = bn_nuevo(k)
    bn_mont(acc, uno, r2, n, ni, k)
    // Exponenciación de izquierda a derecha.
    sea i = 0
    mientras (i < str_largo(e_bytes)) {
        sea b = 7
        mientras (b >= 0) {
            bn_mont(acc, acc, acc, n, ni, k)
            si (__y_bits(__desplazar_der(str_byte(e_bytes, i), b), 1) == 1) { bn_mont(acc, acc, mm, n, ni, k) }
            b = b - 1
        }
        i = i + 1
    }
    sea resultado = bn_nuevo(k)
    bn_mont(resultado, acc, uno, n, ni, k)
    retornar bn_a_bytes(resultado, k, largo)
}

// DER: [etiqueta][largo][contenido] → posición del contenido y su largo.
funcion der_leer(s, i) {
    sea r = mem_reservar(24)
    __guardar64(r, str_byte(s, i))
    sea l = str_byte(s, i + 1)
    sea pos = i + 2
    si (l >= 128) {
        sea bytes = l - 128
        l = 0
        sea k = 0
        mientras (k < bytes) {
            l = l * 256 + str_byte(s, pos + k)
            k = k + 1
        }
        pos = pos + bytes
    }
    __guardar64(r + 8, pos)
    __guardar64(r + 16, l)
    retornar r
}

funcion der_entero(s, i) {
    sea d = der_leer(s, i)
    sea inicio = __cargar64(d + 8)
    sea largo = __cargar64(d + 16)
    mientras (largo > 1 y str_byte(s, inicio) == 0) {
        inicio = inicio + 1
        largo = largo - 1
    }
    retornar str_rebanar(s, inicio, inicio + largo)
}

// Clave pública PEM (SubjectPublicKeyInfo o PKCS#1) → [n][e] en bytes.
funcion rsa_clave(pem) {
    sea b64 = str_nuevo(str_largo(pem))
    sea i = 0
    sea dentro = 0
    mientras (i < str_largo(pem)) {
        sea fin_linea = str_buscar(pem, "\n", i)
        si (fin_linea < 0) { fin_linea = str_largo(pem) }
        sea linea = str_rebanar(pem, i, fin_linea)
        si (str_largo(linea) > 0 y str_byte(linea, str_largo(linea) - 1) == 13) { linea = str_rebanar(linea, 0, str_largo(linea) - 1) }
        si (str_buscar(linea, "-----BEGIN", 0) == 0) { dentro = 1 } sino {
            si (str_buscar(linea, "-----END", 0) == 0) { dentro = 0 } sino {
                si (dentro) { str_agregar(b64, linea) }
            }
        }
        i = fin_linea + 1
    }
    sea der = dyn_dato(cfv_base64_decodificar(dyn_texto(b64)))
    sea seq = der_leer(der, 0)
    sea p = __cargar64(seq + 8)
    sea primero = der_leer(der, p)
    si (__cargar64(primero) == 48) {
        // SPKI: SEQUENCE { algoritmo } BIT STRING { 0, SEQUENCE { n, e } }
        sea bits = der_leer(der, __cargar64(primero + 8) + __cargar64(primero + 16))
        p = __cargar64(bits + 8) + 1
        sea interna = der_leer(der, p)
        p = __cargar64(interna + 8)
    }
    sea n = der_entero(der, p)
    sea dn = der_leer(der, p)
    sea e = der_entero(der, __cargar64(dn + 8) + __cargar64(dn + 16))
    sea r = mem_reservar(16)
    __guardar64(r, n)
    __guardar64(r + 8, e)
    retornar r
}

// MGF1 con el resumen alg.
funcion mgf1(alg, semilla, largo) {
    sea r = str_nuevo(largo + 64)
    sea contador = 0
    mientras (str_largo(r) < largo) {
        sea entrada = str_nuevo(str_largo(semilla) + 4)
        str_agregar(entrada, semilla)
        str_agregar_byte(entrada, __y_bits(__desplazar_der(contador, 24), 255))
        str_agregar_byte(entrada, __y_bits(__desplazar_der(contador, 16), 255))
        str_agregar_byte(entrada, __y_bits(__desplazar_der(contador, 8), 255))
        str_agregar_byte(entrada, __y_bits(contador, 255))
        str_agregar(r, cr_resumen(alg, entrada))
        contador = contador + 1
    }
    retornar str_rebanar(r, 0, largo)
}

// RSAES-OAEP (RFC 8017) con SHA-1 (alg 1) o SHA-256 (256), etiqueta vacía.
funcion rsa_oaep_crudo(pem, mensaje, alg) {
    sea clave = rsa_clave(pem)
    sea n = __cargar64(clave)
    sea e = __cargar64(clave + 8)
    sea k = str_largo(n)
    sea lhash = cr_resumen(alg, "")
    sea hlen = str_largo(lhash)
    si (str_largo(mensaje) > k - 2 * hlen - 2) { dyn_error("rsa_oaep_cifrar: mensaje demasiado largo para la clave") }
    sea db = str_nuevo(k)
    str_agregar(db, lhash)
    sea relleno = k - str_largo(mensaje) - 2 * hlen - 2
    sea i = 0
    mientras (i < relleno) {
        str_agregar_byte(db, 0)
        i = i + 1
    }
    str_agregar_byte(db, 1)
    str_agregar(db, mensaje)
    sea semilla = str_nuevo(hlen)
    si (sys_aleatorio(str_datos(semilla), hlen) != 0) { dyn_error("rsa_oaep_cifrar: sin bytes aleatorios") }
    __guardar64(semilla, hlen)
    sea mascara_db = mgf1(alg, semilla, k - hlen - 1)
    sea db_m = str_nuevo(k)
    i = 0
    mientras (i < str_largo(db)) {
        str_agregar_byte(db_m, __xo_bits(str_byte(db, i), str_byte(mascara_db, i)))
        i = i + 1
    }
    sea mascara_s = mgf1(alg, db_m, hlen)
    sea em = str_nuevo(k)
    str_agregar_byte(em, 0)
    i = 0
    mientras (i < hlen) {
        str_agregar_byte(em, __xo_bits(str_byte(semilla, i), str_byte(mascara_s, i)))
        i = i + 1
    }
    str_agregar(em, db_m)
    retornar rsa_crudo(em, n, e)
}

funcion rsa_oaep_cifrar(pem, mensaje, resumen) {
    sea alg = 1
    si (resumen != 0 y str_igual(dyn_texto_de(resumen, "rsa_oaep_cifrar"), "sha256")) { alg = 256 }
    retornar dyn_texto(rsa_oaep_crudo(dyn_texto_de(pem, "rsa_oaep_cifrar"), dyn_a_str(mensaje), alg))
}

// ── Utilidades de bytes (little endian) ─────────────────────────────────

funcion le32(s, i) {
    retornar __o_bits(__o_bits(str_byte(s, i), __desplazar_izq(str_byte(s, i + 1), 8)), __o_bits(__desplazar_izq(str_byte(s, i + 2), 16), __desplazar_izq(str_byte(s, i + 3), 24)))
}
funcion le64(s, i) { retornar __o_bits(le32(s, i), __desplazar_izq(le32(s, i + 4), 32)) }
funcion agregar_le32(r, v) {
    sea k = 0
    mientras (k < 4) {
        str_agregar_byte(r, __y_bits(__desplazar_der(v, k * 8), 255))
        k = k + 1
    }
    retornar 0
}
funcion agregar_le64(r, v) {
    sea k = 0
    mientras (k < 8) {
        str_agregar_byte(r, __y_bits(__desplazar_der(v, k * 8), 255))
        k = k + 1
    }
    retornar 0
}
funcion m32(p, i) { retornar __cargar64(p + i * 8) }
funcion f32(p, i, v) {
    __guardar64(p + i * 8, __y_bits(v, 4294967295))
    retornar 0
}

// Borra el contenido de un texto (bytes en 0): para claves y contraseñas.
funcion borrar_texto(t) {
    si (dyn_tipo(t) != 1) { retornar 0 }
    sea s = dyn_dato(t)
    mem_llenar(str_datos(s), 0, str_largo(s))
    retornar 0
}

// ── ChaCha20 (RFC 8439) ─────────────────────────────────────────────────

funcion chacha_cuarto(x, a, b, c, d) {
    f32(x, a, m32(x, a) + m32(x, b)) f32(x, d, roti32(__xo_bits(m32(x, d), m32(x, a)), 16))
    f32(x, c, m32(x, c) + m32(x, d)) f32(x, b, roti32(__xo_bits(m32(x, b), m32(x, c)), 12))
    f32(x, a, m32(x, a) + m32(x, b)) f32(x, d, roti32(__xo_bits(m32(x, d), m32(x, a)), 8))
    f32(x, c, m32(x, c) + m32(x, d)) f32(x, b, roti32(__xo_bits(m32(x, b), m32(x, c)), 7))
    retornar 0
}

// Estado inicial: constantes, clave (32), contador y nonce (16 bytes en
// total: contador de 32 bits + nonce de 96, o 64 + 64 en la variante original).
funcion chacha_estado(clave, contador, nonce) {
    sea x = mem_reservar(16 * 8)
    f32(x, 0, 1634760805) f32(x, 1, 857760878) f32(x, 2, 2036477234) f32(x, 3, 1797285236)
    sea i = 0
    mientras (i < 8) {
        f32(x, 4 + i, le32(clave, i * 4))
        i = i + 1
    }
    f32(x, 12, contador)
    f32(x, 13, le32(nonce, 0))
    f32(x, 14, le32(nonce, 4))
    f32(x, 15, le32(nonce, 8))
    retornar x
}

funcion chacha_rondas(x) {
    sea r = 0
    mientras (r < 10) {
        chacha_cuarto(x, 0, 4, 8, 12) chacha_cuarto(x, 1, 5, 9, 13)
        chacha_cuarto(x, 2, 6, 10, 14) chacha_cuarto(x, 3, 7, 11, 15)
        chacha_cuarto(x, 0, 5, 10, 15) chacha_cuarto(x, 1, 6, 11, 12)
        chacha_cuarto(x, 2, 7, 8, 13) chacha_cuarto(x, 3, 4, 9, 14)
        r = r + 1
    }
    retornar 0
}

// Bloque de 64 bytes de flujo.
funcion chacha_bloque(clave, contador, nonce) {
    sea x = chacha_estado(clave, contador, nonce)
    sea w = mem_reservar(16 * 8)
    sea i = 0
    mientras (i < 16) {
        __guardar64(w + i * 8, m32(x, i))
        i = i + 1
    }
    chacha_rondas(w)
    sea r = str_nuevo(64)
    i = 0
    mientras (i < 16) {
        agregar_le32(r, m32(w, i) + m32(x, i))
        i = i + 1
    }
    mem_liberar(w)
    mem_liberar(x)
    retornar r
}

funcion chacha20_xor(clave, contador, nonce, texto) {
    sea r = str_nuevo(str_largo(texto))
    sea i = 0
    mientras (i < str_largo(texto)) {
        sea flujo = chacha_bloque(clave, contador, nonce)
        sea k = 0
        mientras (k < 64 y i + k < str_largo(texto)) {
            str_agregar_byte(r, __xo_bits(str_byte(texto, i + k), str_byte(flujo, k)))
            k = k + 1
        }
        contador = contador + 1
        i = i + 64
    }
    retornar r
}

// HChaCha20: subclave de 32 bytes para XChaCha20 (nonce de 24 bytes).
funcion hchacha20(clave, n16) {
    sea x = mem_reservar(16 * 8)
    f32(x, 0, 1634760805) f32(x, 1, 857760878) f32(x, 2, 2036477234) f32(x, 3, 1797285236)
    sea i = 0
    mientras (i < 8) {
        f32(x, 4 + i, le32(clave, i * 4))
        i = i + 1
    }
    i = 0
    mientras (i < 4) {
        f32(x, 12 + i, le32(n16, i * 4))
        i = i + 1
    }
    chacha_rondas(x)
    sea r = str_nuevo(32)
    i = 0
    mientras (i < 4) {
        agregar_le32(r, m32(x, i))
        i = i + 1
    }
    i = 12
    mientras (i < 16) {
        agregar_le32(r, m32(x, i))
        i = i + 1
    }
    mem_liberar(x)
    retornar r
}

// ── Poly1305 (cifras de 26 bits, como poly1305-donna) ────────────────────

funcion poly1305_crudo(clave, m) {
    sea r0 = __y_bits(le32(clave, 0), 67108863)
    sea r1 = __y_bits(__desplazar_der(le32(clave, 3), 2), 67108611)
    sea r2 = __y_bits(__desplazar_der(le32(clave, 6), 4), 67092735)
    sea r3 = __y_bits(__desplazar_der(le32(clave, 9), 6), 66076671)
    sea r4 = __y_bits(__desplazar_der(le32(clave, 12), 8), 1048575)
    sea s1 = r1 * 5
    sea s2 = r2 * 5
    sea s3 = r3 * 5
    sea s4 = r4 * 5
    sea h0 = 0
    sea h1 = 0
    sea h2 = 0
    sea h3 = 0
    sea h4 = 0
    sea i = 0
    mientras (i < str_largo(m)) {
        sea b = str_nuevo(17)
        sea k = 0
        mientras (k < 16 y i + k < str_largo(m)) {
            str_agregar_byte(b, str_byte(m, i + k))
            k = k + 1
        }
        sea alto = 16777216
        si (k < 16) {
            str_agregar_byte(b, 1)
            k = k + 1
            mientras (k < 17) {
                str_agregar_byte(b, 0)
                k = k + 1
            }
            alto = 0
        } sino {
            str_agregar_byte(b, 0)
        }
        h0 = h0 + __y_bits(le32(b, 0), 67108863)
        h1 = h1 + __y_bits(__desplazar_der(le32(b, 3), 2), 67108863)
        h2 = h2 + __y_bits(__desplazar_der(le32(b, 6), 4), 67108863)
        h3 = h3 + __y_bits(__desplazar_der(le32(b, 9), 6), 67108863)
        h4 = h4 + __o_bits(__desplazar_der(le32(b, 12), 8), alto)
        sea d0 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1
        sea d1 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2
        sea d2 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3
        sea d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4
        sea d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0
        sea c = __desplazar_der(d0, 26)
        h0 = __y_bits(d0, 67108863)
        d1 = d1 + c
        c = __desplazar_der(d1, 26)
        h1 = __y_bits(d1, 67108863)
        d2 = d2 + c
        c = __desplazar_der(d2, 26)
        h2 = __y_bits(d2, 67108863)
        d3 = d3 + c
        c = __desplazar_der(d3, 26)
        h3 = __y_bits(d3, 67108863)
        d4 = d4 + c
        c = __desplazar_der(d4, 26)
        h4 = __y_bits(d4, 67108863)
        h0 = h0 + c * 5
        c = __desplazar_der(h0, 26)
        h0 = __y_bits(h0, 67108863)
        h1 = h1 + c
        i = i + 16
    }
    // Reducción final y suma de s (mod 2^128).
    sea c = __desplazar_der(h1, 26)
    h1 = __y_bits(h1, 67108863)
    h2 = h2 + c
    c = __desplazar_der(h2, 26)
    h2 = __y_bits(h2, 67108863)
    h3 = h3 + c
    c = __desplazar_der(h3, 26)
    h3 = __y_bits(h3, 67108863)
    h4 = h4 + c
    c = __desplazar_der(h4, 26)
    h4 = __y_bits(h4, 67108863)
    h0 = h0 + c * 5
    c = __desplazar_der(h0, 26)
    h0 = __y_bits(h0, 67108863)
    h1 = h1 + c
    sea g0 = h0 + 5
    c = __desplazar_der(g0, 26)
    g0 = __y_bits(g0, 67108863)
    sea g1 = h1 + c
    c = __desplazar_der(g1, 26)
    g1 = __y_bits(g1, 67108863)
    sea g2 = h2 + c
    c = __desplazar_der(g2, 26)
    g2 = __y_bits(g2, 67108863)
    sea g3 = h3 + c
    c = __desplazar_der(g3, 26)
    g3 = __y_bits(g3, 67108863)
    sea g4 = h4 + c - 67108864
    // Si g4 no es negativo, h ≥ p: usar g (selección sin ramas).
    sea mascara = __desplazar_aritmetico(g4, 63)
    sea usar_g = __xo_bits(mascara, 0 - 1)
    h0 = __o_bits(__y_bits(h0, mascara), __y_bits(g0, usar_g))
    h1 = __o_bits(__y_bits(h1, mascara), __y_bits(g1, usar_g))
    h2 = __o_bits(__y_bits(h2, mascara), __y_bits(g2, usar_g))
    h3 = __o_bits(__y_bits(h3, mascara), __y_bits(g3, usar_g))
    h4 = __o_bits(__y_bits(h4, mascara), __y_bits(__y_bits(g4, 67108863), usar_g))
    sea f0 = __y_bits(__o_bits(h0, __desplazar_izq(h1, 26)), 4294967295)
    sea f1 = __y_bits(__o_bits(__desplazar_der(h1, 6), __desplazar_izq(h2, 20)), 4294967295)
    sea f2 = __y_bits(__o_bits(__desplazar_der(h2, 12), __desplazar_izq(h3, 14)), 4294967295)
    sea f3 = __y_bits(__o_bits(__desplazar_der(h3, 18), __desplazar_izq(h4, 8)), 4294967295)
    sea t0 = f0 + le32(clave, 16)
    sea t1 = f1 + le32(clave, 20) + __desplazar_der(t0, 32)
    sea t2 = f2 + le32(clave, 24) + __desplazar_der(t1, 32)
    sea t3 = f3 + le32(clave, 28) + __desplazar_der(t2, 32)
    sea r = str_nuevo(16)
    agregar_le32(r, t0)
    agregar_le32(r, t1)
    agregar_le32(r, t2)
    agregar_le32(r, t3)
    retornar r
}

// ── AEAD ChaCha20-Poly1305 (RFC 8439) y XChaCha20-Poly1305 ─────────────

funcion relleno16(r, n) {
    mientras (n % 16 != 0) {
        str_agregar_byte(r, 0)
        n = n + 1
    }
    retornar 0
}

funcion aead_etiqueta(clave, nonce, aad, cifrado) {
    sea otk = str_rebanar(chacha_bloque(clave, 0, nonce), 0, 32)
    sea mac = str_nuevo(str_largo(aad) + str_largo(cifrado) + 48)
    str_agregar(mac, aad)
    relleno16(mac, str_largo(aad))
    str_agregar(mac, cifrado)
    relleno16(mac, str_largo(cifrado))
    agregar_le64(mac, str_largo(aad))
    agregar_le64(mac, str_largo(cifrado))
    retornar poly1305_crudo(otk, mac)
}

// cifrar → cifrado || etiqueta; descifrar → texto o -1.
funcion aead_crudo(clave, nonce, texto, aad, cifrar) {
    si (str_largo(clave) != 32) { dyn_error("chacha20_poly1305: la clave debe tener 32 bytes") }
    si (str_largo(nonce) == 24) {
        clave = hchacha20(clave, str_rebanar(nonce, 0, 16))
        sea n12 = str_nuevo(12)
        agregar_le32(n12, 0)
        str_agregar(n12, str_rebanar(nonce, 16, 24))
        nonce = n12
    }
    si (str_largo(nonce) != 12) { dyn_error("chacha20_poly1305: el nonce debe tener 12 bytes (o 24 con XChaCha20)") }
    si (cifrar) {
        sea c = chacha20_xor(clave, 1, nonce, texto)
        str_agregar(c, aead_etiqueta(clave, nonce, aad, c))
        retornar c
    }
    sea n = str_largo(texto)
    si (n < 16) { retornar 0 - 1 }
    sea cifrado = str_rebanar(texto, 0, n - 16)
    sea etiqueta = aead_etiqueta(clave, nonce, aad, cifrado)
    sea d = 0
    sea i = 0
    mientras (i < 16) {
        d = __o_bits(d, __xo_bits(str_byte(etiqueta, i), str_byte(texto, n - 16 + i)))
        i = i + 1
    }
    si (d != 0) { retornar 0 - 1 }
    retornar chacha20_xor(clave, 1, nonce, cifrado)
}

funcion chacha20_poly1305_cifrar(clave, nonce, texto, aad) {
    sea a = ""
    si (aad != 0) { a = dyn_a_str(aad) }
    retornar dyn_texto(aead_crudo(dyn_a_str(clave), dyn_a_str(nonce), dyn_a_str(texto), a, 1))
}

funcion chacha20_poly1305_descifrar(clave, nonce, cifrado, aad) {
    sea a = ""
    si (aad != 0) { a = dyn_a_str(aad) }
    sea r = aead_crudo(dyn_a_str(clave), dyn_a_str(nonce), dyn_a_str(cifrado), a, 0)
    si (r == 0 - 1) { dyn_error("chacha20_poly1305_descifrar: la etiqueta no coincide (clave, nonce o datos alterados)") }
    retornar dyn_texto(r)
}

funcion poly1305(clave, mensaje) {
    sea k = dyn_a_str(clave)
    si (str_largo(k) != 32) { dyn_error("poly1305: la clave debe tener 32 bytes") }
    retornar dyn_texto(poly1305_crudo(k, dyn_a_str(mensaje)))
}

// Caja segura por defecto (como crypto_secretbox / aead de Monocypher):
// XChaCha20-Poly1305 con nonce aleatorio de 24 bytes al inicio. El usuario
// no maneja nonces: caja_abrir(clave, caja_cerrar(clave, t)) == t.
funcion caja_cerrar(clave, texto) {
    sea nonce = str_nuevo(24)
    si (sys_aleatorio(str_datos(nonce), 24) != 0) { dyn_error("caja_cerrar: sin bytes aleatorios") }
    __guardar64(nonce, 24)
    sea r = str_nuevo(str_largo(dyn_a_str(texto)) + 40)
    str_agregar(r, nonce)
    str_agregar(r, aead_crudo(dyn_a_str(clave), nonce, dyn_a_str(texto), "", 1))
    retornar dyn_texto(r)
}

funcion caja_abrir(clave, caja) {
    sea c = dyn_a_str(caja)
    si (str_largo(c) < 40) { dyn_error("caja_abrir: datos incompletos") }
    sea r = aead_crudo(dyn_a_str(clave), str_rebanar(c, 0, 24), str_rebanar(c, 24, str_largo(c)), "", 0)
    si (r == 0 - 1) { dyn_error("caja_abrir: la clave no corresponde o los datos fueron alterados") }
    retornar dyn_texto(r)
}

// ── BLAKE2b (RFC 7693) ──────────────────────────────────────────────────

funcion b2_iv(i) {
    si (i == 0) { retornar cr_hex64("6a09e667f3bcc908", 0) }
    si (i == 1) { retornar cr_hex64("bb67ae8584caa73b", 0) }
    si (i == 2) { retornar cr_hex64("3c6ef372fe94f82b", 0) }
    si (i == 3) { retornar cr_hex64("a54ff53a5f1d36f1", 0) }
    si (i == 4) { retornar cr_hex64("510e527fade682d1", 0) }
    si (i == 5) { retornar cr_hex64("9b05688c2b3e6c1f", 0) }
    si (i == 6) { retornar cr_hex64("1f83d9abfb41bd6b", 0) }
    retornar cr_hex64("5be0cd19137e2179", 0)
}

funcion b2_sigma() {
    retornar "0123456789abcdefea489fd61c02b753b8c052fdae3671947931dcbe265a40f8905724afe1bc683d2c6a0b834d75fe19c51fed4a0763928bdb7ec13950f4862a6fe9b308c2d714a5a2847615fb9e3cd0"
}

funcion b2_g(v, a, b, c, d, x, y) {
    __guardar64(v + a * 8, __cargar64(v + a * 8) + __cargar64(v + b * 8) + x)
    __guardar64(v + d * 8, rotd64(__xo_bits(__cargar64(v + d * 8), __cargar64(v + a * 8)), 32))
    __guardar64(v + c * 8, __cargar64(v + c * 8) + __cargar64(v + d * 8))
    __guardar64(v + b * 8, rotd64(__xo_bits(__cargar64(v + b * 8), __cargar64(v + c * 8)), 24))
    __guardar64(v + a * 8, __cargar64(v + a * 8) + __cargar64(v + b * 8) + y)
    __guardar64(v + d * 8, rotd64(__xo_bits(__cargar64(v + d * 8), __cargar64(v + a * 8)), 16))
    __guardar64(v + c * 8, __cargar64(v + c * 8) + __cargar64(v + d * 8))
    __guardar64(v + b * 8, rotd64(__xo_bits(__cargar64(v + b * 8), __cargar64(v + c * 8)), 63))
    retornar 0
}

// Comprime el bloque de 128 bytes en h (8 palabras).
funcion b2_comprimir(h, bloque, t, ultimo) {
    sea v = mem_reservar(16 * 8)
    sea m = mem_reservar(16 * 8)
    sea i = 0
    mientras (i < 8) {
        __guardar64(v + i * 8, __cargar64(h + i * 8))
        __guardar64(v + (i + 8) * 8, b2_iv(i))
        i = i + 1
    }
    i = 0
    mientras (i < 16) {
        __guardar64(m + i * 8, le64(bloque, i * 8))
        i = i + 1
    }
    __guardar64(v + 12 * 8, __xo_bits(__cargar64(v + 12 * 8), t))
    si (ultimo) { __guardar64(v + 14 * 8, __xo_bits(__cargar64(v + 14 * 8), 0 - 1)) }
    sea sg = b2_sigma()
    sea r = 0
    mientras (r < 12) {
        sea base = (r % 10) * 16
        sea s = mem_reservar(16 * 8)
        sea k = 0
        mientras (k < 16) {
            __guardar64(s + k * 8, valor_hex(str_byte(sg, base + k)))
            k = k + 1
        }
        b2_g(v, 0, 4, 8, 12, __cargar64(m + __cargar64(s) * 8), __cargar64(m + __cargar64(s + 8) * 8))
        b2_g(v, 1, 5, 9, 13, __cargar64(m + __cargar64(s + 16) * 8), __cargar64(m + __cargar64(s + 24) * 8))
        b2_g(v, 2, 6, 10, 14, __cargar64(m + __cargar64(s + 32) * 8), __cargar64(m + __cargar64(s + 40) * 8))
        b2_g(v, 3, 7, 11, 15, __cargar64(m + __cargar64(s + 48) * 8), __cargar64(m + __cargar64(s + 56) * 8))
        b2_g(v, 0, 5, 10, 15, __cargar64(m + __cargar64(s + 64) * 8), __cargar64(m + __cargar64(s + 72) * 8))
        b2_g(v, 1, 6, 11, 12, __cargar64(m + __cargar64(s + 80) * 8), __cargar64(m + __cargar64(s + 88) * 8))
        b2_g(v, 2, 7, 8, 13, __cargar64(m + __cargar64(s + 96) * 8), __cargar64(m + __cargar64(s + 104) * 8))
        b2_g(v, 3, 4, 9, 14, __cargar64(m + __cargar64(s + 112) * 8), __cargar64(m + __cargar64(s + 120) * 8))
        mem_liberar(s)
        r = r + 1
    }
    i = 0
    mientras (i < 8) {
        __guardar64(h + i * 8, __xo_bits(__xo_bits(__cargar64(h + i * 8), __cargar64(v + i * 8)), __cargar64(v + (i + 8) * 8)))
        i = i + 1
    }
    mem_liberar(v)
    mem_liberar(m)
    retornar 0
}

// BLAKE2b con salida de n bytes (1..64) y clave opcional (0..64).
funcion blake2b_crudo(m, n, clave) {
    sea h = mem_reservar(8 * 8)
    sea i = 0
    mientras (i < 8) {
        __guardar64(h + i * 8, b2_iv(i))
        i = i + 1
    }
    __guardar64(h, __xo_bits(__cargar64(h), __o_bits(__o_bits(16842752, __desplazar_izq(str_largo(clave), 8)), n)))
    sea datos = m
    si (str_largo(clave) > 0) {
        datos = str_nuevo(128 + str_largo(m))
        str_agregar(datos, clave)
        relleno_hasta(datos, 128)
        str_agregar(datos, m)
    }
    sea total = str_largo(datos)
    sea t = 0
    sea pos = 0
    mientras (total - pos > 128) {
        t = t + 128
        b2_comprimir(h, str_rebanar(datos, pos, pos + 128), t, 0)
        pos = pos + 128
    }
    sea ultimo = str_rebanar(datos, pos, total)
    t = t + str_largo(ultimo)
    relleno_hasta(ultimo, 128)
    b2_comprimir(h, ultimo, t, 1)
    sea r = str_nuevo(64)
    i = 0
    mientras (i < 8) {
        agregar_le64(r, __cargar64(h + i * 8))
        i = i + 1
    }
    mem_liberar(h)
    retornar str_rebanar(r, 0, n)
}

funcion relleno_hasta(s, n) {
    mientras (str_largo(s) < n) { str_agregar_byte(s, 0) }
    retornar 0
}

funcion blake2b(mensaje, largo, clave) {
    sea n = 64
    si (largo != 0 y dyn_valor_entero(largo) != 0) { n = dyn_valor_entero(largo) }
    si (n < 1 o n > 64) { dyn_error("blake2b: el largo debe ser 1..64") }
    sea k = ""
    si (clave != 0) { k = dyn_a_str(clave) }
    si (str_largo(k) > 64) { dyn_error("blake2b: la clave admite hasta 64 bytes") }
    retornar dyn_texto(blake2b_crudo(dyn_a_str(mensaje), n, k))
}

// H' de Argon2 (resumen de largo variable).
funcion argon2_h(largo, entrada) {
    sea x = str_nuevo(str_largo(entrada) + 4)
    agregar_le32(x, largo)
    str_agregar(x, entrada)
    si (largo <= 64) { retornar blake2b_crudo(x, largo, "") }
    sea r = str_nuevo(largo)
    sea v = blake2b_crudo(x, 64, "")
    str_agregar(r, str_rebanar(v, 0, 32))
    mientras (largo - str_largo(r) > 64) {
        v = blake2b_crudo(v, 64, "")
        str_agregar(r, str_rebanar(v, 0, 32))
    }
    v = blake2b_crudo(v, largo - str_largo(r), "")
    str_agregar(r, v)
    retornar r
}

// ── Argon2id (RFC 9106) ─────────────────────────────────────────────────
// Bloques de 1024 bytes (128 palabras de 64 bits) en memoria propia.

funcion bla_mka(x, y) {
    retornar x + y + 2 * __y_bits(x, 4294967295) * __y_bits(y, 4294967295)
}

funcion argon2_gb(v, a, b, c, d) {
    __guardar64(v + a * 8, bla_mka(__cargar64(v + a * 8), __cargar64(v + b * 8)))
    __guardar64(v + d * 8, rotd64(__xo_bits(__cargar64(v + d * 8), __cargar64(v + a * 8)), 32))
    __guardar64(v + c * 8, bla_mka(__cargar64(v + c * 8), __cargar64(v + d * 8)))
    __guardar64(v + b * 8, rotd64(__xo_bits(__cargar64(v + b * 8), __cargar64(v + c * 8)), 24))
    __guardar64(v + a * 8, bla_mka(__cargar64(v + a * 8), __cargar64(v + b * 8)))
    __guardar64(v + d * 8, rotd64(__xo_bits(__cargar64(v + d * 8), __cargar64(v + a * 8)), 16))
    __guardar64(v + c * 8, bla_mka(__cargar64(v + c * 8), __cargar64(v + d * 8)))
    __guardar64(v + b * 8, rotd64(__xo_bits(__cargar64(v + b * 8), __cargar64(v + c * 8)), 63))
    retornar 0
}

// P sobre 16 palabras en posiciones dadas (i0..i15 en el arreglo idx).
funcion argon2_p(z, idx) {
    sea v = mem_reservar(16 * 8)
    sea k = 0
    mientras (k < 16) {
        __guardar64(v + k * 8, __cargar64(z + __cargar64(idx + k * 8) * 8))
        k = k + 1
    }
    argon2_gb(v, 0, 4, 8, 12)
    argon2_gb(v, 1, 5, 9, 13)
    argon2_gb(v, 2, 6, 10, 14)
    argon2_gb(v, 3, 7, 11, 15)
    argon2_gb(v, 0, 5, 10, 15)
    argon2_gb(v, 1, 6, 11, 12)
    argon2_gb(v, 2, 7, 8, 13)
    argon2_gb(v, 3, 4, 9, 14)
    k = 0
    mientras (k < 16) {
        __guardar64(z + __cargar64(idx + k * 8) * 8, __cargar64(v + k * 8))
        k = k + 1
    }
    mem_liberar(v)
    retornar 0
}

// destino ← G(x, y) (si xorear, destino ← destino ⊕ G(x, y)).
funcion argon2_g(destino, x, y, xorear) {
    sea r = mem_reservar(1024)
    sea z = mem_reservar(1024)
    sea k = 0
    mientras (k < 128) {
        sea w = __xo_bits(__cargar64(x + k * 8), __cargar64(y + k * 8))
        __guardar64(r + k * 8, w)
        __guardar64(z + k * 8, w)
        k = k + 1
    }
    sea idx = mem_reservar(16 * 8)
    // Filas: 8 grupos de 16 palabras seguidas.
    sea f = 0
    mientras (f < 8) {
        k = 0
        mientras (k < 16) {
            __guardar64(idx + k * 8, f * 16 + k)
            k = k + 1
        }
        argon2_p(z, idx)
        f = f + 1
    }
    // Columnas: pares de palabras 2c, 2c+1 de cada fila.
    sea col = 0
    mientras (col < 8) {
        k = 0
        mientras (k < 8) {
            __guardar64(idx + (2 * k) * 8, k * 16 + 2 * col)
            __guardar64(idx + (2 * k + 1) * 8, k * 16 + 2 * col + 1)
            k = k + 1
        }
        argon2_p(z, idx)
        col = col + 1
    }
    k = 0
    mientras (k < 128) {
        sea w = __xo_bits(__cargar64(z + k * 8), __cargar64(r + k * 8))
        si (xorear) { w = __xo_bits(w, __cargar64(destino + k * 8)) }
        __guardar64(destino + k * 8, w)
        k = k + 1
    }
    mem_liberar(r)
    mem_liberar(z)
    mem_liberar(idx)
    retornar 0
}

funcion bloque_de_texto(p, s) {
    sea k = 0
    mientras (k < 128) {
        __guardar64(p + k * 8, le64(s, k * 8))
        k = k + 1
    }
    retornar 0
}

funcion argon2id_crudo(clave, sal, t_coste, m_coste, lanes, largo, secreto, extra) {
    si (lanes < 1) { lanes = 1 }
    si (m_coste < 8 * lanes) { m_coste = 8 * lanes }
    sea q = (m_coste / (4 * lanes)) * 4
    sea m = q * lanes
    sea seg = q / 4
    // H0
    sea h = str_nuevo(256)
    agregar_le32(h, lanes)
    agregar_le32(h, largo)
    agregar_le32(h, m_coste)
    agregar_le32(h, t_coste)
    agregar_le32(h, 19)
    agregar_le32(h, 2)
    agregar_le32(h, str_largo(clave)) str_agregar(h, clave)
    agregar_le32(h, str_largo(sal)) str_agregar(h, sal)
    agregar_le32(h, str_largo(secreto)) str_agregar(h, secreto)
    agregar_le32(h, str_largo(extra)) str_agregar(h, extra)
    sea h0 = blake2b_crudo(h, 64, "")
    sea memoria = mem_reservar(m * 1024)
    sea l = 0
    mientras (l < lanes) {
        sea k = 0
        mientras (k < 2) {
            sea e = str_nuevo(72)
            str_agregar(e, h0)
            agregar_le32(e, k)
            agregar_le32(e, l)
            bloque_de_texto(memoria + (l * q + k) * 1024, argon2_h(1024, e))
            k = k + 1
        }
        l = l + 1
    }
    sea cero = mem_reservar(1024)
    mem_llenar(cero, 0, 1024)
    sea entrada = mem_reservar(1024)
    sea direcciones = mem_reservar(1024)
    sea pasada = 0
    mientras (pasada < t_coste) {
        sea s = 0
        mientras (s < 4) {
            l = 0
            mientras (l < lanes) {
                sea independiente = pasada == 0 y s < 2
                si (independiente) {
                    mem_llenar(entrada, 0, 1024)
                    __guardar64(entrada, pasada)
                    __guardar64(entrada + 8, l)
                    __guardar64(entrada + 16, s)
                    __guardar64(entrada + 24, m)
                    __guardar64(entrada + 32, t_coste)
                    __guardar64(entrada + 40, 2)
                }
                sea i = 0
                si (pasada == 0 y s == 0) {
                    i = 2
                    si (independiente) {
                        __guardar64(entrada + 48, __cargar64(entrada + 48) + 1)
                        argon2_g(direcciones, cero, entrada, 0)
                        argon2_g(direcciones, cero, direcciones, 0)
                    }
                }
                mientras (i < seg) {
                    sea j = l * q + s * seg + i
                    sea previo = j - 1
                    si (s * seg + i == 0) { previo = l * q + q - 1 }
                    sea pseudo = 0
                    si (independiente) {
                        si (i % 128 == 0) {
                            __guardar64(entrada + 48, __cargar64(entrada + 48) + 1)
                            argon2_g(direcciones, cero, entrada, 0)
                            argon2_g(direcciones, cero, direcciones, 0)
                        }
                        pseudo = __cargar64(direcciones + (i % 128) * 8)
                    } sino {
                        pseudo = __cargar64(memoria + previo * 1024)
                    }
                    sea j1 = __y_bits(pseudo, 4294967295)
                    sea j2 = __desplazar_der(pseudo, 32)
                    sea carril = j2 % lanes
                    si (pasada == 0 y s == 0) { carril = l }
                    // Tamaño del conjunto de referencia (RFC 9106 §3.4.1.2).
                    sea area = 0
                    si (pasada == 0) {
                        si (carril == l) { area = s * seg + i - 1 } sino {
                            area = s * seg
                            si (i == 0) { area = area - 1 }
                        }
                    } sino {
                        si (carril == l) { area = q - seg + i - 1 } sino {
                            area = q - seg
                            si (i == 0) { area = area - 1 }
                        }
                    }
                    sea x = __desplazar_der(j1 * j1, 32)
                    sea y = __desplazar_der(area * x, 32)
                    sea zz = area - 1 - y
                    sea inicio = 0
                    si (pasada != 0 y s != 3) { inicio = (s + 1) * seg }
                    sea ref = carril * q + (inicio + zz) % q
                    argon2_g(memoria + j * 1024, memoria + previo * 1024, memoria + ref * 1024, pasada > 0)
                    i = i + 1
                }
                l = l + 1
            }
            s = s + 1
        }
        pasada = pasada + 1
    }
    // XOR de los últimos bloques de cada carril y H' final.
    sea final = mem_reservar(1024)
    mem_llenar(final, 0, 1024)
    l = 0
    mientras (l < lanes) {
        sea k = 0
        mientras (k < 128) {
            __guardar64(final + k * 8, __xo_bits(__cargar64(final + k * 8), __cargar64(memoria + (l * q + q - 1) * 1024 + k * 8)))
            k = k + 1
        }
        l = l + 1
    }
    sea bytes = str_nuevo(1024)
    sea k = 0
    mientras (k < 128) {
        agregar_le64(bytes, __cargar64(final + k * 8))
        k = k + 1
    }
    mem_llenar(memoria, 0, m * 1024)
    mem_liberar(memoria)
    retornar argon2_h(largo, bytes)
}

funcion argon2id(clave, sal, iteraciones, memoria_kib, paralelismo, largo) {
    sea s = dyn_a_str(sal)
    si (str_largo(s) < 8) { dyn_error("argon2id: la sal debe tener al menos 8 bytes") }
    retornar dyn_texto(argon2id_crudo(dyn_a_str(clave), s, dyn_valor_entero(iteraciones), dyn_valor_entero(memoria_kib), dyn_valor_entero(paralelismo), dyn_valor_entero(largo), "", ""))
}

// ── BLAKE3 ──────────────────────────────────────────────────────────────

funcion b3_iv(i) {
    si (i == 0) { retornar 1779033703 }
    si (i == 1) { retornar 3144134277 }
    si (i == 2) { retornar 1013904242 }
    si (i == 3) { retornar 2773480762 }
    si (i == 4) { retornar 1359893119 }
    si (i == 5) { retornar 2600822924 }
    si (i == 6) { retornar 528734635 }
    retornar 1541459225
}

funcion b3_g(v, a, b, c, d, x, y) {
    f32(v, a, m32(v, a) + m32(v, b) + x) f32(v, d, rotd32(__xo_bits(m32(v, d), m32(v, a)), 16))
    f32(v, c, m32(v, c) + m32(v, d)) f32(v, b, rotd32(__xo_bits(m32(v, b), m32(v, c)), 12))
    f32(v, a, m32(v, a) + m32(v, b) + y) f32(v, d, rotd32(__xo_bits(m32(v, d), m32(v, a)), 8))
    f32(v, c, m32(v, c) + m32(v, d)) f32(v, b, rotd32(__xo_bits(m32(v, b), m32(v, c)), 7))
    retornar 0
}

// Compresión: cv (8 palabras), bloque (16 palabras), contador, largo y
// banderas → 16 palabras de salida.
funcion b3_comprimir(cv, m, contador, largo, banderas) {
    sea v = mem_reservar(16 * 8)
    sea i = 0
    mientras (i < 8) {
        f32(v, i, m32(cv, i))
        i = i + 1
    }
    f32(v, 8, b3_iv(0)) f32(v, 9, b3_iv(1)) f32(v, 10, b3_iv(2)) f32(v, 11, b3_iv(3))
    f32(v, 12, contador) f32(v, 13, __desplazar_der(contador, 32)) f32(v, 14, largo) f32(v, 15, banderas)
    sea w = mem_reservar(16 * 8)
    i = 0
    mientras (i < 16) {
        f32(w, i, m32(m, i))
        i = i + 1
    }
    sea perm = "263a704d1bc59ef8"
    sea r = 0
    mientras (r < 7) {
        b3_g(v, 0, 4, 8, 12, m32(w, 0), m32(w, 1))
        b3_g(v, 1, 5, 9, 13, m32(w, 2), m32(w, 3))
        b3_g(v, 2, 6, 10, 14, m32(w, 4), m32(w, 5))
        b3_g(v, 3, 7, 11, 15, m32(w, 6), m32(w, 7))
        b3_g(v, 0, 5, 10, 15, m32(w, 8), m32(w, 9))
        b3_g(v, 1, 6, 11, 12, m32(w, 10), m32(w, 11))
        b3_g(v, 2, 7, 8, 13, m32(w, 12), m32(w, 13))
        b3_g(v, 3, 4, 9, 14, m32(w, 14), m32(w, 15))
        sea p = mem_reservar(16 * 8)
        i = 0
        mientras (i < 16) {
            f32(p, i, m32(w, valor_hex(str_byte(perm, i))))
            i = i + 1
        }
        mem_liberar(w)
        w = p
        r = r + 1
    }
    i = 0
    mientras (i < 8) {
        f32(v, i, __xo_bits(m32(v, i), m32(v, i + 8)))
        f32(v, i + 8, __xo_bits(m32(v, i + 8), m32(cv, i)))
        i = i + 1
    }
    mem_liberar(w)
    retornar v
}

funcion b3_palabras(s, i) {
    sea m = mem_reservar(16 * 8)
    sea b = str_nuevo(64)
    sea k = 0
    mientras (k < 64) {
        si (i + k < str_largo(s)) { str_agregar_byte(b, str_byte(s, i + k)) } sino { str_agregar_byte(b, 0) }
        k = k + 1
    }
    k = 0
    mientras (k < 16) {
        f32(m, k, le32(b, k * 4))
        k = k + 1
    }
    retornar m
}

// Chunk de hasta 1024 bytes → salida "pendiente" [cv o clave, bloque, largo, banderas, contador].
funcion b3_nodo(cv, m, contador, largo, banderas) {
    sea n = mem_reservar(48)
    __guardar64(n, cv)
    __guardar64(n + 8, m)
    __guardar64(n + 16, contador)
    __guardar64(n + 24, largo)
    __guardar64(n + 32, banderas)
    retornar n
}

funcion b3_chunk(clave, s, inicio, fin, contador, banderas_base) {
    sea cv = mem_reservar(8 * 8)
    sea i = 0
    mientras (i < 8) {
        f32(cv, i, m32(clave, i))
        i = i + 1
    }
    sea pos = inicio
    sea bloques = (fin - inicio + 63) / 64
    si (bloques == 0) { bloques = 1 }
    sea b = 0
    mientras (b < bloques - 1) {
        sea banderas = banderas_base
        si (b == 0) { banderas = __o_bits(banderas, 1) }
        sea salida = b3_comprimir(cv, b3_palabras(str_rebanar(s, pos, pos + 64), 0), contador, 64, banderas)
        i = 0
        mientras (i < 8) {
            f32(cv, i, m32(salida, i))
            i = i + 1
        }
        pos = pos + 64
        b = b + 1
    }
    sea banderas = __o_bits(banderas_base, 2)
    si (bloques == 1) { banderas = __o_bits(banderas, 1) }
    retornar b3_nodo(cv, b3_palabras(str_rebanar(s, pos, fin), 0), contador, fin - pos, banderas)
}

funcion b3_cv_de(nodo) {
    sea o = b3_comprimir(__cargar64(nodo), __cargar64(nodo + 8), __cargar64(nodo + 16), __cargar64(nodo + 24), __cargar64(nodo + 32))
    retornar o
}

funcion b3_padre(clave, izq, der, banderas_base) {
    sea m = mem_reservar(16 * 8)
    sea i = 0
    mientras (i < 8) {
        f32(m, i, m32(izq, i))
        f32(m, i + 8, m32(der, i))
        i = i + 1
    }
    retornar b3_nodo(clave, m, 0, 64, __o_bits(banderas_base, 4))
}

// BLAKE3 (modo hash, keyed o derive_key) con salida de n bytes.
funcion blake3_crudo(clave_palabras, s, n, banderas_base) {
    sea total = str_largo(s)
    sea chunks = (total + 1023) / 1024
    si (chunks == 0) { chunks = 1 }
    sea pila = vec_nuevo()
    sea nodo = 0
    sea c = 0
    mientras (c < chunks) {
        sea fin = (c + 1) * 1024
        si (fin > total) { fin = total }
        nodo = b3_chunk(clave_palabras, s, c * 1024, fin, c, banderas_base)
        si (c < chunks - 1) {
            // Cerrar el chunk y combinar según los bits del contador.
            sea cv = b3_cv_de(nodo)
            sea t = c + 1
            mientras (t % 2 == 0) {
                cv = b3_cv_de(b3_padre(clave_palabras, vec_quitar_ultimo(pila), cv, banderas_base))
                t = t / 2
            }
            vec_agregar(pila, cv)
        }
        c = c + 1
    }
    mientras (vec_largo(pila) > 0) {
        nodo = b3_padre(clave_palabras, vec_quitar_ultimo(pila), b3_cv_de(nodo), banderas_base)
    }
    // Raíz con salida extensible (XOF).
    sea r = str_nuevo(n + 64)
    sea contador = 0
    mientras (str_largo(r) < n) {
        sea o = b3_comprimir(__cargar64(nodo), __cargar64(nodo + 8), contador, __cargar64(nodo + 24), __o_bits(__cargar64(nodo + 32), 8))
        sea i = 0
        mientras (i < 16) {
            agregar_le32(r, m32(o, i))
            i = i + 1
        }
        contador = contador + 1
    }
    retornar str_rebanar(r, 0, n)
}

funcion b3_clave_iv() {
    sea k = mem_reservar(8 * 8)
    sea i = 0
    mientras (i < 8) {
        f32(k, i, b3_iv(i))
        i = i + 1
    }
    retornar k
}

funcion b3_clave_de(s) {
    sea k = mem_reservar(8 * 8)
    sea i = 0
    mientras (i < 8) {
        f32(k, i, le32(s, i * 4))
        i = i + 1
    }
    retornar k
}

funcion blake3(mensaje, largo, clave) {
    sea n = 32
    si (largo != 0 y dyn_valor_entero(largo) != 0) { n = dyn_valor_entero(largo) }
    si (clave != 0) {
        sea k = dyn_a_str(clave)
        si (str_largo(k) != 32) { dyn_error("blake3: la clave debe tener 32 bytes") }
        retornar dyn_texto(blake3_crudo(b3_clave_de(k), dyn_a_str(mensaje), n, 16))
    }
    retornar dyn_texto(blake3_crudo(b3_clave_iv(), dyn_a_str(mensaje), n, 0))
}

// derive_key de BLAKE3: contexto fijo de la aplicación + material.
funcion blake3_derivar(contexto, material, largo) {
    sea ck = blake3_crudo(b3_clave_iv(), dyn_a_str(contexto), 32, 32)
    retornar dyn_texto(blake3_crudo(b3_clave_de(ck), dyn_a_str(material), dyn_valor_entero(largo), 64))
}
