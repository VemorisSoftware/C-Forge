// runtime/vec.cfv — listas dinámicas de valores de 64 bits.
// Una lista es un puntero a 24 bytes: [largo][capacidad][datos].

funcion vec_nuevo() {
    sea v = mem_reservar(24)
    __guardar64(v, 0)
    __guardar64(v + 8, 8)
    __guardar64(v + 16, mem_reservar(64))
    retornar v
}

funcion vec_largo(v) { retornar __cargar64(v) }

funcion vec_agregar(v, valor) {
    sea largo = __cargar64(v)
    sea capacidad = __cargar64(v + 8)
    si (largo == capacidad) {
        sea nueva = capacidad * 2
        sea datos = mem_reservar(nueva * 8)
        mem_copiar(datos, __cargar64(v + 16), largo * 8)
        mem_liberar(__cargar64(v + 16))
        __guardar64(v + 8, nueva)
        __guardar64(v + 16, datos)
    }
    __guardar64(__cargar64(v + 16) + largo * 8, valor)
    __guardar64(v, largo + 1)
    retornar v
}

funcion vec_obtener(v, i) {
    si (i < 0 o i >= __cargar64(v)) { rt_panico("índice de lista fuera de rango") }
    retornar __cargar64(__cargar64(v + 16) + i * 8)
}

funcion vec_fijar(v, i, valor) {
    si (i < 0 o i >= __cargar64(v)) { rt_panico("índice de lista fuera de rango") }
    __guardar64(__cargar64(v + 16) + i * 8, valor)
    retornar valor
}

funcion vec_quitar_ultimo(v) {
    sea largo = __cargar64(v)
    si (largo == 0) { rt_panico("la lista está vacía") }
    __guardar64(v, largo - 1)
    retornar __cargar64(__cargar64(v + 16) + (largo - 1) * 8)
}

funcion vec_liberar(v) {
    mem_liberar(__cargar64(v + 16))
    mem_liberar(v)
    retornar 0
}
