// runtime/f64.cfv — números decimales (f64) a texto.
//
// Los f64 viajan como sus 64 bits. Formato: hasta 6 decimales sin ceros
// sobrantes ("3.5", "0.333333", "-2"); notación científica desde 1e15;
// "nan", "inf" y "-inf" para los valores especiales.

funcion f64_desde_entero(n) { retornar __f64_desde_entero(n) }

funcion f64_desde_fraccion(numerador, denominador) {
    retornar __f64_div(__f64_desde_entero(numerador), __f64_desde_entero(denominador))
}

funcion str_digitos_ceros(r, valor, ancho) {
    sea digitos = str_desde_entero(valor)
    sea faltan = ancho - str_largo(digitos)
    mientras (faltan > 0) {
        str_agregar_byte(r, 48)
        faltan = faltan - 1
    }
    str_agregar(r, digitos)
    str_liberar(digitos)
    retornar r
}

funcion str_desde_f64(bits) {
    sea r = str_nuevo(32)
    sea exponente = __y_bits(__desplazar_der(bits, 52), 2047)
    sea negativo = bits < 0
    // Valor absoluto: limpia el bit de signo.
    sea absoluto = __desplazar_der(__desplazar_izq(bits, 1), 1)
    si (exponente == 2047) {
        si (__desplazar_izq(bits, 12) != 0) {
            str_agregar(r, "nan")
            retornar r
        }
        si (negativo) { str_agregar_byte(r, 45) }
        str_agregar(r, "inf")
        retornar r
    }
    si (negativo y absoluto != 0) { str_agregar_byte(r, 45) }
    sea diez = __f64_desde_entero(10)
    sea limite = __f64_desde_entero(1000000000)
    limite = __f64_mul(limite, __f64_desde_entero(1000000))       // 1e15
    sea exponente10 = 0
    si (__f64_menor(absoluto, limite) == 0) {
        mientras (__f64_menor(absoluto, diez) == 0) {
            absoluto = __f64_div(absoluto, diez)
            exponente10 = exponente10 + 1
        }
    }
    sea millon = __f64_desde_entero(1000000)
    sea medio = __f64_div(__f64_desde_entero(1), __f64_desde_entero(2))
    sea entero = __f64_a_entero(absoluto)
    sea fraccion = __f64_resta(absoluto, __f64_desde_entero(entero))
    sea decimales = __f64_a_entero(__f64_suma(__f64_mul(fraccion, millon), medio))
    si (decimales >= 1000000) {
        entero = entero + 1
        decimales = decimales - 1000000
    }
    sea parte = str_desde_entero(entero)
    str_agregar(r, parte)
    str_liberar(parte)
    si (decimales > 0) {
        mientras (decimales % 10 == 0) { decimales = decimales / 10 }
        str_agregar_byte(r, 46)
        str_digitos_ceros_decimales(r, fraccion, decimales)
    }
    si (exponente10 > 0) {
        str_agregar(r, "e+")
        sea e = str_desde_entero(exponente10)
        str_agregar(r, e)
        str_liberar(e)
    }
    retornar r
}

// Escribe los decimales conservando los ceros a la izquierda (3.05 → "05").
funcion str_digitos_ceros_decimales(r, fraccion, decimales) {
    sea ceros = 0
    sea escala = __f64_desde_entero(10)
    sea f = fraccion
    sea medio = __f64_div(__f64_desde_entero(1), __f64_desde_entero(2000000))
    f = __f64_suma(f, medio)
    sea seguir = 1
    mientras (seguir y ceros < 6) {
        f = __f64_mul(f, escala)
        si (__f64_a_entero(f) == 0) {
            ceros = ceros + 1
        } sino {
            seguir = 0
        }
    }
    mientras (ceros > 0) {
        str_agregar_byte(r, 48)
        ceros = ceros - 1
    }
    sea digitos = str_desde_entero(decimales)
    str_agregar(r, digitos)
    str_liberar(digitos)
    retornar r
}
