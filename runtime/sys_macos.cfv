// runtime/sys_macos.cfv — capa del sistema para macOS (Mach-O x86-64 y ARM64).
//
// Misma interfaz que runtime/sys_linux.cfv, sobre /usr/lib/libSystem.B.dylib
// llamada con __libsistema (la vía estable en macOS: las syscalls directas
// no son una interfaz pública). dyld entrega argc, argv y envp a la entrada
// (globales 60, 61 y 62).

// Resultado int de C (32 bits con signo).
funcion sys_i32(x) {
    sea v = __y_bits(x, 4294967295)
    si (v >= 2147483648) { retornar v - 4294967296 }
    retornar v
}

funcion sys_leer(fd, destino, cantidad) { retornar __libsistema("read", fd, destino, cantidad) }
funcion sys_escribir(fd, origen, cantidad) { retornar __libsistema("write", fd, origen, cantidad) }

// banderas como en Linux: 0 lectura · 577 escritura (crear/truncar) ·
// 65536 directorio; se traducen a las de macOS.
funcion sys_abrir(ruta_c, banderas, modo) {
    sea b = 0
    si (banderas == 577) { b = 1537 }                          // O_WRONLY | O_CREAT | O_TRUNC
    si (banderas == 65536) { b = 1048576 }                     // O_DIRECTORY
    retornar sys_i32(__libsistema("open", ruta_c, b, modo))
}

funcion sys_cerrar(fd) { retornar sys_i32(__libsistema("close", fd)) }

funcion sys_mapear(tamano) {
    sea p = __libsistema("mmap", 0, tamano, 3, 4098, 0 - 1, 0)   // PROT_READ|WRITE, MAP_PRIVATE|MAP_ANON
    si (p == 0 - 1) { retornar 0 - 1 }
    retornar p
}

funcion sys_desmapear(direccion, tamano) { retornar sys_i32(__libsistema("munmap", direccion, tamano)) }

funcion sys_salir(codigo) {
    __libsistema("exit", codigo)
    retornar 0
}

funcion sys_argc() { retornar sys_i32(__cargar64(__globales() + 480)) }
funcion sys_argv(indice) { retornar __cargar64(__cargar64(__globales() + 488) + indice * 8) }
funcion sys_entorno(i) { retornar __cargar64(__cargar64(__globales() + 496) + i * 8) }

funcion sys_abrir_lectura() { retornar 0 }
funcion sys_abrir_escritura() { retornar 577 }
funcion sys_modo_archivo() { retornar 420 }
funcion sys_permisos(ruta_c, modo) { retornar sys_i32(__libsistema("chmod", ruta_c, modo)) }

funcion sys_proceso_id() { retornar sys_i32(__libsistema("getpid")) }
funcion sys_borrar(ruta_c) { retornar sys_i32(__libsistema("unlink", ruta_c)) }
funcion sys_ceder() { __libsistema("sched_yield") retornar 0 }
funcion sys_es_windows() { retornar 0 }
funcion sys_nombre_plataforma() {
    si (__plataforma() == 3) { retornar "macOS ARM64" }
    retornar "macOS x86-64"
}
funcion sys_ruta_temporal() { retornar "/tmp/" }

funcion sys_ruta_ejecutable() {
    sea buf = mem_reservar(4096)
    sea tam = mem_reservar(8)
    __guardar64(tam, 4096)
    sea r = 0
    si (sys_i32(__libsistema("_NSGetExecutablePath", buf, tam)) == 0) { r = str_desde_c(buf) }
    mem_liberar(buf)
    mem_liberar(tam)
    retornar r
}

funcion sys_variable_entorno(nombre) {
    sea p = __libsistema("getenv", str_c(nombre))
    si (p == 0) { retornar 0 }
    retornar str_desde_c(p)
}

// Ejecuta un programa (fork + execve + waitpid) y devuelve su código.
funcion sys_ejecutar_programa(ruta, argumentos) {
    sea n = vec_largo(argumentos)
    sea argv = mem_reservar((n + 2) * 8)
    __guardar64(argv, str_c(ruta))
    sea i = 0
    mientras (i < n) {
        __guardar64(argv + 8 + i * 8, str_c(vec_obtener(argumentos, i)))
        i = i + 1
    }
    __guardar64(argv + 8 + n * 8, 0)
    sea pid = sys_i32(__libsistema("fork"))
    si (pid == 0) {
        __libsistema("execve", str_c(ruta), argv, __cargar64(__globales() + 496))
        __libsistema("_exit", 127)
    }
    si (pid < 0) { retornar 0 - 1 }
    sea estado = mem_reservar(8)
    __guardar64(estado, 0)
    __libsistema("waitpid", pid, estado, 0)
    sea s = __y_bits(__cargar64(estado), 65535)
    mem_liberar(estado)
    si (__y_bits(s, 127) == 0) { retornar __y_bits(__desplazar_der(s, 8), 255) }
    retornar 128 + __y_bits(s, 127)
}

// Crea un directorio (0755); 0 si se creó o ya existía.
funcion sys_crear_directorio(ruta_c) {
    si (sys_i32(__libsistema("mkdir", ruta_c, 493)) == 0) { retornar 0 }
    sea d = __libsistema("opendir", ruta_c)
    si (d == 0) { retornar 0 - 1 }
    __libsistema("closedir", d)
    retornar 0
}

// Directorio de trabajo actual (getcwd), o 0.
funcion sys_directorio_actual() {
    sea buf = mem_reservar(4096)
    sea r = 0
    si (__libsistema("getcwd", buf, 4096) != 0) { r = str_desde_c(buf) }
    mem_liberar(buf)
    retornar r
}
