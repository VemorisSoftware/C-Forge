// runtime/sdl.cfv — gráficos con SDL2, escritos en C-Forge sobre extern.
//
// Mismas funciones que el intérprete (sdl_init, sdl_ventana, sdl_renderer,
// sdl_color, sdl_rect, …). SDL2 se carga con dlopen al primer uso; cforge
// incluye este módulo solo si el programa usa funciones sdl_.

// Las declaraciones se registran al compilar y cada función se resuelve
// (dlopen + dlsym) la primera vez que se llama.
funcion __sdl_declaraciones() {
    extern "SDL2" funcion SDL_Init(banderas: entero): entero
    extern "SDL2" funcion SDL_CreateWindow(titulo: texto, x: entero, y: entero, ancho: entero, alto: entero, banderas: entero): puntero
    extern "SDL2" funcion SDL_CreateRenderer(ventana: puntero, indice: entero, banderas: entero): puntero
    extern "SDL2" funcion SDL_SetRenderDrawColor(ren: puntero, r: entero, g: entero, b: entero, a: entero): entero
    extern "SDL2" funcion SDL_RenderClear(ren: puntero): entero
    extern "SDL2" funcion SDL_RenderPresent(ren: puntero): nulo
    extern "SDL2" funcion SDL_RenderFillRect(ren: puntero, rect: puntero): entero
    extern "SDL2" funcion SDL_RenderDrawRect(ren: puntero, rect: puntero): entero
    extern "SDL2" funcion SDL_RenderDrawLine(ren: puntero, x1: entero, y1: entero, x2: entero, y2: entero): entero
    extern "SDL2" funcion SDL_RenderDrawPoint(ren: puntero, x: entero, y: entero): entero
    extern "SDL2" funcion SDL_PollEvent(evento: puntero): entero
    extern "SDL2" funcion SDL_GetTicks(): entero
    extern "SDL2" funcion SDL_Delay(ms: entero): nulo
    extern "SDL2" funcion SDL_SetWindowTitle(ventana: puntero, titulo: texto): nulo
    extern "SDL2" funcion SDL_DestroyRenderer(ren: puntero): nulo
    extern "SDL2" funcion SDL_DestroyWindow(ventana: puntero): nulo
    extern "SDL2" funcion SDL_Quit(): nulo
    extern "SDL2_ttf" funcion TTF_RenderUTF8_Blended(fuente: puntero, texto: texto, color: entero): puntero
    extern "SDL2" funcion SDL_CreateTextureFromSurface(ren: puntero, superficie: puntero): puntero
    extern "SDL2" funcion SDL_FreeSurface(superficie: puntero): nulo
    extern "SDL2" funcion SDL_QueryTexture(textura: puntero, formato: puntero, acceso: puntero, ancho: puntero, alto: puntero): entero
    extern "SDL2" funcion SDL_RenderCopy(ren: puntero, textura: puntero, origen: puntero, destino: puntero): entero
    extern "SDL2" funcion SDL_DestroyTexture(textura: puntero): nulo
}

// Estado creado al primer uso (el módulo se agrega después del programa).
sea __sdl = nulo

funcion __sdl_estado() {
    si (__sdl == nulo) { __sdl = {"ventanas": [], "renderers": [], "fuentes": [], "rect": nulo, "evento": nulo, "ttf": nulo} }
    retornar __sdl
}

funcion __sdl_rect(x, y, ancho, alto) {
    sea estado = __sdl_estado()
    si (estado["rect"] == nulo) { estado["rect"] = c_reservar(16) }
    sea r = __sdl_estado()["rect"]
    c_escribir32(r, 0, piso(x))
    c_escribir32(r, 4, piso(y))
    c_escribir32(r, 8, piso(ancho))
    c_escribir32(r, 12, piso(alto))
    retornar r
}

funcion sdl_disponible() {
    intentar {
        SDL_GetTicks()
        retornar verdadero
    } capturar (e) {
        retornar falso
    }
}

funcion sdl_init(banderas) {
    intentar {
        SDL_GetTicks()
    } capturar (e) {
        lanzar "sdl_init: SDL2 no encontrado. Instala libSDL2."
    }
    si (banderas == nulo) { banderas = 48 }                    // VIDEO | AUDIO
    si (SDL_Init(banderas) != 0) { lanzar "sdl_init: fallo al inicializar SDL2" }
    retornar verdadero
}

funcion sdl_iniciar(banderas) { retornar sdl_init(banderas) }

funcion sdl_ventana(titulo, ancho, alto, banderas) {
    si (tipo_de(titulo) != "texto") { titulo = "C-Forge" }
    si (ancho == nulo) { ancho = 800 }
    si (alto == nulo) { alto = 600 }
    si (banderas == nulo) { banderas = 4 }                     // SHOWN
    sea v = SDL_CreateWindow(titulo, 536805376, 536805376, piso(ancho), piso(alto), banderas)
    si (v == 0) { lanzar "sdl_ventana: no se pudo crear la ventana" }
    __sdl_estado()["ventanas"].agregar(v)
    retornar v
}

funcion sdl_renderer(ventana) {
    sea r = SDL_CreateRenderer(ventana, -1, 6)                 // ACCELERATED | PRESENTVSYNC
    si (r == 0) { r = SDL_CreateRenderer(ventana, -1, 0) }
    si (r == 0) { lanzar "sdl_renderer: no se pudo crear renderer" }
    __sdl_estado()["renderers"].agregar(r)
    retornar r
}

funcion sdl_color(ren, r, g, b, a) {
    SDL_SetRenderDrawColor(ren, piso(r ?? 255), piso(g ?? 255), piso(b ?? 255), piso(a ?? 255))
}

funcion sdl_limpiar(ren) { SDL_RenderClear(ren) }
funcion sdl_presentar(ren) { SDL_RenderPresent(ren) }
funcion sdl_mostrar(ren) { SDL_RenderPresent(ren) }

funcion sdl_rect(ren, x, y, ancho, alto, relleno) {
    sea r = __sdl_rect(x, y, ancho, alto)
    si (relleno == falso) { SDL_RenderDrawRect(ren, r) } sino { SDL_RenderFillRect(ren, r) }
}

funcion sdl_dibujar_rect(ren, x, y, ancho, alto, relleno) { sdl_rect(ren, x, y, ancho, alto, relleno) }
funcion sdl_linea(ren, x1, y1, x2, y2) { SDL_RenderDrawLine(ren, piso(x1), piso(y1), piso(x2), piso(y2)) }
funcion sdl_dibujar_linea(ren, x1, y1, x2, y2) { sdl_linea(ren, x1, y1, x2, y2) }
funcion sdl_dibujar_pixel(ren, x, y) { SDL_RenderDrawPoint(ren, piso(x), piso(y)) }

funcion sdl_dibujar_circulo(ren, cx, cy, radio) {
    sea x = radio
    sea y = 0
    sea error = 0
    mientras (x >= y) {
        para p en [[x, y], [y, x], [-y, x], [-x, y], [-x, -y], [-y, -x], [y, -x], [x, -y]] {
            SDL_RenderDrawPoint(ren, piso(cx + p[0]), piso(cy + p[1]))
        }
        y += 1
        error += 1 + 2 * y
        si (2 * (error - x) + 1 > 0) {
            x -= 1
            error += 1 - 2 * x
        }
    }
}

// Lista de eventos: mapas {tipo, tecla, presionada, x, y, boton, salir}.
funcion sdl_eventos() {
    sea estado = __sdl_estado()
    si (estado["evento"] == nulo) { estado["evento"] = c_reservar(64) }
    sea e = estado["evento"]
    sea lista = []
    mientras (SDL_PollEvent(e) != 0) {
        sea tipo = c_leer32(e, 0)
        sea ev = {"tipo": tipo}
        si (tipo == 768 o tipo == 769) {
            ev["tecla"] = c_leer32(e, 16)
            ev["presionada"] = tipo == 768
        } sino si (tipo == 1024 o tipo == 1025 o tipo == 1026) {
            ev["x"] = c_leer32(e, 20)
            ev["y"] = c_leer32(e, 24)
            si (tipo == 1025) { ev["boton"] = c_leer8(e, 16) }
        } sino si (tipo == 256) {
            ev["salir"] = verdadero
        }
        lista.agregar(ev)
    }
    retornar lista
}

funcion sdl_ticks() { retornar SDL_GetTicks() }
funcion sdl_tiempo() { retornar SDL_GetTicks() }
funcion sdl_esperar(ms) { SDL_Delay(piso(ms ?? 16)) }
funcion sdl_delay(ms) { sdl_esperar(ms) }
funcion sdl_titulo(ventana, titulo) { SDL_SetWindowTitle(ventana, titulo) }

funcion sdl_cerrar() {
    para r en __sdl_estado()["renderers"] { SDL_DestroyRenderer(r) }
    para v en __sdl_estado()["ventanas"] { SDL_DestroyWindow(v) }
    sea estado = __sdl_estado()
    estado["renderers"] = []
    estado["ventanas"] = []
    SDL_Quit()
}

// Texto con SDL2_ttf (opcional, como en el intérprete).
funcion sdl_cargar_fuente(ruta, tam) {
    intentar {
        extern "SDL2_ttf" funcion TTF_Init(): entero
        extern "SDL2_ttf" funcion TTF_OpenFont(ruta: texto, tam: entero): puntero
    } capturar (e) {
        lanzar "sdl_cargar_fuente: SDL2_ttf no disponible"
    }
    sea estado = __sdl_estado()
    si (estado["ttf"] == nulo) {
        TTF_Init()
        estado["ttf"] = verdadero
    }
    sea f = TTF_OpenFont(ruta, piso(tam ?? 16))
    si (f == 0) { lanzar "sdl_cargar_fuente: no se pudo abrir '" + ruta + "'" }
    estado["fuentes"].agregar(f)
    retornar f
}

funcion sdl_texto(ren, fuente, txt, x, y, r, g, b) {
    // Sin fuente (SDL2_ttf ausente o no cargada) no se dibuja, como en el intérprete.
    si (no lista_contiene(__sdl_estado()["fuentes"], fuente)) { retornar nulo }
    sea color = piso(r ?? 255) + piso(g ?? 255) * 256 + piso(b ?? 255) * 65536 + 255 * 16777216
    sea s = TTF_RenderUTF8_Blended(fuente, a_texto(txt), color)
    si (s == 0) { retornar nulo }
    sea t = SDL_CreateTextureFromSurface(ren, s)
    SDL_FreeSurface(s)
    sea medidas = c_reservar(8)
    SDL_QueryTexture(t, 0, 0, medidas, medidas + 4)
    SDL_RenderCopy(ren, t, 0, __sdl_rect(x, y, c_leer32(medidas, 0), c_leer32(medidas, 4)))
    c_liberar(medidas)
    SDL_DestroyTexture(t)
}

// Texturas con SDL2_image (opcional, como en el intérprete).
funcion sdl_cargar_textura(ren, ruta) {
    intentar {
        extern "SDL2_image" funcion IMG_LoadTexture(ren: puntero, ruta: texto): puntero
    } capturar (e) {
        lanzar "sdl_cargar_textura: no se pudo cargar '" + ruta + "'. Instala libSDL2-image."
    }
    sea t = IMG_LoadTexture(ren, ruta)
    si (t == 0) { lanzar "sdl_cargar_textura: no se pudo cargar '" + ruta + "'. Instala libSDL2-image." }
    retornar t
}

funcion sdl_dibujar_textura(ren, textura, x, y, ancho, alto, angulo) {
    SDL_RenderCopy(ren, textura, 0, __sdl_rect(x, y, ancho, alto))
}

funcion sdl_destruir_textura(textura) {
    SDL_DestroyTexture(textura)
}
