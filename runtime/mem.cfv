// runtime/mem.cfv — gestor de memoria propio (sin malloc ni libc).
//
// Bloques chicos (hasta 32 KiB) salen de arenas de 64 MiB pedidas con
// sys_mapear y se reciclan con listas libres por clase de tamaño (potencias
// de 2 desde 16 bytes). Los bloques grandes se mapean y desmapean directo.
// Cada bloque lleva 8 bytes de cabecera: la clase (>= 0) o -tamaño mapeado.
//
// Globales (ver __globales): 0 = cursor de la arena, 1 = fin de la arena,
// 2..13 = listas libres de las clases 0..11, 14 = bytes en uso.

funcion mem_global(i) {
    retornar __cargar64(__globales() + i * 8)
}

funcion mem_fijar_global(i, valor) {
    __guardar64(__globales() + i * 8, valor)
    retornar 0
}

funcion mem_clase(total) {
    sea clase = 0
    sea tamano = 16
    mientras (tamano < total) {
        tamano = tamano * 2
        clase = clase + 1
    }
    retornar clase
}

funcion mem_tamano_clase(clase) {
    retornar __desplazar_izq(16, clase)
}

funcion mem_reservar_sin_cerrojo(bytes) {
    sea total = bytes + 8
    sea clase = mem_clase(total)
    si (clase > 11) {
        sea paginas = (total + 4095) / 4096 * 4096
        sea grande = sys_mapear(paginas)
        si (grande < 0) { rt_panico("sin memoria") }
        __guardar64(grande, 0 - paginas)
        mem_fijar_global(14, mem_global(14) + paginas)
        retornar grande + 8
    }
    sea libre = mem_global(2 + clase)
    si (libre != 0) {
        mem_fijar_global(2 + clase, __cargar64(libre))
        __guardar64(libre - 8, clase)
        mem_fijar_global(14, mem_global(14) + mem_tamano_clase(clase))
        retornar libre
    }
    sea tamano = mem_tamano_clase(clase)
    sea cursor = mem_global(0)
    si (cursor == 0 o cursor + tamano > mem_global(1)) {
        sea arena = sys_mapear(67108864)
        si (arena < 0) { rt_panico("sin memoria") }
        cursor = arena
        mem_fijar_global(1, arena + 67108864)
    }
    mem_fijar_global(0, cursor + tamano)
    __guardar64(cursor, clase)
    mem_fijar_global(14, mem_global(14) + tamano)
    retornar cursor + 8
}

funcion mem_liberar_sin_cerrojo(puntero) {
    si (puntero == 0) { retornar 0 }
    sea cabecera = __cargar64(puntero - 8)
    si (cabecera < 0) {
        mem_fijar_global(14, mem_global(14) + cabecera)
        sys_desmapear(puntero - 8, 0 - cabecera)
        retornar 0
    }
    __guardar64(puntero, mem_global(2 + cabecera))
    mem_fijar_global(2 + cabecera, puntero)
    mem_fijar_global(14, mem_global(14) - mem_tamano_clase(cabecera))
    retornar 0
}

funcion mem_en_uso() {
    retornar mem_global(14)
}

funcion mem_copiar(destino, origen, bytes) {
    sea i = 0
    mientras (i + 8 <= bytes) {
        __guardar64(destino + i, __cargar64(origen + i))
        i = i + 8
    }
    mientras (i < bytes) {
        __guardar8(destino + i, __cargar8(origen + i))
        i = i + 1
    }
    retornar destino
}

funcion mem_llenar(destino, byte, bytes) {
    sea i = 0
    mientras (i < bytes) {
        __guardar8(destino + i, byte)
        i = i + 1
    }
    retornar destino
}

// ── Cerrojo del asignador (global 25) ─────────────────────────────────────
// Los hilos (clone) comparten el heap: reservar y liberar se serializan con
// un intercambio atómico (xchg); mientras está ocupado se cede la CPU.
funcion mem_cerrar() {
    sea cerrojo = __globales() + 200
    mientras (__intercambiar(cerrojo, 1) != 0) { sys_ceder() }
    retornar 0
}

funcion mem_abrir() {
    __guardar64(__globales() + 200, 0)
    retornar 0
}

funcion mem_reservar(bytes) {
    mem_cerrar()
    sea p = mem_reservar_sin_cerrojo(bytes)
    mem_abrir()
    retornar p
}

funcion mem_liberar(puntero) {
    mem_cerrar()
    mem_liberar_sin_cerrojo(puntero)
    mem_abrir()
    retornar 0
}
