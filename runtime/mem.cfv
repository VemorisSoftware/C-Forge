// runtime/mem.cfv — gestor de memoria propio (sin malloc ni libc).
//
// Bloques chicos (hasta 32 KiB) salen de arenas de 64 MiB pedidas con
// sys_mapear y se reciclan con listas libres por clase de tamaño (potencias
// de 2 desde 16 bytes). Los bloques grandes se mapean y desmapean directo.
// Cada bloque lleva 8 bytes de cabecera: la clase (>= 0) o -tamaño mapeado.
//
// Globales (ver __globales): 0 = cursor de la arena, 1 = fin de la arena,
// 2..13 = listas libres de las clases 0..11, 14 = bytes en uso.

funcion mem_global(i) {
    retornar __cargar64(__globales() + i * 8)
}

funcion mem_fijar_global(i, valor) {
    __guardar64(__globales() + i * 8, valor)
    retornar 0
}

funcion mem_clase(total) {
    sea clase = 0
    sea tamano = 16
    mientras (tamano < total) {
        tamano = tamano * 2
        clase = clase + 1
    }
    retornar clase
}

funcion mem_tamano_clase(clase) {
    retornar __desplazar_izq(16, clase)
}

funcion mem_reservar_sin_cerrojo(bytes) {
    // Tamaños negativos (cálculos desbordados) o absurdos (> 1 TiB) nunca
    // llegan a sumarse con la cabecera ni a redondearse a páginas.
    si (bytes < 0 o bytes > 1099511627776) { rt_panico("reserva de memoria inválida (tamaño negativo o mayor que 1 TiB)") }
    sea gc = __cargar64(__globales() + 144)
    si (gc != 0) {
        si (__cargar64(__globales() + 112) > __cargar64(gc + 48)) { gc_recolectar(gc) }
    }
    sea total = bytes + 8
    sea clase = mem_clase(total)
    si (clase > 11) {
        sea paginas = (total + 4095) / 4096 * 4096
        sea grande = sys_mapear(paginas)
        si (grande < 0) { rt_panico("sin memoria") }
        __guardar64(grande, 0 - paginas)
        __guardar64(__globales() + 112, __cargar64(__globales() + 112) + paginas)
        si (__cargar64(__globales() + 144) != 0) { gc_registrar_grande(grande) }
        retornar grande + 8
    }
    sea libre = __cargar64(__globales() + (2 + clase) * 8)
    si (libre != 0) {
        __guardar64(__globales() + (2 + clase) * 8, __cargar64(libre))
        __guardar64(libre - 8, clase)
        __guardar64(__globales() + 112, __cargar64(__globales() + 112) + __desplazar_izq(16, clase))
        // Con el recolector, un bloque reciclado empieza en cero: punteros
        // viejos en su parte sin usar retendrían basura.
        si (gc != 0) { mem_poner_cero(libre, __desplazar_izq(16, clase) - 8) }
        retornar libre
    }
    // Sin libres de esta clase: partir uno libre de una clase mayor (cada
    // mitad sobrante va a la lista de su clase) antes de crecer la arena.
    // Casilla 56: bit k encendido si la lista k puede tener bloques (se
    // enciende al apilar y se apaga al encontrarla vacía); sin libres
    // mayores se va directo a la arena.
    sea mayor = 12
    sea pistas = __desplazar_der(__cargar64(__globales() + 448), clase + 1)
    si (pistas != 0) {
        mayor = clase + 1
        mientras (mayor <= 11 y __cargar64(__globales() + (2 + mayor) * 8) == 0) {
            __guardar64(__globales() + 448, __y_bits(__cargar64(__globales() + 448), 0 - 1 - __desplazar_izq(1, mayor)))
            mayor = mayor + 1
        }
    }
    si (mayor <= 11) {
        sea bloque = __cargar64(__globales() + (2 + mayor) * 8)
        __guardar64(__globales() + (2 + mayor) * 8, __cargar64(bloque))
        mientras (mayor > clase) {
            mayor = mayor - 1
            sea mitad = bloque + __desplazar_izq(16, mayor)          // dato de la mitad alta
            __guardar64(mitad - 8, mayor + 128)
            __guardar64(mitad, __cargar64(__globales() + (2 + mayor) * 8))
            __guardar64(__globales() + (2 + mayor) * 8, mitad)
            __guardar64(__globales() + 448, __o_bits(__cargar64(__globales() + 448), __desplazar_izq(1, mayor)))
            si (__cargar64(__globales() + 144) != 0) { gc_marcar_inicio(mitad - 8) }
        }
        __guardar64(bloque - 8, clase)
        __guardar64(__globales() + 112, __cargar64(__globales() + 112) + __desplazar_izq(16, clase))
        si (gc != 0) { mem_poner_cero(bloque, __desplazar_izq(16, clase) - 8) }
        retornar bloque
    }
    sea tamano = __desplazar_izq(16, clase)
    sea cursor = __cargar64(__globales() + 0)
    si (cursor == 0 o cursor + tamano > __cargar64(__globales() + 8)) {
        sea arena = sys_mapear(67108864)
        si (arena < 0) { rt_panico("sin memoria") }
        si (__cargar64(__globales() + 144) != 0) { gc_registrar_arena(arena, cursor) }
        cursor = arena
        __guardar64(__globales() + 8, arena + 67108864)
    }
    __guardar64(__globales() + 0, cursor + tamano)
    __guardar64(cursor, clase)
    __guardar64(__globales() + 112, __cargar64(__globales() + 112) + tamano)
    si (__cargar64(__globales() + 144) != 0) { gc_marcar_inicio(cursor) }
    retornar cursor + 8
}

funcion mem_liberar_sin_cerrojo(puntero) {
    si (puntero == 0) { retornar 0 }
    sea cabecera = __cargar64(puntero - 8)
    si (cabecera < 0) {
        si (__cargar64(__globales() + 144) != 0) { gc_quitar_grande(puntero - 8) }
        __guardar64(__globales() + 112, __cargar64(__globales() + 112) + cabecera)
        sys_desmapear(puntero - 8, 0 - cabecera)
        retornar 0
    }
    si (cabecera >= 128) { retornar 0 }                         // ya libre
    __guardar64(puntero, __cargar64(__globales() + (2 + cabecera) * 8))
    __guardar64(__globales() + (2 + cabecera) * 8, puntero)
    __guardar64(__globales() + 448, __o_bits(__cargar64(__globales() + 448), __desplazar_izq(1, cabecera)))
    __guardar64(puntero - 8, cabecera + 128)                   // marca de libre
    __guardar64(__globales() + 112, __cargar64(__globales() + 112) - __desplazar_izq(16, cabecera))
    retornar 0
}

// Bloque de al menos `nuevo` bytes con los primeros `usados` de puntero; el
// bloque viejo deja de valer. Los bloques grandes (mapeados aparte) crecen
// con sys_remapear cuando el sistema lo permite: sin copiar ni tocar de
// nuevo las páginas ya escritas (una lista de millones de elementos crece
// a la mitad de costo).
funcion mem_redimensionar(puntero, usados, nuevo) {
    si (puntero != 0 y __cargar64(puntero - 8) < 0 y mem_clase(nuevo + 8) > 11) {
        mem_cerrar()
        sea bloque = puntero - 8
        sea viejas = 0 - __cargar64(bloque)
        sea paginas = (nuevo + 8 + 4095) / 4096 * 4096
        sea r = sys_remapear(bloque, viejas, paginas)
        si (r > 0 y __y_bits(r, 4095) == 0) {
            sea gc = __cargar64(__globales() + 144)
            si (gc != 0) { gc_quitar_grande(bloque) }
            __guardar64(r, 0 - paginas)
            __guardar64(__globales() + 112, __cargar64(__globales() + 112) + paginas - viejas)
            si (gc != 0) { gc_registrar_grande(r) }
            mem_abrir()
            retornar r + 8
        }
        mem_abrir()
    }
    sea datos = mem_reservar(nuevo)
    mem_copiar(datos, puntero, usados)
    mem_liberar(puntero)
    retornar datos
}

funcion mem_en_uso() {
    retornar mem_global(14)
}

funcion mem_copiar(destino, origen, bytes) {
    sea i = 0
    mientras (i + 8 <= bytes) {
        __guardar64(destino + i, __cargar64(origen + i))
        i = i + 8
    }
    mientras (i < bytes) {
        __guardar8(destino + i, __cargar8(origen + i))
        i = i + 1
    }
    retornar destino
}

funcion mem_poner_cero(destino, bytes) {
    sea i = 0
    sea fin4 = bytes - 24
    mientras (i < fin4) {
        __guardar64(destino + i, 0)
        __guardar64(destino + i + 8, 0)
        __guardar64(destino + i + 16, 0)
        __guardar64(destino + i + 24, 0)
        i = i + 32
    }
    mientras (i < bytes) {
        __guardar64(destino + i, 0)
        i = i + 8
    }
    retornar 0
}

funcion mem_llenar(destino, byte, bytes) {
    sea i = 0
    mientras (i < bytes) {
        __guardar8(destino + i, byte)
        i = i + 1
    }
    retornar destino
}

// ── Cerrojo del asignador (global 25) ─────────────────────────────────────
// Los hilos (clone) comparten el heap: reservar y liberar se serializan con
// un intercambio atómico (xchg); mientras está ocupado se cede la CPU.
funcion mem_cerrar() {
    sea cerrojo = __globales() + 200
    mientras (__intercambiar(cerrojo, 1) != 0) { sys_ceder() }
    retornar 0
}

funcion mem_abrir() {
    __guardar64(__globales() + 200, 0)
    retornar 0
}

funcion mem_reservar(bytes) {
    mem_cerrar()
    sea p = mem_reservar_sin_cerrojo(bytes)
    mem_abrir()
    retornar p
}

funcion mem_liberar(puntero) {
    mem_cerrar()
    mem_liberar_sin_cerrojo(puntero)
    mem_abrir()
    retornar 0
}

// ── Recolector de basura (marcado y barrido conservador) ──────────────────
// Solo para programas del lenguaje (gc_activar, al inicio del programa); el
// compilador y el dialecto nativo liberan a mano. Raíces: las casillas
// globales y las variables de nivel superior, y la pila del lenguaje
// (desde __pila() hasta la base, casilla 63). Cualquier palabra que apunte
// al inicio de un bloque vivo lo mantiene vivo (y se recorre su contenido
// palabra por palabra): no hace falta conocer el tipo de cada bloque.
//
// Estado (casilla 18, 64 KiB fuera del heap):
//   0 arenas · 8 tabla de bloques grandes · 16 grandes · 24 capacidad
//   32 pila de marcado · 40 capacidad · 48 umbral · 56 fin de las globales
//   64 recolecciones · 72 bytes liberados · 80 umbral mínimo · 88 tope de
//   la pila de marcado · 128 arenas de 32 bytes:
//   [inicio][fin usado][mapa de inicios][mapa de marcas] (1 bit cada 16 B)

funcion gc_activar(fin_globales, minimo) {
    si (mem_global(18) != 0) { retornar 0 }
    sea gc = sys_mapear(65536)
    si (gc < 0) { retornar 0 }
    __guardar64(gc + 8, sys_mapear(65536))
    __guardar64(gc + 24, 4096)
    __guardar64(gc + 32, sys_mapear(1048576))
    __guardar64(gc + 40, 131072)
    __guardar64(gc + 48, minimo)
    __guardar64(gc + 56, fin_globales)
    __guardar64(gc + 80, minimo)
    mem_fijar_global(18, gc)
    // Una arena que ya existía: registrar sus bloques.
    sea cursor = mem_global(0)
    si (cursor != 0) {
        sea inicio = mem_global(1) - 67108864
        gc_registrar_arena(inicio, 0)
        sea p = inicio
        mientras (p < cursor) {
            gc_marcar_inicio(p)
            p = p + mem_tamano_clase(__y_bits(__cargar64(p), 127))
        }
    }
    retornar 0
}

// Nueva arena; la anterior termina en fin_anterior (0: no hay).
funcion gc_registrar_arena(inicio, fin_anterior) {
    sea gc = mem_global(18)
    sea n = __cargar64(gc)
    si (n > 0 y fin_anterior != 0) { __guardar64(gc + 128 + (n - 1) * 32 + 8, fin_anterior) }
    si (n >= 2040) { rt_panico("gc: demasiadas arenas") }
    sea r = gc + 128 + n * 32
    __guardar64(r, inicio)
    __guardar64(r + 8, inicio)
    __guardar64(r + 16, sys_mapear(524288))
    __guardar64(r + 24, sys_mapear(524288))
    __guardar64(gc, n + 1)
    retornar 0
}

funcion gc_arena_de(gc, direccion) {
    sea n = __cargar64(gc)
    sea i = 0
    mientras (i < n) {
        sea r = gc + 128 + i * 32
        si (direccion >= __cargar64(r) y direccion < __cargar64(r) + 67108864) { retornar r }
        i = i + 1
    }
    retornar 0
}

funcion gc_marcar_inicio(bloque) {
    sea r = gc_arena_de(mem_global(18), bloque)
    si (r == 0) { retornar 0 }
    sea k = (bloque - __cargar64(r)) / 16
    sea b = __cargar64(r + 16) + k / 8
    __guardar8(b, __o_bits(__cargar8(b), __desplazar_izq(1, k % 8)))
    retornar 0
}

funcion gc_bit(mapa, k) { retornar __y_bits(__cargar8(mapa + k / 8), __desplazar_izq(1, k % 8)) != 0 }

funcion gc_fijar_bit(mapa, k) {
    __guardar8(mapa + k / 8, __o_bits(__cargar8(mapa + k / 8), __desplazar_izq(1, k % 8)))
    retornar 0
}

// Tabla de bloques grandes: entradas [bloque][marca].
funcion gc_registrar_grande(bloque) {
    sea gc = mem_global(18)
    sea n = __cargar64(gc + 16)
    si (n >= __cargar64(gc + 24)) {
        sea cap = __cargar64(gc + 24) * 2
        sea nueva = sys_mapear(cap * 16)
        mem_copiar(nueva, __cargar64(gc + 8), n * 16)
        sys_desmapear(__cargar64(gc + 8), __cargar64(gc + 24) * 16)
        __guardar64(gc + 8, nueva)
        __guardar64(gc + 24, cap)
    }
    __guardar64(__cargar64(gc + 8) + n * 16, bloque)
    __guardar64(__cargar64(gc + 8) + n * 16 + 8, 0)
    __guardar64(gc + 16, n + 1)
    retornar 0
}

funcion gc_quitar_grande(bloque) {
    sea gc = mem_global(18)
    sea t = __cargar64(gc + 8)
    sea n = __cargar64(gc + 16)
    sea i = 0
    mientras (i < n) {
        si (__cargar64(t + i * 16) == bloque) {
            __guardar64(t + i * 16, __cargar64(t + (n - 1) * 16))
            __guardar64(t + i * 16 + 8, __cargar64(t + (n - 1) * 16 + 8))
            __guardar64(gc + 16, n - 1)
            retornar 0
        }
        i = i + 1
    }
    retornar 0
}

funcion gc_apilar(gc, w) {
    sea pila = __cargar64(gc + 32)
    sea tope = __cargar64(gc + 88)
    si (tope >= __cargar64(gc + 40)) {
        sea cap = __cargar64(gc + 40) * 2
        sea nueva = sys_mapear(cap * 8)
        mem_copiar(nueva, pila, tope * 8)
        sys_desmapear(pila, __cargar64(gc + 40) * 8)
        __guardar64(gc + 32, nueva)
        __guardar64(gc + 40, cap)
        pila = nueva
    }
    __guardar64(pila + tope * 8, w)
    __guardar64(gc + 88, tope + 1)
    retornar 0
}

// ¿w apunta al inicio (dato) de un bloque vivo sin marcar? Lo marca y apila.
funcion gc_considerar(gc, w) {
    si (__y_bits(w, 15) != 8) { retornar 0 }
    sea bloque = w - 8
    sea n = __cargar64(gc)
    sea i = 0
    mientras (i < n) {
        sea r = gc + 128 + i * 32
        sea inicio = __cargar64(r)
        si (bloque >= inicio y bloque < inicio + 67108864) {
            sea fin = __cargar64(r + 8)
            si (i == n - 1) { fin = mem_global(0) }
            si (bloque >= fin) { retornar 0 }
            sea k = (bloque - inicio) / 16
            si (gc_bit(__cargar64(r + 16), k) == 0) { retornar 0 }
            si (gc_bit(__cargar64(r + 24), k)) { retornar 0 }
            sea cabecera = __cargar64(bloque)
            si (cabecera < 0 o cabecera >= 128) { retornar 0 }
            gc_fijar_bit(__cargar64(r + 24), k)
            gc_apilar(gc, w)
            retornar 0
        }
        i = i + 1
    }
    // Bloques grandes (mapeados aparte: alineados a página).
    si (__y_bits(bloque, 4095) != 0) { retornar 0 }
    sea t = __cargar64(gc + 8)
    sea g = __cargar64(gc + 16)
    sea j = 0
    mientras (j < g) {
        si (__cargar64(t + j * 16) == bloque) {
            si (__cargar64(t + j * 16 + 8) == 0) {
                __guardar64(t + j * 16 + 8, 1)
                gc_apilar(gc, w)
            }
            retornar 0
        }
        j = j + 1
    }
    retornar 0
}

funcion gc_escanear(gc, desde, hasta) {
    sea p = __y_bits(desde, 0 - 8)
    mientras (p + 8 <= hasta) {
        // descarte rápido en línea: enteros etiquetados, nulo, etc.
        sea w = __cargar64(p)
        si (__y_bits(w, 15) == 8) { gc_considerar(gc, w) }
        p = p + 8
    }
    retornar 0
}

// ¿Hay hilos de tarea() vivos? (casilla 34: bases; [base + 16] = vivo)
funcion gc_hay_hilos() {
    sea bases = mem_global(34)
    si (bases == 0) { retornar 0 }
    sea i = 0
    mientras (i < __cargar64(bases)) {
        sea base = __cargar64(__cargar64(bases + 16) + i * 8)
        si (__cargar64(base + 16) != 0) { retornar 1 }
        i = i + 1
    }
    retornar 0
}

funcion gc_recolectar(gc) {
    si (gc_hay_hilos()) {
        __guardar64(gc + 48, mem_global(14) * 2)
        retornar 0
    }
    __guardar64(gc + 88, 0)
    // Raíces: casillas globales y variables de nivel superior; pila del
    // lenguaje (incluye los marcos de esta misma llamada).
    gc_escanear(gc, __globales(), __cargar64(gc + 56))
    gc_escanear(gc, __pila(), mem_global(63))
    // Marcado transitivo.
    mientras (__cargar64(gc + 88) > 0) {
        sea tope = __cargar64(gc + 88) - 1
        __guardar64(gc + 88, tope)
        sea w = __cargar64(__cargar64(gc + 32) + tope * 8)
        sea cabecera = __cargar64(w - 8)
        sea bytes = 0
        si (cabecera < 0) { bytes = 0 - cabecera - 8 } sino { bytes = mem_tamano_clase(cabecera) - 8 }
        gc_escanear(gc, w, w + bytes)
    }
    // Barrido de las arenas: lo vivo sin marcar va a las listas libres.
    sea antes = mem_global(14)
    sea n = __cargar64(gc)
    sea i = 0
    mientras (i < n) {
        sea r = gc + 128 + i * 32
        sea inicio = __cargar64(r)
        sea fin = __cargar64(r + 8)
        si (i == n - 1) { fin = mem_global(0) }
        sea marcas = __cargar64(r + 24)
        sea p = inicio
        mientras (p < fin) {
            sea cabecera = __cargar64(p)
            sea clase = __y_bits(cabecera, 127)
            si (cabecera < 128 y gc_bit(marcas, (p - inicio) / 16) == 0) {
                mem_liberar_sin_cerrojo(p + 8)
            }
            p = p + mem_tamano_clase(clase)
        }
        mem_llenar(marcas, 0, (fin - inicio + 127) / 128)        // bits de 16 B: sin pasarse del mapa (512 KiB)
        i = i + 1
    }
    // Bloques grandes sin marcar.
    sea t = __cargar64(gc + 8)
    sea j = 0
    mientras (j < __cargar64(gc + 16)) {
        si (__cargar64(t + j * 16 + 8) == 0) {
            sea bloque = __cargar64(t + j * 16)
            mem_liberar_sin_cerrojo(bloque + 8)                  // la quita de la tabla
        } sino {
            __guardar64(t + j * 16 + 8, 0)
            j = j + 1
        }
    }
    __guardar64(gc + 64, __cargar64(gc + 64) + 1)
    __guardar64(gc + 72, __cargar64(gc + 72) + antes - mem_global(14))
    sea umbral = mem_global(14) * 2
    si (umbral < __cargar64(gc + 80)) { umbral = __cargar64(gc + 80) }
    __guardar64(gc + 48, umbral)
    retornar 0
}
