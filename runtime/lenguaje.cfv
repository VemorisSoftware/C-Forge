// runtime/lenguaje.cfv — funciones del lenguaje escritas en C-Forge completo.
//
// Se compila en modo "lenguaje" (--lenguaje): es código dinámico normal,
// pero un programa puede redefinir cualquiera de estas funciones.

// Tareas: cada una corre en un hilo nativo (clone) con su propia pila.
// esperar(t[, ms]) espera a que termine y devuelve su resultado; si la tarea
// lanzó un error, esperar lo vuelve a lanzar.
funcion tarea(f) {
    // Todas las claves existen antes de lanzar el hilo: después solo se
    // reemplazan valores (sin modificar la estructura del mapa en paralelo).
    sea t = {"__tarea": verdadero, "f": f, "resultado": nulo, "error": nulo, "fallo": falso, "hilo": nulo}
    t["hilo"] = dyn_hilo_lanzar(t)
    retornar t
}

funcion tarea_ejecutar(t) {
    intentar {
        t["resultado"] = t["f"]()
    } capturar (e) {
        t["error"] = e
        t["fallo"] = verdadero
    }
}

funcion esperar(t, limite_ms) {
    si (no dyn_hilo_esperar(t["hilo"], limite_ms)) { lanzar "esperar: la tarea no terminó en " + limite_ms + " ms" }
    si (t["fallo"]) { lanzar t["error"] }
    retornar t["resultado"]
}

funcion hilo(f) { retornar tarea(f) }

// paralelo(f, lista): f(x) para cada elemento, repartido en 8 hilos; los
// resultados quedan en el orden de la lista.
funcion paralelo(f, elementos) {
    si (tipo_de(f) == "texto") { lanzar "paralelo: pasa la función (paralelo(f, lista)), no su nombre" }
    sea n = longitud(elementos)
    sea resultados = []
    sea i = 0
    mientras (i < n) {
        agregar(resultados, nulo)
        i = i + 1
    }
    sea grupos = 8
    sea tareas = []
    sea g = 0
    mientras (g < grupos) {
        sea primero = g
        agregar(tareas, tarea(funcion() {
            sea k = primero
            mientras (k < n) {
                resultados[k] = f(elementos[k])
                k = k + grupos
            }
            retornar nulo
        }))
        g = g + 1
    }
    para t en tareas { esperar(t) }
    retornar resultados
}

funcion mapear(lista, f) {
    sea r = []
    para x en lista { r.agregar(f(x)) }
    retornar r
}

funcion filtrar(lista, f) {
    sea r = []
    para x en lista {
        si (f(x)) { r.agregar(x) }
    }
    retornar r
}

funcion reducir(lista, f, inicial) {
    sea acumulado = inicial
    para x en lista { acumulado = f(acumulado, x) }
    retornar acumulado
}

// ── JSON ──────────────────────────────────────────────────────────────────

funcion json_escapar(t) {
    sea r = "\""
    sea i = 0
    mientras (i < longitud(t)) {
        sea b = byte_en(t, i)
        si (b == 34) { r = r + "\\\"" }
        sino si (b == 92) { r = r + "\\\\" }
        sino si (b == 10) { r = r + "\\n" }
        sino si (b == 13) { r = r + "\\r" }
        sino si (b == 9) { r = r + "\\t" }
        sino si (b < 32) { r = r + "\\u00" + cfv_hex2(b) }
        sino { r = r + t[i] }
        i = i + 1
    }
    retornar r + "\""
}

funcion cfv_hex2(n) {
    sea digitos = "0123456789abcdef"
    retornar digitos[piso(n / 16)] + digitos[n % 16]
}

funcion cfv_json_serializar(v) {
    sea tipo = tipo_de(v)
    si (tipo == "nulo") { retornar "null" }
    si (tipo == "booleano") { si (v) { retornar "true" } retornar "false" }
    si (tipo == "numero") { retornar numero_preciso(v) }
    si (tipo == "texto") { retornar json_escapar(v) }
    si (tipo == "lista") {
        sea partes = []
        para x en v { partes.agregar(cfv_json_serializar(x)) }
        retornar "[" + texto_unir(partes, ",") + "]"
    }
    si (tipo == "mapa") {
        sea partes = []
        para k en claves(v) { partes.agregar(json_escapar(k) + ":" + cfv_json_serializar(v[k])) }
        retornar "\{" + texto_unir(partes, ",") + "\}"
    }
    lanzar "json_serializar: valor no serializable"
}

funcion json_texto(v) { retornar cfv_json_serializar(v) }

funcion cfv_json_bonito_con(v, sangria) {
    sea tipo = tipo_de(v)
    sea interior = sangria + "  "
    si (tipo == "lista") {
        si (longitud(v) == 0) { retornar "[]" }
        sea partes = []
        para x en v { partes.agregar(interior + cfv_json_bonito_con(x, interior)) }
        retornar "[\n" + texto_unir(partes, ",\n") + "\n" + sangria + "]"
    }
    si (tipo == "mapa") {
        si (longitud(v) == 0) { retornar "\{\}" }
        sea partes = []
        para k en claves(v) { partes.agregar(interior + json_escapar(k) + ": " + cfv_json_bonito_con(v[k], interior)) }
        retornar "\{\n" + texto_unir(partes, ",\n") + "\n" + sangria + "\}"
    }
    retornar cfv_json_serializar(v)
}

funcion cfv_json_bonito(v) { retornar cfv_json_bonito_con(v, "") }

funcion json_error(estado) {
    lanzar "json_parsear: token inválido en la posición " + estado["i"]
}

funcion json_espacios(estado) {
    sea s = estado["s"]
    mientras (estado["i"] < longitud(s)) {
        sea b = byte_en(s, estado["i"])
        si (b == 32 o b == 9 o b == 10 o b == 13) { estado["i"] += 1 } sino { retornar nulo }
    }
}

funcion json_esperar(estado, texto) {
    sea s = estado["s"]
    si (subtexto(s, estado["i"], estado["i"] + longitud(texto)) != texto) { json_error(estado) }
    estado["i"] += longitud(texto)
}

funcion json_texto_crudo(estado) {
    sea s = estado["s"]
    estado["i"] += 1
    sea r = ""
    mientras (verdadero) {
        si (estado["i"] >= longitud(s)) { json_error(estado) }
        sea b = byte_en(s, estado["i"])
        si (b == 34) {
            estado["i"] += 1
            retornar r
        }
        si (b == 92) {
            sea e = s[estado["i"] + 1]
            estado["i"] += 2
            si (e == "n") { r = r + "\n" }
            sino si (e == "t") { r = r + "\t" }
            sino si (e == "r") { r = r + "\r" }
            sino si (e == "b") { r = r + caracter(8) }
            sino si (e == "f") { r = r + caracter(12) }
            sino si (e == "u") {
                sea codigo = 0
                para d en subtexto(s, estado["i"], estado["i"] + 4) {
                    sea v = byte_en(d, 0)
                    si (v >= 97) { v = v - 87 } sino si (v >= 65) { v = v - 55 } sino { v = v - 48 }
                    codigo = codigo * 16 + v
                }
                estado["i"] += 4
                r = r + caracter(codigo)
            }
            sino { r = r + e }
        } sino {
            r = r + s[estado["i"]]
            estado["i"] += 1
        }
    }
}

funcion json_numero(estado) {
    sea s = estado["s"]
    sea inicio = estado["i"]
    mientras (estado["i"] < longitud(s) y contiene("+-0123456789.", s[estado["i"]])) { estado["i"] += 1 }
    sea base = a_numero(subtexto(s, inicio, estado["i"]))
    si (estado["i"] < longitud(s) y (s[estado["i"]] == "e" o s[estado["i"]] == "E")) {
        estado["i"] += 1
        sea inicio_exp = estado["i"]
        mientras (estado["i"] < longitud(s) y contiene("+-0123456789", s[estado["i"]])) { estado["i"] += 1 }
        sea exponente = subtexto(s, inicio_exp, estado["i"])
        si (exponente[0] == "+") { exponente = subtexto(exponente, 1, longitud(exponente)) }
        retornar base * potencia(10, a_numero(exponente))
    }
    retornar base
}

funcion json_valor(estado) {
    json_espacios(estado)
    sea s = estado["s"]
    si (estado["i"] >= longitud(s)) { json_error(estado) }
    sea c = s[estado["i"]]
    si (c == "\{") {
        estado["i"] += 1
        sea m = {}
        json_espacios(estado)
        si (s[estado["i"]] == "\}") {
            estado["i"] += 1
            retornar m
        }
        mientras (verdadero) {
            json_espacios(estado)
            si (estado["i"] >= longitud(s) o s[estado["i"]] != "\"") { json_error(estado) }
            sea clave = json_texto_crudo(estado)
            json_espacios(estado)
            json_esperar(estado, ":")
            m[clave] = json_valor(estado)
            json_espacios(estado)
            si (estado["i"] < longitud(s) y s[estado["i"]] == ",") {
                estado["i"] += 1
            } sino {
                json_esperar(estado, "\}")
                retornar m
            }
        }
    }
    si (c == "[") {
        estado["i"] += 1
        sea l = []
        json_espacios(estado)
        si (s[estado["i"]] == "]") {
            estado["i"] += 1
            retornar l
        }
        mientras (verdadero) {
            l.agregar(json_valor(estado))
            json_espacios(estado)
            si (estado["i"] < longitud(s) y s[estado["i"]] == ",") {
                estado["i"] += 1
            } sino {
                json_esperar(estado, "]")
                retornar l
            }
        }
    }
    si (c == "\"") { retornar json_texto_crudo(estado) }
    si (c == "t") { json_esperar(estado, "true") retornar verdadero }
    si (c == "f") { json_esperar(estado, "false") retornar falso }
    si (c == "n") { json_esperar(estado, "null") retornar nulo }
    si (contiene("-0123456789", c)) { retornar json_numero(estado) }
    json_error(estado)
}

funcion cfv_json_parsear(texto) {
    sea estado = {"s": texto, "i": 0}
    sea v = json_valor(estado)
    json_espacios(estado)
    si (estado["i"] != longitud(texto)) { json_error(estado) }
    retornar v
}

// ── Expresiones regulares (retroceso) ─────────────────────────────────────
// Soporta: literales, ., [..], [^..], rangos, \d \w \s \D \W \S, ^, $,
// grupos (..), alternativas |, y cuantificadores * + ? {m}, {m,}, {m,n}.

funcion re_clase_escape(e) {
    si (e == "d") { retornar {"t": "set", "neg": falso, "rangos": [[48, 57]]} }
    si (e == "D") { retornar {"t": "set", "neg": verdadero, "rangos": [[48, 57]]} }
    si (e == "w") { retornar {"t": "set", "neg": falso, "rangos": [[48, 57], [65, 90], [97, 122], [95, 95]]} }
    si (e == "W") { retornar {"t": "set", "neg": verdadero, "rangos": [[48, 57], [65, 90], [97, 122], [95, 95]]} }
    si (e == "s") { retornar {"t": "set", "neg": falso, "rangos": [[32, 32], [9, 10], [13, 13], [12, 12], [11, 11]]} }
    si (e == "S") { retornar {"t": "set", "neg": verdadero, "rangos": [[32, 32], [9, 10], [13, 13], [12, 12], [11, 11]]} }
    retornar nulo
}

funcion re_codigo_escape(e) {
    si (e == "n") { retornar 10 }
    si (e == "t") { retornar 9 }
    si (e == "r") { retornar 13 }
    retornar byte_en(e, 0)
}

funcion re_numero(estado) {
    sea p = estado["p"]
    sea n = 0
    sea hay = falso
    mientras (estado["i"] < longitud(p) y contiene("0123456789", p[estado["i"]])) {
        n = n * 10 + byte_en(p, estado["i"]) - 48
        estado["i"] += 1
        hay = verdadero
    }
    si (no hay) { retornar nulo }
    retornar n
}

funcion re_conjunto(estado) {
    sea p = estado["p"]
    estado["i"] += 1
    sea nodo = {"t": "set", "neg": falso, "rangos": []}
    si (estado["i"] < longitud(p) y p[estado["i"]] == "^") {
        nodo["neg"] = verdadero
        estado["i"] += 1
    }
    sea primero = verdadero
    mientras (estado["i"] < longitud(p) y (p[estado["i"]] != "]" o primero)) {
        primero = falso
        sea desde = byte_en(p, estado["i"])
        si (p[estado["i"]] == "\\") {
            sea e = p[estado["i"] + 1]
            estado["i"] += 2
            sea clase = re_clase_escape(e)
            si (clase != nulo y no clase["neg"]) {
                para r en clase["rangos"] { nodo["rangos"].agregar(r) }
                continuar
            }
            desde = re_codigo_escape(e)
        } sino {
            estado["i"] += 1
        }
        sea hasta = desde
        si (estado["i"] + 1 < longitud(p) y p[estado["i"]] == "-" y p[estado["i"] + 1] != "]") {
            hasta = byte_en(p, estado["i"] + 1)
            estado["i"] += 2
        }
        nodo["rangos"].agregar([desde, hasta])
    }
    si (estado["i"] >= longitud(p)) { lanzar "regex: falta ']'" }
    estado["i"] += 1
    retornar nodo
}

funcion re_atomo(estado) {
    sea p = estado["p"]
    sea c = p[estado["i"]]
    si (c == "(") {
        estado["i"] += 1
        si (subtexto(p, estado["i"], estado["i"] + 2) == "?:") { estado["i"] += 2 }
        sea alt = re_alternativas(estado)
        si (estado["i"] >= longitud(p) o p[estado["i"]] != ")") { lanzar "regex: falta ')'" }
        estado["i"] += 1
        retornar {"t": "grupo", "alt": alt}
    }
    si (c == "[") { retornar re_conjunto(estado) }
    estado["i"] += 1
    si (c == ".") { retornar {"t": "any"} }
    si (c == "^") { retornar {"t": "bol"} }
    si (c == "$") { retornar {"t": "eol"} }
    si (c == "\\") {
        sea e = p[estado["i"]]
        estado["i"] += 1
        sea clase = re_clase_escape(e)
        si (clase != nulo) { retornar clase }
        retornar {"t": "char", "c": re_codigo_escape(e)}
    }
    retornar {"t": "char", "c": byte_en(c, 0)}
}

funcion re_secuencia(estado) {
    sea p = estado["p"]
    sea items = []
    mientras (estado["i"] < longitud(p) y p[estado["i"]] != "|" y p[estado["i"]] != ")") {
        sea nodo = re_atomo(estado)
        nodo["min"] = 1
        nodo["max"] = 1
        si (estado["i"] < longitud(p)) {
            sea q = p[estado["i"]]
            si (q == "*") { nodo["min"] = 0  nodo["max"] = -1  estado["i"] += 1 }
            sino si (q == "+") { nodo["max"] = -1  estado["i"] += 1 }
            sino si (q == "?") { nodo["min"] = 0  estado["i"] += 1 }
            sino si (q == "\{") {
                estado["i"] += 1
                sea m = re_numero(estado)
                nodo["min"] = m
                nodo["max"] = m
                si (p[estado["i"]] == ",") {
                    estado["i"] += 1
                    sea n = re_numero(estado)
                    si (n == nulo) { nodo["max"] = -1 } sino { nodo["max"] = n }
                }
                si (p[estado["i"]] != "\}") { lanzar "regex: cuantificador inválido" }
                estado["i"] += 1
            }
            si (estado["i"] < longitud(p) y p[estado["i"]] == "?") { estado["i"] += 1 }
        }
        items.agregar(nodo)
    }
    retornar items
}

funcion re_alternativas(estado) {
    sea opciones = [re_secuencia(estado)]
    mientras (estado["i"] < longitud(estado["p"]) y estado["p"][estado["i"]] == "|") {
        estado["i"] += 1
        opciones.agregar(re_secuencia(estado))
    }
    retornar opciones
}

funcion re_compilar(patron) {
    sea estado = {"p": patron, "i": 0}
    sea alt = re_alternativas(estado)
    si (estado["i"] != longitud(patron)) { lanzar "regex: ')' sin abrir" }
    retornar alt
}

funcion re_en_conjunto(nodo, b) {
    sea dentro = falso
    para r en nodo["rangos"] {
        si (b >= r[0] y b <= r[1]) { dentro = verdadero }
    }
    si (nodo["neg"]) { retornar no dentro }
    retornar dentro
}

// Una repetición del nodo desde pos: posición final o -1.
funcion re_uno(nodo, s, pos) {
    sea t = nodo["t"]
    si (t == "char") {
        si (pos < longitud(s) y byte_en(s, pos) == nodo["c"]) { retornar pos + 1 }
        retornar -1
    }
    si (t == "any") {
        si (pos < longitud(s) y byte_en(s, pos) != 10) { retornar pos + 1 }
        retornar -1
    }
    si (t == "set") {
        si (pos < longitud(s) y re_en_conjunto(nodo, byte_en(s, pos))) { retornar pos + 1 }
        retornar -1
    }
    si (t == "bol") { si (pos == 0) { retornar pos } retornar -1 }
    si (t == "eol") { si (pos == longitud(s)) { retornar pos } retornar -1 }
    retornar re_alt(nodo["alt"], s, pos, funcion(x) { retornar x })
}

funcion re_seq(items, k, s, pos, cont) {
    si (k == longitud(items)) { retornar cont(pos) }
    sea nodo = items[k]
    sea posiciones = [pos]
    sea ultima = pos
    sea cuenta = 0
    mientras (nodo["max"] < 0 o cuenta < nodo["max"]) {
        sea siguiente = re_uno(nodo, s, ultima)
        si (siguiente < 0 o (siguiente == ultima y cuenta >= nodo["min"])) { romper }
        posiciones.agregar(siguiente)
        ultima = siguiente
        cuenta += 1
    }
    sea i = longitud(posiciones) - 1
    mientras (i >= nodo["min"]) {
        sea r = re_seq(items, k + 1, s, posiciones[i], cont)
        si (r >= 0) { retornar r }
        i -= 1
    }
    retornar -1
}

funcion re_alt(opciones, s, pos, cont) {
    para items en opciones {
        sea r = re_seq(items, 0, s, pos, cont)
        si (r >= 0) { retornar r }
    }
    retornar -1
}

// Primera coincidencia desde inicio: [comienzo, fin] o nulo.
funcion re_buscar_desde(alt, s, inicio) {
    sea i = inicio
    mientras (i <= longitud(s)) {
        sea fin = re_alt(alt, s, i, funcion(x) { retornar x })
        si (fin >= 0) { retornar [i, fin] }
        i += 1
    }
    retornar nulo
}

funcion re_todas(alt, s) {
    sea r = []
    sea i = 0
    mientras (i <= longitud(s)) {
        sea m = re_buscar_desde(alt, s, i)
        si (m == nulo) { romper }
        r.agregar(m)
        si (m[1] > m[0]) { i = m[1] } sino { i = m[0] + 1 }
    }
    retornar r
}

funcion cfv_regex_coincidir(patron, texto) {
    retornar re_buscar_desde(re_compilar(patron), texto, 0) != nulo
}

funcion cfv_regex_buscar(patron, texto) {
    sea m = re_buscar_desde(re_compilar(patron), texto, 0)
    si (m == nulo) { retornar nulo }
    retornar subtexto(texto, m[0], m[1])
}

funcion cfv_regex_buscar_todos(patron, texto) {
    sea r = []
    para m en re_todas(re_compilar(patron), texto) { r.agregar(subtexto(texto, m[0], m[1])) }
    retornar r
}

funcion cfv_regex_reemplazar(patron, texto, reemplazo) {
    sea r = ""
    sea ultimo = 0
    para m en re_todas(re_compilar(patron), texto) {
        r = r + subtexto(texto, ultimo, m[0]) + reemplazo
        ultimo = m[1]
    }
    retornar r + subtexto(texto, ultimo, longitud(texto))
}

funcion cfv_regex_dividir(patron, texto) {
    sea r = []
    sea ultimo = 0
    para m en re_todas(re_compilar(patron), texto) {
        si (m[1] > m[0]) {
            r.agregar(subtexto(texto, ultimo, m[0]))
            ultimo = m[1]
        }
    }
    r.agregar(subtexto(texto, ultimo, longitud(texto)))
    retornar r
}

// ── Ordenamiento (mergesort estable) ──────────────────────────────────────
// comparar(a, b) < 0 si a va antes que b; sin función se usa el orden natural.

funcion ordenar(lista, comparar) {
    si (longitud(lista) <= 1) { retornar lista_invertir(lista_invertir(lista)) }
    sea medio = piso(longitud(lista) / 2)
    sea izquierda = []
    sea derecha = []
    sea i = 0
    para x en lista {
        si (i < medio) { izquierda.agregar(x) } sino { derecha.agregar(x) }
        i += 1
    }
    izquierda = ordenar(izquierda, comparar)
    derecha = ordenar(derecha, comparar)
    sea r = []
    sea a = 0
    sea b = 0
    mientras (a < longitud(izquierda) o b < longitud(derecha)) {
        sea tomar_izquierda = b >= longitud(derecha)
        si (a < longitud(izquierda) y b < longitud(derecha)) {
            si (comparar == nulo) {
                tomar_izquierda = no (derecha[b] < izquierda[a])
            } sino {
                tomar_izquierda = comparar(izquierda[a], derecha[b]) <= 0
            }
        }
        si (tomar_izquierda) {
            r.agregar(izquierda[a])
            a += 1
        } sino {
            r.agregar(derecha[b])
            b += 1
        }
    }
    retornar r
}

funcion lista_ordenar(lista) { retornar ordenar(lista, nulo) }

funcion lista_aplanar(lista) {
    sea r = []
    para x en lista {
        si (tipo_de(x) == "lista") {
            para y en lista_aplanar(x) { r.agregar(y) }
        } sino {
            r.agregar(x)
        }
    }
    retornar r
}

funcion para_cada(lista, f) {
    para x en lista { f(x) }
}

// rango(fin) · rango(inicio, fin) · rango(inicio, fin, paso)
funcion rango(a, b, paso) {
    si (b == nulo) {
        b = a
        a = 0
    }
    si (paso == nulo) { paso = 1 }
    sea r = []
    sea i = a
    si (paso > 0) {
        mientras (i < b) {
            r.agregar(i)
            i += paso
        }
    } sino {
        mientras (i > b) {
            r.agregar(i)
            i += paso
        }
    }
    retornar r
}

// ── Nombres de la biblioteca de 3.x ───────────────────────────────────────

funcion eliminar_clave(m, clave) { retornar quitar_clave(m, clave) }
funcion reloj_ms() { retornar tiempo_ms() }
funcion tiempo_segundos() { retornar piso(tiempo_ms() / 1000) }
funcion tipo(v) { retornar tipo_de(v) }
funcion separar(t, separador) { retornar texto_dividir(t, separador) }
funcion unir(lista, separador) { retornar texto_unir(lista, separador) }
funcion lista_unir(lista, separador) { retornar texto_unir(lista, separador) }
funcion texto_buscar(t, buscado) { retornar texto_indice(t, buscado) }
funcion lista_filtrar(lista, f) { retornar filtrar(lista, f) }
funcion lista_mapear(lista, f) { retornar mapear(lista, f) }

funcion texto_subcadena(t, inicio, fin) {
    si (fin == nulo) { fin = longitud(t) }
    retornar subtexto(t, inicio, fin)
}

// Elementos [inicio, fin) de una lista, como lista nueva.
funcion subarray(lista, inicio, fin) {
    si (fin == nulo o fin > longitud(lista)) { fin = longitud(lista) }
    si (inicio < 0) { inicio = 0 }
    sea r = []
    sea i = inicio
    mientras (i < fin) {
        r.agregar(lista[i])
        i += 1
    }
    retornar r
}

funcion lista_repetir(v, n) {
    sea r = []
    sea i = 0
    mientras (i < n) {
        r.agregar(v)
        i += 1
    }
    retornar r
}

// Número uniforme en [minimo, maximo).
funcion cfv_aleatorio_uniforme(minimo_v, maximo_v) {
    si (minimo_v >= maximo_v) { lanzar "aleatorio_uniforme: min debe ser < max" }
    retornar minimo_v + aleatorio() * (maximo_v - minimo_v)
}
funcion aleatorio_uniforme(minimo_v, maximo_v) { retornar cfv_aleatorio_uniforme(minimo_v, maximo_v) }

// ── Cliente HTTP/1.1 (HTTPS llega con la capa TLS) ────────────────────────

funcion http_partir_url(url) {
    sea seguro = falso
    sea resto = url
    si (texto_empieza_con(url, "https://")) {
        seguro = verdadero
        resto = subtexto(url, 8, longitud(url))
    } sino si (texto_empieza_con(url, "http://")) {
        resto = subtexto(url, 7, longitud(url))
    }
    sea barra = texto_indice(resto, "/")
    sea anfitrion = resto
    sea ruta = "/"
    si (barra >= 0) {
        anfitrion = subtexto(resto, 0, barra)
        ruta = subtexto(resto, barra, longitud(resto))
    }
    sea puerto = 80
    si (seguro) { puerto = 443 }
    sea dos_puntos = texto_indice(anfitrion, ":")
    si (dos_puntos >= 0) {
        puerto = a_numero(subtexto(anfitrion, dos_puntos + 1, longitud(anfitrion)))
        anfitrion = subtexto(anfitrion, 0, dos_puntos)
    }
    retornar {"seguro": seguro, "anfitrion": anfitrion, "puerto": puerto, "ruta": ruta}
}

funcion http_hex_a_numero(t) {
    sea n = 0
    para c en texto_minusculas(texto_recortar(t)) {
        sea d = texto_indice("0123456789abcdef", c)
        si (d < 0) { romper }
        n = n * 16 + d
    }
    retornar n
}

funcion http_quitar_chunked(cuerpo) {
    sea r = []
    sea i = 0
    mientras (i < longitud(cuerpo)) {
        sea fin = texto_indice(subtexto(cuerpo, i, longitud(cuerpo)), "\r\n")
        si (fin < 0) { romper }
        sea n = http_hex_a_numero(subtexto(cuerpo, i, i + fin))
        si (n == 0) { romper }
        sea inicio = i + fin + 2
        r.agregar(subtexto(cuerpo, inicio, minimo(inicio + n, longitud(cuerpo))))
        i = inicio + n + 2
    }
    retornar texto_unir(r, "")
}

funcion http_conexion(partes) {
    sea sock = net_conectar(partes["anfitrion"], partes["puerto"])
    si (partes["seguro"]) {
        sea t = tls_abrir(sock, partes["anfitrion"])
        retornar {"enviar": funcion(d) { retornar tls_enviar(t, d) }, "todo": funcion() { retornar tls_recibir_todo(t) }, "cerrar": funcion() { retornar tls_cerrar(t) }}
    }
    retornar {"enviar": funcion(d) { retornar net_enviar(sock, d) }, "todo": funcion() { retornar net_recibir_todo(sock) }, "cerrar": funcion() { retornar net_cerrar(sock) }}
}

// opciones: {"cuerpo", "tipo", "cabeceras": mapa, "redirecciones": n}
// → {"estado", "cuerpo", "cabeceras" (mapa en minúsculas), "cabeceras_texto"}
funcion http_solicitud(metodo, url, opciones) {
    si (opciones == nulo) { opciones = {} }
    sea saltos = 5
    si (tiene_clave(opciones, "redirecciones")) { saltos = opciones["redirecciones"] }
    sea actual = url
    mientras (verdadero) {
        sea partes = http_partir_url(actual)
        sea cuerpo = ""
        si (tiene_clave(opciones, "cuerpo") y opciones["cuerpo"] != nulo) { cuerpo = a_texto(opciones["cuerpo"]) }
        sea anfitrion = partes["anfitrion"]
        si ((partes["seguro"] y partes["puerto"] != 443) o (no partes["seguro"] y partes["puerto"] != 80)) {
            anfitrion = anfitrion + ":" + partes["puerto"]
        }
        sea pedido = metodo + " " + partes["ruta"] + " HTTP/1.1\r\nHost: " + anfitrion + "\r\nConnection: close\r\nUser-Agent: C-Forge/4.1\r\nAccept-Encoding: identity\r\n"
        si (tiene_clave(opciones, "tipo") y opciones["tipo"] != nulo) { pedido = pedido + "Content-Type: " + opciones["tipo"] + "\r\n" }
        si (longitud(cuerpo) > 0 o metodo == "POST" o metodo == "PUT" o metodo == "PATCH") {
            pedido = pedido + "Content-Length: " + longitud(cuerpo) + "\r\n"
        }
        si (tiene_clave(opciones, "cabeceras") y opciones["cabeceras"] != nulo) {
            para k en claves(opciones["cabeceras"]) { pedido = pedido + k + ": " + opciones["cabeceras"][k] + "\r\n" }
        }
        pedido = pedido + "\r\n" + cuerpo
        sea con = http_conexion(partes)
        con["enviar"](pedido)
        sea crudo = con["todo"]()
        con["cerrar"]()
        sea fin = texto_indice(crudo, "\r\n\r\n")
        sea texto_cab = crudo
        sea resto = ""
        si (fin >= 0) {
            texto_cab = subtexto(crudo, 0, fin)
            resto = subtexto(crudo, fin + 4, longitud(crudo))
        }
        sea lineas = texto_dividir(texto_cab, "\r\n")
        sea estado = 0
        sea primera = texto_dividir(lineas[0], " ")
        si (longitud(primera) >= 2) { estado = a_numero(primera[1]) }
        sea cab = {}
        sea i = 1
        mientras (i < longitud(lineas)) {
            sea p = texto_indice(lineas[i], ":")
            si (p > 0) { cab[texto_minusculas(texto_recortar(subtexto(lineas[i], 0, p)))] = texto_recortar(subtexto(lineas[i], p + 1, longitud(lineas[i]))) }
            i += 1
        }
        si (tiene_clave(cab, "transfer-encoding") y texto_contiene(texto_minusculas(cab["transfer-encoding"]), "chunked")) {
            resto = http_quitar_chunked(resto)
        } sino si (tiene_clave(cab, "content-length")) {
            sea largo = a_numero(cab["content-length"])
            si (largo < longitud(resto)) { resto = subtexto(resto, 0, largo) }
        }
        si (estado >= 300 y estado < 400 y tiene_clave(cab, "location") y saltos > 0) {
            sea destino = cab["location"]
            si (texto_empieza_con(destino, "/")) {
                sea esquema = "http://"
                si (partes["seguro"]) { esquema = "https://" }
                destino = esquema + anfitrion + destino
            }
            actual = destino
            saltos -= 1
            si (estado == 303) { metodo = "GET" }
        } sino {
            retornar {"estado": estado, "cuerpo": resto, "cabeceras": cab, "cabeceras_texto": texto_cab}
        }
    }
}

funcion http_get(url) { retornar http_solicitud("GET", url, {})["cuerpo"] }
funcion http_post(url, cuerpo, tipo) {
    si (tipo == nulo) { tipo = "application/json" }
    retornar http_solicitud("POST", url, {"cuerpo": cuerpo, "tipo": tipo})["cuerpo"]
}
funcion http_put(url, cuerpo) { retornar http_solicitud("PUT", url, {"cuerpo": cuerpo, "tipo": "application/json"})["cuerpo"] }
funcion http_delete(url) { retornar http_solicitud("DELETE", url, {})["cuerpo"] }

// cforge repl: muestra el valor de una expresión (salvo nulo).
// comptime { … } dentro de código que ya se ejecuta al compilar.
funcion comptime_ejecutar(f) { retornar f() }

funcion repl_valor(v) {
    si (v != nulo) { mostrar(v) }
}

// ── Resultado<T, E> y Opcion<T> de primera clase ──────────────────────────
// Ok(v) / Error(e) y Alguno(v) / Ninguno: funcionan con el operador ? (un
// Error o un Ninguno se retorna de la función) y con coincidir.
funcion Ok(v) { retornar {"ok": verdadero, "valor": v, "error": nulo} }
funcion Error(e) { retornar {"ok": falso, "valor": nulo, "error": e} }
funcion Alguno(v) { retornar {"presente": verdadero, "valor": v} }
funcion Ninguno() { retornar {"presente": falso, "valor": nulo} }

// await / aguardar: espera una tarea (de una async funcion o de tarea(f)) y
// entrega su resultado; si falló, relanza su error. Otro valor pasa tal cual.
funcion aguardar(v) {
    si (tipo_de(v) == "mapa" y tiene_clave(v, "__tarea")) { retornar esperar(v) }
    retornar v
}

