// runtime/str.cfv — textos dinámicos.
//
// Un texto es un puntero a 32 bytes: [largo][capacidad][datos][propio].
// "propio" vale 1 si los datos son del montículo y 0 si son estáticos (los
// literales del programa). Los datos siempre terminan en un byte 0 extra para
// pasarlos al sistema operativo sin copiar.

funcion str_nuevo(capacidad) {
    si (capacidad < 15) { capacidad = 15 }
    sea s = mem_reservar(32)
    __guardar64(s, 0)
    __guardar64(s + 8, capacidad)
    sea datos = mem_reservar(capacidad + 1)
    __guardar8(datos, 0)
    __guardar64(s + 16, datos)
    __guardar64(s + 24, 1)
    retornar s
}

funcion str_largo(s) { retornar __cargar64(s) }
funcion str_datos(s) { retornar __cargar64(s + 16) }

funcion str_byte(s, i) {
    si (i < 0 o i >= __cargar64(s)) { rt_panico("índice de texto fuera de rango") }
    retornar __cargar8(__cargar64(s + 16) + i)
}

// Garantiza espacio para al menos `minimo` bytes (más el 0 final).
funcion str_asegurar(s, minimo) {
    sea capacidad = __cargar64(s + 8)
    si (minimo <= capacidad y __cargar64(s + 24) == 1) { retornar 0 }
    sea nueva = capacidad * 2
    si (nueva < minimo) { nueva = minimo }
    si (nueva < 15) { nueva = 15 }
    sea datos = mem_reservar(nueva + 1)
    mem_copiar(datos, __cargar64(s + 16), __cargar64(s))
    __guardar8(datos + __cargar64(s), 0)
    si (__cargar64(s + 24) == 1) { mem_liberar(__cargar64(s + 16)) }
    __guardar64(s + 8, nueva)
    __guardar64(s + 16, datos)
    __guardar64(s + 24, 1)
    retornar 0
}

funcion str_agregar_byte(s, byte) {
    sea largo = __cargar64(s)
    str_asegurar(s, largo + 1)
    sea datos = __cargar64(s + 16)
    __guardar8(datos + largo, byte)
    __guardar8(datos + largo + 1, 0)
    __guardar64(s, largo + 1)
    retornar s
}

funcion str_agregar(s, otro) {
    sea largo = __cargar64(s)
    sea extra = __cargar64(otro)
    str_asegurar(s, largo + extra)
    sea datos = __cargar64(s + 16)
    mem_copiar(datos + largo, __cargar64(otro + 16), extra)
    __guardar8(datos + largo + extra, 0)
    __guardar64(s, largo + extra)
    retornar s
}

funcion str_concatenar(a, b) {
    sea r = str_nuevo(__cargar64(a) + __cargar64(b))
    str_agregar(r, a)
    str_agregar(r, b)
    retornar r
}

funcion str_rebanar(s, inicio, fin) {
    si (inicio < 0) { inicio = 0 }
    si (fin > __cargar64(s)) { fin = __cargar64(s) }
    si (fin < inicio) { fin = inicio }
    sea r = str_nuevo(fin - inicio)
    mem_copiar(__cargar64(r + 16), __cargar64(s + 16) + inicio, fin - inicio)
    __guardar8(__cargar64(r + 16) + fin - inicio, 0)
    __guardar64(r, fin - inicio)
    retornar r
}

funcion str_igual(a, b) {
    sea largo = __cargar64(a)
    si (largo != __cargar64(b)) { retornar 0 }
    sea da = __cargar64(a + 16)
    sea db = __cargar64(b + 16)
    sea i = 0
    mientras (i < largo) {
        si (__cargar8(da + i) != __cargar8(db + i)) { retornar 0 }
        i = i + 1
    }
    retornar 1
}

// Agrega n en decimal al final de r, escribiendo los dígitos en su lugar
// (sin textos temporales). Vale también para el mínimo entero.
funcion str_agregar_entero(r, n) {
    sea cifras = 1
    sea m = n / 10
    mientras (m != 0) {
        cifras = cifras + 1
        m = m / 10
    }
    sea total = cifras
    si (n < 0) { total = total + 1 }
    sea largo = __cargar64(r)
    str_asegurar(r, largo + total + 1)
    sea p = __cargar64(r + 16) + largo
    si (n < 0) { __guardar8(p, 45) }
    sea i = total - 1
    mientras (cifras > 0) {
        sea d = n % 10
        si (d < 0) { d = 0 - d }
        __guardar8(p + i, 48 + d)
        n = n / 10
        i = i - 1
        cifras = cifras - 1
    }
    __guardar64(r, largo + total)
    __guardar8(p + total, 0)
    retornar 0
}

funcion str_desde_entero(n) {
    sea r = str_nuevo(24)
    str_agregar_entero(r, n)
    retornar r
}

// Texto a partir de una cadena C terminada en 0 (argv, entorno).
funcion str_desde_c(puntero) {
    sea largo = 0
    mientras (__cargar8(puntero + largo) != 0) { largo = largo + 1 }
    sea r = str_nuevo(largo)
    mem_copiar(__cargar64(r + 16), puntero, largo)
    __guardar8(__cargar64(r + 16) + largo, 0)
    __guardar64(r, largo)
    retornar r
}

// Puntero a bytes terminados en 0, válido mientras el texto no cambie.
funcion str_c(s) {
    si (__cargar64(s + 24) == 0) {
        // Los literales ya terminan en 0.
        retornar __cargar64(s + 16)
    }
    retornar __cargar64(s + 16)
}

funcion str_liberar(s) {
    si (__cargar64(s + 24) == 1) { mem_liberar(__cargar64(s + 16)) }
    mem_liberar(s)
    retornar 0
}
