// runtime/biblioteca.cfv — biblioteca estándar nativa, 100 % C-Forge.
//
// Se compila en modo puente (como dyn.cfv): código del dialecto nativo que
// recibe y devuelve valores del lenguaje. Sin libc: la matemática usa series
// propias, el tiempo usa clock_gettime y los archivos usan syscalls.

// ── Flotantes: constantes y ayudas ────────────────────────────────────────

funcion f_(n) { retornar __f64_desde_entero(n) }
funcion f_pi() { retornar 4614256656552045848 }               // 0x400921FB54442D18
funcion f_ln2() { retornar 4604418534313441775 }              // 0x3FE62E42FEFA39EF
funcion f_neg(x) { retornar __f64_resta(f_(0), x) }
funcion f_abs(x) { retornar __desplazar_der(__desplazar_izq(x, 1), 1) }
funcion f_mayor(a, b) { retornar __f64_menor(b, a) }

// Redondeo a entero, mitades lejos del cero.
funcion f_redondear(x) {
    si (__f64_menor(x, f_(0))) {
        retornar 0 - __f64_a_entero(__f64_suma(f_abs(x), __f64_div(f_(1), f_(2))))
    }
    retornar __f64_a_entero(__f64_suma(x, __f64_div(f_(1), f_(2))))
}

funcion f_potencia10(n) {
    sea r = f_(1)
    sea i = 0
    mientras (i < n) {
        r = __f64_mul(r, f_(10))
        i = i + 1
    }
    retornar r
}

// seno en [-pi/2, pi/2] por serie de Taylor.
funcion f_seno_reducido(x) {
    sea x2 = __f64_mul(x, x)
    sea termino = x
    sea suma = x
    sea k = 1
    mientras (k < 10) {
        termino = __f64_div(__f64_mul(f_neg(termino), x2), f_((2 * k) * (2 * k + 1)))
        suma = __f64_suma(suma, termino)
        k = k + 1
    }
    retornar suma
}

funcion f_coseno_reducido(x) {
    sea x2 = __f64_mul(x, x)
    sea termino = f_(1)
    sea suma = f_(1)
    sea k = 1
    mientras (k < 11) {
        termino = __f64_div(__f64_mul(f_neg(termino), x2), f_((2 * k - 1) * (2 * k)))
        suma = __f64_suma(suma, termino)
        k = k + 1
    }
    retornar suma
}

// Lleva x a [-pi, pi].
funcion f_reducir_angulo(x) {
    sea dos_pi = __f64_mul(f_(2), f_pi())
    sea k = f_redondear(__f64_div(x, dos_pi))
    retornar __f64_resta(x, __f64_mul(f_(k), dos_pi))
}

funcion f_seno(x) {
    x = f_reducir_angulo(x)
    sea medio_pi = __f64_div(f_pi(), f_(2))
    si (f_mayor(x, medio_pi)) { x = __f64_resta(f_pi(), x) }
    si (__f64_menor(x, f_neg(medio_pi))) { x = __f64_resta(f_neg(f_pi()), x) }
    retornar f_seno_reducido(x)
}

funcion f_coseno(x) {
    x = f_abs(f_reducir_angulo(x))
    si (f_mayor(x, __f64_div(f_pi(), f_(2)))) {
        retornar f_neg(f_coseno_reducido(__f64_resta(f_pi(), x)))
    }
    retornar f_coseno_reducido(x)
}

funcion f_arcotangente(x) {
    sea negativo = __f64_menor(x, f_(0))
    x = f_abs(x)
    sea invertido = 0
    si (f_mayor(x, f_(1))) {
        x = __f64_div(f_(1), x)
        invertido = 1
    }
    // atan(x) = 2·atan(x / (1 + sqrt(1 + x²))), dos veces.
    sea factor = 1
    sea i = 0
    mientras (i < 2) {
        x = __f64_div(x, __f64_suma(f_(1), __f64_raiz(__f64_suma(f_(1), __f64_mul(x, x)))))
        factor = factor * 2
        i = i + 1
    }
    sea x2 = __f64_mul(x, x)
    sea potencia = x
    sea suma = x
    sea k = 1
    mientras (k < 12) {
        potencia = __f64_mul(f_neg(potencia), x2)
        suma = __f64_suma(suma, __f64_div(potencia, f_(2 * k + 1)))
        k = k + 1
    }
    sea r = __f64_mul(suma, f_(factor))
    si (invertido) { r = __f64_resta(__f64_div(f_pi(), f_(2)), r) }
    si (negativo) { r = f_neg(r) }
    retornar r
}

funcion f_arcoseno(x) {
    si (f_mayor(f_abs(x), f_(1))) { dyn_error("arcoseno fuera de [-1, 1]") }
    si (f_abs(x) == f_(1)) {
        sea medio = __f64_div(f_pi(), f_(2))
        si (__f64_menor(x, f_(0))) { retornar f_neg(medio) }
        retornar medio
    }
    retornar f_arcotangente(__f64_div(x, __f64_raiz(__f64_resta(f_(1), __f64_mul(x, x)))))
}

funcion f_exponencial(x) {
    sea k = f_redondear(__f64_div(x, f_ln2()))
    sea r = __f64_resta(x, __f64_mul(f_(k), f_ln2()))
    sea termino = f_(1)
    sea suma = f_(1)
    sea i = 1
    mientras (i < 22) {
        termino = __f64_div(__f64_mul(termino, r), f_(i))
        suma = __f64_suma(suma, termino)
        i = i + 1
    }
    mientras (k > 0) {
        suma = __f64_mul(suma, f_(2))
        k = k - 1
    }
    mientras (k < 0) {
        suma = __f64_div(suma, f_(2))
        k = k + 1
    }
    retornar suma
}

funcion f_logaritmo(x) {
    si (__f64_menor(f_(0), x) == 0) { dyn_error("logaritmo de un número no positivo") }
    sea e = __y_bits(__desplazar_der(x, 52), 2047) - 1023
    sea m = __o_bits(__y_bits(x, 4503599627370495), 4607182418800017408)   // mantisa en [1, 2)
    si (f_mayor(m, __f64_raiz(f_(2)))) {
        m = __f64_div(m, f_(2))
        e = e + 1
    }
    sea t = __f64_div(__f64_resta(m, f_(1)), __f64_suma(m, f_(1)))
    sea t2 = __f64_mul(t, t)
    sea potencia = t
    sea suma = t
    sea k = 1
    mientras (k < 18) {
        potencia = __f64_mul(potencia, t2)
        suma = __f64_suma(suma, __f64_div(potencia, f_(2 * k + 1)))
        k = k + 1
    }
    retornar __f64_suma(__f64_mul(f_(2), suma), __f64_mul(f_(e), f_ln2()))
}

// ── Formato de números (como %g con 6 cifras, igual que el intérprete) ───

funcion dyn_formato_g(r, bits) { retornar dyn_formato_cifras(r, bits, 6) }

// Número con cifras significativas: 6 para mostrar (como %g), 15 para JSON
// (ida y vuelta sin perder datos; los enteros exactos van sin decimales).
funcion dyn_formato_cifras(r, bits, cifras) {
    sea exponente_bits = __y_bits(__desplazar_der(bits, 52), 2047)
    sea negativo = bits < 0
    sea x = f_abs(bits)
    si (exponente_bits == 2047) {
        si (__desplazar_izq(bits, 12) != 0) { str_agregar(r, "nan") retornar 0 }
        si (negativo) { str_agregar_byte(r, 45) }
        str_agregar(r, "inf")
        retornar 0
    }
    si (x == 0) { str_agregar_byte(r, 48) retornar 0 }
    si (negativo) { str_agregar_byte(r, 45) }
    // Exponente decimal e tal que 10^e <= x < 10^(e+1).
    sea e = 0
    sea y = x
    mientras (__f64_menor(y, f_(10)) == 0) {
        y = __f64_div(y, f_(10))
        e = e + 1
    }
    mientras (__f64_menor(y, f_(1))) {
        y = __f64_mul(y, f_(10))
        e = e - 1
    }
    // Las cifras significativas como entero m (10^(c-1) <= m < 10^c).
    sea minimo_m = 1
    sea k = 1
    mientras (k < cifras) {
        minimo_m = minimo_m * 10
        k = k + 1
    }
    sea maximo_m = minimo_m * 10
    sea m = 0
    si (e - (cifras - 1) >= 0) {
        m = f_redondear(__f64_div(x, f_potencia10(e - (cifras - 1))))
    } sino {
        m = f_redondear(__f64_mul(x, f_potencia10(cifras - 1 - e)))
    }
    si (m >= maximo_m) {
        m = (m + 5) / 10
        e = e + 1
    }
    si (m < minimo_m) {
        m = m * 10
        e = e - 1
    }
    sea digitos = str_desde_entero(m)
    // Quitar ceros finales.
    sea utiles = cifras
    mientras (utiles > 1 y str_byte(digitos, utiles - 1) == 48) { utiles = utiles - 1 }
    si (e < 0 - 4 o e >= cifras) {
        str_agregar_byte(r, str_byte(digitos, 0))
        si (utiles > 1) {
            str_agregar_byte(r, 46)
            str_agregar(r, str_rebanar(digitos, 1, utiles))
        }
        str_agregar_byte(r, 101)
        si (e < 0) {
            str_agregar_byte(r, 45)
            e = 0 - e
        } sino {
            str_agregar_byte(r, 43)
        }
        si (e < 10) { str_agregar_byte(r, 48) }
        str_agregar(r, str_desde_entero(e))
        retornar 0
    }
    si (e >= 0) {
        str_agregar(r, str_rebanar(digitos, 0, e + 1))
        si (utiles > e + 1) {
            str_agregar_byte(r, 46)
            str_agregar(r, str_rebanar(digitos, e + 1, utiles))
        }
        retornar 0
    }
    str_agregar(r, "0.")
    sea ceros = 0 - e - 1
    mientras (ceros > 0) {
        str_agregar_byte(r, 48)
        ceros = ceros - 1
    }
    str_agregar(r, str_rebanar(digitos, 0, utiles))
    retornar 0
}

// ── Matemática del lenguaje ───────────────────────────────────────────────

funcion absoluto(v) {
    si (__y_bits(v, 1) == 1) {
        si (v < 0) { retornar 2 - v }
        retornar v
    }
    retornar dyn_desde_f64(f_abs(dyn_a_f64(v)))
}

funcion minimo(a, b) {
    si (dyn_comparar(b, a) < 0) { retornar b }
    retornar a
}

funcion maximo(a, b) {
    si (dyn_comparar(b, a) > 0) { retornar b }
    retornar a
}

funcion raiz(v) {
    sea x = dyn_a_f64(v)
    si (__f64_menor(x, f_(0))) { dyn_error("raíz de un número negativo") }
    retornar dyn_desde_f64(__f64_raiz(x))
}

funcion potencia(base, exponente) {
    si (dyn_ambos_enteros(base, exponente) y exponente >= 1) {
        sea b = dyn_valor_entero(base)
        sea e = dyn_valor_entero(exponente)
        sea r = 1
        sea desborda = 0
        mientras (e > 0 y desborda == 0) {
            si (r > 1152921504606846976 / (absoluto_crudo(b) + 1)) { desborda = 1 }
            r = r * b
            e = e - 1
        }
        si (desborda == 0) { retornar dyn_entero(r) }
    }
    sea x = dyn_a_f64(base)
    sea y = dyn_a_f64(exponente)
    si (x == f_(0)) {
        si (__f64_menor(f_(0), y)) { retornar dyn_entero(0) }
        si (y == f_(0)) { retornar dyn_entero(1) }
        dyn_error("potencia: cero elevado a un exponente negativo")
    }
    si (__f64_menor(x, f_(0))) {
        sea entero = __f64_a_entero(y)
        si (f_(entero) != y) { dyn_error("potencia: base negativa con exponente fraccionario") }
        sea magnitud = f_exponencial(__f64_mul(y, f_logaritmo(f_abs(x))))
        si (__y_bits(entero, 1) == 1) { magnitud = f_neg(magnitud) }
        retornar dyn_desde_f64(magnitud)
    }
    retornar dyn_desde_f64(f_exponencial(__f64_mul(y, f_logaritmo(x))))
}

funcion absoluto_crudo(n) {
    si (n < 0) { retornar 0 - n }
    retornar n
}

funcion redondear(v, decimales) {
    si (__y_bits(v, 1) == 1) { retornar v }
    sea x = dyn_a_f64(v)
    si (decimales == 0) { retornar dyn_entero(f_redondear(x)) }
    sea escala = f_potencia10(dyn_valor_entero(decimales))
    retornar dyn_desde_f64(__f64_div(f_(f_redondear(__f64_mul(x, escala))), escala))
}

funcion seno(v) { retornar dyn_desde_f64(f_seno(dyn_a_f64(v))) }
funcion coseno(v) { retornar dyn_desde_f64(f_coseno(dyn_a_f64(v))) }
funcion tangente(v) {
    sea x = dyn_a_f64(v)
    retornar dyn_desde_f64(__f64_div(f_seno(x), f_coseno(x)))
}
funcion arcoseno(v) { retornar dyn_desde_f64(f_arcoseno(dyn_a_f64(v))) }
funcion arccoseno(v) {
    retornar dyn_desde_f64(__f64_resta(__f64_div(f_pi(), f_(2)), f_arcoseno(dyn_a_f64(v))))
}
funcion arcotangente(v) { retornar dyn_desde_f64(f_arcotangente(dyn_a_f64(v))) }
funcion exponencial(v) { retornar dyn_desde_f64(f_exponencial(dyn_a_f64(v))) }
funcion logaritmo(v) { retornar dyn_desde_f64(f_logaritmo(dyn_a_f64(v))) }
funcion sen(v) { retornar seno(v) }
funcion cos(v) { retornar coseno(v) }
funcion tan(v) { retornar tangente(v) }
funcion pi() { retornar dyn_desde_f64(f_pi()) }

// Generador xorshift64* (global 22), sembrado con el reloj.
funcion aleatorio_crudo() {
    sea x = mem_global(22)
    si (x == 0) { x = __o_bits(sys_reloj_ns(), 1) }
    x = __xo_bits(x, __desplazar_der(x, 12))
    x = __xo_bits(x, __desplazar_izq(x, 25))
    x = __xo_bits(x, __desplazar_der(x, 27))
    mem_fijar_global(22, x)
    retornar __desplazar_der(x * 2685821657736338717, 11)        // 53 bits
}

funcion aleatorio() {
    retornar dyn_caja(4, __f64_div(f_(aleatorio_crudo()), f_(9007199254740992)))
}

funcion aleatorio_entero(minimo_v, maximo_v) {
    sea a = dyn_valor_entero(minimo_v)
    sea b = dyn_valor_entero(maximo_v)
    si (b < a) { dyn_error("aleatorio_entero: el máximo es menor que el mínimo") }
    retornar dyn_entero(a + aleatorio_crudo() % (b - a + 1))
}

// ── Texto ─────────────────────────────────────────────────────────────────

// Posición de aguja en pajar desde inicio, o -1.
funcion str_buscar(pajar, aguja, inicio) {
    sea n = str_largo(pajar)
    sea m = str_largo(aguja)
    sea i = inicio
    mientras (i + m <= n) {
        sea j = 0
        mientras (j < m y str_byte(pajar, i + j) == str_byte(aguja, j)) { j = j + 1 }
        si (j == m) { retornar i }
        i = i + 1
    }
    retornar 0 - 1
}

funcion texto_reemplazar(t, buscado, reemplazo) {
    sea s = dyn_texto_de(t, "texto_reemplazar")
    sea a = dyn_texto_de(buscado, "texto_reemplazar")
    sea b = dyn_a_str(reemplazo)
    si (str_largo(a) == 0) { retornar t }
    sea r = str_nuevo(str_largo(s))
    sea i = 0
    mientras (i < str_largo(s)) {
        sea p = str_buscar(s, a, i)
        si (p < 0) {
            str_agregar(r, str_rebanar(s, i, str_largo(s)))
            i = str_largo(s)
        } sino {
            str_agregar(r, str_rebanar(s, i, p))
            str_agregar(r, b)
            i = p + str_largo(a)
        }
    }
    retornar dyn_texto(r)
}

funcion contiene(coleccion, v) {
    sea t = dyn_tipo(coleccion)
    si (t == 1) {
        retornar dyn_bool(str_buscar(dyn_dato(coleccion), dyn_a_str(v), 0) >= 0)
    }
    si (t == 2) { retornar lista_contiene(coleccion, v) }
    si (t == 3) { retornar tiene_clave(coleccion, v) }
    dyn_error_tipo("contiene", coleccion)
    retornar 2
}

funcion texto_contiene(t, sub) { retornar contiene(t, sub) }

funcion subtexto(t, inicio, fin) {
    sea s = dyn_texto_de(t, "subtexto")
    retornar dyn_texto(str_rebanar(s, dyn_valor_entero(inicio), dyn_valor_entero(fin)))
}

funcion texto_dividir(t, separador) {
    sea s = dyn_texto_de(t, "texto_dividir")
    sea sep = dyn_texto_de(separador, "texto_dividir")
    sea r = vec_nuevo()
    si (str_largo(sep) == 0) {
        sea k = 0
        mientras (k < str_largo(s)) {
            vec_agregar(r, dyn_texto(str_rebanar(s, k, k + 1)))
            k = k + 1
        }
        retornar dyn_caja(2, r)
    }
    sea i = 0
    sea seguir = 1
    mientras (seguir) {
        sea p = str_buscar(s, sep, i)
        si (p < 0) {
            vec_agregar(r, dyn_texto(str_rebanar(s, i, str_largo(s))))
            seguir = 0
        } sino {
            vec_agregar(r, dyn_texto(str_rebanar(s, i, p)))
            i = p + str_largo(sep)
        }
    }
    retornar dyn_caja(2, r)
}

funcion texto_unir(lista, separador) {
    si (dyn_tipo(lista) != 2) { dyn_error_tipo("texto_unir", lista) }
    sea l = dyn_dato(lista)
    sea r = str_nuevo(16)
    sea i = 0
    mientras (i < vec_largo(l)) {
        si (i > 0) { dyn_agregar_valor(r, separador, 0) }
        dyn_agregar_valor(r, vec_obtener(l, i), 0)
        i = i + 1
    }
    retornar dyn_texto(r)
}

funcion es_blanco(b) { retornar b == 32 o b == 9 o b == 10 o b == 13 }

funcion texto_recortar(t) {
    sea s = dyn_texto_de(t, "texto_recortar")
    sea i = 0
    sea j = str_largo(s)
    mientras (i < j y es_blanco(str_byte(s, i))) { i = i + 1 }
    mientras (j > i y es_blanco(str_byte(s, j - 1))) { j = j - 1 }
    retornar dyn_texto(str_rebanar(s, i, j))
}

// Código Unicode del primer carácter (UTF-8).
funcion cfv_codigo_char(t) {
    sea s = dyn_texto_de(t, "codigo_char")
    si (str_largo(s) == 0) { dyn_error("codigo_char: texto vacío") }
    sea b = str_byte(s, 0)
    si (b < 128) { retornar dyn_entero(b) }
    sea extra = 1
    sea valor = __y_bits(b, 31)
    si (b >= 240) {
        extra = 3
        valor = __y_bits(b, 7)
    } sino {
        si (b >= 224) {
            extra = 2
            valor = __y_bits(b, 15)
        }
    }
    sea i = 1
    mientras (i <= extra y i < str_largo(s)) {
        valor = valor * 64 + __y_bits(str_byte(s, i), 63)
        i = i + 1
    }
    retornar dyn_entero(valor)
}

funcion str_agregar_utf8(r, n) {
    si (n < 128) { str_agregar_byte(r, n) retornar 0 }
    si (n < 2048) {
        str_agregar_byte(r, 192 + n / 64)
        str_agregar_byte(r, 128 + n % 64)
        retornar 0
    }
    si (n < 65536) {
        str_agregar_byte(r, 224 + n / 4096)
        str_agregar_byte(r, 128 + (n / 64) % 64)
        str_agregar_byte(r, 128 + n % 64)
        retornar 0
    }
    str_agregar_byte(r, 240 + n / 262144)
    str_agregar_byte(r, 128 + (n / 4096) % 64)
    str_agregar_byte(r, 128 + (n / 64) % 64)
    str_agregar_byte(r, 128 + n % 64)
    retornar 0
}

funcion caracter(codigo) {
    sea r = str_nuevo(4)
    str_agregar_utf8(r, dyn_valor_entero(codigo))
    retornar dyn_texto(r)
}

// Byte i del texto como entero (para bibliotecas escritas en C-Forge).
funcion byte_en(t, i) {
    sea s = dyn_texto_de(t, "byte_en")
    si (__y_bits(i, 1) != 1) { dyn_error("byte_en: el índice debe ser un entero") }
    sea k = dyn_valor_entero(i)
    si (k < 0 o k >= str_largo(s)) { dyn_error("byte_en: índice fuera del texto") }
    retornar dyn_entero(str_byte(s, k))
}

// ── Base64 y URL ──────────────────────────────────────────────────────────

funcion base64_simbolo(n) {
    si (n < 26) { retornar 65 + n }
    si (n < 52) { retornar 97 + n - 26 }
    si (n < 62) { retornar 48 + n - 52 }
    si (n == 62) { retornar 43 }
    retornar 47
}

funcion base64_valor(b) {
    si (b >= 65 y b <= 90) { retornar b - 65 }
    si (b >= 97 y b <= 122) { retornar b - 97 + 26 }
    si (b >= 48 y b <= 57) { retornar b - 48 + 52 }
    si (b == 43 o b == 45) { retornar 62 }
    si (b == 47 o b == 95) { retornar 63 }
    retornar 0 - 1
}

funcion cfv_base64_codificar(t) {
    sea s = dyn_a_str(t)
    sea n = str_largo(s)
    sea r = str_nuevo(n * 4 / 3 + 4)
    sea i = 0
    mientras (i < n) {
        sea b0 = str_byte(s, i)
        sea b1 = 0
        sea b2 = 0
        si (i + 1 < n) { b1 = str_byte(s, i + 1) }
        si (i + 2 < n) { b2 = str_byte(s, i + 2) }
        sea grupo = b0 * 65536 + b1 * 256 + b2
        str_agregar_byte(r, base64_simbolo(__y_bits(__desplazar_der(grupo, 18), 63)))
        str_agregar_byte(r, base64_simbolo(__y_bits(__desplazar_der(grupo, 12), 63)))
        si (i + 1 < n) { str_agregar_byte(r, base64_simbolo(__y_bits(__desplazar_der(grupo, 6), 63))) } sino { str_agregar_byte(r, 61) }
        si (i + 2 < n) { str_agregar_byte(r, base64_simbolo(__y_bits(grupo, 63))) } sino { str_agregar_byte(r, 61) }
        i = i + 3
    }
    retornar dyn_texto(r)
}

funcion cfv_base64_decodificar(t) {
    sea s = dyn_texto_de(t, "base64_decodificar")
    sea r = str_nuevo(str_largo(s))
    sea acumulado = 0
    sea bits = 0
    sea i = 0
    mientras (i < str_largo(s)) {
        sea v = base64_valor(str_byte(s, i))
        si (v >= 0) {
            acumulado = __y_bits(acumulado * 64 + v, 16777215)
            bits = bits + 6
            si (bits >= 8) {
                bits = bits - 8
                str_agregar_byte(r, __y_bits(__desplazar_der(acumulado, bits), 255))
            }
        }
        i = i + 1
    }
    retornar dyn_texto(r)
}

funcion hex_digito(n) {
    si (n < 10) { retornar 48 + n }
    retornar 55 + n
}

funcion valor_hex(b) {
    si (b >= 48 y b <= 57) { retornar b - 48 }
    si (b >= 65 y b <= 70) { retornar b - 55 }
    si (b >= 97 y b <= 102) { retornar b - 87 }
    retornar 0 - 1
}

funcion url_reservado(b) {
    si ((b >= 65 y b <= 90) o (b >= 97 y b <= 122) o (b >= 48 y b <= 57)) { retornar 0 }
    si (b == 45 o b == 95 o b == 46 o b == 126) { retornar 0 }
    retornar 1
}

funcion cfv_url_codificar(t) {
    sea s = dyn_a_str(t)
    sea r = str_nuevo(str_largo(s) * 3)
    sea i = 0
    mientras (i < str_largo(s)) {
        sea b = str_byte(s, i)
        si (url_reservado(b)) {
            str_agregar_byte(r, 37)
            str_agregar_byte(r, hex_digito(b / 16))
            str_agregar_byte(r, hex_digito(b % 16))
        } sino {
            str_agregar_byte(r, b)
        }
        i = i + 1
    }
    retornar dyn_texto(r)
}

funcion cfv_url_decodificar(t) {
    sea s = dyn_texto_de(t, "url_decodificar")
    sea r = str_nuevo(str_largo(s))
    sea i = 0
    mientras (i < str_largo(s)) {
        sea b = str_byte(s, i)
        si (b == 37 y i + 2 < str_largo(s) y valor_hex(str_byte(s, i + 1)) >= 0 y valor_hex(str_byte(s, i + 2)) >= 0) {
            str_agregar_byte(r, valor_hex(str_byte(s, i + 1)) * 16 + valor_hex(str_byte(s, i + 2)))
            i = i + 3
        } sino {
            si (b == 43) { str_agregar_byte(r, 32) } sino { str_agregar_byte(r, b) }
            i = i + 1
        }
    }
    retornar dyn_texto(r)
}

// ── SHA-256 y MD5 (aritmética de 32 bits sobre enteros de 64) ─────────────

funcion u32(x) { retornar __y_bits(x, 4294967295) }
funcion rotd32(x, n) { retornar u32(__o_bits(__desplazar_der(x, n), __desplazar_izq(x, 32 - n))) }
funcion roti32(x, n) { retornar u32(__o_bits(__desplazar_izq(x, n), __desplazar_der(x, 32 - n))) }

funcion hex_agregar(r, valor, bytes, invertido) {
    sea i = 0
    mientras (i < bytes) {
        sea desplazamiento = (bytes - 1 - i) * 8
        si (invertido) { desplazamiento = i * 8 }
        sea b = __y_bits(__desplazar_der(valor, desplazamiento), 255)
        str_agregar_byte(r, __o_bits(hex_digito(b / 16), 32))
        str_agregar_byte(r, __o_bits(hex_digito(b % 16), 32))
        i = i + 1
    }
    retornar 0
}

// Mensaje con relleno de 64 bytes; longitud en bits al final (BE o LE).
funcion hash_relleno(s, little) {
    sea r = str_nuevo(str_largo(s) + 72)
    str_agregar(r, s)
    str_agregar_byte(r, 128)
    mientras (str_largo(r) % 64 != 56) { str_agregar_byte(r, 0) }
    sea bits = str_largo(s) * 8
    sea i = 0
    mientras (i < 8) {
        si (little) {
            str_agregar_byte(r, __y_bits(__desplazar_der(bits, i * 8), 255))
        } sino {
            str_agregar_byte(r, __y_bits(__desplazar_der(bits, (7 - i) * 8), 255))
        }
        i = i + 1
    }
    retornar r
}

funcion sha256_k() {
    sea k = mem_global(23)
    si (k != 0) { retornar k }
    k = vec_nuevo()
    sea valores = "428a2f98 71374491 b5c0fbcf e9b5dba5 3956c25b 59f111f1 923f82a4 ab1c5ed5 d807aa98 12835b01 243185be 550c7dc3 72be5d74 80deb1fe 9bdc06a7 c19bf174 e49b69c1 efbe4786 0fc19dc6 240ca1cc 2de92c6f 4a7484aa 5cb0a9dc 76f988da 983e5152 a831c66d b00327c8 bf597fc7 c6e00bf3 d5a79147 06ca6351 14292967 27b70a85 2e1b2138 4d2c6dfc 53380d13 650a7354 766a0abb 81c2c92e 92722c85 a2bfe8a1 a81a664b c24b8b70 c76c51a3 d192e819 d6990624 f40e3585 106aa070 19a4c116 1e376c08 2748774c 34b0bcb5 391c0cb3 4ed8aa4a 5b9cca4f 682e6ff3 748f82ee 78a5636f 84c87814 8cc70208 90befffa a4506ceb bef9a3f7 c67178f2"
    sea i = 0
    mientras (i < str_largo(valores)) {
        sea v = 0
        sea j = 0
        mientras (j < 8) {
            v = v * 16 + valor_hex(str_byte(valores, i + j))
            j = j + 1
        }
        vec_agregar(k, v)
        i = i + 9
    }
    mem_fijar_global(23, k)
    retornar k
}

funcion cfv_sha256(t) {
    sea m = hash_relleno(dyn_a_str(t), 0)
    sea k = sha256_k()
    sea h = vec_nuevo()
    vec_agregar(h, 1779033703)
    vec_agregar(h, 3144134277)
    vec_agregar(h, 1013904242)
    vec_agregar(h, 2773480762)
    vec_agregar(h, 1359893119)
    vec_agregar(h, 2600822924)
    vec_agregar(h, 528734635)
    vec_agregar(h, 1541459225)
    sea w = vec_nuevo()
    sea i = 0
    mientras (i < 64) {
        vec_agregar(w, 0)
        i = i + 1
    }
    sea bloque = 0
    mientras (bloque < str_largo(m)) {
        i = 0
        mientras (i < 16) {
            sea p = bloque + i * 4
            vec_fijar(w, i, str_byte(m, p) * 16777216 + str_byte(m, p + 1) * 65536 + str_byte(m, p + 2) * 256 + str_byte(m, p + 3))
            i = i + 1
        }
        mientras (i < 64) {
            sea w15 = vec_obtener(w, i - 15)
            sea w2 = vec_obtener(w, i - 2)
            sea s0 = __xo_bits(__xo_bits(rotd32(w15, 7), rotd32(w15, 18)), __desplazar_der(w15, 3))
            sea s1 = __xo_bits(__xo_bits(rotd32(w2, 17), rotd32(w2, 19)), __desplazar_der(w2, 10))
            vec_fijar(w, i, u32(vec_obtener(w, i - 16) + s0 + vec_obtener(w, i - 7) + s1))
            i = i + 1
        }
        sea a = vec_obtener(h, 0)
        sea b = vec_obtener(h, 1)
        sea c = vec_obtener(h, 2)
        sea d = vec_obtener(h, 3)
        sea e = vec_obtener(h, 4)
        sea f = vec_obtener(h, 5)
        sea g = vec_obtener(h, 6)
        sea hh = vec_obtener(h, 7)
        i = 0
        mientras (i < 64) {
            sea S1 = __xo_bits(__xo_bits(rotd32(e, 6), rotd32(e, 11)), rotd32(e, 25))
            sea ch = __xo_bits(__y_bits(e, f), __y_bits(__xo_bits(e, 4294967295), g))
            sea t1 = u32(hh + S1 + ch + vec_obtener(k, i) + vec_obtener(w, i))
            sea S0 = __xo_bits(__xo_bits(rotd32(a, 2), rotd32(a, 13)), rotd32(a, 22))
            sea mayoria = __xo_bits(__xo_bits(__y_bits(a, b), __y_bits(a, c)), __y_bits(b, c))
            sea t2 = u32(S0 + mayoria)
            hh = g
            g = f
            f = e
            e = u32(d + t1)
            d = c
            c = b
            b = a
            a = u32(t1 + t2)
            i = i + 1
        }
        vec_fijar(h, 0, u32(vec_obtener(h, 0) + a))
        vec_fijar(h, 1, u32(vec_obtener(h, 1) + b))
        vec_fijar(h, 2, u32(vec_obtener(h, 2) + c))
        vec_fijar(h, 3, u32(vec_obtener(h, 3) + d))
        vec_fijar(h, 4, u32(vec_obtener(h, 4) + e))
        vec_fijar(h, 5, u32(vec_obtener(h, 5) + f))
        vec_fijar(h, 6, u32(vec_obtener(h, 6) + g))
        vec_fijar(h, 7, u32(vec_obtener(h, 7) + hh))
        bloque = bloque + 64
    }
    sea r = str_nuevo(64)
    i = 0
    mientras (i < 8) {
        hex_agregar(r, vec_obtener(h, i), 4, 0)
        i = i + 1
    }
    retornar dyn_texto(r)
}

funcion md5_tablas() {
    sea t = mem_global(24)
    si (t != 0) { retornar t }
    t = vec_nuevo()
    // K[i] = floor(|sin(i + 1)| · 2^32)
    sea i = 0
    mientras (i < 64) {
        sea s = f_abs(f_seno(f_(i + 1)))
        vec_agregar(t, __f64_a_entero(__f64_mul(s, f_(4294967296))))
        i = i + 1
    }
    mem_fijar_global(24, t)
    retornar t
}

funcion md5_desplazamiento(i) {
    sea ronda = i / 16
    sea j = i % 4
    si (ronda == 0) {
        si (j == 0) { retornar 7 }
        si (j == 1) { retornar 12 }
        si (j == 2) { retornar 17 }
        retornar 22
    }
    si (ronda == 1) {
        si (j == 0) { retornar 5 }
        si (j == 1) { retornar 9 }
        si (j == 2) { retornar 14 }
        retornar 20
    }
    si (ronda == 2) {
        si (j == 0) { retornar 4 }
        si (j == 1) { retornar 11 }
        si (j == 2) { retornar 16 }
        retornar 23
    }
    si (j == 0) { retornar 6 }
    si (j == 1) { retornar 10 }
    si (j == 2) { retornar 15 }
    retornar 21
}

funcion cfv_md5(t) {
    sea m = hash_relleno(dyn_a_str(t), 1)
    sea k = md5_tablas()
    sea a0 = 1732584193
    sea b0 = 4023233417
    sea c0 = 2562383102
    sea d0 = 271733878
    sea palabras = vec_nuevo()
    sea i = 0
    mientras (i < 16) {
        vec_agregar(palabras, 0)
        i = i + 1
    }
    sea bloque = 0
    mientras (bloque < str_largo(m)) {
        i = 0
        mientras (i < 16) {
            sea p = bloque + i * 4
            vec_fijar(palabras, i, str_byte(m, p) + str_byte(m, p + 1) * 256 + str_byte(m, p + 2) * 65536 + str_byte(m, p + 3) * 16777216)
            i = i + 1
        }
        sea a = a0
        sea b = b0
        sea c = c0
        sea d = d0
        i = 0
        mientras (i < 64) {
            sea f = 0
            sea g = 0
            si (i < 16) {
                f = __o_bits(__y_bits(b, c), __y_bits(__xo_bits(b, 4294967295), d))
                g = i
            } sino {
                si (i < 32) {
                    f = __o_bits(__y_bits(d, b), __y_bits(__xo_bits(d, 4294967295), c))
                    g = (5 * i + 1) % 16
                } sino {
                    si (i < 48) {
                        f = __xo_bits(__xo_bits(b, c), d)
                        g = (3 * i + 5) % 16
                    } sino {
                        f = __xo_bits(c, __o_bits(b, __xo_bits(d, 4294967295)))
                        g = (7 * i) % 16
                    }
                }
            }
            f = u32(f + a + vec_obtener(k, i) + vec_obtener(palabras, g))
            a = d
            d = c
            c = b
            b = u32(b + roti32(f, md5_desplazamiento(i)))
            i = i + 1
        }
        a0 = u32(a0 + a)
        b0 = u32(b0 + b)
        c0 = u32(c0 + c)
        d0 = u32(d0 + d)
        bloque = bloque + 64
    }
    sea r = str_nuevo(32)
    hex_agregar(r, a0, 4, 1)
    hex_agregar(r, b0, 4, 1)
    hex_agregar(r, c0, 4, 1)
    hex_agregar(r, d0, 4, 1)
    retornar dyn_texto(r)
}

// ── Archivos ──────────────────────────────────────────────────────────────

funcion leer_archivo(ruta) { retornar dyn_texto(archivo_leer(dyn_texto_de(ruta, "leer_archivo"))) }

funcion escribir_archivo(ruta, contenido) {
    archivo_escribir(dyn_texto_de(ruta, "escribir_archivo"), dyn_a_str(contenido))
    retornar 0
}

funcion existe_archivo(ruta) {
    sea fd = sys_abrir(str_c(dyn_texto_de(ruta, "existe_archivo")), sys_abrir_lectura(), 0)
    si (fd < 0) { retornar 2 }
    sys_cerrar(fd)
    retornar 4
}

// ── Tiempo (clock_gettime) ────────────────────────────────────────────────


funcion cfv_fecha_ahora_ms() { retornar dyn_entero(sys_reloj_ns() / 1000000) }

// Fecha civil (UTC) a partir de días desde 1970 (algoritmo de H. Hinnant).
funcion cfv_fecha_ahora() {
    sea segundos = sys_reloj_ns() / 1000000000
    sea dias = segundos / 86400
    sea resto = segundos % 86400
    sea z = dias + 719468
    sea era = z / 146097
    sea doe = z - era * 146097
    sea yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    sea y = yoe + era * 400
    sea doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    sea mp = (5 * doy + 2) / 153
    sea d = doy - (153 * mp + 2) / 5 + 1
    sea m = mp + 3
    si (m > 12) { m = m - 12 }
    si (m <= 2) { y = y + 1 }
    sea r = map_nuevo()
    map_fijar(r, "anio", dyn_entero(y))
    map_fijar(r, "mes", dyn_entero(m))
    map_fijar(r, "dia", dyn_entero(d))
    map_fijar(r, "hora", dyn_entero(resto / 3600))
    map_fijar(r, "minuto", dyn_entero((resto % 3600) / 60))
    map_fijar(r, "segundo", dyn_entero(resto % 60))
    map_fijar(r, "dia_semana", dyn_entero((dias + 3) % 7))       // 0 = lunes
    retornar dyn_caja(3, r)
}

// ── Sistema y rutas ───────────────────────────────────────────────────────


funcion sys_info() {
    sea r = map_nuevo()
    map_fijar(r, "sistema", dyn_texto("linux"))
    map_fijar(r, "cpu", dyn_texto("x86_64"))
    map_fijar(r, "nucleos", dyn_entero(sys_nucleos()))
    retornar dyn_caja(3, r)
}

funcion ruta_nombre(ruta) {
    sea s = dyn_texto_de(ruta, "ruta_nombre")
    sea i = str_largo(s)
    mientras (i > 0 y str_byte(s, i - 1) != 47) { i = i - 1 }
    retornar dyn_texto(str_rebanar(s, i, str_largo(s)))
}

funcion ruta_extension(ruta) {
    sea s = dyn_dato(ruta_nombre(ruta))
    sea i = str_largo(s)
    mientras (i > 0 y str_byte(s, i - 1) != 46) { i = i - 1 }
    si (i <= 1) { retornar dyn_texto("") }
    retornar dyn_texto(str_rebanar(s, i - 1, str_largo(s)))
}

// ── Listas y mapas ────────────────────────────────────────────────────────

funcion insertar(lista, posicion, v) {
    si (dyn_tipo(lista) != 2) { dyn_error_tipo("insertar", lista) }
    sea l = dyn_dato(lista)
    sea p = dyn_valor_entero(posicion)
    si (p < 0 o p > vec_largo(l)) { dyn_error("insertar: posición inválida") }
    vec_agregar(l, 0)
    sea i = vec_largo(l) - 1
    mientras (i > p) {
        vec_fijar(l, i, vec_obtener(l, i - 1))
        i = i - 1
    }
    vec_fijar(l, p, v)
    retornar 0
}

funcion eliminar(lista, posicion) {
    si (dyn_tipo(lista) != 2) { dyn_error_tipo("eliminar", lista) }
    sea l = dyn_dato(lista)
    sea p = dyn_valor_entero(posicion)
    si (p < 0 o p >= vec_largo(l)) { dyn_error("eliminar: posición inválida") }
    sea v = vec_obtener(l, p)
    sea i = p
    mientras (i + 1 < vec_largo(l)) {
        vec_fijar(l, i, vec_obtener(l, i + 1))
        i = i + 1
    }
    vec_quitar_ultimo(l)
    retornar v
}

funcion mapa_claves(m) { retornar claves(m) }

// ── Conversión de valores para extern (ABI System V AMD64) ────────────────

// Entero de 64 bits de C → valor del lenguaje: un entero si cabe en 63
// bits con signo (n·2+1); si no (p. ej. un tagged pointer de Objective-C
// en ARM64, con el bit 63), una caja de puntero de C (tipo 11) exacta.
funcion dyn_entero_desde_c(x) {
    si (__desplazar_der(x, 63) == __y_bits(__desplazar_der(x, 62), 1)) { retornar x + x + 1 }
    retornar dyn_caja(11, x)
}

funcion dyn_entero_c(v) {
    sea t = dyn_tipo(v)
    si (t == 6) { retornar dyn_valor_entero(v) }
    si (t == 11) { retornar dyn_dato(v) }
    si (t == 5) { retornar v == 4 }
    si (t == 0) { retornar 0 }
    si (t == 4) { retornar __f64_a_entero(dyn_dato(v)) }
    dyn_error_tipo("extern: se esperaba un número entero", v)
    retornar 0
}

// char* terminado en cero (los textos del runtime ya lo están).
funcion dyn_texto_c(v) {
    si (v == 0) { retornar 0 }
    retornar str_datos(dyn_texto_de(v, "extern: se esperaba texto"))
}

funcion dyn_texto_desde_c(p) {
    si (p == 0) { retornar 0 }
    retornar dyn_texto(str_desde_c(p))
}

// ── Carga diferida de bibliotecas compartidas (dlopen / dlsym) ───────────


// "sqlite3" → libsqlite3.so.0, "SDL2" → libSDL2-2.0.so.0: busca en los
// directorios del sistema un archivo lib<nombre>.so* o lib<nombre>-*.so*.
funcion buscar_biblioteca(base) {
    sea dirs = vec_nuevo()
    vec_agregar(dirs, "/lib/x86_64-linux-gnu")
    vec_agregar(dirs, "/usr/lib/x86_64-linux-gnu")
    vec_agregar(dirs, "/lib/aarch64-linux-gnu")
    vec_agregar(dirs, "/usr/lib/aarch64-linux-gnu")
    vec_agregar(dirs, "/usr/local/lib")
    vec_agregar(dirs, "/usr/lib64")
    vec_agregar(dirs, "/lib64")
    vec_agregar(dirs, "/usr/lib")
    sea con_so = str_concatenar(base, ".so")
    sea con_guion = str_concatenar(base, "-")
    sea i = 0
    mientras (i < vec_largo(dirs)) {
        sea nombres = sys_listar(vec_obtener(dirs, i))
        si (nombres != 0) {
            sea j = 0
            mientras (j < vec_largo(nombres)) {
                sea n = vec_obtener(nombres, j)
                si ((dyn_empieza(n, con_so) o dyn_empieza(n, con_guion)) y str_buscar(n, ".so", 0) >= 0) {
                    retornar str_concatenar(str_concatenar(vec_obtener(dirs, i), "/"), n)
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    retornar 0
}

funcion dyn_empieza(s, prefijo) {
    si (str_largo(s) < str_largo(prefijo)) { retornar 0 }
    retornar str_igual(str_rebanar(s, 0, str_largo(prefijo)), prefijo)
}

funcion dyn_abrir_biblioteca(nombre) {
    si (sys_dl_disponible() == 0) { retornar 0 }
    sea cache = mem_global(31)
    si (cache == 0) {
        cache = map_nuevo()
        mem_fijar_global(31, cache)
    }
    sea h = map_obtener_o(cache, nombre, 0)
    si (h != 0) { retornar h }
    h = sys_cargar_biblioteca(nombre)
    si (h == 0 y str_buscar(nombre, "/", 0) < 0 y str_buscar(nombre, "\\", 0) < 0) {
        sea base = nombre
        si (str_buscar(nombre, ".so", 0) >= 0) { base = str_rebanar(nombre, 0, str_buscar(nombre, ".so", 0)) }
        si (str_buscar(nombre, ".dylib", 0) >= 0) { base = str_rebanar(nombre, 0, str_buscar(nombre, ".dylib", 0)) }
        si (str_buscar(nombre, ".dll", 0) >= 0) { base = str_rebanar(nombre, 0, str_buscar(nombre, ".dll", 0)) }
        si (sys_es_windows()) {
            // "libsqlite3" → sqlite3.dll, winsqlite3.dll (la del sistema), libsqlite3.dll
            sea sin_lib = base
            si (dyn_empieza(base, "lib")) { sin_lib = str_rebanar(base, 3, str_largo(base)) }
            h = sys_cargar_biblioteca(str_concatenar(sin_lib, ".dll"))
            si (h == 0) { h = sys_cargar_biblioteca(str_concatenar(str_concatenar("win", sin_lib), ".dll")) }
            si (h == 0) { h = sys_cargar_biblioteca(str_concatenar(base, ".dll")) }
        } sino {
            si (__plataforma() == 2 o __plataforma() == 3) {
                sea con_dylib = str_concatenar(base, ".dylib")
                h = sys_cargar_biblioteca(con_dylib)
                si (h == 0) { h = sys_cargar_biblioteca(str_concatenar("/usr/lib/", con_dylib)) }
                si (h == 0) { h = sys_cargar_biblioteca(str_concatenar("/opt/homebrew/lib/", con_dylib)) }
                si (h == 0) { h = sys_cargar_biblioteca(str_concatenar("/usr/local/lib/", con_dylib)) }
            } sino {
                sea encontrada = buscar_biblioteca(base)
                si (encontrada != 0) { h = sys_cargar_biblioteca(encontrada) }
            }
        }
    }
    si (h != 0) { map_fijar(cache, nombre, h) }
    retornar h
}

// Dirección de simbolo en biblioteca; error capturable si no existe.
funcion dyn_extern_resolver(simbolo, biblioteca) {
    sea h = dyn_abrir_biblioteca(biblioteca)
    si (h == 0) {
        sea m = str_concatenar("extern: no se pudo cargar la biblioteca ", biblioteca)
        str_agregar(m, " (para '")
        str_agregar(m, simbolo)
        str_agregar(m, "')")
        dyn_error(m)
    }
    sea p = sys_simbolo(h, simbolo)
    si (p == 0) { dyn_simbolo_faltante(simbolo, biblioteca) }
    retornar p
}

funcion dyn_simbolo_faltante(simbolo, biblioteca) {
    sea m = str_concatenar("extern: no se encontró el símbolo '", simbolo)
    str_agregar(m, "' en ")
    str_agregar(m, biblioteca)
    dyn_error(m)
    retornar 0
}

// ── Programa: argumentos, entrada y salida ────────────────────────────────

funcion argumentos_programa() {
    sea r = vec_nuevo()
    sea i = 1
    mientras (i < rt_argc()) {
        vec_agregar(r, dyn_texto(rt_argumento(i)))
        i = i + 1
    }
    retornar dyn_caja(2, r)
}

funcion argumentos() { retornar argumentos_programa() }

// Lee una línea de la entrada estándar (sin el salto final); nulo al final.
funcion leer(mensaje) {
    si (mensaje != 0) { rt_escribir_texto(1, dyn_a_str(mensaje)) }
    sea r = str_nuevo(64)
    sea b = mem_reservar(8)
    sea leidos = 0
    sea seguir = 1
    mientras (seguir) {
        sea n = sys_leer(0, b, 1)
        si (n <= 0) {
            seguir = 0
        } sino {
            leidos = leidos + 1
            si (__cargar8(b) == 10) { seguir = 0 } sino { str_agregar_byte(r, __cargar8(b)) }
        }
    }
    mem_liberar(b)
    si (leidos == 0) { retornar 0 }
    retornar dyn_texto(r)
}

funcion cobertura_iniciar(ruta) { retornar cobertura_iniciar_ruta(dyn_a_str(ruta)) }

funcion salir(codigo) {
    sea c = 0
    si (__y_bits(codigo, 1) == 1) { c = dyn_valor_entero(codigo) }
    cobertura_volcar()
    sys_salir(c)
    retornar 0
}

funcion numero_a_texto(v) { retornar a_texto(v) }
funcion subcadena(t, inicio, fin) { retornar subtexto(t, inicio, fin) }

// ── Texto (más) ───────────────────────────────────────────────────────────

funcion texto_empieza_con(t, prefijo) { retornar dyn_bool(dyn_empieza(dyn_texto_de(t, "texto_empieza_con"), dyn_texto_de(prefijo, "texto_empieza_con"))) }

funcion texto_termina_con(t, sufijo) {
    sea s = dyn_texto_de(t, "texto_termina_con")
    sea f = dyn_texto_de(sufijo, "texto_termina_con")
    si (str_largo(f) > str_largo(s)) { retornar 2 }
    retornar dyn_bool(str_igual(str_rebanar(s, str_largo(s) - str_largo(f), str_largo(s)), f))
}

funcion texto_indice(t, buscado) {
    retornar dyn_entero(str_buscar(dyn_texto_de(t, "texto_indice"), dyn_texto_de(buscado, "texto_indice"), 0))
}

funcion texto_invertir(t) {
    sea s = dyn_texto_de(t, "texto_invertir")
    sea r = str_nuevo(str_largo(s))
    sea i = str_largo(s) - 1
    mientras (i >= 0) {
        str_agregar_byte(r, str_byte(s, i))
        i = i - 1
    }
    retornar dyn_texto(r)
}

funcion texto_repetir(t, veces) {
    sea s = dyn_a_str(t)
    sea r = str_nuevo(16)
    sea i = 0
    mientras (i < dyn_valor_entero(veces)) {
        str_agregar(r, s)
        i = i + 1
    }
    retornar dyn_texto(r)
}

funcion texto_a_numero(t) { retornar a_numero(t) }

// ── Tiempo ────────────────────────────────────────────────────────────────

funcion tiempo_ms() { retornar dyn_entero(sys_reloj_ns() / 1000000) }

// ── HMAC-SHA256 y bytes aleatorios del sistema ────────────────────────────

// Texto hexadecimal → bytes crudos.
funcion hex_a_bytes(h) {
    sea r = str_nuevo(str_largo(h) / 2)
    sea i = 0
    mientras (i + 1 < str_largo(h)) {
        str_agregar_byte(r, valor_hex(str_byte(h, i)) * 16 + valor_hex(str_byte(h, i + 1)))
        i = i + 2
    }
    retornar r
}

// HMAC-SHA256 (RFC 2104) en hexadecimal, igual que en 3.x.
funcion hmac_sha256(clave, mensaje) {
    sea k = dyn_a_str(clave)
    si (str_largo(k) > 64) { k = hex_a_bytes(dyn_texto_de(cfv_sha256(dyn_texto(k)), "hmac_sha256")) }
    sea interno = str_nuevo(64 + str_largo(dyn_a_str(mensaje)))
    sea externo = str_nuevo(96)
    sea i = 0
    mientras (i < 64) {
        sea b = 0
        si (i < str_largo(k)) { b = str_byte(k, i) }
        str_agregar_byte(interno, __xo_bits(b, 54))
        str_agregar_byte(externo, __xo_bits(b, 92))
        i = i + 1
    }
    str_agregar(interno, dyn_a_str(mensaje))
    str_agregar(externo, hex_a_bytes(dyn_texto_de(cfv_sha256(dyn_texto(interno)), "hmac_sha256")))
    retornar cfv_sha256(dyn_texto(externo))
}

// n bytes aleatorios criptográficos del sistema, en hexadecimal.
funcion crypto_rand_bytes(n) {
    sea k = dyn_valor_entero(n)
    si (k < 1 o k > 65536) { dyn_error("crypto_rand_bytes: n debe ser 1..65536") }
    sea buf = mem_reservar(k)
    si (sys_aleatorio(buf, k) != 0) { dyn_error("crypto_rand_bytes: el sistema no entregó bytes aleatorios") }
    sea r = str_nuevo(k * 2)
    sea i = 0
    mientras (i < k) {
        sea b = __cargar8(buf + i)
        str_agregar_byte(r, __o_bits(hex_digito(b / 16), 32))
        str_agregar_byte(r, __o_bits(hex_digito(b % 16), 32))
        i = i + 1
    }
    mem_liberar(buf)
    retornar dyn_texto(r)
}

// ── AES-256-CBC con PKCS#7 (FIPS 197), en C-Forge puro ────────────────────
// Formato compatible con 3.x: hex(iv) + ":" + hex(cifrado); la clave es el
// SHA-256 del texto que pasa el programa.

funcion aes_xtime(b) {
    sea r = b * 2
    si (r >= 256) { r = __xo_bits(r, 283) }
    retornar r
}

funcion aes_mul(a, b) {
    sea r = 0
    mientras (b > 0) {
        si (__y_bits(b, 1)) { r = __xo_bits(r, a) }
        a = aes_xtime(a)
        b = __desplazar_der(b, 1)
    }
    retornar r
}

// S-box (0..255) y su inversa (256..511), una sola vez (global 15; ver docs/GLOBALES.md
// para el mapa de casillas).
funcion aes_tablas() {
    sea t = mem_global(15)
    si (t != 0) { retornar t }
    t = mem_reservar(512)
    sea p = 1
    sea q = 1
    __guardar8(t, 99)
    __guardar8(t + 256 + 99, 0)
    sea vuelta = 0
    sea x = 0
    sea k = 0
    mientras (vuelta < 255) {
        // p · 3, q / 3 en GF(2^8)
        p = __xo_bits(p, aes_xtime(p))
        q = __xo_bits(q, q * 2)
        q = __xo_bits(q, q * 4)
        q = __xo_bits(q, q * 16)
        q = __y_bits(q, 255)
        si (__y_bits(q, 128)) { q = __xo_bits(q, 9) }
        x = __xo_bits(q, 99)
        k = 1
        mientras (k <= 4) {
            x = __xo_bits(x, __y_bits(__o_bits(__desplazar_izq(q, k), __desplazar_der(q, 8 - k)), 255))
            k = k + 1
        }
        __guardar8(t + p, x)
        __guardar8(t + 256 + x, p)
        vuelta = vuelta + 1
    }
    mem_fijar_global(15, t)
    retornar t
}

// Expansión de la clave de 32 bytes → 240 bytes (15 claves de ronda).
funcion aes_expandir(clave) {
    sea s = aes_tablas()
    sea w = mem_reservar(240)
    sea i = 0
    mientras (i < 32) {
        __guardar8(w + i, __cargar8(clave + i))
        i = i + 1
    }
    sea rcon = 1
    mientras (i < 240) {
        sea a = __cargar8(w + i - 4)
        sea b = __cargar8(w + i - 3)
        sea c = __cargar8(w + i - 2)
        sea d = __cargar8(w + i - 1)
        si (i % 32 == 0) {
            sea tmp = a
            a = __xo_bits(__cargar8(s + b), rcon)
            b = __cargar8(s + c)
            c = __cargar8(s + d)
            d = __cargar8(s + tmp)
            rcon = aes_xtime(rcon)
        } sino {
            si (i % 32 == 16) {
                a = __cargar8(s + a)
                b = __cargar8(s + b)
                c = __cargar8(s + c)
                d = __cargar8(s + d)
            }
        }
        __guardar8(w + i, __xo_bits(__cargar8(w + i - 32), a))
        __guardar8(w + i + 1, __xo_bits(__cargar8(w + i - 31), b))
        __guardar8(w + i + 2, __xo_bits(__cargar8(w + i - 30), c))
        __guardar8(w + i + 3, __xo_bits(__cargar8(w + i - 29), d))
        i = i + 4
    }
    retornar w
}

funcion aes_sumar_clave(e, w, ronda) {
    sea i = 0
    mientras (i < 16) {
        __guardar8(e + i, __xo_bits(__cargar8(e + i), __cargar8(w + ronda * 16 + i)))
        i = i + 1
    }
    retornar 0
}

// SubBytes + ShiftRows (directo o inverso) sobre el estado e (16 bytes).
funcion aes_sustituir_desplazar(e, tabla, inverso) {
    sea tmp = mem_reservar(16)
    sea i = 0
    mientras (i < 16) {
        sea fila = i % 4
        sea col = i / 4
        sea origen = ((col + fila) % 4) * 4 + fila
        si (inverso) { origen = ((col + 4 - fila) % 4) * 4 + fila }
        __guardar8(tmp + i, __cargar8(tabla + __cargar8(e + origen)))
        i = i + 1
    }
    i = 0
    mientras (i < 16) {
        __guardar8(e + i, __cargar8(tmp + i))
        i = i + 1
    }
    mem_liberar(tmp)
    retornar 0
}

funcion aes_mezclar(e, inverso) {
    sea c = 0
    mientras (c < 4) {
        sea p = e + c * 4
        sea a0 = __cargar8(p)
        sea a1 = __cargar8(p + 1)
        sea a2 = __cargar8(p + 2)
        sea a3 = __cargar8(p + 3)
        si (inverso) {
            __guardar8(p, __xo_bits(__xo_bits(aes_mul(a0, 14), aes_mul(a1, 11)), __xo_bits(aes_mul(a2, 13), aes_mul(a3, 9))))
            __guardar8(p + 1, __xo_bits(__xo_bits(aes_mul(a0, 9), aes_mul(a1, 14)), __xo_bits(aes_mul(a2, 11), aes_mul(a3, 13))))
            __guardar8(p + 2, __xo_bits(__xo_bits(aes_mul(a0, 13), aes_mul(a1, 9)), __xo_bits(aes_mul(a2, 14), aes_mul(a3, 11))))
            __guardar8(p + 3, __xo_bits(__xo_bits(aes_mul(a0, 11), aes_mul(a1, 13)), __xo_bits(aes_mul(a2, 9), aes_mul(a3, 14))))
        } sino {
            __guardar8(p, __xo_bits(__xo_bits(aes_xtime(a0), __xo_bits(aes_xtime(a1), a1)), __xo_bits(a2, a3)))
            __guardar8(p + 1, __xo_bits(__xo_bits(a0, aes_xtime(a1)), __xo_bits(__xo_bits(aes_xtime(a2), a2), a3)))
            __guardar8(p + 2, __xo_bits(__xo_bits(a0, a1), __xo_bits(aes_xtime(a2), __xo_bits(aes_xtime(a3), a3))))
            __guardar8(p + 3, __xo_bits(__xo_bits(__xo_bits(aes_xtime(a0), a0), a1), __xo_bits(a2, aes_xtime(a3))))
        }
        c = c + 1
    }
    retornar 0
}

funcion aes_bloque_cifrar(e, w) {
    sea s = aes_tablas()
    aes_sumar_clave(e, w, 0)
    sea r = 1
    mientras (r < 14) {
        aes_sustituir_desplazar(e, s, 0)
        aes_mezclar(e, 0)
        aes_sumar_clave(e, w, r)
        r = r + 1
    }
    aes_sustituir_desplazar(e, s, 0)
    aes_sumar_clave(e, w, 14)
    retornar 0
}

funcion aes_bloque_descifrar(e, w) {
    sea s = aes_tablas() + 256
    aes_sumar_clave(e, w, 14)
    sea r = 13
    mientras (r > 0) {
        aes_sustituir_desplazar(e, s, 1)
        aes_sumar_clave(e, w, r)
        aes_mezclar(e, 1)
        r = r - 1
    }
    aes_sustituir_desplazar(e, s, 1)
    aes_sumar_clave(e, w, 0)
    retornar 0
}

funcion aes_clave_de(clave) {
    sea k = hex_a_bytes(dyn_texto_de(cfv_sha256(dyn_texto(dyn_a_str(clave))), "aes"))
    retornar aes_expandir(str_datos(k))
}

funcion hex_de_memoria(r, p, n) {
    sea i = 0
    mientras (i < n) {
        sea b = __cargar8(p + i)
        str_agregar_byte(r, __o_bits(hex_digito(b / 16), 32))
        str_agregar_byte(r, __o_bits(hex_digito(b % 16), 32))
        i = i + 1
    }
    retornar 0
}

funcion aes_cifrar(clave, texto) {
    sea w = aes_clave_de(clave)
    sea m = dyn_a_str(texto)
    sea n = str_largo(m)
    sea relleno = 16 - n % 16
    sea total = n + relleno
    sea datos = mem_reservar(total)
    sea i = 0
    mientras (i < n) {
        __guardar8(datos + i, str_byte(m, i))
        i = i + 1
    }
    mientras (i < total) {
        __guardar8(datos + i, relleno)
        i = i + 1
    }
    sea iv = mem_reservar(16)
    si (sys_aleatorio(iv, 16) != 0) { dyn_error("aes_cifrar: el sistema no entregó bytes aleatorios") }
    sea previo = iv
    sea b = 0
    mientras (b < total) {
        sea j = 0
        mientras (j < 16) {
            __guardar8(datos + b + j, __xo_bits(__cargar8(datos + b + j), __cargar8(previo + j)))
            j = j + 1
        }
        aes_bloque_cifrar(datos + b, w)
        previo = datos + b
        b = b + 16
    }
    sea r = str_nuevo(33 + total * 2)
    hex_de_memoria(r, iv, 16)
    str_agregar_byte(r, 58)
    hex_de_memoria(r, datos, total)
    mem_liberar(datos)
    mem_liberar(iv)
    mem_liberar(w)
    retornar dyn_texto(r)
}

funcion aes_descifrar(clave, cifrado) {
    sea c = dyn_texto_de(cifrado, "aes_descifrar")
    si (str_largo(c) < 33 o str_byte(c, 32) != 58) { dyn_error("aes_descifrar: formato invalido (usar salida de aes_cifrar)") }
    sea iv = hex_a_bytes(str_rebanar(c, 0, 32))
    sea ct = hex_a_bytes(str_rebanar(c, 33, str_largo(c)))
    sea total = str_largo(ct)
    si (total == 0 o total % 16 != 0) { dyn_error("aes_descifrar: clave incorrecta o datos corruptos") }
    sea w = aes_clave_de(clave)
    sea datos = mem_reservar(total)
    sea i = 0
    mientras (i < total) {
        __guardar8(datos + i, str_byte(ct, i))
        i = i + 1
    }
    sea b = total - 16
    mientras (b >= 0) {
        aes_bloque_descifrar(datos + b, w)
        sea j = 0
        mientras (j < 16) {
            sea anterior = 0
            si (b == 0) { anterior = str_byte(iv, j) } sino { anterior = str_byte(ct, b - 16 + j) }
            __guardar8(datos + b + j, __xo_bits(__cargar8(datos + b + j), anterior))
            j = j + 1
        }
        b = b - 16
    }
    sea relleno = __cargar8(datos + total - 1)
    sea valido = relleno >= 1 y relleno <= 16
    i = 0
    mientras (valido y i < relleno) {
        si (__cargar8(datos + total - 1 - i) != relleno) { valido = 0 }
        i = i + 1
    }
    mem_liberar(w)
    si (valido == 0) {
        mem_liberar(datos)
        dyn_error("aes_descifrar: clave incorrecta o datos corruptos")
    }
    sea r = str_nuevo(total)
    i = 0
    mientras (i < total - relleno) {
        str_agregar_byte(r, __cargar8(datos + i))
        i = i + 1
    }
    mem_liberar(datos)
    retornar dyn_texto(r)
}

// ── Red: nombres, TCP y UDP (IPv4) ────────────────────────────────────────

// "a.b.c.d" → ip (entero de 32 bits) o -1.
funcion red_ip_de_texto(s) {
    sea ip = 0
    sea parte = 0
    sea digitos = 0
    sea puntos = 0
    sea i = 0
    mientras (i < str_largo(s)) {
        sea b = str_byte(s, i)
        si (b >= 48 y b <= 57) {
            parte = parte * 10 + b - 48
            digitos = digitos + 1
            si (parte > 255 o digitos > 3) { retornar 0 - 1 }
        } sino {
            si (b != 46 o digitos == 0) { retornar 0 - 1 }
            ip = ip * 256 + parte
            parte = 0
            digitos = 0
            puntos = puntos + 1
        }
        i = i + 1
    }
    si (puntos != 3 o digitos == 0) { retornar 0 - 1 }
    retornar ip * 256 + parte
}

funcion red_texto_de_ip(ip) {
    sea r = str_nuevo(16)
    sea k = 3
    mientras (k >= 0) {
        str_agregar(r, str_desde_entero(__y_bits(__desplazar_der(ip, k * 8), 255)))
        si (k > 0) { str_agregar_byte(r, 46) }
        k = k - 1
    }
    retornar r
}

// Contenido de un archivo, o 0 si no existe.
funcion red_leer_si_existe(ruta) {
    sea fd = sys_abrir(str_c(ruta), sys_abrir_lectura(), 0)
    si (fd < 0) { retornar 0 }
    sys_cerrar(fd)
    retornar archivo_leer(ruta)
}

// Siguiente palabra (separada por espacios o tabs) desde *pos; avanza pos.
funcion red_palabra(linea, pos) {
    sea i = __cargar64(pos)
    mientras (i < str_largo(linea) y (str_byte(linea, i) == 32 o str_byte(linea, i) == 9)) { i = i + 1 }
    sea inicio = i
    mientras (i < str_largo(linea) y str_byte(linea, i) != 32 y str_byte(linea, i) != 9) { i = i + 1 }
    __guardar64(pos, i)
    retornar str_rebanar(linea, inicio, i)
}

funcion red_igual_sin_mayusculas(a, b) {
    si (str_largo(a) != str_largo(b)) { retornar 0 }
    sea i = 0
    mientras (i < str_largo(a)) {
        sea x = str_byte(a, i)
        sea y = str_byte(b, i)
        si (x >= 65 y x <= 90) { x = x + 32 }
        si (y >= 65 y y <= 90) { y = y + 32 }
        si (x != y) { retornar 0 }
        i = i + 1
    }
    retornar 1
}

// Busca nombre en un archivo con el formato de /etc/hosts o resolv.conf:
// en hosts devuelve la ip de la línea que lo nombra; con nombre == 0
// devuelve la ip del primer "nameserver".
funcion red_buscar_en_archivo(ruta, nombre) {
    sea texto = red_leer_si_existe(ruta)
    si (texto == 0) { retornar 0 - 1 }
    sea pos = mem_reservar(8)
    sea inicio = 0
    sea i = 0
    sea resultado = 0 - 1
    mientras (i <= str_largo(texto) y resultado < 0) {
        si (i == str_largo(texto) o str_byte(texto, i) == 10) {
            sea linea = str_rebanar(texto, inicio, i)
            sea comentario = str_buscar(linea, "#", 0)
            si (comentario >= 0) { linea = str_rebanar(linea, 0, comentario) }
            __guardar64(pos, 0)
            sea primera = red_palabra(linea, pos)
            si (nombre == 0) {
                si (str_igual(primera, "nameserver")) { resultado = red_ip_de_texto(red_palabra(linea, pos)) }
            } sino {
                sea ip = red_ip_de_texto(primera)
                si (ip >= 0) {
                    sea otra = red_palabra(linea, pos)
                    mientras (str_largo(otra) > 0 y resultado < 0) {
                        si (red_igual_sin_mayusculas(otra, nombre)) { resultado = ip }
                        otra = red_palabra(linea, pos)
                    }
                }
            }
            inicio = i + 1
        }
        i = i + 1
    }
    mem_liberar(pos)
    retornar resultado
}

// Salta un nombre DNS (etiquetas o puntero comprimido) desde p.
funcion red_dns_saltar_nombre(m, p) {
    mientras (p < str_largo(m)) {
        sea n = str_byte(m, p)
        si (n == 0) { retornar p + 1 }
        si (n >= 192) { retornar p + 2 }
        p = p + 1 + n
    }
    retornar p
}

// Consulta A al servidor DNS (UDP 53). Devuelve la ip o -1.
funcion red_dns_consultar(nombre, servidor) {
    sea q = str_nuevo(32 + str_largo(nombre))
    sea id_buf = mem_reservar(8)
    sys_aleatorio(id_buf, 2)
    sea id = __y_bits(__cargar64(id_buf), 65535)
    mem_liberar(id_buf)
    str_agregar_byte(q, __desplazar_der(id, 8))
    str_agregar_byte(q, __y_bits(id, 255))
    str_agregar_byte(q, 1)                                     // RD
    str_agregar_byte(q, 0)
    str_agregar_byte(q, 0)
    str_agregar_byte(q, 1)                                     // QDCOUNT = 1
    sea k = 0
    mientras (k < 6) {
        str_agregar_byte(q, 0)
        k = k + 1
    }
    sea inicio = 0
    sea i = 0
    mientras (i <= str_largo(nombre)) {
        si (i == str_largo(nombre) o str_byte(nombre, i) == 46) {
            si (i > inicio) {
                str_agregar_byte(q, i - inicio)
                str_agregar(q, str_rebanar(nombre, inicio, i))
            }
            inicio = i + 1
        }
        i = i + 1
    }
    str_agregar_byte(q, 0)
    str_agregar_byte(q, 0)
    str_agregar_byte(q, 1)                                     // QTYPE A
    str_agregar_byte(q, 0)
    str_agregar_byte(q, 1)                                     // QCLASS IN
    sea fd = sys_udp_crear(0)
    si (fd < 0) { retornar 0 - 1 }
    sys_red_espera(fd, 2500)
    sea buf = mem_reservar(1500)
    sea dir = mem_reservar(16)
    sea resultado = 0 - 1
    sea intento = 0
    mientras (intento < 2 y resultado < 0) {
        sys_udp_enviar(fd, servidor, 53, str_datos(q), str_largo(q))
        sea n = sys_udp_recibir(fd, buf, 1500, dir, 1)
        si (n >= 12 y __cargar8(buf) * 256 + __cargar8(buf + 1) == id) {
            sea m = str_nuevo(n)
            sea j = 0
            mientras (j < n) {
                str_agregar_byte(m, __cargar8(buf + j))
                j = j + 1
            }
            sea respuestas = str_byte(m, 6) * 256 + str_byte(m, 7)
            sea p = red_dns_saltar_nombre(m, 12) + 4
            sea r = 0
            mientras (r < respuestas y resultado < 0 y p + 10 <= n) {
                p = red_dns_saltar_nombre(m, p)
                sea tipo = str_byte(m, p) * 256 + str_byte(m, p + 1)
                sea largo = str_byte(m, p + 8) * 256 + str_byte(m, p + 9)
                p = p + 10
                si (tipo == 1 y largo == 4 y p + 4 <= n) {
                    resultado = str_byte(m, p) * 16777216 + str_byte(m, p + 1) * 65536 + str_byte(m, p + 2) * 256 + str_byte(m, p + 3)
                }
                p = p + largo
                r = r + 1
            }
            intento = 2
        }
        intento = intento + 1
    }
    mem_liberar(dir)
    mem_liberar(buf)
    sys_red_cerrar(fd)
    retornar resultado
}

// Nombre de máquina → ip: dirección literal, localhost, el resolvedor del
// sistema (macOS, Windows) o /etc/hosts y DNS propio (Linux). -1 si falla.
funcion red_resolver_crudo(nombre) {
    sea ip = red_ip_de_texto(nombre)
    si (ip >= 0) { retornar ip }
    si (red_igual_sin_mayusculas(nombre, "localhost")) { retornar 2130706433 }
    ip = sys_resolver(str_c(nombre))
    si (ip != 0) { retornar ip }
    ip = red_buscar_en_archivo("/etc/hosts", nombre)
    si (ip >= 0) { retornar ip }
    sea servidor = red_buscar_en_archivo("/etc/resolv.conf", 0)
    si (servidor < 0) { servidor = 16843009 }                  // 1.1.1.1
    retornar red_dns_consultar(nombre, servidor)
}

funcion red_resolver(nombre) {
    sea ip = red_resolver_crudo(dyn_texto_de(nombre, "red_resolver"))
    si (ip < 0) { retornar 0 }
    retornar dyn_texto(red_texto_de_ip(ip))
}

// ── TCP ──

funcion net_conectar(host, puerto) {
    sea nombre = dyn_texto_de(host, "net_conectar")
    sea ip = red_resolver_crudo(nombre)
    si (ip < 0) { dyn_error(str_concatenar("net_conectar: no se pudo resolver ", nombre)) }
    sea fd = sys_red_conectar(ip, dyn_valor_entero(puerto))
    si (fd < 0) { dyn_error(str_concatenar("net_conectar: no se pudo conectar a ", nombre)) }
    sys_red_espera(fd, 15000)
    retornar dyn_entero(fd)
}

funcion net_espera(sock, ms) {
    sys_red_espera(dyn_valor_entero(sock), dyn_valor_entero(ms))
    retornar 0
}

funcion net_enviar(sock, datos) {
    sea fd = dyn_valor_entero(sock)
    sea s = dyn_a_str(datos)
    sea hecho = 0
    mientras (hecho < str_largo(s)) {
        sea n = sys_red_escribir(fd, str_datos(s) + hecho, str_largo(s) - hecho)
        si (n <= 0) { dyn_error("net_enviar: la conexión se cerró") }
        hecho = hecho + n
    }
    retornar dyn_entero(hecho)
}

// Lee hasta max bytes (por defecto 65536). "" si la conexión terminó o se
// agotó la espera.
funcion net_recibir(sock, max) {
    sea limite = 65536
    si (max != 0) { limite = dyn_valor_entero(max) }
    sea r = str_nuevo(limite)
    sea n = sys_red_leer(dyn_valor_entero(sock), str_datos(r), limite)
    si (n > 0) { __guardar64(r, n) }
    retornar dyn_texto(r)
}

// Todo lo que llegue hasta que la otra parte cierre.
funcion net_recibir_todo(sock) {
    sea fd = dyn_valor_entero(sock)
    sea r = str_nuevo(4096)
    sea seguir = 1
    mientras (seguir) {
        str_asegurar(r, str_largo(r) + 65536)
        sea n = sys_red_leer(fd, str_datos(r) + str_largo(r), 65536)
        si (n <= 0) { seguir = 0 } sino { __guardar64(r, str_largo(r) + n) }
    }
    retornar dyn_texto(r)
}

// Envía y devuelve la respuesta: espera el primer bloque y sigue leyendo
// mientras lleguen datos (pausa de 100 ms).
funcion net_enviar_recibir(sock, datos) {
    sea fd = dyn_valor_entero(sock)
    net_enviar(sock, datos)
    sea r = str_nuevo(4096)
    sea seguir = 1
    sea primero = 1
    mientras (seguir) {
        str_asegurar(r, str_largo(r) + 65536)
        sea n = sys_red_leer(fd, str_datos(r) + str_largo(r), 65536)
        si (n <= 0) {
            seguir = 0
        } sino {
            __guardar64(r, str_largo(r) + n)
            si (primero) {
                sys_red_espera(fd, 100)
                primero = 0
            }
        }
    }
    sys_red_espera(fd, 15000)
    retornar dyn_texto(r)
}

funcion net_cerrar(sock) {
    sys_red_cerrar(dyn_valor_entero(sock))
    retornar 0
}

// ── UDP ──

funcion udp_crear(puerto) {
    sea p = 0
    si (puerto != 0) { p = dyn_valor_entero(puerto) }
    sea fd = sys_udp_crear(p)
    si (fd < 0) { dyn_error(str_concatenar("udp_crear: no se pudo abrir el puerto ", str_desde_entero(p))) }
    retornar dyn_entero(fd)
}

funcion udp_enviar(sock, host, puerto, datos) {
    sea nombre = dyn_texto_de(host, "udp_enviar")
    sea ip = red_resolver_crudo(nombre)
    si (ip < 0) { dyn_error(str_concatenar("udp_enviar: dirección inválida ", nombre)) }
    sea s = dyn_a_str(datos)
    sys_udp_enviar(dyn_valor_entero(sock), ip, dyn_valor_entero(puerto), str_datos(s), str_largo(s))
    retornar 0
}

// {"datos", "origen", "puerto"} o nulo si no hay datagramas (no bloquea).
funcion udp_recibir(sock) {
    sea buf = mem_reservar(65536)
    sea dir = mem_reservar(16)
    sea n = sys_udp_recibir(dyn_valor_entero(sock), buf, 65536, dir, 0)
    si (n <= 0) {
        mem_liberar(buf)
        mem_liberar(dir)
        retornar 0
    }
    sea datos = str_nuevo(n)
    sea i = 0
    mientras (i < n) {
        str_agregar_byte(datos, __cargar8(buf + i))
        i = i + 1
    }
    sea ip = __cargar8(dir + 4) * 16777216 + __cargar8(dir + 5) * 65536 + __cargar8(dir + 6) * 256 + __cargar8(dir + 7)
    sea m = map_nuevo()
    map_fijar(m, "datos", dyn_texto(datos))
    map_fijar(m, "origen", dyn_texto(red_texto_de_ip(ip)))
    map_fijar(m, "puerto", dyn_entero(__cargar8(dir + 2) * 256 + __cargar8(dir + 3)))
    mem_liberar(buf)
    mem_liberar(dir)
    retornar dyn_caja(3, m)
}

funcion udp_cerrar(sock) {
    sys_red_cerrar(dyn_valor_entero(sock))
    retornar 0
}

// ── TLS (HTTPS) con la biblioteca del sistema ─────────────────────────────
// Linux y macOS: OpenSSL 3 (o 1.1) cargado en tiempo de ejecución, con
// verificación de certificados contra el almacén del sistema y SNI.
// Windows: Schannel (SSPI). El estado de una conexión es un bloque de
// 64 bytes: [ssl][ctx][fd][tipo][...].

funcion tls_i32(x) {
    sea v = __y_bits(x, 4294967295)
    si (v >= 2147483648) { retornar v - 4294967296 }
    retornar v
}

// Handle de libssl (global 16), o 0 si no está disponible.
funcion tls_libssl() {
    sea h = mem_global(16)
    si (h != 0) { retornar h }
    si (sys_dl_disponible() == 0) { retornar 0 }
    sea candidatos = vec_nuevo()
    si (__plataforma() == 2 o __plataforma() == 3) {
        vec_agregar(candidatos, "/opt/homebrew/opt/openssl@3/lib/libssl.3.dylib")
        vec_agregar(candidatos, "/usr/local/opt/openssl@3/lib/libssl.3.dylib")
        vec_agregar(candidatos, "/opt/homebrew/lib/libssl.3.dylib")
        vec_agregar(candidatos, "/usr/local/lib/libssl.3.dylib")
    } sino {
        vec_agregar(candidatos, "libssl.so.3")
        vec_agregar(candidatos, "libssl.so.1.1")
    }
    sea i = 0
    mientras (i < vec_largo(candidatos) y h == 0) {
        h = dyn_abrir_biblioteca(vec_obtener(candidatos, i))
        i = i + 1
    }
    si (h != 0) {
        mem_fijar_global(16, h)
        __ccall(sys_simbolo(h, "OPENSSL_init_ssl"), 0, 0)
    }
    retornar h
}

funcion tls_f(nombre) {
    sea p = sys_simbolo(tls_libssl(), nombre)
    si (p == 0) { dyn_error(str_concatenar("tls: falta el símbolo de OpenSSL ", nombre)) }
    retornar p
}

funcion tls_error(estado, mensaje) {
    sys_red_cerrar(__cargar64(estado + 16))
    dyn_error(mensaje)
    retornar 0
}

funcion tls_abrir(sock, anfitrion) {
    sea fd = dyn_valor_entero(sock)
    sea host = dyn_texto_de(anfitrion, "tls_abrir")
    sea estado = mem_reservar(64)
    mem_llenar(estado, 0, 64)
    __guardar64(estado + 16, fd)
    si (sys_es_windows()) { retornar tls_abrir_schannel(estado, host) }
    si (tls_libssl() == 0) {
        si (sys_dl_disponible() == 0) { tls_error(estado, "https: agrega importar \"tls\" (o \"red\") al programa para usar TLS") }
        tls_error(estado, "https: no se encontró OpenSSL (libssl 3 o 1.1); en macOS: brew install openssl@3")
    }
    sea ctx = __ccall(tls_f("SSL_CTX_new"), __ccall(tls_f("TLS_client_method")))
    si (ctx == 0) { tls_error(estado, "tls: SSL_CTX_new falló") }
    __ccall(tls_f("SSL_CTX_set_default_verify_paths"), ctx)
    __ccall(tls_f("SSL_CTX_set_verify"), ctx, 1, 0)             // SSL_VERIFY_PEER
    // TLS 1.2 como mínimo (SSL_CTRL_SET_MIN_PROTO_VERSION) y, en 1.2, solo
    // suites AEAD con ECDHE (TLS 1.3 ya es AEAD siempre).
    __ccall(tls_f("SSL_CTX_ctrl"), ctx, 123, 771, 0)
    __ccall(tls_f("SSL_CTX_set_cipher_list"), ctx, str_c("ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305"))
    sea ssl = __ccall(tls_f("SSL_new"), ctx)
    __guardar64(estado, ssl)
    __guardar64(estado + 8, ctx)
    __guardar64(estado + 24, 1)
    __ccall(tls_f("SSL_set_fd"), ssl, fd)
    sea host_c = str_c(host)
    __ccall(tls_f("SSL_ctrl"), ssl, 55, 0, host_c)              // SNI
    __ccall(tls_f("SSL_set1_host"), ssl, host_c)                // nombre del certificado
    si (tls_i32(__ccall(tls_f("SSL_connect"), ssl)) != 1) {
        sea v = __ccall(tls_f("SSL_get_verify_result"), ssl)
        __ccall(tls_f("SSL_free"), ssl)
        __ccall(tls_f("SSL_CTX_free"), ctx)
        si (v != 0) { tls_error(estado, str_concatenar(str_concatenar("tls: certificado no válido para ", host), str_concatenar(" (código ", str_concatenar(str_desde_entero(v), ")")))) }
        tls_error(estado, str_concatenar("tls: no se pudo establecer la sesión con ", host))
    }
    retornar dyn_caja(11, estado)
}

funcion tls_enviar(t, datos) {
    sea estado = dyn_entero_c(t)
    si (__cargar64(estado + 24) == 2) { retornar tls_enviar_schannel(estado, datos) }
    sea s = dyn_a_str(datos)
    sea hecho = 0
    mientras (hecho < str_largo(s)) {
        sea n = tls_i32(__ccall(tls_f("SSL_write"), __cargar64(estado), str_datos(s) + hecho, str_largo(s) - hecho))
        si (n <= 0) { dyn_error("tls: la conexión se cerró al enviar") }
        hecho = hecho + n
    }
    retornar dyn_entero(hecho)
}

funcion tls_recibir_todo(t) {
    sea estado = dyn_entero_c(t)
    si (__cargar64(estado + 24) == 2) { retornar tls_recibir_todo_schannel(estado) }
    sea r = str_nuevo(4096)
    sea leer = tls_f("SSL_read")
    sea seguir = 1
    mientras (seguir) {
        str_asegurar(r, str_largo(r) + 16384)
        sea n = tls_i32(__ccall(leer, __cargar64(estado), str_datos(r) + str_largo(r), 16384))
        si (n <= 0) { seguir = 0 } sino { __guardar64(r, str_largo(r) + n) }
    }
    retornar dyn_texto(r)
}

funcion tls_cerrar(t) {
    sea estado = dyn_entero_c(t)
    si (__cargar64(estado + 24) == 2) { retornar tls_cerrar_schannel(estado) }
    si (__cargar64(estado) != 0) {
        __ccall(tls_f("SSL_shutdown"), __cargar64(estado))
        __ccall(tls_f("SSL_free"), __cargar64(estado))
        __ccall(tls_f("SSL_CTX_free"), __cargar64(estado + 8))
    }
    sys_red_cerrar(__cargar64(estado + 16))
    mem_liberar(estado)
    retornar 0
}

// Versión negociada ("TLSv1.3", "TLSv1.2"…).
funcion tls_version(t) {
    sea estado = dyn_entero_c(t)
    si (__cargar64(estado + 24) == 2) { retornar dyn_texto(sys_tls_version(estado)) }
    si (__cargar64(estado) == 0) { retornar dyn_texto("desconocida") }
    retornar dyn_texto(str_desde_c(__ccall(tls_f("SSL_get_version"), __cargar64(estado))))
}

// Schannel (Windows): el trabajo está en sys_windows_ext.cfv.
funcion tls_abrir_schannel(estado, host) {
    __guardar64(estado + 24, 2)
    sea r = sys_tls_abrir(estado, host)
    si (r != 0) {
        sea m = str_concatenar("tls: no se pudo establecer la sesión con ", host)
        str_agregar(m, " (SSPI 0x")
        sea k = 7
        mientras (k >= 0) {
            str_agregar_byte(m, __o_bits(hex_digito(__y_bits(__desplazar_der(r, k * 4), 15)), 32))
            k = k - 1
        }
        str_agregar(m, ")")
        tls_error(estado, m)
    }
    retornar dyn_caja(11, estado)
}

funcion tls_enviar_schannel(estado, datos) {
    sea s = dyn_a_str(datos)
    si (sys_tls_enviar(estado, str_datos(s), str_largo(s)) != 0) { dyn_error("tls: la conexión se cerró al enviar") }
    retornar dyn_entero(str_largo(s))
}

funcion tls_recibir_todo_schannel(estado) { retornar dyn_texto(sys_tls_recibir_todo(estado)) }

funcion tls_cerrar_schannel(estado) {
    sys_tls_cerrar(estado)
    sys_red_cerrar(__cargar64(estado + 16))
    mem_liberar(estado)
    retornar 0
}

// cforge repl: omitir las primeras n líneas de mostrar y anotar cuántas
// se mostraron en el archivo de conteo.
funcion repl_preparar(omitir, archivo_conteo) {
    sea r = mem_reservar(24)
    __guardar64(r, dyn_valor_entero(omitir))
    __guardar64(r + 8, 0)
    __guardar64(r + 16, dyn_texto_de(archivo_conteo, "repl_preparar"))
    archivo_escribir(__cargar64(r + 16), "0")
    mem_fijar_global(17, r)
    retornar 0
}

// Estado de la memoria: bytes en uso, recolecciones, bytes liberados por el
// recolector y bytes de arena usados.
funcion memoria_estadisticas() {
    sea m = map_nuevo()
    map_fijar(m, "en_uso", dyn_entero(mem_global(14)))
    sea gc = mem_global(18)
    sea recolecciones = 0
    sea liberados = 0
    sea arena = 0
    si (gc != 0) {
        recolecciones = __cargar64(gc + 64)
        liberados = __cargar64(gc + 72)
        sea n = __cargar64(gc)
        sea i = 0
        mientras (i < n) {
            sea r = gc + 128 + i * 32
            sea fin = __cargar64(r + 8)
            si (i == n - 1) { fin = mem_global(0) }
            arena = arena + fin - __cargar64(r)
            i = i + 1
        }
    }
    map_fijar(m, "recolecciones", dyn_entero(recolecciones))
    map_fijar(m, "liberados", dyn_entero(liberados))
    map_fijar(m, "arena", dyn_entero(arena))
    map_fijar(m, "recolector", dyn_bool(gc != 0))
    retornar dyn_caja(3, m)
}

// Un byte como texto de un carácter (sin codificar UTF-8).
funcion char_de(n) {
    sea r = str_nuevo(1)
    str_agregar_byte(r, __y_bits(dyn_valor_entero(n), 255))
    retornar dyn_texto(r)
}
// Segundos desde la época (Unix) con decimales.
funcion tiempo_actual() { retornar dyn_desde_f64(__f64_div(__f64_desde_entero(sys_reloj_ns()), __f64_desde_entero(1000000000))) }

funcion hilo_dormir(ms) {
    sys_dormir_ms(dyn_valor_entero(ms))
    retornar 0
}

funcion dormir(ms) { retornar hilo_dormir(ms) }

// ── Hilos, canales y mutex (clone + futex) ────────────────────────────────

funcion futex_esperar(direccion, valor, ms) { retornar futex_esperar_op(direccion, valor, ms, 128) }

// op 128: FUTEX_WAIT_PRIVATE · op 0: FUTEX_WAIT (el kernel despierta el tid
// de CLONE_CHILD_CLEARTID con un FUTEX_WAKE compartido).
funcion futex_esperar_op(direccion, valor, ms, op) {
    sys_futex_esperar(direccion, valor, ms, op)
    retornar 0
}

funcion futex_despertar(direccion) {
    sys_futex_despertar(direccion)
    retornar 0
}

funcion cerrojo_tomar(direccion) {
    mientras (__intercambiar(direccion, 1) != 0) { futex_esperar(direccion, 1, 0 - 1) }
    retornar 0
}

funcion cerrojo_soltar(direccion) {
    __guardar64(direccion, 0)
    futex_despertar(direccion)
    retornar 0
}

// Hilo nuevo con pila propia de 8 MiB alineada; su registro (en la base de
// la pila): [hilo vivo][manejadores de intentar][tid].
// La función de entrada es tarea_ejecutar(t) (runtime/lenguaje.cfv).
funcion dyn_hilo_lanzar(t) {
    sea tam = 8388608
    sea zona = sys_mapear(tam * 2)
    si (zona < 0) { dyn_error("no se pudo reservar la pila del hilo") }
    sea base = __y_bits(zona + tam - 1, 0 - tam)
    __guardar64(base, 1)
    __guardar64(base + 8, 0)
    __guardar64(base + 16, 1)
    dyn_anotar_hilo(base)
    si (sys_hilo_crear(base, tam, t) < 0) { dyn_error("no se pudo crear el hilo") }
    retornar dyn_entero(base)
}

funcion dyn_hilo_inicio(t) {
    tarea_ejecutar(t)
    retornar 0
}

// Espera a que el hilo termine (CLONE_CHILD_CLEARTID pone el tid en 0).
// Devuelve verdadero si terminó, falso si venció el plazo (ms, o nulo).
funcion dyn_hilo_esperar(base_v, limite) {
    sea base = dyn_valor_entero(base_v)
    sea ms = 0 - 1
    si (__y_bits(limite, 1) == 1) { ms = dyn_valor_entero(limite) }
    sea inicio = sys_reloj_ns() / 1000000
    mientras (__y_bits(__cargar64(base + 16), 4294967295) != 0) {
        si (ms >= 0) {
            sea resta = ms - (sys_reloj_ns() / 1000000 - inicio)
            si (resta <= 0) { retornar 2 }
            futex_esperar_op(base + 16, __cargar64(base + 16), resta, 0)
        } sino {
            futex_esperar_op(base + 16, __cargar64(base + 16), 0 - 1, 0)
        }
    }
    retornar 4
}

// Canal: [cerrojo][secuencia][cola][inicio][capacidad][cerrado]
funcion canal_nuevo(capacidad) {
    sea r = mem_reservar(48)
    __guardar64(r, 0)
    __guardar64(r + 8, 0)
    __guardar64(r + 16, vec_nuevo())
    __guardar64(r + 24, 0)
    sea cap = 0
    si (__y_bits(capacidad, 1) == 1) { cap = dyn_valor_entero(capacidad) }
    __guardar64(r + 32, cap)
    __guardar64(r + 40, 0)
    retornar dyn_caja(9, r)
}

funcion canal_de(v) {
    si (dyn_tipo(v) != 9) { dyn_error_tipo("se esperaba un canal", v) }
    retornar dyn_dato(v)
}

funcion canal_tam_crudo(r) { retornar vec_largo(__cargar64(r + 16)) - __cargar64(r + 24) }

funcion canal_avisar(r) {
    __guardar64(r + 8, __cargar64(r + 8) + 1)
    cerrojo_soltar(r)
    futex_despertar(r + 8)
    retornar 0
}

funcion canal_enviar(canal, v) {
    sea r = canal_de(canal)
    mientras (verdadero) {
        cerrojo_tomar(r)
        si (__cargar64(r + 40)) {
            cerrojo_soltar(r)
            dyn_error("canal_enviar: el canal está cerrado")
        }
        si (__cargar64(r + 32) == 0 o canal_tam_crudo(r) < __cargar64(r + 32)) {
            vec_agregar(__cargar64(r + 16), v)
            canal_avisar(r)
            retornar 0
        }
        sea secuencia = __cargar64(r + 8)
        cerrojo_soltar(r)
        futex_esperar(r + 8, secuencia, 0 - 1)
    }
    retornar 0
}

// Bloquea hasta recibir un valor; nulo si el canal está cerrado y vacío.
funcion canal_recibir(canal) {
    sea r = canal_de(canal)
    mientras (verdadero) {
        cerrojo_tomar(r)
        si (canal_tam_crudo(r) > 0) {
            sea cola = __cargar64(r + 16)
            sea inicio = __cargar64(r + 24)
            sea v = vec_obtener(cola, inicio)
            inicio = inicio + 1
            si (inicio == vec_largo(cola)) {
                __guardar64(cola, 0)
                inicio = 0
            }
            __guardar64(r + 24, inicio)
            canal_avisar(r)
            retornar v
        }
        si (__cargar64(r + 40)) {
            cerrojo_soltar(r)
            retornar 0
        }
        sea secuencia = __cargar64(r + 8)
        cerrojo_soltar(r)
        futex_esperar(r + 8, secuencia, 0 - 1)
    }
    retornar 0
}

funcion canal_tam(canal) {
    sea r = canal_de(canal)
    cerrojo_tomar(r)
    sea n = canal_tam_crudo(r)
    cerrojo_soltar(r)
    retornar dyn_entero(n)
}

funcion canal_cerrar(canal) {
    sea r = canal_de(canal)
    cerrojo_tomar(r)
    __guardar64(r + 40, 1)
    canal_avisar(r)
    retornar 0
}

// Mutex: [estado] con futex.
funcion mutex_crear() {
    sea r = mem_reservar(8)
    __guardar64(r, 0)
    retornar dyn_caja(10, r)
}

funcion mutex_de(v) {
    si (dyn_tipo(v) != 10) { dyn_error_tipo("se esperaba un mutex", v) }
    retornar dyn_dato(v)
}

funcion mutex_bloquear(m) { cerrojo_tomar(mutex_de(m)) retornar 0 }
funcion mutex_desbloquear(m) { cerrojo_soltar(mutex_de(m)) retornar 0 }
funcion mutex_liberar(m) { retornar mutex_desbloquear(m) }

// ── Servidor HTTP (socket, bind, listen, accept) ──────────────────────────
// Servidores en la global 32: [descriptor del socket][cliente activo].

funcion http_servidores() {
    sea v = mem_global(32)
    si (v == 0) {
        v = vec_nuevo()
        mem_fijar_global(32, v)
    }
    retornar v
}

funcion http_servidor(id) {
    sea v = http_servidores()
    sea i = dyn_valor_entero(id)
    si (__y_bits(id, 1) != 1 o i < 0 o i >= vec_largo(v)) { dyn_error("servidor http: id inválido") }
    retornar vec_obtener(v, i)
}

funcion servidor_http_escuchar(puerto) {
    sea p = dyn_valor_entero(puerto)
    si (p < 1 o p > 65535) { dyn_error("servidor_http_escuchar: puerto invalido") }
    sea fd = sys_red_escuchar(p)
    si (fd == 0 - 1) { dyn_error("servidor_http_escuchar: no se pudo crear socket") }
    si (fd == 0 - 2) { dyn_error(str_concatenar("servidor_http_escuchar: no se pudo enlazar al puerto ", str_desde_entero(p))) }
    si (fd < 0) { dyn_error("servidor_http_escuchar: no se pudo escuchar") }
    // [socket][cliente][máx. cabeceras][máx. cuerpo][ms por lectura][ms cabeceras]
    sea r = mem_reservar(48)
    __guardar64(r, fd)
    __guardar64(r + 8, 0 - 1)
    __guardar64(r + 16, 8192)
    __guardar64(r + 24, 16777216)
    __guardar64(r + 32, 10000)
    __guardar64(r + 40, 5000)
    sea v = http_servidores()
    vec_agregar(v, r)
    retornar dyn_entero(vec_largo(v) - 1)
}

funcion http_linea_hasta(s, desde, aguja) {
    sea p = str_buscar(s, aguja, desde)
    si (p < 0) { retornar str_largo(s) }
    retornar p
}

funcion http_minusculas(s) {
    sea r = str_nuevo(str_largo(s))
    sea i = 0
    mientras (i < str_largo(s)) {
        sea b = str_byte(s, i)
        si (b >= 65 y b <= 90) { b = b + 32 }
        str_agregar_byte(r, b)
        i = i + 1
    }
    retornar r
}

// Límites del servidor: bytes de cabeceras, bytes de cuerpo, ms de espera
// por lectura y ms para recibir todas las cabeceras (anti Slowloris).
funcion servidor_http_limites(id, cabeceras, cuerpo, ms_lectura, ms_cabeceras) {
    sea srv = http_servidor(id)
    si (cabeceras != 0) { __guardar64(srv + 16, dyn_valor_entero(cabeceras)) }
    si (cuerpo != 0) { __guardar64(srv + 24, dyn_valor_entero(cuerpo)) }
    si (ms_lectura != 0) { __guardar64(srv + 32, dyn_valor_entero(ms_lectura)) }
    si (ms_cabeceras != 0) { __guardar64(srv + 40, dyn_valor_entero(ms_cabeceras)) }
    retornar 0
}

funcion http_rechazar(cliente, estado) {
    sea r = str_concatenar("HTTP/1.1 ", estado)
    str_agregar(r, "\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
    sys_red_escribir(cliente, str_datos(r), str_largo(r))
    sys_red_cerrar(cliente)
    retornar 0
}

// Valida las cabeceras (en minúsculas) de una solicitud. Devuelve el largo
// del cuerpo, o un código negativo: -400 solicitud ambigua o inválida
// (Content-Length y Transfer-Encoding a la vez, Content-Length repetido o no
// numérico), -501 Transfer-Encoding no soportado, -413 cuerpo demasiado
// grande.
funcion http_largo_cuerpo(cabeceras, maximo) {
    sea largo = 0
    sea vistos = 0
    sea te = 0
    sea pos = 0
    mientras (pos < str_largo(cabeceras)) {
        sea nl = http_linea_hasta(cabeceras, pos, "\r\n")
        sea l = str_rebanar(cabeceras, pos, nl)
        si (str_largo(l) > 0 y (str_byte(l, 0) == 32 o str_byte(l, 0) == 9)) { retornar 0 - 400 }     // obs-fold
        sea dp = str_buscar(l, ":", 0)
        si (dp > 0) {
            sea nombre = str_rebanar(l, 0, dp)
            si (str_byte(nombre, str_largo(nombre) - 1) == 32 o str_byte(nombre, str_largo(nombre) - 1) == 9) { retornar 0 - 400 }
            sea v = dp + 1
            mientras (v < str_largo(l) y (str_byte(l, v) == 32 o str_byte(l, v) == 9)) { v = v + 1 }
            sea f = str_largo(l)
            mientras (f > v y (str_byte(l, f - 1) == 32 o str_byte(l, f - 1) == 9)) { f = f - 1 }
            si (str_igual(nombre, "transfer-encoding")) { te = 1 }
            si (str_igual(nombre, "content-length")) {
                si (f == v o f - v > 15) { retornar 0 - 400 }
                sea n = 0
                sea k = v
                mientras (k < f) {
                    sea c = str_byte(l, k)
                    si (c < 48 o c > 57) { retornar 0 - 400 }
                    n = n * 10 + c - 48
                    k = k + 1
                }
                si (vistos == 1 y n != largo) { retornar 0 - 400 }
                largo = n
                vistos = 1
            }
        }
        pos = nl + 2
    }
    si (te == 1 y vistos == 1) { retornar 0 - 400 }
    si (te == 1) { retornar 0 - 501 }
    si (largo > maximo) { retornar 0 - 413 }
    retornar largo
}

// Espera una petición y la devuelve como mapa: metodo, ruta, query,
// cuerpo, cabeceras (en minúsculas), ip y _srv_id. Las solicitudes
// inválidas, demasiado grandes o lentas se responden con 400/408/413/431/501
// y se sigue esperando la siguiente.
funcion servidor_http_solicitud(id) {
    sea r = 0
    mientras (r == 0) { r = servidor_http_intentar(id) }
    retornar r
}

funcion servidor_http_intentar(id) {
    sea srv = http_servidor(id)
    si (__cargar64(srv + 8) >= 0) {
        sys_red_cerrar(__cargar64(srv + 8))
        __guardar64(srv + 8, 0 - 1)
    }
    sea dir = mem_reservar(16)
    sea largo_dir = mem_reservar(8)
    __guardar64(largo_dir, 16)
    sea cliente = sys_red_aceptar(__cargar64(srv), dir, largo_dir)
    si (cliente < 0) { dyn_error("servidor_http_solicitud: accept fallo") }
    sea ip = str_nuevo(16)
    sea k = 0
    mientras (k < 4) {
        si (k > 0) { str_agregar_byte(ip, 46) }
        str_agregar(ip, str_desde_entero(__cargar8(dir + 4 + k)))
        k = k + 1
    }
    mem_liberar(dir)
    mem_liberar(largo_dir)
    sea max_cab = __cargar64(srv + 16)
    sea max_cuerpo = __cargar64(srv + 24)
    sys_red_espera(cliente, __cargar64(srv + 32))
    sea limite_cab = sys_reloj_ns() / 1000000 + __cargar64(srv + 40)
    // Leer cabeceras y luego el cuerpo según Content-Length.
    sea crudo = str_nuevo(4096)
    sea buf = mem_reservar(4096)
    sea fin_cabeceras = 0 - 1
    sea esperado = 0 - 1
    sea seguir = 1
    sea rechazo = 0
    mientras (seguir) {
        sea pedir = 4096
        si (fin_cabeceras >= 0 y esperado - (str_largo(crudo) - fin_cabeceras - 4) < pedir) { pedir = esperado - (str_largo(crudo) - fin_cabeceras - 4) }
        sea n = 0
        si (pedir > 0) { n = sys_red_leer(cliente, buf, pedir) }
        si (n <= 0) {
            seguir = 0
            si (fin_cabeceras < 0) {
                si (str_largo(crudo) > 0) { rechazo = 408 } sino { rechazo = 1 }
            }
        } sino {
            sea i = 0
            mientras (i < n) {
                str_agregar_byte(crudo, __cargar8(buf + i))
                i = i + 1
            }
            si (fin_cabeceras < 0) {
                fin_cabeceras = str_buscar(crudo, "\r\n\r\n", 0)
                si (fin_cabeceras < 0) {
                    si (str_largo(crudo) > max_cab) { rechazo = 431 }
                    si (sys_reloj_ns() / 1000000 > limite_cab) { rechazo = 408 }
                } sino {
                    si (fin_cabeceras > max_cab) { rechazo = 431 } sino {
                        esperado = http_largo_cuerpo(http_minusculas(str_rebanar(crudo, 0, fin_cabeceras)), max_cuerpo)
                        si (esperado < 0) { rechazo = 0 - esperado }
                    }
                }
                si (rechazo != 0) { seguir = 0 }
            }
            si (seguir y fin_cabeceras >= 0 y str_largo(crudo) - fin_cabeceras - 4 >= esperado) { seguir = 0 }
        }
    }
    si (rechazo != 0) {
        mem_liberar(buf)
        si (rechazo == 1) { sys_red_cerrar(cliente) }
        si (rechazo == 400) { http_rechazar(cliente, "400 Bad Request") }
        si (rechazo == 408) { http_rechazar(cliente, "408 Request Timeout") }
        si (rechazo == 413) { http_rechazar(cliente, "413 Content Too Large") }
        si (rechazo == 431) { http_rechazar(cliente, "431 Request Header Fields Too Large") }
        si (rechazo == 501) { http_rechazar(cliente, "501 Not Implemented") }
        retornar 0
    }
    // Cuerpo incompleto (la conexión se cortó o expiró): no se entrega.
    si (fin_cabeceras >= 0 y str_largo(crudo) - fin_cabeceras - 4 < esperado) {
        mem_liberar(buf)
        http_rechazar(cliente, "400 Bad Request")
        retornar 0
    }
    __guardar64(srv + 8, cliente)
    mem_liberar(buf)
    si (fin_cabeceras < 0) { fin_cabeceras = str_largo(crudo) }
    // Línea de petición: MÉTODO RUTA PROTOCOLO
    sea fin_linea = http_linea_hasta(crudo, 0, "\r\n")
    sea linea = str_rebanar(crudo, 0, fin_linea)
    sea e1 = str_buscar(linea, " ", 0)
    sea metodo = "GET"
    sea ruta = "/"
    si (e1 > 0) {
        metodo = str_rebanar(linea, 0, e1)
        sea e2 = str_buscar(linea, " ", e1 + 1)
        si (e2 < 0) { e2 = str_largo(linea) }
        ruta = str_rebanar(linea, e1 + 1, e2)
    }
    sea consulta = ""
    sea q = str_buscar(ruta, "?", 0)
    si (q >= 0) {
        consulta = str_rebanar(ruta, q + 1, str_largo(ruta))
        ruta = str_rebanar(ruta, 0, q)
    }
    sea cabeceras = map_nuevo()
    sea pos = fin_linea + 2
    mientras (pos < fin_cabeceras) {
        sea nl = http_linea_hasta(crudo, pos, "\r\n")
        si (nl > fin_cabeceras) { nl = fin_cabeceras }
        sea l = str_rebanar(crudo, pos, nl)
        sea dos_puntos = str_buscar(l, ":", 0)
        si (dos_puntos > 0) {
            sea valor_inicio = dos_puntos + 1
            mientras (valor_inicio < str_largo(l) y (str_byte(l, valor_inicio) == 32 o str_byte(l, valor_inicio) == 9)) { valor_inicio = valor_inicio + 1 }
            map_fijar(cabeceras, http_minusculas(str_rebanar(l, 0, dos_puntos)), dyn_texto(str_rebanar(l, valor_inicio, str_largo(l))))
        }
        pos = nl + 2
    }
    sea cuerpo = ""
    si (fin_cabeceras + 4 <= str_largo(crudo)) { cuerpo = str_rebanar(crudo, fin_cabeceras + 4, str_largo(crudo)) }
    sea r = map_nuevo()
    map_fijar(r, "metodo", dyn_texto(metodo))
    map_fijar(r, "ruta", dyn_texto(ruta))
    map_fijar(r, "query", dyn_texto(consulta))
    map_fijar(r, "cuerpo", dyn_texto(cuerpo))
    map_fijar(r, "cabeceras", dyn_caja(3, cabeceras))
    map_fijar(r, "ip", dyn_texto(ip))
    map_fijar(r, "_srv_id", id)
    retornar dyn_caja(3, r)
}

funcion http_texto_estado(estado) {
    si (estado == 201) { retornar "Created" }
    si (estado == 204) { retornar "No Content" }
    si (estado == 400) { retornar "Bad Request" }
    si (estado == 401) { retornar "Unauthorized" }
    si (estado == 403) { retornar "Forbidden" }
    si (estado == 404) { retornar "Not Found" }
    si (estado == 405) { retornar "Method Not Allowed" }
    si (estado == 422) { retornar "Unprocessable Entity" }
    si (estado == 500) { retornar "Internal Server Error" }
    retornar "OK"
}

funcion servidor_http_responder(id, estado, cuerpo, tipo) {
    sea srv = http_servidor(id)
    sea cliente = __cargar64(srv + 8)
    si (cliente < 0) { dyn_error("servidor_http_responder: sin cliente activo") }
    sea e = dyn_valor_entero(estado)
    sea c = dyn_a_str(cuerpo)
    sea t = "text/plain; charset=utf-8"
    si (dyn_tipo(tipo) == 1) { t = dyn_dato(tipo) }
    sea r = str_nuevo(str_largo(c) + 256)
    str_agregar(r, "HTTP/1.1 ")
    str_agregar(r, str_desde_entero(e))
    str_agregar_byte(r, 32)
    str_agregar(r, http_texto_estado(e))
    str_agregar(r, "\r\nContent-Type: ")
    str_agregar(r, t)
    str_agregar(r, "\r\nContent-Length: ")
    str_agregar(r, str_desde_entero(str_largo(c)))
    str_agregar(r, "\r\nConnection: close\r\nAccess-Control-Allow-Origin: *\r\n\r\n")
    str_agregar(r, c)
    sea enviado = 0
    mientras (enviado < str_largo(r)) {
        sea n = sys_red_escribir(cliente, str_datos(r) + enviado, str_largo(r) - enviado)
        si (n <= 0) { enviado = str_largo(r) } sino { enviado = enviado + n }
    }
    sys_red_cerrar(cliente)
    __guardar64(srv + 8, 0 - 1)
    retornar 0
}

funcion servidor_http_cerrar(id) {
    sea srv = http_servidor(id)
    si (__cargar64(srv + 8) >= 0) { sys_red_cerrar(__cargar64(srv + 8)) }
    sys_red_cerrar(__cargar64(srv))
    retornar 0
}

// ── Memoria C para bibliotecas externas (estructuras, búferes) ────────────
funcion c_reservar(bytes) {
    sea n = dyn_valor_entero(bytes)
    sea p = mem_reservar(n)
    mem_llenar(p, 0, n)
    retornar dyn_caja(11, p)
}
funcion c_liberar(p) { mem_liberar(dyn_entero_c(p)) retornar 0 }
funcion c_escribir32(p, desplazamiento, v) {
    sea d = dyn_entero_c(p) + dyn_valor_entero(desplazamiento)
    sea x = dyn_entero_c(v)
    __guardar8(d, __y_bits(x, 255))
    __guardar8(d + 1, __y_bits(__desplazar_der(x, 8), 255))
    __guardar8(d + 2, __y_bits(__desplazar_der(x, 16), 255))
    __guardar8(d + 3, __y_bits(__desplazar_der(x, 24), 255))
    retornar 0
}
funcion c_leer32(p, desplazamiento) {
    sea d = dyn_entero_c(p) + dyn_valor_entero(desplazamiento)
    sea x = __cargar8(d) + __cargar8(d + 1) * 256 + __cargar8(d + 2) * 65536 + __cargar8(d + 3) * 16777216
    si (x >= 2147483648) { x = x - 4294967296 }
    retornar dyn_entero(x)
}
// Texto del lenguaje a partir de una cadena C (terminada en 0) en p.
funcion c_texto(p) { retornar dyn_texto(str_desde_c(dyn_entero_c(p))) }
// Llama a la función C en f (puntero, p. ej. de SDL_GL_GetProcAddress) con
// hasta 8 argumentos enteros o punteros; los que faltan valen 0.
funcion c_llamar(f, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10) {
    sea r = 0
    si (a9 == 0 y a10 == 0) { r = __ccall(dyn_entero_c(f), dyn_entero_c(a1), dyn_entero_c(a2), dyn_entero_c(a3), dyn_entero_c(a4), dyn_entero_c(a5), dyn_entero_c(a6), dyn_entero_c(a7), dyn_entero_c(a8)) } sino {
        r = __ccall(dyn_entero_c(f), dyn_entero_c(a1), dyn_entero_c(a2), dyn_entero_c(a3), dyn_entero_c(a4), dyn_entero_c(a5), dyn_entero_c(a6), dyn_entero_c(a7), dyn_entero_c(a8), dyn_entero_c(a9), dyn_entero_c(a10))
    }
    retornar dyn_entero_desde_c(r)
}

// Resultado int de C (32 bits con signo) a partir de un valor de 64 bits.
funcion c_i32(v) {
    sea x = __y_bits(dyn_entero_c(v), 4294967295)
    si (x >= 2147483648) { x = x - 4294967296 }
    retornar dyn_entero(x)
}

// Bits IEEE-754 de 32 bits (float) del número, redondeando al par.
funcion f32_bits(d) {
    sea signo = __y_bits(__desplazar_der(d, 63), 1) * 2147483648
    sea e = __y_bits(__desplazar_der(d, 52), 2047)
    sea m = __y_bits(d, 4503599627370495)
    si (e == 2047) {
        si (m != 0) { retornar 2143289344 }                    // NaN
        retornar signo + 2139095040                            // ±inf
    }
    sea e8 = e - 1023 + 127
    si (e8 >= 255) { retornar signo + 2139095040 }
    si (e8 <= 0) {
        // Subnormal de float (o cero).
        si (e8 < 0 - 23) { retornar signo }
        sea completa = __o_bits(m, 4503599627370496)          // con el 1 implícito
        sea corrimiento = 29 + 1 - e8
        sea r = __desplazar_der(completa, corrimiento)
        sea resto = __y_bits(completa, __desplazar_izq(1, corrimiento) - 1)
        sea mitad = __desplazar_izq(1, corrimiento - 1)
        si (resto > mitad o (resto == mitad y __y_bits(r, 1) == 1)) { r = r + 1 }
        retornar signo + r
    }
    sea r = __desplazar_der(m, 29)
    sea resto = __y_bits(m, 536870911)
    si (resto > 268435456 o (resto == 268435456 y __y_bits(r, 1) == 1)) { r = r + 1 }
    si (r == 8388608) {
        r = 0
        e8 = e8 + 1
        si (e8 >= 255) { retornar signo + 2139095040 }
    }
    retornar signo + e8 * 8388608 + r
}

funcion c_f32(v) { retornar dyn_entero(f32_bits(dyn_a_f64(v))) }

funcion c_escribir_f32(p, desplazamiento, v) {
    sea d = dyn_entero_c(p) + dyn_valor_entero(desplazamiento)
    sea x = f32_bits(dyn_a_f64(v))
    __guardar8(d, __y_bits(x, 255))
    __guardar8(d + 1, __y_bits(__desplazar_der(x, 8), 255))
    __guardar8(d + 2, __y_bits(__desplazar_der(x, 16), 255))
    __guardar8(d + 3, __y_bits(__desplazar_der(x, 24), 255))
    retornar 0
}

// Copia del texto como cadena C terminada en 0 (liberar con c_liberar).
funcion c_cadena(t) {
    sea s = dyn_a_str(t)
    sea p = mem_reservar(str_largo(s) + 1)
    sea i = 0
    mientras (i < str_largo(s)) {
        __guardar8(p + i, str_byte(s, i))
        i = i + 1
    }
    __guardar8(p + str_largo(s), 0)
    retornar dyn_caja(11, p)
}

// Entero de 64 bits (o puntero) en p + desplazamiento.
funcion c_leer64(p, desplazamiento) {
    retornar dyn_entero_desde_c(__cargar64(dyn_entero_c(p) + dyn_valor_entero(desplazamiento)))
}
funcion c_escribir64(p, desplazamiento, v) {
    __guardar64(dyn_entero_c(p) + dyn_valor_entero(desplazamiento), dyn_entero_c(v))
    retornar 0
}
funcion c_leer8(p, desplazamiento) {
    retornar dyn_entero(__cargar8(dyn_entero_c(p) + dyn_valor_entero(desplazamiento)))
}

// ── Bytes, SHA-1, PBKDF2 (WebSocket, PostgreSQL, MySQL) ───────────────────
// Los textos son bytes: estas funciones arman y leen protocolos binarios.

// n en "ancho" bytes; orden 0 = big endian (red), 1 = little endian.
funcion bytes_entero(n, ancho, orden) {
    sea v = dyn_valor_entero(n)
    sea w = dyn_valor_entero(ancho)
    sea r = str_nuevo(w)
    sea i = 0
    mientras (i < w) {
        sea d = (w - 1 - i) * 8
        si (dyn_valor_entero(orden) == 1) { d = i * 8 }
        str_agregar_byte(r, __y_bits(__desplazar_der(v, d), 255))
        i = i + 1
    }
    retornar dyn_texto(r)
}

// Entero sin signo de "ancho" bytes desde pos.
funcion bytes_leer_entero(t, pos, ancho, orden) {
    sea s = dyn_texto_de(t, "bytes_leer_entero")
    sea p = dyn_valor_entero(pos)
    sea w = dyn_valor_entero(ancho)
    si (p < 0 o p + w > str_largo(s)) { dyn_error("bytes_leer_entero: fuera del texto") }
    sea v = 0
    sea i = 0
    mientras (i < w) {
        si (dyn_valor_entero(orden) == 1) {
            v = __o_bits(v, __desplazar_izq(str_byte(s, p + i), i * 8))
        } sino {
            v = __o_bits(__desplazar_izq(v, 8), str_byte(s, p + i))
        }
        i = i + 1
    }
    retornar dyn_entero(v)
}

funcion bytes_xor(a, b) {
    sea x = dyn_a_str(a)
    sea y = dyn_a_str(b)
    sea n = str_largo(x)
    sea m = str_largo(y)
    si (m == 0 y n > 0) { dyn_error("bytes_xor: la clave está vacía") }
    sea r = str_nuevo(n)
    sea px = str_datos(x)
    sea py = str_datos(y)
    sea pr = str_datos(r)
    sea i = 0
    sea j = 0
    mientras (i < n) {
        __guardar8(pr + i, __xo_bits(__cargar8(px + i), __cargar8(py + j)))
        i = i + 1
        j = j + 1
        si (j == m) { j = 0 }
    }
    __guardar8(pr + n, 0)
    __guardar64(r, n)
    retornar dyn_texto(r)
}

funcion bytes_de_hex(h) { retornar dyn_texto(hex_a_bytes(dyn_texto_de(h, "bytes_de_hex"))) }

funcion hex_de_bytes(t) {
    sea s = dyn_a_str(t)
    sea r = str_nuevo(str_largo(s) * 2)
    sea i = 0
    mientras (i < str_largo(s)) {
        hex_agregar(r, str_byte(s, i), 1, 0)
        i = i + 1
    }
    retornar dyn_texto(r)
}

funcion sha1_crudo(s) {
    sea m = hash_relleno(s, 0)
    sea h0 = 1732584193
    sea h1 = 4023233417
    sea h2 = 2562383102
    sea h3 = 271733878
    sea h4 = 3285377520
    sea w = mem_reservar(80 * 8)
    sea bloque = 0
    mientras (bloque < str_largo(m)) {
        sea i = 0
        mientras (i < 16) {
            sea p = bloque + i * 4
            __guardar64(w + i * 8, str_byte(m, p) * 16777216 + str_byte(m, p + 1) * 65536 + str_byte(m, p + 2) * 256 + str_byte(m, p + 3))
            i = i + 1
        }
        mientras (i < 80) {
            __guardar64(w + i * 8, roti32(__xo_bits(__xo_bits(__cargar64(w + (i - 3) * 8), __cargar64(w + (i - 8) * 8)), __xo_bits(__cargar64(w + (i - 14) * 8), __cargar64(w + (i - 16) * 8))), 1))
            i = i + 1
        }
        sea a = h0
        sea b = h1
        sea c = h2
        sea d = h3
        sea e = h4
        i = 0
        mientras (i < 80) {
            sea f = 0
            sea k = 0
            si (i < 20) {
                f = __o_bits(__y_bits(b, c), __y_bits(__xo_bits(b, 4294967295), d))
                k = 1518500249
            } sino {
                si (i < 40) {
                    f = __xo_bits(__xo_bits(b, c), d)
                    k = 1859775393
                } sino {
                    si (i < 60) {
                        f = __o_bits(__o_bits(__y_bits(b, c), __y_bits(b, d)), __y_bits(c, d))
                        k = 2400959708
                    } sino {
                        f = __xo_bits(__xo_bits(b, c), d)
                        k = 3395469782
                    }
                }
            }
            sea t = u32(roti32(a, 5) + f + e + k + __cargar64(w + i * 8))
            e = d
            d = c
            c = roti32(b, 30)
            b = a
            a = t
            i = i + 1
        }
        h0 = u32(h0 + a)
        h1 = u32(h1 + b)
        h2 = u32(h2 + c)
        h3 = u32(h3 + d)
        h4 = u32(h4 + e)
        bloque = bloque + 64
    }
    mem_liberar(w)
    sea r = str_nuevo(40)
    hex_agregar(r, h0, 4, 0)
    hex_agregar(r, h1, 4, 0)
    hex_agregar(r, h2, 4, 0)
    hex_agregar(r, h3, 4, 0)
    hex_agregar(r, h4, 4, 0)
    retornar r
}

// SHA-1 en hexadecimal (WebSocket, mysql_native_password).
funcion cfv_sha1(t) { retornar dyn_texto(sha1_crudo(dyn_a_str(t))) }
funcion sha1_bytes(t) { retornar dyn_texto(hex_a_bytes(sha1_crudo(dyn_a_str(t)))) }
funcion sha256_bytes(t) { retornar dyn_texto(hex_a_bytes(dyn_texto_de(cfv_sha256(t), "sha256_bytes"))) }
funcion hmac_sha256_bytes(clave, mensaje) { retornar dyn_texto(hex_a_bytes(dyn_texto_de(hmac_sha256(clave, mensaje), "hmac_sha256_bytes"))) }

// PBKDF2-HMAC-SHA256 (RFC 8018): "largo" bytes (SCRAM-SHA-256 usa 32).
funcion pbkdf2_sha256(clave, sal, iteraciones, largo) {
    sea n = dyn_valor_entero(iteraciones)
    sea total = dyn_valor_entero(largo)
    sea r = str_nuevo(total)
    sea bloque = 1
    mientras (str_largo(r) < total) {
        sea primero = str_concatenar(dyn_a_str(sal), dyn_texto_de(bytes_entero(dyn_entero(bloque), dyn_entero(4), dyn_entero(0)), "pbkdf2"))
        sea u = hmac_sha256_bytes(clave, dyn_texto(primero))
        sea x = u
        sea i = 1
        mientras (i < n) {
            u = hmac_sha256_bytes(clave, u)
            x = bytes_xor(x, u)
            i = i + 1
        }
        str_agregar(r, dyn_dato(x))
        bloque = bloque + 1
    }
    retornar dyn_texto(str_rebanar(r, 0, total))
}

// Lee exactamente n bytes (o menos si la conexión se cierra o vence la espera).
funcion net_recibir_exacto(sock, n) {
    sea fd = dyn_valor_entero(sock)
    sea total = dyn_valor_entero(n)
    si (total < 0) { dyn_error("net_recibir_exacto: largo negativo") }
    sea r = str_nuevo(total + 1)
    mientras (str_largo(r) < total) {
        sea k = sys_red_leer(fd, str_datos(r) + str_largo(r), total - str_largo(r))
        si (k <= 0) { retornar dyn_texto(r) }
        __guardar64(r, str_largo(r) + k)
    }
    retornar dyn_texto(r)
}

// Búfer de bytes propio y reutilizable (p. ej. uno por conexión).
funcion bytes_bufer(capacidad) {
    sea c = dyn_valor_entero(capacidad)
    si (c < 16) { c = 16 }
    si (c > 16777216) { dyn_error("bytes_bufer: capacidad mayor que 16 MiB") }
    retornar dyn_texto(str_nuevo(c))
}

// Lee exactamente n bytes del socket dentro de buf (lo reemplaza) sin
// reservar un texto nuevo; devuelve cuántos llegaron.
funcion net_recibir_en(sock, buf, n) {
    sea fd = dyn_valor_entero(sock)
    sea total = dyn_valor_entero(n)
    si (total < 0) { dyn_error("net_recibir_en: largo negativo") }
    sea r = dyn_a_str(buf)
    __guardar64(r, 0)
    str_asegurar(r, total + 1)
    mientras (str_largo(r) < total) {
        sea k = sys_red_leer(fd, str_datos(r) + str_largo(r), total - str_largo(r))
        si (k <= 0) {
            __guardar8(str_datos(r) + str_largo(r), 0)
            retornar dyn_entero(str_largo(r))
        }
        __guardar64(r, str_largo(r) + k)
    }
    __guardar8(str_datos(r) + total, 0)
    retornar dyn_entero(total)
}

// XOR en el sitio con la máscara de 4 bytes de WebSocket (los 4 primeros
// bytes de clave), de a 8 bytes. Solo para textos recién recibidos.
funcion bytes_desenmascarar(datos, clave) {
    sea d = dyn_a_str(datos)
    sea k = dyn_a_str(clave)
    si (str_largo(k) < 4) { dyn_error("bytes_desenmascarar: la máscara tiene 4 bytes") }
    si (__cargar64(d + 24) != 1) { retornar bytes_xor(datos, dyn_texto(str_rebanar(k, 0, 4))) }   // texto prestado: copia
    sea p = str_datos(d)
    sea n = str_largo(d)
    sea m4 = __y_bits(__cargar64(str_datos(k)), 4294967295)
    sea m8 = __o_bits(m4, __desplazar_izq(m4, 32))
    sea i = 0
    mientras (i + 8 <= n) {
        __guardar64(p + i, __xo_bits(__cargar64(p + i), m8))
        i = i + 8
    }
    mientras (i < n) {
        __guardar8(p + i, __xo_bits(__cargar8(p + i), __cargar8(str_datos(k) + i % 4)))
        i = i + 1
    }
    retornar datos
}

// Saca la conexión activa del servidor HTTP (para WebSocket): el servidor ya
// no la cierra; devuelve el socket.
funcion servidor_http_tomar_conexion(id) {
    sea srv = http_servidor(id)
    sea cliente = __cargar64(srv + 8)
    si (cliente < 0) { dyn_error("servidor_http_tomar_conexion: sin cliente activo") }
    __guardar64(srv + 8, 0 - 1)
    retornar dyn_entero(cliente)
}

// Posición de "aguja" desde "desde" (-1 si no está).
funcion bytes_buscar(t, aguja, desde) {
    retornar dyn_entero(str_buscar(dyn_texto_de(t, "bytes_buscar"), dyn_texto_de(aguja, "bytes_buscar"), dyn_valor_entero(desde)))
}

// Dirección de los elementos de una lista (enteros de 64 bits seguidos):
// para compartirlos sin copiar (p. ej. con JavaScript en WebAssembly). La
// dirección cambia si la lista crece.
funcion lista_direccion(l) {
    si (dyn_tipo(l) != 2) { dyn_error_tipo("lista_direccion", l) }
    retornar dyn_caja(11, __cargar64(dyn_dato(l) + 16))
}

// Texto de un número sin perder precisión (para JSON y serialización).
funcion numero_preciso(v) {
    si (dyn_tipo(v) != 4) { retornar a_texto(v) }
    sea r = str_nuevo(32)
    dyn_formato_cifras(r, dyn_dato(v), 15)
    retornar dyn_texto(r)
}

// n bytes desde una dirección de C (BLOB, textos con bytes 0).
funcion c_bytes(p, n) {
    sea d = dyn_entero_c(p)
    sea k = dyn_valor_entero(n)
    sea r = str_nuevo(k)
    si (d != 0 y k > 0) {
        mem_copiar(str_datos(r), d, k)
        __guardar64(r, k)
    }
    retornar dyn_texto(r)
}

// Borra un archivo; verdadero si existía y se borró.
funcion eliminar_archivo(ruta) {
    si (existe_archivo(ruta) == 2) { retornar 2 }
    sys_borrar(str_c(dyn_texto_de(ruta, "eliminar_archivo")))
    retornar dyn_bool(existe_archivo(ruta) == 2)
}

// ── Java (JNI): la JVM dentro del programa ────────────────────────────────
// java_iniciar(classpath) arranca la JVM (JAVA_HOME o rutas habituales).
// java_estatico("java.lang.Math", "max", "(II)I", [3, 9]) llama un método
// estático; java_nuevo(clase, firma_constructor, args) crea un objeto y
// java_metodo(obj, metodo, firma, args) llama sus métodos. Firmas JNI:
// I/S/B/C enteros, J largo, Z booleano, D decimal (solo argumentos),
// Ljava/lang/String; texto, otros L…; objetos (los devuelve java_nuevo o un
// método), V sin valor. Una excepción de Java llega como error capturable.
// Globales del programa: 50 = JNIEnv*, 51 = JavaVM*.

funcion java_env() {
    sea e = mem_global(50)
    si (e == 0) { dyn_error("java: llama primero a java_iniciar()") }
    retornar e
}

funcion java_fn(i) { retornar __cargar64(__cargar64(java_env()) + i * 8) }

funcion java_comprobar(que) {
    sea env = java_env()
    si (__y_bits(__ccall(java_fn(228), env), 255) != 0) {
        // El mensaje es el toString() de la excepción ("java.lang.X: …").
        sea ex = __ccall(java_fn(15), env)
        __ccall(java_fn(17), env)
        sea m = str_concatenar(str_concatenar("java: ", que), ": ")
        si (ex != 0) {
            sea k = __ccall(java_fn(31), env, ex)
            sea ts = __ccall(java_fn(33), env, k, str_c("toString"), str_c("()Ljava/lang/String;"))
            sea vacio = mem_reservar(8)
            sea j = __ccall(java_fn(36), env, ex, ts, vacio)
            si (__y_bits(__ccall(java_fn(228), env), 255) != 0) { __ccall(java_fn(17), env) }
            si (j != 0) {
                sea p = __ccall(java_fn(169), env, j, 0)
                str_agregar(m, str_desde_c(p))
                __ccall(java_fn(170), env, j, p)
            }
        }
        dyn_error(m)
    }
    retornar 0
}

funcion java_probar_jvm(candidatos, ruta) {
    vec_agregar(candidatos, str_concatenar(ruta, "/lib/server/libjvm.so"))
    vec_agregar(candidatos, str_concatenar(ruta, "/lib/server/libjvm.dylib"))
    vec_agregar(candidatos, str_concatenar(ruta, "/Contents/Home/lib/server/libjvm.dylib"))
    vec_agregar(candidatos, str_concatenar(ruta, "\\bin\\server\\jvm.dll"))
    retornar 0
}

funcion java_libjvm() {
    sea candidatos = vec_nuevo()
    sea casa = sys_variable_entorno("JAVA_HOME")
    si (casa != 0) { java_probar_jvm(candidatos, casa) }
    sea dirs = vec_nuevo()
    vec_agregar(dirs, "/usr/lib/jvm")
    vec_agregar(dirs, "/Library/Java/JavaVirtualMachines")
    vec_agregar(dirs, "/opt/homebrew/opt/openjdk/libexec/openjdk.jdk")
    vec_agregar(dirs, "C:\\Program Files\\Java")
    sea d = 0
    mientras (d < vec_largo(dirs)) {
        sea nombres = sys_listar(vec_obtener(dirs, d))
        si (nombres != 0) {
            sea i = 0
            mientras (i < vec_largo(nombres)) {
                sea n = vec_obtener(nombres, i)
                si (str_igual(n, ".") == 0 y str_igual(n, "..") == 0) {
                    sea base = str_concatenar(vec_obtener(dirs, d), "/")
                    si (__plataforma() == 1) { base = str_concatenar(vec_obtener(dirs, d), "\\") }
                    java_probar_jvm(candidatos, str_concatenar(base, n))
                }
                i = i + 1
            }
        }
        java_probar_jvm(candidatos, vec_obtener(dirs, d))
        d = d + 1
    }
    sea h = 0
    sea i = 0
    mientras (i < vec_largo(candidatos) y h == 0) {
        h = dyn_abrir_biblioteca(vec_obtener(candidatos, i))
        i = i + 1
    }
    retornar h
}

funcion java_iniciar(ruta_clases) {
    si (mem_global(50) != 0) { retornar 4 }
    si (sys_dl_disponible() == 0) { dyn_error("java: este programa no puede cargar bibliotecas dinámicas") }
    sea h = java_libjvm()
    si (h == 0) { dyn_error("java: no encontré la JVM (instala un JDK o define JAVA_HOME)") }
    sea crear = sys_simbolo(h, "JNI_CreateJavaVM")
    si (crear == 0) { dyn_error("java: libjvm sin JNI_CreateJavaVM") }
    sea opciones = mem_reservar(48)
    mem_llenar(opciones, 0, 48)
    sea n = 0
    __guardar64(opciones, str_c("-Xrs"))                       // sin manejar SIGINT/SIGTERM
    n = 1
    si (ruta_clases != 0) {
        __guardar64(opciones + 16, str_c(str_concatenar("-Djava.class.path=", dyn_texto_de(ruta_clases, "java_iniciar"))))
        n = 2
    }
    sea args = mem_reservar(24)
    mem_llenar(args, 0, 24)
    __guardar64(args, __o_bits(65544, __desplazar_izq(n, 32)))  // JNI_VERSION_1_8 y cantidad de opciones
    __guardar64(args + 8, opciones)
    __guardar8(args + 16, 1)                                   // ignoreUnrecognized
    sea pvm = mem_reservar(8)
    sea penv = mem_reservar(8)
    __guardar64(pvm, 0)
    __guardar64(penv, 0)
    sea r = __y_bits(__ccall(crear, pvm, penv, args), 4294967295)
    si (r != 0) { dyn_error("java: JNI_CreateJavaVM falló (¿ya hay una JVM en este proceso?)") }
    mem_fijar_global(50, __cargar64(penv))
    mem_fijar_global(51, __cargar64(pvm))
    retornar 4
}

// "java.util.ArrayList" → "java/util/ArrayList".
funcion java_ruta_clase(c) {
    sea s = dyn_texto_de(c, "java")
    sea r = str_nuevo(str_largo(s) + 1)
    sea i = 0
    mientras (i < str_largo(s)) {
        si (str_byte(s, i) == 46) { str_agregar_byte(r, 47) } sino { str_agregar_byte(r, str_byte(s, i)) }
        i = i + 1
    }
    retornar r
}

funcion java_clase(c) {
    sea k = __ccall(java_fn(6), java_env(), str_c(java_ruta_clase(c)))
    java_comprobar(str_concatenar("FindClass ", dyn_texto_de(c, "java")))
    si (k == 0) { dyn_error(str_concatenar("java: no existe la clase ", dyn_texto_de(c, "java"))) }
    retornar k
}

// Tipos de una firma JNI: vec de letras (L = objeto, T = String, A = arreglo)
// para los parámetros y, al final, la del retorno.
funcion java_tipos(firma) {
    sea r = vec_nuevo()
    sea i = 1
    mientras (i < str_largo(firma)) {
        sea c = str_byte(firma, i)
        si (c == 41) { i = i + 1 } sino {
            si (c == 91) {
                mientras (i < str_largo(firma) y str_byte(firma, i) == 91) { i = i + 1 }
                si (i < str_largo(firma) y str_byte(firma, i) == 76) { mientras (i < str_largo(firma) y str_byte(firma, i) != 59) { i = i + 1 } }
                vec_agregar(r, 65)
                i = i + 1
            } sino {
