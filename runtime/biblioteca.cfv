funcion dotnet_crudo(f, args) {
    sea v = dotnet_argumentos(args)
    retornar __ccall(dyn_valor_entero(f), __cargar64(v), __cargar64(v + 8), __cargar64(v + 16), __cargar64(v + 24), __cargar64(v + 32), __cargar64(v + 40))
