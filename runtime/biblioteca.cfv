// runtime/biblioteca.cfv — biblioteca estándar nativa, 100 % C-Forge.
//
// Se compila en modo puente (como dyn.cfv): código del dialecto nativo que
// recibe y devuelve valores del lenguaje. Sin libc: la matemática usa series
// propias, el tiempo usa clock_gettime y los archivos usan syscalls.

// ── Flotantes: constantes y ayudas ────────────────────────────────────────

funcion f_(n) { retornar __f64_desde_entero(n) }
funcion f_pi() { retornar 4614256656552045848 }               // 0x400921FB54442D18
funcion f_ln2() { retornar 4604418534313441775 }              // 0x3FE62E42FEFA39EF
funcion f_neg(x) { retornar __f64_resta(f_(0), x) }
funcion f_abs(x) { retornar __desplazar_der(__desplazar_izq(x, 1), 1) }
funcion f_mayor(a, b) { retornar __f64_menor(b, a) }

// Redondeo a entero, mitades lejos del cero.
funcion f_redondear(x) {
    si (__f64_menor(x, f_(0))) {
        retornar 0 - __f64_a_entero(__f64_suma(f_abs(x), __f64_div(f_(1), f_(2))))
    }
    retornar __f64_a_entero(__f64_suma(x, __f64_div(f_(1), f_(2))))
}

funcion f_potencia10(n) {
    sea r = f_(1)
    sea i = 0
    mientras (i < n) {
        r = __f64_mul(r, f_(10))
        i = i + 1
    }
    retornar r
}

// seno en [-pi/2, pi/2] por serie de Taylor.
funcion f_seno_reducido(x) {
    sea x2 = __f64_mul(x, x)
    sea termino = x
    sea suma = x
    sea k = 1
    mientras (k < 10) {
        termino = __f64_div(__f64_mul(f_neg(termino), x2), f_((2 * k) * (2 * k + 1)))
        suma = __f64_suma(suma, termino)
        k = k + 1
    }
    retornar suma
}

funcion f_coseno_reducido(x) {
    sea x2 = __f64_mul(x, x)
    sea termino = f_(1)
    sea suma = f_(1)
    sea k = 1
    mientras (k < 11) {
        termino = __f64_div(__f64_mul(f_neg(termino), x2), f_((2 * k - 1) * (2 * k)))
        suma = __f64_suma(suma, termino)
        k = k + 1
    }
    retornar suma
}

// Lleva x a [-pi, pi].
funcion f_reducir_angulo(x) {
    sea dos_pi = __f64_mul(f_(2), f_pi())
    sea k = f_redondear(__f64_div(x, dos_pi))
    retornar __f64_resta(x, __f64_mul(f_(k), dos_pi))
}

funcion f_seno(x) {
    x = f_reducir_angulo(x)
    sea medio_pi = __f64_div(f_pi(), f_(2))
    si (f_mayor(x, medio_pi)) { x = __f64_resta(f_pi(), x) }
    si (__f64_menor(x, f_neg(medio_pi))) { x = __f64_resta(f_neg(f_pi()), x) }
    retornar f_seno_reducido(x)
}

funcion f_coseno(x) {
    x = f_abs(f_reducir_angulo(x))
    si (f_mayor(x, __f64_div(f_pi(), f_(2)))) {
        retornar f_neg(f_coseno_reducido(__f64_resta(f_pi(), x)))
    }
    retornar f_coseno_reducido(x)
}

funcion f_arcotangente(x) {
    sea negativo = __f64_menor(x, f_(0))
    x = f_abs(x)
    sea invertido = 0
    si (f_mayor(x, f_(1))) {
        x = __f64_div(f_(1), x)
        invertido = 1
    }
    // atan(x) = 2·atan(x / (1 + sqrt(1 + x²))), dos veces.
    sea factor = 1
    sea i = 0
    mientras (i < 2) {
        x = __f64_div(x, __f64_suma(f_(1), __f64_raiz(__f64_suma(f_(1), __f64_mul(x, x)))))
        factor = factor * 2
        i = i + 1
    }
    sea x2 = __f64_mul(x, x)
    sea potencia = x
    sea suma = x
    sea k = 1
    mientras (k < 12) {
        potencia = __f64_mul(f_neg(potencia), x2)
        suma = __f64_suma(suma, __f64_div(potencia, f_(2 * k + 1)))
        k = k + 1
    }
    sea r = __f64_mul(suma, f_(factor))
    si (invertido) { r = __f64_resta(__f64_div(f_pi(), f_(2)), r) }
    si (negativo) { r = f_neg(r) }
    retornar r
}

funcion f_arcoseno(x) {
    si (f_mayor(f_abs(x), f_(1))) { dyn_error("arcoseno fuera de [-1, 1]") }
    si (f_abs(x) == f_(1)) {
        sea medio = __f64_div(f_pi(), f_(2))
        si (__f64_menor(x, f_(0))) { retornar f_neg(medio) }
        retornar medio
    }
    retornar f_arcotangente(__f64_div(x, __f64_raiz(__f64_resta(f_(1), __f64_mul(x, x)))))
}

funcion f_exponencial(x) {
    sea k = f_redondear(__f64_div(x, f_ln2()))
    sea r = __f64_resta(x, __f64_mul(f_(k), f_ln2()))
    sea termino = f_(1)
    sea suma = f_(1)
    sea i = 1
    mientras (i < 22) {
        termino = __f64_div(__f64_mul(termino, r), f_(i))
        suma = __f64_suma(suma, termino)
        i = i + 1
    }
    mientras (k > 0) {
        suma = __f64_mul(suma, f_(2))
        k = k - 1
    }
    mientras (k < 0) {
        suma = __f64_div(suma, f_(2))
        k = k + 1
    }
    retornar suma
}

funcion f_logaritmo(x) {
    si (__f64_menor(f_(0), x) == 0) { dyn_error("logaritmo de un número no positivo") }
    sea e = __y_bits(__desplazar_der(x, 52), 2047) - 1023
    sea m = __o_bits(__y_bits(x, 4503599627370495), 4607182418800017408)   // mantisa en [1, 2)
    si (f_mayor(m, __f64_raiz(f_(2)))) {
        m = __f64_div(m, f_(2))
        e = e + 1
    }
    sea t = __f64_div(__f64_resta(m, f_(1)), __f64_suma(m, f_(1)))
    sea t2 = __f64_mul(t, t)
    sea potencia = t
    sea suma = t
    sea k = 1
    mientras (k < 18) {
        potencia = __f64_mul(potencia, t2)
        suma = __f64_suma(suma, __f64_div(potencia, f_(2 * k + 1)))
        k = k + 1
    }
    retornar __f64_suma(__f64_mul(f_(2), suma), __f64_mul(f_(e), f_ln2()))
}

// ── Formato de números (como %g con 6 cifras, igual que el intérprete) ───

funcion dyn_formato_g(r, bits) {
    sea exponente_bits = __y_bits(__desplazar_der(bits, 52), 2047)
    sea negativo = bits < 0
    sea x = f_abs(bits)
    si (exponente_bits == 2047) {
        si (__desplazar_izq(bits, 12) != 0) { str_agregar(r, "nan") retornar 0 }
        si (negativo) { str_agregar_byte(r, 45) }
        str_agregar(r, "inf")
        retornar 0
    }
    si (x == 0) { str_agregar_byte(r, 48) retornar 0 }
    si (negativo) { str_agregar_byte(r, 45) }
    // Exponente decimal e tal que 10^e <= x < 10^(e+1).
    sea e = 0
    sea y = x
    mientras (__f64_menor(y, f_(10)) == 0) {
        y = __f64_div(y, f_(10))
        e = e + 1
    }
    mientras (__f64_menor(y, f_(1))) {
        y = __f64_mul(y, f_(10))
        e = e - 1
    }
    // Seis cifras significativas como entero m (100000 <= m < 1000000).
    sea m = 0
    si (e - 5 >= 0) {
        m = f_redondear(__f64_div(x, f_potencia10(e - 5)))
    } sino {
        m = f_redondear(__f64_mul(x, f_potencia10(5 - e)))
    }
    si (m >= 1000000) {
        m = (m + 5) / 10
        e = e + 1
    }
    si (m < 100000) {
        m = m * 10
        e = e - 1
    }
    sea digitos = str_desde_entero(m)
    // Quitar ceros finales.
    sea utiles = 6
    mientras (utiles > 1 y str_byte(digitos, utiles - 1) == 48) { utiles = utiles - 1 }
    si (e < 0 - 4 o e >= 6) {
        str_agregar_byte(r, str_byte(digitos, 0))
        si (utiles > 1) {
            str_agregar_byte(r, 46)
            str_agregar(r, str_rebanar(digitos, 1, utiles))
        }
        str_agregar_byte(r, 101)
        si (e < 0) {
            str_agregar_byte(r, 45)
            e = 0 - e
        } sino {
            str_agregar_byte(r, 43)
        }
        si (e < 10) { str_agregar_byte(r, 48) }
        str_agregar(r, str_desde_entero(e))
        retornar 0
    }
    si (e >= 0) {
        str_agregar(r, str_rebanar(digitos, 0, e + 1))
        si (utiles > e + 1) {
            str_agregar_byte(r, 46)
            str_agregar(r, str_rebanar(digitos, e + 1, utiles))
        }
        retornar 0
    }
    str_agregar(r, "0.")
    sea ceros = 0 - e - 1
    mientras (ceros > 0) {
        str_agregar_byte(r, 48)
        ceros = ceros - 1
    }
    str_agregar(r, str_rebanar(digitos, 0, utiles))
    retornar 0
}

// ── Matemática del lenguaje ───────────────────────────────────────────────

funcion absoluto(v) {
    si (__y_bits(v, 1) == 1) {
        si (v < 0) { retornar 2 - v }
        retornar v
    }
    retornar dyn_desde_f64(f_abs(dyn_a_f64(v)))
}

funcion minimo(a, b) {
    si (dyn_comparar(b, a) < 0) { retornar b }
    retornar a
}

funcion maximo(a, b) {
    si (dyn_comparar(b, a) > 0) { retornar b }
    retornar a
}

funcion raiz(v) {
    sea x = dyn_a_f64(v)
    si (__f64_menor(x, f_(0))) { dyn_error("raíz de un número negativo") }
    retornar dyn_desde_f64(__f64_raiz(x))
}

funcion potencia(base, exponente) {
    si (dyn_ambos_enteros(base, exponente) y exponente >= 1) {
        sea b = dyn_valor_entero(base)
        sea e = dyn_valor_entero(exponente)
        sea r = 1
        sea desborda = 0
        mientras (e > 0 y desborda == 0) {
            si (r > 1152921504606846976 / (absoluto_crudo(b) + 1)) { desborda = 1 }
            r = r * b
            e = e - 1
        }
        si (desborda == 0) { retornar dyn_entero(r) }
    }
    sea x = dyn_a_f64(base)
    sea y = dyn_a_f64(exponente)
    si (x == f_(0)) {
        si (__f64_menor(f_(0), y)) { retornar dyn_entero(0) }
        si (y == f_(0)) { retornar dyn_entero(1) }
        dyn_error("potencia: cero elevado a un exponente negativo")
    }
    si (__f64_menor(x, f_(0))) {
        sea entero = __f64_a_entero(y)
        si (f_(entero) != y) { dyn_error("potencia: base negativa con exponente fraccionario") }
        sea magnitud = f_exponencial(__f64_mul(y, f_logaritmo(f_abs(x))))
        si (__y_bits(entero, 1) == 1) { magnitud = f_neg(magnitud) }
        retornar dyn_desde_f64(magnitud)
    }
    retornar dyn_desde_f64(f_exponencial(__f64_mul(y, f_logaritmo(x))))
}

funcion absoluto_crudo(n) {
    si (n < 0) { retornar 0 - n }
    retornar n
}

funcion redondear(v, decimales) {
    si (__y_bits(v, 1) == 1) { retornar v }
    sea x = dyn_a_f64(v)
    si (decimales == 0) { retornar dyn_entero(f_redondear(x)) }
    sea escala = f_potencia10(dyn_valor_entero(decimales))
    retornar dyn_desde_f64(__f64_div(f_(f_redondear(__f64_mul(x, escala))), escala))
}

funcion seno(v) { retornar dyn_desde_f64(f_seno(dyn_a_f64(v))) }
funcion coseno(v) { retornar dyn_desde_f64(f_coseno(dyn_a_f64(v))) }
funcion tangente(v) {
    sea x = dyn_a_f64(v)
    retornar dyn_desde_f64(__f64_div(f_seno(x), f_coseno(x)))
}
funcion arcoseno(v) { retornar dyn_desde_f64(f_arcoseno(dyn_a_f64(v))) }
funcion arccoseno(v) {
    retornar dyn_desde_f64(__f64_resta(__f64_div(f_pi(), f_(2)), f_arcoseno(dyn_a_f64(v))))
}
funcion arcotangente(v) { retornar dyn_desde_f64(f_arcotangente(dyn_a_f64(v))) }
funcion exponencial(v) { retornar dyn_desde_f64(f_exponencial(dyn_a_f64(v))) }
funcion logaritmo(v) { retornar dyn_desde_f64(f_logaritmo(dyn_a_f64(v))) }
funcion sen(v) { retornar seno(v) }
funcion cos(v) { retornar coseno(v) }
funcion tan(v) { retornar tangente(v) }
funcion pi() { retornar dyn_desde_f64(f_pi()) }

// Generador xorshift64* (global 22), sembrado con el reloj.
funcion aleatorio_crudo() {
    sea x = mem_global(22)
    si (x == 0) { x = __o_bits(sys_reloj_ns(), 1) }
    x = __xo_bits(x, __desplazar_der(x, 12))
    x = __xo_bits(x, __desplazar_izq(x, 25))
    x = __xo_bits(x, __desplazar_der(x, 27))
    mem_fijar_global(22, x)
    retornar __desplazar_der(x * 2685821657736338717, 11)        // 53 bits
}

funcion aleatorio() {
    retornar dyn_caja(4, __f64_div(f_(aleatorio_crudo()), f_(9007199254740992)))
}

funcion aleatorio_entero(minimo_v, maximo_v) {
    sea a = dyn_valor_entero(minimo_v)
    sea b = dyn_valor_entero(maximo_v)
    si (b < a) { dyn_error("aleatorio_entero: el máximo es menor que el mínimo") }
    retornar dyn_entero(a + aleatorio_crudo() % (b - a + 1))
}

// ── Texto ─────────────────────────────────────────────────────────────────

// Posición de aguja en pajar desde inicio, o -1.
funcion str_buscar(pajar, aguja, inicio) {
    sea n = str_largo(pajar)
    sea m = str_largo(aguja)
    sea i = inicio
    mientras (i + m <= n) {
        sea j = 0
        mientras (j < m y str_byte(pajar, i + j) == str_byte(aguja, j)) { j = j + 1 }
        si (j == m) { retornar i }
        i = i + 1
    }
    retornar 0 - 1
}

funcion texto_reemplazar(t, buscado, reemplazo) {
    sea s = dyn_texto_de(t, "texto_reemplazar")
    sea a = dyn_texto_de(buscado, "texto_reemplazar")
    sea b = dyn_a_str(reemplazo)
    si (str_largo(a) == 0) { retornar t }
    sea r = str_nuevo(str_largo(s))
    sea i = 0
    mientras (i < str_largo(s)) {
        sea p = str_buscar(s, a, i)
        si (p < 0) {
            str_agregar(r, str_rebanar(s, i, str_largo(s)))
            i = str_largo(s)
        } sino {
            str_agregar(r, str_rebanar(s, i, p))
            str_agregar(r, b)
            i = p + str_largo(a)
        }
    }
    retornar dyn_texto(r)
}

funcion contiene(coleccion, v) {
    sea t = dyn_tipo(coleccion)
    si (t == 1) {
        retornar dyn_bool(str_buscar(dyn_dato(coleccion), dyn_a_str(v), 0) >= 0)
    }
    si (t == 2) { retornar lista_contiene(coleccion, v) }
    si (t == 3) { retornar tiene_clave(coleccion, v) }
    dyn_error_tipo("contiene", coleccion)
    retornar 2
}

funcion texto_contiene(t, sub) { retornar contiene(t, sub) }

funcion subtexto(t, inicio, fin) {
    sea s = dyn_texto_de(t, "subtexto")
    retornar dyn_texto(str_rebanar(s, dyn_valor_entero(inicio), dyn_valor_entero(fin)))
}

funcion texto_dividir(t, separador) {
    sea s = dyn_texto_de(t, "texto_dividir")
    sea sep = dyn_texto_de(separador, "texto_dividir")
    sea r = vec_nuevo()
    si (str_largo(sep) == 0) {
        sea k = 0
        mientras (k < str_largo(s)) {
            vec_agregar(r, dyn_texto(str_rebanar(s, k, k + 1)))
            k = k + 1
        }
        retornar dyn_caja(2, r)
    }
    sea i = 0
    sea seguir = 1
    mientras (seguir) {
        sea p = str_buscar(s, sep, i)
        si (p < 0) {
            vec_agregar(r, dyn_texto(str_rebanar(s, i, str_largo(s))))
            seguir = 0
        } sino {
            vec_agregar(r, dyn_texto(str_rebanar(s, i, p)))
            i = p + str_largo(sep)
        }
    }
    retornar dyn_caja(2, r)
}

funcion texto_unir(lista, separador) {
    si (dyn_tipo(lista) != 2) { dyn_error_tipo("texto_unir", lista) }
    sea l = dyn_dato(lista)
    sea r = str_nuevo(16)
    sea i = 0
    mientras (i < vec_largo(l)) {
        si (i > 0) { dyn_agregar_valor(r, separador, 0) }
        dyn_agregar_valor(r, vec_obtener(l, i), 0)
        i = i + 1
    }
    retornar dyn_texto(r)
}

funcion es_blanco(b) { retornar b == 32 o b == 9 o b == 10 o b == 13 }

funcion texto_recortar(t) {
    sea s = dyn_texto_de(t, "texto_recortar")
    sea i = 0
    sea j = str_largo(s)
    mientras (i < j y es_blanco(str_byte(s, i))) { i = i + 1 }
    mientras (j > i y es_blanco(str_byte(s, j - 1))) { j = j - 1 }
    retornar dyn_texto(str_rebanar(s, i, j))
}

// Código Unicode del primer carácter (UTF-8).
funcion cfv_codigo_char(t) {
    sea s = dyn_texto_de(t, "codigo_char")
    si (str_largo(s) == 0) { dyn_error("codigo_char: texto vacío") }
    sea b = str_byte(s, 0)
    si (b < 128) { retornar dyn_entero(b) }
    sea extra = 1
    sea valor = __y_bits(b, 31)
    si (b >= 240) {
        extra = 3
        valor = __y_bits(b, 7)
    } sino {
        si (b >= 224) {
            extra = 2
            valor = __y_bits(b, 15)
        }
    }
    sea i = 1
    mientras (i <= extra y i < str_largo(s)) {
        valor = valor * 64 + __y_bits(str_byte(s, i), 63)
        i = i + 1
    }
    retornar dyn_entero(valor)
}

funcion str_agregar_utf8(r, n) {
    si (n < 128) { str_agregar_byte(r, n) retornar 0 }
    si (n < 2048) {
        str_agregar_byte(r, 192 + n / 64)
        str_agregar_byte(r, 128 + n % 64)
        retornar 0
    }
    si (n < 65536) {
        str_agregar_byte(r, 224 + n / 4096)
        str_agregar_byte(r, 128 + (n / 64) % 64)
        str_agregar_byte(r, 128 + n % 64)
        retornar 0
    }
    str_agregar_byte(r, 240 + n / 262144)
    str_agregar_byte(r, 128 + (n / 4096) % 64)
    str_agregar_byte(r, 128 + (n / 64) % 64)
    str_agregar_byte(r, 128 + n % 64)
    retornar 0
}

funcion caracter(codigo) {
    sea r = str_nuevo(4)
    str_agregar_utf8(r, dyn_valor_entero(codigo))
    retornar dyn_texto(r)
}

// Byte i del texto como entero (para bibliotecas escritas en C-Forge).
funcion byte_en(t, i) {
    retornar dyn_entero(str_byte(dyn_texto_de(t, "byte_en"), dyn_valor_entero(i)))
}

// ── Base64 y URL ──────────────────────────────────────────────────────────

funcion base64_simbolo(n) {
    si (n < 26) { retornar 65 + n }
    si (n < 52) { retornar 97 + n - 26 }
    si (n < 62) { retornar 48 + n - 52 }
    si (n == 62) { retornar 43 }
    retornar 47
}

funcion base64_valor(b) {
    si (b >= 65 y b <= 90) { retornar b - 65 }
    si (b >= 97 y b <= 122) { retornar b - 97 + 26 }
    si (b >= 48 y b <= 57) { retornar b - 48 + 52 }
    si (b == 43 o b == 45) { retornar 62 }
    si (b == 47 o b == 95) { retornar 63 }
    retornar 0 - 1
}

funcion cfv_base64_codificar(t) {
    sea s = dyn_a_str(t)
    sea n = str_largo(s)
    sea r = str_nuevo(n * 4 / 3 + 4)
    sea i = 0
    mientras (i < n) {
        sea b0 = str_byte(s, i)
        sea b1 = 0
        sea b2 = 0
        si (i + 1 < n) { b1 = str_byte(s, i + 1) }
        si (i + 2 < n) { b2 = str_byte(s, i + 2) }
        sea grupo = b0 * 65536 + b1 * 256 + b2
        str_agregar_byte(r, base64_simbolo(__y_bits(__desplazar_der(grupo, 18), 63)))
        str_agregar_byte(r, base64_simbolo(__y_bits(__desplazar_der(grupo, 12), 63)))
        si (i + 1 < n) { str_agregar_byte(r, base64_simbolo(__y_bits(__desplazar_der(grupo, 6), 63))) } sino { str_agregar_byte(r, 61) }
        si (i + 2 < n) { str_agregar_byte(r, base64_simbolo(__y_bits(grupo, 63))) } sino { str_agregar_byte(r, 61) }
        i = i + 3
    }
    retornar dyn_texto(r)
}

funcion cfv_base64_decodificar(t) {
    sea s = dyn_texto_de(t, "base64_decodificar")
    sea r = str_nuevo(str_largo(s))
    sea acumulado = 0
    sea bits = 0
    sea i = 0
    mientras (i < str_largo(s)) {
        sea v = base64_valor(str_byte(s, i))
        si (v >= 0) {
            acumulado = __y_bits(acumulado * 64 + v, 16777215)
            bits = bits + 6
            si (bits >= 8) {
                bits = bits - 8
                str_agregar_byte(r, __y_bits(__desplazar_der(acumulado, bits), 255))
            }
        }
        i = i + 1
    }
    retornar dyn_texto(r)
}

funcion hex_digito(n) {
    si (n < 10) { retornar 48 + n }
    retornar 55 + n
}

funcion valor_hex(b) {
    si (b >= 48 y b <= 57) { retornar b - 48 }
    si (b >= 65 y b <= 70) { retornar b - 55 }
    si (b >= 97 y b <= 102) { retornar b - 87 }
    retornar 0 - 1
}

funcion url_reservado(b) {
    si ((b >= 65 y b <= 90) o (b >= 97 y b <= 122) o (b >= 48 y b <= 57)) { retornar 0 }
    si (b == 45 o b == 95 o b == 46 o b == 126) { retornar 0 }
    retornar 1
}

funcion cfv_url_codificar(t) {
    sea s = dyn_a_str(t)
    sea r = str_nuevo(str_largo(s) * 3)
    sea i = 0
    mientras (i < str_largo(s)) {
        sea b = str_byte(s, i)
        si (url_reservado(b)) {
            str_agregar_byte(r, 37)
            str_agregar_byte(r, hex_digito(b / 16))
            str_agregar_byte(r, hex_digito(b % 16))
        } sino {
            str_agregar_byte(r, b)
        }
        i = i + 1
    }
    retornar dyn_texto(r)
}

funcion cfv_url_decodificar(t) {
    sea s = dyn_texto_de(t, "url_decodificar")
    sea r = str_nuevo(str_largo(s))
    sea i = 0
    mientras (i < str_largo(s)) {
        sea b = str_byte(s, i)
        si (b == 37 y i + 2 < str_largo(s) y valor_hex(str_byte(s, i + 1)) >= 0 y valor_hex(str_byte(s, i + 2)) >= 0) {
            str_agregar_byte(r, valor_hex(str_byte(s, i + 1)) * 16 + valor_hex(str_byte(s, i + 2)))
            i = i + 3
        } sino {
            si (b == 43) { str_agregar_byte(r, 32) } sino { str_agregar_byte(r, b) }
            i = i + 1
        }
    }
    retornar dyn_texto(r)
}

// ── SHA-256 y MD5 (aritmética de 32 bits sobre enteros de 64) ─────────────

funcion u32(x) { retornar __y_bits(x, 4294967295) }
funcion rotd32(x, n) { retornar u32(__o_bits(__desplazar_der(x, n), __desplazar_izq(x, 32 - n))) }
funcion roti32(x, n) { retornar u32(__o_bits(__desplazar_izq(x, n), __desplazar_der(x, 32 - n))) }

funcion hex_agregar(r, valor, bytes, invertido) {
    sea i = 0
    mientras (i < bytes) {
        sea desplazamiento = (bytes - 1 - i) * 8
        si (invertido) { desplazamiento = i * 8 }
        sea b = __y_bits(__desplazar_der(valor, desplazamiento), 255)
        str_agregar_byte(r, __o_bits(hex_digito(b / 16), 32))
        str_agregar_byte(r, __o_bits(hex_digito(b % 16), 32))
        i = i + 1
    }
    retornar 0
}

// Mensaje con relleno de 64 bytes; longitud en bits al final (BE o LE).
funcion hash_relleno(s, little) {
    sea r = str_nuevo(str_largo(s) + 72)
    str_agregar(r, s)
    str_agregar_byte(r, 128)
    mientras (str_largo(r) % 64 != 56) { str_agregar_byte(r, 0) }
    sea bits = str_largo(s) * 8
    sea i = 0
    mientras (i < 8) {
        si (little) {
            str_agregar_byte(r, __y_bits(__desplazar_der(bits, i * 8), 255))
        } sino {
            str_agregar_byte(r, __y_bits(__desplazar_der(bits, (7 - i) * 8), 255))
        }
        i = i + 1
    }
    retornar r
}

funcion sha256_k() {
    sea k = mem_global(23)
    si (k != 0) { retornar k }
    k = vec_nuevo()
    sea valores = "428a2f98 71374491 b5c0fbcf e9b5dba5 3956c25b 59f111f1 923f82a4 ab1c5ed5 d807aa98 12835b01 243185be 550c7dc3 72be5d74 80deb1fe 9bdc06a7 c19bf174 e49b69c1 efbe4786 0fc19dc6 240ca1cc 2de92c6f 4a7484aa 5cb0a9dc 76f988da 983e5152 a831c66d b00327c8 bf597fc7 c6e00bf3 d5a79147 06ca6351 14292967 27b70a85 2e1b2138 4d2c6dfc 53380d13 650a7354 766a0abb 81c2c92e 92722c85 a2bfe8a1 a81a664b c24b8b70 c76c51a3 d192e819 d6990624 f40e3585 106aa070 19a4c116 1e376c08 2748774c 34b0bcb5 391c0cb3 4ed8aa4a 5b9cca4f 682e6ff3 748f82ee 78a5636f 84c87814 8cc70208 90befffa a4506ceb bef9a3f7 c67178f2"
    sea i = 0
    mientras (i < str_largo(valores)) {
        sea v = 0
        sea j = 0
        mientras (j < 8) {
            v = v * 16 + valor_hex(str_byte(valores, i + j))
            j = j + 1
        }
        vec_agregar(k, v)
        i = i + 9
    }
    mem_fijar_global(23, k)
    retornar k
}

funcion cfv_sha256(t) {
    sea m = hash_relleno(dyn_a_str(t), 0)
    sea k = sha256_k()
    sea h = vec_nuevo()
    vec_agregar(h, 1779033703)
    vec_agregar(h, 3144134277)
    vec_agregar(h, 1013904242)
    vec_agregar(h, 2773480762)
    vec_agregar(h, 1359893119)
    vec_agregar(h, 2600822924)
    vec_agregar(h, 528734635)
    vec_agregar(h, 1541459225)
    sea w = vec_nuevo()
    sea i = 0
    mientras (i < 64) {
        vec_agregar(w, 0)
        i = i + 1
    }
    sea bloque = 0
    mientras (bloque < str_largo(m)) {
        i = 0
        mientras (i < 16) {
            sea p = bloque + i * 4
            vec_fijar(w, i, str_byte(m, p) * 16777216 + str_byte(m, p + 1) * 65536 + str_byte(m, p + 2) * 256 + str_byte(m, p + 3))
            i = i + 1
        }
        mientras (i < 64) {
            sea w15 = vec_obtener(w, i - 15)
            sea w2 = vec_obtener(w, i - 2)
            sea s0 = __xo_bits(__xo_bits(rotd32(w15, 7), rotd32(w15, 18)), __desplazar_der(w15, 3))
            sea s1 = __xo_bits(__xo_bits(rotd32(w2, 17), rotd32(w2, 19)), __desplazar_der(w2, 10))
            vec_fijar(w, i, u32(vec_obtener(w, i - 16) + s0 + vec_obtener(w, i - 7) + s1))
            i = i + 1
        }
        sea a = vec_obtener(h, 0)
        sea b = vec_obtener(h, 1)
        sea c = vec_obtener(h, 2)
        sea d = vec_obtener(h, 3)
        sea e = vec_obtener(h, 4)
        sea f = vec_obtener(h, 5)
        sea g = vec_obtener(h, 6)
        sea hh = vec_obtener(h, 7)
        i = 0
        mientras (i < 64) {
            sea S1 = __xo_bits(__xo_bits(rotd32(e, 6), rotd32(e, 11)), rotd32(e, 25))
            sea ch = __xo_bits(__y_bits(e, f), __y_bits(__xo_bits(e, 4294967295), g))
            sea t1 = u32(hh + S1 + ch + vec_obtener(k, i) + vec_obtener(w, i))
            sea S0 = __xo_bits(__xo_bits(rotd32(a, 2), rotd32(a, 13)), rotd32(a, 22))
            sea mayoria = __xo_bits(__xo_bits(__y_bits(a, b), __y_bits(a, c)), __y_bits(b, c))
            sea t2 = u32(S0 + mayoria)
            hh = g
            g = f
            f = e
            e = u32(d + t1)
            d = c
            c = b
            b = a
            a = u32(t1 + t2)
            i = i + 1
        }
        vec_fijar(h, 0, u32(vec_obtener(h, 0) + a))
        vec_fijar(h, 1, u32(vec_obtener(h, 1) + b))
        vec_fijar(h, 2, u32(vec_obtener(h, 2) + c))
        vec_fijar(h, 3, u32(vec_obtener(h, 3) + d))
        vec_fijar(h, 4, u32(vec_obtener(h, 4) + e))
        vec_fijar(h, 5, u32(vec_obtener(h, 5) + f))
        vec_fijar(h, 6, u32(vec_obtener(h, 6) + g))
        vec_fijar(h, 7, u32(vec_obtener(h, 7) + hh))
        bloque = bloque + 64
    }
    sea r = str_nuevo(64)
    i = 0
    mientras (i < 8) {
        hex_agregar(r, vec_obtener(h, i), 4, 0)
        i = i + 1
    }
    retornar dyn_texto(r)
}

funcion md5_tablas() {
    sea t = mem_global(24)
    si (t != 0) { retornar t }
    t = vec_nuevo()
    // K[i] = floor(|sin(i + 1)| · 2^32)
    sea i = 0
    mientras (i < 64) {
        sea s = f_abs(f_seno(f_(i + 1)))
        vec_agregar(t, __f64_a_entero(__f64_mul(s, f_(4294967296))))
        i = i + 1
    }
    mem_fijar_global(24, t)
    retornar t
}

funcion md5_desplazamiento(i) {
    sea ronda = i / 16
    sea j = i % 4
    si (ronda == 0) {
        si (j == 0) { retornar 7 }
        si (j == 1) { retornar 12 }
        si (j == 2) { retornar 17 }
        retornar 22
    }
    si (ronda == 1) {
        si (j == 0) { retornar 5 }
        si (j == 1) { retornar 9 }
        si (j == 2) { retornar 14 }
        retornar 20
    }
    si (ronda == 2) {
        si (j == 0) { retornar 4 }
        si (j == 1) { retornar 11 }
        si (j == 2) { retornar 16 }
        retornar 23
    }
    si (j == 0) { retornar 6 }
    si (j == 1) { retornar 10 }
    si (j == 2) { retornar 15 }
    retornar 21
}

funcion cfv_md5(t) {
    sea m = hash_relleno(dyn_a_str(t), 1)
    sea k = md5_tablas()
    sea a0 = 1732584193
    sea b0 = 4023233417
    sea c0 = 2562383102
    sea d0 = 271733878
    sea palabras = vec_nuevo()
    sea i = 0
    mientras (i < 16) {
        vec_agregar(palabras, 0)
        i = i + 1
    }
    sea bloque = 0
    mientras (bloque < str_largo(m)) {
        i = 0
        mientras (i < 16) {
            sea p = bloque + i * 4
            vec_fijar(palabras, i, str_byte(m, p) + str_byte(m, p + 1) * 256 + str_byte(m, p + 2) * 65536 + str_byte(m, p + 3) * 16777216)
            i = i + 1
        }
        sea a = a0
        sea b = b0
        sea c = c0
        sea d = d0
        i = 0
        mientras (i < 64) {
            sea f = 0
            sea g = 0
            si (i < 16) {
                f = __o_bits(__y_bits(b, c), __y_bits(__xo_bits(b, 4294967295), d))
                g = i
            } sino {
                si (i < 32) {
                    f = __o_bits(__y_bits(d, b), __y_bits(__xo_bits(d, 4294967295), c))
                    g = (5 * i + 1) % 16
                } sino {
                    si (i < 48) {
                        f = __xo_bits(__xo_bits(b, c), d)
                        g = (3 * i + 5) % 16
                    } sino {
                        f = __xo_bits(c, __o_bits(b, __xo_bits(d, 4294967295)))
                        g = (7 * i) % 16
                    }
                }
            }
            f = u32(f + a + vec_obtener(k, i) + vec_obtener(palabras, g))
            a = d
            d = c
            c = b
            b = u32(b + roti32(f, md5_desplazamiento(i)))
            i = i + 1
        }
        a0 = u32(a0 + a)
        b0 = u32(b0 + b)
        c0 = u32(c0 + c)
        d0 = u32(d0 + d)
        bloque = bloque + 64
    }
    sea r = str_nuevo(32)
    hex_agregar(r, a0, 4, 1)
    hex_agregar(r, b0, 4, 1)
    hex_agregar(r, c0, 4, 1)
    hex_agregar(r, d0, 4, 1)
    retornar dyn_texto(r)
}

// ── Archivos ──────────────────────────────────────────────────────────────

funcion leer_archivo(ruta) { retornar dyn_texto(archivo_leer(dyn_texto_de(ruta, "leer_archivo"))) }

funcion escribir_archivo(ruta, contenido) {
    archivo_escribir(dyn_texto_de(ruta, "escribir_archivo"), dyn_a_str(contenido))
    retornar 0
}

funcion existe_archivo(ruta) {
    sea fd = sys_abrir(str_c(dyn_texto_de(ruta, "existe_archivo")), sys_abrir_lectura(), 0)
    si (fd < 0) { retornar 2 }
    sys_cerrar(fd)
    retornar 4
}

// ── Tiempo (clock_gettime) ────────────────────────────────────────────────

funcion sys_reloj_ns() {
    sea ts = mem_reservar(16)
    __syscall(228, 0, ts)                                      // CLOCK_REALTIME
    sea ns = __cargar64(ts) * 1000000000 + __cargar64(ts + 8)
    mem_liberar(ts)
    retornar ns
}

funcion cfv_fecha_ahora_ms() { retornar dyn_entero(sys_reloj_ns() / 1000000) }

// Fecha civil (UTC) a partir de días desde 1970 (algoritmo de H. Hinnant).
funcion cfv_fecha_ahora() {
    sea segundos = sys_reloj_ns() / 1000000000
    sea dias = segundos / 86400
    sea resto = segundos % 86400
    sea z = dias + 719468
    sea era = z / 146097
    sea doe = z - era * 146097
    sea yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    sea y = yoe + era * 400
    sea doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    sea mp = (5 * doy + 2) / 153
    sea d = doy - (153 * mp + 2) / 5 + 1
    sea m = mp + 3
    si (m > 12) { m = m - 12 }
    si (m <= 2) { y = y + 1 }
    sea r = map_nuevo()
    map_fijar(r, "anio", dyn_entero(y))
    map_fijar(r, "mes", dyn_entero(m))
    map_fijar(r, "dia", dyn_entero(d))
    map_fijar(r, "hora", dyn_entero(resto / 3600))
    map_fijar(r, "minuto", dyn_entero((resto % 3600) / 60))
    map_fijar(r, "segundo", dyn_entero(resto % 60))
    map_fijar(r, "dia_semana", dyn_entero((dias + 3) % 7))       // 0 = lunes
    retornar dyn_caja(3, r)
}

// ── Sistema y rutas ───────────────────────────────────────────────────────

funcion sys_nucleos() {
    sea mascara = mem_reservar(128)
    mem_llenar(mascara, 0, 128)
    sea n = __syscall(204, 0, 128, mascara)                    // sched_getaffinity
    sea total = 0
    si (n > 0) {
        sea i = 0
        mientras (i < n) {
            sea b = __cargar8(mascara + i)
            mientras (b > 0) {
                total = total + __y_bits(b, 1)
                b = __desplazar_der(b, 1)
            }
            i = i + 1
        }
    }
    mem_liberar(mascara)
    si (total < 1) { total = 1 }
    retornar total
}

funcion sys_info() {
    sea r = map_nuevo()
    map_fijar(r, "sistema", dyn_texto("linux"))
    map_fijar(r, "cpu", dyn_texto("x86_64"))
    map_fijar(r, "nucleos", dyn_entero(sys_nucleos()))
    retornar dyn_caja(3, r)
}

funcion ruta_nombre(ruta) {
    sea s = dyn_texto_de(ruta, "ruta_nombre")
    sea i = str_largo(s)
    mientras (i > 0 y str_byte(s, i - 1) != 47) { i = i - 1 }
    retornar dyn_texto(str_rebanar(s, i, str_largo(s)))
}

funcion ruta_extension(ruta) {
    sea s = dyn_dato(ruta_nombre(ruta))
    sea i = str_largo(s)
    mientras (i > 0 y str_byte(s, i - 1) != 46) { i = i - 1 }
    si (i <= 1) { retornar dyn_texto("") }
    retornar dyn_texto(str_rebanar(s, i - 1, str_largo(s)))
}

// ── Listas y mapas ────────────────────────────────────────────────────────

funcion insertar(lista, posicion, v) {
    si (dyn_tipo(lista) != 2) { dyn_error_tipo("insertar", lista) }
    sea l = dyn_dato(lista)
    sea p = dyn_valor_entero(posicion)
    si (p < 0 o p > vec_largo(l)) { dyn_error("insertar: posición inválida") }
    vec_agregar(l, 0)
    sea i = vec_largo(l) - 1
    mientras (i > p) {
        vec_fijar(l, i, vec_obtener(l, i - 1))
        i = i - 1
    }
    vec_fijar(l, p, v)
    retornar 0
}

funcion eliminar(lista, posicion) {
    si (dyn_tipo(lista) != 2) { dyn_error_tipo("eliminar", lista) }
    sea l = dyn_dato(lista)
    sea p = dyn_valor_entero(posicion)
    si (p < 0 o p >= vec_largo(l)) { dyn_error("eliminar: posición inválida") }
    sea v = vec_obtener(l, p)
    sea i = p
    mientras (i + 1 < vec_largo(l)) {
        vec_fijar(l, i, vec_obtener(l, i + 1))
        i = i + 1
    }
    vec_quitar_ultimo(l)
    retornar v
}

funcion mapa_claves(m) { retornar claves(m) }

// ── Conversión de valores para extern (ABI System V AMD64) ────────────────

funcion dyn_entero_c(v) {
    sea t = dyn_tipo(v)
    si (t == 6) { retornar dyn_valor_entero(v) }
    si (t == 5) { retornar v == 4 }
    si (t == 0) { retornar 0 }
    si (t == 4) { retornar __f64_a_entero(dyn_dato(v)) }
    dyn_error_tipo("extern: se esperaba un número entero", v)
    retornar 0
}

// char* terminado en cero (los textos del runtime ya lo están).
funcion dyn_texto_c(v) {
    si (v == 0) { retornar 0 }
    retornar str_datos(dyn_texto_de(v, "extern: se esperaba texto"))
}

funcion dyn_texto_desde_c(p) {
    si (p == 0) { retornar 0 }
    retornar dyn_texto(str_desde_c(p))
}

funcion dyn_simbolo_faltante(simbolo, biblioteca) {
    sea m = str_concatenar("extern: no se encontró el símbolo '", simbolo)
    str_agregar(m, "' en ")
    str_agregar(m, biblioteca)
    dyn_error(m)
    retornar 0
}

// ── Programa: argumentos, entrada y salida ────────────────────────────────

funcion argumentos_programa() {
    sea r = vec_nuevo()
    sea i = 1
    mientras (i < rt_argc()) {
        vec_agregar(r, dyn_texto(rt_argumento(i)))
        i = i + 1
    }
    retornar dyn_caja(2, r)
}

funcion argumentos() { retornar argumentos_programa() }

// Lee una línea de la entrada estándar (sin el salto final); nulo al final.
funcion leer(mensaje) {
    si (mensaje != 0) { rt_escribir_texto(1, dyn_a_str(mensaje)) }
    sea r = str_nuevo(64)
    sea b = mem_reservar(8)
    sea leidos = 0
    sea seguir = 1
    mientras (seguir) {
        sea n = sys_leer(0, b, 1)
        si (n <= 0) {
            seguir = 0
        } sino {
            leidos = leidos + 1
            si (__cargar8(b) == 10) { seguir = 0 } sino { str_agregar_byte(r, __cargar8(b)) }
        }
    }
    mem_liberar(b)
    si (leidos == 0) { retornar 0 }
    retornar dyn_texto(r)
}

funcion salir(codigo) {
    sea c = 0
    si (__y_bits(codigo, 1) == 1) { c = dyn_valor_entero(codigo) }
    sys_salir(c)
    retornar 0
}

funcion numero_a_texto(v) { retornar a_texto(v) }
funcion subcadena(t, inicio, fin) { retornar subtexto(t, inicio, fin) }
