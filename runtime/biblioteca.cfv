funcion dotnet_llamar(f, args) {
    sea r = dotnet_crudo(f, args)
    retornar dyn_entero(r)
}

funcion dotnet_llamar_texto(f, args) {
    sea r = dotnet_crudo(f, args)
    si (r == 0) { retornar 0 }
    retornar dyn_texto(str_desde_c(r))
}

/// Valor de una variable de entorno, o nulo si no existe.
funcion variable_entorno(nombre) {
    sea v = sys_variable_entorno(dyn_texto_de(nombre, "variable_entorno"))
    si (v == 0) { retornar 0 }
    retornar dyn_texto(v)
