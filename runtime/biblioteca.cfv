    si (raiz == 0) { dyn_error("dotnet: no encontré .NET (instala el SDK o el runtime, o define DOTNET_ROOT)") }
    sea sep = dotnet_separador()
    sea fxr = str_concatenar(raiz, str_concatenar(sep, str_concatenar("host", str_concatenar(sep, "fxr"))))
    sea version_fxr = dotnet_ultima(fxr)
    sea lib = "libhostfxr.so"
    si (__plataforma() == 2 o __plataforma() == 3) { lib = "libhostfxr.dylib" }
    si (__plataforma() == 1) { lib = "hostfxr.dll" }
    sea h = dyn_abrir_biblioteca(str_concatenar(fxr, str_concatenar(sep, str_concatenar(version_fxr, str_concatenar(sep, lib)))))
    si (h == 0) { dyn_error("dotnet: no se pudo cargar hostfxr") }
    // runtimeconfig.json con la versión instalada de Microsoft.NETCore.App.
    sea compartido = str_concatenar(raiz, str_concatenar(sep, str_concatenar("shared", str_concatenar(sep, "Microsoft.NETCore.App"))))
    sea version = dotnet_ultima(compartido)
    si (version == 0) { dyn_error("dotnet: falta Microsoft.NETCore.App") }
    sea mayor = str_nuevo(8)
    sea k = 0
    mientras (k < str_largo(version) y str_byte(version, k) != 46) {
        str_agregar_byte(mayor, str_byte(version, k))
        k = k + 1
    }
    sea json = str_concatenar("{\"runtimeOptions\":{\"tfm\":\"net", mayor)
    str_agregar(json, ".0\",\"framework\":{\"name\":\"Microsoft.NETCore.App\",\"version\":\"")
    str_agregar(json, version)
    str_agregar(json, "\"}}}")
    sea config = str_concatenar(sys_ruta_temporal(), str_concatenar("cforge-dotnet-", str_concatenar(str_desde_entero(sys_proceso_id()), ".runtimeconfig.json")))
    archivo_escribir(config, json)
    sea iniciar = sys_simbolo(h, "hostfxr_initialize_for_runtime_config")
    sea delegado = sys_simbolo(h, "hostfxr_get_runtime_delegate")
    si (iniciar == 0 o delegado == 0) { dyn_error("dotnet: hostfxr sin las funciones de hospedaje") }
    sea manija = mem_reservar(8)
    __guardar64(manija, 0)
    sea rc = __y_bits(__ccall(iniciar, dotnet_ruta_nativa(config), 0, manija), 4294967295)
    sys_borrar(str_c(config))
    si (rc > 2) { dyn_error("dotnet: no se pudo iniciar el runtime de .NET") }
    sea f = mem_reservar(8)
    __guardar64(f, 0)
    rc = __y_bits(__ccall(delegado, __cargar64(manija), 5, f), 4294967295)   // hdt_load_assembly_and_get_function_pointer
    si (rc != 0 o __cargar64(f) == 0) { dyn_error("dotnet: no se pudo obtener el cargador de ensamblados") }
    mem_fijar_global(52, __cargar64(f))
    mem_fijar_global(53, h)
    retornar 4
}

funcion dotnet_funcion(dll, tipo, metodo) {
    sea cargar = mem_global(52)
    si (cargar == 0) { dyn_error("dotnet: llama primero a dotnet_iniciar()") }
    sea ruta = dyn_texto_de(dll, "dotnet_funcion")
    si (dyn_verdad(existe_archivo(dll)) == 0) { dyn_error(str_concatenar("dotnet: no existe ", ruta)) }
