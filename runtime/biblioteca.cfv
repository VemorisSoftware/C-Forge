funcion dotnet_argumentos(args) {
    sea v = mem_reservar(56)
    mem_llenar(v, 0, 56)
    si (args == 0) { retornar v }
    si (dyn_tipo(args) != 2) { dyn_error("dotnet: los argumentos van en una lista") }
    sea l = dyn_dato(args)
    si (vec_largo(l) > 6) { dyn_error("dotnet: como máximo 6 argumentos") }
