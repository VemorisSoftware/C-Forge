    si (t == 90) { retornar 39 }
    si (t == 73 o t == 83 o t == 66 o t == 67) { retornar 51 }
    si (t == 74) { retornar 54 }
    si (t == 86) { retornar 63 }
    si (t == 68 o t == 70) { dyn_error("java: un método que devuelve decimal (D/F) todavía no se puede llamar; envuélvelo en String.valueOf") }
