// ── C# / .NET (hostfxr): el runtime de .NET dentro del programa ───────────
// dotnet_iniciar() carga .NET (DOTNET_ROOT o rutas habituales);
// dotnet_funcion(dll, "Espacio.Clase, Ensamblado", "Metodo") devuelve el
// puntero de un método static marcado [UnmanagedCallersOnly] y
// dotnet_llamar(f, args) lo llama con hasta 6 argumentos enteros, largos o
// punteros (un texto se pasa como char* UTF-8) y devuelve un entero;
// dotnet_llamar_texto(f, args) hace lo mismo y lee el IntPtr devuelto como
// texto UTF-8 (Marshal.StringToCoTaskMemUTF8). Globales 52 = función para
// cargar ensamblados, 53 = handle de hostfxr.

funcion dotnet_ruta_nativa(s) {
    // char_t: UTF-16 en Windows (ASCII ampliado byte a byte), UTF-8 en el resto.
    si (__plataforma() != 1) { retornar str_c(s) }
    sea n = str_largo(s)
    sea r = mem_reservar(n * 2 + 2)
    sea i = 0
    mientras (i < n) {
        __guardar8(r + i * 2, str_byte(s, i))
        __guardar8(r + i * 2 + 1, 0)
        i = i + 1
    }
    __guardar8(r + n * 2, 0)
    __guardar8(r + n * 2 + 1, 0)
    retornar r
}

funcion dotnet_separador() { si (__plataforma() == 1) { retornar "\\" } retornar "/" }

// ¿"10.0.1" > "8.0.34"? Compara número a número.
funcion dotnet_version_mayor(a, b) {
    sea i = 0
    sea j = 0
    mientras (i < str_largo(a) o j < str_largo(b)) {
        sea x = 0
        mientras (i < str_largo(a) y str_byte(a, i) >= 48 y str_byte(a, i) <= 57) {
            x = x * 10 + str_byte(a, i) - 48
            i = i + 1
        }
        sea y = 0
        mientras (j < str_largo(b) y str_byte(b, j) >= 48 y str_byte(b, j) <= 57) {
            y = y * 10 + str_byte(b, j) - 48
            j = j + 1
        }
        si (x != y) { retornar x > y }
        // Salta el separador (o cualquier otro carácter).
        si (i < str_largo(a)) { i = i + 1 }
        si (j < str_largo(b)) { j = j + 1 }
    }
    retornar 0
}

// Primera carpeta (orden alfabético inverso: la versión más nueva) dentro de dir.
funcion dotnet_ultima(dir) {
    sea nombres = sys_listar(dir)
    si (nombres == 0) { retornar 0 }
    sea mejor = 0
    sea i = 0
    mientras (i < vec_largo(nombres)) {
        sea n = vec_obtener(nombres, i)
        si (str_igual(n, ".") == 0 y str_igual(n, "..") == 0) {
            si (mejor == 0 o dotnet_version_mayor(n, mejor)) { mejor = n }
        }
        i = i + 1
    }
    retornar mejor
}

funcion dotnet_raiz() {
    sea candidatos = vec_nuevo()
    sea e = sys_variable_entorno("DOTNET_ROOT")
    si (e != 0) { vec_agregar(candidatos, e) }
    vec_agregar(candidatos, "/usr/lib/dotnet")
    vec_agregar(candidatos, "/usr/share/dotnet")
    vec_agregar(candidatos, "/usr/local/share/dotnet")
    vec_agregar(candidatos, "/opt/homebrew/opt/dotnet/libexec")
    vec_agregar(candidatos, "C:\\Program Files\\dotnet")
    sea casa = sys_variable_entorno("HOME")
    si (casa != 0) { vec_agregar(candidatos, str_concatenar(casa, "/.dotnet")) }
    sea i = 0
    mientras (i < vec_largo(candidatos)) {
        sea r = vec_obtener(candidatos, i)
        si (dotnet_ultima(str_concatenar(r, str_concatenar(dotnet_separador(), str_concatenar("host", str_concatenar(dotnet_separador(), "fxr"))))) != 0) { retornar r }
        i = i + 1
    }
    retornar 0
}

funcion dotnet_iniciar() {
