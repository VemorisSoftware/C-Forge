// Cubo 3D con textura, luz y texto, rasterizado en C-Forge y mostrado en un
// <canvas> (sin WebGL: el mismo código corre igual en nativo).
//   cforge build cubo3d.cfv --target wasm --release -o cubo3d
//   (sirve la carpeta con cualquier servidor estático y abre index.html)
importar "navegador"
importar "graficos"
importar "modelo"
importar "fuente"

sea l = lienzo_crear(480, 320)
sea cubo = malla_cubo(1.3)
sea esfera = malla_esfera(0.35, 18, 12)
sea cam = camara3d([0, 1.2, 3.4], [0, 0, 0], 55)
sea damero = imagen_nueva(8, 8)
para y en rango(8) { para x en rango(8) { si ((x + y) % 2 == 0) { imagen_fijar_pixel(damero, x, y, [245, 245, 245]) } sino { imagen_fijar_pixel(damero, x, y, [234, 88, 12]) } } }
sea cuadros = 0
sea t0 = nav_tiempo()

nav_animar(funcion(t) {
    sea ang = (t - t0) / 20
    lienzo_limpiar(l, [9, 9, 11])
    lienzo_malla(l, cubo, m4_mul(m4_rotacion_y(ang), m4_rotacion_x(ang * 0.6)), cam, {"textura": damero, "suave": falso})
    lienzo_malla(l, esfera, m4_mul(m4_rotacion_y(0 - ang * 2), m4_traslacion(1.5, 0, 0)), cam, {"color": [96, 165, 250]})
    cuadros = cuadros + 1
    sea fps = piso(cuadros * 1000 / maximo(1, t - t0))
    lienzo_texto(l, nulo, "C-Forge 3D por software - " + fps + " FPS", 8, 6, 12, [244, 244, 245])
    nav_mostrar_lienzo("#lienzo", l)
})
