// Partículas interactivas en el navegador, escritas en C-Forge.
//   cforge build particulas.cfv --target wasm --release -o particulas
//   (sirve la carpeta con cualquier servidor estático y abre index.html)
// Un núcleo de partículas que gira; el mouse lo empuja y el scroll lo
// abre en un anillo. Física en enteros (milésimas) a 60 FPS.
importar "navegador"

sea N = 12000
sea X = []
sea Y = []
sea Z = []
sea CALOR = []
sea VX = []
sea VY = []
sea BX = []
sea BY = []
sea BZ = []
sea semilla = 42
funcion azar(n) {
    semilla = (semilla * 1103515245 + 12345) % 2147483648
    retornar semilla % n
}
sea SENO = []
para i en rango(4096) { SENO.agregar(piso(seno(i * 2 * pi() / 4096) * 1024 + 0.5)) }

// Esfera de Fibonacci (radio 1100).
para i en rango(N) {
    sea y = 1 - (i / (N - 1.0)) * 2
    sea r = raiz(1 - y * y)
    sea th = i * 2.399963
    BX.agregar(piso(coseno(th) * r * 1100))
    BY.agregar(piso(y * 1100))
    BZ.agregar(piso(seno(th) * r * 1100))
    X.agregar(azar(8000) - 4000)
    Y.agregar(azar(8000) - 4000)
    Z.agregar(0)
    VX.agregar(0)
    VY.agregar(0)
    CALOR.agregar(0)
}

funcion cuadro(t) {
    // Mouse en coordenadas del mundo (milésimas): ±2.8 de ancho visible.
    sea ancho = nav_ancho()
    sea alto = nav_alto()
    sea mx = cociente((nav_mouse_x() * 2 - ancho) * 2800, alto)
    sea my = cociente((alto - nav_mouse_y() * 2) * 2800, alto)
    sea apertura = nav_scroll()
    sea giro = cociente(t * 1024, 6000)
    sea ca = SENO[bits_y(giro + 1024, 4095)]
    sea sa = SENO[bits_y(giro, 4095)]
    sea i = 0
    mientras (i < N) {
        sea bx = BX[i]
        sea by = BY[i]
        sea bz = BZ[i]
        // Con scroll el núcleo se aplana en un anillo.
        by = by - cociente(by * apertura, 1100)
        sea tx = cociente(bx * ca - bz * sa, 1024)
        sea tz = cociente(bx * sa + bz * ca, 1024)
        sea x = X[i]
        sea y = Y[i]
        sea vx = VX[i] + cociente((tx - x) * 36, 1024)
        sea vy = VY[i] + cociente((by - y) * 36, 1024)
        sea dx = x - mx
        sea dy = y - my
        si (dx > 0 - 1000 y dx < 1000 y dy > 0 - 1000 y dy < 1000) {
            sea w = 1000 - cociente(dx * dx + dy * dy, 1000)
            si (w > 0) {
                vx = vx + cociente(dx * w, 8192)
                vy = vy + cociente(dy * w, 8192)
            }
        }
        vx = cociente(vx * 901, 1024)
        vy = cociente(vy * 901, 1024)
        X[i] = x + vx
        Y[i] = y + vy
        Z[i] = tz
        sea rapidez = vx + vy
        si (vx < 0) { rapidez = rapidez - vx - vx }
        si (vy < 0) { rapidez = rapidez - vy - vy }
        CALOR[i] = minimo(1000, rapidez * 5)
        i = i + 1
    }
    nav_particulas("#lienzo", X, Y, Z, CALOR)
}

nav_animar(cuadro)
nav_texto("#motor", "física en C-Forge → WebAssembly · " + N + " partículas")
