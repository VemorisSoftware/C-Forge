// ejemplos/web/tablero — tablero con tarjetas arrastrables y ventana de
// detalle que se cierra con Escape. Todo en C-Forge: sin .css ni .js aparte.
//   cforge build tablero.cfv --target wasm --html -o tablero
importar "navegador"

nav_css("
body { font-family: system-ui, sans-serif; margin: 0; padding: 24px; background: #f4f5f7; color: #1d1d1f; }
h1 { font-size: 20px; margin: 0 0 16px; }
#tablero { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.columna { background: #e9ebef; border-radius: 10px; padding: 12px; min-height: 220px; transition: background .15s; }
.columna.sobre { background: #d5e3ff; }
.columna h2 { font-size: 14px; margin: 0 0 10px; color: #555; }
.tarjeta { background: #fff; border-radius: 8px; padding: 10px 12px; margin-bottom: 8px; box-shadow: 0 1px 2px #0002; cursor: grab; }
.tarjeta.arrastrando { opacity: .4; }
#detalle { position: fixed; inset: 0; background: #0006; display: none; align-items: center; justify-content: center; }
#detalle.abierto { display: flex; }
#detalle > div { background: #fff; border-radius: 12px; padding: 24px; min-width: 280px; }
")

sea columnas = ["Pendiente", "En curso", "Listo"]
sea tareas = [
    {"id": "t1", "titulo": "Diseñar portada", "columna": 0},
    {"id": "t2", "titulo": "Escribir textos", "columna": 0},
    {"id": "t3", "titulo": "Revisar fotos", "columna": 1}
]

funcion buscar(id) {
    para t en tareas { si (t["id"] == id) { retornar t } }
    retornar nulo
}

funcion dibujar() {
    sea html = "<h1>Tablero</h1><div id=\"tablero\">"
    sea i = 0
    mientras (i < longitud(columnas)) {
        html = html + "<div class=\"columna\" id=\"c" + i + "\"><h2>" + columnas[i] + "</h2>"
        para t en tareas {
            si (t["columna"] == i) { html = html + "<div class=\"tarjeta\" id=\"" + t["id"] + "\">" + t["titulo"] + "</div>" }
        }
        html = html + "</div>"
        i = i + 1
    }
    html = html + "</div><div id=\"detalle\"><div><h2 id=\"detalle-titulo\"></h2><p id=\"detalle-columna\"></p><p>Escape para cerrar</p></div></div>"
    nav_html("body", html)
}

dibujar()

// Arrastrar una tarjeta a otra columna.
nav_al_soltar(".tarjeta", ".columna", funcion(x) {
    sea t = buscar(nav_evento("origen"))
    si (t != nulo) {
        t["columna"] = a_numero(subcadena(nav_evento("destino"), 1, 2))
        dibujar()
    }
})

// Clic en una tarjeta: ventana de detalle. Escape la cierra.
nav_al_hacer("body", "click", funcion(x) {
    sea t = buscar(nav_evento("id"))
    si (t != nulo) {
        nav_texto("#detalle-titulo", t["titulo"])
        nav_texto("#detalle-columna", "Columna: " + columnas[t["columna"]])
        nav_clase("#detalle", "abierto", verdadero)
    }
})
nav_al_tecla("Escape", funcion(x) { nav_clase("#detalle", "abierto", falso) })
