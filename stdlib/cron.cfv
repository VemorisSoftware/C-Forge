// stdlib/cron.cfv — expresiones cron: nombres en inglés del módulo "reloj".
// English names for the "reloj" module; both can be used together.

importar "reloj"

funcion cron_parse(expr, desfase_min) { retornar reloj_cron(expr, desfase_min) }
funcion cron_matches(c, ms) { retornar reloj_coincide(c, ms) }
funcion cron_next(c, ms) { retornar reloj_siguiente(c, ms) }
funcion cron_upcoming(c, ms, n) { retornar reloj_proximas(c, ms, n) }
funcion cron_format(c, ms) { retornar reloj_formato(c, ms) }
funcion cron_schedule(c, f, veces) { retornar reloj_programar(c, f, veces) }
