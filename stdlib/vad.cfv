// stdlib/vad.cfv — detección de voz (VAD de WebRTC): nombres en inglés del módulo "voz_activa".
// English names for the "voz_activa" module; both can be used together.

importar "voz_activa"

funcion _vad_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_vad_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _vad_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _VAD_RES = {"inicio_ms": "start_ms", "fin_ms": "end_ms"}

funcion vad_new(modo) { retornar voz_nuevo(modo) }
funcion vad_compat_48k(v, activo) { retornar voz_compat_48k(v, activo) }
funcion vad_set_mode(v, modo) { retornar voz_modo(v, modo) }
funcion vad_samples(pcm) { retornar voz_muestras(pcm) }
funcion vad_valid_frame(frecuencia, n) { retornar voz_cuadro_valido(frecuencia, n) }
funcion vad_is_speech(v, cuadro, frecuencia) { retornar voz_hay(v, cuadro, frecuencia) }
funcion vad_frames(pcm, frecuencia, ms) { retornar voz_cuadros(pcm, frecuencia, ms) }
funcion vad_decisions(v, pcm, frecuencia, ms) { retornar voz_decisiones(v, pcm, frecuencia, ms) }
funcion vad_segments(v, pcm, frecuencia, ms, relleno_ms) { retornar _vad_tr(voz_segmentos(v, pcm, frecuencia, ms, relleno_ms), _VAD_RES) }
