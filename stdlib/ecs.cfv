// stdlib/ecs.cfv — Entidad-Componente-Sistema: nombres en inglés del módulo "elenco".
// English names for the "elenco" module; both can be used together.

importar "elenco"

funcion ecs_world() { retornar elenco_mundo() }
funcion ecs_spawn(m, componentes) { retornar elenco_crear(m, componentes) }
funcion ecs_alive(m, e) { retornar elenco_vive(m, e) }
funcion ecs_insert(m, e, nombre, datos) { retornar elenco_poner(m, e, nombre, datos) }
funcion ecs_get(m, e, nombre) { retornar elenco_obtener(m, e, nombre) }
funcion ecs_has(m, e, nombre) { retornar elenco_tiene(m, e, nombre) }
funcion ecs_remove(m, e, nombre) { retornar elenco_quitar(m, e, nombre) }
funcion ecs_despawn(m, e) { retornar elenco_destruir(m, e) }
funcion ecs_query(m, con, sin) { retornar elenco_consultar(m, con, sin) }
funcion ecs_system(m, nombre, con, f, sin) { retornar elenco_sistema(m, nombre, con, f, sin) }
funcion ecs_enable(m, nombre, activo) { retornar elenco_activar(m, nombre, activo) }
funcion ecs_step(m, dt) { retornar elenco_paso(m, dt) }
funcion ecs_count(m) { retornar elenco_cantidad(m) }
funcion ecs_resource(m, nombre, valor) { retornar elenco_recurso(m, nombre, valor) }
funcion ecs_emit(m, nombre, datos) { retornar elenco_emitir(m, nombre, datos) }
funcion ecs_events(m, nombre) { retornar elenco_eventos(m, nombre) }
