// stdlib/telefono.cfv — números de teléfono: limpiar, validar, normalizar a
// E.164 (+56912345678), formatear para mostrar y detectar móvil o fijo.
// Planes de numeración de Chile, Argentina, Perú, Colombia, México, España
// y Estados Unidos/Canadá. Inspirada en libphonenumber (Apache). En inglés:
// importar "phone".
//
//   importar "telefono"
//   sea t = telefono_analizar("9 1234 5678", "CL")
//   t["e164"]            // "+56912345678"
//   t["tipo"]            // "movil"
//   telefono_formatear(t)   // "+56 9 1234 5678"

sea _TF_PAISES = {
    "CL": {"codigo": "56", "largos": [9], "movil": ["9"], "troncal": "", "grupos": [1, 4, 4]},
    "AR": {"codigo": "54", "largos": [10, 11], "movil": ["9"], "troncal": "0", "grupos": [1, 2, 4, 4]},
    "PE": {"codigo": "51", "largos": [8, 9], "movil": ["9"], "troncal": "0", "grupos": [3, 3, 3]},
    "CO": {"codigo": "57", "largos": [10], "movil": ["3"], "troncal": "", "grupos": [3, 3, 4]},
    "MX": {"codigo": "52", "largos": [10], "movil": [], "troncal": "", "grupos": [2, 4, 4]},
    "ES": {"codigo": "34", "largos": [9], "movil": ["6", "7"], "troncal": "", "grupos": [3, 3, 3]},
    "US": {"codigo": "1", "largos": [10], "movil": [], "troncal": "1", "grupos": [3, 3, 4]}
}

funcion _tf_digitos(t) {
    sea r = ""
    para c en texto_dividir("" + t, "") { si (texto_indice("0123456789", c) >= 0) { r = r + c } }
    retornar r
}

funcion _tf_pais_de_codigo(d) {
    // Busca el código de país más largo que calce.
    sea mejor = nulo
    para p en claves(_TF_PAISES) {
        sea c = _TF_PAISES[p]["codigo"]
        si (texto_empieza_con(d, c)) {
            si (mejor == nulo) { mejor = p } sino { si (longitud(c) > longitud(_TF_PAISES[mejor]["codigo"])) { mejor = p } }
        }
    }
    retornar mejor
}

/// Analiza un número escrito como sea. pais: código ISO ("CL") para
/// números sin "+". Devuelve {"valido", "pais", "nacional", "e164", "tipo"}.
funcion telefono_analizar(texto, pais) {
    sea t = texto_recortar("" + texto)
    sea d = _tf_digitos(t)
    sea internacional = texto_empieza_con(t, "+") o texto_empieza_con(d, "00")
    si (texto_empieza_con(d, "00")) { d = subcadena(d, 2, longitud(d)) }
    sea p = pais
    sea nacional = d
    si (internacional) {
        p = _tf_pais_de_codigo(d)
        si (p == nulo) { retornar {"valido": falso, "pais": nulo, "nacional": d, "e164": nulo, "tipo": nulo, "error": "código de país desconocido"} }
        nacional = subcadena(d, longitud(_TF_PAISES[p]["codigo"]), longitud(d))
    } sino {
        si (p == nulo) { retornar {"valido": falso, "pais": nulo, "nacional": d, "e164": nulo, "tipo": nulo, "error": "falta el país"} }
        p = texto_mayusculas(p)
        si (tiene_clave(_TF_PAISES, p) == falso) { lanzar "telefono: país no soportado " + p }
        // Prefijo de país escrito sin "+" (p. ej. 56912345678).
        sea c = _TF_PAISES[p]["codigo"]
        si (texto_empieza_con(d, c) y longitud(d) - longitud(c) == _TF_PAISES[p]["largos"][0]) { nacional = subcadena(d, longitud(c), longitud(d)) }
        sea tr = _TF_PAISES[p]["troncal"]
        si (tr != "" y texto_empieza_con(nacional, tr) y longitud(nacional) > _TF_PAISES[p]["largos"][0]) { nacional = subcadena(nacional, longitud(tr), longitud(nacional)) }
    }
    sea info = _TF_PAISES[p]
    sea ok = falso
    para l en info["largos"] { si (longitud(nacional) == l) { ok = verdadero } }
    // Reglas extra por país.
    si (p == "CL" y ok) { ok = texto_indice("2345679", subcadena(nacional, 0, 1)) >= 0 }
    si (p == "US" y ok) { ok = texto_indice("23456789", subcadena(nacional, 0, 1)) >= 0 y texto_indice("23456789", subcadena(nacional, 3, 4)) >= 0 }
    sea tipo_n = "fijo"
    para m en info["movil"] { si (texto_empieza_con(nacional, m)) { tipo_n = "movil" } }
    si (longitud(info["movil"]) == 0) { tipo_n = "desconocido" }
    sea e164 = nulo
    si (ok) { e164 = "+" + info["codigo"] + nacional }
    retornar {"valido": ok, "pais": p, "codigo": info["codigo"], "nacional": nacional, "e164": e164, "tipo": tipo_n}
}

funcion telefono_valido(texto, pais) { retornar telefono_analizar(texto, pais)["valido"] }

/// "+56 9 1234 5678" (internacional) o "9 1234 5678" (nacional = verdadero).
funcion telefono_formatear(t, nacional) {
    si (t["valido"] == falso) { lanzar "telefono: número inválido" }
    sea info = _TF_PAISES[t["pais"]]
    sea n = t["nacional"]
    sea grupos = info["grupos"]
    // Si sobran o faltan cifras, el primer grupo absorbe la diferencia.
    sea suma = 0
    para g en grupos { suma = suma + g }
    sea partes = []
    sea pos = 0
    sea i = 0
    mientras (i < longitud(grupos)) {
        sea g = grupos[i]
        si (i == 0) { g = g + longitud(n) - suma }
        si (g > 0) { partes.agregar(subcadena(n, pos, pos + g)) }
        pos = pos + g
        i = i + 1
    }
    si (nacional == verdadero) { retornar unir(partes, " ") }
    retornar "+" + info["codigo"] + " " + unir(partes, " ")
}

/// Enlace para WhatsApp (wa.me) o "tel:".
funcion telefono_enlace(t, tipo_e) {
    si (t["valido"] == falso) { lanzar "telefono: número inválido" }
    si (tipo_e == "whatsapp") { retornar "https://wa.me/" + subcadena(t["e164"], 1, longitud(t["e164"])) }
    retornar "tel:" + t["e164"]
}

funcion telefono_paises() { retornar claves(_TF_PAISES) }
