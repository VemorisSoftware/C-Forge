// stdlib/gdal.cfv — Datos geoespaciales (estilo GDAL/OGR): nombres en inglés del módulo "territorio".
// English names for the "territorio" module; both can be used together.

importar "territorio"

funcion gdal_geometry(tipo_g, coordenadas) { retornar territorio_geometria(tipo_g, coordenadas) }
funcion gdal_area(g) { retornar territorio_area(g) }
funcion gdal_contains(g, p) { retornar territorio_contiene(g, p) }
funcion gdal_bounds(g) { retornar territorio_limites(g) }
funcion gdal_layer(campos, prj) { retornar territorio_capa(campos, prj) }
funcion gdal_add_feature(capa, geometria, atributos) { retornar territorio_agregar(capa, geometria, atributos) }
funcion gdal_filter(capa, fn) { retornar territorio_filtrar(capa, fn) }
funcion gdal_map_coordinates(g, f) { retornar territorio_transformar_geometria(g, f) }
funcion gdal_reproject(capa, desde, hacia) { retornar territorio_reproyectar(capa, desde, hacia) }
funcion gdal_to_wkt(g) { retornar territorio_a_wkt(g) }
funcion gdal_from_wkt(t) { retornar territorio_de_wkt(t) }
funcion gdal_to_wkb(g, big_endian) { retornar territorio_a_wkb(g, big_endian) }
funcion gdal_from_wkb(b) { retornar territorio_de_wkb(b) }
funcion gdal_to_geojson(capa) { retornar territorio_a_geojson(capa) }
funcion gdal_from_geojson(texto) { retornar territorio_de_geojson(texto) }
funcion gdal_read_shapefile(ruta) { retornar territorio_leer_shp(ruta) }
funcion gdal_write_shapefile(capa, ruta) { retornar territorio_escribir_shp(capa, ruta) }
