// stdlib/entities.cfv — ECS de alto rendimiento: nombres en inglés del módulo "entidades".
// English names for the "entidades" module; both can be used together.

importar "entidades"

funcion entities_world() { retornar entidades_mundo() }
funcion entities_alive(m, e) { retornar entidades_viva(m, e) }
funcion entities_create(m, componentes) { retornar entidades_crear(m, componentes) }
funcion entities_destroy(m, e) { retornar entidades_destruir(m, e) }
funcion entities_insert(m, e, nombre, datos) { retornar entidades_poner(m, e, nombre, datos) }
funcion entities_remove(m, e, nombre) { retornar entidades_quitar(m, e, nombre) }
funcion entities_has(m, e, nombre) { retornar entidades_tiene(m, e, nombre) }
funcion entities_get(m, e, nombre) { retornar entidades_obtener(m, e, nombre) }
funcion entities_count(m) { retornar entidades_cantidad(m) }
funcion entities_count_with(m, nombre) { retornar entidades_cuantas(m, nombre) }
funcion entities_components(m, e) { retornar entidades_componentes(m, e) }
funcion entities_each(m, con, f, sin) { retornar entidades_cada(m, con, f, sin) }
funcion entities_query(m, con, sin) { retornar entidades_consultar(m, con, sin) }
funcion entities_sort(m, nombre, comparador) { retornar entidades_ordenar(m, nombre, comparador) }
funcion entities_on(m, tipo_, nombre, f) { retornar entidades_al(m, tipo_, nombre, f) }
funcion entities_system(m, nombre, con, f, opciones) { retornar entidades_sistema(m, nombre, con, f, opciones) }
funcion entities_set_enabled(m, nombre, activo) { retornar entidades_activar(m, nombre, activo) }
funcion entities_flush(m) { retornar entidades_aplicar(m) }
funcion entities_step(m, dt) { retornar entidades_paso(m, dt) }
funcion entities_emit(m, tipo_, datos) { retornar entidades_emitir(m, tipo_, datos) }
funcion entities_events(m, tipo_) { retornar entidades_eventos(m, tipo_) }
funcion entities_resource(m, nombre, valor) { retornar entidades_recurso(m, nombre, valor) }
funcion entities_save(m) { retornar entidades_guardar(m) }
funcion entities_load(m, texto) { retornar entidades_cargar(m, texto) }
