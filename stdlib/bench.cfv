// stdlib/bench.cfv — micro-benchmarks: nombres en inglés del módulo "cronometro".
// English names for the "cronometro" module; both can be used together.

importar "cronometro"

/// options: samples (20), target_ms (50), warmup_ms (100).
funcion bench_run(nombre, f, opciones) {
    sea o = {}
    si (opciones != nulo) {
        para k en claves(opciones) { o[k] = opciones[k] }
        si (tiene_clave(opciones, "samples")) { o["muestras"] = opciones["samples"] }
        si (tiene_clave(opciones, "target_ms")) { o["objetivo_ms"] = opciones["target_ms"] }
        si (tiene_clave(opciones, "warmup_ms")) { o["calentamiento_ms"] = opciones["warmup_ms"] }
    }
    retornar _bench_en(cronometro_medir(nombre, f, o))
}
funcion _bench_en(r) {
    retornar {"name": r["nombre"], "samples": r["muestras"], "iterations": r["vueltas"], "mean_ms": r["media_ms"], "median_ms": r["mediana_ms"], "std_ms": r["desviacion_ms"], "min_ms": r["min_ms"], "max_ms": r["max_ms"], "ci95_ms": r["ic95_ms"], "ops_per_s": r["ops_por_s"], "outliers": r["atipicos"], "_es": r}
}

funcion bench_stats(nombre, tiempos, vueltas) { retornar _bench_en(cronometro_estadistica(nombre, tiempos, vueltas)) }
funcion bench_report(r) {
    si (tiene_clave(r, "_es")) { retornar cronometro_texto(r["_es"]) }
    retornar cronometro_texto(r)
}
funcion bench_compare(a, b, opciones) { retornar cronometro_comparar(a, b, opciones) }
