// stdlib/numerica.cfv — estadística y análisis numérico: medias, mediana,
// varianza, percentiles, correlación, regresión lineal, histogramas, FFT,
// integración y raíces. Inspirada en Math.NET / NumPy (MIT/BSD). En
// inglés: importar "numeric".
//
//   importar "numerica"
//   numerica_media([1, 2, 3, 4])                 // 2.5
//   numerica_percentil([1, 2, 3, 4], 90)         // 3.7 (interpolación lineal)
//   numerica_regresion([1, 2, 3], [2, 4, 6.1])   // {"pendiente", "intercepto", "r2"}
//   numerica_fft([1, 0, 0, 0])                   // [[1, 0], [1, 0], [1, 0], [1, 0]]

funcion _nm_no_vacia(xs, que) {
    si (tipo(xs) != "lista" o longitud(xs) == 0) { lanzar "numerica: " + que + " necesita al menos un dato" }
}

/// Suma compensada (Kahan–Neumaier): sin perder decimales en listas largas.
funcion numerica_suma(xs) {
    sea s = 0.0
    sea c = 0.0
    para x en xs {
        sea t = s + x
        si (absoluto(s) >= absoluto(x)) { c = c + ((s - t) + x) } sino { c = c + ((x - t) + s) }
        s = t
    }
    retornar s + c
}

funcion numerica_media(xs) {
    _nm_no_vacia(xs, "la media")
    retornar numerica_suma(xs) / longitud(xs)
}

funcion _nm_ordenados(xs) { retornar ordenar(xs, funcion(a, b) { retornar a - b }) }

funcion numerica_mediana(xs) { retornar numerica_percentil(xs, 50) }

/// Percentil p (0–100) con interpolación lineal (como NumPy por defecto).
funcion numerica_percentil(xs, p) {
    _nm_no_vacia(xs, "el percentil")
    si (p < 0 o p > 100) { lanzar "numerica: percentil entre 0 y 100" }
    sea o = _nm_ordenados(xs)
    sea pos = (longitud(o) - 1) * p / 100
    sea i = piso(pos)
    sea f = pos - i
    si (i + 1 >= longitud(o)) { retornar o[i] }
    retornar o[i] + (o[i + 1] - o[i]) * f
}

/// Valores más frecuentes (lista, por si hay empate), en orden.
funcion numerica_moda(xs) {
    _nm_no_vacia(xs, "la moda")
    sea cuenta = {}
    para x en xs { cuenta["" + x] = (cuenta["" + x] ?? 0) + 1 }
    sea mejor = 0
    para k en claves(cuenta) { si (cuenta[k] > mejor) { mejor = cuenta[k] } }
    sea r = []
    sea vistos = {}
    para x en _nm_ordenados(xs) { si (cuenta["" + x] == mejor y tiene_clave(vistos, "" + x) == falso) { r.agregar(x)  vistos["" + x] = verdadero } }
    retornar r
}

/// Varianza (muestral, n−1, salvo poblacion = verdadero). Algoritmo de Welford.
funcion numerica_varianza(xs, poblacion) {
    _nm_no_vacia(xs, "la varianza")
    sea n = 0
    sea media = 0.0
    sea m2 = 0.0
    para x en xs {
        n = n + 1
        sea d = x - media
        media = media + d / n
        m2 = m2 + d * (x - media)
    }
    si (poblacion == verdadero) { retornar m2 / n }
    si (n < 2) { lanzar "numerica: la varianza muestral necesita al menos 2 datos" }
    retornar m2 / (n - 1)
}

funcion numerica_desviacion(xs, poblacion) { retornar raiz(numerica_varianza(xs, poblacion)) }

funcion numerica_covarianza(xs, ys) {
    si (longitud(xs) != longitud(ys) o longitud(xs) < 2) { lanzar "numerica: listas del mismo largo (al menos 2)" }
    sea mx = numerica_media(xs)
    sea my = numerica_media(ys)
    sea s = []
    sea i = 0
    mientras (i < longitud(xs)) { s.agregar((xs[i] - mx) * (ys[i] - my))  i = i + 1 }
    retornar numerica_suma(s) / (longitud(xs) - 1)
}

/// Correlación de Pearson (−1 a 1).
funcion numerica_correlacion(xs, ys) {
    sea sx = numerica_desviacion(xs)
    sea sy = numerica_desviacion(ys)
    si (sx == 0 o sy == 0) { lanzar "numerica: correlación indefinida (un lado es constante)" }
    retornar numerica_covarianza(xs, ys) / (sx * sy)
}

/// Mínimos cuadrados y = pendiente·x + intercepto, con R².
funcion numerica_regresion(xs, ys) {
    si (longitud(xs) != longitud(ys) o longitud(xs) < 2) { lanzar "numerica: listas del mismo largo (al menos 2)" }
    sea mx = numerica_media(xs)
    sea my = numerica_media(ys)
    sea sxy = []
    sea sxx = []
    sea i = 0
    mientras (i < longitud(xs)) {
        sxy.agregar((xs[i] - mx) * (ys[i] - my))
        sxx.agregar((xs[i] - mx) * (xs[i] - mx))
        i = i + 1
    }
    sea den = numerica_suma(sxx)
    si (den == 0) { lanzar "numerica: todos los x son iguales" }
    sea m = numerica_suma(sxy) / den
    sea b = my - m * mx
    sea res = []
    sea tot = []
    i = 0
    mientras (i < longitud(xs)) {
        sea e = ys[i] - (m * xs[i] + b)
        res.agregar(e * e)
        tot.agregar((ys[i] - my) * (ys[i] - my))
        i = i + 1
    }
    sea st = numerica_suma(tot)
    sea r2 = 1
    si (st > 0) { r2 = 1 - numerica_suma(res) / st }
    retornar {"pendiente": m, "intercepto": b, "r2": r2}
}

/// Puntajes z: (x − media) / desviación.
funcion numerica_estandarizar(xs) {
    sea m = numerica_media(xs)
    sea s = numerica_desviacion(xs)
    sea r = []
    para x en xs { si (s == 0) { r.agregar(0) } sino { r.agregar((x - m) / s) } }
    retornar r
}

/// Histograma de "cajas" intervalos iguales: {"bordes": [...], "cuentas": [...]}.
funcion numerica_histograma(xs, cajas) {
    _nm_no_vacia(xs, "el histograma")
    sea n = cajas ?? 10
    sea lo = xs[0]
    sea hi = xs[0]
    para x en xs { lo = minimo(lo, x)  hi = maximo(hi, x) }
    si (hi == lo) { hi = lo + 1 }
    sea ancho = (hi - lo) / n
    sea bordes = []
    sea cuentas = []
    sea i = 0
    mientras (i <= n) { bordes.agregar(lo + ancho * i)  si (i < n) { cuentas.agregar(0) }  i = i + 1 }
    para x en xs {
        sea k = piso((x - lo) / ancho)
        si (k >= n) { k = n - 1 }
        cuentas[k] = cuentas[k] + 1
    }
    retornar {"bordes": bordes, "cuentas": cuentas}
}

/// Resumen: n, media, desviación, mínimo, cuartiles, máximo.
funcion numerica_resumen(xs) {
    _nm_no_vacia(xs, "el resumen")
    sea o = _nm_ordenados(xs)
    sea d = 0
    si (longitud(xs) > 1) { d = numerica_desviacion(xs) }
    retornar {"n": longitud(xs), "media": numerica_media(xs), "desviacion": d, "min": o[0], "q1": numerica_percentil(xs, 25), "mediana": numerica_percentil(xs, 50), "q3": numerica_percentil(xs, 75), "max": o[longitud(o) - 1]}
}

// ── FFT (Cooley–Tukey, radix 2). Complejos como [re, im]. ─────────────────

funcion _nm_complejos(xs) {
    sea r = []
    para x en xs {
        si (tipo(x) == "lista") { r.agregar([x[0], x[1]]) } sino { r.agregar([x, 0]) }
    }
    retornar r
}

funcion _nm_fft(a, inversa) {
    sea n = longitud(a)
    si (n == 0) { retornar [] }
    sea p = 1
    mientras (p < n) { p = p * 2 }
    si (p != n) { lanzar "numerica: la FFT necesita un largo potencia de 2 (usa numerica_rellenar)" }
    // Reordenamiento por bits invertidos.
    sea j = 0
    sea i = 1
    mientras (i < n) {
        sea bit = cociente(n, 2)
        mientras (j >= bit y bit > 0) { j = j - bit  bit = cociente(bit, 2) }
        j = j + bit
        si (i < j) { sea t = a[i]  a[i] = a[j]  a[j] = t }
        i = i + 1
    }
    sea largo = 2
    sea signo = -1
    si (inversa) { signo = 1 }
    mientras (largo <= n) {
        sea ang = signo * 2 * pi() / largo
        sea mitad = cociente(largo, 2)
        sea k = 0
        mientras (k < n) {
            sea m = 0
            mientras (m < mitad) {
                sea wr = coseno(ang * m)
                sea wi = seno(ang * m)
                sea u = a[k + m]
                sea v = a[k + m + mitad]
                sea tr = v[0] * wr - v[1] * wi
                sea ti = v[0] * wi + v[1] * wr
                a[k + m] = [u[0] + tr, u[1] + ti]
                a[k + m + mitad] = [u[0] - tr, u[1] - ti]
                m = m + 1
            }
            k = k + largo
        }
        largo = largo * 2
    }
    si (inversa) {
        sea r = []
        para c en a { r.agregar([c[0] / n, c[1] / n]) }
        retornar r
    }
    retornar a
}

/// Transformada rápida de Fourier de reales o complejos [re, im].
funcion numerica_fft(xs) { retornar _nm_fft(_nm_complejos(xs), falso) }
funcion numerica_ifft(xs) { retornar _nm_fft(_nm_complejos(xs), verdadero) }

/// Rellena con ceros hasta la siguiente potencia de 2.
funcion numerica_rellenar(xs) {
    sea r = []
    para x en xs { r.agregar(x) }
    sea p = 1
    mientras (p < longitud(r)) { p = p * 2 }
    mientras (longitud(r) < p) { r.agregar(0) }
    retornar r
}

/// Magnitudes |X[k]| de la FFT.
funcion numerica_espectro(xs) {
    sea r = []
    para c en numerica_fft(xs) { r.agregar(raiz(c[0] * c[0] + c[1] * c[1])) }
    retornar r
}

// ── Cálculo ───────────────────────────────────────────────────────────────

/// ∫ f de a a b (Simpson compuesto, n par de tramos).
funcion numerica_integrar(f, a, b, n) {
    sea tramos = n ?? 1000
    si (tramos % 2 == 1) { tramos = tramos + 1 }
    sea h = (b - a) / tramos
    sea s = f(a) + f(b)
    sea i = 1
    mientras (i < tramos) {
        sea peso = 4
        si (i % 2 == 0) { peso = 2 }
        s = s + peso * f(a + i * h)
        i = i + 1
    }
    retornar s * h / 3
}

/// Raíz de f en [a, b] (bisección + secante; f(a) y f(b) con signos opuestos).
funcion numerica_raiz(f, a, b, tolerancia) {
    sea tol = tolerancia ?? 0.000000000001
    sea fa = f(a)
    sea fb = f(b)
    si (fa == 0) { retornar a }
    si (fb == 0) { retornar b }
    si ((fa < 0) == (fb < 0)) { lanzar "numerica: f(a) y f(b) deben tener signos opuestos" }
    sea iter = 0
    mientras (iter < 200) {
        sea m = (a + b) / 2
        sea fm = f(m)
        si (fm == 0 o (b - a) / 2 < tol) { retornar m }
        si ((fm < 0) == (fa < 0)) { a = m  fa = fm } sino { b = m  fb = fm }
        iter = iter + 1
    }
    retornar (a + b) / 2
}

/// Derivada numérica (diferencia central).
funcion numerica_derivada(f, x, h) {
    sea paso = h ?? 0.00001
    retornar (f(x + paso) - f(x - paso)) / (2 * paso)
}
