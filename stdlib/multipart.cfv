// stdlib/multipart.cfv — formularios multipart/form-data: nombres en inglés del módulo "subida".
// English names for the "subida" module; both can be used together.

importar "subida"

funcion multipart_boundary(tipo_contenido) { retornar subida_frontera(tipo_contenido) }
funcion multipart_parse(cuerpo, tipo_contenido, opciones) { retornar subida_analizar(cuerpo, tipo_contenido, opciones) }
funcion multipart_fields(partes) { retornar subida_campos(partes) }
funcion multipart_files(partes) { retornar subida_archivos(partes) }
funcion multipart_safe_filename(nombre) { retornar subida_nombre_seguro(nombre) }
funcion multipart_build(partes) { retornar subida_crear(partes) }
