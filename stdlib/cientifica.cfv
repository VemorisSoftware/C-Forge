// stdlib/cientifica.cfv — Funciones especiales, ecuaciones diferenciales,
// integración, raíces, mínimos e interpolación al estilo de GSL, en C-Forge
// puro y con precisión cercana a la de doble precisión.
//
//   · Gamma, log-gamma, beta, digamma, zeta de Riemann.
//   · Error (erf, erfc), gamma y beta incompletas regularizadas.
//   · Bessel J0, J1, Jn, Y0, Y1, Yn; integrales elípticas K y E.
//   · EDO: Runge-Kutta 4 de paso fijo y Dormand-Prince 5(4) adaptativo.
//   · Integración adaptativa Gauss-Kronrod 7-15 (también con límites
//     infinitos), raíces con Brent, mínimos con Brent, derivadas.
//   · Interpolación lineal y por splines cúbicos naturales.
// Idea de GSL (GPL): solo la idea; algoritmos clásicos de la literatura
// (Lanczos, Lentz, QUADPACK, Hairer), escritos desde cero. En inglés:
// importar "gsl".
//
//   importar "cientifica"
//   cientifica_gamma(0.5)          // 1.7724538509055159 (√π)
//   cientifica_erf(1)              // 0.8427007929497149
//   sea inf = cientifica_infinito()
//   cientifica_integrar(funcion(x) { retornar exponencial(0 - x * x) }, 0 - inf, inf, nulo)

sea _CI_PI = 3.141592653589793
sea _CI_EPS = 0.0000000000000002220446049250313
sea _CI_INF = 1e308 * 10

/// Infinito (para los límites de cientifica_integrar).
funcion cientifica_infinito() { retornar _CI_INF }

// ---------- gamma y familia ----------

sea _CI_LANCZOS = [0.99999999999980993, 676.5203681218851, -1259.1392167224028, 771.32342877765313, -176.61502916214059,
    12.507343278686905, -0.13857109526572012, 0.0000099843695780195716, 0.00000015056327351493116]

/// Función gamma.
funcion cientifica_gamma(x) {
    si (x == piso(x) y x <= 0) { lanzar "cientifica_gamma: polo en " + x }
    si (x < 0.5) { retornar _CI_PI / (seno(_CI_PI * x) * cientifica_gamma(1 - x)) }
    si (x == piso(x) y x <= 30) {
        sea r = 1
        sea k = 2
        mientras (k < x) {
            r = r * k
            k = k + 1
        }
        retornar r
    }
    si (x > 171.7) { retornar _CI_INF }
    // Para x grande se usa exp(lgamma) con la serie de Stirling.
    si (x > 20) { retornar exponencial(cientifica_lgamma(x)) }
    sea z = x - 1
    sea a = _CI_LANCZOS[0]
    sea t = z + 7.5
    sea i = 1
    mientras (i < 9) {
        a = a + _CI_LANCZOS[i] / (z + i)
        i = i + 1
    }
    retornar raiz(2 * _CI_PI) * potencia(t, z + 0.5) * exponencial(0 - t) * a
}

/// Logaritmo de |gamma(x)|.
funcion cientifica_lgamma(x) {
    si (x <= 0 y x == piso(x)) { retornar _CI_INF }
    si (x < 0.5) { retornar logaritmo(_CI_PI / absoluto(seno(_CI_PI * x))) - cientifica_lgamma(1 - x) }
    si (x < 15) { retornar logaritmo(absoluto(cientifica_gamma(x))) }
    // Stirling con corrección de Bernoulli.
    sea x2 = x * x
    sea serie = 1 / (12 * x) - 1 / (360 * x * x2) + 1 / (1260 * x2 * x2 * x) - 1 / (1680 * x2 * x2 * x2 * x) + 1 / (1188 * x2 * x2 * x2 * x2 * x)
    retornar (x - 0.5) * logaritmo(x) - x + 0.5 * logaritmo(2 * _CI_PI) + serie
}

/// Función beta B(a, b).
funcion cientifica_beta(a, b) {
    si (a + b < 100) { retornar cientifica_gamma(a) * cientifica_gamma(b) / cientifica_gamma(a + b) }
    retornar exponencial(cientifica_lgamma(a) + cientifica_lgamma(b) - cientifica_lgamma(a + b))
}

/// Digamma ψ(x).
funcion cientifica_digamma(x) {
    si (x <= 0 y x == piso(x)) { lanzar "cientifica_digamma: polo en " + x }
    si (x < 0) { retornar cientifica_digamma(1 - x) - _CI_PI / tangente(_CI_PI * x) }
    sea r = 0
    sea z = x
    mientras (z < 12) {
        r = r - 1 / z
        z = z + 1
    }
    sea z2 = 1 / (z * z)
    retornar r + logaritmo(z) - 0.5 / z - z2 * (1 / 12 - z2 * (1 / 120 - z2 * (1 / 252 - z2 * (1 / 240 - z2 * (1 / 132 - z2 * (691 / 32760 - z2 / 12))))))
}

/// Zeta de Riemann ζ(s) para s > 1 (algoritmo de Borwein).
funcion cientifica_zeta(s) {
    si (s == 1) { retornar _CI_INF }
    si (s < 1) { lanzar "cientifica_zeta: solo para s > 1" }
    sea n = 40
    sea d = []
    sea suma = 0
    sea k = 0
    // d_k = n · Σ_{i=0..k} (n+i-1)! 4^i / ((n-i)! (2i)!)
    sea termino = 1 / n
    mientras (k <= n) {
        si (k == 0) { termino = 1 / n } sino { termino = termino * 4 * (n + k - 1) * (n - k + 1) / ((2 * k - 1) * (2 * k)) }
        suma = suma + termino
        d.agregar(n * suma)
        k = k + 1
    }
    sea total = 0
    k = 0
    mientras (k < n) {
        sea signo = 1
        si (k % 2 == 1) { signo = -1 }
        total = total + signo * (d[k] - d[n]) / potencia(k + 1, s)
        k = k + 1
    }
    retornar 0 - total / (d[n] * (1 - potencia(2, 1 - s)))
}

// ---------- error y funciones incompletas ----------

funcion _ci_erfc_fc(x) {
    // Fracción continua (Lentz) para x ≥ 2,5.
    sea tiny = 1e-300
    sea f = x
    si (f == 0) { f = tiny }
    sea c = f
    sea d = 0
    sea k = 1
    mientras (k < 300) {
        sea a = k / 2
        d = x + a * d
        si (d == 0) { d = tiny }
        c = x + a / c
        si (c == 0) { c = tiny }
        d = 1 / d
        sea delta = c * d
        f = f * delta
        si (absoluto(delta - 1) < 1e-16) { romper }
        k = k + 1
    }
    retornar exponencial(0 - x * x) / (raiz(_CI_PI) * f)
}

funcion _ci_erf_serie(x) {
    // erf(x) = 2x/√π · e^(−x²) · Σ (2x²)^n / (1·3·…·(2n+1)), sin restas.
    sea t = 1
    sea s = 1
    sea n = 0
    mientras (n < 500) {
        n = n + 1
        t = t * 2 * x * x / (2 * n + 1)
        s = s + t
        si (t < s * 1e-17) { romper }
    }
    retornar 2 * x / raiz(_CI_PI) * exponencial(0 - x * x) * s
}

/// Función error.
funcion cientifica_erf(x) {
    si (x < 0) { retornar 0 - cientifica_erf(0 - x) }
    si (x < 2.5) { retornar _ci_erf_serie(x) }
    retornar 1 - _ci_erfc_fc(x)
}

/// Función error complementaria (precisa también en la cola).
funcion cientifica_erfc(x) {
    si (x < 0) { retornar 2 - cientifica_erfc(0 - x) }
    si (x < 2.5) { retornar 1 - _ci_erf_serie(x) }
    retornar _ci_erfc_fc(x)
}

/// Gamma incompleta inferior regularizada P(a, x).
funcion cientifica_gamma_inc(a, x) {
    si (x < 0 o a <= 0) { lanzar "cientifica_gamma_inc: a > 0 y x ≥ 0" }
    si (x == 0) { retornar 0 }
    si (x < a + 1) {
        sea ap = a
        sea suma = 1 / a
        sea del = suma
        sea n = 0
        mientras (n < 1000) {
            ap = ap + 1
            del = del * x / ap
            suma = suma + del
            si (absoluto(del) < absoluto(suma) * 1e-16) { romper }
            n = n + 1
        }
        retornar suma * exponencial(0 - x + a * logaritmo(x) - cientifica_lgamma(a))
    }
    retornar 1 - cientifica_gamma_inc_sup(a, x)
}

/// Gamma incompleta superior regularizada Q(a, x) = 1 − P(a, x).
funcion cientifica_gamma_inc_sup(a, x) {
    si (x < a + 1) { retornar 1 - cientifica_gamma_inc(a, x) }
    sea tiny = 1e-300
    sea b = x + 1 - a
    sea c = 1 / tiny
    sea d = 1 / b
    sea h = d
    sea i = 1
    mientras (i < 1000) {
        sea an = 0 - i * (i - a)
        b = b + 2
        d = an * d + b
        si (absoluto(d) < tiny) { d = tiny }
        c = b + an / c
        si (absoluto(c) < tiny) { c = tiny }
        d = 1 / d
        sea del = d * c
        h = h * del
        si (absoluto(del - 1) < 1e-16) { romper }
        i = i + 1
    }
    retornar exponencial(0 - x + a * logaritmo(x) - cientifica_lgamma(a)) * h
}

funcion _ci_betacf(a, b, x) {
    sea tiny = 1e-300
    sea qab = a + b
    sea qap = a + 1
    sea qam = a - 1
    sea c = 1
    sea d = 1 - qab * x / qap
    si (absoluto(d) < tiny) { d = tiny }
    d = 1 / d
    sea h = d
    sea m = 1
    mientras (m < 1000) {
        sea m2 = 2 * m
        sea aa = m * (b - m) * x / ((qam + m2) * (a + m2))
        d = 1 + aa * d
        si (absoluto(d) < tiny) { d = tiny }
        c = 1 + aa / c
        si (absoluto(c) < tiny) { c = tiny }
        d = 1 / d
        h = h * d * c
        aa = 0 - (a + m) * (qab + m) * x / ((a + m2) * (qap + m2))
        d = 1 + aa * d
        si (absoluto(d) < tiny) { d = tiny }
        c = 1 + aa / c
        si (absoluto(c) < tiny) { c = tiny }
        d = 1 / d
        sea del = d * c
        h = h * del
        si (absoluto(del - 1) < 1e-16) { romper }
        m = m + 1
    }
    retornar h
}

/// Beta incompleta regularizada I_x(a, b).
funcion cientifica_beta_inc(a, b, x) {
    si (x < 0 o x > 1) { lanzar "cientifica_beta_inc: x debe estar entre 0 y 1" }
    si (x == 0 o x == 1) { retornar x }
    sea bt = exponencial(cientifica_lgamma(a + b) - cientifica_lgamma(a) - cientifica_lgamma(b) + a * logaritmo(x) + b * logaritmo(1 - x))
    si (x < (a + 1) / (a + b + 2)) { retornar bt * _ci_betacf(a, b, x) / a }
    retornar 1 - bt * _ci_betacf(b, a, 1 - x) / b
}

// ---------- Bessel ----------

funcion _ci_bessel_asint(n, x) {
    // Expansión de Hankel para x grande: [J, Y].
    sea mu = 4 * n * n
    sea p = 1
    sea q = 0
    sea t = 1
    sea k = 1
    sea ultimo = 1e300
    mientras (k < 60) {
        t = t * (mu - (2 * k - 1) * (2 * k - 1)) / (k * 8 * x)
        si (absoluto(t) > ultimo) { romper }
        ultimo = absoluto(t)
        si (k % 2 == 1) {
            si ((k - 1) % 4 == 0) { q = q + t } sino { q = q - t }
        } sino {
            si (k % 4 == 0) { p = p + t } sino { p = p - t }
        }
        si (absoluto(t) < 1e-17) { romper }
        k = k + 1
    }
    sea chi = x - (n / 2 + 0.25) * _CI_PI
    sea f = raiz(2 / (_CI_PI * x))
    retornar [f * (p * coseno(chi) - q * seno(chi)), f * (p * seno(chi) + q * coseno(chi))]
}

funcion _ci_j_serie(n, x) {
    sea t = 1
    sea k = 1
    mientras (k <= n) {
        t = t * x / (2 * k)
        k = k + 1
    }
    sea s = t
    sea m = 1
    mientras (m < 300) {
        t = 0 - t * x * x / (4 * m * (m + n))
        s = s + t
        si (absoluto(t) < 1e-17 * absoluto(s) o (t == 0)) { romper }
        m = m + 1
    }
    retornar s
}

/// Bessel de primera especie J0.
funcion cientifica_bessel_j0(x) {
    sea a = absoluto(x)
    si (a < 12) { retornar _ci_j_serie(0, a) }
    retornar _ci_bessel_asint(0, a)[0]
}

/// Bessel de primera especie J1.
funcion cientifica_bessel_j1(x) {
    sea a = absoluto(x)
    sea r = 0
    si (a < 12) { r = _ci_j_serie(1, a) } sino { r = _ci_bessel_asint(1, a)[0] }
    si (x < 0) { retornar 0 - r }
    retornar r
}

/// Bessel de primera especie Jn (n entero ≥ 0).
funcion cientifica_bessel_jn(n, x) {
    si (n == 0) { retornar cientifica_bessel_j0(x) }
    si (n == 1) { retornar cientifica_bessel_j1(x) }
    si (x == 0) { retornar 0 }
    sea a = absoluto(x)
    sea r = 0
    si (a > n) {
        // Recurrencia hacia adelante (estable para x > n).
        sea j0 = cientifica_bessel_j0(a)
        sea j1 = cientifica_bessel_j1(a)
        sea k = 1
        mientras (k < n) {
            sea j2 = 2 * k / a * j1 - j0
            j0 = j1
            j1 = j2
            k = k + 1
        }
        r = j1
    } sino { r = _ci_j_serie(n, a) }
    si (x < 0 y n % 2 == 1) { retornar 0 - r }
    retornar r
}

sea _CI_EULER = 0.5772156649015329

/// Bessel de segunda especie Y0 (x > 0).
funcion cientifica_bessel_y0(x) {
    si (x <= 0) { lanzar "cientifica_bessel_y0: x debe ser positivo" }
    si (x >= 12) { retornar _ci_bessel_asint(0, x)[1] }
    sea t = 1
    sea h = 0
    sea s = 0
    sea k = 1
    mientras (k < 300) {
        t = 0 - t * x * x / (4 * k * k)
        h = h + 1 / k
        sea term = 0 - t * h
        s = s + term
        si (absoluto(term) < 1e-17 * absoluto(s)) { romper }
        k = k + 1
    }
    retornar 2 / _CI_PI * ((logaritmo(x / 2) + _CI_EULER) * _ci_j_serie(0, x) + s)
}

/// Bessel de segunda especie Y1 (x > 0).
funcion cientifica_bessel_y1(x) {
    si (x <= 0) { lanzar "cientifica_bessel_y1: x debe ser positivo" }
    si (x >= 12) { retornar _ci_bessel_asint(1, x)[1] }
    // Y1 = (2/π)(ln(x/2)+γ)J1 − 2/(πx) − (1/π) Σ (−1)^k (H_k + H_{k+1}) (x/2)^(2k+1) / (k!(k+1)!)
    sea t = x / 2
    sea hk = 0
    sea hk1 = 1
    sea s = t * (hk + hk1)
    sea k = 1
    mientras (k < 300) {
        t = 0 - t * x * x / (4 * k * (k + 1))
        hk = hk + 1 / k
        hk1 = hk1 + 1 / (k + 1)
        sea term = t * (hk + hk1)
        s = s + term
        si (absoluto(term) < 1e-17 * absoluto(s)) { romper }
        k = k + 1
    }
    retornar 2 / _CI_PI * (logaritmo(x / 2) + _CI_EULER) * _ci_j_serie(1, x) - 2 / (_CI_PI * x) - s / _CI_PI
}

/// Bessel de segunda especie Yn (n entero ≥ 0, x > 0).
funcion cientifica_bessel_yn(n, x) {
    si (n == 0) { retornar cientifica_bessel_y0(x) }
    sea y0 = cientifica_bessel_y0(x)
    sea y1 = cientifica_bessel_y1(x)
    sea k = 1
    mientras (k < n) {
        sea y2 = 2 * k / x * y1 - y0
        y0 = y1
        y1 = y2
        k = k + 1
    }
    retornar y1
}

/// Integral elíptica completa de primera especie K(m) (m = k²).
funcion cientifica_eliptica_k(m) {
    si (m >= 1) { retornar _CI_INF }
    sea a = 1
    sea b = raiz(1 - m)
    sea it = 0
    mientras (absoluto(a - b) > 1e-15 * a y it < 60) {
        it = it + 1
        sea an = (a + b) / 2
        b = raiz(a * b)
        a = an
    }
    retornar _CI_PI / (2 * a)
}

/// Integral elíptica completa de segunda especie E(m).
funcion cientifica_eliptica_e(m) {
    si (m == 1) { retornar 1 }
    sea a = 1
    sea b = raiz(1 - m)
    sea c = raiz(m)
    sea suma = c * c / 2
    sea p = 0.5
    sea it = 0
    mientras (absoluto(c) > 1e-16 y it < 60) {
        it = it + 1
        sea an = (a + b) / 2
        c = (a - b) / 2
        b = raiz(a * b)
        a = an
        p = p * 2
        suma = suma + p * c * c
    }
    retornar _CI_PI / (2 * a) * (1 - suma)
}

// ---------- EDO ----------

funcion _ci_sumar(yv, k, h) {
    sea r = []
    sea i = 0
    mientras (i < longitud(yv)) {
        r.agregar(yv[i] + h * k[i])
        i = i + 1
    }
    retornar r
}

funcion _ci_comb(yv, h, ks, cs) {
    sea r = []
    sea i = 0
    mientras (i < longitud(yv)) {
        sea s = 0
        sea j = 0
        mientras (j < longitud(cs)) {
            si (cs[j] != 0) { s = s + cs[j] * ks[j][i] }
            j = j + 1
        }
        r.agregar(yv[i] + h * s)
        i = i + 1
    }
    retornar r
}

funcion _ci_vec(yv) {
    si (tipo(yv) == "lista") { retornar yv }
    retornar [yv]
}

/// Runge-Kutta 4 de paso fijo: f(t, y) → dy/dt (y es un número o una
/// lista). Devuelve {"t": [...], "y": [...]}.
funcion cientifica_rk4(f, t0, y0, t1, pasos) {
    sea escalar = tipo(y0) != "lista"
    sea yv = _ci_vec(y0)
    sea g = funcion(t, v) {
        si (escalar) { retornar [f(t, v[0])] }
        retornar f(t, v)
    }
    sea h = (t1 - t0) / pasos
    sea ts = [t0]
    sea ys = [y0]
    sea t = t0
    sea i = 0
    mientras (i < pasos) {
        sea k1 = g(t, yv)
        sea k2 = g(t + h / 2, _ci_sumar(yv, k1, h / 2))
        sea k3 = g(t + h / 2, _ci_sumar(yv, k2, h / 2))
        sea k4 = g(t + h, _ci_sumar(yv, k3, h))
        yv = _ci_comb(yv, h, [k1, k2, k3, k4], [1 / 6, 1 / 3, 1 / 3, 1 / 6])
        t = t0 + (i + 1) * h
        ts.agregar(t)
        si (escalar) { ys.agregar(yv[0]) } sino { ys.agregar(yv) }
        i = i + 1
    }
    retornar {"t": ts, "y": ys}
}

/// Dormand-Prince 5(4) con paso adaptativo. opciones: "rtol" (1e-8),
/// "atol" (1e-10), "paso" (inicial), "max_pasos" (100000), "puntos"
/// (lista de tiempos donde se quiere la solución; si no, todos los pasos).
/// Devuelve {"t", "y", "pasos", "rechazados"}.
funcion cientifica_edo(f, t0, y0, t1, opciones) {
    sea op = opciones ?? {}
    sea rtol = op["rtol"] ?? 1e-8
    sea atol = op["atol"] ?? 1e-10
    sea escalar = tipo(y0) != "lista"
    sea g = funcion(t, v) {
        si (escalar) { retornar [f(t, v[0])] }
        retornar f(t, v)
    }
    sea yv = _ci_vec(y0)
    sea n = longitud(yv)
    sea t = t0
    sea dir = 1
    si (t1 < t0) { dir = -1 }
    sea h = op["paso"] ?? ((t1 - t0) / 100)
    sea ts = [t0]
    sea ys = [y0]
    sea puntos = op["puntos"] ?? nulo
    si (puntos != nulo) {
        ts = []
        ys = []
    }
    sea ip = 0
    sea k1 = g(t, yv)
    sea pasos = 0
    sea rechazados = 0
    sea maxp = op["max_pasos"] ?? 100000
    mientras (dir * (t1 - t) > 1e-15 * maximo(1, absoluto(t1)) y pasos < maxp) {
        si (dir * (t + h - t1) > 0) { h = t1 - t }
        sea k2 = g(t + h / 5, _ci_comb(yv, h, [k1], [1 / 5]))
        sea k3 = g(t + 3 * h / 10, _ci_comb(yv, h, [k1, k2], [3 / 40, 9 / 40]))
        sea k4 = g(t + 4 * h / 5, _ci_comb(yv, h, [k1, k2, k3], [44 / 45, -56 / 15, 32 / 9]))
        sea k5 = g(t + 8 * h / 9, _ci_comb(yv, h, [k1, k2, k3, k4], [19372 / 6561, -25360 / 2187, 64448 / 6561, -212 / 729]))
        sea k6 = g(t + h, _ci_comb(yv, h, [k1, k2, k3, k4, k5], [9017 / 3168, -355 / 33, 46732 / 5247, 49 / 176, -5103 / 18656]))
        sea y5 = _ci_comb(yv, h, [k1, k2, k3, k4, k5, k6], [35 / 384, 0, 500 / 1113, 125 / 192, -2187 / 6784, 11 / 84])
        sea k7 = g(t + h, y5)
        sea e = [71 / 57600, 0, -71 / 16695, 71 / 1920, -17253 / 339200, 22 / 525, -1 / 40]
        sea err = 0
        sea i = 0
        mientras (i < n) {
            sea ei = h * (e[0] * k1[i] + e[2] * k3[i] + e[3] * k4[i] + e[4] * k5[i] + e[5] * k6[i] + e[6] * k7[i])
            sea sc = atol + rtol * maximo(absoluto(yv[i]), absoluto(y5[i]))
            err = err + (ei / sc) * (ei / sc)
            i = i + 1
        }
        err = raiz(err / n)
        pasos = pasos + 1
        si (err <= 1) {
            sea tn = t + h
            // Salida densa (interpolación de Hermite) para los puntos pedidos.
            si (puntos != nulo) {
                mientras (ip < longitud(puntos) y dir * (puntos[ip] - tn) <= 0) {
                    sea th = (puntos[ip] - t) / h
                    sea yi = []
                    i = 0
                    mientras (i < n) {
                        sea h00 = 2 * th * th * th - 3 * th * th + 1
                        sea h10 = th * th * th - 2 * th * th + th
                        sea h01 = 0 - 2 * th * th * th + 3 * th * th
                        sea h11 = th * th * th - th * th
                        yi.agregar(h00 * yv[i] + h10 * h * k1[i] + h01 * y5[i] + h11 * h * k7[i])
                        i = i + 1
                    }
                    ts.agregar(puntos[ip])
                    si (escalar) { ys.agregar(yi[0]) } sino { ys.agregar(yi) }
                    ip = ip + 1
                }
            }
            t = tn
            yv = y5
            k1 = k7
            si (puntos == nulo) {
                ts.agregar(t)
                si (escalar) { ys.agregar(yv[0]) } sino { ys.agregar(yv) }
            }
        } sino { rechazados = rechazados + 1 }
        sea factor = 5
        si (err > 0) { factor = minimo(5, maximo(0.2, 0.9 * potencia(err, -0.2))) }
        h = h * factor
    }
    retornar {"t": ts, "y": ys, "pasos": pasos, "rechazados": rechazados}
}

// ---------- integración ----------

sea _CI_XGK = [0.991455371120812639206854697526329, 0.949107912342758524526189684047851, 0.864864423359769072789712788640926,
    0.741531185599394439863864773280788, 0.586087235467691130294144845693013, 0.405845151377397166906606412076961,
    0.207784955007898467600689403773245, 0]
sea _CI_WGK = [0.022935322010529224963732008058970, 0.063092092629978553290700663189204, 0.104790010322250183839876322541518,
    0.140653259715525918745189590510238, 0.169004726639267902826583426598550, 0.190350578064785409913256402421014,
    0.204432940075298892414161999234649, 0.209482141084727828012999174891714]
sea _CI_WG = [0.129484966168869693270611432679082, 0.279705391489276667901467771423780, 0.381830050505118944950369775488975,
    0.417959183673469387755102040816327]

funcion _ci_gk15(f, a, b) {
    sea c = (a + b) / 2
    sea h = (b - a) / 2
    sea fc = f(c)
    sea rk = fc * _CI_WGK[7]
    sea rg = fc * _CI_WG[3]
    sea j = 0
    mientras (j < 7) {
        sea dx = h * _CI_XGK[j]
        sea f1 = f(c - dx)
        sea f2 = f(c + dx)
        rk = rk + _CI_WGK[j] * (f1 + f2)
        si (j % 2 == 1) { rg = rg + _CI_WG[piso(j / 2)] * (f1 + f2) }
        j = j + 1
    }
    retornar [rk * h, absoluto((rk - rg) * h)]
}

/// Integral de f entre a y b (pueden ser ±cientifica_infinito()) con Gauss-Kronrod
/// adaptativo. opciones: "tolerancia" (1e-10), "max_intervalos" (500).
/// Con opciones {"detalle": verdadero} devuelve {"valor", "error", "evaluaciones"}.
funcion cientifica_integrar(f, a, b, opciones) {
    sea op = opciones ?? {}
    sea tol = op["tolerancia"] ?? 1e-10
    sea g = f
    sea ia = a
    sea ib = b
    sea evals = [0]
    // Cambios de variable para límites infinitos.
    si (a == 0 - _CI_INF y b == _CI_INF) {
        g = funcion(t) {
            sea u = 1 - t * t
            retornar f(t / u) * (1 + t * t) / (u * u)
        }
        ia = -1
        ib = 1
    } sino si (b == _CI_INF) {
        g = funcion(t) { retornar f(a + t / (1 - t)) / ((1 - t) * (1 - t)) }
        ia = 0
        ib = 1
    } sino si (a == 0 - _CI_INF) {
        g = funcion(t) { retornar f(b - (1 - t) / t) / (t * t) }
        ia = 0
        ib = 1
    }
    sea h = funcion(x) {
        evals[0] = evals[0] + 1
        retornar g(x)
    }
    sea intervalos = [[ia, ib, _ci_gk15(h, ia, ib)]]
    sea maxi = op["max_intervalos"] ?? 500
    mientras (verdadero) {
        sea total = 0
        sea err = 0
        sea peor = 0
        sea i = 0
        mientras (i < longitud(intervalos)) {
            total = total + intervalos[i][2][0]
            err = err + intervalos[i][2][1]
            si (intervalos[i][2][1] > intervalos[peor][2][1]) { peor = i }
            i = i + 1
        }
        si (err <= maximo(tol, tol * absoluto(total)) o longitud(intervalos) >= maxi) {
            si (op["detalle"] ?? falso) { retornar {"valor": total, "error": err, "evaluaciones": evals[0]} }
            retornar total
        }
        sea p = eliminar(intervalos, peor)
        sea m = (p[0] + p[1]) / 2
        intervalos.agregar([p[0], m, _ci_gk15(h, p[0], m)])
        intervalos.agregar([m, p[1], _ci_gk15(h, m, p[1])])
    }
}

/// Derivada numérica (diferencias centrales de Richardson).
funcion cientifica_derivada(f, x, h) {
    sea paso = h ?? 0.01
    sea d1 = (f(x + paso) - f(x - paso)) / (2 * paso)
    sea d2 = (f(x + paso / 2) - f(x - paso / 2)) / paso
    sea d4 = (f(x + paso / 4) - f(x - paso / 4)) / (paso / 2)
    sea r1 = (4 * d2 - d1) / 3
    sea r2 = (4 * d4 - d2) / 3
    retornar (16 * r2 - r1) / 15
}

// ---------- raíces y mínimos ----------

/// Raíz de f en [a, b] (f(a) y f(b) con signos distintos), método de Brent.
funcion cientifica_raiz(f, a, b, tolerancia) {
    sea tol = tolerancia ?? 1e-14
    sea fa = f(a)
    sea fb = f(b)
    si (fa == 0) { retornar a }
    si (fb == 0) { retornar b }
    si ((fa > 0) == (fb > 0)) { lanzar "cientifica_raiz: f(a) y f(b) deben tener signos distintos" }
    sea c = a
    sea fc = fa
    sea d = b - a
    sea e = d
    sea it = 0
    mientras (it < 200) {
        si ((fb > 0) == (fc > 0)) {
            c = a
            fc = fa
            d = b - a
            e = d
        }
        si (absoluto(fc) < absoluto(fb)) {
            a = b
            b = c
            c = a
            fa = fb
            fb = fc
            fc = fa
        }
        sea tol1 = 2 * _CI_EPS * absoluto(b) + tol / 2
        sea xm = (c - b) / 2
        si (absoluto(xm) <= tol1 o fb == 0) { retornar b }
        si (absoluto(e) >= tol1 y absoluto(fa) > absoluto(fb)) {
            sea s = fb / fa
            sea p = 0
            sea q = 0
            si (a == c) {
                p = 2 * xm * s
                q = 1 - s
            } sino {
                sea q0 = fa / fc
                sea r = fb / fc
                p = s * (2 * xm * q0 * (q0 - r) - (b - a) * (r - 1))
                q = (q0 - 1) * (r - 1) * (s - 1)
            }
            si (p > 0) { q = 0 - q }
            p = absoluto(p)
            si (2 * p < minimo(3 * xm * q - absoluto(tol1 * q), absoluto(e * q))) {
                e = d
                d = p / q
            } sino {
                d = xm
                e = d
            }
        } sino {
            d = xm
            e = d
        }
        a = b
        fa = fb
        si (absoluto(d) > tol1) { b = b + d } sino si (xm > 0) { b = b + tol1 } sino { b = b - tol1 }
        fb = f(b)
        it = it + 1
    }
    retornar b
}

/// Mínimo de f en [a, b] (método de Brent): {"x", "valor"}.
funcion cientifica_minimo(f, a, b, tolerancia) {
    sea tol = tolerancia ?? 1e-10
    sea oro = 0.3819660112501051
    sea x = a + oro * (b - a)
    sea w = x
    sea v = x
    sea fx = f(x)
    sea fw = fx
    sea fv = fx
    sea d = 0
    sea e = 0
    sea it = 0
    mientras (it < 500) {
        sea xm = (a + b) / 2
        sea tol1 = tol * absoluto(x) + 1e-12
        sea tol2 = 2 * tol1
        si (absoluto(x - xm) <= tol2 - (b - a) / 2) { romper }
        sea parabola = falso
        si (absoluto(e) > tol1) {
            sea r = (x - w) * (fx - fv)
            sea q = (x - v) * (fx - fw)
            sea p = (x - v) * q - (x - w) * r
            q = 2 * (q - r)
            si (q > 0) { p = 0 - p }
            q = absoluto(q)
            sea etemp = e
            e = d
            si (absoluto(p) < absoluto(q * etemp / 2) y p > q * (a - x) y p < q * (b - x)) {
                d = p / q
                sea u0 = x + d
                si (u0 - a < tol2 o b - u0 < tol2) {
                    d = tol1
                    si (xm < x) { d = 0 - tol1 }
                }
                parabola = verdadero
            }
        }
        si (parabola == falso) {
            si (x >= xm) { e = a - x } sino { e = b - x }
            d = oro * e
        }
        sea u = x + d
        si (absoluto(d) < tol1) {
            si (d >= 0) { u = x + tol1 } sino { u = x - tol1 }
        }
        sea fu = f(u)
        si (fu <= fx) {
            si (u >= x) { a = x } sino { b = x }
            v = w
            fv = fw
            w = x
            fw = fx
            x = u
            fx = fu
        } sino {
            si (u < x) { a = u } sino { b = u }
            si (fu <= fw o w == x) {
                v = w
                fv = fw
                w = u
                fw = fu
            } sino si (fu <= fv o v == x o v == w) {
                v = u
                fv = fu
            }
        }
        it = it + 1
    }
    retornar {"x": x, "valor": fx}
}

// ---------- interpolación ----------

/// Interpolación lineal en tablas xs (crecientes) e ys.
funcion cientifica_interpolar(xs, ys, x) {
    sea n = longitud(xs)
    si (x <= xs[0]) { retornar ys[0] }
    si (x >= xs[n - 1]) { retornar ys[n - 1] }
    sea lo = 0
    sea hi = n - 1
    mientras (hi - lo > 1) {
        sea m = piso((lo + hi) / 2)
        si (xs[m] > x) { hi = m } sino { lo = m }
    }
    sea t = (x - xs[lo]) / (xs[hi] - xs[lo])
    retornar ys[lo] + t * (ys[hi] - ys[lo])
}

/// Spline cúbico natural: devuelve un objeto para cientifica_spline_valor.
funcion cientifica_spline(xs, ys) {
    sea n = longitud(xs)
    si (n < 3) { lanzar "cientifica_spline: hacen falta al menos 3 puntos" }
    sea m = []
    sea i = 0
    mientras (i < n) {
        m.agregar(0)
        i = i + 1
    }
    // Sistema tridiagonal para las segundas derivadas.
    sea c = []
    sea d = []
    i = 0
    mientras (i < n) {
        c.agregar(0)
        d.agregar(0)
        i = i + 1
    }
    i = 1
    mientras (i < n - 1) {
        sea h0 = xs[i] - xs[i - 1]
        sea h1 = xs[i + 1] - xs[i]
        sea diag = 2 * (h0 + h1)
        sea rhs = 6 * ((ys[i + 1] - ys[i]) / h1 - (ys[i] - ys[i - 1]) / h0)
        si (i > 1) {
            diag = diag - h0 * c[i - 1]
            rhs = rhs - h0 * d[i - 1]
        }
        c[i] = h1 / diag
        d[i] = rhs / diag
        i = i + 1
    }
    i = n - 2
    mientras (i >= 1) {
        m[i] = d[i] - c[i] * m[i + 1]
        i = i - 1
    }
    retornar {"xs": xs, "ys": ys, "m": m}
}

/// Valor del spline en x (y su derivada con derivada = verdadero).
funcion cientifica_spline_valor(s, x, derivada) {
    sea xs = s["xs"]
    sea ys = s["ys"]
    sea m = s["m"]
    sea n = longitud(xs)
    sea lo = 0
    sea hi = n - 1
    mientras (hi - lo > 1) {
        sea k = piso((lo + hi) / 2)
        si (xs[k] > x) { hi = k } sino { lo = k }
    }
    sea h = xs[hi] - xs[lo]
    sea a = (xs[hi] - x) / h
    sea b = (x - xs[lo]) / h
    si (derivada ?? falso) {
        retornar (ys[hi] - ys[lo]) / h - (3 * a * a - 1) / 6 * h * m[lo] + (3 * b * b - 1) / 6 * h * m[hi]
    }
    retornar a * ys[lo] + b * ys[hi] + ((a * a * a - a) * m[lo] + (b * b * b - b) * m[hi]) * h * h / 6
}
