// stdlib/testcontainers.cfv — servicios reales en pruebas: nombres en inglés del módulo "entorno".
// English names for the "entorno" module; both can be used together.


importar "entorno"

funcion _testcontainers_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_testcontainers_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _testcontainers_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _TESTCONTAINERS_RES = {"codigo": "exit_code"}
sea _TESTCONTAINERS_OPT = {"image": "imagen", "cmd": "cmd", "env": "env", "ports": "puertos", "wait": "esperar", "timeout_ms": "tiempo_ms", "files": "archivos", "pull": "bajar", "labels": "etiquetas", "network": "red", "aliases": "alias", "interval_ms": "intervalo_ms"}

funcion tc_session() { retornar entorno_sesion() }
funcion tc_client(c) { retornar entorno_cliente(c) }
funcion tc_wait_log(texto, veces) { retornar entorno_esperar_log(texto, veces) }
funcion tc_wait_port(puerto) { retornar entorno_esperar_puerto(puerto) }
funcion tc_wait_http(puerto, ruta, estado) { retornar entorno_esperar_http(puerto, ruta, estado) }
funcion tc_wait_command(cmd) { retornar entorno_esperar_comando(cmd) }
funcion tc_wait_healthy() { retornar entorno_esperar_salud() }
funcion tc_wait_all(lista) { retornar entorno_esperar_todas(lista) }
funcion tc_container(imagen, opciones) { retornar entorno_contenedor(imagen, _testcontainers_opt(opciones)) }
funcion tc_start(dc) { retornar entorno_iniciar(dc) }
funcion tc_host(e) { retornar entorno_host(e) }
funcion tc_port(e, puerto) { retornar entorno_puerto(e, puerto) }
funcion tc_address(e, puerto) { retornar entorno_direccion(e, puerto) }
funcion tc_exec(e, cmd) { retornar _testcontainers_tr(entorno_ejecutar(e, cmd), _TESTCONTAINERS_RES) }
funcion tc_logs(e) { retornar entorno_logs(e) }
funcion tc_stop(e) { retornar entorno_parar(e) }
funcion tc_with(dc, fn) { retornar entorno_con(dc, fn) }
funcion tc_group(defs) { retornar entorno_grupo(defs) }
funcion tc_stop_group(g) { retornar entorno_parar_grupo(g) }
funcion tc_cleanup(sesion) { retornar entorno_limpiar(sesion) }
funcion tc_redis(opciones) { retornar entorno_redis(_testcontainers_opt(opciones)) }
funcion tc_postgres(opciones) { retornar entorno_postgres(_testcontainers_opt(opciones)) }
funcion tc_mysql(opciones) { retornar entorno_mysql(_testcontainers_opt(opciones)) }
funcion tc_nats(opciones) { retornar entorno_nats(_testcontainers_opt(opciones)) }
funcion tc_rabbitmq(opciones) { retornar entorno_rabbitmq(_testcontainers_opt(opciones)) }
funcion tc_url(e, esquema, puerto, ruta) { retornar entorno_url(e, esquema, puerto, ruta) }

funcion _testcontainers_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_TESTCONTAINERS_OPT[k] ?? k] = o[k] }
    retornar r
}
