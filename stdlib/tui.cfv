// stdlib/tui.cfv — interfaces de texto en la terminal: nombres en inglés del módulo "terminal".
// English names for the "terminal" module; both can be used together.


importar "terminal"

funcion _tui_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_tui_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _tui_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _TUI_OPT = {"title": "titulo", "borders": "bordes", "style": "estilo", "align": "alinear", "wrap": "ajustar", "scroll": "desplazar", "highlight": "resaltar", "header": "cabecera", "margin": "margen", "label": "etiqueta", "max": "maximo", "width": "ancho", "gap": "espacio", "divider": "divisor"}

funcion tui_buffer(ancho, alto) { retornar terminal_bufer(ancho, alto) }
funcion tui_area(b) { retornar terminal_area(b) }
funcion tui_clear(b) { retornar terminal_limpiar(b) }
funcion tui_write(b, x, y, texto, estilo, max_ancho) { retornar terminal_escribir(b, x, y, texto, estilo, max_ancho) }
funcion tui_fill(b, area, estilo) { retornar terminal_pintar(b, area, estilo) }
funcion tui_cell(b, x, y) { retornar terminal_celda(b, x, y) }
funcion tui_text(b) { retornar terminal_texto(b) }
funcion tui_split(area, direccion, restricciones, opciones) { retornar terminal_dividir(area, direccion, restricciones, _tui_opt(opciones)) }
funcion tui_inner(area, margen) { retornar terminal_interior(area, margen) }
funcion tui_center(area, ancho, alto) { retornar terminal_centrar(area, ancho, alto) }
funcion tui_block(b, area, opciones) { retornar terminal_bloque(b, area, _tui_opt(opciones)) }
funcion tui_paragraph(b, area, contenido, opciones) { retornar terminal_parrafo(b, area, contenido, _tui_opt(opciones)) }
funcion tui_list(b, area, elementos, estado, opciones) { retornar terminal_lista(b, area, elementos, estado, _tui_opt(opciones)) }
funcion tui_table(b, area, filas, anchos, opciones) { retornar terminal_tabla(b, area, filas, anchos, _tui_opt(opciones)) }
funcion tui_gauge(b, area, proporcion, opciones) { retornar terminal_medidor(b, area, proporcion, _tui_opt(opciones)) }
funcion tui_sparkline(b, area, valores, opciones) { retornar terminal_chispa(b, area, valores, _tui_opt(opciones)) }
funcion tui_barchart(b, area, datos, opciones) { retornar terminal_barras(b, area, datos, _tui_opt(opciones)) }
funcion tui_tabs(b, area, titulos, elegida, opciones) { retornar terminal_pestanas(b, area, titulos, elegida, _tui_opt(opciones)) }
funcion tui_ansi(b) { retornar terminal_ansi(b) }
funcion tui_diff(anterior, actual) { retornar terminal_diferencia(anterior, actual) }
funcion tui_size() { retornar terminal_tamano() }
funcion tui_init() { retornar terminal_iniciar() }
funcion tui_restore() { retornar terminal_terminar() }
funcion tui_parse_key(bytes_) { retornar terminal_tecla(bytes_) }
funcion tui_read_key() { retornar terminal_leer_tecla() }
funcion tui_run(dibujar, teclas) { retornar terminal_ejecutar(dibujar, teclas) }

funcion _tui_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_TUI_OPT[k] ?? k] = o[k] }
    retornar r
}
