// stdlib/queue.cfv — cola de trabajos: nombres en inglés del módulo "cola".
// English names for the "cola" module; both can be used together.

importar "cola"

funcion queue_new() { retornar cola_nueva() }
funcion queue_with_clock(c, reloj) { retornar cola_con_reloj(c, reloj) }
funcion queue_add(c, tipo_t, datos, opciones) { retornar cola_agregar(c, tipo_t, datos, opciones) }
funcion queue_process(c, manejadores, limite) { retornar cola_procesar(c, manejadores, limite) }
funcion queue_work(c, manejadores, hasta_vaciar) { retornar cola_trabajar(c, manejadores, hasta_vaciar) }
/// {"pending", "ready", "failed", "done"}
funcion queue_status(c) {
    sea e = cola_estado(c)
    retornar {"pending": e["pendientes"], "ready": e["listos"], "failed": e["fallidos"], "done": e["hechos"]}
}
funcion queue_retry_failed(c) { retornar cola_reintentar_fallidos(c) }
funcion queue_save(c, ruta) { retornar cola_guardar(c, ruta) }
funcion queue_load(ruta) { retornar cola_cargar(ruta) }
