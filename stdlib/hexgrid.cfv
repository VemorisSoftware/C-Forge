// stdlib/hexgrid.cfv — índice hexagonal del planeta: nombres en inglés del módulo "panal".
// English names for the "panal" module; both can be used together.

importar "panal"

funcion hex_area_km2(res) { retornar panal_area_km2(res) }
funcion hex_edge_km(res) { retornar panal_lado_km(res) }
funcion hex_parts(id) { retornar panal_partes(id) }
funcion hex_cell(lat, lon, res) { retornar panal_celda(lat, lon, res) }
funcion hex_center(id) { retornar panal_centro(id) }
funcion hex_boundary(id) { retornar panal_borde(id) }
funcion hex_neighbors(id) { retornar panal_vecinos(id) }
funcion hex_ring(id, k) { retornar panal_anillo(id, k) }
funcion hex_disk(id, k) { retornar panal_disco(id, k) }
funcion hex_distance(a, b) { retornar panal_distancia(a, b) }
funcion hex_parent(id, res) { retornar panal_padre(id, res) }
funcion hex_children(id) { retornar panal_hijos(id) }
funcion hex_polyfill(poligono, res) { retornar panal_cubrir(poligono, res) }
funcion hex_count_points(puntos, res) { retornar panal_agrupar(puntos, res) }
funcion hex_to_geojson(ids, propiedades) { retornar panal_geojson(ids, propiedades) }
funcion hex_plane_from_pixel(x, yv, tamano) { retornar panal_plano_de_pixel(x, yv, tamano) }
funcion hex_plane_to_pixel(h, tamano) { retornar panal_plano_a_pixel(h, tamano) }
funcion hex_plane_distance(a, b) { retornar panal_plano_distancia(a, b) }
funcion hex_plane_neighbors(h) { retornar panal_plano_vecinos(h) }
funcion hex_plane_line(a, b) { retornar panal_plano_linea(a, b) }
funcion hex_plane_path(a, b, bloqueados, limite) { retornar panal_plano_camino(a, b, bloqueados, limite) }
