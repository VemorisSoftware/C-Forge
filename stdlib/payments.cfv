// stdlib/payments.cfv — cobros seguros: nombres en inglés del módulo "cobro".
// English names for the "cobro" module; both can be used together.

importar "cobro"

funcion payments_new(ttl_s) { retornar cobro_nuevo(ttl_s) }
funcion payments_with_clock(c, reloj) { retornar cobro_con_reloj(c, reloj) }
funcion payments_idempotent(c, clave, cuerpo, f) { retornar cobro_idempotente(c, clave, cuerpo, f) }
funcion payments_key() { retornar cobro_clave() }
funcion payments_sign_webhook(secreto, cuerpo, ms) { retornar cobro_firmar_webhook(secreto, cuerpo, ms) }
funcion payments_verify_webhook(secreto, cuerpo, cabecera, tolerancia_s, ms) { retornar cobro_verificar_webhook(secreto, cuerpo, cabecera, tolerancia_s, ms) }
funcion payments_charge(monto, moneda, datos) { retornar cobro_pago(monto, moneda, datos) }
sea _PAY_EN = {"pending": "pendiente", "authorized": "autorizado", "captured": "capturado", "refunded": "reembolsado", "canceled": "cancelado", "failed": "fallido"}

/// States: pending, authorized, captured, refunded, canceled, failed.
funcion payments_transition(p, estado) {
    sea e = estado
    si (tiene_clave(_PAY_EN, estado)) { e = _PAY_EN[estado] }
    retornar cobro_cambiar(p, e)
}

funcion payments_status(p) {
    para k en claves(_PAY_EN) { si (_PAY_EN[k] == p["estado"]) { retornar k } }
    retornar p["estado"]
}
funcion payments_refund(p, monto) { retornar cobro_reembolsar(p, monto) }
funcion payments_format(monto, moneda) { retornar cobro_formato(monto, moneda) }
