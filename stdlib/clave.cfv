// stdlib/clave.cfv — hash de contraseñas: bcrypt ($2b$, compatible con
// OpenBSD, PHP y la librería bcrypt de Python), scrypt (RFC 7914, en formato
// PHC $scrypt$) y una interfaz única que también entiende Argon2id
// (nativo), PBKDF2 y detecta cuándo conviene volver a calcular el hash
// porque los parámetros quedaron cortos. Inspirada en passlib (BSD) y en la
// implementación de bcrypt de OpenBSD (ISC). En inglés: importar "password".
//
//   importar "clave"
//   sea h = clave_hash("mi contraseña")                // Argon2id (OWASP)
//   clave_verificar("mi contraseña", h)                // verdadero
//   sea b = clave_bcrypt("hola", 12)                    // $2b$12$…
//   clave_verificar("hola", b)                          // verdadero
//   clave_rehacer(b, {"algoritmo": "argon2id"})         // verdadero: migrar

