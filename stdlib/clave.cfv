funcion _cl_pi_palabras() {
    sea r = []
    sea i = 0
    mientras (i < longitud(_CL_PI)) {
        r.agregar(bytes_leer_entero(bytes_de_hex(subcadena(_CL_PI, i, i + 8)), 0, 4, 0))
        i = i + 8
    }
    retornar r
}

sea _CL_INICIAL = nulo

// ── Blowfish ──────────────────────────────────────────────────────────────

funcion _cl_estado() {
    si (_CL_INICIAL == nulo) { _CL_INICIAL = _cl_pi_palabras() }
    sea p = []
    sea s = []
    sea i = 0
    mientras (i < 18) { p.agregar(_CL_INICIAL[i])  i = i + 1 }
    mientras (i < 1042) { s.agregar(_CL_INICIAL[i])  i = i + 1 }
    retornar {"p": p, "s": s}
}

// Cifra el par [L, R] con el estado (16 rondas de Feistel).
funcion _cl_cifrar(st, l, r) {
    sea p = st["p"]
    sea s = st["s"]
    sea i = 0
    mientras (i < 16) {
        l = bits_xo(l, p[i])
        sea a = cociente(l, 16777216)
        sea b = cociente(l, 65536) % 256
        sea c = cociente(l, 256) % 256
        sea d = l % 256
        sea f = ((bits_xo((s[a] + s[256 + b]) % _CL_M32, s[512 + c])) + s[768 + d]) % _CL_M32
        r = bits_xo(r, f)
        sea t = l
        l = r
        r = t
        i = i + 1
    }
    sea t2 = l
    l = r
    r = t2
    r = bits_xo(r, p[16])
    l = bits_xo(l, p[17])
    retornar [l, r]
}

// Palabra de 32 bits que recorre los datos de forma cíclica.
funcion _cl_palabra(datos, pos) {
    sea w = 0
    sea k = 0
    mientras (k < 4) {
        w = w * 256 + byte_en(datos, pos[0])
        pos[0] = (pos[0] + 1) % longitud(datos)
        k = k + 1
    }
    retornar w
}

funcion _cl_expandir(st, clave, sal) {
    sea pk = [0]
    sea i = 0
    mientras (i < 18) { st["p"][i] = bits_xo(st["p"][i], _cl_palabra(clave, pk))  i = i + 1 }
    sea l = 0
    sea r = 0
    sea ps = [0]
    i = 0
    mientras (i < 18) {
        si (sal != nulo) { l = bits_xo(l, _cl_palabra(sal, ps))  r = bits_xo(r, _cl_palabra(sal, ps)) }
        sea lr = _cl_cifrar(st, l, r)
        l = lr[0]
        r = lr[1]
        st["p"][i] = l
        st["p"][i + 1] = r
        i = i + 2
    }
    i = 0
    mientras (i < 1024) {
        si (sal != nulo) { l = bits_xo(l, _cl_palabra(sal, ps))  r = bits_xo(r, _cl_palabra(sal, ps)) }
        sea lr = _cl_cifrar(st, l, r)
        l = lr[0]
        r = lr[1]
        st["s"][i] = l
        st["s"][i + 1] = r
        i = i + 2
    }
}

sea _CL_B64 = "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

funcion _cl_b64(b, n) {
    // Base64 de bcrypt (otro alfabeto, sin relleno), n caracteres.
    sea r = ""
    sea i = 0
    mientras (longitud(r) < n) {
        sea c1 = byte_en(b, i)
        sea c2 = 0
        sea c3 = 0
        si (i + 1 < longitud(b)) { c2 = byte_en(b, i + 1) }
        si (i + 2 < longitud(b)) { c3 = byte_en(b, i + 2) }
        sea v = c1 * 65536 + c2 * 256 + c3
        sea k = 0
        mientras (k < 4 y longitud(r) < n) {
            r = r + subcadena(_CL_B64, cociente(v, 262144), cociente(v, 262144) + 1)
            v = (v % 262144) * 64
            k = k + 1
        }
        i = i + 3
    }
    retornar r
}

funcion _cl_de_b64(t, nbytes) {
    sea r = ""
    sea acc = 0
    sea bits = 0
    sea i = 0
    mientras (i < longitud(t) y longitud(r) < nbytes) {
        sea v = texto_indice(_CL_B64, subcadena(t, i, i + 1))
        si (v < 0) { lanzar "clave: base64 de bcrypt inválido" }
        acc = acc * 64 + v
        bits = bits + 6
        si (bits >= 8) {
            bits = bits - 8
            sea div = 1
            sea k = 0
            mientras (k < bits) { div = div * 2  k = k + 1 }
            r = r + bytes_entero(cociente(acc, div), 1, 0)
            acc = acc % div
        }
        i = i + 1
    }
    retornar r
}

/// Hash bcrypt crudo (23 bytes) para una clave de hasta 72 bytes, sal de 16
/// bytes y costo 4–31.
funcion clave_bcrypt_crudo(contrasena, sal, costo) {
    si (costo < 4 o costo > 31) { lanzar "clave: el costo de bcrypt va de 4 a 31" }
    si (longitud(sal) != 16) { lanzar "clave: la sal de bcrypt mide 16 bytes" }
    sea k = "" + contrasena + caracter(0)
    si (longitud(k) > 72) { k = subcadena(k, 0, 72) }
    sea st = _cl_estado()
    _cl_expandir(st, k, sal)
    sea vueltas = 1
    sea i = 0
    mientras (i < costo) { vueltas = vueltas * 2  i = i + 1 }
    i = 0
    mientras (i < vueltas) {
        _cl_expandir(st, k, nulo)
        _cl_expandir(st, sal, nulo)
        i = i + 1
    }
    sea txt = "OrpheanBeholderScryDoubt"
    sea w = []
    i = 0
    mientras (i < 24) { w.agregar(bytes_leer_entero(txt, i, 4, 0))  i = i + 4 }
    sea j = 0
    mientras (j < 64) {
        i = 0
        mientras (i < 6) {
            sea lr = _cl_cifrar(st, w[i], w[i + 1])
            w[i] = lr[0]
            w[i + 1] = lr[1]
            i = i + 2
        }
        j = j + 1
    }
    sea r = ""
    para x en w { r = r + bytes_entero(x, 4, 0) }
    retornar subcadena(r, 0, 23)
}

/// "$2b$<costo>$<sal><hash>". costo: 4–31 (12 por defecto). sal: 16 bytes
/// (aleatoria si es nulo).
funcion clave_bcrypt(contrasena, costo, sal) {
    sea c = costo ?? 12
    sea s = sal ?? bytes_aleatorios(16)
    sea cc = "" + c
    si (c < 10) { cc = "0" + cc }
    retornar "$2b$" + cc + "$" + _cl_b64(s, 22) + _cl_b64(clave_bcrypt_crudo(contrasena, s, c), 31)
}

funcion _cl_bcrypt_verificar(contrasena, h) {
    si (longitud(h) != 60) { retornar falso }
    sea v = subcadena(h, 1, 3)
    si (v != "2b" y v != "2a" y v != "2y") { retornar falso }
    sea c = a_numero(subcadena(h, 4, 6))
    sea sal = _cl_de_b64(subcadena(h, 7, 29), 16)
    sea k = "" + contrasena
    // $2a$ calculaba mal la longitud de claves de más de 255 bytes; aquí se
    // trata igual que $2b$ (truncar a 72), como hacen OpenBSD y Python.
    retornar comparar_seguro(subcadena(h, 29, 60), _cl_b64(clave_bcrypt_crudo(k, sal, c), 31))
}

// ── scrypt ────────────────────────────────────────────────────────────────

funcion _cl_rotl(x, n) {
    sea div = 1
    sea k = 0
    mientras (k < 32 - n) { div = div * 2  k = k + 1 }
    sea mul = _CL_M32 / div
    retornar (x % div) * mul + cociente(x, div)
}

funcion _cl_salsa8(b) {
    sea x = []
    para v en b { x.agregar(v) }
    sea i = 0
    mientras (i < 4) {
        x[4] = bits_xo(x[4], _cl_rotl((x[0] + x[12]) % _CL_M32, 7))
        x[8] = bits_xo(x[8], _cl_rotl((x[4] + x[0]) % _CL_M32, 9))
        x[12] = bits_xo(x[12], _cl_rotl((x[8] + x[4]) % _CL_M32, 13))
        x[0] = bits_xo(x[0], _cl_rotl((x[12] + x[8]) % _CL_M32, 18))
        x[9] = bits_xo(x[9], _cl_rotl((x[5] + x[1]) % _CL_M32, 7))
        x[13] = bits_xo(x[13], _cl_rotl((x[9] + x[5]) % _CL_M32, 9))
        x[1] = bits_xo(x[1], _cl_rotl((x[13] + x[9]) % _CL_M32, 13))
        x[5] = bits_xo(x[5], _cl_rotl((x[1] + x[13]) % _CL_M32, 18))
        x[14] = bits_xo(x[14], _cl_rotl((x[10] + x[6]) % _CL_M32, 7))
        x[2] = bits_xo(x[2], _cl_rotl((x[14] + x[10]) % _CL_M32, 9))
        x[6] = bits_xo(x[6], _cl_rotl((x[2] + x[14]) % _CL_M32, 13))
        x[10] = bits_xo(x[10], _cl_rotl((x[6] + x[2]) % _CL_M32, 18))
        x[3] = bits_xo(x[3], _cl_rotl((x[15] + x[11]) % _CL_M32, 7))
        x[7] = bits_xo(x[7], _cl_rotl((x[3] + x[15]) % _CL_M32, 9))
        x[11] = bits_xo(x[11], _cl_rotl((x[7] + x[3]) % _CL_M32, 13))
        x[15] = bits_xo(x[15], _cl_rotl((x[11] + x[7]) % _CL_M32, 18))
        x[1] = bits_xo(x[1], _cl_rotl((x[0] + x[3]) % _CL_M32, 7))
        x[2] = bits_xo(x[2], _cl_rotl((x[1] + x[0]) % _CL_M32, 9))
        x[3] = bits_xo(x[3], _cl_rotl((x[2] + x[1]) % _CL_M32, 13))
        x[0] = bits_xo(x[0], _cl_rotl((x[3] + x[2]) % _CL_M32, 18))
        x[6] = bits_xo(x[6], _cl_rotl((x[5] + x[4]) % _CL_M32, 7))
        x[7] = bits_xo(x[7], _cl_rotl((x[6] + x[5]) % _CL_M32, 9))
        x[4] = bits_xo(x[4], _cl_rotl((x[7] + x[6]) % _CL_M32, 13))
        x[5] = bits_xo(x[5], _cl_rotl((x[4] + x[7]) % _CL_M32, 18))
        x[11] = bits_xo(x[11], _cl_rotl((x[10] + x[9]) % _CL_M32, 7))
        x[8] = bits_xo(x[8], _cl_rotl((x[11] + x[10]) % _CL_M32, 9))
        x[9] = bits_xo(x[9], _cl_rotl((x[8] + x[11]) % _CL_M32, 13))
        x[10] = bits_xo(x[10], _cl_rotl((x[9] + x[8]) % _CL_M32, 18))
        x[12] = bits_xo(x[12], _cl_rotl((x[15] + x[14]) % _CL_M32, 7))
        x[13] = bits_xo(x[13], _cl_rotl((x[12] + x[15]) % _CL_M32, 9))
        x[14] = bits_xo(x[14], _cl_rotl((x[13] + x[12]) % _CL_M32, 13))
        x[15] = bits_xo(x[15], _cl_rotl((x[14] + x[13]) % _CL_M32, 18))
        i = i + 1
    }
    sea r = []
    i = 0
    mientras (i < 16) { r.agregar((x[i] + b[i]) % _CL_M32)  i = i + 1 }
    retornar r
}

// BlockMix sobre 2r bloques de 16 palabras (lista plana de 32r palabras).
funcion _cl_blockmix(b, r) {
    sea x = []
    sea i = (2 * r - 1) * 16
    mientras (i < 2 * r * 16) { x.agregar(b[i])  i = i + 1 }
    sea ys = []
    sea j = 0
    mientras (j < 2 * r) {
        sea t = []
        sea k = 0
        mientras (k < 16) { t.agregar(bits_xo(x[k], b[j * 16 + k]))  k = k + 1 }
        x = _cl_salsa8(t)
        ys.agregar(x)
        j = j + 1
    }
    sea out = []
    j = 0
    mientras (j < 2 * r) { para v en ys[j] { out.agregar(v) }  j = j + 2 }
    j = 1
    mientras (j < 2 * r) { para v en ys[j] { out.agregar(v) }  j = j + 2 }
    retornar out
}

funcion _cl_romix(bloque, r, n) {
    sea x = []
    sea i = 0
    mientras (i < 32 * r) { x.agregar(bytes_leer_entero(bloque, i * 4, 4, 1))  i = i + 1 }
    sea v = []
    i = 0
    mientras (i < n) { v.agregar(x)  x = _cl_blockmix(x, r)  i = i + 1 }
    i = 0
    mientras (i < n) {
        sea jj = x[(2 * r - 1) * 16] % n
        sea vj = v[jj]
        sea t = []
        sea k = 0
        mientras (k < 32 * r) { t.agregar(bits_xo(x[k], vj[k]))  k = k + 1 }
        x = _cl_blockmix(t, r)
        i = i + 1
    }
    sea s = ""
    para w en x { s = s + bytes_entero(w, 4, 1) }
    retornar s
}

/// scrypt (RFC 7914). n: potencia de 2 (16384), r (8), p (1), largo (32).
funcion clave_scrypt(contrasena, sal, n, r, p, largo) {
    sea nn = n ?? 16384
    sea rr = r ?? 8
    sea pp = p ?? 1
    si (nn < 2 o bits_y(nn, nn - 1) != 0) { lanzar "clave: n de scrypt debe ser potencia de 2" }
    sea b = pbkdf2_sha256("" + contrasena, sal, 1, pp * 128 * rr)
    sea mezcla = ""
    sea i = 0
    mientras (i < pp) {
        mezcla = mezcla + _cl_romix(subcadena(b, i * 128 * rr, (i + 1) * 128 * rr), rr, nn)
        i = i + 1
    }
    retornar pbkdf2_sha256("" + contrasena, mezcla, 1, largo ?? 32)
}

// ── Formatos PHC y verificación unificada ─────────────────────────────────

funcion _cl_phc(h) {
    // $id$[v=..$]params$sal$hash
    sea partes = texto_dividir(h, "$")
    si (longitud(partes) < 5) { lanzar "clave: formato PHC inválido" }
    sea r = {"id": partes[1], "params": {}, "sal": "", "hash": ""}
    sea i = 2
    si (texto_empieza_con(partes[2], "v=")) { r["version"] = a_numero(subcadena(partes[2], 2, longitud(partes[2])))  i = 3 }
    para kv en texto_dividir(partes[i], ",") {
        sea e = texto_indice(kv, "=")
        si (e > 0) { r["params"][subcadena(kv, 0, e)] = subcadena(kv, e + 1, longitud(kv)) }
    }
    r["sal"] = _cl_de_b64_phc(partes[i + 1])
    r["hash"] = _cl_de_b64_phc(partes[i + 2])
    retornar r
}

funcion _cl_de_b64_phc(t) {
    sea x = texto_reemplazar(texto_reemplazar(texto_reemplazar("" + t, "-", "+"), "_", "/"), ".", "+")
    mientras (longitud(x) % 4 != 0) { x = x + "=" }
    retornar base64_decodificar(x)
}

funcion _cl_b64_phc(b) {
    sea t = base64_codificar(b)
    mientras (texto_termina_con(t, "=")) { t = subcadena(t, 0, longitud(t) - 1) }
    retornar t
}

/// Hash de contraseña. opciones: algoritmo ("argon2id" | "bcrypt" | "scrypt"
/// | "pbkdf2_sha256"), y sus parámetros: t (2), m (19456 KiB), p (1);
/// costo (12); n (32768), r (8); iteraciones (600000).
funcion clave_hash(contrasena, opciones) {
    sea o = opciones ?? {}
    sea alg = o["algoritmo"] ?? "argon2id"
    si (alg == "bcrypt") { retornar clave_bcrypt(contrasena, o["costo"] ?? 12, nulo) }
    sea sal = o["sal"] ?? bytes_aleatorios(16)
    si (alg == "argon2id") {
        sea t = o["t"] ?? 2
        sea m = o["m"] ?? 19456
        sea p = o["p"] ?? 1
        retornar "$argon2id$v=19$m=" + m + ",t=" + t + ",p=" + p + "$" + _cl_b64_phc(sal) + "$" + _cl_b64_phc(argon2id("" + contrasena, sal, t, m, p, o["largo"] ?? 32))
    }
    si (alg == "scrypt") {
        sea n = o["n"] ?? 32768
        sea r = o["r"] ?? 8
        sea p = o["p"] ?? 1
        sea ln = 0
        sea x = n
        mientras (x > 1) { x = x / 2  ln = ln + 1 }
        retornar "$scrypt$ln=" + ln + ",r=" + r + ",p=" + p + "$" + _cl_b64_phc(sal) + "$" + _cl_b64_phc(clave_scrypt(contrasena, sal, n, r, p, o["largo"] ?? 32))
    }
    si (alg == "pbkdf2_sha256") {
        sea it = o["iteraciones"] ?? 600000
        retornar "$pbkdf2-sha256$i=" + it + "$" + _cl_b64_phc(sal) + "$" + _cl_b64_phc(pbkdf2_sha256("" + contrasena, sal, it, o["largo"] ?? 32))
    }
    lanzar "clave: algoritmo desconocido " + alg
}

/// Verifica una contraseña contra un hash bcrypt, Argon2id, scrypt o
/// PBKDF2 (formato PHC o el de Django "pbkdf2_sha256$it$sal$hash").
/// Compara en tiempo constante; un formato inválido devuelve falso.
funcion clave_verificar(contrasena, h) {
    sea ok = falso
    intentar {
        si (texto_empieza_con(h, "$2")) { ok = _cl_bcrypt_verificar(contrasena, h) } sino {
            si (texto_empieza_con(h, "pbkdf2_sha256$")) {
                sea pd = texto_dividir(h, "$")
                ok = comparar_seguro(base64_codificar(pbkdf2_sha256("" + contrasena, pd[2], a_numero(pd[1]), longitud(base64_decodificar(pd[3])))), pd[3])
            } sino {
                sea x = _cl_phc(h)
                sea calc = nulo
                si (x["id"] == "argon2id") { calc = argon2id("" + contrasena, x["sal"], a_numero(x["params"]["t"]), a_numero(x["params"]["m"]), a_numero(x["params"]["p"]), longitud(x["hash"])) }
                si (x["id"] == "scrypt") {
                    sea n = 1
                    sea k = 0
                    mientras (k < a_numero(x["params"]["ln"])) { n = n * 2  k = k + 1 }
                    calc = clave_scrypt(contrasena, x["sal"], n, a_numero(x["params"]["r"]), a_numero(x["params"]["p"]), longitud(x["hash"]))
                }
                si (x["id"] == "pbkdf2-sha256") { calc = pbkdf2_sha256("" + contrasena, x["sal"], a_numero(x["params"]["i"]), longitud(x["hash"])) }
                si (calc != nulo) { ok = comparar_seguro(calc, x["hash"]) }
            }
        }
    } capturar (e) { ok = falso }
    retornar ok
}

/// Parámetros de un hash: {"algoritmo", y los de cada uno}.
funcion clave_info(h) {
    si (texto_empieza_con(h, "$2")) { retornar {"algoritmo": "bcrypt", "version": subcadena(h, 1, 3), "costo": a_numero(subcadena(h, 4, 6))} }
    si (texto_empieza_con(h, "pbkdf2_sha256$")) { retornar {"algoritmo": "pbkdf2_sha256", "iteraciones": a_numero(texto_dividir(h, "$")[1])} }
    sea x = _cl_phc(h)
    sea r = {"algoritmo": texto_reemplazar(x["id"], "-", "_")}
    para k en claves(x["params"]) { r[k] = a_numero(x["params"][k]) }
    si (tiene_clave(r, "ln")) {
        sea n = 1
        sea k2 = 0
        mientras (k2 < r["ln"]) { n = n * 2  k2 = k2 + 1 }
        r["n"] = n
    }
    si (tiene_clave(r, "i")) { r["iteraciones"] = r["i"] }
    retornar r
}

/// ¿Conviene volver a calcular el hash (al iniciar sesión) porque usa otro
/// algoritmo o parámetros más débiles que las opciones dadas?
funcion clave_rehacer(h, opciones) {
    sea o = opciones ?? {}
    sea alg = o["algoritmo"] ?? "argon2id"
    sea i = clave_info(h)
    si (i["algoritmo"] != alg) { retornar verdadero }
    si (alg == "bcrypt") { retornar i["costo"] < (o["costo"] ?? 12) o i["version"] != "2b" }
    si (alg == "argon2id") { retornar i["t"] < (o["t"] ?? 2) o i["m"] < (o["m"] ?? 19456) o i["p"] != (o["p"] ?? 1) }
    si (alg == "scrypt") { retornar i["n"] < (o["n"] ?? 32768) o i["r"] < (o["r"] ?? 8) }
    retornar i["iteraciones"] < (o["iteraciones"] ?? 600000)
}

/// Estimación de la fuerza de una contraseña: {"bits", "nivel" (0–4),
/// "avisos": [...]}. Penaliza contraseñas comunes, repeticiones y series.
funcion clave_fuerza(contrasena) {
    sea c = "" + contrasena
    sea avisos = []
    sea comunes = ["123456", "password", "contrasena", "qwerty", "123456789", "12345678", "111111", "abc123", "iloveyou", "admin", "letmein", "welcome", "monkey", "dragon", "football", "baseball", "superman", "hola123", "chile123", "000000"]
    sea min = texto_minusculas(c)
    para w en comunes { si (min == w o texto_indice(min, w) >= 0) { avisos.agregar("contiene una contraseña muy común: " + w) } }
    sea clases = 0
    sea tiene = {"min": falso, "may": falso, "num": falso, "otro": falso}
    sea i = 0
    mientras (i < longitud(c)) {
        sea b = byte_en(c, i)
        si (b >= 97 y b <= 122) { tiene["min"] = verdadero } sino {
            si (b >= 65 y b <= 90) { tiene["may"] = verdadero } sino {
                si (b >= 48 y b <= 57) { tiene["num"] = verdadero } sino { tiene["otro"] = verdadero }
            }
        }
        i = i + 1
    }
    sea alfabeto = 0
    si (tiene["min"]) { alfabeto = alfabeto + 26 }
    si (tiene["may"]) { alfabeto = alfabeto + 26 }
    si (tiene["num"]) { alfabeto = alfabeto + 10 }
    si (tiene["otro"]) { alfabeto = alfabeto + 33 }
    // Largo efectivo: repeticiones y series consecutivas cuentan poco.
    sea efectivo = 0
    i = 0
    mientras (i < longitud(c)) {
        sea peso = 1
        si (i > 0) {
            sea d = byte_en(c, i) - byte_en(c, i - 1)
            si (d == 0) { peso = 0.25 }
            si (d == 1 o d == -1) { peso = 0.5 }
        }
        efectivo = efectivo + peso
        i = i + 1
    }
    sea bits = 0
    si (alfabeto > 0) { bits = efectivo * logaritmo(alfabeto) / logaritmo(2) }
    si (longitud(avisos) > 0) { bits = minimo(bits, 20) }
    si (longitud(c) < 8) { avisos.agregar("muy corta: usa al menos 12 caracteres") }
    sea nivel = 0
    si (bits >= 28) { nivel = 1 }
    si (bits >= 36) { nivel = 2 }
    si (bits >= 60) { nivel = 3 }
    si (bits >= 80) { nivel = 4 }
    retornar {"bits": redondear(bits, 1), "nivel": nivel, "avisos": avisos}
}
