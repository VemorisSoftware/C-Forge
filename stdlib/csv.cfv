// stdlib/csv.cfv — CSV según RFC 4180: comillas, comillas dobles escapadas,
// saltos de línea dentro de campos, CRLF y separador configurable.
// Inspirada en csv-rs (MIT/Unlicense). Protegida contra inyección de
// fórmulas al exportar (=, +, -, @ al inicio) con csv_escribir_seguro.
//
//   importar "csv"
//   sea filas = csv_leer("nombre,edad\nAna,30\n")       // lista de listas
//   sea registros = csv_registros(texto)                 // lista de mapas (cabecera)
//   escribir_archivo("salida.csv", csv_escribir(filas))

/// Texto CSV → lista de filas (cada fila, lista de textos).
funcion csv_leer(texto, separador) {
    sea sep = separador
    si (sep == nulo) { sep = "," }
    si (longitud(sep) != 1) { lanzar "csv: el separador es un solo carácter" }
    sea filas = []
    sea fila = []
    sea campo = []
    sea i = 0
    sea n = longitud(texto)
    sea entre_comillas = falso
    sea hubo_algo = falso
    mientras (i < n) {
        sea c = subcadena(texto, i, i + 1)
        si (entre_comillas) {
            si (c == "\"") {
                si (i + 1 < n y subcadena(texto, i + 1, i + 2) == "\"") {
                    campo.agregar("\"")
                    i = i + 1
                } sino { entre_comillas = falso }
            } sino { campo.agregar(c) }
        } sino {
            si (c == "\"") {
                entre_comillas = verdadero
                hubo_algo = verdadero
            } sino {
                si (c == sep) {
                    fila.agregar(unir(campo, ""))
                    campo = []
                    hubo_algo = verdadero
                } sino {
                    si (c == "\n" o c == "\r") {
                        si (c == "\r" y i + 1 < n y subcadena(texto, i + 1, i + 2) == "\n") { i = i + 1 }
                        si (hubo_algo o longitud(campo) > 0 o longitud(fila) > 0) {
                            fila.agregar(unir(campo, ""))
                            filas.agregar(fila)
                        }
                        fila = []
                        campo = []
                        hubo_algo = falso
                    } sino {
                        campo.agregar(c)
                        hubo_algo = verdadero
                    }
                }
            }
        }
        i = i + 1
    }
    si (entre_comillas) { lanzar "csv: comillas sin cerrar" }
    si (hubo_algo o longitud(campo) > 0 o longitud(fila) > 0) {
        fila.agregar(unir(campo, ""))
        filas.agregar(fila)
    }
    retornar filas
}

/// Con cabecera: lista de mapas {columna: valor}.
funcion csv_registros(texto, separador) {
    sea filas = csv_leer(texto, separador)
    si (longitud(filas) == 0) { retornar [] }
    sea cabecera = filas[0]
    sea r = []
    sea i = 1
    mientras (i < longitud(filas)) {
        sea m = {}
        sea j = 0
        mientras (j < longitud(cabecera)) {
            si (j < longitud(filas[i])) { m[cabecera[j]] = filas[i][j] } sino { m[cabecera[j]] = "" }
            j = j + 1
        }
        r.agregar(m)
        i = i + 1
    }
    retornar r
}

funcion _csv_campo(v, sep, seguro) {
    sea t = ""
    si (v != nulo) { t = "" + v }
    si (seguro y longitud(t) > 0 y texto_indice("=+-@\t\r", subcadena(t, 0, 1)) >= 0) { t = "'" + t }
    si (texto_indice(t, sep) >= 0 o texto_indice(t, "\"") >= 0 o texto_indice(t, "\n") >= 0 o texto_indice(t, "\r") >= 0) {
        retornar "\"" + texto_reemplazar(t, "\"", "\"\"") + "\""
    }
    retornar t
}

funcion _csv_escribir(filas, separador, seguro) {
    sea sep = separador
    si (sep == nulo) { sep = "," }
    sea lineas = []
    para fila en filas {
        sea campos = []
        para v en fila { campos.agregar(_csv_campo(v, sep, seguro)) }
        lineas.agregar(unir(campos, sep))
    }
    retornar unir(lineas, "\r\n") + "\r\n"
}

/// Lista de filas → texto CSV (CRLF, comillas solo donde hacen falta).
funcion csv_escribir(filas, separador) { retornar _csv_escribir(filas, separador, falso) }

/// Igual, pero neutraliza fórmulas (=, +, -, @) para abrir en Excel sin riesgo.
funcion csv_escribir_seguro(filas, separador) { retornar _csv_escribir(filas, separador, verdadero) }

/// Lista de mapas → CSV con cabecera (orden de columnas del primer mapa o el dado).
funcion csv_desde_registros(registros, columnas) {
    si (longitud(registros) == 0) { retornar "" }
    sea cols = columnas
    si (cols == nulo) { cols = claves(registros[0]) }
    sea filas = [cols]
    para r en registros {
        sea f = []
        para c en cols { f.agregar(r[c] ?? "") }
        filas.agregar(f)
    }
    retornar csv_escribir(filas)
}
