// stdlib/casco.cfv — cabeceras HTTP de seguridad con valores sensatos
// (CSP, HSTS, anti-clickjacking, nosniff…). Inspirada en Helmet (MIT).
// En inglés: importar "helmet".
//
//   importar "casco"
//   sea h = casco_cabeceras({"csp": {"script-src": ["'self'", "https://cdn.x.cl"]}})
//   // con web_responder: pasa h, o casco_texto(h) para escribirlas a mano
//
// Opciones: {"csp": falso | mapa de directivas extra, "hsts": falso | segundos,
// "marcos"/"frames": "DENY" | "SAMEORIGIN", "referer"/"referrer": política,
// "extra": mapa de cabeceras}.

importar "base64"

sea _CASCO_CSP = {
    "default-src": ["'self'"], "base-uri": ["'self'"], "font-src": ["'self'", "https:", "data:"],
    "form-action": ["'self'"], "frame-ancestors": ["'self'"], "img-src": ["'self'", "data:"],
    "object-src": ["'none'"], "script-src": ["'self'"], "script-src-attr": ["'none'"],
    "style-src": ["'self'", "https:", "'unsafe-inline'"], "upgrade-insecure-requests": []
}

/// Arma el valor de Content-Security-Policy; las directivas dadas
/// reemplazan a las de por defecto (un valor falso la quita).
funcion casco_csp(directivas) {
    sea d = {}
    para k en claves(_CASCO_CSP) { d[k] = _CASCO_CSP[k] }
    si (directivas != nulo) { para k en claves(directivas) { d[k] = directivas[k] } }
    sea partes = []
    para k en claves(d) {
        si (d[k] != falso) {
            sea v = d[k]
            si (tipo(v) == "texto") { v = [v] }
            si (longitud(v) == 0) { partes.agregar(k) } sino { partes.agregar(k + " " + unir(v, " ")) }
        }
    }
    retornar unir(partes, "; ")
}

/// Valor aleatorio para 'nonce-…' en scripts en línea (16 bytes, base64).
funcion casco_nonce() { retornar base64_codificar(bytes_aleatorios(16)) }

funcion _cs_op(o, k, defecto) {
    si (tiene_clave(o, k)) { retornar o[k] }
    retornar defecto
}

funcion casco_cabeceras(opciones) {
    sea o = opciones ?? {}
    sea h = {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Resource-Policy": "same-origin",
        "Origin-Agent-Cluster": "?1",
        "Referrer-Policy": _cs_op(o, "referer", _cs_op(o, "referrer", "no-referrer")),
        "X-Content-Type-Options": "nosniff",
        "X-DNS-Prefetch-Control": "off",
        "X-Download-Options": "noopen",
        "X-Frame-Options": _cs_op(o, "marcos", _cs_op(o, "frames", "SAMEORIGIN")),
        "X-Permitted-Cross-Domain-Policies": "none",
        "X-XSS-Protection": "0",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()"
    }
    sea csp = _cs_op(o, "csp", verdadero)
    si (csp != falso) {
        sea extra = nulo
        si (tipo(csp) == "mapa") { extra = csp }
        h["Content-Security-Policy"] = casco_csp(extra)
    }
    sea hsts = _cs_op(o, "hsts", 31536000)
    si (hsts != falso) { h["Strict-Transport-Security"] = "max-age=" + hsts + "; includeSubDomains" }
    sea extras = _cs_op(o, "extra", {})
    para k en claves(extras) { h[k] = extras[k] }
    retornar h
}

/// "Nombre: valor\r\n" por cabecera. Rechaza saltos de línea (inyección
/// de cabeceras / división de respuesta).
funcion casco_texto(h) {
    sea r = ""
    para k en claves(h) {
        sea v = "" + h[k]
        si (texto_indice(k + v, "\r") >= 0 o texto_indice(k + v, "\n") >= 0) { lanzar "casco: salto de línea en la cabecera " + k }
        r = r + k + ": " + v + "\r\n"
    }
    retornar r
}
