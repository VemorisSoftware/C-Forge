// stdlib/suricata.cfv — captura pcap y reglas de detección: nombres en inglés del módulo "centinela".
// English names for the "centinela" module; both can be used together.

importar "centinela"

funcion _suricata_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_suricata_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _suricata_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _SURICATA_RES = {"origen": "src", "destino": "dst", "puerto_origen": "src_port", "puerto_destino": "dst_port", "carga": "payload", "tam": "length", "veces": "count", "fragmento": "fragment"}

funcion pcap_read(datos) { retornar centinela_pcap(datos) }
funcion pcap_write(paquetes, enlace) { retornar centinela_pcap_escribir(paquetes, enlace) }
funcion packet_decode(datos, enlace) { retornar _suricata_tr(centinela_decodificar(datos, enlace), _SURICATA_RES) }
funcion suricata_rule(linea) { retornar centinela_regla(linea) }
funcion suricata_engine(reglas_texto, variables) { retornar centinela_motor(reglas_texto, variables) }
funcion suricata_eval(motor, q, t) { retornar centinela_evaluar(motor, q, t) }
funcion suricata_analyze(motor, pcap) { retornar centinela_analizar(motor, pcap) }
funcion suricata_summary(alertas) { retornar _suricata_tr(centinela_resumen(alertas), _SURICATA_RES) }
funcion suricata_fast(a) { retornar centinela_fast(a) }
