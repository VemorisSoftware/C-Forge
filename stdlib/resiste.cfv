// stdlib/resiste.cfv — resiliencia: reintentos con espera exponencial y
// cortacircuitos (circuit breaker). Inspirada en Polly (BSD). En inglés:
// importar "resilience".
//
//   importar "resiste"
//   sea datos = resiste_reintentar(funcion() { retornar http_obtener(url) }, 4, 100, 2)
//   sea c = resiste_cortacircuitos(5, 30000)    // abre tras 5 fallas, 30 s de pausa
//   resiste_llamar(c, funcion() { retornar pagar(pedido) })

/// Llama f() hasta "intentos" veces; entre fallas espera espera_ms,
/// multiplicada por "factor" cada vez (más un azar de ±20 % para no
/// sincronizar clientes). Si todas fallan, relanza el último error.
funcion resiste_reintentar(f, intentos, espera_ms, factor) {
    sea n = intentos ?? 3
    sea espera = espera_ms ?? 100
    sea k = factor ?? 2
    si (n < 1) { lanzar "resiste: al menos un intento" }
    sea ultimo = nulo
    sea i = 0
    mientras (i < n) {
        intentar { retornar f() } capturar (e) { ultimo = e }
        i = i + 1
        si (i < n y espera > 0) {
            dormir(piso(espera * (0.8 + aleatorio() * 0.4)))
            espera = espera * k
        }
    }
    lanzar ultimo
}

/// Cortacircuitos: tras "umbral" fallas seguidas se abre y rechaza las
/// llamadas al instante durante enfriamiento_ms; luego deja pasar una de
/// prueba (semiabierto): si sale bien se cierra, si falla vuelve a abrirse.
funcion resiste_cortacircuitos(umbral, enfriamiento_ms) {
    retornar {"umbral": umbral ?? 5, "enfriamiento": enfriamiento_ms ?? 30000, "fallas": 0, "estado": "cerrado", "abierto_en": 0}
}

/// "cerrado", "abierto" o "semiabierto".
funcion resiste_estado(c) {
    si (c["estado"] == "abierto" y cfv_fecha_ahora_ms() - c["abierto_en"] >= c["enfriamiento"]) { c["estado"] = "semiabierto" }
    retornar c["estado"]
}

funcion resiste_llamar(c, f) {
    si (resiste_estado(c) == "abierto") { lanzar "resiste: circuito abierto" }
    sea resultado = nulo
    intentar {
        resultado = f()
    } capturar (e) {
        c["fallas"] = c["fallas"] + 1
        si (c["estado"] == "semiabierto" o c["fallas"] >= c["umbral"]) {
            c["estado"] = "abierto"
            c["abierto_en"] = cfv_fecha_ahora_ms()
        }
        lanzar e
    }
    c["fallas"] = 0
    c["estado"] = "cerrado"
    retornar resultado
}
