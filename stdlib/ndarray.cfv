// stdlib/ndarray.cfv — arreglos de N dimensiones: nombres en inglés del módulo "matriz".
// English names for the "matriz" module; both can be used together.

importar "matriz"

funcion ndarray_from(lista) { retornar matriz_de(lista) }
funcion ndarray_full(forma, valor) { retornar matriz_llena(forma, valor) }
funcion ndarray_zeros(forma) { retornar matriz_ceros(forma) }
funcion ndarray_ones(forma) { retornar matriz_unos(forma) }
funcion ndarray_eye(n) { retornar matriz_identidad(n) }
funcion ndarray_arange(desde, hasta, paso) { retornar matriz_rango(desde, hasta, paso) }
funcion ndarray_linspace(a, b, n) { retornar matriz_espacio(a, b, n) }
funcion ndarray_shape(m) { retornar matriz_forma(m) }
funcion ndarray_size(m) { retornar matriz_tamano(m) }
funcion ndarray_reshape(m, forma) { retornar matriz_remodelar(m, forma) }
funcion ndarray_get(m, indices) { retornar matriz_obtener(m, indices) }
funcion ndarray_set(m, indices, v) { retornar matriz_poner(m, indices, v) }
funcion ndarray_to_list(m) { retornar matriz_a_lista(m) }
funcion ndarray_map(m, f) { retornar matriz_aplicar(m, f) }
funcion ndarray_add(a, b) { retornar matriz_sumar(a, b) }
funcion ndarray_sub(a, b) { retornar matriz_restar(a, b) }
funcion ndarray_mul(a, b) { retornar matriz_multiplicar(a, b) }
funcion ndarray_div(a, b) { retornar matriz_dividir(a, b) }
funcion ndarray_pow(a, b) { retornar matriz_potencia(a, b) }
funcion ndarray_transpose(m) { retornar matriz_transponer(m) }
funcion ndarray_dot(a, b) { retornar matriz_punto(a, b) }
funcion ndarray_sum(m, eje) { retornar matriz_suma(m, eje) }
funcion ndarray_max(m, eje) { retornar matriz_max(m, eje) }
funcion ndarray_min(m, eje) { retornar matriz_min(m, eje) }
funcion ndarray_mean(m, eje) { retornar matriz_media(m, eje) }
funcion ndarray_argmax(m) { retornar matriz_argmax(m) }
funcion ndarray_rows(m, desde, hasta) { retornar matriz_filas(m, desde, hasta) }
funcion ndarray_allclose(a, b, tolerancia) { retornar matriz_casi_igual(a, b, tolerancia) }
