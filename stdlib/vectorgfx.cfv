// stdlib/vectorgfx.cfv — gráficos vectoriales a SVG, PDF y PNG: nombres en inglés del módulo "vector".
// English names for the "vector" module; both can be used together.


importar "vector"

funcion _vectorgfx_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_vectorgfx_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _vectorgfx_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _VECTORGFX_OPT = {"background": "fondo", "ttf_font": "fuente_ttf", "title": "titulo"}

funcion vgfx_rgba(c) { retornar vector_rgba(c) }
funcion vgfx_new(tipo_s, ancho, alto, opciones) { retornar vector_nuevo(tipo_s, ancho, alto, _vectorgfx_opt(opciones)) }
funcion vgfx_save(c) { retornar vector_guardar(c) }
funcion vgfx_restore(c) { retornar vector_restaurar(c) }
funcion vgfx_transform(c, m) { retornar vector_transformar(c, m) }
funcion vgfx_translate(c, x, y) { retornar vector_trasladar(c, x, y) }
funcion vgfx_scale(c, sx, sy) { retornar vector_escalar(c, sx, sy) }
funcion vgfx_rotate(c, radianes) { retornar vector_rotar(c, radianes) }
funcion vgfx_matrix(c) { retornar vector_matriz(c) }
funcion vgfx_set_matrix(c, m) { retornar vector_fijar_matriz(c, m) }
funcion vgfx_color(c, color) { retornar vector_color(c, color) }
funcion vgfx_linear_gradient(c, x0, y0, x1, y1, paradas) { retornar vector_degradado_lineal(c, x0, y0, x1, y1, paradas) }
funcion vgfx_radial_gradient(c, cx, cy, r0, r1, paradas) { retornar vector_degradado_radial(c, cx, cy, r0, r1, paradas) }
funcion vgfx_line_width(c, g) { retornar vector_grosor(c, g) }
funcion vgfx_line_cap(c, e) { retornar vector_extremo(c, e) }
funcion vgfx_line_join(c, u) { retornar vector_union(c, u) }
funcion vgfx_miter_limit(c, l) { retornar vector_limite_inglete(c, l) }
funcion vgfx_dash(c, lista, desfase) { retornar vector_guiones(c, lista, desfase) }
funcion vgfx_fill_rule(c, r) { retornar vector_regla(c, r) }
funcion vgfx_font(c, tam, familia, negrita) { retornar vector_fuente(c, tam, familia, negrita) }
funcion vgfx_new_path(c) { retornar vector_nuevo_camino(c) }
funcion vgfx_move_to(c, x, y) { retornar vector_mover(c, x, y) }
funcion vgfx_line_to(c, x, y) { retornar vector_linea(c, x, y) }
funcion vgfx_curve_to(c, x1, y1, x2, y2, x3, y3) { retornar vector_curva(c, x1, y1, x2, y2, x3, y3) }
funcion vgfx_quad_to(c, x1, y1, x2, y2) { retornar vector_cuadratica(c, x1, y1, x2, y2) }
funcion vgfx_close_path(c) { retornar vector_cerrar(c) }
funcion vgfx_arc(c, cx, cy, r, a0, a1, negativo) { retornar vector_arco(c, cx, cy, r, a0, a1, negativo) }
funcion vgfx_rect(c, x, y, w, h) { retornar vector_rectangulo(c, x, y, w, h) }
funcion vgfx_rounded_rect(c, x, y, w, h, r) { retornar vector_rectangulo_redondeado(c, x, y, w, h, r) }
funcion vgfx_ellipse(c, cx, cy, rx, ry) { retornar vector_elipse(c, cx, cy, rx, ry) }
funcion vgfx_circle(c, cx, cy, r) { retornar vector_circulo(c, cx, cy, r) }
funcion vgfx_svg_path(c, d) { retornar vector_camino_svg(c, d) }
funcion vgfx_path_d(c) { retornar vector_camino_d(c) }
funcion vgfx_new_page(c) { retornar vector_pagina(c) }
funcion vgfx_fill(c) { retornar vector_rellenar(c) }
funcion vgfx_fill_preserve(c) { retornar vector_rellenar_mantener(c) }
funcion vgfx_stroke(c) { retornar vector_trazar(c) }
funcion vgfx_stroke_preserve(c) { retornar vector_trazar_mantener(c) }
funcion vgfx_fill_stroke(c) { retornar vector_rellenar_y_trazar(c) }
funcion vgfx_clip(c) { retornar vector_recortar(c) }
funcion vgfx_text_width(c, texto) { retornar vector_ancho_texto(c, texto) }
funcion vgfx_text(c, x, y, texto, alinear) { retornar vector_texto(c, x, y, texto, alinear) }
funcion vgfx_image(c, img, x, y, w, h) { retornar vector_imagen(c, img, x, y, w, h) }
funcion vgfx_finish(c) { retornar vector_terminar(c) }
funcion vgfx_canvas(c) { retornar vector_lienzo(c) }
funcion vgfx_write_file(c, ruta) { retornar vector_guardar_archivo(c, ruta) }

funcion _vectorgfx_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_VECTORGFX_OPT[k] ?? k] = o[k] }
    retornar r
}

// Valores en inglés para extremos, uniones y reglas.
sea _VGFX_CAPS = {"butt": "plano", "round": "redondo", "square": "cuadrado"}
sea _VGFX_JOINS = {"miter": "inglete", "round": "redonda", "bevel": "bisel"}
sea _VGFX_RULES = {"nonzero": "no_cero", "evenodd": "par_impar"}
funcion vgfx_cap(c, e) { vector_extremo(c, _VGFX_CAPS[e] ?? e) }
funcion vgfx_join(c, u) { vector_union(c, _VGFX_JOINS[u] ?? u) }
funcion vgfx_rule(c, r) { vector_regla(c, _VGFX_RULES[r] ?? r) }
