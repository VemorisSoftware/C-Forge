// stdlib/logging.cfv — registro de eventos desacoplado: nombres en inglés del módulo "registro".
// English names for the "registro" module; both can be used together.


importar "registro"

funcion _logging_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_logging_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _logging_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _LOGGING_OPT = {"format": "formato", "pattern": "patron", "level": "nivel", "max_bytes": "max_bytes", "backups": "copias", "levels": "niveles", "sinks": "destinos", "clock": "reloj"}

funcion logging_configure(opciones) { retornar registro_configurar(_logging_opt(opciones)) }
funcion logging_reset() { retornar registro_reiniciar() }
funcion logging_get_logger(nombre) { retornar registro_obtener(nombre) }
funcion logging_bind(r, campos) { retornar registro_con(r, campos) }
funcion logging_level_of(nombre) { retornar registro_nivel_de(nombre) }
funcion logging_enabled(r, nivel) { retornar registro_activo(r, nivel) }
funcion logging_push_context(campos) { retornar registro_contexto(campos) }
funcion logging_pop_context() { retornar registro_quitar_contexto() }
funcion logging_with_context(campos, f) { retornar registro_en_contexto(campos, f) }
funcion logging_format(ev, patron) { retornar registro_formatear(ev, patron) }
funcion logging_json(ev) { retornar registro_json(ev) }
funcion logging_console(opciones) { retornar registro_pantalla(_logging_opt(opciones)) }
funcion logging_file(ruta, opciones) { retornar registro_archivo(ruta, _logging_opt(opciones)) }
funcion logging_memory(n, opciones) { retornar registro_memoria(n, _logging_opt(opciones)) }
funcion logging_callback(f, opciones) { retornar registro_funcion(f, _logging_opt(opciones)) }
funcion logging_lines(d) { retornar registro_lineas(d) }
funcion logging_events(d) { retornar registro_eventos(d) }
funcion logging_log(r, nivel, mensaje, campos) { retornar registro_evento(r, nivel, mensaje, campos) }
funcion logging_trace(r, m, c) { retornar registro_traza(r, m, c) }
funcion logging_debug(r, m, c) { retornar registro_depuracion(r, m, c) }
funcion logging_info(r, m, c) { retornar registro_info(r, m, c) }
funcion logging_warn(r, m, c) { retornar registro_aviso(r, m, c) }
funcion logging_error(r, m, c) { retornar registro_error(r, m, c) }
funcion logging_fatal(r, m, c) { retornar registro_fatal(r, m, c) }
funcion logging_counts() { retornar registro_conteo() }
funcion logging_timed(r, mensaje, f) { retornar registro_medir(r, mensaje, f) }

funcion _logging_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_LOGGING_OPT[k] ?? k] = o[k] }
    retornar r
}
