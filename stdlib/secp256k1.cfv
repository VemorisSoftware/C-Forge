// stdlib/secp256k1.cfv — curva secp256k1: nombres en inglés del módulo "curva".
// English names for the "curva" module; both can be used together.

importar "curva"

funcion secp256k1_is_valid_private(b) { retornar curva_privada_valida(b) }
funcion secp256k1_random_private() { retornar curva_privada_aleatoria() }
funcion secp256k1_public_key(priv, comprimida) { retornar curva_publica(priv, comprimida) }
funcion secp256k1_convert_public(pub, comprimida) { retornar curva_convertir(pub, comprimida) }
funcion secp256k1_add_private(a, b) { retornar curva_sumar_privadas(a, b) }
funcion secp256k1_tweak_public(pub, t, comprimida) { retornar curva_sumar_publica(pub, t, comprimida) }
funcion secp256k1_ecdh(priv, pub) { retornar curva_compartido(priv, pub) }
funcion secp256k1_sign(priv, resumen) { retornar curva_firmar(priv, resumen) }
funcion secp256k1_sign_recoverable(priv, resumen) { retornar curva_firmar_recuperable(priv, resumen) }
funcion secp256k1_verify(pub, resumen, firma) { retornar curva_verificar(pub, resumen, firma) }
funcion secp256k1_recover(resumen, firma, comprimida) { retornar curva_recuperar(resumen, firma, comprimida) }
funcion secp256k1_to_der(firma) { retornar curva_a_der(firma) }
funcion secp256k1_from_der(der) { retornar curva_de_der(der) }
funcion secp256k1_tagged_hash(etiqueta, datos) { retornar curva_hash_etiquetado(etiqueta, datos) }
funcion secp256k1_xonly_public_key(priv) { retornar curva_publica_x(priv) }
funcion schnorr_sign(priv, mensaje, aux) { retornar curva_schnorr_firmar(priv, mensaje, aux) }
funcion schnorr_verify(pubx, mensaje, firma) { retornar curva_schnorr_verificar(pubx, mensaje, firma) }
