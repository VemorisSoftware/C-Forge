// stdlib/phone.cfv — números de teléfono: nombres en inglés del módulo "telefono".
// English names for the "telefono" module; both can be used together.

importar "telefono"

funcion phone_parse(texto, pais) { retornar telefono_analizar(texto, pais) }
funcion phone_valid(texto, pais) { retornar telefono_valido(texto, pais) }
funcion phone_format(t, nacional) { retornar telefono_formatear(t, nacional) }
funcion phone_link(t, tipo_e) { retornar telefono_enlace(t, tipo_e) }
funcion phone_countries() { retornar telefono_paises() }
