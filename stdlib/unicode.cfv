sea _UC = [nulo]

funcion _uc_hex(h) {
    sea n = 0
    sea i = 0
    mientras (i < longitud(h)) {
        sea b = byte_en(h, i)
        si (b >= 65) { n = n * 16 + b - 55 } sino { n = n * 16 + b - 48 }
        i = i + 1
    }
    retornar n
}

funcion _uc_mapa(txt, lista) {
    sea r = {}
    para par en texto_dividir(txt, ";") {
        sea i = texto_indice(par, "=")
        sea v = subcadena(par, i + 1, longitud(par))
        si (lista) {
            sea l = []
            para x en texto_dividir(v, ".") { l.agregar(_uc_hex(x)) }
            r["" + _uc_hex(subcadena(par, 0, i))] = l
        } sino { r["" + _uc_hex(subcadena(par, 0, i))] = _uc_hex(v) }
    }
    retornar r
}

funcion _uc_rangos(txt) {
    sea r = []
    para par en texto_dividir(txt, ";") {
        sea i = texto_indice(par, "-")
        r.agregar([_uc_hex(subcadena(par, 0, i)), _uc_hex(subcadena(par, i + 1, longitud(par)))])
    }
    retornar r
}

funcion _uc() {
    si (_UC[0] != nulo) { retornar _UC[0] }
    sea comp = {}
    para par en texto_dividir(_UC_TXT[1], ";") {
        sea i = texto_indice(par, "=")
        sea ab = texto_dividir(subcadena(par, 0, i), ".")
        comp["" + _uc_hex(ab[0]) + "." + _uc_hex(ab[1])] = _uc_hex(subcadena(par, i + 1, longitud(par)))
    }
    sea ccc = {}
    para par en texto_dividir(_UC_TXT[4], ";") {
        sea i = texto_indice(par, "=")
        ccc["" + _uc_hex(subcadena(par, 0, i))] = a_numero(subcadena(par, i + 1, longitud(par)))
    }
    _UC[0] = {"dec": _uc_mapa(_UC_TXT[0], verdadero), "comp": comp, "min": _uc_mapa(_UC_TXT[2], verdadero), "may": _uc_mapa(_UC_TXT[3], verdadero), "ccc": ccc, "ancho": _uc_rangos(_UC_TXT[5]), "cero": _uc_rangos(_UC_TXT[6])}
    retornar _UC[0]
}

// ── Puntos de código ──────────────────────────────────────────────────────

/// Texto UTF-8 → lista de puntos de código (bytes inválidos → U+FFFD).
funcion unicode_puntos(t) {
    sea s = "" + t
    sea n = longitud(s)
    sea r = []
    sea i = 0
    mientras (i < n) {
        sea b = byte_en(s, i)
        sea largo = 1
        sea cp = b
        si (b >= 240 y b < 248) { largo = 4  cp = b - 240 }
        si (b >= 224 y b < 240) { largo = 3  cp = b - 224 }
        si (b >= 192 y b < 224) { largo = 2  cp = b - 192 }
        si (b >= 128 y b < 192) { largo = 0 }
        si (b >= 248) { largo = 0 }
        si (largo == 0 o i + largo > n) {
            r.agregar(65533)
            i = i + 1
        } sino {
            sea ok = verdadero
            sea k = 1
            mientras (k < largo) {
                sea c = byte_en(s, i + k)
                si (c < 128 o c >= 192) { ok = falso } sino { cp = cp * 64 + (c - 128) }
                k = k + 1
            }
            si (ok) {
                r.agregar(cp)
                i = i + largo
            } sino {
                r.agregar(65533)
                i = i + 1
            }
        }
    }
    retornar r
}

/// Lista de puntos de código → texto.
funcion unicode_texto(puntos) {
    sea partes = []
    para cp en puntos { partes.agregar(caracter(cp)) }
    retornar unir(partes, "")
}

/// Cantidad de puntos de código (no bytes).
funcion unicode_largo(t) { retornar longitud(unicode_puntos(t)) }

funcion _uc_en_rangos(cp, rangos) {
    sea a = 0
    sea b = longitud(rangos) - 1
    mientras (a <= b) {
        sea m = piso((a + b) / 2)
        si (cp < rangos[m][0]) { b = m - 1 } sino {
            si (cp > rangos[m][1]) { a = m + 1 } sino { retornar verdadero }
        }
    }
    retornar falso
}

funcion _uc_ccc(cp) {
    si (cp < 768) { retornar 0 }
    retornar _uc()["ccc"]["" + cp] ?? 0
}

funcion _uc_es_marca(cp) {
    si (cp < 768) { retornar falso }
    retornar _uc_ccc(cp) > 0 o _uc_en_rangos(cp, _uc()["cero"])
}

// ── Normalización ─────────────────────────────────────────────────────────

funcion _uc_nfd_puntos(ps) {
    sea u = _uc()
    sea r = []
    para cp en ps {
        sea d = u["dec"]["" + cp] ?? nulo
        si (d == nulo) {
            // Hangul: descomposición algorítmica.
            si (cp >= 44032 y cp <= 55203) {
                sea s = cp - 44032
                r.agregar(4352 + piso(s / 588))
                r.agregar(4449 + piso((s % 588) / 28))
                si (s % 28 != 0) { r.agregar(4519 + s % 28) }
            } sino { r.agregar(cp) }
        } sino { para x en d { r.agregar(x) } }
    }
    // Orden canónico de las marcas (burbuja estable por clase combinante).
    sea i = 1
    mientras (i < longitud(r)) {
        sea j = i
        mientras (j > 0 y _uc_ccc(r[j]) > 0 y _uc_ccc(r[j - 1]) > _uc_ccc(r[j])) {
            sea t = r[j]  r[j] = r[j - 1]  r[j - 1] = t
            j = j - 1
        }
        i = i + 1
    }
    retornar r
}

/// Forma NFD (descompuesta): "é" → "e" + acento combinante.
funcion unicode_nfd(t) { retornar unicode_texto(_uc_nfd_puntos(unicode_puntos(t))) }

/// Forma NFC (compuesta), la recomendada para guardar y comparar.
funcion unicode_nfc(t) {
    sea u = _uc()
    sea d = _uc_nfd_puntos(unicode_puntos(t))
    sea r = []
    sea inicio = -1
    sea ultima_clase = -1
    para cp en d {
        sea c = _uc_ccc(cp)
        sea hecho = falso
        si (inicio >= 0 y (ultima_clase < c o ultima_clase == 0 y longitud(r) - 1 == inicio)) {
            si (ultima_clase != 0 o longitud(r) - 1 == inicio) {
                sea k = "" + r[inicio] + "." + cp
                si (tiene_clave(u["comp"], k)) {
                    r[inicio] = u["comp"][k]
                    hecho = verdadero
                }
                // Hangul LV y LVT.
                si (hecho == falso y r[inicio] >= 4352 y r[inicio] <= 4370 y cp >= 4449 y cp <= 4469 y longitud(r) - 1 == inicio) {
                    r[inicio] = 44032 + ((r[inicio] - 4352) * 21 + (cp - 4449)) * 28
                    hecho = verdadero
                }
                si (hecho == falso y r[inicio] >= 44032 y r[inicio] <= 55203 y (r[inicio] - 44032) % 28 == 0 y cp > 4519 y cp <= 4546 y longitud(r) - 1 == inicio) {
                    r[inicio] = r[inicio] + (cp - 4519)
                    hecho = verdadero
                }
            }
        }
        si (hecho == falso) {
            si (c == 0) { inicio = longitud(r)  ultima_clase = -1 } sino { ultima_clase = c }
            r.agregar(cp)
            si (c == 0) { ultima_clase = 0 }
        }
    }
    retornar unicode_texto(r)
}

funcion unicode_es_nfc(t) { retornar unicode_nfc(t) == "" + t }

// ── Mayúsculas y minúsculas ──────────────────────────────────────────────

// Mapeo completo (puede dar varios puntos, como ß → SS o İ → i̇).
funcion _uc_min_l(cp) {
    si (cp >= 65 y cp <= 90) { retornar [cp + 32] }
    si (cp < 192) { retornar [cp] }
    retornar _uc()["min"]["" + cp] ?? [cp]
}

funcion _uc_may_l(cp) {
    si (cp >= 97 y cp <= 122) { retornar [cp - 32] }
    si (cp < 181) { retornar [cp] }
    retornar _uc()["may"]["" + cp] ?? [cp]
}

// Mapeo simple (un punto): para comparar y clasificar.
funcion _uc_min(cp) {
    sea l = _uc_min_l(cp)
    si (longitud(l) == 1) { retornar l[0] }
    retornar cp
}

funcion _uc_may(cp) {
    sea l = _uc_may_l(cp)
    si (longitud(l) == 1) { retornar l[0] }
    retornar cp
}

funcion unicode_minusculas(t) {
    sea ps = unicode_puntos(t)
    sea r = []
    sea i = 0
    mientras (i < longitud(ps)) {
        sea l = _uc_min_l(ps[i])
        // Sigma final griega.
        si (ps[i] == 931) {
            sea sig = 0
            si (i + 1 < longitud(ps)) { sig = ps[i + 1] }
            sea es_letra = (sig >= 913 y sig <= 1023) o (sig >= 7936 y sig <= 8191)
            si (i > 0 y es_letra == falso) { l = [962] }
        }
        para cp en l { r.agregar(cp) }
        i = i + 1
    }
    retornar unicode_texto(r)
}

funcion unicode_mayusculas(t) {
    sea r = []
    para cp en unicode_puntos(t) { para x en _uc_may_l(cp) { r.agregar(x) } }
    retornar unicode_texto(r)
}

/// Primera letra de cada palabra en mayúscula.
funcion unicode_titulo(t) {
    sea r = []
    sea inicio = verdadero
    para cp en unicode_puntos(t) {
        sea letra = _uc_min(cp) != _uc_may(cp) o (cp >= 48 y cp <= 57)
        si (inicio y letra) { r.agregar(_uc_may(cp))  inicio = falso } sino {
            si (letra o _uc_es_marca(cp) o cp == 39) { r.agregar(_uc_min(cp)) } sino { r.agregar(cp)  inicio = verdadero }
        }
    }
    retornar unicode_texto(r)
}

/// Plegado de caso para comparar sin importar mayúsculas ("Straße" ~ "STRASSE").
funcion unicode_plegar(t) {
    sea r = []
    para cp en unicode_puntos(unicode_nfc(t)) {
        sea m = _uc_min(cp)
        si (m == 223) { r.agregar(115)  r.agregar(115) } sino {
            si (m == 962) { r.agregar(963) } sino { r.agregar(m) }
        }
    }
    retornar unicode_texto(r)
}

funcion unicode_iguales_sin_caso(a, b) { retornar unicode_plegar(a) == unicode_plegar(b) }

// ── Acentos y slugs ───────────────────────────────────────────────────────

sea _UC_EXTRA = {"216": "O", "248": "o", "198": "AE", "230": "ae", "223": "ss", "272": "D", "273": "d", "321": "L", "322": "l", "338": "OE", "339": "oe", "222": "TH", "254": "th", "208": "D", "240": "d", "305": "i", "7838": "SS"}

/// Quita tildes y diacríticos: "Ñuñoa, São Paulo, Łódź" → "Nunoa, Sao Paulo, Lodz".
funcion unicode_sin_acentos(t) {
    sea partes = []
    para cp en _uc_nfd_puntos(unicode_puntos(t)) {
        si (_uc_es_marca(cp) == falso) {
            sea e = _UC_EXTRA["" + cp] ?? nulo
            si (e == nulo) { partes.agregar(caracter(cp)) } sino { partes.agregar(e) }
        }
    }
    retornar unir(partes, "")
}

/// Slug para URLs: minúsculas ASCII, sin acentos, palabras unidas por sep ("-").
funcion unicode_slug(t, sep) {
    sea s = sep ?? "-"
    sea base = unicode_minusculas(unicode_sin_acentos(t))
    sea r = ""
    sea pend = falso
    sea i = 0
    mientras (i < longitud(base)) {
        sea b = byte_en(base, i)
        si ((b >= 97 y b <= 122) o (b >= 48 y b <= 57)) {
            si (pend y r != "") { r = r + s }
            pend = falso
            r = r + subcadena(base, i, i + 1)
        } sino { pend = verdadero }
        i = i + 1
    }
    retornar r
}

// ── Grafemas y ancho ──────────────────────────────────────────────────────

funcion _uc_extiende(cp) {
    retornar _uc_es_marca(cp) o cp == 8205 o (cp >= 65024 y cp <= 65039) o (cp >= 127995 y cp <= 127999) o (cp >= 917536 y cp <= 917631)
}

/// Grafemas (lo que se ve como un carácter): ["é", "👍🏽", "🇨🇱", …].
funcion unicode_grafemas(t) {
    sea ps = unicode_puntos(t)
    sea r = []
    sea actual = []
    sea i = 0
    sea regionales = 0
    mientras (i < longitud(ps)) {
        sea cp = ps[i]
        sea une = falso
        si (longitud(actual) > 0) {
            sea prev = actual[longitud(actual) - 1]
            si (_uc_extiende(cp)) { une = verdadero }
            si (prev == 8205) { une = verdadero }
            si (cp >= 127462 y cp <= 127487 y prev >= 127462 y prev <= 127487 y regionales % 2 == 1) { une = verdadero }
            si (prev == 13 y cp == 10) { une = verdadero }
            // Jamo hangul.
            si (prev >= 4352 y prev <= 4607 y cp >= 4449 y cp <= 4607) { une = verdadero }
        }
        si (une == falso y longitud(actual) > 0) {
            r.agregar(unicode_texto(actual))
            actual = []
            regionales = 0
        }
        actual.agregar(cp)
        si (cp >= 127462 y cp <= 127487) { regionales = regionales + 1 }
        i = i + 1
    }
    si (longitud(actual) > 0) { r.agregar(unicode_texto(actual)) }
    retornar r
}

funcion _uc_ancho_cp(cp) {
    si (cp == 0) { retornar 0 }
    si (cp < 32 o (cp >= 127 y cp < 160)) { retornar 0 }
    si (cp < 768) { retornar 1 }
    si (_uc_es_marca(cp) o cp == 8205) { retornar 0 }
    si (_uc_en_rangos(cp, _uc()["ancho"])) { retornar 2 }
    retornar 1
}

/// Columnas que ocupa en una terminal (CJK y emojis = 2, marcas = 0).
funcion unicode_ancho(t) {
    sea w = 0
    para g en unicode_grafemas(t) {
        sea ps = unicode_puntos(g)
        sea a = _uc_ancho_cp(ps[0])
        para cp en ps { si (cp == 65039) { a = 2 } }
        w = w + a
    }
    retornar w
}

/// Corta a un ancho máximo sin partir grafemas; agrega sufijo ("…") si cortó.
funcion unicode_cortar(t, ancho, sufijo) {
    sea suf = sufijo ?? "…"
    si (unicode_ancho(t) <= ancho) { retornar "" + t }
    sea lim = ancho - unicode_ancho(suf)
    sea r = ""
    sea w = 0
    para g en unicode_grafemas(t) {
        sea a = unicode_ancho(g)
        si (w + a > lim) { retornar r + suf }
        r = r + g
        w = w + a
    }
    retornar r + suf
}

/// Invierte por grafemas (no rompe tildes ni emojis).
funcion unicode_invertir(t) {
    sea g = unicode_grafemas(t)
    sea r = []
    sea i = longitud(g) - 1
    mientras (i >= 0) { r.agregar(g[i])  i = i - 1 }
    retornar unir(r, "")
}

/// Rellena a un ancho visible (alinear = "izq" | "der" | "centro").
funcion unicode_rellenar(t, ancho, alinear) {
    sea falta = ancho - unicode_ancho(t)
    si (falta <= 0) { retornar "" + t }
    sea esp = funcion(n) {
        sea s = ""
        sea i = 0
        mientras (i < n) { s = s + " "  i = i + 1 }
        retornar s
    }
    si (alinear == "der" o alinear == "right") { retornar esp(falta) + t }
    si (alinear == "centro" o alinear == "center") { retornar esp(piso(falta / 2)) + t + esp(falta - piso(falta / 2)) }
    retornar t + esp(falta)
}

// ── Ordenamiento según idioma ─────────────────────────────────────────────

funcion _uc_op(o, k, k2, d) {
    si (o != nulo) {
        si (tiene_clave(o, k)) { retornar o[k] }
        si (tiene_clave(o, k2)) { retornar o[k2] }
    }
    retornar d
}

/// Clave de orden en 3 niveles: [base, acentos, mayúsculas].
funcion unicode_clave(t, opciones) {
    sea idioma = _uc_op(opciones, "idioma", "locale", "")
    sea numeros = _uc_op(opciones, "numeros", "numeric", verdadero)
    sea ps = _uc_nfd_puntos(unicode_puntos(t))
    sea p1 = []
    sea p2 = []
    sea p3 = []
    sea i = 0
    mientras (i < longitud(ps)) {
        sea cp = ps[i]
        si (numeros y cp >= 48 y cp <= 57) {
            sea v = 0
            sea ceros = 0
            mientras (i < longitud(ps) y ps[i] >= 48 y ps[i] <= 57) {
                v = v * 10 + ps[i] - 48
                si (v == 0) { ceros = ceros + 1 }
                i = i + 1
            }
            p1.agregar(1)  p1.agregar(v)
            p2.agregar(0)
            p3.agregar(ceros)
        } sino {
            si (_uc_es_marca(cp)) {
                // Marca suelta: nivel 2 del carácter anterior.
                si (longitud(p2) > 0) { p2[longitud(p2) - 1] = p2[longitud(p2) - 1] * 1000 + (cp - 760) }
                i = i + 1
            } sino {
                sea base = _uc_min(cp)
                sea e = _UC_EXTRA["" + base] ?? nulo
                si (e != nulo) { base = byte_en(e, 0) }
                sea peso = base
                sea marcas = 0
                // ñ en español: letra propia entre n y o.
                si (idioma == "es" y base == 110 y i + 1 < longitud(ps) y ps[i + 1] == 771) {
                    peso = 110.5
                    i = i + 1
                }
                sea clase = 2
                si (peso < 48 o (peso > 57 y peso < 65) o (peso > 90 y peso < 97) o (peso > 122 y peso < 128)) { clase = 0 }
                p1.agregar(clase)  p1.agregar(peso)
                p2.agregar(marcas)
                si (_uc_min(cp) != cp) { p3.agregar(1) } sino { p3.agregar(0) }
                i = i + 1
            }
        }
    }
    retornar [p1, p2, p3]
}

funcion _uc_cmp_lista(a, b) {
    sea i = 0
    mientras (i < longitud(a) y i < longitud(b)) {
        si (a[i] < b[i]) { retornar -1 }
        si (a[i] > b[i]) { retornar 1 }
        i = i + 1
    }
    si (longitud(a) < longitud(b)) { retornar -1 }
    si (longitud(a) > longitud(b)) { retornar 1 }
    retornar 0
}

funcion _uc_cmp_claves(ka, kb) {
    sea n = 0
    mientras (n < 3) {
        sea c = _uc_cmp_lista(ka[n], kb[n])
        si (c != 0) { retornar c }
        n = n + 1
    }
    retornar 0
}

/// -1, 0 o 1. opciones: idioma ("es" pone la ñ tras la n), numeros
/// (verdadero: "2" < "10").
funcion unicode_comparar(a, b, opciones) {
    sea c = _uc_cmp_claves(unicode_clave(a, opciones), unicode_clave(b, opciones))
    si (c != 0) { retornar c }
    si (("" + a) < ("" + b)) { retornar -1 }
    si (("" + a) > ("" + b)) { retornar 1 }
    retornar 0
}

/// Ordena textos como lo haría una persona (estable).
funcion unicode_ordenar(lista, opciones) {
    sea pares = []
    para t en lista { pares.agregar([unicode_clave(t, opciones), t]) }
    pares = ordenar(pares, funcion(x, z) {
        sea c = _uc_cmp_claves(x[0], z[0])
        si (c != 0) { retornar c }
        si (("" + x[1]) < ("" + z[1])) { retornar -1 }
        si (("" + x[1]) > ("" + z[1])) { retornar 1 }
        retornar 0
    })
    sea r = []
    para p en pares { r.agregar(p[1]) }
    retornar r
}
