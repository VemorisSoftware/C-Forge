// stdlib/windows.cfv — APIs nativas de Windows (estilo crate windows): nombres en inglés del módulo "ventanas_api".
// English names for the "ventanas_api" module; both can be used together.

importar "ventanas_api"

funcion _windows_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_windows_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _windows_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _WINDOWS_RES = {"valor": "value", "falla": "failed", "facilidad": "facility", "codigo": "code", "nombre": "name", "texto": "text", "maquina": "machine", "dll": "dll", "subsistema": "subsystem", "punto_entrada": "entry_point", "base": "image_base", "fecha": "timestamp", "secciones": "sections", "importaciones": "imports", "exportaciones": "exports", "ordinal": "ordinal", "tamano_virtual": "virtual_size", "va": "virtual_address", "tamano_crudo": "raw_size", "puntero_crudo": "raw_pointer", "caracteristicas": "characteristics", "nombre_dll": "dll_name", "tamano_cabeceras": "header_size", "mayor": "major", "menor": "minor", "compilacion": "build", "total": "total", "libre": "free", "carga": "load", "arquitectura": "arch", "procesadores": "processors", "pagina": "page_size", "claves": "keys", "valores": "values"}

funcion windows_is_windows() { retornar ventanas_es_windows() }
funcion windows_to_utf16(t) { retornar ventanas_utf16(t) }
funcion windows_from_utf16(b) { retornar ventanas_desde_utf16(b) }
funcion windows_guid_to_string(b) { retornar ventanas_guid_texto(b) }
funcion windows_guid_from_string(t) { retornar ventanas_guid_bytes(t) }
funcion windows_new_guid() { retornar ventanas_guid_nuevo() }
funcion windows_hresult_from_win32(e) { retornar ventanas_hresult_de_win32(e) }
funcion windows_hresult_info(h) { retornar _windows_tr(ventanas_hresult(h), _WINDOWS_RES) }
funcion windows_error_message(e) { retornar ventanas_texto_error(e) }
funcion windows_filetime_to_ms(ft) { retornar ventanas_filetime_a_ms(ft) }
funcion windows_ms_to_filetime(ms) { retornar ventanas_ms_a_filetime(ms) }
funcion windows_parse_reg_file(texto) { retornar ventanas_reg_leer(texto) }
funcion windows_write_reg_file(claves_reg) { retornar ventanas_reg_escribir(claves_reg) }
funcion windows_parse_pe(b) { retornar _windows_tr(ventanas_pe_leer(b), _WINDOWS_RES) }
funcion windows_registry_get(raiz, sub, nombre) { retornar ventanas_registro_leer(raiz, sub, nombre) }
funcion windows_registry_set(raiz, sub, nombre, valor, tipo_v) { retornar ventanas_registro_escribir(raiz, sub, nombre, valor, tipo_v) }
funcion windows_registry_delete(raiz, sub, nombre) { retornar ventanas_registro_borrar(raiz, sub, nombre) }
funcion windows_registry_list(raiz, sub) { retornar _windows_tr(ventanas_registro_listar(raiz, sub), _WINDOWS_RES) }
funcion windows_computer_name() { retornar ventanas_nombre_equipo() }
funcion windows_user_name() { retornar ventanas_nombre_usuario() }
funcion windows_get_env(nombre) { retornar ventanas_entorno(nombre) }
funcion windows_set_env(nombre, valor) { retornar ventanas_fijar_entorno(nombre, valor) }
funcion windows_last_error() { retornar ventanas_ultimo_error() }
funcion windows_version() { retornar _windows_tr(ventanas_version(), _WINDOWS_RES) }
funcion windows_memory_status() { retornar _windows_tr(ventanas_memoria(), _WINDOWS_RES) }
funcion windows_system_info() { retornar _windows_tr(ventanas_info_sistema(), _WINDOWS_RES) }
funcion windows_uptime_ms() { retornar ventanas_tiempo_encendido() }
funcion windows_exe_path() { retornar ventanas_ruta_ejecutable() }
funcion windows_known_folder(nombre) { retornar ventanas_carpeta(nombre) }
funcion windows_path_exists(ruta) { retornar ventanas_existe(ruta) }
funcion windows_clipboard_get() { retornar ventanas_portapapeles() }
funcion windows_clipboard_set(texto) { retornar ventanas_fijar_portapapeles(texto) }
funcion windows_message_box(texto, titulo, tipo_m, icono) { retornar ventanas_mensaje(texto, titulo, tipo_m, icono) }
funcion windows_shell_open(ruta, operacion) { retornar ventanas_abrir(ruta, operacion) }
funcion windows_single_instance(nombre) { retornar ventanas_instancia_unica(nombre) }
funcion windows_release_instance(r) { retornar ventanas_soltar_instancia(r) }
funcion windows_system_metric(m) { retornar ventanas_metrica(m) }
funcion windows_debug_print(texto) { retornar ventanas_depurar(texto) }
