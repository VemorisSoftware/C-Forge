// stdlib/graph.cfv — grafos: nombres en inglés del módulo "grafos".
// English names for the "grafos" module; both can be used together.

importar "grafos"

funcion _graph_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_graph_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _graph_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _GRAPH_RES = {"distancia": "distance", "camino": "path", "explorados": "explored", "distancias": "distances", "previos": "predecessors", "desde": "from", "hasta": "to", "peso": "weight", "datos": "data", "aristas": "edges", "flujo": "flow", "corte": "cut", "flujos": "flows", "puentes": "bridges", "articulaciones": "articulation_points"}

funcion graph_new(dirigido) { retornar grafos_nuevo(dirigido) }
funcion graph_add_node(g, id, datos) { retornar grafos_nodo(g, id, datos) }
funcion graph_add_edge(g, a, b, peso, datos) { retornar grafos_arista(g, a, b, peso, datos) }
funcion graph_remove_edge(g, id) { retornar grafos_quitar_arista(g, id) }
funcion graph_remove_node(g, id) { retornar grafos_quitar_nodo(g, id) }
funcion graph_nodes(g) { retornar grafos_nodos(g) }
funcion graph_node_data(g, id) { retornar grafos_datos(g, id) }
funcion graph_node_count(g) { retornar grafos_cantidad_nodos(g) }
funcion graph_edge_count(g) { retornar grafos_cantidad_aristas(g) }
funcion graph_edges(g) { retornar _graph_tr(grafos_aristas(g), _GRAPH_RES) }
funcion graph_neighbors(g, id) { retornar grafos_vecinos(g, id) }
funcion graph_degree(g, id) { retornar grafos_grado(g, id) }
funcion graph_in_degree(g, id) { retornar grafos_grado_entrada(g, id) }
funcion graph_has_edge(g, a, b) { retornar grafos_tiene_arista(g, a, b) }
funcion graph_bfs(g, inicio) { retornar grafos_bfs(g, inicio) }
funcion graph_dfs(g, inicio) { retornar grafos_dfs(g, inicio) }
funcion graph_dijkstra(g, inicio, destino) { retornar _graph_tr(grafos_dijkstra(g, inicio, destino), _GRAPH_RES) }
funcion graph_astar(g, inicio, destino, heuristica) { retornar _graph_tr(grafos_astar(g, inicio, destino, heuristica), _GRAPH_RES) }
funcion graph_bellman_ford(g, inicio) { retornar _graph_tr(grafos_bellman_ford(g, inicio), _GRAPH_RES) }
funcion graph_floyd_warshall(g) { retornar grafos_floyd_warshall(g) }
funcion graph_k_shortest_paths(g, inicio, destino, k) { retornar _graph_tr(grafos_k_caminos(g, inicio, destino, k), _GRAPH_RES) }
funcion graph_toposort(g) { retornar grafos_topologico(g) }
funcion graph_is_cyclic(g) { retornar grafos_tiene_ciclo(g) }
funcion graph_connected_components(g) { retornar grafos_componentes(g) }
funcion graph_tarjan_scc(g) { retornar grafos_fuertemente_conexas(g) }
funcion graph_min_spanning_tree(g, maximo) { retornar _graph_tr(grafos_arbol_minimo(g, maximo), _GRAPH_RES) }
funcion graph_max_flow(g, fuente, sumidero) { retornar _graph_tr(grafos_flujo_maximo(g, fuente, sumidero), _GRAPH_RES) }
funcion graph_bipartite_matching(g, izquierda) { retornar grafos_emparejamiento(g, izquierda) }
funcion graph_bridges(g) { retornar _graph_tr(grafos_puentes(g), _GRAPH_RES) }
funcion graph_coloring(g) { retornar grafos_colorear(g) }
funcion graph_pagerank(g, amortiguacion, iteraciones) { retornar grafos_pagerank(g, amortiguacion, iteraciones) }
funcion graph_betweenness(g, normalizar) { retornar grafos_intermediacion(g, normalizar) }
funcion graph_eulerian_path(g) { retornar grafos_euleriano(g) }
funcion graph_to_dot(g, nombre) { retornar grafos_dot(g, nombre) }
