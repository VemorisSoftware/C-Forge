// stdlib/diagnostics.cfv — mensajes de error con contexto: nombres en inglés del módulo "diagnostico".
// English names for the "diagnostico" module; both can be used together.

importar "diagnostico"

funcion diagnostic_new(nivel, mensaje, archivo, fuente, codigo) { retornar diagnostico_nuevo(nivel, mensaje, archivo, fuente, codigo) }
funcion diagnostic_label(d, inicio, fin, etiqueta) { retornar diagnostico_marca(d, inicio, fin, etiqueta) }
funcion diagnostic_label_at(d, linea, columna, largo, etiqueta) { retornar diagnostico_marca_linea(d, linea, columna, largo, etiqueta) }
funcion diagnostic_help(d, texto) { retornar diagnostico_ayuda(d, texto) }
funcion diagnostic_note(d, texto) { retornar diagnostico_nota(d, texto) }
funcion diagnostic_offset(fuente, linea, columna) { retornar diagnostico_posicion(fuente, linea, columna) }
funcion diagnostic_line_col(fuente, pos) { retornar diagnostico_linea_columna(fuente, pos) }
funcion diagnostic_render(d, color) { retornar diagnostico_texto(d, color) }
