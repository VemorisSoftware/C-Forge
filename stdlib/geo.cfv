// stdlib/geo.cfv — geometría y geografía: nombres en inglés del módulo "geometria".
// English names for the "geometria" module; both can be used together.

importar "geometria"

funcion geo_distance(a, b) { retornar geometria_distancia(a, b) }
funcion geo_bearing(a, b) { retornar geometria_rumbo(a, b) }
funcion geo_destination(a, km, rumbo) { retornar geometria_destino(a, km, rumbo) }
funcion geo_midpoint(a, b) { retornar geometria_punto_medio(a, b) }
funcion geo_contains(p, poligono) { retornar geometria_dentro(p, poligono) }
funcion geo_area(poligono) { retornar geometria_area(poligono) }
funcion geo_area_m2(poligono) { retornar geometria_area_geo(poligono) }
funcion geo_centroid(poligono) { retornar geometria_centroide(poligono) }
funcion geo_bbox(puntos) { retornar geometria_caja(puntos) }
funcion geo_length(linea, geo) { retornar geometria_largo(linea, geo) }
funcion geo_simplify(linea, tolerancia) { retornar geometria_simplificar(linea, tolerancia) }
funcion geo_distance_to_line(p, linea) { retornar geometria_distancia_linea(p, linea) }
funcion geo_convex_hull(puntos) { retornar geometria_envolvente(puntos) }
funcion geo_geojson(tipo_g, coords, propiedades) { retornar geometria_geojson(tipo_g, coords, propiedades) }
