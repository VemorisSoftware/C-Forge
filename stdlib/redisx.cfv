// stdlib/redisx.cfv — cliente Redis con clústeres: nombres en inglés del módulo "memoria_rapida".
// English names for the "memoria_rapida" module; both can be used together.


importar "memoria_rapida"

funcion _redisx_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_redisx_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _redisx_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _REDISX_RES = {"canal": "channel", "datos": "data", "patron": "pattern"}
sea _REDISX_OPT = {"user": "usuario", "password": "clave", "db": "base", "resp3": "resp3", "name": "nombre", "transport": "transporte"}

funcion redisx_crc16(t) { retornar memoria_crc16(t) }
funcion redisx_slot(clave) { retornar memoria_ranura(clave) }
funcion redisx_resp(args) { retornar memoria_resp(args) }
funcion redisx_is_error(v) { retornar memoria_es_error(v) }
funcion redisx_connect(direccion, opciones) { retornar memoria_conectar(direccion, _redisx_opt(opciones)) }
funcion redisx_cmd(c, args) { retornar memoria_cmd(c, args) }
funcion redisx_pipeline(c, comandos) { retornar memoria_tuberia(c, comandos) }
funcion redisx_transaction(c, comandos, vigilar) { retornar memoria_transaccion(c, comandos, vigilar) }
funcion redisx_script(c, codigo, claves_s, args) { retornar memoria_script(c, codigo, claves_s, args) }
funcion redisx_subscribe(c, canales, patron) { retornar memoria_suscribir(c, canales, patron) }
funcion redisx_message(c) { retornar _redisx_tr(memoria_mensaje(c), _REDISX_RES) }
funcion redisx_close(c) { retornar memoria_cerrar(c) }
funcion redisx_map(v) { retornar memoria_mapa(v) }
funcion redisx_cluster(semillas, opciones) { retornar memoria_cluster(semillas, _redisx_opt(opciones)) }
funcion redisx_node_for(cl, clave) { retornar memoria_nodo_de(cl, clave) }
funcion redisx_masters(cl) { retornar memoria_maestros(cl) }
funcion redisx_key_of(args) { retornar memoria_clave_de(args) }
funcion redisx_mget(c, ks) { retornar memoria_mget(c, ks) }
funcion redisx_mset(c, m) { retornar memoria_mset(c, m) }
funcion redisx_del(c, ks) { retornar memoria_borrar(c, ks) }
funcion redisx_scan(c, patron) { retornar memoria_escanear(c, patron) }
funcion redisx_simulated(direcciones) { retornar memoria_simulado(direcciones) }

funcion _redisx_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_REDISX_OPT[k] ?? k] = o[k] }
    retornar r
}
