// stdlib/numeric.cfv — estadística y análisis numérico: nombres en inglés del módulo "numerica".
// English names for the "numerica" module; both can be used together.

importar "numerica"

funcion numeric_sum(xs) { retornar numerica_suma(xs) }
funcion numeric_mean(xs) { retornar numerica_media(xs) }
funcion numeric_median(xs) { retornar numerica_mediana(xs) }
funcion numeric_percentile(xs, p) { retornar numerica_percentil(xs, p) }
funcion numeric_mode(xs) { retornar numerica_moda(xs) }
funcion numeric_variance(xs, poblacion) { retornar numerica_varianza(xs, poblacion) }
funcion numeric_std(xs, poblacion) { retornar numerica_desviacion(xs, poblacion) }
funcion numeric_covariance(xs, ys) { retornar numerica_covarianza(xs, ys) }
funcion numeric_correlation(xs, ys) { retornar numerica_correlacion(xs, ys) }
/// {"slope", "intercept", "r2"}
funcion numeric_regression(xs, ys) {
    sea r = numerica_regresion(xs, ys)
    retornar {"slope": r["pendiente"], "intercept": r["intercepto"], "r2": r["r2"]}
}
funcion numeric_zscore(xs) { retornar numerica_estandarizar(xs) }
/// {"edges", "counts"}
funcion numeric_histogram(xs, cajas) {
    sea r = numerica_histograma(xs, cajas)
    retornar {"edges": r["bordes"], "counts": r["cuentas"]}
}
/// {"n", "mean", "std", "min", "q1", "median", "q3", "max"}
funcion numeric_summary(xs) {
    sea r = numerica_resumen(xs)
    retornar {"n": r["n"], "mean": r["media"], "std": r["desviacion"], "min": r["min"], "q1": r["q1"], "median": r["mediana"], "q3": r["q3"], "max": r["max"]}
}
funcion numeric_fft(xs) { retornar numerica_fft(xs) }
funcion numeric_ifft(xs) { retornar numerica_ifft(xs) }
funcion numeric_pad(xs) { retornar numerica_rellenar(xs) }
funcion numeric_spectrum(xs) { retornar numerica_espectro(xs) }
funcion numeric_integrate(f, a, b, n) { retornar numerica_integrar(f, a, b, n) }
funcion numeric_root(f, a, b, tolerancia) { retornar numerica_raiz(f, a, b, tolerancia) }
funcion numeric_derivative(f, x, h) { retornar numerica_derivada(f, x, h) }
