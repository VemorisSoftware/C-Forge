// stdlib/mailbox.cfv — leer correo (MIME, IMAP y POP3): nombres en inglés del módulo "bandeja".
// English names for the "bandeja" module; both can be used together.

importar "bandeja"

funcion _mailbox_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_mailbox_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _mailbox_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _MAILBOX_RES = {"cabeceras": "headers", "asunto": "subject", "de": "from", "para": "to", "responder_a": "reply_to", "fecha_ms": "date_ms", "en_respuesta_a": "in_reply_to", "texto": "text", "adjuntos": "attachments", "nombre": "name", "correo": "email", "tipo": "type", "datos": "data", "tamano": "size", "lineas": "lines", "estado": "status", "etiqueta": "tag", "banderas": "flags", "separador": "delimiter", "buzon": "mailbox", "atributos": "attributes"}

funcion mail_to_utf8(b, juego) { retornar bandeja_a_utf8(b, juego) }
funcion mail_quoted_printable(t, en_cabecera) { retornar bandeja_qp(t, en_cabecera) }
funcion mail_decode_words(t) { retornar bandeja_palabras(t) }
funcion mail_headers(texto) { retornar bandeja_cabeceras(texto) }
funcion mail_params(v) { retornar bandeja_parametros(v) }
funcion mail_addresses(v) { retornar _mailbox_tr(bandeja_direcciones(v), _MAILBOX_RES) }
funcion mail_date(v) { retornar bandeja_fecha(v) }
funcion mail_parse(texto) { retornar _mailbox_tr(bandeja_mime(texto), _MAILBOX_RES) }
funcion imap_string(t) { retornar bandeja_imap_cadena(t) }
funcion imap_new() { retornar bandeja_imap_nueva() }
funcion imap_command(st, comando) { retornar bandeja_imap_comando(st, comando) }
funcion imap_login(st, usuario, clave) { retornar bandeja_imap_login(st, usuario, clave) }
funcion imap_values(t) { retornar bandeja_imap_valores(t) }
funcion imap_response(texto, etiqueta) { retornar bandeja_imap_respuesta(texto, etiqueta) }
funcion imap_fetch(respuesta) { retornar bandeja_imap_fetch(respuesta) }
funcion imap_search(respuesta) { retornar bandeja_imap_search(respuesta) }
funcion imap_list(respuesta) { retornar _mailbox_tr(bandeja_imap_list(respuesta), _MAILBOX_RES) }
funcion pop3_multiline(t) { retornar bandeja_pop3_multilinea(t) }
funcion pop3_ok(linea) { retornar bandeja_pop3_ok(linea) }

/// Builds a message: {"from", "to", "cc", "subject", "text", "html", "attachments", "headers"}.
funcion mail_build(m) {
    sea t = {"from": "de", "to": "para", "subject": "asunto", "text": "texto", "attachments": "adjuntos", "headers": "cabeceras", "reply_to": "responder_a", "name": "nombre", "email": "correo", "type": "tipo", "data": "datos"}
    retornar bandeja_armar(_mailbox_tr(m, t))
}
