// stdlib/geometria.cfv — geometría y geografía: distancias entre
// coordenadas (haversine), rumbo, punto de destino, punto en polígono,
// área y centroide (planos y geodésicos), rectángulos envolventes,
// simplificación de líneas (Douglas–Peucker) y GeoJSON. Inspirada en Turf
// / GEOS (MIT/LGPL: solo la idea). En inglés: importar "geo".
//
//   importar "geometria"
//   geometria_distancia([-33.4489, -70.6693], [-32.9446, -71.5525])   // km Santiago → Viña
//   geometria_dentro([x, y], poligono)
//   geometria_area_geo(poligono_latlon)                              // m²
//
// Coordenadas geográficas como [latitud, longitud] en grados; geometría
// plana como [x, y].

sea _GEO_R = 6371.0088

funcion _geo_rad(g) { retornar g * pi() / 180 }
funcion _geo_grad(r) { retornar r * 180 / pi() }

funcion _geo_atan2(y, x) {
    si (x > 0) { retornar arcotangente(y / x) }
    si (x < 0 y y >= 0) { retornar arcotangente(y / x) + pi() }
    si (x < 0 y y < 0) { retornar arcotangente(y / x) - pi() }
    si (y > 0) { retornar pi() / 2 }
    si (y < 0) { retornar 0 - pi() / 2 }
    retornar 0
}

/// Distancia de gran círculo en km (radio medio de la Tierra).
funcion geometria_distancia(a, b) {
    sea la1 = _geo_rad(a[0])
    sea la2 = _geo_rad(b[0])
    sea dla = la2 - la1
    sea dlo = _geo_rad(b[1] - a[1])
    sea h = seno(dla / 2) * seno(dla / 2) + coseno(la1) * coseno(la2) * seno(dlo / 2) * seno(dlo / 2)
    retornar 2 * _GEO_R * _geo_atan2(raiz(h), raiz(1 - h))
}

/// Rumbo inicial de a hacia b (0 = norte, 90 = este).
funcion geometria_rumbo(a, b) {
    sea la1 = _geo_rad(a[0])
    sea la2 = _geo_rad(b[0])
    sea dlo = _geo_rad(b[1] - a[1])
    sea y_ = seno(dlo) * coseno(la2)
    sea x = coseno(la1) * seno(la2) - seno(la1) * coseno(la2) * coseno(dlo)
    sea r = _geo_grad(_geo_atan2(y_, x))
    retornar (r + 360) % 360
}

/// Punto a "km" de distancia con el rumbo dado.
funcion geometria_destino(a, km, rumbo) {
    sea d = km / _GEO_R
    sea t = _geo_rad(rumbo)
    sea la1 = _geo_rad(a[0])
    sea lo1 = _geo_rad(a[1])
    sea la2 = arcoseno(seno(la1) * coseno(d) + coseno(la1) * seno(d) * coseno(t))
    sea lo2 = lo1 + _geo_atan2(seno(t) * seno(d) * coseno(la1), coseno(d) - seno(la1) * seno(la2))
    sea lon = (_geo_grad(lo2) + 540) % 360 - 180
    retornar [_geo_grad(la2), lon]
}

funcion geometria_punto_medio(a, b) {
    sea la1 = _geo_rad(a[0])
    sea lo1 = _geo_rad(a[1])
    sea la2 = _geo_rad(b[0])
    sea dlo = _geo_rad(b[1] - a[1])
    sea bx = coseno(la2) * coseno(dlo)
    sea by = coseno(la2) * seno(dlo)
    sea la3 = _geo_atan2(seno(la1) + seno(la2), raiz((coseno(la1) + bx) * (coseno(la1) + bx) + by * by))
    sea lo3 = lo1 + _geo_atan2(by, coseno(la1) + bx)
    retornar [_geo_grad(la3), _geo_grad(lo3)]
}

/// ¿Punto dentro del polígono (lista de vértices, plano o lat/lon)? Regla
/// del rayo; el borde cuenta como dentro.
funcion geometria_dentro(p, poligono) {
    sea dentro = falso
    sea n = longitud(poligono)
    sea j = n - 1
    sea i = 0
    mientras (i < n) {
        sea a = poligono[i]
        sea b = poligono[j]
        // Sobre el borde.
        sea cruz = (b[0] - a[0]) * (p[1] - a[1]) - (b[1] - a[1]) * (p[0] - a[0])
        si (absoluto(cruz) < 0.000000001 y p[0] >= minimo(a[0], b[0]) y p[0] <= maximo(a[0], b[0]) y p[1] >= minimo(a[1], b[1]) y p[1] <= maximo(a[1], b[1])) { retornar verdadero }
        si ((a[1] > p[1]) != (b[1] > p[1])) {
            si (p[0] < (b[0] - a[0]) * (p[1] - a[1]) / (b[1] - a[1]) + a[0]) { dentro = dentro == falso }
        }
        j = i
        i = i + 1
    }
    retornar dentro
}

/// Área plana con signo (positiva = antihorario), fórmula del cordón.
funcion geometria_area(poligono) {
    sea s = 0
    sea n = longitud(poligono)
    sea i = 0
    mientras (i < n) {
        sea a = poligono[i]
        sea b = poligono[(i + 1) % n]
        s = s + a[0] * b[1] - b[0] * a[1]
        i = i + 1
    }
    retornar absoluto(s / 2)
}

/// Área geodésica aproximada en m² (proyección esférica; error < 0.5 %).
funcion geometria_area_geo(poligono) {
    sea s = 0
    sea n = longitud(poligono)
    sea R = _GEO_R * 1000
    sea i = 0
    mientras (i < n) {
        sea a = poligono[i]
        sea b = poligono[(i + 1) % n]
        s = s + _geo_rad(b[1] - a[1]) * (2 + seno(_geo_rad(a[0])) + seno(_geo_rad(b[0])))
        i = i + 1
    }
    retornar absoluto(s * R * R / 2)
}

funcion geometria_centroide(poligono) {
    sea a = 0
    sea cx = 0
    sea cy = 0
    sea n = longitud(poligono)
    sea i = 0
    mientras (i < n) {
        sea p = poligono[i]
        sea q = poligono[(i + 1) % n]
        sea f = p[0] * q[1] - q[0] * p[1]
        a = a + f
        cx = cx + (p[0] + q[0]) * f
        cy = cy + (p[1] + q[1]) * f
        i = i + 1
    }
    si (a == 0) {
        sea sx = 0
        sea sy = 0
        para p en poligono { sx = sx + p[0]  sy = sy + p[1] }
        retornar [sx / n, sy / n]
    }
    retornar [cx / (3 * a), cy / (3 * a)]
}

/// [min0, min1, max0, max1].
funcion geometria_caja(puntos) {
    sea r = [puntos[0][0], puntos[0][1], puntos[0][0], puntos[0][1]]
    para p en puntos {
        r[0] = minimo(r[0], p[0])  r[1] = minimo(r[1], p[1])
        r[2] = maximo(r[2], p[0])  r[3] = maximo(r[3], p[1])
    }
    retornar r
}

/// Largo de una línea: plano, o en km si geo = verdadero.
funcion geometria_largo(linea, geo) {
    sea s = 0
    sea i = 1
    mientras (i < longitud(linea)) {
        si (geo == verdadero) { s = s + geometria_distancia(linea[i - 1], linea[i]) } sino {
            sea dx = linea[i][0] - linea[i - 1][0]
            sea dy = linea[i][1] - linea[i - 1][1]
            s = s + raiz(dx * dx + dy * dy)
        }
        i = i + 1
    }
    retornar s
}

funcion _geo_dist_seg(p, a, b) {
    sea dx = b[0] - a[0]
    sea dy = b[1] - a[1]
    si (dx == 0 y dy == 0) { retornar raiz((p[0] - a[0]) * (p[0] - a[0]) + (p[1] - a[1]) * (p[1] - a[1])) }
    sea t = maximo(0, minimo(1, ((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / (dx * dx + dy * dy)))
    sea x = a[0] + t * dx
    sea y_ = a[1] + t * dy
    retornar raiz((p[0] - x) * (p[0] - x) + (p[1] - y_) * (p[1] - y_))
}

/// Simplifica una línea (Douglas–Peucker) con tolerancia en sus unidades.
funcion geometria_simplificar(linea, tolerancia) {
    si (longitud(linea) < 3) { retornar linea }
    sea maxd = 0
    sea idx = 0
    sea i = 1
    mientras (i < longitud(linea) - 1) {
        sea d = _geo_dist_seg(linea[i], linea[0], linea[longitud(linea) - 1])
        si (d > maxd) { maxd = d  idx = i }
        i = i + 1
    }
    si (maxd <= tolerancia) { retornar [linea[0], linea[longitud(linea) - 1]] }
    sea a = []
    sea b = []
    i = 0
    mientras (i < longitud(linea)) {
        si (i <= idx) { a.agregar(linea[i]) }
        si (i >= idx) { b.agregar(linea[i]) }
        i = i + 1
    }
    sea ra = geometria_simplificar(a, tolerancia)
    sea rb = geometria_simplificar(b, tolerancia)
    sea r = []
    i = 0
    mientras (i < longitud(ra) - 1) { r.agregar(ra[i])  i = i + 1 }
    para p en rb { r.agregar(p) }
    retornar r
}

/// Distancia de un punto (plano) a una línea o polígono.
funcion geometria_distancia_linea(p, linea) {
    sea m = nulo
    sea i = 1
    mientras (i < longitud(linea)) {
        sea d = _geo_dist_seg(p, linea[i - 1], linea[i])
        si (m == nulo o d < m) { m = d }
        i = i + 1
    }
    retornar m
}

/// Envolvente convexa (Andrew, monótona).
funcion geometria_envolvente(puntos) {
    sea p = ordenar(puntos, funcion(a, b) {
        si (a[0] != b[0]) { retornar a[0] - b[0] }
        retornar a[1] - b[1]
    })
    si (longitud(p) < 3) { retornar p }
    sea cruz = funcion(o, a, b) { retornar (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]) }
    sea abajo = []
    para x en p {
        mientras (longitud(abajo) >= 2 y cruz(abajo[longitud(abajo) - 2], abajo[longitud(abajo) - 1], x) <= 0) {
            sea r = []
            sea k = 0
            mientras (k < longitud(abajo) - 1) { r.agregar(abajo[k])  k = k + 1 }
            abajo = r
        }
        abajo.agregar(x)
    }
    sea arriba = []
    sea i = longitud(p) - 1
    mientras (i >= 0) {
        sea x = p[i]
        mientras (longitud(arriba) >= 2 y cruz(arriba[longitud(arriba) - 2], arriba[longitud(arriba) - 1], x) <= 0) {
            sea r = []
            sea k = 0
            mientras (k < longitud(arriba) - 1) { r.agregar(arriba[k])  k = k + 1 }
            arriba = r
        }
        arriba.agregar(x)
        i = i - 1
    }
    sea h = []
    i = 0
    mientras (i < longitud(abajo) - 1) { h.agregar(abajo[i])  i = i + 1 }
    i = 0
    mientras (i < longitud(arriba) - 1) { h.agregar(arriba[i])  i = i + 1 }
    retornar h
}

/// Puntos [lat, lon] → Feature GeoJSON (GeoJSON usa [lon, lat]).
funcion geometria_geojson(tipo_g, coords, propiedades) {
    sea voltear = funcion(c) { retornar [c[1], c[0]] }
    sea g = nulo
    si (tipo_g == "punto" o tipo_g == "Point") { g = {"type": "Point", "coordinates": voltear(coords)} }
    si (tipo_g == "linea" o tipo_g == "LineString") {
        sea l = []
        para c en coords { l.agregar(voltear(c)) }
        g = {"type": "LineString", "coordinates": l}
    }
    si (tipo_g == "poligono" o tipo_g == "Polygon") {
        sea anillo = []
        para c en coords { anillo.agregar(voltear(c)) }
        si (anillo[0][0] != anillo[longitud(anillo) - 1][0] o anillo[0][1] != anillo[longitud(anillo) - 1][1]) { anillo.agregar(anillo[0]) }
        g = {"type": "Polygon", "coordinates": [anillo]}
    }
    si (g == nulo) { lanzar "geometria: tipo \"punto\", \"linea\" o \"poligono\"" }
    retornar {"type": "Feature", "geometry": g, "properties": propiedades ?? {}}
}
