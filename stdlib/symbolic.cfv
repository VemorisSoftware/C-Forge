// stdlib/symbolic.cfv — matemática simbólica: nombres en inglés del módulo "simbolo".
// English names for the "simbolo" module; both can be used together.

importar "simbolo"

funcion symbolic_parse(texto) { retornar simbolo_leer(texto) }
funcion symbolic_simplify(e) { retornar simbolo_simplificar(e) }
funcion symbolic_diff(e, x, n) { retornar simbolo_derivar(e, x, n) }
funcion symbolic_has(e, x) { retornar simbolo_contiene(e, x) }
funcion symbolic_variables(e) { retornar simbolo_variables(e) }
funcion symbolic_subs(e, cambios) { retornar simbolo_sustituir(e, cambios) }
funcion symbolic_eval(e, valores) { retornar simbolo_evaluar(e, valores) }
funcion symbolic_str(e) { retornar simbolo_texto(e) }
funcion symbolic_latex(e) { retornar simbolo_latex(e) }
funcion symbolic_integrate(e, x, a, b, n) { retornar simbolo_integrar(e, x, a, b, n) }
