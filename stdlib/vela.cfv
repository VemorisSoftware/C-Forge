// stdlib/vela.cfv — árboles de decisión (clasificación con Gini y
// regresión con varianza), bosques aleatorios con votación y Naive Bayes
// (gaussiano y multinomial para texto). Reproducibles con semilla.
// Inspirada en Linfa / scikit-learn (MIT/BSD). En inglés: importar "trees".
//
//   importar "vela"
//   sea arbol = vela_arbol(X, y, {"profundidad": 4})
//   vela_predecir(arbol, [[5.1, 3.5]])
//   sea bosque = vela_bosque(X, y, {"arboles": 50, "semilla": 7})
//   sea nb = vela_bayes_texto(["oferta gratis", "reunión mañana"], ["spam", "ok"])
//   vela_predecir(nb, ["gratis gratis"])

funcion _ve_op(o, k, d) {
    si (o != nulo) { si (tiene_clave(o, k)) { retornar o[k] } }
    retornar d
}

funcion _ve_azar(est) {
    est[0] = (est[0] * 48271) % 2147483647
    retornar (est[0] - 1) / 2147483646
}

funcion _ve_cuentas(y, idx) {
    sea c = {}
    para i en idx { c["" + y[i]] = (c["" + y[i]] ?? 0) + 1 }
    retornar c
}

funcion _ve_gini(c, n) {
    si (n == 0) { retornar 0 }
    sea g = 1
    para k en claves(c) { g = g - (c[k] / n) * (c[k] / n) }
    retornar g
}

funcion _ve_mayoria(y, idx) {
    sea c = {}
    sea mejor = nulo
    sea valor = nulo
    para i en idx {
        sea k = "" + y[i]
        c[k] = (c[k] ?? 0) + 1
        si (mejor == nulo o c[k] > c[mejor]) { mejor = k  valor = y[i] }
    }
    retornar valor
}

funcion _ve_media(y, idx) {
    sea s = 0
    para i en idx { s = s + y[i] }
    retornar s / longitud(idx)
}

funcion _ve_var(y, idx) {
    si (longitud(idx) == 0) { retornar 0 }
    sea m = _ve_media(y, idx)
    sea s = 0
    para i en idx { s = s + (y[i] - m) * (y[i] - m) }
    retornar s
}

// Mejor corte para un subconjunto de columnas.
funcion _ve_corte(X, y, idx, columnas, regresion, min_hoja) {
    sea mejor = nulo
    sea n = longitud(idx)
    sea base = 0
    si (regresion) { base = _ve_var(y, idx) } sino { base = _ve_gini(_ve_cuentas(y, idx), n) * n }
    para c en columnas {
        sea orden = ordenar(idx, funcion(a, b) { retornar X[a][c] - X[b][c] })
        // Recorre los cortes acumulando estadísticos.
        sea izq_c = {}
        sea der_c = _ve_cuentas(y, orden)
        sea izq_s = 0
        sea izq_q = 0
        sea der_s = 0
        sea der_q = 0
        si (regresion) { para i en orden { der_s = der_s + y[i]  der_q = der_q + y[i] * y[i] } }
        sea k = 0
        mientras (k < n - 1) {
            sea i = orden[k]
            si (regresion) {
                izq_s = izq_s + y[i]  izq_q = izq_q + y[i] * y[i]
                der_s = der_s - y[i]  der_q = der_q - y[i] * y[i]
            } sino {
                sea e = "" + y[i]
                izq_c[e] = (izq_c[e] ?? 0) + 1
                der_c[e] = der_c[e] - 1
            }
            sea a = X[i][c]
            sea b = X[orden[k + 1]][c]
            si (a != b y k + 1 >= min_hoja y n - k - 1 >= min_hoja) {
                sea ni = k + 1
                sea nd = n - ni
                sea costo = 0
                si (regresion) { costo = (izq_q - izq_s * izq_s / ni) + (der_q - der_s * der_s / nd) } sino { costo = _ve_gini(izq_c, ni) * ni + _ve_gini(der_c, nd) * nd }
                si (mejor == nulo o costo < mejor["costo"] - 0.000000001) { mejor = {"columna": c, "umbral": (a + b) / 2, "costo": costo, "ganancia": base - costo} }
            }
            k = k + 1
        }
    }
    retornar mejor
}

funcion _ve_construir(X, y, idx, prof, o, est) {
    sea regresion = o["regresion"]
    sea hoja = nulo
    si (regresion) { hoja = {"hoja": verdadero, "valor": _ve_media(y, idx), "n": longitud(idx)} } sino { hoja = {"hoja": verdadero, "valor": _ve_mayoria(y, idx), "n": longitud(idx), "cuentas": _ve_cuentas(y, idx)} }
    si (prof >= o["profundidad"] o longitud(idx) < o["min_division"]) { retornar hoja }
    si (regresion == falso y longitud(claves(_ve_cuentas(y, idx))) == 1) { retornar hoja }
    sea m = longitud(X[0])
    sea columnas = []
    sea c = 0
    mientras (c < m) { columnas.agregar(c)  c = c + 1 }
    si (o["max_columnas"] != nulo y o["max_columnas"] < m) {
        // Muestra sin reemplazo (Fisher–Yates parcial).
        sea i = 0
        mientras (i < o["max_columnas"]) {
            sea j = i + piso(_ve_azar(est) * (m - i))
            sea t = columnas[i]  columnas[i] = columnas[j]  columnas[j] = t
            i = i + 1
        }
        sea r = []
        i = 0
        mientras (i < o["max_columnas"]) { r.agregar(columnas[i])  i = i + 1 }
        columnas = r
    }
    sea corte = _ve_corte(X, y, idx, columnas, regresion, o["min_hoja"])
    si (corte == nulo o corte["ganancia"] <= 0.0000000001) { retornar hoja }
    sea izq = []
    sea der = []
    para i en idx { si (X[i][corte["columna"]] <= corte["umbral"]) { izq.agregar(i) } sino { der.agregar(i) } }
    retornar {"hoja": falso, "columna": corte["columna"], "umbral": corte["umbral"], "izq": _ve_construir(X, y, izq, prof + 1, o, est), "der": _ve_construir(X, y, der, prof + 1, o, est), "n": longitud(idx)}
}

funcion _ve_opciones(X, y, opciones, semilla_def) {
    si (tipo(X) != "lista" o longitud(X) == 0 o longitud(X) != longitud(y)) { lanzar "vela: X e y deben tener el mismo largo (y no estar vacíos)" }
    sea regresion = _ve_op(opciones, "regresion", _ve_op(opciones, "regression", nulo))
    si (regresion == nulo) {
        regresion = verdadero
        // Clasificación si hay textos, o si todos los valores son enteros y pocos distintos.
        sea distintos = {}
        para v en y { distintos["" + v] = verdadero }
        para v en y { si (tipo(v) != "numero") { regresion = falso } }
        si (regresion) {
            sea enteros = verdadero
            para v en y { si (piso(v) != v) { enteros = falso } }
            si (enteros y longitud(claves(distintos)) <= 10) { regresion = falso }
        }
    }
    retornar {"profundidad": _ve_op(opciones, "profundidad", _ve_op(opciones, "depth", 8)), "min_division": _ve_op(opciones, "min_division", 2), "min_hoja": _ve_op(opciones, "min_hoja", 1), "max_columnas": _ve_op(opciones, "max_columnas", nulo), "regresion": regresion, "semilla": _ve_op(opciones, "semilla", _ve_op(opciones, "seed", semilla_def))}
}

/// Árbol de decisión. opciones: profundidad (8), min_division (2),
/// min_hoja (1), regresion (se deduce de y si no se da).
funcion vela_arbol(X, y, opciones) {
    sea o = _ve_opciones(X, y, opciones, 1)
    sea idx = []
    sea i = 0
    mientras (i < longitud(X)) { idx.agregar(i)  i = i + 1 }
    retornar {"tipo": "arbol", "raiz": _ve_construir(X, y, idx, 0, o, [o["semilla"] % 2147483646 + 1]), "regresion": o["regresion"]}
}

/// Bosque aleatorio. opciones: arboles (50), semilla, max_columnas (√m),
/// y las del árbol.
funcion vela_bosque(X, y, opciones) {
    sea o = _ve_opciones(X, y, opciones, 42)
    sea m = longitud(X[0])
    si (_ve_op(opciones, "max_columnas", nulo) == nulo) { o["max_columnas"] = maximo(1, redondear(raiz(m), 0)) }
    sea n_arboles = _ve_op(opciones, "arboles", _ve_op(opciones, "trees", 50))
    sea est = [o["semilla"] % 2147483646 + 1]
    sea arboles = []
    sea t = 0
    mientras (t < n_arboles) {
        sea idx = []
        sea i = 0
        mientras (i < longitud(X)) { idx.agregar(piso(_ve_azar(est) * longitud(X)))  i = i + 1 }
        arboles.agregar(_ve_construir(X, y, idx, 0, o, est))
        t = t + 1
    }
    retornar {"tipo": "bosque", "arboles": arboles, "regresion": o["regresion"]}
}

funcion _ve_bajar(n, x) {
    sea nodo = n
    mientras (nodo["hoja"] == falso) {
        si (x[nodo["columna"]] <= nodo["umbral"]) { nodo = nodo["izq"] } sino { nodo = nodo["der"] }
    }
    retornar nodo
}

// ── Naive Bayes ───────────────────────────────────────────────────────────

/// Naive Bayes gaussiano para columnas numéricas.
funcion vela_bayes(X, y) {
    sea clases = {}
    sea orden = []
    sea i = 0
    mientras (i < longitud(X)) {
        sea k = "" + y[i]
        si (tiene_clave(clases, k) == falso) { clases[k] = {"valor": y[i], "filas": []}  orden.agregar(k) }
        clases[k]["filas"].agregar(X[i])
        i = i + 1
    }
    sea m = longitud(X[0])
    sea modelo = []
    para k en orden {
        sea filas = clases[k]["filas"]
        sea medias = []
        sea vars = []
        sea c = 0
        mientras (c < m) {
            sea s = 0
            para f en filas { s = s + f[c] }
            sea media = s / longitud(filas)
            sea v = 0
            para f en filas { v = v + (f[c] - media) * (f[c] - media) }
            medias.agregar(media)
            vars.agregar(v / longitud(filas) + 0.000000001)
            c = c + 1
        }
        modelo.agregar({"valor": clases[k]["valor"], "prior": logaritmo(longitud(filas) / longitud(X)), "medias": medias, "vars": vars})
    }
    retornar {"tipo": "bayes", "clases": modelo}
}

funcion _ve_palabras(t) {
    sea r = []
    sea actual = ""
    para c en texto_dividir(texto_minusculas("" + t) + " ", "") {
        sea b = byte_en(c, 0)
        si ((b >= 97 y b <= 122) o (b >= 48 y b <= 57) o b >= 128) { actual = actual + c } sino {
            si (actual != "") { r.agregar(actual)  actual = "" }
        }
    }
    retornar r
}

/// Naive Bayes multinomial para clasificar textos (suavizado de Laplace).
funcion vela_bayes_texto(textos, etiquetas, alfa) {
    sea a = alfa ?? 1
    sea clases = {}
    sea orden = []
    sea vocab = {}
    sea i = 0
    mientras (i < longitud(textos)) {
        sea k = "" + etiquetas[i]
        si (tiene_clave(clases, k) == falso) { clases[k] = {"valor": etiquetas[i], "docs": 0, "palabras": {}, "total": 0}  orden.agregar(k) }
        sea c = clases[k]
        c["docs"] = c["docs"] + 1
        para p en _ve_palabras(textos[i]) {
            c["palabras"][p] = (c["palabras"][p] ?? 0) + 1
            c["total"] = c["total"] + 1
            vocab[p] = verdadero
        }
        i = i + 1
    }
    sea modelo = []
    para k en orden { modelo.agregar({"valor": clases[k]["valor"], "prior": logaritmo(clases[k]["docs"] / longitud(textos)), "palabras": clases[k]["palabras"], "total": clases[k]["total"]}) }
    retornar {"tipo": "bayes_texto", "clases": modelo, "v": longitud(claves(vocab)), "alfa": a}
}

/// Puntajes por clase (log-probabilidades) para un ejemplo.
funcion vela_puntajes(modelo, x) {
    sea r = {}
    si (modelo["tipo"] == "bayes") {
        para c en modelo["clases"] {
            sea s = c["prior"]
            sea j = 0
            mientras (j < longitud(x)) {
                s = s - 0.5 * logaritmo(2 * pi() * c["vars"][j]) - (x[j] - c["medias"][j]) * (x[j] - c["medias"][j]) / (2 * c["vars"][j])
                j = j + 1
            }
            r["" + c["valor"]] = s
        }
        retornar r
    }
    si (modelo["tipo"] == "bayes_texto") {
        sea ps = _ve_palabras(x)
        para c en modelo["clases"] {
            sea s = c["prior"]
            para p en ps { s = s + logaritmo(((c["palabras"][p] ?? 0) + modelo["alfa"]) / (c["total"] + modelo["alfa"] * modelo["v"])) }
            r["" + c["valor"]] = s
        }
        retornar r
    }
    lanzar "vela: puntajes solo para Naive Bayes"
}

funcion vela_predecir(modelo, X) {
    sea r = []
    para x en X {
        sea t = modelo["tipo"]
        si (t == "arbol") { r.agregar(_ve_bajar(modelo["raiz"], x)["valor"]) }
        si (t == "bosque") {
            si (modelo["regresion"]) {
                sea s = 0
                para a en modelo["arboles"] { s = s + _ve_bajar(a, x)["valor"] }
                r.agregar(s / longitud(modelo["arboles"]))
            } sino {
                sea votos = {}
                sea mejor = nulo
                sea valor = nulo
                para a en modelo["arboles"] {
                    sea v = _ve_bajar(a, x)["valor"]
                    sea k = "" + v
                    votos[k] = (votos[k] ?? 0) + 1
                    si (mejor == nulo o votos[k] > votos[mejor]) { mejor = k  valor = v }
                }
                r.agregar(valor)
            }
        }
        si (t == "bayes" o t == "bayes_texto") {
            sea p = vela_puntajes(modelo, x)
            sea mejor = nulo
            para c en modelo["clases"] { si (mejor == nulo o p["" + c["valor"]] > p["" + mejor]) { mejor = c["valor"] } }
            r.agregar(mejor)
        }
    }
    retornar r
}

/// Importancia de cada columna (reducción total de impureza, normalizada).
funcion vela_importancia(modelo, columnas) {
    sea imp = []
    sea c = 0
    mientras (c < columnas) { imp.agregar(0)  c = c + 1 }
    sea arboles = []
    si (modelo["tipo"] == "bosque") { arboles = modelo["arboles"] } sino { arboles = [modelo["raiz"]] }
    para a en arboles {
        sea pila = [a]
        mientras (longitud(pila) > 0) {
            sea n = pila[longitud(pila) - 1]
            sea r = []
            sea i = 0
            mientras (i < longitud(pila) - 1) { r.agregar(pila[i])  i = i + 1 }
            pila = r
            si (n["hoja"] == falso) {
                imp[n["columna"]] = imp[n["columna"]] + n["n"]
                pila.agregar(n["izq"])
                pila.agregar(n["der"])
            }
        }
    }
    sea total = 0
    para v en imp { total = total + v }
    sea r = []
    para v en imp { si (total > 0) { r.agregar(v / total) } sino { r.agregar(0) } }
    retornar r
}

/// Texto legible del árbol.
funcion vela_texto(modelo, nombres) {
    sea l = []
    sea dibujar = nulo
    dibujar = funcion(n, sangria) {
        si (n["hoja"]) { l.agregar(sangria + "→ " + n["valor"] + " (" + n["n"] + ")") } sino {
            sea nom = "x" + n["columna"]
            si (nombres != nulo) { nom = nombres[n["columna"]] }
            l.agregar(sangria + nom + " <= " + redondear(n["umbral"], 4))
            dibujar(n["izq"], sangria + "  ")
            l.agregar(sangria + nom + " > " + redondear(n["umbral"], 4))
            dibujar(n["der"], sangria + "  ")
        }
    }
    dibujar(modelo["raiz"], "")
    retornar unir(l, "\n")
}
