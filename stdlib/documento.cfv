sea _DC_ANCHOS = {}
sea _DC_CP1252 = [8364, 0, 8218, 402, 8222, 8230, 8224, 8225, 710, 8240, 352, 8249, 338, 0, 381, 0, 0, 8216, 8217, 8220, 8221, 8226, 8211, 8212, 732, 8482, 353, 8250, 339, 0, 382, 376]
sea _DC_TAMANOS = {"a4": [595.28, 841.89], "a3": [841.89, 1190.55], "a5": [419.53, 595.28], "carta": [612, 792], "letter": [612, 792], "oficio": [612, 1008], "legal": [612, 1008]}
sea _DC_FUENTES = {"helvetica": "Helvetica", "helvetica-bold": "Helvetica-Bold", "helvetica-oblique": "Helvetica-Oblique", "helvetica-boldoblique": "Helvetica-BoldOblique", "times": "Times-Roman", "times-roman": "Times-Roman", "times-bold": "Times-Bold", "times-italic": "Times-Italic", "times-bolditalic": "Times-BoldItalic", "courier": "Courier", "courier-bold": "Courier-Bold", "courier-oblique": "Courier-Oblique", "courier-boldoblique": "Courier-BoldOblique"}
sea _DC_CLAVE_ANCHO = {"Helvetica": "helvetica", "Helvetica-Bold": "helveticaB", "Helvetica-Oblique": "helveticaI", "Helvetica-BoldOblique": "helveticaBI", "Times-Roman": "times", "Times-Bold": "timesB", "Times-Italic": "timesI", "Times-BoldItalic": "timesBI"}

funcion _dc_byte(v) { retornar bytes_de_hex(subcadena("0123456789abcdef", piso(v / 16), piso(v / 16) + 1) + subcadena("0123456789abcdef", v % 16, v % 16 + 1)) }

// ── Fuentes y texto ───────────────────────────────────────────────────────

/// Nombre PostScript de una fuente estándar ("Helvetica-Bold", "times", …).
/// opciones negrita/cursiva eligen la variante.
funcion documento_fuente(nombre, negrita, cursiva) {
    sea n = texto_minusculas(nombre ?? "helvetica")
    si (tiene_clave(_DC_FUENTES, n) == falso) { lanzar "documento: fuente desconocida " + nombre + " (usa Helvetica, Times o Courier)" }
    sea base = _DC_FUENTES[n]
    si (negrita != verdadero y cursiva != verdadero) { retornar base }
    sea familia = "Helvetica"
    si (texto_empieza_con(base, "Times")) { familia = "Times" }
    si (texto_empieza_con(base, "Courier")) { familia = "Courier" }
    sea b = negrita == verdadero o texto_indice(base, "Bold") >= 0
    sea c = cursiva == verdadero o texto_indice(base, "Oblique") >= 0 o texto_indice(base, "Italic") >= 0
    si (familia == "Times") {
        si (b y c) { retornar "Times-BoldItalic" }
        si (b) { retornar "Times-Bold" }
        si (c) { retornar "Times-Italic" }
        retornar "Times-Roman"
    }
    si (b y c) { retornar familia + "-BoldOblique" }
    si (b) { retornar familia + "-Bold" }
    si (c) { retornar familia + "-Oblique" }
    retornar familia
}

funcion _dc_anchos(fuente) {
    si (texto_empieza_con(fuente, "Courier")) { retornar nulo }
    sea k = _DC_CLAVE_ANCHO[fuente]
    si (tiene_clave(_DC_ANCHOS, k) == falso) {
        sea l = []
        para x en texto_dividir(_DC_ANCHOS_TXT[k], ",") { l.agregar(a_numero(x)) }
        _DC_ANCHOS[k] = l
    }
    retornar _DC_ANCHOS[k]
}

/// UTF-8 → bytes WinAnsi (cp1252); lo que no existe queda como "?".
funcion documento_winansi(t) {
    sea s = "" + t
    sea r = []
    sea i = 0
    sea n = longitud(s)
    mientras (i < n) {
        sea b = byte_en(s, i)
        sea cp = b
        sea l = 1
        si (b >= 240) { cp = ((b - 240) * 64 + byte_en(s, i + 1) - 128) * 4096 + (byte_en(s, i + 2) - 128) * 64 + byte_en(s, i + 3) - 128  l = 4 } sino {
            si (b >= 224) { cp = ((b - 224) * 64 + byte_en(s, i + 1) - 128) * 64 + byte_en(s, i + 2) - 128  l = 3 } sino {
                si (b >= 192) { cp = (b - 192) * 64 + byte_en(s, i + 1) - 128  l = 2 }
            }
        }
        sea v = 63
        si (cp < 128 o (cp >= 160 y cp <= 255)) { v = cp } sino {
            sea k = 0
            mientras (k < 32) {
                si (_DC_CP1252[k] == cp) { v = 128 + k }
                k = k + 1
            }
        }
        r.agregar(_dc_byte(v))
        i = i + l
    }
    retornar unir(r, "")
}

/// Ancho del texto en puntos.
funcion documento_ancho(texto, fuente, tamano) {
    sea f = documento_fuente(fuente ?? "Helvetica")
    sea b = documento_winansi(texto)
    sea a = _dc_anchos(f)
    si (a == nulo) { retornar longitud(b) * 600 * (tamano ?? 12) / 1000 }
    sea s = 0
    sea i = 0
    mientras (i < longitud(b)) { s = s + a[byte_en(b, i)]  i = i + 1 }
    retornar s * (tamano ?? 12) / 1000
}

funcion _dc_escapar(b) {
    sea r = texto_reemplazar(b, "\\", "\\\\")
    r = texto_reemplazar(r, "(", "\\(")
    r = texto_reemplazar(r, ")", "\\)")
    r = texto_reemplazar(r, "\r", "\\r")
    retornar texto_reemplazar(r, "\n", "\\n")
}

funcion _dc_num(v) {
    sea x = redondear(v, 3)
    si (piso(x) == x) { retornar "" + piso(x) }
    retornar "" + x
}

funcion _dc_color(c) {
    sea h = "" + c
    si (texto_empieza_con(h, "#")) { h = subcadena(h, 1, longitud(h)) }
    si (longitud(h) == 3) { h = subcadena(h, 0, 1) + subcadena(h, 0, 1) + subcadena(h, 1, 2) + subcadena(h, 1, 2) + subcadena(h, 2, 3) + subcadena(h, 2, 3) }
    si (longitud(h) != 6) { lanzar "documento: color inválido " + c + " (usa #rrggbb)" }
    sea b = bytes_de_hex(texto_minusculas(h))
    retornar _dc_num(byte_en(b, 0) / 255) + " " + _dc_num(byte_en(b, 1) / 255) + " " + _dc_num(byte_en(b, 2) / 255)
}

// ── Documento ─────────────────────────────────────────────────────────────

/// opciones: tamano ("A4", "carta", "oficio", [ancho, alto]), horizontal,
/// titulo, autor, asunto, palabras, comprimir (verdadero).
funcion documento_nuevo(opciones) {
    sea o = opciones ?? {}
    sea t = o["tamano"] ?? (o["size"] ?? "A4")
    sea dim = t
    si (tipo(t) == "texto") {
        dim = _DC_TAMANOS[texto_minusculas(t)] ?? nulo
        si (dim == nulo) { lanzar "documento: tamaño desconocido " + t }
    }
    si (o["horizontal"] ?? falso) { dim = [dim[1], dim[0]] }
    retornar {"tamano": dim, "paginas": [], "fuentes": {}, "imagenes": [], "info": {"Title": o["titulo"] ?? (o["title"] ?? nulo), "Author": o["autor"] ?? (o["author"] ?? nulo), "Subject": o["asunto"] ?? nulo, "Keywords": o["palabras"] ?? nulo}, "comprimir": o["comprimir"] ?? verdadero, "actual": nulo}
}

/// Agrega una página (tamaño opcional distinto) y la deja como actual.
funcion documento_pagina(d, tamano) {
    sea dim = d["tamano"]
    si (tamano != nulo) {
        si (tipo(tamano) == "texto") { dim = _DC_TAMANOS[texto_minusculas(tamano)] } sino { dim = tamano }
    }
    sea p = {"tamano": dim, "ops": [], "fuentes": {}, "imagenes": {}, "enlaces": []}
    d["paginas"].agregar(p)
    d["actual"] = p
    retornar longitud(d["paginas"])
}

funcion documento_paginas(d) { retornar longitud(d["paginas"]) }
funcion documento_alto(d) { retornar d["actual"]["tamano"][1] }
funcion documento_ancho_pagina(d) { retornar d["actual"]["tamano"][0] }

funcion _dc_pag(d) {
    si (d["actual"] == nulo) { documento_pagina(d) }
    retornar d["actual"]
}

funcion _dc_fuente_id(d, p, f) {
    si (tiene_clave(d["fuentes"], f) == falso) { d["fuentes"][f] = "F" + (longitud(claves(d["fuentes"])) + 1) }
    sea id = d["fuentes"][f]
    p["fuentes"][id] = f
    retornar id
}

/// Texto en (x, y) = esquina superior izquierda de la línea. opciones:
/// fuente, tamano (12), color, negrita, cursiva, alinear ("izq" | "centro"
/// | "der"; x es el punto de anclaje), subrayado.
funcion documento_texto(d, x, y, texto, opciones) {
    sea o = opciones ?? {}
    sea p = _dc_pag(d)
    sea f = documento_fuente(o["fuente"] ?? "Helvetica", o["negrita"] ?? falso, o["cursiva"] ?? falso)
    sea tam = o["tamano"] ?? 12
    sea id = _dc_fuente_id(d, p, f)
    sea ancho = documento_ancho(texto, f, tam)
    sea x0 = x
    sea al = o["alinear"] ?? "izq"
    si (al == "centro" o al == "center") { x0 = x - ancho / 2 }
    si (al == "der" o al == "right") { x0 = x - ancho }
    // Línea base a 0.8 del tamaño bajo y (aprox. el ascendente de la fuente).
    sea base = p["tamano"][1] - y - tam * 0.8
    sea color = o["color"] ?? "#000000"
    p["ops"].agregar("BT /" + id + " " + _dc_num(tam) + " Tf " + _dc_color(color) + " rg " + _dc_num(x0) + " " + _dc_num(base) + " Td (" + _dc_escapar(documento_winansi(texto)) + ") Tj ET")
    si (o["subrayado"] ?? falso) { p["ops"].agregar(_dc_color(color) + " RG " + _dc_num(tam / 18) + " w " + _dc_num(x0) + " " + _dc_num(base - tam * 0.12) + " m " + _dc_num(x0 + ancho) + " " + _dc_num(base - tam * 0.12) + " l S") }
    retornar ancho
}

funcion _dc_trazo(o) {
    sea s = ""
    si ((o["grosor"] ?? nulo) != nulo) { s = s + _dc_num(o["grosor"]) + " w " }
    si ((o["guiones"] ?? nulo) != nulo) {
        sea l = []
        para v en o["guiones"] { l.agregar(_dc_num(v)) }
        s = s + "[" + unir(l, " ") + "] 0 d "
    }
    retornar s
}

funcion documento_linea(d, x1, y1, x2, y2, opciones) {
    sea o = opciones ?? {}
    sea p = _dc_pag(d)
    sea h = p["tamano"][1]
    p["ops"].agregar("q " + _dc_trazo(o) + _dc_color(o["color"] ?? "#000000") + " RG " + _dc_num(x1) + " " + _dc_num(h - y1) + " m " + _dc_num(x2) + " " + _dc_num(h - y2) + " l S Q")
}

/// Rectángulo. opciones: relleno (color), borde (color), grosor, radio (esquinas redondeadas).
funcion documento_rect(d, x, y, w, h_, opciones) {
    sea o = opciones ?? {}
    sea p = _dc_pag(d)
    sea H = p["tamano"][1]
    sea s = "q " + _dc_trazo(o)
    si ((o["relleno"] ?? nulo) != nulo) { s = s + _dc_color(o["relleno"]) + " rg " }
    si ((o["borde"] ?? nulo) != nulo) { s = s + _dc_color(o["borde"]) + " RG " }
    sea r = minimo(o["radio"] ?? 0, minimo(w, h_) / 2)
    si (r > 0) {
        sea k = 0.5523 * r
        sea x0 = x
        sea y0 = H - y - h_
        s = s + _dc_num(x0 + r) + " " + _dc_num(y0) + " m " + _dc_num(x0 + w - r) + " " + _dc_num(y0) + " l " + _dc_num(x0 + w - r + k) + " " + _dc_num(y0) + " " + _dc_num(x0 + w) + " " + _dc_num(y0 + r - k) + " " + _dc_num(x0 + w) + " " + _dc_num(y0 + r) + " c " + _dc_num(x0 + w) + " " + _dc_num(y0 + h_ - r) + " l " + _dc_num(x0 + w) + " " + _dc_num(y0 + h_ - r + k) + " " + _dc_num(x0 + w - r + k) + " " + _dc_num(y0 + h_) + " " + _dc_num(x0 + w - r) + " " + _dc_num(y0 + h_) + " c " + _dc_num(x0 + r) + " " + _dc_num(y0 + h_) + " l " + _dc_num(x0 + r - k) + " " + _dc_num(y0 + h_) + " " + _dc_num(x0) + " " + _dc_num(y0 + h_ - r + k) + " " + _dc_num(x0) + " " + _dc_num(y0 + h_ - r) + " c " + _dc_num(x0) + " " + _dc_num(y0 + r) + " l " + _dc_num(x0) + " " + _dc_num(y0 + r - k) + " " + _dc_num(x0 + r - k) + " " + _dc_num(y0) + " " + _dc_num(x0 + r) + " " + _dc_num(y0) + " c "
    } sino { s = s + _dc_num(x) + " " + _dc_num(H - y - h_) + " " + _dc_num(w) + " " + _dc_num(h_) + " re " }
    sea op = "n"
    si ((o["relleno"] ?? nulo) != nulo y (o["borde"] ?? nulo) != nulo) { op = "B" } sino {
        si ((o["relleno"] ?? nulo) != nulo) { op = "f" }
        si ((o["borde"] ?? nulo) != nulo) { op = "S" }
    }
    si (op == "n") { s = s + "0 0 0 RG S Q" } sino { s = s + op + " Q" }
    p["ops"].agregar(s)
}

funcion documento_circulo(d, cx, cy, r, opciones) {
    sea o = opciones ?? {}
    sea p = _dc_pag(d)
    sea H = p["tamano"][1]
    sea y = H - cy
    sea k = 0.5523 * r
    sea s = "q " + _dc_trazo(o)
    si ((o["relleno"] ?? nulo) != nulo) { s = s + _dc_color(o["relleno"]) + " rg " }
    si ((o["borde"] ?? nulo) != nulo) { s = s + _dc_color(o["borde"]) + " RG " }
    s = s + _dc_num(cx + r) + " " + _dc_num(y) + " m " + _dc_num(cx + r) + " " + _dc_num(y + k) + " " + _dc_num(cx + k) + " " + _dc_num(y + r) + " " + _dc_num(cx) + " " + _dc_num(y + r) + " c " + _dc_num(cx - k) + " " + _dc_num(y + r) + " " + _dc_num(cx - r) + " " + _dc_num(y + k) + " " + _dc_num(cx - r) + " " + _dc_num(y) + " c " + _dc_num(cx - r) + " " + _dc_num(y - k) + " " + _dc_num(cx - k) + " " + _dc_num(y - r) + " " + _dc_num(cx) + " " + _dc_num(y - r) + " c " + _dc_num(cx + k) + " " + _dc_num(y - r) + " " + _dc_num(cx + r) + " " + _dc_num(y - k) + " " + _dc_num(cx + r) + " " + _dc_num(y) + " c "
    sea op = "S"
    si ((o["relleno"] ?? nulo) != nulo y (o["borde"] ?? nulo) != nulo) { op = "B" } sino { si ((o["relleno"] ?? nulo) != nulo) { op = "f" } }
    p["ops"].agregar(s + op + " Q")
}

// Dimensiones de un JPEG (marcador SOF).
funcion _dc_jpeg_info(b) {
    si (longitud(b) < 4 o byte_en(b, 0) != 255 o byte_en(b, 1) != 216) { retornar nulo }
    sea i = 2
    mientras (i + 9 < longitud(b)) {
        si (byte_en(b, i) != 255) { retornar nulo }
        sea m = byte_en(b, i + 1)
        sea largo = byte_en(b, i + 2) * 256 + byte_en(b, i + 3)
        si ((m >= 192 y m <= 195) o (m >= 197 y m <= 199) o (m >= 201 y m <= 203) o (m >= 205 y m <= 207)) {
            retornar {"alto": byte_en(b, i + 5) * 256 + byte_en(b, i + 6), "ancho": byte_en(b, i + 7) * 256 + byte_en(b, i + 8), "componentes": byte_en(b, i + 9)}
        }
        i = i + 2 + largo
    }
    retornar nulo
}

/// Imagen JPEG o PNG en (x, y) con ancho w (alto proporcional si h es nulo).
funcion documento_imagen(d, datos, x, y, w, h_) {
    sea p = _dc_pag(d)
    sea img = nulo
    sea info = _dc_jpeg_info(datos)
    si (info != nulo) {
        sea cs = "/DeviceRGB"
        si (info["componentes"] == 1) { cs = "/DeviceGray" }
        si (info["componentes"] == 4) { cs = "/DeviceCMYK" }
        img = {"ancho": info["ancho"], "alto": info["alto"], "filtro": "/DCTDecode", "cs": cs, "datos": datos, "alfa": nulo, "extra": ""}
        si (info["componentes"] == 4) { img["extra"] = " /Decode [1 0 1 0 1 0 1 0]" }
    } sino {
        si (longitud(datos) > 8 y subcadena(datos, 1, 4) == "PNG") {
            sea dec = png_decodificar(datos)
            sea px = dec[2]
            sea n = dec[0] * dec[1]
            sea rgb = []
            sea alfa = []
            sea hay_alfa = falso
            sea i = 0
            mientras (i < n) {
                rgb.agregar(subcadena(px, i * 4, i * 4 + 3))
                sea a = byte_en(px, i * 4 + 3)
                si (a != 255) { hay_alfa = verdadero }
                alfa.agregar(subcadena(px, i * 4 + 3, i * 4 + 4))
                i = i + 1
            }
            img = {"ancho": dec[0], "alto": dec[1], "filtro": "/FlateDecode", "cs": "/DeviceRGB", "datos": zlib_comprimir(unir(rgb, ""), 6), "alfa": nulo, "extra": ""}
            si (hay_alfa) { img["alfa"] = zlib_comprimir(unir(alfa, ""), 6) }
        } sino { lanzar "documento: la imagen debe ser JPEG o PNG" }
    }
    d["imagenes"].agregar(img)
    sea id = "Im" + longitud(d["imagenes"])
    p["imagenes"][id] = longitud(d["imagenes"]) - 1
    sea ancho = w ?? img["ancho"]
    sea alto = h_ ?? (ancho * img["alto"] / img["ancho"])
    p["ops"].agregar("q " + _dc_num(ancho) + " 0 0 " + _dc_num(alto) + " " + _dc_num(x) + " " + _dc_num(p["tamano"][1] - y - alto) + " cm /" + id + " Do Q")
    retornar [ancho, alto]
}

/// Zona que abre una URL al hacer clic.
funcion documento_enlace(d, x, y, w, h_, url) {
    sea p = _dc_pag(d)
    sea H = p["tamano"][1]
    p["enlaces"].agregar({"r": [x, H - y - h_, x + w, H - y], "url": url})
}

/// Operadores PDF crudos en la página actual (para lo que falte).
funcion documento_crudo(d, ops) { _dc_pag(d)["ops"].agregar(ops) }

funcion _dc_texto_pdf(t) {
    // Textos de metadatos: ASCII escapado o UTF-16BE con BOM.
    sea s = "" + t
    sea ascii = verdadero
    sea i = 0
    mientras (i < longitud(s)) { si (byte_en(s, i) >= 128) { ascii = falso }  i = i + 1 }
    si (ascii) { retornar "(" + _dc_escapar(s) + ")" }
    sea r = "FEFF"
    i = 0
    mientras (i < longitud(s)) {
        sea b = byte_en(s, i)
        sea cp = b
        sea l = 1
        si (b >= 240) { cp = ((b - 240) * 64 + byte_en(s, i + 1) - 128) * 4096 + (byte_en(s, i + 2) - 128) * 64 + byte_en(s, i + 3) - 128  l = 4 } sino {
            si (b >= 224) { cp = ((b - 224) * 64 + byte_en(s, i + 1) - 128) * 64 + byte_en(s, i + 2) - 128  l = 3 } sino {
                si (b >= 192) { cp = (b - 192) * 64 + byte_en(s, i + 1) - 128  l = 2 }
            }
        }
        si (cp >= 65536) {
            sea v = cp - 65536
            r = r + _dc_hex4(55296 + piso(v / 1024)) + _dc_hex4(56320 + v % 1024)
        } sino { r = r + _dc_hex4(cp) }
        i = i + l
    }
    retornar "<" + r + ">"
}

funcion _dc_hex4(v) {
    sea h = "0123456789ABCDEF"
    retornar subcadena(h, piso(v / 4096) % 16, piso(v / 4096) % 16 + 1) + subcadena(h, piso(v / 256) % 16, piso(v / 256) % 16 + 1) + subcadena(h, piso(v / 16) % 16, piso(v / 16) % 16 + 1) + subcadena(h, v % 16, v % 16 + 1)
}

/// Bytes del PDF terminado.
funcion documento_bytes(d) {
    si (longitud(d["paginas"]) == 0) { documento_pagina(d) }
    sea objs = []
    // 1 catálogo, 2 páginas, 3 info; luego fuentes, imágenes y páginas.
    objs.agregar("")
    objs.agregar("")
    sea info = []
    para k en ["Title", "Author", "Subject", "Keywords"] { si (d["info"][k] != nulo) { info.agregar("/" + k + " " + _dc_texto_pdf(d["info"][k])) } }
    info.agregar("/Producer (C-Forge documento)")
    objs.agregar("<< " + unir(info, " ") + " >>")
    sea fuente_obj = {}
    para f en claves(d["fuentes"]) {
        objs.agregar("<< /Type /Font /Subtype /Type1 /BaseFont /" + f + " /Encoding /WinAnsiEncoding >>")
        fuente_obj[f] = longitud(objs)
    }
    sea img_obj = []
    para img en d["imagenes"] {
        sea smask = ""
        si (img["alfa"] != nulo) {
            objs.agregar("<< /Type /XObject /Subtype /Image /Width " + img["ancho"] + " /Height " + img["alto"] + " /ColorSpace /DeviceGray /BitsPerComponent 8 /Filter /FlateDecode /Length " + longitud(img["alfa"]) + " >>\nstream\n" + img["alfa"] + "\nendstream")
            smask = " /SMask " + longitud(objs) + " 0 R"
        }
        objs.agregar("<< /Type /XObject /Subtype /Image /Width " + img["ancho"] + " /Height " + img["alto"] + " /ColorSpace " + img["cs"] + " /BitsPerComponent 8 /Filter " + img["filtro"] + img["extra"] + smask + " /Length " + longitud(img["datos"]) + " >>\nstream\n" + img["datos"] + "\nendstream")
        img_obj.agregar(longitud(objs))
    }
    sea kids = []
    para p en d["paginas"] {
        sea contenido = unir(p["ops"], "\n")
        sea filtro = ""
        si (d["comprimir"]) {
            contenido = zlib_comprimir(contenido, 6)
            filtro = " /Filter /FlateDecode"
        }
        objs.agregar("<< /Length " + longitud(contenido) + filtro + " >>\nstream\n" + contenido + "\nendstream")
        sea cont_id = longitud(objs)
        sea annots = []
        para e en p["enlaces"] {
            objs.agregar("<< /Type /Annot /Subtype /Link /Rect [" + _dc_num(e["r"][0]) + " " + _dc_num(e["r"][1]) + " " + _dc_num(e["r"][2]) + " " + _dc_num(e["r"][3]) + "] /Border [0 0 0] /A << /S /URI /URI " + _dc_texto_pdf(e["url"]) + " >> >>")
            annots.agregar(longitud(objs) + " 0 R")
        }
        sea fs = []
        para id en claves(p["fuentes"]) { fs.agregar("/" + id + " " + fuente_obj[p["fuentes"][id]] + " 0 R") }
        sea xs = []
        para id en claves(p["imagenes"]) { xs.agregar("/" + id + " " + img_obj[p["imagenes"][id]] + " 0 R") }
        sea res = "/Resources << /ProcSet [/PDF /Text /ImageB /ImageC] /Font << " + unir(fs, " ") + " >> /XObject << " + unir(xs, " ") + " >> >>"
        sea an = ""
        si (longitud(annots) > 0) { an = " /Annots [" + unir(annots, " ") + "]" }
        objs.agregar("<< /Type /Page /Parent 2 0 R /MediaBox [0 0 " + _dc_num(p["tamano"][0]) + " " + _dc_num(p["tamano"][1]) + "] /Contents " + cont_id + " 0 R " + res + an + " >>")
        kids.agregar(longitud(objs) + " 0 R")
    }
    objs[0] = "<< /Type /Catalog /Pages 2 0 R >>"
    objs[1] = "<< /Type /Pages /Kids [" + unir(kids, " ") + "] /Count " + longitud(kids) + " >>"
    sea partes = ["%PDF-1.7\n%" + bytes_de_hex("e2e3cfd3") + "\n"]
    sea offs = []
    sea pos = longitud(partes[0])
    sea i = 0
    mientras (i < longitud(objs)) {
        sea o = (i + 1) + " 0 obj\n" + objs[i] + "\nendobj\n"
        offs.agregar(pos)
        partes.agregar(o)
        pos = pos + longitud(o)
        i = i + 1
    }
    sea xref = ["xref\n0 " + (longitud(objs) + 1) + "\n0000000000 65535 f \n"]
    para of en offs {
        sea s = "" + of
        mientras (longitud(s) < 10) { s = "0" + s }
        xref.agregar(s + " 00000 n \n")
    }
    partes.agregar(unir(xref, ""))
    partes.agregar("trailer\n<< /Size " + (longitud(objs) + 1) + " /Root 1 0 R /Info 3 0 R >>\nstartxref\n" + pos + "\n%%EOF\n")
    retornar unir(partes, "")
}

// ── Lectura ───────────────────────────────────────────────────────────────

funcion _dc_objetos(b) {
    // Busca "N G obj … endobj" (la última definición gana, como en las
    // actualizaciones incrementales).
    sea r = {}
    sea i = 0
    sea n = longitud(b)
    mientras (verdadero) {
        sea rel = texto_indice(subcadena(b, i, n), " obj")
        si (rel < 0) { retornar r }
        sea k = i + rel
        // Retrocede a los números.
        sea j = k - 1
        mientras (j >= 0 y byte_en(b, j) >= 48 y byte_en(b, j) <= 57) { j = j - 1 }
        sea gen_ini = j + 1
        sea j2 = j - 1
        mientras (j2 >= 0 y byte_en(b, j2) >= 48 y byte_en(b, j2) <= 57) { j2 = j2 - 1 }
        sea num = nulo
        si (j >= 0 y byte_en(b, j) == 32 y j2 + 1 < j) {
            intentar { num = a_numero(subcadena(b, j2 + 1, j)) } capturar (e) { num = nulo }
        }
        sea fin_rel = texto_indice(subcadena(b, k, n), "endobj")
        si (fin_rel < 0) { retornar r }
        si (num != nulo) { r["" + num] = subcadena(b, k + 4, k + fin_rel) }
        i = k + fin_rel + 6
    }
}

funcion _dc_dict_valor(obj, clave) {
    sea k = texto_indice(obj, "/" + clave)
    si (k < 0) { retornar nulo }
    sea resto = texto_recortar(subcadena(obj, k + longitud(clave) + 1, longitud(obj)))
    retornar resto
}

funcion _dc_ref(texto_) {
    // "12 0 R …" → "12"
    sea p = texto_dividir(texto_recortar(texto_), " ")
    si (longitud(p) >= 3 y p[2] == "R") { retornar p[0] }
    si (longitud(p) >= 3 y texto_empieza_con(p[2], "R")) { retornar p[0] }
    retornar nulo
}

funcion _dc_stream(obj) {
    sea k = texto_indice(obj, "stream")
    si (k < 0) { retornar nulo }
    sea ini = k + 6
    si (subcadena(obj, ini, ini + 2) == "\r\n") { ini = ini + 2 } sino { si (subcadena(obj, ini, ini + 1) == "\n" o subcadena(obj, ini, ini + 1) == "\r") { ini = ini + 1 } }
    sea fin = texto_indice(subcadena(obj, ini, longitud(obj)), "endstream")
    sea datos = subcadena(obj, ini, ini + fin)
    mientras (longitud(datos) > 0 y (texto_termina_con(datos, "\n") o texto_termina_con(datos, "\r"))) { datos = subcadena(datos, 0, longitud(datos) - 1) }
    sea dic = subcadena(obj, 0, k)
    si (texto_indice(dic, "/FlateDecode") >= 0) {
        sea r = nulo
        intentar { r = zlib_descomprimir(datos, 50000000) } capturar (e) { r = nulo }
        retornar r
    }
    si (texto_indice(dic, "/Filter") >= 0) { retornar nulo }
    retornar datos
}

funcion _dc_paginas_ids(objs) {
    // Recorre el árbol desde /Root → /Pages.
    sea raiz = nulo
    para k en claves(objs) { si (texto_indice(objs[k], "/Type /Catalog") >= 0 o texto_indice(objs[k], "/Type/Catalog") >= 0) { raiz = objs[k] } }
    sea r = []
    si (raiz == nulo) { retornar r }
    sea pid = _dc_ref(_dc_dict_valor(raiz, "Pages") ?? "")
    sea visitar = nulo
    visitar = funcion(id, prof) {
        si (id == nulo o prof > 50 o tiene_clave(objs, id) == falso) { retornar nulo }
        sea o = objs[id]
        si (texto_indice(o, "/Kids") >= 0) {
            sea k = texto_indice(o, "/Kids")
            sea a = texto_indice(subcadena(o, k, longitud(o)), "[")
            sea c = texto_indice(subcadena(o, k, longitud(o)), "]")
            sea partes = []
            para x en texto_dividir(texto_reemplazar(texto_reemplazar(subcadena(o, k + a + 1, k + c), "\n", " "), "\r", " "), " ") { si (x != "") { partes.agregar(x) } }
            sea i = 0
            mientras (i + 2 < longitud(partes) + 0 y i < longitud(partes)) {
                si (i + 2 < longitud(partes) + 1 y partes[i + 2] == "R") { visitar(partes[i], prof + 1) }
                i = i + 3
            }
        } sino { r.agregar(id) }
    }
    visitar(pid, 0)
    retornar r
}

// Lee un mapa ToUnicode simple (bfchar y bfrange).
funcion _dc_tounicode(cmap) {
    sea m = {}
    sea t = cmap
    sea i = 0
    mientras (verdadero) {
        sea a = texto_indice(subcadena(t, i, longitud(t)), "beginbfchar")
        sea b = texto_indice(subcadena(t, i, longitud(t)), "beginbfrange")
        si (a < 0 y b < 0) { retornar m }
        si (a >= 0 y (b < 0 o a < b)) {
            sea ini = i + a + 11
            sea fin = ini + texto_indice(subcadena(t, ini, longitud(t)), "endbfchar")
            sea hexs = _dc_hexes(subcadena(t, ini, fin))
            sea k = 0
            mientras (k + 1 < longitud(hexs)) { m[hexs[k]] = hexs[k + 1]  k = k + 2 }
            i = fin
        } sino {
            sea ini = i + b + 12
            sea fin = ini + texto_indice(subcadena(t, ini, longitud(t)), "endbfrange")
            sea hexs = _dc_hexes(subcadena(t, ini, fin))
            sea k = 0
            mientras (k + 2 < longitud(hexs)) {
                sea lo = _dc_hex_num(hexs[k])
                sea hi = _dc_hex_num(hexs[k + 1])
                sea dst = _dc_hex_num(hexs[k + 2])
                sea largo = longitud(hexs[k])
                sea v = lo
                mientras (v <= hi y v - lo < 65536) {
                    m[_dc_hex_pad(v, largo)] = _dc_hex_pad(dst + v - lo, 4)
                    v = v + 1
                }
                k = k + 3
            }
            i = fin
        }
    }
}

funcion _dc_hexes(t) {
    sea r = []
    sea i = 0
    mientras (i < longitud(t)) {
        si (subcadena(t, i, i + 1) == "<") {
            sea f = texto_indice(subcadena(t, i, longitud(t)), ">")
            r.agregar(texto_mayusculas(texto_reemplazar(subcadena(t, i + 1, i + f), " ", "")))
            i = i + f + 1
        } sino {
            si (subcadena(t, i, i + 1) == "[") {
                // bfrange con lista: toma el primer destino.
                sea f = texto_indice(subcadena(t, i, longitud(t)), "]")
                sea dentro = _dc_hexes(subcadena(t, i + 1, i + f))
                si (longitud(dentro) > 0) { r.agregar(dentro[0]) }
                i = i + f + 1
            } sino { i = i + 1 }
        }
    }
    retornar r
}

funcion _dc_hex_num(h) {
    sea v = 0
    sea i = 0
    mientras (i < longitud(h)) {
        sea b = byte_en(h, i)
        sea d = b - 48
        si (b >= 65) { d = b - 55 }
        si (b >= 97) { d = b - 87 }
        v = v * 16 + d
        i = i + 1
    }
    retornar v
}

funcion _dc_hex_pad(v, largo) {
    sea h = "0123456789ABCDEF"
    sea r = ""
    sea x = v
    sea i = 0
    mientras (i < largo) { r = subcadena(h, x % 16, x % 16 + 1) + r  x = piso(x / 16)  i = i + 1 }
    retornar r
}

funcion _dc_utf16(h) {
    sea r = ""
    sea i = 0
    mientras (i + 4 <= longitud(h)) {
        sea v = _dc_hex_num(subcadena(h, i, i + 4))
        si (v >= 55296 y v <= 56319 y i + 8 <= longitud(h)) {
            sea w = _dc_hex_num(subcadena(h, i + 4, i + 8))
            v = 65536 + (v - 55296) * 1024 + (w - 56320)
            i = i + 4
        }
        si (v != 0) { r = r + caracter(v) }
        i = i + 4
    }
    retornar r
}

funcion _dc_winansi_a_utf8(b) {
    sea r = ""
    sea i = 0
    mientras (i < longitud(b)) {
        sea v = byte_en(b, i)
        si (v >= 128 y v < 160) { v = _DC_CP1252[v - 128] }
        si (v != 0) { r = r + caracter(v) }
        i = i + 1
    }
    retornar r
}

funcion _dc_literal(c, i) {
    // Texto entre paréntesis con escapes y anidamiento.
    sea r = ""
    sea nivel = 1
    sea j = i + 1
    mientras (j < longitud(c) y nivel > 0) {
        sea ch = subcadena(c, j, j + 1)
        si (ch == "\\") {
            sea e = subcadena(c, j + 1, j + 2)
            sea mapa = {"n": "\n", "r": "\r", "t": "\t", "b": "", "f": "", "(": "(", ")": ")", "\\": "\\"}
            si (tiene_clave(mapa, e)) { r = r + mapa[e]  j = j + 2 } sino {
                si (byte_en(e, 0) >= 48 y byte_en(e, 0) <= 55) {
                    sea k = j + 1
                    sea v = 0
                    mientras (k < j + 4 y k < longitud(c) y byte_en(c, k) >= 48 y byte_en(c, k) <= 55) { v = v * 8 + byte_en(c, k) - 48  k = k + 1 }
                    r = r + _dc_byte(v % 256)
                    j = k
                } sino { j = j + 2 }
            }
        } sino {
            si (ch == "(") { nivel = nivel + 1 }
            si (ch == ")") { nivel = nivel - 1 }
            si (nivel > 0) { r = r + ch }
            j = j + 1
        }
    }
    retornar [r, j]
}

funcion _dc_fuentes_pagina(objs, pagina) {
    // nombre de recurso → mapa ToUnicode (o nulo = WinAnsi).
    sea r = {}
    sea res = pagina
    sea rr = _dc_dict_valor(pagina, "Resources")
    si (rr != nulo y _dc_ref(rr) != nulo) { res = objs[_dc_ref(rr)] ?? pagina }
    sea fk = texto_indice(res, "/Font")
    si (fk < 0) { retornar r }
    sea resto = subcadena(res, fk + 5, longitud(res))
    sea dic = ""
    si (_dc_ref(resto) != nulo) { dic = objs[_dc_ref(resto)] ?? "" } sino {
        sea a = texto_indice(resto, "<<")
        sea b = texto_indice(resto, ">>")
        si (a >= 0 y b > a) { dic = subcadena(resto, a + 2, b) }
    }
    sea toks = []
    para x en texto_dividir(texto_reemplazar(texto_reemplazar(texto_reemplazar(dic, "/", " /"), "\n", " "), "\r", " "), " ") { si (x != "") { toks.agregar(x) } }
    sea i = 0
    mientras (i < longitud(toks)) {
        si (texto_empieza_con(toks[i], "/") y i + 3 < longitud(toks) y toks[i + 3] == "R") {
            sea nombre = subcadena(toks[i], 1, longitud(toks[i]))
            sea fobj = objs[toks[i + 1]] ?? ""
            sea tu = _dc_dict_valor(fobj, "ToUnicode")
            si (tu != nulo y _dc_ref(tu) != nulo) {
                sea cm = _dc_stream(objs[_dc_ref(tu)] ?? "")
                si (cm != nulo) { r[nombre] = _dc_tounicode(cm) }
            }
            i = i + 4
        } sino { i = i + 1 }
    }
    retornar r
}

funcion _dc_decodificar(s, cmap) {
    si (cmap == nulo) { retornar _dc_winansi_a_utf8(s) }
    sea h = texto_mayusculas(hex_de_bytes(s))
    // Prueba códigos de 2 bytes y luego de 1.
    sea r = ""
    sea i = 0
    mientras (i < longitud(h)) {
        sea c4 = subcadena(h, i, i + 4)
        sea c2 = subcadena(h, i, i + 2)
        si (longitud(c4) == 4 y tiene_clave(cmap, c4)) { r = r + _dc_utf16(cmap[c4])  i = i + 4 } sino {
            si (tiene_clave(cmap, c2)) { r = r + _dc_utf16(cmap[c2]) }
            i = i + 2
        }
    }
    retornar r
}

funcion _dc_texto_contenido(c, fuentes) {
    sea r = ""
    sea i = 0
    sea n = longitud(c)
    sea pila = []
    sea cmap = nulo
    sea tx = 0
    sea ty = 0
    sea prev_x = nulo
    sea prev_y = nulo
    sea salto = falso
    sea num = funcion(x) {
        sea v = 0
        intentar { v = a_numero(x["t"] ?? "0") } capturar (e) { v = 0 }
        retornar v
    }
    sea separar = funcion() {
        si (r != "") {
            si (salto o (prev_y != nulo y absoluto(ty - prev_y) > 0.5)) {
                si (texto_termina_con(r, "\n") == falso) { r = r + "\n" }
            } sino {
                si (prev_x != nulo y tx != prev_x y texto_termina_con(r, " ") == falso y texto_termina_con(r, "\n") == falso) { r = r + " " }
            }
        }
        salto = falso
        prev_x = tx
        prev_y = ty
    }
    mientras (i < n) {
        sea ch = subcadena(c, i, i + 1)
        sea b = byte_en(c, i)
        si (ch == "(") {
            sea x = _dc_literal(c, i)
            pila.agregar({"s": x[0]})
            i = x[1]
        } sino {
            si (ch == "<" y subcadena(c, i + 1, i + 2) != "<") {
                sea f = texto_indice(subcadena(c, i, n), ">")
                sea hx = texto_reemplazar(subcadena(c, i + 1, i + f), " ", "")
                si (longitud(hx) % 2 == 1) { hx = hx + "0" }
                pila.agregar({"s": bytes_de_hex(texto_minusculas(hx))})
                i = i + f + 1
            } sino {
                si (ch == "[" o ch == "]") {
                    pila.agregar({"op": ch})
                    i = i + 1
                } sino {
                    si (b == 32 o b == 10 o b == 13 o b == 9) { i = i + 1 } sino {
                        sea j = i
                        mientras (j < n y byte_en(c, j) != 32 y byte_en(c, j) != 10 y byte_en(c, j) != 13 y byte_en(c, j) != 9 y subcadena(c, j, j + 1) != "(" y subcadena(c, j, j + 1) != "[" y subcadena(c, j, j + 1) != "]" y subcadena(c, j, j + 1) != "<" y (j == i o subcadena(c, j, j + 1) != "/")) { j = j + 1 }
                        sea tok = subcadena(c, i, j)
                        i = j
                        sea np = longitud(pila)
                        si (tok == "Tf" y np >= 2) {
                            sea nm = pila[np - 2]["t"] ?? ""
                            cmap = fuentes[subcadena(nm, 1, longitud(nm))] ?? nulo
                            pila = []
                        } sino {
                            si (tok == "Tj" o tok == "'" o tok == "\"") {
                                si (tok != "Tj") { salto = verdadero }
                                separar()
                                si (np > 0 y tiene_clave(pila[np - 1], "s")) { r = r + _dc_decodificar(pila[np - 1]["s"], cmap) }
                                pila = []
                            } sino {
                                si (tok == "TJ") {
                                    separar()
                                    sea dentro = falso
                                    para x en pila {
                                        si ((x["op"] ?? "") == "[") { dentro = verdadero }
                                        si (dentro y tiene_clave(x, "s")) { r = r + _dc_decodificar(x["s"], cmap) }
                                        // Un hueco grande entre trozos suele ser un espacio real.
                                        si (dentro y tiene_clave(x, "t")) { si (num(x) < -200 y texto_termina_con(r, " ") == falso) { r = r + " " } }
                                    }
                                    pila = []
                                } sino {
                                    si (tok == "BT") { tx = 0  ty = 0  pila = [] } sino {
                                        si ((tok == "Td" o tok == "TD") y np >= 2) {
                                            tx = tx + num(pila[np - 2])
                                            ty = ty + num(pila[np - 1])
                                            pila = []
                                        } sino {
                                            si (tok == "Tm" y np >= 6) {
                                                tx = num(pila[np - 2])
                                                ty = num(pila[np - 1])
                                                pila = []
                                            } sino {
                                                si (tok == "T*") { salto = verdadero  pila = [] } sino { pila.agregar({"t": tok}) }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    retornar r
}

/// Lee un PDF: {"paginas", "titulo", "autor", "texto": [texto por página]}.
funcion documento_leer(pdf) {
    si (subcadena(pdf, 0, 5) != "%PDF-") { lanzar "documento: no es un PDF" }
    sea objs = _dc_objetos(pdf)
    sea ids = _dc_paginas_ids(objs)
    sea textos = []
    para id en ids {
        sea p = objs[id]
        sea contenidos = []
        sea cv = _dc_dict_valor(p, "Contents") ?? ""
        si (texto_empieza_con(cv, "[")) {
            sea f = texto_indice(cv, "]")
            sea partes = []
            para x en texto_dividir(texto_reemplazar(subcadena(cv, 1, f), "\n", " "), " ") { si (x != "") { partes.agregar(x) } }
            sea k = 0
            mientras (k + 2 < longitud(partes) + 1) { contenidos.agregar(partes[k])  k = k + 3 }
        } sino { si (_dc_ref(cv) != nulo) { contenidos.agregar(_dc_ref(cv)) } }
        sea fuentes = _dc_fuentes_pagina(objs, p)
        sea t = ""
        para cid en contenidos {
            sea s = _dc_stream(objs[cid] ?? "")
            si (s != nulo) { t = t + _dc_texto_contenido(s, fuentes) }
        }
        textos.agregar(texto_recortar(t))
    }
    sea titulo = nulo
    sea autor = nulo
    para k en claves(objs) {
        sea o = objs[k]
        si (texto_indice(o, "/Producer") >= 0 o texto_indice(o, "/Title") >= 0) {
            para par en [["Title", "t"], ["Author", "a"]] {
                sea v = _dc_dict_valor(o, par[0])
                si (v != nulo) {
                    sea val = nulo
                    si (texto_empieza_con(v, "(")) { val = _dc_winansi_a_utf8(_dc_literal(v, 0)[0]) }
                    si (texto_empieza_con(v, "<")) {
                        sea hx = texto_mayusculas(subcadena(v, 1, texto_indice(v, ">")))
                        si (texto_empieza_con(hx, "FEFF")) { val = _dc_utf16(subcadena(hx, 4, longitud(hx))) } sino { val = _dc_winansi_a_utf8(bytes_de_hex(texto_minusculas(hx))) }
                    }
                    si (par[1] == "t" y val != nulo) { titulo = val }
                    si (par[1] == "a" y val != nulo) { autor = val }
                }
            }
        }
    }
    retornar {"paginas": longitud(ids), "titulo": titulo, "autor": autor, "texto": textos}
}
