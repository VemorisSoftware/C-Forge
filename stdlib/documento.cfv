// stdlib/documento.cfv — PDF sin dependencias: crea documentos con
// páginas de cualquier tamaño, texto con las 14 fuentes estándar
// (Helvetica, Times, Courier en normal, negrita y cursiva, con tildes y ñ
// en WinAnsi), medidas de texto exactas para maquetar, líneas,
// rectángulos, círculos, colores, imágenes JPEG y PNG (con transparencia),
// enlaces, metadatos y compresión; y lee PDFs: cantidad de páginas,
// metadatos y el texto de cada página (Flate, ToUnicode). Para maquetar
// párrafos, tablas y Markdown usa "composicion". Métricas de las fuentes:
// Adobe Core 14 AFM (libres). Inspirada en PDFium / lopdf (BSD/MIT).
// En inglés: importar "pdf".
//
//   importar "documento"
//   sea d = documento_nuevo({"tamano": "A4", "titulo": "Informe"})
//   documento_pagina(d)
//   documento_texto(d, 72, 72, "Hola, Ñuñoa", {"fuente": "Helvetica-Bold", "tamano": 18})
//   documento_linea(d, 72, 100, 523, 100, {"color": "#888"})
//   escribir_archivo("informe.pdf", documento_bytes(d))
//
// Coordenadas en puntos (1/72 de pulgada) desde la esquina superior izquierda.

importar "imagen"

