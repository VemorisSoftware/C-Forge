// stdlib/regla.cfv — validación encadenada de valores sueltos o de
// formularios, con mensajes claros. Complementa a "esquema" (estructuras):
// aquí se describe cada campo con reglas en cadena. Inspirada en
// FluentValidation (Apache). En inglés: importar "validator".
//
//   importar "regla"
//   sea v = regla_validador()
//   regla_campo(v, "correo", ["requerido", "correo"])
//   regla_campo(v, "edad", ["numero", ["entre", 18, 120]])
//   regla_campo(v, "clave", ["requerido", ["largo_min", 8], ["cumple", funcion(x, d) { retornar texto_indice(x, " ") < 0 }, "sin espacios"]])
//   sea r = regla_validar(v, formulario)   // {"ok", "errores": {"campo": ["mensaje", …]}}

funcion regla_validador(idioma) { retornar {"campos": [], "idioma": idioma ?? "es"} }

funcion _rg_t(c, es, en) {
    si (c["idioma"] == "en") { retornar en }
    retornar es
}

/// Declara un campo con su lista de reglas. Cada regla es un nombre o una
/// lista [nombre, argumentos…]:
///   "requerido", "texto", "numero", "entero", "correo", "url", "rut",
///   ["entre", a, b], ["minimo", a], ["maximo", a], ["largo_min", n],
///   ["largo_max", n], ["patron", regex, mensaje?], ["uno_de", lista],
///   ["igual_a", otro_campo, nombre?], ["cumple", f(x, datos), mensaje].
/// También en inglés: required, text, number, integer, email, between, min,
/// max, min_length, max_length, pattern, one_of, equals, must.
funcion regla_campo(v, nombre, reglas, etiqueta) {
    sea c = {"nombre": nombre, "etiqueta": etiqueta ?? nombre, "reglas": [], "opcional": verdadero, "idioma": v["idioma"]}
    para r0 en reglas {
        sea r = r0
        si (tipo(r0) == "texto") { r = [r0] }
        sea n = r[0]
        si (tiene_clave(_RG_EN, n)) { n = _RG_EN[n] }
        si (n == "requerido") { c["opcional"] = falso } sino { c["reglas"].agregar(_rg_regla(c, n, r)) }
    }
    v["campos"].agregar(c)
    retornar c
}

sea _RG_EN = {"required": "requerido", "text": "texto", "number": "numero", "integer": "entero", "email": "correo", "between": "entre", "min": "minimo", "max": "maximo", "min_length": "largo_min", "max_length": "largo_max", "pattern": "patron", "one_of": "uno_de", "equals": "igual_a", "must": "cumple"}

funcion _rg_regla(c, n, r) {
    si (n == "texto") { retornar [funcion(x, d) { retornar tipo(x) == "texto" }, _rg_t(c, "debe ser texto", "must be text")] }
    si (n == "numero") { retornar [funcion(x, d) { retornar tipo(x) == "numero" }, _rg_t(c, "debe ser un número", "must be a number")] }
    si (n == "entero") { retornar [funcion(x, d) { retornar tipo(x) == "numero" y piso(x) == x }, _rg_t(c, "debe ser un número entero", "must be a whole number")] }
    si (n == "entre") {
        sea a = r[1]
        sea b = r[2]
        retornar [funcion(x, d) { retornar tipo(x) == "numero" y x >= a y x <= b }, _rg_t(c, "debe estar entre ", "must be between ") + a + _rg_t(c, " y ", " and ") + b]
    }
    si (n == "minimo") {
        sea a = r[1]
        retornar [funcion(x, d) { retornar tipo(x) == "numero" y x >= a }, _rg_t(c, "debe ser al menos ", "must be at least ") + a]
    }
    si (n == "maximo") {
        sea a = r[1]
        retornar [funcion(x, d) { retornar tipo(x) == "numero" y x <= a }, _rg_t(c, "debe ser como máximo ", "must be at most ") + a]
    }
    si (n == "largo_min") {
        sea a = r[1]
        retornar [funcion(x, d) { retornar longitud("" + x) >= a }, _rg_t(c, "debe tener al menos ", "must have at least ") + a + _rg_t(c, " caracteres", " characters")]
    }
    si (n == "largo_max") {
        sea a = r[1]
        retornar [funcion(x, d) { retornar longitud("" + x) <= a }, _rg_t(c, "debe tener como máximo ", "must have at most ") + a + _rg_t(c, " caracteres", " characters")]
    }
    si (n == "correo") { retornar [funcion(x, d) { retornar _rg_correo("" + x) }, _rg_t(c, "no es un correo válido", "is not a valid email")] }
    si (n == "url") { retornar [funcion(x, d) { retornar (texto_empieza_con("" + x, "https://") o texto_empieza_con("" + x, "http://")) y longitud("" + x) > 10 y texto_indice("" + x, " ") < 0 }, _rg_t(c, "no es una URL válida", "is not a valid URL")] }
    si (n == "rut") { retornar [funcion(x, d) { retornar regla_rut_valido("" + x) }, _rg_t(c, "no es un RUT válido", "is not a valid Chilean RUT")] }
    si (n == "patron") {
        sea p = r[1]
        sea m = _rg_t(c, "no tiene el formato esperado", "has an invalid format")
        si (longitud(r) > 2) { m = r[2] }
        retornar [funcion(x, d) { retornar regex_coincidir("^(" + p + ")$", "" + x) }, m]
    }
    si (n == "uno_de") {
        sea l = r[1]
        retornar [funcion(x, d) {
            para o en l { si (o == x) { retornar verdadero } }
            retornar falso
        }, _rg_t(c, "debe ser uno de: ", "must be one of: ") + unir(l, ", ")]
    }
    si (n == "igual_a") {
        sea otro = r[1]
        sea nombre_otro = otro
        si (longitud(r) > 2) { nombre_otro = r[2] }
        retornar [funcion(x, d) { retornar tiene_clave(d, otro) y d[otro] == x }, _rg_t(c, "debe coincidir con ", "must match ") + nombre_otro]
    }
    si (n == "cumple") {
        sea m = _rg_t(c, "no es válido", "is invalid")
        si (longitud(r) > 2) { m = r[2] }
        retornar [r[1], m]
    }
    lanzar "regla: regla desconocida " + n
}

importar "regex"

funcion _rg_correo(t) {
    si (texto_indice(t, " ") >= 0 o longitud(t) > 254) { retornar falso }
    sea p = texto_dividir(t, "@")
    si (longitud(p) != 2) { retornar falso }
    si (p[0] == "") { retornar falso }
    retornar texto_indice(p[1], ".") > 0 y texto_termina_con(p[1], ".") == falso
}

/// RUT chileno (acepta 12.345.678-5, 12345678-5 o 123456785; K o k).
funcion regla_rut_valido(rut) {
    sea t = texto_mayusculas(texto_reemplazar(texto_reemplazar(texto_recortar("" + rut), ".", ""), "-", ""))
    si (longitud(t) < 2 o longitud(t) > 9) { retornar falso }
    sea cuerpo = subcadena(t, 0, longitud(t) - 1)
    sea dv = subcadena(t, longitud(t) - 1, longitud(t))
    sea n = 0
    para d en texto_dividir(cuerpo, "") {
        sea k = texto_indice("0123456789", d)
        si (k < 0) { retornar falso }
        n = n * 10 + k
    }
    sea suma = 0
    sea factor = 2
    mientras (n > 0) {
        suma = suma + (n % 10) * factor
        n = cociente(n, 10)
        factor = factor + 1
        si (factor > 7) { factor = 2 }
    }
    sea r = 11 - suma % 11
    sea esperado = "" + r
    si (r == 11) { esperado = "0" }
    si (r == 10) { esperado = "K" }
    retornar dv == esperado
}

funcion _rg_vacio(x) { retornar x == nulo o (tipo(x) == "texto" y texto_recortar(x) == "") }

/// Valida un mapa de datos. Un campo opcional vacío no se revisa.
funcion regla_validar(v, datos) {
    sea errores = {}
    para c en v["campos"] {
        sea x = nulo
        si (tiene_clave(datos, c["nombre"])) { x = datos[c["nombre"]] }
        sea lista = []
        si (_rg_vacio(x)) {
            si (c["opcional"] == falso) { lista.agregar(_rg_t(c, "es obligatorio", "is required")) }
        } sino {
            para r en c["reglas"] {
                sea ok = falso
                intentar { ok = r[0](x, datos) == verdadero } capturar (e) { ok = falso }
                si (ok == falso) { lista.agregar(r[1]) }
            }
        }
        si (longitud(lista) > 0) { errores[c["nombre"]] = lista }
    }
    retornar {"ok": longitud(claves(errores)) == 0, "errores": errores}
}

/// Mensajes listos para mostrar: ["Correo: no es un correo válido", …].
funcion regla_mensajes(v, resultado) {
    sea r = []
    para c en v["campos"] {
        si (tiene_clave(resultado["errores"], c["nombre"])) {
            para m en resultado["errores"][c["nombre"]] { r.agregar(c["etiqueta"] + ": " + m) }
        }
    }
    retornar r
}
