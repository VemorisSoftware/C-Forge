// stdlib/stats.cfv — pruebas y distribuciones estadísticas: nombres en inglés del módulo "estadistica".
// English names for the "estadistica" module; both can be used together.

importar "estadistica"

funcion _stats_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_stats_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _stats_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _STATS_RES = {"gl": "df", "gl_entre": "df_between", "gl_dentro": "df_within", "media": "mean", "inferior": "lower", "superior": "upper", "esperados": "expected", "error": "stderr"}

funcion stats_ln_gamma(x) { retornar estadistica_ln_gamma(x) }
funcion stats_beta_inc(x, a, b) { retornar estadistica_beta_inc(x, a, b) }
funcion stats_gamma_inc(a, x) { retornar estadistica_gamma_inc(a, x) }
funcion stats_normal_pdf(x, media, desv) { retornar estadistica_normal_pdf(x, media, desv) }
funcion stats_normal_cdf(x, media, desv) { retornar estadistica_normal_cdf(x, media, desv) }
funcion stats_normal_ppf(p, media, desv) { retornar estadistica_normal_inv(p, media, desv) }
funcion stats_t_cdf(t, gl) { retornar estadistica_t_cdf(t, gl) }
funcion stats_t_ppf(p, gl) { retornar estadistica_t_inv(p, gl) }
funcion stats_chi2_cdf(x, gl) { retornar estadistica_chi2_cdf(x, gl) }
funcion stats_f_cdf(x, d1, d2) { retornar estadistica_f_cdf(x, d1, d2) }
funcion stats_ttest_1samp(xs, mu, cola) { retornar _stats_tr(estadistica_t_una(xs, mu, cola), _STATS_RES) }
funcion stats_ttest_ind(a, b, cola) { retornar _stats_tr(estadistica_t_dos(a, b, cola), _STATS_RES) }
funcion stats_ttest_rel(a, b, cola) { retornar _stats_tr(estadistica_t_pareada(a, b, cola), _STATS_RES) }
funcion stats_chi2_contingency(tabla) { retornar _stats_tr(estadistica_chi2_tabla(tabla), _STATS_RES) }
funcion stats_chisquare(observados, esperados) { retornar _stats_tr(estadistica_chi2_ajuste(observados, esperados), _STATS_RES) }
funcion stats_f_oneway(grupos) { retornar _stats_tr(estadistica_anova(grupos), _STATS_RES) }
funcion stats_pearsonr(xs, ys) { retornar _stats_tr(estadistica_correlacion(xs, ys), _STATS_RES) }
funcion stats_confidence_interval(xs, confianza) { retornar _stats_tr(estadistica_intervalo(xs, confianza), _STATS_RES) }
funcion stats_cohen_d(a, b) { retornar estadistica_cohen_d(a, b) }
