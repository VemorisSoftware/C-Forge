// stdlib/hidapi.cfv — Dispositivos USB HID (estilo hidapi): nombres en inglés del módulo "mando".
// English names for the "mando" module; both can be used together.

importar "mando"

funcion _hidapi_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_hidapi_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _hidapi_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _HIDAPI_RES = {"ruta": "path", "serie": "serial_number", "producto": "product_string", "pagina_uso": "usage_page", "uso": "usage", "campos": "fields", "colecciones": "collections", "con_id": "numbered", "tipo": "type", "usos": "usages", "inicio": "start", "tam": "size", "cuenta": "count", "lmin": "logical_min", "lmax": "logical_max", "pmin": "physical_min", "pmax": "physical_max", "unidad": "unit", "exponente": "unit_exp", "arreglo": "array", "constante": "const", "relativo": "relative", "nulo": "null_state", "nombre": "name", "pagina": "page", "campo": "field", "valores": "values", "nivel": "level"}

funcion hid_enumerate(vendor, producto) { retornar _hidapi_tr(mando_enumerar(vendor, producto), _HIDAPI_RES) }
funcion hid_open(vendor, producto, serie) { retornar mando_abrir(vendor, producto, serie) }
funcion hid_open_path(ruta) { retornar mando_abrir_ruta(ruta) }
funcion hid_write(m, datos) { retornar mando_escribir(m, datos) }
funcion hid_read_timeout(m, tam, tiempo_max) { retornar mando_leer(m, tam, tiempo_max) }
funcion hid_send_feature_report(m, datos) { retornar mando_enviar_caracteristica(m, datos) }
funcion hid_get_feature_report(m, id, tam) { retornar mando_obtener_caracteristica(m, id, tam) }
funcion hid_get_report_descriptor(m) { retornar mando_descriptor(m) }
funcion hid_close(m) { retornar mando_cerrar(m) }
funcion hid_parse_report_descriptor(datos) { retornar _hidapi_tr(mando_analizar_descriptor(datos), _HIDAPI_RES) }
funcion hid_decode_report(desc, reporte, tipo_r) { retornar _hidapi_tr(mando_decodificar(desc, reporte, tipo_r), _HIDAPI_RES) }
funcion hid_report_values(desc, reporte) { retornar mando_valores(desc, reporte) }
funcion hid_encode_report(desc, id, valores, tipo_r) { retornar mando_codificar(desc, id, valores, tipo_r) }
funcion hid_report_fields(desc, id, tipo_r) { retornar _hidapi_tr(mando_campos_reporte(desc, id, tipo_r), _HIDAPI_RES) }
funcion hid_usage_name(uso) { retornar mando_nombre_uso(uso) }
funcion hid_usage_page_name(pagina) { retornar mando_nombre_pagina(pagina) }
funcion hid_set_roots(sysfs, dev) { retornar mando_raices(sysfs, dev) }
