// stdlib/ratelimit.cfv — límite de peticiones: nombres en inglés del módulo "freno".
// English names for the "freno" module; both can be used together.

importar "freno"

funcion ratelimit_new(capacidad, por_segundo) { retornar freno_nuevo(capacidad, por_segundo) }
funcion ratelimit_with_clock(f, reloj) { retornar freno_con_reloj(f, reloj) }
funcion ratelimit_allow(f, clave, costo) { retornar freno_permitir(f, clave, costo) }
funcion ratelimit_remaining(f, clave) { retornar freno_restante(f, clave) }
funcion ratelimit_wait_ms(f, clave) { retornar freno_espera_ms(f, clave) }
funcion ratelimit_headers(f, clave) { retornar freno_cabeceras(f, clave) }
