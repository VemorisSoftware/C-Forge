// stdlib/meshio.cfv — importar y exportar modelos 3D: nombres en inglés del módulo "importa3d".
// English names for the "importa3d" module; both can be used together.


importar "importa3d"

funcion _meshio_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_meshio_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _meshio_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _MESHIO_RES = {"triangulos": "triangles", "centro": "center", "tamano": "size", "volumen": "volume", "cerrada": "watertight"}
sea _MESHIO_OPT = {"format": "formato", "name": "nombre", "join": "unir", "tolerance": "tolerancia", "clean": "limpiar", "flip": "invertir", "center": "centrar", "scale": "escala", "normals": "normales"}

funcion meshio_detect(datos, nombre) { retornar importa3d_formato(datos, nombre) }
funcion meshio_load_bytes(datos, opciones) { retornar importa3d_desde(datos, _meshio_opt(opciones)) }
funcion meshio_load(ruta, opciones) { retornar importa3d_cargar(ruta, _meshio_opt(opciones)) }
funcion meshio_process(m, opciones) { retornar importa3d_procesar(m, _meshio_opt(opciones)) }
funcion meshio_join_vertices(m, tolerancia) { retornar importa3d_unir(m, tolerancia) }
funcion meshio_remove_degenerate(m) { retornar importa3d_limpiar(m) }
funcion meshio_flip(m) { retornar importa3d_invertir(m) }
funcion meshio_normalize(m, centrar, escala) { retornar importa3d_normalizar(m, centrar, escala) }
funcion meshio_flat_normals(m) { retornar importa3d_normales_planas(m) }
funcion meshio_smooth_normals(m) { retornar importa3d_normales_suaves(m) }
funcion meshio_measure(m) { retornar _meshio_tr(importa3d_medidas(m), _MESHIO_RES) }
funcion meshio_export(m, formato, opciones) { retornar importa3d_exportar(m, formato, _meshio_opt(opciones)) }

funcion _meshio_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_MESHIO_OPT[k] ?? k] = o[k] }
    retornar r
}
