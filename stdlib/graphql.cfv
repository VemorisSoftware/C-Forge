// stdlib/graphql.cfv — GraphQL: nombres en inglés del módulo "grafo_api".
// English names for the "grafo_api" module; both can be used together.

importar "grafo_api"

funcion graphql_schema(sdl) { retornar grafo_esquema(sdl) }
funcion graphql_parse(texto) { retornar grafo_analizar(texto) }
funcion graphql_execute(g, resolvedores, consulta, variables, operacion, contexto) { retornar grafo_ejecutar(g, resolvedores, consulta, variables, operacion, contexto) }
funcion graphql_json(g, resolvedores, consulta, variables, operacion, contexto) { retornar grafo_json(g, resolvedores, consulta, variables, operacion, contexto) }
funcion graphql_http(g, resolvedores, cuerpo, contexto) { retornar grafo_http(g, resolvedores, cuerpo, contexto) }
