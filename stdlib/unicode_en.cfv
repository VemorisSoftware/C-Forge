// stdlib/unicode_en.cfv — Unicode: nombres en inglés del módulo "unicode".
// English names for the "unicode" module; both can be used together.

importar "unicode"

funcion unicode_code_points(t) { retornar unicode_puntos(t) }
funcion unicode_from_code_points(puntos) { retornar unicode_texto(puntos) }
funcion unicode_length(t) { retornar unicode_largo(t) }
funcion unicode_is_nfc(t) { retornar unicode_es_nfc(t) }
funcion unicode_lower(t) { retornar unicode_minusculas(t) }
funcion unicode_upper(t) { retornar unicode_mayusculas(t) }
funcion unicode_title(t) { retornar unicode_titulo(t) }
funcion unicode_casefold(t) { retornar unicode_plegar(t) }
funcion unicode_equals_ignore_case(a, b) { retornar unicode_iguales_sin_caso(a, b) }
funcion unicode_strip_accents(t) { retornar unicode_sin_acentos(t) }
funcion unicode_graphemes(t) { retornar unicode_grafemas(t) }
funcion unicode_width(t) { retornar unicode_ancho(t) }
funcion unicode_truncate(t, ancho, sufijo) { retornar unicode_cortar(t, ancho, sufijo) }
funcion unicode_reverse(t) { retornar unicode_invertir(t) }
funcion unicode_pad(t, ancho, alinear) { retornar unicode_rellenar(t, ancho, alinear) }
funcion unicode_sort_key(t, opciones) { retornar unicode_clave(t, opciones) }
funcion unicode_compare(a, b, opciones) { retornar unicode_comparar(a, b, opciones) }
funcion unicode_sort(lista, opciones) { retornar unicode_ordenar(lista, opciones) }
