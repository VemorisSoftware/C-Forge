// stdlib/matriz.cfv — arreglos numéricos de N dimensiones: forma, índices,
// operaciones elemento a elemento con difusión (broadcasting), producto
// matricial, reducciones por eje. Inspirada en NumPy (BSD). En inglés:
// importar "ndarray".
//
//   importar "matriz"
//   sea a = matriz_de([[1, 2], [3, 4]])
//   matriz_a_lista(matriz_punto(a, matriz_transponer(a)))   // [[5, 11], [11, 25]]
//   matriz_a_lista(matriz_sumar(a, matriz_de([10, 20])))    // [[11, 22], [13, 24]]
//   matriz_suma(a, 0)                                       // por columnas
//
// Representación: {"forma": [f, c, …], "datos": [plano en orden C]}.

funcion _mz_producto(forma) {
    sea p = 1
    para d en forma { p = p * d }
    retornar p
}

funcion _mz(forma, datos) { retornar {"forma": forma, "datos": datos} }

funcion _mz_aplanar(v, prof, forma, datos) {
    si (tipo(v) == "lista") {
        si (prof == longitud(forma)) { forma.agregar(longitud(v)) } sino {
            si (prof > longitud(forma) o forma[prof] != longitud(v)) { lanzar "matriz: lista irregular (las filas deben medir lo mismo)" }
        }
        para x en v { _mz_aplanar(x, prof + 1, forma, datos) }
    } sino {
        si (tipo(v) != "numero") { lanzar "matriz: solo números, no " + tipo(v) }
        si (prof != longitud(forma)) { lanzar "matriz: lista irregular (las filas deben medir lo mismo)" }
        datos.agregar(v)
    }
}

/// Lista anidada (o número) → matriz.
funcion matriz_de(lista) {
    sea forma = []
    sea datos = []
    _mz_aplanar(lista, 0, forma, datos)
    retornar _mz(forma, datos)
}

funcion matriz_llena(forma, valor) {
    sea f = forma
    si (tipo(forma) == "numero") { f = [forma] }
    sea n = _mz_producto(f)
    si (n > 50000000) { lanzar "matriz: demasiado grande" }
    sea d = []
    sea i = 0
    mientras (i < n) { d.agregar(valor)  i = i + 1 }
    sea copia = []
    para x en f { copia.agregar(x) }
    retornar _mz(copia, d)
}
funcion matriz_ceros(forma) { retornar matriz_llena(forma, 0) }
funcion matriz_unos(forma) { retornar matriz_llena(forma, 1) }

funcion matriz_identidad(n) {
    sea m = matriz_ceros([n, n])
    sea i = 0
    mientras (i < n) { m["datos"][i * n + i] = 1  i = i + 1 }
    retornar m
}

/// 0, 1, …, n-1 (o desde, hasta, paso).
funcion matriz_rango(desde, hasta, paso) {
    sea a = 0
    sea b = desde
    si (hasta != nulo) { a = desde  b = hasta }
    sea p = paso ?? 1
    si (p == 0) { lanzar "matriz: paso 0" }
    sea d = []
    sea x = a
    mientras ((p > 0 y x < b) o (p < 0 y x > b)) { d.agregar(x)  x = x + p }
    retornar _mz([longitud(d)], d)
}

/// n números de a a b (ambos incluidos).
funcion matriz_espacio(a, b, n) {
    sea d = []
    sea i = 0
    mientras (i < n) {
        si (n == 1) { d.agregar(a) } sino { d.agregar(a + (b - a) * i / (n - 1)) }
        i = i + 1
    }
    retornar _mz([n], d)
}

funcion matriz_forma(m) { retornar m["forma"] }
funcion matriz_tamano(m) { retornar longitud(m["datos"]) }

/// Cambia la forma (un -1 se deduce).
funcion matriz_remodelar(m, forma) {
    sea n = longitud(m["datos"])
    sea f = []
    sea libre = 0 - 1
    sea p = 1
    sea i = 0
    para d en forma {
        si (d == -1) { libre = i } sino { p = p * d }
        f.agregar(d)
        i = i + 1
    }
    si (libre >= 0) {
        si (p == 0 o n % p != 0) { lanzar "matriz: no se puede remodelar " + n + " elementos" }
        f[libre] = cociente(n, p)
    }
    si (_mz_producto(f) != n) { lanzar "matriz: no se puede remodelar " + n + " elementos en " + f }
    retornar _mz(f, m["datos"])
}

funcion _mz_offset(m, indices) {
    sea f = m["forma"]
    si (longitud(indices) != longitud(f)) { lanzar "matriz: se esperaban " + longitud(f) + " índices" }
    sea o = 0
    sea k = 0
    mientras (k < longitud(f)) {
        sea i = indices[k]
        si (i < 0) { i = f[k] + i }
        si (i < 0 o i >= f[k]) { lanzar "matriz: índice fuera de rango en el eje " + k }
        o = o * f[k] + i
        k = k + 1
    }
    retornar o
}

funcion matriz_obtener(m, indices) { retornar m["datos"][_mz_offset(m, indices)] }
funcion matriz_poner(m, indices, v) { m["datos"][_mz_offset(m, indices)] = v  retornar m }

funcion _mz_lista(datos, forma, eje, inicio) {
    si (eje == longitud(forma)) { retornar datos[inicio] }
    sea paso = 1
    sea k = eje + 1
    mientras (k < longitud(forma)) { paso = paso * forma[k]  k = k + 1 }
    sea r = []
    sea i = 0
    mientras (i < forma[eje]) { r.agregar(_mz_lista(datos, forma, eje + 1, inicio + i * paso))  i = i + 1 }
    retornar r
}

funcion matriz_a_lista(m) {
    si (longitud(m["forma"]) == 0) { retornar m["datos"][0] }
    retornar _mz_lista(m["datos"], m["forma"], 0, 0)
}

/// f(x) a cada elemento.
funcion matriz_aplicar(m, f) {
    sea d = []
    para x en m["datos"] { d.agregar(f(x)) }
    retornar _mz(m["forma"], d)
}

// Difusión estilo NumPy: alinea por la derecha; 1 se estira.
funcion _mz_operar(a, b, op) {
    si (tipo(a) == "numero") { a = _mz([], [a]) }
    si (tipo(b) == "numero") { b = _mz([], [b]) }
    sea fa = a["forma"]
    sea fb = b["forma"]
    sea n = maximo(longitud(fa), longitud(fb))
    sea f = []
    sea k = 0
    mientras (k < n) {
        sea da = 1
        sea db = 1
        si (k >= n - longitud(fa)) { da = fa[k - (n - longitud(fa))] }
        si (k >= n - longitud(fb)) { db = fb[k - (n - longitud(fb))] }
        si (da != db y da != 1 y db != 1) { lanzar "matriz: formas incompatibles " + fa + " y " + fb }
        f.agregar(maximo(da, db))
        k = k + 1
    }
    sea total = _mz_producto(f)
    sea d = []
    sea mismo = longitud(fa) == longitud(fb) y longitud(a["datos"]) == total y longitud(b["datos"]) == total
    sea idx = []
    k = 0
    mientras (k < n) { idx.agregar(0)  k = k + 1 }
    sea i = 0
    mientras (i < total) {
        si (mismo) { d.agregar(op(a["datos"][i], b["datos"][i])) } sino {
            sea oa = 0
            sea ob = 0
            k = 0
            mientras (k < n) {
                sea ka = k - (n - longitud(fa))
                si (ka >= 0) { si (fa[ka] != 1) { oa = oa * fa[ka] + idx[k] } sino { oa = oa * 1 } }
                sea kb = k - (n - longitud(fb))
                si (kb >= 0) { si (fb[kb] != 1) { ob = ob * fb[kb] + idx[k] } sino { ob = ob * 1 } }
                k = k + 1
            }
            d.agregar(op(a["datos"][oa], b["datos"][ob]))
            // Siguiente índice
            k = n - 1
            sea acarreo = verdadero
            mientras (k >= 0 y acarreo) {
                idx[k] = idx[k] + 1
                si (idx[k] < f[k]) { acarreo = falso } sino { idx[k] = 0 }
                k = k - 1
            }
        }
        i = i + 1
    }
    retornar _mz(f, d)
}

funcion matriz_sumar(a, b) { retornar _mz_operar(a, b, funcion(x, y) { retornar x + y }) }
funcion matriz_restar(a, b) { retornar _mz_operar(a, b, funcion(x, y) { retornar x - y }) }
funcion matriz_multiplicar(a, b) { retornar _mz_operar(a, b, funcion(x, y) { retornar x * y }) }
funcion matriz_dividir(a, b) { retornar _mz_operar(a, b, funcion(x, y) { retornar x / y }) }
funcion matriz_potencia(a, b) { retornar _mz_operar(a, b, funcion(x, y) { retornar potencia(x, y) }) }

/// Transpuesta de una matriz 2D (o vector: igual).
funcion matriz_transponer(m) {
    sea f = m["forma"]
    si (longitud(f) == 1) { retornar m }
    si (longitud(f) != 2) { lanzar "matriz: transponer necesita 2 dimensiones" }
    sea d = []
    sea j = 0
    mientras (j < f[1]) {
        sea i = 0
        mientras (i < f[0]) { d.agregar(m["datos"][i * f[1] + j])  i = i + 1 }
        j = j + 1
    }
    retornar _mz([f[1], f[0]], d)
}

/// Producto punto (vectores) o matricial (2D · 2D, 2D · vector).
funcion matriz_punto(a, b) {
    sea fa = a["forma"]
    sea fb = b["forma"]
    si (longitud(fa) == 1 y longitud(fb) == 1) {
        si (fa[0] != fb[0]) { lanzar "matriz: vectores de largo distinto" }
        sea s = 0
        sea i = 0
        mientras (i < fa[0]) { s = s + a["datos"][i] * b["datos"][i]  i = i + 1 }
        retornar s
    }
    sea filas = fa[0]
    sea comun = fa[1]
    sea vector = longitud(fb) == 1
    sea cols = 1
    si (vector == falso) { cols = fb[1] }
    si (longitud(fa) != 2 o fb[0] != comun) { lanzar "matriz: formas incompatibles " + fa + " · " + fb }
    sea d = []
    sea i = 0
    mientras (i < filas) {
        sea j = 0
        mientras (j < cols) {
            sea s = 0
            sea k = 0
            mientras (k < comun) { s = s + a["datos"][i * comun + k] * b["datos"][k * cols + j]  k = k + 1 }
            d.agregar(s)
            j = j + 1
        }
        i = i + 1
    }
    si (vector) { retornar _mz([filas], d) }
    retornar _mz([filas, cols], d)
}

// Reducción a lo largo de un eje (o de todo si eje es nulo).
funcion _mz_reducir(m, eje, inicial, f) {
    si (eje == nulo) {
        sea acc = inicial
        para x en m["datos"] { si (acc == nulo) { acc = x } sino { acc = f(acc, x) } }
        retornar acc
    }
    sea forma = m["forma"]
    sea e = eje
    si (e < 0) { e = longitud(forma) + e }
    si (e < 0 o e >= longitud(forma)) { lanzar "matriz: eje fuera de rango" }
    sea antes = 1
    sea k = 0
    mientras (k < e) { antes = antes * forma[k]  k = k + 1 }
    sea despues = 1
    k = e + 1
    mientras (k < longitud(forma)) { despues = despues * forma[k]  k = k + 1 }
    sea d = []
    sea i = 0
    mientras (i < antes) {
        sea j = 0
        mientras (j < despues) {
            sea acc = inicial
            sea t = 0
            mientras (t < forma[e]) {
                sea x = m["datos"][(i * forma[e] + t) * despues + j]
                si (acc == nulo) { acc = x } sino { acc = f(acc, x) }
                t = t + 1
            }
            d.agregar(acc)
            j = j + 1
        }
        i = i + 1
    }
    sea nf = []
    k = 0
    mientras (k < longitud(forma)) { si (k != e) { nf.agregar(forma[k]) }  k = k + 1 }
    retornar _mz(nf, d)
}

funcion matriz_suma(m, eje) { retornar _mz_reducir(m, eje, 0, funcion(a, b) { retornar a + b }) }
funcion matriz_max(m, eje) { retornar _mz_reducir(m, eje, nulo, funcion(a, b) { retornar maximo(a, b) }) }
funcion matriz_min(m, eje) { retornar _mz_reducir(m, eje, nulo, funcion(a, b) { retornar minimo(a, b) }) }
funcion matriz_media(m, eje) {
    si (eje == nulo) { retornar matriz_suma(m) / longitud(m["datos"]) }
    sea e = eje
    si (e < 0) { e = longitud(m["forma"]) + e }
    retornar matriz_dividir(matriz_suma(m, e), m["forma"][e])
}

/// Índice plano del máximo.
funcion matriz_argmax(m) {
    sea mejor = 0
    sea i = 1
    mientras (i < longitud(m["datos"])) { si (m["datos"][i] > m["datos"][mejor]) { mejor = i }  i = i + 1 }
    retornar mejor
}

/// Filas de una matriz 2D de desde a hasta (sin incluir).
funcion matriz_filas(m, desde, hasta) {
    sea f = m["forma"]
    sea cols = _mz_producto(f) / f[0]
    sea a = maximo(0, desde)
    sea b = minimo(f[0], hasta ?? f[0])
    sea d = []
    sea i = a * cols
    mientras (i < b * cols) { d.agregar(m["datos"][i])  i = i + 1 }
    sea nf = [maximo(0, b - a)]
    sea k = 1
    mientras (k < longitud(f)) { nf.agregar(f[k])  k = k + 1 }
    retornar _mz(nf, d)
}

/// ¿Iguales con tolerancia?
funcion matriz_casi_igual(a, b, tolerancia) {
    sea t = tolerancia ?? 0.000000001
    si (a["forma"] + "" != b["forma"] + "") { retornar falso }
    sea i = 0
    mientras (i < longitud(a["datos"])) {
        si (absoluto(a["datos"][i] - b["datos"][i]) > t) { retornar falso }
        i = i + 1
    }
    retornar verdadero
}
