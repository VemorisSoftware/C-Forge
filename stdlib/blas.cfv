// stdlib/blas.cfv — Álgebra lineal densa al estilo de BLAS y LAPACK
// (OpenBLAS): operaciones de vectores (nivel 1), matriz-vector (nivel 2) y
// matriz-matriz (nivel 3), y las factorizaciones de LAPACK más usadas: LU
// con pivoteo parcial, Cholesky, QR de Householder, mínimos cuadrados,
// valores y vectores propios de matrices simétricas (Jacobi) y SVD (Jacobi
// de un lado). Las matrices son listas de filas y los vectores, listas.
// Idea de OpenBLAS (BSD) y LAPACK (BSD), escrito desde cero. En inglés:
// importar "openblas".
//
//   importar "blas"
//   blas_gemm(1, [[1, 2], [3, 4]], [[5, 6], [7, 8]], 0, nulo, falso, falso)   // [[19, 22], [43, 50]]
//   blas_resolver([[2, 1], [1, 3]], [3, 5])                                   // [0.8, 1.4]

funcion _bl2_dim(A) { retornar [longitud(A), longitud(A[0])] }

funcion _bl2_ceros(m, n) {
    sea r = []
    sea i = 0
    mientras (i < m) {
        sea f = []
        sea j = 0
        mientras (j < n) {
            f.agregar(0)
            j = j + 1
        }
        r.agregar(f)
        i = i + 1
    }
    retornar r
}

funcion _bl2_copiar(A) {
    sea r = []
    para f en A {
        sea g = []
        para x en f { g.agregar(x) }
        r.agregar(g)
    }
    retornar r
}

/// Matriz identidad n×n.
funcion blas_identidad(n) {
    sea r = _bl2_ceros(n, n)
    sea i = 0
    mientras (i < n) {
        r[i][i] = 1
        i = i + 1
    }
    retornar r
}

/// Traspuesta.
funcion blas_traspuesta(A) {
    sea d = _bl2_dim(A)
    sea r = _bl2_ceros(d[1], d[0])
    sea i = 0
    mientras (i < d[0]) {
        sea j = 0
        mientras (j < d[1]) {
            r[j][i] = A[i][j]
            j = j + 1
        }
        i = i + 1
    }
    retornar r
}

// ---------- nivel 1 ----------

/// Producto punto x·y.
funcion blas_punto(x, y) {
    sea s = 0
    sea i = 0
    mientras (i < longitud(x)) {
        s = s + x[i] * y[i]
        i = i + 1
    }
    retornar s
}

/// a·x + y (nuevo vector).
funcion blas_axpy(a, x, y) {
    sea r = []
    sea i = 0
    mientras (i < longitud(x)) {
        r.agregar(a * x[i] + y[i])
        i = i + 1
    }
    retornar r
}

/// a·x.
funcion blas_escalar(a, x) {
    sea r = []
    para v en x { r.agregar(a * v) }
    retornar r
}

/// Norma euclídea sin desbordes (como dnrm2).
funcion blas_norma2(x) {
    sea escala = 0
    sea ssq = 1
    para v en x {
        si (v != 0) {
            sea a = absoluto(v)
            si (escala < a) {
                ssq = 1 + ssq * (escala / a) * (escala / a)
                escala = a
            } sino { ssq = ssq + (a / escala) * (a / escala) }
        }
    }
    retornar escala * raiz(ssq)
}

/// Suma de valores absolutos.
funcion blas_asum(x) {
    sea s = 0
    para v en x { s = s + absoluto(v) }
    retornar s
}

/// Índice del elemento de mayor valor absoluto.
funcion blas_iamax(x) {
    sea k = 0
    sea i = 1
    mientras (i < longitud(x)) {
        si (absoluto(x[i]) > absoluto(x[k])) { k = i }
        i = i + 1
    }
    retornar k
}

// ---------- nivel 2 y 3 ----------

/// alfa·op(A)·x + beta·y (op: traspuesta si trans). y puede ser nulo.
funcion blas_gemv(alfa, A, x, beta, y, trans) {
    sea d = _bl2_dim(A)
    sea t = trans ?? falso
    sea m = d[0]
    sea n = d[1]
    si (t) {
        m = d[1]
        n = d[0]
    }
    sea r = []
    sea i = 0
    mientras (i < m) {
        sea s = 0
        sea j = 0
        si (t) {
            mientras (j < n) {
                s = s + A[j][i] * x[j]
                j = j + 1
            }
        } sino {
            sea fila = A[i]
            mientras (j < n) {
                s = s + fila[j] * x[j]
                j = j + 1
            }
        }
        sea v = alfa * s
        si (y != nulo y beta != 0) { v = v + beta * y[i] }
        r.agregar(v)
        i = i + 1
    }
    retornar r
}

/// alfa·op(A)·op(B) + beta·C (C puede ser nula).
funcion blas_gemm(alfa, A, B, beta, C, trans_a, trans_b) {
    sea Aa = A
    sea Bb = B
    si (trans_a ?? falso) { Aa = blas_traspuesta(A) }
    si (trans_b ?? falso) { Bb = blas_traspuesta(B) }
    sea m = longitud(Aa)
    sea k = longitud(Aa[0])
    si (longitud(Bb) != k) { lanzar "blas_gemm: dimensiones incompatibles " + m + "×" + k + " y " + longitud(Bb) + "×" + longitud(Bb[0]) }
    sea n = longitud(Bb[0])
    sea r = _bl2_ceros(m, n)
    sea i = 0
    mientras (i < m) {
        sea fila_r = r[i]
        sea fila_a = Aa[i]
        sea p = 0
        // Orden i-k-j: recorre filas de B seguidas.
        mientras (p < k) {
            sea a = alfa * fila_a[p]
            si (a != 0) {
                sea fila_b = Bb[p]
                sea j = 0
                mientras (j < n) {
                    fila_r[j] = fila_r[j] + a * fila_b[j]
                    j = j + 1
                }
            }
            p = p + 1
        }
        si (C != nulo y beta != 0) {
            sea j = 0
            mientras (j < n) {
                fila_r[j] = fila_r[j] + beta * C[i][j]
                j = j + 1
            }
        }
        i = i + 1
    }
    retornar r
}

/// Producto A·B.
funcion blas_mul(A, B) { retornar blas_gemm(1, A, B, 0, nulo, falso, falso) }

// ---------- LU ----------

/// LU con pivoteo parcial (dgetrf): {"lu", "piv", "signo", "singular"}.
funcion blas_lu(A) {
    sea n = longitud(A)
    si (longitud(A[0]) != n) { lanzar "blas_lu: la matriz debe ser cuadrada" }
    sea lu = _bl2_copiar(A)
    sea piv = []
    sea signo = 1
    sea singular = falso
    sea k = 0
    mientras (k < n) {
        sea p = k
        sea i = k + 1
        mientras (i < n) {
            si (absoluto(lu[i][k]) > absoluto(lu[p][k])) { p = i }
            i = i + 1
        }
        piv.agregar(p)
        si (p != k) {
            sea tmp = lu[p]
            lu[p] = lu[k]
            lu[k] = tmp
            signo = 0 - signo
        }
        sea pivote = lu[k][k]
        si (pivote == 0) { singular = verdadero } sino {
            i = k + 1
            mientras (i < n) {
                sea f = lu[i][k] / pivote
                lu[i][k] = f
                si (f != 0) {
                    sea fila_i = lu[i]
                    sea fila_k = lu[k]
                    sea j = k + 1
                    mientras (j < n) {
                        fila_i[j] = fila_i[j] - f * fila_k[j]
                        j = j + 1
                    }
                }
                i = i + 1
            }
        }
        k = k + 1
    }
    retornar {"lu": lu, "piv": piv, "signo": signo, "singular": singular}
}

funcion _bl2_lu_resolver(f, b) {
    sea n = longitud(f["lu"])
    sea lu = f["lu"]
    sea x = []
    para v en b { x.agregar(v) }
    sea k = 0
    mientras (k < n) {
        sea p = f["piv"][k]
        si (p != k) {
            sea t = x[p]
            x[p] = x[k]
            x[k] = t
        }
        k = k + 1
    }
    sea i = 0
    mientras (i < n) {
        sea s = x[i]
        sea j = 0
        mientras (j < i) {
            s = s - lu[i][j] * x[j]
            j = j + 1
        }
        x[i] = s
        i = i + 1
    }
    i = n - 1
    mientras (i >= 0) {
        sea s = x[i]
        sea j = i + 1
        mientras (j < n) {
            s = s - lu[i][j] * x[j]
            j = j + 1
        }
        x[i] = s / lu[i][i]
        i = i - 1
    }
    retornar x
}

/// Resuelve A·x = b (b vector o matriz de columnas: lista de filas).
funcion blas_resolver(A, b) {
    sea f = blas_lu(A)
    si (f["singular"]) { lanzar "blas_resolver: la matriz es singular" }
    si (tipo(b[0]) == "lista") {
        sea bt = blas_traspuesta(b)
        sea cols = []
        para c en bt { cols.agregar(_bl2_lu_resolver(f, c)) }
        retornar blas_traspuesta(cols)
    }
    retornar _bl2_lu_resolver(f, b)
}

/// Determinante.
funcion blas_det(A) {
    sea f = blas_lu(A)
    si (f["singular"]) { retornar 0 }
    sea d = f["signo"]
    sea i = 0
    mientras (i < longitud(A)) {
        d = d * f["lu"][i][i]
        i = i + 1
    }
    retornar d
}

/// Inversa.
funcion blas_inversa(A) { retornar blas_resolver(A, blas_identidad(longitud(A))) }

// ---------- Cholesky ----------

/// Cholesky (dpotrf): L triangular inferior con A = L·Lᵀ.
funcion blas_cholesky(A) {
    sea n = longitud(A)
    sea L = _bl2_ceros(n, n)
    sea j = 0
    mientras (j < n) {
        sea s = A[j][j]
        sea k = 0
        mientras (k < j) {
            s = s - L[j][k] * L[j][k]
            k = k + 1
        }
        si (s <= 0) { lanzar "blas_cholesky: la matriz no es definida positiva" }
        L[j][j] = raiz(s)
        sea i = j + 1
        mientras (i < n) {
            sea t = A[i][j]
            k = 0
            mientras (k < j) {
                t = t - L[i][k] * L[j][k]
                k = k + 1
            }
            L[i][j] = t / L[j][j]
            i = i + 1
        }
        j = j + 1
    }
    retornar L
}

// ---------- QR y mínimos cuadrados ----------

/// QR de Householder (dgeqrf + dorgqr) de una matriz m×n con m ≥ n:
/// {"q": m×n con columnas ortonormales, "r": n×n triangular superior}.
funcion blas_qr(A) {
    sea d = _bl2_dim(A)
    sea m = d[0]
    sea n = d[1]
    si (m < n) { lanzar "blas_qr: hace falta m ≥ n" }
    sea R = _bl2_copiar(A)
    sea vs = []
    sea k = 0
    mientras (k < n) {
        sea x = []
        sea i = k
        mientras (i < m) {
            x.agregar(R[i][k])
            i = i + 1
        }
        sea alfa = blas_norma2(x)
        si (x[0] > 0) { alfa = 0 - alfa }
        sea v = []
        para e en x { v.agregar(e) }
        v[0] = v[0] - alfa
        sea nv = blas_norma2(v)
        si (nv > 0) {
            sea j = 0
            mientras (j < longitud(v)) {
                v[j] = v[j] / nv
                j = j + 1
            }
            // R = (I − 2vvᵀ) R en las filas k..m−1.
            sea c = k
            mientras (c < n) {
                sea s = 0
                i = 0
                mientras (i < longitud(v)) {
                    s = s + v[i] * R[k + i][c]
                    i = i + 1
                }
                i = 0
                mientras (i < longitud(v)) {
                    R[k + i][c] = R[k + i][c] - 2 * v[i] * s
                    i = i + 1
                }
                c = c + 1
            }
        }
        vs.agregar(v)
        k = k + 1
    }
    // Q = H0·H1·…·H(n−1) aplicado a las primeras n columnas de I.
    sea Q = _bl2_ceros(m, n)
    sea i = 0
    mientras (i < n) {
        Q[i][i] = 1
        i = i + 1
    }
    k = n - 1
    mientras (k >= 0) {
        sea v = vs[k]
        sea c = 0
        mientras (c < n) {
            sea s = 0
            i = 0
            mientras (i < longitud(v)) {
                s = s + v[i] * Q[k + i][c]
                i = i + 1
            }
            i = 0
            mientras (i < longitud(v)) {
                Q[k + i][c] = Q[k + i][c] - 2 * v[i] * s
                i = i + 1
            }
            c = c + 1
        }
        k = k - 1
    }
    sea Rn = []
    i = 0
    mientras (i < n) {
        sea f = []
        sea j = 0
        mientras (j < n) {
            si (j < i) { f.agregar(0) } sino { f.agregar(R[i][j]) }
            j = j + 1
        }
        Rn.agregar(f)
        i = i + 1
    }
    retornar {"q": Q, "r": Rn}
}

/// Mínimos cuadrados: x que minimiza |A·x − b| (A m×n, m ≥ n), con QR.
funcion blas_minimos_cuadrados(A, b) {
    sea f = blas_qr(A)
    sea qtb = blas_gemv(1, f["q"], b, 0, nulo, verdadero)
    sea R = f["r"]
    sea n = longitud(R)
    sea x = []
    sea i = 0
    mientras (i < n) {
        x.agregar(0)
        i = i + 1
    }
    i = n - 1
    mientras (i >= 0) {
        sea s = qtb[i]
        sea j = i + 1
        mientras (j < n) {
            s = s - R[i][j] * x[j]
            j = j + 1
        }
        si (R[i][i] == 0) { lanzar "blas_minimos_cuadrados: columnas dependientes" }
        x[i] = s / R[i][i]
        i = i - 1
    }
    retornar x
}

// ---------- valores propios y SVD ----------

/// Valores y vectores propios de una matriz simétrica (Jacobi cíclico):
/// {"valores" (de menor a mayor), "vectores" (columnas, como lista de filas)}.
funcion blas_propios_simetrica(A) {
    sea n = longitud(A)
    sea a = _bl2_copiar(A)
    sea V = blas_identidad(n)
    sea barrido = 0
    mientras (barrido < 100) {
        sea fuera = 0
        sea p = 0
        mientras (p < n) {
            sea q = p + 1
            mientras (q < n) {
                fuera = fuera + a[p][q] * a[p][q]
                q = q + 1
            }
            p = p + 1
        }
        si (fuera < 1e-30) { romper }
        p = 0
        mientras (p < n) {
            sea q = p + 1
            mientras (q < n) {
                si (a[p][q] != 0) {
                    sea theta = (a[q][q] - a[p][p]) / (2 * a[p][q])
                    sea t = 1 / (absoluto(theta) + raiz(theta * theta + 1))
                    si (theta < 0) { t = 0 - t }
                    sea c = 1 / raiz(t * t + 1)
                    sea s = t * c
                    sea k = 0
                    mientras (k < n) {
                        sea akp = a[k][p]
                        sea akq = a[k][q]
                        a[k][p] = c * akp - s * akq
                        a[k][q] = s * akp + c * akq
                        k = k + 1
                    }
                    k = 0
                    mientras (k < n) {
                        sea apk = a[p][k]
                        sea aqk = a[q][k]
                        a[p][k] = c * apk - s * aqk
                        a[q][k] = s * apk + c * aqk
                        k = k + 1
                    }
                    k = 0
                    mientras (k < n) {
                        sea vkp = V[k][p]
                        sea vkq = V[k][q]
                        V[k][p] = c * vkp - s * vkq
                        V[k][q] = s * vkp + c * vkq
                        k = k + 1
                    }
                }
                q = q + 1
            }
            p = p + 1
        }
        barrido = barrido + 1
    }
    // Ordena de menor a mayor.
    sea idx = []
    sea i = 0
    mientras (i < n) {
        idx.agregar(i)
        i = i + 1
    }
    i = 1
    mientras (i < n) {
        sea v = idx[i]
        sea j = i - 1
        mientras (j >= 0 y a[idx[j]][idx[j]] > a[v][v]) {
            idx[j + 1] = idx[j]
            j = j - 1
        }
        idx[j + 1] = v
        i = i + 1
    }
    sea valores = []
    sea vecs = _bl2_ceros(n, n)
    i = 0
    mientras (i < n) {
        valores.agregar(a[idx[i]][idx[i]])
        sea k = 0
        mientras (k < n) {
            vecs[k][i] = V[k][idx[i]]
            k = k + 1
        }
        i = i + 1
    }
    retornar {"valores": valores, "vectores": vecs}
}

/// SVD (Jacobi de un lado): A = U·diag(s)·Vᵀ con s de mayor a menor.
/// {"u": m×n, "s": [...], "v": n×n}.
funcion blas_svd(A) {
    sea d = _bl2_dim(A)
    sea m = d[0]
    sea n = d[1]
    si (m < n) {
        sea t = blas_svd(blas_traspuesta(A))
        retornar {"u": t["v"], "s": t["s"], "v": t["u"]}
    }
    sea U = _bl2_copiar(A)
    sea V = blas_identidad(n)
    sea barrido = 0
    mientras (barrido < 100) {
        sea rotaciones = 0
        sea p = 0
        mientras (p < n - 1) {
            sea q = p + 1
            mientras (q < n) {
                sea alfa = 0
                sea beta = 0
                sea gamma = 0
                sea i = 0
                mientras (i < m) {
                    alfa = alfa + U[i][p] * U[i][p]
                    beta = beta + U[i][q] * U[i][q]
                    gamma = gamma + U[i][p] * U[i][q]
                    i = i + 1
                }
                si (absoluto(gamma) > 1e-15 * raiz(alfa * beta) y absoluto(gamma) > 1e-300) {
                    rotaciones = rotaciones + 1
                    sea zeta = (beta - alfa) / (2 * gamma)
                    sea t = 1 / (absoluto(zeta) + raiz(1 + zeta * zeta))
                    si (zeta < 0) { t = 0 - t }
                    sea c = 1 / raiz(1 + t * t)
                    sea s = c * t
                    i = 0
                    mientras (i < m) {
                        sea up = U[i][p]
                        sea uq = U[i][q]
                        U[i][p] = c * up - s * uq
                        U[i][q] = s * up + c * uq
                        i = i + 1
                    }
                    i = 0
                    mientras (i < n) {
                        sea vp = V[i][p]
                        sea vq = V[i][q]
                        V[i][p] = c * vp - s * vq
                        V[i][q] = s * vp + c * vq
                        i = i + 1
                    }
                }
                q = q + 1
            }
            p = p + 1
        }
        si (rotaciones == 0) { romper }
        barrido = barrido + 1
    }
    // Valores singulares = normas de las columnas.
    sea s = []
    sea j = 0
    mientras (j < n) {
        sea col = []
        sea i = 0
        mientras (i < m) {
            col.agregar(U[i][j])
            i = i + 1
        }
        sea nrm = blas_norma2(col)
        s.agregar(nrm)
        si (nrm > 0) {
            i = 0
            mientras (i < m) {
                U[i][j] = U[i][j] / nrm
                i = i + 1
            }
        }
        j = j + 1
    }
    // Orden descendente.
    sea idx = []
    j = 0
    mientras (j < n) {
        idx.agregar(j)
        j = j + 1
    }
    sea i = 1
    mientras (i < n) {
        sea v = idx[i]
        sea k = i - 1
        mientras (k >= 0 y s[idx[k]] < s[v]) {
            idx[k + 1] = idx[k]
            k = k - 1
        }
        idx[k + 1] = v
        i = i + 1
    }
    sea Uo = _bl2_ceros(m, n)
    sea Vo = _bl2_ceros(n, n)
    sea so = []
    j = 0
    mientras (j < n) {
        so.agregar(s[idx[j]])
        i = 0
        mientras (i < m) {
            Uo[i][j] = U[i][idx[j]]
            i = i + 1
        }
        i = 0
        mientras (i < n) {
            Vo[i][j] = V[i][idx[j]]
            i = i + 1
        }
        j = j + 1
    }
    retornar {"u": Uo, "s": so, "v": Vo}
}

/// Rango numérico (valores singulares mayores que tol·s_max).
funcion blas_rango(A, tol) {
    sea s = blas_svd(A)["s"]
    si (longitud(s) == 0 o s[0] == 0) { retornar 0 }
    sea t = tol ?? (1e-12 * maximo(longitud(A), longitud(A[0])))
    sea r = 0
    para v en s { si (v > t * s[0]) { r = r + 1 } }
    retornar r
}

/// Número de condición (norma 2).
funcion blas_condicion(A) {
    sea s = blas_svd(A)["s"]
    sea ultimo = s[longitud(s) - 1]
    si (ultimo == 0) { retornar 1e308 * 10 }
    retornar s[0] / ultimo
}

/// Pseudoinversa de Moore-Penrose (con SVD).
funcion blas_pseudoinversa(A) {
    sea f = blas_svd(A)
    sea s = f["s"]
    sea tol = 1e-12 * s[0] * maximo(longitud(A), longitud(A[0]))
    sea U = f["u"]
    sea V = f["v"]
    sea n = longitud(s)
    // V·diag(1/s)·Uᵀ
    sea VS = _bl2_copiar(V)
    sea i = 0
    mientras (i < longitud(V)) {
        sea j = 0
        mientras (j < n) {
            si (s[j] > tol) { VS[i][j] = V[i][j] / s[j] } sino { VS[i][j] = 0 }
            j = j + 1
        }
        i = i + 1
    }
    retornar blas_gemm(1, VS, U, 0, nulo, falso, verdadero)
}
