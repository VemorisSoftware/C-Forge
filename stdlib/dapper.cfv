// stdlib/dapper.cfv — micro-ORM: nombres en inglés del módulo "ligero".
// English names for the "ligero" module; both can be used together.


importar "ligero"

funcion _dapper_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_dapper_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _dapper_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _DAPPER_RES = {"cambios": "changes", "ultimo_id": "last_id"}
sea _DAPPER_OPT = {"names": "nombres", "types": "tipos", "group": "agrupar"}

funcion dapper_prepare(sql, parametros) { retornar ligero_preparar(sql, parametros) }
funcion dapper_query(db, sql, parametros, opciones) { retornar ligero_consultar(db, sql, parametros, _dapper_opt(opciones)) }
funcion dapper_query_first(db, sql, parametros, opciones) { retornar ligero_primero(db, sql, parametros, _dapper_opt(opciones)) }
funcion dapper_query_single(db, sql, parametros, opciones) { retornar ligero_unico(db, sql, parametros, _dapper_opt(opciones)) }
funcion dapper_scalar(db, sql, parametros) { retornar ligero_escalar(db, sql, parametros) }
funcion dapper_execute(db, sql, parametros) { retornar _dapper_tr(ligero_ejecutar(db, sql, parametros), _DAPPER_RES) }
funcion dapper_execute_many(db, sql, lista_parametros) { retornar ligero_ejecutar_lote(db, sql, lista_parametros) }
funcion dapper_query_multiple(db, sql, parametros, opciones) { retornar ligero_varias(db, sql, parametros, _dapper_opt(opciones)) }
funcion dapper_query_map(db, sql, parametros, dividir, f, opciones) { retornar ligero_multi(db, sql, parametros, dividir, f, _dapper_opt(opciones)) }
funcion dapper_insert(db, tabla, objeto) { retornar ligero_insertar(db, tabla, objeto) }
funcion dapper_update(db, tabla, objeto, clave) { retornar ligero_actualizar(db, tabla, objeto, clave) }
funcion dapper_delete(db, tabla, id, clave) { retornar ligero_borrar(db, tabla, id, clave) }
funcion dapper_get(db, tabla, id, clave, opciones) { retornar ligero_obtener(db, tabla, id, clave, _dapper_opt(opciones)) }
funcion dapper_get_all(db, tabla, opciones) { retornar ligero_todos(db, tabla, _dapper_opt(opciones)) }

funcion _dapper_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_DAPPER_OPT[k] ?? k] = o[k] }
    retornar r
}
