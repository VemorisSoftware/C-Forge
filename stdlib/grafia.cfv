sea _GF_COMP = nulo
sea _GF_DESC = nulo

funcion _gf_hex(t) {
    sea d = "0123456789abcdef"
    sea v = 0
    para ch en texto_dividir(t, "") { v = v * 16 + texto_indice(d, ch) }
    retornar v
}

funcion _gf_tablas_comp() {
    si (_GF_COMP != nulo) { retornar nulo }
    _GF_COMP = {}
    _GF_DESC = {}
    para t en texto_dividir(_GF_COMP_TXT, " ") {
        sea p = texto_dividir(t, ".")
        sea a = _gf_hex(p[0])
        sea b = _gf_hex(p[1])
        sea c = _gf_hex(p[2])
        _GF_COMP[a + "," + b] = c
        _GF_DESC["" + c] = [a, b]
    }
}

// ---------- fuente ----------

/// Carga una fuente TrueType/OpenType desde sus bytes.
funcion grafia_fuente(datos) {
    sea d = datos
    sea tablas = {}
    sea n = _gf_u16(d, 4)
    sea i = 0
    mientras (i < n) {
        sea r = 12 + 16 * i
        tablas[_gf_tag(d, r)] = [_gf_u32(d, r + 8), _gf_u32(d, r + 12)]
        i = i + 1
    }
    si (tiene_clave(tablas, "cmap") == falso) { lanzar "grafia: la fuente no tiene cmap" }
    sea f = {"d": d, "t": tablas, "upem": _gf_u16(d, tablas["head"][0] + 18), "cache": {}}
    sea hhea = tablas["hhea"][0]
    f["num_hm"] = _gf_u16(d, hhea + 34)
    f["ascenso"] = _gf_s16(d, hhea + 4)
    f["descenso"] = _gf_s16(d, hhea + 6)
    f["hmtx"] = tablas["hmtx"][0]
    f["cmap"] = _gf_cmap(d, tablas["cmap"][0])
    f["gdef"] = _gf_gdef(f)
    retornar f
}

funcion _gf_cmap(d, base) {
    sea n = _gf_u16(d, base + 2)
    sea mejor = nulo
    sea prio = -1
    sea i = 0
    mientras (i < n) {
        sea pid = _gf_u16(d, base + 4 + 8 * i)
        sea eid = _gf_u16(d, base + 6 + 8 * i)
        sea off = base + _gf_u32(d, base + 8 + 8 * i)
        sea fmt = _gf_u16(d, off)
        sea p = -1
        si (fmt == 12 y ((pid == 3 y eid == 10) o pid == 0)) { p = 3 }
        sino si (fmt == 4 y ((pid == 3 y eid == 1) o pid == 0)) { p = 2 }
        si (p > prio) {
            prio = p
            mejor = off
        }
        i = i + 1
    }
    si (mejor == nulo) { lanzar "grafia: cmap sin formato 4 ni 12" }
    retornar {"off": mejor, "fmt": _gf_u16(d, mejor)}
}

/// Glifo de un punto de código (0 si la fuente no lo tiene).
funcion grafia_glifo(f, cp) {
    sea k = "c" + cp
    sea c = f["cache"]
    si (tiene_clave(c, k)) { retornar c[k] }
    sea d = f["d"]
    sea o = f["cmap"]["off"]
    sea g = 0
    si (f["cmap"]["fmt"] == 12) {
        sea n = _gf_u32(d, o + 12)
        sea a = 0
        sea b = n - 1
        mientras (a <= b) {
            sea m = piso((a + b) / 2)
            sea r = o + 16 + 12 * m
            sea ini = _gf_u32(d, r)
            sea fin = _gf_u32(d, r + 4)
            si (cp < ini) { b = m - 1 } sino si (cp > fin) { a = m + 1 } sino {
                g = _gf_u32(d, r + 8) + cp - ini
                a = b + 1
            }
        }
    } sino si (cp < 65536) {
        sea segx2 = _gf_u16(d, o + 6)
        sea ends = o + 14
        sea starts = ends + segx2 + 2
        sea deltas = starts + segx2
        sea rangos = deltas + segx2
        sea i = 0
        mientras (i < segx2 / 2) {
            sea fin = _gf_u16(d, ends + 2 * i)
            si (cp <= fin) {
                sea ini = _gf_u16(d, starts + 2 * i)
                si (cp >= ini) {
                    sea delta = _gf_u16(d, deltas + 2 * i)
                    sea ro = _gf_u16(d, rangos + 2 * i)
                    si (ro == 0) { g = (cp + delta) % 65536 } sino {
                        sea p = rangos + 2 * i + ro + 2 * (cp - ini)
                        g = _gf_u16(d, p)
                        si (g != 0) { g = (g + delta) % 65536 }
                    }
                }
                i = segx2
            }
            i = i + 1
        }
    }
    c[k] = g
    retornar g
}

/// Avance horizontal de un glifo (unidades de la fuente).
funcion grafia_avance(f, g) {
    sea i = g
    si (i >= f["num_hm"]) { i = f["num_hm"] - 1 }
    retornar _gf_u16(f["d"], f["hmtx"] + 4 * i)
}

// ---------- tablas comunes ----------

// Cobertura: mapa glifo → índice (en caché por desplazamiento).
funcion _gf_cobertura(f, o) {
    sea k = "cov" + o
    sea c = f["cache"]
    si (tiene_clave(c, k)) { retornar c[k] }
    sea d = f["d"]
    sea m = {}
    sea fmt = _gf_u16(d, o)
    sea n = _gf_u16(d, o + 2)
    sea i = 0
    si (fmt == 1) {
        mientras (i < n) {
            m["" + _gf_u16(d, o + 4 + 2 * i)] = i
            i = i + 1
        }
    } sino {
        mientras (i < n) {
            sea r = o + 4 + 6 * i
            sea ini = _gf_u16(d, r)
            sea fin = _gf_u16(d, r + 2)
            sea idx = _gf_u16(d, r + 4)
            sea g = ini
            mientras (g <= fin) {
                m["" + g] = idx + g - ini
                g = g + 1
            }
            i = i + 1
        }
    }
    c[k] = m
    retornar m
}

funcion _gf_cubre(f, o, g) { retornar _gf_cobertura(f, o)["" + g] ?? -1 }

// Definición de clases: mapa glifo → clase (0 si no está).
funcion _gf_clases(f, o) {
    sea k = "cls" + o
    sea c = f["cache"]
    si (tiene_clave(c, k)) { retornar c[k] }
    sea d = f["d"]
    sea m = {}
    sea fmt = _gf_u16(d, o)
    si (fmt == 1) {
        sea ini = _gf_u16(d, o + 2)
        sea n = _gf_u16(d, o + 4)
        sea i = 0
        mientras (i < n) {
            m["" + (ini + i)] = _gf_u16(d, o + 6 + 2 * i)
            i = i + 1
        }
    } sino {
        sea n = _gf_u16(d, o + 2)
        sea i = 0
        mientras (i < n) {
            sea r = o + 4 + 6 * i
            sea g = _gf_u16(d, r)
            sea fin = _gf_u16(d, r + 2)
            sea cl = _gf_u16(d, r + 4)
            mientras (g <= fin) {
                m["" + g] = cl
                g = g + 1
            }
            i = i + 1
        }
    }
    c[k] = m
    retornar m
}

funcion _gf_clase(f, o, g) {
    si (o == 0) { retornar 0 }
    retornar _gf_clases(f, o)["" + g] ?? 0
}

funcion _gf_gdef(f) {
    sea t = f["t"]["GDEF"] ?? nulo
    sea r = {"clases": 0, "anclaje": 0, "conjuntos": []}
    si (t == nulo) { retornar r }
    sea d = f["d"]
    sea o = t[0]
    sea gc = _gf_u16(d, o + 4)
    si (gc != 0) { r["clases"] = o + gc }
    sea mac = _gf_u16(d, o + 10)
    si (mac != 0) { r["anclaje"] = o + mac }
    si (_gf_u16(d, o + 2) >= 2) {
        sea ms = _gf_u16(d, o + 12)
        si (ms != 0) {
            sea b = o + ms
            sea n = _gf_u16(d, b + 2)
            sea i = 0
            mientras (i < n) {
                r["conjuntos"].agregar(b + _gf_u32(d, b + 4 + 4 * i))
                i = i + 1
            }
        }
    }
    retornar r
}

/// Clase GDEF de un glifo: 1 base, 2 ligadura, 3 marca, 4 componente, 0 sin clase.
funcion grafia_clase_glifo(f, g) { retornar _gf_clase(f, f["gdef"]["clases"], g) }

// ---------- búfer ----------

funcion _gf_es_marca_cp(cp) {
    retornar (cp >= 768 y cp <= 879) o (cp >= 6832 y cp <= 6911) o (cp >= 7616 y cp <= 7679) o (cp >= 8400 y cp <= 8447) o (cp >= 65056 y cp <= 65071)
}

// Clase de combinación canónica (aproximada para los diacríticos comunes).
funcion _gf_ccc(cp) {
    si (_gf_es_marca_cp(cp) == falso) { retornar 0 }
    si (cp == 795) { retornar 216 }
    si (cp == 807 o cp == 808) { retornar 202 }
    si ((cp >= 790 y cp <= 793) o (cp >= 796 y cp <= 800) o (cp >= 803 y cp <= 806) o (cp >= 809 y cp <= 819) o (cp >= 825 y cp <= 828) o cp == 839 o cp == 840 o cp == 845 o cp == 846 o cp == 851 o cp == 852 o cp == 853 o cp == 854 o cp == 857 o cp == 858) { retornar 220 }
    si (cp >= 820 y cp <= 824) { retornar 1 }
    si (cp == 837) { retornar 240 }
    retornar 230
}

// Descomposición de HarfBuzz: solo si la fuente tiene la marca y la base
// (o la base se puede descomponer a su vez). nulo si no conviene.
funcion _gf_descomponer(f, c) {
    sea dd = _GF_DESC["" + c] ?? nulo
    si (dd == nulo) { retornar nulo }
    si (grafia_glifo(f, dd[1]) == 0) { retornar nulo }
    sea r = _gf_descomponer(f, dd[0])
    si (r != nulo) { retornar r + [dd[1]] }
    si (grafia_glifo(f, dd[0]) != 0) { retornar [dd[0], dd[1]] }
    retornar nulo
}

// Descompone lo que la fuente no tiene, ordena las marcas y vuelve a
// componer cuando la fuente tiene el compuesto (como HarfBuzz).
funcion _gf_normalizar(f, cps) {
    _gf_tablas_comp()
    sea d = []
    para x en cps {
        sea partes = nulo
        si (grafia_glifo(f, x[0]) == 0) { partes = _gf_descomponer(f, x[0]) }
        si (partes == nulo) { partes = [x[0]] }
        para c en partes { d.agregar([c, x[1]]) }
    }
    // Orden canónico de las marcas (inserción estable por clase).
    sea i = 1
    mientras (i < longitud(d)) {
        sea c = _gf_ccc(d[i][0])
        si (c > 0) {
            sea j = i
            mientras (j > 0 y _gf_ccc(d[j - 1][0]) > c) {
                sea t = d[j - 1]
                d[j - 1] = d[j]
                d[j] = t
                j = j - 1
            }
        }
        i = i + 1
    }
    // Composición con bloqueo, como en NFC.
    sea r = []
    sea base = -1
    sea ultimo_ccc = 0
    para x en d {
        sea c = _gf_ccc(x[0])
        sea hecho = falso
        si (base >= 0 y c > 0 y (ultimo_ccc == 0 o ultimo_ccc < c)) {
            sea comp = _GF_COMP["" + r[base][0] + "," + x[0]] ?? nulo
            si (comp != nulo y grafia_glifo(f, comp) != 0) {
                r[base] = [comp, r[base][1]]
                hecho = verdadero
            }
        }
        si (hecho == falso) {
            si (c == 0) {
                base = longitud(r)
                ultimo_ccc = 0
            } sino { ultimo_ccc = c }
            r.agregar(x)
        }
    }
    retornar r
}

// ---------- selección de búsquedas ----------

funcion _gf_etiqueta_escritura(cps) {
    para x en cps {
        sea cp = x[0]
        si ((cp >= 880 y cp <= 1023) o (cp >= 7936 y cp <= 8191)) { retornar "grek" }
        si (cp >= 1024 y cp <= 1327) { retornar "cyrl" }
        si ((cp >= 65 y cp <= 90) o (cp >= 97 y cp <= 122) o (cp >= 192 y cp <= 591)) { retornar "latn" }
    }
    retornar "DFLT"
}

// Índices de búsquedas para los rasgos pedidos, en orden.
funcion _gf_busquedas(f, tabla, escritura, idioma, rasgos) {
    sea t = f["t"][tabla] ?? nulo
    si (t == nulo) { retornar [] }
    sea d = f["d"]
    sea o = t[0]
    sea sl = o + _gf_u16(d, o + 4)
    sea fl = o + _gf_u16(d, o + 6)
    // Escritura: la pedida, DFLT o latn.
    sea ns = _gf_u16(d, sl)
    sea elegida = -1
    para quiero en [escritura, "DFLT", "dflt", "latn"] {
        si (elegida < 0) {
            sea i = 0
            mientras (i < ns) {
                si (_gf_tag(d, sl + 2 + 6 * i) == quiero) { elegida = sl + _gf_u16(d, sl + 6 + 6 * i) }
                i = i + 1
            }
        }
    }
    si (elegida < 0) { retornar [] }
    // Sistema de idioma: el pedido o el por defecto.
    sea ls = 0
    si (idioma != nulo) {
        sea nl = _gf_u16(d, elegida + 2)
        sea i = 0
        mientras (i < nl) {
            si (texto_recortar(_gf_tag(d, elegida + 4 + 6 * i)) == texto_recortar(idioma)) { ls = elegida + _gf_u16(d, elegida + 8 + 6 * i) }
            i = i + 1
        }
    }
    si (ls == 0) {
        sea def = _gf_u16(d, elegida)
        si (def == 0) { retornar [] }
        ls = elegida + def
    }
    sea indices = []
    sea req = _gf_u16(d, ls + 2)
    si (req != 65535) { indices.agregar(req) }
    sea nf = _gf_u16(d, ls + 4)
    sea i = 0
    mientras (i < nf) {
        indices.agregar(_gf_u16(d, ls + 6 + 2 * i))
        i = i + 1
    }
    sea vistos = {}
    sea r = []
    para fi en indices {
        sea rec = fl + 2 + 6 * fi
        sea etq = _gf_tag(d, rec)
        si ((tiene_clave(rasgos, etq) y rasgos[etq] == verdadero) o (fi == req y req != 65535)) {
            sea fo = fl + _gf_u16(d, rec + 4)
            sea nlk = _gf_u16(d, fo + 2)
            sea j = 0
            mientras (j < nlk) {
                sea li = _gf_u16(d, fo + 4 + 2 * j)
                si (tiene_clave(vistos, "" + li) == falso) {
                    vistos["" + li] = verdadero
                    r.agregar(li)
                }
                j = j + 1
            }
        }
    }
    retornar ordenar(r, funcion(a, b) { retornar a - b })
}

funcion _gf_busqueda(f, tabla, idx) {
    sea k = tabla + "L" + idx
    sea c = f["cache"]
    si (tiene_clave(c, k)) { retornar c[k] }
    sea d = f["d"]
    sea o = f["t"][tabla][0]
    sea ll = o + _gf_u16(d, o + 8)
    sea lo = ll + _gf_u16(d, ll + 2 + 2 * idx)
    sea tipo_b = _gf_u16(d, lo)
    sea banderas = _gf_u16(d, lo + 2)
    sea n = _gf_u16(d, lo + 4)
    sea subs = []
    sea i = 0
    mientras (i < n) {
        sea so = lo + _gf_u16(d, lo + 6 + 2 * i)
        sea t = tipo_b
        si ((tabla == "GSUB" y tipo_b == 7) o (tabla == "GPOS" y tipo_b == 9)) {
            t = _gf_u16(d, so + 2)
            so = so + _gf_u32(d, so + 4)
        }
        subs.agregar([t, so])
        i = i + 1
    }
    sea conj = -1
    si (bits_y(banderas, 16) != 0) { conj = _gf_u16(d, lo + 6 + 2 * n) }
    sea b = {"tipo": tipo_b, "banderas": banderas, "subs": subs, "conjunto": conj}
    c[k] = b
    retornar b
}

// ¿Se salta este glifo con estas banderas?
funcion _gf_ignorar(f, b, g) {
    sea fl = b["banderas"]
    si (fl == 0) { retornar falso }
    sea cl = grafia_clase_glifo(f, g)
    si (bits_y(fl, 2) != 0 y cl == 1) { retornar verdadero }
    si (bits_y(fl, 4) != 0 y cl == 2) { retornar verdadero }
    si (bits_y(fl, 8) != 0 y cl == 3) { retornar verdadero }
    si (cl == 3) {
        si (bits_y(fl, 16) != 0 y b["conjunto"] >= 0) {
            sea cj = f["gdef"]["conjuntos"]
            si (b["conjunto"] < longitud(cj)) { retornar _gf_cubre(f, cj[b["conjunto"]], g) < 0 }
        }
        sea tipo_m = piso(fl / 256)
        si (tipo_m != 0 y _gf_clase(f, f["gdef"]["anclaje"], g) != tipo_m) { retornar verdadero }
    }
    retornar falso
}

funcion _gf_siguiente(f, b, buf, i) {
    sea j = i + 1
    mientras (j < longitud(buf) y _gf_ignorar(f, b, buf[j]["g"])) { j = j + 1 }
    retornar j
}

funcion _gf_anterior(f, b, buf, i) {
    sea j = i - 1
    mientras (j >= 0 y _gf_ignorar(f, b, buf[j]["g"])) { j = j - 1 }
    retornar j
}

// ---------- contexto ----------

// Compara una secuencia de glifos usando un predicado por posición.
// Devuelve las posiciones en el búfer o nulo.
funcion _gf_coincide_entrada(f, b, buf, i, n, pred) {
    sea pos = [i]
    sea j = i
    sea k = 1
    mientras (k < n) {
        j = _gf_siguiente(f, b, buf, j)
        si (j >= longitud(buf) o pred(k, buf[j]["g"]) == falso) { retornar nulo }
        pos.agregar(j)
        k = k + 1
    }
    retornar pos
}

funcion _gf_coincide_atras(f, b, buf, i, n, pred) {
    sea j = i
    sea k = 0
    mientras (k < n) {
        j = _gf_anterior(f, b, buf, j)
        si (j < 0 o pred(k, buf[j]["g"]) == falso) { retornar falso }
        k = k + 1
    }
    retornar verdadero
}

funcion _gf_coincide_adelante(f, b, buf, ultimo, n, pred) {
    sea j = ultimo
    sea k = 0
    mientras (k < n) {
        j = _gf_siguiente(f, b, buf, j)
        si (j >= longitud(buf) o pred(k, buf[j]["g"]) == falso) { retornar falso }
        k = k + 1
    }
    retornar verdadero
}

// Aplica los registros de búsqueda anidados; devuelve el nuevo búfer.
funcion _gf_aplicar_registros(f, tabla, buf, pos, recs, profundidad) {
    sea b2 = buf
    // Las posiciones cambian si un GSUB anidado cambia el largo: se ajustan.
    sea p = pos
    para r en recs {
        sea si = r[0]
        si (si < longitud(p)) {
            sea antes = longitud(b2)
            sea res = _gf_aplicar_en(f, tabla, b2, p[si], r[1], profundidad + 1)
            b2 = res[0]
            sea delta = longitud(b2) - antes
            si (delta != 0) {
                sea np = []
                sea k = 0
                mientras (k < longitud(p)) {
                    si (k <= si) { np.agregar(p[k]) } sino { np.agregar(p[k] + delta) }
                    k = k + 1
                }
                p = np
            }
        }
    }
    retornar b2
}

funcion _gf_leer_registros(d, o, n) {
    sea r = []
    sea i = 0
    mientras (i < n) {
        r.agregar([_gf_u16(d, o + 4 * i), _gf_u16(d, o + 4 * i + 2)])
        i = i + 1
    }
    retornar r
}

// Contexto (GSUB 5 / GPOS 7) y encadenado (GSUB 6 / GPOS 8).
// Devuelve [búfer, aplicó].
funcion _gf_contexto(f, tabla, b, buf, i, so, encadenado, profundidad) {
    sea d = f["d"]
    sea fmt = _gf_u16(d, so)
    sea g = buf[i]["g"]
    si (fmt == 1) {
        sea ci = _gf_cubre(f, so + _gf_u16(d, so + 2), g)
        si (ci < 0) { retornar [buf, falso] }
        sea nsets = _gf_u16(d, so + 4)
        si (ci >= nsets) { retornar [buf, falso] }
        sea setoff = _gf_u16(d, so + 6 + 2 * ci)
        si (setoff == 0) { retornar [buf, falso] }
        sea so2 = so + setoff
        sea nr = _gf_u16(d, so2)
        sea r = 0
        mientras (r < nr) {
            sea ro = so2 + _gf_u16(d, so2 + 2 + 2 * r)
            sea res = _gf_regla(f, tabla, b, buf, i, ro, encadenado, profundidad, funcion(sec, k, gg) { retornar _gf_u16(d, sec + 2 * k) == gg }, funcion(sec, k, gg) { retornar _gf_u16(d, sec + 2 * k) == gg }, funcion(sec, k, gg) { retornar _gf_u16(d, sec + 2 * k) == gg })
            si (res != nulo) { retornar [res, verdadero] }
            r = r + 1
        }
        retornar [buf, falso]
    }
    si (fmt == 2) {
        sea ci = _gf_cubre(f, so + _gf_u16(d, so + 2), g)
        si (ci < 0) { retornar [buf, falso] }
        sea cdb = 0
        sea cdi = 0
        sea cda = 0
        sea base = so + 4
        si (encadenado) {
            cdb = so + _gf_u16(d, so + 4)
            cdi = so + _gf_u16(d, so + 6)
            cda = so + _gf_u16(d, so + 8)
            base = so + 10
        } sino { cdi = so + _gf_u16(d, so + 4)
            base = so + 6 }
        sea cl = _gf_clase(f, cdi, g)
        sea nsets = _gf_u16(d, base)
        si (cl >= nsets) { retornar [buf, falso] }
        sea setoff = _gf_u16(d, base + 2 + 2 * cl)
        si (setoff == 0) { retornar [buf, falso] }
        sea so2 = so + setoff
        sea nr = _gf_u16(d, so2)
        sea r = 0
        mientras (r < nr) {
            sea ro = so2 + _gf_u16(d, so2 + 2 + 2 * r)
            sea res = _gf_regla(f, tabla, b, buf, i, ro, encadenado, profundidad, funcion(sec, k, gg) { retornar _gf_clase(f, cdb, gg) == _gf_u16(d, sec + 2 * k) }, funcion(sec, k, gg) { retornar _gf_clase(f, cdi, gg) == _gf_u16(d, sec + 2 * k) }, funcion(sec, k, gg) { retornar _gf_clase(f, cda, gg) == _gf_u16(d, sec + 2 * k) })
            si (res != nulo) { retornar [res, verdadero] }
            r = r + 1
        }
        retornar [buf, falso]
    }
    si (fmt == 3) {
        sea p = so + 2
        sea nb = 0
        sea bo = 0
        si (encadenado) {
            nb = _gf_u16(d, p)
            bo = p + 2
            p = p + 2 + 2 * nb
        }
        sea ni = 0
        sea io = 0
        sea na = 0
        sea ao = 0
        sea nl = 0
        sea lo = 0
        si (encadenado) {
            ni = _gf_u16(d, p)
            io = p + 2
            p = p + 2 + 2 * ni
            na = _gf_u16(d, p)
            ao = p + 2
            p = p + 2 + 2 * na
            nl = _gf_u16(d, p)
            lo = p + 2
        } sino {
            ni = _gf_u16(d, p)
            nl = _gf_u16(d, p + 2)
            io = p + 4
            lo = io + 2 * ni
        }
        si (ni == 0 o _gf_cubre(f, so + _gf_u16(d, io), g) < 0) { retornar [buf, falso] }
        sea pos = _gf_coincide_entrada(f, b, buf, i, ni, funcion(k, gg) { retornar _gf_cubre(f, so + _gf_u16(d, io + 2 * k), gg) >= 0 })
        si (pos == nulo) { retornar [buf, falso] }
        si (_gf_coincide_atras(f, b, buf, i, nb, funcion(k, gg) { retornar _gf_cubre(f, so + _gf_u16(d, bo + 2 * k), gg) >= 0 }) == falso) { retornar [buf, falso] }
        si (_gf_coincide_adelante(f, b, buf, pos[longitud(pos) - 1], na, funcion(k, gg) { retornar _gf_cubre(f, so + _gf_u16(d, ao + 2 * k), gg) >= 0 }) == falso) { retornar [buf, falso] }
        retornar [_gf_aplicar_registros(f, tabla, buf, pos, _gf_leer_registros(d, lo, nl), profundidad), verdadero]
    }
    retornar [buf, falso]
}

// Una regla de los formatos 1 y 2 (con o sin encadenado).
funcion _gf_regla(f, tabla, b, buf, i, ro, encadenado, profundidad, pb, pi, pa) {
    sea d = f["d"]
    si (encadenado) {
        sea nb = _gf_u16(d, ro)
        sea bo = ro + 2
        sea p = bo + 2 * nb
        sea ni = _gf_u16(d, p)
        sea io = p + 2
        p = io + 2 * (ni - 1)
        sea na = _gf_u16(d, p)
        sea ao = p + 2
        p = ao + 2 * na
        sea nl = _gf_u16(d, p)
        sea pos = _gf_coincide_entrada(f, b, buf, i, ni, funcion(k, gg) { retornar pi(io, k - 1, gg) })
        si (pos == nulo) { retornar nulo }
        si (_gf_coincide_atras(f, b, buf, i, nb, funcion(k, gg) { retornar pb(bo, k, gg) }) == falso) { retornar nulo }
        si (_gf_coincide_adelante(f, b, buf, pos[longitud(pos) - 1], na, funcion(k, gg) { retornar pa(ao, k, gg) }) == falso) { retornar nulo }
        retornar _gf_aplicar_registros(f, tabla, buf, pos, _gf_leer_registros(d, p + 2, nl), profundidad)
    }
    sea ni = _gf_u16(d, ro)
    sea nl = _gf_u16(d, ro + 2)
    sea io = ro + 4
    sea pos = _gf_coincide_entrada(f, b, buf, i, ni, funcion(k, gg) { retornar pi(io, k - 1, gg) })
    si (pos == nulo) { retornar nulo }
    retornar _gf_aplicar_registros(f, tabla, buf, pos, _gf_leer_registros(d, io + 2 * (ni - 1), nl), profundidad)
}

// ---------- GSUB ----------

funcion _gf_copia_glifo(x, g) {
    sea r = {}
    para k en claves(x) { r[k] = x[k] }
    r["g"] = g
    retornar r
}

funcion _gf_lig_id(f) {
    f["sig_lig"] = (f["sig_lig"] ?? 0) + 1
    retornar f["sig_lig"]
}

// Aplica una búsqueda en la posición i. Devuelve [búfer, aplicó].
funcion _gf_aplicar_en(f, tabla, buf, i, idx, profundidad) {
    si (profundidad > 10 o i >= longitud(buf)) { retornar [buf, falso] }
    sea b = _gf_busqueda(f, tabla, idx)
    si (_gf_ignorar(f, b, buf[i]["g"])) { retornar [buf, falso] }
    para s en b["subs"] {
        sea r = nulo
        si (tabla == "GSUB") { r = _gf_gsub_sub(f, b, s[0], s[1], buf, i, profundidad) } sino { r = _gf_gpos_sub(f, b, s[0], s[1], buf, i, profundidad) }
        si (r[1]) { retornar r }
    }
    retornar [buf, falso]
}

funcion _gf_gsub_sub(f, b, t, so, buf, i, profundidad) {
    sea d = f["d"]
    sea x = buf[i]
    sea g = x["g"]
    si (t == 1) {
        sea fmt = _gf_u16(d, so)
        sea ci = _gf_cubre(f, so + _gf_u16(d, so + 2), g)
        si (ci < 0) { retornar [buf, falso] }
        si (fmt == 1) { x["g"] = (g + _gf_s16(d, so + 4) + 65536) % 65536 } sino { x["g"] = _gf_u16(d, so + 6 + 2 * ci) }
        retornar [buf, verdadero]
    }
    si (t == 2 o t == 3) {
        sea ci = _gf_cubre(f, so + _gf_u16(d, so + 2), g)
        si (ci < 0) { retornar [buf, falso] }
        sea seq = so + _gf_u16(d, so + 6 + 2 * ci)
        sea n = _gf_u16(d, seq)
        si (t == 3) {
            si (n > 0) { x["g"] = _gf_u16(d, seq + 2) }
            retornar [buf, verdadero]
        }
        sea nuevos = []
        sea k = 0
        mientras (k < n) {
            nuevos.agregar(_gf_copia_glifo(x, _gf_u16(d, seq + 2 + 2 * k)))
            k = k + 1
        }
        sea r = []
        k = 0
        mientras (k < longitud(buf)) {
            si (k == i) { r = r + nuevos } sino { r.agregar(buf[k]) }
            k = k + 1
        }
        retornar [r, verdadero]
    }
    si (t == 4) {
        sea ci = _gf_cubre(f, so + _gf_u16(d, so + 2), g)
        si (ci < 0) { retornar [buf, falso] }
        sea lset = so + _gf_u16(d, so + 6 + 2 * ci)
        sea nl = _gf_u16(d, lset)
        sea li = 0
        mientras (li < nl) {
            sea lo = lset + _gf_u16(d, lset + 2 + 2 * li)
            sea lig = _gf_u16(d, lo)
            sea nc = _gf_u16(d, lo + 2)
            sea pos = _gf_coincide_entrada(f, b, buf, i, nc, funcion(k, gg) { retornar _gf_u16(d, lo + 4 + 2 * (k - 1)) == gg })
            si (pos != nulo) {
                // Une: el primero pasa a ser la ligadura; los demás se quitan.
                sea quitar = {}
                sea cl = x["cluster"]
                sea k = 1
                mientras (k < longitud(pos)) {
                    quitar["" + pos[k]] = verdadero
                    si (buf[pos[k]]["cluster"] < cl) { cl = buf[pos[k]]["cluster"] }
                    k = k + 1
                }
                sea id = _gf_lig_id(f)
                x["g"] = lig
                x["lig_id"] = id
                x["lig_n"] = nc
                x["cluster"] = cl
                sea r = []
                sea comp = 0
                k = 0
                mientras (k < longitud(buf)) {
                    si (tiene_clave(quitar, "" + k)) { comp = comp + 1 } sino {
                        sea gy = buf[k]
                        // Marcas saltadas dentro de la ligadura: recuerdan su componente.
                        si (k > i y k < pos[longitud(pos) - 1]) {
                            gy["lig_id"] = id
                            gy["lig_comp"] = comp + 1
                        }
                        si (k > i y k <= pos[longitud(pos) - 1]) { gy["cluster"] = cl }
                        r.agregar(gy)
                    }
                    k = k + 1
                }
                retornar [r, verdadero]
            }
            li = li + 1
        }
        retornar [buf, falso]
    }
    si (t == 5) { retornar _gf_contexto(f, "GSUB", b, buf, i, so, falso, profundidad) }
    si (t == 6) { retornar _gf_contexto(f, "GSUB", b, buf, i, so, verdadero, profundidad) }
    si (t == 8) {
        // Sustitución encadenada en reversa (de un glifo).
        sea ci = _gf_cubre(f, so + _gf_u16(d, so + 2), g)
        si (ci < 0) { retornar [buf, falso] }
        sea nb = _gf_u16(d, so + 4)
        sea bo = so + 6
        sea p = bo + 2 * nb
        sea na = _gf_u16(d, p)
        sea ao = p + 2
        p = ao + 2 * na
        si (_gf_coincide_atras(f, b, buf, i, nb, funcion(k, gg) { retornar _gf_cubre(f, so + _gf_u16(d, bo + 2 * k), gg) >= 0 }) == falso) { retornar [buf, falso] }
        si (_gf_coincide_adelante(f, b, buf, i, na, funcion(k, gg) { retornar _gf_cubre(f, so + _gf_u16(d, ao + 2 * k), gg) >= 0 }) == falso) { retornar [buf, falso] }
        x["g"] = _gf_u16(d, p + 2 + 2 * ci)
        retornar [buf, verdadero]
    }
    retornar [buf, falso]
}

// ---------- GPOS ----------

funcion _gf_valor(d, o, fmt) {
    // [xPlacement, yPlacement, xAdvance, yAdvance] y largo en bytes.
    sea v = [0, 0, 0, 0]
    sea p = o
    sea k = 0
    mientras (k < 8) {
        si (bits_y(fmt, potencia(2, k)) != 0) {
            si (k < 4) { v[k] = _gf_s16(d, p) }
            p = p + 2
        }
        k = k + 1
    }
    retornar [v, p - o]
}

funcion _gf_sumar_valor(x, v) {
    x["dx"] = x["dx"] + v[0]
    x["dy"] = x["dy"] + v[1]
    x["ax"] = x["ax"] + v[2]
    x["ay"] = x["ay"] + v[3]
}

funcion _gf_ancla(d, o) { retornar [_gf_s16(d, o + 2), _gf_s16(d, o + 4)] }

// Marca: [clase, ancla] o nulo.
funcion _gf_marca(f, d, marcas, mi) {
    sea r = marcas + 2 + 4 * mi
    retornar [_gf_u16(d, r), _gf_ancla(d, marcas + _gf_u16(d, r + 2))]
}

funcion _gf_unir_marca(x, base_i, ancla_base, ancla_marca) {
    x["adj"] = base_i
    x["mdx"] = ancla_base[0] - ancla_marca[0]
    x["mdy"] = ancla_base[1] - ancla_marca[1]
}

funcion _gf_gpos_sub(f, b, t, so, buf, i, profundidad) {
    sea d = f["d"]
    sea x = buf[i]
    sea g = x["g"]
    si (t == 1) {
        sea fmt = _gf_u16(d, so)
        sea ci = _gf_cubre(f, so + _gf_u16(d, so + 2), g)
        si (ci < 0) { retornar [buf, falso] }
        sea vf = _gf_u16(d, so + 4)
        si (fmt == 1) { _gf_sumar_valor(x, _gf_valor(d, so + 6, vf)[0]) } sino {
            sea largo = _gf_valor(d, so + 8, vf)[1]
            _gf_sumar_valor(x, _gf_valor(d, so + 8 + largo * ci, vf)[0])
        }
        retornar [buf, verdadero]
    }
    si (t == 2) {
        sea fmt = _gf_u16(d, so)
        sea ci = _gf_cubre(f, so + _gf_u16(d, so + 2), g)
        si (ci < 0) { retornar [buf, falso] }
        sea j = _gf_siguiente(f, b, buf, i)
        si (j >= longitud(buf)) { retornar [buf, falso] }
        sea g2 = buf[j]["g"]
        sea vf1 = _gf_u16(d, so + 4)
        sea vf2 = _gf_u16(d, so + 6)
        sea l1 = _gf_valor(d, 0, vf1)[1]
        sea l2 = _gf_valor(d, 0, vf2)[1]
        si (fmt == 1) {
            sea ps = so + _gf_u16(d, so + 10 + 2 * ci)
            sea n = _gf_u16(d, ps)
            sea paso = 2 + l1 + l2
            // Búsqueda binaria por el segundo glifo.
            sea a = 0
            sea z = n - 1
            mientras (a <= z) {
                sea m = piso((a + z) / 2)
                sea r = ps + 2 + paso * m
                sea gg = _gf_u16(d, r)
                si (g2 < gg) { z = m - 1 } sino si (g2 > gg) { a = m + 1 } sino {
                    _gf_sumar_valor(x, _gf_valor(d, r + 2, vf1)[0])
                    _gf_sumar_valor(buf[j], _gf_valor(d, r + 2 + l1, vf2)[0])
                    si (l2 > 0) { f["salto"] = j + 1 } sino { f["salto"] = j }
                    retornar [buf, verdadero]
                }
            }
            retornar [buf, falso]
        }
        sea c1 = _gf_clase(f, so + _gf_u16(d, so + 8), g)
        sea c2 = _gf_clase(f, so + _gf_u16(d, so + 10), g2)
        sea n1 = _gf_u16(d, so + 12)
        sea n2 = _gf_u16(d, so + 14)
        si (c1 >= n1 o c2 >= n2) { retornar [buf, falso] }
        sea r = so + 16 + (c1 * n2 + c2) * (l1 + l2)
        _gf_sumar_valor(x, _gf_valor(d, r, vf1)[0])
        _gf_sumar_valor(buf[j], _gf_valor(d, r + l1, vf2)[0])
        si (l2 > 0) { f["salto"] = j + 1 } sino { f["salto"] = j }
        retornar [buf, verdadero]
    }
    si (t == 4 o t == 5 o t == 6) {
        sea mi = _gf_cubre(f, so + _gf_u16(d, so + 2), g)
        si (mi < 0) { retornar [buf, falso] }
        sea nclases = _gf_u16(d, so + 6)
        sea marcas = so + _gf_u16(d, so + 8)
        sea mm = _gf_marca(f, d, marcas, mi)
        // Base: el glifo anterior que no es marca (4, 5) o la marca anterior (6).
        sea j = i - 1
        si (t == 6) {
            // Como HarfBuzz: sin las banderas de ignorar (solo el filtro de marcas).
            sea b2 = {"banderas": b["banderas"] - bits_y(b["banderas"], 14), "conjunto": b["conjunto"]}
            mientras (j >= 0 y _gf_ignorar(f, b2, buf[j]["g"])) { j = j - 1 }
            si (j < 0 o grafia_clase_glifo(f, buf[j]["g"]) != 3) { retornar [buf, falso] }
        } sino {
            mientras (j >= 0 y grafia_clase_glifo(f, buf[j]["g"]) == 3) { j = j - 1 }
            si (j < 0) { retornar [buf, falso] }
        }
        sea bi = _gf_cubre(f, so + _gf_u16(d, so + 4), buf[j]["g"])
        si (bi < 0) { retornar [buf, falso] }
        sea arr = so + _gf_u16(d, so + 10)
        si (t == 5) {
            sea lat = arr + _gf_u16(d, arr + 2 + 2 * bi)
            sea ncomp = _gf_u16(d, lat)
            si (ncomp == 0) { retornar [buf, falso] }
            sea comp = ncomp - 1
            si ((x["lig_id"] ?? 0) != 0 y (x["lig_id"] ?? 0) == (buf[j]["lig_id"] ?? -1) y (x["lig_comp"] ?? 0) > 0) { comp = minimo(x["lig_comp"], ncomp) - 1 }
            sea ao = _gf_u16(d, lat + 2 + 2 * (comp * nclases + mm[0]))
            si (ao == 0) { retornar [buf, falso] }
            _gf_unir_marca(x, j, _gf_ancla(d, lat + ao), mm[1])
            retornar [buf, verdadero]
        }
        sea ao = _gf_u16(d, arr + 2 + 2 * (bi * nclases + mm[0]))
        si (ao == 0) { retornar [buf, falso] }
        _gf_unir_marca(x, j, _gf_ancla(d, arr + ao), mm[1])
        retornar [buf, verdadero]
    }
    si (t == 7) { retornar _gf_contexto(f, "GPOS", b, buf, i, so, falso, profundidad) }
    si (t == 8) { retornar _gf_contexto(f, "GPOS", b, buf, i, so, verdadero, profundidad) }
    retornar [buf, falso]
}

// ---------- kern antiguo ----------

funcion _gf_kern_antiguo(f, buf) {
    sea t = f["t"]["kern"] ?? nulo
    si (t == nulo) { retornar nulo }
    sea d = f["d"]
    sea o = t[0]
    si (_gf_u16(d, o) != 0) { retornar nulo }
    sea n = _gf_u16(d, o + 2)
    sea p = o + 4
    sea s = 0
    mientras (s < n) {
        sea largo = _gf_u16(d, p + 2)
        sea cov = _gf_u16(d, p + 4)
        si (piso(cov / 256) == 0 y (cov % 2) == 1) {
            sea np = _gf_u16(d, p + 6)
            sea k = 0
            sea pares = {}
            mientras (k < np) {
                sea r = p + 14 + 6 * k
                pares["" + _gf_u16(d, r) + "," + _gf_u16(d, r + 2)] = _gf_s16(d, r + 4)
                k = k + 1
            }
            sea i = 0
            mientras (i + 1 < longitud(buf)) {
                sea v = pares["" + buf[i]["g"] + "," + buf[i + 1]["g"]] ?? 0
                buf[i]["ax"] = buf[i]["ax"] + v
                i = i + 1
            }
        }
        p = p + largo
        s = s + 1
    }
}

// ---------- moldeo ----------

sea _GF_RASGOS_GSUB = ["rvrn", "ccmp", "locl", "rlig", "liga", "clig", "calt"]
sea _GF_RASGOS_GPOS = ["kern", "mark", "mkmk", "dist", "curs"]

/// Moldea un texto. opciones: "rasgos" ({"liga": falso, "smcp":
/// verdadero…}), "escritura" ("latn", "grek", "cyrl"…), "idioma" ("ESP "…).
/// Devuelve [{"glifo", "cluster", "avance_x", "avance_y", "desplaz_x",
/// "desplaz_y"}] en unidades de la fuente; cluster es el índice del punto de
/// código en el texto.
funcion grafia_moldear(f, texto, opciones) {
    sea op = opciones ?? {}
    sea cps = []
    sea i = 0
    para cp en texto_codigos(texto) {
        cps.agregar([cp, i])
        i = i + 1
    }
    cps = _gf_normalizar(f, cps)
    // Las marcas van en el mismo grupo (cluster) que su base.
    i = 1
    mientras (i < longitud(cps)) {
        si (_gf_es_marca_cp(cps[i][0])) { cps[i] = [cps[i][0], cps[i - 1][1]] }
        i = i + 1
    }
    sea escritura = op["escritura"] ?? _gf_etiqueta_escritura(cps)
    sea buf = []
    para x en cps {
        sea g = grafia_glifo(f, x[0])
        buf.agregar({"g": g, "cp": x[0], "cluster": x[1], "ax": grafia_avance(f, g), "ay": 0, "dx": 0, "dy": 0, "adj": -1, "mdx": 0, "mdy": 0, "lig_id": 0, "lig_comp": 0})
    }
    sea pedidos = {}
    para k en _GF_RASGOS_GSUB { pedidos[k] = verdadero }
    para k en _GF_RASGOS_GPOS { pedidos[k] = verdadero }
    para k en claves(op["rasgos"] ?? {}) { pedidos[k] = op["rasgos"][k] }
    // GSUB.
    para li en _gf_busquedas(f, "GSUB", escritura, op["idioma"] ?? nulo, pedidos) {
        sea tl = _gf_busqueda(f, "GSUB", li)["tipo"]
        si (tl == 8) {
            sea j = longitud(buf) - 1
            mientras (j >= 0) {
                buf = _gf_aplicar_en(f, "GSUB", buf, j, li, 0)[0]
                j = j - 1
            }
        } sino {
            sea j = 0
            mientras (j < longitud(buf)) {
                sea r = _gf_aplicar_en(f, "GSUB", buf, j, li, 0)
                buf = r[0]
                j = j + 1
            }
        }
    }
    // Avances por defecto con los glifos finales.
    para x en buf { x["ax"] = grafia_avance(f, x["g"]) }
    // GPOS.
    sea busq = _gf_busquedas(f, "GPOS", escritura, op["idioma"] ?? nulo, pedidos)
    si (longitud(busq) == 0 y (pedidos["kern"] ?? falso) == verdadero) { _gf_kern_antiguo(f, buf) }
    para li en busq {
        sea j = 0
        mientras (j < longitud(buf)) {
            f["salto"] = -1
            _gf_aplicar_en(f, "GPOS", buf, j, li, 0)
            si (f["salto"] > j) { j = f["salto"] } sino { j = j + 1 }
        }
    }
    // Marcas con ancho cero (por GDEF) y desplazamientos de las uniones.
    para x en buf { si (grafia_clase_glifo(f, x["g"]) == 3) { x["ax"] = 0 } }
    i = 0
    mientras (i < longitud(buf)) {
        sea x = buf[i]
        si (x["adj"] >= 0) {
            sea base = buf[x["adj"]]
            x["dx"] = x["dx"] + x["mdx"] + base["dx"]
            x["dy"] = x["dy"] + x["mdy"] + base["dy"]
            sea k = x["adj"]
            mientras (k < i) {
                x["dx"] = x["dx"] - buf[k]["ax"]
                k = k + 1
            }
        }
        i = i + 1
    }
    sea r = []
    para x en buf { r.agregar({"glifo": x["g"], "cluster": x["cluster"], "avance_x": x["ax"], "avance_y": x["ay"], "desplaz_x": x["dx"], "desplaz_y": x["dy"]}) }
    retornar r
}

/// Ancho total del texto moldeado, en unidades de la fuente.
funcion grafia_ancho(f, texto, opciones) {
    sea t = 0
    para g en grafia_moldear(f, texto, opciones) { t = t + g["avance_x"] }
    retornar t
}

/// Rasgos (features) que ofrece la fuente: {"GSUB": [...], "GPOS": [...]}.
funcion grafia_rasgos(f) {
    sea r = {"GSUB": [], "GPOS": []}
    para tabla en ["GSUB", "GPOS"] {
        sea t = f["t"][tabla] ?? nulo
        si (t != nulo) {
            sea d = f["d"]
            sea fl = t[0] + _gf_u16(d, t[0] + 6)
            sea n = _gf_u16(d, fl)
            sea vistos = {}
            sea i = 0
            mientras (i < n) {
                sea e = _gf_tag(d, fl + 2 + 6 * i)
                si (tiene_clave(vistos, e) == falso) {
                    vistos[e] = verdadero
                    r[tabla].agregar(e)
                }
                i = i + 1
            }
        }
    }
    retornar r
}
