// stdlib/docconvert.cfv — conversión entre formatos de documento: nombres en inglés del módulo "conversor".
// English names for the "conversor" module; both can be used together.


importar "conversor"

funcion _docconvert_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_docconvert_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _docconvert_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _DOCCONVERT_RES = {"nivel": "level", "texto": "text", "numero": "number"}
sea _DOCCONVERT_OPT = {"document": "documento", "toc": "indice", "number_sections": "numerar", "width": "ancho", "title": "titulo", "depth": "profundidad"}

funcion docconvert_read_markdown(texto) { retornar conversor_leer_markdown(texto) }
funcion docconvert_read_text(texto) { retornar conversor_leer_texto(texto) }
funcion docconvert_read_html(h) { retornar conversor_leer_html(h) }
funcion docconvert_toc(doc, profundidad) { retornar _docconvert_tr(conversor_indice(doc, profundidad), _DOCCONVERT_RES) }
funcion docconvert_read(texto, formato) { retornar conversor_leer(texto, formato) }
funcion docconvert_write(doc, formato, opciones) { retornar conversor_escribir(doc, formato, _docconvert_opt(opciones)) }
funcion docconvert(texto, desde, hacia, opciones) { retornar conversor_convertir(texto, desde, hacia, _docconvert_opt(opciones)) }
funcion docconvert_filter(doc, fn) { retornar conversor_filtrar(doc, fn) }
funcion docconvert_plain_text(x) { retornar conversor_texto_de(x) }

funcion _docconvert_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_DOCCONVERT_OPT[k] ?? k] = o[k] }
    retornar r
}
