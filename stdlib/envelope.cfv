// stdlib/envelope.cfv — cifrado de archivos: nombres en inglés del módulo "sobre".
// English names for the "sobre" module; both can be used together.

importar "sobre"

/// {"secret", "public"}
funcion envelope_keys() {
    sea k = sobre_claves()
    retornar {"secret": k["secreta"], "public": k["publica"]}
}
funcion envelope_public_of(secreta) { retornar sobre_publica_de(secreta) }
funcion envelope_encrypt(datos, destinatarios) { retornar sobre_cifrar(datos, destinatarios) }
funcion envelope_encrypt_password(datos, contrasena, vueltas) { retornar sobre_cifrar_clave(datos, contrasena, vueltas) }
funcion envelope_decrypt(sobre, secreta) { retornar sobre_descifrar(sobre, secreta) }
funcion envelope_decrypt_password(sobre, contrasena) { retornar sobre_descifrar_clave(sobre, contrasena) }
funcion envelope_armor(sobre) { retornar sobre_armar(sobre) }
funcion envelope_dearmor(texto) { retornar sobre_desarmar(texto) }
