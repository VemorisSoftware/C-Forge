// stdlib/jit_asm.cfv — código máquina en tiempo de ejecución: nombres en inglés del módulo "jit".
// English names for the "jit" module; both can be used together.

importar "jit"

funcion jit_arg(f, i) { retornar jit_param(f, i) }
funcion jit_iconst(f, n) { retornar jit_constante(f, n) }
funcion jit_fconst(f, x) { retornar jit_real(f, x) }
funcion jit_binop(f, op, a, b) { retornar jit_op(f, op, a, b) }
funcion jit_unop(f, op, a) { retornar jit_unaria(f, op, a) }
funcion jit_icmp(f, cond, a, b) { retornar jit_comparar(f, cond, a, b) }
funcion jit_select(f, c, a, b) { retornar jit_seleccionar(f, c, a, b) }
funcion jit_to_float(f, a) { retornar jit_a_real(f, a) }
funcion jit_to_int(f, a) { retornar jit_a_entero(f, a) }
funcion jit_declare_var(f, tipo_v) { retornar jit_variable(f, tipo_v) }
funcion jit_def_var(f, var, v) { retornar jit_poner(f, var, v) }
funcion jit_use_var(f, var) { retornar jit_leer(f, var) }
funcion jit_create_block(f) { retornar jit_bloque(f) }
funcion jit_switch_to_block(f, b) { retornar jit_ir(f, b) }
funcion jit_jump(f, b) { retornar jit_saltar(f, b) }
funcion jit_brif(f, c, b_si, b_no) { retornar jit_saltar_si(f, c, b_si, b_no) }
funcion jit_return(f, v) { retornar jit_retornar(f, v) }
funcion jit_machine_code(f, arquitectura) { retornar jit_codigo(f, arquitectura) }
funcion jit_finalize(f, opciones) { retornar jit_compilar(f, opciones) }
funcion jit_call(h, args) { retornar jit_llamar(h, args) }
funcion jit_free(h) { retornar jit_liberar(h) }

sea _JA_TIPOS = {"int": "entero", "i64": "entero", "float": "real", "f64": "real"}
sea _JA_OPS = {"add": "suma", "sub": "resta", "mul": "mul", "div": "div", "rem": "resto", "and": "y", "or": "o", "xor": "xo", "shl": "izq", "ushr": "der", "sshr": "der_s",
    "neg": "neg", "not": "no", "sqrt": "raiz", "abs": "abs", "eq": "igual", "ne": "distinto", "lt": "menor", "le": "menor_igual", "gt": "mayor", "ge": "mayor_igual",
    "ult": "menor_u", "ugt": "mayor_u"}
funcion _ja_t(t) {
    si (tipo(t) == "lista") {
        sea r = []
        para x en t { r.agregar(_JA_TIPOS[x] ?? x) }
        retornar r
    }
    si (t == nulo) { retornar nulo }
    retornar _JA_TIPOS[t] ?? t
}
// New function with n params. types: "int"/"float" or a list; ret: "int"/"float".
funcion jit_function(n, types, ret) { retornar jit_funcion(n, _ja_t(types), _ja_t(ret)) }
funcion jit_op_en(f, op, a, b) { retornar jit_op(f, _JA_OPS[op] ?? op, a, b) }
funcion jit_unop_en(f, op, a) { retornar jit_unaria(f, _JA_OPS[op] ?? op, a) }
funcion jit_cmp_en(f, cond, a, b) { retornar jit_comparar(f, _JA_OPS[cond] ?? cond, a, b) }
// Compile an expression ("a * b + 3 > c ? a : b") with named params.
funcion jit_compile_expr(text, names, types) { retornar jit_expresion(text, names, _ja_t(types)) }
