// stdlib/dbus.cfv — D-Bus para Linux: nombres en inglés del módulo "bus".
// English names for the "bus" module; both can be used together.


importar "bus"

funcion _dbus_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_dbus_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _dbus_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _DBUS_OPT = {"transport": "transporte", "uid": "uid", "p2p": "p2p"}

funcion dbus_signature(f) { retornar bus_firma(f) }
funcion dbus_types(firma) { retornar bus_tipos(firma) }
funcion dbus_variant(firma, valor) { retornar bus_variante(firma, valor) }
funcion dbus_infer(v) { retornar bus_inferir(v) }
funcion dbus_marshal(firma, valores) { retornar bus_codificar(firma, valores) }
funcion dbus_unmarshal(firma, datos, le) { retornar bus_decodificar(firma, datos, le) }
funcion dbus_plain(v) { retornar bus_simple(v) }
funcion dbus_message(m) { retornar bus_mensaje(m) }
funcion dbus_message_length(cabeza) { retornar bus_largo_mensaje(cabeza) }
funcion dbus_parse_message(datos) { retornar bus_leer_mensaje(datos) }
funcion dbus_pipe() { retornar bus_tubo() }
funcion dbus_connect(direccion, opciones) { retornar bus_conectar(direccion, _dbus_opt(opciones)) }
funcion dbus_call(c, destino, ruta, interfaz, metodo, firma, args) { retornar bus_llamar(c, destino, ruta, interfaz, metodo, firma, args) }
funcion dbus_call_no_reply(c, destino, ruta, interfaz, metodo, firma, args) { retornar bus_llamar_sin_respuesta(c, destino, ruta, interfaz, metodo, firma, args) }
funcion dbus_error_text(e) { retornar bus_error_texto(e) }
funcion dbus_get_property(c, destino, ruta, interfaz, nombre) { retornar bus_propiedad(c, destino, ruta, interfaz, nombre) }
funcion dbus_get_all(c, destino, ruta, interfaz) { retornar bus_propiedades(c, destino, ruta, interfaz) }
funcion dbus_request_name(c, nombre, banderas) { retornar bus_pedir_nombre(c, nombre, banderas) }
funcion dbus_release_name(c, nombre) { retornar bus_soltar_nombre(c, nombre) }
funcion dbus_match_rule(m) { retornar bus_regla(m) }
funcion dbus_add_match(c, regla) { retornar bus_escuchar(c, regla) }
funcion dbus_emit(c, ruta, interfaz, nombre, firma, args) { retornar bus_emitir(c, ruta, interfaz, nombre, firma, args) }
funcion dbus_next_signal(c) { retornar bus_siguiente(c) }
funcion dbus_wait_signal(c, interfaz, miembro) { retornar bus_esperar_senal(c, interfaz, miembro) }
funcion dbus_process(c) { retornar bus_atender(c) }
funcion dbus_process_pending(c) { retornar bus_atender_pendientes(c) }
funcion dbus_close(c) { retornar bus_cerrar(c) }
funcion dbus_export(c, ruta, interfaz, metodos, propiedades, senales) { retornar bus_exportar(c, ruta, interfaz, metodos, propiedades, senales) }
funcion dbus_unexport(c, ruta) { retornar bus_retirar(c, ruta) }
funcion dbus_set_property(c, ruta, interfaz, nombre, valor) { retornar bus_cambiar_propiedad(c, ruta, interfaz, nombre, valor) }
funcion dbus_introspect(c, ruta) { retornar bus_introspeccion(c, ruta) }

funcion _dbus_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_DBUS_OPT[k] ?? k] = o[k] }
    retornar r
}
