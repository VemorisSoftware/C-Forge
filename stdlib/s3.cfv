// stdlib/s3.cfv — almacenamiento S3: nombres en inglés del módulo "objetos".
// English names for the "objetos" module; both can be used together.


importar "objetos"

funcion _s3_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_s3_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _s3_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _S3_RES = {"metodo": "method", "cabeceras": "headers", "cuerpo": "body", "canonica": "canonical_request", "objetos": "objects", "clave": "key", "tamano": "size", "modificado": "last_modified", "clase": "storage_class", "carpetas": "prefixes", "truncado": "truncated", "continuar": "next_token"}
sea _S3_OPT = {"endpoint": "extremo", "access_key": "clave", "secret_key": "secreto", "session_token": "token", "path_style": "estilo_ruta", "service": "servicio", "content_type": "tipo", "metadata": "metadatos", "cache_control": "cache", "public": "publico", "storage_class": "clase", "range": "rango", "prefix": "prefijo", "delimiter": "delimitador", "max_keys": "maximo", "continuation_token": "continuar", "now_ms": "ahora_ms", "body": "cuerpo", "headers": "cabeceras", "query": "consulta", "unsigned_payload": "sin_firmar_cuerpo"}

funcion s3_client(o) { retornar objetos_cliente(o) }
funcion s3_uri_encode(s, ruta) { retornar objetos_codificar(s, ruta) }
funcion s3_sign_request(c, metodo, bucket, clave, opciones) { retornar _s3_tr(objetos_firmar(c, metodo, bucket, clave, _s3_opt(opciones)), _S3_RES) }
funcion s3_presign_url(c, metodo, bucket, clave, segundos, ahora_ms, consulta_extra) { retornar objetos_url_firmada(c, metodo, bucket, clave, segundos, ahora_ms, consulta_extra) }
funcion s3_put_object(c, bucket, clave, datos, opciones) { retornar _s3_tr(objetos_subir(c, bucket, clave, datos, _s3_opt(opciones)), _S3_RES) }
funcion s3_get_object(c, bucket, clave, opciones) { retornar _s3_tr(objetos_bajar(c, bucket, clave, _s3_opt(opciones)), _S3_RES) }
funcion s3_delete_object(c, bucket, clave, ahora_ms) { retornar _s3_tr(objetos_borrar(c, bucket, clave, ahora_ms), _S3_RES) }
funcion s3_head_object(c, bucket, clave, ahora_ms) { retornar _s3_tr(objetos_info(c, bucket, clave, ahora_ms), _S3_RES) }
funcion s3_list_objects(c, bucket, opciones) { retornar _s3_tr(objetos_listar(c, bucket, _s3_opt(opciones)), _S3_RES) }
funcion s3_copy_object(c, bucket_origen, clave_origen, bucket, clave, ahora_ms) { retornar _s3_tr(objetos_copiar(c, bucket_origen, clave_origen, bucket, clave, ahora_ms), _S3_RES) }
funcion s3_parse_list(texto) { retornar _s3_tr(objetos_leer_listado(texto), _S3_RES) }
funcion s3_parse_error(texto) { retornar objetos_leer_error(texto) }

funcion _s3_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_S3_OPT[k] ?? k] = o[k] }
    retornar r
}
