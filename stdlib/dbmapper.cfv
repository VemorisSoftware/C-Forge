// stdlib/dbmapper.cfv — ORM sobre SQLite: nombres en inglés del módulo "mapeador".
// English names for the "mapeador" module; both can be used together.

importar "mapeador"

funcion _dbmapper_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_dbmapper_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _dbmapper_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _DBMAPPER_RES = {"descripcion": "description", "fecha": "date", "valor": "value", "cantidad": "count"}

funcion mapper_open(ruta) { retornar mapeador_abrir(ruta) }
funcion mapper_close(orm) { retornar mapeador_cerrar(orm) }
funcion mapper_log(orm, fn) { retornar mapeador_registro(orm, fn) }
funcion mapper_model(orm, nombre, def) { retornar mapeador_modelo(orm, nombre, def) }
funcion mapper_plan(orm) { retornar _dbmapper_tr(mapeador_plan(orm), _DBMAPPER_RES) }
funcion mapper_migrate(orm) { retornar mapeador_migrar(orm) }
funcion mapper_history(orm) { retornar _dbmapper_tr(mapeador_historial(orm), _DBMAPPER_RES) }
funcion mapper_validate(orm, nombre, datos) { retornar mapeador_validar(orm, nombre, datos) }
funcion mapper_create(orm, nombre, datos) { retornar mapeador_crear(orm, nombre, datos) }
funcion mapper_save(orm, e) { retornar mapeador_guardar(orm, e) }
funcion mapper_changes(orm, e) { retornar mapeador_cambios(orm, e) }
funcion mapper_delete(orm, e) { retornar mapeador_borrar(orm, e) }
funcion mapper_find(orm, nombre, clave) { retornar mapeador_buscar(orm, nombre, clave) }
funcion mapper_transaction(orm, fn) { retornar mapeador_transaccion(orm, fn) }
funcion mapper_query(orm, nombre) { retornar mapeador_consulta(orm, nombre) }
funcion mapper_where(q, campo, op, valor) { retornar mapeador_donde(q, campo, op, valor) }
funcion mapper_where_map(q, m) { retornar mapeador_donde_mapa(q, m) }
funcion mapper_or(q, alternativas) { retornar mapeador_o(q, alternativas) }
funcion mapper_order_by(q, campo, sentido) { retornar mapeador_ordenar(q, campo, sentido) }
funcion mapper_limit(q, n, desde) { retornar mapeador_limite(q, n, desde) }
funcion mapper_include(q, relacion) { retornar mapeador_incluir(q, relacion) }
funcion mapper_sql(q) { retornar mapeador_sql(q) }
funcion mapper_all(q) { retornar mapeador_lista(q) }
funcion mapper_first(q) { retornar mapeador_primero(q) }
funcion mapper_count(q) { retornar mapeador_contar(q) }
funcion mapper_exists(q) { retornar mapeador_existe(q) }
funcion mapper_aggregate(q, funcion_ag, campo) { retornar mapeador_agregado(q, funcion_ag, campo) }
funcion mapper_group_count(q, campo) { retornar _dbmapper_tr(mapeador_agrupar(q, campo), _DBMAPPER_RES) }
funcion mapper_update_where(q, datos) { retornar mapeador_actualizar_donde(q, datos) }
funcion mapper_delete_where(q) { retornar mapeador_borrar_donde(q) }
funcion mapper_load(orm, e, rel) { retornar mapeador_cargar(orm, e, rel) }
funcion mapper_data(orm, e) { retornar mapeador_datos(orm, e) }
