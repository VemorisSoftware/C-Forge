// stdlib/avalonia.cfv — Apps de escritorio con XAML (estilo Avalonia): nombres en inglés del módulo "escritorio".
// English names for the "escritorio" module; both can be used together.

importar "escritorio"

funcion avalonia_color(v) { retornar escritorio_color(v) }
funcion avalonia_window(xaml, modelo) { retornar escritorio_ventana(xaml, modelo) }
funcion avalonia_simulate(v) { retornar escritorio_simular(v) }
funcion avalonia_refresh(v) { retornar escritorio_refrescar(v) }
funcion avalonia_model(v) { retornar escritorio_modelo(v) }
funcion avalonia_click(v, x, y) { retornar escritorio_clic(v, x, y) }
funcion avalonia_click_on(v, texto_o_nombre) { retornar escritorio_clic_en(v, texto_o_nombre) }
funcion avalonia_find(v, texto_o_nombre) { retornar escritorio_buscar(v, texto_o_nombre) }
funcion avalonia_type_text(v, texto) { retornar escritorio_escribir(v, texto) }
funcion avalonia_key(v, tecla, mayus) { retornar escritorio_tecla(v, tecla, mayus) }
funcion avalonia_mouse_move(v, x, y) { retornar escritorio_mover(v, x, y) }
funcion avalonia_mouse_down(v, x, y) { retornar escritorio_presionar(v, x, y) }
funcion avalonia_mouse_up(v, x, y) { retornar escritorio_soltar(v, x, y) }
funcion avalonia_wheel(v, delta) { retornar escritorio_rueda(v, delta) }
funcion avalonia_draw(v, lienzo) { retornar escritorio_dibujar(v, lienzo) }
funcion avalonia_run(v) { retornar escritorio_ejecutar(v) }
