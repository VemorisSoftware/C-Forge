// stdlib/httpclient.cfv — cliente HTTP con interceptores: nombres en inglés del módulo "cartero".
// English names for the "cartero" module; both can be used together.


importar "cartero"

funcion _httpclient_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_httpclient_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _httpclient_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _HTTPCLIENT_RES = {"estado": "status", "cabeceras": "headers", "datos": "data", "peticion": "request"}
sea _HTTPCLIENT_OPT = {"base_url": "base", "baseURL": "base", "headers": "cabeceras", "params": "parametros", "params_style": "estilo_parametros", "timeout": "tiempo", "retries": "reintentos", "retry_delay": "espera", "retry_on": "reintentar_en", "validate_status": "validar_estado", "response_type": "tipo_respuesta", "adapter": "adaptador", "auth": "auth", "token": "token", "transform_request": "transformar_peticion", "transform_response": "transformar_respuesta", "sleep": "dormir", "method": "metodo", "data": "datos", "cancel": "cancelar", "retry_all": "reintentar_todo"}

funcion httpclient_params(p, estilo) { retornar cartero_parametros(p, estilo) }
funcion httpclient_join_url(base, ruta) { retornar cartero_unir_url(base, ruta) }
funcion httpclient_create(opciones) { retornar cartero_crear(_httpclient_opt(opciones)) }
funcion httpclient_extend(inst, opciones) { retornar cartero_extender(inst, _httpclient_opt(opciones)) }
funcion httpclient_request_interceptor(inst, ok, error) { retornar cartero_interceptor_peticion(inst, ok, error) }
funcion httpclient_response_interceptor(inst, ok, error) { retornar cartero_interceptor_respuesta(inst, ok, error) }
funcion httpclient_eject(inst, id) { retornar cartero_quitar_interceptor(inst, id) }
funcion httpclient_cancel_token() { retornar cartero_ficha() }
funcion httpclient_cancel(ficha, motivo) { retornar cartero_cancelar(ficha, motivo) }
funcion httpclient_is_cancel(e) { retornar cartero_es_cancelacion(e) }
funcion httpclient_error_message(e) { retornar cartero_mensaje(e) }
funcion httpclient_request(inst, opciones) { retornar _httpclient_tr(cartero_pedir(inst, _httpclient_opt(opciones)), _HTTPCLIENT_RES) }
funcion httpclient_retry_request(inst, peticion) { retornar _httpclient_tr(cartero_repetir(inst, peticion), _HTTPCLIENT_RES) }
funcion httpclient_get(inst, url, opciones) { retornar _httpclient_tr(cartero_get(inst, url, _httpclient_opt(opciones)), _HTTPCLIENT_RES) }
funcion httpclient_delete(inst, url, opciones) { retornar _httpclient_tr(cartero_borrar(inst, url, _httpclient_opt(opciones)), _HTTPCLIENT_RES) }
funcion httpclient_head(inst, url, opciones) { retornar _httpclient_tr(cartero_head(inst, url, _httpclient_opt(opciones)), _HTTPCLIENT_RES) }
funcion httpclient_post(inst, url, datos, opciones) { retornar _httpclient_tr(cartero_post(inst, url, datos, _httpclient_opt(opciones)), _HTTPCLIENT_RES) }
funcion httpclient_put(inst, url, datos, opciones) { retornar _httpclient_tr(cartero_put(inst, url, datos, _httpclient_opt(opciones)), _HTTPCLIENT_RES) }
funcion httpclient_patch(inst, url, datos, opciones) { retornar _httpclient_tr(cartero_patch(inst, url, datos, _httpclient_opt(opciones)), _HTTPCLIENT_RES) }
funcion httpclient_all(inst, configs, permitir_errores) { retornar _httpclient_tr(cartero_todas(inst, configs, permitir_errores), _HTTPCLIENT_RES) }
funcion httpclient_mock(rutas) { retornar cartero_simulado(rutas) }

funcion _httpclient_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_HTTPCLIENT_OPT[k] ?? k] = o[k] }
    retornar r
}
