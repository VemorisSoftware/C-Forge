// stdlib/rustls.cfv — TLS 1.3 propio: nombres en inglés del módulo "blindaje".
// English names for the "blindaje" module; both can be used together.

importar "blindaje"

funcion _rustls_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_rustls_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _rustls_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _RUSTLS_RES = {"privada": "private", "publica": "public", "semilla": "seed", "tipo": "type", "curva": "curve"}

funcion rustls_hkdf_expand_label(alg, secreto, etiqueta, contexto, largo) { retornar blindaje_expandir_etiqueta(alg, secreto, etiqueta, contexto, largo) }
funcion rustls_pem_blocks(texto, tipo_bloque) { retornar blindaje_pem(texto, tipo_bloque) }
funcion rustls_name_matches(cert, nombre) { retornar blindaje_nombre_valido(cert, nombre) }
funcion rustls_verify_chain(cadena, raices, nombre, ahora) { retornar blindaje_verificar_cadena(cadena, raices, nombre, ahora) }
funcion rustls_take_output(c) { retornar blindaje_salida(c) }
funcion rustls_read(c) { retornar blindaje_leer(c) }
funcion rustls_is_ready(c) { retornar blindaje_listo(c) }
funcion rustls_write(c, datos) { retornar blindaje_escribir(c, datos) }
funcion rustls_send_close_notify(c) { retornar blindaje_aviso_cierre(c) }
funcion rustls_key_update(c, solicitar) { retornar blindaje_renovar_claves(c, solicitar) }
funcion rustls_feed(c, datos) { retornar blindaje_entrada(c, datos) }
funcion rustls_quic_receive(c, nivel, datos) { retornar blindaje_quic_recibir(c, nivel, datos) }
funcion rustls_quic_output(c, nivel) { retornar blindaje_quic_salida(c, nivel) }
funcion rustls_export_keying_material(c, etiqueta, contexto, largo) { retornar blindaje_exportar(c, etiqueta, contexto, largo) }
funcion rustls_key_pem(clave) { retornar blindaje_clave_pem(clave) }
funcion rustls_listen(puerto) { retornar blindaje_escuchar(puerto) }
funcion rustls_send(c, datos) { retornar blindaje_enviar(c, datos) }
funcion rustls_receive(c) { retornar blindaje_recibir(c) }
funcion rustls_receive_all(c) { retornar blindaje_recibir_todo(c) }
funcion rustls_close(c) { retornar blindaje_cerrar(c) }

sea _RUSTLS_OP = {"roots": "raices", "verify": "verificar", "alpn": "alpn", "suites": "suites", "groups": "grupos", "quic": "quic", "quic_params": "quic_parametros",
    "now": "ahora", "chain": "cadena", "key": "clave", "sni": "sni", "key_pair": "clave", "issuer": "emisor", "certificate": "certificado", "days": "dias", "ca": "ca"}
funcion _rustls_op(o) {
    si (o == nulo) { retornar nulo }
    sea r = {}
    para k en claves(o) {
        sea v = o[k]
        si (k == "issuer" y tipo(v) == "mapa") { v = _rustls_op(v) }
        r[_RUSTLS_OP[k] ?? k] = v
    }
    retornar r
}
funcion _rustls_cert(c) {
    retornar {"der": c["der"], "subject": c["sujeto"], "issuer": c["emisor"], "serial": c["serie"], "not_before": c["desde"], "not_after": c["hasta"],
        "names": c["nombres"], "ips": c["ips"], "is_ca": c["ca"], "signature_algorithm": c["alg_firma"], "public_key": c["clave"]}
}
// Client connection without I/O. options: "roots" (PEM), "verify", "alpn", "suites", "groups", "quic", "quic_params", "now".
funcion rustls_client(server_name, options) { retornar blindaje_cliente(server_name, _rustls_op(options)) }
// Server connection without I/O. options: "chain" (DER list), "key", "alpn", "suites", "groups", "quic", "quic_params".
funcion rustls_server(options) { retornar blindaje_servidor(_rustls_op(options)) }
// Connect over TCP and handshake.
funcion rustls_connect(host, port, options) { retornar blindaje_conectar(host, port, _rustls_op(options)) }
// Accept a TCP connection and handshake as a server.
funcion rustls_accept(listener, options) { retornar blindaje_aceptar(listener, _rustls_op(options)) }
// Parse an X.509 certificate (DER).
funcion rustls_certificate(der) { retornar _rustls_cert(blindaje_certificado(der)) }
// Trust roots from a PEM (or the system store when nulo).
funcion rustls_roots(pem) { retornar blindaje_raices(pem) }
// Keys keep the Spanish fields (used internally) and add English ones.
funcion _rustls_clave(k) {
    sea r = {}
    para x en claves(k) { r[x] = k[x] }
    r["type"] = k["tipo"]
    si (tiene_clave(k, "semilla")) { r["seed"] = k["semilla"] }
    si (tiene_clave(k, "privada")) { r["private"] = k["privada"] }
    si (tiene_clave(k, "curva")) { r["curve"] = k["curva"] }
    r["public"] = k["publica"]
    retornar r
}
// New server key: "ed25519" (default), "P-256" or "P-384".
funcion rustls_new_key(kind) { retornar _rustls_clave(blindaje_clave_nueva(kind)) }
// Read a private key PEM (PKCS#8 Ed25519/EC or SEC1).
funcion rustls_read_key(pem) { retornar _rustls_clave(blindaje_leer_clave(pem)) }
// Issue a certificate. options: "key", "issuer" ({"certificate", "key"}), "ca", "days".
// Returns {"der", "pem", "key", "key_pem"}.
funcion rustls_issue(names, options) {
    sea r = blindaje_emitir(names, _rustls_op(options))
    retornar {"der": r["der"], "pem": r["pem"], "key": _rustls_clave(r["clave"]), "key_pem": r["clave_pem"]}
}
// Connection summary: version, suite, group, alpn, sni, scheme, certificates, retry, state.
funcion rustls_info(c) {
    sea i = blindaje_info(c)
    sea certs = []
    para x en i["certificados"] { certs.agregar(_rustls_cert(x)) }
    retornar {"version": i["version"], "suite": i["suite"], "group": i["grupo"], "alpn": i["alpn"], "sni": i["sni"], "scheme": i["esquema"], "certificates": certs, "retry": i["reintento"], "state": i["estado"]}
}
// QUIC secrets per level {"handshake"/"aplicacion": {"cliente", "servidor"}} renamed to English.
funcion rustls_quic_secrets(c) {
    sea s = blindaje_quic_secretos(c)
    sea r = {"hash": s["hash"] ?? nulo}
    si (tiene_clave(s, "handshake")) { r["handshake"] = {"client": s["handshake"]["cliente"], "server": s["handshake"]["servidor"]} }
    si (tiene_clave(s, "aplicacion")) { r["application"] = {"client": s["aplicacion"]["cliente"], "server": s["aplicacion"]["servidor"]} }
    retornar r
}
