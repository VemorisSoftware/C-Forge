// stdlib/texcompress.cfv — compresión de texturas: nombres en inglés del módulo "textura".
// English names for the "textura" module; both can be used together.

importar "textura"

funcion _texcompress_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_texcompress_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _texcompress_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _TEXCOMPRESS_RES = {"formato": "format", "ancho": "width", "alto": "height", "niveles": "levels"}

funcion texture_compress(img, formato) { retornar textura_comprimir(img, formato) }
funcion texture_decompress(datos, formato, ancho, alto, desde) { retornar textura_descomprimir(datos, formato, ancho, alto, desde) }
funcion texture_downsample(img) { retornar textura_reducir(img) }
funcion texture_mipmaps(img) { retornar textura_mipmaps(img) }
funcion texture_psnr(a, b, con_alfa) { retornar textura_psnr(a, b, con_alfa) }
funcion texture_dds(img, formato, mips) { retornar textura_dds(img, formato, mips) }
funcion texture_dds_read(datos) { retornar _texcompress_tr(textura_dds_leer(datos), _TEXCOMPRESS_RES) }
funcion texture_ktx(img, formato, mips) { retornar textura_ktx(img, formato, mips) }
funcion texture_ktx_read(datos) { retornar _texcompress_tr(textura_ktx_leer(datos), _TEXCOMPRESS_RES) }
