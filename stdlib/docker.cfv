// stdlib/docker.cfv — controlar Docker: nombres en inglés del módulo "contenedor".
// English names for the "contenedor" module; both can be used together.


importar "contenedor"

funcion _docker_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_docker_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _docker_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _DOCKER_RES = {"codigo": "exit_code", "estado": "status", "corriendo": "running", "salud": "health", "titulos": "titles", "procesos": "processes", "id": "id", "salida": "output"}
sea _DOCKER_OPT = {"image": "imagen", "cmd": "cmd", "entrypoint": "punto_entrada", "env": "env", "ports": "puertos", "volumes": "volumenes", "labels": "etiquetas", "network": "red", "aliases": "alias", "hostname": "nombre_host", "workdir": "dir_trabajo", "user": "usuario", "tty": "tty", "auto_remove": "auto_borrar", "privileged": "privilegiado", "memory": "memoria", "cpus": "cpus", "restart": "reinicio", "healthcheck": "salud", "raw": "crudo", "name": "nombre", "version": "version", "transport": "transporte", "tag": "etiqueta", "build_args": "args", "no_cache": "sin_cache", "tail": "cola", "since": "desde", "timestamps": "marcas"}

funcion docker_parse_http(crudo) { retornar contenedor_respuesta_http(crudo) }
funcion docker_client(direccion, opciones) { retornar contenedor_cliente(direccion, _docker_opt(opciones)) }
funcion docker_api(c, metodo, ruta, consulta, cuerpo, tipo_cuerpo) { retornar contenedor_api(c, metodo, ruta, consulta, cuerpo, tipo_cuerpo) }
funcion docker_error_text(e) { retornar contenedor_error_texto(e) }
funcion docker_demux(b) { retornar contenedor_demultiplexar(b) }
funcion docker_mux(tramas) { retornar contenedor_multiplexar(tramas) }
funcion docker_ping(c) { retornar contenedor_ping(c) }
funcion docker_version(c) { retornar contenedor_version(c) }
funcion docker_info(c) { retornar contenedor_info(c) }
funcion docker_events(c, desde, hasta, filtros) { retornar contenedor_eventos(c, desde, hasta, filtros) }
funcion docker_images(c, filtros) { retornar contenedor_imagenes(c, filtros) }
funcion docker_image_inspect(c, nombre) { retornar contenedor_imagen(c, nombre) }
funcion docker_image_exists(c, nombre) { retornar contenedor_hay_imagen(c, nombre) }
funcion docker_pull(c, imagen) { retornar contenedor_bajar(c, imagen) }
funcion docker_build(c, archivos, opciones) { retornar contenedor_construir(c, archivos, _docker_opt(opciones)) }
funcion docker_import(c, tar, repo, etiqueta) { retornar contenedor_importar(c, tar, repo, etiqueta) }
funcion docker_tag(c, imagen, repo, etiqueta) { retornar contenedor_etiquetar(c, imagen, repo, etiqueta) }
funcion docker_image_remove(c, imagen, forzar) { retornar contenedor_borrar_imagen(c, imagen, forzar) }
funcion docker_config(oc) { retornar contenedor_config(oc) }
funcion docker_create(c, opciones) { retornar contenedor_crear(c, _docker_opt(opciones)) }
funcion docker_start(c, id) { retornar contenedor_iniciar(c, id) }
funcion docker_stop(c, id, segundos) { retornar contenedor_parar(c, id, segundos) }
funcion docker_restart(c, id, segundos) { retornar contenedor_reiniciar(c, id, segundos) }
funcion docker_kill(c, id, senal) { retornar contenedor_matar(c, id, senal) }
funcion docker_pause(c, id) { retornar contenedor_pausar(c, id) }
funcion docker_unpause(c, id) { retornar contenedor_reanudar(c, id) }
funcion docker_rename(c, id, nombre) { retornar contenedor_renombrar(c, id, nombre) }
funcion docker_remove(c, id, forzar, volumenes) { retornar contenedor_borrar(c, id, forzar, volumenes) }
funcion docker_inspect(c, id) { retornar contenedor_inspeccionar(c, id) }
funcion docker_list(c, todos, filtros) { retornar contenedor_listar(c, todos, filtros) }
funcion docker_wait(c, id) { retornar contenedor_esperar(c, id) }
funcion docker_logs(c, id, opciones) { retornar contenedor_logs(c, id, _docker_opt(opciones)) }
funcion docker_exec(c, id, cmd, opciones) { retornar _docker_tr(contenedor_ejecutar(c, id, cmd, _docker_opt(opciones)), _DOCKER_RES) }
funcion docker_top(c, id) { retornar _docker_tr(contenedor_procesos(c, id), _DOCKER_RES) }
funcion docker_stats(c, id) { retornar contenedor_estadisticas(c, id) }
funcion docker_port(c, id, puerto) { retornar contenedor_puerto(c, id, puerto) }
funcion docker_state(c, id) { retornar _docker_tr(contenedor_estado(c, id), _DOCKER_RES) }
funcion docker_copy_in(c, id, destino, archivos) { retornar contenedor_copiar_dentro(c, id, destino, archivos) }
funcion docker_copy_out(c, id, ruta) { retornar contenedor_copiar_fuera(c, id, ruta) }
funcion docker_network_create(c, nombre, etiquetas) { retornar contenedor_crear_red(c, nombre, etiquetas) }
funcion docker_network_remove(c, id) { retornar contenedor_borrar_red(c, id) }
funcion docker_networks(c, filtros) { retornar contenedor_redes(c, filtros) }
funcion docker_network_connect(c, red, id, alias) { retornar contenedor_conectar_red(c, red, id, alias) }
funcion docker_volume_create(c, nombre, etiquetas) { retornar contenedor_crear_volumen(c, nombre, etiquetas) }
funcion docker_volume_remove(c, nombre) { retornar contenedor_borrar_volumen(c, nombre) }
funcion docker_volumes(c, filtros) { retornar contenedor_volumenes(c, filtros) }
funcion docker_mock() { retornar contenedor_simulado() }

funcion _docker_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_DOCKER_OPT[k] ?? k] = o[k] }
    retornar r
}
