// stdlib/tinta.cfv — colores y estilos ANSI para la terminal.
// Inspirada en picocolors / chalk (MIT). Respeta NO_COLOR y FORCE_COLOR.
//
//   importar "tinta"
//   mostrar(tinta_verde("listo") + " " + tinta_negrita(tinta_rojo("error")))
//   mostrar(tinta_rgb(255, 128, 0, "naranjo"))
//   mostrar(tinta_quitar(texto_con_colores))      // texto plano
// En inglés: importar "ink".

sea _TINTA_ACTIVA = nulo

/// ¿Se emiten colores? NO_COLOR los apaga; FORCE_COLOR los fuerza.
funcion tinta_activa() {
    si (_TINTA_ACTIVA == nulo) {
        sea forzar = variable_entorno("FORCE_COLOR")
        sea apagar = variable_entorno("NO_COLOR")
        _TINTA_ACTIVA = (forzar != nulo y forzar != "0") o apagar == nulo o apagar == ""
    }
    retornar _TINTA_ACTIVA
}

/// Activa o desactiva los colores a mano.
funcion tinta_usar(activa) { _TINTA_ACTIVA = activa }

funcion _tinta(abre, cierra, t) {
    si (tinta_activa() == falso) { retornar "" + t }
    sea e = caracter(27) + "["
    // Anidar: si el texto ya contiene el cierre, se reabre el estilo.
    sea cuerpo = texto_reemplazar("" + t, e + cierra + "m", e + cierra + "m" + e + abre + "m")
    retornar e + abre + "m" + cuerpo + e + cierra + "m"
}

/// Estilos.
funcion tinta_negrita(t) { retornar _tinta("1", "22", t) }
funcion tinta_tenue(t) { retornar _tinta("2", "22", t) }
funcion tinta_cursiva(t) { retornar _tinta("3", "23", t) }
funcion tinta_subrayado(t) { retornar _tinta("4", "24", t) }
funcion tinta_invertido(t) { retornar _tinta("7", "27", t) }
funcion tinta_tachado(t) { retornar _tinta("9", "29", t) }

/// Colores de texto.
funcion tinta_negro(t) { retornar _tinta("30", "39", t) }
funcion tinta_rojo(t) { retornar _tinta("31", "39", t) }
funcion tinta_verde(t) { retornar _tinta("32", "39", t) }
funcion tinta_amarillo(t) { retornar _tinta("33", "39", t) }
funcion tinta_azul(t) { retornar _tinta("34", "39", t) }
funcion tinta_magenta(t) { retornar _tinta("35", "39", t) }
funcion tinta_cian(t) { retornar _tinta("36", "39", t) }
funcion tinta_blanco(t) { retornar _tinta("37", "39", t) }
funcion tinta_gris(t) { retornar _tinta("90", "39", t) }

/// Colores de fondo.
funcion tinta_fondo_rojo(t) { retornar _tinta("41", "49", t) }
funcion tinta_fondo_verde(t) { retornar _tinta("42", "49", t) }
funcion tinta_fondo_amarillo(t) { retornar _tinta("43", "49", t) }
funcion tinta_fondo_azul(t) { retornar _tinta("44", "49", t) }

funcion _tinta_canal(v) {
    sea n = piso(v)
    si (n < 0) { retornar 0 }
    si (n > 255) { retornar 255 }
    retornar n
}

/// Color verdadero (24 bits) para el texto y para el fondo.
funcion tinta_rgb(r, g, b, t) { retornar _tinta("38;2;" + _tinta_canal(r) + ";" + _tinta_canal(g) + ";" + _tinta_canal(b), "39", t) }
funcion tinta_fondo_rgb(r, g, b, t) { retornar _tinta("48;2;" + _tinta_canal(r) + ";" + _tinta_canal(g) + ";" + _tinta_canal(b), "49", t) }

/// "#ff8800" → color de texto.
funcion tinta_hex(color, t) {
    sea h = texto_reemplazar(color, "#", "")
    si (longitud(h) != 6) { lanzar "tinta_hex: se espera #rrggbb" }
    retornar tinta_rgb(bytes_leer_entero(bytes_de_hex(subcadena(h, 0, 2)), 0, 1, 0), bytes_leer_entero(bytes_de_hex(subcadena(h, 2, 4)), 0, 1, 0), bytes_leer_entero(bytes_de_hex(subcadena(h, 4, 6)), 0, 1, 0), t)
}

/// Quita todas las secuencias ANSI (para medir o guardar en archivos).
funcion tinta_quitar(t) {
    sea s = "" + t
    sea partes = []
    sea esc = caracter(27)
    sea i = 0
    sea n = longitud(s)
    mientras (i < n) {
        sea c = subcadena(s, i, i + 1)
        si (c == esc y i + 1 < n y subcadena(s, i + 1, i + 2) == "[") {
            sea j = i + 2
            mientras (j < n y texto_indice("0123456789;", subcadena(s, j, j + 1)) >= 0) { j = j + 1 }
            i = j + 1
        } sino {
            partes.agregar(c)
            i = i + 1
        }
    }
    retornar unir(partes, "")
}

/// Largo visible (sin las secuencias ANSI).
funcion tinta_largo(t) { retornar longitud(tinta_quitar(t)) }
