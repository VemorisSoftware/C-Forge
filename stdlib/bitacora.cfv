// stdlib/bitacora.cfv — registro de eventos por niveles, en texto o JSON
// (logs estructurados consultables como datos). Inspirada en Serilog y
// SLF4J (Apache/MIT). En inglés: importar "logger".
//
//   importar "bitacora"
//   sea b = bitacora_nueva("info", "texto")           // o "json"
//   bitacora_info(b, "pedido creado", {"id": 42, "total": 9990})
//   bitacora_error(b, "falló el pago", {"codigo": "rechazado"})
//
// Niveles: depuracion < info < aviso < error. Destino por defecto: la
// pantalla; con bitacora_a_lista(b) se acumulan en b["registros"].
// Los campos se escapan: un mensaje con saltos de línea no inyecta líneas.

sea _BIT_NIVELES = {"depuracion": 10, "info": 20, "aviso": 30, "error": 40, "debug": 10, "warn": 30}

funcion bitacora_nueva(nivel, formato) {
    sea n = nivel ?? "info"
    si (tiene_clave(_BIT_NIVELES, n) == falso) { lanzar "bitacora: nivel desconocido " + n }
    sea f = formato ?? "texto"
    si (f == "text") { f = "texto" }
    si (f != "texto" y f != "json") { lanzar "bitacora: formato \"texto\" o \"json\"" }
    retornar {"nivel": _BIT_NIVELES[n], "formato": f, "contexto": {}, "registros": nulo, "idioma": "es"}
}

/// Guarda las líneas en b["registros"] en vez de mostrarlas (pruebas).
funcion bitacora_a_lista(b) {
    b["registros"] = []
    retornar b
}

/// Bitácora hija con campos fijos (p. ej. {"peticion": id}).
funcion bitacora_con(b, campos) {
    sea c = {}
    para k en claves(b["contexto"]) { c[k] = b["contexto"][k] }
    para k en claves(campos) { c[k] = campos[k] }
    retornar {"nivel": b["nivel"], "formato": b["formato"], "contexto": c, "registros": b["registros"], "idioma": b["idioma"]}
}

funcion _bit_plano(v) {
    sea t = "" + v
    t = texto_reemplazar(t, "\\", "\\\\")
    t = texto_reemplazar(t, "\n", "\\n")
    t = texto_reemplazar(t, "\r", "\\r")
    si (texto_indice(t, " ") >= 0 o texto_indice(t, "=") >= 0 o texto_indice(t, "\"") >= 0) { retornar "\"" + texto_reemplazar(t, "\"", "\\\"") + "\"" }
    retornar t
}

funcion _bit_escribir(b, nivel, nombre, mensaje, campos) {
    si (_BIT_NIVELES[nivel] < b["nivel"]) { retornar nulo }
    sea todos = {}
    para k en claves(b["contexto"]) { todos[k] = b["contexto"][k] }
    si (campos != nulo) { para k en claves(campos) { todos[k] = campos[k] } }
    si (b["idioma"] == "en") { nombre = {"depuracion": "debug", "info": "info", "aviso": "warn", "error": "error"}[nombre] }
    sea linea = ""
    si (b["formato"] == "json") {
        sea m = {"ts": cfv_fecha_ahora_ms(), "nivel": nombre, "mensaje": "" + mensaje}
        si (b["idioma"] == "en") { m = {"ts": m["ts"], "level": nombre, "message": m["mensaje"]} }
        para k en claves(todos) { m[k] = todos[k] }
        linea = json_texto(m)
    } sino {
        sea partes = [texto_mayusculas(nombre), _bit_plano(mensaje)]
        para k en claves(todos) { partes.agregar(k + "=" + _bit_plano(todos[k])) }
        linea = unir(partes, " ")
    }
    si (b["registros"] != nulo) { b["registros"].agregar(linea) } sino { mostrar(linea) }
    retornar nulo
}

funcion bitacora_depuracion(b, mensaje, campos) { _bit_escribir(b, "depuracion", "depuracion", mensaje, campos) }
funcion bitacora_info(b, mensaje, campos) { _bit_escribir(b, "info", "info", mensaje, campos) }
funcion bitacora_aviso(b, mensaje, campos) { _bit_escribir(b, "aviso", "aviso", mensaje, campos) }
funcion bitacora_error(b, mensaje, campos) { _bit_escribir(b, "error", "error", mensaje, campos) }
