// ---------- envío ----------

funcion _vz_ack(e) {
    sea l = []
    para x en e["recibidos"] { l.agregar(x) }
    l = ordenar(l)
    // De mayor a menor en rangos.
    sea rangos = []
    sea i = longitud(l) - 1
    mientras (i >= 0) {
        sea hi = l[i]
        sea lo = hi
        mientras (i > 0 y l[i - 1] == lo - 1) {
            lo = lo - 1
            i = i - 1
        }
        rangos.agregar([lo, hi])
        i = i - 1
    }
    sea n = minimo(longitud(rangos), 32)
    sea r = veloz_varint(2) + veloz_varint(rangos[0][1]) + veloz_varint(0) + veloz_varint(n - 1) + veloz_varint(rangos[0][1] - rangos[0][0])
    sea k = 1
    mientras (k < n) {
        r = r + veloz_varint(rangos[k - 1][0] - rangos[k][1] - 2) + veloz_varint(rangos[k][1] - rangos[k][0])
        k = k + 1
    }
    retornar r
}

funcion _vz_marco_bytes(fr) {
    si (fr["t"] == "crypto") { retornar veloz_varint(6) + veloz_varint(fr["off"]) + veloz_varint(longitud(fr["datos"])) + fr["datos"] }
    si (fr["t"] == "flujo") {
        sea tipo_m = 8 + 4 + 2
        si (fr["fin"]) { tipo_m = tipo_m + 1 }
        retornar veloz_varint(tipo_m) + veloz_varint(fr["id"]) + veloz_varint(fr["off"]) + veloz_varint(longitud(fr["datos"])) + fr["datos"]
    }
    si (fr["t"] == "hd") { retornar veloz_varint(30) }
    si (fr["t"] == "ping") { retornar veloz_varint(1) }
    si (fr["t"] == "path_resp") { retornar veloz_varint(27) + fr["datos"] }
    retornar ""
}

// Arma la carga de un paquete de un nivel; [carga, marcos, pide_ack].
funcion _vz_carga(q, nivel, espacio_max, ahora) {
    sea e = q["espacios"][nivel]
    sea carga = ""
    sea marcos = []
    si (e["ack"] y longitud(e["recibidos"]) > 0) {
        carga = carga + _vz_ack(e)
        e["ack"] = falso
    }
    // Retransmisiones.
    mientras (longitud(e["repetir"]) > 0 y longitud(carga) < espacio_max - 40) {
        sea fr = e["repetir"][0]
        sea b = _vz_marco_bytes(fr)
        si (longitud(carga) + longitud(b) > espacio_max y longitud(carga) > 0) { romper }
        carga = carga + b
        marcos.agregar(fr)
        sea resto = []
        sea i = 1
        mientras (i < longitud(e["repetir"])) {
            resto.agregar(e["repetir"][i])
            i = i + 1
        }
        e["repetir"] = resto
    }
    // CRYPTO nuevo.
    mientras (longitud(e["crypto"]) > 0 y longitud(carga) < espacio_max - 40) {
        sea cabe = espacio_max - longitud(carga) - 16
        sea trozo = subtexto(e["crypto"], 0, minimo(cabe, longitud(e["crypto"])))
        sea fr = {"t": "crypto", "off": e["crypto_off"], "datos": trozo}
        e["crypto"] = subtexto(e["crypto"], longitud(trozo), longitud(e["crypto"]))
        e["crypto_off"] = e["crypto_off"] + longitud(trozo)
        carga = carga + _vz_marco_bytes(fr)
        marcos.agregar(fr)
    }
    si (nivel == "aplicacion" y q["estado"] == "conectado") {
        si (q["hd_pendiente"]) {
            marcos.agregar({"t": "hd"})
            carga = carga + veloz_varint(30)
            q["hd_pendiente"] = falso
        }
        // Datos de flujos.
        para k en claves(q["flujos"]) {
            sea f = q["flujos"][k]
            mientras ((longitud(f["env"]) > 0 o (f["fin_env"] y f["fin_enviado"] == falso)) y longitud(carga) < espacio_max - 40) {
                sea cabe = espacio_max - longitud(carga) - 30
                sea limite = minimo(f["max_env"] - f["env_off"], q["max_datos_par"] - q["datos_enviados"])
                sea n = minimo(cabe, minimo(longitud(f["env"]), limite))
                si (n <= 0 y (longitud(f["env"]) > 0 o f["fin_env"] == falso)) { romper }
                sea trozo = subtexto(f["env"], 0, maximo(0, n))
                f["env"] = subtexto(f["env"], longitud(trozo), longitud(f["env"]))
                sea fin = f["fin_env"] y longitud(f["env"]) == 0
                sea fr = {"t": "flujo", "id": f["id"], "off": f["env_off"], "datos": trozo, "fin": fin}
                f["env_off"] = f["env_off"] + longitud(trozo)
                q["datos_enviados"] = q["datos_enviados"] + longitud(trozo)
                si (fin) { f["fin_enviado"] = verdadero }
                carga = carga + _vz_marco_bytes(fr)
                marcos.agregar(fr)
            }
        }
    }
    retornar [carga, marcos]
}

funcion _vz_armar(q, nivel, carga, ahora, marcos) {
    sea e = q["espacios"][nivel]
    sea pn = e["sig_pn"]
    e["sig_pn"] = pn + 1
    // Relleno para que alcance la muestra de la protección de cabecera.
    mientras (longitud(carga) < 4) { carga = carga + char_de(0) }
    sea cab = ""
    sea pn_pos = 0
    si (nivel == "aplicacion") {
        cab = char_de(67) + q["dcid"]
        pn_pos = longitud(cab)
    } sino {
        sea tipo_p = 0
        si (nivel == "handshake") { tipo_p = 2 }
        cab = char_de(192 + tipo_p * 16 + 3) + bytes_entero(1, 4, 0) + char_de(longitud(q["dcid"])) + q["dcid"] + char_de(longitud(q["scid"])) + q["scid"]
        si (nivel == "inicial") { cab = cab + veloz_varint(longitud(q["token"])) + q["token"] }
        sea largo = 4 + longitud(carga) + 16
        cab = cab + char_de(64 + piso(largo / 256)) + char_de(largo % 256)
        pn_pos = longitud(cab)
    }
    cab = cab + bytes_entero(pn, 4, 0)
    sea pide = falso
    para fr en marcos { si (fr["t"] != "ack") { pide = verdadero } }
    si (pide) { e["enviados"]["" + pn] = {"t": ahora, "frames": marcos} }
    retornar veloz_proteger(e["escribir"], cab, pn, pn_pos, 4, carga)
}

funcion _vz_cierre_paquete(q, ahora) {
    sea c = q["cerrar"]
    sea nivel = "aplicacion"
    si (q["espacios"]["aplicacion"]["escribir"] == nulo o q["estado"] != "conectado") {
        nivel = "handshake"
        si (q["espacios"]["handshake"]["escribir"] == nulo) { nivel = "inicial" }
    }
    sea m = ""
    si ((c["app"] ?? falso) y nivel == "aplicacion") { m = veloz_varint(29) + veloz_varint(c["codigo"]) + veloz_varint(longitud(c["razon"])) + c["razon"] }
    sino { m = veloz_varint(28) + veloz_varint(c["codigo"]) + veloz_varint(0) + veloz_varint(longitud(c["razon"])) + c["razon"] }
    sea p = _vz_armar(q, nivel, m, ahora, [])
    si (q["rol"] == "cliente" y nivel == "inicial") {
        mientras (longitud(m) < 1100) { m = m + char_de(0) }
        p = _vz_armar(q, nivel, m, ahora, [])
    }
    retornar p
}

/// Datagramas para enviar ahora (con retransmisiones si venció el plazo).
funcion veloz_salida(q, ahora) {
    si (q["estado"] == "cerrado") { retornar [] }
    si (q["cerrar"] != nulo) {
        q["estado"] = "cerrado"
        sea r = []
        si (q["espacios"]["inicial"]["escribir"] != nulo) { r.agregar(_vz_cierre_paquete(q, ahora)) }
        retornar r
    }
    si (q["rol"] == "servidor" y tiene_clave(q, "odcid") == falso) { retornar [] }
    // Plazos vencidos: los marcos vuelven a la cola.
    para nivel en ["inicial", "handshake", "aplicacion"] {
        sea e = q["espacios"][nivel]
        para k en claves(e["enviados"]) {
            sea env = e["enviados"][k]
            si (ahora - env["t"] >= q["pto"]) {
                para fr en env["frames"] { si (fr["t"] == "crypto" o fr["t"] == "flujo" o fr["t"] == "hd") { e["repetir"].agregar(fr) } }
                quitar_clave(e["enviados"], k)
                q["pto"] = minimo(q["pto"] * 2, 4000)
            }
        }
    }
    sea datagramas = []
    sea seguir = verdadero
    mientras (seguir y longitud(datagramas) < 64) {
        seguir = falso
        sea dg = ""
        sea tiene_inicial = falso
        para nivel en ["inicial", "handshake", "aplicacion"] {
            sea e = q["espacios"][nivel]
            si (e["escribir"] != nulo y 1200 - longitud(dg) > 80 y tiene_inicial == falso) {
                sea espacio = 1200 - longitud(dg) - 60
                sea cm = _vz_carga(q, nivel, espacio, ahora)
                si (longitud(cm[0]) > 0) {
                    sea carga = cm[0]
                    // El cliente rellena (con marcos PADDING) los datagramas con Initial
                    // hasta 1200 bytes y no les agrega otros paquetes.
                    si (nivel == "inicial" y q["rol"] == "cliente") {
                        sea hl = 1 + 4 + 1 + longitud(q["dcid"]) + 1 + longitud(q["scid"]) + longitud(veloz_varint(longitud(q["token"]))) + longitud(q["token"]) + 2 + 4
                        mientras (longitud(carga) < 1200 - longitud(dg) - hl - 16) { carga = carga + char_de(0) }
                        tiene_inicial = verdadero
                    }
                    dg = dg + _vz_armar(q, nivel, carga, ahora, cm[1])
                    seguir = verdadero
                }
            }
        }
        si (longitud(dg) > 0) { datagramas.agregar(dg) }
    }
    retornar datagramas
}

/// Milisegundos hasta el próximo plazo de retransmisión (nulo si no hay).
funcion veloz_espera(q, ahora) {
    sea r = nulo
    para nivel en ["inicial", "handshake", "aplicacion"] {
        para k en claves(q["espacios"][nivel]["enviados"]) {
            sea falta = q["pto"] - (ahora - q["espacios"][nivel]["enviados"][k]["t"])
            si (r == nulo o falta < r) { r = maximo(0, falta) }
        }
    }
    retornar r
}

/// ¿Terminó el handshake?
funcion veloz_conectado(q) { retornar q["estado"] == "conectado" }

// ---------- QPACK (tabla estática, sin tabla dinámica) ----------

sea _VZ_ESTATICA = [[":authority", ""], [":path", "/"], ["age", "0"], ["content-disposition", ""], ["content-length", "0"], ["cookie", ""], ["date", ""], ["etag", ""],
    ["if-modified-since", ""], ["if-none-match", ""], ["last-modified", ""], ["link", ""], ["location", ""], ["referer", ""], ["set-cookie", ""],
    [":method", "CONNECT"], [":method", "DELETE"], [":method", "GET"], [":method", "HEAD"], [":method", "OPTIONS"], [":method", "POST"], [":method", "PUT"],
    [":scheme", "http"], [":scheme", "https"], [":status", "103"], [":status", "200"], [":status", "304"], [":status", "404"], [":status", "503"],
    ["accept", "*/*"], ["accept", "application/dns-message"], ["accept-encoding", "gzip, deflate, br"], ["accept-ranges", "bytes"],
    ["access-control-allow-headers", "cache-control"], ["access-control-allow-headers", "content-type"], ["access-control-allow-origin", "*"],
    ["cache-control", "max-age=0"], ["cache-control", "max-age=2592000"], ["cache-control", "max-age=604800"], ["cache-control", "no-cache"],
    ["cache-control", "no-store"], ["cache-control", "public, max-age=31536000"], ["content-encoding", "br"], ["content-encoding", "gzip"],
    ["content-type", "application/dns-message"], ["content-type", "application/javascript"], ["content-type", "application/json"],
    ["content-type", "application/x-www-form-urlencoded"], ["content-type", "image/gif"], ["content-type", "image/jpeg"], ["content-type", "image/png"],
    ["content-type", "text/css"], ["content-type", "text/html; charset=utf-8"], ["content-type", "text/plain"], ["content-type", "text/plain;charset=utf-8"],
    ["range", "bytes=0-"], ["strict-transport-security", "max-age=31536000"], ["strict-transport-security", "max-age=31536000; includesubdomains"],
    ["strict-transport-security", "max-age=31536000; includesubdomains; preload"], ["vary", "accept-encoding"], ["vary", "origin"],
    ["x-content-type-options", "nosniff"], ["x-xss-protection", "1; mode=block"], [":status", "100"], [":status", "204"], [":status", "206"],
    [":status", "302"], [":status", "400"], [":status", "403"], [":status", "421"], [":status", "425"], [":status", "500"], ["accept-language", ""],
    ["access-control-allow-credentials", "FALSE"], ["access-control-allow-credentials", "TRUE"], ["access-control-allow-headers", "*"],
    ["access-control-allow-methods", "get"], ["access-control-allow-methods", "get, post, options"], ["access-control-allow-methods", "options"],
    ["access-control-expose-headers", "content-length"], ["access-control-request-headers", "content-type"], ["access-control-request-method", "get"],
    ["access-control-request-method", "post"], ["alt-svc", "clear"], ["authorization", ""],
    ["content-security-policy", "script-src 'none'; object-src 'none'; base-uri 'none'"], ["early-data", "1"], ["expect-ct", ""], ["forwarded", ""],
    ["if-range", ""], ["origin", ""], ["purpose", "prefetch"], ["server", ""], ["timing-allow-origin", "*"], ["upgrade-insecure-requests", "1"],
    ["user-agent", ""], ["x-forwarded-for", ""], ["x-frame-options", "deny"], ["x-frame-options", "sameorigin"]]

funcion _vz_entero_prefijo(bits_prefijo, primer, v) {
    sea maxp = potencia(2, bits_prefijo) - 1
    si (v < maxp) { retornar char_de(primer + v) }
    sea r = char_de(primer + maxp)
    sea x = v - maxp
    mientras (x >= 128) {
        r = r + char_de(128 + x % 128)
        x = piso(x / 128)
    }
    retornar r + char_de(x)
}

// [valor, siguiente posición]
funcion _vz_leer_prefijo(d, p, bits_prefijo) {
    sea maxp = potencia(2, bits_prefijo) - 1
    sea v = byte_en(d, p) % (maxp + 1)
    sea q = p + 1
    si (v < maxp) { retornar [v, q] }
    sea m = 0
    mientras (verdadero) {
        sea b = byte_en(d, q)
        v = v + (b % 128) * potencia(2, m)
        m = m + 7
        q = q + 1
        si (b < 128) { romper }
    }
    retornar [v, q]
}

/// Codifica cabeceras (lista de [nombre, valor]) en un bloque QPACK.
funcion veloz_qpack_codificar(cabeceras) {
    sea r = char_de(0) + char_de(0)
    para c en cabeceras {
        sea nombre = texto_minusculas(c[0])
        sea valor = "" + c[1]
        sea exacto = -1
        sea solo_nombre = -1
        sea i = 0
        mientras (i < longitud(_VZ_ESTATICA)) {
            si (_VZ_ESTATICA[i][0] == nombre) {
                si (_VZ_ESTATICA[i][1] == valor y exacto < 0) { exacto = i }
                si (solo_nombre < 0) { solo_nombre = i }
            }
            i = i + 1
        }
        si (exacto >= 0) { r = r + _vz_entero_prefijo(6, 192, exacto) }
        sino si (solo_nombre >= 0) { r = r + _vz_entero_prefijo(4, 80, solo_nombre) + _vz_entero_prefijo(7, 0, longitud(valor)) + valor }
        sino { r = r + _vz_entero_prefijo(3, 32, longitud(nombre)) + nombre + _vz_entero_prefijo(7, 0, longitud(valor)) + valor }
    }
    retornar r
}

/// Decodifica un bloque QPACK (sin tabla dinámica): lista de [nombre, valor].
funcion veloz_qpack_decodificar(d) {
    sea ric = _vz_leer_prefijo(d, 0, 8)
    si (ric[0] != 0) { lanzar "veloz: QPACK con tabla dinámica no soportado" }
    sea base = _vz_leer_prefijo(d, ric[1], 7)
    sea p = base[1]
    sea r = []
    mientras (p < longitud(d)) {
        sea b = byte_en(d, p)
        si (b >= 128) {
            si (bits_y(b, 64) == 0) { lanzar "veloz: QPACK dinámico no soportado" }
            sea x = _vz_leer_prefijo(d, p, 6)
            r.agregar([_VZ_ESTATICA[x[0]][0], _VZ_ESTATICA[x[0]][1]])
            p = x[1]
        } sino si (b >= 64) {
            si (bits_y(b, 16) == 0) { lanzar "veloz: QPACK dinámico no soportado" }
            sea x = _vz_leer_prefijo(d, p, 4)
            sea v = _vz_cadena(d, x[1], 7)
            r.agregar([_VZ_ESTATICA[x[0]][0], v[0]])
            p = v[1]
        } sino si (b >= 32) {
            sea huff = bits_y(b, 8) != 0
            sea l = _vz_leer_prefijo(d, p, 3)
            sea nombre = subtexto(d, l[1], l[1] + l[0])
            si (huff) { nombre = veloz_huffman_decodificar(nombre) }
            sea v = _vz_cadena(d, l[1] + l[0], 7)
            r.agregar([nombre, v[0]])
            p = v[1]
        } sino { lanzar "veloz: QPACK dinámico no soportado" }
    }
    retornar r
}

funcion _vz_cadena(d, p, bits_prefijo) {
    sea huff = bits_y(byte_en(d, p), potencia(2, bits_prefijo)) != 0
    sea l = _vz_leer_prefijo(d, p, bits_prefijo)
    sea s = subtexto(d, l[1], l[1] + l[0])
    si (huff) { s = veloz_huffman_decodificar(s) }
    retornar [s, l[1] + l[0]]
}

sea _VZ_HUFF = {}

funcion _vz_huff_arbol() {
    si (tiene_clave(_VZ_HUFF, "nodos")) { retornar _VZ_HUFF["nodos"] }
    sea b = bytes_de_hex(_VZ_HUFF_HEX)
    sea nodos = [[0, 0]]
    sea s = 0
    mientras (s < 257) {
        sea codigo = bytes_leer_entero(b, s * 5, 4, 0)
        sea largo = byte_en(b, s * 5 + 4)
        sea nodo = 0
        sea k = largo - 1
        mientras (k >= 0) {
            sea bit = piso(codigo / potencia(2, k)) % 2
            si (k == 0) { nodos[nodo][bit] = 0 - (s + 1) } sino {
                si (nodos[nodo][bit] <= 0) {
                    nodos.agregar([0, 0])
                    nodos[nodo][bit] = longitud(nodos) - 1
                }
                nodo = nodos[nodo][bit]
            }
            k = k - 1
        }
        s = s + 1
    }
    _VZ_HUFF["nodos"] = nodos
    retornar nodos
}

/// Decodifica una cadena con el Huffman de HPACK/QPACK.
funcion veloz_huffman_decodificar(d) {
    sea nodos = _vz_huff_arbol()
    sea r = ""
    sea nodo = 0
    sea i = 0
    mientras (i < longitud(d)) {
        sea b = byte_en(d, i)
        sea k = 7
        mientras (k >= 0) {
            sea sig = nodos[nodo][piso(b / potencia(2, k)) % 2]
            si (sig < 0) {
                sea s = 0 - sig - 1
                si (s == 256) { lanzar "veloz: EOS en Huffman" }
                r = r + char_de(s)
                nodo = 0
            } sino { nodo = sig }
            k = k - 1
        }
        i = i + 1
    }
    retornar r
}

// ---------- HTTP/3 ----------

funcion _vz_h3_marco(tipo_m, datos) { retornar veloz_varint(tipo_m) + veloz_varint(longitud(datos)) + datos }

// Abre el flujo de control con SETTINGS (una vez).
funcion _vz_h3_control(q) {
    si (tiene_clave(q, "h3_control")) { retornar nulo }
    sea id = veloz_flujo_abrir(q, falso)
    q["h3_control"] = id
    veloz_flujo_escribir(q, id, veloz_varint(0) + _vz_h3_marco(4, veloz_varint(1) + veloz_varint(0) + veloz_varint(7) + veloz_varint(0)), falso)
}

// Lee marcos HTTP/3 completos de un búfer: [marcos, resto].
funcion _vz_h3_marcos(buf) {
    sea r = []
    sea p = 0
    mientras (p < longitud(buf)) {
        si (p + 2 > longitud(buf)) { romper }
        sea t = _vz_leer_varint(buf, p)
        si (t[1] >= longitud(buf)) { romper }
        sea l = _vz_leer_varint(buf, t[1])
        si (l[1] + l[0] > longitud(buf)) { romper }
        r.agregar([t[0], subtexto(buf, l[1], l[1] + l[0])])
        p = l[1] + l[0]
    }
    retornar [r, subtexto(buf, p, longitud(buf))]
}

/// Prepara una solicitud HTTP/3 en un flujo nuevo. Devuelve el flujo.
funcion veloz_h3_solicitar(q, metodo, autoridad, ruta, cabeceras, cuerpo) {
    _vz_h3_control(q)
    sea id = veloz_flujo_abrir(q, verdadero)
    sea cab = [[":method", metodo], [":scheme", "https"], [":authority", autoridad], [":path", ruta]]
    para c en cabeceras ?? [] { cab.agregar(c) }
    sea d = _vz_h3_marco(1, veloz_qpack_codificar(cab))
    si (cuerpo != nulo y longitud(cuerpo) > 0) { d = d + _vz_h3_marco(0, cuerpo) }
    veloz_flujo_escribir(q, id, d, verdadero)
    q["h3_resp"] = q["h3_resp"] ?? {}
    q["h3_resp"]["" + id] = {"buf": "", "cabeceras": nulo, "cuerpo": "", "fin": falso}
    retornar id
}

/// Respuesta de una solicitud: {"estado", "cabeceras", "cuerpo", "fin"}.
funcion veloz_h3_respuesta(q, id) {
    sea r = q["h3_resp"]["" + id]
    sea l = veloz_flujo_leer(q, id)
    r["buf"] = r["buf"] + l["datos"]
    sea m = _vz_h3_marcos(r["buf"])
    r["buf"] = m[1]
    para fr en m[0] {
        si (fr[0] == 1) { r["cabeceras"] = veloz_qpack_decodificar(fr[1]) }
        si (fr[0] == 0) { r["cuerpo"] = r["cuerpo"] + fr[1] }
    }
    si (l["fin"]) { r["fin"] = verdadero }
    sea estado = nulo
    sea mapa = {}
    para c en r["cabeceras"] ?? [] {
        si (c[0] == ":status") { estado = a_numero(c[1]) } sino { mapa[c[0]] = c[1] }
    }
    retornar {"estado": estado, "cabeceras": mapa, "cuerpo": r["cuerpo"], "fin": r["fin"]}
}

/// Servidor HTTP/3: atiende las solicitudes completas con manejador(req)
/// → {"estado", "cabeceras", "cuerpo"}. req: {"metodo", "ruta",
/// "autoridad", "cabeceras", "cuerpo"}.
funcion veloz_h3_atender(q, manejador) {
    si (q["estado"] != "conectado") { retornar 0 }
    _vz_h3_control(q)
    q["h3_req"] = q["h3_req"] ?? {}
    sea atendidas = 0
    para k en claves(q["flujos"]) {
        sea f = q["flujos"][k]
        si (f["propio"] == falso y f["uni"] == falso) {
            si (tiene_clave(q["h3_req"], k) == falso) { q["h3_req"][k] = {"buf": "", "cabeceras": nulo, "cuerpo": "", "listo": falso} }
            sea st = q["h3_req"][k]
            si (st["listo"] == falso) {
                sea l = veloz_flujo_leer(q, f["id"])
                st["buf"] = st["buf"] + l["datos"]
                sea m = _vz_h3_marcos(st["buf"])
                st["buf"] = m[1]
                para fr en m[0] {
                    si (fr[0] == 1 y st["cabeceras"] == nulo) { st["cabeceras"] = veloz_qpack_decodificar(fr[1]) }
                    si (fr[0] == 0) { st["cuerpo"] = st["cuerpo"] + fr[1] }
                }
                si (l["fin"] y st["cabeceras"] != nulo) {
                    st["listo"] = verdadero
                    sea req = {"metodo": "GET", "ruta": "/", "autoridad": "", "cabeceras": {}, "cuerpo": st["cuerpo"]}
                    para c en st["cabeceras"] {
                        si (c[0] == ":method") { req["metodo"] = c[1] }
                        sino si (c[0] == ":path") { req["ruta"] = c[1] }
                        sino si (c[0] == ":authority") { req["autoridad"] = c[1] }
                        sino si (texto_empieza_con(c[0], ":") == falso) { req["cabeceras"][c[0]] = c[1] }
                    }
                    sea resp = manejador(req)
                    sea cab = [[":status", "" + (resp["estado"] ?? 200)]]
                    para nombre en claves(resp["cabeceras"] ?? {}) { cab.agregar([nombre, resp["cabeceras"][nombre]]) }
                    sea cuerpo = resp["cuerpo"] ?? ""
                    cab.agregar(["content-length", "" + longitud(cuerpo)])
                    sea d = _vz_h3_marco(1, veloz_qpack_codificar(cab))
                    si (longitud(cuerpo) > 0) { d = d + _vz_h3_marco(0, cuerpo) }
                    veloz_flujo_escribir(q, f["id"], d, verdadero)
                    atendidas = atendidas + 1
                }
            }
        }
    }
    retornar atendidas
}

// ---------- sobre UDP ----------

funcion _vz_url(url) {
    sea u = url
    si (texto_empieza_con(u, "https://")) { u = subtexto(u, 8, longitud(u)) }
    sea barra = texto_indice(u, "/")
    sea hostport = u
    sea ruta = "/"
    si (barra >= 0) {
        hostport = subtexto(u, 0, barra)
        ruta = subtexto(u, barra, longitud(u))
    }
    sea host = hostport
    sea puerto = 443
    sea dos = texto_indice(hostport, ":")
    si (dos >= 0) {
        host = subtexto(hostport, 0, dos)
        puerto = a_numero(subtexto(hostport, dos + 1, longitud(hostport)))
    }
    retornar {"host": host, "puerto": puerto, "ruta": ruta, "autoridad": hostport}
}

/// GET (o el método de opciones["metodo"]) por HTTP/3 sobre UDP.
/// opciones: las de veloz_cliente más "metodo", "cabeceras", "cuerpo",
/// "espera_ms" (10000). Devuelve {"estado", "cabeceras", "cuerpo"}.
funcion veloz_http3_get(url, opciones) {
    sea op = opciones ?? {}
    sea u = _vz_url(url)
    sea s = udp_crear(0)
    sea q = veloz_cliente(op["sni"] ?? u["host"], op)
    sea inicio = tiempo_ms()
    sea limite = op["espera_ms"] ?? 10000
    sea id = nulo
    sea resp = nulo
    mientras (tiempo_ms() - inicio < limite) {
        sea ahora = tiempo_ms()
        para dg en veloz_salida(q, ahora) { udp_enviar(s, u["host"], u["puerto"], dg) }
        si (q["estado"] == "cerrado") { romper }
        sea llego = falso
        sea r = udp_recibir(s)
        mientras (r != nulo) {
            veloz_recibir(q, r["datos"], tiempo_ms())
            llego = verdadero
            r = udp_recibir(s)
        }
        si (veloz_conectado(q) y id == nulo) { id = veloz_h3_solicitar(q, op["metodo"] ?? "GET", u["autoridad"], u["ruta"], op["cabeceras"] ?? [], op["cuerpo"] ?? nulo) }
        si (id != nulo) {
            resp = veloz_h3_respuesta(q, id)
            si (resp["fin"]) { romper }
        }
        si (llego == falso) { dormir(2) }
    }
    veloz_cerrar(q, 256, "")
    para dg en veloz_salida(q, tiempo_ms()) { udp_enviar(s, u["host"], u["puerto"], dg) }
    udp_cerrar(s)
    si (resp == nulo o resp["fin"] == falso) {
        si (q["error"] != nulo) { lanzar "veloz: " + q["error"] }
        lanzar "veloz: no llegó la respuesta a tiempo"
    }
    retornar {"estado": resp["estado"], "cabeceras": resp["cabeceras"], "cuerpo": resp["cuerpo"], "alpn": q["alpn"]}
}

/// Servidor HTTP/3 sobre UDP: atiende con manejador hasta que pasen
/// opciones["max_ms"] (sin límite si es nulo) o se atiendan
/// opciones["max_solicitudes"]. Devuelve cuántas atendió.
funcion veloz_http3_servir(puerto, opciones, manejador) {
    sea op = opciones ?? {}
    sea s = udp_crear(puerto)
    sea conexiones = {}
    sea inicio = tiempo_ms()
    sea total = 0
    mientras ((op["max_ms"] == nulo o tiempo_ms() - inicio < op["max_ms"]) y (op["max_solicitudes"] == nulo o total < op["max_solicitudes"])) {
        sea r = udp_recibir(s)
        sea hubo = falso
        mientras (r != nulo) {
            hubo = verdadero
            sea clave = r["origen"] + ":" + r["puerto"]
            si (tiene_clave(conexiones, clave) == falso) { conexiones[clave] = {"q": veloz_servidor(op), "host": r["origen"], "puerto": r["puerto"]} }
            intentar { veloz_recibir(conexiones[clave]["q"], r["datos"], tiempo_ms()) } capturar (e) { }
            r = udp_recibir(s)
        }
        para clave en claves(conexiones) {
            sea cx = conexiones[clave]
            intentar { total = total + veloz_h3_atender(cx["q"], manejador) } capturar (e) { }
            para dg en veloz_salida(cx["q"], tiempo_ms()) { udp_enviar(s, cx["host"], cx["puerto"], dg) }
            si (cx["q"]["estado"] == "cerrado") { quitar_clave(conexiones, clave) }
        }
        si (hubo == falso) { dormir(2) }
    }
    // Deja salir lo último.
    para clave en claves(conexiones) { para dg en veloz_salida(conexiones[clave]["q"], tiempo_ms()) { udp_enviar(s, conexiones[clave]["host"], conexiones[clave]["puerto"], dg) } }
    udp_cerrar(s)
    retornar total
}
