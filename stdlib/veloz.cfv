// stdlib/veloz.cfv — QUIC v1 (RFC 9000/9001/9002) y HTTP/3 (RFC 9114 con
// QPACK de RFC 9204) propios en C-Forge puro, al estilo de Quinn: cliente y
// servidor sin E/S (se le dan datagramas y devuelve datagramas, con
// temporizador) y sobre UDP; claves iniciales, protección de paquetes y de
// cabeceras (AES y ChaCha20), los tres espacios de números de paquete,
// CRYPTO con TLS 1.3 de "blindaje", ACK, retransmisión por tiempo, flujos
// bidireccionales y unidireccionales con control de flujo, HANDSHAKE_DONE,
// cierre, parámetros de transporte, Retry y HTTP/3 (SETTINGS, HEADERS y
// DATA con QPACK estático y Huffman). Probado contra aioquic.
// Idea de Quinn (MIT/Apache-2.0), escrito desde cero. En inglés: importar "quinn".
//
//   importar "veloz"
//   sea r = veloz_http3_get("https://localhost:4433/", {"raices": leer_archivo("ca.pem")})
//   mostrar([r["estado"], r["cuerpo"]])

importar "blindaje"

// ---------- enteros de largo variable ----------

funcion veloz_varint(v) {
    si (v < 64) { retornar char_de(v) }
    si (v < 16384) { retornar char_de(64 + piso(v / 256)) + char_de(v % 256) }
    si (v < 1073741824) { retornar char_de(128 + piso(v / 16777216)) + char_de(piso(v / 65536) % 256) + char_de(piso(v / 256) % 256) + char_de(v % 256) }
    retornar char_de(192 + piso(v / 72057594037927936) % 64) + bytes_entero(v % 72057594037927936, 7, 0)
}

// [valor, siguiente posición]
funcion _vz_leer_varint(d, p) {
    sea b = byte_en(d, p)
    sea tipo_v = piso(b / 64)
    sea v = b % 64
    sea n = 1
    si (tipo_v == 1) { n = 2 } sino si (tipo_v == 2) { n = 4 } sino si (tipo_v == 3) { n = 8 }
    sea i = 1
    mientras (i < n) {
        v = v * 256 + byte_en(d, p + i)
        i = i + 1
    }
    retornar [v, p + n]
}

// ---------- claves y protección ----------

sea _VZ_SAL = "38762cf7f55934b34d179ae6a4c80cadccbb7f0a"

funcion _vz_claves_de(secreto, suite) {
    sea alg = suite["hash"]
    sea r = {"clave": blindaje_expandir_etiqueta(alg, secreto, "quic key", "", suite["klen"]), "iv": blindaje_expandir_etiqueta(alg, secreto, "quic iv", "", 12),
        "hp": blindaje_expandir_etiqueta(alg, secreto, "quic hp", "", suite["klen"]), "aead": suite["aead"], "secreto": secreto, "suite": suite}
    retornar r
}

/// Claves iniciales a partir del DCID del cliente: {"cliente", "servidor"}.
funcion veloz_claves_iniciales(dcid) {
    sea inicial = hmac_sha256_bytes(bytes_de_hex(_VZ_SAL), dcid)
    sea suite = {"hash": 256, "klen": 16, "aead": "aes"}
    retornar {"cliente": _vz_claves_de(blindaje_expandir_etiqueta(256, inicial, "client in", "", 32), suite),
        "servidor": _vz_claves_de(blindaje_expandir_etiqueta(256, inicial, "server in", "", 32), suite)}
}

funcion _vz_mascara(k, muestra) {
    si (k["aead"] == "aes") { retornar aes_bloque(k["hp"], muestra) }
    sea contador = bytes_leer_entero(muestra, 0, 4, 1)
    retornar chacha20_xor(k["hp"], contador, subtexto(muestra, 4, 16), _vz_ceros(5))
}

funcion _vz_ceros(n) {
    sea r = ""
    mientras (longitud(r) < n) { r = r + char_de(0) }
    retornar r
}

funcion _vz_nonce(k, pn) {
    sea r = ""
    sea pnb = bytes_entero(pn, 8, 0)
    sea i = 0
    mientras (i < 12) {
        sea x = 0
        si (i >= 4) { x = byte_en(pnb, i - 4) }
        r = r + char_de(bits_xo(byte_en(k["iv"], i), x))
        i = i + 1
    }
    retornar r
}

funcion _vz_sellar(k, pn, aad, texto) {
    si (k["aead"] == "aes") { retornar aes_gcm_cifrar(k["clave"], _vz_nonce(k, pn), texto, aad) }
    retornar chacha20_poly1305_cifrar(k["clave"], _vz_nonce(k, pn), texto, aad)
}

funcion _vz_abrir(k, pn, aad, cifrado) {
    si (k["aead"] == "aes") { retornar aes_gcm_descifrar(k["clave"], _vz_nonce(k, pn), cifrado, aad) }
    retornar chacha20_poly1305_descifrar(k["clave"], _vz_nonce(k, pn), cifrado, aad)
}

/// Protege un paquete: cabecera (con el número de paquete sin proteger,
/// que empieza en pn_pos y mide pn_largo) y carga útil en claro.
funcion veloz_proteger(k, cabecera, pn, pn_pos, pn_largo, carga) {
    sea cifrado = _vz_sellar(k, pn, cabecera, carga)
    sea pkt = cabecera + cifrado
    sea muestra = subtexto(pkt, pn_pos + 4, pn_pos + 20)
    sea m = _vz_mascara(k, muestra)
    sea b0 = byte_en(pkt, 0)
    si (b0 >= 128) { b0 = bits_xo(b0, bits_y(byte_en(m, 0), 15)) } sino { b0 = bits_xo(b0, bits_y(byte_en(m, 0), 31)) }
    sea r = char_de(b0) + subtexto(pkt, 1, pn_pos)
    sea i = 0
    mientras (i < pn_largo) {
        r = r + char_de(bits_xo(byte_en(pkt, pn_pos + i), byte_en(m, 1 + i)))
        i = i + 1
    }
    retornar r + subtexto(pkt, pn_pos + pn_largo, longitud(pkt))
}

// Quita la protección: devuelve {"pn", "carga", "cabecera"} o nulo si falla.
funcion _vz_desproteger(k, pkt, pn_pos, esperado) {
    si (pn_pos + 20 > longitud(pkt)) { retornar nulo }
    sea m = _vz_mascara(k, subtexto(pkt, pn_pos + 4, pn_pos + 20))
    sea b0 = byte_en(pkt, 0)
    si (b0 >= 128) { b0 = bits_xo(b0, bits_y(byte_en(m, 0), 15)) } sino { b0 = bits_xo(b0, bits_y(byte_en(m, 0), 31)) }
    sea pn_largo = b0 % 4 + 1
    sea truncado = 0
    sea pnb = ""
    sea i = 0
    mientras (i < pn_largo) {
        sea x = bits_xo(byte_en(pkt, pn_pos + i), byte_en(m, 1 + i))
        pnb = pnb + char_de(x)
        truncado = truncado * 256 + x
        i = i + 1
    }
    sea pn = _vz_decodificar_pn(esperado, truncado, pn_largo * 8)
    sea cab = char_de(b0) + subtexto(pkt, 1, pn_pos) + pnb
    sea carga = ""
    intentar { carga = _vz_abrir(k, pn, cab, subtexto(pkt, pn_pos + pn_largo, longitud(pkt))) } capturar (e) { retornar nulo }
    retornar {"pn": pn, "carga": carga, "b0": b0}
}

funcion _vz_decodificar_pn(esperado, truncado, bits) {
    sea win = potencia(2, bits)
    sea hwin = win / 2
    sea candidato = esperado - esperado % win + truncado
    si (candidato <= esperado - hwin y candidato < potencia(2, 62) - win) { retornar candidato + win }
    si (candidato > esperado + hwin y candidato >= win) { retornar candidato - win }
    retornar candidato
}

// ---------- parámetros de transporte ----------

funcion _vz_tp(id, valor) { retornar veloz_varint(id) + veloz_varint(longitud(valor)) + valor }
funcion _vz_tpn(id, n) { retornar _vz_tp(id, veloz_varint(n)) }

funcion _vz_mis_parametros(q) {
    sea op = q["op"]
    sea r = _vz_tpn(1, op["inactividad_ms"] ?? 30000) + _vz_tpn(4, 16777216) + _vz_tpn(5, 4194304) + _vz_tpn(6, 4194304) + _vz_tpn(7, 4194304)
    r = r + _vz_tpn(8, 100) + _vz_tpn(9, 100) + _vz_tp(15, q["scid"])
    si (q["rol"] == "servidor") {
        r = r + _vz_tp(0, q["odcid"])
        si (q["retry_scid"] != nulo) { r = r + _vz_tp(16, q["retry_scid"]) }
    }
    retornar r
}

funcion _vz_leer_parametros(d) {
    sea r = {}
    sea p = 0
    mientras (p < longitud(d)) {
        sea a = _vz_leer_varint(d, p)
        sea b = _vz_leer_varint(d, a[1])
        sea v = subtexto(d, b[1], b[1] + b[0])
        p = b[1] + b[0]
        sea id = a[0]
        si (id == 0 o id == 15 o id == 16 o id == 2) { r["" + id] = v }
        sino si (longitud(v) > 0) { r["" + id] = _vz_leer_varint(v, 0)[0] }
    }
    retornar r
}

// ---------- conexión ----------

funcion _vz_espacio() { retornar {"leer": nulo, "escribir": nulo, "sig_pn": 0, "mayor": -1, "recibidos": [], "ack": falso, "crypto": "", "crypto_off": 0, "crypto_rec": {}, "crypto_rec_off": 0, "enviados": {}, "repetir": []} }

funcion _vz_conexion(rol, op) {
    sea q = {"rol": rol, "op": op, "estado": "inicial", "espacios": {"inicial": _vz_espacio(), "handshake": _vz_espacio(), "aplicacion": _vz_espacio()},
        "flujos": {}, "par": {}, "sig_bidi": 0, "sig_uni": 2, "eventos": [], "token": "", "retry_scid": nulo, "cerrar": nulo, "confirmado": falso,
        "hd_pendiente": falso, "datos_enviados": 0, "max_datos_par": 0, "pto": op["pto_ms"] ?? 250, "ultimo_rec": 0, "error": nulo, "nuevos": []}
    si (rol == "servidor") {
        q["sig_bidi"] = 1
        q["sig_uni"] = 3
    }
    retornar q
}

/// Conexión cliente (sin E/S). opciones: las de blindaje_cliente
/// ("raices", "verificar", "alpn"…) más "inactividad_ms".
funcion veloz_cliente(nombre_servidor, opciones) {
    sea op = opciones ?? {}
    sea q = _vz_conexion("cliente", op)
    q["scid"] = bytes_aleatorios(8)
    q["dcid"] = bytes_aleatorios(8)
    q["odcid"] = q["dcid"]
    _vz_iniciales(q, q["dcid"])
    sea top = {}
    para k en claves(op) { top[k] = op[k] }
    top["quic"] = verdadero
    top["quic_parametros"] = _vz_mis_parametros(q)
    si (tiene_clave(top, "alpn") == falso) { top["alpn"] = ["h3"] }
    q["tls"] = blindaje_cliente(nombre_servidor, top)
    _vz_tls_salida(q)
    retornar q
}

/// Conexión servidor (sin E/S) para el primer Initial recibido.
/// opciones: las de blindaje_servidor ("cadena", "clave", "alpn"…).
funcion veloz_servidor(opciones) {
    sea op = opciones ?? {}
    sea q = _vz_conexion("servidor", op)
    q["scid"] = bytes_aleatorios(8)
    retornar q
}

funcion _vz_iniciales(q, dcid) {
    sea ci = veloz_claves_iniciales(dcid)
    sea e = q["espacios"]["inicial"]
    si (q["rol"] == "cliente") {
        e["escribir"] = ci["cliente"]
        e["leer"] = ci["servidor"]
    } sino {
        e["escribir"] = ci["servidor"]
        e["leer"] = ci["cliente"]
    }
}

// Pasa lo que TLS quiere enviar a los búferes CRYPTO e instala claves nuevas.
funcion _vz_tls_salida(q) {
    para nivel en ["inicial", "handshake", "aplicacion"] {
        sea s = blindaje_quic_salida(q["tls"], nivel)
        si (longitud(s) > 0) { q["espacios"][nivel]["crypto"] = q["espacios"][nivel]["crypto"] + s }
    }
    sea sec = blindaje_quic_secretos(q["tls"])
    sea yo = "cliente"
    sea otro = "servidor"
    si (q["rol"] == "servidor") {
        yo = "servidor"
        otro = "cliente"
    }
    para nivel en ["handshake", "aplicacion"] {
        sea e = q["espacios"][nivel]
        si (tiene_clave(sec, nivel) y e["escribir"] == nulo) {
            e["escribir"] = _vz_claves_de(sec[nivel][yo], sec["suite"])
            e["leer"] = _vz_claves_de(sec[nivel][otro], sec["suite"])
        }
    }
    si (blindaje_listo(q["tls"]) y q["estado"] == "inicial") {
        q["estado"] = "conectado"
        q["alpn"] = q["tls"]["alpn"]
        q["par"] = _vz_leer_parametros(q["tls"]["quic_parametros_par"] ?? "")
        q["max_datos_par"] = q["par"]["4"] ?? 0
        _vz_validar_parametros(q)
        q["eventos"].agregar({"tipo": "conectado"})
        si (q["rol"] == "servidor") { q["hd_pendiente"] = verdadero }
    }
}

funcion _vz_validar_parametros(q) {
    sea p = q["par"]
    si ((p["15"] ?? "") != q["dcid_par_inicial"]) { _vz_fallar(q, 8, "initial_source_connection_id no coincide") }
    si (q["rol"] == "cliente") {
        si ((p["0"] ?? "") != q["odcid"]) { _vz_fallar(q, 8, "original_destination_connection_id no coincide") }
        si (q["retry_scid"] != nulo y (p["16"] ?? "") != q["retry_scid"]) { _vz_fallar(q, 8, "retry_source_connection_id no coincide") }
    }
}

funcion _vz_fallar(q, codigo, msj) {
    q["error"] = msj
    q["cerrar"] = {"codigo": codigo, "razon": msj}
    lanzar "veloz: " + msj
}

// ---------- recepción ----------

/// Procesa un datagrama UDP recibido (ahora: milisegundos).
funcion veloz_recibir(q, datos, ahora) {
    q["ultimo_rec"] = ahora
    sea p = 0
    mientras (p < longitud(datos)) {
        sea b0 = byte_en(datos, p)
        si (b0 >= 128) {
            sea version = bytes_leer_entero(datos, p + 1, 4, 0)
            sea dl = byte_en(datos, p + 5)
            sea dcid = subtexto(datos, p + 6, p + 6 + dl)
            sea sl = byte_en(datos, p + 6 + dl)
            sea scid = subtexto(datos, p + 7 + dl, p + 7 + dl + sl)
            sea pos = p + 7 + dl + sl
            si (version != 1) { retornar nulo }
            sea tipo_p = piso(b0 / 16) % 4
            si (tipo_p == 3) {
                _vz_retry(q, subtexto(datos, p, longitud(datos)), scid)
                retornar nulo
            }
            sea token = ""
            si (tipo_p == 0) {
                sea tl = _vz_leer_varint(datos, pos)
                token = subtexto(datos, tl[1], tl[1] + tl[0])
                pos = tl[1] + tl[0]
            }
            sea ll = _vz_leer_varint(datos, pos)
            sea fin = ll[1] + ll[0]
            sea pkt = subtexto(datos, p, fin)
            sea pn_pos = ll[1] - p
            sea nivel = "inicial"
            si (tipo_p == 2) { nivel = "handshake" }
            si (tipo_p == 1) { nivel = "" }
            si (q["rol"] == "servidor" y tiene_clave(q, "odcid") == falso y tipo_p == 0) {
                q["odcid"] = dcid
                q["dcid"] = scid
                q["dcid_par_inicial"] = scid
                _vz_iniciales(q, dcid)
                sea top = {}
                para k en claves(q["op"]) { top[k] = q["op"][k] }
                top["quic"] = verdadero
                top["quic_parametros"] = _vz_mis_parametros(q)
                si (tiene_clave(top, "alpn") == falso) { top["alpn"] = ["h3"] }
                q["tls"] = blindaje_servidor(top)
            }
            si (q["rol"] == "cliente" y tipo_p == 0 y tiene_clave(q, "dcid_par_inicial") == falso) {
                q["dcid"] = scid
                q["dcid_par_inicial"] = scid
            }
            si (nivel != "") { _vz_paquete(q, nivel, pkt, pn_pos, ahora) }
            p = fin
        } sino si (bits_y(b0, 64) == 0) {
            // Relleno o basura al final del datagrama.
            p = longitud(datos)
        } sino {
            sea pn_pos = 1 + longitud(q["scid"])
            _vz_paquete(q, "aplicacion", subtexto(datos, p, longitud(datos)), pn_pos, ahora)
            p = longitud(datos)
        }
    }
}

funcion _vz_paquete(q, nivel, pkt, pn_pos, ahora) {
    sea e = q["espacios"][nivel]
    si (e["leer"] == nulo) { retornar nulo }
    sea r = _vz_desproteger(e["leer"], pkt, pn_pos, e["mayor"] + 1)
    si (r == nulo) {
        q["descartados"] = (q["descartados"] ?? 0) + 1
        retornar nulo
    }
    si (contiene(e["recibidos"], r["pn"])) { retornar nulo }
    e["recibidos"].agregar(r["pn"])
    si (r["pn"] > e["mayor"]) { e["mayor"] = r["pn"] }
    si (nivel == "handshake" y q["rol"] == "servidor") { q["espacios"]["inicial"]["enviados"] = {} }
    si (_vz_marcos(q, nivel, r["carga"], ahora)) { e["ack"] = verdadero }
}

// Procesa los marcos; devuelve si alguno pide ACK.
funcion _vz_marcos(q, nivel, d, ahora) {
    sea e = q["espacios"][nivel]
    sea pide = falso
    sea p = 0
    mientras (p < longitud(d)) {
        sea t = _vz_leer_varint(d, p)
        sea tipo_m = t[0]
        p = t[1]
        si (tipo_m == 0) {
        } sino si (tipo_m == 1) {
            pide = verdadero
        } sino si (tipo_m == 2 o tipo_m == 3) {
            sea mayor = _vz_leer_varint(d, p)
            sea demora = _vz_leer_varint(d, mayor[1])
            sea nr = _vz_leer_varint(d, demora[1])
            sea primero = _vz_leer_varint(d, nr[1])
            p = primero[1]
            sea hi = mayor[0]
            sea lo = hi - primero[0]
            _vz_confirmar(q, e, lo, hi)
            sea k = 0
            mientras (k < nr[0]) {
                sea gap = _vz_leer_varint(d, p)
                sea largo = _vz_leer_varint(d, gap[1])
                p = largo[1]
                hi = lo - gap[0] - 2
                lo = hi - largo[0]
                _vz_confirmar(q, e, lo, hi)
                k = k + 1
            }
            si (tipo_m == 3) {
                sea z = 0
                mientras (z < 3) {
                    p = _vz_leer_varint(d, p)[1]
                    z = z + 1
                }
            }
        } sino si (tipo_m == 4) {
            sea id = _vz_leer_varint(d, p)
            sea err = _vz_leer_varint(d, id[1])
            sea fin_t = _vz_leer_varint(d, err[1])
            p = fin_t[1]
            sea f = _vz_flujo(q, id[0])
            f["reiniciado"] = err[0]
            q["eventos"].agregar({"tipo": "reinicio", "id": id[0], "codigo": err[0]})
            pide = verdadero
        } sino si (tipo_m == 5) {
            sea id = _vz_leer_varint(d, p)
            p = _vz_leer_varint(d, id[1])[1]
            pide = verdadero
        } sino si (tipo_m == 6) {
            sea off = _vz_leer_varint(d, p)
            sea l = _vz_leer_varint(d, off[1])
            sea datos = subtexto(d, l[1], l[1] + l[0])
            p = l[1] + l[0]
            _vz_crypto_recibido(q, nivel, off[0], datos)
            pide = verdadero
        } sino si (tipo_m == 7) {
            sea l = _vz_leer_varint(d, p)
            p = l[1] + l[0]
            pide = verdadero
        } sino si (tipo_m >= 8 y tipo_m <= 15) {
            sea id = _vz_leer_varint(d, p)
            p = id[1]
            sea off = 0
            si (bits_y(tipo_m, 4) != 0) {
                sea o = _vz_leer_varint(d, p)
                off = o[0]
                p = o[1]
            }
            sea largo = longitud(d) - p
            si (bits_y(tipo_m, 2) != 0) {
                sea l = _vz_leer_varint(d, p)
                largo = l[0]
                p = l[1]
            }
            sea datos = subtexto(d, p, p + largo)
            p = p + largo
            _vz_flujo_recibido(q, id[0], off, datos, bits_y(tipo_m, 1) != 0)
            pide = verdadero
        } sino si (tipo_m == 16) {
            sea m = _vz_leer_varint(d, p)
            p = m[1]
            si (m[0] > q["max_datos_par"]) { q["max_datos_par"] = m[0] }
            pide = verdadero
        } sino si (tipo_m == 17) {
            sea id = _vz_leer_varint(d, p)
            sea m = _vz_leer_varint(d, id[1])
            p = m[1]
            sea f = _vz_flujo(q, id[0])
            si (m[0] > f["max_env"]) { f["max_env"] = m[0] }
            pide = verdadero
        } sino si (tipo_m == 18 o tipo_m == 19 o tipo_m == 20 o tipo_m == 22 o tipo_m == 23) {
            p = _vz_leer_varint(d, p)[1]
            pide = verdadero
        } sino si (tipo_m == 21) {
            sea id = _vz_leer_varint(d, p)
            p = _vz_leer_varint(d, id[1])[1]
            pide = verdadero
        } sino si (tipo_m == 24) {
            sea sec = _vz_leer_varint(d, p)
            sea ret = _vz_leer_varint(d, sec[1])
            sea l = byte_en(d, ret[1])
            p = ret[1] + 1 + l + 16
            pide = verdadero
        } sino si (tipo_m == 25) {
            p = _vz_leer_varint(d, p)[1]
            pide = verdadero
        } sino si (tipo_m == 26) {
            e["repetir"].agregar({"t": "path_resp", "datos": subtexto(d, p, p + 8)})
            p = p + 8
            pide = verdadero
        } sino si (tipo_m == 27) {
            p = p + 8
            pide = verdadero
        } sino si (tipo_m == 28 o tipo_m == 29) {
            sea codigo = _vz_leer_varint(d, p)
            p = codigo[1]
            si (tipo_m == 28) { p = _vz_leer_varint(d, p)[1] }
            sea l = _vz_leer_varint(d, p)
            sea razon = subtexto(d, l[1], l[1] + l[0])
            p = l[1] + l[0]
            q["estado"] = "cerrado"
            q["cierre_par"] = {"codigo": codigo[0], "razon": razon}
            q["eventos"].agregar({"tipo": "cerrado", "codigo": codigo[0], "razon": razon})
        } sino si (tipo_m == 30) {
            q["confirmado"] = verdadero
            q["espacios"]["handshake"]["enviados"] = {}
            pide = verdadero
        } sino si (tipo_m == 48 o tipo_m == 49) {
            si (tipo_m == 49) {
                sea l = _vz_leer_varint(d, p)
                p = l[1] + l[0]
            } sino { p = longitud(d) }
            pide = verdadero
        } sino {
            _vz_fallar(q, 7, "marco desconocido " + tipo_m)
        }
    }
    retornar pide
}

funcion _vz_confirmar(q, e, lo, hi) {
    para k en claves(e["enviados"]) {
        sea pn = a_numero(k)
        si (pn >= lo y pn <= hi) { quitar_clave(e["enviados"], k) }
    }
}

funcion _vz_crypto_recibido(q, nivel, off, datos) {
    sea e = q["espacios"][nivel]
    si (off + longitud(datos) <= e["crypto_rec_off"]) { retornar nulo }
    e["crypto_rec"]["" + off] = datos
    // Entrega en orden.
    sea seguir = verdadero
    mientras (seguir) {
        seguir = falso
        para k en claves(e["crypto_rec"]) {
            sea o = a_numero(k)
            sea dd = e["crypto_rec"][k]
            si (o <= e["crypto_rec_off"] y o + longitud(dd) > e["crypto_rec_off"]) {
                sea nuevo = subtexto(dd, e["crypto_rec_off"] - o, longitud(dd))
                e["crypto_rec_off"] = o + longitud(dd)
                quitar_clave(e["crypto_rec"], k)
                si (q["tls"] != nulo) {
                    intentar { blindaje_quic_recibir(q["tls"], nivel, nuevo) } capturar (err) {
                        q["error"] = err
                        q["cerrar"] = {"codigo": 256 + 40, "razon": "" + err}
                        lanzar err
                    }
                }
                seguir = verdadero
            } sino si (o + longitud(dd) <= e["crypto_rec_off"]) { quitar_clave(e["crypto_rec"], k) }
        }
    }
    _vz_tls_salida(q)
}

// ---------- flujos ----------

funcion _vz_flujo(q, id) {
    si (tiene_clave(q["flujos"], "" + id) == falso) {
        sea propio = (id % 2 == 0) == (q["rol"] == "cliente")
        sea uni = piso(id / 2) % 2 == 1
        sea max_env = 0
        si (uni) { max_env = q["par"]["7"] ?? 0 }
        sino si (propio) { max_env = q["par"]["6"] ?? 0 }
        sino { max_env = q["par"]["5"] ?? 0 }
        q["flujos"]["" + id] = {"id": id, "rec": {}, "rec_off": 0, "buf": "", "fin_rec": nulo, "fin_entregado": falso, "env": "", "env_off": 0, "fin_env": falso,
            "fin_enviado": falso, "max_env": max_env, "propio": propio, "uni": uni, "reiniciado": nulo}
        si (propio == falso) {
            q["eventos"].agregar({"tipo": "flujo", "id": id})
            q["nuevos"].agregar(id)
        }
    }
    retornar q["flujos"]["" + id]
}

funcion _vz_flujo_recibido(q, id, off, datos, fin) {
    sea f = _vz_flujo(q, id)
    si (fin) { f["fin_rec"] = off + longitud(datos) }
    si (off + longitud(datos) > f["rec_off"] o longitud(datos) == 0) {
        f["rec"]["" + off] = datos
        sea seguir = verdadero
        mientras (seguir) {
            seguir = falso
            para k en claves(f["rec"]) {
                sea o = a_numero(k)
                sea dd = f["rec"][k]
                si (o <= f["rec_off"] y o + longitud(dd) >= f["rec_off"]) {
                    f["buf"] = f["buf"] + subtexto(dd, f["rec_off"] - o, longitud(dd))
                    f["rec_off"] = maximo(f["rec_off"], o + longitud(dd))
                    quitar_clave(f["rec"], k)
                    seguir = verdadero
                }
            }
        }
    }
    q["eventos"].agregar({"tipo": "datos", "id": id})
}

/// Abre un flujo propio (bidireccional o no). Devuelve su número.
funcion veloz_flujo_abrir(q, bidireccional) {
    sea id = 0
    si (bidireccional) {
        id = q["sig_bidi"]
        q["sig_bidi"] = id + 4
    } sino {
        id = q["sig_uni"]
        q["sig_uni"] = id + 4
    }
    _vz_flujo(q, id)
    retornar id
}

/// Encola datos en un flujo (fin: es lo último).
funcion veloz_flujo_escribir(q, id, datos, fin) {
    sea f = _vz_flujo(q, id)
    f["env"] = f["env"] + datos
    si (fin) { f["fin_env"] = verdadero }
}

/// Lee lo recibido en un flujo: {"datos", "fin"}.
funcion veloz_flujo_leer(q, id) {
    sea f = _vz_flujo(q, id)
    sea d = f["buf"]
    f["buf"] = ""
    sea fin = f["fin_rec"] != nulo y f["rec_off"] >= f["fin_rec"]
    retornar {"datos": d, "fin": fin}
}

/// Flujos que abrió el otro lado desde la última llamada.
funcion veloz_flujos_nuevos(q) {
    sea r = q["nuevos"]
    q["nuevos"] = []
    retornar r
}

/// Eventos pendientes (conectado, flujo, datos, cerrado…), y los quita.
funcion veloz_eventos(q) {
    sea r = q["eventos"]
    q["eventos"] = []
    retornar r
}

/// Cierra la conexión con un código de aplicación.
funcion veloz_cerrar(q, codigo, razon) {
    q["cerrar"] = {"codigo": codigo ?? 0, "razon": razon ?? "", "app": verdadero}
}

// ---------- Retry ----------

funcion _vz_retry(q, pkt, scid) {
    si (q["rol"] != "cliente" o q["retry_scid"] != nulo o longitud(pkt) < 16) { retornar nulo }
    // Etiqueta de integridad (RFC 9001 5.8).
    sea sin_tag = subtexto(pkt, 0, longitud(pkt) - 16)
    sea pseudo = char_de(longitud(q["odcid"])) + q["odcid"] + sin_tag
    sea tag = aes_gcm_cifrar(bytes_de_hex("be0c690b9f66575a1d766b54e368c84e"), bytes_de_hex("461599d35d632bf2239825bb"), "", pseudo)
    si (tag != subtexto(pkt, longitud(pkt) - 16, longitud(pkt))) { retornar nulo }
    sea dl = byte_en(pkt, 5)
    sea sl = byte_en(pkt, 6 + dl)
    q["token"] = subtexto(pkt, 7 + dl + sl, longitud(pkt) - 16)
    q["retry_scid"] = scid
    q["dcid"] = scid
    _vz_iniciales(q, scid)
    // Se vuelve a mandar todo el CRYPTO inicial.
    sea e = q["espacios"]["inicial"]
    sea todo = ""
    para k en claves(e["enviados"]) { para fr en e["enviados"][k]["frames"] { si (fr["t"] == "crypto") { e["repetir"].agregar(fr) } } }
    e["enviados"] = {}
}

