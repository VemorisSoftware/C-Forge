// stdlib/ebpf.cfv — máquina virtual de eBPF: nombres en inglés del módulo "nucleo".
// English names for the "nucleo" module; both can be used together.

importar "nucleo"

funcion _ebpf_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_ebpf_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _ebpf_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _EBPF_RES = {"op": "opcode", "dst": "dst", "src": "src", "off": "off", "imm": "imm", "programas": "programs", "mapas": "maps", "nombres_mapas": "map_names", "licencia": "license"}

funcion ebpf_decode(prog) { retornar _ebpf_tr(nucleo_decodificar(prog), _EBPF_RES) }
funcion ebpf_assemble(texto) { retornar nucleo_ensamblar(texto) }
funcion ebpf_disassemble(prog) { retornar nucleo_desensamblar(prog) }
funcion ebpf_map(tipo_m, tam_clave, tam_valor, maximo_n) { retornar nucleo_mapa(tipo_m, tam_clave, tam_valor, maximo_n) }
funcion ebpf_map_lookup(m, clave) { retornar nucleo_mapa_leer(m, clave) }
funcion ebpf_map_update(m, clave, valor) { retornar nucleo_mapa_poner(m, clave, valor) }
funcion ebpf_map_delete(m, clave) { retornar nucleo_mapa_borrar(m, clave) }
funcion ebpf_map_keys(m) { retornar nucleo_mapa_claves(m) }
funcion ebpf_load_elf(d) { retornar _ebpf_tr(nucleo_cargar_elf(d), _EBPF_RES) }

// Verify a program: [] or a list of errors. options: "loops", "max_insns".
funcion ebpf_verify(prog, options) {
    sea o = options ?? {}
    sea op = {}
    si (tiene_clave(o, "loops")) { op["bucles"] = o["loops"] }
    si (tiene_clave(o, "max_insns")) { op["max_instrucciones"] = o["max_insns"] }
    retornar nucleo_verificar(prog, op)
}
// Run a program. options: "maps", "helpers", "max_steps", "writable_ctx".
// Returns {"r0", "r0_hex", "steps", "output", "ctx"}.
funcion ebpf_run(prog, ctx, options) {
    sea o = options ?? {}
    sea op = {}
    si (tiene_clave(o, "maps")) { op["mapas"] = o["maps"] }
    si (tiene_clave(o, "helpers")) { op["ayudas"] = o["helpers"] }
    si (tiene_clave(o, "max_steps")) { op["max_pasos"] = o["max_steps"] }
    si (tiene_clave(o, "writable_ctx")) { op["contexto_escribible"] = o["writable_ctx"] }
    sea r = nucleo_ejecutar(prog, ctx, op)
    retornar {"r0": r["r0"], "r0_hex": r["r0_hex"], "r0_u32": r["r0_u32"], "steps": r["pasos"], "output": r["salida"], "ctx": r["contexto"]}
}
