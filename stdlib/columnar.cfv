// stdlib/columnar.cfv — Parquet y Arrow: nombres en inglés del módulo "columnas".
// English names for the "columnas" module; both can be used together.


importar "columnas"

funcion _columnar_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_columnar_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _columnar_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _COLUMNAR_RES = {"nombre": "name", "tipo": "type", "filas": "rows", "esquema": "schema", "grupos": "row_groups", "creado_por": "created_by"}
sea _COLUMNAR_OPT = {"columns": "columnas", "compression": "compresion", "row_group_size": "filas_por_grupo", "dictionary": "diccionario", "metadata": "meta"}

funcion columnar_table(datos, tipos, orden) { retornar columnas_tabla(datos, tipos, orden) }
funcion columnar_from_rows(filas, tipos, orden) { retornar columnas_desde_filas(filas, tipos, orden) }
funcion columnar_rows(t) { retornar columnas_filas(t) }
funcion columnar_column(t, nombre) { retornar columnas_columna(t, nombre) }
funcion columnar_schema(t) { retornar _columnar_tr(columnas_esquema(t), _COLUMNAR_RES) }
funcion columnar_select(t, nombres) { retornar columnas_seleccionar(t, nombres) }
funcion columnar_filter(t, fn) { retornar columnas_filtrar(t, fn) }
funcion parquet_info(datos) { retornar _columnar_tr(columnas_parquet_info(datos), _COLUMNAR_RES) }
funcion parquet_read(datos, opciones) { retornar columnas_parquet_leer(datos, _columnar_opt(opciones)) }
funcion parquet_write(t, opciones) { retornar columnas_parquet_escribir(t, _columnar_opt(opciones)) }
funcion arrow_stream(t) { retornar columnas_arrow_flujo(t) }
funcion arrow_file(t) { retornar columnas_arrow_archivo(t) }
funcion arrow_read(datos) { retornar columnas_arrow_leer(datos) }

funcion _columnar_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_COLUMNAR_OPT[k] ?? k] = o[k] }
    retornar r
}
