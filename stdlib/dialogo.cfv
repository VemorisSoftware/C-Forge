// stdlib/dialogo.cfv — narrativa interactiva para juegos, chatbots guiados
// o aventuras de texto: nodos con líneas, opciones con condiciones,
// variables, saltos y efectos. Se escribe en un texto simple. Inspirada en
// ink / Yarn Spinner (MIT). En inglés: importar "dialogue".
//
//   === inicio
//   Ana: Hola, viajero.
//   * [Saludar] -> saludo
//   * (oro >= 10) [Comprar una espada] ~ oro -= 10 ~ espada = verdadero -> tienda
//   * [Irse] -> FIN
//
//   importar "dialogo"
//   sea d = dialogo_cargar(guion, {"oro": 12})
//   sea paso = dialogo_paso(d)          // {"lineas": [...], "opciones": [...], "fin"}
//   dialogo_elegir(d, 1)
//
// Líneas: "Personaje: texto" o texto suelto; {{variable}} se reemplaza.
// "~ x = 5", "~ x += 1" cambian variables; "-> nodo" salta; "-> FIN" termina.

funcion _dl_valor(t, vars) {
    sea x = texto_recortar(t)
    si (x == "verdadero" o x == "true") { retornar verdadero }
    si (x == "falso" o x == "false") { retornar falso }
    si (texto_empieza_con(x, "\"") y texto_termina_con(x, "\"")) { retornar subcadena(x, 1, longitud(x) - 1) }
    sea n = nulo
    intentar { n = a_numero(x) } capturar (e) { n = nulo }
    si (n != nulo y x != "") { retornar n }
    si (tiene_clave(vars, x)) { retornar vars[x] }
    retornar nulo
}

// "oro >= 10", "espada", "no espada", "a == \"x\"".
funcion _dl_condicion(c, vars) {
    sea t = texto_recortar(c)
    si (texto_empieza_con(t, "no ")) { retornar _dl_condicion(subcadena(t, 3, longitud(t)), vars) == falso }
    para op en [">=", "<=", "!=", "==", ">", "<"] {
        sea i = texto_indice(t, op)
        si (i > 0) {
            sea a = _dl_valor(subcadena(t, 0, i), vars)
            sea b = _dl_valor(subcadena(t, i + longitud(op), longitud(t)), vars)
            si (op == "==") { retornar a == b }
            si (op == "!=") { retornar a != b }
            si (a == nulo o b == nulo) { retornar falso }
            si (op == ">=") { retornar a >= b }
            si (op == "<=") { retornar a <= b }
            si (op == ">") { retornar a > b }
            retornar a < b
        }
    }
    sea v = _dl_valor(t, vars)
    retornar v != nulo y v != falso y v != 0 y v != ""
}

funcion _dl_efecto(e, vars) {
    sea t = texto_recortar(e)
    para op en ["+=", "-=", "="] {
        sea i = texto_indice(t, op)
        si (i > 0) {
            sea k = texto_recortar(subcadena(t, 0, i))
            sea v = _dl_valor(subcadena(t, i + longitud(op), longitud(t)), vars)
            si (op == "+=") { vars[k] = (vars[k] ?? 0) + v }
            si (op == "-=") { vars[k] = (vars[k] ?? 0) - v }
            si (op == "=") { vars[k] = v }
            retornar nulo
        }
    }
    lanzar "dialogo: efecto inválido: " + e
}

// "texto ~ efecto ~ efecto -> destino" → [texto, [efectos], destino]
funcion _dl_partes(t) {
    sea destino = nulo
    sea flecha = texto_indice(t, "->")
    sea cuerpo = t
    si (flecha >= 0) {
        destino = texto_recortar(subcadena(t, flecha + 2, longitud(t)))
        cuerpo = subcadena(t, 0, flecha)
    }
    sea trozos = texto_dividir(cuerpo, "~")
    sea efectos = []
    sea i = 1
    mientras (i < longitud(trozos)) { efectos.agregar(trozos[i])  i = i + 1 }
    retornar [texto_recortar(trozos[0]), efectos, destino]
}

/// Lee el guion. vars: variables iniciales. Empieza en el primer nodo.
funcion dialogo_cargar(guion, vars) {
    sea nodos = {}
    sea primero = nulo
    sea actual = nulo
    sea n = 0
    para linea0 en texto_dividir("" + guion, "\n") {
        n = n + 1
        sea linea = texto_recortar(linea0)
        si (linea == "" o texto_empieza_con(linea, "//")) { } sino {
            si (texto_empieza_con(linea, "===")) {
                actual = texto_recortar(texto_reemplazar(linea, "=", ""))
                si (tiene_clave(nodos, actual)) { lanzar "dialogo: nodo repetido " + actual + " (línea " + n + ")" }
                nodos[actual] = {"lineas": [], "opciones": []}
                si (primero == nulo) { primero = actual }
            } sino {
                si (actual == nulo) { lanzar "dialogo: línea " + n + " fuera de un nodo (empieza con === nombre)" }
                si (texto_empieza_con(linea, "*")) {
                    sea t = texto_recortar(subcadena(linea, 1, longitud(linea)))
                    sea cond = nulo
                    si (texto_empieza_con(t, "(")) {
                        sea c = texto_indice(t, ")")
                        cond = subcadena(t, 1, c)
                        t = texto_recortar(subcadena(t, c + 1, longitud(t)))
                    }
                    si (texto_empieza_con(t, "[") == falso) { lanzar "dialogo: opción sin [texto] (línea " + n + ")" }
                    sea cierra = texto_indice(t, "]")
                    sea etiqueta = subcadena(t, 1, cierra)
                    sea p = _dl_partes(subcadena(t, cierra + 1, longitud(t)))
                    nodos[actual]["opciones"].agregar({"texto": etiqueta, "condicion": cond, "efectos": p[1], "destino": p[2], "linea": n})
                } sino {
                    sea p = nulo
                    si (texto_empieza_con(linea, "~")) { p = ["", texto_dividir(subcadena(linea, 1, longitud(linea)), "~"), nulo] } sino { p = _dl_partes(linea) }
                    nodos[actual]["lineas"].agregar({"texto": p[0], "efectos": p[1], "destino": p[2], "linea": n})
                }
            }
        }
    }
    si (primero == nulo) { lanzar "dialogo: el guion no tiene nodos" }
    // Validar destinos.
    para k en claves(nodos) {
        para x en nodos[k]["lineas"] { si (x["destino"] != nulo y x["destino"] != "FIN" y tiene_clave(nodos, x["destino"]) == falso) { lanzar "dialogo: el nodo " + x["destino"] + " no existe (línea " + x["linea"] + ")" } }
        para x en nodos[k]["opciones"] { si (x["destino"] != nulo y x["destino"] != "FIN" y tiene_clave(nodos, x["destino"]) == falso) { lanzar "dialogo: el nodo " + x["destino"] + " no existe (línea " + x["linea"] + ")" } }
    }
    retornar {"nodos": nodos, "nodo": primero, "vars": vars ?? {}, "fin": falso, "visitas": {}, "historial": [], "opciones_vivas": []}
}

funcion _dl_rellenar(t, vars) {
    sea r = t
    para k en claves(vars) {
        r = texto_reemplazar(r, "{{" + k + "}}", "" + vars[k])
        r = texto_reemplazar(r, "{{ " + k + " }}", "" + vars[k])
    }
    retornar r
}

/// Avanza hasta las próximas opciones o el fin: {"lineas": [{"quien", "texto"}],
/// "opciones": [{"indice", "texto"}], "fin"}.
funcion dialogo_paso(d) {
    sea lineas = []
    sea saltos = 0
    mientras (d["fin"] == falso) {
        saltos = saltos + 1
        si (saltos > 1000) { lanzar "dialogo: bucle infinito entre nodos" }
        sea nodo = d["nodos"][d["nodo"]]
        d["visitas"][d["nodo"]] = (d["visitas"][d["nodo"]] ?? 0) + 1
        d["vars"]["visitas_" + d["nodo"]] = d["visitas"][d["nodo"]]
        sea destino = nulo
        para l en nodo["lineas"] {
            si (destino == nulo) {
                para e en l["efectos"] { _dl_efecto(e, d["vars"]) }
                si (l["texto"] != "") {
                    sea t = _dl_rellenar(l["texto"], d["vars"])
                    sea dos = texto_indice(t, ":")
                    sea quien = nulo
                    si (dos > 0 y dos < 30 y texto_indice(subcadena(t, 0, dos), " ") < 0) { quien = subcadena(t, 0, dos)  t = texto_recortar(subcadena(t, dos + 1, longitud(t))) }
                    lineas.agregar({"quien": quien, "texto": t})
                    d["historial"].agregar({"quien": quien, "texto": t})
                }
                si (l["destino"] != nulo) { destino = l["destino"] }
            }
        }
        si (destino != nulo) {
            si (destino == "FIN") { d["fin"] = verdadero } sino { d["nodo"] = destino }
        } sino {
            sea vivas = []
            sea i = 0
            mientras (i < longitud(nodo["opciones"])) {
                sea o = nodo["opciones"][i]
                si (o["condicion"] == nulo o _dl_condicion(o["condicion"], d["vars"])) { vivas.agregar({"indice": longitud(vivas), "texto": _dl_rellenar(o["texto"], d["vars"]), "_o": o}) }
                i = i + 1
            }
            si (longitud(vivas) == 0) { d["fin"] = verdadero } sino {
                d["opciones_vivas"] = vivas
                sea pub = []
                para v en vivas { pub.agregar({"indice": v["indice"], "texto": v["texto"]}) }
                retornar {"lineas": lineas, "opciones": pub, "fin": falso}
            }
        }
    }
    retornar {"lineas": lineas, "opciones": [], "fin": verdadero}
}

/// Elige la opción (índice de las mostradas) y aplica sus efectos.
funcion dialogo_elegir(d, indice) {
    si (indice < 0 o indice >= longitud(d["opciones_vivas"])) { lanzar "dialogo: opción inválida " + indice }
    sea o = d["opciones_vivas"][indice]["_o"]
    d["historial"].agregar({"quien": "›", "texto": o["texto"]})
    para e en o["efectos"] { _dl_efecto(e, d["vars"]) }
    d["opciones_vivas"] = []
    si (o["destino"] == "FIN") { d["fin"] = verdadero } sino { si (o["destino"] != nulo) { d["nodo"] = o["destino"] } }
    retornar d
}

funcion dialogo_variable(d, nombre) {
    si (tiene_clave(d["vars"], nombre)) { retornar d["vars"][nombre] }
    retornar nulo
}

/// Juega en la terminal (usa "pregunta" para elegir).
funcion dialogo_jugar(d) {
    mientras (d["fin"] == falso) {
        sea p = dialogo_paso(d)
        para l en p["lineas"] {
            si (l["quien"] != nulo) { mostrar(l["quien"] + ": " + l["texto"]) } sino { mostrar(l["texto"]) }
        }
        si (p["fin"] == falso) {
            sea i = 0
            mientras (i < longitud(p["opciones"])) { mostrar("  " + (i + 1) + ") " + p["opciones"][i]["texto"])  i = i + 1 }
            sea r = leer("> ")
            sea n = 0
            intentar { n = a_numero(texto_recortar(r)) - 1 } capturar (e) { n = -1 }
            si (n >= 0 y n < longitud(p["opciones"])) { dialogo_elegir(d, n) } sino { mostrar("(elige un número)") }
        }
    }
}
