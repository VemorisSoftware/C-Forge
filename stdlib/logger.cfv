// stdlib/logger.cfv — registro de eventos por niveles: nombres en inglés del módulo "bitacora".
// English names for the "bitacora" module; both can be used together.

importar "bitacora"

funcion logger_new(nivel, formato) {
    sea b = bitacora_nueva(nivel, formato)
    b["idioma"] = "en"
    retornar b
}
funcion logger_to_list(b) { retornar bitacora_a_lista(b) }
funcion logger_records(b) { retornar b["registros"] }
funcion logger_with(b, campos) { retornar bitacora_con(b, campos) }
funcion logger_debug(b, mensaje, campos) { retornar bitacora_depuracion(b, mensaje, campos) }
funcion logger_info(b, mensaje, campos) { retornar bitacora_info(b, mensaje, campos) }
funcion logger_warn(b, mensaje, campos) { retornar bitacora_aviso(b, mensaje, campos) }
funcion logger_error(b, mensaje, campos) { retornar bitacora_error(b, mensaje, campos) }
