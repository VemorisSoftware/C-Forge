// stdlib/kubernetes.cfv — cliente de Kubernetes: nombres en inglés del módulo "orquesta".
// English names for the "orquesta" module; both can be used together.


importar "orquesta"

funcion _kubernetes_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_kubernetes_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _kubernetes_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _KUBERNETES_RES = {"nombre": "name", "cluster": "cluster", "usuario": "user", "espacio": "namespace", "actual": "current", "accion": "action", "tipo": "type", "objeto": "object"}
sea _KUBERNETES_OPT = {"path": "ruta", "context": "contexto", "server": "servidor", "transport": "transporte", "namespace": "espacio", "labels": "etiquetas", "fields": "campos", "limit": "limite", "container": "contenedor", "tail_lines": "ultimas", "since_seconds": "desde_segundos", "previous": "previo"}

funcion k8s_plural(kind) { retornar orquesta_plural(kind) }
funcion k8s_path(api_version, kind, ns, nombre, sub) { retornar orquesta_ruta(api_version, kind, ns, nombre, sub) }
funcion k8s_client(opciones) { retornar orquesta_cliente(_kubernetes_opt(opciones)) }
funcion k8s_load_kubeconfig(k, txt, contexto) { retornar orquesta_cargar_kubeconfig(k, txt, contexto) }
funcion k8s_contexts(txt) { retornar _kubernetes_tr(orquesta_contextos(txt), _KUBERNETES_RES) }
funcion k8s_list(k, api_version, kind, ns, opciones) { retornar orquesta_listar(k, api_version, kind, ns, _kubernetes_opt(opciones)) }
funcion k8s_get(k, api_version, kind, ns, nombre) { retornar orquesta_obtener(k, api_version, kind, ns, nombre) }
funcion k8s_create(k, obj, opciones) { retornar orquesta_crear(k, obj, _kubernetes_opt(opciones)) }
funcion k8s_replace(k, obj) { retornar orquesta_reemplazar(k, obj) }
funcion k8s_patch(k, api_version, kind, ns, nombre, parche, tipo_p, sub) { retornar orquesta_parchar(k, api_version, kind, ns, nombre, parche, tipo_p, sub) }
funcion k8s_delete(k, api_version, kind, ns, nombre, opciones) { retornar orquesta_borrar(k, api_version, kind, ns, nombre, _kubernetes_opt(opciones)) }
funcion k8s_scale(k, kind, ns, nombre, replicas) { retornar orquesta_escalar(k, kind, ns, nombre, replicas) }
funcion k8s_restart(k, kind, ns, nombre, cuando) { retornar orquesta_reiniciar(k, kind, ns, nombre, cuando) }
funcion k8s_logs(k, ns, pod, opciones) { retornar orquesta_logs(k, ns, pod, _kubernetes_opt(opciones)) }
funcion k8s_apply(k, yaml_texto) { retornar _kubernetes_tr(orquesta_aplicar(k, yaml_texto), _KUBERNETES_RES) }
funcion k8s_events(texto) { retornar _kubernetes_tr(orquesta_eventos(texto), _KUBERNETES_RES) }
funcion k8s_watch(k, api_version, kind, ns, opciones) { retornar _kubernetes_tr(orquesta_vigilar(k, api_version, kind, ns, _kubernetes_opt(opciones)), _KUBERNETES_RES) }
funcion k8s_object(api_version, kind, nombre, ns, spec, etiquetas) { retornar orquesta_objeto(api_version, kind, nombre, ns, spec, etiquetas) }

funcion _kubernetes_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_KUBERNETES_OPT[k] ?? k] = o[k] }
    retornar r
}
