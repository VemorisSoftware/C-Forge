// stdlib/resilience.cfv — reintentos y cortacircuitos: nombres en inglés del módulo "resiste".
// English names for the "resiste" module; both can be used together.

importar "resiste"

funcion retry(f, intentos, espera_ms, factor) { retornar resiste_reintentar(f, intentos, espera_ms, factor) }
funcion breaker_new(umbral, enfriamiento_ms) { retornar resiste_cortacircuitos(umbral, enfriamiento_ms) }
/// "closed", "open" or "half-open".
funcion breaker_state(c) { retornar {"cerrado": "closed", "abierto": "open", "semiabierto": "half-open"}[resiste_estado(c)] }
funcion breaker_call(c, f) { retornar resiste_llamar(c, f) }
