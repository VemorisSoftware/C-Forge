// stdlib/orm.cfv — esquemas y consultas SQL: nombres en inglés del módulo "modelo_db".
// English names for the "modelo_db" module; both can be used together.


importar "modelo_db"

funcion _orm_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_orm_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _orm_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _ORM_OPT = {"primary": "primaria", "autoincrement": "auto", "nullable": "nulo", "unique": "unico", "default": "defecto", "references": "ref", "on_delete": "al_borrar", "length": "largo", "columns": "columnas", "where": "donde", "order": "orden", "limit": "limite", "offset": "desde", "join": "unir", "group": "agrupar", "returning": "retornar", "on_conflict": "al_conflicto"}

funcion orm_column(tipo_, opciones) { retornar modelo_col(tipo_, _orm_opt(opciones)) }
funcion orm_table(nombre, columnas, indices) { retornar modelo_tabla(nombre, columnas, indices) }
funcion orm_schema(tablas) { retornar modelo_esquema(tablas) }
funcion orm_create_sql(t, dialecto) { retornar modelo_crear_sql(t, dialecto) }
funcion orm_ddl(esquema, dialecto) { retornar modelo_ddl(esquema, dialecto) }
funcion orm_migration(viejo, nuevo, dialecto) { retornar modelo_migracion(viejo, nuevo, dialecto) }
funcion orm_migrate(db, esquema) { retornar modelo_migrar(db, esquema) }
funcion orm_eq(c, v) { retornar modelo_igual(c, v) }
funcion orm_ne(c, v) { retornar modelo_distinto(c, v) }
funcion orm_gt(c, v) { retornar modelo_mayor(c, v) }
funcion orm_gte(c, v) { retornar modelo_mayor_igual(c, v) }
funcion orm_lt(c, v) { retornar modelo_menor(c, v) }
funcion orm_lte(c, v) { retornar modelo_menor_igual(c, v) }
funcion orm_like(c, patron) { retornar modelo_como(c, patron) }
funcion orm_in(c, lista) { retornar modelo_en(c, lista) }
funcion orm_between(c, a, b) { retornar modelo_entre(c, a, b) }
funcion orm_is_null(c) { retornar modelo_es_nulo(c) }
funcion orm_not_null(c) { retornar modelo_no_nulo(c) }
funcion orm_and(conds) { retornar modelo_y(conds) }
funcion orm_or(conds) { retornar modelo_o(conds) }
funcion orm_not(cond) { retornar modelo_no(cond) }
funcion orm_select(tabla, opciones) { retornar modelo_select(tabla, _orm_opt(opciones)) }
funcion orm_insert(tabla, filas, opciones) { retornar modelo_insert(tabla, filas, _orm_opt(opciones)) }
funcion orm_update(tabla, cambios, donde) { retornar modelo_update(tabla, cambios, donde) }
funcion orm_delete(tabla, donde) { retornar modelo_delete(tabla, donde) }
funcion orm_sql(q, dialecto) { retornar modelo_sql(q, dialecto) }
funcion orm_all(db, q) { retornar modelo_todos(db, q) }
funcion orm_first(db, q) { retornar modelo_primero(db, q) }
funcion orm_run(db, q) { retornar modelo_ejecutar(db, q) }

funcion _orm_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_ORM_OPT[k] ?? k] = o[k] }
    retornar r
}
