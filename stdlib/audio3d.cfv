// stdlib/audio3d.cfv — audio 3D: nombres en inglés del módulo "espacial".
// English names for the "espacial" module; both can be used together.


importar "espacial"

funcion _audio3d_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_audio3d_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _audio3d_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _AUDIO3D_RES = {"ganancia": "gain", "distancia": "distance", "azimut": "azimuth", "elevacion": "elevation", "izquierda": "left", "derecha": "right", "tono": "pitch"}
sea _AUDIO3D_OPT = {"rate": "tasa", "model": "modelo", "speed_of_sound": "velocidad_sonido", "position": "posicion", "velocity": "velocidad", "direction": "direccion", "gain": "ganancia", "pitch": "tono", "loop": "bucle", "relative": "relativa", "ref_distance": "distancia_ref", "max_distance": "distancia_max", "inner_cone": "cono_interno", "outer_cone": "cono_externo", "outer_gain": "ganancia_externa", "reverb_send": "envio_reverb", "shadow": "sombra", "size": "tamano", "damping": "amortiguar"}

funcion audio3d_context(opciones) { retornar espacial_contexto(_audio3d_opt(opciones)) }
funcion audio3d_listener(ctx, valores) { retornar espacial_oyente(ctx, valores) }
funcion audio3d_source(ctx, sonido, opciones) { retornar espacial_fuente(ctx, sonido, _audio3d_opt(opciones)) }
funcion audio3d_set(f, valores) { retornar espacial_ajustar(f, valores) }
funcion audio3d_play(f) { retornar espacial_reproducir(f) }
funcion audio3d_pause(f) { retornar espacial_pausar(f) }
funcion audio3d_stop(f) { retornar espacial_detener(f) }
funcion audio3d_state(f) { retornar espacial_estado(f) }
funcion audio3d_cleanup(ctx) { retornar espacial_limpiar(ctx) }
funcion audio3d_attenuation(modelo, distancia, ref, maxd, rolloff) { retornar espacial_atenuacion(modelo, distancia, ref, maxd, rolloff) }
funcion audio3d_cone(angulo, interno, externo, ganancia_externa) { retornar espacial_cono(angulo, interno, externo, ganancia_externa) }
funcion audio3d_doppler(ctx, f) { retornar espacial_doppler(ctx, f) }
funcion audio3d_compute(ctx, f) { retornar _audio3d_tr(espacial_calcular(ctx, f), _AUDIO3D_RES) }
funcion audio3d_reverb(ctx, opciones) { retornar espacial_reverb(ctx, _audio3d_opt(opciones)) }
funcion audio3d_mix(ctx, cuadros) { retornar espacial_mezclar(ctx, cuadros) }
funcion audio3d_pcm(ctx, cuadros) { retornar espacial_pcm(ctx, cuadros) }
funcion audio3d_render(ctx, ms) { retornar espacial_renderizar(ctx, ms) }

funcion _audio3d_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_AUDIO3D_OPT[k] ?? k] = o[k] }
    retornar r
}
