// stdlib/dataframe.cfv — tablas de datos: nombres en inglés del módulo "tabla".
// English names for the "tabla" module; both can be used together.

importar "tabla"

funcion df_from_records(filas) { retornar tabla_de(filas) }
funcion df_from_columns(mapa, orden) { retornar tabla_columnas(mapa, orden) }
funcion df_from_csv(texto, separador, convertir) { retornar tabla_desde_csv(texto, separador, convertir) }
funcion df_to_csv(t, separador, seguro) { retornar tabla_csv(t, separador, seguro) }
funcion df_rows(t) { retornar tabla_filas(t) }
funcion df_columns(t) { retornar tabla_nombres(t) }
funcion df_len(t) { retornar tabla_largo(t) }
funcion df_column(t, c) { retornar tabla_columna(t, c) }
funcion df_select(t, cols) { retornar tabla_seleccionar(t, cols) }
funcion df_rename(t, cambios) { retornar tabla_renombrar(t, cambios) }
funcion df_filter(t, f) { retornar tabla_filtrar(t, f) }
funcion df_with_column(t, nombre, f) { retornar tabla_calcular(t, nombre, f) }
funcion df_sort(t, columnas, descendente) { retornar tabla_ordenar(t, columnas, descendente) }
funcion df_head(t, n) { retornar tabla_cabeza(t, n) }
funcion df_group_by(t, por, agregaciones) { retornar tabla_agrupar(t, por, agregaciones) }
funcion df_join(a, b, clave, como) { retornar tabla_unir(a, b, clave, como) }
funcion df_describe(t) { retornar tabla_describir(t) }
funcion df_to_string(t, limite) { retornar tabla_texto(t, limite) }
