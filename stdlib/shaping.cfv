// stdlib/shaping.cfv — moldeado de texto OpenType: nombres en inglés del módulo "grafia".
// English names for the "grafia" module; both can be used together.


importar "grafia"

funcion _shaping_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_shaping_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _shaping_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _SHAPING_RES = {"glifo": "glyph", "avance_x": "x_advance", "avance_y": "y_advance", "desplaz_x": "x_offset", "desplaz_y": "y_offset"}
sea _SHAPING_OPT = {"features": "rasgos", "script": "escritura", "language": "idioma"}

funcion shaping_font(datos) { retornar grafia_fuente(datos) }
funcion shaping_glyph(f, cp) { retornar grafia_glifo(f, cp) }
funcion shaping_advance(f, g) { retornar grafia_avance(f, g) }
funcion shaping_glyph_class(f, g) { retornar grafia_clase_glifo(f, g) }
funcion shaping_shape(f, texto, opciones) { retornar _shaping_tr(grafia_moldear(f, texto, _shaping_opt(opciones)), _SHAPING_RES) }
funcion shaping_width(f, texto, opciones) { retornar grafia_ancho(f, texto, _shaping_opt(opciones)) }
funcion shaping_features(f) { retornar grafia_rasgos(f) }

funcion _shaping_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_SHAPING_OPT[k] ?? k] = o[k] }
    retornar r
}
