// stdlib/geometry2d.cfv — geometría computacional: nombres en inglés del módulo "malla_geo".
// English names for the "malla_geo" module; both can be used together.

importar "malla_geo"

funcion _geometry2d_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_geometry2d_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _geometry2d_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _GEOMETRY2D_RES = {"centro": "center", "radio": "radius", "distancia": "distance"}

funcion geom_orientation(a, b, c) { retornar malla_orientacion(a, b, c) }
funcion geom_circumcenter(a, b, c) { retornar malla_circuncentro(a, b, c) }
funcion geom_delaunay(puntos) { retornar malla_delaunay(puntos) }
funcion geom_edges(triangulos) { retornar malla_aristas(triangulos) }
funcion geom_voronoi(puntos, caja) { retornar malla_voronoi(puntos, caja) }
funcion geom_signed_area(poli) { retornar malla_area(poli) }
funcion geom_triangulate(poli) { retornar malla_triangular(poli) }
funcion geom_is_convex(poli) { retornar malla_es_convexo(poli) }
funcion geom_clip(poli, recorte) { retornar malla_recortar(poli, recorte) }
funcion geom_segment_intersection(a, b, c, d) { retornar malla_interseccion(a, b, c, d) }
funcion geom_min_enclosing_circle(puntos) { retornar _geometry2d_tr(malla_circulo_minimo(puntos), _GEOMETRY2D_RES) }
funcion geom_closest_pair(puntos) { retornar _geometry2d_tr(malla_par_cercano(puntos), _GEOMETRY2D_RES) }
funcion geom_locate(puntos, triangulos, p) { retornar malla_localizar(puntos, triangulos, p) }
funcion geom_interpolate(puntos, valores, triangulos, p) { retornar malla_interpolar(puntos, valores, triangulos, p) }
