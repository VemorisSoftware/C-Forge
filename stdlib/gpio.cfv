// stdlib/gpio.cfv — GPIO, I2C, SPI y PWM: nombres en inglés del módulo "pines".
// English names for the "pines" module; both can be used together.

importar "pines"

funcion _gpio_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_gpio_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _gpio_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _GPIO_RES = {"ruta": "path", "nombre": "name", "etiqueta": "label", "lineas": "lines", "linea": "line", "consumidor": "consumer", "usada": "used", "direccion": "direction", "activo_bajo": "active_low", "flancos": "edges", "sesgo": "bias", "drenador": "drive", "antirrebote_us": "debounce_us", "flanco": "edge", "temperatura": "temperature", "presion": "pressure", "humedad": "humidity"}

funcion gpio_chips() { retornar _gpio_tr(pines_chips(), _GPIO_RES) }
funcion gpio_chip(cual) { retornar pines_chip(cual) }
funcion gpio_close(x) { retornar pines_cerrar(x) }
funcion gpio_simulated(n, opciones) { retornar pines_simulado(n, opciones) }
funcion gpio_line_by_name(chip, nombre) { retornar pines_linea_por_nombre(chip, nombre) }
funcion gpio_read(pedido) { retornar pines_leer(pedido) }
funcion gpio_write(pedido, valores) { retornar pines_escribir(pedido, valores) }
funcion gpio_release(pedido) { retornar pines_soltar(pedido) }
funcion gpio_sim_drive(chip, linea, nivel, ns) { retornar pines_sim_poner(chip, linea, nivel, ns) }
funcion gpio_sim_level(chip, linea) { retornar pines_sim_nivel(chip, linea) }
funcion gpio_board() { retornar pines_placa() }
funcion gpio_bcm(fisico) { retornar pines_bcm(fisico) }
funcion gpio_physical(bcm) { retornar pines_fisico(bcm) }
funcion gpio_board_chip() { retornar pines_chip_placa() }
funcion i2c_open(bus) { retornar pines_i2c(bus) }
funcion i2c_simulated() { retornar pines_i2c_simulado() }
funcion i2c_sim_device(bus, dir, registros) { retornar pines_sim_i2c(bus, dir, registros) }
funcion i2c_write(bus, dir, bytes) { retornar pines_i2c_escribir(bus, dir, bytes) }
funcion i2c_read(bus, dir, n) { retornar pines_i2c_leer(bus, dir, n) }
funcion i2c_write_read(bus, dir, bytes, n) { retornar pines_i2c_escribir_leer(bus, dir, bytes, n) }
funcion i2c_read_register(bus, dir, registro, n) { retornar pines_i2c_leer_registro(bus, dir, registro, n) }
funcion i2c_read_byte(bus, dir, registro) { retornar pines_i2c_leer_byte(bus, dir, registro) }
funcion i2c_write_register(bus, dir, registro, datos) { retornar pines_i2c_escribir_registro(bus, dir, registro, datos) }
funcion i2c_scan(bus) { retornar pines_i2c_escanear(bus) }
funcion spi_simulated(responder) { retornar pines_spi_simulado(responder) }
funcion spi_transfer(spi, bytes) { retornar pines_spi_transferir(spi, bytes) }
funcion pwm_open(chip, canal, raiz) { retornar pines_pwm(chip, canal, raiz) }
funcion pwm_servo(pwm, angulo, opciones) { retornar pines_pwm_servo(pwm, angulo, opciones) }
funcion bme280_open(bus, dir) { retornar pines_bme280(bus, dir) }
funcion bme280_compensate(s, adc_t, adc_p, adc_h) { retornar _gpio_tr(pines_bme280_compensar(s, adc_t, adc_p, adc_h), _GPIO_RES) }
funcion bme280_read(s) { retornar _gpio_tr(pines_bme280_leer(s), _GPIO_RES) }
funcion ssd1306_open(bus, dir, ancho, alto) { retornar pines_ssd1306(bus, dir, ancho, alto) }
funcion ssd1306_pixel(p, x, py, encendido) { retornar pines_ssd1306_pixel(p, x, py, encendido) }
funcion ssd1306_clear(p) { retornar pines_ssd1306_limpiar(p) }
funcion ssd1306_text(p, x, py, texto) { retornar pines_ssd1306_texto(p, x, py, texto) }
funcion ssd1306_image(p, img, umbral) { retornar pines_ssd1306_imagen(p, img, umbral) }
funcion ssd1306_show(p) { retornar pines_ssd1306_mostrar(p) }
funcion ssd1306_contrast(p, valor) { retornar pines_ssd1306_contraste(p, valor) }
funcion ssd1306_invert(p, si_) { retornar pines_ssd1306_invertir(p, si_) }

sea _GPIO_OP = {"mode": "modo", "value": "valor", "active_low": "activo_bajo", "bias": "sesgo", "drive": "drenador", "edges": "flancos", "debounce_us": "antirrebote_us", "consumer": "consumidor", "realtime_clock": "reloj_real",
    "speed": "velocidad", "bits": "bits", "frequency": "frecuencia", "period_ns": "periodo_ns", "duty": "ciclo", "duty_ns": "activo_ns", "polarity": "polaridad", "enabled": "activo", "min_us": "min_us", "max_us": "max_us",
    "rx_len": "rx_n", "delay_us": "espera_us", "cs_change": "cs_cambio"}
sea _GPIO_VAL = {"input": "entrada", "output": "salida", "up": "arriba", "down": "abajo", "disabled": "ninguno", "none": "ninguno", "open_drain": "abierto", "open_source": "fuente",
    "rising": "subida", "falling": "bajada", "both": "ambos", "inversed": "invertida", "inverted": "invertida"}
funcion _gpio_op(o) {
    si (o == nulo) { retornar nulo }
    sea r = {}
    para k en claves(o) {
        sea v = o[k]
        si (tipo(v) == "texto") { v = _GPIO_VAL[v] ?? v }
        r[_GPIO_OP[k] ?? k] = v
    }
    retornar r
}
// Request lines. options: "mode" ("input"/"output"), "value", "active_low",
// "bias" ("up", "down", "disabled"), "drive" ("open_drain", "open_source"),
// "edges" ("rising", "falling", "both"), "debounce_us", "consumer".
funcion gpio_request(chip, lines, options) { retornar pines_pedir(chip, lines, _gpio_op(options)) }
funcion gpio_reconfigure(request, options) { retornar pines_configurar(request, _gpio_op(options)) }
// Open /dev/spidevB.C. options: "speed" (Hz), "mode" (0-3), "bits".
funcion spi_open(bus, cs, options) { retornar pines_spi(bus, cs, _gpio_op(options)) }
sea _GPIO_EN = {"entrada": "input", "salida": "output", "arriba": "up", "abajo": "down", "ninguno": "disabled", "abierto": "open_drain", "fuente": "open_source", "subida": "rising", "bajada": "falling", "ambos": "both"}
funcion _gpio_en(m) {
    sea r = {}
    para k en claves(m) {
        sea v = m[k]
        si (tipo(v) == "texto") { v = _GPIO_EN[v] ?? v }
        r[_GPIO_RES[k] ?? k] = v
    }
    retornar r
}
// Edge events: [{"line", "edge" ("rising"/"falling"), "ns", "seq"}].
funcion gpio_events(request, wait_ms) {
    sea r = []
    para e en pines_eventos(request, wait_ms) { r.agregar(_gpio_en(e)) }
    retornar r
}
// Line info: name, consumer, used, direction, active_low, edges, bias, drive, debounce_us.
funcion gpio_line_info(chip, line) { retornar _gpio_en(pines_info(chip, line)) }
// Several transfers: [{"tx", "rx_len", "speed", "delay_us", "cs_change", "bits"}].
funcion spi_transfers(spi, list) {
    sea l = []
    para t en list { l.agregar(_gpio_op(t)) }
    retornar pines_spi_transferencias(spi, l)
}
// Configure PWM: "frequency" or "period_ns", "duty" (0-1) or "duty_ns",
// "polarity" ("normal"/"inverted"), "enabled".
funcion pwm_configure(pwm, options) { retornar pines_pwm_configurar(pwm, _gpio_op(options)) }
