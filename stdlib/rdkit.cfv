// stdlib/rdkit.cfv — Química con SMILES (estilo RDKit): nombres en inglés del módulo "molecula".
// English names for the "molecula" module; both can be used together.

importar "molecula"

funcion _rdkit_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_rdkit_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _rdkit_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _RDKIT_RES = {"formula": "formula", "peso": "mol_wt", "masa_exacta": "exact_mol_wt", "atomos_pesados": "heavy_atoms", "hidrogenos": "hydrogens", "anillos": "rings", "anillos_aromaticos": "aromatic_rings", "aceptores": "acceptors", "donadores": "donors", "rotables": "rotatable_bonds", "tpsa": "tpsa", "carga": "charge", "cumple": "passes", "violaciones": "violations"}

funcion mol_from_smiles(smiles) { retornar molecula_leer(smiles) }
funcion mol_to_smiles(m) { retornar molecula_smiles(m) }
funcion calc_mol_formula(m) { retornar molecula_formula(m) }
funcion mol_wt(m) { retornar molecula_peso(m) }
funcion exact_mol_wt(m) { retornar molecula_masa_exacta(m) }
funcion num_heavy_atoms(m) { retornar molecula_atomos_pesados(m) }
funcion num_hydrogens(m) { retornar molecula_hidrogenos(m) }
funcion formal_charge(m) { retornar molecula_carga(m) }
funcion num_rings(m) { retornar molecula_anillos(m) }
funcion num_aromatic_rings(m) { retornar molecula_anillos_aromaticos(m) }
funcion no_count(m) { retornar molecula_aceptores(m) }
funcion nhoh_count(m) { retornar molecula_donadores(m) }
funcion num_rotatable_bonds(m) { retornar molecula_rotables(m) }
funcion calc_tpsa(m) { retornar molecula_tpsa(m) }
funcion mol_descriptors(m) { retornar _rdkit_tr(molecula_descriptores(m), _RDKIT_RES) }
funcion lipinski(m) { retornar _rdkit_tr(molecula_lipinski(m), _RDKIT_RES) }
funcion get_substruct_matches(m, patron) { retornar molecula_buscar(m, patron) }
funcion has_substruct_match(m, patron) { retornar molecula_contiene(m, patron) }
