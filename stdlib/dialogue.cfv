// stdlib/dialogue.cfv — narrativa interactiva: nombres en inglés del módulo "dialogo".
// English names for the "dialogo" module; both can be used together.

importar "dialogo"

funcion dialogue_load(guion, vars) { retornar dialogo_cargar(guion, vars) }
/// {"lines": [{"speaker", "text"}], "options": [{"index", "text"}], "done"}
funcion dialogue_step(d) {
    sea p = dialogo_paso(d)
    sea lines = []
    para l en p["lineas"] { lines.agregar({"speaker": l["quien"], "text": l["texto"]}) }
    sea opts = []
    para o en p["opciones"] { opts.agregar({"index": o["indice"], "text": o["texto"]}) }
    retornar {"lines": lines, "options": opts, "done": p["fin"]}
}
funcion dialogue_choose(d, indice) { retornar dialogo_elegir(d, indice) }
funcion dialogue_var(d, nombre) { retornar dialogo_variable(d, nombre) }
funcion dialogue_play(d) { retornar dialogo_jugar(d) }
