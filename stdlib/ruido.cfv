// stdlib/ruido.cfv — ruido procedural para terrenos, nubes, texturas y
// mundos generados: Perlin mejorado (2D/3D), simplex 2D, valor, celular
// (Worley) y fractal (fBm, turbulento, crestas). Determinista por semilla.
// Inspirada en FastNoiseLite (MIT). En inglés: importar "noise".
//
//   importar "ruido"
//   sea r = ruido_nuevo(1234)
//   ruido_perlin(r, x * 0.01, y * 0.01)                         // −1 … 1
//   ruido_fractal(r, x * 0.005, y * 0.005, {"octavas": 5})      // terreno
//   ruido_mapa(r, 64, 64, 0.05)                                 // filas de 0 … 1

funcion ruido_nuevo(semilla) {
    sea s = piso(absoluto(semilla ?? 1337)) % 2147483646 + 1
    sea p = []
    sea i = 0
    mientras (i < 256) { p.agregar(i)  i = i + 1 }
    // Barajado de Fisher–Yates con Park–Miller.
    i = 255
    mientras (i > 0) {
        s = (s * 48271) % 2147483647
        sea j = s % (i + 1)
        sea t = p[i]  p[i] = p[j]  p[j] = t
        i = i - 1
    }
    sea perm = []
    i = 0
    mientras (i < 512) { perm.agregar(p[i % 256])  i = i + 1 }
    retornar {"perm": perm, "semilla": semilla ?? 1337}
}

funcion _rd_suave(t) { retornar t * t * t * (t * (t * 6 - 15) + 10) }
funcion _rd_lerp(a, b, t) { retornar a + t * (b - a) }

funcion _rd_grad2(h, x, yv) {
    sea k = h % 8
    si (k == 0) { retornar x + yv }
    si (k == 1) { retornar 0 - x + yv }
    si (k == 2) { retornar x - yv }
    si (k == 3) { retornar 0 - x - yv }
    si (k == 4) { retornar x }
    si (k == 5) { retornar 0 - x }
    si (k == 6) { retornar yv }
    retornar 0 - yv
}

funcion _rd_grad3(h, x, yv, z) {
    sea k = h % 16
    sea u = yv
    si (k < 8) { u = x }
    sea v = z
    si (k < 4) { v = yv } sino { si (k == 12 o k == 14) { v = x } }
    sea a = u
    si (k % 2 == 1) { a = 0 - u }
    sea b = v
    si ((cociente(k, 2)) % 2 == 1) { b = 0 - v }
    retornar a + b
}

/// Perlin mejorado. Con z da la versión 3D (animar: z = tiempo).
funcion ruido_perlin(r, x, yv, z) {
    sea p = r["perm"]
    si (z != nulo) {
        sea X = piso(x)
        sea Y = piso(yv)
        sea Z = piso(z)
        sea xf = x - X
        sea yf = yv - Y
        sea zf = z - Z
        X = ((X % 256) + 256) % 256
        Y = ((Y % 256) + 256) % 256
        Z = ((Z % 256) + 256) % 256
        sea u = _rd_suave(xf)
        sea v = _rd_suave(yf)
        sea w = _rd_suave(zf)
        sea A = p[X] + Y
        sea AA = p[A] + Z
        sea AB = p[A + 1] + Z
        sea B = p[X + 1] + Y
        sea BA = p[B] + Z
        sea BB = p[B + 1] + Z
        retornar _rd_lerp(
            _rd_lerp(_rd_lerp(_rd_grad3(p[AA], xf, yf, zf), _rd_grad3(p[BA], xf - 1, yf, zf), u), _rd_lerp(_rd_grad3(p[AB], xf, yf - 1, zf), _rd_grad3(p[BB], xf - 1, yf - 1, zf), u), v),
            _rd_lerp(_rd_lerp(_rd_grad3(p[AA + 1], xf, yf, zf - 1), _rd_grad3(p[BA + 1], xf - 1, yf, zf - 1), u), _rd_lerp(_rd_grad3(p[AB + 1], xf, yf - 1, zf - 1), _rd_grad3(p[BB + 1], xf - 1, yf - 1, zf - 1), u), v), w)
    }
    sea X = piso(x)
    sea Y = piso(yv)
    sea xf = x - X
    sea yf = yv - Y
    X = ((X % 256) + 256) % 256
    Y = ((Y % 256) + 256) % 256
    sea u = _rd_suave(xf)
    sea v = _rd_suave(yf)
    sea aa = p[p[X] + Y]
    sea ab = p[p[X] + Y + 1]
    sea ba = p[p[X + 1] + Y]
    sea bb = p[p[X + 1] + Y + 1]
    // ×0.7071 lleva el rango teórico de ±√2/2·2 a ≈ ±1.
    retornar _rd_lerp(_rd_lerp(_rd_grad2(aa, xf, yf), _rd_grad2(ba, xf - 1, yf), u), _rd_lerp(_rd_grad2(ab, xf, yf - 1), _rd_grad2(bb, xf - 1, yf - 1), u), v) * 0.7071
}

/// Simplex 2D (menos artefactos en diagonales).
funcion ruido_simplex(r, x, yv) {
    sea p = r["perm"]
    sea F2 = 0.3660254037844386
    sea G2 = 0.21132486540518713
    sea s = (x + yv) * F2
    sea i = piso(x + s)
    sea j = piso(yv + s)
    sea t = (i + j) * G2
    sea x0 = x - (i - t)
    sea y0 = yv - (j - t)
    sea i1 = 0
    sea j1 = 1
    si (x0 > y0) { i1 = 1  j1 = 0 }
    sea x1 = x0 - i1 + G2
    sea y1 = y0 - j1 + G2
    sea x2 = x0 - 1 + 2 * G2
    sea y2 = y0 - 1 + 2 * G2
    sea ii = ((i % 256) + 256) % 256
    sea jj = ((j % 256) + 256) % 256
    sea n = 0
    sea t0 = 0.5 - x0 * x0 - y0 * y0
    si (t0 > 0) { t0 = t0 * t0  n = n + t0 * t0 * _rd_grad2(p[ii + p[jj]], x0, y0) }
    sea t1 = 0.5 - x1 * x1 - y1 * y1
    si (t1 > 0) { t1 = t1 * t1  n = n + t1 * t1 * _rd_grad2(p[ii + i1 + p[jj + j1]], x1, y1) }
    sea t2 = 0.5 - x2 * x2 - y2 * y2
    si (t2 > 0) { t2 = t2 * t2  n = n + t2 * t2 * _rd_grad2(p[ii + 1 + p[jj + 1]], x2, y2) }
    retornar 70 * n
}

funcion _rd_hash(r, x, yv) {
    sea p = r["perm"]
    retornar p[(p[((x % 256) + 256) % 256] + ((yv % 256) + 256) % 256) % 256]
}

/// Ruido de valor (más "cuadrado", barato).
funcion ruido_valor(r, x, yv) {
    sea X = piso(x)
    sea Y = piso(yv)
    sea u = _rd_suave(x - X)
    sea v = _rd_suave(yv - Y)
    sea a = _rd_hash(r, X, Y) / 127.5 - 1
    sea b = _rd_hash(r, X + 1, Y) / 127.5 - 1
    sea c = _rd_hash(r, X, Y + 1) / 127.5 - 1
    sea d = _rd_hash(r, X + 1, Y + 1) / 127.5 - 1
    retornar _rd_lerp(_rd_lerp(a, b, u), _rd_lerp(c, d, u), v)
}

/// Celular (Worley): distancia al punto más cercano (0 … ~1). Bueno para
/// piedras, células, agua.
funcion ruido_celular(r, x, yv) {
    sea X = piso(x)
    sea Y = piso(yv)
    sea mejor = 9
    sea dy = -1
    mientras (dy <= 1) {
        sea dx = -1
        mientras (dx <= 1) {
            sea h = _rd_hash(r, X + dx, Y + dy)
            sea px = X + dx + (h % 16) / 16 + 0.03125
            sea py = Y + dy + cociente(h, 16) / 16 + 0.03125
            sea d = raiz((px - x) * (px - x) + (py - yv) * (py - yv))
            si (d < mejor) { mejor = d }
            dx = dx + 1
        }
        dy = dy + 1
    }
    retornar minimo(1, mejor)
}

/// Fractal: suma de octavas. opciones: octavas (4), lacunaridad (2),
/// ganancia (0.5), tipo ("fbm" | "turbulento" | "crestas"), base
/// ("perlin" | "simplex" | "valor").
funcion ruido_fractal(r, x, yv, opciones) {
    sea o = opciones ?? {}
    sea octavas = o["octavas"] ?? 4
    si (tiene_clave(o, "octaves")) { octavas = o["octaves"] }
    sea lac = 2
    si (tiene_clave(o, "lacunaridad")) { lac = o["lacunaridad"] }
    si (tiene_clave(o, "lacunarity")) { lac = o["lacunarity"] }
    sea gan = 0.5
    si (tiene_clave(o, "ganancia")) { gan = o["ganancia"] }
    si (tiene_clave(o, "gain")) { gan = o["gain"] }
    sea tp = "fbm"
    si (tiene_clave(o, "tipo")) { tp = o["tipo"] }
    si (tiene_clave(o, "type")) { tp = o["type"] }
    si (tp == "turbulent") { tp = "turbulento" }
    si (tp == "ridged") { tp = "crestas" }
    sea base = "perlin"
    si (tiene_clave(o, "base")) { base = o["base"] }
    si (base == "value") { base = "valor" }
    sea suma = 0
    sea amp = 1
    sea frec = 1
    sea norma = 0
    sea k = 0
    mientras (k < octavas) {
        sea n = 0
        si (base == "simplex") { n = ruido_simplex(r, x * frec, yv * frec) } sino {
            si (base == "valor") { n = ruido_valor(r, x * frec, yv * frec) } sino { n = ruido_perlin(r, x * frec, yv * frec) }
        }
        si (tp == "turbulento") { n = absoluto(n) * 2 - 1 }
        si (tp == "crestas") { n = 1 - absoluto(n)  n = n * n * 2 - 1 }
        suma = suma + n * amp
        norma = norma + amp
        amp = amp * gan
        frec = frec * lac
        k = k + 1
    }
    retornar suma / norma
}

/// Matriz alto × ancho de valores 0 … 1 (fractal con escala dada).
funcion ruido_mapa(r, ancho, alto, escala, opciones) {
    sea e = escala ?? 0.05
    sea filas = []
    sea yv = 0
    mientras (yv < alto) {
        sea f = []
        sea x = 0
        mientras (x < ancho) {
            sea v = (ruido_fractal(r, x * e, yv * e, opciones) + 1) / 2
            f.agregar(maximo(0, minimo(1, v)))
            x = x + 1
        }
        filas.agregar(f)
        yv = yv + 1
    }
    retornar filas
}

/// Dibujo rápido en la terminal: " .:-=+*#%@" por valor.
funcion ruido_ascii(mapa) {
    sea paleta = " .:-=+*#%@"
    sea l = []
    para f en mapa {
        sea t = ""
        para v en f {
            sea i = piso(v * 9.999)
            t = t + subcadena(paleta, i, i + 1)
        }
        l.agregar(t)
    }
    retornar unir(l, "\n")
}
