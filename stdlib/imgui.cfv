// stdlib/imgui.cfv — GUI de modo inmediato al estilo de Dear ImGui: nombres en inglés del módulo "panel".
// English names for the "panel" module; both can be used together.


importar "panel"

funcion _imgui_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_imgui_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _imgui_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _IMGUI_OPT = {"width": "ancho", "height": "alto", "no_move": "fija", "no_title": "sin_titulo", "no_resize": "sin_redimensionar", "collapsed": "plegada", "decimals": "decimales", "format": "formato", "speed": "velocidad", "min": "minimo", "max": "maximo", "hint": "pista", "password": "contrasena", "open": "abierto", "leaf": "hoja", "widths": "anchos", "selected": "seleccion"}

funcion imgui_render(ctx) { retornar panel_terminar(ctx) }
funcion imgui_wants_mouse(ctx) { retornar panel_quiere_raton(ctx) }
funcion imgui_wants_keyboard(ctx) { retornar panel_quiere_teclado(ctx) }
funcion imgui_begin(ctx, titulo, opciones) { retornar panel_ventana(ctx, titulo, _imgui_opt(opciones)) }
funcion imgui_end(ctx) { retornar panel_fin_ventana(ctx) }
funcion imgui_same_line(ctx, espacio) { retornar panel_misma_linea(ctx, espacio) }
funcion imgui_spacing(ctx, alto) { retornar panel_espacio(ctx, alto) }
funcion imgui_separator(ctx) { retornar panel_separador(ctx) }
funcion imgui_indent(ctx) { retornar panel_sangrar(ctx) }
funcion imgui_unindent(ctx) { retornar panel_desangrar(ctx) }
funcion imgui_item_width(ctx, ancho) { retornar panel_ancho_elementos(ctx, ancho) }
funcion imgui_row(ctx, alto, anchos) { retornar panel_fila(ctx, alto, anchos) }
funcion imgui_is_item_hovered(ctx) { retornar panel_ultimo_caliente(ctx) }
funcion imgui_is_item_changed(ctx) { retornar panel_ultimo_cambio(ctx) }
funcion imgui_item_rect(ctx) { retornar panel_ultimo_rect(ctx) }
funcion imgui_tooltip(ctx, texto) { retornar panel_ayuda(ctx, texto) }
funcion imgui_text(ctx, texto) { retornar panel_texto(ctx, texto) }
funcion imgui_text_colored(ctx, texto, color) { retornar panel_texto_color(ctx, texto, color) }
funcion imgui_text_disabled(ctx, texto) { retornar panel_texto_apagado(ctx, texto) }
funcion imgui_label_text(ctx, etiqueta, valor) { retornar panel_etiqueta(ctx, etiqueta, valor) }
funcion imgui_button(ctx, etiqueta, opciones) { retornar panel_boton(ctx, etiqueta, _imgui_opt(opciones)) }
funcion imgui_small_button(ctx, etiqueta) { retornar panel_boton_chico(ctx, etiqueta) }
funcion imgui_checkbox(ctx, etiqueta, valor) { retornar panel_casilla(ctx, etiqueta, valor) }
funcion imgui_radio_button(ctx, etiqueta, activo) { retornar panel_radio(ctx, etiqueta, activo) }
funcion imgui_slider(ctx, etiqueta, valor, minimo_, maximo_, opciones) { retornar panel_deslizador(ctx, etiqueta, valor, minimo_, maximo_, _imgui_opt(opciones)) }
funcion imgui_slider_int(ctx, etiqueta, valor, minimo_, maximo_) { retornar panel_deslizador_entero(ctx, etiqueta, valor, minimo_, maximo_) }
funcion imgui_drag(ctx, etiqueta, valor, opciones) { retornar panel_arrastrar(ctx, etiqueta, valor, _imgui_opt(opciones)) }
funcion imgui_input_text(ctx, etiqueta, texto, opciones) { retornar panel_entrada_texto(ctx, etiqueta, texto, _imgui_opt(opciones)) }
funcion imgui_input_submitted(ctx) { retornar panel_texto_confirmado(ctx) }
funcion imgui_selectable(ctx, etiqueta, seleccionado) { retornar panel_seleccionable(ctx, etiqueta, seleccionado) }
funcion imgui_combo(ctx, etiqueta, indice, opciones_) { retornar panel_combo(ctx, etiqueta, indice, opciones_) }
funcion imgui_list_box(ctx, etiqueta, indice, items, alto_items) { retornar panel_lista(ctx, etiqueta, indice, items, alto_items) }
funcion imgui_tree_node(ctx, etiqueta, opciones) { retornar panel_arbol(ctx, etiqueta, _imgui_opt(opciones)) }
funcion imgui_tree_pop(ctx) { retornar panel_fin_arbol(ctx) }
funcion imgui_collapsing_header(ctx, etiqueta, opciones) { retornar panel_cabecera(ctx, etiqueta, _imgui_opt(opciones)) }
funcion imgui_tabs(ctx, etiqueta, nombres, indice) { retornar panel_pestanas(ctx, etiqueta, nombres, indice) }
funcion imgui_progress_bar(ctx, fraccion, texto) { retornar panel_progreso(ctx, fraccion, texto) }
funcion imgui_color_edit(ctx, etiqueta, color) { retornar panel_color(ctx, etiqueta, color) }
funcion imgui_table(ctx, etiqueta, columnas, filas, opciones) { retornar panel_tabla(ctx, etiqueta, columnas, filas, _imgui_opt(opciones)) }
funcion imgui_draw(lienzo, ctx, lista) { retornar panel_dibujar(lienzo, ctx, lista) }
funcion imgui_render_image(ctx, ancho, alto, fondo) { retornar panel_imagen(ctx, ancho, alto, fondo) }

funcion _imgui_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_IMGUI_OPT[k] ?? k] = o[k] }
    retornar r
}
sea _IMGUI_TECLAS = {"left": "izquierda", "right": "derecha", "up": "arriba", "down": "abajo", "home": "inicio", "end": "fin", "backspace": "retroceso", "delete": "suprimir", "enter": "intro", "tab": "tab", "escape": "escape"}
funcion _imgui_entrada(io) {
    sea e = io ?? {}
    sea t = []
    para k en e["keys"] ?? e["teclas"] ?? [] { t.agregar(_IMGUI_TECLAS[k] ?? k) }
    retornar {"raton": e["mouse"] ?? e["raton"] ?? [-1, -1], "botones": e["buttons"] ?? e["botones"] ?? [falso, falso, falso], "rueda": e["wheel"] ?? e["rueda"] ?? 0, "teclas": t, "texto": e["text"] ?? e["texto"] ?? ""}
}
funcion _imgui_contexto_op(o) {
    sea op = o ?? {}
    sea r = {}
    si (tiene_clave(op, "font")) { r["fuente"] = op["font"] }
    si (tiene_clave(op, "size")) { r["tam"] = op["size"] }
    si (tiene_clave(op, "rounding")) { r["redondeo"] = op["rounding"] }
    sea s = op["style"] ?? nulo
    si (s == "dark") { r["estilo"] = "oscuro" } sino si (s == "light") { r["estilo"] = "claro" } sino si (s != nulo) { r["estilo"] = s }
    retornar r
}

// Create a context. options: "font", "size", "style" ("dark", "light" or a map).
funcion imgui_context(options) { retornar panel_contexto(_imgui_contexto_op(options)) }
// Start a frame. io: "mouse" [x, y], "buttons" [left, right, middle],
// "wheel", "keys" (left, right, up, down, home, end, backspace, delete,
// enter, tab, escape) and "text".
funcion imgui_new_frame(ctx, io) { panel_cuadro(ctx, _imgui_entrada(io)) }
