// stdlib/rbac.cfv — control de acceso: nombres en inglés del módulo "permisos".
// English names for the "permisos" module; both can be used together.

importar "permisos"

funcion rbac_new() { retornar permisos_nuevo() }
funcion rbac_role(p, rol, hereda) { retornar permisos_rol(p, rol, hereda) }
funcion rbac_assign(p, sujeto, rol, dominio) { retornar permisos_asignar(p, sujeto, rol, dominio) }
funcion rbac_revoke(p, sujeto, rol, dominio) { retornar permisos_revocar(p, sujeto, rol, dominio) }
funcion rbac_allow(p, rol, recurso, accion, condicion, dominio) { retornar permisos_permitir(p, rol, recurso, accion, condicion, dominio) }
funcion rbac_deny(p, rol, recurso, accion, condicion, dominio) { retornar permisos_denegar(p, rol, recurso, accion, condicion, dominio) }
funcion rbac_roles(p, sujeto, dominio) { retornar permisos_roles(p, sujeto, dominio) }
funcion rbac_can(p, usuario, recurso, accion, dominio) { retornar permisos_puede(p, usuario, recurso, accion, dominio) }
funcion rbac_require(p, usuario, recurso, accion, dominio) { retornar permisos_exigir(p, usuario, recurso, accion, dominio) }
