// stdlib/helmet.cfv — cabeceras HTTP de seguridad: nombres en inglés del módulo "casco".
// English names for the "casco" module; both can be used together.

importar "casco"

funcion helmet_csp(directivas) { retornar casco_csp(directivas) }
funcion helmet_nonce() { retornar casco_nonce() }
funcion helmet_headers(opciones) { retornar casco_cabeceras(opciones) }
funcion helmet_text(h) { retornar casco_texto(h) }
