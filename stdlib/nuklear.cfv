// stdlib/nuklear.cfv — GUI embebible mínima al estilo de Nuklear: nombres en inglés del módulo "mini_gui".
// English names for the "mini_gui" module; both can be used together.

importar "mini_gui"

funcion nk_end(ctx) { retornar mini_terminar(ctx) }
funcion nk_layout_row_dynamic(ctx, alto, columnas) { retornar mini_fila_dinamica(ctx, alto, columnas) }
funcion nk_layout_row_static(ctx, alto, ancho, columnas) { retornar mini_fila_estatica(ctx, alto, ancho, columnas) }
funcion nk_layout_row(ctx, alto, proporciones) { retornar mini_fila(ctx, alto, proporciones) }
funcion nk_button_label(ctx, etiqueta) { retornar mini_boton(ctx, etiqueta) }
funcion nk_checkbox_label(ctx, etiqueta, valor) { retornar mini_casilla(ctx, etiqueta, valor) }
funcion nk_option_label(ctx, etiqueta, activo) { retornar mini_opcion(ctx, etiqueta, activo) }
funcion nk_slider(ctx, minimo_, valor, maximo_, paso) { retornar mini_deslizador(ctx, minimo_, valor, maximo_, paso) }
funcion nk_property(ctx, nombre, minimo_, valor, maximo_, paso, inc_por_pixel) { retornar mini_propiedad(ctx, nombre, minimo_, valor, maximo_, paso, inc_por_pixel) }
funcion nk_progress(ctx, actual, maximo_, modificable) { retornar mini_progreso(ctx, actual, maximo_, modificable) }
funcion nk_edit_string(ctx, texto, maximo_) { retornar mini_editar(ctx, texto, maximo_) }
funcion nk_combo(ctx, items, seleccionado) { retornar mini_combo(ctx, items, seleccionado) }
funcion nk_render_image(ctx, ancho, alto) { retornar mini_imagen(ctx, ancho, alto) }
funcion nk_commands(ctx) { retornar mini_comandos(ctx) }
sea _NK_TECLAS = {"left": "izquierda", "right": "derecha", "up": "arriba", "down": "abajo", "home": "inicio", "end": "fin", "backspace": "retroceso", "delete": "suprimir", "enter": "intro", "tab": "tab", "escape": "escape"}
funcion _nk_entrada(io) {
    sea e = io ?? {}
    sea t = []
    para k en e["keys"] ?? e["teclas"] ?? [] { t.agregar(_NK_TECLAS[k] ?? k) }
    retornar {"raton": e["mouse"] ?? e["raton"] ?? [-1, -1], "botones": e["buttons"] ?? e["botones"] ?? [falso, falso, falso], "rueda": e["wheel"] ?? e["rueda"] ?? 0, "teclas": t, "texto": e["text"] ?? e["texto"] ?? ""}
}
funcion _nk_contexto_op(o) {
    sea op = o ?? {}
    sea r = {}
    si (tiene_clave(op, "font")) { r["fuente"] = op["font"] }
    si (tiene_clave(op, "size")) { r["tam"] = op["size"] }
    si (tiene_clave(op, "rounding")) { r["redondeo"] = op["rounding"] }
    sea s = op["style"] ?? nulo
    si (s == "dark") { r["estilo"] = "oscuro" } sino si (s == "light") { r["estilo"] = "claro" } sino si (s != nulo) { r["estilo"] = s }
    retornar r
}

sea _NK_BANDERAS = {"movable": "movible", "scalable": "escalable", "minimizable": "minimizable", "title": "titulo", "border": "borde", "minimized": "minimizada"}
// Create a context. options: "font", "size", "style", "rounding".
funcion nk_context(options) { retornar mini_contexto(_nk_contexto_op(options)) }
// Input for the frame (same keys as imgui_new_frame).
funcion nk_input(ctx, io) { mini_entrada(ctx, _nk_entrada(io)) }
// Begin a window in rect [x, y, w, h]; flags: movable, scalable,
// minimizable, title, border, minimized.
funcion nk_begin(ctx, title, rect, flags) {
    sea b = []
    para f en flags ?? [] { b.agregar(_NK_BANDERAS[f] ?? f) }
    retornar mini_comenzar(ctx, title, rect, b)
}
// Label with alignment "left", "center" or "right".
funcion nk_label(ctx, text, align) {
    sea a = {"left": "izquierda", "center": "centro", "centered": "centro", "right": "derecha"}
    mini_etiqueta(ctx, text, a[align ?? "left"] ?? align)
}
