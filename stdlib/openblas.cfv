// stdlib/openblas.cfv — Álgebra lineal (estilo BLAS/LAPACK): nombres en inglés del módulo "blas".
// English names for the "blas" module; both can be used together.

importar "blas"

funcion _openblas_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_openblas_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _openblas_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _OPENBLAS_RES = {"lu": "lu", "piv": "ipiv", "signo": "sign", "singular": "singular", "valores": "values", "vectores": "vectors", "q": "q", "r": "r", "u": "u", "s": "s", "v": "v"}

funcion openblas_identity(n) { retornar blas_identidad(n) }
funcion openblas_transpose(A) { retornar blas_traspuesta(A) }
funcion openblas_ddot(x, y) { retornar blas_punto(x, y) }
funcion openblas_daxpy(a, x, y) { retornar blas_axpy(a, x, y) }
funcion openblas_dscal(a, x) { retornar blas_escalar(a, x) }
funcion openblas_dnrm2(x) { retornar blas_norma2(x) }
funcion openblas_dasum(x) { retornar blas_asum(x) }
funcion openblas_idamax(x) { retornar blas_iamax(x) }
funcion openblas_dgemv(alfa, A, x, beta, y, trans) { retornar blas_gemv(alfa, A, x, beta, y, trans) }
funcion openblas_dgemm(alfa, A, B, beta, C, trans_a, trans_b) { retornar blas_gemm(alfa, A, B, beta, C, trans_a, trans_b) }
funcion openblas_matmul(A, B) { retornar blas_mul(A, B) }
funcion openblas_dgetrf(A) { retornar _openblas_tr(blas_lu(A), _OPENBLAS_RES) }
funcion openblas_dgesv(A, b) { retornar blas_resolver(A, b) }
funcion openblas_det(A) { retornar blas_det(A) }
funcion openblas_inv(A) { retornar blas_inversa(A) }
funcion openblas_dpotrf(A) { retornar blas_cholesky(A) }
funcion openblas_dgeqrf(A) { retornar _openblas_tr(blas_qr(A), _OPENBLAS_RES) }
funcion openblas_dgels(A, b) { retornar blas_minimos_cuadrados(A, b) }
funcion openblas_dsyev(A) { retornar _openblas_tr(blas_propios_simetrica(A), _OPENBLAS_RES) }
funcion openblas_dgesvd(A) { retornar _openblas_tr(blas_svd(A), _OPENBLAS_RES) }
funcion openblas_matrix_rank(A, tol) { retornar blas_rango(A, tol) }
funcion openblas_cond(A) { retornar blas_condicion(A) }
funcion openblas_pinv(A) { retornar blas_pseudoinversa(A) }
