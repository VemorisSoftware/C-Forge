// stdlib/tracing.cfv — trazas distribuidas: nombres en inglés del módulo "traza".
// English names for the "traza" module; both can be used together.

importar "traza"

funcion tracing_new(servicio, muestreo) { retornar traza_nuevo(servicio, muestreo) }
funcion tracing_with_clock(t, reloj) { retornar traza_con_reloj(t, reloj) }
funcion tracing_continue(t, cabeceras) { retornar traza_continuar(t, cabeceras) }
funcion tracing_start(t, nombre, atributos) { retornar traza_iniciar(t, nombre, atributos) }
funcion tracing_attribute(s, clave, valor) { retornar traza_atributo(s, clave, valor) }
funcion tracing_event(s, nombre, atributos, t) { retornar traza_evento(s, nombre, atributos, t) }
funcion tracing_status(s, estado, mensaje) { retornar traza_estado(s, estado, mensaje) }
funcion tracing_end(t, s) { retornar traza_terminar(t, s) }
funcion tracing_span(t, nombre, f, atributos) { retornar traza_span(t, nombre, f, atributos) }
funcion tracing_inject(t) { retornar traza_propagar(t) }
funcion tracing_spans(t) { retornar traza_spans(t) }
funcion tracing_otlp(t) { retornar traza_otlp(t) }
funcion tracing_render(t) { retornar traza_texto(t) }
