// stdlib/gsl.cfv — Funciones especiales y EDO (estilo GSL): nombres en inglés del módulo "cientifica".
// English names for the "cientifica" module; both can be used together.


importar "cientifica"

funcion _gsl_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_gsl_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _gsl_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _GSL_RES = {"pasos": "steps", "rechazados": "rejected", "valor": "value", "error": "error", "evaluaciones": "evaluations"}
sea _GSL_OPT = {"tolerance": "tolerancia", "max_intervals": "max_intervalos", "detail": "detalle", "steps": "pasos", "points": "puntos", "max_steps": "max_pasos", "step": "paso", "rtol": "rtol", "atol": "atol"}

funcion gsl_inf() { retornar cientifica_infinito() }
funcion gsl_gamma(x) { retornar cientifica_gamma(x) }
funcion gsl_lngamma(x) { retornar cientifica_lgamma(x) }
funcion gsl_beta(a, b) { retornar cientifica_beta(a, b) }
funcion gsl_psi(x) { retornar cientifica_digamma(x) }
funcion gsl_zeta(s) { retornar cientifica_zeta(s) }
funcion gsl_erf(x) { retornar cientifica_erf(x) }
funcion gsl_erfc(x) { retornar cientifica_erfc(x) }
funcion gsl_gamma_inc_P(a, x) { retornar cientifica_gamma_inc(a, x) }
funcion gsl_gamma_inc_Q(a, x) { retornar cientifica_gamma_inc_sup(a, x) }
funcion gsl_beta_inc(a, b, x) { retornar cientifica_beta_inc(a, b, x) }
funcion gsl_bessel_J0(x) { retornar cientifica_bessel_j0(x) }
funcion gsl_bessel_J1(x) { retornar cientifica_bessel_j1(x) }
funcion gsl_bessel_Jn(n, x) { retornar cientifica_bessel_jn(n, x) }
funcion gsl_bessel_Y0(x) { retornar cientifica_bessel_y0(x) }
funcion gsl_bessel_Y1(x) { retornar cientifica_bessel_y1(x) }
funcion gsl_bessel_Yn(n, x) { retornar cientifica_bessel_yn(n, x) }
funcion gsl_ellint_Kcomp(m) { retornar cientifica_eliptica_k(m) }
funcion gsl_ellint_Ecomp(m) { retornar cientifica_eliptica_e(m) }
funcion gsl_odeiv_rk4(f, t0, y0, t1, pasos) { retornar _gsl_tr(cientifica_rk4(f, t0, y0, t1, pasos), _GSL_RES) }
funcion gsl_ode_solve(f, t0, y0, t1, opciones) { retornar _gsl_tr(cientifica_edo(f, t0, y0, t1, _gsl_opt(opciones)), _GSL_RES) }
funcion gsl_integration_qag(f, a, b, opciones) { retornar cientifica_integrar(f, a, b, _gsl_opt(opciones)) }
funcion gsl_deriv_central(f, x, h) { retornar cientifica_derivada(f, x, h) }
funcion gsl_root_brent(f, a, b, tolerancia) { retornar cientifica_raiz(f, a, b, tolerancia) }
funcion gsl_min_brent(f, a, b, tolerancia) { retornar _gsl_tr(cientifica_minimo(f, a, b, tolerancia), _GSL_RES) }
funcion gsl_interp_linear(xs, ys, x) { retornar cientifica_interpolar(xs, ys, x) }
funcion gsl_spline_init(xs, ys) { retornar cientifica_spline(xs, ys) }
funcion gsl_spline_eval(s, x, derivada) { retornar cientifica_spline_valor(s, x, derivada) }

funcion _gsl_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_GSL_OPT[k] ?? k] = o[k] }
    retornar r
}
