// stdlib/schema.cfv — validación con esquemas: nombres en inglés del módulo "esquema".
// English names for the "esquema" module; both can be used together.

importar "esquema"

funcion schema_string() { retornar esquema_texto() }
funcion schema_number() { retornar esquema_numero() }
funcion schema_int() { retornar esquema_entero() }
funcion schema_bool() { retornar esquema_booleano() }
funcion schema_any() { retornar esquema_cualquiera() }
funcion schema_list(elemento) { retornar esquema_lista(elemento) }
funcion schema_object(campos) { retornar esquema_objeto(campos) }
funcion schema_min(e, n) { retornar esquema_min(e, n) }
funcion schema_max(e, n) { retornar esquema_max(e, n) }
funcion schema_pattern(e, patron) { retornar esquema_patron(e, patron) }
funcion schema_email(e) { retornar esquema_correo(e) }
funcion schema_one_of(e, opciones) { retornar esquema_uno_de(e, opciones) }
funcion schema_optional(e) { retornar esquema_opcional(e) }
funcion schema_default(e, v) { retornar esquema_defecto(e, v) }
funcion schema_strict(e) { retornar esquema_estricto(e) }
/// Like esquema_validar, with English messages ("errors": path, code, message).
funcion schema_validate(e, valor) {
    sea r = esquema_validar(e, valor)
    sea errores = []
    para x en r["errores"] {
        sea ruta = x["ruta"]
        si (ruta == "(raíz)") { ruta = "(root)" }
        errores.agregar({"path": ruta, "code": x["codigo"], "message": _schema_en(x), "limit": x["limite"]})
    }
    retornar {"ok": r["ok"], "value": r["valor"], "errors": errores}
}

funcion _schema_en(x) {
    sea c = x["codigo"]
    sea n = x["limite"]
    sea en_lista = texto_indice(x["mensaje"], "elementos") >= 0
    si (c == "requerido") { retornar "is required" }
    si (c == "tipo") {
        si (texto_indice(x["mensaje"], "texto") >= 0) { retornar "must be a string" }
        si (texto_indice(x["mensaje"], "número") >= 0) { retornar "must be a number" }
        si (texto_indice(x["mensaje"], "lista") >= 0) { retornar "must be a list" }
        si (texto_indice(x["mensaje"], "objeto") >= 0) { retornar "must be an object" }
        retornar "must be true or false"
    }
    si (c == "muy_corto") { si (en_lista) { retornar "must have at least " + n + " items" }  retornar "must have at least " + n + " characters" }
    si (c == "muy_largo") { si (en_lista) { retornar "must have at most " + n + " items" }  retornar "must have at most " + n + " characters" }
    si (c == "muy_pequeno") { retornar "must be at least " + n }
    si (c == "muy_grande") { retornar "must be at most " + n }
    si (c == "entero") { retornar "must be an integer" }
    si (c == "correo") { retornar "is not a valid email" }
    si (c == "patron") { retornar "does not match the expected format" }
    si (c == "opcion") { retornar "must be one of: " + n }
    si (c == "desconocido") { retornar "unknown key" }
    retornar x["mensaje"]
}
funcion schema_parse(e, valor) {
    sea r = schema_validate(e, valor)
    si (r["ok"] == falso) { lanzar r["errors"][0]["path"] + ": " + r["errors"][0]["message"] }
    retornar r["value"]
}
