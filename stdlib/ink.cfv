// stdlib/ink.cfv — Colores y estilos ANSI para la terminal (alias en inglés de "tinta").
// English names for the "tinta" module; both can be used together.

importar "tinta"

funcion ink_enabled() { retornar tinta_activa() }
funcion ink_use(activa) { retornar tinta_usar(activa) }
funcion ink_bold(t) { retornar tinta_negrita(t) }
funcion ink_dim(t) { retornar tinta_tenue(t) }
funcion ink_italic(t) { retornar tinta_cursiva(t) }
funcion ink_underline(t) { retornar tinta_subrayado(t) }
funcion ink_inverse(t) { retornar tinta_invertido(t) }
funcion ink_strikethrough(t) { retornar tinta_tachado(t) }
funcion ink_black(t) { retornar tinta_negro(t) }
funcion ink_red(t) { retornar tinta_rojo(t) }
funcion ink_green(t) { retornar tinta_verde(t) }
funcion ink_yellow(t) { retornar tinta_amarillo(t) }
funcion ink_blue(t) { retornar tinta_azul(t) }
funcion ink_magenta(t) { retornar tinta_magenta(t) }
funcion ink_cyan(t) { retornar tinta_cian(t) }
funcion ink_white(t) { retornar tinta_blanco(t) }
funcion ink_gray(t) { retornar tinta_gris(t) }
funcion ink_bg_red(t) { retornar tinta_fondo_rojo(t) }
funcion ink_bg_green(t) { retornar tinta_fondo_verde(t) }
funcion ink_bg_yellow(t) { retornar tinta_fondo_amarillo(t) }
funcion ink_bg_blue(t) { retornar tinta_fondo_azul(t) }
funcion ink_rgb(r, g, b, t) { retornar tinta_rgb(r, g, b, t) }
funcion ink_bg_rgb(r, g, b, t) { retornar tinta_fondo_rgb(r, g, b, t) }
funcion ink_hex(color, t) { retornar tinta_hex(color, t) }
funcion ink_strip(t) { retornar tinta_quitar(t) }
funcion ink_length(t) { retornar tinta_largo(t) }
