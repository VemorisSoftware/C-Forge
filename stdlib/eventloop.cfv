// stdlib/eventloop.cfv — bucle de eventos: nombres en inglés del módulo "latido".
// English names for the "latido" module; both can be used together.

importar "latido"

funcion loop_new() { retornar latido_bucle() }
funcion loop_now(b) { retornar latido_ahora(b) }
funcion loop_stop(b) { retornar latido_parar(b) }
funcion loop_timer(b, espera_ms, repetir_ms, cb) { retornar latido_temporizador(b, espera_ms, repetir_ms, cb) }
funcion loop_cancel(h) { retornar latido_detener(h) }
funcion loop_unref(h) { retornar latido_sin_ref(h) }
funcion loop_ref(h) { retornar latido_con_ref(h) }
funcion loop_next_tick(b, cb) { retornar latido_proximo(b, cb) }
funcion loop_idle(b, cb) { retornar latido_inactivo(b, cb) }
funcion loop_watch(b, fd, eventos, cb) { retornar latido_vigilar(b, fd, eventos, cb) }
funcion loop_set_events(h, eventos) { retornar latido_cambiar_eventos(h, eventos) }
funcion loop_run(b, modo) { retornar latido_correr(b, modo) }
funcion loop_read(s, cb) { retornar latido_leer(s, cb) }
funcion loop_read_stop(s) { retornar latido_dejar_de_leer(s) }
funcion loop_write(s, datos, cb) { retornar latido_escribir(s, datos, cb) }
funcion loop_end(s, cb) { retornar latido_terminar(s, cb) }
funcion loop_close(s, cb) { retornar latido_cerrar(s, cb) }
funcion loop_pipe(b) { retornar latido_tubo(b) }
funcion loop_tcp_server(b, host, puerto, al_conectar) { retornar latido_tcp_servidor(b, host, puerto, al_conectar) }
funcion loop_port(srv) { retornar latido_puerto(srv) }
funcion loop_server_close(srv) { retornar latido_cerrar_servidor(srv) }
funcion loop_tcp_connect(b, host, puerto, cb) { retornar latido_tcp_conectar(b, host, puerto, cb) }
funcion loop_work(b, fn, cb) { retornar latido_trabajo(b, fn, cb) }
funcion loop_after(b, ms, cb) { retornar latido_despues(b, ms, cb) }
