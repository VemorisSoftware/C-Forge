// stdlib/flexbox.cfv — motor de diseño Flexbox: nombres en inglés del módulo "flex".
// English names for the "flex" module; both can be used together.

importar "flex"

funcion flexbox_node(estilo, hijos) { retornar flex_nodo(estilo, hijos) }
funcion flexbox_compute(raiz, ancho, alto) { retornar flex_calcular(raiz, ancho, alto) }
funcion flexbox_boxes(raiz) { retornar flex_cajas(raiz) }
