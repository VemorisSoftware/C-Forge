// stdlib/vitrina.cfv — salida bonita en la terminal: tablas, paneles y
// árboles con bordes Unicode, anchos correctos con tildes y emojis
// simples, y números alineados a la derecha. Inspirada en Rich (MIT).
// En inglés: importar "rich".
//
//   importar "vitrina"
//   mostrar(vitrina_tabla(["Producto", "Precio"], [["Café", 2500], ["Té", 1800]]))
//   mostrar(vitrina_panel("Listo ✓", "Estado"))
//   mostrar(vitrina_arbol({"nombre": "src", "hijos": [{"nombre": "main.cfv"}]}))
//
// Opciones de tabla: {"titulo": t, "borde": "redondo" | "simple" | "doble" | "ascii",
// "alinear": ["izq", "der", "centro"…]}.

sea _VT_BORDES = {
    "simple": ["┌", "─", "┬", "┐", "│", "├", "┼", "┤", "└", "┴", "┘"],
    "redondo": ["╭", "─", "┬", "╮", "│", "├", "┼", "┤", "╰", "┴", "╯"],
    "doble": ["╔", "═", "╦", "╗", "║", "╠", "╬", "╣", "╚", "╩", "╝"],
    "ascii": ["+", "-", "+", "+", "|", "+", "+", "+", "+", "+", "+"]
}
_VT_BORDES["square"] = _VT_BORDES["simple"]
_VT_BORDES["rounded"] = _VT_BORDES["redondo"]
_VT_BORDES["double"] = _VT_BORDES["doble"]

/// Columnas visibles (cuenta caracteres, no bytes; quita colores ANSI).
funcion vitrina_ancho(t) {
    sea s = "" + t
    sea n = 0
    sea i = 0
    sea largo = longitud(s)
    mientras (i < largo) {
        sea b = byte_en(s, i)
        si (b == 27) {
            // Secuencia ANSI: ESC [ … letra
            i = i + 1
            mientras (i < largo y (byte_en(s, i) < 64 o byte_en(s, i) == 91)) { i = i + 1 }
        } sino {
            si (b < 128 o b >= 192) {
                n = n + 1
                // Emojis y CJK (3–4 bytes, U+1F000+ y U+3000–U+9FFF) ocupan 2.
                si (b >= 240) { n = n + 1 }
                si (b == 227 o (b >= 228 y b <= 233)) { n = n + 1 }
            }
        }
        i = i + 1
    }
    retornar n
}

funcion _vt_rellenar(t, ancho, alinear) {
    sea falta = ancho - vitrina_ancho(t)
    si (falta <= 0) { retornar t }
    si (alinear == "der" o alinear == "right") { retornar texto_repetir(" ", falta) + t }
    si (alinear == "centro" o alinear == "center") {
        sea izq = cociente(falta, 2)
        retornar texto_repetir(" ", izq) + t + texto_repetir(" ", falta - izq)
    }
    retornar t + texto_repetir(" ", falta)
}

funcion _vt_opcion(o, k, defecto) {
    si (o != nulo) { si (tiene_clave(o, k)) { retornar o[k] } }
    retornar defecto
}

funcion _vt_linea(b, anchos, izq, medio, der) {
    sea partes = []
    para a en anchos { partes.agregar(texto_repetir(b[1], a + 2)) }
    retornar b[izq] + unir(partes, b[medio]) + b[der]
}

funcion _vt_celda(v) {
    si (v == nulo) { retornar "" }
    sea t = "" + v
    t = texto_reemplazar(t, "\n", " ")
    retornar texto_reemplazar(t, "\t", " ")
}

funcion vitrina_tabla(encabezados, filas, opciones) {
    sea b = _VT_BORDES[_vt_opcion(opciones, "borde", _vt_opcion(opciones, "border", "redondo"))]
    sea alinear = _vt_opcion(opciones, "alinear", _vt_opcion(opciones, "align", nulo))
    sea n = longitud(encabezados)
    sea anchos = []
    sea auto = []
    sea k = 0
    mientras (k < n) {
        anchos.agregar(vitrina_ancho(encabezados[k]))
        auto.agregar("der")
        k = k + 1
    }
    para fila en filas {
        si (longitud(fila) != n) { lanzar "vitrina: la fila tiene " + longitud(fila) + " celdas y hay " + n + " columnas" }
        k = 0
        mientras (k < n) {
            anchos[k] = maximo(anchos[k], vitrina_ancho(_vt_celda(fila[k])))
            si (tipo(fila[k]) != "numero" y fila[k] != nulo) { auto[k] = "izq" }
            k = k + 1
        }
    }
    si (alinear != nulo) { auto = alinear }
    sea l = []
    sea titulo = _vt_opcion(opciones, "titulo", _vt_opcion(opciones, "title", nulo))
    si (titulo != nulo) {
        sea total = 0
        para a en anchos { total = total + a + 3 }
        sea centrado = _vt_rellenar(titulo, total + 1, "centro")
        mientras (texto_termina_con(centrado, " ")) { centrado = subcadena(centrado, 0, longitud(centrado) - 1) }
        l.agregar(centrado)
    }
    l.agregar(_vt_linea(b, anchos, 0, 2, 3))
    sea cab = []
    k = 0
    mientras (k < n) { cab.agregar(" " + _vt_rellenar(_vt_celda(encabezados[k]), anchos[k], "izq") + " ")  k = k + 1 }
    l.agregar(b[4] + unir(cab, b[4]) + b[4])
    l.agregar(_vt_linea(b, anchos, 5, 6, 7))
    para fila en filas {
        sea cel = []
        k = 0
        mientras (k < n) { cel.agregar(" " + _vt_rellenar(_vt_celda(fila[k]), anchos[k], auto[k]) + " ")  k = k + 1 }
        l.agregar(b[4] + unir(cel, b[4]) + b[4])
    }
    l.agregar(_vt_linea(b, anchos, 8, 9, 10))
    retornar unir(l, "\n")
}

/// Recuadro alrededor de un texto (varias líneas), con título opcional.
funcion vitrina_panel(texto, titulo, borde) {
    sea b = _VT_BORDES[borde ?? "redondo"]
    sea lineas = texto_dividir("" + texto, "\n")
    sea ancho = 0
    para x en lineas { ancho = maximo(ancho, vitrina_ancho(x)) }
    si (titulo != nulo) { ancho = maximo(ancho, vitrina_ancho(titulo) + 2) }
    sea arriba = b[0] + texto_repetir(b[1], ancho + 2) + b[3]
    si (titulo != nulo) {
        sea t = " " + titulo + " "
        sea resto = ancho + 2 - vitrina_ancho(t)
        arriba = b[0] + b[1] + t + texto_repetir(b[1], resto - 1) + b[3]
    }
    sea l = [arriba]
    para x en lineas { l.agregar(b[4] + " " + _vt_rellenar(x, ancho, "izq") + " " + b[4]) }
    l.agregar(b[8] + texto_repetir(b[1], ancho + 2) + b[10])
    retornar unir(l, "\n")
}

funcion _vt_rama(nodo, prefijo, l) {
    sea hijos = _vt_opcion(nodo, "hijos", _vt_opcion(nodo, "children", []))
    sea i = 0
    mientras (i < longitud(hijos)) {
        sea ultimo = i == longitud(hijos) - 1
        sea h = hijos[i]
        sea nombre = h
        si (tipo(h) == "mapa") { nombre = _vt_nombre(h) }
        si (ultimo) { l.agregar(prefijo + "└── " + nombre) } sino { l.agregar(prefijo + "├── " + nombre) }
        si (tipo(h) == "mapa") {
            si (ultimo) { _vt_rama(h, prefijo + "    ", l) } sino { _vt_rama(h, prefijo + "│   ", l) }
        }
        i = i + 1
    }
}

funcion _vt_nombre(n) { retornar _vt_opcion(n, "nombre", _vt_opcion(n, "name", "")) }

/// Árbol (también acepta "name"/"children"): {"nombre": n, "hijos": [nodo o texto]}.
funcion vitrina_arbol(raiz) {
    sea l = [_vt_nombre(raiz)]
    _vt_rama(raiz, "", l)
    retornar unir(l, "\n")
}
