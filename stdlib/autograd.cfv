// stdlib/autograd.cfv — autodiferenciación y redes pequeñas: nombres en inglés del módulo "gradiente".
// English names for the "gradiente" module; both can be used together.


importar "gradiente"

funcion _autograd_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_autograd_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _autograd_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _AUTOGRAD_OPT = {"epochs": "epocas", "rate": "tasa", "lr": "tasa", "optimizer": "optimizador"}

funcion autograd_value(v, padres, op, derivadas) { retornar gradiente_valor(v, padres, op, derivadas) }
funcion autograd_add(a, b) { retornar gradiente_suma(a, b) }
funcion autograd_sub(a, b) { retornar gradiente_resta(a, b) }
funcion autograd_mul(a, b) { retornar gradiente_mul(a, b) }
funcion autograd_div(a, b) { retornar gradiente_div(a, b) }
funcion autograd_pow(a, n) { retornar gradiente_pot(a, n) }
funcion autograd_exp(a) { retornar gradiente_exp(a) }
funcion autograd_log(a) { retornar gradiente_log(a) }
funcion autograd_tanh(a) { retornar gradiente_tanh(a) }
funcion autograd_relu(a) { retornar gradiente_relu(a) }
funcion autograd_sigmoid(a) { retornar gradiente_sigmoide(a) }
funcion autograd_backward(y) { retornar gradiente_atras(y) }
funcion autograd_mlp(tamanos, activacion, semilla, salida) { retornar gradiente_red(tamanos, activacion, semilla, salida) }
funcion autograd_forward(red, x) { retornar gradiente_adelante(red, x) }
funcion autograd_parameters(red) { retornar gradiente_parametros(red) }
funcion autograd_predict(red, x) { retornar gradiente_predecir(red, x) }
funcion autograd_train(red, X, y, opciones) { retornar gradiente_entrenar(red, X, y, _autograd_opt(opciones)) }
funcion autograd_numeric_grad(f, xs, h) { retornar gradiente_numerico(f, xs, h) }

funcion _autograd_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_AUTOGRAD_OPT[k] ?? k] = o[k] }
    retornar r
}

/// Valor y gradiente de un nodo.
funcion autograd_data(n) { retornar n["v"] }
funcion autograd_grad(n) { retornar n["grad"] }
