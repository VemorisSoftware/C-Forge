// stdlib/validator.cfv — validación de formularios: nombres en inglés del módulo "regla".
// English names for the "regla" module; both can be used together.

importar "regla"

/// English messages by default.
funcion validator_new(idioma) { retornar regla_validador(idioma ?? "en") }
funcion validator_field(v, nombre, reglas, etiqueta) { retornar regla_campo(v, nombre, reglas, etiqueta) }
funcion validator_rut(rut) { retornar regla_rut_valido(rut) }
/// {"ok", "errors": {field: [messages]}}
funcion validator_check(v, datos) {
    sea r = regla_validar(v, datos)
    retornar {"ok": r["ok"], "errors": r["errores"]}
}
funcion validator_messages(v, resultado) {
    sea r = resultado
    si (tiene_clave(r, "errors")) { r = {"ok": resultado["ok"], "errores": resultado["errors"]} }
    retornar regla_mensajes(v, r)
}
