// stdlib/fixedphysics.cfv — física 2D determinista en punto fijo: nombres en inglés del módulo "determinista".
// English names for the "determinista" module; both can be used together.

importar "determinista"

funcion fp_fixed(v) { retornar det_fijo(v) }
funcion fp_real(f) { retornar det_real(f) }
funcion fp_sqrt(f) { retornar det_raiz(f) }
funcion fp_sin(a) { retornar det_seno(a) }
funcion fp_cos(a) { retornar det_coseno(a) }
funcion fp_world(opciones) { retornar det_mundo(opciones) }
funcion fp_circle(m, o) { retornar det_circulo(m, o) }
funcion fp_box(m, o) { retornar det_caja(m, o) }
funcion fp_remove(m, id) { retornar det_quitar(m, id) }
funcion fp_position(m, id) { retornar det_posicion(m, id) }
funcion fp_angle(m, id) { retornar det_angulo(m, id) }
funcion fp_velocity(m, id) { retornar det_velocidad(m, id) }
funcion fp_set_velocity(m, id, vx, vy) { retornar det_fijar_velocidad(m, id, vx, vy) }
funcion fp_impulse(m, id, ix, iy) { retornar det_impulso(m, id, ix, iy) }
funcion fp_force(m, id, fx, fy) { retornar det_fuerza(m, id, fx, fy) }
funcion fp_move(m, id, x, y) { retornar det_mover(m, id, x, y) }
funcion fp_step(m) { retornar det_paso(m) }
funcion fp_steps(m, n) { retornar det_pasos(m, n) }
funcion fp_contacts(m) { retornar det_contactos(m) }
funcion fp_snapshot(m) { retornar det_captura(m) }
funcion fp_restore(m, cap) { retornar det_restaurar(m, cap) }
funcion fp_checksum(m) { retornar det_suma(m) }

sea _FP_OPC = {"gravity": "gravedad", "step": "paso", "iterations": "iteraciones", "cell": "celda", "x": "x", "y": "y", "radius": "radio", "width": "ancho", "height": "alto", "angle": "angulo", "type": "tipo", "density": "densidad", "mass": "masa", "friction": "friccion", "restitution": "restitucion", "damping": "amortiguacion", "vel": "vel", "angular_velocity": "vel_angular", "sensor": "sensor", "data": "datos", "fixed_rotation": "sin_rotacion"}
sea _FP_TIPOS = {"dynamic": "dinamico", "static": "estatico", "kinematic": "cinematico"}
funcion _fp_o(o) {
    sea r = {}
    para k en claves(o ?? {}) { r[_FP_OPC[k] ?? k] = o[k] }
    si (tiene_clave(r, "tipo")) { r["tipo"] = _FP_TIPOS[r["tipo"]] ?? r["tipo"] }
    retornar r
}
funcion fp_world_new(o) { retornar det_mundo(_fp_o(o)) }
funcion fp_add_circle(m, o) { retornar det_circulo(m, _fp_o(o)) }
funcion fp_add_box(m, o) { retornar det_caja(m, _fp_o(o)) }
