// stdlib/rich.cfv — tablas, paneles y árboles en la terminal: nombres en inglés del módulo "vitrina".
// English names for the "vitrina" module; both can be used together.

importar "vitrina"

funcion rich_width(t) { retornar vitrina_ancho(t) }
funcion rich_table(encabezados, filas, opciones) { retornar vitrina_tabla(encabezados, filas, opciones) }
funcion rich_panel(texto, titulo, borde) { retornar vitrina_panel(texto, titulo, borde) }
funcion rich_tree(raiz) { retornar vitrina_arbol(raiz) }
