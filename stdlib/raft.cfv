// stdlib/raft.cfv — consenso Raft: nombres en inglés del módulo "consenso".
// English names for the "consenso" module; both can be used together.


importar "consenso"

funcion _raft_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_raft_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _raft_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _RAFT_RES = {"rol": "role", "termino": "term", "lider": "leader", "registro": "log", "seguidor": "follower", "candidato": "candidate"}
sea _RAFT_OPT = {"election_min": "eleccion_min", "election_max": "eleccion_max", "heartbeat": "latido", "seed": "semilla", "loss": "perdida", "delay_min": "demora_min", "delay_max": "demora_max"}

funcion raft_node(id, pares, opciones) { retornar consenso_nodo(id, pares, _raft_opt(opciones)) }
funcion raft_tick(n, ahora) { retornar consenso_tic(n, ahora) }
funcion raft_step(n, m) { retornar consenso_recibir(n, m) }
funcion raft_propose(n, cmd) { retornar consenso_proponer(n, cmd) }
funcion raft_apply(n) { retornar consenso_aplicar(n) }
funcion raft_committed(n) { retornar consenso_aplicados(n) }
funcion raft_status(n) { retornar _raft_tr(consenso_estado(n), _RAFT_RES) }
funcion raft_network(ids, opciones) { retornar consenso_red(ids, _raft_opt(opciones)) }
funcion raft_network_run(r, ms) { retornar consenso_red_avanzar(r, ms) }
funcion raft_network_leader(r) { retornar consenso_red_lider(r) }
funcion raft_network_partition(r, grupo_a, grupo_b, cortar) { retornar consenso_red_particion(r, grupo_a, grupo_b, cortar) }
funcion raft_network_crash(r, id, caido) { retornar consenso_red_caida(r, id, caido) }

funcion _raft_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_RAFT_OPT[k] ?? k] = o[k] }
    retornar r
}

funcion raft_nodes(net) { retornar net["nodos"] }
