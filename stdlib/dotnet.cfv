// stdlib/dotnet.cfv — C# / .NET desde C-Forge: el runtime de .NET corre
// dentro del programa (hostfxr). Necesita .NET 6 o superior instalado.
//
// En C# (biblioteca de clases, net8.0):
//   using System.Runtime.InteropServices;
//   public static class Calc {
//       [UnmanagedCallersOnly] public static int Sumar(int a, int b) => a + b;
//       [UnmanagedCallersOnly] public static IntPtr Saludo(IntPtr nombre) =>
//           Marshal.StringToCoTaskMemUTF8("Hola " + Marshal.PtrToStringUTF8(nombre));
//   }
//
// En C-Forge:
//   importar "dotnet"
//   dotnet_iniciar()
//   sea sumar = dotnet_funcion("bin/Calc.dll", "Calc, Calc", "Sumar")
//   mostrar(dotnet_llamar(sumar, [40, 2]))                 // 42
//   sea saludo = dotnet_funcion("bin/Calc.dll", "Calc, Calc", "Saludo")
//   mostrar(dotnet_llamar_texto(saludo, ["Javier"]))       // Hola Javier
//
// Argumentos: hasta 6 enteros, largos, booleanos o textos (char* UTF-8).
// Decimales (double) todavía no.

// Cualquier extern activa el enlazador dinámico (dlopen de hostfxr). La
// declaración va dentro de una función que nunca se llama.
funcion __dotnet_declaraciones() {
    extern "libc" funcion __dotnet_enlace_dinamico(): entero como "getpid"
}
