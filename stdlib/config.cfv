// stdlib/config.cfv — TOML y YAML: nombres en inglés del módulo "ajustes".
// English names for the "ajustes" module; both can be used together.


importar "ajustes"

funcion _config_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_config_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _config_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _CONFIG_OPT = {"dates": "fechas", "duplicates": "duplicadas", "env": "entorno", "variables": "variables", "schema": "molde", "optional": "opcional"}

funcion toml_parse(texto, opciones) { retornar ajustes_toml(texto, _config_opt(opciones)) }
funcion toml_stringify(m) { retornar ajustes_a_toml(m) }
funcion yaml_parse_all(texto, opciones) { retornar ajustes_yaml_todos(texto, _config_opt(opciones)) }
funcion yaml_parse(texto, opciones) { retornar ajustes_yaml(texto, _config_opt(opciones)) }
funcion yaml_stringify(v) { retornar ajustes_a_yaml(v) }
funcion config_merge(a, b) { retornar ajustes_mezclar(a, b) }
funcion config_expand_env(v, vars) { retornar ajustes_entorno(v, vars) }
funcion config_parse(texto, formato, opciones) { retornar ajustes_leer(texto, formato, _config_opt(opciones)) }
funcion config_load(rutas, opciones) { retornar ajustes_cargar(rutas, _config_opt(opciones)) }
funcion config_get(c, ruta, defecto) { retornar ajustes_obtener(c, ruta, defecto) }

funcion _config_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_CONFIG_OPT[k] ?? k] = o[k] }
    retornar r
}
