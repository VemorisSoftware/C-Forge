// stdlib/fastapi.cfv — APIs con documentación automática: nombres en inglés del módulo "api_rapida".
// English names for the "api_rapida" module; both can be used together.


importar "api_rapida"

funcion _fastapi_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_fastapi_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _fastapi_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _FASTAPI_RES = {"estado": "status", "tipo": "type", "cuerpo": "body", "cabeceras": "headers"}
sea _FASTAPI_OPT = {"title": "titulo", "description": "descripcion", "params": "parametros", "query": "consulta", "body": "cuerpo", "response": "respuesta", "status": "estado", "summary": "resumen", "tags": "etiquetas", "security": "seguridad", "method": "metodo", "path": "ruta", "headers": "cabeceras"}

funcion fastapi_new(opciones) { retornar api_nueva(_fastapi_opt(opciones)) }
funcion fastapi_dependency(app, f) { retornar api_dependencia(app, f) }
funcion fastapi_bearer(app, verificar) { retornar api_bearer(app, verificar) }
funcion fastapi_schema(app, nombre, m) { retornar api_esquema(app, nombre, m) }
funcion fastapi_error(estado, mensaje, cabeceras) { retornar api_error(estado, mensaje, cabeceras) }
funcion fastapi_openapi(app) { retornar api_openapi(app) }
funcion fastapi_docs_html(app) { retornar api_docs_html(app) }
funcion fastapi_serve(app, puerto) { retornar api_servir(app, puerto) }

funcion _fastapi_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_FASTAPI_OPT[k] ?? k] = o[k] }
    retornar r
}

funcion fastapi_route(app, method, path, spec, handler) { retornar api_ruta(app, method, path, _fastapi_opt(spec), handler) }
funcion fastapi_get(app, path, spec, f) { retornar api_get(app, path, _fastapi_opt(spec), f) }
funcion fastapi_post(app, path, spec, f) { retornar api_post(app, path, _fastapi_opt(spec), f) }
funcion fastapi_put(app, path, spec, f) { retornar api_put(app, path, _fastapi_opt(spec), f) }
funcion fastapi_patch(app, path, spec, f) { retornar api_patch(app, path, _fastapi_opt(spec), f) }
funcion fastapi_delete(app, path, spec, f) { retornar api_delete(app, path, _fastapi_opt(spec), f) }
funcion fastapi_response(status, body, type_, headers) { retornar api_respuesta(status, body, type_, headers) }
/// request: {"method", "path", "query", "headers", "body"} → {"status", "type", "body", "headers"}.
funcion fastapi_handle(app, request) { retornar _fastapi_tr(api_manejar(app, _fastapi_opt(request)), _FASTAPI_RES) }
