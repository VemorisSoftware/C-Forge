// stdlib/codigo_qr.cfv — códigos QR (versiones 1 a 40, niveles L/M/Q/H,
// modos numérico, alfanumérico y bytes UTF-8, máscara automática) y códigos
// de barras EAN-13, UPC-A y Code 128, como matriz, SVG o texto para la
// terminal. Basada en el generador de QR de Project Nayuki (MIT,
// Copyright (c) Project Nayuki) e inspirada en ZXing (Apache). En inglés:
// importar "qrcode".
//
//   importar "codigo_qr"
//   sea q = qr_crear("https://c-forge.org", {"nivel": "M"})
//   escribir_archivo("qr.svg", qr_svg(q, {"modulo": 8}))
//   mostrar(qr_texto(q))
//   escribir_archivo("ean.svg", barras_svg(barras_ean13("780123456789")))

// ── Campo de Galois GF(256) con polinomio 0x11D ──────────────────────────

sea _QR_EXP = []
sea _QR_LOG = []

funcion _qr_tablas() {
    si (longitud(_QR_EXP) > 0) { retornar nulo }
    sea i = 0
    mientras (i < 256) { _QR_LOG.agregar(0)  i = i + 1 }
    sea x = 1
    i = 0
    mientras (i < 255) {
        _QR_EXP.agregar(x)
        _QR_LOG[x] = i
        x = x * 2
        si (x >= 256) { x = bits_xo(x, 285) }
        i = i + 1
    }
}

funcion _qr_mul(a, b) {
    si (a == 0 o b == 0) { retornar 0 }
    retornar _QR_EXP[(_QR_LOG[a] + _QR_LOG[b]) % 255]
}

funcion _qr_divisor(grado) {
    sea r = []
    sea i = 0
    mientras (i < grado - 1) { r.agregar(0)  i = i + 1 }
    r.agregar(1)
    sea raiz_ = 1
    i = 0
    mientras (i < grado) {
        sea j = 0
        mientras (j < grado) {
            r[j] = _qr_mul(r[j], raiz_)
            si (j + 1 < grado) { r[j] = bits_xo(r[j], r[j + 1]) }
            j = j + 1
        }
        raiz_ = _qr_mul(raiz_, 2)
        i = i + 1
    }
    retornar r
}

funcion _qr_resto(datos, divisor) {
    sea r = []
    para d en divisor { r.agregar(0) }
    para b en datos {
        sea factor = bits_xo(b, r[0])
        sea nr = []
        sea i = 1
        mientras (i < longitud(r)) { nr.agregar(r[i])  i = i + 1 }
        nr.agregar(0)
        r = nr
        i = 0
        mientras (i < longitud(r)) { r[i] = bits_xo(r[i], _qr_mul(divisor[i], factor))  i = i + 1 }
    }
    retornar r
}

// ── Tablas del estándar (ISO/IEC 18004) ───────────────────────────────────

sea _QR_ECC = {
    "L": [-1, 7, 10, 15, 20, 26, 18, 20, 24, 30, 18, 20, 24, 26, 30, 22, 24, 28, 30, 28, 28, 28, 28, 30, 30, 26, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30],
    "M": [-1, 10, 16, 26, 18, 24, 16, 18, 22, 22, 26, 30, 22, 22, 24, 24, 28, 28, 26, 26, 26, 26, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28],
    "Q": [-1, 13, 22, 18, 26, 18, 24, 18, 22, 20, 24, 28, 26, 24, 20, 30, 24, 28, 28, 26, 30, 28, 30, 30, 30, 30, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30],
    "H": [-1, 17, 28, 22, 16, 22, 28, 26, 26, 24, 28, 24, 28, 22, 24, 24, 30, 28, 28, 26, 28, 30, 24, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30]
}
sea _QR_BLOQUES = {
    "L": [-1, 1, 1, 1, 1, 1, 2, 2, 2, 2, 4, 4, 4, 4, 4, 6, 6, 6, 6, 7, 8, 8, 9, 9, 10, 12, 12, 12, 13, 14, 15, 16, 17, 18, 19, 19, 20, 21, 22, 24, 25],
    "M": [-1, 1, 1, 1, 2, 2, 4, 4, 4, 5, 5, 5, 8, 9, 9, 10, 10, 11, 13, 14, 16, 17, 17, 18, 20, 21, 23, 25, 26, 28, 29, 31, 33, 35, 37, 38, 40, 43, 45, 47, 49],
    "Q": [-1, 1, 1, 2, 2, 4, 4, 6, 6, 8, 8, 8, 10, 12, 16, 12, 17, 16, 18, 21, 20, 23, 23, 25, 27, 29, 34, 34, 35, 38, 40, 43, 45, 48, 51, 53, 56, 59, 62, 65, 68],
    "H": [-1, 1, 1, 2, 4, 4, 4, 5, 6, 8, 8, 11, 11, 16, 16, 18, 16, 19, 21, 25, 25, 25, 34, 30, 32, 35, 37, 40, 42, 45, 48, 51, 54, 57, 60, 63, 66, 70, 74, 77, 81]
}
sea _QR_FORMATO = {"L": 1, "M": 0, "Q": 3, "H": 2}
sea _QR_ALFA = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:"

funcion _qr_bit(n, i) { retornar piso(n / potencia(2, i)) % 2 }

funcion _qr_crudos(v) {
    sea r = (16 * v + 128) * v + 64
    si (v >= 2) {
        sea na = piso(v / 7) + 2
        r = r - ((25 * na - 10) * na - 55)
        si (v >= 7) { r = r - 36 }
    }
    retornar r
}

funcion _qr_datos_cap(v, nivel) { retornar piso(_qr_crudos(v) / 8) - _QR_ECC[nivel][v] * _QR_BLOQUES[nivel][v] }

funcion _qr_agregar_bits(bits, valor, n) {
    sea i = n - 1
    mientras (i >= 0) { bits.agregar(_qr_bit(valor, i))  i = i - 1 }
}

funcion _qr_modo(t) {
    sea num = verdadero
    sea alfa = verdadero
    sea i = 0
    mientras (i < longitud(t)) {
        sea c = subcadena(t, i, i + 1)
        sea b = byte_en(t, i)
        si (b < 48 o b > 57) { num = falso }
        si (texto_indice(_QR_ALFA, c) < 0) { alfa = falso }
        i = i + 1
    }
    si (num y longitud(t) > 0) { retornar "numerico" }
    si (alfa y longitud(t) > 0) { retornar "alfanumerico" }
    retornar "bytes"
}

funcion _qr_bits_cuenta(modo, v) {
    sea k = 0
    si (v >= 10) { k = 1 }
    si (v >= 27) { k = 2 }
    si (modo == "numerico") { retornar [10, 12, 14][k] }
    si (modo == "alfanumerico") { retornar [9, 11, 13][k] }
    retornar [8, 16, 16][k]
}

funcion _qr_segmento(t, modo) {
    sea bits = []
    si (modo == "numerico") {
        sea i = 0
        mientras (i < longitud(t)) {
            sea n = minimo(3, longitud(t) - i)
            _qr_agregar_bits(bits, a_numero(subcadena(t, i, i + n)), n * 3 + 1)
            i = i + n
        }
        retornar {"modo": 1, "cuenta": longitud(t), "bits": bits}
    }
    si (modo == "alfanumerico") {
        sea i = 0
        mientras (i + 1 < longitud(t)) {
            _qr_agregar_bits(bits, texto_indice(_QR_ALFA, subcadena(t, i, i + 1)) * 45 + texto_indice(_QR_ALFA, subcadena(t, i + 1, i + 2)), 11)
            i = i + 2
        }
        si (i < longitud(t)) { _qr_agregar_bits(bits, texto_indice(_QR_ALFA, subcadena(t, i, i + 1)), 6) }
        retornar {"modo": 2, "cuenta": longitud(t), "bits": bits}
    }
    sea i = 0
    mientras (i < longitud(t)) { _qr_agregar_bits(bits, byte_en(t, i), 8)  i = i + 1 }
    retornar {"modo": 4, "cuenta": longitud(t), "bits": bits}
}

funcion _qr_op(o, k, k2, d) {
    si (o != nulo) {
        si (tiene_clave(o, k)) { retornar o[k] }
        si (tiene_clave(o, k2)) { retornar o[k2] }
    }
    retornar d
}

// ── Construcción de la matriz ─────────────────────────────────────────────

funcion _qr_poner(q, x, yy, oscuro, funcion_) {
    q["m"][yy][x] = oscuro
    si (funcion_) { q["f"][yy][x] = verdadero }
}

funcion _qr_buscador(q, cx, cy) {
    sea dy = -4
    mientras (dy <= 4) {
        sea dx = -4
        mientras (dx <= 4) {
            sea d = maximo(absoluto(dx), absoluto(dy))
            sea x = cx + dx
            sea yy = cy + dy
            si (x >= 0 y x < q["n"] y yy >= 0 y yy < q["n"]) { _qr_poner(q, x, yy, d != 2 y d != 4, verdadero) }
            dx = dx + 1
        }
        dy = dy + 1
    }
}

funcion _qr_alineacion(q, cx, cy) {
    sea dy = -2
    mientras (dy <= 2) {
        sea dx = -2
        mientras (dx <= 2) {
            _qr_poner(q, cx + dx, cy + dy, maximo(absoluto(dx), absoluto(dy)) != 1, verdadero)
            dx = dx + 1
        }
        dy = dy + 1
    }
}

funcion _qr_pos_alineacion(v) {
    si (v == 1) { retornar [] }
    sea na = piso(v / 7) + 2
    sea paso = piso((v * 8 + na * 3 + 5) / (na * 4 - 4)) * 2
    sea r = [6]
    sea pos = v * 4 + 17 - 7
    sea lista = []
    sea i = 0
    mientras (i < na - 1) { lista.agregar(pos)  pos = pos - paso  i = i + 1 }
    i = longitud(lista) - 1
    mientras (i >= 0) { r.agregar(lista[i])  i = i - 1 }
    retornar r
}

funcion _qr_formato(q, mascara) {
    sea datos = _QR_FORMATO[q["nivel"]] * 8 + mascara
    sea rem = datos
    sea i = 0
    mientras (i < 10) {
        rem = rem * 2
        si (rem >= 1024) { rem = bits_xo(rem, 1335) }
        i = i + 1
    }
    sea bits = bits_xo(datos * 1024 + rem, 21522)
    sea n = q["n"]
    i = 0
    mientras (i <= 5) { _qr_poner(q, 8, i, _qr_bit(bits, i) == 1, verdadero)  i = i + 1 }
    _qr_poner(q, 8, 7, _qr_bit(bits, 6) == 1, verdadero)
    _qr_poner(q, 8, 8, _qr_bit(bits, 7) == 1, verdadero)
    _qr_poner(q, 7, 8, _qr_bit(bits, 8) == 1, verdadero)
    i = 9
    mientras (i < 15) { _qr_poner(q, 14 - i, 8, _qr_bit(bits, i) == 1, verdadero)  i = i + 1 }
    i = 0
    mientras (i < 8) { _qr_poner(q, n - 1 - i, 8, _qr_bit(bits, i) == 1, verdadero)  i = i + 1 }
    i = 8
    mientras (i < 15) { _qr_poner(q, 8, n - 15 + i, _qr_bit(bits, i) == 1, verdadero)  i = i + 1 }
    _qr_poner(q, 8, n - 8, verdadero, verdadero)
}

funcion _qr_version_bits(q) {
    sea v = q["version"]
    si (v < 7) { retornar nulo }
    sea rem = v
    sea i = 0
    mientras (i < 12) {
        rem = rem * 2
        si (rem >= 4096) { rem = bits_xo(rem, 7973) }
        i = i + 1
    }
    sea bits = v * 4096 + rem
    sea n = q["n"]
    i = 0
    mientras (i < 18) {
        sea b = _qr_bit(bits, i) == 1
        sea a = n - 11 + i % 3
        sea c = piso(i / 3)
        _qr_poner(q, a, c, b, verdadero)
        _qr_poner(q, c, a, b, verdadero)
        i = i + 1
    }
}

funcion _qr_base(v, nivel) {
    sea n = v * 4 + 17
    sea m = []
    sea f = []
    sea yy = 0
    mientras (yy < n) {
        sea fm = []
        sea ff = []
        sea x = 0
        mientras (x < n) { fm.agregar(falso)  ff.agregar(falso)  x = x + 1 }
        m.agregar(fm)
        f.agregar(ff)
        yy = yy + 1
    }
    sea q = {"version": v, "nivel": nivel, "n": n, "m": m, "f": f}
    sea i = 0
    mientras (i < n) {
        _qr_poner(q, 6, i, i % 2 == 0, verdadero)
        _qr_poner(q, i, 6, i % 2 == 0, verdadero)
        i = i + 1
    }
    _qr_buscador(q, 3, 3)
    _qr_buscador(q, n - 4, 3)
    _qr_buscador(q, 3, n - 4)
    sea pos = _qr_pos_alineacion(v)
    sea na = longitud(pos)
    i = 0
    mientras (i < na) {
        sea j = 0
        mientras (j < na) {
            si ((i == 0 y j == 0) o (i == 0 y j == na - 1) o (i == na - 1 y j == 0)) { } sino { _qr_alineacion(q, pos[i], pos[j]) }
            j = j + 1
        }
        i = i + 1
    }
    _qr_formato(q, 0)
    _qr_version_bits(q)
    retornar q
}

funcion _qr_dibujar(q, datos) {
    sea n = q["n"]
    sea i = 0
    sea total = longitud(datos) * 8
    sea derecha = n - 1
    mientras (derecha >= 1) {
        si (derecha == 6) { derecha = 5 }
        sea vert = 0
        mientras (vert < n) {
            sea j = 0
            mientras (j < 2) {
                sea x = derecha - j
                sea arriba = (piso((derecha + 1) / 2) % 2) == 0
                sea yy = vert
                si (arriba) { yy = n - 1 - vert }
                si (q["f"][yy][x] == falso y i < total) {
                    q["m"][yy][x] = _qr_bit(datos[piso(i / 8)], 7 - i % 8) == 1
                    i = i + 1
                }
                j = j + 1
            }
            vert = vert + 1
        }
        derecha = derecha - 2
    }
}

funcion _qr_enmascara(k, x, yy) {
    si (k == 0) { retornar (x + yy) % 2 == 0 }
    si (k == 1) { retornar yy % 2 == 0 }
    si (k == 2) { retornar x % 3 == 0 }
    si (k == 3) { retornar (x + yy) % 3 == 0 }
    si (k == 4) { retornar (piso(x / 3) + piso(yy / 2)) % 2 == 0 }
    si (k == 5) { retornar (x * yy) % 2 + (x * yy) % 3 == 0 }
    si (k == 6) { retornar ((x * yy) % 2 + (x * yy) % 3) % 2 == 0 }
    retornar ((x + yy) % 2 + (x * yy) % 3) % 2 == 0
}

funcion _qr_aplicar_mascara(q, k) {
    sea n = q["n"]
    sea yy = 0
    mientras (yy < n) {
        sea x = 0
        mientras (x < n) {
            si (q["f"][yy][x] == falso y _qr_enmascara(k, x, yy)) { q["m"][yy][x] = q["m"][yy][x] == falso }
            x = x + 1
        }
        yy = yy + 1
    }
}

funcion _qr_linea_penal(celdas) {
    sea p = 0
    sea n = longitud(celdas)
    // Regla 1: rachas de 5 o más.
    sea i = 0
    mientras (i < n) {
        sea j = i
        mientras (j < n y celdas[j] == celdas[i]) { j = j + 1 }
        si (j - i >= 5) { p = p + 3 + (j - i - 5) }
        i = j
    }
    // Regla 3: 1011101 con 4 claros a un lado (fuera del borde cuenta como claro).
    i = -4
    mientras (i < n) {
        sea patron = [verdadero, falso, verdadero, verdadero, verdadero, falso, verdadero]
        sea ok = verdadero
        sea k = 0
        mientras (k < 7 y ok) {
            sea c = falso
            si (i + 4 + k >= 0 y i + 4 + k < n) { c = celdas[i + 4 + k] }
            si (c != patron[k]) { ok = falso }
            k = k + 1
        }
        si (ok) {
            sea antes = verdadero
            sea despues = verdadero
            k = 0
            mientras (k < 4) {
                sea a = i + k
                si (a >= 0 y a < n y celdas[a]) { antes = falso }
                sea b = i + 11 + k
                si (b >= 0 y b < n y celdas[b]) { despues = falso }
                k = k + 1
            }
            si (antes) { p = p + 40 }
            si (despues) { p = p + 40 }
        }
        i = i + 1
    }
    retornar p
}

funcion _qr_penal(q) {
    sea n = q["n"]
    sea m = q["m"]
    sea p = 0
    sea oscuros = 0
    sea yy = 0
    mientras (yy < n) {
        p = p + _qr_linea_penal(m[yy])
        sea col = []
        sea x = 0
        mientras (x < n) {
            col.agregar(m[x][yy])
            si (m[yy][x]) { oscuros = oscuros + 1 }
            si (x + 1 < n y yy + 1 < n) {
                sea c = m[yy][x]
                si (m[yy][x + 1] == c y m[yy + 1][x] == c y m[yy + 1][x + 1] == c) { p = p + 3 }
            }
            x = x + 1
        }
        p = p + _qr_linea_penal(col)
        yy = yy + 1
    }
    sea total = n * n
    sea k = techo(absoluto(oscuros * 20 - total * 10) / total) - 1
    p = p + maximo(0, k) * 10
    retornar p
}

funcion _qr_copiar(q) {
    sea m = []
    para fila en q["m"] {
        sea r = []
        para c en fila { r.agregar(c) }
        m.agregar(r)
    }
    retornar {"version": q["version"], "nivel": q["nivel"], "n": q["n"], "m": m, "f": q["f"]}
}

/// Crea un QR. opciones: nivel ("L" | "M" | "Q" | "H", M por defecto),
/// version (mínima, 1–40), mascara (0–7; automática si se omite),
/// modo ("numerico" | "alfanumerico" | "bytes"; se elige solo),
/// subir_nivel (verdadero: sube el nivel si cabe en la misma versión).
/// Devuelve {"version", "nivel", "mascara", "n", "m": filas de booleanos}.
funcion qr_crear(texto, opciones) {
    _qr_tablas()
    sea t = "" + texto
    sea nivel = texto_mayusculas(_qr_op(opciones, "nivel", "level", "M"))
    si (tiene_clave(_QR_FORMATO, nivel) == falso) { lanzar "codigo_qr: nivel desconocido " + nivel + " (usa L, M, Q o H)" }
    sea modo = _qr_op(opciones, "modo", "mode", nulo)
    si (modo == "numeric") { modo = "numerico" }
    si (modo == "alphanumeric") { modo = "alfanumerico" }
    si (modo == "byte") { modo = "bytes" }
    si (modo == nulo) { modo = _qr_modo(t) }
    sea seg = _qr_segmento(t, modo)
    sea vmin = _qr_op(opciones, "version", "version", 1)
    sea v = vmin
    sea usados = 0
    sea encontrado = falso
    mientras (v <= 40 y encontrado == falso) {
        usados = 4 + _qr_bits_cuenta(modo, v) + longitud(seg["bits"])
        si (seg["cuenta"] < potencia(2, _qr_bits_cuenta(modo, v)) y usados <= _qr_datos_cap(v, nivel) * 8) { encontrado = verdadero } sino { v = v + 1 }
    }
    si (encontrado == falso) { lanzar "codigo_qr: el texto no cabe en un QR (máximo versión 40)" }
    si (_qr_op(opciones, "subir_nivel", "boost", verdadero)) {
        para nv en ["Q", "H"] {
            sea orden = {"L": 0, "M": 1, "Q": 2, "H": 3}
            si (orden[nv] > orden[nivel] y usados <= _qr_datos_cap(v, nv) * 8) { nivel = nv }
        }
        si (nivel == "L" y usados <= _qr_datos_cap(v, "M") * 8) { nivel = "M" }
    }
    sea cap = _qr_datos_cap(v, nivel) * 8
    sea bits = []
    _qr_agregar_bits(bits, seg["modo"], 4)
    _qr_agregar_bits(bits, seg["cuenta"], _qr_bits_cuenta(modo, v))
    para b en seg["bits"] { bits.agregar(b) }
    sea term = minimo(4, cap - longitud(bits))
    sea i = 0
    mientras (i < term) { bits.agregar(0)  i = i + 1 }
    mientras (longitud(bits) % 8 != 0) { bits.agregar(0) }
    sea datos = []
    i = 0
    mientras (i < longitud(bits)) {
        sea byte = 0
        sea k = 0
        mientras (k < 8) { byte = byte * 2 + bits[i + k]  k = k + 1 }
        datos.agregar(byte)
        i = i + 8
    }
    sea relleno = 236
    mientras (longitud(datos) * 8 < cap) {
        datos.agregar(relleno)
        si (relleno == 236) { relleno = 17 } sino { relleno = 236 }
    }
    // Bloques con corrección de errores, intercalados.
    sea nb = _QR_BLOQUES[nivel][v]
    sea ecl = _QR_ECC[nivel][v]
    sea crudos = piso(_qr_crudos(v) / 8)
    sea cortos = nb - crudos % nb
    sea largo_corto = piso(crudos / nb)
    sea divisor = _qr_divisor(ecl)
    sea bloques = []
    sea k = 0
    i = 0
    mientras (i < nb) {
        sea extra = 1
        si (i < cortos) { extra = 0 }
        sea dat = []
        sea j = 0
        mientras (j < largo_corto - ecl + extra) { dat.agregar(datos[k + j])  j = j + 1 }
        k = k + longitud(dat)
        sea ecc = _qr_resto(dat, divisor)
        si (i < cortos) { dat.agregar(0) }
        para e en ecc { dat.agregar(e) }
        bloques.agregar(dat)
        i = i + 1
    }
    sea final = []
    i = 0
    mientras (i < longitud(bloques[0])) {
        sea j = 0
        mientras (j < nb) {
            si (i != largo_corto - ecl o j >= cortos) { final.agregar(bloques[j][i]) }
            j = j + 1
        }
        i = i + 1
    }
    sea base = _qr_base(v, nivel)
    _qr_dibujar(base, final)
    sea mascara = _qr_op(opciones, "mascara", "mask", nulo)
    sea mejor = nulo
    sea mejor_p = 0
    sea candidatas = [0, 1, 2, 3, 4, 5, 6, 7]
    si (mascara != nulo) { candidatas = [mascara] }
    para c en candidatas {
        sea q = _qr_copiar(base)
        _qr_aplicar_mascara(q, c)
        _qr_formato(q, c)
        sea p = 0
        si (longitud(candidatas) > 1) { p = _qr_penal(q) }
        si (mejor == nulo o p < mejor_p) { mejor = q  mejor_p = p  mejor["mascara"] = c }
    }
    retornar {"version": v, "nivel": nivel, "mascara": mejor["mascara"], "n": mejor["n"], "m": mejor["m"], "modo": modo}
}

/// ¿Está oscuro el módulo (x, y)? Fuera del código es claro.
funcion qr_modulo(q, x, yy) {
    si (x < 0 o yy < 0 o x >= q["n"] o yy >= q["n"]) { retornar falso }
    retornar q["m"][yy][x]
}

funcion _qr_hex(c) {
    si (texto_empieza_con(c, "#")) { retornar c }
    retornar c
}

/// SVG. opciones: modulo (px por módulo, 4), margen (módulos de zona
/// tranquila, 4), color ("#000"), fondo ("#fff"; nulo = transparente).
funcion qr_svg(q, opciones) {
    sea mod = _qr_op(opciones, "modulo", "module", 4)
    sea margen = _qr_op(opciones, "margen", "border", 4)
    sea color = _qr_op(opciones, "color", "color", "#000")
    sea fondo = _qr_op(opciones, "fondo", "background", "#fff")
    sea lado = (q["n"] + margen * 2)
    sea camino = []
    sea yy = 0
    mientras (yy < q["n"]) {
        sea x = 0
        mientras (x < q["n"]) {
            si (q["m"][yy][x]) {
                sea x0 = x
                mientras (x < q["n"] y q["m"][yy][x]) { x = x + 1 }
                camino.agregar("M" + (x0 + margen) + " " + (yy + margen) + "h" + (x - x0) + "v1h-" + (x - x0) + "z")
            } sino { x = x + 1 }
        }
        yy = yy + 1
    }
    sea s = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 " + lado + " " + lado + "\" width=\"" + (lado * mod) + "\" height=\"" + (lado * mod) + "\" shape-rendering=\"crispEdges\">"
    si (fondo != nulo) { s = s + "<rect width=\"100%\" height=\"100%\" fill=\"" + fondo + "\"/>" }
    retornar s + "<path fill=\"" + color + "\" d=\"" + unir(camino, "") + "\"/></svg>"
}

/// Texto con medios bloques Unicode (2 filas por línea), para la terminal.
funcion qr_texto(q, margen) {
    sea b = margen ?? 2
    sea l = []
    sea yy = -b
    mientras (yy < q["n"] + b) {
        sea linea = ""
        sea x = -b
        mientras (x < q["n"] + b) {
            sea a = qr_modulo(q, x, yy)
            sea c = qr_modulo(q, x, yy + 1)
            si (a y c) { linea = linea + " " }
            si (a y c == falso) { linea = linea + "▄" }
            si (a == falso y c) { linea = linea + "▀" }
            si (a == falso y c == falso) { linea = linea + "█" }
            x = x + 1
        }
        l.agregar(linea)
        yy = yy + 2
    }
    retornar unir(l, "\n")
}

/// Contenido de un QR de WiFi (los teléfonos lo ofrecen para conectarse).
funcion qr_wifi(red, clave, seguridad, oculta) {
    sea esc = funcion(s) {
        sea r = "" + s
        para c en ["\\", ";", ",", ":", "\""] { r = texto_reemplazar(r, c, "\\" + c) }
        retornar r
    }
    sea t = "WIFI:T:" + (seguridad ?? "WPA") + ";S:" + esc(red) + ";"
    si (clave != nulo y clave != "") { t = t + "P:" + esc(clave) + ";" }
    si (oculta == verdadero) { t = t + "H:true;" }
    retornar t + ";"
}

// ── Códigos de barras ─────────────────────────────────────────────────────

sea _EAN_L = ["0001101", "0011001", "0010011", "0111101", "0100011", "0110001", "0101111", "0111011", "0110111", "0001011"]
sea _EAN_G = ["0100111", "0110011", "0011011", "0100001", "0011101", "0111001", "0000101", "0010001", "0001001", "0010111"]
sea _EAN_R = ["1110010", "1100110", "1101100", "1000010", "1011100", "1001110", "1010000", "1000100", "1001000", "1110100"]
sea _EAN_PAR = ["LLLLLL", "LLGLGG", "LLGGLG", "LLGGGL", "LGLLGG", "LGGLLG", "LGGGLL", "LGLGLG", "LGLGGL", "LGGLGL"]

/// Dígito verificador EAN/UPC (módulo 10).
funcion barras_digito_control(digitos) {
    sea s = 0
    sea i = longitud(digitos) - 1
    sea peso = 3
    mientras (i >= 0) {
        s = s + (byte_en(digitos, i) - 48) * peso
        si (peso == 3) { peso = 1 } sino { peso = 3 }
        i = i - 1
    }
    retornar (10 - s % 10) % 10
}

funcion _ean_solo_digitos(t) {
    sea i = 0
    mientras (i < longitud(t)) {
        si (byte_en(t, i) < 48 o byte_en(t, i) > 57) { lanzar "codigo_qr: un EAN solo lleva dígitos" }
        i = i + 1
    }
}

/// EAN-13 desde 12 dígitos (agrega el verificador) o 13 (lo comprueba).
funcion barras_ean13(numero) {
    sea t = "" + numero
    _ean_solo_digitos(t)
    si (longitud(t) == 12) { t = t + barras_digito_control(t) } sino {
        si (longitud(t) != 13) { lanzar "codigo_qr: EAN-13 necesita 12 o 13 dígitos" }
        si (barras_digito_control(subcadena(t, 0, 12)) != byte_en(t, 12) - 48) { lanzar "codigo_qr: dígito verificador incorrecto (debería ser " + barras_digito_control(subcadena(t, 0, 12)) + ")" }
    }
    sea par = _EAN_PAR[byte_en(t, 0) - 48]
    sea b = "101"
    sea i = 1
    mientras (i <= 6) {
        sea d = byte_en(t, i) - 48
        si (subcadena(par, i - 1, i) == "L") { b = b + _EAN_L[d] } sino { b = b + _EAN_G[d] }
        i = i + 1
    }
    b = b + "01010"
    mientras (i <= 12) { b = b + _EAN_R[byte_en(t, i) - 48]  i = i + 1 }
    retornar {"tipo": "ean13", "texto": t, "barras": b + "101"}
}

/// UPC-A desde 11 dígitos (o 12 con verificador).
funcion barras_upca(numero) {
    sea t = "" + numero
    _ean_solo_digitos(t)
    si (longitud(t) == 11) { t = t + barras_digito_control(t) }
    sea r = barras_ean13("0" + t)
    r["tipo"] = "upca"
    r["texto"] = t
    retornar r
}

sea _C128 = ["11011001100", "11001101100", "11001100110", "10010011000", "10010001100", "10001001100", "10011001000", "10011000100", "10001100100", "11001001000", "11001000100", "11000100100", "10110011100", "10011011100", "10011001110", "10111001100", "10011101100", "10011100110", "11001110010", "11001011100", "11001001110", "11011100100", "11001110100", "11101101110", "11101001100", "11100101100", "11100100110", "11101100100", "11100110100", "11100110010", "11011011000", "11011000110", "11000110110", "10100011000", "10001011000", "10001000110", "10110001000", "10001101000", "10001100010", "11010001000", "11000101000", "11000100010", "10110111000", "10110001110", "10001101110", "10111011000", "10111000110", "10001110110", "11101110110", "11010001110", "11000101110", "11011101000", "11011100010", "11011101110", "11101011000", "11101000110", "11100010110", "11101101000", "11101100010", "11100011010", "11101111010", "11001000010", "11110001010", "10100110000", "10100001100", "10010110000", "10010000110", "10000101100", "10000100110", "10110010000", "10110000100", "10011010000", "10011000010", "10000110100", "10000110010", "11000010010", "11001010000", "11110111010", "11000010100", "10001111010", "10100111100", "10010111100", "10010011110", "10111100100", "10011110100", "10011110010", "11110100100", "11110010100", "11110010010", "11011011110", "11011110110", "11110110110", "10101111000", "10100011110", "10001011110", "10111101000", "10111100010", "11110101000", "11110100010", "10111011110", "10111101110", "11101011110", "11110101110", "11010000100", "11010010000", "11010011100", "1100011101011"]

/// Code 128 (conjunto B; usa C para tramos largos de dígitos).
funcion barras_code128(texto) {
    sea t = "" + texto
    si (longitud(t) == 0) { lanzar "codigo_qr: Code 128 vacío" }
    sea i = 0
    mientras (i < longitud(t)) {
        sea b = byte_en(t, i)
        si (b < 32 o b > 126) { lanzar "codigo_qr: Code 128 solo admite ASCII imprimible" }
        i = i + 1
    }
    sea es_dig = funcion(k) { retornar k < longitud(t) y byte_en(t, k) >= 48 y byte_en(t, k) <= 57 }
    sea corrida = funcion(k) {
        sea j = k
        mientras (es_dig(j)) { j = j + 1 }
        retornar j - k
    }
    sea valores = []
    sea conj = "B"
    si (corrida(0) >= 4 y (corrida(0) == longitud(t) o corrida(0) >= 4)) { conj = "C"  valores.agregar(105) } sino { valores.agregar(104) }
    i = 0
    mientras (i < longitud(t)) {
        si (conj == "C") {
            si (corrida(i) >= 2) {
                valores.agregar(a_numero(subcadena(t, i, i + 2)))
                i = i + 2
            } sino {
                valores.agregar(100)
                conj = "B"
            }
        } sino {
            sea r = corrida(i)
            si (r >= 6 o (r >= 4 y i + r == longitud(t))) {
                si (r % 2 == 1) {
                    valores.agregar(byte_en(t, i) - 32)
                    i = i + 1
                }
                valores.agregar(99)
                conj = "C"
            } sino {
                valores.agregar(byte_en(t, i) - 32)
                i = i + 1
            }
        }
    }
    sea suma = valores[0]
    i = 1
    mientras (i < longitud(valores)) { suma = suma + valores[i] * i  i = i + 1 }
    valores.agregar(suma % 103)
    sea b = ""
    para v en valores { b = b + _C128[v] }
    retornar {"tipo": "code128", "texto": t, "barras": b + _C128[106], "valores": valores}
}

/// Código de barras → SVG. opciones: modulo (2 px), alto (60), margen (10
/// módulos), texto (verdadero: muestra el número debajo).
funcion barras_svg(c, opciones) {
    sea mod = _qr_op(opciones, "modulo", "module", 2)
    sea alto = _qr_op(opciones, "alto", "height", 60)
    sea margen = _qr_op(opciones, "margen", "border", 10)
    sea con_texto = _qr_op(opciones, "texto", "text", verdadero)
    sea b = c["barras"]
    sea ancho = (longitud(b) + margen * 2) * mod
    sea total = alto
    si (con_texto) { total = alto + 16 }
    sea r = []
    sea i = 0
    mientras (i < longitud(b)) {
        si (subcadena(b, i, i + 1) == "1") {
            sea j = i
            mientras (j < longitud(b) y subcadena(b, j, j + 1) == "1") { j = j + 1 }
            r.agregar("<rect x=\"" + ((i + margen) * mod) + "\" y=\"0\" width=\"" + ((j - i) * mod) + "\" height=\"" + alto + "\"/>")
            i = j
        } sino { i = i + 1 }
    }
    sea s = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + ancho + "\" height=\"" + total + "\" viewBox=\"0 0 " + ancho + " " + total + "\"><rect width=\"100%\" height=\"100%\" fill=\"#fff\"/><g fill=\"#000\">" + unir(r, "") + "</g>"
    si (con_texto) {
        sea txt = texto_reemplazar(texto_reemplazar(texto_reemplazar(c["texto"], "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
        s = s + "<text x=\"" + (ancho / 2) + "\" y=\"" + (alto + 13) + "\" font-family=\"monospace\" font-size=\"14\" text-anchor=\"middle\">" + txt + "</text>"
    }
    retornar s + "</svg>"
}
