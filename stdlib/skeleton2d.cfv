// stdlib/skeleton2d.cfv — animación 2D por huesos (formato Spine): nombres en inglés del módulo "esqueleto".
// English names for the "esqueleto" module; both can be used together.


importar "esqueleto"

funcion _skeleton2d_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_skeleton2d_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _skeleton2d_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _SKELETON2D_RES = {"nombre": "name", "x": "x", "y": "y", "rotacion": "rotation", "escala_x": "scale_x", "escala_y": "scale_y", "local": "local", "matriz": "matrix", "animacion": "animation", "tiempo": "time", "bucle": "loop", "terminada": "finished", "mezclando_desde": "mixing_from"}
sea _SKELETON2D_OPT = {"x": "x", "y": "y", "scale": "escala", "y_down": "y_abajo", "smooth": "suave", "bones": "huesos", "bone_color": "color_huesos"}

funcion skel_load(fuente) { retornar esqueleto_cargar(fuente) }
funcion skel_setup_pose(e) { retornar esqueleto_pose_inicial(e) }
funcion skel_apply(e, nombre, t, bucle, alfa, desde) { retornar esqueleto_aplicar(e, nombre, t, bucle, alfa, desde) }
funcion skel_update_world(e) { retornar esqueleto_mundo(e) }
funcion skel_bone(e, nombre) { retornar _skeleton2d_tr(esqueleto_hueso(e, nombre), _SKELETON2D_RES) }
funcion skel_set_bone(e, nombre, valores) { retornar esqueleto_mover_hueso(e, nombre, valores) }
funcion skel_set_position(e, x, y, escala_x, escala_y) { retornar esqueleto_posicion(e, x, y, escala_x, escala_y) }
funcion skel_world_to_local(e, nombre, x, y) { retornar esqueleto_mundo_a_local(e, nombre, x, y) }
funcion skel_skins(e) { retornar esqueleto_pieles(e) }
funcion skel_animations(e) { retornar esqueleto_animaciones(e) }
funcion skel_duration(e, nombre) { retornar esqueleto_duracion(e, nombre) }
funcion skel_set_skin(e, nombre) { retornar esqueleto_piel(e, nombre) }
funcion skel_attachment(e, ranura, nombre) { retornar esqueleto_adjunto(e, ranura, nombre) }
funcion skel_set_attachment(e, ranura, nombre) { retornar esqueleto_poner_adjunto(e, ranura, nombre) }
funcion skel_draw_list(e, atlas) { retornar esqueleto_triangulos(e, atlas) }
funcion skel_bounding_boxes(e) { retornar esqueleto_cajas(e) }
funcion skel_hit_test(e, x, y) { retornar esqueleto_tocar(e, x, y) }
funcion skel_point(e, ranura, nombre) { retornar _skeleton2d_tr(esqueleto_punto(e, ranura, nombre), _SKELETON2D_RES) }
funcion skel_bounds(e) { retornar esqueleto_limites(e) }
funcion skel_atlas(texto, cargar_pagina) { retornar esqueleto_atlas(texto, cargar_pagina) }
funcion skel_render_image(e, atlas, img, opciones) { retornar esqueleto_dibujar_imagen(e, atlas, img, _skeleton2d_opt(opciones)) }
funcion skel_render_vector(e, lienzo, opciones) { retornar esqueleto_dibujar_vector(e, lienzo, _skeleton2d_opt(opciones)) }
funcion skel_state(e) { retornar esqueleto_estado(e) }
funcion skel_state_set_mix(est, desde, hacia, segundos) { retornar esqueleto_estado_mezcla(est, desde, hacia, segundos) }
funcion skel_state_set(est, pista, nombre, bucle) { retornar esqueleto_estado_poner(est, pista, nombre, bucle) }
funcion skel_state_add(est, pista, nombre, bucle, retraso) { retornar esqueleto_estado_encolar(est, pista, nombre, bucle, retraso) }
funcion skel_state_clear(est, pista) { retornar esqueleto_estado_quitar(est, pista) }
funcion skel_state_alpha(est, pista, alfa) { retornar esqueleto_estado_alfa(est, pista, alfa) }
funcion skel_state_update(est, segundos) { retornar esqueleto_estado_actualizar(est, segundos) }
funcion skel_state_apply(est) { retornar esqueleto_estado_aplicar(est) }
funcion skel_state_track(est, pista) { retornar _skeleton2d_tr(esqueleto_estado_pista(est, pista), _SKELETON2D_RES) }

funcion _skeleton2d_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_SKELETON2D_OPT[k] ?? k] = o[k] }
    retornar r
}
