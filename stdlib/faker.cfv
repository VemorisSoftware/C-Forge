// stdlib/faker.cfv — datos falsos reproducibles: nombres en inglés del módulo "ficticio".
// English names for the "ficticio" module; both can be used together.

importar "ficticio"

funcion faker_new(semilla, idioma) { retornar ficticio_nuevo(semilla, idioma) }
funcion faker_int(f, min, max) { retornar ficticio_entero(f, min, max) }
funcion faker_pick(f, lista) { retornar ficticio_elegir(f, lista) }
funcion faker_bool(f) { retornar ficticio_booleano(f) }
funcion faker_first_name(f) { retornar ficticio_nombre(f) }
funcion faker_last_name(f) { retornar ficticio_apellido(f) }
funcion faker_name(f) { retornar ficticio_nombre_completo(f) }
funcion faker_city(f) { retornar ficticio_ciudad(f) }
funcion faker_address(f) { retornar ficticio_direccion(f) }
funcion faker_company(f) { retornar ficticio_empresa(f) }
funcion faker_email(f) { retornar ficticio_correo(f) }
funcion faker_phone(f) { retornar ficticio_telefono(f) }
funcion faker_rut_check_digit(numero) { retornar ficticio_dv(numero) }
funcion faker_rut(f) { retornar ficticio_rut(f) }
funcion faker_sentence(f, palabras) { retornar ficticio_oracion(f, palabras) }
funcion faker_paragraph(f, oraciones) { retornar ficticio_parrafo(f, oraciones) }
funcion faker_uuid(f) { retornar ficticio_uuid(f) }
funcion faker_person(f) { retornar ficticio_persona(f) }
