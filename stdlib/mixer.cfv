// stdlib/mixer.cfv — FLAC y mezcla de pistas: nombres en inglés del módulo "mezcla".
// English names for the "mezcla" module; both can be used together.


importar "mezcla"

funcion _mixer_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_mixer_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _mixer_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _MIXER_RES = {"tasa": "rate", "canales": "channels", "bits": "bits", "muestras": "samples", "etiquetas": "tags", "valido": "valid", "calculado": "computed"}
sea _MIXER_OPT = {"verify_crc": "verificar_crc", "block": "bloque", "tags": "etiquetas", "rate": "tasa", "channels": "canales", "normalize": "normalizar"}

funcion flac_info(datos) { retornar _mixer_tr(mezcla_flac_info(datos), _MIXER_RES) }
funcion flac_decode(datos, opciones) { retornar _mixer_tr(mezcla_flac_decodificar(datos, _mixer_opt(opciones)), _MIXER_RES) }
funcion flac_samples_md5(canales, bits) { retornar mezcla_md5_muestras(canales, bits) }
funcion flac_verify(datos) { retornar _mixer_tr(mezcla_flac_verificar(datos), _MIXER_RES) }
funcion flac_encode(sonido, opciones) { retornar mezcla_flac_codificar(sonido, _mixer_opt(opciones)) }
funcion mixer_source(sonido) { retornar mezcla_fuente(sonido) }
funcion mixer_from_samples(canales, tasa) { retornar mezcla_desde_muestras(canales, tasa) }
funcion mixer_silence(ms, tasa, canales) { retornar mezcla_silencio(ms, tasa, canales) }
funcion mixer_frames(f) { retornar mezcla_cuadros(f) }
funcion mixer_duration_ms(f) { retornar mezcla_duracion_ms(f) }
funcion mixer_gain(f, g) { retornar mezcla_ganancia(f, g) }
funcion mixer_db(f, db) { retornar mezcla_db(f, db) }
funcion mixer_channels(f, n) { retornar mezcla_canales(f, n) }
funcion mixer_pan(f, pan) { retornar mezcla_panear(f, pan) }
funcion mixer_resample(f, tasa) { retornar mezcla_remuestrear(f, tasa) }
funcion mixer_speed(f, factor) { retornar mezcla_velocidad(f, factor) }
funcion mixer_trim(f, desde_ms, hasta_ms) { retornar mezcla_recortar(f, desde_ms, hasta_ms) }
funcion mixer_fade(f, entrada_ms, salida_ms) { retornar mezcla_fundido(f, entrada_ms, salida_ms) }
funcion mixer_concat(fuentes) { retornar mezcla_concatenar(fuentes) }
funcion mixer_repeat(f, n) { retornar mezcla_repetir(f, n) }
funcion mixer_delay(f, ms) { retornar mezcla_retrasar(f, ms) }
funcion mixer_mix(pistas, opciones) { retornar mezcla_mezclar(pistas, _mixer_opt(opciones)) }
funcion mixer_peak(f) { retornar mezcla_pico(f) }
funcion mixer_rms(f) { retornar mezcla_rms(f) }
funcion mixer_normalize(f, pico) { retornar mezcla_normalizar(f, pico) }
funcion mixer_pcm(f) { retornar mezcla_pcm(f) }
funcion mixer_wav(f) { retornar mezcla_wav(f) }
funcion mixer_open(datos) { retornar mezcla_abrir(datos) }

funcion _mixer_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_MIXER_OPT[k] ?? k] = o[k] }
    retornar r
}
