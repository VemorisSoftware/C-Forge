// stdlib/workflow.cfv — flujos de trabajo durables: nombres en inglés del módulo "proceso".
// English names for the "proceso" module; both can be used together.


importar "proceso"

funcion _workflow_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_workflow_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _workflow_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _WORKFLOW_RES = {"estado": "status", "resultado": "result", "despertar": "wake_at", "pasos": "steps", "tipo": "type", "corriendo": "running", "esperando": "waiting", "completado": "completed", "fallido": "failed", "cancelado": "cancelled"}
sea _WORKFLOW_OPT = {"file": "archivo", "clock": "reloj", "retries": "reintentos", "wait_ms": "espera_ms", "factor": "factor", "max_wait_ms": "espera_max_ms", "sleep": "dormir", "compensate": "compensar"}

funcion workflow_engine(opciones) { retornar proceso_motor(_workflow_opt(opciones)) }
funcion workflow_register(m, nombre, fn) { retornar proceso_registrar(m, nombre, fn) }
funcion workflow_start(m, tipo_flujo, id, entrada) { retornar _workflow_tr(proceso_iniciar(m, tipo_flujo, id, entrada), _WORKFLOW_RES) }
funcion workflow_activity(ctx, nombre, fn, args, opciones) { retornar proceso_actividad(ctx, nombre, fn, args, _workflow_opt(opciones)) }
funcion workflow_side_effect(ctx, fn) { retornar proceso_efecto(ctx, fn) }
funcion workflow_now(ctx) { retornar proceso_ahora(ctx) }
funcion workflow_sleep(ctx, ms) { retornar proceso_dormir(ctx, ms) }
funcion workflow_wait_signal(ctx, nombre, tiempo_ms_max) { retornar proceso_esperar_senal(ctx, nombre, tiempo_ms_max) }
funcion workflow_set_query(ctx, nombre, valor) { retornar proceso_publicar(ctx, nombre, valor) }
funcion workflow_version(ctx, id_cambio, maxima) { retornar proceso_version(ctx, id_cambio, maxima) }
funcion workflow_compensate(ctx) { retornar proceso_compensar(ctx) }
funcion workflow_advance(m, id) { retornar _workflow_tr(proceso_avanzar(m, id), _WORKFLOW_RES) }
funcion workflow_signal(m, id, nombre, dato) { retornar _workflow_tr(proceso_senal(m, id, nombre, dato), _WORKFLOW_RES) }
funcion workflow_query(m, id, nombre) { retornar proceso_consultar(m, id, nombre) }
funcion workflow_cancel(m, id) { retornar proceso_cancelar(m, id) }
funcion workflow_status(m, id) { retornar _workflow_tr(proceso_estado(m, id), _WORKFLOW_RES) }
funcion workflow_tick(m) { retornar proceso_tic(m) }
funcion workflow_list(m, estado) { retornar _workflow_tr(proceso_listar(m, estado), _WORKFLOW_RES) }
funcion workflow_worker(m, intervalo_ms) { retornar proceso_trabajar(m, intervalo_ms) }

funcion _workflow_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_WORKFLOW_OPT[k] ?? k] = o[k] }
    retornar r
}
