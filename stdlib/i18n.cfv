// stdlib/i18n.cfv — internacionalización: nombres en inglés del módulo "idiomas".
// English names for the "idiomas" module; both can be used together.

importar "idiomas"

funcion i18n_new(recursos, idioma, respaldo) { retornar idiomas_nuevo(recursos, idioma, respaldo) }
funcion i18n_set_language(i, idioma) { retornar idiomas_cambiar(i, idioma) }
funcion i18n_language(i) { retornar idiomas_actual(i) }
funcion i18n_add(i, idioma, textos) { retornar idiomas_agregar(i, idioma, textos) }
funcion i18n_t(i, clave, vars) { retornar idiomas_t(i, clave, vars) }
funcion i18n_exists(i, clave) { retornar idiomas_existe(i, clave) }
funcion i18n_number(i, n, decimales) { retornar idiomas_numero(i, n, decimales) }
