// stdlib/iso8583.cfv — mensajes ISO 8583: nombres en inglés del módulo "mensaje_bancario".
// English names for the "mensaje_bancario" module; both can be used together.

importar "mensaje_bancario"

funcion iso8583_define(campos) { retornar mensaje_bancario_definir(campos) }
funcion iso8583_pack(mti, campos) { retornar mensaje_bancario_armar(mti, campos) }
/// {"mti", "fields"}
funcion iso8583_unpack(texto) {
    sea m = mensaje_bancario_leer(texto)
    retornar {"mti": m["mti"], "fields": m["campos"], "campos": m["campos"]}
}
funcion iso8583_mask_pan(pan) { retornar mensaje_bancario_enmascarar(pan) }
funcion iso8583_describe(m) { retornar mensaje_bancario_texto(m) }
funcion iso8583_response_mti(mti) { retornar mensaje_bancario_respuesta_mti(mti) }
funcion iso8583_luhn(pan) { retornar mensaje_bancario_luhn(pan) }
funcion iso8583_response_text(codigo) {
    sea en = {"00": "approved", "01": "refer to issuer", "03": "invalid merchant", "05": "do not honor", "12": "invalid transaction", "13": "invalid amount", "14": "invalid card", "30": "format error", "41": "lost card", "43": "stolen card", "51": "insufficient funds", "54": "expired card", "55": "incorrect PIN", "57": "transaction not permitted", "61": "exceeds limit", "62": "restricted card", "65": "exceeds frequency", "75": "PIN tries exceeded", "91": "issuer unavailable", "96": "system malfunction"}
    si (tiene_clave(en, "" + codigo)) { retornar en["" + codigo] }
    retornar "unknown"
}
