// stdlib/onnxruntime.cfv — Inferencia de modelos ONNX (estilo ONNX Runtime): nombres en inglés del módulo "cerebro".
// English names for the "cerebro" module; both can be used together.

importar "cerebro"

funcion ort_load(ruta) { retornar cerebro_cargar(ruta) }
funcion ort_load_bytes(datos) { retornar cerebro_desde_bytes(datos) }
funcion ort_inputs(m) { retornar cerebro_entradas(m) }
funcion ort_outputs(m) { retornar cerebro_salidas(m) }
funcion ort_tensor(forma, datos) { retornar cerebro_tensor(forma, datos) }
funcion ort_run(m, entradas, salidas) { retornar cerebro_ejecutar(m, entradas, salidas) }
