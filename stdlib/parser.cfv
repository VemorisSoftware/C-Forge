// stdlib/parser.cfv — combinadores de analizadores: nombres en inglés del módulo "gramatica".
// English names for the "gramatica" module; both can be used together.

importar "gramatica"

funcion parser_literal(s) { retornar gramatica_literal(s) }
funcion parser_symbol(s) { retornar gramatica_simbolo(s) }
funcion parser_regex(patron, nombre) { retornar gramatica_regex(patron, nombre) }
funcion parser_lexeme(par) { retornar gramatica_lexema(par) }
funcion parser_seq(partes) { retornar gramatica_secuencia(partes) }
funcion parser_choice(opciones) { retornar gramatica_alternativa(opciones) }
funcion parser_many(par, min) { retornar gramatica_muchos(par, min) }
funcion parser_optional(par, defecto) { retornar gramatica_opcional(par, defecto) }
funcion parser_sep_by(par, separador, min) { retornar gramatica_separados(par, separador, min) }
funcion parser_map(par, f) { retornar gramatica_mapear(par, f) }
funcion parser_between(abre, par, cierra) { retornar gramatica_entre(abre, par, cierra) }
funcion parser_lazy(f) { retornar gramatica_recursivo(f) }
funcion parser_operators(atomo, niveles) { retornar gramatica_operadores(atomo, niveles) }
funcion parser_parse(par, texto) { retornar gramatica_analizar(par, texto) }
funcion parser_number() { retornar gramatica_numero() }
funcion parser_identifier() { retornar gramatica_identificador() }
funcion parser_string() { retornar gramatica_cadena() }
