// stdlib/ta.cfv — análisis técnico: nombres en inglés del módulo "indicadores".
// English names for the "indicadores" module; both can be used together.

importar "indicadores"

funcion ta_sma(xs, periodo) { retornar indicadores_sma(xs, periodo) }
funcion ta_ema(xs, periodo, alfa) { retornar indicadores_ema(xs, periodo, alfa) }
funcion ta_rsi(xs, periodo) { retornar indicadores_rsi(xs, periodo) }
/// {"macd", "signal", "histogram"}
funcion ta_macd(xs, rapida, lenta, senal) {
    sea r = indicadores_macd(xs, rapida, lenta, senal)
    retornar {"macd": r["macd"], "signal": r["senal"], "histogram": r["histograma"]}
}
/// {"middle", "upper", "lower"}
funcion ta_bollinger(xs, periodo, k) {
    sea r = indicadores_bollinger(xs, periodo, k)
    retornar {"middle": r["media"], "upper": r["superior"], "lower": r["inferior"]}
}
funcion ta_atr(velas, periodo) { retornar indicadores_atr(velas, periodo) }
funcion ta_stochastic(velas, periodo, suavizado) { retornar indicadores_estocastico(velas, periodo, suavizado) }
funcion ta_obv(cierres, volumenes) { retornar indicadores_obv(cierres, volumenes) }
funcion ta_vwap(velas) { retornar indicadores_vwap(velas) }
funcion ta_returns(xs, logaritmicos) { retornar indicadores_retornos(xs, logaritmicos) }
funcion ta_max_drawdown(xs) { retornar indicadores_caida_maxima(xs) }
funcion ta_crossovers(a, b) { retornar indicadores_cruces(a, b) }
