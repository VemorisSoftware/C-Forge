// stdlib/cache.cfv — cachés y colecciones avanzadas: nombres en inglés del módulo "caja".
// English names for the "caja" module; both can be used together.


importar "caja"

funcion _cache_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_cache_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _cache_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _CACHE_RES = {"aciertos": "hits", "fallos": "misses", "tasa": "hit_rate", "cargas": "loads", "fallos_carga": "load_failures", "desalojos": "evictions", "carga_promedio_ms": "average_load_ms", "cantidad": "size"}
sea _CACHE_OPT = {"max": "maximo", "max_weight": "peso_maximo", "weigher": "peso", "policy": "politica", "expire_after_write_ms": "vence_escritura_ms", "expire_after_access_ms": "vence_lectura_ms", "refresh_after_write_ms": "refrescar_ms", "loader": "cargar", "on_evict": "al_desalojar", "clock": "reloj"}

funcion cache_new(opciones) { retornar caja_cache(_cache_opt(opciones)) }
funcion cache_put(c, clave, valor) { retornar caja_poner(c, clave, valor) }
funcion cache_get_if_present(c, clave) { retornar caja_si_esta(c, clave) }
funcion cache_get(c, clave, cargador) { retornar caja_obtener(c, clave, cargador) }
funcion cache_get_all(c, claves_, cargador) { retornar caja_obtener_varios(c, claves_, cargador) }
funcion cache_invalidate(c, clave) { retornar caja_invalidar(c, clave) }
funcion cache_invalidate_all(c) { retornar caja_invalidar_todo(c) }
funcion cache_clean_up(c) { retornar caja_limpiar(c) }
funcion cache_size(c) { retornar caja_cantidad(c) }
funcion cache_weight(c) { retornar caja_peso(c) }
funcion cache_keys(c) { retornar caja_claves(c) }
funcion cache_stats(c) { retornar _cache_tr(caja_estadisticas(c), _CACHE_RES) }
funcion memoize(f, opciones) { retornar caja_memo(f, _cache_opt(opciones)) }
funcion multimap_new() { retornar caja_multimapa() }
funcion multimap_put(mm, k, v) { retornar caja_mm_poner(mm, k, v) }
funcion multimap_get(mm, k) { retornar caja_mm_obtener(mm, k) }
funcion multimap_remove(mm, k, v) { retornar caja_mm_quitar(mm, k, v) }
funcion multimap_remove_all(mm, k) { retornar caja_mm_quitar_todos(mm, k) }
funcion multimap_keys(mm) { retornar caja_mm_claves(mm) }
funcion multimap_size(mm) { retornar caja_mm_cantidad(mm) }
funcion multimap_invert(mm) { retornar caja_mm_invertir(mm) }
funcion bimap_new() { retornar caja_bimapa() }
funcion bimap_put(bm, k, v, forzar) { retornar caja_bm_poner(bm, k, v, forzar) }
funcion bimap_get(bm, k) { retornar caja_bm_valor(bm, k) }
funcion bimap_get_key(bm, v) { retornar caja_bm_clave(bm, v) }
funcion bimap_inverse(bm) { retornar caja_bm_inverso(bm) }
funcion multiset_new(lista) { retornar caja_multiconjunto(lista) }
funcion multiset_add(mc, x, n) { retornar caja_mc_agregar(mc, x, n) }
funcion multiset_remove(mc, x, n) { retornar caja_mc_quitar(mc, x, n) }
funcion multiset_count(mc, x) { retornar caja_mc_contar(mc, x) }
funcion multiset_size(mc) { retornar caja_mc_total(mc) }
funcion multiset_most_common(mc, n) { retornar caja_mc_mas_comunes(mc, n) }
funcion table_new() { retornar caja_tabla() }
funcion table_put(t, fila, col, v) { retornar caja_tb_poner(t, fila, col, v) }
funcion table_get(t, fila, col) { retornar caja_tb_obtener(t, fila, col) }
funcion table_row(t, fila) { retornar caja_tb_fila(t, fila) }
funcion table_column(t, col) { retornar caja_tb_columna(t, col) }
funcion table_remove(t, fila, col) { retornar caja_tb_quitar(t, fila, col) }
funcion table_rows(t) { retornar caja_tb_filas(t) }
funcion table_columns(t) { retornar caja_tb_columnas(t) }
funcion rangeset_new() { retornar caja_rangos() }
funcion rangeset_add(rs, desde, hasta) { retornar caja_rg_agregar(rs, desde, hasta) }
funcion rangeset_remove(rs, desde, hasta) { retornar caja_rg_quitar(rs, desde, hasta) }
funcion rangeset_contains(rs, v) { retornar caja_rg_contiene(rs, v) }
funcion rangeset_ranges(rs) { retornar caja_rg_lista(rs) }
funcion rangeset_complement(rs, desde, hasta) { retornar caja_rg_complemento(rs, desde, hasta) }
funcion bloom_new(n, p) { retornar caja_bloom(n, p) }
funcion bloom_add(b, x) { retornar caja_bloom_agregar(b, x) }
funcion bloom_might_contain(b, x) { retornar caja_bloom_tal_vez(b, x) }
funcion rate_limiter(por_segundo, rafaga, reloj) { retornar caja_limitador(por_segundo, rafaga, reloj) }
funcion rate_limiter_try(l, n) { retornar caja_permitir(l, n) }
funcion rate_limiter_wait_ms(l, n) { retornar caja_espera_ms(l, n) }

funcion _cache_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_CACHE_OPT[k] ?? k] = o[k] }
    retornar r
}
