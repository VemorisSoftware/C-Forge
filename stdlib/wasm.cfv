// stdlib/wasm.cfv — intérprete de WebAssembly: nombres en inglés del módulo "huesped".
// English names for the "huesped" module; both can be used together.

importar "huesped"

funcion wasm_module(datos) { retornar huesped_modulo(datos) }
funcion wasm_instantiate(datos, importaciones) { retornar huesped_instanciar(datos, importaciones) }
funcion wasm_i64_text(p, con_signo) { retornar huesped_i64_texto(p, con_signo) }
funcion wasm_i64(t) { retornar huesped_i64(t) }
funcion wasm_call(inst, nombre, args) { retornar huesped_llamar(inst, nombre, args) }
funcion wasm_exports(inst) { retornar huesped_exportaciones(inst) }
funcion wasm_read(inst, dir, n) { retornar huesped_leer(inst, dir, n) }
funcion wasm_write(inst, dir, datos) { retornar huesped_escribir(inst, dir, datos) }
funcion wasm_c_string(inst, dir) { retornar huesped_texto_c(inst, dir) }
funcion wasm_global(inst, nombre) { retornar huesped_global(inst, nombre) }
funcion wasm_pages(inst) { retornar huesped_paginas(inst) }
