// stdlib/secretos.cfv — secretos cifrados que se pueden guardar en el
// repositorio: cifra solo los valores de un JSON o de un .env (las claves
// quedan legibles para revisar cambios), con autenticación de cada valor
// atada a su ruta (no se pueden intercambiar entre campos) y una huella del
// archivo completo. Inspirada en sops (MPL: solo la idea). En inglés:
// importar "secrets".
//
//   importar "secretos"
//   sea clave = secretos_clave()                          // guárdala fuera del repo
//   sea cifrado = secretos_cifrar_json({"db": {"clave": "s3cr3t"}, "puerto": 5432}, clave)
//   secretos_descifrar_json(cifrado, clave)               // {"db": {"clave": "s3cr3t"}, "puerto": 5432}
//   secretos_cifrar_env("API_KEY=abc\nMODO=prod\n", clave, ["MODO"])   // MODO queda en claro
//
// Valor cifrado: "ENC[c1:<nonce>:<datos>:<tipo>]".

importar "json"
importar "base64"

funcion secretos_clave() { retornar "SECRETOS-" + hex_de_bytes(bytes_aleatorios(32)) }

funcion _se_clave(k) {
    sea t = texto_recortar("" + k)
    si (texto_empieza_con(t, "SECRETOS-") == falso o longitud(t) != 73) { lanzar "secretos: clave inválida (usa secretos_clave())" }
    retornar bytes_de_hex(subcadena(t, 9, 73))
}

funcion _se_b64(t) { retornar texto_reemplazar(base64_codificar(t), "=", "") }
funcion _se_de_b64(t) {
    sea s = "" + t
    mientras (longitud(s) % 4 != 0) { s = s + "=" }
    retornar base64_decodificar(s)
}

funcion _se_cifrar_valor(clave, ruta, v) {
    sea t = "texto"
    sea plano = "" + v
    si (tipo(v) == "numero") { t = "numero" }
    si (tipo(v) == "booleano") { t = "booleano" }
    si (v == nulo) { t = "nulo"  plano = "" }
    sea nonce = bytes_aleatorios(12)
    sea c = chacha20_poly1305_cifrar(clave, nonce, plano, ruta + ":" + t)
    retornar "ENC[c1:" + _se_b64(nonce) + ":" + _se_b64(c) + ":" + t + "]"
}

funcion secretos_es_cifrado(v) { retornar tipo(v) == "texto" y texto_empieza_con(v, "ENC[c1:") y texto_termina_con(v, "]") }

funcion _se_descifrar_valor(clave, ruta, v) {
    sea p = texto_dividir(subcadena(v, 4, longitud(v) - 1), ":")
    si (longitud(p) != 4 o p[0] != "c1") { lanzar "secretos: valor cifrado mal formado en " + ruta }
    sea plano = nulo
    intentar { plano = chacha20_poly1305_descifrar(clave, _se_de_b64(p[1]), _se_de_b64(p[2]), ruta + ":" + p[3]) } capturar (e) { lanzar "secretos: no se pudo descifrar " + ruta + " (clave incorrecta o valor movido/alterado)" }
    si (p[3] == "numero") { retornar a_numero(plano) }
    si (p[3] == "booleano") { retornar plano == "verdadero" }
    si (p[3] == "nulo") { retornar nulo }
    retornar plano
}

funcion _se_recorrer(v, ruta, f, claro) {
    sea t = tipo(v)
    si (t == "mapa") {
        sea r = {}
        para k en claves(v) {
            si (k == "_secretos") { } sino {
                sea sub = ruta + "/" + k
                si (claro != nulo y tiene_clave(claro, k)) { r[k] = v[k] } sino { r[k] = _se_recorrer(v[k], sub, f, nulo) }
            }
        }
        retornar r
    }
    si (t == "lista") {
        sea r = []
        sea i = 0
        mientras (i < longitud(v)) { r.agregar(_se_recorrer(v[i], ruta + "/" + i, f, nulo))  i = i + 1 }
        retornar r
    }
    retornar f(ruta, v)
}

/// Cifra todos los valores (las claves listadas en "en_claro", de primer
/// nivel, no se cifran). Devuelve el JSON como texto.
funcion secretos_cifrar_json(datos, clave, en_claro) {
    sea k = _se_clave(clave)
    sea claro = {}
    para x en en_claro ?? [] { claro[x] = verdadero }
    sea r = _se_recorrer(datos, "", funcion(ruta, v) { retornar _se_cifrar_valor(k, ruta, v) }, claro)
    sea cuerpo = json_texto(r)
    r["_secretos"] = {"version": 1, "huella": hmac_sha256(k, cuerpo), "en_claro": en_claro ?? []}
    retornar json_texto(r)
}

/// Descifra y verifica la huella (nadie agregó, quitó ni cambió campos).
funcion secretos_descifrar_json(texto, clave) {
    sea k = _se_clave(clave)
    sea d = json_parsear(texto)
    si (tiene_clave(d, "_secretos") == falso) { lanzar "secretos: el archivo no tiene la sección _secretos" }
    sea meta = d["_secretos"]
    sea sin = {}
    para x en claves(d) { si (x != "_secretos") { sin[x] = d[x] } }
    si (hmac_sha256(k, json_texto(sin)) != meta["huella"]) { lanzar "secretos: clave incorrecta o archivo modificado (la huella no coincide)" }
    sea claro = {}
    para x en meta["en_claro"] { claro[x] = verdadero }
    retornar _se_recorrer(sin, "", funcion(ruta, v) {
        si (secretos_es_cifrado(v)) { retornar _se_descifrar_valor(k, ruta, v) }
        retornar v
    }, claro)
}

/// .env: cifra cada valor (menos las claves en_claro). Conserva comentarios.
funcion secretos_cifrar_env(texto, clave, en_claro) {
    sea k = _se_clave(clave)
    sea claro = {}
    para x en en_claro ?? [] { claro[x] = verdadero }
    sea l = []
    para linea en texto_dividir("" + texto, "\n") {
        sea t = texto_recortar(linea)
        sea igual = texto_indice(t, "=")
        si (t == "" o texto_empieza_con(t, "#") o igual <= 0) { l.agregar(linea) } sino {
            sea nombre = texto_recortar(subcadena(t, 0, igual))
            sea valor = texto_recortar(subcadena(t, igual + 1, longitud(t)))
            si ((texto_empieza_con(valor, "\"") y texto_termina_con(valor, "\"")) o (texto_empieza_con(valor, "'") y texto_termina_con(valor, "'"))) { si (longitud(valor) >= 2) { valor = subcadena(valor, 1, longitud(valor) - 1) } }
            si (tiene_clave(claro, nombre) o secretos_es_cifrado(valor)) { l.agregar(nombre + "=" + valor) } sino { l.agregar(nombre + "=" + _se_cifrar_valor(k, "env/" + nombre, valor)) }
        }
    }
    retornar unir(l, "\n")
}

/// .env cifrado → mapa nombre → valor.
funcion secretos_descifrar_env(texto, clave) {
    sea k = _se_clave(clave)
    sea r = {}
    para linea en texto_dividir("" + texto, "\n") {
        sea t = texto_recortar(linea)
        sea igual = texto_indice(t, "=")
        si (t != "" y texto_empieza_con(t, "#") == falso y igual > 0) {
            sea nombre = texto_recortar(subcadena(t, 0, igual))
            sea valor = texto_recortar(subcadena(t, igual + 1, longitud(t)))
            si (secretos_es_cifrado(valor)) { r[nombre] = _se_descifrar_valor(k, "env/" + nombre, valor) } sino { r[nombre] = valor }
        }
    }
    retornar r
}

/// Cambia la clave: descifra con la vieja y vuelve a cifrar con la nueva.
funcion secretos_rotar_json(texto, vieja, nueva) {
    sea d = json_parsear(texto)
    sea en_claro = d["_secretos"]["en_claro"]
    retornar secretos_cifrar_json(secretos_descifrar_json(texto, vieja), nueva, en_claro)
}
