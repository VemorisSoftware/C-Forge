// stdlib/science.cfv — optimización e interpolación: nombres en inglés del módulo "ciencia".
// English names for the "ciencia" module; both can be used together.

importar "ciencia"

/// {"x", "value", "iterations"}
funcion science_minimize(f, inicio, opciones) {
    sea r = ciencia_minimizar(f, inicio, opciones)
    retornar {"x": r["x"], "value": r["valor"], "iterations": r["iteraciones"]}
}
funcion science_minimize_scalar(f, a, b, tol) { retornar ciencia_minimo_1d(f, a, b, tol) }
funcion science_gradient(f, x, h) { retornar ciencia_gradiente(f, x, h) }
funcion science_solve(A, b) { retornar ciencia_resolver(A, b) }
/// {"params", "residual"}
funcion science_curve_fit(f, xs, ys, p0, iteraciones) {
    sea r = ciencia_ajustar(f, xs, ys, p0, iteraciones)
    retornar {"params": r["p"], "residual": r["residuo"]}
}
funcion science_interp(xs, ys, x) { retornar ciencia_interpolar(xs, ys, x) }
funcion science_spline(xs, ys) { retornar ciencia_spline(xs, ys) }
funcion science_spline_eval(s, x) { retornar ciencia_evaluar_spline(s, x) }
funcion science_ode(f, y0, t0, t1, n) { retornar ciencia_edo(f, y0, t0, t1, n) }
