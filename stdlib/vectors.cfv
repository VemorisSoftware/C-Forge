// stdlib/vectors.cfv — búsqueda vectorial: nombres en inglés del módulo "vecindad".
// English names for the "vecindad" module; both can be used together.

importar "vecindad"

funcion vectors_new(dimension, metrica) { retornar vecindad_nueva(dimension, metrica) }
funcion vectors_add(v, id, vector, meta) { retornar vecindad_agregar(v, id, vector, meta) }
funcion vectors_remove(v, id) { retornar vecindad_quitar(v, id) }
funcion vectors_size(v) { retornar vecindad_tamano(v) }
funcion vectors_search(v, consulta, k, filtro) { retornar vecindad_buscar(v, consulta, k, filtro) }
funcion vectors_cosine(a, b) { retornar vecindad_coseno(a, b) }
funcion vectors_save(v, ruta) { retornar vecindad_guardar(v, ruta) }
funcion vectors_load(ruta) { retornar vecindad_cargar(ruta) }
