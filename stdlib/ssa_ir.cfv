// stdlib/ssa_ir.cfv — código intermedio en SSA y sus optimizaciones: nombres en inglés del módulo "intermedio".
// English names for the "intermedio" module; both can be used together.

importar "intermedio"

funcion ir_parse(texto) { retornar intermedio_leer(texto) }
funcion ir_print(m) { retornar intermedio_texto(m) }
funcion ir_verify(m) { retornar intermedio_verificar(m) }
funcion ir_interpret(m, nombre, args) { retornar intermedio_ejecutar(m, nombre, args) }
funcion ir_mem2reg(f) { retornar intermedio_mem2reg(f) }
funcion ir_constant_fold(f) { retornar intermedio_plegar(f) }
funcion ir_dce(f) { retornar intermedio_muerto(f) }
funcion ir_simplify_cfg(f) { retornar intermedio_simplificar(f) }
funcion ir_cse(f) { retornar intermedio_cse(f) }
funcion ir_licm(f) { retornar intermedio_licm(f) }
funcion ir_size(m) { retornar intermedio_tamano(m) }
funcion ir_to_jit(m, nombre, opciones) { retornar intermedio_a_jit(m, nombre, opciones) }

sea _SSA_PASES = {"mem2reg": "mem2reg", "fold": "plegar", "constant_fold": "plegar", "cse": "cse", "licm": "licm", "dce": "muerto", "simplify_cfg": "simplificar", "simplify": "simplificar"}
sea _SSA_PASES_EN = {"mem2reg": "mem2reg", "plegar": "fold", "cse": "cse", "licm": "licm", "muerto": "dce", "simplificar": "simplify_cfg"}
// Run passes until nothing changes. options: "passes" (mem2reg, fold, cse,
// licm, dce, simplify_cfg). Returns changes per pass.
funcion ir_optimize(m, options) {
    sea o = options ?? {}
    sea op = {}
    si (tiene_clave(o, "passes")) {
        sea l = []
        para p en o["passes"] { l.agregar(_SSA_PASES[p] ?? p) }
        op["pases"] = l
    }
    sea r = intermedio_optimizar(m, op)
    sea t = {}
    para k en claves(r) { t[_SSA_PASES_EN[k] ?? k] = r[k] }
    retornar t
}
