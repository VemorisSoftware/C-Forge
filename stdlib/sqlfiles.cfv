// stdlib/sqlfiles.cfv — SQL sobre CSV y JSON: nombres en inglés del módulo "consulta_archivos".
// English names for the "consulta_archivos" module; both can be used together.

importar "consulta_archivos"

funcion sql_new() { retornar consulta_nueva() }
funcion sql_register(c, nombre, datos) { retornar consulta_registrar(c, nombre, datos) }
funcion sql_register_csv(c, nombre, texto, separador) { retornar consulta_registrar_csv(c, nombre, texto, separador) }
funcion sql_register_json(c, nombre, texto) { retornar consulta_registrar_json(c, nombre, texto) }
funcion sql_tables(c) { retornar consulta_tablas(c) }
funcion sql_scalar(c, sql, params) { retornar consulta_valor(c, sql, params) }

/// Runs a query: {"columns": [...], "rows": [maps]}.
funcion sql_query(c, sql, params) {
    sea r = consulta_sql(c, sql, params)
    retornar {"columns": r["columnas"], "rows": r["filas"]}
}

funcion sql_to_string(r, limit) { retornar consulta_texto({"columnas": r["columns"], "filas": r["rows"]}, limit) }
