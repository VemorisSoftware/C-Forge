// stdlib/parallel.cfv — paralelismo de datos: nombres en inglés del módulo "enjambre".
// English names for the "enjambre" module; both can be used together.


importar "enjambre"

funcion _parallel_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_parallel_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _parallel_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _PARALLEL_OPT = {"threads": "hilos", "chunk": "trozo"}

funcion par_threads() { retornar enjambre_hilos() }
funcion par_set_threads(n) { retornar enjambre_fijar_hilos(n) }
funcion par_map(lista, f, opciones) { retornar enjambre_mapear(lista, f, _parallel_opt(opciones)) }
funcion par_map_indexed(lista, f, opciones) { retornar enjambre_mapear_indice(lista, f, _parallel_opt(opciones)) }
funcion par_filter(lista, pred, opciones) { retornar enjambre_filtrar(lista, pred, _parallel_opt(opciones)) }
funcion par_for_each(lista, f, opciones) { retornar enjambre_cada(lista, f, _parallel_opt(opciones)) }
funcion par_reduce(lista, identidad, f, combinar, opciones) { retornar enjambre_reducir(lista, identidad, f, combinar, _parallel_opt(opciones)) }
funcion par_sum(lista) { retornar enjambre_suma(lista) }
funcion par_min_max(lista) { retornar enjambre_extremos(lista) }
funcion par_count(lista, pred, opciones) { retornar enjambre_contar(lista, pred, _parallel_opt(opciones)) }
funcion par_position(lista, pred, opciones) { retornar enjambre_buscar_indice(lista, pred, _parallel_opt(opciones)) }
funcion par_find(lista, pred, opciones) { retornar enjambre_buscar(lista, pred, _parallel_opt(opciones)) }
funcion par_any(lista, pred, opciones) { retornar enjambre_alguno(lista, pred, _parallel_opt(opciones)) }
funcion par_all(lista, pred, opciones) { retornar enjambre_todos(lista, pred, _parallel_opt(opciones)) }
funcion par_range(desde, hasta, f, opciones) { retornar enjambre_rango(desde, hasta, f, _parallel_opt(opciones)) }
funcion par_sort(lista, cmp, opciones) { retornar enjambre_ordenar(lista, cmp, _parallel_opt(opciones)) }
funcion par_join(fa, fb) { retornar enjambre_unir(fa, fb) }
funcion par_join_all(funciones) { retornar enjambre_todas(funciones) }

funcion _parallel_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_PARALLEL_OPT[k] ?? k] = o[k] }
    retornar r
}
