// stdlib/aprende.cfv — aprendizaje automático clásico, reproducible (con
// semilla): k-medias, k vecinos, regresión lineal múltiple, regresión
// logística, estandarizar, dividir datos y métricas. Inspirada en
// scikit-learn (BSD). En inglés: importar "ml".
//
//   importar "aprende"
//   sea m = aprende_logistica(X, y)                     // y con 0 y 1
//   aprende_predecir(m, [[1.5, 2.0]])                   // [1]
//   sea g = aprende_kmedias(puntos, 3, {"semilla": 7})  // {"centros", "etiquetas", "inercia"}
//   aprende_exactitud(y_real, y_pred)
//
// X es una lista de filas (listas de números); y una lista.

funcion _ap_azar(estado) {
    estado[0] = (estado[0] * 48271) % 2147483647
    retornar (estado[0] - 1) / 2147483646
}

funcion _ap_estado(semilla) {
    sea s = semilla ?? 42
    retornar [piso(absoluto(s)) % 2147483646 + 1]
}

funcion _ap_op(o, k, d) {
    si (o != nulo) { si (tiene_clave(o, k)) { retornar o[k] } }
    retornar d
}

funcion _ap_d2(a, b) {
    sea s = 0
    sea i = 0
    mientras (i < longitud(a)) { sea d = a[i] - b[i]  s = s + d * d  i = i + 1 }
    retornar s
}

funcion _ap_validar(X, y) {
    si (tipo(X) != "lista" o longitud(X) == 0) { lanzar "aprende: X necesita al menos una fila" }
    sea n = longitud(X[0])
    para f en X { si (longitud(f) != n) { lanzar "aprende: todas las filas de X deben tener " + n + " columnas" } }
    si (y != nulo) { si (longitud(y) != longitud(X)) { lanzar "aprende: X e y deben tener el mismo largo" } }
}

/// Divide en entrenamiento y prueba (barajado con semilla).
funcion aprende_dividir(X, y, proporcion_prueba, semilla) {
    _ap_validar(X, y)
    sea est = _ap_estado(semilla)
    sea idx = []
    sea i = 0
    mientras (i < longitud(X)) { idx.agregar(i)  i = i + 1 }
    i = longitud(idx) - 1
    mientras (i > 0) {
        sea j = piso(_ap_azar(est) * (i + 1))
        sea t = idx[i]  idx[i] = idx[j]  idx[j] = t
        i = i - 1
    }
    sea n_prueba = redondear(longitud(X) * (proporcion_prueba ?? 0.25), 0)
    sea r = {"X_entrenamiento": [], "y_entrenamiento": [], "X_prueba": [], "y_prueba": []}
    i = 0
    mientras (i < longitud(idx)) {
        sea k = idx[i]
        si (i < n_prueba) { r["X_prueba"].agregar(X[k])  r["y_prueba"].agregar(y[k]) } sino { r["X_entrenamiento"].agregar(X[k])  r["y_entrenamiento"].agregar(y[k]) }
        i = i + 1
    }
    retornar r
}

/// Aprende media y desviación por columna: {"medias", "desviaciones"}.
funcion aprende_escalador(X) {
    _ap_validar(X, nulo)
    sea n = longitud(X[0])
    sea medias = []
    sea desv = []
    sea c = 0
    mientras (c < n) {
        sea s = 0
        para f en X { s = s + f[c] }
        sea m = s / longitud(X)
        sea v = 0
        para f en X { v = v + (f[c] - m) * (f[c] - m) }
        sea d = raiz(v / longitud(X))
        si (d == 0) { d = 1 }
        medias.agregar(m)
        desv.agregar(d)
        c = c + 1
    }
    retornar {"medias": medias, "desviaciones": desv}
}

funcion aprende_escalar(escalador, X) {
    sea r = []
    para f en X {
        sea g = []
        sea c = 0
        mientras (c < longitud(f)) { g.agregar((f[c] - escalador["medias"][c]) / escalador["desviaciones"][c])  c = c + 1 }
        r.agregar(g)
    }
    retornar r
}

/// k-medias con inicio k-means++. opciones: semilla, iteraciones (100).
funcion aprende_kmedias(X, k, opciones) {
    _ap_validar(X, nulo)
    si (k < 1 o k > longitud(X)) { lanzar "aprende: k entre 1 y la cantidad de puntos" }
    sea est = _ap_estado(_ap_op(opciones, "semilla", _ap_op(opciones, "seed", 42)))
    sea iteraciones = _ap_op(opciones, "iteraciones", _ap_op(opciones, "iterations", 100))
    sea centros = [X[piso(_ap_azar(est) * longitud(X))]]
    mientras (longitud(centros) < k) {
        sea ds = []
        sea total = 0
        para p en X {
            sea m = _ap_d2(p, centros[0])
            para c en centros { m = minimo(m, _ap_d2(p, c)) }
            ds.agregar(m)
            total = total + m
        }
        sea elegido = longitud(X) - 1
        si (total > 0) {
            sea r = _ap_azar(est) * total
            sea acc = 0
            sea i = 0
            sea listo = falso
            mientras (i < longitud(X) y listo == falso) {
                acc = acc + ds[i]
                si (acc >= r y ds[i] > 0) { elegido = i  listo = verdadero }
                i = i + 1
            }
        }
        centros.agregar(X[elegido])
    }
    sea etiquetas = []
    para p en X { etiquetas.agregar(0) }
    sea it = 0
    sea cambio = verdadero
    mientras (cambio y it < iteraciones) {
        cambio = falso
        sea i = 0
        mientras (i < longitud(X)) {
            sea mejor = 0
            sea dm = _ap_d2(X[i], centros[0])
            sea c = 1
            mientras (c < k) {
                sea d = _ap_d2(X[i], centros[c])
                si (d < dm) { dm = d  mejor = c }
                c = c + 1
            }
            si (etiquetas[i] != mejor o it == 0) { si (etiquetas[i] != mejor) { cambio = verdadero }  etiquetas[i] = mejor }
            i = i + 1
        }
        sea nuevos = []
        sea c = 0
        mientras (c < k) {
            sea suma = []
            para x en X[0] { suma.agregar(0) }
            sea cuantos = 0
            i = 0
            mientras (i < longitud(X)) {
                si (etiquetas[i] == c) {
                    sea q = 0
                    mientras (q < longitud(suma)) { suma[q] = suma[q] + X[i][q]  q = q + 1 }
                    cuantos = cuantos + 1
                }
                i = i + 1
            }
            si (cuantos == 0) { nuevos.agregar(centros[c]) } sino {
                sea m = []
                para s en suma { m.agregar(s / cuantos) }
                nuevos.agregar(m)
            }
            c = c + 1
        }
        centros = nuevos
        it = it + 1
    }
    sea inercia = 0
    sea i = 0
    mientras (i < longitud(X)) { inercia = inercia + _ap_d2(X[i], centros[etiquetas[i]])  i = i + 1 }
    retornar {"tipo": "kmedias", "centros": centros, "etiquetas": etiquetas, "inercia": inercia, "iteraciones": it}
}

/// k vecinos (votación; empates al más cercano). Guarda los datos.
funcion aprende_knn(X, y, k) {
    _ap_validar(X, y)
    retornar {"tipo": "knn", "X": X, "y": y, "k": k ?? 5}
}

// Gauss–Jordan con pivoteo parcial: resuelve A·x = b.
funcion _ap_resolver(A, b) {
    sea n = longitud(A)
    sea M = []
    sea i = 0
    mientras (i < n) {
        sea fila = []
        para v en A[i] { fila.agregar(v) }
        fila.agregar(b[i])
        M.agregar(fila)
        i = i + 1
    }
    sea c = 0
    mientras (c < n) {
        sea piv = c
        sea r = c + 1
        mientras (r < n) { si (absoluto(M[r][c]) > absoluto(M[piv][c])) { piv = r }  r = r + 1 }
        si (absoluto(M[piv][c]) < 0.000000000001) { lanzar "aprende: columnas linealmente dependientes (sin solución única)" }
        sea t = M[c]  M[c] = M[piv]  M[piv] = t
        r = 0
        mientras (r < n) {
            si (r != c) {
                sea f = M[r][c] / M[c][c]
                sea q = c
                mientras (q <= n) { M[r][q] = M[r][q] - f * M[c][q]  q = q + 1 }
            }
            r = r + 1
        }
        c = c + 1
    }
    sea x = []
    i = 0
    mientras (i < n) { x.agregar(M[i][n] / M[i][i])  i = i + 1 }
    retornar x
}

/// Regresión lineal múltiple (mínimos cuadrados; "ridge" opcional).
funcion aprende_lineal(X, y, ridge) {
    _ap_validar(X, y)
    sea n = longitud(X[0]) + 1
    sea A = []
    sea b = []
    sea i = 0
    mientras (i < n) {
        sea fila = []
        sea j = 0
        mientras (j < n) { fila.agregar(0)  j = j + 1 }
        A.agregar(fila)
        b.agregar(0)
        i = i + 1
    }
    sea r = 0
    mientras (r < longitud(X)) {
        sea f = [1]
        para v en X[r] { f.agregar(v) }
        i = 0
        mientras (i < n) {
            b[i] = b[i] + f[i] * y[r]
            sea j = 0
            mientras (j < n) { A[i][j] = A[i][j] + f[i] * f[j]  j = j + 1 }
            i = i + 1
        }
        r = r + 1
    }
    si (ridge != nulo) { i = 1  mientras (i < n) { A[i][i] = A[i][i] + ridge  i = i + 1 } }
    sea w = _ap_resolver(A, b)
    sea pesos = []
    i = 1
    mientras (i < n) { pesos.agregar(w[i])  i = i + 1 }
    retornar {"tipo": "lineal", "intercepto": w[0], "pesos": pesos}
}

funcion _ap_sigmoide(z) {
    si (z >= 0) { retornar 1 / (1 + exponencial(0 - z)) }
    sea e = exponencial(z)
    retornar e / (1 + e)
}

/// Regresión logística binaria (y = 0/1) por descenso de gradiente sobre
/// datos estandarizados. opciones: iteraciones (2000), tasa (0.1), l2 (0).
funcion aprende_logistica(X, y, opciones) {
    _ap_validar(X, y)
    para v en y { si (v != 0 y v != 1) { lanzar "aprende: la logística necesita y con 0 y 1" } }
    sea esc = aprende_escalador(X)
    sea Z = aprende_escalar(esc, X)
    sea iteraciones = _ap_op(opciones, "iteraciones", _ap_op(opciones, "iterations", 2000))
    sea tasa = _ap_op(opciones, "tasa", _ap_op(opciones, "rate", 0.1))
    sea l2 = _ap_op(opciones, "l2", 0)
    sea n = longitud(Z[0])
    sea w = []
    sea j = 0
    mientras (j < n) { w.agregar(0)  j = j + 1 }
    sea b = 0
    sea it = 0
    mientras (it < iteraciones) {
        sea gw = []
        j = 0
        mientras (j < n) { gw.agregar(0)  j = j + 1 }
        sea gb = 0
        sea r = 0
        mientras (r < longitud(Z)) {
            sea z = b
            j = 0
            mientras (j < n) { z = z + w[j] * Z[r][j]  j = j + 1 }
            sea e = _ap_sigmoide(z) - y[r]
            j = 0
            mientras (j < n) { gw[j] = gw[j] + e * Z[r][j]  j = j + 1 }
            gb = gb + e
            r = r + 1
        }
        j = 0
        mientras (j < n) { w[j] = w[j] - tasa * (gw[j] / longitud(Z) + l2 * w[j])  j = j + 1 }
        b = b - tasa * gb / longitud(Z)
        it = it + 1
    }
    retornar {"tipo": "logistica", "pesos": w, "intercepto": b, "escalador": esc}
}

/// Probabilidad de clase 1 (logística).
funcion aprende_probabilidad(m, X) {
    si (m["tipo"] != "logistica") { lanzar "aprende: probabilidad solo para modelos logísticos" }
    sea r = []
    para f en aprende_escalar(m["escalador"], X) {
        sea z = m["intercepto"]
        sea j = 0
        mientras (j < longitud(f)) { z = z + m["pesos"][j] * f[j]  j = j + 1 }
        r.agregar(_ap_sigmoide(z))
    }
    retornar r
}

funcion aprende_predecir(m, X) {
    sea t = m["tipo"]
    sea r = []
    si (t == "lineal") {
        para f en X {
            sea s = m["intercepto"]
            sea j = 0
            mientras (j < longitud(f)) { s = s + m["pesos"][j] * f[j]  j = j + 1 }
            r.agregar(s)
        }
        retornar r
    }
    si (t == "logistica") {
        para p en aprende_probabilidad(m, X) { si (p >= 0.5) { r.agregar(1) } sino { r.agregar(0) } }
        retornar r
    }
    si (t == "kmedias") {
        para f en X {
            sea mejor = 0
            sea c = 1
            mientras (c < longitud(m["centros"])) {
                si (_ap_d2(f, m["centros"][c]) < _ap_d2(f, m["centros"][mejor])) { mejor = c }
                c = c + 1
            }
            r.agregar(mejor)
        }
        retornar r
    }
    si (t == "knn") {
        para f en X {
            sea pares = []
            sea i = 0
            mientras (i < longitud(m["X"])) { pares.agregar([_ap_d2(f, m["X"][i]), m["y"][i]])  i = i + 1 }
            pares = ordenar(pares, funcion(a, b) { retornar a[0] - b[0] })
            sea votos = {}
            sea primero = {}
            sea k = minimo(m["k"], longitud(pares))
            i = 0
            mientras (i < k) {
                sea et = "" + pares[i][1]
                votos[et] = (votos[et] ?? 0) + 1
                si (tiene_clave(primero, et) == falso) { primero[et] = i }
                i = i + 1
            }
            sea mejor = nulo
            sea valor = nulo
            i = 0
            mientras (i < k) {
                sea et = "" + pares[i][1]
                si (mejor == nulo) { mejor = et  valor = pares[i][1] } sino {
                    si (votos[et] > votos[mejor] o (votos[et] == votos[mejor] y primero[et] < primero[mejor])) { mejor = et  valor = pares[i][1] }
                }
                i = i + 1
            }
            r.agregar(valor)
        }
        retornar r
    }
    lanzar "aprende: modelo desconocido"
}

funcion aprende_exactitud(real, pred) {
    si (longitud(real) != longitud(pred) o longitud(real) == 0) { lanzar "aprende: listas del mismo largo" }
    sea ok = 0
    sea i = 0
    mientras (i < longitud(real)) { si (real[i] == pred[i]) { ok = ok + 1 }  i = i + 1 }
    retornar ok / longitud(real)
}

/// Error cuadrático medio y R² para regresión.
funcion aprende_error(real, pred) {
    sea n = longitud(real)
    sea m = 0
    para v en real { m = m + v }
    m = m / n
    sea res = 0
    sea tot = 0
    sea i = 0
    mientras (i < n) { res = res + (real[i] - pred[i]) * (real[i] - pred[i])  tot = tot + (real[i] - m) * (real[i] - m)  i = i + 1 }
    sea r2 = 1
    si (tot > 0) { r2 = 1 - res / tot }
    retornar {"ecm": res / n, "r2": r2}
}

/// Matriz de confusión: {"etiquetas": [...], "matriz": [[...]]} (filas = real).
funcion aprende_confusion(real, pred) {
    sea vistas = {}
    sea et = []
    para v en real { si (tiene_clave(vistas, "" + v) == falso) { vistas["" + v] = verdadero  et.agregar(v) } }
    para v en pred { si (tiene_clave(vistas, "" + v) == falso) { vistas["" + v] = verdadero  et.agregar(v) } }
    et = ordenar(et, funcion(a, b) { si ("" + a < "" + b) { retornar -1 }  retornar 1 })
    sea pos = {}
    sea i = 0
    mientras (i < longitud(et)) { pos["" + et[i]] = i  i = i + 1 }
    sea M = []
    para a en et {
        sea fila = []
        para b en et { fila.agregar(0) }
        M.agregar(fila)
    }
    i = 0
    mientras (i < longitud(real)) { M[pos["" + real[i]]][pos["" + pred[i]]] = M[pos["" + real[i]]][pos["" + pred[i]]] + 1  i = i + 1 }
    retornar {"etiquetas": et, "matriz": M}
}
