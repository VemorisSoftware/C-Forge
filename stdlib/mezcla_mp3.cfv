sea _M3_TABLAS = [[0, 0, 0], [0, 7, 0], [7, 17, 0], [24, 17, 0], [0, 0, 0], [41, 31, 0], [72, 31, 0], [103, 71, 0], [174, 71, 0], [245, 71, 0],
    [316, 127, 0], [443, 127, 0], [570, 127, 0], [697, 511, 0], [0, 0, 0], [1208, 511, 0], [1719, 511, 1], [1719, 511, 2], [1719, 511, 3], [1719, 511, 4],
    [1719, 511, 6], [1719, 511, 8], [1719, 511, 10], [1719, 511, 13], [2230, 512, 4], [2230, 512, 5], [2230, 512, 6], [2230, 512, 7], [2230, 512, 8], [2230, 512, 9],
    [2230, 512, 11], [2230, 512, 13], [2742, 31, 0], [2773, 31, 0]]

// Anchos de las bandas de factores de escala (largas, cortas por ventana y mixtas)
// por tasa: 11025/12000, 8000, 22050, 24000, 16000, 44100, 48000, 32000.
sea _M3_LARGAS = [
    [6, 6, 6, 6, 6, 6, 8, 10, 12, 14, 16, 20, 24, 28, 32, 38, 46, 52, 60, 68, 58, 54],
    [12, 12, 12, 12, 12, 12, 16, 20, 24, 28, 32, 40, 48, 56, 64, 76, 90, 2, 2, 2, 2, 2],
    [6, 6, 6, 6, 6, 6, 8, 10, 12, 14, 16, 20, 24, 28, 32, 38, 46, 52, 60, 68, 58, 54],
    [6, 6, 6, 6, 6, 6, 8, 10, 12, 14, 16, 18, 22, 26, 32, 38, 46, 54, 62, 70, 76, 36],
    [6, 6, 6, 6, 6, 6, 8, 10, 12, 14, 16, 20, 24, 28, 32, 38, 46, 52, 60, 68, 58, 54],
    [4, 4, 4, 4, 4, 4, 6, 6, 8, 8, 10, 12, 16, 20, 24, 28, 34, 42, 50, 54, 76, 158],
    [4, 4, 4, 4, 4, 4, 6, 6, 6, 8, 10, 12, 16, 18, 22, 28, 34, 40, 46, 54, 54, 192],
    [4, 4, 4, 4, 4, 4, 6, 6, 8, 10, 12, 16, 20, 24, 30, 38, 46, 56, 68, 84, 102, 26]]
sea _M3_CORTAS = [
    [4, 4, 4, 6, 8, 10, 12, 14, 18, 24, 30, 40, 18],
    [8, 8, 8, 12, 16, 20, 24, 28, 36, 2, 2, 2, 26],
    [4, 4, 4, 6, 6, 8, 10, 14, 18, 26, 32, 42, 18],
    [4, 4, 4, 6, 8, 10, 12, 14, 18, 24, 32, 44, 12],
    [4, 4, 4, 6, 8, 10, 12, 14, 18, 24, 30, 40, 18],
    [4, 4, 4, 4, 6, 8, 10, 12, 14, 18, 22, 30, 56],
    [4, 4, 4, 4, 6, 6, 10, 12, 14, 16, 20, 26, 66],
    [4, 4, 4, 4, 6, 8, 12, 16, 20, 26, 34, 42, 12]]
// Bandas largas del principio de los bloques mixtos.
sea _M3_MIXTAS_LARGAS = [[6, 6, 6, 6, 6, 6], [12, 12, 12], [6, 6, 6, 6, 6, 6], [6, 6, 6, 6, 6, 6], [6, 6, 6, 6, 6, 6], [4, 4, 4, 4, 4, 4, 6, 6], [4, 4, 4, 4, 4, 4, 6, 6], [4, 4, 4, 4, 4, 4, 6, 6]]

sea _M3_PARTICIONES = [
    [6, 5, 5, 5, 6, 5, 5, 5, 6, 5, 7, 3, 11, 10, 0, 0, 7, 7, 7, 0, 6, 6, 6, 3, 8, 8, 5, 0],
    [8, 9, 6, 12, 6, 9, 9, 9, 6, 9, 12, 6, 15, 18, 0, 0, 6, 15, 12, 0, 6, 12, 9, 6, 6, 18, 9, 0],
    [9, 9, 6, 12, 9, 9, 9, 9, 9, 9, 12, 6, 18, 18, 0, 0, 12, 12, 12, 0, 12, 9, 9, 6, 15, 12, 9, 0]]
sea _M3_SCFC = [0, 1, 2, 3, 12, 5, 6, 7, 9, 10, 11, 13, 14, 15, 18, 19]
sea _M3_MOD = [5, 5, 4, 4, 5, 5, 4, 1, 4, 3, 1, 1, 5, 6, 6, 1, 4, 4, 4, 1, 4, 3, 1, 1]
sea _M3_PRETAB = [1, 1, 1, 1, 2, 2, 3, 3, 3, 2]
sea _M3_CS = [0.857492925712, 0.881741997318, 0.949628649103, 0.983314592492, 0.995517816066, 0.999160558175, 0.999899082859, 0.999993151356]
sea _M3_CA = [-0.514495755428, -0.471731968565, -0.313377447826, -0.181913199611, -0.094574192526, -0.040965582885, -0.014198568572, -0.003699974674]
sea _M3_BR1 = [0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320]
sea _M3_BR2 = [0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160]
sea _M3_HZ = [44100, 48000, 32000]

funcion _m3_tablas() {
    si (tiene_clave(_M3_CACHE, "huff")) { retornar _M3_CACHE }
    sea b = bytes_de_hex(_M3_HUFF_HEX)
    sea h = []
    sea i = 0
    mientras (i < longitud(b)) {
        h.agregar(byte_en(b, i) * 256 + byte_en(b, i + 1))
        i = i + 2
    }
    _M3_CACHE["huff"] = h
    // IMDCT larga: cos(π/72 (2p + 1 + 18)(2m + 1)) y ventanas.
    sea pi = 3.141592653589793
    sea cl = []
    sea m = 0
    mientras (m < 18) {
        sea fila = []
        sea p = 0
        mientras (p < 36) {
            fila.agregar(coseno(pi / 72 * (2 * p + 19) * (2 * m + 1)))
            p = p + 1
        }
        cl.agregar(fila)
        m = m + 1
    }
    _M3_CACHE["cos36"] = cl
    sea cc = []
    m = 0
    mientras (m < 6) {
        sea fila = []
        sea p = 0
        mientras (p < 12) {
            fila.agregar(coseno(pi / 24 * (2 * p + 7) * (2 * m + 1)))
            p = p + 1
        }
        cc.agregar(fila)
        m = m + 1
    }
    _M3_CACHE["cos12"] = cc
    sea v = [[], [], [], []]
    sea k = 0
    mientras (k < 36) {
        v[0].agregar(seno(pi / 36 * (k + 0.5)))
        si (k < 18) { v[1].agregar(seno(pi / 36 * (k + 0.5))) } sino si (k < 24) { v[1].agregar(1.0) } sino si (k < 30) { v[1].agregar(seno(pi / 12 * (k + 0.5 - 18))) } sino { v[1].agregar(0.0) }
        si (k < 6) { v[3].agregar(0.0) } sino si (k < 12) { v[3].agregar(seno(pi / 12 * (k + 0.5 - 6))) } sino si (k < 18) { v[3].agregar(1.0) } sino { v[3].agregar(seno(pi / 36 * (k + 0.5))) }
        k = k + 1
    }
    k = 0
    mientras (k < 12) {
        v[2].agregar(seno(pi / 12 * (k + 0.5)))
        k = k + 1
    }
    _M3_CACHE["ventanas"] = v
    // Matriz de la síntesis polifásica.
    sea n = []
    sea i2 = 0
    mientras (i2 < 64) {
        sea fila = []
        sea j = 0
        mientras (j < 32) {
            fila.agregar(coseno((16 + i2) * (2 * j + 1) * pi / 64))
            j = j + 1
        }
        n.agregar(fila)
        i2 = i2 + 1
    }
    _M3_CACHE["sintesis"] = n
    sea d = []
    sea db = bytes_de_hex(_M3_D_HEX)
    i = 0
    mientras (i < longitud(db)) {
        sea x = bytes_leer_entero(db, i, 4, 1)
        si (x >= 2147483648) { x = x - 4294967296 }
        d.agregar(x / 1000000000.0)
        i = i + 4
    }
    _M3_CACHE["ventana_d"] = d
    retornar _M3_CACHE
}

sea _M3_CACHE = {}

// ---------- bits ----------

funcion _m3_lector(d) { retornar {"d": d, "p": 0} }

funcion _m3_bits(r, n) {
    sea v = 0
    sea k = 0
    sea p = r["p"]
    sea d = r["d"]
    mientras (k < n) {
        sea byte = p / 8
        sea b = byte_en(d, piso(byte))
        sea desp = 7 - p % 8
        v = v * 2 + piso(b / potencia(2, desp)) % 2
        p = p + 1
        k = k + 1
    }
    r["p"] = p
    retornar v
}

funcion _m3_bit(r) {
    sea p = r["p"]
    r["p"] = p + 1
    retornar piso(byte_en(r["d"], piso(p / 8)) / _M3_POT[7 - p % 8]) % 2
}

sea _M3_POT = [1, 2, 4, 8, 16, 32, 64, 128]

// ---------- cabecera ----------

/// Lee la cabecera de la trama en pos. nulo si no es válida.
funcion _m3_cabecera(d, pos) {
    si (pos + 4 > longitud(d)) { retornar nulo }
    sea b0 = byte_en(d, pos)
    sea b1 = byte_en(d, pos + 1)
    sea b2 = byte_en(d, pos + 2)
    sea b3 = byte_en(d, pos + 3)
    si (b0 != 255 o b1 < 224) { retornar nulo }
    sea ver = piso(b1 / 8) % 4
    sea capa = piso(b1 / 2) % 4
    sea bri = piso(b2 / 16)
    sea sri = piso(b2 / 4) % 4
    si (ver == 1 o capa == 0 o bri == 15 o bri == 0 o sri == 3) { retornar nulo }
    sea mpeg1 = ver == 3
    sea tasa = _M3_HZ[sri]
    si (ver == 2) { tasa = tasa / 2 }
    si (ver == 0) { tasa = tasa / 4 }
    sea relleno = piso(b2 / 2) % 2
    sea modo = piso(b3 / 64)
    sea r = {"ver": ver, "mpeg1": mpeg1, "capa": 4 - capa, "crc": b1 % 2 == 0, "tasa": tasa, "sri": sri, "relleno": relleno, "modo": modo, "ext": piso(b3 / 16) % 4, "canales": 2}
    si (modo == 3) { r["canales"] = 1 }
    si (r["capa"] != 3) {
        r["largo"] = 0
        retornar r
    }
    sea br = 0
    si (mpeg1) { br = _M3_BR1[bri] } sino { br = _M3_BR2[bri] }
    r["kbps"] = br
    si (mpeg1) { r["largo"] = piso(144000 * br / tasa) + relleno } sino { r["largo"] = piso(72000 * br / tasa) + relleno }
    r["granulos"] = 2
    si (mpeg1 == falso) { r["granulos"] = 1 }
    // Índice de las tablas de bandas.
    sea idx = sri + (piso(b1 / 8) % 2 + piso(b1 / 16) % 2) * 3
    si (idx != 0) { idx = idx - 1 }
    r["tabla"] = idx
    retornar r
}

// ---------- información lateral ----------

funcion _m3_lateral(h, r) {
    sea nc = h["canales"]
    sea s = {"granulos": []}
    sea scfsi = [[0, 0, 0, 0], [0, 0, 0, 0]]
    si (h["mpeg1"]) {
        s["inicio"] = _m3_bits(r, 9)
        si (nc == 1) { _m3_bits(r, 5) } sino { _m3_bits(r, 3) }
        sea ch = 0
        mientras (ch < nc) {
            sea b = 0
            mientras (b < 4) {
                scfsi[ch][b] = _m3_bits(r, 1)
                b = b + 1
            }
            ch = ch + 1
        }
    } sino {
        s["inicio"] = _m3_bits(r, 8)
        si (nc == 1) { _m3_bits(r, 1) } sino { _m3_bits(r, 2) }
    }
    sea gr = 0
    mientras (gr < h["granulos"]) {
        sea fila = []
        sea ch = 0
        mientras (ch < nc) {
            sea g = {"scfsi": scfsi[ch]}
            g["largo23"] = _m3_bits(r, 12)
            g["grandes"] = _m3_bits(r, 9)
            si (g["grandes"] > 288) { lanzar "mp3: big_values inválido" }
            g["ganancia"] = _m3_bits(r, 8)
            si (h["mpeg1"]) { g["compresion"] = _m3_bits(r, 4) } sino { g["compresion"] = _m3_bits(r, 9) }
            g["tipo"] = 0
            g["mixto"] = 0
            g["subganancia"] = [0, 0, 0]
            g["tablas"] = [0, 0, 0]
            si (_m3_bits(r, 1) == 1) {
                g["tipo"] = _m3_bits(r, 2)
                si (g["tipo"] == 0) { lanzar "mp3: tipo de bloque inválido" }
                g["mixto"] = _m3_bits(r, 1)
                g["tablas"][0] = _m3_bits(r, 5)
                g["tablas"][1] = _m3_bits(r, 5)
                sea w = 0
                mientras (w < 3) {
                    g["subganancia"][w] = _m3_bits(r, 3)
                    w = w + 1
                }
                g["region0"] = 7
                si (g["tipo"] == 2 y g["mixto"] == 0) { g["region0"] = 8 }
                g["region1"] = 255
            } sino {
                g["tablas"][0] = _m3_bits(r, 5)
                g["tablas"][1] = _m3_bits(r, 5)
                g["tablas"][2] = _m3_bits(r, 5)
                g["region0"] = _m3_bits(r, 4)
                g["region1"] = _m3_bits(r, 3)
            }
            si (h["mpeg1"]) { g["preflag"] = _m3_bits(r, 1) } sino { g["preflag"] = 0 }
            si (h["mpeg1"] == falso y g["compresion"] >= 500) { g["preflag"] = 1 }
            g["escala"] = _m3_bits(r, 1)
            g["count1"] = _m3_bits(r, 1)
            // Tabla de bandas de este gránulo.
            sea t = h["tabla"]
            g["n_largas"] = 22
            g["n_cortas"] = 0
            sea anchos = []
            si (g["tipo"] == 2) {
                si (g["mixto"] == 1) {
                    para a en _M3_MIXTAS_LARGAS[t] { anchos.agregar(a) }
                    g["n_largas"] = longitud(_M3_MIXTAS_LARGAS[t])
                    si (h["mpeg1"] == falso) { g["n_largas"] = 6 }
                    sea k = 3
                    mientras (k < 13) {
                        anchos.agregar(_M3_CORTAS[t][k])
                        anchos.agregar(_M3_CORTAS[t][k])
                        anchos.agregar(_M3_CORTAS[t][k])
                        k = k + 1
                    }
                    g["n_cortas"] = 30
                    g["corta_desde"] = 3
                } sino {
                    para a en _M3_CORTAS[t] {
                        anchos.agregar(a)
                        anchos.agregar(a)
                        anchos.agregar(a)
                    }
                    g["n_largas"] = 0
                    g["n_cortas"] = 39
                    g["corta_desde"] = 0
                }
            } sino { para a en _M3_LARGAS[t] { anchos.agregar(a) } }
            g["anchos"] = anchos
            fila.agregar(g)
            ch = ch + 1
        }
        s["granulos"].agregar(fila)
        gr = gr + 1
    }
    retornar s
}

// ---------- factores de escala ----------

// Devuelve {"scf": exponentes por banda (en cuartos de potencia de 2), "is": posiciones de intensidad}.
funcion _m3_factores(h, g, r, ch, previo, gr) {
    sea fila_part = 0
    si (g["n_cortas"] > 0 y g["n_largas"] > 0) { fila_part = 1 }
    si (g["n_cortas"] > 0 y g["n_largas"] == 0) { fila_part = 2 }
    sea part = []
    sea tam = [0, 0, 0, 0]
    sea desde = 0
    si (h["mpeg1"]) {
        sea p = _M3_SCFC[g["compresion"]]
        tam = [piso(p / 4), piso(p / 4), p % 4, p % 4]
    } sino {
        sea ist = 0
        si (h["ext"] % 2 == 1 y ch == 1 y h["modo"] == 1) { ist = 1 }
        sea sfc = piso(g["compresion"] / potencia(2, ist))
        sea k = ist * 12
        mientras (sfc >= 0) {
            sea modprod = 1
            sea i = 3
            mientras (i >= 0) {
                tam[i] = piso(sfc / modprod) % _M3_MOD[k + i]
                modprod = modprod * _M3_MOD[k + i]
                i = i - 1
            }
            sfc = sfc - modprod
            k = k + 4
        }
        desde = k
    }
    sea i = 0
    mientras (i < 4) {
        part.agregar(_M3_PARTICIONES[fila_part][desde + i])
        i = i + 1
    }
    sea scf = []
    sea pos_is = []
    sea k = 0
    mientras (k < 4 y part[k] > 0) {
        sea cnt = part[k]
        sea copiar = h["mpeg1"] y gr == 1 y g["tipo"] != 2 y g["scfsi"][k] == 1
        sea j = 0
        mientras (j < cnt) {
            si (copiar) {
                scf.agregar(previo[longitud(scf)] ?? 0)
                pos_is.agregar(previo[longitud(pos_is)] ?? 0)
            } sino si (tam[k] == 0) {
                scf.agregar(0)
                pos_is.agregar(0)
            } sino {
                sea v = _m3_bits(r, tam[k])
                scf.agregar(v)
                si (h["mpeg1"] == falso y v == potencia(2, tam[k]) - 1) { pos_is.agregar(-1) } sino { pos_is.agregar(v) }
            }
            j = j + 1
        }
        k = k + 1
    }
    mientras (longitud(scf) < g["n_largas"] + g["n_cortas"]) {
        scf.agregar(0)
        pos_is.agregar(0)
    }
    retornar {"scf": scf, "is": pos_is, "tam": tam}
}

// ---------- Huffman ----------

funcion _m3_huff(r, h, tabla, fin) {
    sea t = _M3_TABLAS[tabla]
    si (t[1] == 0) { retornar [0, 0] }
    sea base = t[0]
    sea punto = 0
    sea resto = 32
    sea x = 0
    sea y_ = 0
    mientras (verdadero) {
        sea e = h[base + punto]
        si (e < 256) {
            x = piso(e / 16) % 16
            y_ = e % 16
            romper
        }
        si (_m3_bit(r) == 1) {
            mientras (h[base + punto] % 256 >= 250) { punto = punto + h[base + punto] % 256 }
            punto = punto + h[base + punto] % 256
        } sino {
            mientras (piso(h[base + punto] / 256) >= 250) { punto = punto + piso(h[base + punto] / 256) }
            punto = punto + piso(h[base + punto] / 256)
        }
        resto = resto - 1
        si (resto <= 0 o punto >= t[1]) { romper }
    }
    si (tabla > 31) {
        sea v = piso(y_ / 8) % 2
        sea w = piso(y_ / 4) % 2
        sea xx = piso(y_ / 2) % 2
        sea yy = y_ % 2
        si (v > 0 y _m3_bit(r) == 1) { v = 0 - v }
        si (w > 0 y _m3_bit(r) == 1) { w = 0 - w }
        si (xx > 0 y _m3_bit(r) == 1) { xx = 0 - xx }
        si (yy > 0 y _m3_bit(r) == 1) { yy = 0 - yy }
        retornar [v, w, xx, yy]
    }
    si (t[2] > 0 y x == 15) { x = x + _m3_bits(r, t[2]) }
    si (x > 0 y _m3_bit(r) == 1) { x = 0 - x }
    si (t[2] > 0 y y_ == 15) { y_ = y_ + _m3_bits(r, t[2]) }
    si (y_ > 0 y _m3_bit(r) == 1) { y_ = 0 - y_ }
    retornar [x, y_]
}

// Devuelve las 576 líneas cuantizadas y cuántas no son cero.
funcion _m3_lineas(r, g, h, fin) {
    sea xs = []
    sea i = 0
    mientras (i < 576) {
        xs.agregar(0)
        i = i + 1
    }
    // Límites de las regiones sumando anchos de banda.
    sea r1 = 0
    sea k = 0
    mientras (k <= g["region0"] y k < longitud(g["anchos"])) {
        r1 = r1 + g["anchos"][k]
        k = k + 1
    }
    sea r2 = 576
    si (g["region1"] != 255) {
        r2 = r1
        sea j = 0
        mientras (j <= g["region1"] y k < longitud(g["anchos"])) {
            r2 = r2 + g["anchos"][k]
            k = k + 1
            j = j + 1
        }
    }
    sea pos = 0
    sea grandes = minimo(g["grandes"] * 2, 576)
    mientras (pos < grandes) {
        sea tabla = g["tablas"][0]
        si (pos >= r1) { tabla = g["tablas"][1] }
        si (pos >= r2) { tabla = g["tablas"][2] }
        sea par = _m3_huff(r, h, tabla, fin)
        xs[pos] = par[0]
        xs[pos + 1] = par[1]
        pos = pos + 2
    }
    sea tq = 32 + g["count1"]
    mientras (pos + 4 <= 576 y r["p"] < fin) {
        sea q = _m3_huff(r, h, tq, fin)
        si (r["p"] > fin) { romper }
        xs[pos] = q[0]
        xs[pos + 1] = q[1]
        xs[pos + 2] = q[2]
        xs[pos + 3] = q[3]
        pos = pos + 4
    }
    r["p"] = fin
    retornar [xs, pos]
}

// ---------- recuantización ----------

funcion _m3_recuantizar(h, g, xs, scf) {
    sea out = []
    sea gain = g["ganancia"]
    sea forma = g["escala"] + 1
    // Exponente total por banda (en unidades de 2^(1/4)).
    sea iscf = []
    para v en scf["scf"] { iscf.agregar(v) }
    si (g["n_cortas"] > 0) {
        sea i = 0
        mientras (i < g["n_cortas"]) {
            sea w = 0
            mientras (w < 3) {
                iscf[g["n_largas"] + i + w] = iscf[g["n_largas"] + i + w] + g["subganancia"][w] * potencia(2, 3 - forma)
                w = w + 1
            }
            i = i + 3
        }
    } sino si (g["preflag"] == 1) {
        sea i = 0
        mientras (i < 10) {
            iscf[11 + i] = iscf[11 + i] + _M3_PRETAB[i]
            i = i + 1
        }
    }
    sea base = potencia(2, (gain - 210) / 4.0)
    sea pos = 0
    sea b = 0
    mientras (b < longitud(g["anchos"]) y pos < 576) {
        sea e = 0
        si (b < longitud(iscf)) { e = iscf[b] * potencia(2, forma) }
        sea f = base * potencia(2, 0 - e / 4.0)
        sea k = 0
        mientras (k < g["anchos"][b] y pos < 576) {
            sea v = xs[pos]
            si (v == 0) { out.agregar(0.0) }
            sino si (v > 0) { out.agregar(f * potencia(v, 4 / 3.0)) }
            sino { out.agregar(0 - f * potencia(0 - v, 4 / 3.0)) }
            pos = pos + 1
            k = k + 1
        }
        b = b + 1
    }
    mientras (pos < 576) {
        out.agregar(0.0)
        pos = pos + 1
    }
    retornar out
}

// Reordena los bloques cortos: de [ventana][línea] a [línea][ventana] por banda.
funcion _m3_reordenar(g, xr) {
    si (g["tipo"] != 2) { retornar xr }
    sea out = []
    para v en xr { out.agregar(v) }
    sea pos = 0
    sea b = 0
    mientras (b < g["n_largas"]) {
        pos = pos + g["anchos"][b]
        b = b + 1
    }
    mientras (b < longitud(g["anchos"]) y pos < 576) {
        sea w = g["anchos"][b]
        sea j = 0
        mientras (j < w) {
            sea v = 0
            mientras (v < 3) {
                si (pos + w * v + j < 576) { out[pos + 3 * j + v] = xr[pos + w * v + j] }
                v = v + 1
            }
            j = j + 1
        }
        pos = pos + 3 * w
        b = b + 3
    }
    retornar out
}

// ---------- estéreo ----------

funcion _m3_estereo(h, g0, g1, x0, x1, nz1, scf1) {
    sea ms = h["modo"] == 1 y bits_y(h["ext"], 2) != 0
    sea intensidad = h["modo"] == 1 y h["ext"] % 2 == 1
    sea r2 = 0.7071067811865476
    sea n = 576
    si (intensidad == falso) {
        si (ms) {
            sea i = 0
            mientras (i < n) {
                sea a = x0[i]
                sea b = x1[i]
                x0[i] = (a + b) * r2
                x1[i] = (a - b) * r2
                i = i + 1
            }
        }
        retornar nulo
    }
    // Intensidad: las bandas por encima de la última línea no nula del canal derecho.
    // Se marca para cada línea si va con intensidad y con qué posición.
    sea modo_is = []
    sea i = 0
    mientras (i < n) {
        modo_is.agregar(nulo)
        i = i + 1
    }
    sea pos = 0
    sea b = 0
    sea anchos = g1["anchos"]
    // Bandas (o por ventana en las cortas) con todo en cero en el canal derecho.
    sea ultimo_largo = -1
    si (g1["tipo"] != 2) {
        // Bandas largas: índice de la primera banda desde la que todo es cero.
        sea nz = 0
        sea q = 0
        mientras (q < n) {
            si (x1[q] != 0) { nz = q + 1 }
            q = q + 1
        }
        sea desde = 0
        sea p = 0
        sea k = 0
        mientras (k < longitud(anchos)) {
            si (p < nz) { desde = k + 1 }
            p = p + anchos[k]
            k = k + 1
        }
        p = 0
        k = 0
        mientras (k < longitud(anchos)) {
            si (k >= desde) {
                sea isp = 0
                si (k < longitud(scf1["is"]) y k < 21) { isp = scf1["is"][k] } sino si (longitud(scf1["is"]) > 20) { isp = scf1["is"][20] }
                sea j = 0
                mientras (j < anchos[k] y p + j < n) {
                    modo_is[p + j] = isp
                    j = j + 1
                }
            }
            p = p + anchos[k]
            k = k + 1
        }
    } sino {
        // Cortas: por ventana, la última banda con algo distinto de cero.
        sea p0 = 0
        sea k = 0
        mientras (k < g1["n_largas"]) {
            p0 = p0 + anchos[k]
            k = k + 1
        }
        sea ultima = [-1, -1, -1]
        sea p = p0
        sea kb = k
        mientras (kb < longitud(anchos)) {
            sea w = 0
            mientras (w < 3) {
                sea a = anchos[kb + w]
                sea j = 0
                mientras (j < a) {
                    sea idx = p + 3 * j + w
                    si (idx < n y x1[idx] != 0) { ultima[w] = kb }
                    j = j + 1
                }
                w = w + 1
            }
            p = p + 3 * anchos[kb]
            kb = kb + 3
        }
        p = p0
        kb = k
        mientras (kb < longitud(anchos)) {
            sea w = 0
            mientras (w < 3) {
                si (kb > ultima[w]) {
                    sea si_ = kb + w
                    sea isp = 0
                    si (si_ - g1["n_largas"] < longitud(scf1["is"]) - g1["n_largas"] - 3) { isp = scf1["is"][si_] } sino { isp = scf1["is"][maximo(0, si_ - 3)] }
                    sea a = anchos[kb + w]
                    sea j = 0
                    mientras (j < a) {
                        sea idx = p + 3 * j + w
                        si (idx < n) { modo_is[idx] = isp }
                        j = j + 1
                    }
                }
                w = w + 1
            }
            p = p + 3 * anchos[kb]
            kb = kb + 3
        }
    }
    sea io = 0.8408964152537145
    si (h["mpeg1"] == falso y g1["compresion"] % 2 == 1) { io = r2 }
    i = 0
    mientras (i < n) {
        sea isp = modo_is[i]
        sea valido = isp != nulo y isp >= 0
        si (valido y h["mpeg1"] y isp >= 7) { valido = falso }
        si (valido) {
            sea kl = 1.0
            sea kr = 0.0
            si (h["mpeg1"]) {
                si (isp == 6) {
                    kl = 1.0
                    kr = 0.0
                } sino {
                    sea t = tangente(isp * 3.141592653589793 / 12)
                    kl = t / (1 + t)
                    kr = 1 / (1 + t)
                }
            } sino {
                kl = 1.0
                kr = 1.0
                si (isp > 0) {
                    si (isp % 2 == 1) { kl = potencia(io, (isp + 1) / 2) } sino { kr = potencia(io, isp / 2) }
                }
            }
            sea v = x0[i]
            x0[i] = v * kl
            x1[i] = v * kr
        } sino si (ms) {
            sea a = x0[i]
            sea b2 = x1[i]
            x0[i] = (a + b2) * r2
            x1[i] = (a - b2) * r2
        }
        i = i + 1
    }
}

// ---------- antialias, IMDCT y síntesis ----------

funcion _m3_antialias(g, xr) {
    si (g["tipo"] == 2 y g["mixto"] == 0) { retornar nulo }
    sea lim = 32
    si (g["tipo"] == 2) { lim = 2 }
    sea sb = 1
    mientras (sb < lim) {
        sea i = 0
        mientras (i < 8) {
            sea li = 18 * sb - 1 - i
            sea ui = 18 * sb + i
            sea a = xr[li]
            sea b = xr[ui]
            xr[li] = a * _M3_CS[i] - b * _M3_CA[i]
            xr[ui] = b * _M3_CS[i] + a * _M3_CA[i]
            i = i + 1
        }
        sb = sb + 1
    }
}

funcion _m3_hibrida(t, g, xr, guardado) {
    sea c36 = t["cos36"]
    sea c12 = t["cos12"]
    sea ven = t["ventanas"]
    sea sb = 0
    mientras (sb < 32) {
        sea bt = g["tipo"]
        si (g["mixto"] == 1 y sb < 2) { bt = 0 }
        sea base = sb * 18
        sea sal = []
        sea p = 0
        mientras (p < 36) {
            sal.agregar(0.0)
            p = p + 1
        }
        si (bt == 2) {
            sea w = 0
            mientras (w < 3) {
                p = 0
                mientras (p < 12) {
                    sea s = 0.0
                    sea m = 0
                    mientras (m < 6) {
                        s = s + xr[base + w + 3 * m] * c12[m][p]
                        m = m + 1
                    }
                    sal[6 * w + p + 6] = sal[6 * w + p + 6] + s * ven[2][p]
                    p = p + 1
                }
                w = w + 1
            }
        } sino {
            // Si el bloque es todo cero, la salida es cero.
            sea vacio = verdadero
            sea m = 0
            mientras (m < 18 y vacio) {
                si (xr[base + m] != 0) { vacio = falso }
                m = m + 1
            }
            si (vacio == falso) {
                sea vb = ven[bt]
                p = 0
                mientras (p < 36) {
                    sea s = 0.0
                    m = 0
                    mientras (m < 18) {
                        s = s + xr[base + m] * c36[m][p]
                        m = m + 1
                    }
                    sal[p] = s * vb[p]
                    p = p + 1
                }
            }
        }
        sea i = 0
        mientras (i < 18) {
            xr[base + i] = sal[i] + guardado[base + i]
            guardado[base + i] = sal[i + 18]
            i = i + 1
        }
        // Inversión de frecuencia en las subbandas impares.
        si (sb % 2 == 1) {
            i = 1
            mientras (i < 18) {
                xr[base + i] = 0 - xr[base + i]
                i = i + 2
            }
        }
        sb = sb + 1
    }
}

funcion _m3_sintesis(t, xr, estado, salida, nmuestras) {
    sea nwin = t["sintesis"]
    sea d = t["ventana_d"]
    sea v = estado["v"]
    sea ss = 0
    mientras (ss < nmuestras) {
        // Desplaza V 64 lugares (anillo).
        estado["o"] = (estado["o"] + 1024 - 64) % 1024
        sea o = estado["o"]
        sea s = []
        sea i = 0
        mientras (i < 32) {
            s.agregar(xr[i * 18 + ss])
            i = i + 1
        }
        i = 0
        mientras (i < 64) {
            sea fila = nwin[i]
            sea suma = 0.0
            sea j = 0
            mientras (j < 32) {
                suma = suma + fila[j] * s[j]
                j = j + 1
            }
            v[(o + i) % 1024] = suma
            i = i + 1
        }
        i = 0
        mientras (i < 32) {
            sea suma = 0.0
            sea j = 0
            mientras (j < 8) {
                suma = suma + v[(o + j * 128 + i) % 1024] * d[j * 64 + i]
                suma = suma + v[(o + j * 128 + i + 96) % 1024] * d[j * 64 + i + 32]
                j = j + 1
            }
            si (suma > 1) { suma = 1.0 }
            si (suma < -1) { suma = -1.0 }
            salida.agregar(suma)
            i = i + 1
        }
        ss = ss + 1
    }
}

// ---------- decodificador ----------

// Etiqueta ID3v2 al principio: devuelve dónde empieza el audio.
funcion _m3_saltar_id3(d) {
    sea pos = 0
    mientras (pos + 10 <= longitud(d) y subtexto(d, pos, pos + 3) == "ID3") {
        sea tam = byte_en(d, pos + 6) * 2097152 + byte_en(d, pos + 7) * 16384 + byte_en(d, pos + 8) * 128 + byte_en(d, pos + 9)
        sea pie = 0
        si (bits_y(byte_en(d, pos + 5), 16) != 0) { pie = 10 }
        pos = pos + 10 + tam + pie
    }
    retornar pos
}

funcion _m3_buscar(d, pos) {
    sea p = pos
    mientras (p + 4 <= longitud(d)) {
        sea h = _m3_cabecera(d, p)
        si (h != nulo y h["capa"] == 3) {
            // Confirma con la trama siguiente (si hay).
            sea sig = p + h["largo"]
            si (sig + 4 > longitud(d)) { retornar p }
            sea h2 = _m3_cabecera(d, sig)
            si (h2 != nulo y h2["tasa"] == h["tasa"] y h2["capa"] == 3) { retornar p }
        }
        p = p + 1
    }
    retornar -1
}

// Lee la trama Xing/Info y la etiqueta LAME (retardo y relleno del codificador).
funcion _m3_xing(d, pos, h) {
    sea lat = 32
    si (h["mpeg1"] y h["canales"] == 1) { lat = 17 }
    si (h["mpeg1"] == falso y h["canales"] == 2) { lat = 17 }
    si (h["mpeg1"] == falso y h["canales"] == 1) { lat = 9 }
    sea p = pos + 4 + lat
    si (h["crc"]) { p = p + 2 }
    sea id = subtexto(d, p, p + 4)
    si (id != "Xing" y id != "Info") { retornar nulo }
    sea banderas = bytes_leer_entero(d, p + 4, 4, 0)
    sea r = {"tramas": nulo, "retardo": 0, "relleno": 0}
    sea q = p + 8
    si (banderas % 2 == 1) {
        r["tramas"] = bytes_leer_entero(d, q, 4, 0)
        q = q + 4
    }
    si (piso(banderas / 2) % 2 == 1) { q = q + 4 }
    si (piso(banderas / 4) % 2 == 1) { q = q + 100 }
    si (piso(banderas / 8) % 2 == 1) { q = q + 4 }
    si (q + 24 <= longitud(d) y (subtexto(d, q, q + 4) == "LAME" o subtexto(d, q, q + 4) == "Lavc" o subtexto(d, q, q + 4) == "Lavf")) {
        sea a = byte_en(d, q + 21)
        sea b = byte_en(d, q + 22)
        sea c = byte_en(d, q + 23)
        r["retardo"] = a * 16 + piso(b / 16)
        r["relleno"] = (b % 16) * 256 + c
        r["codificador"] = subtexto(d, q, q + 9)
    }
    retornar r
}

/// Información del MP3 sin decodificar: tasa, canales, kbps (de la primera
/// trama), versión, modo, tramas y duración estimada en ms.
funcion mp3_info(datos) {
    sea p = _m3_buscar(datos, _m3_saltar_id3(datos))
    si (p < 0) { lanzar "mp3: no se encontró ninguna trama" }
    sea h = _m3_cabecera(datos, p)
    sea x = _m3_xing(datos, p, h)
    si (x != nulo y p + h["largo"] + 4 <= longitud(datos)) {
        sea h2 = _m3_cabecera(datos, p + h["largo"])
        si (h2 != nulo) { h["modo"] = h2["modo"] }
    }
    sea tramas = 0
    sea q = p
    si (x != nulo) { q = p + h["largo"] }
    mientras (q >= 0 y q + 4 <= longitud(datos)) {
        sea hh = _m3_cabecera(datos, q)
        si (hh == nulo o hh["largo"] == 0) { q = _m3_buscar(datos, q + 1) } sino {
            tramas = tramas + 1
            q = q + hh["largo"]
        }
    }
    sea por_trama = 1152
    si (h["mpeg1"] == falso) { por_trama = 576 }
    sea version = "MPEG-1"
    si (h["ver"] == 2) { version = "MPEG-2" }
    si (h["ver"] == 0) { version = "MPEG-2.5" }
    sea modos = ["estereo", "estereo_conjunto", "doble_canal", "mono"]
    sea muestras = tramas * por_trama
    si (x != nulo y x["retardo"] + x["relleno"] > 0) { muestras = maximo(0, muestras - x["retardo"] - x["relleno"]) }
    retornar {"tasa": h["tasa"], "canales": h["canales"], "kbps": h["kbps"], "version": version, "modo": modos[h["modo"]], "tramas": tramas, "muestras": muestras, "duracion_ms": piso(muestras * 1000 / h["tasa"]), "gapless": x != nulo y x["retardo"] > 0}
}

/// Decodifica un MP3 (MPEG-1, 2 y 2.5, capa III, CBR y VBR, con ID3v2 y
/// Xing/LAME). Devuelve {"tasa", "canales", "c": [muestras de -1 a 1 por
/// canal]}. opciones: "sin_recorte" (no quita el retardo del codificador),
/// "max_ms" (decodifica solo el principio).
funcion mp3_decodificar(datos, opciones) {
    sea op = opciones ?? {}
    sea t = _m3_tablas()
    sea huff = t["huff"]
    sea p = _m3_buscar(datos, _m3_saltar_id3(datos))
    si (p < 0) { lanzar "mp3: no se encontró ninguna trama" }
    sea h0 = _m3_cabecera(datos, p)
    sea nc = h0["canales"]
    sea x = _m3_xing(datos, p, h0)
    si (x != nulo) { p = p + h0["largo"] }
    sea canales = []
    sea guardado = []
    sea sintesis = []
    sea previos = []
    sea k = 0
    mientras (k < nc) {
        canales.agregar([])
        sea g = []
        sea i = 0
        mientras (i < 576) {
            g.agregar(0.0)
            i = i + 1
        }
        guardado.agregar(g)
        sea v = []
        i = 0
        mientras (i < 1024) {
            v.agregar(0.0)
            i = i + 1
        }
        sintesis.agregar({"v": v, "o": 0})
        previos.agregar([])
        k = k + 1
    }
    sea reserva = ""
    sea limite = nulo
    si (tiene_clave(op, "max_ms")) { limite = piso(op["max_ms"] * h0["tasa"] / 1000) + 2000 }
    mientras (p >= 0 y p + 4 <= longitud(datos)) {
        sea h = _m3_cabecera(datos, p)
        si (h == nulo o h["capa"] != 3 o h["tasa"] != h0["tasa"]) {
            p = _m3_buscar(datos, p + 1)
        } sino {
            si (p + h["largo"] > longitud(datos)) { romper }
            sea q = p + 4
            si (h["crc"]) { q = q + 2 }
            sea lat_tam = 32
            si (h["mpeg1"] y nc == 1) { lat_tam = 17 }
            si (h["mpeg1"] == falso y nc == 2) { lat_tam = 17 }
            si (h["mpeg1"] == falso y nc == 1) { lat_tam = 9 }
            sea rl = _m3_lector(subtexto(datos, q, q + lat_tam))
            sea lat = _m3_lateral(h, rl)
            sea principal = subtexto(datos, q + lat_tam, p + h["largo"])
            sea decodificable = lat["inicio"] <= longitud(reserva)
            sea buf = subtexto(reserva, longitud(reserva) - lat["inicio"], longitud(reserva)) + principal
            reserva = reserva + principal
            si (longitud(reserva) > 4096) { reserva = subtexto(reserva, longitud(reserva) - 4096, longitud(reserva)) }
            sea r = _m3_lector(buf + char_de(0) + char_de(0) + char_de(0) + char_de(0))
            sea gr = 0
            mientras (gr < h["granulos"]) {
                sea xs = []
                sea nzs = []
                sea factores = []
                sea ch = 0
                mientras (ch < nc) {
                    sea g = lat["granulos"][gr][ch]
                    si (decodificable) {
                        sea inicio_bits = r["p"]
                        sea f = _m3_factores(h, g, r, ch, previos[ch], gr)
                        previos[ch] = f["scf"]
                        sea lin = _m3_lineas(r, g, huff, inicio_bits + g["largo23"])
                        nzs.agregar(lin[1])
                        factores.agregar(f)
                        xs.agregar(_m3_reordenar(g, _m3_recuantizar(h, g, lin[0], f)))
                    } sino {
                        sea z = []
                        sea i = 0
                        mientras (i < 576) {
                            z.agregar(0.0)
                            i = i + 1
                        }
                        xs.agregar(z)
                        nzs.agregar(0)
                        factores.agregar({"scf": [], "is": []})
                    }
                    ch = ch + 1
                }
                si (nc == 2 y h["modo"] == 1) { _m3_estereo(h, lat["granulos"][gr][0], lat["granulos"][gr][1], xs[0], xs[1], nzs[1], factores[1]) }
                ch = 0
                mientras (ch < nc) {
                    sea g = lat["granulos"][gr][ch]
                    _m3_antialias(g, xs[ch])
                    _m3_hibrida(t, g, xs[ch], guardado[ch])
                    _m3_sintesis(t, xs[ch], sintesis[ch], canales[ch], 18)
                    ch = ch + 1
                }
                gr = gr + 1
            }
            p = p + h["largo"]
            si (limite != nulo y longitud(canales[0]) >= limite) { romper }
        }
    }
    // Recorte sin huecos (LAME): retardo del codificador + 529 del decodificador.
    si (x != nulo y (op["sin_recorte"] ?? falso) == falso y x["retardo"] + x["relleno"] > 0) {
        sea ini = x["retardo"] + 529
        sea total = longitud(canales[0])
        sea fin = total
        si (x["tramas"] != nulo) {
            sea por_trama = 1152
            si (h0["mpeg1"] == falso) { por_trama = 576 }
            fin = minimo(total, x["tramas"] * por_trama - x["relleno"] + 529)
        }
        sea c2 = []
        para c en canales {
            sea n = []
            sea i = ini
            mientras (i < fin) {
                n.agregar(c[i])
                i = i + 1
            }
            c2.agregar(n)
        }
        canales = c2
    }
    si (tiene_clave(op, "max_ms")) {
        sea n = piso(op["max_ms"] * h0["tasa"] / 1000)
        sea c2 = []
        para c en canales {
            sea m = []
            sea i = 0
            mientras (i < minimo(n, longitud(c))) {
                m.agregar(c[i])
                i = i + 1
            }
            c2.agregar(m)
        }
        canales = c2
    }
    retornar {"tasa": h0["tasa"], "canales": nc, "c": canales}
}

/// ¿Parece un MP3 (ID3 o una trama válida al principio)?
funcion mp3_es(datos) {
    si (longitud(datos) >= 3 y subtexto(datos, 0, 3) == "ID3") { retornar verdadero }
    sea h = _m3_cabecera(datos, 0)
    retornar h != nulo y h["capa"] == 3
}
