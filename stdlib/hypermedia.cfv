// stdlib/hypermedia.cfv — interactividad por atributos HTML: nombres en inglés del módulo "atributo".
// English names for the "atributo" module; both can be used together.

importar "atributo"

funcion _hypermedia_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_hypermedia_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _hypermedia_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _HYPERMEDIA_RES = {"peticion": "request", "impulsado": "boosted", "objetivo": "target", "disparador": "trigger", "nombre_disparador": "trigger_name", "url_actual": "current_url", "respuesta_prompt": "prompt", "restaurar_historial": "history_restore"}

funcion hx_runtime_js() { retornar atributo_js() }
funcion hx_script_tag() { retornar atributo_script() }
funcion hx_is_request(sol) { retornar atributo_es_peticion(sol) }
funcion hx_request_info(sol) { retornar _hypermedia_tr(atributo_info(sol), _HYPERMEDIA_RES) }
funcion hx_escape(t) { retornar atributo_escapar(t) }
funcion hx_attrs(mapa) { retornar atributo_attrs(mapa) }
funcion hx_oob(id, html, modo, etiqueta) { retornar atributo_oob(id, html, modo, etiqueta) }
funcion hx_http(r) { retornar atributo_http(r) }
funcion hx_send(sol, r) { retornar atributo_enviar(sol, r) }

sea _HX_OPT = {"trigger": "disparar", "trigger_after_swap": "disparar_despues_intercambio", "trigger_after_settle": "disparar_despues_asentar",
    "redirect": "redirigir", "refresh": "refrescar", "retarget": "reobjetivo", "reswap": "reintercambio", "reselect": "reseleccionar",
    "push_url": "empujar_url", "replace_url": "reemplazar_url", "location": "ubicacion", "status": "estado"}
// Response for the runtime: {"status", "body", "headers"}. options: "trigger",
// "trigger_after_swap", "trigger_after_settle", "redirect", "refresh",
// "retarget", "reswap", "reselect", "push_url", "replace_url", "location", "status".
funcion hx_response(body, options) {
    sea op = {}
    para k en claves(options ?? {}) { op[_HX_OPT[k] ?? k] = options[k] }
    sea r = atributo_respuesta(body, op)
    retornar {"status": r["estado"], "body": r["cuerpo"], "headers": r["cabeceras"], "estado": r["estado"], "cuerpo": r["cuerpo"], "cabeceras": r["cabeceras"]}
}
// Element with hx-* attributes (htmx names) and plain HTML attributes.
funcion hx_element(tag, attrs, content, html_attrs) { retornar atributo_elemento(tag, attrs, content, html_attrs) }
