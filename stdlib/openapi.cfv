// stdlib/openapi.cfv — documentación OpenAPI: nombres en inglés del módulo "contrato".
// English names for the "contrato" module; both can be used together.

importar "contrato"

funcion openapi_new(titulo, version, descripcion) {
    sea c = contrato_nuevo(titulo, version, descripcion)
    c["idioma"] = "en"
    retornar c
}
funcion openapi_server(c, url, descripcion) { retornar contrato_servidor(c, url, descripcion) }
funcion openapi_component(c, nombre, e) { retornar contrato_componente(c, nombre, e) }
funcion openapi_json_schema(e) { retornar contrato_json_schema(e) }
funcion openapi_route(c, metodo, ruta, opciones) { retornar contrato_ruta(c, metodo, ruta, opciones) }
funcion openapi_security(c, nombre, tipo_s) { retornar contrato_seguridad(c, nombre, tipo_s) }
funcion openapi_document(c) { retornar contrato_documento(c) }
funcion openapi_json(c) { retornar contrato_json(c) }
