// stdlib/search.cfv — búsqueda de texto completo: nombres en inglés del módulo "indice".
// English names for the "indice" module; both can be used together.

importar "indice"

funcion search_terms(texto, conservar_vacias) { retornar indice_terminos(texto, conservar_vacias) }
funcion search_new(opciones) { retornar indice_nuevo(opciones) }
funcion search_add(i, id, doc) { retornar indice_agregar(i, id, doc) }
funcion search_remove(i, id) { retornar indice_quitar(i, id) }
funcion search_document(i, id) { retornar indice_documento(i, id) }
funcion search_size(i) { retornar indice_tamano(i) }
funcion search_query(i, consulta, opciones) { retornar indice_buscar(i, consulta, opciones) }
funcion search_highlight(i, id, campo, consulta, antes, despues) { retornar indice_resaltar(i, id, campo, consulta, antes, despues) }
funcion search_save(i, ruta) { retornar indice_guardar(i, ruta) }
funcion search_load(ruta) { retornar indice_cargar(ruta) }
