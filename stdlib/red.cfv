// stdlib/red.cfv — Cliente HTTP/HTTPS + UDP para C-Forge v3.7.0
// Usa los builtins nativos: http_get, http_post, http_put, http_delete, http_solicitud
// y los nuevos builtins UDP: udp_crear, udp_enviar, udp_recibir, udp_cerrar
//
// Ejemplo GET:
//   importar "stdlib/red.cfv"
//   sea resp = get("https://api.example.com/datos")
//   mostrar(resp["cuerpo"])
//
// Ejemplo POST JSON:
//   sea resp = post_json("https://api.example.com/crear", {"nombre": "Juan"})
//   mostrar(resp["estado"])
//
// Ejemplo UDP:
//   sea sock = udp_abrir(8080)
//   udp_mandar(sock, "127.0.0.1", 9090, "hola")
//   sea msg = udp_leer(sock)
//   mostrar(msg["datos"])

importar "json"
importar "tls"

importar "stdlib/json.cfv"

// ── Cliente HTTP ───────────────────────────────────────────────────────────

// GET simple — retorna el cuerpo como texto
funcion get(url: texto): mapa {
    sea resp = http_solicitud("GET", url, {})
    retornar resp
}

// GET que parsea JSON automáticamente
funcion get_json(url: texto): cualquiera {
    sea resp = http_solicitud("GET", url, {})
    retornar json_parsear(resp["cuerpo"])
}

// POST con cuerpo de texto
funcion post(url: texto, cuerpo: texto, tipo_contenido: texto): mapa {
    sea resp = http_solicitud("POST", url, {
        "cuerpo": cuerpo,
        "tipo": tipo_contenido
    })
    retornar resp
}

// POST con JSON (serializa automáticamente)
funcion post_json(url: texto, datos: cualquiera): mapa {
    sea cuerpo = json_serializar(datos)
    sea resp = http_solicitud("POST", url, {
        "cuerpo": cuerpo,
        "tipo": "application/json"
    })
    retornar resp
}

// PUT con JSON
funcion put_json(url: texto, datos: cualquiera): mapa {
    sea cuerpo = json_serializar(datos)
    sea resp = http_solicitud("PUT", url, {
        "cuerpo": cuerpo,
        "tipo": "application/json"
    })
    retornar resp
}

// DELETE
funcion delete(url: texto): mapa {
    sea resp = http_solicitud("DELETE", url, {})
    retornar resp
}

// Petición completa con cabeceras personalizadas
funcion peticion(metodo: texto, url: texto, cuerpo: texto, cabeceras: mapa): mapa {
    sea opts = {
        "cuerpo": cuerpo,
        "cabeceras": cabeceras
    }
    retornar http_solicitud(metodo, url, opts)
}

// Petición con autenticación Bearer token
funcion peticion_auth(metodo: texto, url: texto, token: texto): mapa {
    sea opts = {
        "cabeceras": {
            "Authorization": "Bearer " + token
        }
    }
    retornar http_solicitud(metodo, url, opts)
}

// Verificar si la respuesta fue exitosa (2xx)
funcion respuesta_ok(resp: mapa): booleano {
    sea estado = resp["estado"]
    retornar estado >= 200 y estado < 300
}

// Parsear JSON de la respuesta
funcion respuesta_json(resp: mapa): cualquiera {
    retornar json_parsear(resp["cuerpo"])
}

// ── Utilidades de URL ──────────────────────────────────────────────────────

funcion url_codificar_params(params: mapa): texto {
    sea resultado = ""
    sea primero = verdadero
    para clave en claves(params) {
        si (no primero) { resultado = resultado + "&" }
        resultado = resultado + clave + "=" + a_texto(params[clave])
        primero = falso
    }
    retornar resultado
}

funcion url_con_params(base: texto, params: mapa): texto {
    sea qs = url_codificar_params(params)
    si (longitud(qs) == 0) { retornar base }
    retornar base + "?" + qs
}

// ── Cliente UDP ────────────────────────────────────────────────────────────

// Crear socket UDP (opcionalmente enlazar a un puerto para recibir)
funcion udp_abrir(puerto: numero): numero {
    retornar udp_crear(puerto)
}

// Crear socket UDP sin puerto (solo para enviar)
funcion udp_abrir_emisor(): numero {
    retornar udp_crear(0)
}

// Enviar datos a host:puerto
funcion udp_mandar(sock: numero, host: texto, puerto: numero, datos: texto): nulo {
    udp_enviar(sock, host, puerto, datos)
}

// Enviar datos JSON
funcion udp_mandar_json(sock: numero, host: texto, puerto: numero, datos: cualquiera): nulo {
    udp_enviar(sock, host, puerto, json_serializar(datos))
}

// Recibir datos (no bloqueante — retorna nulo si no hay nada)
funcion udp_leer(sock: numero): mapa {
    retornar udp_recibir(sock)
}

// Cerrar socket UDP
funcion udp_terminar(sock: numero): nulo {
    udp_cerrar(sock)
}

// ── WebSocket (RFC 6455) ──────────────────────────────────────────────────
// Cliente:   sea ws = ws_conectar_url("ws://127.0.0.1:8080/chat")
//            ws_enviar(ws, "hola")  ·  sea m = ws_recibir(ws)  ·  ws_cerrar(ws)
// Servidor:  sea srv = servidor_http_escuchar(8080)
//            sea req = servidor_http_solicitud(srv)
//            si (ws_es_solicitud(req)) { sea c = ws_aceptar(srv, req) … }
// Tramas de texto (1), binarias (2), cierre (8), ping (9) y pong (10), con
// fragmentación y máscara obligatoria del cliente. ws_recibir responde solo
// a ping y cierre; devuelve nulo cuando la conexión termina.

funcion ws_guid(): texto { retornar "258EAFA5-E914-47DA-95CA-C5AB0DC85B11" }

funcion ws_aceptacion(clave: texto): texto {
    retornar cfv_base64_codificar(sha1_bytes(clave + ws_guid()))
}

// "ws://host:puerto/ruta" (puerto 80 por defecto).
funcion ws_conectar_url(url: texto): mapa {
    sea resto = url
    si (texto_empieza_con(resto, "ws://")) { resto = subtexto(resto, 5, longitud(resto)) }
    sea ruta = "/"
    sea barra = texto_indice(resto, "/")
    si (barra >= 0) {
        ruta = subtexto(resto, barra, longitud(resto))
        resto = subtexto(resto, 0, barra)
    }
    sea puerto = 80
    sea dos = texto_indice(resto, ":")
    si (dos >= 0) {
        puerto = a_numero(subtexto(resto, dos + 1, longitud(resto)))
        resto = subtexto(resto, 0, dos)
    }
    retornar ws_conectar(resto, puerto, ruta)
}

funcion ws_conectar(host: texto, puerto: numero, ruta = "/"): mapa {
    sea sock = net_conectar(host, puerto)
    sea clave = cfv_base64_codificar(bytes_de_hex(crypto_rand_bytes(16)))
    sea pedido = "GET " + ruta + " HTTP/1.1\r\nHost: " + host + ":" + puerto + "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + clave + "\r\nSec-WebSocket-Version: 13\r\n\r\n"
    net_enviar(sock, pedido)
    // Cabeceras de la respuesta, byte a byte hasta la línea vacía.
    sea partes = []
    sea fin = ""
    mientras (fin != "\r\n\r\n") {
        sea b = net_recibir_exacto(sock, 1)
        si (longitud(b) == 0) {
            net_cerrar(sock)
            lanzar "ws_conectar: el servidor cerró la conexión durante el saludo"
        }
        partes.agregar(b)
        fin = fin + b
        si (longitud(fin) > 4) { fin = subtexto(fin, 1, 5) }
    }
    sea cabeceras = unir(partes, "")
    sea primera = subtexto(cabeceras, 0, texto_indice(cabeceras, "\r\n"))
    si (texto_indice(primera, " 101") < 0) {
        net_cerrar(sock)
        lanzar "ws_conectar: el servidor no aceptó WebSocket (" + primera + ")"
    }
    si (texto_indice(cabeceras, ws_aceptacion(clave)) < 0) {
        net_cerrar(sock)
        lanzar "ws_conectar: Sec-WebSocket-Accept no coincide"
    }
    retornar {"sock": sock, "cliente": verdadero, "abierto": verdadero}
}

// ¿La petición del servidor HTTP pide pasar a WebSocket?
funcion ws_es_solicitud(req: mapa): booleano {
    sea c = req["cabeceras"]
    si (tiene_clave(c, "upgrade") == falso o tiene_clave(c, "sec-websocket-key") == falso) { retornar falso }
    retornar texto_minusculas(c["upgrade"]) == "websocket"
}

// Completa el saludo y devuelve la conexión (el servidor sigue aceptando).
funcion ws_aceptar(srv: numero, req: mapa): mapa {
    si (ws_es_solicitud(req) == falso) { lanzar "ws_aceptar: la petición no es un saludo WebSocket" }
    sea sock = servidor_http_tomar_conexion(srv)
    net_enviar(sock, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + ws_aceptacion(req["cabeceras"]["sec-websocket-key"]) + "\r\n\r\n")
    retornar {"sock": sock, "cliente": falso, "abierto": verdadero}
}

// Trama completa (FIN) con el código de operación dado.
funcion ws_trama(conn: mapa, opcode: numero, datos: texto): texto {
    sea n = longitud(datos)
    sea mascara = 0
    si (conn["cliente"]) { mascara = 128 }
    sea cabecera = char_de(128 + opcode)
    si (n < 126) {
        cabecera = cabecera + char_de(mascara + n)
    } sino {
        si (n < 65536) {
            cabecera = cabecera + char_de(mascara + 126) + bytes_entero(n, 2, 0)
        } sino {
            cabecera = cabecera + char_de(mascara + 127) + bytes_entero(n, 8, 0)
        }
    }
    si (conn["cliente"]) {
        sea clave = bytes_de_hex(crypto_rand_bytes(4))
        si (n == 0) { retornar cabecera + clave }
        retornar cabecera + clave + bytes_xor(datos, clave)
    }
    retornar cabecera + datos
}

funcion ws_enviar_trama(conn: mapa, opcode: numero, datos: texto) {
    si (conn["abierto"] == falso) { lanzar "ws: la conexión está cerrada" }
    net_enviar(conn["sock"], ws_trama(conn, opcode, datos))
}

funcion ws_enviar(conn: mapa, mensaje: texto) { ws_enviar_trama(conn, 1, mensaje) }
funcion ws_enviar_binario(conn: mapa, datos: texto) { ws_enviar_trama(conn, 2, datos) }
funcion ws_ping(conn: mapa, datos = "") { ws_enviar_trama(conn, 9, datos) }

// Límites por conexión (bytes): una trama y un mensaje completo (suma de
// fragmentos). Se cambian con ws_limites.
funcion ws_limites(conn: mapa, max_trama = 1048576, max_mensaje = 16777216) {
    conn["max_trama"] = max_trama
    conn["max_mensaje"] = max_mensaje
    retornar conn
}

funcion _ws_error(conn: mapa, codigo, mensaje) {
    conn["codigo_cierre"] = codigo
    ws_cerrar(conn, codigo)
    lanzar "ws: " + mensaje
}

// Siguiente mensaje (texto o binario) o nulo si la conexión terminó.
// Cierra con 1009 si una trama o un mensaje pasan los límites (1 MiB y
// 16 MiB por defecto) y con 1002 ante tramas que violan RFC 6455.
funcion ws_recibir(conn: mapa) {
    sea max_trama = conn["max_trama"] ?? 1048576
    sea max_mensaje = conn["max_mensaje"] ?? 16777216
    // Un búfer por conexión para cabecera, largo extendido y máscara: no se
    // reserva un texto nuevo por cada trama.
    sea h = conn["_bufer"] ?? nulo
    si (h == nulo) {
        h = bytes_bufer(16)
        conn["_bufer"] = h
    }
    sea sock = conn["sock"]
    sea partes = []
    sea total = 0
    sea fragmentando = falso
    mientras (conn["abierto"]) {
        si (net_recibir_en(sock, h, 2) < 2) {
            conn["abierto"] = falso
            retornar nulo
        }
        sea b0 = byte_en(h, 0)
        sea b1 = byte_en(h, 1)
        sea fin = b0 >= 128
        sea rsv = piso(b0 / 16) % 8
        sea opcode = b0 % 16
        sea enmascarada = b1 >= 128
        sea n = b1 % 128
        si (rsv != 0) { _ws_error(conn, 1002, "bits RSV sin extensión negociada") }
        si ((opcode > 2 y opcode < 8) o opcode > 10) { _ws_error(conn, 1002, "opcode desconocido " + opcode) }
        si (opcode >= 8 y (fin == falso o n > 125)) { _ws_error(conn, 1002, "trama de control fragmentada o de más de 125 bytes") }
        si (n == 126) {
            si (net_recibir_en(sock, h, 2) < 2) { _ws_error(conn, 1002, "largo de trama inválido") }
            n = bytes_leer_entero(h, 0, 2, 0)
        }
        si (n == 127) {
            si (net_recibir_en(sock, h, 8) < 8 o byte_en(h, 0) >= 128) { _ws_error(conn, 1002, "largo de trama inválido") }
            // 2^56 o más no entra en ningún límite (ni en un entero etiquetado).
            si (byte_en(h, 0) != 0) { _ws_error(conn, 1009, "mensaje demasiado grande") }
            n = bytes_leer_entero(h, 0, 8, 0)
        }
        // Antes de reservar nada: tamaño de la trama y del mensaje.
        si (n > max_trama o (opcode < 8 y total + n > max_mensaje)) { _ws_error(conn, 1009, "mensaje demasiado grande") }
        si (conn["cliente"] == falso y enmascarada == falso) { _ws_error(conn, 1002, "el cliente envió una trama sin máscara") }
        si (opcode == 0 y fragmentando == falso) { _ws_error(conn, 1002, "continuación sin mensaje iniciado") }
        si ((opcode == 1 o opcode == 2) y fragmentando) { _ws_error(conn, 1002, "mensaje nuevo dentro de uno fragmentado") }
        si (enmascarada) {
            si (net_recibir_en(sock, h, 4) < 4) {
                conn["abierto"] = falso
                retornar nulo
            }
        }
        sea datos = ""
        si (n > 0) { datos = net_recibir_exacto(sock, n) }
        si (longitud(datos) < n) {
            conn["abierto"] = falso
            retornar nulo
        }
        // Desenmascarado en el sitio sobre el texto recién recibido.
        si (enmascarada y n > 0) { datos = bytes_desenmascarar(datos, h) }
        si (opcode == 8) {
            // Cierre: se responde con el mismo código y se termina.
            sea codigo = 1000
            si (n >= 2) { codigo = bytes_leer_entero(datos, 0, 2, 0) }
            conn["codigo_cierre"] = codigo
            ws_cerrar(conn, codigo)
            retornar nulo
        }
        si (opcode == 9) {
            net_enviar(sock, ws_trama(conn, 10, datos))
        } sino {
            si (opcode != 10) {
                // Mensaje en una sola trama: sin lista ni copia al unir.
                si (fin y fragmentando == falso) { retornar datos }
                partes.agregar(datos)
                total = total + n
                fragmentando = no fin
                si (fin) { retornar unir(partes, "") }
            }
        }
    }
    retornar nulo
}

funcion ws_cerrar(conn: mapa, codigo = 1000) {
    si (conn["abierto"]) {
        conn["abierto"] = falso
        intentar {
            net_enviar(conn["sock"], ws_trama(conn, 8, bytes_entero(codigo, 2, 0)))
        } capturar (e) { }
        net_cerrar(conn["sock"])
    }
}

// ── Servidor web rápido ────────────────────────────────────────────────────
// Re-exporta la API de stdlib/web.cfv para conveniencia

funcion servidor_crear(puerto: numero): numero {
    retornar servidor_http_escuchar(puerto)
}

funcion servidor_solicitud(srv: numero): mapa {
    retornar servidor_http_solicitud(srv)
}

funcion servidor_responder(req: mapa, estado: numero, cuerpo: texto): nulo {
    servidor_http_responder(req["_srv_id"], estado, cuerpo, "application/json")
}

funcion servidor_responder_json(req: mapa, estado: numero, datos: cualquiera): nulo {
    servidor_http_responder(req["_srv_id"], estado, json_serializar(datos), "application/json")
}
