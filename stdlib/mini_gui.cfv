// stdlib/mini_gui.cfv — GUI embebible mínima al estilo de Nuklear: modo
// inmediato con distribución por filas (dinámicas, estáticas o con
// proporciones), ventanas con banderas (movible, escalable, minimizable,
// título, borde) y los elementos clásicos: etiqueta alineada, botón,
// casilla, opción, deslizador con paso, propiedad (flechas y arrastre),
// barra de progreso modificable, edición de texto y combo. Usa el núcleo
// de "panel" (entrada por cuadro y lista de comandos de dibujo), así que se
// pinta en un lienzo o en cualquier motor.
// Idea de Nuklear (dominio público / MIT), escrito desde cero.
// En inglés: importar "nuklear".
//
//   importar "mini_gui"
//   sea ctx = mini_contexto(nulo)
//   mini_entrada(ctx, {"raton": [0, 0]})
//   si (mini_comenzar(ctx, "Demo", [50, 50, 220, 220], ["borde", "movible", "titulo"])) {
//       mini_fila_estatica(ctx, 30, 80, 1)
//       si (mini_boton(ctx, "botón")) { mostrar("clic") }
//   }
//   mini_terminar(ctx)
//   sea l = mini_imagen(ctx, 320, 320)

importar "panel"

/// Contexto (mismas opciones que panel_contexto).
funcion mini_contexto(opciones) {
    sea op = opciones ?? {}
    sea ctx = panel_contexto(op)
    // Estilo más compacto, como Nuklear.
    ctx["estilo"]["relleno"] = 4
    ctx["estilo"]["relleno_marco"] = 3
    ctx["estilo"]["redondeo"] = op["redondeo"] ?? 4
    retornar ctx
}

/// Entrada del cuadro (como panel_cuadro).
funcion mini_entrada(ctx, entrada) { panel_cuadro(ctx, entrada) }

/// Empieza una ventana en rect [x, y, ancho, alto] con banderas: "movible",
/// "escalable", "minimizable", "titulo", "borde", "minimizada".
funcion mini_comenzar(ctx, titulo, rect, banderas) {
    sea b = banderas ?? []
    sea op = {"x": rect[0], "y": rect[1], "ancho": rect[2], "alto": rect[3],
        "fija": contiene(b, "movible") == falso, "sin_redimensionar": contiene(b, "escalable") == falso,
        "sin_titulo": contiene(b, "titulo") == falso y contiene(b, "minimizable") == falso, "plegada": contiene(b, "minimizada")}
    sea r = panel_ventana(ctx, titulo, op)
    ctx["actual"]["fila"] = nulo
    retornar r
}

/// Cierra la ventana.
funcion mini_terminar(ctx) { panel_fin_ventana(ctx) }

/// Fila con columnas del mismo ancho que llenan el espacio.
funcion mini_fila_dinamica(ctx, alto, columnas) {
    sea a = []
    sea i = 0
    mientras (i < columnas) {
        a.agregar(1 / columnas)
        i = i + 1
    }
    panel_fila(ctx, alto, a)
}

/// Fila con columnas de ancho fijo en píxeles.
funcion mini_fila_estatica(ctx, alto, ancho, columnas) {
    sea a = []
    sea i = 0
    mientras (i < columnas) {
        a.agregar(maximo(2, ancho))
        i = i + 1
    }
    panel_fila(ctx, alto, a)
}

/// Fila con proporciones (fracciones de 0 a 1) o anchos en píxeles (> 1).
funcion mini_fila(ctx, alto, proporciones) { panel_fila(ctx, alto, proporciones) }

funcion _mg_fila(ctx) {
    si (ctx["actual"]["fila"] == nulo) { mini_fila_dinamica(ctx, _pl_alto_marco(ctx), 1) }
}

/// Etiqueta: alineacion "izquierda", "centro" o "derecha".
funcion mini_etiqueta(ctx, texto, alineacion) {
    _mg_fila(ctx)
    sea r = _pl_item(ctx, nulo, ctx["tam"])
    sea w = _pl_ancho(ctx, texto)
    sea x = r[0]
    sea al = alineacion ?? "izquierda"
    si (al == "centro") { x = r[0] + piso((r[2] - w) / 2) } sino si (al == "derecha") { x = r[0] + r[2] - w }
    sea m = ctx["actual"]
    sea guardado = m["recorte"]
    m["recorte"] = _pl_interseccion(guardado, r)
    _pl_texto_en(ctx, x, r[1] + piso((r[3] - ctx["tam"]) / 2), texto, ctx["estilo"]["texto"])
    m["recorte"] = guardado
}

/// Botón con texto.
funcion mini_boton(ctx, etiqueta) {
    _mg_fila(ctx)
    retornar panel_boton(ctx, etiqueta, nulo)
}

/// Casilla.
funcion mini_casilla(ctx, etiqueta, valor) {
    _mg_fila(ctx)
    retornar panel_casilla(ctx, etiqueta, valor)
}

/// Opción (radio): devuelve si quedó activa.
funcion mini_opcion(ctx, etiqueta, activo) {
    _mg_fila(ctx)
    retornar panel_radio(ctx, etiqueta, activo) o activo
}

/// Deslizador con paso (orden de Nuklear: mínimo, valor, máximo, paso).
funcion mini_deslizador(ctx, minimo_, valor, maximo_, paso) {
    _mg_fila(ctx)
    sea dec = 2
    si (piso(paso) == paso y piso(minimo_) == minimo_) { dec = 0 }
    sea v = panel_deslizador(ctx, "##desl" + ctx["actual"]["fila"]["y"] + "_" + ctx["actual"]["fila"]["i"], valor, minimo_, maximo_, {"decimales": dec})
    si (paso > 0) { v = minimo_ + redondear((v - minimo_) / paso) * paso }
    si (dec > 0) { v = redondear(v * 100) / 100 }
    retornar v
}

/// Propiedad: "< nombre: valor >"; las flechas suman o restan el paso y
/// arrastrar el centro cambia por inc_por_pixel.
funcion mini_propiedad(ctx, nombre, minimo_, valor, maximo_, paso, inc_por_pixel) {
    _mg_fila(ctx)
    sea es = ctx["estilo"]
    sea r = _pl_item(ctx, nulo, _pl_alto_marco(ctx))
    sea id = _pl_id(ctx, "#prop" + nombre)
    sea lado = r[3]
    sea v = valor
    sea izq = _pl_boton_logica(ctx, id + "<", [r[0], r[1], lado, lado])
    si (izq["clic"]) { v = v - paso }
    sea der = _pl_boton_logica(ctx, id + ">", [r[0] + r[2] - lado, r[1], lado, lado])
    si (der["clic"]) { v = v + paso }
    sea antes = ctx["activo"] == id
    sea medio = _pl_boton_logica(ctx, id, [r[0] + lado, r[1], r[2] - lado * 2, lado])
    sea x = ctx["entrada"]["raton"][0]
    si (medio["sostenido"]) {
        si (antes == falso) { ctx["estado"][id] = [x, valor] }
        sea e = ctx["estado"][id] ?? [x, valor]
        v = e[1] + (x - e[0]) * (inc_por_pixel ?? paso)
    }
    v = _pl_limitar(v, minimo_, maximo_)
    si (piso(paso) == paso y piso(minimo_) == minimo_) { v = redondear(v) }
    sea c = es["marco"]
    si (medio["sostenido"]) { c = es["marco_activo"] } sino si (medio["caliente"] o izq["caliente"] o der["caliente"]) { c = es["marco_caliente"] }
    _pl_rect(ctx, r, c, es["redondeo"])
    sea mt = piso(lado / 2)
    _pl_tri(ctx, [r[0] + 4 + mt * 0.6, r[1] + piso(lado / 4), r[0] + 4 + mt * 0.6, r[1] + piso(lado / 4) + mt, r[0] + 4, r[1] + piso(lado / 2)], es["texto_apagado"])
    _pl_flecha(ctx, r[0] + r[2] - 4 - mt, r[1] + piso(lado / 4), mt, falso, es["texto_apagado"])
    sea txt = ""
    si (piso(v) == v) { txt = "" + v } sino { txt = _pl_fmt(v, 2) }
    sea t = nombre + ": " + txt
    _pl_texto_en(ctx, r[0] + piso((r[2] - _pl_ancho(ctx, t)) / 2), r[1] + piso((r[3] - ctx["tam"]) / 2), t, es["texto"])
    ctx["ultimo"] = {"id": id, "rect": r, "caliente": medio["caliente"], "cambio": v != valor}
    retornar v
}

/// Barra de progreso; si es modificable, se arrastra. Devuelve el valor.
funcion mini_progreso(ctx, actual, maximo_, modificable) {
    _mg_fila(ctx)
    sea es = ctx["estilo"]
    sea r = _pl_item(ctx, nulo, _pl_alto_marco(ctx))
    sea v = actual
    si (modificable) {
        sea b = _pl_boton_logica(ctx, _pl_id(ctx, "#prog" + r[1] + "_" + r[0]), r)
        si (b["sostenido"]) { v = redondear(_pl_limitar((ctx["entrada"]["raton"][0] - r[0]) / maximo(1, r[2]), 0, 1) * maximo_) }
    }
    _pl_rect(ctx, r, es["marco"], es["redondeo"])
    si (maximo_ > 0 y v > 0) { _pl_rect(ctx, [r[0] + 2, r[1] + 2, (r[2] - 4) * minimo(1, v / maximo_), r[3] - 4], es["agarre"], es["redondeo"]) }
    retornar v
}

/// Edición de texto de una línea (maximo: caracteres).
funcion mini_editar(ctx, texto, maximo_) {
    _mg_fila(ctx)
    retornar panel_entrada_texto(ctx, "##edit" + ctx["actual"]["fila"]["y"] + "_" + ctx["actual"]["fila"]["i"], texto, {"maximo": maximo_ ?? 256})
}

/// Combo: devuelve el índice elegido.
funcion mini_combo(ctx, items, seleccionado) {
    _mg_fila(ctx)
    retornar panel_combo(ctx, "##combo" + ctx["actual"]["fila"]["y"] + "_" + ctx["actual"]["fila"]["i"], seleccionado, items)
}

/// Termina el cuadro y lo pinta en un lienzo nuevo.
funcion mini_imagen(ctx, ancho, alto) { retornar panel_imagen(ctx, ancho, alto, [48, 48, 48, 255]) }

/// Termina el cuadro y devuelve los comandos de dibujo.
funcion mini_comandos(ctx) { retornar panel_terminar(ctx) }
