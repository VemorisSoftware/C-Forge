// stdlib/hybrid.cfv — búsqueda híbrida texto + vectores: nombres en inglés del módulo "hibrida".
// English names for the "hibrida" module; both can be used together.


importar "hibrida"

funcion _hybrid_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_hybrid_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _hybrid_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _HYBRID_OPT = {"fields": "campos"}

funcion hybrid_new(dimension, opciones) { retornar hibrida_nueva(dimension, _hybrid_opt(opciones)) }
funcion hybrid_add(h, id, doc, vector, meta) { retornar hibrida_agregar(h, id, doc, vector, meta) }
funcion hybrid_remove(h, id) { retornar hibrida_quitar(h, id) }
funcion hybrid_chunks(texto, tamano, solape) { retornar hibrida_trozos(texto, tamano, solape) }

funcion _hybrid_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_HYBRID_OPT[k] ?? k] = o[k] }
    retornar r
}

/// Search. options: k, alpha, mode ("rrf" | "weighted"), filter, rrf_k.
/// Results: {"id", "score", "source": "text"|"vector"|"both", "meta", "doc"}.
funcion hybrid_search(h, query, vector, options) {
    sea o = _hybrid_opt(options)
    si (o != nulo) { si ((o["mode"] ?? "") == "weighted") { o["modo"] = "ponderado" } }
    sea fuentes = {"texto": "text", "vector": "vector", "ambos": "both"}
    sea r = []
    para x en hibrida_buscar(h, query, vector, o) { r.agregar({"id": x["id"], "score": x["puntaje"], "source": fuentes[x["fuente"]], "meta": x["meta"], "doc": x["doc"]}) }
    retornar r
}
