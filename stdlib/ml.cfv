// stdlib/ml.cfv — aprendizaje automático clásico: nombres en inglés del módulo "aprende".
// English names for the "aprende" module; both can be used together.

importar "aprende"

/// {"X_train", "y_train", "X_test", "y_test"}
funcion ml_split(X, y, proporcion_prueba, semilla) {
    sea r = aprende_dividir(X, y, proporcion_prueba, semilla)
    retornar {"X_train": r["X_entrenamiento"], "y_train": r["y_entrenamiento"], "X_test": r["X_prueba"], "y_test": r["y_prueba"]}
}
funcion ml_scaler(X) { retornar aprende_escalador(X) }
funcion ml_scale(escalador, X) { retornar aprende_escalar(escalador, X) }
/// Model with "centers", "labels", "inertia", "iterations" (usable with ml_predict).
funcion ml_kmeans(X, k, opciones) {
    sea r = aprende_kmedias(X, k, opciones)
    r["centers"] = r["centros"]
    r["labels"] = r["etiquetas"]
    r["inertia"] = r["inercia"]
    r["iterations"] = r["iteraciones"]
    retornar r
}
funcion ml_knn(X, y, k) { retornar aprende_knn(X, y, k) }
funcion ml_linear(X, y, ridge) { retornar aprende_lineal(X, y, ridge) }
funcion ml_logistic(X, y, opciones) { retornar aprende_logistica(X, y, opciones) }
funcion ml_probability(m, X) { retornar aprende_probabilidad(m, X) }
funcion ml_predict(m, X) { retornar aprende_predecir(m, X) }
funcion ml_accuracy(real, pred) { retornar aprende_exactitud(real, pred) }
/// {"mse", "r2"}
funcion ml_error(real, pred) {
    sea r = aprende_error(real, pred)
    retornar {"mse": r["ecm"], "r2": r["r2"]}
}
/// {"labels", "matrix"}
funcion ml_confusion(real, pred) {
    sea r = aprende_confusion(real, pred)
    retornar {"labels": r["etiquetas"], "matrix": r["matriz"]}
}
