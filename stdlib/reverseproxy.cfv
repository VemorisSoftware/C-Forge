// stdlib/reverseproxy.cfv — proxy inverso y balanceo de carga: nombres en inglés del módulo "proxy".
// English names for the "proxy" module; both can be used together.

importar "proxy"

funcion _reverseproxy_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_reverseproxy_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _reverseproxy_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _REVERSEPROXY_RES = {"metricas": "metrics", "peticiones": "requests", "errores": "errors", "limitadas": "limited", "cache_aciertos": "cache_hits", "atendidas": "served", "activas": "active", "sano": "healthy"}

funcion reverseproxy_handle(px, solicitud, transporte) { retornar proxy_manejar(px, solicitud, transporte) }
funcion reverseproxy_health_check(px, transporte) { retornar proxy_revisar_salud(px, transporte) }
funcion reverseproxy_status(px) { retornar _reverseproxy_tr(proxy_estado(px), _REVERSEPROXY_RES) }
funcion reverseproxy_add_server(px, upstream, servidor) { retornar proxy_agregar_servidor(px, upstream, servidor) }
funcion reverseproxy_remove_server(px, upstream, url) { retornar proxy_quitar_servidor(px, upstream, url) }
funcion reverseproxy_serve(px, puerto) { retornar proxy_servir(px, puerto) }

/// Config in English: upstreams {name: {"servers", "policy", "health": {"path", "fails", "pause_ms"}}},
/// routes [{"host", "prefix", "methods", "upstream", "strip_prefix", "add_prefix", "headers",
/// "remove_headers", "respond", "redirect"}], limit {"per_second", "burst"}, retries, cache, clock.
/// Policies: round_robin, weighted, least_conn, ip_hash, random, first.
funcion reverseproxy_new(config) {
    sea t = {"servers": "servidores", "policy": "politica", "health": "salud", "path": "ruta", "fails": "fallos", "pause_ms": "pausa_ms", "weight": "peso",
        "routes": "rutas", "prefix": "prefijo", "methods": "metodos", "strip_prefix": "quitar_prefijo", "add_prefix": "agregar_prefijo", "headers": "cabeceras",
        "remove_headers": "quitar_cabeceras", "respond": "responder", "redirect": "redirigir", "keep_path": "mantener_ruta", "status": "estado", "body": "cuerpo",
        "limit": "limite", "per_second": "por_segundo", "burst": "rafaga", "retries": "reintentos", "retry_all": "reintentar_todo", "clock": "reloj"}
    sea c = _reverseproxy_tr(config, t)
    para k en claves(c["upstreams"] ?? {}) {
        sea p = c["upstreams"][k]["politica"] ?? nulo
        si (p == "weighted") { c["upstreams"][k]["politica"] = "ponderada" }
    }
    retornar proxy_nuevo(c)
}
