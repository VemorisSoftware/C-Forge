// stdlib/asyncrt.cfv — concurrencia al estilo Tokio: nombres en inglés del módulo "marea".
// English names for the "marea" module; both can be used together.

importar "marea"

funcion _asyncrt_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_asyncrt_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _asyncrt_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _ASYNCRT_RES = {"valor": "value"}

funcion rt_spawn(f) { retornar marea_lanzar(f) }
funcion rt_join(h, ms) { retornar marea_esperar(h, ms) }
funcion rt_is_finished(h) { retornar marea_termino(h) }
funcion rt_timeout(f, ms) { retornar _asyncrt_tr(marea_con_limite(f, ms), _ASYNCRT_RES) }
funcion rt_join_all(hs) { retornar marea_unir_todas(hs) }
funcion rt_race(hs, ms) { retornar marea_carrera(hs, ms) }
funcion rt_join_set() { retornar marea_conjunto() }
funcion rt_join_set_spawn(cj, f) { retornar marea_conjunto_lanzar(cj, f) }
funcion rt_join_next(cj, ms) { retornar _asyncrt_tr(marea_conjunto_siguiente(cj, ms), _ASYNCRT_RES) }
funcion rt_join_set_len(cj) { retornar marea_conjunto_cantidad(cj) }
funcion rt_channel(capacidad) { retornar marea_canal(capacidad) }
funcion rt_send(c, v) { retornar marea_enviar(c, v) }
funcion rt_recv(c, ms) { retornar marea_recibir(c, ms) }
funcion rt_try_recv(c) { retornar marea_probar_recibir(c) }
funcion rt_pending(c) { retornar marea_pendientes(c) }
funcion rt_close(c) { retornar marea_cerrar(c) }
funcion rt_select(canales, ms) { retornar marea_seleccionar(canales, ms) }
funcion rt_broadcast() { retornar marea_difusion() }
funcion rt_subscribe(d) { retornar marea_suscribir(d) }
funcion rt_publish(d, v) { retornar marea_difundir(d, v) }
funcion rt_watch(inicial) { retornar marea_vigia(inicial) }
funcion rt_watch_set(w, v) { retornar marea_vigia_poner(w, v) }
funcion rt_watch_get(w) { retornar marea_vigia_leer(w) }
funcion rt_watch_changed(w, vista, ms) { retornar marea_vigia_esperar(w, vista, ms) }
funcion rt_semaphore(n) { retornar marea_semaforo(n) }
funcion rt_acquire(s) { retornar marea_adquirir(s) }
funcion rt_release(s) { retornar marea_liberar(s) }
funcion rt_with_permit(s, f) { retornar marea_con_permiso(s, f) }
funcion rt_available_permits(s) { retornar marea_disponibles(s) }
funcion rt_barrier(n) { retornar marea_barrera(n) }
funcion rt_barrier_wait(b) { retornar marea_barrera_esperar(b) }
funcion rt_with_mutex(m, f) { retornar marea_con_mutex(m, f) }
funcion rt_counter(inicial) { retornar marea_contador(inicial) }
funcion rt_add(c, d) { retornar marea_sumar(c, d) }
funcion rt_load(c) { retornar marea_valor(c) }
funcion rt_cancel_token() { retornar marea_ficha() }
funcion rt_cancel(f, motivo) { retornar marea_cancelar(f, motivo) }
funcion rt_is_cancelled(f) { retornar marea_cancelada(f) }
funcion rt_sleep(ms, ficha) { retornar marea_dormir(ms, ficha) }
funcion rt_interval(ms, f, veces, ficha) { retornar marea_intervalo(ms, f, veces, ficha) }
