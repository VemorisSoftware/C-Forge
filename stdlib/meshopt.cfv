// stdlib/meshopt.cfv — optimizar mallas y LOD: nombres en inglés del módulo "optimalla".
// English names for the "optimalla" module; both can be used together.


importar "optimalla"

funcion _meshopt_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_meshopt_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _meshopt_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _MESHOPT_RES = {"remapeo": "remap", "vertices": "vertices", "fallos": "misses", "centro": "center", "radio": "radius"}
sea _MESHOPT_OPT = {"lock_border": "bloquear_bordes", "prune": "recortar"}

funcion meshopt_remap_table(m) { retornar _meshopt_tr(optimalla_remapeo(m), _MESHOPT_RES) }
funcion meshopt_remap(m, r) { retornar optimalla_remapear(m, r) }
funcion meshopt_analyze_cache(indices, n_vertices, tam) { retornar _meshopt_tr(optimalla_cache_analizar(indices, n_vertices, tam), _MESHOPT_RES) }
funcion meshopt_optimize_cache(indices, n_vertices) { retornar optimalla_cache(indices, n_vertices) }
funcion meshopt_optimize_fetch(m) { retornar optimalla_fetch(m) }
funcion meshopt_optimize(m) { retornar optimalla_optimizar(m) }
funcion meshopt_simplify(m, fraccion, error_max, opciones) { retornar optimalla_simplificar(m, fraccion, error_max, _meshopt_opt(opciones)) }
funcion meshopt_lod_chain(m, fracciones, error_max) { retornar optimalla_lod(m, fracciones, error_max) }
funcion meshopt_bounds(m) { retornar optimalla_caja(m) }
funcion meshopt_bounding_sphere(m) { retornar _meshopt_tr(optimalla_esfera(m), _MESHOPT_RES) }
funcion meshopt_half(v) { retornar optimalla_media(v) }
funcion meshopt_snorm(v, bits) { retornar optimalla_snorm(v, bits) }
funcion meshopt_unorm(v, bits) { retornar optimalla_unorm(v, bits) }
funcion meshopt_triangle_count(m) { retornar optimalla_triangulos(m) }

funcion _meshopt_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_MESHOPT_OPT[k] ?? k] = o[k] }
    retornar r
}
