// stdlib/prompt.cfv — preguntas interactivas: nombres en inglés del módulo "pregunta".
// English names for the "pregunta" module; both can be used together.

importar "pregunta"

// English messages by default.
pregunta_idioma("en")

funcion prompt_simulate(respuestas) { retornar pregunta_simular(respuestas) }
funcion prompt_output() { retornar pregunta_salida() }
funcion prompt_language(idioma) { retornar pregunta_idioma(idioma) }
funcion prompt_text(mensaje, opciones) { retornar pregunta_texto(mensaje, opciones) }
funcion prompt_confirm(mensaje, defecto) { retornar pregunta_confirmar(mensaje, defecto) }
funcion prompt_number(mensaje, min, max, opciones) { retornar pregunta_numero(mensaje, min, max, opciones) }
funcion prompt_select(mensaje, opciones_l, defecto) { retornar pregunta_elegir(mensaje, opciones_l, defecto) }
funcion prompt_multiselect(mensaje, opciones_l) { retornar pregunta_varias(mensaje, opciones_l) }
