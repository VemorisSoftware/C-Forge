    "50.10": ["queue.declare", [["ticket", "short"], ["queue", "shortstr"], ["passive", "bit"], ["durable", "bit"], ["exclusive", "bit"], ["auto_delete", "bit"], ["nowait", "bit"], ["arguments", "table"]]],
    "50.11": ["queue.declare_ok", [["queue", "shortstr"], ["message_count", "long"], ["consumer_count", "long"]]],
    "50.20": ["queue.bind", [["ticket", "short"], ["queue", "shortstr"], ["exchange", "shortstr"], ["routing_key", "shortstr"], ["nowait", "bit"], ["arguments", "table"]]],
