    "10.60": ["connection.blocked", [["reason", "shortstr"]]],
    "10.61": ["connection.unblocked", []],
    "20.10": ["channel.open", [["out_of_band", "shortstr"]]],
    "20.11": ["channel.open_ok", [["channel_id", "longstr"]]],
    "20.20": ["channel.flow", [["active", "bit"]]],
    "20.21": ["channel.flow_ok", [["active", "bit"]]],
    "20.40": ["channel.close", [["reply_code", "short"], ["reply_text", "shortstr"], ["class_id", "short"], ["method_id", "short"]]],
    "20.41": ["channel.close_ok", []],
    "40.10": ["exchange.declare", [["ticket", "short"], ["exchange", "shortstr"], ["exchange_type", "shortstr"], ["passive", "bit"], ["durable", "bit"], ["auto_delete", "bit"], ["internal", "bit"], ["nowait", "bit"], ["arguments", "table"]]],
    "40.11": ["exchange.declare_ok", []],
    "40.20": ["exchange.delete", [["ticket", "short"], ["exchange", "shortstr"], ["if_unused", "bit"], ["nowait", "bit"]]],
    "40.21": ["exchange.delete_ok", []],
    "40.30": ["exchange.bind", [["ticket", "short"], ["destination", "shortstr"], ["source", "shortstr"], ["routing_key", "shortstr"], ["nowait", "bit"], ["arguments", "table"]]],
