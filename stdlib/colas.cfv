    "10.21": ["connection.secure_ok", [["response", "longstr"]]],
    "10.30": ["connection.tune", [["channel_max", "short"], ["frame_max", "long"], ["heartbeat", "short"]]],
    "10.31": ["connection.tune_ok", [["channel_max", "short"], ["frame_max", "long"], ["heartbeat", "short"]]],
    "10.40": ["connection.open", [["virtual_host", "shortstr"], ["capabilities", "shortstr"], ["insist", "bit"]]],
    "10.41": ["connection.open_ok", [["known_hosts", "shortstr"]]],
    "10.50": ["connection.close", [["reply_code", "short"], ["reply_text", "shortstr"], ["class_id", "short"], ["method_id", "short"]]],
