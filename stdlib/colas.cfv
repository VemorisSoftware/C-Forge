// stdlib/colas.cfv — cliente AMQP 0-9-1 (RabbitMQ) al estilo amqplib y
// pika: tramas, métodos de connection, channel, exchange, queue, basic,
// confirm y tx con sus argumentos, tablas de campos (enteros, decimales,
// textos, listas, tablas, marcas de tiempo, bytes), cabeceras de contenido
// con todas las propiedades, y un cliente con apretón de manos PLAIN,
// canales, declarar y enlazar intercambios y colas, publicar (con
// confirmaciones), consumir, basic.get, ack/nack/reject, QoS, latidos y
// cierre ordenado. La codificación coincide byte a byte con pamqp. Idea de
// amqplib (MIT) y pika (BSD). En inglés: importar "amqp".
//
//   importar "colas"
//   sea c = colas_conectar("amqp://guest:guest@localhost:5672/", nulo)
//   sea ch = colas_canal(c)
//   colas_declarar_cola(ch, "tareas", {"durable": verdadero})
//   colas_publicar(ch, "", "tareas", "{\"id\": 1}", {"content_type": "application/json"})
//   sea m = colas_obtener(ch, "tareas", nulo)

importar "sin_copia"

funcion _am_b(n) { retornar bytes_entero(n, 1, 0) }
funcion _am_u16(n) { retornar bytes_entero(n, 2, 0) }
funcion _am_u32(n) { retornar bytes_entero(n, 4, 0) }

funcion _am_i(n, ancho) {
    sea x = n
    sea neg = x < 0
    si (neg) { x = 0 - x - 1 }
    sea r = []
    sea k = 0
    mientras (k < ancho) {
        sea b = x % 256
        si (neg) { b = 255 - b }
        r.agregar(_am_b(b))
        x = piso(x / 256)
        k = k + 1
    }
    // Big endian.
    sea s = []
    sea j = ancho - 1
    mientras (j >= 0) {
        s.agregar(r[j])
        j = j - 1
    }
    retornar unir(s, "")
}

funcion _am_leer(t, p, n, con_signo) {
    sea v = bytes_leer_entero(t, p, n, 0)
    si (con_signo y n < 8 y v >= potencia(2, n * 8 - 1)) { v = v - potencia(2, n * 8) }
    retornar v
}

funcion _am_ieee_be(v, n) {
    sea l = _sc_ieee(v, n)
    sea r = []
    sea k = n - 1
    mientras (k >= 0) {
        r.agregar(_am_b(l[k]))
        k = k - 1
    }
    retornar unir(r, "")
}

funcion _am_de_ieee_be(t, p, n) {
    sea inv = []
    sea k = n - 1
    mientras (k >= 0) {
        inv.agregar(subcadena(t, p + k, p + k + 1))
        k = k - 1
    }
    retornar _sc_de_ieee(unir(inv, ""), 0, n)
}

// ---------- tablas de campos ----------

funcion _am_shortstr(s) {
    sea t = "" + s
    si (longitud(t) > 255) { lanzar "amqp: texto corto de más de 255 bytes" }
    retornar _am_b(longitud(t)) + t
}

funcion _am_longstr(s) {
    sea t = "" + s
    retornar _am_u32(longitud(t)) + t
}

/// Valor etiquetado: {"tipo": "T", "valor": ms} (marca de tiempo),
/// {"tipo": "x", "valor": bytes}, {"tipo": "D", "escala", "valor"}, o
/// {"tipo": letra, "valor"} para forzar un tipo numérico.
funcion colas_valor(tipo_v, valor) { retornar {"__amqp": tipo_v, "valor": valor} }

funcion _am_valor(v) {
    si (v == nulo) { retornar "V" }
    si (v == verdadero) { retornar "t" + _am_b(1) }
    si (v == falso) { retornar "t" + _am_b(0) }
    si (tipo(v) == "texto") { retornar "S" + _am_longstr(v) }
    si (tipo(v) == "lista") {
        sea partes = []
        para x en v { partes.agregar(_am_valor(x)) }
        sea d = unir(partes, "")
        retornar "A" + _am_u32(longitud(d)) + d
    }
    si (tipo(v) == "mapa") {
        si (tiene_clave(v, "__amqp")) {
            sea t = v["__amqp"]
            si (t == "T") { retornar "T" + _am_i(v["valor"], 8) }
            si (t == "x") { retornar "x" + _am_longstr(v["valor"]) }
            si (t == "D") { retornar "D" + _am_b(v["escala"] ?? 0) + _am_i(v["valor"], 4) }
            si (t == "b") { retornar "b" + _am_i(v["valor"], 1) }
            si (t == "B") { retornar "B" + _am_b(v["valor"]) }
            si (t == "s") { retornar "s" + _am_i(v["valor"], 2) }
            si (t == "u") { retornar "u" + _am_u16(v["valor"]) }
            si (t == "I") { retornar "I" + _am_i(v["valor"], 4) }
            si (t == "i") { retornar "i" + _am_u32(v["valor"]) }
            si (t == "l") { retornar "l" + _am_i(v["valor"], 8) }
            si (t == "f") { retornar "f" + _am_ieee_be(v["valor"], 4) }
            si (t == "d") { retornar "d" + _am_ieee_be(v["valor"], 8) }
            lanzar "amqp: tipo de valor desconocido " + t
        }
        retornar "F" + colas_tabla(v)
    }
    // Números: enteros como I/l (igual que los clientes de Java, Go y pamqp), decimales como d.
    sea txt = "" + v
    si (texto_indice(txt, ".") < 0 y texto_indice(txt, "e") < 0 y v == piso(v)) {
        si (v >= -2147483648 y v <= 2147483647) { retornar "I" + _am_i(v, 4) }
        retornar "l" + _am_i(v, 8)
    }
    retornar "d" + _am_ieee_be(v, 8)
}

/// Codifica una tabla de campos (con su largo).
funcion colas_tabla(m) {
    sea partes = []
    para k en claves(m ?? {}) { partes.agregar(_am_shortstr(k) + _am_valor(m[k])) }
    sea d = unir(partes, "")
    retornar _am_u32(longitud(d)) + d
}

// Lee un valor; devuelve [valor, siguiente posición].
funcion _am_leer_valor(t, p) {
    sea c = subcadena(t, p, p + 1)
    sea q = p + 1
    si (c == "t") { retornar [byte_en(t, q) != 0, q + 1] }
    si (c == "b") { retornar [_am_leer(t, q, 1, verdadero), q + 1] }
    si (c == "B") { retornar [byte_en(t, q), q + 1] }
    si (c == "s") { retornar [_am_leer(t, q, 2, verdadero), q + 2] }
    si (c == "u") { retornar [_am_leer(t, q, 2, falso), q + 2] }
    si (c == "I") { retornar [_am_leer(t, q, 4, verdadero), q + 4] }
    si (c == "i") { retornar [_am_leer(t, q, 4, falso), q + 4] }
    si (c == "l" o c == "L") { retornar [_am_leer(t, q, 8, verdadero), q + 8] }
    si (c == "f") { retornar [_am_de_ieee_be(t, q, 4), q + 4] }
    si (c == "d") { retornar [_am_de_ieee_be(t, q, 8), q + 8] }
    si (c == "D") {
        sea esc = byte_en(t, q)
        sea v = _am_leer(t, q + 1, 4, verdadero)
        retornar [v / potencia(10, esc), q + 5]
    }
    si (c == "S" o c == "x") {
        sea n = _am_leer(t, q, 4, falso)
        retornar [subcadena(t, q + 4, q + 4 + n), q + 4 + n]
    }
    si (c == "T") { retornar [colas_valor("T", _am_leer(t, q, 8, verdadero)), q + 8] }
    si (c == "V") { retornar [nulo, q] }
    si (c == "A") {
        sea n = _am_leer(t, q, 4, falso)
        sea fin = q + 4 + n
        sea r = []
        sea i = q + 4
        mientras (i < fin) {
            sea x = _am_leer_valor(t, i)
            r.agregar(x[0])
            i = x[1]
        }
        retornar [r, fin]
    }
    si (c == "F") { retornar _am_leer_tabla(t, q) }
    lanzar "amqp: tipo de campo desconocido '" + c + "'"
}

funcion _am_leer_tabla(t, p) {
    sea n = _am_leer(t, p, 4, falso)
    sea fin = p + 4 + n
    sea r = {}
    sea i = p + 4
    mientras (i < fin) {
        sea l = byte_en(t, i)
        sea k = subcadena(t, i + 1, i + 1 + l)
        sea x = _am_leer_valor(t, i + 1 + l)
        r[k] = x[0]
        i = x[1]
    }
    retornar [r, fin]
}

// ---------- métodos ----------

sea _AM_METODOS = {
