// stdlib/linalg.cfv — álgebra lineal: nombres en inglés del módulo "algebra".
// English names for the "algebra" module; both can be used together.

importar "algebra"

funcion _linalg_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_linalg_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _linalg_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _LINALG_RES = {"valores": "values", "vectores": "vectors", "signo": "sign"}

funcion mat_zeros(f, c) { retornar algebra_ceros(f, c) }
funcion mat_identity(n) { retornar algebra_identidad(n) }
funcion mat_diag(v) { retornar algebra_diagonal(v) }
funcion mat_copy(a) { retornar algebra_copia(a) }
funcion mat_rows(a) { retornar algebra_filas(a) }
funcion mat_cols(a) { retornar algebra_columnas(a) }
funcion mat_transpose(a) { retornar algebra_transpuesta(a) }
funcion mat_mul(a, b) { retornar algebra_mul(a, b) }
funcion mat_add(a, b) { retornar algebra_sumar(a, b) }
funcion mat_sub(a, b) { retornar algebra_restar(a, b) }
funcion mat_scale(a, k) { retornar algebra_escalar(a, k) }
funcion vec_dot(u, v) { retornar algebra_punto(u, v) }
funcion mat_trace(a) { retornar algebra_traza(a) }
funcion mat_norm(a, tipo_) { retornar algebra_norma(a, tipo_) }
funcion mat_lu(a) { retornar _linalg_tr(algebra_lu(a), _LINALG_RES) }
funcion mat_solve(a, b) { retornar algebra_resolver(a, b) }
funcion mat_det(a) { retornar algebra_determinante(a) }
funcion mat_inverse(a) { retornar algebra_inversa(a) }
funcion mat_cholesky(a) { retornar algebra_cholesky(a) }
funcion mat_ldlt(a) { retornar algebra_ldlt(a) }
funcion mat_qr(a) { retornar algebra_qr(a) }
funcion mat_lstsq(a, b) { retornar algebra_minimos_cuadrados(a, b) }
funcion mat_eigh(a) { retornar _linalg_tr(algebra_propios_simetrica(a), _LINALG_RES) }
funcion mat_eigvals(a) { retornar algebra_propios(a) }
funcion mat_svd(a) { retornar algebra_svd(a) }
funcion mat_rank(a) { retornar algebra_rango(a) }
funcion mat_pinv(a) { retornar algebra_pseudoinversa(a) }
funcion mat_null_space(a) { retornar algebra_nucleo(a) }
funcion mat_cond(a) { retornar algebra_condicion(a) }
funcion mat_expm(a) { retornar algebra_exp(a) }
funcion mat_allclose(a, b, tol) { retornar algebra_casi_igual(a, b, tol) }
