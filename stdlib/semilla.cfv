// stdlib/semilla.cfv — frases semilla y billeteras jerárquicas: BIP-39
// (12 a 24 palabras en inglés o español, con verificación del checksum y
// semilla con PBKDF2-HMAC-SHA512), BIP-32 (claves extendidas xprv/xpub,
// derivación endurecida y normal por ruta "m/84'/0'/0'/0/0"), WIF y
// direcciones Bitcoin P2PKH, P2WPKH (bc1q…) y Taproot P2TR (bc1p…).
// Incluye RIPEMD-160, Base58Check y Bech32/Bech32m. Las listas de palabras
// son las oficiales de BIP-39. Usa "curva" para secp256k1.
// ⚠️ Una frase semilla da acceso total a los fondos: nunca la guardes en
// texto plano ni la escribas en registros. Inspirada en python-mnemonic y
// rust-bitcoin (MIT/CC0). En inglés: importar "hdwallet".
//
//   importar "semilla"
//   sea frase = semilla_nueva(24, "es")
//   sea s = semilla_a_semilla(frase, "")               // 64 bytes
//   sea m = semilla_maestra(s)
//   sea k = semilla_derivar(m, "m/84'/0'/0'/0/0")
//   semilla_direccion(k, "p2wpkh")                      // "bc1q…"

importar "curva"
importar "unicode"

funcion _sm_byte(v) { retornar bytes_de_hex(subcadena("0123456789abcdef", piso(v / 16), piso(v / 16) + 1) + subcadena("0123456789abcdef", v % 16, v % 16 + 1)) }

