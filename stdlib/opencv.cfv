// stdlib/opencv.cfv — Visión por computador (estilo OpenCV): nombres en inglés del módulo "vision".
// English names for the "vision" module; both can be used together.

importar "vision"

funcion _opencv_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_opencv_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _opencv_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _OPENCV_RES = {"umbral": "threshold", "imagen": "image", "etiquetas": "labels", "estadisticas": "stats", "centroides": "centroids", "caja": "box", "resultado": "result", "mejor": "best", "valor": "value"}

funcion cv_mat(filas, columnas, canales, valor) { retornar vision_matriz(filas, columnas, canales, valor) }
funcion cv_from_image(img) { retornar vision_desde_imagen(img) }
funcion cv_to_image(m) { retornar vision_a_imagen(m) }
funcion cv_gray(m) { retornar vision_gris(m) }
funcion cv_hsv(m) { retornar vision_hsv(m) }
funcion cv_threshold(m, umbral, maximo_, tipo_u) { retornar _opencv_tr(vision_umbral(m, umbral, maximo_, tipo_u), _OPENCV_RES) }
funcion cv_adaptive_threshold(m, maximo_, bloque, c, invertido) { retornar vision_umbral_adaptativo(m, maximo_, bloque, c, invertido) }
funcion cv_blur(m, k, borde) { retornar vision_caja(m, k, borde) }
funcion cv_gaussian_blur(m, k, sigma) { retornar vision_gauss(m, k, sigma) }
funcion cv_median_blur(m, k) { retornar vision_mediana(m, k) }
funcion cv_sobel(m, dx, dy) { retornar vision_sobel(m, dx, dy) }
funcion cv_laplacian(m) { retornar vision_laplaciano(m) }
funcion cv_canny(m, bajo, alto) { retornar vision_canny(m, bajo, alto) }
funcion cv_erode(m, k) { retornar vision_erosion(m, k) }
funcion cv_dilate(m, k) { retornar vision_dilatacion(m, k) }
funcion cv_open(m, k) { retornar vision_apertura(m, k) }
funcion cv_close(m, k) { retornar vision_cierre(m, k) }
funcion cv_morph_gradient(m, k) { retornar vision_gradiente_morfologico(m, k) }
funcion cv_connected_components(m, vecinos) { retornar _opencv_tr(vision_componentes(m, vecinos), _OPENCV_RES) }
funcion cv_find_contours(m) { retornar vision_contornos(m) }
funcion cv_contour_info(pts) { retornar _opencv_tr(vision_contorno_info(pts), _OPENCV_RES) }
funcion cv_moments(m) { retornar vision_momentos(m) }
funcion cv_integral(m) { retornar vision_integral(m) }
funcion cv_equalize_hist(m) { retornar vision_ecualizar(m) }
funcion cv_match_template(m, plantilla, metodo) { retornar _opencv_tr(vision_buscar_plantilla(m, plantilla, metodo), _OPENCV_RES) }
funcion cv_resize(m, columnas, filas, metodo) { retornar vision_redimensionar(m, columnas, filas, metodo) }
