// stdlib/pivot.cfv — análisis tabular avanzado: nombres en inglés del módulo "planilla".
// English names for the "planilla" module; both can be used together.

importar "planilla"

funcion pivot_aggregate(valores, op) { retornar planilla_agregar(valores, op) }
funcion pivot_table(t, filas, columnas, valor, op, relleno) { retornar planilla_pivote(t, filas, columnas, valor, op, relleno) }
funcion pivot_melt(t, ids, valores, nombre_var, nombre_valor) { retornar planilla_derretir(t, ids, valores, nombre_var, nombre_valor) }
funcion pivot_crosstab(t, a, b, totales) { retornar planilla_cruzada(t, a, b, totales) }
funcion pivot_rolling(t, columna, n, op, nueva, min_filas) { retornar planilla_movil(t, columna, n, op, nueva, min_filas) }
funcion pivot_cumulative(t, columna, op, nueva, grupo) { retornar planilla_acumulado(t, columna, op, nueva, grupo) }
funcion pivot_pct_change(t, columna, nueva, periodos) { retornar planilla_cambio(t, columna, nueva, periodos) }
funcion pivot_shift(t, columna, n, nueva) { retornar planilla_desplazar(t, columna, n, nueva) }
funcion pivot_rank(t, columna, nueva, descendente, metodo) { retornar planilla_rango(t, columna, nueva, descendente, metodo) }
funcion pivot_fillna(t, columnas, como) { retornar planilla_rellenar(t, columnas, como) }
funcion pivot_drop_duplicates(t, columnas) { retornar planilla_sin_duplicados(t, columnas) }
funcion pivot_group_by(t, por, agregaciones) { retornar planilla_agrupar(t, por, agregaciones) }
funcion pivot_share(t, columna, nueva, grupo) { retornar planilla_porcentaje(t, columna, nueva, grupo) }
