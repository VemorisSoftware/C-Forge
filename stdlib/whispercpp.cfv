// stdlib/whispercpp.cfv — Voz a texto (estilo whisper.cpp): nombres en inglés del módulo "oido".
// English names for the "oido" module; both can be used together.


importar "oido"

funcion _whispercpp_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_whispercpp_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _whispercpp_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _WHISPERCPP_RES = {"multilingue": "multilingual", "idioma": "language", "probabilidades": "probs", "texto": "text"}
sea _WHISPERCPP_OPT = {"language": "idioma", "task": "tarea", "temperature": "temperatura", "seed": "semilla"}

funcion whisper_pcm_from_wav(datos) { retornar oido_audio_wav(datos) }
funcion whisper_resample(muestras, de, a) { retornar oido_remuestrear(muestras, de, a) }
funcion whisper_mel_filters(n_mels) { retornar oido_filtros_mel(n_mels) }
funcion whisper_log_mel_spectrogram(muestras, filtros, n_cuadros) { retornar oido_mel(muestras, filtros, n_cuadros) }
funcion whisper_init_from_buffer(d) { retornar oido_desde_bytes(d) }
funcion whisper_init_from_file(ruta) { retornar oido_cargar(ruta) }
funcion whisper_model_info(m) { retornar _whispercpp_tr(oido_info(m), _WHISPERCPP_RES) }
funcion whisper_encode(m, mel) { retornar oido_codificar(m, mel) }
funcion whisper_decoder_state(m, audio_cod) { retornar oido_estado(m, audio_cod) }
funcion whisper_decode(m, estado, token) { retornar oido_decodificar(m, estado, token) }
funcion whisper_lang_detect(m, muestras) { retornar _whispercpp_tr(oido_detectar_idioma(m, muestras), _WHISPERCPP_RES) }
funcion whisper_full(m, muestras, opciones) { retornar _whispercpp_tr(oido_transcribir(m, muestras, _whispercpp_opt(opciones)), _WHISPERCPP_RES) }
funcion whisper_tokens_to_text(m, tokens) { retornar oido_texto(m, tokens) }
funcion whisper_languages() { retornar oido_idiomas() }

funcion _whispercpp_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_WHISPERCPP_OPT[k] ?? k] = o[k] }
    retornar r
}
