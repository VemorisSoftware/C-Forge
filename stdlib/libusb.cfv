// stdlib/libusb.cfv — USB de bajo nivel (estilo libusb): nombres en inglés del módulo "usb".
// English names for the "usb" module; both can be used together.

importar "usb"

funcion _libusb_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_libusb_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _libusb_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _LIBUSB_RES = {"nombre": "name", "direccion": "address", "puertos": "port_numbers", "fabricante": "manufacturer", "producto": "product", "serie": "serial", "velocidad": "speed", "clase": "class", "descriptores": "descriptors", "subclase": "subclass", "protocolo": "protocol", "max_paquete0": "max_packet_size0", "num_configuraciones": "num_configurations", "configuraciones": "configurations", "valor": "value", "atributos": "attributes", "autoalimentado": "self_powered", "despertar_remoto": "remote_wakeup", "interfaces": "interfaces", "asociaciones": "associations", "numero": "number", "alternativas": "altsettings", "alternativa": "alternate", "endpoints": "endpoints", "entrada": "in", "tipo": "type", "max_paquete": "max_packet_size", "intervalo": "interval", "capacidades": "capabilities", "num_capacidades": "num_capabilities", "total": "total_length", "num_interfaces": "num_interfaces"}

funcion libusb_get_device_list() { retornar _libusb_tr(usb_dispositivos(), _LIBUSB_RES) }
funcion libusb_open_device_with_vid_pid(vendor, producto) { retornar usb_abrir(vendor, producto) }
funcion libusb_open(d) { retornar usb_abrir_dispositivo(d) }
funcion libusb_control_transfer(h, tipo_req, peticion, valor, indice, datos, tiempo_ms) { retornar usb_control(h, tipo_req, peticion, valor, indice, datos, tiempo_ms) }
funcion libusb_bulk_transfer(h, endpoint, datos, tiempo_ms) { retornar usb_bulk(h, endpoint, datos, tiempo_ms) }
funcion libusb_interrupt_transfer(h, endpoint, datos, tiempo_ms) { retornar usb_interrupcion(h, endpoint, datos, tiempo_ms) }
funcion libusb_claim_interface(h, interfaz) { retornar usb_reclamar(h, interfaz) }
funcion libusb_release_interface(h, interfaz) { retornar usb_liberar(h, interfaz) }
funcion libusb_reset_device(h) { retornar usb_reiniciar(h) }
funcion libusb_set_configuration(h, valor) { retornar usb_fijar_configuracion(h, valor) }
funcion libusb_get_string_descriptor(h, indice, idioma) { retornar usb_texto(h, indice, idioma) }
funcion libusb_close(h) { retornar usb_cerrar(h) }
funcion libusb_parse_device_descriptor(d) { retornar _libusb_tr(usb_descriptor_dispositivo(d), _LIBUSB_RES) }
funcion libusb_parse_config_descriptor(d) { retornar _libusb_tr(usb_descriptor_configuracion(d), _LIBUSB_RES) }
funcion libusb_parse_extra(extra) { retornar usb_descriptores_extra(extra) }
funcion libusb_parse_bos_descriptor(d) { retornar _libusb_tr(usb_descriptor_bos(d), _LIBUSB_RES) }
funcion libusb_parse_descriptors(d) { retornar _libusb_tr(usb_analizar_descriptores(d), _LIBUSB_RES) }
funcion libusb_decode_string_descriptor(d) { retornar usb_texto_descriptor(d) }
funcion libusb_fill_control_setup(tipo_req, peticion, valor, indice, largo) { retornar usb_paquete_setup(tipo_req, peticion, valor, indice, largo) }
funcion libusb_request_type(direccion, tipo_r, destino) { retornar usb_tipo_peticion(direccion, tipo_r, destino) }
funcion libusb_class_name(c) { retornar usb_nombre_clase(c) }
funcion libusb_hex4(v) { retornar usb_hex4(v) }
funcion libusb_set_roots(sysfs, dev) { retornar usb_raices(sysfs, dev) }
