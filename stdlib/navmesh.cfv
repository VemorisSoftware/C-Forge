// stdlib/navmesh.cfv — búsqueda de caminos: nombres en inglés del módulo "navegacion".
// English names for the "navegacion" module; both can be used together.


importar "navegacion"

funcion _navmesh_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_navmesh_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _navmesh_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _NAVMESH_RES = {"camino": "path", "costo": "cost", "explorados": "explored", "distancia": "distance", "direccion": "direction", "largo": "length", "poligonos": "polygons"}
sea _NAVMESH_OPT = {"diagonal": "diagonal", "weight": "peso", "smooth": "suavizar", "full": "completo"}

funcion grid_new(filas) { retornar navegacion_grilla(filas) }
funcion grid_walkable(m, x, fy) { retornar navegacion_libre(m, x, fy) }
funcion grid_set(m, x, fy, costo) { retornar navegacion_fijar(m, x, fy, costo) }
funcion grid_astar(m, inicio, fin, opciones) { retornar _navmesh_tr(navegacion_astar(m, inicio, fin, _navmesh_opt(opciones)), _NAVMESH_RES) }
funcion grid_jps(m, inicio, fin, opciones) { retornar _navmesh_tr(navegacion_jps(m, inicio, fin, _navmesh_opt(opciones)), _NAVMESH_RES) }
funcion grid_line_of_sight(m, a, b) { retornar navegacion_vision(m, a, b) }
funcion grid_smooth_path(m, camino) { retornar navegacion_suavizar(m, camino) }
funcion path_length(camino) { retornar navegacion_largo(camino) }
funcion grid_flow_field(m, meta, opciones) { retornar _navmesh_tr(navegacion_flujo(m, meta, _navmesh_opt(opciones)), _NAVMESH_RES) }
funcion flow_field_follow(f, desde) { retornar navegacion_seguir_flujo(f, desde) }
funcion navmesh_new(vertices, poligonos) { retornar navegacion_malla(vertices, poligonos) }
funcion navmesh_find_polygon(nm, punto) { retornar navegacion_poligono_en(nm, punto) }
funcion navmesh_find_path(nm, desde, hasta) { retornar _navmesh_tr(navegacion_malla_camino(nm, desde, hasta), _NAVMESH_RES) }
funcion funnel_path(portales) { retornar navegacion_embudo(portales) }
funcion navmesh_from_polygon(puntos) { retornar navegacion_malla_desde_poligono(puntos) }

funcion _navmesh_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_NAVMESH_OPT[k] ?? k] = o[k] }
    retornar r
}

// The flow field from grid_flow_field uses English keys; follow it with this.
funcion flow_field_follow_en(field, start) { retornar navegacion_seguir_flujo({"distancia": field["distance"], "direccion": field["direction"]}, start) }
