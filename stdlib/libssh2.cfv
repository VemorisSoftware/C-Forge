// stdlib/libssh2.cfv — Cliente SSH, SFTP y túneles (estilo libssh2): nombres en inglés del módulo "consola_remota".
// English names for the "consola_remota" module; both can be used together.


importar "consola_remota"

funcion _libssh2_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_libssh2_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _libssh2_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _LIBSSH2_RES = {"cifrado": "cipher", "salida": "stdout", "error": "stderr", "codigo": "exit_code", "semilla": "seed", "publica": "public", "comentario": "comment", "privada": "private", "nombre": "name", "tamano": "size", "permisos": "permissions", "es_carpeta": "is_dir", "modificado": "mtime", "acceso": "atime"}
sea _LIBSSH2_OPT = {"user": "usuario", "password": "clave", "private_key": "clave_privada", "fingerprint": "huella"}

funcion ssh_connect(host, puerto, opciones) { retornar consola_conectar(host, puerto, _libssh2_opt(opciones)) }
funcion ssh_hostkey_fingerprint(s) { retornar consola_huella(s) }
funcion ssh_algorithms(s) { retornar _libssh2_tr(consola_algoritmos(s), _LIBSSH2_RES) }
funcion ssh_disconnect(s) { retornar consola_cerrar(s) }
funcion ssh_exec(s, comando, entrada) { retornar _libssh2_tr(consola_ejecutar(s, comando, entrada), _LIBSSH2_RES) }
funcion ssh_load_key(texto) { retornar _libssh2_tr(consola_leer_clave(texto), _LIBSSH2_RES) }
funcion ssh_generate_key(comentario, semilla) { retornar _libssh2_tr(consola_generar_clave(comentario, semilla), _LIBSSH2_RES) }
funcion ssh_fingerprint(blob) { retornar consola_huella_de(blob) }
funcion ssh_tunnel_open(s, host, puerto) { retornar consola_tunel_abrir(s, host, puerto) }
funcion ssh_tunnel_send(s, tunel, datos) { retornar consola_tunel_enviar(s, tunel, datos) }
funcion ssh_tunnel_recv(s, tunel) { retornar consola_tunel_recibir(s, tunel) }
funcion ssh_tunnel_close(s, tunel) { retornar consola_tunel_cerrar(s, tunel) }
funcion sftp_read(s, ruta) { retornar consola_sftp_leer(s, ruta) }
funcion sftp_write(s, ruta, datos) { retornar consola_sftp_escribir(s, ruta, datos) }
funcion sftp_list(s, ruta) { retornar _libssh2_tr(consola_sftp_listar(s, ruta), _LIBSSH2_RES) }
funcion sftp_stat(s, ruta) { retornar _libssh2_tr(consola_sftp_info(s, ruta), _LIBSSH2_RES) }
funcion sftp_unlink(s, ruta) { retornar consola_sftp_borrar(s, ruta) }
funcion sftp_mkdir(s, ruta) { retornar consola_sftp_crear_carpeta(s, ruta) }
funcion sftp_rmdir(s, ruta) { retornar consola_sftp_borrar_carpeta(s, ruta) }
funcion sftp_rename(s, de, a) { retornar consola_sftp_renombrar(s, de, a) }
funcion sftp_realpath(s, ruta) { retornar consola_sftp_ruta_real(s, ruta) }

funcion _libssh2_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_LIBSSH2_OPT[k] ?? k] = o[k] }
    retornar r
}
