// stdlib/paseto.cfv — tokens PASETO v4.public: nombres en inglés del módulo "paseo".
// English names for the "paseo" module; both can be used together.

importar "paseo"

funcion paseto_keys() { retornar paseo_claves() }
funcion paseto_key_to_text(clave) { retornar paseo_clave_texto(clave) }
funcion paseto_key_from_text(t) { retornar paseo_clave_de_texto(t) }
funcion paseto_sign(secreta, datos, opciones) { retornar paseo_firmar(secreta, datos, opciones) }
funcion paseto_verify(publica, token, opciones) { retornar paseo_verificar(publica, token, opciones) }
funcion paseto_footer(token) { retornar paseo_pie(token) }
