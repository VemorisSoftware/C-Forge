// stdlib/compress.cfv — compresión zstd, lz4, snappy y gzip: nombres en inglés del módulo "compacta".
// English names for the "compacta" module; both can be used together.


importar "compacta"

funcion _compress_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_compress_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _compress_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _COMPRESS_OPT = {"dictionary": "diccionario", "max": "maximo"}

funcion zstd_decompress(datos, opciones) { retornar compacta_zstd_descomprimir(datos, _compress_opt(opciones)) }
funcion zstd_compress(datos) { retornar compacta_zstd_comprimir(datos) }
funcion zstd_frame_size(datos) { retornar compacta_zstd_tamano(datos) }
funcion crc32(datos, inicial) { retornar compacta_crc32(datos, inicial) }
funcion adler32(datos) { retornar compacta_adler32(datos) }
funcion xxh32(datos, semilla) { retornar compacta_xxh32(datos, semilla) }
funcion lz4_block_compress(datos) { retornar compacta_lz4_bloque(datos) }
funcion lz4_block_decompress(datos, maximo_) { retornar compacta_lz4_bloque_descomprimir(datos, maximo_) }
funcion lz4_compress(datos) { retornar compacta_lz4_comprimir(datos) }
funcion lz4_decompress(datos) { retornar compacta_lz4_descomprimir(datos) }
funcion snappy_compress(datos) { retornar compacta_snappy_comprimir(datos) }
funcion snappy_decompress(datos) { retornar compacta_snappy_descomprimir(datos) }
funcion gzip(datos, nivel) { retornar compacta_gzip(datos, nivel) }
funcion gunzip(datos, maximo_) { retornar compacta_gunzip(datos, maximo_) }
funcion inflate_raw(datos, inicio, maximo_) { retornar compacta_inflar(datos, inicio, maximo_) }

funcion _compress_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_COMPRESS_OPT[k] ?? k] = o[k] }
    retornar r
}
