// stdlib/msgpack.cfv — MessagePack: nombres en inglés del módulo "paquete_bin".
// English names for the "paquete_bin" module; both can be used together.

importar "paquete_bin"

funcion msgpack_encode(v) { retornar paquete_codificar(v) }
funcion msgpack_decode(b) { retornar paquete_decodificar(b) }
