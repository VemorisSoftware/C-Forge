// stdlib/trees.cfv — árboles de decisión, bosques y Naive Bayes: nombres en inglés del módulo "vela".
// English names for the "vela" module; both can be used together.


importar "vela"

funcion _trees_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_trees_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _trees_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _TREES_OPT = {"max_depth": "profundidad", "depth": "profundidad", "min_samples_split": "min_division", "min_samples_leaf": "min_hoja", "max_features": "max_columnas", "n_estimators": "arboles", "trees": "arboles", "seed": "semilla", "regression": "regresion"}

funcion trees_decision_tree(X, y, opciones) { retornar vela_arbol(X, y, _trees_opt(opciones)) }
funcion trees_random_forest(X, y, opciones) { retornar vela_bosque(X, y, _trees_opt(opciones)) }
funcion trees_gaussian_nb(X, y) { retornar vela_bayes(X, y) }
funcion trees_text_nb(textos, etiquetas, alfa) { retornar vela_bayes_texto(textos, etiquetas, alfa) }
funcion trees_scores(modelo, x) { retornar vela_puntajes(modelo, x) }
funcion trees_predict(modelo, X) { retornar vela_predecir(modelo, X) }
funcion trees_feature_importance(modelo, columnas) { retornar vela_importancia(modelo, columnas) }
funcion trees_to_string(modelo, nombres) { retornar vela_texto(modelo, nombres) }

funcion _trees_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_TREES_OPT[k] ?? k] = o[k] }
    retornar r
}
