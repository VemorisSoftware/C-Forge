// stdlib/mqtt.cfv — MQTT: nombres en inglés del módulo "sensor".
// English names for the "sensor" module; both can be used together.

importar "sensor"

sea _MQ_TIPOS = {"mensaje": "message", "conectado": "connected", "rechazado": "rejected", "confirmado": "acked", "suscrito": "subscribed", "pong": "pong"}

funcion _mq_opts(o) {
    si (o == nulo) { retornar nulo }
    sea r = {}
    sea t = {"send": "enviar", "username": "usuario", "password": "clave", "keepalive": "mantener", "clean": "limpia", "will": "voluntad", "clock": "reloj", "retry_ms": "reintento_ms", "retain": "retener"}
    para k en claves(o) { r[t[k] ?? k] = o[k] }
    si (tiene_clave(r, "voluntad") y r["voluntad"] != nulo) {
        sea w = r["voluntad"]
        r["voluntad"] = {"topico": w["topic"] ?? (w["topico"] ?? nulo), "mensaje": w["message"] ?? (w["mensaje"] ?? ""), "qos": w["qos"] ?? 0, "retener": w["retain"] ?? (w["retener"] ?? falso)}
    }
    retornar r
}

funcion _mq_evento(e) {
    sea r = {}
    sea t = {"tipo": "type", "topico": "topic", "mensaje": "message", "retener": "retain", "sesion_presente": "session_present", "codigo": "code", "filtro": "filter", "rechazado": "rejected"}
    para k en claves(e) { r[t[k] ?? k] = e[k] }
    r["type"] = _MQ_TIPOS[e["tipo"]] ?? e["tipo"]
    retornar r
}

funcion mqtt_connect_packet(o) { retornar sensor_paquete_conectar(_mq_opts(o)) }
funcion mqtt_connack_packet(session_present, code, version) { retornar sensor_paquete_connack(session_present, code, version) }
funcion mqtt_publish_packet(topic, payload, o, version) { retornar sensor_paquete_publicar(topic, payload, _mq_opts(o), version) }
funcion mqtt_puback_packet(id) { retornar sensor_paquete_puback(id) }
funcion mqtt_pubrec_packet(id) { retornar sensor_paquete_pubrec(id) }
funcion mqtt_pubrel_packet(id) { retornar sensor_paquete_pubrel(id) }
funcion mqtt_pubcomp_packet(id) { retornar sensor_paquete_pubcomp(id) }
funcion mqtt_subscribe_packet(id, filters, version) { retornar sensor_paquete_suscribir(id, filters, version) }
funcion mqtt_suback_packet(id, codes) { retornar sensor_paquete_suback(id, codes) }
funcion mqtt_unsubscribe_packet(id, filters) { retornar sensor_paquete_desuscribir(id, filters) }
funcion mqtt_unsuback_packet(id) { retornar sensor_paquete_unsuback(id) }
funcion mqtt_pingreq_packet() { retornar sensor_paquete_ping() }
funcion mqtt_pingresp_packet() { retornar sensor_paquete_pong() }
funcion mqtt_disconnect_packet() { retornar sensor_paquete_desconectar() }

funcion mqtt_parse_packet(p, version) {
    sea x = sensor_leer_paquete(p, version)
    sea r = {}
    sea t = {"tipo": "type", "topico": "topic", "mensaje": "message", "retener": "retain", "sesion_presente": "session_present", "codigo": "code", "codigos": "codes", "filtros": "filters", "mantener": "keepalive", "limpia": "clean", "usuario": "username", "clave": "password", "voluntad": "will"}
    para k en claves(x) { r[t[k] ?? k] = x[k] }
    retornar r
}

funcion mqtt_split(buffer) {
    sea r = sensor_separar(buffer)
    retornar {"packets": r["paquetes"], "rest": r["resto"]}
}

funcion mqtt_validate_topic(t) { retornar sensor_validar_topico(t) }
funcion mqtt_validate_filter(f) { retornar sensor_validar_filtro(f) }
funcion mqtt_matches(filter, topic) { retornar sensor_coincide(filter, topic) }

/// options: id, send (f(bytes)), username, password, keepalive, clean, will, version, clock, retry_ms.
funcion mqtt_client(options) { retornar sensor_cliente(_mq_opts(options)) }
funcion mqtt_connect(c) { retornar sensor_conectar(c) }
funcion mqtt_publish(c, topic, payload, options) { retornar sensor_publicar(c, topic, payload, _mq_opts(options)) }
funcion mqtt_subscribe(c, filter, qos) { retornar sensor_suscribir(c, filter, qos) }
funcion mqtt_unsubscribe(c, filter) { retornar sensor_desuscribir(c, filter) }

/// Feeds received bytes; returns events with "type": "message" | "connected" | "acked" | "subscribed" | "pong" | "rejected".
funcion mqtt_receive(c, bytes_) {
    sea r = []
    para e en sensor_recibir(c, bytes_) { r.agregar(_mq_evento(e)) }
    retornar r
}

funcion mqtt_tick(c) { retornar sensor_tic(c) }
funcion mqtt_disconnect(c) { retornar sensor_desconectar(c) }
funcion mqtt_pending(c) { retornar sensor_pendientes(c) }
funcion mqtt_broker() { retornar sensor_broker() }
funcion mqtt_broker_connection(br, send) { retornar sensor_broker_conexion(br, send) }
funcion mqtt_broker_drop(br, id) { retornar sensor_broker_caida(br, id) }
