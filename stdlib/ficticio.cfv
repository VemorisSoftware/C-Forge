// stdlib/ficticio.cfv — datos falsos realistas y reproducibles (misma
// semilla = mismos datos) para pruebas y demos, en español o inglés.
// Incluye RUT chileno con dígito verificador válido. Inspirada en Faker
// (MIT). En inglés: importar "faker".
//
//   importar "ficticio"
//   sea f = ficticio_nuevo(42, "es")
//   ficticio_nombre_completo(f)   // "Camila Rojas Soto"
//   ficticio_correo(f)            // "camila.rojas@ejemplo.cl"
//   ficticio_rut(f)               // "12.345.678-5"
//
// Los correos usan dominios reservados (example.com, ejemplo.cl…) para no
// escribirle nunca a alguien real.

sea _FIC = {
    "es": {
        "nombres": ["Camila", "Valentina", "Sofía", "Isidora", "Antonia", "Martina", "Florencia", "Catalina", "Javiera", "Fernanda", "Benjamín", "Vicente", "Martín", "Matías", "Joaquín", "Agustín", "Tomás", "Lucas", "Diego", "Sebastián"],
        "apellidos": ["González", "Muñoz", "Rojas", "Díaz", "Pérez", "Soto", "Contreras", "Silva", "Martínez", "Sepúlveda", "Morales", "Rodríguez", "López", "Fuentes", "Hernández", "Torres", "Araya", "Flores", "Espinoza", "Valenzuela"],
        "ciudades": ["Santiago", "Valparaíso", "Concepción", "La Serena", "Antofagasta", "Temuco", "Rancagua", "Talca", "Arica", "Puerto Montt", "Ciudad de México", "Bogotá", "Lima", "Madrid", "Buenos Aires"],
        "calles": ["Av. Providencia", "Los Leones", "Av. Irarrázaval", "Grecia", "Pedro de Valdivia", "Av. Matta", "Los Aromos", "El Bosque"],
        "empresas": ["Andes", "Austral", "Pacífico", "Cordillera", "Patagonia", "Litoral", "Altiplano", "Bosque"],
        "sufijos": ["SpA", "Ltda.", "S.A.", "y Cía."],
        "giros": ["Consultores", "Servicios", "Tecnología", "Logística", "Alimentos", "Ingeniería"],
        "dominios": ["ejemplo.cl", "example.com", "example.org"],
        "palabras": ["proyecto", "equipo", "cliente", "sistema", "datos", "plan", "informe", "venta", "red", "diseño", "servicio", "mercado", "idea", "valor", "tiempo", "forma", "ciudad", "camino", "nube", "puerto"],
        "telefono": "+56 9 ",
        "y": "y"
    },
    "en": {
        "nombres": ["Olivia", "Emma", "Amelia", "Sophia", "Charlotte", "Mia", "Harper", "Evelyn", "Ava", "Grace", "Liam", "Noah", "Oliver", "James", "Elijah", "William", "Henry", "Lucas", "Benjamin", "Theodore"],
        "apellidos": ["Smith", "Johnson", "Williams", "Brown", "Jones", "Miller", "Davis", "Wilson", "Anderson", "Taylor", "Thomas", "Moore", "Martin", "Jackson", "Thompson", "White", "Harris", "Clark", "Lewis", "Walker"],
        "ciudades": ["Springfield", "Riverside", "Franklin", "Greenville", "Bristol", "Clinton", "Fairview", "Salem", "Madison", "Georgetown", "Austin", "Denver", "Portland", "Boston", "Seattle"],
        "calles": ["Main St", "Oak Ave", "Maple Dr", "Cedar Ln", "Elm St", "Park Ave", "Pine Rd", "Lake View"],
        "empresas": ["Summit", "Pioneer", "Harbor", "Evergreen", "Northwind", "Bluebird", "Ironwood", "Crescent"],
        "sufijos": ["Inc.", "LLC", "Group", "& Co."],
        "giros": ["Consulting", "Services", "Technologies", "Logistics", "Foods", "Engineering"],
        "dominios": ["example.com", "example.org", "example.net"],
        "palabras": ["project", "team", "client", "system", "data", "plan", "report", "sale", "network", "design", "service", "market", "idea", "value", "time", "shape", "city", "road", "cloud", "harbor"],
        "telefono": "+1 555 ",
        "y": "and"
    }
}

funcion ficticio_nuevo(semilla, idioma) {
    sea l = idioma ?? "es"
    si (tiene_clave(_FIC, l) == falso) { lanzar "ficticio: idioma \"es\" o \"en\"" }
    sea s = semilla ?? 1
    s = piso(absoluto(s)) % 2147483646 + 1
    retornar {"estado": s, "idioma": l}
}

/// Entero en [0, 2147483646): Park–Miller, sin desbordes.
funcion _fic_siguiente(f) {
    f["estado"] = (f["estado"] * 48271) % 2147483647
    retornar f["estado"] - 1
}

/// Entero entre min y max, ambos incluidos.
funcion ficticio_entero(f, min, max) {
    si (max < min) { lanzar "ficticio: max < min" }
    retornar min + _fic_siguiente(f) % (max - min + 1)
}

funcion ficticio_elegir(f, lista) {
    si (longitud(lista) == 0) { lanzar "ficticio: lista vacía" }
    retornar lista[ficticio_entero(f, 0, longitud(lista) - 1)]
}

funcion ficticio_booleano(f) { retornar ficticio_entero(f, 0, 1) == 1 }

funcion _fic(f, clave) { retornar ficticio_elegir(f, _FIC[f["idioma"]][clave]) }

funcion ficticio_nombre(f) { retornar _fic(f, "nombres") }
funcion ficticio_apellido(f) { retornar _fic(f, "apellidos") }
funcion ficticio_nombre_completo(f) {
    si (f["idioma"] == "es") { retornar ficticio_nombre(f) + " " + ficticio_apellido(f) + " " + ficticio_apellido(f) }
    retornar ficticio_nombre(f) + " " + ficticio_apellido(f)
}
funcion ficticio_ciudad(f) { retornar _fic(f, "ciudades") }
funcion ficticio_direccion(f) {
    si (f["idioma"] == "es") { retornar _fic(f, "calles") + " " + ficticio_entero(f, 10, 9999) + ", " + ficticio_ciudad(f) }
    retornar ficticio_entero(f, 10, 9999) + " " + _fic(f, "calles") + ", " + ficticio_ciudad(f)
}
funcion ficticio_empresa(f) {
    sea base = _fic(f, "empresas") + " " + _fic(f, "giros")
    si (f["idioma"] == "es") { retornar base + " " + _fic(f, "sufijos") }
    retornar base + " " + _fic(f, "sufijos")
}

funcion _fic_ascii(t) {
    sea r = texto_minusculas(t)
    sea pares = [["á", "a"], ["é", "e"], ["í", "i"], ["ó", "o"], ["ú", "u"], ["ü", "u"], ["ñ", "n"], ["Á", "a"], ["É", "e"], ["Í", "i"], ["Ó", "o"], ["Ú", "u"], ["Ñ", "n"], [" ", ""]]
    para p en pares { r = texto_reemplazar(r, p[0], p[1]) }
    retornar r
}

funcion ficticio_correo(f) {
    retornar _fic_ascii(ficticio_nombre(f)) + "." + _fic_ascii(ficticio_apellido(f)) + ficticio_entero(f, 1, 99) + "@" + _fic(f, "dominios")
}

funcion ficticio_telefono(f) {
    sea t = _FIC[f["idioma"]]["telefono"]
    si (f["idioma"] == "es") { retornar t + ficticio_entero(f, 1000, 9999) + " " + ficticio_entero(f, 1000, 9999) }
    retornar t + ficticio_entero(f, 100, 999) + " " + ficticio_entero(f, 1000, 9999)
}

/// Dígito verificador del RUT (módulo 11): "0"–"9" o "K".
funcion ficticio_dv(numero) {
    sea n = numero
    sea suma = 0
    sea factor = 2
    mientras (n > 0) {
        suma = suma + (n % 10) * factor
        n = cociente(n, 10)
        factor = factor + 1
        si (factor > 7) { factor = 2 }
    }
    sea d = 11 - suma % 11
    si (d == 11) { retornar "0" }
    si (d == 10) { retornar "K" }
    retornar "" + d
}

/// RUT chileno válido con puntos y guion.
funcion ficticio_rut(f) {
    sea n = ficticio_entero(f, 5000000, 25999999)
    sea t = "" + n
    sea con_puntos = subcadena(t, 0, longitud(t) - 6) + "." + subcadena(t, longitud(t) - 6, longitud(t) - 3) + "." + subcadena(t, longitud(t) - 3, longitud(t))
    retornar con_puntos + "-" + ficticio_dv(n)
}

funcion ficticio_oracion(f, palabras) {
    sea n = palabras ?? ficticio_entero(f, 4, 10)
    sea l = []
    sea i = 0
    mientras (i < n) { l.agregar(_fic(f, "palabras"))  i = i + 1 }
    sea t = unir(l, " ")
    retornar texto_mayusculas(subcadena(t, 0, 1)) + subcadena(t, 1, longitud(t)) + "."
}

funcion ficticio_parrafo(f, oraciones) {
    sea n = oraciones ?? ficticio_entero(f, 3, 6)
    sea l = []
    sea i = 0
    mientras (i < n) { l.agregar(ficticio_oracion(f))  i = i + 1 }
    retornar unir(l, " ")
}

/// UUID v4 con forma correcta (reproducible: no usar como secreto).
funcion ficticio_uuid(f) {
    sea h = "0123456789abcdef"
    sea r = ""
    sea i = 0
    mientras (i < 32) {
        sea d = ficticio_entero(f, 0, 15)
        si (i == 12) { d = 4 }
        si (i == 16) { d = 8 + d % 4 }
        si (i == 8 o i == 12 o i == 16 o i == 20) { r = r + "-" }
        r = r + subcadena(h, d, d + 1)
        i = i + 1
    }
    retornar r
}

/// Persona completa en un mapa.
funcion ficticio_persona(f) {
    sea nombre = ficticio_nombre(f)
    sea apellido = ficticio_apellido(f)
    sea p = {"nombre": nombre, "apellido": apellido, "correo": _fic_ascii(nombre) + "." + _fic_ascii(apellido) + "@" + _fic(f, "dominios"), "telefono": ficticio_telefono(f), "ciudad": ficticio_ciudad(f), "edad": ficticio_entero(f, 18, 80)}
    si (f["idioma"] == "es") { p["rut"] = ficticio_rut(f) }
    retornar p
}
