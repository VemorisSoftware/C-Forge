// stdlib/password.cfv — hash de contraseñas: nombres en inglés del módulo "clave".
// English names for the "clave" module; both can be used together.


importar "clave"

funcion _password_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_password_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _password_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _PASSWORD_RES = {"algoritmo": "algorithm", "costo": "cost", "iteraciones": "iterations", "nivel": "level", "avisos": "warnings"}
sea _PASSWORD_OPT = {"algorithm": "algoritmo", "cost": "costo", "iterations": "iteraciones", "salt": "sal", "length": "largo"}

funcion bcrypt_raw(contrasena, sal, costo) { retornar clave_bcrypt_crudo(contrasena, sal, costo) }
funcion bcrypt_hash(contrasena, costo, sal) { retornar clave_bcrypt(contrasena, costo, sal) }
funcion scrypt(contrasena, sal, n, r, p, largo) { retornar clave_scrypt(contrasena, sal, n, r, p, largo) }
funcion hash_password(contrasena, opciones) { retornar clave_hash(contrasena, _password_opt(opciones)) }
funcion password_verify(contrasena, h) { retornar clave_verificar(contrasena, h) }
funcion password_info(h) { retornar _password_tr(clave_info(h), _PASSWORD_RES) }
funcion password_needs_rehash(h, opciones) { retornar clave_rehacer(h, _password_opt(opciones)) }
funcion password_strength(contrasena) { retornar _password_tr(clave_fuerza(contrasena), _PASSWORD_RES) }

funcion _password_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_PASSWORD_OPT[k] ?? k] = o[k] }
    retornar r
}
