// stdlib/vorbis.cfv — decodificador Ogg Vorbis: nombres en inglés del módulo "mezcla_vorbis".
// English names for the "mezcla_vorbis" module; both can be used together.

importar "mezcla_vorbis"

funcion _vorbis_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_vorbis_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _vorbis_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _VORBIS_RES = {"datos": "data", "granulo": "granule", "ultimo": "last"}

funcion vorbis_is_vorbis(datos) { retornar vorbis_es(datos) }
funcion ogg_packets(datos) { retornar _vorbis_tr(ogg_paquetes(datos), _VORBIS_RES) }

// Decode an Ogg Vorbis stream. Returns {"tasa": rate, "canales": channels,
// "c": [samples per channel], "etiquetas": tags} like "mixer". options: "max_ms".
funcion vorbis_decode(data, options) { retornar vorbis_decodificar(data, options) }
// Stream info: rate, channels, bitrate, samples, duration_ms, vendor, tags, block_sizes.
funcion vorbis_metadata(data) {
    sea i = vorbis_info(data)
    retornar {"rate": i["tasa"], "channels": i["canales"], "bitrate": i["bitrate"], "samples": i["muestras"], "duration_ms": i["duracion_ms"], "vendor": i["proveedor"], "tags": i["etiquetas"], "block_sizes": i["bloques"]}
}
