// stdlib/code_analysis.cfv — el compilador como servicio: nombres en inglés del módulo "analiza".
// English names for the "analiza" module; both can be used together.

importar "analiza"

funcion _code_analysis_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_code_analysis_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _code_analysis_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _CODE_ANALYSIS_RES = {"tipo": "kind", "texto": "text", "valor": "value", "linea": "line", "col": "col", "pos": "pos", "fin": "end", "nombre": "name", "definicion": "is_definition", "firma": "signature", "doc": "doc", "modulo": "module", "detalle": "detail", "hasta": "end_line", "desde": "start_line", "metodos": "methods", "sin_cerrar": "unterminated"}

funcion analysis_tokens(fuente) { retornar _code_analysis_tr(analiza_tokens(fuente), _CODE_ANALYSIS_RES) }
funcion analysis_definition(fuente, linea, col, opciones) { retornar _code_analysis_tr(analiza_definicion(fuente, linea, col, opciones), _CODE_ANALYSIS_RES) }
funcion analysis_references(fuente, linea, col, opciones) { retornar _code_analysis_tr(analiza_referencias(fuente, linea, col, opciones), _CODE_ANALYSIS_RES) }
funcion analysis_rename(fuente, linea, col, nuevo, opciones) { retornar analiza_renombrar(fuente, linea, col, nuevo, opciones) }
funcion analysis_hover(fuente, linea, col, opciones) { retornar _code_analysis_tr(analiza_info(fuente, linea, col, opciones), _CODE_ANALYSIS_RES) }
funcion analysis_complete(fuente, linea, col, opciones) { retornar _code_analysis_tr(analiza_completar(fuente, linea, col, opciones), _CODE_ANALYSIS_RES) }
funcion analysis_symbols(fuente) { retornar _code_analysis_tr(analiza_simbolos(fuente), _CODE_ANALYSIS_RES) }
funcion analysis_folding(fuente) { retornar _code_analysis_tr(analiza_plegado(fuente), _CODE_ANALYSIS_RES) }

// Diagnostics: [{"line", "col", "severity" (error/warning), "code", "message"}].
// options: "stdlib" (module folder), "globals" (extra names).
funcion analysis_diagnostics(source, options) {
    sea o = options ?? {}
    sea op = {}
    si (tiene_clave(o, "stdlib")) { op["stdlib"] = o["stdlib"] }
    si (tiene_clave(o, "globals")) { op["globales"] = o["globals"] }
    sea r = []
    para d en analiza_diagnosticos(source, op) {
        sea sev = "warning"
        si (d["severidad"] == "error") { sev = "error" }
        r.agregar({"line": d["linea"], "col": d["col"], "severity": sev, "code": d["codigo"], "message": d["mensaje"]})
    }
    retornar r
}
// Syntax tree: {"root", "errors"} (node fields keep their Spanish names).
funcion analysis_tree(source) {
    sea a = analiza_arbol(source)
    retornar {"root": a["raiz"], "errors": a["errores"]}
}
