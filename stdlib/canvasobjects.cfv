// stdlib/canvasobjects.cfv — objetos interactivos en un lienzo: nombres en inglés del módulo "pizarra".
// English names for the "pizarra" module; both can be used together.

importar "pizarra"

funcion fab_matrix(ob) { retornar pizarra_matriz(ob) }
funcion fab_corners(ob) { retornar pizarra_esquinas(ob) }
funcion fab_bounding_box(ob) { retornar pizarra_caja(ob) }
funcion fab_contains_point(ob, x, y) { retornar pizarra_contiene(ob, x, y) }
funcion fab_canvas(ancho, alto) { retornar pizarra_nueva(ancho, alto) }
funcion fab_on(pz, evento, f) { retornar pizarra_al(pz, evento, f) }
funcion fab_add(pz, ob) { retornar pizarra_agregar(pz, ob) }
funcion fab_remove(pz, ob) { retornar pizarra_quitar(pz, ob) }
funcion fab_get(pz, clave) { retornar pizarra_obtener(pz, clave) }
funcion fab_bring_to_front(pz, ob) { retornar pizarra_al_frente(pz, ob) }
funcion fab_send_to_back(pz, ob) { retornar pizarra_al_fondo(pz, ob) }
funcion fab_bring_forward(pz, ob) { retornar pizarra_subir(pz, ob) }
funcion fab_send_backwards(pz, ob) { retornar pizarra_bajar(pz, ob) }
funcion fab_find_target(pz, x, y) { retornar pizarra_objeto_en(pz, x, y) }
funcion fab_set_active(pz, ob) { retornar pizarra_seleccionar(pz, ob) }
funcion fab_controls(ob) { retornar pizarra_manijas(ob) }
funcion fab_undo(pz) { retornar pizarra_deshacer(pz) }
funcion fab_redo(pz) { retornar pizarra_rehacer(pz) }
funcion fab_to_json(pz) { retornar pizarra_a_json(pz) }
funcion fab_load_json(j) { retornar pizarra_desde_json(j) }
funcion fab_render(pz, c, con_seleccion) { retornar pizarra_dibujar(pz, c, con_seleccion) }
funcion fab_export(pz, formato, con_seleccion) { retornar pizarra_exportar(pz, formato, con_seleccion) }

sea _FAB_PROPS = {"left": "izq", "top": "arriba", "width": "ancho", "height": "alto", "angle": "angulo", "scaleX": "escala_x", "scaleY": "escala_y", "originX": "origen_x", "originY": "origen_y", "fill": "relleno", "stroke": "trazo", "strokeWidth": "grosor", "opacity": "opacidad", "visible": "visible", "selectable": "seleccionable", "locked": "bloqueado", "name": "nombre", "data": "datos", "radius": "radio", "rx": "rx", "ry": "ry", "fontSize": "tam", "bold": "negrita"}
sea _FAB_VALORES = {"left": "izquierda", "center": "centro", "right": "derecha", "top": "arriba", "bottom": "abajo"}
funcion _fab_o(o) {
    sea r = {}
    para k en claves(o ?? {}) { r[_FAB_PROPS[k] ?? k] = o[k] }
    para k en ["origen_x", "origen_y"] { si (tiene_clave(r, k)) { r[k] = _FAB_VALORES[r[k]] ?? r[k] } }
    retornar r
}
funcion fab_rect(o) { retornar pizarra_rect(_fab_o(o)) }
funcion fab_circle(o) { retornar pizarra_circulo(_fab_o(o)) }
funcion fab_ellipse(o) { retornar pizarra_elipse(_fab_o(o)) }
funcion fab_line(x1, y1, x2, y2, o) { retornar pizarra_linea(x1, y1, x2, y2, _fab_o(o)) }
funcion fab_polygon(puntos, o) { retornar pizarra_poligono(puntos, _fab_o(o)) }
funcion fab_path(d, o) { retornar pizarra_camino(d, _fab_o(o)) }
funcion fab_text(texto, o) { retornar pizarra_texto(texto, _fab_o(o)) }
funcion fab_group(objetos, o) { retornar pizarra_grupo(objetos, _fab_o(o)) }
funcion fab_set(pz, ob, props) { retornar pizarra_cambiar(pz, ob, _fab_o(props)) }
// Ratón: "down", "move" o "up"; opciones "uniform" y "snap_angle".
sea _FAB_RATON = {"down": "bajar", "move": "mover", "up": "subir"}
funcion fab_mouse(pz, tipo_e, x, y, opciones) {
    sea op = {}
    para k en claves(opciones ?? {}) {
        si (k == "uniform") { op["proporcional"] = opciones[k] } sino si (k == "snap_angle") { op["ajuste"] = opciones[k] } sino { op[k] = opciones[k] }
    }
    retornar pizarra_raton(pz, _FAB_RATON[tipo_e] ?? tipo_e, x, y, op)
}
// Eventos en inglés: added, removed, selected, deselected, moving, scaling,
// rotating, modified.
sea _FAB_EVENTOS = {"added": "agregado", "removed": "quitado", "selected": "seleccionado", "deselected": "deseleccionado", "moving": "moviendo", "scaling": "escalando", "rotating": "girando", "modified": "modificado"}
funcion fab_on_event(pz, evento, f) { pizarra_al(pz, _FAB_EVENTOS[evento] ?? evento, f) }
