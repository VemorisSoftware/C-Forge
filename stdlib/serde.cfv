// stdlib/serde.cfv — serialización con esquema: nombres en inglés del módulo "molde".
// English names for the "molde" module; both can be used together.


importar "molde"

funcion _serde_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_serde_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _serde_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _SERDE_RES = {"error": "error"}
sea _SERDE_OPT = {"name": "nombre", "skip": "omitir", "skip_if_null": "omitir_si_nulo", "aliases": "alias"}

funcion serde_list(elemento) { retornar molde_lista(elemento) }
funcion serde_map(valor) { retornar molde_mapa(valor) }
funcion serde_optional(interior) { retornar molde_opcional(interior) }
funcion serde_default(interior, valor) { retornar molde_defecto(interior, valor) }
funcion serde_enum(valores) { retornar molde_enum(valores) }
funcion serde_tagged(etiqueta, variantes) { retornar molde_union(etiqueta, variantes) }
funcion serde_custom(nombre, a_dato, desde_dato) { retornar molde_propio(nombre, a_dato, desde_dato) }
funcion serde_struct(campos, opciones) { retornar molde_registro(campos, _serde_opt(opciones)) }
funcion serde_field(molde_, opciones) { retornar molde_campo(molde_, _serde_opt(opciones)) }
funcion serde_rename(nombre, estilo) { retornar molde_renombrar(nombre, estilo) }
funcion serde_to_value(m, v) { retornar molde_a_dato(m, v) }
funcion serde_from_value(m, d) { retornar molde_desde_dato(m, d) }
funcion serde_to_json(m, v, con_sangria) { retornar molde_a_json(m, v, con_sangria) }
funcion serde_from_json(m, texto) { retornar molde_desde_json(m, texto) }
funcion serde_validate(m, v) { retornar _serde_tr(molde_validar(m, v), _SERDE_RES) }
funcion serde_to_csv(m, lista) { retornar molde_a_csv(m, lista) }
funcion serde_from_csv(m, texto) { retornar molde_desde_csv(m, texto) }
funcion serde_to_query(m, v) { retornar molde_a_query(m, v) }
funcion serde_from_query(m, texto) { retornar molde_desde_query(m, texto) }
funcion serde_to_binary(m, v) { retornar molde_a_binario(m, v) }
funcion serde_from_binary(m, b) { retornar molde_desde_binario(m, b) }
funcion serde_migrate(m, dato, migraciones, campo_version) { retornar molde_migrar(m, dato, migraciones, campo_version) }

funcion _serde_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_SERDE_OPT[k] ?? k] = o[k] }
    retornar r
}
