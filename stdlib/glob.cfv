// stdlib/glob.cfv — recorrer carpetas y comodines: nombres en inglés del módulo "rastreo".
// English names for the "rastreo" module; both can be used together.

importar "rastreo"

funcion glob_match(patron, ruta) { retornar rastreo_coincide(patron, ruta) }
funcion glob_filter(rutas, patron) { retornar rastreo_filtrar(rutas, patron) }

/// options: depth, ignore, hidden, dirs. Entries: {"path", "name", "is_dir", "depth"}.
funcion glob_walk(raiz, opciones) {
    sea o = {}
    sea en = {"depth": "profundidad", "ignore": "ignorar", "hidden": "ocultos", "dirs": "carpetas"}
    si (opciones != nulo) { para k en claves(opciones) { si (tiene_clave(en, k)) { o[en[k]] = opciones[k] } sino { o[k] = opciones[k] } } }
    sea r = []
    para e en rastreo_recorrer(raiz, o) { r.agregar({"path": e["ruta"], "name": e["nombre"], "is_dir": e["carpeta"], "depth": e["profundidad"]}) }
    retornar r
}

funcion glob_find(raiz, patron, opciones) {
    sea o = {}
    sea en = {"depth": "profundidad", "ignore": "ignorar", "hidden": "ocultos"}
    si (opciones != nulo) { para k en claves(opciones) { si (tiene_clave(en, k)) { o[en[k]] = opciones[k] } sino { o[k] = opciones[k] } } }
    retornar rastreo_buscar(raiz, patron, o)
}

funcion list_dir(ruta) { retornar listar_carpeta(ruta) }
funcion is_dir(ruta) { retornar es_carpeta(ruta) }
funcion make_dir(ruta) { retornar crear_carpeta(ruta) }
