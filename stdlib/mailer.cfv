// stdlib/mailer.cfv — enviar correo con DKIM: nombres en inglés del módulo "correo".
// English names for the "correo" module; both can be used together.


importar "correo"

funcion _mailer_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_mailer_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _mailer_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _MAILER_RES = {"valida": "valid", "dominio": "domain", "motivo": "reason", "codigo": "code", "lineas": "lines", "aceptado": "accepted", "respuestas": "replies", "datos": "data", "de": "from", "destinatarios": "recipients"}
sea _MAILER_OPT = {"domain": "dominio", "key": "clave", "headers": "cabeceras", "canonicalization": "canonicalizacion", "time_ms": "tiempo_ms"}

funcion rsa_modpow(base, exp, modulo) { retornar correo_rsa_potencia(base, exp, modulo) }
funcion mailer_parse_key(pem) { retornar correo_clave(pem) }
funcion mailer_message(m) { retornar correo_mensaje(m) }
funcion dkim_sign(mensaje, opciones) { retornar correo_dkim_firmar(mensaje, _mailer_opt(opciones)) }
funcion dkim_verify(mensaje, clave_publica) { retornar _mailer_tr(correo_dkim_verificar(mensaje, clave_publica), _MAILER_RES) }
funcion dkim_dns_record(clave) { retornar correo_dkim_registro(clave) }
funcion smtp_data(datos) { retornar correo_smtp_datos(datos) }
funcion smtp_replies(texto) { retornar _mailer_tr(correo_smtp_respuestas(texto), _MAILER_RES) }
funcion smtp_commands(cuenta, mensaje) { retornar correo_smtp_comandos(cuenta, mensaje) }
funcion mailer_send(cuenta, mensaje) { retornar _mailer_tr(correo_enviar(cuenta, mensaje), _MAILER_RES) }

funcion _mailer_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_MAILER_OPT[k] ?? k] = o[k] }
    retornar r
}

/// Message in English keys: from, to, cc, bcc, subject, text, html, attachments, headers.
funcion mailer_message_en(m) {
    sea t = {"from": "de", "to": "para", "bcc": "cco", "subject": "asunto", "text": "texto", "attachments": "adjuntos", "headers": "cabeceras", "reply_to": "responder_a", "name": "nombre", "email": "correo", "type": "tipo", "data": "datos", "date_ms": "fecha_ms"}
    retornar _mailer_tr(correo_mensaje(_mailer_tr(m, t)), _MAILER_RES)
}
/// account: server, port, user, password, auth, tls, name.
funcion mailer_send_en(account, message) {
    sea a = _mailer_tr(account, {"server": "servidor", "port": "puerto", "user": "usuario", "password": "clave", "name": "nombre"})
    sea m = {"datos": message["data"] ?? message["datos"], "de": message["from"] ?? message["de"], "destinatarios": message["recipients"] ?? message["destinatarios"]}
    retornar _mailer_tr(correo_enviar(a, m), _MAILER_RES)
}
