// stdlib/sysinfo.cfv — información del sistema: nombres en inglés del módulo "sistema".
// English names for the "sistema" module; both can be used together.

importar "sistema"

funcion _sysinfo_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_sysinfo_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _sysinfo_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _SYSINFO_RES = {"so": "os", "nombre": "name", "version": "version", "nucleo": "kernel", "arquitectura": "arch", "equipo": "hostname", "arranque_ms": "boot_ms", "activo_s": "uptime_s", "modelo": "model", "nucleos": "cores", "fisicos": "physical_cores", "carga": "load", "total": "total", "disponible": "available", "usada": "used", "libre": "free", "porcentaje": "percent", "cache": "cached", "swap_total": "swap_total", "swap_libre": "swap_free", "swap_usada": "swap_used", "dispositivo": "device", "montaje": "mount", "tipo": "fs_type", "recibidos": "bytes_recv", "enviados": "bytes_sent", "paquetes_recibidos": "packets_recv", "paquetes_enviados": "packets_sent", "errores_entrada": "errors_in", "errores_salida": "errors_out", "descartados_entrada": "drops_in", "descartados_salida": "drops_out", "estado": "status", "memoria": "memory", "virtual": "virtual_memory", "hilos": "threads", "usuario": "uid", "comando": "cmdline", "inicio_ms": "start_ms", "nombre_corto": "short_name", "sensor": "sensor", "etiqueta": "label", "actual": "current", "maxima": "high", "critica": "critical", "enchufado": "plugged", "segundos_restantes": "seconds_left"}

funcion system_command(cmd) { retornar sistema_comando(cmd) }
funcion system_info() { retornar _sysinfo_tr(sistema_info(), _SYSINFO_RES) }
funcion system_cpu() { retornar _sysinfo_tr(sistema_cpu(), _SYSINFO_RES) }
funcion system_cpu_usage(intervalo_ms) { retornar _sysinfo_tr(sistema_uso_cpu(intervalo_ms), _SYSINFO_RES) }
funcion system_memory() { retornar _sysinfo_tr(sistema_memoria(), _SYSINFO_RES) }
funcion system_disk_usage(ruta) { retornar _sysinfo_tr(sistema_espacio(ruta), _SYSINFO_RES) }
funcion system_disks(todas) { retornar _sysinfo_tr(sistema_discos(todas), _SYSINFO_RES) }
funcion system_networks() { retornar _sysinfo_tr(sistema_red(), _SYSINFO_RES) }
funcion system_process(pid) { retornar _sysinfo_tr(sistema_proceso(pid), _SYSINFO_RES) }
funcion system_processes() { retornar _sysinfo_tr(sistema_procesos(), _SYSINFO_RES) }
funcion system_pid() { retornar sistema_pid() }
funcion system_find_processes(texto) { retornar _sysinfo_tr(sistema_buscar_procesos(texto), _SYSINFO_RES) }
funcion system_temperatures() { retornar _sysinfo_tr(sistema_temperaturas(), _SYSINFO_RES) }
funcion system_battery() { retornar _sysinfo_tr(sistema_bateria(), _SYSINFO_RES) }
funcion system_summary() { retornar sistema_resumen() }
