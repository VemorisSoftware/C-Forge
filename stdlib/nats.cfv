// stdlib/nats.cfv — cliente de NATS: nombres en inglés del módulo "correo_rapido".
// English names for the "correo_rapido" module; both can be used together.


importar "correo_rapido"

funcion _nats_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_nats_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _nats_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _NATS_RES = {"asunto": "subject", "datos": "data", "responder": "reply", "cabeceras": "headers", "estado": "status", "servidor": "server"}
sea _NATS_OPT = {"name": "nombre", "user": "usuario", "password": "clave", "token": "token", "echo": "eco", "transport": "transporte", "queue": "cola", "max": "maximo"}

funcion nats_match(patron, asunto) { retornar correo_coincide(patron, asunto) }
funcion nats_headers(m, estado) { retornar correo_cabeceras(m, estado) }
funcion nats_parse_headers(t) { retornar _nats_tr(correo_leer_cabeceras(t), _NATS_RES) }
funcion nats_pub(asunto, datos, responder, cabeceras) { retornar correo_pub(asunto, datos, responder, cabeceras) }
funcion nats_connect(url, opciones) { retornar correo_conectar(url, _nats_opt(opciones)) }
funcion nats_publish(nc, asunto, datos, cabeceras, responder) { retornar correo_publicar(nc, asunto, datos, cabeceras, responder) }
funcion nats_subscribe(nc, asunto, opciones) { retornar correo_suscribir(nc, asunto, _nats_opt(opciones)) }
funcion nats_unsubscribe(nc, sid) { retornar correo_desuscribir(nc, sid) }
funcion nats_next(nc) { retornar _nats_tr(correo_siguiente(nc), _NATS_RES) }
funcion nats_respond(nc, mensaje, datos, cabeceras) { retornar correo_responder(nc, mensaje, datos, cabeceras) }
funcion nats_request(nc, asunto, datos, cabeceras) { retornar _nats_tr(correo_pedir(nc, asunto, datos, cabeceras), _NATS_RES) }
funcion nats_flush(nc) { retornar correo_vaciar(nc) }
funcion nats_close(nc) { retornar correo_cerrar(nc) }
funcion nats_memory(opciones) { retornar correo_memoria(_nats_opt(opciones)) }

funcion _nats_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_NATS_OPT[k] ?? k] = o[k] }
    retornar r
}
