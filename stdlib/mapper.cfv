// stdlib/mapper.cfv — mapeo de estructuras: nombres en inglés del módulo "calco".
// English names for the "calco" module; both can be used together.

importar "calco"

funcion mapper_get(origen, ruta) { retornar calco_obtener(origen, ruta) }
funcion mapper_set(destino, ruta, valor) { retornar calco_poner(destino, ruta, valor) }
funcion mapper_map(origen, reglas) { retornar calco_mapear(origen, reglas) }
funcion mapper_list(lista, reglas) { retornar calco_lista(lista, reglas) }
funcion mapper_pick(origen, rutas) { retornar calco_elegir(origen, rutas) }
funcion mapper_omit(origen, quitar) { retornar calco_omitir(origen, quitar) }
funcion mapper_flatten(mapa) { retornar calco_aplanar(mapa) }
funcion mapper_unflatten(mapa) { retornar calco_desaplanar(mapa) }
funcion mapper_merge(a, b) { retornar calco_mezclar(a, b) }
