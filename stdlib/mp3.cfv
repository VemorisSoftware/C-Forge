// stdlib/mp3.cfv — decodificador MP3: nombres en inglés del módulo "mezcla_mp3".
// English names for the "mezcla_mp3" module; both can be used together.

importar "mezcla_mp3"

funcion mp3_is_mp3(datos) { retornar mp3_es(datos) }

// Decode an MP3 (MPEG-1/2/2.5 layer III). Returns {"tasa": rate, "canales":
// channels, "c": [samples per channel]} like the "mixer" module. options:
// "no_trim" (keep encoder delay), "max_ms".
funcion mp3_decode(data, options) {
    sea o = options ?? {}
    sea op = {}
    si (tiene_clave(o, "no_trim")) { op["sin_recorte"] = o["no_trim"] }
    si (tiene_clave(o, "max_ms")) { op["max_ms"] = o["max_ms"] }
    retornar mp3_decodificar(data, op)
}
// Stream info: rate, channels, kbps, version, mode, frames, samples, duration_ms, gapless.
funcion mp3_metadata(data) {
    sea i = mp3_info(data)
    sea modos = {"estereo": "stereo", "estereo_conjunto": "joint_stereo", "doble_canal": "dual_channel", "mono": "mono"}
    retornar {"rate": i["tasa"], "channels": i["canales"], "kbps": i["kbps"], "version": i["version"], "mode": modos[i["modo"]], "frames": i["tramas"], "samples": i["muestras"], "duration_ms": i["duracion_ms"], "gapless": i["gapless"]}
}
