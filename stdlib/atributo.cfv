/// El runtime de JavaScript (texto).
funcion atributo_js() { retornar base64_decodificar(unir(_AT_JS_B64, "")) }

/// <script> con el runtime, para poner en la página.
funcion atributo_script() { retornar "<script>" + atributo_js() + "</script>" }

funcion _at_cabecera(sol, nombre) {
    sea c = sol["cabeceras"] ?? {}
    sea n = texto_minusculas(nombre)
    para k en claves(c) { si (texto_minusculas(k) == n) { retornar c[k] } }
    retornar nulo
}

/// ¿La petición viene del runtime (cabecera HX-Request)?
funcion atributo_es_peticion(sol) { retornar _at_cabecera(sol, "HX-Request") == "true" }

/// Datos de la petición: {"peticion", "impulsado", "objetivo", "disparador",
/// "nombre_disparador", "url_actual", "respuesta_prompt", "restaurar_historial"}.
funcion atributo_info(sol) {
    retornar {"peticion": _at_cabecera(sol, "HX-Request") == "true", "impulsado": _at_cabecera(sol, "HX-Boosted") == "true",
        "objetivo": _at_cabecera(sol, "HX-Target"), "disparador": _at_cabecera(sol, "HX-Trigger"), "nombre_disparador": _at_cabecera(sol, "HX-Trigger-Name"),
        "url_actual": _at_cabecera(sol, "HX-Current-URL"), "respuesta_prompt": _at_cabecera(sol, "HX-Prompt"),
        "restaurar_historial": _at_cabecera(sol, "HX-History-Restore-Request") == "true"}
}

funcion _at_disparo(v) {
    si (v == nulo) { retornar nulo }
    si (tipo(v) == "texto") { retornar v }
    si (tipo(v) == "lista") { retornar unir(v, ", ") }
    retornar json_texto(v)
}

sea _AT_RESP = {"disparar": "HX-Trigger", "disparar_despues_intercambio": "HX-Trigger-After-Swap", "disparar_despues_asentar": "HX-Trigger-After-Settle",
    "redirigir": "HX-Redirect", "reobjetivo": "HX-Retarget", "reintercambio": "HX-Reswap", "reseleccionar": "HX-Reselect", "empujar_url": "HX-Push-Url",
    "reemplazar_url": "HX-Replace-Url", "ubicacion": "HX-Location"}

/// Respuesta para el runtime: {"estado", "cuerpo", "cabeceras"}. opciones:
/// "disparar" (nombre, lista o mapa de eventos con datos),
/// "disparar_despues_intercambio", "disparar_despues_asentar", "redirigir",
/// "refrescar", "reobjetivo", "reintercambio", "reseleccionar",
/// "empujar_url", "reemplazar_url", "ubicacion", "estado".
funcion atributo_respuesta(cuerpo, opciones) {
    sea op = opciones ?? {}
    sea cab = {"Content-Type": "text/html; charset=utf-8", "Vary": "HX-Request"}
    para k en claves(op) {
        si (tiene_clave(_AT_RESP, k)) {
            sea v = op[k]
            si (k == "disparar" o texto_empieza_con(k, "disparar_")) { v = _at_disparo(v) }
            sino si (k == "ubicacion" y tipo(v) == "mapa") { v = json_texto(v) }
            sino si (v == verdadero) { v = "true" }
            sino si (v == falso) { v = "false" }
            si (v != nulo) { cab[_AT_RESP[k]] = _at_sin_saltos("" + v) }
        }
    }
    si ((op["refrescar"] ?? falso) == verdadero) { cab["HX-Refresh"] = "true" }
    sea estado = op["estado"] ?? 200
    retornar {"estado": estado, "cuerpo": cuerpo ?? "", "cabeceras": cab}
}

// Una cabecera nunca lleva saltos de línea (evita inyección de cabeceras).
funcion _at_sin_saltos(t) { retornar texto_reemplazar(texto_reemplazar(t, "\r", ""), "\n", " ") }

/// Escapa texto para HTML (contenido o atributo).
funcion atributo_escapar(t) {
    sea r = texto_reemplazar("" + t, "&", "&amp;")
    r = texto_reemplazar(r, "<", "&lt;")
    r = texto_reemplazar(r, ">", "&gt;")
    r = texto_reemplazar(r, caracter(34), "&quot;")
    retornar texto_reemplazar(r, "'", "&#39;")
}

sea _AT_NOMBRES = {"objetivo": "target", "intercambio": "swap", "disparador": "trigger", "incluir": "include", "valores": "vals", "cabeceras": "headers",
    "confirmar": "confirm", "preguntar": "prompt", "indicador": "indicator", "desactivar": "disabled-elt", "seleccionar": "select", "empujar_url": "push-url",
    "reemplazar_url": "replace-url", "impulsar": "boost", "sincronizar": "sync", "codificacion": "encoding", "intercambio_oob": "swap-oob"}

/// Atributos hx-* escapados a partir de un mapa con nombres en español o en
/// htmx: {"get": "/x", "objetivo": "#r", "intercambio": "outerHTML",
/// "valores": {"id": 3}, "en:click": "…"}.
funcion atributo_attrs(mapa) {
    sea r = []
    para k en claves(mapa) {
        sea v = mapa[k]
        sea n = _AT_NOMBRES[k] ?? k
        si (texto_empieza_con(n, "en:")) { n = "on:" + subtexto(n, 3, longitud(n)) }
        si (texto_empieza_con(n, "hx-") == falso) { n = "hx-" + n }
        si (tipo(v) == "mapa" o tipo(v) == "lista") { v = json_texto(v) }
        si (v == verdadero) { v = "true" }
        si (v == falso) { v = "false" }
        r.agregar(n + "=" + caracter(34) + atributo_escapar(v) + caracter(34))
    }
    retornar unir(r, " ")
}

/// Elemento HTML con atributos hx-* (los demás atributos van en "html").
/// El contenido se pone tal cual (ya debe ser HTML).
funcion atributo_elemento(etiqueta, attrs, contenido, html_attrs) {
    sea extra = ""
    si (html_attrs != nulo) {
        para k en claves(html_attrs) { extra = extra + " " + k + "=" + caracter(34) + atributo_escapar(html_attrs[k]) + caracter(34) }
    }
    sea hx = atributo_attrs(attrs ?? {})
    si (hx != "") { hx = " " + hx }
    retornar "<" + etiqueta + extra + hx + ">" + (contenido ?? "") + "</" + etiqueta + ">"
}

/// Trozo para cambiar otro elemento en la misma respuesta (fuera de banda).
/// modo: "true" (outerHTML), "innerHTML", "beforeend"…, o "modo:selector".
funcion atributo_oob(id, html, modo, etiqueta) {
    sea e = etiqueta ?? "div"
    retornar "<" + e + " id=" + caracter(34) + atributo_escapar(id) + caracter(34) + " hx-swap-oob=" + caracter(34) + atributo_escapar(modo ?? "true") + caracter(34) + ">" + html + "</" + e + ">"
}

sea _AT_ESTADOS = {"200": "OK", "201": "Created", "204": "No Content", "286": "Stop Polling", "301": "Moved Permanently", "302": "Found", "303": "See Other",
    "400": "Bad Request", "401": "Unauthorized", "403": "Forbidden", "404": "Not Found", "409": "Conflict", "422": "Unprocessable Content", "500": "Internal Server Error"}

/// La respuesta como texto HTTP/1.1 completo.
funcion atributo_http(r) {
    sea crlf = caracter(13) + caracter(10)
    sea e = r["estado"]
    sea t = "HTTP/1.1 " + e + " " + (_AT_ESTADOS["" + e] ?? "OK") + crlf
    para k en claves(r["cabeceras"]) { t = t + _at_sin_saltos(k) + ": " + _at_sin_saltos("" + r["cabeceras"][k]) + crlf }
    t = t + "Content-Length: " + longitud(r["cuerpo"]) + crlf + "Connection: close" + crlf + crlf
    retornar t + r["cuerpo"]
}

/// Responde una solicitud de "web" (web_solicitud) con todas las cabeceras.
funcion atributo_enviar(sol, r) {
    si (tiene_clave(sol, "_srv_id") == falso) { lanzar "atributo: la solicitud no viene de web_solicitud" }
    sea c = servidor_http_tomar_conexion(sol["_srv_id"])
    net_enviar(c, atributo_http(r))
    net_cerrar(c)
}
