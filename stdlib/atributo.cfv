// stdlib/atributo.cfv — interactividad por atributos HTML al estilo htmx:
// un runtime de JavaScript propio (≈17 KB, sin dependencias) que da vida a
// hx-get/post/put/patch/delete, hx-target (this, closest, find, next,
// previous), hx-swap (innerHTML, outerHTML, beforebegin, afterbegin,
// beforeend, afterend, delete, none, textContent), hx-trigger (eventos,
// load, every, revealed, delay, throttle, changed, once, from:, filtros),
// hx-include, hx-vals, hx-headers, hx-confirm, hx-prompt, hx-indicator,
// hx-disabled-elt, hx-select, hx-push-url, hx-boost, hx-on:*, intercambios
// fuera de banda (hx-swap-oob) y las cabeceras HX-* de respuesta. Del lado
// del servidor: leer las cabeceras de la petición, armar respuestas con
// HX-Trigger, HX-Redirect, HX-Retarget… y escribir atributos escapados.
// Idea de htmx (BSD-2), escrito desde cero. En inglés: importar "hypermedia".
//
//   importar "atributo"
//   sea pagina = "<head>" + atributo_script() + "</head>" +
//       "<button " + atributo_attrs({"post": "/contar", "objetivo": "#n"}) + ">+1</button><span id=n>0</span>"
//   // en el manejador de /contar:
//   si (atributo_es_peticion(sol)) { sea r = atributo_respuesta("1", {"disparar": "contado"}) }

