// stdlib/proj.cfv — Sistemas de coordenadas (estilo PROJ): nombres en inglés del módulo "proyeccion".
// English names for the "proyeccion" module; both can be used together.

importar "proyeccion"

funcion _proj_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_proj_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _proj_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _PROJ_RES = {"zona": "zone", "sur": "south", "epsg": "epsg", "distancia": "distance", "rumbo_1": "azimuth1", "rumbo_2": "azimuth2", "punto": "point", "rumbo": "azimuth"}

funcion proj_ellipsoid(nombre) { retornar proyeccion_elipsoide(nombre) }
funcion proj_geodetic_to_ecef(p, elipsoide) { retornar proyeccion_a_ecef(p, elipsoide) }
funcion proj_ecef_to_geodetic(p, elipsoide) { retornar proyeccion_desde_ecef(p, elipsoide) }
funcion proj_helmert(xyz, par) { retornar proyeccion_helmert(xyz, par) }
funcion proj_from_proj_string(texto) { retornar proyeccion_desde_proj(texto) }
funcion proj_crs(def) { retornar proyeccion_crs(def) }
funcion proj_transform(desde, hacia, p) { retornar proyeccion_transformar(desde, hacia, p) }
funcion proj_utm_zone(p) { retornar _proj_tr(proyeccion_zona_utm(p), _PROJ_RES) }
funcion proj_geod_inverse(p1, p2, elipsoide) { retornar _proj_tr(proyeccion_geodesica_inversa(p1, p2, elipsoide), _PROJ_RES) }
funcion proj_geod_direct(p, rumbo, distancia, elipsoide) { retornar _proj_tr(proyeccion_geodesica_directa(p, rumbo, distancia, elipsoide), _PROJ_RES) }
