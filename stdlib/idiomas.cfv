// stdlib/idiomas.cfv — internacionalización: textos por idioma con claves
// anidadas, variables, plurales, idioma de respaldo y formato de números.
// Inspirada en i18next (MIT). En inglés: importar "i18n".
//
//   importar "idiomas"
//   sea i = idiomas_nuevo({
//       "es": {"saludo": "Hola, {{nombre}}", "carrito": {"items_uno": "1 producto", "items_otro": "{{cuenta}} productos"}},
//       "en": {"saludo": "Hi, {{nombre}}", "carrito": {"items_one": "1 item", "items_other": "{{cuenta}} items"}}
//   }, "es", "en")
//   idiomas_t(i, "carrito.items", {"cuenta": 3})      // "3 productos"
//
// Plurales: sufijos _cero/_uno/_otro (o _zero/_one/_other) según "cuenta".
// Los valores no se interpretan como HTML: escápalos al ponerlos en una página.

funcion idiomas_nuevo(recursos, idioma, respaldo) {
    si (tiene_clave(recursos, idioma) == falso) { lanzar "idiomas: no hay textos para " + idioma }
    retornar {"recursos": recursos, "idioma": idioma, "respaldo": respaldo ?? idioma}
}

funcion idiomas_cambiar(i, idioma) {
    si (tiene_clave(i["recursos"], idioma) == falso) { lanzar "idiomas: no hay textos para " + idioma }
    i["idioma"] = idioma
    retornar i
}

funcion idiomas_actual(i) { retornar i["idioma"] }

/// Agrega o reemplaza textos de un idioma (se mezclan con los que había).
funcion idiomas_agregar(i, idioma, textos) {
    si (tiene_clave(i["recursos"], idioma) == falso) { i["recursos"][idioma] = {} }
    _id_mezclar(i["recursos"][idioma], textos)
    retornar i
}

funcion _id_mezclar(destino, origen) {
    para k en claves(origen) {
        sea v = origen[k]
        si (tipo(v) == "mapa" y tiene_clave(destino, k)) {
            si (tipo(destino[k]) == "mapa") { _id_mezclar(destino[k], v) } sino { destino[k] = v }
        } sino { destino[k] = v }
    }
}

funcion _id_buscar(textos, clave) {
    sea v = textos
    para parte en texto_dividir(clave, ".") {
        si (tipo(v) != "mapa") { retornar nulo }
        si (tiene_clave(v, parte) == falso) { retornar nulo }
        v = v[parte]
    }
    si (tipo(v) == "texto") { retornar v }
    retornar nulo
}

funcion _id_plural(textos, clave, cuenta) {
    sea sufijos = [["_otro", "_other"]]
    si (cuenta == 1) { sufijos = [["_uno", "_one"], ["_otro", "_other"]] }
    si (cuenta == 0) { sufijos = [["_cero", "_zero"], ["_otro", "_other"]] }
    para par en sufijos {
        para s en par {
            sea v = _id_buscar(textos, clave + s)
            si (v != nulo) { retornar v }
        }
    }
    retornar nulo
}

funcion _id_en(i, idioma, clave, vars) {
    si (tiene_clave(i["recursos"], idioma) == falso) { retornar nulo }
    sea textos = i["recursos"][idioma]
    si (vars != nulo) {
        si (tiene_clave(vars, "cuenta")) {
            sea p = _id_plural(textos, clave, vars["cuenta"])
            si (p != nulo) { retornar p }
        }
        si (tiene_clave(vars, "count")) {
            sea p = _id_plural(textos, clave, vars["count"])
            si (p != nulo) { retornar p }
        }
    }
    retornar _id_buscar(textos, clave)
}

funcion _id_rellenar(t, vars) {
    si (vars == nulo) { retornar t }
    sea r = t
    para k en claves(vars) {
        r = texto_reemplazar(r, "{{" + k + "}}", "" + vars[k])
        r = texto_reemplazar(r, "{{ " + k + " }}", "" + vars[k])
    }
    retornar r
}

/// Traduce "clave.anidada". Si falta en el idioma actual usa el de
/// respaldo; si falta en ambos devuelve la clave (se nota en pantalla).
funcion idiomas_t(i, clave, vars) {
    sea t = _id_en(i, i["idioma"], clave, vars)
    si (t == nulo) { t = _id_en(i, i["respaldo"], clave, vars) }
    si (t == nulo) { retornar clave }
    retornar _id_rellenar(t, vars)
}

funcion idiomas_existe(i, clave) {
    retornar _id_en(i, i["idioma"], clave, nulo) != nulo o _id_en(i, i["respaldo"], clave, nulo) != nulo
}

/// Número con separadores del idioma: es → 1.234.567,5 · en → 1,234,567.5
funcion idiomas_numero(i, n, decimales) {
    sea d = decimales ?? 0
    sea miles = "."
    sea coma = ","
    si (texto_empieza_con(i["idioma"], "en") o texto_empieza_con(i["idioma"], "zh") o texto_empieza_con(i["idioma"], "ja")) { miles = ","  coma = "." }
    sea negativo = n < 0
    sea escala = potencia(10, d)
    sea total = piso(absoluto(n) * escala + 0.5)
    sea entera = "" + cociente(total, escala)
    sea frac = ""
    si (d > 0) {
        frac = "" + (total % escala)
        mientras (longitud(frac) < d) { frac = "0" + frac }
    }
    sea grupos = []
    mientras (longitud(entera) > 3) {
        grupos.insertar(0, subcadena(entera, longitud(entera) - 3, longitud(entera)))
        entera = subcadena(entera, 0, longitud(entera) - 3)
    }
    grupos.insertar(0, entera)
    sea r = unir(grupos, miles)
    si (d > 0) { r = r + coma + frac }
    si (negativo y total > 0) { r = "-" + r }
    retornar r
}
