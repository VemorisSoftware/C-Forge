// stdlib/capstone.cfv — Ensamblador y desensamblador x86-64/ARM64 (estilo Capstone/Keystone): nombres en inglés del módulo "desarma".
// English names for the "desarma" module; both can be used together.

importar "desarma"

funcion _capstone_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_capstone_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _capstone_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _CAPSTONE_RES = {"direccion": "address", "mnemonico": "mnemonic", "operandos": "op_str", "texto": "text", "largo": "size"}

funcion cs_disasm_x86(codigo, direccion) { retornar _capstone_tr(desarma_x86(codigo, direccion), _CAPSTONE_RES) }
funcion cs_disasm_arm64(codigo, direccion) { retornar _capstone_tr(desarma_arm64(codigo, direccion), _CAPSTONE_RES) }
funcion cs_disasm(codigo, arquitectura, direccion) { retornar _capstone_tr(desarma(codigo, arquitectura, direccion), _CAPSTONE_RES) }
funcion cs_listing(codigo, arquitectura, direccion) { retornar desarma_listado(codigo, arquitectura, direccion) }
funcion ks_asm_x86(texto, direccion) { retornar ensambla_x86(texto, direccion) }
funcion ks_asm_arm64(texto, direccion) { retornar ensambla_arm64(texto, direccion) }
funcion ks_asm(texto, arquitectura, direccion) { retornar ensambla(texto, arquitectura, direccion) }
