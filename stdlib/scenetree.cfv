// stdlib/scenetree.cfv — árbol de escena con señales: nombres en inglés del módulo "nodos".
// English names for the "nodos" module; both can be used together.


importar "nodos"

funcion _scenetree_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_scenetree_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _scenetree_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _SCENETREE_RES = {"rotacion": "rotation", "escala": "scale"}
sea _SCENETREE_OPT = {"one_shot": "una_vez", "deferred": "diferida", "binds": "ligados", "physics_hz": "fisica_hz"}

funcion scene_class(nombre, def) { retornar nodos_clase(nombre, def) }
funcion scene_is(n, tipo_c) { retornar nodos_es(n, tipo_c) }
funcion scene_node(nombre, tipo_c, props) { retornar nodos_nuevo(nombre, tipo_c, props) }
funcion scene_tree(raiz, opciones) { retornar nodos_arbol(raiz, _scenetree_opt(opciones)) }
funcion scene_add_child(padre, hijo) { retornar nodos_agregar_hijo(padre, hijo) }
funcion scene_remove_child(padre, hijo) { retornar nodos_quitar_hijo(padre, hijo) }
funcion scene_queue_free(n) { retornar nodos_liberar(n) }
funcion scene_child(n, nombre) { retornar nodos_hijo(n, nombre) }
funcion scene_get_node(n, ruta) { retornar nodos_obtener(n, ruta) }
funcion scene_path(n) { retornar nodos_ruta(n) }
funcion scene_find(n, nombre) { retornar nodos_buscar(n, nombre) }
funcion scene_connect(emisor, senal, destino, opciones) { retornar nodos_conectar(emisor, senal, destino, _scenetree_opt(opciones)) }
funcion scene_disconnect(emisor, senal, destino) { retornar nodos_desconectar(emisor, senal, destino) }
funcion scene_is_connected(emisor, senal) { retornar nodos_conectado(emisor, senal) }
funcion scene_emit(n, senal, args) { retornar nodos_emitir(n, senal, args) }
funcion scene_call_deferred(n, destino, args) { retornar nodos_diferir(n, destino, args) }
funcion scene_add_to_group(n, g) { retornar nodos_agregar_grupo(n, g) }
funcion scene_remove_from_group(n, g) { retornar nodos_quitar_grupo(n, g) }
funcion scene_is_in_group(n, g) { retornar nodos_en_grupo(n, g) }
funcion scene_group(a, g) { retornar nodos_grupo(a, g) }
funcion scene_call_group(a, g, metodo, args) { retornar nodos_llamar_grupo(a, g, metodo, args) }
funcion scene_set_pause_mode(n, modo) { retornar nodos_modo_pausa(n, modo) }
funcion scene_pause(a, pausado) { retornar nodos_pausar(a, pausado) }
funcion scene_frame(a, delta) { retornar nodos_cuadro(a, delta) }
funcion scene_input(a, evento) { retornar nodos_entrada(a, evento) }
funcion scene_global_transform(n) { retornar _scenetree_tr(nodos_global(n), _SCENETREE_RES) }
funcion scene_timer(nombre, espera, una_vez, autoarranque) { retornar nodos_temporizador(nombre, espera, una_vez, autoarranque) }
funcion scene_timer_start(n) { retornar nodos_iniciar_temporizador(n) }
funcion scene_pack(n) { retornar nodos_empaquetar(n) }
funcion scene_instantiate(pq) { retornar nodos_instanciar(pq) }
funcion scene_count(n) { retornar nodos_contar(n) }
funcion scene_print(n) { retornar nodos_imprimir(n) }

funcion _scenetree_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_SCENETREE_OPT[k] ?? k] = o[k] }
    retornar r
}
