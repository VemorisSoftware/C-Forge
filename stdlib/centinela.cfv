// stdlib/centinela.cfv — detección de intrusos al estilo Suricata y
// Snort: lee capturas pcap (y pcapng), decodifica Ethernet, VLAN, IPv4,
// IPv6, TCP, UDP e ICMP, reensambla flujos TCP por dirección, y evalúa
// reglas con la sintaxis de Suricata (acción, protocolo, direcciones y
// puertos con variables, negaciones, rangos y listas, dirección -> y <>)
// con las opciones msg, sid, rev, classtype, content (con nocase, offset,
// depth, distance, within y bytes en |hex|), pcre básico, flow
// (to_server, to_client, established), flags TCP, dsize, itype/icode,
// ttl, threshold por origen y http.uri/http.method sobre peticiones HTTP.
// Devuelve alertas con su contexto. Idea de Suricata (GPL; solo la idea)
// y del formato de reglas. En inglés: importar "ids".
//
//   importar "centinela"
//   sea motor = centinela_motor(leer_archivo("reglas.rules"), {"HOME_NET": "192.168.0.0/16"})
//   para a en centinela_analizar(motor, leer_archivo("captura.pcap")) { mostrar(a["msg"] + " " + a["origen"]) }

funcion _ct_u16(t, p) { retornar byte_en(t, p) * 256 + byte_en(t, p + 1) }
funcion _ct_u32(t, p) { retornar _ct_u16(t, p) * 65536 + _ct_u16(t, p + 2) }
funcion _ct_le32(t, p) { retornar bytes_leer_entero(t, p, 4, 1) }
funcion _ct_le16(t, p) { retornar bytes_leer_entero(t, p, 2, 1) }

// ---------- pcap ----------

/// Paquetes de un pcap o pcapng: [{"t" (segundos), "datos", "enlace"}].
funcion centinela_pcap(datos) {
    sea mag = _ct_le32(datos, 0)
    si (mag == 168627466) { retornar _ct_pcapng(datos) }
    sea le = verdadero
    si (mag == 2712847316 o mag == 2712812621) { le = verdadero } sino si (mag == 3569595041 o mag == 1295823521) { le = falso } sino { lanzar "centinela: no es un archivo pcap" }
    sea nano = mag == 2712812621 o mag == 1295823521
    sea u32 = funcion(p) {
        si (le) { retornar _ct_le32(datos, p) }
        retornar _ct_u32(datos, p)
    }
    sea enlace = u32(20)
    sea r = []
    sea p = 24
    mientras (p + 16 <= longitud(datos)) {
        sea ts = u32(p)
        sea us = u32(p + 4)
        sea incl = u32(p + 8)
        sea div = 1000000
        si (nano) { div = 1000000000 }
        r.agregar({"t": ts + us / div, "datos": subcadena(datos, p + 16, p + 16 + incl), "enlace": enlace})
        p = p + 16 + incl
    }
    retornar r
}

funcion _ct_pcapng(datos) {
    sea r = []
    sea p = 0
    sea enlaces = []
    mientras (p + 12 <= longitud(datos)) {
        sea tipo_b = _ct_le32(datos, p)
        sea largo = _ct_le32(datos, p + 4)
        si (tipo_b == 1) { enlaces.agregar(_ct_le16(datos, p + 8)) }
        si (tipo_b == 6) {
            sea iface = _ct_le32(datos, p + 8)
            sea ts = _ct_le32(datos, p + 12) * 4294967296 + _ct_le32(datos, p + 16)
            sea cap = _ct_le32(datos, p + 20)
            r.agregar({"t": ts / 1000000, "datos": subcadena(datos, p + 28, p + 28 + cap), "enlace": enlaces[iface] ?? 1})
        }
        si (tipo_b == 3) {
            sea cap = _ct_le32(datos, p + 8)
            r.agregar({"t": 0, "datos": subcadena(datos, p + 12, p + 12 + cap), "enlace": enlaces[0] ?? 1})
        }
        si (largo < 12) { romper }
        p = p + largo
    }
    retornar r
}

/// Escribe un pcap (Ethernet) con paquetes [{"t", "datos"}].
funcion centinela_pcap_escribir(paquetes, enlace) {
    sea partes = [bytes_entero(2712847316, 4, 1) + bytes_entero(2, 2, 1) + bytes_entero(4, 2, 1) + bytes_entero(0, 8, 1) + bytes_entero(65535, 4, 1) + bytes_entero(enlace ?? 1, 4, 1)]
    para q en paquetes {
        sea t = q["t"] ?? 0
        partes.agregar(bytes_entero(piso(t), 4, 1) + bytes_entero(redondear((t - piso(t)) * 1000000), 4, 1) + bytes_entero(longitud(q["datos"]), 4, 1) + bytes_entero(longitud(q["datos"]), 4, 1) + q["datos"])
    }
    retornar unir(partes, "")
}

// ---------- decodificación ----------

funcion _ct_ip4(t, p) { retornar "" + byte_en(t, p) + "." + byte_en(t, p + 1) + "." + byte_en(t, p + 2) + "." + byte_en(t, p + 3) }

funcion _ct_hex4(v) {
    sea h = "0123456789abcdef"
    si (v == 0) { retornar "0" }
    sea r = ""
    sea x = v
    mientras (x > 0) {
        r = subcadena(h, x % 16, x % 16 + 1) + r
        x = piso(x / 16)
    }
    retornar r
}

funcion _ct_ip6(t, p) {
    sea g = []
    sea i = 0
    mientras (i < 8) {
        g.agregar(_ct_u16(t, p + i * 2))
        i = i + 1
    }
    sea mejor = -1
    sea largo = 1
    i = 0
    mientras (i < 8) {
        si (g[i] == 0) {
            sea j = i
            mientras (j < 8 y g[j] == 0) { j = j + 1 }
            si (j - i > largo) {
                mejor = i
                largo = j - i
            }
            i = j
        } sino { i = i + 1 }
    }
    sea r = []
    i = 0
    mientras (i < 8) {
        si (i == mejor) {
            si (i == 0) { r.agregar("") }
            r.agregar("")
            i = i + largo
            si (i == 8) { r.agregar("") }
        } sino {
            r.agregar(_ct_hex4(g[i]))
            i = i + 1
        }
    }
    retornar unir(r, ":")
}

/// Decodifica un paquete: {"proto" ("tcp"|"udp"|"icmp"|"ip"), "origen",
/// "destino", "puerto_origen", "puerto_destino", "ttl", "carga",
/// "flags" (texto como "SA"), "seq", "ack", "itype", "icode", "vlan"}.
funcion centinela_decodificar(datos, enlace) {
    sea p = 0
    sea et = 0
    sea vlan = nulo
    sea l = enlace ?? 1
    si (l == 1) {
        et = _ct_u16(datos, 12)
        p = 14
        mientras (et == 33024 o et == 34984) {
            vlan = _ct_u16(datos, p) % 4096
            et = _ct_u16(datos, p + 2)
            p = p + 4
        }
    } sino si (l == 101 o l == 228 o l == 229) {
        // IP crudo.
        si (piso(byte_en(datos, 0) / 16) == 6) { et = 34525 } sino { et = 2048 }
    } sino si (l == 113) {
        et = _ct_u16(datos, 14)
        p = 16
    } sino si (l == 0) {
        p = 4
        si (piso(byte_en(datos, 4) / 16) == 6) { et = 34525 } sino { et = 2048 }
    } sino { retornar nulo }
    sea r = {"proto": "otro", "origen": nulo, "destino": nulo, "puerto_origen": nulo, "puerto_destino": nulo, "ttl": nulo, "carga": "", "flags": "", "vlan": vlan, "tam": longitud(datos)}
    sea proto = nulo
    sea fin = longitud(datos)
    si (et == 2048) {
        sea ihl = (byte_en(datos, p) % 16) * 4
        sea total = _ct_u16(datos, p + 2)
        fin = minimo(fin, p + total)
        r["ttl"] = byte_en(datos, p + 8)
        proto = byte_en(datos, p + 9)
        r["origen"] = _ct_ip4(datos, p + 12)
        r["destino"] = _ct_ip4(datos, p + 16)
        r["fragmento"] = (_ct_u16(datos, p + 6) % 8192) != 0 o piso(_ct_u16(datos, p + 6) / 8192) % 2 == 1
        r["version"] = 4
        p = p + ihl
    } sino si (et == 34525) {
        sea plen = _ct_u16(datos, p + 4)
        fin = minimo(fin, p + 40 + plen)
        proto = byte_en(datos, p + 6)
        r["ttl"] = byte_en(datos, p + 7)
        r["origen"] = _ct_ip6(datos, p + 8)
        r["destino"] = _ct_ip6(datos, p + 24)
        r["version"] = 6
        p = p + 40
        // Cabeceras de extensión simples.
        mientras (proto == 0 o proto == 43 o proto == 60) {
            sea sig = byte_en(datos, p)
            p = p + (byte_en(datos, p + 1) + 1) * 8
            proto = sig
        }
    } sino si (et == 2054) {
        r["proto"] = "arp"
        retornar r
    } sino { retornar r }
    r["proto"] = "ip"
    r["protocolo_ip"] = proto
    si (proto == 6) {
        r["proto"] = "tcp"
        r["puerto_origen"] = _ct_u16(datos, p)
        r["puerto_destino"] = _ct_u16(datos, p + 2)
        r["seq"] = _ct_u32(datos, p + 4)
        r["ack"] = _ct_u32(datos, p + 8)
        sea off = piso(byte_en(datos, p + 12) / 16) * 4
        sea fl = byte_en(datos, p + 13)
        sea nombres = [[1, "F"], [2, "S"], [4, "R"], [8, "P"], [16, "A"], [32, "U"], [64, "E"], [128, "C"]]
        sea f = ""
        para nm en nombres { si (piso(fl / nm[0]) % 2 == 1) { f = f + nm[1] } }
        r["flags"] = f
        r["ventana"] = _ct_u16(datos, p + 14)
        r["carga"] = subcadena(datos, p + off, fin)
    } sino si (proto == 17) {
        r["proto"] = "udp"
        r["puerto_origen"] = _ct_u16(datos, p)
        r["puerto_destino"] = _ct_u16(datos, p + 2)
        r["carga"] = subcadena(datos, p + 8, fin)
    } sino si (proto == 1 o proto == 58) {
        r["proto"] = "icmp"
        r["itype"] = byte_en(datos, p)
        r["icode"] = byte_en(datos, p + 1)
        r["carga"] = subcadena(datos, p + 8, fin)
    } sino { r["carga"] = subcadena(datos, p, fin) }
    retornar r
}

// ---------- direcciones ----------

funcion _ct_ip_num(ip) {
    sea p = texto_dividir(ip, ".")
    si (longitud(p) != 4) { retornar nulo }
    retornar a_numero(p[0]) * 16777216 + a_numero(p[1]) * 65536 + a_numero(p[2]) * 256 + a_numero(p[3])
}

// ¿La IP está en la especificación? (any, IP, CIDR, [lista], !negación, $VAR).
funcion _ct_en_red(spec, ip, vars) {
    sea s = texto_recortar(spec)
    si (s == "any") { retornar verdadero }
    si (texto_empieza_con(s, "!")) { retornar _ct_en_red(subcadena(s, 1, longitud(s)), ip, vars) == falso }
    si (texto_empieza_con(s, "$")) {
        sea v = vars[subcadena(s, 1, longitud(s))] ?? nulo
        si (v == nulo) { lanzar "centinela: variable no definida " + s }
        retornar _ct_en_red(v, ip, vars)
    }
    si (texto_empieza_con(s, "[")) {
        sea dentro = subcadena(s, 1, longitud(s) - 1)
        // Las negaciones dentro de la lista restan.
        sea alguno = falso
        sea hay_pos = falso
        para parte en _ct_partir_lista(dentro) {
            si (texto_empieza_con(texto_recortar(parte), "!")) {
                si (_ct_en_red(subcadena(texto_recortar(parte), 1, longitud(texto_recortar(parte))), ip, vars)) { retornar falso }
            } sino {
                hay_pos = verdadero
                si (_ct_en_red(parte, ip, vars)) { alguno = verdadero }
            }
        }
        retornar alguno o hay_pos == falso
    }
    si (ip == nulo) { retornar falso }
    si (texto_indice(s, "/") > 0) {
        sea base = texto_dividir(s, "/")[0]
        sea bits = a_numero(texto_dividir(s, "/")[1])
        sea a = _ct_ip_num(base)
        sea b = _ct_ip_num(ip)
        si (a == nulo o b == nulo) { retornar falso }
        sea div = potencia(2, 32 - bits)
        retornar piso(a / div) == piso(b / div)
    }
    retornar s == ip
}

funcion _ct_partir_lista(t) {
    sea r = []
    sea prof = 0
    sea actual = ""
    sea i = 0
    mientras (i < longitud(t)) {
        sea c = subcadena(t, i, i + 1)
        si (c == "[") { prof = prof + 1 }
        si (c == "]") { prof = prof - 1 }
        si (c == "," y prof == 0) {
            r.agregar(actual)
            actual = ""
        } sino { actual = actual + c }
        i = i + 1
    }
    si (actual != "") { r.agregar(actual) }
    retornar r
}

funcion _ct_en_puertos(spec, puerto, vars) {
    sea s = texto_recortar(spec)
    si (s == "any") { retornar verdadero }
    si (puerto == nulo) { retornar falso }
    si (texto_empieza_con(s, "!")) { retornar _ct_en_puertos(subcadena(s, 1, longitud(s)), puerto, vars) == falso }
    si (texto_empieza_con(s, "$")) { retornar _ct_en_puertos(vars[subcadena(s, 1, longitud(s))] ?? "any", puerto, vars) }
    si (texto_empieza_con(s, "[")) {
        sea alguno = falso
        sea hay_pos = falso
        para parte en _ct_partir_lista(subcadena(s, 1, longitud(s) - 1)) {
            sea pt = texto_recortar(parte)
            si (texto_empieza_con(pt, "!")) { si (_ct_en_puertos(subcadena(pt, 1, longitud(pt)), puerto, vars)) { retornar falso } } sino {
                hay_pos = verdadero
                si (_ct_en_puertos(pt, puerto, vars)) { alguno = verdadero }
            }
        }
        retornar alguno o hay_pos == falso
    }
    si (texto_indice(s, ":") >= 0) {
        sea a = texto_dividir(s, ":")
        sea mn = 0
        sea mx = 65535
        si (a[0] != "") { mn = a_numero(a[0]) }
        si (a[1] != "") { mx = a_numero(a[1]) }
        retornar puerto >= mn y puerto <= mx
    }
    retornar a_numero(s) == puerto
}

// ---------- reglas ----------

// Texto de content con |hex| y escapes a bytes.
funcion _ct_contenido(t) {
    sea r = []
    sea i = 0
    sea hex = falso
    mientras (i < longitud(t)) {
        sea c = subcadena(t, i, i + 1)
        si (c == "|") {
            hex = no hex
            i = i + 1
        } sino si (hex) {
            si (c == " ") { i = i + 1 } sino {
                sea h = texto_minusculas(subcadena(t, i, i + 2))
                r.agregar(bytes_entero(texto_indice("0123456789abcdef", subcadena(h, 0, 1)) * 16 + texto_indice("0123456789abcdef", subcadena(h, 1, 2)), 1, 0))
                i = i + 2
            }
        } sino si (c == "\\" y i + 1 < longitud(t)) {
            r.agregar(subcadena(t, i + 1, i + 2))
            i = i + 2
        } sino {
            r.agregar(c)
            i = i + 1
        }
    }
    retornar unir(r, "")
}

// Divide las opciones "a; b:c; d:"x;y";" respetando comillas.
funcion _ct_opciones(t) {
    sea r = []
    sea actual = ""
    sea comillas = falso
    sea i = 0
    mientras (i < longitud(t)) {
        sea c = subcadena(t, i, i + 1)
        si (c == "\\" y i + 1 < longitud(t)) {
            actual = actual + subcadena(t, i, i + 2)
            i = i + 2
        } sino {
            si (c == "\"") { comillas = no comillas }
            si (c == ";" y comillas == falso) {
                si (texto_recortar(actual) != "") { r.agregar(texto_recortar(actual)) }
                actual = ""
            } sino { actual = actual + c }
            i = i + 1
        }
    }
    si (texto_recortar(actual) != "") { r.agregar(texto_recortar(actual)) }
    sea out = []
    para o en r {
        sea k = texto_indice(o, ":")
        si (k < 0) { out.agregar([texto_recortar(o), nulo]) } sino {
            sea v = texto_recortar(subcadena(o, k + 1, longitud(o)))
            si (texto_empieza_con(v, "\"") y texto_termina_con(v, "\"") y longitud(v) >= 2) { v = subcadena(v, 1, longitud(v) - 1) }
            out.agregar([texto_recortar(subcadena(o, 0, k)), v])
        }
    }
    retornar out
}

/// Lee una regla. Devuelve {"accion", "proto", "origen", "puerto_origen",
/// "dir", "destino", "puerto_destino", "msg", "sid", ...}.
funcion centinela_regla(linea) {
    sea l = texto_recortar(linea)
    sea a = texto_indice(l, "(")
    sea cab = texto_recortar(subcadena(l, 0, a))
    sea cuerpo = subcadena(l, a + 1, longitud(l))
    si (texto_termina_con(texto_recortar(cuerpo), ")")) { cuerpo = subcadena(texto_recortar(cuerpo), 0, longitud(texto_recortar(cuerpo)) - 1) }
    // Cabecera: acción proto origen puertos dir destino puertos (las listas pueden llevar espacios).
    sea tk = []
    sea actual = ""
    sea prof = 0
    sea i = 0
    mientras (i < longitud(cab)) {
        sea c = subcadena(cab, i, i + 1)
        si (c == "[") { prof = prof + 1 }
        si (c == "]") { prof = prof - 1 }
        si (c == " " y prof == 0) {
            si (actual != "") { tk.agregar(actual) }
            actual = ""
        } sino { actual = actual + c }
        i = i + 1
    }
    si (actual != "") { tk.agregar(actual) }
    si (longitud(tk) != 7) { lanzar "centinela: cabecera de regla inválida: " + cab }
    sea r = {"accion": tk[0], "proto": texto_minusculas(tk[1]), "origen": tk[2], "puerto_origen": tk[3], "dir": tk[4], "destino": tk[5], "puerto_destino": tk[6], "contenidos": [], "msg": "", "sid": 0, "rev": 1, "flow": [], "texto": l}
    sea ultimo = nulo
    sea buffer = "carga"
    para op en _ct_opciones(cuerpo) {
        sea k = op[0]
        sea v = op[1]
        si (k == "msg") { r["msg"] = v }
        sino si (k == "sid") { r["sid"] = a_numero(v) }
        sino si (k == "rev") { r["rev"] = a_numero(v) }
        sino si (k == "classtype") { r["clase"] = v }
        sino si (k == "priority") { r["prioridad"] = a_numero(v) }
        sino si (k == "reference") { r["referencia"] = v }
        sino si (k == "http.uri" o k == "http_uri" o k == "http.method" o k == "http_method" o k == "http.host" o k == "http.user_agent" o k == "http.header" o k == "pkt_data") {
            // Modificadores de buffer: los siguientes content se buscan ahí.
            buffer = texto_reemplazar(k, "_", ".")
            si (k == "pkt_data") { buffer = "carga" }
            si (ultimo != nulo y (k == "http_uri" o k == "http_method")) { ultimo["buffer"] = buffer }
        } sino si (k == "content") {
            sea neg = texto_empieza_con(v, "!")
            sea txt = v
            si (neg) { txt = subcadena(v, 2, longitud(v) - 1) }
            ultimo = {"bytes": _ct_contenido(txt), "nocase": falso, "offset": nulo, "depth": nulo, "distance": nulo, "within": nulo, "negado": neg, "buffer": buffer}
            r["contenidos"].agregar(ultimo)
        } sino si (k == "nocase") { ultimo["nocase"] = verdadero }
        sino si (k == "offset" o k == "depth" o k == "distance" o k == "within") { ultimo[k] = a_numero(v) }
        sino si (k == "pcre") { r["pcre"] = v }
        sino si (k == "flow") { para x en texto_dividir(v, ",") { r["flow"].agregar(texto_recortar(x)) } }
        sino si (k == "flags") { r["flags"] = v }
        sino si (k == "dsize") { r["dsize"] = v }
        sino si (k == "itype") { r["itype"] = v }
        sino si (k == "icode") { r["icode"] = v }
        sino si (k == "ttl") { r["ttl"] = v }
        sino si (k == "threshold") {
            sea th = {}
            para x en texto_dividir(v, ",") {
                sea kv = texto_dividir(texto_recortar(x), " ")
                th[kv[0]] = kv[1]
            }
            r["umbral"] = th
        }
    }
    retornar r
}

/// Motor con un archivo de reglas y variables (HOME_NET, EXTERNAL_NET,
/// HTTP_PORTS...).
funcion centinela_motor(reglas_texto, variables) {
    sea vars = {"HOME_NET": "any", "EXTERNAL_NET": "any", "HTTP_PORTS": "[80,8080]"}
    para k en claves(variables ?? {}) { vars[k] = variables[k] }
    sea reglas = []
    para linea en texto_dividir(reglas_texto, "\n") {
        sea l = texto_recortar(linea)
        si (l != "" y texto_empieza_con(l, "#") == falso) { reglas.agregar(centinela_regla(l)) }
    }
    retornar {"reglas": reglas, "vars": vars, "flujos": {}, "umbrales": {}}
}

// ---------- coincidencias ----------

funcion _ct_buscar(hay, aguja, desde, nocase) {
    si (nocase) { retornar _ct_indice(texto_minusculas(hay), texto_minusculas(aguja), desde) }
    retornar _ct_indice(hay, aguja, desde)
}

funcion _ct_indice(t, a, desde) {
    si (desde > longitud(t)) { retornar -1 }
    sea i = texto_indice(subcadena(t, desde, longitud(t)), a)
    si (i < 0) { retornar -1 }
    retornar desde + i
}

// Evalúa los content en orden (con posiciones relativas).
funcion _ct_contenidos(r, buffers) {
    sea fin_prev = {}
    para c en r["contenidos"] {
        sea buf = buffers[c["buffer"]] ?? nulo
        si (buf == nulo) { retornar falso }
        sea ini = 0
        sea lim = longitud(buf)
        sea prev = fin_prev[c["buffer"]] ?? nulo
        si (c["offset"] != nulo) { ini = c["offset"] }
        si (c["depth"] != nulo) { lim = minimo(lim, ini + c["depth"]) }
        si (c["distance"] != nulo y prev != nulo) { ini = prev + c["distance"] }
        si (c["within"] != nulo y prev != nulo) { lim = minimo(longitud(buf), prev + maximo(0, c["distance"] ?? 0) + c["within"]) }
        si (ini < 0) { ini = 0 }
        sea pos = _ct_buscar(subcadena(buf, 0, lim), c["bytes"], ini, c["nocase"])
        si (c["negado"]) {
            si (pos >= 0) { retornar falso }
        } sino {
            si (pos < 0) { retornar falso }
            fin_prev[c["buffer"]] = pos + longitud(c["bytes"])
        }
    }
    retornar verdadero
}

funcion _ct_comparar_num(spec, v) {
    si (v == nulo) { retornar falso }
    sea s = texto_recortar(spec)
    si (texto_indice(s, "<>") > 0) {
        sea a = texto_dividir(s, "<>")
        retornar v > a_numero(a[0]) y v < a_numero(a[1])
    }
    si (texto_empieza_con(s, ">=")) { retornar v >= a_numero(subcadena(s, 2, longitud(s))) }
    si (texto_empieza_con(s, "<=")) { retornar v <= a_numero(subcadena(s, 2, longitud(s))) }
    si (texto_empieza_con(s, ">")) { retornar v > a_numero(subcadena(s, 1, longitud(s))) }
    si (texto_empieza_con(s, "<")) { retornar v < a_numero(subcadena(s, 1, longitud(s))) }
    retornar v == a_numero(s)
}

funcion _ct_flags(spec, f) {
    // "S" exactamente, "S+" incluye, "!R" no incluye, "*SA" alguno; ",12" ignora CE.
    sea s = texto_dividir(spec, ",")[0]
    sea quitar = ""
    si (longitud(texto_dividir(spec, ",")) > 1) { quitar = texto_dividir(spec, ",")[1] }
    sea ff = f
    para c en ["C", "E"] { si (texto_indice(quitar, "1") >= 0 o texto_indice(quitar, "2") >= 0 o texto_indice(quitar, c) >= 0) { ff = texto_reemplazar(ff, c, "") } }
    si (texto_empieza_con(s, "!")) {
        para c en texto_dividir(subcadena(s, 1, longitud(s)), "") { si (texto_indice(ff, c) >= 0) { retornar falso } }
        retornar verdadero
    }
    si (texto_empieza_con(s, "*")) {
        para c en texto_dividir(subcadena(s, 1, longitud(s)), "") { si (texto_indice(ff, c) >= 0) { retornar verdadero } }
        retornar falso
    }
    si (texto_termina_con(s, "+")) {
        para c en texto_dividir(subcadena(s, 0, longitud(s) - 1), "") { si (texto_indice(ff, c) < 0) { retornar falso } }
        retornar verdadero
    }
    si (longitud(ff) != longitud(s)) { retornar falso }
    para c en texto_dividir(s, "") { si (texto_indice(ff, c) < 0) { retornar falso } }
    retornar verdadero
}

// pcre básico: /texto/i con ^ y $ y alternativas (sin metacaracteres complejos).
funcion _ct_pcre(spec, t) {
    sea fin = longitud(spec) - 1
    mientras (fin > 0 y subcadena(spec, fin, fin + 1) != "/") { fin = fin - 1 }
    sea patron = subcadena(spec, 1, fin)
    sea mods = subcadena(spec, fin + 1, longitud(spec))
    sea hay = t
    si (texto_indice(mods, "i") >= 0) {
        patron = texto_minusculas(patron)
        hay = texto_minusculas(t)
    }
    para alt en texto_dividir(patron, "|") {
        sea p = alt
        sea ini = texto_empieza_con(p, "^")
        sea fin_a = texto_termina_con(p, "$")
        si (ini) { p = subcadena(p, 1, longitud(p)) }
        si (fin_a) { p = subcadena(p, 0, longitud(p) - 1) }
        p = texto_reemplazar(p, "\\/", "/")
        p = texto_reemplazar(p, "\\.", ".")
        si (ini y fin_a) { si (hay == p) { retornar verdadero } }
        sino si (ini) { si (texto_empieza_con(hay, p)) { retornar verdadero } }
        sino si (fin_a) { si (texto_termina_con(hay, p)) { retornar verdadero } }
        sino si (texto_indice(hay, p) >= 0) { retornar verdadero }
    }
    retornar falso
}

// Buffers HTTP de una petición (si la carga lo parece).
funcion _ct_http(carga) {
    sea b = {"carga": carga}
    sea ln = texto_indice(carga, "\r\n")
    si (ln < 0) { retornar b }
    sea primera = texto_dividir(subcadena(carga, 0, ln), " ")
    si (longitud(primera) >= 3 y texto_empieza_con(primera[2], "HTTP/")) {
        b["http.method"] = primera[0]
        b["http.uri"] = primera[1]
        sea fin_cab = texto_indice(carga, "\r\n\r\n")
        si (fin_cab < 0) { fin_cab = longitud(carga) }
        sea cabs = subcadena(carga, ln + 2, fin_cab)
        b["http.header"] = cabs
        para l en texto_dividir(cabs, "\r\n") {
            sea k = texto_indice(l, ":")
            si (k > 0) {
                sea nombre = texto_minusculas(subcadena(l, 0, k))
                sea v = texto_recortar(subcadena(l, k + 1, longitud(l)))
                si (nombre == "host") { b["http.host"] = v }
                si (nombre == "user-agent") { b["http.user.agent"] = v }
            }
        }
    }
    retornar b
}

funcion _ct_clave_flujo(q) {
    sea a = q["origen"] + ":" + q["puerto_origen"]
    sea b = q["destino"] + ":" + q["puerto_destino"]
    si (a < b) { retornar [a + "|" + b, verdadero] }
    retornar [b + "|" + a, falso]
}

// Estado de flujo TCP: quién inició y si terminó el apretón de manos.
funcion _ct_flujo(motor, q) {
    si (q["proto"] != "tcp" y q["proto"] != "udp") { retornar nulo }
    sea kf = _ct_clave_flujo(q)
    sea f = motor["flujos"][kf[0]] ?? nulo
    si (f == nulo) {
        // El cliente es quien manda el primer SYN (o el primer paquete).
        sea cliente = q["origen"] + ":" + q["puerto_origen"]
        si (q["flags"] == "SA") { cliente = q["destino"] + ":" + q["puerto_destino"] }
        f = {"cliente": cliente, "syn": falso, "synack": falso, "establecido": q["proto"] == "udp", "paquetes": 0}
        motor["flujos"][kf[0]] = f
    }
    f["paquetes"] = f["paquetes"] + 1
    sea fl = q["flags"]
    si (fl == "S") { f["syn"] = verdadero }
    si (fl == "SA") { f["synack"] = verdadero }
    si (f["syn"] y f["synack"] y texto_indice(fl, "A") >= 0 y texto_indice(fl, "S") < 0) { f["establecido"] = verdadero }
    // Sin apretón visible (captura a mitad): se da por establecido con datos.
    si (f["syn"] == falso y longitud(q["carga"]) > 0) { f["establecido"] = verdadero }
    sea al_servidor = (q["origen"] + ":" + q["puerto_origen"]) == f["cliente"]
    retornar {"al_servidor": al_servidor, "establecido": f["establecido"]}
}

funcion _ct_proto_ok(rp, q) {
    si (rp == "ip") { retornar q["proto"] != "arp" y q["proto"] != "otro" }
    si (rp == "http") { retornar q["proto"] == "tcp" }
    si (rp == "dns") { retornar q["proto"] == "udp" o q["proto"] == "tcp" }
    retornar rp == q["proto"]
}

funcion _ct_coincide(motor, r, q, fl, http) {
    si (_ct_proto_ok(r["proto"], q) == falso) { retornar falso }
    sea v = motor["vars"]
    sea directo = _ct_en_red(r["origen"], q["origen"], v) y _ct_en_puertos(r["puerto_origen"], q["puerto_origen"], v) y _ct_en_red(r["destino"], q["destino"], v) y _ct_en_puertos(r["puerto_destino"], q["puerto_destino"], v)
    si (directo == falso) {
        si (r["dir"] != "<>") { retornar falso }
        sea inverso = _ct_en_red(r["origen"], q["destino"], v) y _ct_en_puertos(r["puerto_origen"], q["puerto_destino"], v) y _ct_en_red(r["destino"], q["origen"], v) y _ct_en_puertos(r["puerto_destino"], q["puerto_origen"], v)
        si (inverso == falso) { retornar falso }
    }
    para f en r["flow"] {
        si (fl == nulo) { retornar falso }
        si ((f == "to_server" o f == "from_client") y fl["al_servidor"] == falso) { retornar falso }
        si ((f == "to_client" o f == "from_server") y fl["al_servidor"]) { retornar falso }
        si (f == "established" y fl["establecido"] == falso) { retornar falso }
        si (f == "not_established" y fl["establecido"]) { retornar falso }
    }
    si ((r["flags"] ?? nulo) != nulo y (q["proto"] != "tcp" o _ct_flags(r["flags"], q["flags"]) == falso)) { retornar falso }
    si ((r["dsize"] ?? nulo) != nulo y _ct_comparar_num(r["dsize"], longitud(q["carga"])) == falso) { retornar falso }
    si ((r["ttl"] ?? nulo) != nulo y _ct_comparar_num(r["ttl"], q["ttl"]) == falso) { retornar falso }
    si ((r["itype"] ?? nulo) != nulo y _ct_comparar_num(r["itype"], q["itype"] ?? nulo) == falso) { retornar falso }
    si ((r["icode"] ?? nulo) != nulo y _ct_comparar_num(r["icode"], q["icode"] ?? nulo) == falso) { retornar falso }
    si (longitud(r["contenidos"]) > 0 y _ct_contenidos(r, http) == falso) { retornar falso }
    si ((r["pcre"] ?? nulo) != nulo y _ct_pcre(r["pcre"], http["http.uri"] ?? q["carga"]) == falso) { retornar falso }
    retornar verdadero
}

funcion _ct_umbral(motor, r, q, t) {
    sea th = r["umbral"] ?? nulo
    si (th == nulo) { retornar verdadero }
    sea quien = q["origen"]
    si ((th["track"] ?? "by_src") == "by_dst") { quien = q["destino"] }
    sea k = "" + r["sid"] + "|" + quien
    sea est = motor["umbrales"][k] ?? {"inicio": t, "n": 0, "alertado": falso}
    sea segundos = a_numero(th["seconds"] ?? "60")
    si (t - est["inicio"] > segundos) { est = {"inicio": t, "n": 0, "alertado": falso} }
    est["n"] = est["n"] + 1
    motor["umbrales"][k] = est
    sea cuenta = a_numero(th["count"] ?? "1")
    sea tipo_u = th["type"] ?? "limit"
    si (tipo_u == "limit") { retornar est["n"] <= cuenta }
    si (tipo_u == "threshold") { retornar est["n"] % cuenta == 0 }
    // both: una alerta al llegar a count en la ventana.
    si (est["n"] >= cuenta y est["alertado"] == falso) {
        est["alertado"] = verdadero
        retornar verdadero
    }
    retornar falso
}

/// Evalúa un paquete decodificado; devuelve las alertas.
funcion centinela_evaluar(motor, q, t) {
    si (q == nulo o q["origen"] == nulo) { retornar [] }
    sea fl = _ct_flujo(motor, q)
    sea http = _ct_http(q["carga"])
    sea r = []
    para regla en motor["reglas"] {
        si (_ct_coincide(motor, regla, q, fl, http) y _ct_umbral(motor, regla, q, t ?? 0)) {
            r.agregar({"sid": regla["sid"], "rev": regla["rev"], "msg": regla["msg"], "accion": regla["accion"], "clase": regla["clase"] ?? nulo, "prioridad": regla["prioridad"] ?? 3,
                "proto": q["proto"], "origen": q["origen"], "puerto_origen": q["puerto_origen"], "destino": q["destino"], "puerto_destino": q["puerto_destino"], "t": t ?? 0})
        }
    }
    retornar r
}

/// Analiza una captura entera. Devuelve las alertas en orden.
funcion centinela_analizar(motor, pcap) {
    sea r = []
    para pk en centinela_pcap(pcap) {
        sea q = centinela_decodificar(pk["datos"], pk["enlace"])
        para a en centinela_evaluar(motor, q, pk["t"]) { r.agregar(a) }
    }
    retornar r
}

/// Resumen de alertas por sid: [{"sid", "msg", "veces"}] (más frecuentes primero).
funcion centinela_resumen(alertas) {
    sea m = {}
    para a en alertas {
        sea k = "" + a["sid"]
        si (tiene_clave(m, k) == falso) { m[k] = {"sid": a["sid"], "msg": a["msg"], "veces": 0} }
        m[k]["veces"] = m[k]["veces"] + 1
    }
    sea l = []
    para k en claves(m) { l.agregar(m[k]) }
    retornar ordenar(l, funcion(x, y) { retornar y["veces"] - x["veces"] })
}

/// Alerta en formato fast.log de Suricata.
funcion centinela_fast(a) {
    sea o = a["origen"]
    si (a["puerto_origen"] != nulo) { o = o + ":" + a["puerto_origen"] }
    sea d = a["destino"]
    si (a["puerto_destino"] != nulo) { d = d + ":" + a["puerto_destino"] }
    retornar "[**] [1:" + a["sid"] + ":" + a["rev"] + "] " + a["msg"] + " [**] [Classification: " + (a["clase"] ?? "") + "] [Priority: " + a["prioridad"] + "] {" + texto_mayusculas(a["proto"]) + "} " + o + " -> " + d
}
