// stdlib/browser.cfv — automatizar Chrome por CDP: nombres en inglés del módulo "piloto".
// English names for the "piloto" module; both can be used together.


importar "piloto"

funcion _browser_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_browser_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _browser_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _BROWSER_RES = {"tipo": "type", "texto": "text"}
sea _BROWSER_OPT = {"transport": "transporte", "executable": "ejecutable", "headful": "con_ventana", "args": "args", "width": "ancho", "height": "alto", "timeout_ms": "tiempo_ms", "full_page": "completa", "selector": "selector", "landscape": "horizontal", "print_background": "fondo", "scale": "escala"}

funcion browser_connect(ws_url, opciones) { retornar piloto_conectar(ws_url, _browser_opt(opciones)) }
funcion browser_cdp(nav, metodo, params, sesion) { retornar piloto_cdp(nav, metodo, params, sesion) }
funcion browser_launch(opciones) { retornar piloto_lanzar(_browser_opt(opciones)) }
funcion browser_version(nav) { retornar piloto_version(nav) }
funcion browser_close(nav) { retornar piloto_cerrar_navegador(nav) }
funcion browser_new_page(nav) { retornar piloto_pagina(nav) }
funcion page_wait_event(p, metodo, filtro) { retornar piloto_esperar_evento(p, metodo, filtro) }
funcion page_goto(p, url) { retornar piloto_ir(p, url) }
funcion page_set_content(p, html) { retornar piloto_html(p, html) }
funcion page_evaluate(p, expresion) { retornar piloto_evaluar(p, expresion) }
funcion page_title(p) { retornar piloto_titulo(p) }
funcion page_url(p) { retornar piloto_url(p) }
funcion page_content(p) { retornar piloto_contenido(p) }
funcion page_inner_text(p, selector) { retornar piloto_texto(p, selector) }
funcion page_get_attribute(p, selector, nombre) { retornar piloto_atributo(p, selector, nombre) }
funcion page_count(p, selector) { retornar piloto_contar(p, selector) }
funcion page_all_inner_texts(p, selector) { retornar piloto_textos(p, selector) }
funcion page_wait_for_function(p, expresion, espera_ms) { retornar piloto_esperar_funcion(p, expresion, espera_ms) }
funcion page_wait_for_selector(p, selector, espera_ms) { retornar piloto_esperar_selector(p, selector, espera_ms) }
funcion page_click(p, selector) { retornar piloto_clic(p, selector) }
funcion page_type(p, selector, texto) { retornar piloto_escribir(p, selector, texto) }
funcion page_fill(p, selector, texto) { retornar piloto_llenar(p, selector, texto) }
funcion page_press(p, tecla) { retornar piloto_tecla(p, tecla) }
funcion page_screenshot(p, opciones) { retornar piloto_captura(p, _browser_opt(opciones)) }
funcion page_pdf(p, opciones) { retornar piloto_pdf(p, _browser_opt(opciones)) }
funcion page_set_viewport(p, ancho, alto) { retornar piloto_tamano(p, ancho, alto) }
funcion page_cookies(p) { retornar piloto_cookies(p) }
funcion page_set_cookie(p, nombre, valor, url) { retornar piloto_fijar_cookie(p, nombre, valor, url) }
funcion page_console(p) { retornar _browser_tr(piloto_consola(p), _BROWSER_RES) }
funcion page_errors(p) { retornar piloto_errores(p) }
funcion page_route(p, patron, manejador) { retornar piloto_ruta(p, patron, manejador) }
funcion page_process(p) { retornar piloto_atender(p) }
funcion page_close(p) { retornar piloto_cerrar(p) }
funcion browser_mock(paginas) { retornar piloto_simulado(paginas) }

funcion _browser_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_BROWSER_OPT[k] ?? k] = o[k] }
    retornar r
}

// En page_route el manejador recibe y devuelve mapas en inglés.
funcion browser_route(p, patron, manejador) {
    piloto_ruta(p, patron, funcion(req) {
        sea r = manejador({"url": req["url"], "method": req["metodo"], "headers": req["cabeceras"], "type": req["tipo"]})
        si (r == nulo o r == "block") { si (r == "block") { retornar "bloquear" } retornar nulo }
        retornar {"estado": r["status"] ?? 200, "cabeceras": r["headers"] ?? nulo, "cuerpo": r["body"] ?? ""}
    })
}
