// stdlib/flex.cfv — motor de diseño Flexbox: calcula la posición y el
// tamaño de cada caja (para GUIs, juegos, PDF o lienzos). Inspirada en
// Yoga (MIT). En inglés: importar "flexbox".
//
//   importar "flex"
//   sea raiz = flex_nodo({"direccion": "fila", "espacio": 10, "relleno": 8}, [
//       flex_nodo({"ancho": 100}),
//       flex_nodo({"crecer": 1}),
//       flex_nodo({"crecer": 2, "alto": 40})
//   ])
//   flex_calcular(raiz, 500, 200)
//   raiz["hijos"][1]["caja"]       // {"x", "y", "ancho", "alto"}
//
// Estilo (en español o inglés): direccion/direction (fila|row, columna|
// column, fila-inversa, columna-inversa), justificar/justify (inicio|start,
// fin|end, centro|center, entre|space-between, alrededor|space-around,
// uniforme|space-evenly), alinear/align (estirar|stretch, inicio, fin,
// centro), alinear_propio/align_self, envolver/wrap, espacio/gap, crecer/
// grow, encoger/shrink (1), base/basis, ancho/width, alto/height, min_ancho,
// max_ancho, min_alto, max_alto, margen/margin, relleno/padding (número o
// [arriba, derecha, abajo, izquierda]), posicion/position: absoluta|absolute
// con arriba/top, izquierda/left, derecha/right, abajo/bottom.

sea _FX_EN = {
    "direccion": "direction", "justificar": "justify", "alinear": "align", "alinear_propio": "align_self",
    "envolver": "wrap", "espacio": "gap", "crecer": "grow", "encoger": "shrink", "base": "basis",
    "ancho": "width", "alto": "height", "min_ancho": "min_width", "max_ancho": "max_width",
    "min_alto": "min_height", "max_alto": "max_height", "margen": "margin", "relleno": "padding",
    "posicion": "position", "arriba": "top", "izquierda": "left", "derecha": "right", "abajo": "bottom"
}
sea _FX_VAL = {"row": "fila", "column": "columna", "row-reverse": "fila-inversa", "column-reverse": "columna-inversa",
    "start": "inicio", "flex-start": "inicio", "end": "fin", "flex-end": "fin", "center": "centro",
    "space-between": "entre", "space-around": "alrededor", "space-evenly": "uniforme", "stretch": "estirar",
    "absolute": "absoluta", "relative": "relativa"}

funcion flex_nodo(estilo, hijos) { retornar {"estilo": estilo ?? {}, "hijos": hijos ?? [], "caja": nulo} }

funcion _fx(n, k, d) {
    sea e = n["estilo"]
    sea v = nulo
    si (tiene_clave(e, k)) { v = e[k] } sino { si (tiene_clave(e, _FX_EN[k])) { v = e[_FX_EN[k]] } }
    si (v == nulo) { retornar d }
    si (tipo(v) == "texto" y tiene_clave(_FX_VAL, v)) { retornar _FX_VAL[v] }
    retornar v
}

// [arriba, derecha, abajo, izquierda]
funcion _fx_lados(v) {
    si (v == nulo) { retornar [0, 0, 0, 0] }
    si (tipo(v) == "numero") { retornar [v, v, v, v] }
    si (longitud(v) == 2) { retornar [v[0], v[1], v[0], v[1]] }
    retornar v
}

funcion _fx_limitar(v, min, max) {
    sea r = v
    si (max != nulo) { r = minimo(r, max) }
    si (min != nulo) { r = maximo(r, min) }
    retornar r
}

// Tamaño propio en el eje principal (fila → ancho).
funcion _fx_principal(h, fila) {
    sea b = _fx(h, "base", nulo)
    si (b != nulo) { retornar b }
    si (fila) { retornar _fx(h, "ancho", _fx_contenido(h, verdadero)) }
    retornar _fx(h, "alto", _fx_contenido(h, falso))
}

// Tamaño mínimo por contenido (suma o máximo de los hijos con tamaño fijo).
funcion _fx_contenido(n, ancho) {
    sea p = _fx_lados(_fx(n, "relleno", 0))
    sea extra = p[1] + p[3]
    si (ancho == falso) { extra = p[0] + p[2] }
    sea fila = texto_empieza_con(_fx(n, "direccion", "columna"), "fila")
    sea total = 0
    sea gap = _fx(n, "espacio", 0)
    sea k = 0
    para h en n["hijos"] {
        si (_fx(h, "posicion", "relativa") != "absoluta") {
            sea m = _fx_lados(_fx(h, "margen", 0))
            sea t = 0
            si (ancho) { t = _fx(h, "ancho", _fx_contenido(h, verdadero)) + m[1] + m[3] } sino { t = _fx(h, "alto", _fx_contenido(h, falso)) + m[0] + m[2] }
            si (fila == ancho) {
                total = total + t
                si (k > 0) { total = total + gap }
            } sino { total = maximo(total, t) }
            k = k + 1
        }
    }
    retornar total + extra
}

/// Calcula todas las cajas dentro de un espacio de ancho × alto.
funcion flex_calcular(raiz, ancho, alto) {
    sea w = _fx(raiz, "ancho", ancho)
    sea h = _fx(raiz, "alto", alto)
    raiz["caja"] = {"x": 0, "y": 0, "ancho": w, "alto": h}
    _fx_disponer(raiz)
    retornar raiz
}

funcion _fx_disponer(n) {
    sea caja = n["caja"]
    sea p = _fx_lados(_fx(n, "relleno", 0))
    sea dir = _fx(n, "direccion", "columna")
    sea fila = texto_empieza_con(dir, "fila")
    sea inversa = texto_termina_con(dir, "inversa")
    sea interior_x = caja["x"] + p[3]
    sea interior_y = caja["y"] + p[0]
    sea interior_w = maximo(0, caja["ancho"] - p[1] - p[3])
    sea interior_h = maximo(0, caja["alto"] - p[0] - p[2])
    sea principal = interior_h
    sea cruzado = interior_w
    si (fila) { principal = interior_w  cruzado = interior_h }
    sea gap = _fx(n, "espacio", 0)
    sea justificar = _fx(n, "justificar", "inicio")
    sea alinear = _fx(n, "alinear", "estirar")
    sea envolver = _fx(n, "envolver", falso)
    si (envolver == "wrap" o envolver == "envolver") { envolver = verdadero }

    // Elementos en flujo, con su base y márgenes.
    sea items = []
    para h en n["hijos"] {
        si (_fx(h, "posicion", "relativa") == "absoluta") { _fx_absoluto(n, h, interior_x, interior_y, interior_w, interior_h) } sino {
            sea m = _fx_lados(_fx(h, "margen", 0))
            sea mp = m[0] + m[2]
            sea mc = m[1] + m[3]
            si (fila) { mp = m[1] + m[3]  mc = m[0] + m[2] }
            sea minp = _fx(h, "min_alto", nulo)
            sea maxp = _fx(h, "max_alto", nulo)
            si (fila) { minp = _fx(h, "min_ancho", nulo)  maxp = _fx(h, "max_ancho", nulo) }
            items.agregar({"nodo": h, "base": _fx_limitar(_fx_principal(h, fila), minp, maxp), "margen": m, "mp": mp, "mc": mc, "min": minp, "max": maxp})
        }
    }
    // Líneas (envolver).
    sea lineas = []
    sea actual = []
    sea usado = 0
    para it en items {
        sea t = it["base"] + it["mp"]
        si (envolver == verdadero y longitud(actual) > 0 y usado + gap + t > principal) {
            lineas.agregar(actual)
            actual = []
            usado = 0
        }
        si (longitud(actual) > 0) { usado = usado + gap }
        usado = usado + t
        actual.agregar(it)
    }
    si (longitud(actual) > 0) { lineas.agregar(actual) }

    // Alto de cada línea en el eje cruzado.
    sea altos = []
    para l en lineas {
        sea c = 0
        para it en l {
            sea propio = _fx(it["nodo"], "ancho", nulo)
            si (fila) { propio = _fx(it["nodo"], "alto", nulo) }
            si (propio == nulo) { propio = _fx_contenido(it["nodo"], fila == falso) }
            c = maximo(c, propio + it["mc"])
        }
        si (longitud(lineas) == 1) { c = cruzado }
        altos.agregar(c)
    }

    sea pos_cruzada = 0
    sea li = 0
    para l en lineas {
        // Crecer / encoger.
        sea suma = 0
        para it en l { suma = suma + it["base"] + it["mp"] }
        suma = suma + gap * (longitud(l) - 1)
        sea libre = principal - suma
        para it en l { it["tam"] = it["base"] }
        si (libre > 0) {
            sea total_crecer = 0
            para it en l { total_crecer = total_crecer + _fx(it["nodo"], "crecer", 0) }
            si (total_crecer > 0) {
                para it en l { it["tam"] = _fx_limitar(it["base"] + libre * _fx(it["nodo"], "crecer", 0) / total_crecer, it["min"], it["max"]) }
                libre = 0
            }
        }
        si (libre < 0) {
            sea total_encoger = 0
            para it en l { total_encoger = total_encoger + _fx(it["nodo"], "encoger", 1) * it["base"] }
            si (total_encoger > 0) {
                para it en l { it["tam"] = _fx_limitar(maximo(0, it["base"] + libre * _fx(it["nodo"], "encoger", 1) * it["base"] / total_encoger), it["min"], it["max"]) }
                libre = 0
            }
        }
        sea ocupado = 0
        para it en l { ocupado = ocupado + it["tam"] + it["mp"] }
        ocupado = ocupado + gap * (longitud(l) - 1)
        libre = maximo(0, principal - ocupado)
        sea inicio = 0
        sea entre = gap
        sea cnt = longitud(l)
        si (justificar == "fin") { inicio = libre }
        si (justificar == "centro") { inicio = libre / 2 }
        si (justificar == "entre" y cnt > 1) { entre = gap + libre / (cnt - 1) }
        si (justificar == "alrededor") { inicio = libre / cnt / 2  entre = gap + libre / cnt }
        si (justificar == "uniforme") { inicio = libre / (cnt + 1)  entre = gap + libre / (cnt + 1) }
        sea alto_linea = altos[li]
        sea cursor = inicio
        para it en l {
            sea h = it["nodo"]
            sea m = it["margen"]
            sea al = _fx(h, "alinear_propio", alinear)
            sea propio = _fx(h, "ancho", nulo)
            si (fila) { propio = _fx(h, "alto", nulo) }
            sea tc = propio
            si (tc == nulo) {
                si (al == "estirar") { tc = alto_linea - it["mc"] } sino { tc = _fx_contenido(h, fila == falso) }
            }
            sea minc = _fx(h, "min_ancho", nulo)
            sea maxc = _fx(h, "max_ancho", nulo)
            si (fila) { minc = _fx(h, "min_alto", nulo)  maxc = _fx(h, "max_alto", nulo) }
            tc = maximo(0, _fx_limitar(tc, minc, maxc))
            sea oc = 0
            si (al == "fin") { oc = alto_linea - tc - it["mc"] }
            si (al == "centro") { oc = (alto_linea - tc - it["mc"]) / 2 }
            sea mi = m[0]
            sea mantes = m[3]
            si (fila) { mi = m[3]  mantes = m[0] }
            sea pp = cursor + mi
            si (inversa) { pp = principal - cursor - mi - it["tam"] }
            si (fila) {
                h["caja"] = {"x": interior_x + pp, "y": interior_y + pos_cruzada + oc + mantes, "ancho": it["tam"], "alto": tc}
            } sino {
                h["caja"] = {"x": interior_x + pos_cruzada + oc + mantes, "y": interior_y + pp, "ancho": tc, "alto": it["tam"]}
            }
            cursor = cursor + it["tam"] + it["mp"] + entre
            _fx_disponer(h)
        }
        pos_cruzada = pos_cruzada + alto_linea + gap
        li = li + 1
    }
}

funcion _fx_absoluto(padre, h, x, y, w, alto) {
    sea izq = _fx(h, "izquierda", nulo)
    sea der = _fx(h, "derecha", nulo)
    sea arr = _fx(h, "arriba", nulo)
    sea aba = _fx(h, "abajo", nulo)
    sea ancho = _fx(h, "ancho", nulo)
    sea alto_h = _fx(h, "alto", nulo)
    si (ancho == nulo) {
        si (izq != nulo y der != nulo) { ancho = w - izq - der } sino { ancho = _fx_contenido(h, verdadero) }
    }
    si (alto_h == nulo) {
        si (arr != nulo y aba != nulo) { alto_h = alto - arr - aba } sino { alto_h = _fx_contenido(h, falso) }
    }
    sea px = x + (izq ?? 0)
    si (izq == nulo y der != nulo) { px = x + w - der - ancho }
    sea py = y + (arr ?? 0)
    si (arr == nulo y aba != nulo) { py = y + alto - aba - alto_h }
    h["caja"] = {"x": px, "y": py, "ancho": ancho, "alto": alto_h}
    _fx_disponer(h)
}

/// Lista plana de [nodo, caja] (para dibujar).
funcion flex_cajas(raiz) {
    sea r = []
    _fx_juntar(raiz, r)
    retornar r
}
funcion _fx_juntar(n, r) {
    r.agregar(n["caja"])
    para h en n["hijos"] { _fx_juntar(h, r) }
}
