// stdlib/signalr.cfv — cliente de SignalR: nombres en inglés del módulo "senal".
// English names for the "senal" module; both can be used together.


importar "senal"

funcion _signalr_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_signalr_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _signalr_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _SIGNALR_OPT = {"token": "token", "skip_negotiation": "sin_negociar", "reconnect": "reconectar", "transport": "transporte", "sleep": "dormir"}

funcion signalr_encode(m) { retornar senal_codificar(m) }
funcion signalr_decode(t) { retornar senal_decodificar(t) }
funcion signalr_handshake() { retornar senal_saludo() }
funcion signalr_connect(url, opciones) { retornar senal_conectar(url, _signalr_opt(opciones)) }
funcion signalr_on(c, metodo, fn) { retornar senal_en(c, metodo, fn) }
funcion signalr_off(c, metodo) { retornar senal_quitar(c, metodo) }
funcion signalr_on_event(c, evento, fn) { retornar senal_al(c, evento, fn) }
funcion signalr_invoke(c, metodo, args) { retornar senal_invocar(c, metodo, args) }
funcion signalr_send(c, metodo, args) { retornar senal_enviar(c, metodo, args) }
funcion signalr_stream_each(c, metodo, args, fn) { retornar senal_flujo_cada(c, metodo, args, fn) }
funcion signalr_stream(c, metodo, args) { retornar senal_flujo(c, metodo, args) }
funcion signalr_process(c) { retornar senal_atender(c) }
funcion signalr_wait(c, metodo) { retornar senal_esperar(c, metodo) }
funcion signalr_ping(c) { retornar senal_ping(c) }
funcion signalr_close(c) { retornar senal_cerrar(c) }
funcion signalr_memory_hub(metodos) { retornar senal_hub_memoria(metodos) }

funcion _signalr_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_SIGNALR_OPT[k] ?? k] = o[k] }
    retornar r
}
