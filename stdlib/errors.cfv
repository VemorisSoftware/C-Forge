// stdlib/errors.cfv — reporte de errores en producción: nombres en inglés del módulo "alerta".
// English names for the "alerta" module; both can be used together.

importar "alerta"

/// options: environment, release, max_breadcrumbs, max_per_minute, before_send.
funcion errors_new(opciones) {
    sea o = {}
    sea en = {"environment": "entorno", "release": "version", "max_breadcrumbs": "max_migas", "max_per_minute": "max_por_minuto", "before_send": "antes_de_enviar"}
    si (opciones != nulo) { para k en claves(opciones) { si (tiene_clave(en, k)) { o[en[k]] = opciones[k] } sino { o[k] = opciones[k] } } }
    retornar alerta_nueva(o)
}
funcion errors_user(a, usuario) { retornar alerta_usuario(a, usuario) }
funcion errors_tag(a, clave, valor) { retornar alerta_etiqueta(a, clave, valor) }
funcion errors_breadcrumb(a, mensaje, categoria, datos) { retornar alerta_miga(a, mensaje, categoria, datos) }
funcion errors_scrub(v) { retornar alerta_filtrar(v) }
funcion errors_fingerprint(mensaje) { retornar alerta_huella(mensaje) }
funcion errors_report(a, error, nivel, extra) { retornar alerta_reportar(a, error, nivel, extra) }
funcion errors_capture(a, f, extra) { retornar alerta_capturar(a, f, extra) }
funcion errors_events(a) { retornar alerta_eventos(a) }
funcion errors_summary(a) { retornar alerta_resumen(a) }
funcion errors_save(a, ruta) { retornar alerta_guardar(a, ruta) }
funcion errors_sentry_request(a, evento, dsn) { retornar alerta_sentry(a, evento, dsn) }
