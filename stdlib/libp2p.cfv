// stdlib/libp2p.cfv — redes P2P al estilo de libp2p: nombres en inglés del módulo "malla".
// English names for the "malla" module; both can be used together.

importar "malla"

funcion libp2p_peer_id(n) { retornar malla_peer_id(n) }
funcion libp2p_peer_id_bytes(texto) { retornar malla_peer_id_bytes(texto) }
funcion multiaddr_parse(texto) { retornar malla_multiaddr(texto) }
funcion multiaddr_to_bytes(texto) { retornar malla_multiaddr_bytes(texto) }
funcion multiaddr_to_string(b) { retornar malla_multiaddr_texto(b) }
funcion libp2p_connection(nodo, rol, esperado) { retornar malla_conexion(nodo, rol, esperado) }
funcion libp2p_take_output(c) { retornar malla_salida(c) }
funcion libp2p_feed(c, datos) { retornar malla_entrada(c, datos) }
funcion libp2p_open_stream(c, protocolo) { retornar malla_abrir_flujo(c, protocolo) }
funcion libp2p_stream_write(c, id, datos) { retornar malla_flujo_escribir(c, id, datos) }
funcion libp2p_stream_close(c, id) { retornar malla_flujo_cerrar(c, id) }
funcion libp2p_remote_peer_id(c) { retornar malla_peer_id_texto(c) }
funcion libp2p_is_ready(c) { retornar malla_lista(c) }
funcion libp2p_go_away(c) { retornar malla_despedir(c) }
funcion libp2p_dial(nodo, multiaddr) { retornar malla_conectar(nodo, multiaddr) }
funcion libp2p_listen(nodo, puerto) { retornar malla_escuchar(nodo, puerto) }
funcion libp2p_accept(nodo, escucha) { retornar malla_aceptar(nodo, escucha) }
funcion libp2p_serve(c, ms) { retornar malla_atender(c, ms) }
funcion libp2p_ping(c) { retornar malla_ping(c) }
funcion libp2p_request(c, protocolo, datos) { retornar malla_pedir(c, protocolo, datos) }
funcion libp2p_close(c) { retornar malla_cerrar(c) }

// New node with an Ed25519 identity. options: "seed" (32 bytes), "agent", "addresses".
funcion libp2p_node(options) {
    sea o = options ?? {}
    sea op = {}
    si (tiene_clave(o, "seed")) { op["semilla"] = o["seed"] }
    si (tiene_clave(o, "agent")) { op["agente"] = o["agent"] }
    si (tiene_clave(o, "addresses")) { op["direcciones"] = o["addresses"] }
    retornar malla_nodo(op)
}
// Register a request/response protocol: handler(request, peer) -> response.
funcion libp2p_handle(node, protocol, handler) { malla_manejar(node, protocol, handler) }
// Read a stream: {"data", "fin", "ready", "rejected"}.
funcion libp2p_stream_read(c, id) {
    sea r = malla_flujo_leer(c, id)
    retornar {"data": r["datos"], "fin": r["fin"], "ready": r["listo"], "rejected": r["rechazado"]}
}
// Pending events (connected, stream, closed).
funcion libp2p_events(c) {
    sea t = {"conectado": "connected", "flujo": "stream", "cerrado": "closed"}
    sea r = []
    para e en malla_eventos(c) {
        sea x = {"type": t[e["tipo"]] ?? e["tipo"]}
        si (tiene_clave(e, "id")) { x["id"] = e["id"] }
        si (tiene_clave(e, "protocolo")) { x["protocol"] = e["protocolo"] }
        r.agregar(x)
    }
    retornar r
}
funcion _libp2p_id(i) { retornar {"protocol_version": i["version"], "agent": i["agente"], "protocols": i["protocolos"], "addresses": i["direcciones"], "observed": i["observada"], "peer_id": i["peer_id"]} }
// Identify over the connection.
funcion libp2p_identify(c) { retornar _libp2p_id(malla_identificar(c)) }
// Decode an identify message (length-prefixed).
funcion libp2p_identify_decode(d) { retornar _libp2p_id(malla_identify_leer(d)) }
