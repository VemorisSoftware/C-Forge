// stdlib/cli.cfv — argumentos de línea de comandos: nombres en inglés del módulo "orden".
// English names for the "orden" module; both can be used together.

importar "orden"

funcion cli_new(nombre, descripcion) { retornar orden_nuevo(nombre, descripcion) }
funcion cli_flag(o, largo, corto, descripcion) { retornar orden_bandera(o, largo, corto, descripcion) }
funcion cli_option(o, largo, corto, descripcion, defecto, requerida) { retornar orden_opcion(o, largo, corto, descripcion, defecto, requerida) }
funcion cli_positional(o, nombre, descripcion, requerido) { retornar orden_posicional(o, nombre, descripcion, requerido) }
funcion cli_parse(o, args) { retornar orden_analizar(o, args) }
funcion cli_help(o) { retornar orden_ayuda(o) }
