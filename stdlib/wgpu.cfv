// stdlib/wgpu.cfv — API de GPU (estilo wgpu, backend de software): nombres en inglés del módulo "gpu".
// English names for the "gpu" module; both can be used together.


importar "gpu"

funcion _wgpu_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_wgpu_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _wgpu_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _WGPU_OPT = {"size": "tamano", "usage": "uso", "contents": "contenido", "width": "ancho", "height": "alto", "format": "formato", "filter": "filtro", "address_mode": "direccion", "vertex": "vertice", "fragment": "fragmento", "attributes": "atributos", "strides": "pasos", "stride": "paso", "instance_slots": "por_instancia", "topology": "topologia", "cull_mode": "descartar", "front_face": "frente", "depth": "profundidad", "blend": "mezcla", "compute": "computo", "workgroup_size": "grupo", "color": "color", "clear": "limpiar", "depth_stencil": "profundidad", "depth_clear": "limpiar_profundidad", "viewport": "vista", "scissor": "tijera"}

funcion wgpu_request_adapter(opciones) { retornar gpu_adaptador(_wgpu_opt(opciones)) }
funcion wgpu_request_device(adaptador) { retornar gpu_dispositivo(adaptador) }
funcion wgpu_stats(dev) { retornar gpu_estadisticas(dev) }
funcion wgpu_create_buffer(dev, opciones) { retornar gpu_buffer(dev, _wgpu_opt(opciones)) }
funcion wgpu_write_buffer(dev, buf, desplazamiento, datos) { retornar gpu_escribir_buffer(dev, buf, desplazamiento, datos) }
funcion wgpu_read_buffer(dev, buf) { retornar gpu_leer_buffer(dev, buf) }
funcion wgpu_create_texture(dev, opciones) { retornar gpu_textura(dev, _wgpu_opt(opciones)) }
funcion wgpu_texture_from_image(dev, img) { retornar gpu_textura_de_imagen(dev, img) }
funcion wgpu_texture_to_image(dev, t) { retornar gpu_textura_imagen(dev, t) }
funcion wgpu_texel(t, x, y) { retornar gpu_texel(t, x, y) }
funcion wgpu_write_texel(t, x, y, c) { retornar gpu_escribir_texel(t, x, y, c) }
funcion wgpu_create_sampler(dev, opciones) { retornar gpu_muestreador(dev, _wgpu_opt(opciones)) }
funcion wgpu_sample(t, m, uv) { retornar gpu_muestrear(t, m, uv) }
funcion wgpu_create_render_pipeline(dev, opciones) { retornar gpu_pipeline_render(dev, _wgpu_opt(opciones)) }
funcion wgpu_create_compute_pipeline(dev, opciones) { retornar gpu_pipeline_computo(dev, _wgpu_opt(opciones)) }
funcion wgpu_create_bind_group(dev, entradas) { retornar gpu_grupo(dev, entradas) }
funcion wgpu_create_command_encoder(dev) { retornar gpu_codificador(dev) }
funcion wgpu_begin_render_pass(enc, opciones) { retornar gpu_pase_render(enc, _wgpu_opt(opciones)) }
funcion wgpu_begin_compute_pass(enc) { retornar gpu_pase_computo(enc) }
funcion wgpu_set_pipeline(pase, p) { retornar gpu_fijar_pipeline(pase, p) }
funcion wgpu_set_bind_group(pase, indice, grupo) { retornar gpu_fijar_grupo(pase, indice, grupo) }
funcion wgpu_set_vertex_buffer(pase, ranura, buf) { retornar gpu_fijar_vertices(pase, ranura, buf) }
funcion wgpu_set_index_buffer(pase, buf) { retornar gpu_fijar_indices(pase, buf) }
funcion wgpu_draw(pase, vertices, instancias, primer_vertice, primera_instancia) { retornar gpu_dibujar(pase, vertices, instancias, primer_vertice, primera_instancia) }
funcion wgpu_draw_indexed(pase, indices, instancias, primer_indice, base_vertice, primera_instancia) { retornar gpu_dibujar_indexado(pase, indices, instancias, primer_indice, base_vertice, primera_instancia) }
funcion wgpu_dispatch_workgroups(pase, x, y, z) { retornar gpu_despachar(pase, x, y, z) }
funcion wgpu_end_pass(pase) { retornar gpu_fin_pase(pase) }
funcion wgpu_copy_buffer_to_buffer(enc, origen, desde, destino, hacia, n) { retornar gpu_copiar_buffer(enc, origen, desde, destino, hacia, n) }
funcion wgpu_finish(enc) { retornar gpu_terminar(enc) }
funcion wgpu_submit(dev, buffers) { retornar gpu_enviar(dev, buffers) }
funcion wgpu_perspective(fov_y, aspecto, cerca, lejos) { retornar gpu_perspectiva(fov_y, aspecto, cerca, lejos) }
funcion wgpu_look_at(ojo, centro, arriba) { retornar gpu_mirar(ojo, centro, arriba) }
funcion wgpu_mat_mul(a, b) { retornar gpu_mat_mul(a, b) }
funcion wgpu_mat_vec(m, v) { retornar gpu_mat_vec(m, v) }
funcion wgpu_translation(x, y, z) { retornar gpu_traslacion(x, y, z) }
funcion wgpu_rotation_y(a) { retornar gpu_rotacion_y(a) }

funcion _wgpu_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_WGPU_OPT[k] ?? k] = o[k] }
    retornar r
}
