// stdlib/libcurl.cfv — Transferencias por URL (estilo libcurl): nombres en inglés del módulo "transporte".
// English names for the "transporte" module; both can be used together.


importar "transporte"

funcion _libcurl_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_libcurl_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _libcurl_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _LIBCURL_OPT = {"user": "usuario", "password": "clave", "from": "desde", "to": "hasta", "headers": "cabeceras", "method": "metodo", "body": "cuerpo", "timeout_ms": "espera_ms", "progress": "progreso", "append": "anexar", "create_dirs": "crear_carpetas", "detail": "detalle", "redirects": "redirecciones", "type": "tipo"}

funcion curl_unescape(t) { retornar transporte_decodificar(t) }
funcion curl_escape(t, dejar_barras) { retornar transporte_codificar(t, dejar_barras) }
funcion curl_parse_url(url) { retornar transporte_url(url) }
funcion curl_get(url, opciones) { retornar transporte_obtener(url, _libcurl_opt(opciones)) }
funcion curl_put(url, datos, opciones) { retornar transporte_enviar(url, datos, _libcurl_opt(opciones)) }
funcion curl_list(url, opciones) { retornar transporte_listar(url, _libcurl_opt(opciones)) }
funcion curl_info(url, opciones) { retornar transporte_info(url, _libcurl_opt(opciones)) }
funcion curl_delete(url, opciones) { retornar transporte_borrar(url, _libcurl_opt(opciones)) }
funcion curl_ftp_commands(url, comandos, opciones) { retornar transporte_ftp_comandos(url, comandos, _libcurl_opt(opciones)) }

funcion _libcurl_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_LIBCURL_OPT[k] ?? k] = o[k] }
    retornar r
}
