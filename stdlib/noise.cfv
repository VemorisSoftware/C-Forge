// stdlib/noise.cfv — ruido procedural: nombres en inglés del módulo "ruido".
// English names for the "ruido" module; both can be used together.

importar "ruido"

funcion noise_new(semilla) { retornar ruido_nuevo(semilla) }
funcion noise_perlin(r, x, yv, z) { retornar ruido_perlin(r, x, yv, z) }
funcion noise_simplex(r, x, yv) { retornar ruido_simplex(r, x, yv) }
funcion noise_value(r, x, yv) { retornar ruido_valor(r, x, yv) }
funcion noise_cellular(r, x, yv) { retornar ruido_celular(r, x, yv) }
funcion noise_fractal(r, x, yv, opciones) { retornar ruido_fractal(r, x, yv, opciones) }
funcion noise_map(r, ancho, alto, escala, opciones) { retornar ruido_mapa(r, ancho, alto, escala, opciones) }
funcion noise_ascii(mapa) { retornar ruido_ascii(mapa) }
