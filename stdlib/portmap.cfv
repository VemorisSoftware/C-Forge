// stdlib/portmap.cfv — abrir puertos (UPnP y NAT-PMP): nombres en inglés del módulo "puertos".
// English names for the "puertos" module; both can be used together.


importar "puertos"

funcion _portmap_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_portmap_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _portmap_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _PORTMAP_RES = {"estado": "status", "cabeceras": "headers", "interno": "internal", "externo": "external", "activo": "enabled", "descripcion": "description", "duracion": "lease", "protocolo": "protocol", "codigo": "code", "segundos": "seconds"}
sea _PORTMAP_OPT = {"transport": "transporte", "destination": "destino", "port": "puerto"}

funcion ssdp_msearch(objetivo, espera_s) { retornar puertos_msearch(objetivo, espera_s) }
funcion ssdp_parse(t) { retornar _portmap_tr(puertos_ssdp_leer(t), _PORTMAP_RES) }
funcion upnp_describe(ubicacion, xml_texto_desc, opciones) { retornar puertos_describir(ubicacion, xml_texto_desc, _portmap_opt(opciones)) }
funcion upnp_discover(ms, opciones) { retornar puertos_descubrir(ms, _portmap_opt(opciones)) }
funcion upnp_soap(servicio, accion, args) { retornar puertos_soap(servicio, accion, args) }
funcion upnp_soap_parse(t) { retornar puertos_soap_leer(t) }
funcion portmap_external_ip(gw) { retornar puertos_ip_externa(gw) }
funcion portmap_add(gw, externo, interno, protocolo, descripcion, duracion_s, ip_interna) { retornar puertos_abrir(gw, externo, interno, protocolo, descripcion, duracion_s, ip_interna) }
funcion portmap_delete(gw, externo, protocolo) { retornar puertos_cerrar(gw, externo, protocolo) }
funcion portmap_get(gw, externo, protocolo) { retornar _portmap_tr(puertos_consultar(gw, externo, protocolo), _PORTMAP_RES) }
funcion portmap_list(gw, maximo) { retornar _portmap_tr(puertos_listar(gw, maximo), _PORTMAP_RES) }
funcion natpmp_request(protocolo, interno, externo, duracion_s) { retornar puertos_natpmp_peticion(protocolo, interno, externo, duracion_s) }
funcion natpmp_response(t) { retornar _portmap_tr(puertos_natpmp_respuesta(t), _PORTMAP_RES) }
funcion natpmp_gateway(ip_router, puerto) { retornar puertos_natpmp(ip_router, puerto) }
funcion natpmp_external_ip(gw) { retornar puertos_natpmp_ip(gw) }
funcion natpmp_map(gw, protocolo, interno, externo, duracion_s) { retornar _portmap_tr(puertos_natpmp_mapear(gw, protocolo, interno, externo, duracion_s), _PORTMAP_RES) }

funcion _portmap_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_PORTMAP_OPT[k] ?? k] = o[k] }
    retornar r
}
