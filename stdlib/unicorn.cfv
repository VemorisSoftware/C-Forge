// stdlib/unicorn.cfv — Emulador de CPU x86-64/ARM64 (estilo Unicorn): nombres en inglés del módulo "emulador".
// English names for the "emulador" module; both can be used together.

importar "emulador"

funcion _unicorn_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_unicorn_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _unicorn_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _UNICORN_RES = {"instrucciones": "instructions", "motivo": "reason"}

funcion uc_open(arquitectura) { retornar emulador_crear(arquitectura) }
funcion uc_mem_map(e, dir, tam) { retornar emulador_mapear(e, dir, tam) }
funcion uc_mem_write(e, dir, datos) { retornar emulador_escribir(e, dir, datos) }
funcion uc_mem_read(e, dir, n) { retornar emulador_leer(e, dir, n) }
funcion uc_reg_read(e, nombre) { retornar emulador_reg(e, nombre) }
funcion uc_reg_read_hex(e, nombre) { retornar emulador_reg_hex(e, nombre) }
funcion uc_reg_write(e, nombre, valor) { retornar emulador_fijar_reg(e, nombre, valor) }
funcion uc_flags(e) { retornar emulador_banderas(e) }
funcion uc_hook_add(e, tipo_gancho, f) { retornar emulador_gancho(e, tipo_gancho, f) }
funcion uc_emu_stop(e) { retornar emulador_detener(e) }
funcion uc_emu_start(e, inicio, fin, maximo_) { retornar _unicorn_tr(emulador_ejecutar(e, inicio, fin, maximo_), _UNICORN_RES) }
