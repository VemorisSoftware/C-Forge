// stdlib/java.cfv — Java desde C-Forge: la JVM corre dentro del programa
// (JNI). Necesita un JDK instalado (JAVA_HOME o las rutas habituales).
//
//   importar "java"
//   java_iniciar("clases")                       // classpath (o nulo)
//   mostrar(java_estatico("java.lang.Math", "max", "(II)I", [3, 9]))
//   sea lista = java_nuevo("java.util.ArrayList", "()V", [])
//   java_metodo(lista, "add", "(Ljava/lang/Object;)Z", ["hola"])
//   mostrar(java_metodo(lista, "size", "()I", []))
//
// Firmas JNI: I/S/B/C entero, J largo, Z booleano, D decimal (como
// argumento), Ljava/lang/String; texto, otros L…; objetos (los que devuelven
// java_nuevo y los métodos; java_soltar(obj) los libera), V sin valor. Una
// excepción de Java llega como error capturable. Métodos que devuelven
// decimal: todavía no (envuélvelos en String.valueOf).

// Cualquier extern activa el enlazador dinámico (dlopen de libjvm). La
// declaración va dentro de una función que nunca se llama.
funcion __java_declaraciones() {
    extern "libc" funcion __java_enlace_dinamico(): entero como "getpid"
}
