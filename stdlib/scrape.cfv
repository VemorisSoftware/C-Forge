// stdlib/scrape.cfv — HTML con selectores CSS: nombres en inglés del módulo "cosecha".
// English names for the "cosecha" module; both can be used together.

importar "cosecha"

funcion scrape_parent(n) { retornar cosecha_padre(n) }
funcion scrape_load(html) { retornar cosecha_cargar(html) }
funcion scrape_select(nodo, selector) { retornar cosecha_buscar(nodo, selector) }
funcion scrape_first(nodo, selector) { retornar cosecha_primero(nodo, selector) }
funcion scrape_text(nodo) { retornar cosecha_texto(nodo) }
funcion scrape_attr(nodo, nombre) { retornar cosecha_attr(nodo, nombre) }
funcion scrape_extract(nodo, selector, atributo) { retornar cosecha_extraer(nodo, selector, atributo) }
funcion scrape_html(n) { retornar cosecha_html(n) }
