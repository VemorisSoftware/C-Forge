// stdlib/logpipe.cfv — tubería de logs y eventos: nombres en inglés del módulo "recolector".
// English names for the "recolector" module; both can be used together.

importar "recolector"

funcion logpipe_field(e, ruta) { retornar recolector_campo(e, ruta) }
funcion logpipe_template(t, e) { retornar recolector_plantilla(t, e) }
funcion parse_logfmt(t) { retornar recolector_logfmt(t) }
funcion parse_syslog(t) { retornar recolector_syslog(t) }
funcion parse_pattern(patron, texto) { retornar recolector_patron(patron, texto) }
funcion remap_compile(texto) { retornar recolector_compilar(texto) }
funcion remap_eval(expr, e) { retornar recolector_evaluar(expr, e) }
funcion logpipe_new(config) { retornar recolector_nuevo(config) }
funcion elasticsearch_bulk(evs, indice) { retornar recolector_bulk(evs, indice) }
funcion loki_payload(evs, etiquetas) { retornar recolector_loki(evs, etiquetas) }
funcion logpipe_run(p, opciones) { retornar recolector_ejecutar(p, opciones) }
funcion logpipe_output(p, destino) { retornar recolector_salida(p, destino) }
funcion logpipe_send(p, fuente, eventos) { retornar recolector_enviar(p, fuente, eventos) }
