// stdlib/read_xlsx.cfv — leer planillas .xlsx: nombres en inglés del módulo "lee_excel".
// English names for the "lee_excel" module; both can be used together.

importar "lee_excel"

funcion read_xlsx_open(bytes) { retornar lee_excel_abrir(bytes) }
funcion read_xlsx_sheets(libro) { retornar lee_excel_hojas(libro) }
/// options: {"dates_ms": true} converts date-formatted cells to ms.
funcion read_xlsx_rows(libro, hoja, opciones) {
    sea o = opciones
    si (opciones != nulo) { si (tiene_clave(opciones, "dates_ms")) { o = {"fechas_ms": opciones["dates_ms"]} } }
    retornar lee_excel_filas(libro, hoja, o)
}
funcion read_xlsx_records(libro, hoja, opciones) {
    sea o = opciones
    si (opciones != nulo) { si (tiene_clave(opciones, "dates_ms")) { o = {"fechas_ms": opciones["dates_ms"]} } }
    retornar lee_excel_registros(libro, hoja, o)
}
funcion read_xlsx_date_ms(serial) { retornar lee_excel_fecha_ms(serial) }
