// stdlib/zeromq.cfv — sockets ZeroMQ (ZMTP 3.0): nombres en inglés del módulo "buzon".
// English names for the "buzon" module; both can be used together.


importar "buzon"

funcion _zeromq_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_zeromq_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _zeromq_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _ZEROMQ_OPT = {"identity": "identidad", "transport": "transporte", "server": "servidor"}

funcion zmq_greeting(servidor) { retornar buzon_saludo(servidor) }
funcion zmq_command(nombre, props) { retornar buzon_comando(nombre, props) }
funcion zmq_message(partes) { retornar buzon_mensaje(partes) }
funcion zmq_pipe() { retornar buzon_tubo() }
funcion zmq_connect(tipo_s, url, opciones) { retornar buzon_conectar(tipo_s, url, _zeromq_opt(opciones)) }
funcion zmq_socket(tipo_s, transporte, opciones) { retornar buzon_socket(tipo_s, transporte, _zeromq_opt(opciones)) }
funcion zmq_bind(tipo_s, url, opciones) { retornar buzon_escuchar(tipo_s, url, _zeromq_opt(opciones)) }
funcion zmq_accept(s) { retornar buzon_aceptar(s) }
funcion zmq_subscribe(s, prefijo) { retornar buzon_suscribir(s, prefijo) }
funcion zmq_unsubscribe(s, prefijo) { retornar buzon_desuscribir(s, prefijo) }
funcion zmq_send(s, mensaje) { retornar buzon_enviar(s, mensaje) }
funcion zmq_recv(s) { retornar buzon_recibir(s) }
funcion zmq_close(s) { retornar buzon_cerrar(s) }

funcion _zeromq_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_ZEROMQ_OPT[k] ?? k] = o[k] }
    retornar r
}
