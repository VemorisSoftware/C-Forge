// stdlib/oidc.cfv — OAuth 2.0 y OpenID Connect: nombres en inglés del módulo "federa".
// English names for the "federa" module; both can be used together.


importar "federa"

funcion _oidc_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_oidc_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _oidc_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _OIDC_RES = {"verificador": "verifier", "desafio": "challenge", "metodo": "method", "codigo": "code", "estado": "state", "acceso": "access_token", "refresco": "refresh_token", "tipo": "token_type", "vence_ms": "expires_at_ms", "alcance": "scope", "emisor": "issuer", "autorizacion": "authorization_endpoint", "token": "token_endpoint", "userinfo": "userinfo_endpoint", "fin_sesion": "end_session_endpoint", "algoritmos": "algorithms", "cabecera": "header", "carga": "payload", "firma": "signature", "firmado": "signing_input"}
sea _OIDC_OPT = {"now_ms": "ahora_ms", "leeway_s": "tolerancia_s"}

funcion oidc_b64url(t) { retornar federa_b64url(t) }
funcion oidc_b64url_decode(s) { retornar federa_b64url_decodificar(s) }
funcion oidc_random(bytes) { retornar federa_aleatorio(bytes) }
funcion oidc_pkce() { retornar _oidc_tr(federa_pkce(), _OIDC_RES) }
funcion oidc_urlencode(s) { retornar federa_codificar(s) }
funcion oidc_authorization_url(c) { retornar federa_url_autorizacion(c) }
funcion oidc_callback(consulta, estado_esperado) { retornar _oidc_tr(federa_callback(consulta, estado_esperado), _OIDC_RES) }
funcion oidc_token_request_body(c, codigo, verificador) { retornar federa_cuerpo_canje(c, codigo, verificador) }
funcion oidc_refresh_request_body(c, refresco) { retornar federa_cuerpo_refresco(c, refresco) }
funcion oidc_parse_token_response(texto, ahora_ms) { retornar _oidc_tr(federa_respuesta_token(texto, ahora_ms), _OIDC_RES) }
funcion oidc_discovery(texto) { retornar _oidc_tr(federa_descubrimiento(texto), _OIDC_RES) }
funcion oidc_rsa_verify(n_bytes, e_bytes, mensaje, firma, alg) { retornar federa_rsa_verificar(n_bytes, e_bytes, mensaje, firma, alg) }
funcion oidc_validate_id_token(token, opciones) { retornar federa_validar_id_token(token, _oidc_opt(opciones)) }
funcion oidc_logout_url(fin_sesion, id_token, redireccion, estado) { retornar federa_url_salida(fin_sesion, id_token, redireccion, estado) }

funcion _oidc_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_OIDC_OPT[k] ?? k] = o[k] }
    retornar r
}

funcion _oidc_jwt_en(j) { retornar {"header": j["cabecera"], "payload": j["carga"], "signature": j["firma"], "signing_input": j["firmado"]} }

/// Splits a JWT without verifying: {"header", "payload", "signature", "signing_input"}.
funcion oidc_decode_jwt(token) { retornar _oidc_jwt_en(federa_jwt(token)) }

/// Verifies only the signature (options: jwks or secret, algorithms).
funcion oidc_verify_signature(token, options) { retornar _oidc_jwt_en(federa_verificar_firma(token, _oidc_opt(options))) }

/// Should the token be refreshed? (less than margin_s seconds left, 60 by default).
funcion oidc_needs_refresh(tokens, now_ms, margin_s) { retornar federa_por_vencer({"vence_ms": tokens["expires_at_ms"] ?? nulo}, now_ms, margin_s) }
