// stdlib/esquema.cfv — validación de datos con esquemas declarativos:
// valida, limpia y explica cada error con su ruta. Inspirada en Zod (MIT).
// En inglés: importar "schema".
//
//   importar "esquema"
//   sea usuario = esquema_objeto({
//       "nombre": esquema_min(esquema_texto(), 2),
//       "correo": esquema_correo(esquema_texto()),
//       "edad": esquema_opcional(esquema_entero())
//   })
//   sea r = esquema_validar(usuario, datos)   // {"ok", "valor", "errores": [{"ruta", "mensaje", "codigo"}]}
//   sea limpio = esquema_analizar(usuario, datos)   // o lanza el primer error

importar "regex"

funcion _es(tipo_e) { retornar {"tipo": tipo_e, "opcional": falso, "defecto": nulo, "tiene_defecto": falso, "min": nulo, "max": nulo, "patron": nulo, "correo": falso, "opciones": nulo, "estricto": falso} }

funcion esquema_texto() { retornar _es("texto") }
funcion esquema_numero() { retornar _es("numero") }
funcion esquema_entero() { retornar _es("entero") }
funcion esquema_booleano() { retornar _es("booleano") }
funcion esquema_cualquiera() { retornar _es("cualquiera") }
funcion esquema_lista(elemento) {
    sea e = _es("lista")
    e["elemento"] = elemento
    retornar e
}
funcion esquema_objeto(campos) {
    sea e = _es("objeto")
    e["campos"] = campos
    retornar e
}

/// Mínimo: largo para textos y listas, valor para números.
funcion esquema_min(e, n) { e["min"] = n  retornar e }
funcion esquema_max(e, n) { e["max"] = n  retornar e }
/// Expresión regular que el texto debe cumplir completo.
funcion esquema_patron(e, patron) { e["patron"] = patron  retornar e }
funcion esquema_correo(e) { e["correo"] = verdadero  retornar e }
/// Solo uno de estos valores.
funcion esquema_uno_de(e, opciones) { e["opciones"] = opciones  retornar e }
funcion esquema_opcional(e) { e["opcional"] = verdadero  retornar e }
funcion esquema_defecto(e, v) { e["defecto"] = v  e["tiene_defecto"] = verdadero  retornar e }
/// Rechaza claves que el objeto no declara.
funcion esquema_estricto(e) { e["estricto"] = verdadero  retornar e }

funcion _es_correo(t) {
    si (texto_indice(t, " ") >= 0 o longitud(t) > 254) { retornar falso }
    sea partes = texto_dividir(t, "@")
    si (longitud(partes) != 2) { retornar falso }
    si (longitud(partes[0]) == 0) { retornar falso }
    sea dominio = partes[1]
    sea punto = texto_indice(dominio, ".")
    si (punto <= 0) { retornar falso }
    retornar texto_termina_con(dominio, ".") == falso
}

funcion _es_error(errores, ruta, codigo, mensaje, limite) {
    sea r = ruta
    si (r == "") { r = "(raíz)" }
    errores.agregar({"ruta": r, "codigo": codigo, "mensaje": mensaje, "limite": limite})
}

funcion _es_ruta(base, parte) {
    si (base == "") { retornar "" + parte }
    retornar base + "." + parte
}

funcion _es_validar(e, v, ruta, errores) {
    si (v == nulo) {
        si (e["tiene_defecto"]) { retornar e["defecto"] }
        si (e["opcional"]) { retornar nulo }
        _es_error(errores, ruta, "requerido", "es obligatorio")
        retornar nulo
    }
    sea t = e["tipo"]
    si (t == "cualquiera") { retornar v }
    si (t == "texto") {
        si (tipo(v) != "texto") { _es_error(errores, ruta, "tipo", "debe ser texto")  retornar nulo }
        si (e["min"] != nulo) { si (longitud(v) < e["min"]) { _es_error(errores, ruta, "muy_corto", "debe tener al menos " + e["min"] + " caracteres", e["min"]) } }
        si (e["max"] != nulo) { si (longitud(v) > e["max"]) { _es_error(errores, ruta, "muy_largo", "debe tener como máximo " + e["max"] + " caracteres", e["max"]) } }
        si (e["correo"]) { si (_es_correo(v) == falso) { _es_error(errores, ruta, "correo", "no es un correo válido") } }
        si (e["patron"] != nulo) { si (regex_coincidir("^(" + e["patron"] + ")$", v) == falso) { _es_error(errores, ruta, "patron", "no tiene el formato esperado") } }
    }
    si (t == "numero" o t == "entero") {
        si (tipo(v) != "numero") { _es_error(errores, ruta, "tipo", "debe ser un número")  retornar nulo }
        si (t == "entero") { si (piso(v) != v) { _es_error(errores, ruta, "entero", "debe ser un número entero")  retornar nulo } }
        si (e["min"] != nulo) { si (v < e["min"]) { _es_error(errores, ruta, "muy_pequeno", "debe ser al menos " + e["min"], e["min"]) } }
        si (e["max"] != nulo) { si (v > e["max"]) { _es_error(errores, ruta, "muy_grande", "debe ser como máximo " + e["max"], e["max"]) } }
    }
    si (t == "booleano") {
        si (tipo(v) != "booleano") { _es_error(errores, ruta, "tipo", "debe ser verdadero o falso")  retornar nulo }
    }
    si (e["opciones"] != nulo) {
        sea esta = falso
        para o en e["opciones"] { si (o == v) { esta = verdadero } }
        si (esta == falso) { _es_error(errores, ruta, "opcion", "debe ser uno de: " + unir(e["opciones"], ", "), unir(e["opciones"], ", ")) }
    }
    si (t == "lista") {
        si (tipo(v) != "lista") { _es_error(errores, ruta, "tipo", "debe ser una lista")  retornar nulo }
        si (e["min"] != nulo) { si (longitud(v) < e["min"]) { _es_error(errores, ruta, "muy_corto", "debe tener al menos " + e["min"] + " elementos", e["min"]) } }
        si (e["max"] != nulo) { si (longitud(v) > e["max"]) { _es_error(errores, ruta, "muy_largo", "debe tener como máximo " + e["max"] + " elementos", e["max"]) } }
        sea r = []
        sea i = 0
        mientras (i < longitud(v)) {
            r.agregar(_es_validar(e["elemento"], v[i], _es_ruta(ruta, i), errores))
            i = i + 1
        }
        retornar r
    }
    si (t == "objeto") {
        si (tipo(v) != "mapa") { _es_error(errores, ruta, "tipo", "debe ser un objeto")  retornar nulo }
        sea r = {}
        para k en claves(e["campos"]) {
            sea x = nulo
            si (tiene_clave(v, k)) { x = v[k] }
            sea limpio = _es_validar(e["campos"][k], x, _es_ruta(ruta, k), errores)
            si (limpio != nulo) { r[k] = limpio }
        }
        para k en claves(v) {
            si (tiene_clave(e["campos"], k) == falso) {
                si (e["estricto"]) { _es_error(errores, _es_ruta(ruta, k), "desconocido", "clave no permitida") }
            }
        }
        retornar r
    }
    retornar v
}

/// Valida sin lanzar. Las claves no declaradas se descartan del valor limpio.
funcion esquema_validar(e, valor) {
    sea errores = []
    sea limpio = _es_validar(e, valor, "", errores)
    retornar {"ok": longitud(errores) == 0, "valor": limpio, "errores": errores}
}

/// Devuelve el valor limpio o lanza "ruta: mensaje" del primer error.
funcion esquema_analizar(e, valor) {
    sea r = esquema_validar(e, valor)
    si (r["ok"] == falso) { lanzar r["errores"][0]["ruta"] + ": " + r["errores"][0]["mensaje"] }
    retornar r["valor"]
}
