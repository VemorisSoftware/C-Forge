// stdlib/tailwind.cfv — utilidades de estilo: nombres en inglés del módulo "estilos".
// English names for the "estilos" module; both can be used together.


importar "estilos"

funcion _tailwind_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_tailwind_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _tailwind_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _TAILWIND_OPT = {"theme": "tema", "root": "raiz", "properties": "propiedades"}

funcion tailwind_theme(nombre) { retornar estilos_tema(nombre) }
funcion tailwind_rule(clase, ctx_) { retornar estilos_regla(clase, ctx_) }
funcion tailwind_candidates(texto) { retornar estilos_clases(texto) }
funcion tailwind_css(entrada, opciones) { retornar estilos_css(entrada, _tailwind_opt(opciones)) }
funcion tailwind_unknown(entrada) { retornar estilos_desconocidas(entrada) }
funcion tw_merge(partes) { retornar estilos_unir(partes) }

funcion _tailwind_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_TAILWIND_OPT[k] ?? k] = o[k] }
    retornar r
}
