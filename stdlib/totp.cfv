// stdlib/totp.cfv — segundo factor (TOTP/HOTP): nombres en inglés del módulo "segundo_factor".
// English names for the "segundo_factor" module; both can be used together.

importar "segundo_factor"

funcion totp_base32(bytes) { retornar segundo_factor_base32(bytes) }
funcion totp_from_base32(texto) { retornar segundo_factor_desde_base32(texto) }
funcion totp_secret(bytes_n) { retornar segundo_factor_secreto(bytes_n) }
funcion hotp_code(secreto, contador, digitos) { retornar segundo_factor_hotp(secreto, contador, digitos) }
funcion totp_code(secreto, ms, paso_s, digitos) { retornar segundo_factor_totp(secreto, ms, paso_s, digitos) }
funcion totp_verify(secreto, codigo, ventana, ms, paso_s) { retornar segundo_factor_verificar(secreto, codigo, ventana, ms, paso_s) }
funcion totp_uri(secreto, cuenta, emisor) { retornar segundo_factor_uri(secreto, cuenta, emisor) }
funcion totp_backup_codes(n) { retornar segundo_factor_respaldo(n) }
