// stdlib/indicadores.cfv — análisis técnico para series de precios: SMA,
// EMA, RSI (Wilder), MACD, Bandas de Bollinger, ATR, estocástico, OBV,
// VWAP, máximos/mínimos y retornos. Los primeros valores sin datos
// suficientes son nulo (igual que TA-Lib: la serie conserva su largo).
// Inspirada en TA-Lib (BSD). En inglés: importar "ta".
//
//   importar "indicadores"
//   sea cierres = [44.34, 44.09, 44.15, …]
//   indicadores_rsi(cierres, 14)
//   sea m = indicadores_macd(cierres)          // {"macd", "senal", "histograma"}
//   sea b = indicadores_bollinger(cierres, 20, 2)   // {"media", "superior", "inferior"}

sea _TA_EN = {"alto": "high", "bajo": "low", "cierre": "close", "volumen": "volume"}

// Campo de una vela en español o inglés.
funcion _ta_c(vela, k) {
    si (tiene_clave(vela, k)) { retornar vela[k] }
    retornar vela[_TA_EN[k]]
}

funcion _ta_nulos(n) {
    sea r = []
    sea i = 0
    mientras (i < n) { r.agregar(nulo)  i = i + 1 }
    retornar r
}

funcion _ta_periodo(p, xs) {
    si (p < 1) { lanzar "indicadores: el periodo debe ser al menos 1" }
    si (tipo(xs) != "lista") { lanzar "indicadores: se esperaba una lista de precios" }
}

/// Media móvil simple.
funcion indicadores_sma(xs, periodo) {
    _ta_periodo(periodo, xs)
    sea r = _ta_nulos(longitud(xs))
    sea s = 0
    sea i = 0
    mientras (i < longitud(xs)) {
        s = s + xs[i]
        si (i >= periodo) { s = s - xs[i - periodo] }
        si (i >= periodo - 1) { r[i] = s / periodo }
        i = i + 1
    }
    retornar r
}

/// Media móvil exponencial (semilla = SMA del primer periodo). Ignora
/// nulos iniciales (para encadenar indicadores).
funcion indicadores_ema(xs, periodo, alfa) {
    _ta_periodo(periodo, xs)
    sea k = alfa ?? (2 / (periodo + 1))
    sea r = _ta_nulos(longitud(xs))
    sea inicio = 0
    mientras (inicio < longitud(xs) y xs[inicio] == nulo) { inicio = inicio + 1 }
    si (longitud(xs) - inicio < periodo) { retornar r }
    sea s = 0
    sea i = inicio
    mientras (i < inicio + periodo) { s = s + xs[i]  i = i + 1 }
    sea e = s / periodo
    r[inicio + periodo - 1] = e
    i = inicio + periodo
    mientras (i < longitud(xs)) {
        e = xs[i] * k + e * (1 - k)
        r[i] = e
        i = i + 1
    }
    retornar r
}

/// RSI de Wilder (0–100).
funcion indicadores_rsi(xs, periodo) {
    sea p = periodo ?? 14
    _ta_periodo(p, xs)
    sea r = _ta_nulos(longitud(xs))
    si (longitud(xs) <= p) { retornar r }
    sea ganancia = 0
    sea perdida = 0
    sea i = 1
    mientras (i <= p) {
        sea d = xs[i] - xs[i - 1]
        si (d > 0) { ganancia = ganancia + d } sino { perdida = perdida - d }
        i = i + 1
    }
    ganancia = ganancia / p
    perdida = perdida / p
    sea rsi = funcion(g, l) {
        si (l == 0) { si (g == 0) { retornar 50 }  retornar 100 }
        retornar 100 - 100 / (1 + g / l)
    }
    r[p] = rsi(ganancia, perdida)
    mientras (i < longitud(xs)) {
        sea d = xs[i] - xs[i - 1]
        sea g = 0
        sea l = 0
        si (d > 0) { g = d } sino { l = 0 - d }
        ganancia = (ganancia * (p - 1) + g) / p
        perdida = (perdida * (p - 1) + l) / p
        r[i] = rsi(ganancia, perdida)
        i = i + 1
    }
    retornar r
}

/// MACD (rápida 12, lenta 26, señal 9).
funcion indicadores_macd(xs, rapida, lenta, senal) {
    sea a = indicadores_ema(xs, rapida ?? 12)
    sea b = indicadores_ema(xs, lenta ?? 26)
    sea m = []
    sea i = 0
    mientras (i < longitud(xs)) {
        si (a[i] == nulo o b[i] == nulo) { m.agregar(nulo) } sino { m.agregar(a[i] - b[i]) }
        i = i + 1
    }
    sea s = indicadores_ema(m, senal ?? 9)
    sea h = []
    i = 0
    mientras (i < longitud(xs)) {
        si (m[i] == nulo o s[i] == nulo) { h.agregar(nulo) } sino { h.agregar(m[i] - s[i]) }
        i = i + 1
    }
    retornar {"macd": m, "senal": s, "histograma": h}
}

/// Bandas de Bollinger (desviación poblacional, como TA-Lib).
funcion indicadores_bollinger(xs, periodo, k) {
    sea p = periodo ?? 20
    sea f = k ?? 2
    sea media = indicadores_sma(xs, p)
    sea sup = _ta_nulos(longitud(xs))
    sea inf = _ta_nulos(longitud(xs))
    sea i = p - 1
    mientras (i < longitud(xs)) {
        sea v = 0
        sea j = i - p + 1
        mientras (j <= i) { v = v + (xs[j] - media[i]) * (xs[j] - media[i])  j = j + 1 }
        sea d = raiz(v / p)
        sup[i] = media[i] + f * d
        inf[i] = media[i] - f * d
        i = i + 1
    }
    retornar {"media": media, "superior": sup, "inferior": inf}
}

/// Rango verdadero promedio (Wilder). velas: [{"alto", "bajo", "cierre"}]
/// (o high, low, close).
funcion indicadores_atr(velas, periodo) {
    sea p = periodo ?? 14
    sea n = longitud(velas)
    sea r = _ta_nulos(n)
    si (n <= p) { retornar r }
    sea tr = [_ta_c(velas[0], "alto") - _ta_c(velas[0], "bajo")]
    sea i = 1
    mientras (i < n) {
        sea a = _ta_c(velas[i], "alto") - _ta_c(velas[i], "bajo")
        sea b = absoluto(_ta_c(velas[i], "alto") - _ta_c(velas[i - 1], "cierre"))
        sea c = absoluto(_ta_c(velas[i], "bajo") - _ta_c(velas[i - 1], "cierre"))
        tr.agregar(maximo(a, maximo(b, c)))
        i = i + 1
    }
    sea s = 0
    i = 1
    mientras (i <= p) { s = s + tr[i]  i = i + 1 }
    sea atr = s / p
    r[p] = atr
    mientras (i < n) {
        atr = (atr * (p - 1) + tr[i]) / p
        r[i] = atr
        i = i + 1
    }
    retornar r
}

/// Oscilador estocástico %K y %D.
funcion indicadores_estocastico(velas, periodo, suavizado) {
    sea p = periodo ?? 14
    sea n = longitud(velas)
    sea k = _ta_nulos(n)
    sea i = p - 1
    mientras (i < n) {
        sea hi = _ta_c(velas[i], "alto")
        sea lo = _ta_c(velas[i], "bajo")
        sea j = i - p + 1
        mientras (j <= i) { hi = maximo(hi, _ta_c(velas[j], "alto"))  lo = minimo(lo, _ta_c(velas[j], "bajo"))  j = j + 1 }
        si (hi == lo) { k[i] = 50 } sino { k[i] = 100 * (_ta_c(velas[i], "cierre") - lo) / (hi - lo) }
        i = i + 1
    }
    sea d = _ta_nulos(n)
    sea q = suavizado ?? 3
    i = p - 1 + q - 1
    mientras (i < n) {
        sea s = 0
        sea j = i - q + 1
        mientras (j <= i) { s = s + k[j]  j = j + 1 }
        d[i] = s / q
        i = i + 1
    }
    retornar {"k": k, "d": d}
}

/// On-balance volume.
funcion indicadores_obv(cierres, volumenes) {
    sea r = [0]
    sea i = 1
    mientras (i < longitud(cierres)) {
        sea v = r[i - 1]
        si (cierres[i] > cierres[i - 1]) { v = v + volumenes[i] }
        si (cierres[i] < cierres[i - 1]) { v = v - volumenes[i] }
        r.agregar(v)
        i = i + 1
    }
    retornar r
}

/// Precio medio ponderado por volumen acumulado.
funcion indicadores_vwap(velas) {
    sea r = []
    sea pv = 0
    sea vol = 0
    para v en velas {
        sea tipico = (_ta_c(v, "alto") + _ta_c(v, "bajo") + _ta_c(v, "cierre")) / 3
        pv = pv + tipico * _ta_c(v, "volumen")
        vol = vol + _ta_c(v, "volumen")
        si (vol == 0) { r.agregar(nulo) } sino { r.agregar(pv / vol) }
    }
    retornar r
}

/// Retornos simples (o logarítmicos) entre precios consecutivos.
funcion indicadores_retornos(xs, logaritmicos) {
    sea r = [nulo]
    sea i = 1
    mientras (i < longitud(xs)) {
        si (logaritmicos == verdadero) { r.agregar(logaritmo(xs[i] / xs[i - 1])) } sino { r.agregar(xs[i] / xs[i - 1] - 1) }
        i = i + 1
    }
    retornar r
}

/// Caída máxima desde un pico (0.25 = −25 %).
funcion indicadores_caida_maxima(xs) {
    sea pico = xs[0]
    sea peor = 0
    para x en xs {
        si (x > pico) { pico = x }
        si ((pico - x) / pico > peor) { peor = (pico - x) / pico }
    }
    retornar peor
}

/// Cruces: lista de [índice, "alza" | "baja"] cuando a cruza a b.
funcion indicadores_cruces(a, b) {
    sea r = []
    sea i = 1
    mientras (i < longitud(a)) {
        si (a[i] != nulo y b[i] != nulo y a[i - 1] != nulo y b[i - 1] != nulo) {
            si (a[i - 1] <= b[i - 1] y a[i] > b[i]) { r.agregar([i, "alza"]) }
            si (a[i - 1] >= b[i - 1] y a[i] < b[i]) { r.agregar([i, "baja"]) }
        }
        i = i + 1
    }
    retornar r
}
