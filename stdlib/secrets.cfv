// stdlib/secrets.cfv — secretos cifrados en el repositorio: nombres en inglés del módulo "secretos".
// English names for the "secretos" module; both can be used together.

importar "secretos"

funcion secrets_key() { retornar secretos_clave() }
funcion secrets_is_encrypted(v) { retornar secretos_es_cifrado(v) }
funcion secrets_encrypt_json(datos, clave, en_claro) { retornar secretos_cifrar_json(datos, clave, en_claro) }
funcion secrets_decrypt_json(texto, clave) { retornar secretos_descifrar_json(texto, clave) }
funcion secrets_encrypt_env(texto, clave, en_claro) { retornar secretos_cifrar_env(texto, clave, en_claro) }
funcion secrets_decrypt_env(texto, clave) { retornar secretos_descifrar_env(texto, clave) }
funcion secrets_rotate_json(texto, vieja, nueva) { retornar secretos_rotar_json(texto, vieja, nueva) }
