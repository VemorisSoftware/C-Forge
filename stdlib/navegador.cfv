// stdlib/navegador.cfv — el navegador desde C-Forge (cforge build --target wasm).
// El cargador generado (app.mjs) trae estas funciones; no hace falta escribir
// JavaScript. Las funciones de C-Forge que se pasan (animar, al hacer clic…)
// reciben un entero: el tiempo en ms o 0.
//
//   importar "navegador"
//   nav_texto("#titulo", "Hola desde C-Forge")
//   nav_al_hacer("#boton", "click", funcion(x) { nav_texto("#contador", "clic") })
//   nav_animar(funcion(t) { nav_estilo("#caja", "transform", "rotate(" + cociente(t, 10) + "deg)") })
//
// Datos del evento: nav_evento("tecla" | "id" | "x" | "y" | "valor" | "tipo"),
// atajos con nav_al_tecla("Escape", f), arrastrar y soltar con
// nav_al_soltar(origenes, destinos, f) y estilos con nav_css("…").
// cforge build app.cfv --target wasm --html genera también app.html.
//
// Lienzo 2D: nav_lienzo("#lienzo"), nav_limpiar(color), nav_rect(...),
// nav_circulo(...), nav_linea(...), nav_escribir(...).
// Lienzo 2D avanzado: degradados (nav_relleno_lineal, nav_relleno_radial
// con paradas "0 #fff; 1 rgba(0,0,0,.5)"), rutas (nav_ruta_nueva, _mover,
// _linea, _arco, _rombo, _cerrar → nav_rellenar, nav_trazar, nav_recortar),
// nav_guardar/nav_restaurar, nav_alfa, nav_mezcla, nav_sombra y nav_grano
// (ruido de película sobre todo el lienzo).
// Varios elementos: nav_cuantos(sel), nav_clase_n(sel, i, …),
// nav_estilo_n(sel, i, …) y nav_caja(sel, i, "arriba"|"alto"…) para saber
// dónde está en pantalla. nav_medio("(prefers-reduced-motion: reduce)").
// Partículas WebGL (miles a 60 FPS): nav_particulas("#lienzo", x, y, z, calor)
// con listas de enteros en milésimas de unidad; ver ejemplos/web/particulas.

// Las externas viven dentro de una función que nunca se llama: así un
// programa nativo que importa este módulo no busca "libnavegador" al iniciar.
funcion nav_externas() {
    extern "navegador" funcion nav_texto(selector: texto, valor: texto)
    // nav_html inserta HTML tal cual (innerHTML): úsalo solo con HTML propio.
    // Para mostrar datos del usuario o de la red usa nav_texto, que no
    // interpreta HTML y evita XSS.
    extern "navegador" funcion nav_html(selector: texto, valor: texto)
    extern "navegador" funcion nav_estilo(selector: texto, propiedad: texto, valor: texto)
    extern "navegador" funcion nav_atributo(selector: texto, nombre: texto, valor: texto)
    extern "navegador" funcion nav_clase(selector: texto, clase: texto, activa: booleano)
    extern "navegador" funcion nav_valor(selector: texto): texto
    extern "navegador" funcion nav_consola(valor: texto)
    extern "navegador" funcion nav_ancho(): entero
    extern "navegador" funcion nav_alto(): entero
    extern "navegador" funcion nav_scroll(): entero
    extern "navegador" funcion nav_scroll_y(): entero
    extern "navegador" funcion nav_mouse_x(): entero
    extern "navegador" funcion nav_mouse_y(): entero
    extern "navegador" funcion nav_mouse_activo(): booleano
    extern "navegador" funcion nav_tiempo(): numero
    extern "navegador" funcion nav_dato(): entero
    extern "navegador" funcion nav_registrar_animacion(id: entero)
    extern "navegador" funcion nav_registrar_evento(selector: texto, evento: texto, id: entero)
    extern "navegador" funcion nav_evento(campo: texto): texto
    extern "navegador" funcion nav_registrar_tecla(tecla: texto, id: entero)
    extern "navegador" funcion nav_registrar_arrastre(origenes: texto, destinos: texto, id: entero)
    extern "navegador" funcion nav_css(css: texto)
    extern "navegador" funcion nav_lienzo(selector: texto): entero
    extern "navegador" funcion nav_limpiar(color: texto)
    extern "navegador" funcion nav_rect(x: numero, y: numero, ancho: numero, alto: numero, color: texto)
    extern "navegador" funcion nav_circulo(x: numero, y: numero, radio: numero, color: texto)
    extern "navegador" funcion nav_linea(x1: numero, y1: numero, x2: numero, y2: numero, grosor: numero, color: texto)
    extern "navegador" funcion nav_escribir(x: numero, y: numero, texto_: texto, tamano: numero, color: texto)
    extern "navegador" funcion nav_particulas_crudo(selector: texto, x: puntero, y: puntero, z: puntero, calor: puntero, n: entero)
    extern "navegador" funcion nav_lienzo_pintar(selector: texto, pixeles: puntero, ancho: entero, alto: entero)
    extern "navegador" funcion nav_cuantos(selector: texto): entero
    extern "navegador" funcion nav_clase_n(selector: texto, i: entero, clase: texto, activa: booleano)
    extern "navegador" funcion nav_estilo_n(selector: texto, i: entero, propiedad: texto, valor: texto)
    extern "navegador" funcion nav_caja(selector: texto, i: entero, campo: texto): numero
    extern "navegador" funcion nav_medio(consulta: texto): booleano
    extern "navegador" funcion nav_lienzo_alto(): entero
    extern "navegador" funcion nav_relleno(color: texto)
    extern "navegador" funcion nav_trazo(color: texto, grosor: numero)
    extern "navegador" funcion nav_relleno_lineal(x0: numero, y0: numero, x1: numero, y1: numero, paradas: texto)
    extern "navegador" funcion nav_relleno_radial(x0: numero, y0: numero, r0: numero, x1: numero, y1: numero, r1: numero, paradas: texto)
    extern "navegador" funcion nav_rellenar_rect(x: numero, y: numero, ancho: numero, alto: numero)
    extern "navegador" funcion nav_ruta_nueva()
    extern "navegador" funcion nav_ruta_mover(x: numero, y: numero)
    extern "navegador" funcion nav_ruta_linea(x: numero, y: numero)
    extern "navegador" funcion nav_ruta_arco(x: numero, y: numero, radio: numero, desde: numero, hasta: numero, antihorario: booleano)
    extern "navegador" funcion nav_ruta_rombo(x: numero, y: numero, ancho: numero, alto: numero)
    extern "navegador" funcion nav_ruta_cerrar()
    extern "navegador" funcion nav_rellenar()
    extern "navegador" funcion nav_trazar()
    extern "navegador" funcion nav_recortar()
    extern "navegador" funcion nav_guardar()
    extern "navegador" funcion nav_restaurar()
    extern "navegador" funcion nav_alfa(alfa: numero)
    extern "navegador" funcion nav_mezcla(modo: texto)
    extern "navegador" funcion nav_sombra(color: texto, desenfoque: numero)
    extern "navegador" funcion nav_grano(alfa: numero, dx: numero, dy: numero, modo: texto)
}

sea NAV_FUNCIONES = []

funcion nav_registrar(f) {
    NAV_FUNCIONES.agregar(f)
    retornar longitud(NAV_FUNCIONES) - 1
}

// JavaScript llama aquí (por nombre) para ejecutar una función registrada.
funcion navegador_despachar(id) {
    retornar NAV_FUNCIONES[id](nav_dato())
}

// f(t) en cada cuadro de la pantalla (requestAnimationFrame).
funcion nav_animar(f) {
    nav_registrar_animacion(nav_registrar(f))
}

// f(0) cuando ocurre el evento ("click", "input", "scroll"…) en el selector.
funcion nav_al_hacer(selector, evento, f) {
    nav_registrar_evento(selector, evento, nav_registrar(f))
}

// f(0) al pulsar esa tecla en cualquier parte de la página ("Escape",
// "Enter", "ArrowLeft"…). La tecla también está en nav_evento("tecla").
funcion nav_al_tecla(tecla, f) {
    nav_registrar_tecla(tecla, nav_registrar(f))
}

// Arrastrar y soltar: los elementos de "origenes" se pueden arrastrar y, al
// soltarlos sobre uno de "destinos", se llama f(0); nav_evento("origen") y
// nav_evento("destino") dan sus id. Funciona con elementos creados después.
//   nav_al_soltar(".tarjeta", ".columna", funcion(x) {
//       mover(nav_evento("origen"), nav_evento("destino"))
//   })
funcion nav_al_soltar(origenes, destinos, f) {
    nav_registrar_arrastre(origenes, destinos, nav_registrar(f))
}

// Dibuja las listas como partículas brillantes (WebGL2). Las listas no deben
// crecer después de la primera llamada.
funcion nav_particulas(selector, x, y, z, calor) {
    nav_particulas_crudo(selector, lista_direccion(x), lista_direccion(y), lista_direccion(z), lista_direccion(calor), longitud(x))
}

// Muestra en un <canvas> un lienzo de graficos.cfv (RGBA rasterizado en
// C-Forge: 2D, 3D por software, texto TrueType e imágenes).
funcion nav_mostrar_lienzo(selector, l) {
    nav_lienzo_pintar(selector, bytes_direccion(l["pixeles"]), l["ancho"], l["alto"])
}
