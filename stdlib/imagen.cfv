// stdlib/imagen.cfv — imágenes RGBA en C-Forge puro (sin libpng, libjpeg,
// stb_image ni SDL_image).
//
// Una imagen es un mapa {"ancho", "alto", "pixeles"}: píxeles RGBA de 8 bits,
// fila por fila, de arriba abajo. Formatos:
//   · PNG: lectura de todos los tipos (1–16 bits, paleta, tRNS, Adam7) y
//     escritura con filtros adaptativos y deflate con Huffman dinámico.
//   · JPEG: lectura baseline y progresiva (4:4:4, 4:2:2, 4:2:0, gris, CMYK).
//   · BMP: lectura de 8, 24 y 32 bits.
//
//   importar "imagen"
//   sea img = imagen_cargar("foto.jpg")
//   imagen_guardar(imagen_escalar(img, 320, 200), "mini.png")

funcion imagen_nueva(ancho, alto, color = nulo) {
    si (ancho <= 0 o alto <= 0) { lanzar "imagen_nueva: dimensiones inválidas" }
    sea img = {"ancho": piso(ancho), "alto": piso(alto), "pixeles": lienzo_nuevo_buffer(ancho, alto)}
    si (color != nulo) { lienzo_llenar(img["pixeles"], img["ancho"], img["alto"], color[0], color[1], color[2], _imagen_alfa(color)) }
    retornar img
}

funcion _imagen_alfa(color) {
    si (longitud(color) > 3) { retornar color[3] }
    retornar 255
}

funcion _imagen_de_lista(r) { retornar {"ancho": r[0], "alto": r[1], "pixeles": r[2]} }

// Formato por la firma de los bytes: "png", "jpeg", "bmp" o nulo.
funcion imagen_formato(datos) {
    si (longitud(datos) >= 8 y byte_en(datos, 0) == 137 y subtexto(datos, 1, 4) == "PNG") { retornar "png" }
    si (longitud(datos) >= 3 y byte_en(datos, 0) == 255 y byte_en(datos, 1) == 216) { retornar "jpeg" }
    si (longitud(datos) >= 2 y subtexto(datos, 0, 2) == "BM") { retornar "bmp" }
    retornar nulo
}

funcion imagen_decodificar(datos) {
    sea f = imagen_formato(datos)
    si (f == "png") { retornar _imagen_de_lista(png_decodificar(datos)) }
    si (f == "jpeg") { retornar _imagen_de_lista(jpeg_decodificar(datos)) }
    si (f == "bmp") { retornar _imagen_de_lista(bmp_decodificar(datos)) }
    lanzar "imagen_decodificar: formato no reconocido (se admite PNG, JPEG y BMP)"
}

funcion imagen_cargar(ruta) {
    si (existe_archivo(ruta) == falso) { lanzar "imagen_cargar: no existe " + ruta }
    retornar imagen_decodificar(leer_archivo(ruta))
}

// PNG con compresión 0–9 (6 por defecto).
funcion imagen_codificar_png(img, nivel = 6) {
    retornar png_codificar(img["pixeles"], img["ancho"], img["alto"], nivel)
}

funcion imagen_guardar(img, ruta, nivel = 6) {
    escribir_archivo(ruta, imagen_codificar_png(img, nivel))
    retornar ruta
}

funcion imagen_pixel(img, x, y) {
    sea i = (piso(y) * img["ancho"] + piso(x)) * 4
    sea p = img["pixeles"]
    retornar [byte_en(p, i), byte_en(p, i + 1), byte_en(p, i + 2), byte_en(p, i + 3)]
}

funcion imagen_fijar_pixel(img, x, y, color) {
    lienzo_fijar_pixel(img["pixeles"], img["ancho"], img["alto"], x, y, color[0], color[1], color[2], _imagen_alfa(color))
    retornar img
}

funcion imagen_copiar(img) {
    sea nueva = imagen_nueva(img["ancho"], img["alto"])
    lienzo_copiar(nueva["pixeles"], nueva["ancho"], nueva["alto"], img["pixeles"], img["ancho"], img["alto"], [0, 0, img["ancho"], img["alto"], 0, 0, img["ancho"], img["alto"], 255, 0, 255, 255, 255])
    retornar nueva
}

// Escala con filtro bilineal (o vecino más cercano si suave es falso).
funcion imagen_escalar(img, ancho, alto, suave = verdadero) {
    sea nueva = imagen_nueva(ancho, alto)
    sea bil = 0
    si (suave) { bil = 1 }
    lienzo_copiar(nueva["pixeles"], nueva["ancho"], nueva["alto"], img["pixeles"], img["ancho"], img["alto"], [0, 0, nueva["ancho"], nueva["alto"], 0, 0, img["ancho"], img["alto"], 255, bil, 255, 255, 255])
    retornar nueva
}

funcion imagen_recortar(img, x, y, ancho, alto) {
    si (x < 0 o y < 0 o x + ancho > img["ancho"] o y + alto > img["alto"]) { lanzar "imagen_recortar: el recorte sale de la imagen" }
    sea nueva = imagen_nueva(ancho, alto)
    lienzo_copiar(nueva["pixeles"], ancho, alto, img["pixeles"], img["ancho"], img["alto"], [0, 0, ancho, alto, x, y, ancho, alto, 255, 0, 255, 255, 255])
    retornar nueva
}

// Resumen SHA-256 de los píxeles (útil para pruebas de render).
funcion imagen_huella(img) { retornar hex_de_bytes(sha256_bytes(img["pixeles"])) }
