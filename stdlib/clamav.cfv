// stdlib/clamav.cfv — Escáner de firmas (estilo ClamAV): nombres en inglés del módulo "antivirus".
// English names for the "antivirus" module; both can be used together.


importar "antivirus"

funcion _clamav_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_clamav_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _clamav_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _CLAMAV_RES = {"firma": "signature", "tipo": "type", "desplazamiento": "offset", "dentro": "inside", "ruta": "path", "infectado": "infected", "firmas": "signatures", "detalle": "details", "archivos": "files", "infectados": "infected", "hash": "hash", "hex": "hex", "logica": "logical"}
sea _CLAMAV_OPT = {"depth": "profundidad"}

funcion clam_engine(opciones) { retornar antivirus_base(_clamav_opt(opciones)) }
funcion clam_signature_count(base) { retornar antivirus_cuantas(base) }
funcion clam_load(base, texto, formato) { retornar antivirus_cargar(base, texto, formato) }
funcion clam_load_file(base, ruta) { retornar antivirus_cargar_archivo(base, ruta) }
funcion clam_scan(base, datos) { retornar antivirus_escanear(base, datos) }
funcion clam_scan_details(base, datos) { retornar _clamav_tr(antivirus_detalle(base, datos), _CLAMAV_RES) }
funcion clam_scan_file(base, ruta) { retornar _clamav_tr(antivirus_escanear_archivo(base, ruta), _CLAMAV_RES) }
funcion clam_scan_dir(base, carpeta, solo_infectados) { retornar _clamav_tr(antivirus_escanear_carpeta(base, carpeta, solo_infectados), _CLAMAV_RES) }
funcion clam_summary(resultados) { retornar _clamav_tr(antivirus_resumen(resultados), _CLAMAV_RES) }
funcion clam_md5_signature(datos, nombre) { retornar antivirus_firma_md5(datos, nombre) }
funcion clam_sha256_signature(datos, nombre) { retornar antivirus_firma_sha256(datos, nombre) }
funcion clam_hex_signature(datos, nombre) { retornar antivirus_firma_hex(datos, nombre) }

funcion _clamav_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_CLAMAV_OPT[k] ?? k] = o[k] }
    retornar r
}
