// stdlib/leptonica.cfv — Documentos escaneados (estilo Leptonica): nombres en inglés del módulo "escaner".
// English names for the "escaner" module; both can be used together.

importar "escaner"

funcion _leptonica_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_leptonica_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _leptonica_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _LEPTONICA_RES = {"angulo": "angle", "confianza": "confidence", "imagen": "image"}

funcion pix_otsu(g) { retornar escaner_otsu(g) }
funcion pix_sauvola(g, ventana, k, r) { retornar escaner_sauvola(g, ventana, k, r) }
funcion pix_sauvola_threshold(g, ventana, k, r) { retornar escaner_sauvola_umbral(g, ventana, k, r) }
funcion pix_find_skew(b, rango, paso) { retornar _leptonica_tr(escaner_inclinacion(b, rango, paso), _LEPTONICA_RES) }
funcion pix_rotate(g, grados) { retornar escaner_rotar(g, grados) }
funcion pix_deskew(g, rango) { retornar _leptonica_tr(escaner_enderezar(g, rango), _LEPTONICA_RES) }
funcion pix_dilate_brick(b, alto, ancho) { retornar escaner_dilatar(b, alto, ancho) }
funcion pix_erode_brick(b, alto, ancho) { retornar escaner_erosionar(b, alto, ancho) }
funcion pix_close_brick(b, alto, ancho) { retornar escaner_cerrar(b, alto, ancho) }
funcion pix_open_brick(b, alto, ancho) { retornar escaner_abrir(b, alto, ancho) }
funcion pix_content_box(b) { retornar escaner_caja_contenido(b) }
funcion pix_clip_margins(g, b, margen) { retornar escaner_recortar_margenes(g, b, margen) }
funcion pix_text_lines(b, minimo_) { retornar escaner_renglones(b, minimo_) }
funcion pix_text_blocks(b, separacion_x, separacion_y) { retornar escaner_bloques(b, separacion_x, separacion_y) }
