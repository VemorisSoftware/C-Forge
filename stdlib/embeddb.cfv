// stdlib/embeddb.cfv — base de datos embebida ACID: nombres en inglés del módulo "cofre".
// English names for the "cofre" module; both can be used together.


importar "cofre"

funcion _embeddb_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_embeddb_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _embeddb_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _EMBEDDB_RES = {"paginas": "pages", "libres": "free_pages"}
sea _EMBEDDB_OPT = {"from": "desde", "to": "hasta", "reverse": "inverso", "limit": "limite", "prefix": "prefijo"}

funcion embeddb_open(ruta, opciones) { retornar cofre_abrir(ruta, _embeddb_opt(opciones)) }
funcion embeddb_close(db) { retornar cofre_cerrar(db) }
funcion embeddb_update(db, fn) { retornar cofre_escribir(db, fn) }
funcion embeddb_view(db, fn) { retornar cofre_leer(db, fn) }
funcion embeddb_put(tx, tabla, clave, valor) { retornar cofre_poner(tx, tabla, clave, valor) }
funcion embeddb_get(tx, tabla, clave) { retornar cofre_obtener(tx, tabla, clave) }
funcion embeddb_delete(tx, tabla, clave) { retornar cofre_borrar(tx, tabla, clave) }
funcion embeddb_range(tx, tabla, opciones) { retornar cofre_rango(tx, tabla, _embeddb_opt(opciones)) }
funcion embeddb_count(tx, tabla) { retornar cofre_contar(tx, tabla) }
funcion embeddb_buckets(tx) { retornar cofre_tablas(tx) }
funcion embeddb_drop_bucket(tx, tabla) { retornar cofre_borrar_tabla(tx, tabla) }
funcion embeddb_stats(db) { retornar _embeddb_tr(cofre_estado(db), _EMBEDDB_RES) }

funcion _embeddb_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_EMBEDDB_OPT[k] ?? k] = o[k] }
    retornar r
}
