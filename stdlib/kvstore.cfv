// stdlib/kvstore.cfv — clave-valor en disco (LSM): nombres en inglés del módulo "archivo_kv".
// English names for the "archivo_kv" module; both can be used together.


importar "archivo_kv"

funcion _kvstore_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_kvstore_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _kvstore_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _KVSTORE_RES = {"secuencia": "sequence", "memtable_claves": "memtable_keys", "tablas_por_nivel": "tables_per_level", "estadisticas": "stats", "escrituras": "writes", "lecturas": "reads", "vaciados": "flushes", "compactaciones": "compactions"}
sea _KVSTORE_OPT = {"memtable_bytes": "memtable_bytes", "block_bytes": "bloque_bytes", "l0_tables": "tablas_l0", "level_factor": "factor_nivel", "sync": "sincronizar", "merge": "combinar", "from": "desde", "to": "hasta", "prefix": "prefijo", "limit": "limite", "reverse": "inverso", "snapshot": "instantanea"}

funcion kvstore_open(ruta, opciones) { retornar kv_abrir(ruta, _kvstore_opt(opciones)) }
funcion kvstore_batch(db, ops) { retornar kv_lote(db, ops) }
funcion kvstore_put(db, clave, valor) { retornar kv_poner(db, clave, valor) }
funcion kvstore_delete(db, clave) { retornar kv_borrar(db, clave) }
funcion kvstore_merge(db, clave, operando) { retornar kv_combinar(db, clave, operando) }
funcion kvstore_get(db, clave, instantanea) { retornar kv_obtener(db, clave, instantanea) }
funcion kvstore_has(db, clave) { retornar kv_existe(db, clave) }
funcion kvstore_snapshot(db) { retornar kv_instantanea(db) }
funcion kvstore_release(db, s) { retornar kv_soltar(db, s) }
funcion kvstore_flush(db) { retornar kv_vaciar(db) }
funcion kvstore_compact(db, n) { retornar kv_compactar(db, n) }
funcion kvstore_range(db, opciones) { retornar kv_rango(db, _kvstore_opt(opciones)) }
funcion kvstore_count(db, opciones) { retornar kv_contar(db, _kvstore_opt(opciones)) }
funcion kvstore_stats(db) { retornar _kvstore_tr(kv_estado(db), _KVSTORE_RES) }
funcion kvstore_close(db) { retornar kv_cerrar(db) }
funcion kvstore_crash(db) { retornar kv_soltar_sin_vaciar(db) }
funcion kvstore_destroy(ruta) { retornar kv_destruir(ruta) }

funcion _kvstore_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_KVSTORE_OPT[k] ?? k] = o[k] }
    retornar r
}
