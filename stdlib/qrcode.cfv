// stdlib/qrcode.cfv — códigos QR y de barras: nombres en inglés del módulo "codigo_qr".
// English names for the "codigo_qr" module; both can be used together.

importar "codigo_qr"

funcion qr_create(texto, opciones) { retornar qr_crear(texto, opciones) }
funcion qr_module(q, x, yy) { retornar qr_modulo(q, x, yy) }
funcion qr_to_svg(q, opciones) { retornar qr_svg(q, opciones) }
funcion qr_to_text(q, margen) { retornar qr_texto(q, margen) }
funcion qr_wifi_payload(red, clave, seguridad, oculta) { retornar qr_wifi(red, clave, seguridad, oculta) }
funcion barcode_check_digit(digitos) { retornar barras_digito_control(digitos) }
funcion barcode_ean13(numero) { retornar barras_ean13(numero) }
funcion barcode_upca(numero) { retornar barras_upca(numero) }
funcion barcode_code128(texto) { retornar barras_code128(texto) }
funcion barcode_to_svg(c, opciones) { retornar barras_svg(c, opciones) }
