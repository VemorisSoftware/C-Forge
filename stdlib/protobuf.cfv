// stdlib/protobuf.cfv — Protocol Buffers y gRPC: nombres en inglés del módulo "llamada".
// English names for the "llamada" module; both can be used together.

importar "llamada"

funcion _protobuf_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_protobuf_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _protobuf_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _PROTOBUF_RES = {"ruta": "path", "cabeceras": "headers", "cuerpo": "body", "salida": "output_type", "codigo": "code", "nombre": "name", "mensaje": "message"}

funcion protobuf_schema(texto) { retornar llamada_esquema(texto) }
funcion protobuf_encode(e, mensaje, valor) { retornar llamada_codificar(e, mensaje, valor) }
funcion protobuf_decode(e, mensaje, b) { retornar llamada_decodificar(e, mensaje, b) }
funcion grpc_frame(mensaje) { retornar llamada_marco(mensaje) }
funcion grpc_unframe(cuerpo) { retornar llamada_marcos(cuerpo) }
funcion grpc_request(e, servicio, metodo, valor) { retornar _protobuf_tr(llamada_peticion(e, servicio, metodo, valor), _PROTOBUF_RES) }
funcion grpc_status(trailers) { retornar _protobuf_tr(llamada_estado(trailers), _PROTOBUF_RES) }
