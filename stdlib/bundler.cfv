// stdlib/bundler.cfv — empaquetador de JavaScript: nombres en inglés del módulo "empaca".
// English names for the "empaca" module; both can be used together.


importar "empaca"

funcion _bundler_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_bundler_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _bundler_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _BUNDLER_RES = {"codigo": "code", "modulos": "modules", "advertencias": "warnings"}
sea _BUNDLER_OPT = {"entry": "entrada", "files": "archivos", "format": "formato", "global_name": "nombre_global", "external": "externos", "minify": "compactar"}

funcion bundler_resolve(desde, esp, opciones) { retornar empaca_resolver(desde, esp, _bundler_opt(opciones)) }
funcion bundler_build(opciones) { retornar _bundler_tr(empaca_construir(_bundler_opt(opciones)), _BUNDLER_RES) }
funcion bundler_minify(codigo) { retornar empaca_compactar(codigo) }
funcion bundler_graph(opciones) { retornar empaca_grafo(_bundler_opt(opciones)) }

funcion _bundler_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_BUNDLER_OPT[k] ?? k] = o[k] }
    retornar r
}
