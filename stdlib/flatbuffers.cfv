// stdlib/flatbuffers.cfv — serialización FlatBuffers: nombres en inglés del módulo "sin_copia".
// English names for the "sin_copia" module; both can be used together.

importar "sin_copia"

funcion flatbuffers_schema(texto) { retornar sin_copia_esquema(texto) }
funcion flatbuffers_encode(esquema, valor, tipo_raiz) { retornar sin_copia_codificar(esquema, valor, tipo_raiz) }
funcion flatbuffers_root(esquema, bytes_, tipo_raiz) { retornar sin_copia_raiz(esquema, bytes_, tipo_raiz) }
funcion flatbuffers_identifier(bytes_) { retornar sin_copia_identificador(bytes_) }
funcion flatbuffers_field(obj, nombre) { retornar sin_copia_campo(obj, nombre) }
funcion flatbuffers_has(obj, nombre) { retornar sin_copia_tiene(obj, nombre) }
funcion flatbuffers_length(v) { retornar sin_copia_largo(v) }
funcion flatbuffers_element(v, i) { retornar sin_copia_elemento(v, i) }
funcion flatbuffers_to_map(obj) { retornar sin_copia_a_mapa(obj) }
funcion flatbuffers_decode(esquema, bytes_, tipo_raiz) { retornar sin_copia_decodificar(esquema, bytes_, tipo_raiz) }
