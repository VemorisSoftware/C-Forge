// stdlib/noise_protocol.cfv — el Protocolo Noise: nombres en inglés del módulo "apreton".
// English names for the "apreton" module; both can be used together.


importar "apreton"

funcion _noise_protocol_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_noise_protocol_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _noise_protocol_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _NOISE_PROTOCOL_RES = {"privada": "private", "publica": "public"}
sea _NOISE_PROTOCOL_OPT = {"static": "estatica", "remote_static": "remota", "prologue": "prologo", "ephemeral": "efimera", "hash": "hash"}

funcion noise_keypair(privada) { retornar _noise_protocol_tr(apreton_claves(privada), _NOISE_PROTOCOL_RES) }
funcion noise_new(patron, iniciador, opciones) {
    sea o = _noise_protocol_opt(opciones)
    si (o != nulo y tiene_clave(o, "estatica")) { o["estatica"] = _np_par(o["estatica"]) }
    retornar apreton_nuevo(patron, iniciador, o)
}
funcion noise_write(e, carga) { retornar apreton_escribir(e, carga) }
funcion noise_read(e, mensaje) { retornar apreton_leer(e, mensaje) }
funcion noise_is_finished(e) { retornar apreton_listo(e) }
funcion noise_remote_static(e) { retornar apreton_remota(e) }
funcion noise_handshake_hash(e) { retornar apreton_hash(e) }
funcion noise_transport(e) { retornar apreton_transporte(e) }
funcion noise_encrypt(t, datos) { retornar apreton_cifrar(t, datos) }
funcion noise_decrypt(t, datos) { retornar apreton_descifrar(t, datos) }
funcion noise_rekey(t, direccion) { retornar apreton_rekey(t, direccion) }

funcion _noise_protocol_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_NOISE_PROTOCOL_OPT[k] ?? k] = o[k] }
    retornar r
}

// Accepts English keypairs ({"private", "public"}) in options too.
funcion _np_par(k) {
    si (k == nulo) { retornar nulo }
    si (tiene_clave(k, "private")) { retornar {"privada": k["private"], "publica": k["public"]} }
    retornar k
}
