// stdlib/tokenizers.cfv — tokenización BPE y WordPiece: nombres en inglés del módulo "fichas".
// English names for the "fichas" module; both can be used together.


importar "fichas"

funcion _tokenizers_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_tokenizers_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _tokenizers_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _TOKENIZERS_RES = {"fichas": "tokens", "palabras": "word_ids", "tipos": "type_ids", "atencion": "attention_mask"}
sea _TOKENIZERS_OPT = {"add_special_tokens": "especiales", "max_length": "largo_maximo", "pad_to": "rellenar_hasta", "pad_token": "ficha_relleno", "padding": "rellenar", "vocab_size": "vocabulario", "min_frequency": "min_frecuencia", "byte_level": "nivel_bytes", "lowercase": "minusculas", "special_tokens": "especiales"}

funcion tokenizer_from_json(texto_json) { retornar fichas_cargar(texto_json) }
funcion tokenizer_encode(t, texto, par, opciones) { retornar _tokenizers_tr(fichas_codificar(t, texto, par, _tokenizers_opt(opciones)), _TOKENIZERS_RES) }
funcion tokenizer_encode_batch(t, textos, opciones) { retornar _tokenizers_tr(fichas_codificar_lote(t, textos, _tokenizers_opt(opciones)), _TOKENIZERS_RES) }
funcion tokenizer_token_to_id(t, ficha) { retornar fichas_id(t, ficha) }
funcion tokenizer_id_to_token(t, id) { retornar fichas_ficha(t, id) }
funcion tokenizer_vocab_size(t) { retornar fichas_tamano_vocabulario(t) }
funcion tokenizer_decode(t, ids, saltar_especiales) { retornar fichas_decodificar(t, ids, saltar_especiales) }
funcion bpe_train(textos, opciones) { retornar fichas_bpe_entrenar(textos, _tokenizers_opt(opciones)) }
funcion tokenizer_to_json(t) { retornar fichas_guardar(t) }

funcion _tokenizers_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_TOKENIZERS_OPT[k] ?? k] = o[k] }
    retornar r
}
