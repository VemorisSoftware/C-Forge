// stdlib/chart.cfv — gráficos SVG: nombres en inglés del módulo "grafica".
// English names for the "grafica" module; both can be used together.

importar "grafica"

funcion chart_ticks(min, max, n) { retornar grafica_marcas(min, max, n) }
funcion _chart_series(series) {
    sea r = []
    para s en series {
        sea x = {}
        para k en claves(s) { x[k] = s[k] }
        si (tiene_clave(s, "name")) { x["nombre"] = s["name"] }
        si (tiene_clave(s, "values")) { x["valores"] = s["values"] }
        si (tiene_clave(s, "points")) { x["puntos"] = s["points"] }
        r.agregar(x)
    }
    retornar r
}

funcion _chart_opts(o) {
    si (o == nulo) { retornar nulo }
    sea r = {}
    sea en = {"title": "titulo", "width": "ancho", "height": "alto", "legend": "leyenda", "stacked": "apiladas", "donut": "dona", "points": "puntos", "background": "fondo"}
    para k en claves(o) { si (tiene_clave(en, k)) { r[en[k]] = o[k] } sino { r[k] = o[k] } }
    retornar r
}

/// series: [{"name", "values"}]; options: title, width, height, area, legend.
funcion chart_line(etiquetas, series, opciones) { retornar grafica_lineas(etiquetas, _chart_series(series), _chart_opts(opciones)) }
funcion chart_bar(etiquetas, series, opciones) { retornar grafica_barras(etiquetas, _chart_series(series), _chart_opts(opciones)) }
funcion chart_scatter(series, opciones) { retornar grafica_dispersion(_chart_series(series), _chart_opts(opciones)) }
funcion chart_pie(etiquetas, valores, opciones) { retornar grafica_torta(etiquetas, valores, _chart_opts(opciones)) }
funcion chart_sparkline(valores, ancho, alto, color) { retornar grafica_mini(valores, ancho, alto, color) }
