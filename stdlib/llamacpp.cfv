// stdlib/llamacpp.cfv — Modelos de lenguaje GGUF (estilo llama.cpp): nombres en inglés del módulo "oraculo".
// English names for the "oraculo" module; both can be used together.


importar "oraculo"

funcion _llamacpp_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_llamacpp_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _llamacpp_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _LLAMACPP_RES = {"arquitectura": "architecture", "cabezas": "heads", "cabezas_kv": "kv_heads", "capas": "layers", "contexto": "context", "nombre": "name", "vocabulario": "vocab", "texto": "text", "fin": "stop_reason"}
sea _LLAMACPP_OPT = {"temperature": "temperatura", "seed": "semilla", "stop": "parar"}

funcion llama_gguf_read(datos) { retornar oraculo_gguf(datos) }
funcion llama_gguf_tensor(g, nombre) { retornar oraculo_tensor(g, nombre) }
funcion llama_model_from_bytes(datos) { retornar oraculo_desde_bytes(datos) }
funcion llama_model_load(ruta) { retornar oraculo_cargar(ruta) }
funcion llama_model_info(m) { retornar _llamacpp_tr(oraculo_info(m), _LLAMACPP_RES) }
funcion llama_reset(m) { retornar oraculo_reiniciar(m) }
funcion llama_eval(m, token) { retornar oraculo_evaluar(m, token) }
funcion llama_tokenize(m, texto, con_bos) { retornar oraculo_tokenizar(m, texto, con_bos) }
funcion llama_detokenize(m, tokens) { retornar oraculo_texto(m, tokens) }
funcion llama_sample(logits, opciones, estado) { retornar oraculo_muestrear(logits, _llamacpp_opt(opciones), estado) }
funcion llama_generate(m, prompt, opciones) { retornar _llamacpp_tr(oraculo_generar(m, prompt, _llamacpp_opt(opciones)), _LLAMACPP_RES) }
funcion llama_complete(m, prompt, opciones) { retornar oraculo_completar(m, prompt, _llamacpp_opt(opciones)) }

funcion _llamacpp_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_LLAMACPP_OPT[k] ?? k] = o[k] }
    retornar r
}
