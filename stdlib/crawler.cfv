// stdlib/crawler.cfv — sesiones web y rastreo: nombres en inglés del módulo "recolecta".
// English names for the "recolecta" module; both can be used together.

importar "recolecta"

funcion _cr_pagina(p) { retornar {"status": p["estado"], "url": p["url"], "headers": p["cabeceras"], "body": p["cuerpo"], "doc": p["doc"]} }

funcion _cr_transporte(f) {
    si (f == nulo) { retornar nulo }
    retornar funcion(m, u, cab, cuerpo) {
        sea r = f(m, u, cab, cuerpo)
        retornar {"estado": r["status"], "cabeceras": r["headers"] ?? {}, "cuerpo": r["body"] ?? "", "set_cookie": r["set_cookie"] ?? []}
    }
}

funcion _cr_form_es(f) { retornar {"accion": f["action"], "metodo": f["method"], "campos": f["fields"], "botones": f["buttons"], "id": f["id"]} }
funcion _cr_form_en(f) { retornar {"action": f["accion"], "method": f["metodo"], "fields": f["campos"], "buttons": f["botones"], "id": f["id"]} }

/// options: user_agent, transport (f(method, url, headers, body) →
/// {"status", "headers", "body", "set_cookie": [...]}), max_redirects, headers, clock.
funcion crawler_session(options) {
    sea o = options ?? {}
    retornar recolecta_sesion({"agente": o["user_agent"] ?? nulo, "transporte": _cr_transporte(o["transport"] ?? nulo), "max_redirecciones": o["max_redirects"] ?? nulo, "cabeceras": o["headers"] ?? nulo, "reloj": o["clock"] ?? nulo})
}

funcion crawler_url_parts(url) {
    sea p = recolecta_partes(url)
    retornar {"scheme": p["esquema"], "authority": p["autoridad"], "host": p["host"], "port": p["puerto"], "path": p["ruta"], "query": p["consulta"], "fragment": p["fragmento"]}
}

funcion crawler_resolve(base, rel) { retornar recolecta_resolver(base, rel) }
funcion crawler_http_date(t) { retornar recolecta_fecha_http(t) }
funcion crawler_store_cookie(s, url, header) { retornar recolecta_guardar_cookie(s, url, header) }
funcion crawler_cookie_header(s, url) { retornar recolecta_cookies_para(s, url) }
funcion crawler_request(s, method, url, body, headers) { retornar _cr_pagina(recolecta_pedir(s, method, url, body, headers)) }
funcion crawler_get(s, url, headers) { retornar _cr_pagina(recolecta_get(s, url, headers)) }
funcion crawler_post(s, url, fields) { retornar _cr_pagina(recolecta_post(s, url, fields)) }

funcion crawler_forms(page, base) {
    sea r = []
    para f en recolecta_formularios(page, base) { r.agregar(_cr_form_en(f)) }
    retornar r
}

funcion crawler_submit(s, form, changes, button) { retornar _cr_pagina(recolecta_enviar(s, _cr_form_es(form), changes, button)) }
funcion crawler_links(page, base, selector) { retornar recolecta_enlaces(page, base, selector) }

funcion crawler_robots(text, agent) {
    sea r = recolecta_robots(text, agent)
    retornar {"rules": r["reglas"], "crawl_delay_s": r["espera_s"], "sitemaps": r["sitemaps"]}
}

funcion crawler_allowed(robots, path_or_url) { retornar recolecta_permitido({"reglas": robots["rules"]}, path_or_url) }

funcion crawler_sitemap(text) {
    sea r = []
    para x en recolecta_sitemap(text) { r.agregar({"url": x["url"], "lastmod": x["modificado"], "is_index": x["indice"]}) }
    retornar r
}

/// options: max_pages, same_host, robots, filter, visit (f(page)), delay_ms.
funcion crawler_crawl(s, start, options) {
    sea o = options ?? {}
    sea v = o["visit"] ?? nulo
    sea visitar = nulo
    si (v != nulo) { visitar = funcion(p) { v(_cr_pagina(p)) } }
    retornar recolecta_rastrear(s, start, {"max_paginas": o["max_pages"] ?? 50, "mismo_host": o["same_host"] ?? verdadero, "robots": o["robots"] ?? verdadero, "filtro": o["filter"] ?? nulo, "visitar": visitar, "espera_ms": o["delay_ms"] ?? 0})
}
