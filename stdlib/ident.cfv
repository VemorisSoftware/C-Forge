// stdlib/ident.cfv — identificadores únicos: UUID v4 (aleatorio), UUID v7
// (ordenable por tiempo, RFC 9562), ULID y NanoID. Inspirada en uuid / ulid
// / nanoid (MIT). Usa el generador criptográfico del sistema.
//
//   importar "ident"
//   mostrar(ident_uuid4())         // "3f2c…-4…"
//   mostrar(ident_uuid7())         // ordenable: los más nuevos van después
//   mostrar(ident_ulid())          // 26 caracteres Crockford base32
//   mostrar(ident_nanoid(21))      // URL-safe

funcion _id_hex(b) { retornar hex_de_bytes(b) }

funcion _id_guiones(h) {
    retornar subcadena(h, 0, 8) + "-" + subcadena(h, 8, 12) + "-" + subcadena(h, 12, 16) + "-" + subcadena(h, 16, 20) + "-" + subcadena(h, 20, 32)
}

// Reemplaza el byte i de b por v.
funcion _id_poner(b, i, v) { retornar subcadena(b, 0, i) + bytes_entero(v, 1, 0) + subcadena(b, i + 1, longitud(b)) }

/// UUID versión 4 (122 bits aleatorios).
funcion ident_uuid4() {
    sea b = crypto_rand_bytes(16)
    b = _id_poner(b, 6, 64 + byte_en(b, 6) % 16)              // versión 4
    b = _id_poner(b, 8, 128 + byte_en(b, 8) % 64)             // variante RFC
    retornar _id_guiones(_id_hex(b))
}

/// UUID versión 7: 48 bits de milisegundos Unix + 74 aleatorios.
funcion ident_uuid7() {
    sea ms = cfv_fecha_ahora_ms()
    sea b = bytes_entero(ms, 6, 0) + crypto_rand_bytes(10)
    b = _id_poner(b, 6, 112 + byte_en(b, 6) % 16)             // versión 7
    b = _id_poner(b, 8, 128 + byte_en(b, 8) % 64)
    retornar _id_guiones(_id_hex(b))
}

/// ¿Es un UUID bien formado? (cualquier versión, minúsculas o mayúsculas)
funcion ident_es_uuid(t) {
    si (longitud(t) != 36) { retornar falso }
    sea i = 0
    mientras (i < 36) {
        sea c = texto_minusculas(subcadena(t, i, i + 1))
        si (i == 8 o i == 13 o i == 18 o i == 23) {
            si (c != "-") { retornar falso }
        } sino {
            si (texto_indice("0123456789abcdef", c) < 0) { retornar falso }
        }
        i = i + 1
    }
    retornar verdadero
}

/// Versión de un UUID (4, 7…).
funcion ident_version_uuid(t) {
    si (ident_es_uuid(t) == falso) { lanzar "ident: UUID inválido" }
    retornar texto_indice("0123456789abcdef", texto_minusculas(subcadena(t, 14, 15)))
}

/// Milisegundos Unix guardados en un UUID v7.
funcion ident_uuid7_ms(t) {
    si (ident_version_uuid(t) != 7) { lanzar "ident: no es un UUID v7" }
    sea h = texto_reemplazar(subcadena(t, 0, 13), "-", "")
    retornar bytes_leer_entero(bytes_de_hex(h), 0, 6, 0)
}

sea _ID_CROCKFORD = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"

/// ULID: 10 caracteres de tiempo + 16 aleatorios (Crockford base32).
funcion ident_ulid() {
    sea ms = cfv_fecha_ahora_ms()
    sea r = []
    sea i = 0
    sea t = ms
    sea tiempo = []
    mientras (i < 10) {
        tiempo.agregar(subcadena(_ID_CROCKFORD, t % 32, t % 32 + 1))
        t = cociente(t, 32)
        i = i + 1
    }
    i = 9
    mientras (i >= 0) {
        r.agregar(tiempo[i])
        i = i - 1
    }
    sea b = crypto_rand_bytes(16)
    i = 0
    mientras (i < 16) {
        sea k = byte_en(b, i) % 32
        r.agregar(subcadena(_ID_CROCKFORD, k, k + 1))
        i = i + 1
    }
    retornar unir(r, "")
}

/// Milisegundos Unix de un ULID.
funcion ident_ulid_ms(u) {
    si (longitud(u) != 26) { lanzar "ident: ULID inválido" }
    sea v = 0
    sea i = 0
    mientras (i < 10) {
        sea k = texto_indice(_ID_CROCKFORD, texto_mayusculas(subcadena(u, i, i + 1)))
        si (k < 0) { lanzar "ident: ULID inválido" }
        v = v * 32 + k
        i = i + 1
    }
    retornar v
}

sea _ID_NANO = "useandom-26T198340PX75pxJACKVERYMINDBUSHWOLF_GQZbfghjklqvwyzrict"

/// NanoID URL-safe (por defecto 21 caracteres: ~126 bits).
funcion ident_nanoid(largo) {
    sea n = largo
    si (n == nulo) { n = 21 }
    si (n < 1 o n > 256) { lanzar "ident_nanoid: largo entre 1 y 256" }
    sea b = crypto_rand_bytes(n)
    sea r = []
    sea i = 0
    mientras (i < n) {
        sea k = byte_en(b, i) % 64
        r.agregar(subcadena(_ID_NANO, k, k + 1))
        i = i + 1
    }
    retornar unir(r, "")
}
