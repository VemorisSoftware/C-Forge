// stdlib/tauri.cfv — Apps con interfaz web (estilo Tauri): nombres en inglés del módulo "cristal".
// English names for the "cristal" module; both can be used together.


importar "cristal"

funcion _tauri_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_tauri_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _tauri_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _TAURI_OPT = {"title": "titulo", "width": "ancho", "height": "alto", "frontend": "frontend", "commands": "comandos", "state": "estado", "csp": "csp"}

funcion tauri_app(opciones) { retornar cristal_app(_tauri_opt(opciones)) }
funcion tauri_command(app, nombre, fn) { retornar cristal_comando(app, nombre, fn) }
funcion tauri_listen(app, evento, fn) { retornar cristal_escuchar(app, evento, fn) }
funcion tauri_emit(app, evento, datos) { retornar cristal_emitir(app, evento, datos) }
funcion tauri_url(app) { retornar cristal_url(app) }
funcion tauri_handle_request(app, sol) { retornar cristal_manejar(app, sol) }
funcion tauri_serve(app, puerto) { retornar cristal_servir(app, puerto) }
funcion tauri_poll(app, ms) { retornar cristal_atender(app, ms) }
funcion tauri_close(app) { retornar cristal_cerrar(app) }
funcion tauri_open_window(app) { retornar cristal_abrir_ventana(app) }
funcion tauri_run(app) { retornar cristal_ejecutar(app) }

funcion _tauri_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_TAURI_OPT[k] ?? k] = o[k] }
    retornar r
}
