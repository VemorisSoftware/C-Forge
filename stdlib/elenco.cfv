// stdlib/elenco.cfv — Entidad-Componente-Sistema para juegos y simulación:
// las entidades son números, los componentes son datos y los sistemas
// recorren las entidades que tienen ciertos componentes. Inspirada en
// Bevy ECS / EnTT (MIT/Apache). En inglés: importar "ecs".
//
//   importar "elenco"
//   sea m = elenco_mundo()
//   sea e = elenco_crear(m, {"pos": {"x": 0, "y": 0}, "vel": {"x": 1, "y": 0}})
//   elenco_sistema(m, "mover", ["pos", "vel"], funcion(m, e, c, dt) {
//       c["pos"]["x"] = c["pos"]["x"] + c["vel"]["x"] * dt
//   })
//   elenco_paso(m, 1 / 60)
//
// Destruir durante un sistema es seguro: se aplica al final del paso.

funcion elenco_mundo() {
    retornar {"siguiente": 1, "vivas": {}, "comp": {}, "sistemas": [], "por_destruir": [], "en_paso": falso, "recursos": {}, "eventos": {}}
}

funcion elenco_crear(m, componentes) {
    sea e = m["siguiente"]
    m["siguiente"] = e + 1
    m["vivas"]["" + e] = verdadero
    si (componentes != nulo) { para k en claves(componentes) { elenco_poner(m, e, k, componentes[k]) } }
    retornar e
}

funcion elenco_vive(m, e) { retornar tiene_clave(m["vivas"], "" + e) }

funcion elenco_poner(m, e, nombre, datos) {
    si (elenco_vive(m, e) == falso) { lanzar "elenco: la entidad " + e + " no existe" }
    si (tiene_clave(m["comp"], nombre) == falso) { m["comp"][nombre] = {} }
    m["comp"][nombre]["" + e] = datos
    retornar m
}

funcion elenco_obtener(m, e, nombre) {
    si (tiene_clave(m["comp"], nombre) == falso) { retornar nulo }
    sea t = m["comp"][nombre]
    si (tiene_clave(t, "" + e)) { retornar t["" + e] }
    retornar nulo
}

funcion elenco_tiene(m, e, nombre) {
    si (tiene_clave(m["comp"], nombre) == falso) { retornar falso }
    retornar tiene_clave(m["comp"][nombre], "" + e)
}

funcion _ec_sin(mapa, k) {
    sea r = {}
    para x en claves(mapa) { si (x != k) { r[x] = mapa[x] } }
    retornar r
}

funcion elenco_quitar(m, e, nombre) {
    si (elenco_tiene(m, e, nombre)) { m["comp"][nombre] = _ec_sin(m["comp"][nombre], "" + e) }
    retornar m
}

funcion _ec_destruir_ya(m, e) {
    sea k = "" + e
    si (tiene_clave(m["vivas"], k) == falso) { retornar nulo }
    m["vivas"] = _ec_sin(m["vivas"], k)
    para nombre en claves(m["comp"]) { si (tiene_clave(m["comp"][nombre], k)) { m["comp"][nombre] = _ec_sin(m["comp"][nombre], k) } }
}

funcion elenco_destruir(m, e) {
    si (m["en_paso"]) { m["por_destruir"].agregar(e) } sino { _ec_destruir_ya(m, e) }
    retornar m
}

/// Entidades con todos los componentes pedidos (y ninguno de "sin"), en
/// orden de creación.
funcion elenco_consultar(m, con, sin) {
    si (longitud(con) == 0) { lanzar "elenco: la consulta necesita al menos un componente" }
    // Recorre la tabla más chica.
    sea base = nulo
    para n en con {
        si (tiene_clave(m["comp"], n) == falso) { retornar [] }
        si (base == nulo o longitud(claves(m["comp"][n])) < longitud(claves(m["comp"][base]))) { base = n }
    }
    sea r = []
    para k en claves(m["comp"][base]) {
        sea ok = tiene_clave(m["vivas"], k)
        para n en con { si (ok y tiene_clave(m["comp"][n], k) == falso) { ok = falso } }
        si (sin != nulo) { para n en sin { si (ok y tiene_clave(m["comp"], n)) { si (tiene_clave(m["comp"][n], k)) { ok = falso } } } }
        si (ok) { r.agregar(a_numero(k)) }
    }
    retornar ordenar(r, funcion(a, b) { retornar a - b })
}

/// Registra un sistema: f(mundo, entidad, componentes, dt) para cada
/// entidad que tenga "con" (y opcionalmente no tenga "sin").
funcion elenco_sistema(m, nombre, con, f, sin) {
    m["sistemas"].agregar({"nombre": nombre, "con": con, "sin": sin, "f": f, "activo": verdadero})
    retornar m
}

funcion elenco_activar(m, nombre, activo) {
    para s en m["sistemas"] { si (s["nombre"] == nombre) { s["activo"] = activo } }
    retornar m
}

/// Corre todos los sistemas activos en orden y luego aplica las destrucciones.
funcion elenco_paso(m, dt) {
    m["en_paso"] = verdadero
    para s en m["sistemas"] {
        si (s["activo"]) {
            para e en elenco_consultar(m, s["con"], s["sin"]) {
                si (elenco_vive(m, e)) {
                    sea c = {}
                    para n en s["con"] { c[n] = elenco_obtener(m, e, n) }
                    s["f"](m, e, c, dt)
                }
            }
        }
    }
    m["en_paso"] = falso
    para e en m["por_destruir"] { _ec_destruir_ya(m, e) }
    m["por_destruir"] = []
    m["eventos"] = {}
    retornar m
}

funcion elenco_cantidad(m) { retornar longitud(claves(m["vivas"])) }

/// Datos globales del mundo (tiempo, puntaje, entrada…).
funcion elenco_recurso(m, nombre, valor) {
    si (valor != nulo) { m["recursos"][nombre] = valor }
    si (tiene_clave(m["recursos"], nombre)) { retornar m["recursos"][nombre] }
    retornar nulo
}

/// Eventos del paso actual: elenco_emitir(m, "choque", datos); elenco_eventos(m, "choque").
funcion elenco_emitir(m, nombre, datos) {
    si (tiene_clave(m["eventos"], nombre) == falso) { m["eventos"][nombre] = [] }
    m["eventos"][nombre].agregar(datos)
    retornar m
}

funcion elenco_eventos(m, nombre) {
    si (tiene_clave(m["eventos"], nombre)) { retornar m["eventos"][nombre] }
    retornar []
}
