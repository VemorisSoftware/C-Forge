// stdlib/tls.cfv — Activa TLS (HTTPS) en el programa.
//
// Linux y macOS usan OpenSSL 3 (o 1.1) del sistema, cargado al primer uso,
// con verificación de certificados y SNI; Windows usa Schannel. Importar
// este módulo (o "red", que lo importa) habilita la carga dinámica de la
// biblioteca en los ejecutables de Linux, que por defecto no la usan.
//
// Uso:
//   importar "tls"
//   sea r = http_solicitud("GET", "https://example.com/", {})
//
//   sea sock = net_conectar("example.com", 443)
//   sea t = tls_abrir(sock, "example.com")
//   tls_enviar(t, "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
//   mostrar(tls_version(t))                 // "TLSv1.3" o "TLSv1.2"
//   mostrar(tls_recibir_todo(t))
//   tls_cerrar(t)

// Cualquier extern activa el enlazador dinámico. La declaración va dentro
// de una función que no se llama: se registra al compilar y nunca se
// resuelve (no hace falta que la biblioteca exista).
funcion __tls_declaraciones() {
    extern "libc" funcion __tls_enlace_dinamico(): entero como "getpid"
}
