// stdlib/vips.cfv — Procesamiento de imágenes (estilo libvips): nombres en inglés del módulo "revelado".
// English names for the "revelado" module; both can be used together.


importar "revelado"

funcion _vips_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_vips_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _vips_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _VIPS_RES = {"media": "mean", "desviacion": "stddev"}
sea _VIPS_OPT = {"quality": "calidad", "subsampling": "submuestreo", "level": "nivel"}

funcion vips_load(ruta) { retornar revelado_cargar(ruta) }
funcion vips_load_buffer(datos) { retornar revelado_desde_bytes(datos) }
funcion vips_save_buffer(img, formato, opciones) { retornar revelado_a_bytes(img, formato, _vips_opt(opciones)) }
funcion vips_save(img, ruta, opciones) { retornar revelado_guardar(img, ruta, _vips_opt(opciones)) }
funcion vips_crop(img, x, y, ancho, alto) { retornar revelado_recortar(img, x, y, ancho, alto) }
funcion vips_flip(img, direccion) { retornar revelado_voltear(img, direccion) }
funcion vips_rot(img, grados) { retornar revelado_rotar(img, grados) }
funcion vips_embed(img, x, y, ancho, alto, fondo) { retornar revelado_incrustar(img, x, y, ancho, alto, fondo) }
funcion vips_insert(base, sub, x, y) { retornar revelado_insertar(base, sub, x, y) }
funcion vips_arrayjoin(imagenes, columnas, fondo) { retornar revelado_mosaico(imagenes, columnas, fondo) }
funcion vips_resize(img, ancho, alto, nucleo) { retornar revelado_redimensionar(img, ancho, alto, nucleo) }
funcion vips_thumbnail(img, ancho, alto, nucleo) { retornar revelado_miniatura(img, ancho, alto, nucleo) }
funcion vips_grayscale(img) { retornar revelado_gris(img) }
funcion vips_maplut(img, tabla) { retornar revelado_tabla(img, tabla) }
funcion vips_invert(img) { retornar revelado_negativo(img) }
funcion vips_linear(img, a, b) { retornar revelado_lineal(img, a, b) }
funcion vips_gamma(img, gamma) { retornar revelado_gamma(img, gamma) }
funcion vips_threshold(img, umbral) { retornar revelado_umbral(img, umbral) }
funcion vips_hist(img) { retornar revelado_histograma(img) }
funcion vips_stats(img) { retornar _vips_tr(revelado_estadisticas(img), _VIPS_RES) }
funcion vips_autocontrast(img) { retornar revelado_autocontraste(img) }
funcion vips_hist_equal(img) { retornar revelado_ecualizar(img) }
funcion vips_composite(abajo, arriba, x, y) { retornar revelado_componer(abajo, arriba, x, y) }
funcion vips_gaussblur(img, sigma) { retornar revelado_desenfocar(img, sigma) }
funcion vips_sharpen(img, sigma, cantidad) { retornar revelado_enfocar(img, sigma, cantidad) }
funcion vips_conv(img, nucleo, escala, desplazamiento) { retornar revelado_convolucion(img, nucleo, escala, desplazamiento) }
funcion vips_sobel(img) { retornar revelado_bordes(img) }

funcion _vips_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_VIPS_OPT[k] ?? k] = o[k] }
    retornar r
}
