// stdlib/libpcap.cfv — Captura y análisis de paquetes (estilo libpcap): nombres en inglés del módulo "sonda".
// English names for the "sonda" module; both can be used together.


importar "sonda"

funcion _libpcap_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_libpcap_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _libpcap_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _LIBPCAP_OPT = {"format": "formato", "link": "enlace", "filter": "filtro", "snaplen": "largo_maximo"}

funcion pcap_mac_to_text(b) { retornar sonda_mac_texto(b) }
funcion pcap_mac_to_bytes(t) { retornar sonda_mac_bytes(t) }
funcion pcap_ipv4_to_text(b) { retornar sonda_ipv4_texto(b) }
funcion pcap_ipv4_to_bytes(t) { retornar sonda_ipv4_bytes(t) }
funcion pcap_ipv6_to_text(b) { retornar sonda_ipv6_texto(b) }
funcion pcap_ipv6_to_bytes(t) { retornar sonda_ipv6_bytes(t) }
funcion pcap_checksum(b) { retornar sonda_suma_verificacion(b) }
funcion pcap_load(ruta) { retornar sonda_leer(ruta) }
funcion pcap_from_bytes(b) { retornar sonda_de_bytes(b) }
funcion pcap_save(ruta, paquetes, opciones) { retornar sonda_escribir(ruta, paquetes, _libpcap_opt(opciones)) }
funcion pcap_to_bytes(paquetes, opciones) { retornar sonda_a_bytes(paquetes, _libpcap_opt(opciones)) }
funcion pcap_decode(datos, enlace) { retornar sonda_decodificar(datos, enlace) }
funcion pcap_dns(m) { retornar sonda_dns(m) }
funcion pcap_compile_filter(expr) { retornar sonda_filtro(expr) }
funcion pcap_matches(d, f) { retornar sonda_coincide(d, f) }
funcion pcap_filter(captura, expr) { retornar sonda_filtrar(captura, expr) }
funcion pcap_stats(captura) { retornar sonda_estadisticas(captura) }
funcion pcap_build_packet(capas) { retornar sonda_paquete(capas) }
funcion pcap_interfaces() { retornar sonda_interfaces() }
funcion pcap_open_live(interfaz, opciones) { retornar sonda_abrir(interfaz, _libpcap_opt(opciones)) }
funcion pcap_next(cap, espera_ms) { retornar sonda_siguiente(cap, espera_ms) }
funcion pcap_inject(cap, datos) { retornar sonda_inyectar(cap, datos) }
funcion pcap_close(cap) { retornar sonda_cerrar(cap) }

funcion _libpcap_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_LIBPCAP_OPT[k] ?? k] = o[k] }
    retornar r
}
