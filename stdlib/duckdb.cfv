// stdlib/duckdb.cfv — SQL analítico embebido (estilo DuckDB): nombres en inglés del módulo "analitica".
// English names for the "analitica" module; both can be used together.

importar "analitica"

funcion _duckdb_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_duckdb_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _duckdb_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _DUCKDB_RES = {"columnas": "columns", "filas": "rows", "cambios": "changes"}

funcion duckdb_connect() { retornar analitica_abrir() }
funcion duckdb_query(db, sql, params) { retornar _duckdb_tr(analitica_consulta(db, sql, params), _DUCKDB_RES) }
funcion duckdb_execute(db, sql) { retornar analitica_ejecutar(db, sql) }
funcion duckdb_fetchall(db, sql, params) { retornar analitica_filas(db, sql, params) }
funcion duckdb_fetchone(db, sql, params) { retornar analitica_valor(db, sql, params) }
funcion duckdb_register(db, nombre, datos) { retornar analitica_registrar(db, nombre, datos) }
funcion duckdb_tables(db) { retornar analitica_tablas(db) }
funcion duckdb_to_csv(resultado) { retornar analitica_csv({"columnas": resultado["columns"] ?? resultado["columnas"], "filas": resultado["rows"] ?? resultado["filas"]}) }
