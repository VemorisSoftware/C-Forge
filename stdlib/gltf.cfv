// stdlib/gltf.cfv — modelos glTF 2.0: nombres en inglés del módulo "carga3d".
// English names for the "carga3d" module; both can be used together.


importar "carga3d"

funcion _gltf_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_gltf_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _gltf_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _GLTF_OPT = {"resolve": "resolver", "generator": "generador"}

funcion gltf_node_matrix(nodo) { retornar carga3d_matriz_nodo(nodo) }
funcion gltf_parse(datos, opciones) { retornar carga3d_gltf(datos, _gltf_opt(opciones)) }
funcion gltf_world(m) { retornar carga3d_mundo(m) }
funcion gltf_load(ruta, opciones) { retornar carga3d_cargar(ruta, _gltf_opt(opciones)) }
funcion gltf_flatten(m, escena) { retornar carga3d_aplanar(m, escena) }
funcion gltf_sample(m, animacion, canal, t) { retornar carga3d_muestrear(m, animacion, canal, t) }
funcion gltf_export_glb(mallas, opciones) { retornar carga3d_glb(mallas, _gltf_opt(opciones)) }

funcion _gltf_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_GLTF_OPT[k] ?? k] = o[k] }
    retornar r
}
