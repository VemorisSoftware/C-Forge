// ---------- Ogg ----------

/// Paquetes de un flujo Ogg (el primero que aparece): lista de
/// {"datos", "granulo" (de la página donde termina, o -1), "ultimo"}.
funcion ogg_paquetes(datos) {
    sea pos = 0
    sea paquetes = []
    sea actual = ""
    sea serie = nulo
    mientras (pos + 27 <= longitud(datos)) {
        si (subtexto(datos, pos, pos + 4) != "OggS") {
            sea sig = texto_indice(subtexto(datos, pos + 1, longitud(datos)), "OggS")
            si (sig < 0) { romper }
            pos = pos + 1 + sig
        } sino {
            sea tipo_pag = byte_en(datos, pos + 5)
            sea granulo = bytes_leer_entero(datos, pos + 6, 8, 1)
            sea s = bytes_leer_entero(datos, pos + 14, 4, 1)
            sea nseg = byte_en(datos, pos + 26)
            sea cuerpo = pos + 27 + nseg
            si (serie == nulo) { serie = s }
            sea total = 0
            sea k = 0
            mientras (k < nseg) {
                total = total + byte_en(datos, pos + 27 + k)
                k = k + 1
            }
            si (cuerpo + total > longitud(datos)) { romper }
            si (s == serie) {
                si (bits_y(tipo_pag, 1) == 0) { actual = "" }
                sea p = cuerpo
                sea terminados = []
                k = 0
                mientras (k < nseg) {
                    sea l = byte_en(datos, pos + 27 + k)
                    actual = actual + subtexto(datos, p, p + l)
                    p = p + l
                    si (l < 255) {
                        terminados.agregar(actual)
                        actual = ""
                    }
                    k = k + 1
                }
                sea i = 0
                para t en terminados {
                    sea g = -1
                    si (i == longitud(terminados) - 1) { g = granulo }
                    paquetes.agregar({"datos": t, "granulo": g, "ultimo": bits_y(tipo_pag, 4) != 0 y i == longitud(terminados) - 1})
                    i = i + 1
                }
            }
            pos = cuerpo + total
        }
    }
    retornar paquetes
}

// ---------- bits (de menor a mayor dentro de cada byte) ----------

funcion _vb_lector(d) { retornar {"d": d, "p": 0, "n": longitud(d) * 8} }

funcion _vb_bits(r, n) {
    sea v = 0
    sea k = 0
    sea p = r["p"]
    sea d = r["d"]
    sea mult = 1
    mientras (k < n) {
        si (p >= r["n"]) {
            r["p"] = p + (n - k)
            r["fin"] = verdadero
            retornar v
        }
        // Lee de a byte entero cuando se puede.
        si (p % 8 == 0 y n - k >= 8) {
            v = v + byte_en(d, piso(p / 8)) * mult
            mult = mult * 256
            p = p + 8
            k = k + 8
        } sino {
            v = v + (piso(byte_en(d, piso(p / 8)) / _VB_POT[p % 8]) % 2) * mult
            mult = mult * 2
            p = p + 1
            k = k + 1
        }
    }
    r["p"] = p
    retornar v
}

funcion _vb_bit(r) {
    sea p = r["p"]
    r["p"] = p + 1
    si (p >= r["n"]) {
        r["fin"] = verdadero
        retornar 0
    }
    retornar piso(byte_en(r["d"], piso(p / 8)) / _VB_POT[p % 8]) % 2
}

sea _VB_POT = [1, 2, 4, 8, 16, 32, 64, 128]

funcion _vb_ilog(v) {
    sea n = 0
    sea x = v
    mientras (x > 0) {
        n = n + 1
        x = piso(x / 2)
    }
    retornar n
}

funcion _vb_float32(x) {
    sea mant = x % 2097152
    sea signo = piso(x / 2147483648) % 2
    sea exp = piso(x / 2097152) % 1024
    sea v = mant * potencia(2, exp - 788)
    si (signo == 1) { retornar 0 - v }
    retornar v
}

// ---------- libros de códigos ----------

funcion _vb_lookup1(entradas, dim) {
    sea r = piso(potencia(entradas, 1.0 / dim))
    mientras (potencia(r + 1, dim) <= entradas) { r = r + 1 }
    mientras (r > 0 y potencia(r, dim) > entradas) { r = r - 1 }
    retornar r
}

funcion _vb_libro(r) {
    si (_vb_bits(r, 24) != 5653314) { lanzar "vorbis: libro de códigos dañado" }
    sea dim = _vb_bits(r, 16)
    sea entradas = _vb_bits(r, 24)
    sea largos = []
    si (_vb_bit(r) == 1) {
        // Ordenado.
        sea actual = 0
        sea largo = _vb_bits(r, 5) + 1
        mientras (actual < entradas) {
            sea num = _vb_bits(r, _vb_ilog(entradas - actual))
            sea i = 0
            mientras (i < num) {
                largos.agregar(largo)
                i = i + 1
            }
            actual = actual + num
            largo = largo + 1
        }
    } sino {
        sea disperso = _vb_bit(r) == 1
        sea i = 0
        mientras (i < entradas) {
            si (disperso) {
                si (_vb_bit(r) == 1) { largos.agregar(_vb_bits(r, 5) + 1) } sino { largos.agregar(0) }
            } sino { largos.agregar(_vb_bits(r, 5) + 1) }
            i = i + 1
        }
    }
    sea libro = {"dim": dim, "entradas": entradas, "largos": largos, "tipo": 0}
    sea tipo_vq = _vb_bits(r, 4)
    libro["tipo"] = tipo_vq
    si (tipo_vq == 1 o tipo_vq == 2) {
        sea minimo_ = _vb_float32(_vb_bits(r, 32))
        sea delta = _vb_float32(_vb_bits(r, 32))
        sea bits_valor = _vb_bits(r, 4) + 1
        sea secuencia = _vb_bit(r) == 1
        sea nvalores = entradas * dim
        si (tipo_vq == 1) { nvalores = _vb_lookup1(entradas, dim) }
        sea mult = []
        sea i = 0
        mientras (i < nvalores) {
            mult.agregar(_vb_bits(r, bits_valor))
            i = i + 1
        }
        // Vectores de cada entrada.
        sea vecs = []
        sea e = 0
        mientras (e < entradas) {
            sea v = []
            sea ultimo = 0.0
            sea divisor = 1
            sea j = 0
            mientras (j < dim) {
                sea m = 0
                si (tipo_vq == 1) { m = mult[piso(e / divisor) % nvalores] } sino { m = mult[e * dim + j] }
                sea x = m * delta + minimo_ + ultimo
                v.agregar(x)
                si (secuencia) { ultimo = x }
                divisor = divisor * nvalores
                j = j + 1
            }
            vecs.agregar(v)
            e = e + 1
        }
        libro["vecs"] = vecs
    } sino si (tipo_vq != 0) { lanzar "vorbis: tipo de búsqueda " + tipo_vq + " no válido" }
    _vb_arbol(libro)
    retornar libro
}

// Árbol de Huffman a partir de los largos (asignación del estándar).
funcion _vb_arbol(libro) {
    sea disponible = []
    sea i = 0
    mientras (i < 33) {
        disponible.agregar(0)
        i = i + 1
    }
    // Nodos: [hijo0, hijo1] con índices; las hojas son -(entrada + 1).
    sea nodos = [[0, 0]]
    sea usadas = 0
    sea unica = -1
    sea primero = verdadero
    sea e = 0
    mientras (e < libro["entradas"]) {
        sea l = libro["largos"][e]
        si (l > 0) {
            usadas = usadas + 1
            unica = e
            sea codigo = 0
            si (primero) {
                codigo = 0
                sea k = 1
                mientras (k <= l) {
                    disponible[k] = potencia(2, 32 - k)
                    k = k + 1
                }
                primero = falso
            } sino {
                sea z = l
                mientras (z > 0 y disponible[z] == 0) { z = z - 1 }
                si (z == 0) { lanzar "vorbis: libro de códigos sobredeterminado" }
                codigo = disponible[z]
                disponible[z] = 0
                sea k = z + 1
                mientras (k <= l) {
                    disponible[k] = codigo + potencia(2, 32 - k)
                    k = k + 1
                }
            }
            // Bits del código de mayor a menor (alineado arriba en 32 bits).
            sea nodo = 0
            sea b = 0
            mientras (b < l) {
                sea bit = piso(codigo / potencia(2, 31 - b)) % 2
                si (b == l - 1) { nodos[nodo][bit] = 0 - (e + 1) }
                sino {
                    sea sig = nodos[nodo][bit]
                    si (sig <= 0) {
                        nodos.agregar([0, 0])
                        sig = longitud(nodos) - 1
                        nodos[nodo][bit] = sig
                    }
                    nodo = sig
                }
                b = b + 1
            }
        }
        e = e + 1
    }
    libro["nodos"] = nodos
    libro["unica"] = nulo
    si (usadas == 1) { libro["unica"] = unica }
}

funcion _vb_decodificar(r, libro) {
    si (libro["unica"] != nulo) {
        // Un solo código: se lee un bit y vale esa entrada.
        _vb_bit(r)
        retornar libro["unica"]
    }
    sea nodos = libro["nodos"]
    sea nodo = 0
    sea vueltas = 0
    mientras (vueltas < 33) {
        sea sig = nodos[nodo][_vb_bit(r)]
        si (sig < 0) { retornar 0 - sig - 1 }
        si (sig == 0) { retornar -1 }
        nodo = sig
        vueltas = vueltas + 1
    }
    retornar -1
}

// ---------- cabeceras ----------

funcion _vb_identificacion(d) {
    si (longitud(d) < 30 o byte_en(d, 0) != 1 o subtexto(d, 1, 7) != "vorbis") { lanzar "vorbis: no es un flujo Vorbis" }
    sea bs = byte_en(d, 28)
    retornar {"version": bytes_leer_entero(d, 7, 4, 1), "canales": byte_en(d, 11), "tasa": bytes_leer_entero(d, 12, 4, 1),
        "bitrate_max": bytes_leer_entero(d, 16, 4, 1), "bitrate": bytes_leer_entero(d, 20, 4, 1), "bitrate_min": bytes_leer_entero(d, 24, 4, 1),
        "bs0": potencia(2, bs % 16), "bs1": potencia(2, piso(bs / 16))}
}

funcion _vb_comentarios(d) {
    si (byte_en(d, 0) != 3 o subtexto(d, 1, 7) != "vorbis") { retornar {"proveedor": "", "etiquetas": {}} }
    sea p = 7
    sea lv = bytes_leer_entero(d, p, 4, 1)
    sea proveedor = subtexto(d, p + 4, p + 4 + lv)
    p = p + 4 + lv
    sea n = bytes_leer_entero(d, p, 4, 1)
    p = p + 4
    sea etiquetas = {}
    sea i = 0
    mientras (i < n y p + 4 <= longitud(d)) {
        sea l = bytes_leer_entero(d, p, 4, 1)
        sea c = subtexto(d, p + 4, p + 4 + l)
        p = p + 4 + l
        sea eq_ = texto_indice(c, "=")
        si (eq_ > 0) {
            sea k = texto_minusculas(subtexto(c, 0, eq_))
            sea v = subtexto(c, eq_ + 1, longitud(c))
            si (tiene_clave(etiquetas, k)) { etiquetas[k] = etiquetas[k] + "; " + v } sino { etiquetas[k] = v }
        }
        i = i + 1
    }
    retornar {"proveedor": proveedor, "etiquetas": etiquetas}
}

funcion _vb_config(d, ident) {
    si (byte_en(d, 0) != 5 o subtexto(d, 1, 7) != "vorbis") { lanzar "vorbis: falta la cabecera de configuración" }
    sea r = _vb_lector(d)
    r["p"] = 56
    sea c = {"libros": [], "pisos": [], "residuos": [], "mapeos": [], "modos": []}
    sea n = _vb_bits(r, 8) + 1
    sea i = 0
    mientras (i < n) {
        c["libros"].agregar(_vb_libro(r))
        i = i + 1
    }
    n = _vb_bits(r, 6) + 1
    i = 0
    mientras (i < n) {
        si (_vb_bits(r, 16) != 0) { lanzar "vorbis: transformada de tiempo no válida" }
        i = i + 1
    }
    // Pisos.
    n = _vb_bits(r, 6) + 1
    i = 0
    mientras (i < n) {
        sea t = _vb_bits(r, 16)
        si (t == 0) { lanzar "vorbis: el piso de tipo 0 (LSP) no está soportado" }
        si (t != 1) { lanzar "vorbis: tipo de piso " + t + " no válido" }
        sea nparts = _vb_bits(r, 5)
        sea clases_part = []
        sea maxc = -1
        sea k = 0
        mientras (k < nparts) {
            sea cl = _vb_bits(r, 4)
            clases_part.agregar(cl)
            maxc = maximo(maxc, cl)
            k = k + 1
        }
        sea clases = []
        k = 0
        mientras (k <= maxc) {
            sea cl = {"dim": _vb_bits(r, 3) + 1, "sub": _vb_bits(r, 2), "maestro": -1, "libros": []}
            si (cl["sub"] > 0) { cl["maestro"] = _vb_bits(r, 8) }
            sea j = 0
            mientras (j < potencia(2, cl["sub"])) {
                cl["libros"].agregar(_vb_bits(r, 8) - 1)
                j = j + 1
            }
            clases.agregar(cl)
            k = k + 1
        }
        sea mult = _vb_bits(r, 2) + 1
        sea rbits = _vb_bits(r, 4)
        sea xs = [0, potencia(2, rbits)]
        para cl en clases_part {
            sea j = 0
            mientras (j < clases[cl]["dim"]) {
                xs.agregar(_vb_bits(r, rbits))
                j = j + 1
            }
        }
        // Vecinos y orden para la síntesis.
        sea bajo = [0, 0]
        sea alto = [0, 0]
        sea j = 2
        mientras (j < longitud(xs)) {
            sea lo = 0
            sea hi = 1
            sea lx = -1
            sea hx = 100000000
            sea q = 0
            mientras (q < j) {
                si (xs[q] < xs[j] y xs[q] > lx) {
                    lx = xs[q]
                    lo = q
                }
                si (xs[q] > xs[j] y xs[q] < hx) {
                    hx = xs[q]
                    hi = q
                }
                q = q + 1
            }
            bajo.agregar(lo)
            alto.agregar(hi)
            j = j + 1
        }
        sea orden = []
        j = 0
        mientras (j < longitud(xs)) {
            orden.agregar(j)
            j = j + 1
        }
        // Orden por X (inserción; son pocos puntos).
        sea a = 1
        mientras (a < longitud(orden)) {
            sea v = orden[a]
            sea b = a - 1
            mientras (b >= 0 y xs[orden[b]] > xs[v]) {
                orden[b + 1] = orden[b]
                b = b - 1
            }
            orden[b + 1] = v
            a = a + 1
        }
        c["pisos"].agregar({"partes": clases_part, "clases": clases, "mult": mult, "xs": xs, "bajo": bajo, "alto": alto, "orden": orden})
        i = i + 1
    }
    // Residuos.
    n = _vb_bits(r, 6) + 1
    i = 0
    mientras (i < n) {
        sea t = _vb_bits(r, 16)
        si (t > 2) { lanzar "vorbis: tipo de residuo " + t + " no válido" }
        sea res = {"tipo": t, "inicio": _vb_bits(r, 24), "fin": _vb_bits(r, 24), "tam": _vb_bits(r, 24) + 1, "clases": _vb_bits(r, 6) + 1, "libro_clase": _vb_bits(r, 8)}
        sea cascada = []
        sea k = 0
        mientras (k < res["clases"]) {
            sea bajo = _vb_bits(r, 3)
            sea alto = 0
            si (_vb_bit(r) == 1) { alto = _vb_bits(r, 5) }
            cascada.agregar(alto * 8 + bajo)
            k = k + 1
        }
        sea libros = []
        k = 0
        mientras (k < res["clases"]) {
            sea fila = []
            sea j = 0
            mientras (j < 8) {
                si (piso(cascada[k] / potencia(2, j)) % 2 == 1) { fila.agregar(_vb_bits(r, 8)) } sino { fila.agregar(-1) }
                j = j + 1
            }
            libros.agregar(fila)
            k = k + 1
        }
        res["libros"] = libros
        c["residuos"].agregar(res)
        i = i + 1
    }
    // Mapeos.
    n = _vb_bits(r, 6) + 1
    i = 0
    mientras (i < n) {
        si (_vb_bits(r, 16) != 0) { lanzar "vorbis: tipo de mapeo no válido" }
        sea m = {"submapas": 1, "acople": [], "mux": [], "pisos": [], "residuos": []}
        si (_vb_bit(r) == 1) { m["submapas"] = _vb_bits(r, 4) + 1 }
        si (_vb_bit(r) == 1) {
            sea pasos = _vb_bits(r, 8) + 1
            sea bitsc = _vb_ilog(ident["canales"] - 1)
            sea k = 0
            mientras (k < pasos) {
                m["acople"].agregar([_vb_bits(r, bitsc), _vb_bits(r, bitsc)])
                k = k + 1
            }
        }
        si (_vb_bits(r, 2) != 0) { lanzar "vorbis: mapeo dañado" }
        sea k = 0
        mientras (k < ident["canales"]) {
            si (m["submapas"] > 1) { m["mux"].agregar(_vb_bits(r, 4)) } sino { m["mux"].agregar(0) }
            k = k + 1
        }
        k = 0
        mientras (k < m["submapas"]) {
            _vb_bits(r, 8)
            m["pisos"].agregar(_vb_bits(r, 8))
            m["residuos"].agregar(_vb_bits(r, 8))
            k = k + 1
        }
        c["mapeos"].agregar(m)
        i = i + 1
    }
    // Modos.
    n = _vb_bits(r, 6) + 1
    i = 0
    mientras (i < n) {
        sea bandera = _vb_bit(r)
        _vb_bits(r, 16)
        _vb_bits(r, 16)
        c["modos"].agregar({"largo": bandera == 1, "mapeo": _vb_bits(r, 8)})
        i = i + 1
    }
    si (_vb_bit(r) != 1) { lanzar "vorbis: falta el bit de cierre de la configuración" }
    retornar c
}

// ---------- piso 1 ----------

funcion _vb_punto(x0, y0, x1, y1, x) {
    sea dy = y1 - y0
    sea adx = x1 - x0
    sea err = absoluto(dy) * (x - x0)
    sea off = piso(err / adx)
    si (dy < 0) { retornar y0 - off }
    retornar y0 + off
}

funcion _vb_linea(x0, y0, x1, y1, v, n) {
    sea dy = y1 - y0
    sea adx = x1 - x0
    sea ady = absoluto(dy)
    sea base = 0
    si (dy >= 0) { base = piso(dy / adx) } sino { base = 0 - piso((0 - dy) / adx) }
    sea sy = base + 1
    si (dy < 0) { sy = base - 1 }
    ady = ady - absoluto(base) * adx
    sea x = x0
    sea py = y0
    sea err = 0
    si (x < n) { v[x] = py }
    x = x + 1
    mientras (x < x1) {
        err = err + ady
        si (err >= adx) {
            err = err - adx
            py = py + sy
        } sino { py = py + base }
        si (x < n) { v[x] = py }
        x = x + 1
    }
}

// Lee el piso de un canal: lista de Y o nulo si el canal no se usa.
funcion _vb_piso_leer(r, piso_, libros) {
    si (_vb_bit(r) == 0) { retornar nulo }
    sea rango = [256, 128, 86, 64][piso_["mult"] - 1]
    sea b = _vb_ilog(rango - 1)
    sea ys = [_vb_bits(r, b), _vb_bits(r, b)]
    para cl en piso_["partes"] {
        sea clase = piso_["clases"][cl]
        sea cbits = clase["sub"]
        sea csub = potencia(2, cbits) - 1
        sea cval = 0
        si (cbits > 0) { cval = _vb_decodificar(r, libros[clase["maestro"]]) }
        sea j = 0
        mientras (j < clase["dim"]) {
            sea libro = clase["libros"][cval % (csub + 1)]
            cval = piso(cval / (csub + 1))
            si (libro >= 0) { ys.agregar(_vb_decodificar(r, libros[libro])) } sino { ys.agregar(0) }
            j = j + 1
        }
    }
    si (r["fin"] ?? falso) { retornar nulo }
    retornar ys
}

// Curva del piso (n/2 valores) a partir de los Y.
funcion _vb_piso_curva(piso_, ys, n2) {
    sea xs = piso_["xs"]
    sea rango = [256, 128, 86, 64][piso_["mult"] - 1]
    sea cuantos = longitud(xs)
    sea paso2 = [verdadero, verdadero]
    sea final = [ys[0], ys[1]]
    sea i = 2
    mientras (i < cuantos) {
        sea lo = piso_["bajo"][i]
        sea hi = piso_["alto"][i]
        sea pred = _vb_punto(xs[lo], final[lo], xs[hi], final[hi], xs[i])
        sea val = ys[i]
        sea alto_ = rango - pred
        sea bajo_ = pred
        sea cuarto = minimo(alto_, bajo_) * 2
        si (val != 0) {
            paso2[lo] = verdadero
            paso2[hi] = verdadero
            paso2.agregar(verdadero)
            si (val >= cuarto) {
                si (alto_ > bajo_) { final.agregar(val - bajo_ + pred) } sino { final.agregar(pred - val + alto_ - 1) }
            } sino {
                si (val % 2 == 1) { final.agregar(pred - piso((val + 1) / 2)) } sino { final.agregar(pred + piso(val / 2)) }
            }
        } sino {
            paso2.agregar(falso)
            final.agregar(pred)
        }
        i = i + 1
    }
    sea v = []
    i = 0
    mientras (i < n2) {
        v.agregar(0)
        i = i + 1
    }
    sea lx = 0
    sea ly = final[piso_["orden"][0]] * piso_["mult"]
    sea hx = 0
    sea hy = 0
    sea k = 1
    mientras (k < cuantos) {
        sea j = piso_["orden"][k]
        si (paso2[j]) {
            hy = final[j] * piso_["mult"]
            hx = xs[j]
            _vb_linea(lx, ly, hx, hy, v, n2)
            lx = hx
            ly = hy
        }
        k = k + 1
    }
    si (hx < n2) { _vb_linea(hx, hy, n2, hy, v, n2) }
    sea curva = []
    i = 0
    mientras (i < n2) {
        curva.agregar(_VB_INV_DB[_vb_limitar(v[i], 0, 255)])
        i = i + 1
    }
    retornar curva
}

funcion _vb_limitar(v, a, b) {
    si (v < a) { retornar a }
    si (v > b) { retornar b }
    retornar v
}

// ---------- residuo ----------

funcion _vb_residuo(r, res, libros, vectores, no_decodificar, n2) {
    sea nch = longitud(vectores)
    sea tipo_r = res["tipo"]
    sea objetivos = vectores
    sea ncanal = nch
    sea largo = n2
    si (tipo_r == 2) {
        sea alguno = falso
        para z en no_decodificar { si (z == falso) { alguno = verdadero } }
        si (alguno == falso) { retornar nulo }
        sea plano = []
        sea i = 0
        mientras (i < n2 * nch) {
            plano.agregar(0.0)
            i = i + 1
        }
        objetivos = [plano]
        ncanal = 1
        largo = n2 * nch
        no_decodificar = [falso]
    }
    sea inicio = minimo(res["inicio"], largo)
    sea fin = minimo(res["fin"], largo)
    sea tam = res["tam"]
    sea total = piso((fin - inicio) / tam)
    si (total <= 0) {
        si (tipo_r == 2) { _vb_desentrelazar(objetivos[0], vectores, n2) }
        retornar nulo
    }
    sea libro_clase = libros[res["libro_clase"]]
    sea por_palabra = libro_clase["dim"]
    sea clasif = []
    sea c = 0
    mientras (c < ncanal) {
        sea l = []
        sea i = 0
        mientras (i < total + por_palabra) {
            l.agregar(0)
            i = i + 1
        }
        clasif.agregar(l)
        c = c + 1
    }
    sea pasada = 0
    mientras (pasada < 8) {
        sea parte = 0
        mientras (parte < total) {
            si (pasada == 0) {
                c = 0
                mientras (c < ncanal) {
                    si (no_decodificar[c] == falso) {
                        sea temp = _vb_decodificar(r, libro_clase)
                        si (temp < 0) { retornar nulo }
                        sea i = por_palabra - 1
                        mientras (i >= 0) {
                            clasif[c][parte + i] = temp % res["clases"]
                            temp = piso(temp / res["clases"])
                            i = i - 1
                        }
                    }
                    c = c + 1
                }
            }
            sea k = 0
            mientras (k < por_palabra y parte < total) {
                c = 0
                mientras (c < ncanal) {
                    si (no_decodificar[c] == falso) {
                        sea libro_n = res["libros"][clasif[c][parte]][pasada]
                        si (libro_n >= 0) {
                            sea libro = libros[libro_n]
                            sea off = inicio + parte * tam
                            sea v = objetivos[c]
                            sea dim = libro["dim"]
                            si (tipo_r == 0) {
                                sea paso = piso(tam / dim)
                                sea j = 0
                                mientras (j < paso) {
                                    sea e = _vb_decodificar(r, libro)
                                    si (e < 0) { retornar nulo }
                                    sea vec = libro["vecs"][e]
                                    sea q = 0
                                    mientras (q < dim) {
                                        v[off + j + q * paso] = v[off + j + q * paso] + vec[q]
                                        q = q + 1
                                    }
                                    j = j + 1
                                }
                            } sino {
                                sea j = 0
                                mientras (j < tam) {
                                    sea e = _vb_decodificar(r, libro)
                                    si (e < 0) { retornar nulo }
                                    sea vec = libro["vecs"][e]
                                    sea q = 0
                                    mientras (q < dim y j < tam) {
                                        v[off + j] = v[off + j] + vec[q]
                                        j = j + 1
                                        q = q + 1
                                    }
                                }
                            }
                        }
                    }
                    c = c + 1
                }
                parte = parte + 1
                k = k + 1
            }
        }
        pasada = pasada + 1
    }
    si (tipo_r == 2) { _vb_desentrelazar(objetivos[0], vectores, n2) }
}

funcion _vb_desentrelazar(plano, vectores, n2) {
    sea nch = longitud(vectores)
    sea i = 0
    mientras (i < n2) {
        sea c = 0
        mientras (c < nch) {
            vectores[c][i] = plano[i * nch + c]
            c = c + 1
        }
        i = i + 1
    }
}

// ---------- IMDCT con FFT ----------

funcion _vb_fft(re, im) {
    sea n = longitud(re)
    // Permutación por inversión de bits.
    sea j = 0
    sea i = 1
    mientras (i < n) {
        sea bit = piso(n / 2)
        mientras (j >= bit y bit > 0) {
            j = j - bit
            bit = piso(bit / 2)
        }
        j = j + bit
        si (i < j) {
            sea t = re[i]
            re[i] = re[j]
            re[j] = t
            t = im[i]
            im[i] = im[j]
            im[j] = t
        }
        i = i + 1
    }
    sea largo = 2
    mientras (largo <= n) {
        sea ang = -6.283185307179586 / largo
        sea wr = coseno(ang)
        sea wi = seno(ang)
        sea mitad = piso(largo / 2)
        sea s = 0
        mientras (s < n) {
            sea cr = 1.0
            sea ci = 0.0
            sea k = 0
            mientras (k < mitad) {
                sea a = s + k
                sea b = a + mitad
                sea tr = re[b] * cr - im[b] * ci
                sea ti = re[b] * ci + im[b] * cr
                re[b] = re[a] - tr
                im[b] = im[a] - ti
                re[a] = re[a] + tr
                im[a] = im[a] + ti
                sea ncr = cr * wr - ci * wi
                ci = cr * wi + ci * wr
                cr = ncr
                k = k + 1
            }
            s = s + largo
        }
        largo = largo * 2
    }
}

// Tablas de giro por tamaño.
funcion _vb_giros(m) {
    si (tiene_clave(_VB_CACHE, "" + m)) { retornar _VB_CACHE["" + m] }
    sea h = piso(m / 2)
    sea pre = []
    sea post = []
    sea n = 0
    mientras (n < h) {
        sea a = -3.141592653589793 * (4 * n + 1) / (4 * m)
        pre.agregar([coseno(a), seno(a)])
        sea b = -3.141592653589793 * n / m
        post.agregar([coseno(b), seno(b)])
        n = n + 1
    }
    sea t = {"pre": pre, "post": post}
    _VB_CACHE["" + m] = t
    retornar t
}

sea _VB_CACHE = {}

// IMDCT de n/2 coeficientes a n muestras (sin ventana).
funcion _vb_imdct(x) {
    sea m = longitud(x)
    sea h = piso(m / 2)
    sea g = _vb_giros(m)
    sea re = []
    sea im = []
    sea n = 0
    mientras (n < h) {
        sea a = x[2 * n]
        sea b = x[m - 1 - 2 * n]
        sea w = g["pre"][n]
        re.agregar(a * w[0] - b * w[1])
        im.agregar(a * w[1] + b * w[0])
        n = n + 1
    }
    _vb_fft(re, im)
    sea u = []
    n = 0
    mientras (n < m) {
        u.agregar(0.0)
        n = n + 1
    }
    n = 0
    mientras (n < h) {
        sea w = g["post"][n]
        sea wr = re[n] * w[0] - im[n] * w[1]
        sea wi = re[n] * w[1] + im[n] * w[0]
        u[2 * n] = wr
        u[m - 1 - 2 * n] = 0 - wi
        n = n + 1
    }
    sea y = []
    sea total = 2 * m
    sea mh = piso(m / 2)
    n = 0
    mientras (n < total) {
        sea k = n + mh
        si (k < m) { y.agregar(u[k]) }
        sino si (k < 2 * m) { y.agregar(0 - u[2 * m - 1 - k]) }
        sino { y.agregar(0 - u[k - 2 * m]) }
        n = n + 1
    }
    retornar y
}

// Ventana de Vorbis para un bloque de tamaño n con vecinos.
funcion _vb_ventana(n, largo, previo_largo, sig_largo, bs0) {
    sea clave = "v" + n + "_" + previo_largo + "_" + sig_largo
    si (tiene_clave(_VB_CACHE, clave)) { retornar _VB_CACHE[clave] }
    sea centro = piso(n / 2)
    sea li = 0
    sea lf = centro
    sea ln = centro
    sea ri = centro
    sea rf = n
    sea rn = centro
    si (largo y previo_largo == falso) {
        li = piso(n / 4) - piso(bs0 / 4)
        lf = piso(n / 4) + piso(bs0 / 4)
        ln = piso(bs0 / 2)
    }
    si (largo y sig_largo == falso) {
        ri = piso(n * 3 / 4) - piso(bs0 / 4)
        rf = piso(n * 3 / 4) + piso(bs0 / 4)
        rn = piso(bs0 / 2)
    }
    sea w = []
    sea pi2 = 1.5707963267948966
    sea i = 0
    mientras (i < n) {
        si (i < li) { w.agregar(0.0) }
        sino si (i < lf) {
            sea s = seno((i - li + 0.5) / ln * pi2)
            w.agregar(seno(pi2 * s * s))
        } sino si (i < ri) { w.agregar(1.0) }
        sino si (i < rf) {
            sea s = seno((i - ri + 0.5) / rn * pi2 + pi2)
            w.agregar(seno(pi2 * s * s))
        } sino { w.agregar(0.0) }
        i = i + 1
    }
    _VB_CACHE[clave] = w
    retornar w
}

// ---------- decodificador ----------

funcion _vb_paquete_audio(d, est) {
    sea id = est["ident"]
    sea cfg = est["cfg"]
    sea r = _vb_lector(d)
    si (_vb_bit(r) != 0) { retornar nulo }
    sea modo = cfg["modos"][_vb_bits(r, _vb_ilog(longitud(cfg["modos"]) - 1))]
    sea n = id["bs0"]
    sea previo = falso
    sea sig = falso
    si (modo["largo"]) {
        n = id["bs1"]
        previo = _vb_bit(r) == 1
        sig = _vb_bit(r) == 1
    }
    sea n2 = piso(n / 2)
    sea mapeo = cfg["mapeos"][modo["mapeo"]]
    sea nch = id["canales"]
    sea pisos = []
    sea no_dec = []
    sea c = 0
    mientras (c < nch) {
        sea sm = mapeo["mux"][c]
        sea p = _vb_piso_leer(r, cfg["pisos"][mapeo["pisos"][sm]], cfg["libros"])
        pisos.agregar(p)
        no_dec.agregar(p == nulo)
        c = c + 1
    }
    para par en mapeo["acople"] {
        si (no_dec[par[0]] == falso o no_dec[par[1]] == falso) {
            no_dec[par[0]] = falso
            no_dec[par[1]] = falso
        }
    }
    // Residuos por submapa.
    sea residuos = []
    c = 0
    mientras (c < nch) {
        sea v = []
        sea i = 0
        mientras (i < n2) {
            v.agregar(0.0)
            i = i + 1
        }
        residuos.agregar(v)
        c = c + 1
    }
    sea sm = 0
    mientras (sm < mapeo["submapas"]) {
        sea vecs = []
        sea nd = []
        sea idx = []
        c = 0
        mientras (c < nch) {
            si (mapeo["mux"][c] == sm) {
                vecs.agregar(residuos[c])
                nd.agregar(no_dec[c])
                idx.agregar(c)
            }
            c = c + 1
        }
        _vb_residuo(r, cfg["residuos"][mapeo["residuos"][sm]], cfg["libros"], vecs, nd, n2)
        sm = sm + 1
    }
    // Desacople (en orden inverso).
    sea k = longitud(mapeo["acople"]) - 1
    mientras (k >= 0) {
        sea mag = residuos[mapeo["acople"][k][0]]
        sea ang = residuos[mapeo["acople"][k][1]]
        sea i = 0
        mientras (i < n2) {
            sea m = mag[i]
            sea a = ang[i]
            si (m > 0) {
                si (a > 0) { ang[i] = m - a } sino {
                    ang[i] = m
                    mag[i] = m + a
                }
            } sino {
                si (a > 0) { ang[i] = m + a } sino {
                    ang[i] = m
                    mag[i] = m - a
                }
            }
            i = i + 1
        }
        k = k - 1
    }
    // Piso × residuo, IMDCT y ventana.
    sea w = _vb_ventana(n, modo["largo"], previo, sig, id["bs0"])
    sea salida = []
    c = 0
    mientras (c < nch) {
        sea espectro = residuos[c]
        si (pisos[c] == nulo) {
            sea i = 0
            mientras (i < n2) {
                espectro[i] = 0.0
                i = i + 1
            }
        } sino {
            sea sm2 = mapeo["mux"][c]
            sea curva = _vb_piso_curva(cfg["pisos"][mapeo["pisos"][sm2]], pisos[c], n2)
            sea i = 0
            mientras (i < n2) {
                espectro[i] = espectro[i] * curva[i]
                i = i + 1
            }
        }
        sea t = _vb_imdct(espectro)
        sea i = 0
        mientras (i < n) {
            t[i] = t[i] * w[i]
            i = i + 1
        }
        salida.agregar(t)
        c = c + 1
    }
    retornar {"n": n, "pcm": salida}
}

funcion _vb_abrir(datos) {
    sea paq = ogg_paquetes(datos)
    si (longitud(paq) < 3) { lanzar "vorbis: no es un flujo Ogg Vorbis" }
    sea id = _vb_identificacion(paq[0]["datos"])
    si (id["canales"] == 0 o id["tasa"] == 0) { lanzar "vorbis: cabecera de identificación dañada" }
    sea com = _vb_comentarios(paq[1]["datos"])
    retornar {"paquetes": paq, "ident": id, "com": com}
}

/// Información de un Ogg Vorbis: tasa, canales, bitrate nominal, muestras,
/// duración en ms, proveedor y etiquetas (title, artist…).
funcion vorbis_info(datos) {
    sea e = _vb_abrir(datos)
    sea muestras = 0
    para p en e["paquetes"] { si (p["granulo"] > muestras y p["granulo"] < 4611686018427387903) { muestras = p["granulo"] } }
    retornar {"tasa": e["ident"]["tasa"], "canales": e["ident"]["canales"], "bitrate": e["ident"]["bitrate"], "muestras": muestras,
        "duracion_ms": piso(muestras * 1000 / e["ident"]["tasa"]), "proveedor": e["com"]["proveedor"], "etiquetas": e["com"]["etiquetas"],
        "bloques": [e["ident"]["bs0"], e["ident"]["bs1"]]}
}

/// Decodifica un Ogg Vorbis (pisos de tipo 1, residuos 0, 1 y 2, acople y
/// cualquier cantidad de canales). Devuelve {"tasa", "canales", "c"} como
/// "mezcla". opciones: "max_ms".
funcion vorbis_decodificar(datos, opciones) {
    sea op = opciones ?? {}
    sea e = _vb_abrir(datos)
    sea id = e["ident"]
    e["cfg"] = _vb_config(e["paquetes"][2]["datos"], id)
    sea nch = id["canales"]
    sea canales = []
    sea c = 0
    mientras (c < nch) {
        canales.agregar([])
        c = c + 1
    }
    sea limite = nulo
    si (tiene_clave(op, "max_ms")) { limite = piso(op["max_ms"] * id["tasa"] / 1000) }
    sea previo = nulo
    sea granulo_final = -1
    sea i = 3
    mientras (i < longitud(e["paquetes"])) {
        sea pq = e["paquetes"][i]
        si (pq["granulo"] >= 0) { granulo_final = pq["granulo"] }
        sea b = _vb_paquete_audio(pq["datos"], e)
        si (b != nulo) {
            si (previo != nulo) {
                // Del centro del bloque anterior al centro de este.
                sea pn = previo["n"]
                sea n = b["n"]
                sea ini_c = piso(pn * 3 / 4) - piso(n / 4)
                sea desde = piso(pn / 2)
                sea hasta = ini_c + piso(n / 2)
                c = 0
                mientras (c < nch) {
                    sea pp = previo["pcm"][c]
                    sea cp = b["pcm"][c]
                    sea out = canales[c]
                    sea x = desde
                    mientras (x < hasta) {
                        sea v = 0.0
                        si (x < pn) { v = pp[x] }
                        sea j = x - ini_c
                        si (j >= 0 y j < n) { v = v + cp[j] }
                        si (v > 1) { v = 1.0 }
                        si (v < -1) { v = -1.0 }
                        out.agregar(v)
                        x = x + 1
                    }
                    c = c + 1
                }
            }
            previo = b
        }
        si (limite != nulo y longitud(canales[0]) >= limite) { romper }
        i = i + 1
    }
    // El gránulo de la última página dice cuántas muestras hay en total.
    sea total = longitud(canales[0])
    si (limite != nulo) { total = minimo(total, limite) }
    sino si (granulo_final >= 0 y granulo_final < total) { total = granulo_final }
    si (total < longitud(canales[0])) {
        sea c2 = []
        para ch en canales {
            sea m = []
            sea k = 0
            mientras (k < total) {
                m.agregar(ch[k])
                k = k + 1
            }
            c2.agregar(m)
        }
        canales = c2
    }
    retornar {"tasa": id["tasa"], "canales": nch, "c": canales, "etiquetas": e["com"]["etiquetas"]}
}

/// ¿Parece un Ogg Vorbis?
funcion vorbis_es(datos) {
    si (longitud(datos) < 40 o subtexto(datos, 0, 4) != "OggS") { retornar falso }
    retornar contiene(subtexto(datos, 0, minimo(longitud(datos), 200)), char_de(1) + "vorbis")
}
