// stdlib/lottie.cfv — reproductor de animaciones Lottie: nombres en inglés del módulo "animacion".
// English names for the "animacion" module; both can be used together.


importar "animacion"

funcion _lottie_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_lottie_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _lottie_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _LOTTIE_RES = {"ancho": "width", "alto": "height", "inicio": "in_point", "fin": "out_point", "cuadros": "frames", "segundos": "seconds", "capas": "layers"}
sea _LOTTIE_OPT = {"background": "fondo", "scale": "escala"}

funcion lottie_load(j) { retornar animacion_cargar(j) }
funcion lottie_info(a) { retornar _lottie_tr(animacion_info(a), _LOTTIE_RES) }
funcion lottie_render(a, c, f) { retornar animacion_dibujar(a, c, f) }
funcion lottie_frame(a, f, formato, opciones) { retornar animacion_cuadro(a, f, formato, _lottie_opt(opciones)) }
funcion lottie_value(propiedad, f) { retornar animacion_valor(propiedad, f) }

funcion _lottie_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_LOTTIE_OPT[k] ?? k] = o[k] }
    retornar r
}
