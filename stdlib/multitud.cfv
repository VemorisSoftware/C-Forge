// stdlib/multitud.cfv — simulación de multitudes y bandadas: agentes con
// posición y velocidad que buscan un destino, evitan chocarse entre sí y
// con obstáculos, y se agrupan como bandadas (boids: separación,
// alineación, cohesión). Usa una grilla espacial para escalar a miles de
// agentes. Inspirada en DetourCrowd / Reynolds (zlib/BSD). En inglés:
// importar "crowd".
//
//   importar "multitud"
//   sea m = multitud_nueva({"radio_vecinos": 50})
//   sea a = multitud_agregar(m, 10, 10, {"destino": [300, 200], "velocidad_max": 80})
//   multitud_obstaculo(m, 150, 100, 30)
//   multitud_paso(m, 1 / 60)
//   multitud_agentes(m)[0]["x"]

funcion _mu_op(o, k, d) {
    si (o != nulo) { si (tiene_clave(o, k)) { retornar o[k] } }
    retornar d
}

funcion multitud_nueva(opciones) {
    retornar {
        "agentes": [], "obstaculos": [], "siguiente": 1,
        "radio_vecinos": _mu_op(opciones, "radio_vecinos", 40),
        "peso_separacion": _mu_op(opciones, "separacion", 1.5),
        "peso_alineacion": _mu_op(opciones, "alineacion", 1),
        "peso_cohesion": _mu_op(opciones, "cohesion", 1),
        "peso_destino": _mu_op(opciones, "destino", 1.2),
        "peso_obstaculos": _mu_op(opciones, "obstaculos", 3),
        "limites": _mu_op(opciones, "limites", nulo)
    }
}

/// opciones: destino [x, y], velocidad_max (60), fuerza_max (120), radio (5),
/// grupo (los boids solo se alinean con su grupo), vx, vy.
funcion multitud_agregar(m, x, y, opciones) {
    sea a = {"id": m["siguiente"], "x": x, "y": y, "vx": _mu_op(opciones, "vx", 0), "vy": _mu_op(opciones, "vy", 0), "destino": _mu_op(opciones, "destino", nulo), "velocidad_max": _mu_op(opciones, "velocidad_max", 60), "fuerza_max": _mu_op(opciones, "fuerza_max", 120), "radio": _mu_op(opciones, "radio", 5), "grupo": _mu_op(opciones, "grupo", 0), "llego": falso}
    m["siguiente"] = m["siguiente"] + 1
    m["agentes"].agregar(a)
    retornar a
}

funcion multitud_obstaculo(m, x, y, radio) {
    m["obstaculos"].agregar({"x": x, "y": y, "radio": radio})
    retornar m
}

funcion multitud_destino(a, x, y) {
    a["destino"] = [x, y]
    a["llego"] = falso
    retornar a
}

funcion multitud_agentes(m) { retornar m["agentes"] }

funcion _mu_limitar(x, y, max) {
    sea l = raiz(x * x + y * y)
    si (l > max y l > 0) { retornar [x / l * max, y / l * max] }
    retornar [x, y]
}

funcion _mu_grilla(m) {
    sea g = {}
    sea c = m["radio_vecinos"]
    para a en m["agentes"] {
        sea k = piso(a["x"] / c) + ":" + piso(a["y"] / c)
        si (tiene_clave(g, k) == falso) { g[k] = [] }
        g[k].agregar(a)
    }
    retornar g
}

funcion _mu_vecinos(m, g, a) {
    sea c = m["radio_vecinos"]
    sea cx = piso(a["x"] / c)
    sea cy = piso(a["y"] / c)
    sea r = []
    sea dy = -1
    mientras (dy <= 1) {
        sea dx = -1
        mientras (dx <= 1) {
            sea k = (cx + dx) + ":" + (cy + dy)
            si (tiene_clave(g, k)) {
                para b en g[k] {
                    si (b["id"] != a["id"]) {
                        sea ex = b["x"] - a["x"]
                        sea ey = b["y"] - a["y"]
                        si (ex * ex + ey * ey < c * c) { r.agregar(b) }
                    }
                }
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
    retornar r
}

/// Avanza la simulación dt segundos.
funcion multitud_paso(m, dt) {
    sea g = _mu_grilla(m)
    sea fuerzas = []
    para a en m["agentes"] {
        sea fx = 0
        sea fy = 0
        sea vecinos = _mu_vecinos(m, g, a)
        // Separación (más fuerte cuanto más cerca), alineación y cohesión.
        sea sx = 0
        sea sy = 0
        sea ax = 0
        sea ay = 0
        sea cx = 0
        sea cy = 0
        sea n = 0
        para b en vecinos {
            sea ex = a["x"] - b["x"]
            sea ey = a["y"] - b["y"]
            sea d = raiz(ex * ex + ey * ey)
            sea minima = a["radio"] + b["radio"]
            si (d > 0) {
                sea peso = 1 / d
                si (d < minima * 2) { peso = peso * 4 }
                sx = sx + ex / d * peso
                sy = sy + ey / d * peso
            } sino { sx = sx + (aleatorio() - 0.5)  sy = sy + (aleatorio() - 0.5) }
            si (b["grupo"] == a["grupo"]) {
                ax = ax + b["vx"]
                ay = ay + b["vy"]
                cx = cx + b["x"]
                cy = cy + b["y"]
                n = n + 1
            }
        }
        fx = fx + sx * m["peso_separacion"] * a["fuerza_max"]
        fy = fy + sy * m["peso_separacion"] * a["fuerza_max"]
        si (n > 0 y a["destino"] == nulo) {
            fx = fx + (ax / n - a["vx"]) * m["peso_alineacion"]
            fy = fy + (ay / n - a["vy"]) * m["peso_alineacion"]
            fx = fx + (cx / n - a["x"]) * m["peso_cohesion"]
            fy = fy + (cy / n - a["y"]) * m["peso_cohesion"]
        }
        // Ir al destino con frenado al llegar.
        si (a["destino"] != nulo) {
            sea ex = a["destino"][0] - a["x"]
            sea ey = a["destino"][1] - a["y"]
            sea d = raiz(ex * ex + ey * ey)
            si (d < a["radio"]) { a["llego"] = verdadero }
            sea vel = a["velocidad_max"]
            si (d < 50) { vel = vel * d / 50 }
            si (d > 0) {
                fx = fx + (ex / d * vel - a["vx"]) * m["peso_destino"] * 4
                fy = fy + (ey / d * vel - a["vy"]) * m["peso_destino"] * 4
            }
        }
        // Obstáculos circulares.
        para o en m["obstaculos"] {
            sea ex = a["x"] - o["x"]
            sea ey = a["y"] - o["y"]
            sea d = raiz(ex * ex + ey * ey)
            sea alcance = o["radio"] + a["radio"] + 30
            si (d < alcance y d > 0) {
                sea k = (alcance - d) / alcance
                fx = fx + ex / d * k * a["fuerza_max"] * m["peso_obstaculos"]
                fy = fy + ey / d * k * a["fuerza_max"] * m["peso_obstaculos"]
            }
        }
        fuerzas.agregar(_mu_limitar(fx, fy, a["fuerza_max"] * 3))
    }
    sea i = 0
    para a en m["agentes"] {
        sea f = fuerzas[i]
        sea v = _mu_limitar(a["vx"] + f[0] * dt, a["vy"] + f[1] * dt, a["velocidad_max"])
        a["vx"] = v[0]
        a["vy"] = v[1]
        a["x"] = a["x"] + a["vx"] * dt
        a["y"] = a["y"] + a["vy"] * dt
        // Nunca dentro de un obstáculo.
        para o en m["obstaculos"] {
            sea ex = a["x"] - o["x"]
            sea ey = a["y"] - o["y"]
            sea d = raiz(ex * ex + ey * ey)
            sea min = o["radio"] + a["radio"]
            si (d < min) {
                si (d == 0) { ex = 1  ey = 0  d = 1 }
                a["x"] = o["x"] + ex / d * min
                a["y"] = o["y"] + ey / d * min
            }
        }
        si (m["limites"] != nulo) {
            sea L = m["limites"]
            a["x"] = maximo(L[0], minimo(L[2], a["x"]))
            a["y"] = maximo(L[1], minimo(L[3], a["y"]))
        }
        i = i + 1
    }
    // Relajación: separa los pares que quedaron superpuestos (garantiza que
    // ningún agente atraviese a otro aunque las fuerzas no alcancen).
    sea g2 = _mu_grilla(m)
    sea vuelta = 0
    mientras (vuelta < 2) {
        para a en m["agentes"] {
            para b en _mu_vecinos(m, g2, a) {
                si (a["id"] < b["id"]) {
                    sea ex = b["x"] - a["x"]
                    sea ey = b["y"] - a["y"]
                    sea d = raiz(ex * ex + ey * ey)
                    sea min = a["radio"] + b["radio"]
                    si (d < min) {
                        si (d == 0) { ex = 1  ey = 0  d = 1 }
                        sea sobra = (min - d) / 2
                        a["x"] = a["x"] - ex / d * sobra
                        a["y"] = a["y"] - ey / d * sobra
                        b["x"] = b["x"] + ex / d * sobra
                        b["y"] = b["y"] + ey / d * sobra
                    }
                }
            }
        }
        vuelta = vuelta + 1
    }
    // Los obstáculos tienen la última palabra.
    para a en m["agentes"] {
        para o en m["obstaculos"] {
            sea ex = a["x"] - o["x"]
            sea ey = a["y"] - o["y"]
            sea d = raiz(ex * ex + ey * ey)
            sea min = o["radio"] + a["radio"]
            si (d < min) {
                si (d == 0) { ex = 1  ey = 0  d = 1 }
                a["x"] = o["x"] + ex / d * min
                a["y"] = o["y"] + ey / d * min
            }
        }
    }
    retornar m
}

/// ¿Llegaron todos a su destino?
funcion multitud_llegaron(m) {
    para a en m["agentes"] { si (a["destino"] != nulo y a["llego"] == falso) { retornar falso } }
    retornar verdadero
}

/// Distancia mínima entre dos agentes (para verificar que no se chocan).
funcion multitud_distancia_minima(m) {
    sea mejor = nulo
    sea i = 0
    mientras (i < longitud(m["agentes"])) {
        sea j = i + 1
        mientras (j < longitud(m["agentes"])) {
            sea a = m["agentes"][i]
            sea b = m["agentes"][j]
            sea d = raiz((a["x"] - b["x"]) * (a["x"] - b["x"]) + (a["y"] - b["y"]) * (a["y"] - b["y"]))
            si (mejor == nulo o d < mejor) { mejor = d }
            j = j + 1
        }
        i = i + 1
    }
    retornar mejor
}
