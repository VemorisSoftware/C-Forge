// stdlib/tilemap.cfv — mapas de tiles: nombres en inglés del módulo "mosaico".
// English names for the "mosaico" module; both can be used together.

importar "mosaico"

funcion tilemap_new(ancho, alto, tam_tile_x, tam_tile_y) { retornar mosaico_nuevo(ancho, alto, tam_tile_x, tam_tile_y) }
funcion tilemap_layer(m, nombre, datos) { retornar mosaico_capa(m, nombre, datos) }
funcion tilemap_layer_text(m, nombre, texto, leyenda) { retornar mosaico_capa_texto(m, nombre, texto, leyenda) }
funcion tilemap_inside(m, cx, cy) { retornar mosaico_dentro(m, cx, cy) }
funcion tilemap_get(m, capa, cx, cy) { retornar mosaico_tile(m, capa, cx, cy) }
funcion tilemap_set(m, capa, cx, cy, id) { retornar mosaico_poner(m, capa, cx, cy, id) }
funcion tilemap_cell(m, x, y) { retornar mosaico_celda(m, x, y) }
funcion tilemap_pixel(m, cx, cy) { retornar mosaico_pixel(m, cx, cy) }
funcion tilemap_solid(m, capa, x, y) { retornar mosaico_solido(m, capa, x, y) }
funcion tilemap_collides(m, capa, caja) { retornar mosaico_choca(m, capa, caja) }
/// box: {"x", "y", "width", "height"} → {"x", "y", "width", "height", "hit_x", "hit_y"}
funcion tilemap_move(m, capa, caja, dx, dy) {
    sea ancho = 0
    sea alto = 0
    si (tiene_clave(caja, "width")) { ancho = caja["width"] } sino { ancho = caja["ancho"] }
    si (tiene_clave(caja, "height")) { alto = caja["height"] } sino { alto = caja["alto"] }
    sea r = mosaico_mover(m, capa, {"x": caja["x"], "y": caja["y"], "ancho": ancho, "alto": alto}, dx, dy)
    retornar {"x": r["x"], "y": r["y"], "width": r["ancho"], "height": r["alto"], "hit_x": r["choco_x"], "hit_y": r["choco_y"]}
}
funcion tilemap_add_object(m, capa, objeto) { retornar mosaico_agregar_objeto(m, capa, objeto) }
funcion tilemap_objects(m, capa, nombre) { retornar mosaico_objetos(m, capa, nombre) }
funcion tilemap_visible(m, camara) { retornar mosaico_visibles(m, camara) }
funcion tilemap_from_tiled(texto) { retornar mosaico_desde_tiled(texto) }
funcion tilemap_path(m, capa, desde, hasta) { retornar mosaico_camino(m, capa, desde, hasta) }
