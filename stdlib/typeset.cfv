// stdlib/typeset.cfv — composición tipográfica de PDFs: nombres en inglés del módulo "composicion".
// English names for the "composicion" module; both can be used together.


importar "composicion"

funcion _typeset_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_typeset_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _typeset_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _TYPESET_OPT = {"size": "tamano", "landscape": "horizontal", "margins": "margenes", "font": "fuente", "font_size": "tamano_texto", "line_height": "interlineado", "header": "encabezado", "footer": "pie", "title": "titulo", "author": "autor", "accent_color": "color_acento", "align": "alinear", "indent": "sangria", "widths": "anchos", "zebra": "cebra", "header_row": "cabecera", "bold": "negrita", "color": "color"}

funcion typeset_new(opciones) { retornar composicion_nueva(_typeset_opt(opciones)) }
funcion typeset_paragraph(c, texto, opciones) { retornar composicion_parrafo(c, texto, _typeset_opt(opciones)) }
funcion typeset_heading(c, texto, nivel) { retornar composicion_titulo(c, texto, nivel) }
funcion typeset_list(c, elementos, numerada) { retornar composicion_lista(c, elementos, numerada) }
funcion typeset_quote(c, texto) { retornar composicion_cita(c, texto) }
funcion typeset_code(c, texto) { retornar composicion_codigo(c, texto) }
funcion typeset_rule(c) { retornar composicion_regla(c) }
funcion typeset_space(c, puntos) { retornar composicion_espacio(c, puntos) }
funcion typeset_page_break(c) { retornar composicion_salto(c) }
funcion typeset_image(c, datos, ancho, pie_) { retornar composicion_imagen(c, datos, ancho, pie_) }
funcion typeset_table(c, filas, opciones) { retornar composicion_tabla(c, filas, _typeset_opt(opciones)) }
funcion typeset_markdown(c, md) { retornar composicion_markdown(c, md) }
funcion typeset_pdf(c) { retornar composicion_pdf(c) }

funcion _typeset_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_TYPESET_OPT[k] ?? k] = o[k] }
    retornar r
}
