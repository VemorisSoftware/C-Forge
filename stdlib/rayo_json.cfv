// stdlib/rayo_json.cfv — JSON rápido al estilo simdjson: índice estructural,
// acceso bajo demanda con punteros JSON (RFC 6901) sin armar todo el árbol,
// validación estricta con línea y columna (incluye UTF-8), minificado y
// JSON por líneas (NDJSON).
//
// El truco es el mismo de simdjson pero sin SIMD: en vez de mirar byte por
// byte, se salta con búsquedas nativas (bytes_buscar) al siguiente carácter
// que importa, así los textos largos y los valores que no se piden se
// recorren casi gratis.
//
// Uso:
//   importar "rayo_json"
//   sea d = rayo_json_abrir(texto)
//   rayo_json_en(d, "/usuarios/3/nombre")
//   rayo_json_contar(d, "/usuarios")
//   rayo_json_validar(texto)   // {"valido", "mensaje", "linea", "columna", "posicion"}

importar "json"

// ---------- utilidades ----------

funcion _rz_ws(t, i, n) {
    sea k = i
    mientras (k < n) {
        sea c = byte_en(t, k)
        si (c != 32 y c != 10 y c != 13 y c != 9) { retornar k }
        k = k + 1
    }
    retornar k
}

// Fin (posición después de la comilla de cierre) del texto que empieza en i.
funcion _rz_fin_texto(t, i) {
    sea j = i + 1
    mientras (verdadero) {
        sea q = bytes_buscar(t, "\"", j)
        si (q < 0) { lanzar "rayo_json: texto sin cerrar en la posición " + i }
        // Cuenta las barras invertidas justo antes.
        sea b = 0
        mientras (q - 1 - b > i y byte_en(t, q - 1 - b) == 92) { b = b + 1 }
        si (b % 2 == 0) { retornar q + 1 }
        j = q + 1
    }
}

funcion _rz_prox(t, s, desde) {
    sea p = bytes_buscar(t, s, desde)
    si (p < 0) { retornar 9223372036854775 }
    retornar p
}

// Salta un valor completo que empieza en i (sin espacios antes) y devuelve
// la posición siguiente.
funcion _rz_saltar(t, i, n) {
    si (i >= n) { lanzar "rayo_json: se esperaba un valor al final" }
    sea c = byte_en(t, i)
    si (c == 34) { retornar _rz_fin_texto(t, i) }
    si (c == 123 o c == 91) { retornar _rz_saltar_contenedor(t, i) }
    si (c == 116 o c == 110) { retornar i + 4 }
    si (c == 102) { retornar i + 5 }
    sea k = i
    mientras (k < n) {
        sea d = byte_en(t, k)
        si ((d >= 48 y d <= 57) o d == 45 o d == 43 o d == 46 o d == 101 o d == 69) { k = k + 1 } sino { retornar k }
    }
    retornar k
}

// Cinco cursores (comilla, dos aperturas, dos cierres) que avanzan con
// búsquedas nativas: el «índice estructural» se arma sobre la marcha.
funcion _rz_saltar_contenedor(t, i) {
    sea q = _rz_prox(t, "\"", i + 1)
    sea a1 = _rz_prox(t, "[", i + 1)
    sea a2 = _rz_prox(t, "{", i + 1)
    sea c1 = _rz_prox(t, "]", i + 1)
    sea c2 = _rz_prox(t, "}", i + 1)
    sea prof = 1
    mientras (verdadero) {
        sea m = minimo(minimo(q, minimo(a1, a2)), minimo(c1, c2))
        si (m >= 9223372036854775) { lanzar "rayo_json: contenedor sin cerrar en la posición " + i }
        si (m == q) {
            sea f = _rz_fin_texto(t, q)
            q = _rz_prox(t, "\"", f)
            si (a1 < f) { a1 = _rz_prox(t, "[", f) }
            si (a2 < f) { a2 = _rz_prox(t, "{", f) }
            si (c1 < f) { c1 = _rz_prox(t, "]", f) }
            si (c2 < f) { c2 = _rz_prox(t, "}", f) }
        } sino si (m == a1) {
            prof = prof + 1
            a1 = _rz_prox(t, "[", m + 1)
        } sino si (m == a2) {
            prof = prof + 1
            a2 = _rz_prox(t, "{", m + 1)
        } sino {
            prof = prof - 1
            si (prof == 0) { retornar m + 1 }
            si (m == c1) { c1 = _rz_prox(t, "]", m + 1) } sino { c2 = _rz_prox(t, "}", m + 1) }
        }
    }
}

funcion _rz_clave(t, i, f) {
    sea crudo = subtexto(t, i + 1, f - 1)
    si (bytes_buscar(crudo, "\\", 0) < 0) { retornar crudo }
    retornar json_parsear(subtexto(t, i, f))
}

funcion _rz_puntero(p) {
    si (tipo(p) == "lista") { retornar p }
    si (p == nulo o p == "") { retornar [] }
    si (subtexto(p, 0, 1) != "/") { lanzar "rayo_json: el puntero debe empezar con / (" + p + ")" }
    sea r = []
    para parte en texto_dividir(subtexto(p, 1, longitud(p)), "/") {
        r.agregar(texto_reemplazar(texto_reemplazar(parte, "~1", "/"), "~0", "~"))
    }
    retornar r
}

funcion _rz_indice_texto(p) {
    sea n = longitud(p)
    si (n == 0 o (n > 1 y byte_en(p, 0) == 48)) { retornar -1 }
    sea r = 0
    sea i = 0
    mientras (i < n) {
        sea c = byte_en(p, i)
        si (c < 48 o c > 57) { retornar -1 }
        r = r * 10 + (c - 48)
        i = i + 1
    }
    retornar r
}

// Posición [inicio, fin] del valor en el puntero, o nulo si no está.
funcion _rz_ubicar(d, puntero) {
    sea t = d["t"]
    sea n = d["n"]
    sea i = _rz_ws(t, d["inicio"] ?? 0, n)
    para paso en _rz_puntero(puntero) {
        si (i >= n) { retornar nulo }
        sea c = byte_en(t, i)
        si (c == 123) {
            sea encontrado = falso
            i = _rz_ws(t, i + 1, n)
            si (byte_en(t, i) == 125) { retornar nulo }
            mientras (encontrado == falso) {
                si (byte_en(t, i) != 34) { lanzar "rayo_json: se esperaba una clave en la posición " + i }
                sea f = _rz_fin_texto(t, i)
                sea k = _rz_clave(t, i, f)
                i = _rz_ws(t, f, n)
                si (byte_en(t, i) != 58) { lanzar "rayo_json: se esperaba ':' en la posición " + i }
                i = _rz_ws(t, i + 1, n)
                si (k == "" + paso) { encontrado = verdadero } sino {
                    i = _rz_ws(t, _rz_saltar(t, i, n), n)
                    si (i >= n o byte_en(t, i) == 125) { retornar nulo }
                    i = _rz_ws(t, i + 1, n)
                }
            }
        } sino si (c == 91) {
            sea idx = -1
            si (tipo(paso) == "numero") { idx = paso } sino { idx = _rz_indice_texto(paso) }
            si (idx < 0) { retornar nulo }
            i = _rz_ws(t, i + 1, n)
            si (byte_en(t, i) == 93) { retornar nulo }
            sea k = 0
            mientras (k < idx) {
                i = _rz_ws(t, _rz_saltar(t, i, n), n)
                si (i >= n o byte_en(t, i) == 93) { retornar nulo }
                i = _rz_ws(t, i + 1, n)
                k = k + 1
            }
        } sino { retornar nulo }
    }
    si (i >= n) { retornar nulo }
    retornar [i, _rz_saltar(t, i, n)]
}

// ---------- acceso bajo demanda ----------

/// Prepara un documento para consultarlo sin parsearlo entero.
funcion rayo_json_abrir(texto) {
    retornar {"t": texto, "n": longitud(texto), "inicio": 0}
}

/// Texto JSON crudo del valor en el puntero (o nulo).
funcion rayo_json_crudo(d, puntero) {
    sea r = _rz_ubicar(d, puntero)
    si (r == nulo) { retornar nulo }
    retornar subtexto(d["t"], r[0], r[1])
}

/// Valor en el puntero ya convertido (o nulo si no existe).
funcion rayo_json_en(d, puntero) {
    sea c = rayo_json_crudo(d, puntero)
    si (c == nulo) { retornar nulo }
    retornar _rz_p([0], c, longitud(c))
}

/// ¿Existe el puntero?
funcion rayo_json_existe(d, puntero) { retornar _rz_ubicar(d, puntero) != nulo }

/// Tipo del valor: "objeto", "lista", "texto", "numero", "booleano", "nulo"
/// (o nulo si no existe).
funcion rayo_json_tipo(d, puntero) {
    sea r = _rz_ubicar(d, puntero)
    si (r == nulo) { retornar nulo }
    sea c = byte_en(d["t"], r[0])
    si (c == 123) { retornar "objeto" }
    si (c == 91) { retornar "lista" }
    si (c == 34) { retornar "texto" }
    si (c == 116 o c == 102) { retornar "booleano" }
    si (c == 110) { retornar "nulo" }
    retornar "numero"
}

/// Sub-documento en el puntero (para seguir consultando desde ahí).
funcion rayo_json_sub(d, puntero) {
    sea r = _rz_ubicar(d, puntero)
    si (r == nulo) { retornar nulo }
    retornar {"t": d["t"], "n": r[1], "inicio": r[0]}
}

/// Recorre los elementos de una lista u objeto sin convertirlos:
/// fn(clave_o_indice, sub_documento). Si fn devuelve falso, se detiene.
funcion rayo_json_recorrer(d, puntero, fn) {
    sea r = _rz_ubicar(d, puntero)
    si (r == nulo) { retornar nulo }
    sea t = d["t"]
    sea n = r[1]
    sea i = r[0]
    sea c = byte_en(t, i)
    si (c != 123 y c != 91) { lanzar "rayo_json_recorrer: no es lista ni objeto" }
    sea cierre = 93
    si (c == 123) { cierre = 125 }
    i = _rz_ws(t, i + 1, n)
    sea k = 0
    mientras (byte_en(t, i) != cierre) {
        sea clave = k
        si (c == 123) {
            sea f = _rz_fin_texto(t, i)
            clave = _rz_clave(t, i, f)
            i = _rz_ws(t, _rz_ws(t, f, n) + 1, n)
        }
        sea fin = _rz_saltar(t, i, n)
        si (fn(clave, {"t": t, "n": fin, "inicio": i}) == falso) { retornar nulo }
        i = _rz_ws(t, fin, n)
        si (byte_en(t, i) == 44) { i = _rz_ws(t, i + 1, n) }
        k = k + 1
    }
}

/// Cantidad de elementos de una lista u objeto (sin convertirlos).
funcion rayo_json_contar(d, puntero) {
    sea r = [0]
    rayo_json_recorrer(d, puntero, funcion(k, s) { r[0] = r[0] + 1 })
    retornar r[0]
}

/// Claves de un objeto, en orden.
funcion rayo_json_claves(d, puntero) {
    sea r = []
    rayo_json_recorrer(d, puntero, funcion(k, s) { r.agregar(k) })
    retornar r
}

/// Valor convertido de un sub-documento (o del documento entero).
funcion rayo_json_valor(d) { retornar rayo_json_en(d, "") }

/// Extrae varios campos de cada elemento de una lista, sin convertir el
/// resto: rayo_json_columnas(d, "/filas", ["id", "nombre"]).
funcion rayo_json_columnas(d, puntero, campos) {
    sea filas = []
    rayo_json_recorrer(d, puntero, funcion(k, s) {
        sea fila = {}
        para c en campos { fila[c] = rayo_json_en(s, [c]) }
        filas.agregar(fila)
    })
    retornar filas
}

/// Índice estructural: posiciones de { } [ ] : , fuera de los textos.
funcion rayo_json_indice(texto) {
    sea t = texto
    sea n = longitud(t)
    sea r = []
    sea i = 0
    mientras (i < n) {
        sea c = byte_en(t, i)
        si (c == 34) { i = _rz_fin_texto(t, i) } sino {
            si (c == 123 o c == 125 o c == 91 o c == 93 o c == 58 o c == 44) { r.agregar(i) }
            i = i + 1
        }
    }
    retornar r
}

// ---------- validación estricta ----------

funcion _rz_err(v, msg, i) {
    v["error"] = msg
    v["pos"] = i
    lanzar "_rz_invalido"
}

funcion _rz_v_valor(v, t, i, n, prof) {
    si (prof > 1024) { _rz_err(v, "demasiada profundidad", i) }
    si (i >= n) { _rz_err(v, "se esperaba un valor", i) }
    sea c = byte_en(t, i)
    si (c == 123) {
        sea k = _rz_ws(t, i + 1, n)
        si (k < n y byte_en(t, k) == 125) { retornar k + 1 }
        mientras (verdadero) {
            si (k >= n o byte_en(t, k) != 34) { _rz_err(v, "se esperaba una clave entre comillas", k) }
            k = _rz_ws(t, _rz_v_texto(v, t, k, n), n)
            si (k >= n o byte_en(t, k) != 58) { _rz_err(v, "se esperaba ':'", k) }
            k = _rz_ws(t, _rz_v_valor(v, t, _rz_ws(t, k + 1, n), n, prof + 1), n)
            si (k >= n) { _rz_err(v, "objeto sin cerrar", k) }
            sea d = byte_en(t, k)
            si (d == 125) { retornar k + 1 }
            si (d != 44) { _rz_err(v, "se esperaba ',' o '}'", k) }
            k = _rz_ws(t, k + 1, n)
        }
    }
    si (c == 91) {
        sea k = _rz_ws(t, i + 1, n)
        si (k < n y byte_en(t, k) == 93) { retornar k + 1 }
        mientras (verdadero) {
            k = _rz_ws(t, _rz_v_valor(v, t, k, n, prof + 1), n)
            si (k >= n) { _rz_err(v, "lista sin cerrar", k) }
            sea d = byte_en(t, k)
            si (d == 93) { retornar k + 1 }
            si (d != 44) { _rz_err(v, "se esperaba ',' o ']'", k) }
            k = _rz_ws(t, k + 1, n)
        }
    }
    si (c == 34) { retornar _rz_v_texto(v, t, i, n) }
    si (c == 116) { retornar _rz_v_literal(v, t, i, n, "true") }
    si (c == 102) { retornar _rz_v_literal(v, t, i, n, "false") }
    si (c == 110) { retornar _rz_v_literal(v, t, i, n, "null") }
    si (c == 45 o (c >= 48 y c <= 57)) { retornar _rz_v_numero(v, t, i, n) }
    _rz_err(v, "carácter inesperado", i)
}

funcion _rz_v_literal(v, t, i, n, lit) {
    si (i + longitud(lit) > n o subtexto(t, i, i + longitud(lit)) != lit) { _rz_err(v, "literal inválido (¿" + lit + "?)", i) }
    retornar i + longitud(lit)
}

funcion _rz_digito(t, k, n) {
    si (k >= n) { retornar falso }
    sea c = byte_en(t, k)
    retornar c >= 48 y c <= 57
}

funcion _rz_v_numero(v, t, i, n) {
    sea k = i
    si (byte_en(t, k) == 45) { k = k + 1 }
    si (_rz_digito(t, k, n) == falso) { _rz_err(v, "número inválido", k) }
    si (byte_en(t, k) == 48) {
        k = k + 1
        si (_rz_digito(t, k, n)) { _rz_err(v, "número con ceros a la izquierda", k) }
    } sino {
        mientras (_rz_digito(t, k, n)) { k = k + 1 }
    }
    si (k < n y byte_en(t, k) == 46) {
        k = k + 1
        si (_rz_digito(t, k, n) == falso) { _rz_err(v, "faltan decimales", k) }
        mientras (_rz_digito(t, k, n)) { k = k + 1 }
    }
    si (k < n y (byte_en(t, k) == 101 o byte_en(t, k) == 69)) {
        k = k + 1
        si (k < n y (byte_en(t, k) == 43 o byte_en(t, k) == 45)) { k = k + 1 }
        si (_rz_digito(t, k, n) == falso) { _rz_err(v, "exponente inválido", k) }
        mientras (_rz_digito(t, k, n)) { k = k + 1 }
    }
    retornar k
}

funcion _rz_hex(c) { retornar (c >= 48 y c <= 57) o (c >= 65 y c <= 70) o (c >= 97 y c <= 102) }

funcion _rz_v_texto(v, t, i, n) {
    sea k = i + 1
    mientras (verdadero) {
        si (k >= n) { _rz_err(v, "texto sin cerrar", i) }
        sea c = byte_en(t, k)
        si (c == 34) { retornar k + 1 }
        si (c < 32) { _rz_err(v, "carácter de control dentro de un texto", k) }
        si (c == 92) {
            si (k + 1 >= n) { _rz_err(v, "escape incompleto", k) }
            sea e = byte_en(t, k + 1)
            si (e == 117) {
                sea j = 2
                mientras (j < 6) {
                    si (k + j >= n o _rz_hex(byte_en(t, k + j)) == falso) { _rz_err(v, "\\u inválido", k) }
                    j = j + 1
                }
                k = k + 6
            } sino si (e == 34 o e == 92 o e == 47 o e == 98 o e == 102 o e == 110 o e == 114 o e == 116) { k = k + 2 } sino {
                _rz_err(v, "escape inválido", k)
            }
        } sino si (c < 128) { k = k + 1 } sino {
            // UTF-8: largo, continuación, sobrelargos y sustitutos.
            sea largo = 0
            sea minimo_cp = 0
            sea cp = 0
            si (c >= 194 y c <= 223) {
                largo = 2
                cp = c - 192
                minimo_cp = 128
            } sino si (c >= 224 y c <= 239) {
                largo = 3
                cp = c - 224
                minimo_cp = 2048
            } sino si (c >= 240 y c <= 244) {
                largo = 4
                cp = c - 240
                minimo_cp = 65536
            } sino { _rz_err(v, "UTF-8 inválido", k) }
            sea j = 1
            mientras (j < largo) {
                si (k + j >= n) { _rz_err(v, "UTF-8 cortado", k) }
                sea b = byte_en(t, k + j)
                si (b < 128 o b > 191) { _rz_err(v, "UTF-8 inválido", k) }
                cp = cp * 64 + (b - 128)
                j = j + 1
            }
            si (cp < minimo_cp o cp > 1114111 o (cp >= 55296 y cp <= 57343)) { _rz_err(v, "UTF-8 inválido", k) }
            k = k + largo
        }
    }
}

funcion _rz_linea_col(t, pos) {
    sea linea = 1
    sea inicio = 0
    sea k = bytes_buscar(t, "\n", 0)
    mientras (k >= 0 y k < pos) {
        linea = linea + 1
        inicio = k + 1
        k = bytes_buscar(t, "\n", k + 1)
    }
    retornar [linea, pos - inicio + 1]
}

/// Valida JSON estricto (RFC 8259, UTF-8). Devuelve {"valido": verdadero} o
/// {"valido": falso, "mensaje", "posicion", "linea", "columna"}.
funcion rayo_json_validar(texto) {
    sea v = {"error": nulo, "pos": 0}
    sea n = longitud(texto)
    intentar {
        sea k = _rz_ws(texto, _rz_v_valor(v, texto, _rz_ws(texto, 0, n), n, 0), n)
        si (k < n) { _rz_err(v, "sobra texto después del valor", k) }
    } capturar (e) {
        si (v["error"] == nulo) { lanzar e }
        sea lc = _rz_linea_col(texto, v["pos"])
        retornar {"valido": falso, "mensaje": v["error"], "posicion": v["pos"], "linea": lc[0], "columna": lc[1]}
    }
    retornar {"valido": verdadero}
}

// ---------- parser completo ----------

funcion _rz_desescapar(t, i, f) {
    sea crudo = subtexto(t, i + 1, f - 1)
    si (bytes_buscar(crudo, "\\", 0) < 0) { retornar crudo }
    sea partes = []
    sea k = 0
    sea n = longitud(crudo)
    mientras (k < n) {
        sea b = bytes_buscar(crudo, "\\", k)
        si (b < 0) {
            partes.agregar(subtexto(crudo, k, n))
            k = n
        } sino {
            si (b > k) { partes.agregar(subtexto(crudo, k, b)) }
            sea e = byte_en(crudo, b + 1)
            si (e == 110) { partes.agregar("\n") } sino si (e == 116) { partes.agregar("\t") } sino si (e == 114) { partes.agregar("\r") }
            sino si (e == 98) { partes.agregar(char_de(8)) } sino si (e == 102) { partes.agregar(char_de(12)) }
            sino si (e == 117) {
                sea cp = _rz_hex4(crudo, b + 2)
                sea paso = 6
                si (cp >= 55296 y cp <= 56319 y b + 11 < n + 0 y byte_en(crudo, b + 6) == 92 y byte_en(crudo, b + 7) == 117) {
                    sea lo = _rz_hex4(crudo, b + 8)
                    si (lo >= 56320 y lo <= 57343) {
                        cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
                        paso = 12
                    }
                }
                partes.agregar(caracter(cp))
                k = b + paso
                continuar
            } sino { partes.agregar(char_de(e)) }
            k = b + 2
        }
    }
    retornar unir(partes, "")
}

funcion _rz_hex4(t, i) {
    sea r = 0
    sea k = 0
    mientras (k < 4) {
        sea c = byte_en(t, i + k)
        sea d = c - 48
        si (c >= 97) { d = c - 87 } sino si (c >= 65) { d = c - 55 }
        r = r * 16 + d
        k = k + 1
    }
    retornar r
}

funcion _rz_p(st, t, n) {
    sea i = _rz_ws(t, st[0], n)
    sea c = byte_en(t, i)
    si (c == 34) {
        sea f = _rz_fin_texto(t, i)
        st[0] = f
        retornar _rz_desescapar(t, i, f)
    }
    si (c == 123) {
        sea r = {}
        i = _rz_ws(t, i + 1, n)
        si (byte_en(t, i) == 125) {
            st[0] = i + 1
            retornar r
        }
        mientras (verdadero) {
            sea f = _rz_fin_texto(t, i)
            sea k = _rz_desescapar(t, i, f)
            st[0] = _rz_ws(t, f, n) + 1
            r[k] = _rz_p(st, t, n)
            i = _rz_ws(t, st[0], n)
            si (byte_en(t, i) == 125) {
                st[0] = i + 1
                retornar r
            }
            i = _rz_ws(t, i + 1, n)
        }
    }
    si (c == 91) {
        sea r = []
        i = _rz_ws(t, i + 1, n)
        si (byte_en(t, i) == 93) {
            st[0] = i + 1
            retornar r
        }
        st[0] = i
        mientras (verdadero) {
            r.agregar(_rz_p(st, t, n))
            i = _rz_ws(t, st[0], n)
            si (byte_en(t, i) == 93) {
                st[0] = i + 1
                retornar r
            }
            st[0] = i + 1
        }
    }
    si (c == 116) {
        st[0] = i + 4
        retornar verdadero
    }
    si (c == 102) {
        st[0] = i + 5
        retornar falso
    }
    si (c == 110) {
        st[0] = i + 4
        retornar nulo
    }
    sea f = _rz_saltar(t, i, n)
    st[0] = f
    retornar _rz_numero(subtexto(t, i, f))
}

funcion _rz_numero(s) {
    // Enteros cortos sin pasar por a_numero.
    sea n = longitud(s)
    si (n < 16) {
        sea r = 0
        sea k = 0
        sea neg = falso
        si (byte_en(s, 0) == 45) {
            neg = verdadero
            k = 1
        }
        mientras (k < n) {
            sea c = byte_en(s, k)
            si (c < 48 o c > 57) { retornar a_numero(s) }
            r = r * 10 + (c - 48)
            k = k + 1
        }
        si (neg) { retornar 0 - r }
        retornar r
    }
    retornar a_numero(s)
}

/// Parsea con validación estricta; el error dice línea y columna. Suele ser
/// bastante más rápido que json_parsear en documentos grandes.
funcion rayo_json_parsear(texto) {
    sea r = rayo_json_validar(texto)
    si (r["valido"] == falso) { lanzar "rayo_json: " + r["mensaje"] + " (línea " + r["linea"] + ", columna " + r["columna"] + ")" }
    retornar _rz_p([0], texto, longitud(texto))
}

// ---------- minificar y NDJSON ----------

/// Quita los espacios que sobran (los textos quedan intactos).
funcion rayo_json_minificar(texto) {
    sea t = texto
    sea n = longitud(t)
    sea partes = []
    sea i = 0
    sea desde = 0
    mientras (i < n) {
        sea c = byte_en(t, i)
        si (c == 34) { i = _rz_fin_texto(t, i) } sino si (c == 32 o c == 10 o c == 13 o c == 9) {
            si (i > desde) { partes.agregar(subtexto(t, desde, i)) }
            i = _rz_ws(t, i, n)
            desde = i
        } sino { i = i + 1 }
    }
    si (n > desde) { partes.agregar(subtexto(t, desde, n)) }
    retornar unir(partes, "")
}

/// Recorre un texto NDJSON (un valor por línea): fn(valor, numero_de_linea).
/// Las líneas vacías se saltan. Si fn devuelve falso, se detiene.
funcion rayo_json_lineas_recorrer(texto, fn) {
    sea n = longitud(texto)
    sea i = 0
    sea linea = 1
    mientras (i < n) {
        sea f = bytes_buscar(texto, "\n", i)
        si (f < 0) { f = n }
        sea l = texto_recortar(subtexto(texto, i, f))
        si (l != "") {
            sea r = rayo_json_validar(l)
            si (r["valido"] == falso) { lanzar "rayo_json: línea " + linea + ": " + r["mensaje"] + " (columna " + r["columna"] + ")" }
            si (fn(json_parsear(l), linea) == falso) { retornar nulo }
        }
        i = f + 1
        linea = linea + 1
    }
}

/// Todos los valores de un texto NDJSON.
funcion rayo_json_lineas(texto) {
    sea r = []
    rayo_json_lineas_recorrer(texto, funcion(v, l) { r.agregar(v) })
    retornar r
}

/// Serializa una lista de valores como NDJSON.
funcion rayo_json_a_lineas(valores) {
    sea partes = []
    para v en valores { partes.agregar(json_serializar(v)) }
    retornar unir(partes, "\n") + "\n"
}
