    "text-shadow-sm=0px 1px 0px rgb(0 0 0 / 0.075), 0px 1px 1px rgb(0 0 0 / 0.075), 0px 2px 2px rgb(0 0 0 / 0.075)\ntext-shadow-md=0px 1px 1px rgb(0 0 0 / 0.1), 0px 1px 2px rgb(0 0 0 / 0.1), 0px 2px 4px rgb(0 0 0 / 0.1)\ntext-shadow-lg=0px 1px 2px rgb(0 0 0 / 0.1), 0px 3px 2px rgb(0 0 0 / 0.1), 0px 4px 8px rgb(0 0 0 / 0.1)\nease-in=cubic-bezier(0.4, 0, 1, 1)\nease-out=cubic-bezier(0, 0, 0.2, 1)\nease-in-out=cubic-bezier(0.4, 0, 0.2, 1)\nanimate-spin=spin 1s linear infinite\nanimate-ping=ping 1s cubic-bezier(0, 0, 0.2, 1) infinite\nanimate-pulse=pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite\nanimate-bounce=bounce 1s infinite\nblur-xs=4px\nblur-sm=8px\nblur-md=12px\nblur-lg=16px\nblur-xl=24px\nblur-2xl=40px\nblur-3xl=64px\nperspective-dramatic=100px\nperspective-near=300px\nperspective-normal=500px\nperspective-midrange=800px\nperspective-distant=1200px\naspect-video=16 / 9\ndefault-transition-duration=150ms\ndefault-transition-timing-function=cubic-bezier(0.4, 0, 0.2, 1)\ndefault-font-family=--theme(--font-sans, initial)\ndefault-font-feature-settings=--theme(--font-sans--font-feature-settings, initial)\ndefault-font-variation-settings=--theme(--font-sans--font-variation-settings, initial)\ndefault-mono-font-family=--theme(--font-mono, initial)\ndefault-mono-font-feature-settings=--theme(--font-mono--font-feature-settings, initial)\ndefault-mono-font-variation-settings=--theme(--font-mono--font-variation-settings, initial)\nblur=8px\nshadow=0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)\nshadow-inner=inset 0 2px 4px 0 rgb(0 0 0 / 0.05)\ndrop-shadow=0 1px 2px rgb(0 0 0 / 0.1), 0 1px 1px rgb(0 0 0 / 0.06)\nradius=0.25rem\nmax-width-prose=65ch\n"

sea _ES_LL = caracter(123)
sea _ES_RR = caracter(125)
sea _ES_TEMA = nulo
sea _ES_ORDEN_TEMA = []

funcion _es_tema() {
    si (_ES_TEMA != nulo) { retornar _ES_TEMA }
    sea t = {}
    para l en texto_dividir(_ES_TEMA_TXT, "\n") {
        sea e = texto_indice(l, "=")
        si (e > 0) {
            t[subcadena(l, 0, e)] = subcadena(l, e + 1, longitud(l))
            _ES_ORDEN_TEMA.agregar(subcadena(l, 0, e))
        }
    }
    _ES_TEMA = t
    retornar t
}

/// Valor del tema (sin el "--"): "color-red-500", "spacing", "breakpoint-md"…
funcion estilos_tema(nombre) { retornar _es_tema()[nombre] ?? nulo }

// ── Escapado de selectores (CSS.escape) ───────────────────────────────────

funcion _es_escapar(t) {
    sea r = ""
    sea i = 0
    sea n = longitud(t)
    mientras (i < n) {
        sea b = byte_en(t, i)
        sea c = subcadena(t, i, i + 1)
        si (b >= 128 o (b >= 48 y b <= 57 y i > 0) o (b >= 65 y b <= 90) o (b >= 97 y b <= 122) o b == 95 o (b == 45 y (i > 0 o n > 1))) {
            si (b == 45 y i == 0 y n > 1 y byte_en(t, 1) >= 48 y byte_en(t, 1) <= 57) { r = r + c } sino { r = r + c }
        } sino {
            si (b >= 48 y b <= 57 y i == 0) { r = r + "\\3" + c + " " } sino { r = r + "\\" + c }
        }
        i = i + 1
    }
    retornar r
}

// ── Valores ───────────────────────────────────────────────────────────────

funcion _es_num(t) {
    // Número decimal positivo (múltiplo de 0.25 en Tailwind).
    si (t == "" o t == nulo) { retornar falso }
    sea i = 0
    sea punto = falso
    mientras (i < longitud(t)) {
        sea b = byte_en(t, i)
        si (b == 46) {
            si (punto o i == 0 o i == longitud(t) - 1) { retornar falso }
            punto = verdadero
        } sino { si (b < 48 o b > 57) { retornar falso } }
        i = i + 1
    }
    retornar verdadero
}

funcion _es_entero(t) { retornar _es_num(t) y texto_indice(t, ".") < 0 }

funcion _es_fraccion(t) {
    sea b = texto_indice(t, "/")
    retornar b > 0 y _es_entero(subcadena(t, 0, b)) y _es_entero(subcadena(t, b + 1, longitud(t)))
}

funcion _es_arbitrario(t) {
    si (texto_empieza_con(t, "[") y texto_termina_con(t, "]")) {
        sea v = subcadena(t, 1, longitud(t) - 1)
        // Los guiones bajos son espacios (como en Tailwind).
        retornar texto_reemplazar(v, "_", " ")
    }
    retornar nulo
}

// Valor de espaciado: número, px, fracción o arbitrario. ctx registra vars.
funcion _es_espacio(v, ctx, negativo, permite_fraccion) {
    sea arb = _es_arbitrario(v)
    si (arb != nulo) {
        si (negativo) { retornar "calc(" + arb + " * -1)" }
        retornar arb
    }
    si (v == "px") {
        si (negativo) { retornar "-1px" }
        retornar "1px"
    }
    si (v == "0") {
        si (negativo) { retornar "calc(var(--spacing) * -0)" }
        retornar "0px"
    }
    si (_es_num(v)) {
        _es_usar(ctx, "spacing")
        si (negativo) { retornar "calc(var(--spacing) * -" + v + ")" }
        si (v == "1") { retornar "var(--spacing)" }
        retornar "calc(var(--spacing) * " + v + ")"
    }
    si (permite_fraccion y _es_fraccion(v)) {
        sea b = texto_indice(v, "/")
        sea s = "calc(" + subcadena(v, 0, b) + " / " + subcadena(v, b + 1, longitud(v)) + " * 100%)"
        si (negativo) { retornar "calc(" + subcadena(v, 0, b) + " / " + subcadena(v, b + 1, longitud(v)) + " * -100%)" }
        retornar s
    }
    retornar nulo
}

funcion _es_usar(ctx, var_) { si (tiene_clave(ctx["vars"], var_) == falso) { ctx["vars"][var_] = verdadero } }

funcion _es_prop(ctx, nombre) { ctx["props"][nombre] = verdadero }

// Color: nombre del tema, especiales, arbitrario, con /opacidad.
funcion _es_color(v, ctx) {
    sea alfa = nulo
    sea base = v
    sea barra = texto_indice(v, "/")
    si (barra > 0 y texto_termina_con(v, "]") == falso) {
        base = subcadena(v, 0, barra)
        alfa = subcadena(v, barra + 1, longitud(v))
    }
    si (base == "transparent") { retornar ["transparent", nulo] }
    si (base == "current") { retornar ["currentcolor", nulo] }
    si (base == "inherit") { retornar ["inherit", nulo] }
    sea arb = _es_arbitrario(base)
    sea valor = nulo
    sea literal = nulo
    si (arb != nulo) {
        valor = arb
        literal = arb
    } sino {
        sea t = _es_tema()
        si (tiene_clave(t, "color-" + base) == falso) { retornar nulo }
        valor = "var(--color-" + base + ")"
        literal = t["color-" + base]
        _es_usar(ctx, "color-" + base)
    }
    si (alfa == nulo) { retornar [valor, nulo] }
    sea pct = alfa
    si (_es_num(alfa)) { pct = alfa + "%" } sino {
        sea a2 = _es_arbitrario(alfa)
        si (a2 == nulo) { retornar nulo }
        pct = a2
        si (_es_num(a2) y texto_indice(a2, ".") >= 0) { pct = (a2 * 100) + "%" }
    }
    si (arb != nulo) { retornar ["color-mix(in oklab, " + valor + " " + pct + ", transparent)", nulo] }
    // Con respaldo para navegadores sin color-mix en oklab.
    retornar ["color-mix(in srgb, " + literal + " " + pct + ", transparent)", "color-mix(in oklab, " + valor + " " + pct + ", transparent)"]
}

sea _ES_FIJAS = nulo

funcion _es_fijas() {
    si (_ES_FIJAS != nulo) { retornar _ES_FIJAS }
    sea f = {}
    para d en ["block", "inline-block", "inline", "flex", "inline-flex", "grid", "inline-grid", "contents", "table", "table-row", "table-cell", "flow-root", "list-item"] { f[d] = [["display", d]] }
    f["hidden"] = [["display", "none"]]
    para p en ["static", "fixed", "absolute", "relative", "sticky"] { f[p] = [["position", p]] }
    f["visible"] = [["visibility", "visible"]]
    f["invisible"] = [["visibility", "hidden"]]
    f["collapse"] = [["visibility", "collapse"]]
    f["flex-row"] = [["flex-direction", "row"]]
    f["flex-row-reverse"] = [["flex-direction", "row-reverse"]]
    f["flex-col"] = [["flex-direction", "column"]]
    f["flex-col-reverse"] = [["flex-direction", "column-reverse"]]
    f["flex-wrap"] = [["flex-wrap", "wrap"]]
    f["flex-wrap-reverse"] = [["flex-wrap", "wrap-reverse"]]
    f["flex-nowrap"] = [["flex-wrap", "nowrap"]]
    f["flex-auto"] = [["flex", "auto"]]
    f["flex-initial"] = [["flex", "0 auto"]]
    f["flex-none"] = [["flex", "none"]]
    f["grow"] = [["flex-grow", "1"]]
    f["grow-0"] = [["flex-grow", "0"]]
    f["shrink"] = [["flex-shrink", "1"]]
    f["shrink-0"] = [["flex-shrink", "0"]]
    para par en [["start", "flex-start"], ["end", "flex-end"], ["center", "center"], ["baseline", "baseline"], ["stretch", "stretch"]] {
        f["items-" + par[0]] = [["align-items", par[1]]]
        f["self-" + par[0]] = [["align-self", par[1]]]
    }
    f["self-auto"] = [["align-self", "auto"]]
    para par en [["start", "flex-start"], ["end", "flex-end"], ["center", "center"], ["between", "space-between"], ["around", "space-around"], ["evenly", "space-evenly"], ["stretch", "stretch"], ["normal", "normal"]] {
        f["justify-" + par[0]] = [["justify-content", par[1]]]
        f["content-" + par[0]] = [["align-content", par[1]]]
    }
    para par en [["start", "start"], ["end", "end"], ["center", "center"], ["stretch", "stretch"], ["baseline", "baseline"]] { f["place-items-" + par[0]] = [["place-items", par[1]]] }
    para par en [["start", "start"], ["end", "end"], ["center", "center"], ["between", "space-between"], ["around", "space-around"], ["evenly", "space-evenly"], ["stretch", "stretch"]] { f["place-content-" + par[0]] = [["place-content", par[1]]] }
    para par en [["left", "left"], ["center", "center"], ["right", "right"], ["justify", "justify"], ["start", "start"], ["end", "end"]] { f["text-" + par[0]] = [["text-align", par[1]]] }
    f["uppercase"] = [["text-transform", "uppercase"]]
    f["lowercase"] = [["text-transform", "lowercase"]]
    f["capitalize"] = [["text-transform", "capitalize"]]
    f["normal-case"] = [["text-transform", "none"]]
    f["italic"] = [["font-style", "italic"]]
    f["not-italic"] = [["font-style", "normal"]]
    f["underline"] = [["text-decoration-line", "underline"]]
    f["overline"] = [["text-decoration-line", "overline"]]
    f["line-through"] = [["text-decoration-line", "line-through"]]
    f["no-underline"] = [["text-decoration-line", "none"]]
    f["truncate"] = [["overflow", "hidden"], ["text-overflow", "ellipsis"], ["white-space", "nowrap"]]
    f["text-ellipsis"] = [["text-overflow", "ellipsis"]]
    f["text-clip"] = [["text-overflow", "clip"]]
    para w en ["normal", "nowrap", "pre", "pre-line", "pre-wrap", "break-spaces"] { f["whitespace-" + w] = [["white-space", w]] }
    f["break-words"] = [["overflow-wrap", "break-word"]]
    f["break-all"] = [["word-break", "break-all"]]
    f["break-normal"] = [["overflow-wrap", "normal"], ["word-break", "normal"]]
    para o en ["auto", "hidden", "clip", "visible", "scroll"] {
        f["overflow-" + o] = [["overflow", o]]
        f["overflow-x-" + o] = [["overflow-x", o]]
        f["overflow-y-" + o] = [["overflow-y", o]]
    }
    para c en ["auto", "default", "pointer", "wait", "text", "move", "help", "not-allowed", "none", "grab", "grabbing", "crosshair", "zoom-in", "zoom-out", "progress"] { f["cursor-" + c] = [["cursor", c]] }
    f["pointer-events-none"] = [["pointer-events", "none"]]
    f["pointer-events-auto"] = [["pointer-events", "auto"]]
    f["select-none"] = [["-webkit-user-select", "none"], ["user-select", "none"]]
    f["select-text"] = [["-webkit-user-select", "text"], ["user-select", "text"]]
    f["select-all"] = [["-webkit-user-select", "all"], ["user-select", "all"]]
    f["select-auto"] = [["-webkit-user-select", "auto"], ["user-select", "auto"]]
    para o en ["contain", "cover", "fill", "none", "scale-down"] { f["object-" + o] = [["object-fit", o]] }
    f["list-none"] = [["list-style-type", "none"]]
    f["list-disc"] = [["list-style-type", "disc"]]
    f["list-decimal"] = [["list-style-type", "decimal"]]
    f["sr-only"] = [["position", "absolute"], ["width", "1px"], ["height", "1px"], ["padding", "0"], ["margin", "-1px"], ["overflow", "hidden"], ["clip-path", "inset(50%)"], ["white-space", "nowrap"], ["border-width", "0"]]
    f["not-sr-only"] = [["position", "static"], ["width", "auto"], ["height", "auto"], ["padding", "0"], ["margin", "0"], ["overflow", "visible"], ["clip-path", "none"], ["white-space", "normal"]]
    f["aspect-square"] = [["aspect-ratio", "1 / 1"]]
    f["aspect-auto"] = [["aspect-ratio", "auto"]]
    f["isolate"] = [["isolation", "isolate"]]
    f["box-border"] = [["box-sizing", "border-box"]]
    f["box-content"] = [["box-sizing", "content-box"]]
    f["antialiased"] = [["-webkit-font-smoothing", "antialiased"], ["-moz-osx-font-smoothing", "grayscale"]]
    _ES_FIJAS = f
    retornar f
}

funcion _es_lado(base) {
    // Lados de padding/margin: p, px, py, pt, pr, pb, pl, ps, pe.
    sea mapa = {"": [""], "x": ["-inline"], "y": ["-block"], "t": ["-top"], "r": ["-right"], "b": ["-bottom"], "l": ["-left"], "s": ["-inline-start"], "e": ["-inline-end"]}
    retornar mapa[base] ?? nulo
}

// Declaraciones de una utilidad (sin variantes) o nulo si no se reconoce.
funcion _es_utilidad(u, ctx) {
    sea neg = falso
    sea x = u
    si (texto_empieza_con(x, "-")) {
        neg = verdadero
        x = subcadena(x, 1, longitud(x))
    }
    sea fijas = _es_fijas()
    si (neg == falso y tiene_clave(fijas, x)) { retornar fijas[x] }
    sea t = _es_tema()
    // Propiedad arbitraria: [mask-type:luminance]
    si (texto_empieza_con(x, "[") y texto_termina_con(x, "]") y texto_indice(x, ":") > 0) {
        sea dentro = subcadena(x, 1, longitud(x) - 1)
        sea dp = texto_indice(dentro, ":")
        retornar [[subcadena(dentro, 0, dp), texto_reemplazar(subcadena(dentro, dp + 1, longitud(dentro)), "_", " ")]]
    }
    sea guion = texto_indice(x, "-")
    // Padding y margin.
    si (guion > 0 y (texto_empieza_con(x, "p") o texto_empieza_con(x, "m"))) {
        sea pre = subcadena(x, 0, guion)
        sea letra = subcadena(pre, 0, 1)
        sea lado = subcadena(pre, 1, longitud(pre))
        sea lados = _es_lado(lado)
        si (lados != nulo y longitud(pre) <= 2) {
            sea v = subcadena(x, guion + 1, longitud(x))
            sea val = nulo
            si (letra == "m" y v == "auto") { val = "auto" } sino {
                si (letra == "p" y neg) { retornar nulo }
                val = _es_espacio(v, ctx, neg, falso)
            }
            si (val == nulo) { retornar nulo }
            sea prop = "padding"
            si (letra == "m") { prop = "margin" }
            retornar [[prop + lados[0], val]]
        }
    }
    // Tamaños.
    para par en [["w-", ["width"]], ["h-", ["height"]], ["size-", ["width", "height"]], ["min-w-", ["min-width"]], ["min-h-", ["min-height"]], ["max-w-", ["max-width"]], ["max-h-", ["max-height"]], ["basis-", ["flex-basis"]]] {
        si (texto_empieza_con(x, par[0]) y neg == falso) {
            sea v = subcadena(x, longitud(par[0]), longitud(x))
            sea val = nulo
            sea es_w = par[1][0] == "width" o par[1][0] == "min-width" o par[1][0] == "max-width" o par[1][0] == "flex-basis"
            si (v == "auto") { val = "auto" }
            si (v == "full") { val = "100%" }
            si (v == "screen") {
                si (es_w) { val = "100vw" } sino { val = "100vh" }
            }
            si (v == "dvh" o v == "svh" o v == "lvh") { val = "100" + v }
            si (v == "dvw" o v == "svw" o v == "lvw") { val = "100" + v }
            si (v == "min" o v == "max" o v == "fit") { val = v + "-content" }
            si (v == "none" y texto_empieza_con(par[0], "max-")) { val = "none" }
            si (val == nulo y (par[0] == "max-w-" o par[0] == "w-" o par[0] == "min-w-") y tiene_clave(t, "container-" + v)) {
                _es_usar(ctx, "container-" + v)
                val = "var(--container-" + v + ")"
            }
            si (val == nulo) { val = _es_espacio(v, ctx, falso, verdadero) }
            si (val == nulo) { retornar nulo }
            sea r = []
            para p en par[1] { r.agregar([p, val]) }
            retornar r
        }
    }
    // Posición: inset, top, right, bottom, left, inset-x, inset-y.
    para par en [["inset-x-", "inset-inline"], ["inset-y-", "inset-block"], ["inset-", "inset"], ["top-", "top"], ["right-", "right"], ["bottom-", "bottom"], ["left-", "left"], ["start-", "inset-inline-start"], ["end-", "inset-inline-end"]] {
        si (texto_empieza_con(x, par[0])) {
            sea v = subcadena(x, longitud(par[0]), longitud(x))
            sea val = nulo
            si (v == "auto" y neg == falso) { val = "auto" }
            si (v == "full") {
                si (neg) { val = "-100%" } sino { val = "100%" }
            }
            si (val == nulo) { val = _es_espacio(v, ctx, neg, verdadero) }
            si (val == nulo) { retornar nulo }
            retornar [[par[1], val]]
        }
    }
    // Espacios entre hijos.
    si (texto_empieza_con(x, "gap-")) {
        sea v = subcadena(x, 4, longitud(x))
        sea prop = "gap"
        si (texto_empieza_con(v, "x-")) { prop = "column-gap"  v = subcadena(v, 2, longitud(v)) }
        si (texto_empieza_con(v, "y-")) { prop = "row-gap"  v = subcadena(v, 2, longitud(v)) }
        sea val = _es_espacio(v, ctx, falso, falso)
        si (val == nulo o neg) { retornar nulo }
        retornar [[prop, val]]
    }
    si (texto_empieza_con(x, "space-x-") o texto_empieza_con(x, "space-y-")) {
        sea eje = subcadena(x, 6, 7)
        sea val = _es_espacio(subcadena(x, 8, longitud(x)), ctx, neg, falso)
        si (val == nulo) { retornar nulo }
        ctx["hijos"] = ":where(" + _ES_LL + "sel" + _ES_RR + " > :not(:last-child))"
        ctx["propiedades_tw"]["--tw-space-" + eje + "-reverse"] = verdadero
        si (eje == "x") { retornar [["--tw-space-x-reverse", "0"], ["margin-inline-start", "calc(" + val + " * var(--tw-space-x-reverse))"], ["margin-inline-end", "calc(" + val + " * calc(1 - var(--tw-space-x-reverse)))"]] }
        retornar [["--tw-space-y-reverse", "0"], ["margin-block-start", "calc(" + val + " * var(--tw-space-y-reverse))"], ["margin-block-end", "calc(" + val + " * calc(1 - var(--tw-space-y-reverse)))"]]
    }
    // Flex y grid.
    si (x == "flex-1") { retornar [["flex", "1"]] }
    si (texto_empieza_con(x, "order-") y _es_entero(subcadena(x, 6, longitud(x)))) {
        si (neg) { retornar [["order", "calc(" + subcadena(x, 6, longitud(x)) + " * -1)"]] }
        retornar [["order", subcadena(x, 6, longitud(x))]]
    }
    para par en [["grid-cols-", "grid-template-columns"], ["grid-rows-", "grid-template-rows"]] {
        si (texto_empieza_con(x, par[0])) {
            sea v = subcadena(x, longitud(par[0]), longitud(x))
            si (_es_entero(v)) { retornar [[par[1], "repeat(" + v + ", minmax(0, 1fr))"]] }
            si (v == "none") { retornar [[par[1], "none"]] }
            si (v == "subgrid") { retornar [[par[1], "subgrid"]] }
            sea a = _es_arbitrario(v)
            si (a != nulo) { retornar [[par[1], a]] }
            retornar nulo
        }
    }
    para par en [["col-span-", "grid-column"], ["row-span-", "grid-row"]] {
        si (texto_empieza_con(x, par[0])) {
            sea v = subcadena(x, longitud(par[0]), longitud(x))
            si (v == "full") { retornar [[par[1], "1 / -1"]] }
            si (_es_entero(v)) { retornar [[par[1], "span " + v + " / span " + v]] }
            retornar nulo
        }
    }
    para par en [["col-start-", "grid-column-start"], ["col-end-", "grid-column-end"], ["row-start-", "grid-row-start"], ["row-end-", "grid-row-end"]] {
        si (texto_empieza_con(x, par[0])) {
            sea v = subcadena(x, longitud(par[0]), longitud(x))
            si (_es_entero(v)) {
                si (neg) { retornar [[par[1], "calc(" + v + " * -1)"]] }
                retornar [[par[1], v]]
            }
            si (v == "auto") { retornar [[par[1], "auto"]] }
            retornar nulo
        }
    }
    // Capas.
    si (texto_empieza_con(x, "z-")) {
        sea v = subcadena(x, 2, longitud(x))
        si (v == "auto") { retornar [["z-index", "auto"]] }
        si (_es_entero(v)) {
            si (neg) { retornar [["z-index", "calc(" + v + " * -1)"]] }
            retornar [["z-index", v]]
        }
        retornar nulo
    }
    // Tipografía.
    si (texto_empieza_con(x, "text-")) {
        sea v = subcadena(x, 5, longitud(x))
        si (tiene_clave(t, "text-" + v)) {
            _es_usar(ctx, "text-" + v)
            _es_usar(ctx, "text-" + v + "--line-height")
            ctx["propiedades_tw"]["--tw-leading"] = verdadero
            retornar [["font-size", "var(--text-" + v + ")"], ["line-height", "var(--tw-leading, var(--text-" + v + "--line-height))"]]
        }
        sea a = _es_arbitrario(v)
        si (a != nulo y (texto_termina_con(a, "px") o texto_termina_con(a, "rem") o texto_termina_con(a, "em") o texto_termina_con(a, "%"))) { retornar [["font-size", a]] }
        sea col = _es_color(v, ctx)
        si (col != nulo) { retornar _es_con_color("color", col) }
        retornar nulo
    }
    si (texto_empieza_con(x, "font-")) {
        sea v = subcadena(x, 5, longitud(x))
        si (tiene_clave(t, "font-weight-" + v)) {
            _es_usar(ctx, "font-weight-" + v)
            ctx["propiedades_tw"]["--tw-font-weight"] = verdadero
            retornar [["--tw-font-weight", "var(--font-weight-" + v + ")"], ["font-weight", "var(--font-weight-" + v + ")"]]
        }
        si (tiene_clave(t, "font-" + v)) {
            _es_usar(ctx, "font-" + v)
            retornar [["font-family", "var(--font-" + v + ")"]]
        }
        retornar nulo
    }
    si (texto_empieza_con(x, "leading-")) {
        sea v = subcadena(x, 8, longitud(x))
        sea val = nulo
        si (v == "none") { val = "1" } sino {
            si (tiene_clave(t, "leading-" + v)) {
                _es_usar(ctx, "leading-" + v)
                val = "var(--leading-" + v + ")"
            } sino { val = _es_espacio(v, ctx, falso, falso) }
        }
        si (val == nulo) { retornar nulo }
        ctx["propiedades_tw"]["--tw-leading"] = verdadero
        retornar [["--tw-leading", val], ["line-height", val]]
    }
    si (texto_empieza_con(x, "tracking-")) {
        sea v = subcadena(x, 9, longitud(x))
        si (tiene_clave(t, "tracking-" + v) == falso) { retornar nulo }
        _es_usar(ctx, "tracking-" + v)
        ctx["propiedades_tw"]["--tw-tracking"] = verdadero
        retornar [["--tw-tracking", "var(--tracking-" + v + ")"], ["letter-spacing", "var(--tracking-" + v + ")"]]
    }
    si (texto_empieza_con(x, "line-clamp-")) {
        sea v = subcadena(x, 11, longitud(x))
        si (_es_entero(v)) { retornar [["overflow", "hidden"], ["display", "-webkit-box"], ["-webkit-box-orient", "vertical"], ["-webkit-line-clamp", v]] }
        si (v == "none") { retornar [["overflow", "visible"], ["display", "block"], ["-webkit-box-orient", "horizontal"], ["-webkit-line-clamp", "unset"]] }
    }
    // Fondo.
    si (texto_empieza_con(x, "bg-")) {
        sea col = _es_color(subcadena(x, 3, longitud(x)), ctx)
        si (col != nulo) { retornar _es_con_color("background-color", col) }
        retornar nulo
    }
    // Bordes.
    si (x == "border" o texto_empieza_con(x, "border-")) {
        sea resto = ""
        si (x != "border") { resto = subcadena(x, 7, longitud(x)) }
        sea lado = ""
        sea lados = {"x": "-inline", "y": "-block", "t": "-top", "r": "-right", "b": "-bottom", "l": "-left", "s": "-inline-start", "e": "-inline-end"}
        sea g2 = texto_indice(resto, "-")
        sea cab = resto
        si (g2 >= 0) { cab = subcadena(resto, 0, g2) }
        si (tiene_clave(lados, cab)) {
            lado = lados[cab]
            si (g2 >= 0) { resto = subcadena(resto, g2 + 1, longitud(resto)) } sino { resto = "" }
        }
        sea ancho = nulo
        si (resto == "") { ancho = "1px" }
        si (_es_entero(resto)) { ancho = resto + "px" }
        si (ancho != nulo) {
            ctx["propiedades_tw"]["--tw-border-style"] = verdadero
            retornar [["border" + lado + "-style", "var(--tw-border-style)"], ["border" + lado + "-width", ancho]]
        }
        para st en ["solid", "dashed", "dotted", "double", "hidden", "none"] {
            si (resto == st y lado == "") {
                ctx["propiedades_tw"]["--tw-border-style"] = verdadero
                retornar [["--tw-border-style", st], ["border-style", st]]
            }
        }
        sea col = _es_color(resto, ctx)
        si (col != nulo) { retornar _es_con_color("border" + lado + "-color", col) }
        retornar nulo
    }
    si (x == "rounded" o texto_empieza_con(x, "rounded-")) {
        sea resto = ""
        si (x != "rounded") { resto = subcadena(x, 8, longitud(x)) }
        sea esquinas = {"t": ["top-left", "top-right"], "r": ["top-right", "bottom-right"], "b": ["bottom-right", "bottom-left"], "l": ["top-left", "bottom-left"], "tl": ["top-left"], "tr": ["top-right"], "br": ["bottom-right"], "bl": ["bottom-left"]}
        sea props = ["border-radius"]
        sea g3 = texto_indice(resto, "-")
        sea cab = resto
        si (g3 >= 0) { cab = subcadena(resto, 0, g3) }
        si (tiene_clave(esquinas, cab)) {
            props = []
            para e en esquinas[cab] { props.agregar("border-" + e + "-radius") }
            si (g3 >= 0) { resto = subcadena(resto, g3 + 1, longitud(resto)) } sino { resto = "" }
        }
        sea val = nulo
        si (resto == "") { val = "0.25rem" }
        si (resto == "none") { val = "0" }
        si (resto == "full") { val = "calc(infinity * 1px)" }
        si (val == nulo y tiene_clave(t, "radius-" + resto)) {
            _es_usar(ctx, "radius-" + resto)
            val = "var(--radius-" + resto + ")"
        }
        si (val == nulo) { val = _es_arbitrario(resto) }
        si (val == nulo) { retornar nulo }
        sea r = []
        para p en props { r.agregar([p, val]) }
        retornar r
    }
    si (x == "outline") {
        ctx["propiedades_tw"]["--tw-outline-style"] = verdadero
        retornar [["outline-style", "var(--tw-outline-style)"], ["outline-width", "1px"]]
    }
    si (x == "outline-none") {
        ctx["propiedades_tw"]["--tw-outline-style"] = verdadero
        retornar [["--tw-outline-style", "none"], ["outline-style", "none"]]
    }
    // Efectos.
    si (texto_empieza_con(x, "opacity-")) {
        sea v = subcadena(x, 8, longitud(x))
        si (_es_num(v)) { retornar [["opacity", v + "%"]] }
        retornar nulo
    }
    si (x == "shadow" o texto_empieza_con(x, "shadow-")) {
        sea v = "default"
        si (x != "shadow") { v = subcadena(x, 7, longitud(x)) }
        sea sombras = {"default": "0 1px 3px 0 var(--tw-shadow-color, rgb(0 0 0 / 0.1)), 0 1px 2px -1px var(--tw-shadow-color, rgb(0 0 0 / 0.1))", "none": "0 0 #0000"}
        sea s = sombras[v] ?? nulo
        si (s == nulo y tiene_clave(t, "shadow-" + v)) {
            s = texto_reemplazar(texto_reemplazar(t["shadow-" + v], "rgb(0 0 0 / 0.05)", "var(--tw-shadow-color, rgb(0 0 0 / 0.05))"), "rgb(0 0 0 / 0.1)", "var(--tw-shadow-color, rgb(0 0 0 / 0.1))")
            s = texto_reemplazar(s, "rgb(0 0 0 / 0.25)", "var(--tw-shadow-color, rgb(0 0 0 / 0.25))")
        }
        si (s == nulo) {
            sea col = _es_color(v, ctx)
            si (col == nulo) { retornar nulo }
            ctx["propiedades_tw"]["--tw-shadow-color"] = verdadero
            retornar [["--tw-shadow-color", col[0]]]
        }
        para pv en ["--tw-shadow", "--tw-shadow-color", "--tw-shadow-alpha", "--tw-inset-shadow", "--tw-inset-shadow-color", "--tw-inset-shadow-alpha", "--tw-ring-color", "--tw-ring-shadow", "--tw-inset-ring-color", "--tw-inset-ring-shadow", "--tw-ring-inset", "--tw-ring-offset-width", "--tw-ring-offset-color", "--tw-ring-offset-shadow"] { ctx["propiedades_tw"][pv] = verdadero }
        retornar [["--tw-shadow", s], ["box-shadow", "var(--tw-inset-shadow), var(--tw-inset-ring-shadow), var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow)"]]
    }
    si (x == "ring" o texto_empieza_con(x, "ring-")) {
        sea v = "1"
        si (x != "ring") { v = subcadena(x, 5, longitud(x)) }
        si (_es_entero(v)) {
            para pv en ["--tw-shadow", "--tw-shadow-color", "--tw-shadow-alpha", "--tw-inset-shadow", "--tw-inset-shadow-color", "--tw-inset-shadow-alpha", "--tw-ring-color", "--tw-ring-shadow", "--tw-inset-ring-color", "--tw-inset-ring-shadow", "--tw-ring-inset", "--tw-ring-offset-width", "--tw-ring-offset-color", "--tw-ring-offset-shadow"] { ctx["propiedades_tw"][pv] = verdadero }
            retornar [["--tw-ring-shadow", "var(--tw-ring-inset,) 0 0 0 calc(" + v + "px + var(--tw-ring-offset-width)) var(--tw-ring-color, currentcolor)"], ["box-shadow", "var(--tw-inset-shadow), var(--tw-inset-ring-shadow), var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow)"]]
        }
        sea col = _es_color(v, ctx)
        si (col != nulo) {
            ctx["propiedades_tw"]["--tw-ring-color"] = verdadero
            retornar _es_con_color("--tw-ring-color", col)
        }
        retornar nulo
    }
    si (x == "transition" o texto_empieza_con(x, "transition-")) {
        sea grupos = {"transition": "color, background-color, border-color, outline-color, text-decoration-color, fill, stroke, --tw-gradient-from, --tw-gradient-via, --tw-gradient-to, opacity, box-shadow, transform, translate, scale, rotate, filter, -webkit-backdrop-filter, backdrop-filter, display, content-visibility, overlay, pointer-events", "transition-all": "all", "transition-colors": "color, background-color, border-color, outline-color, text-decoration-color, fill, stroke, --tw-gradient-from, --tw-gradient-via, --tw-gradient-to", "transition-opacity": "opacity", "transition-shadow": "box-shadow", "transition-transform": "transform, translate, scale, rotate"}
        si (x == "transition-none") { retornar [["transition-property", "none"]] }
        si (tiene_clave(grupos, x) == falso) { retornar nulo }
        _es_usar(ctx, "default-transition-timing-function")
        _es_usar(ctx, "default-transition-duration")
        retornar [["transition-property", grupos[x]], ["transition-timing-function", "var(--tw-ease, var(--default-transition-timing-function))"], ["transition-duration", "var(--tw-duration, var(--default-transition-duration))"]]
    }
    si (texto_empieza_con(x, "duration-")) {
        sea v = subcadena(x, 9, longitud(x))
        si (_es_entero(v) == falso) { retornar nulo }
        ctx["propiedades_tw"]["--tw-duration"] = verdadero
        retornar [["--tw-duration", v + "ms"], ["transition-duration", v + "ms"]]
    }
    si (texto_empieza_con(x, "aspect-")) {
        sea v = subcadena(x, 7, longitud(x))
        si (tiene_clave(t, "aspect-" + v)) {
            _es_usar(ctx, "aspect-" + v)
            retornar [["aspect-ratio", "var(--aspect-" + v + ")"]]
        }
        si (_es_fraccion(v)) { retornar [["aspect-ratio", texto_reemplazar(v, "/", " / ")]] }
        retornar nulo
    }
    retornar nulo
}

funcion _es_con_color(prop, col) {
    si (col[1] == nulo) { retornar [[prop, col[0]]] }
    retornar [[prop, col[0]], ["@supports (color: color-mix(in lab, red, red))", [[prop, col[1]]]]]
}

// ── Variantes ─────────────────────────────────────────────────────────────

// Variante → [tipo, valor]: "sufijo" agrega a .clase, "medio" envuelve en
// @media, "padre" usa un selector con & (sel).
funcion _es_variante(v) {
    sea pseudo = {"hover": ":hover", "focus": ":focus", "focus-visible": ":focus-visible", "focus-within": ":focus-within", "active": ":active", "visited": ":visited", "disabled": ":disabled", "enabled": ":enabled", "checked": ":checked", "required": ":required", "invalid": ":invalid", "valid": ":valid", "placeholder-shown": ":placeholder-shown", "read-only": ":read-only", "first": ":first-child", "last": ":last-child", "only": ":only-child", "odd": ":nth-child(odd)", "even": ":nth-child(even)", "first-of-type": ":first-of-type", "last-of-type": ":last-of-type", "empty": ":empty", "target": ":target", "open": ":is([open], :popover-open, :open)"}
    sea pseudos_el = {"before": "::before", "after": "::after", "placeholder": "::placeholder", "selection": "::selection", "marker": "::marker", "file": "::file-selector-button", "first-line": "::first-line", "first-letter": "::first-letter"}
    sea t = _es_tema()
    si (tiene_clave(pseudo, v)) {
        si (v == "hover") { retornar [["medio", "(hover: hover)"], ["sufijo", ":hover"]] }
        retornar [["sufijo", pseudo[v]]]
    }
    si (tiene_clave(pseudos_el, v)) {
        si (v == "before" o v == "after") { retornar [["sufijo", pseudos_el[v]], ["contenido", "var(--tw-content)"]] }
        retornar [["sufijo", pseudos_el[v]]]
    }
    si (tiene_clave(t, "breakpoint-" + v)) { retornar [["medio", "(width >= " + t["breakpoint-" + v] + ")"]] }
    si (texto_empieza_con(v, "max-") y tiene_clave(t, "breakpoint-" + subcadena(v, 4, longitud(v)))) { retornar [["medio", "(width < " + t["breakpoint-" + subcadena(v, 4, longitud(v))] + ")"]] }
    si (v == "dark") { retornar [["medio", "(prefers-color-scheme: dark)"]] }
    si (v == "motion-reduce") { retornar [["medio", "(prefers-reduced-motion: reduce)"]] }
    si (v == "motion-safe") { retornar [["medio", "(prefers-reduced-motion: no-preference)"]] }
    si (v == "print") { retornar [["medio", "print"]] }
    si (v == "portrait") { retornar [["medio", "(orientation: portrait)"]] }
    si (v == "landscape") { retornar [["medio", "(orientation: landscape)"]] }
    si (v == "*") { retornar [["padre", ":is(" + _ES_LL + "sel" + _ES_RR + " > *)"]] }
    si (texto_empieza_con(v, "aria-")) { retornar [["sufijo", "[aria-" + subcadena(v, 5, longitud(v)) + "=\"true\"]"]] }
    si (texto_empieza_con(v, "data-")) { retornar [["sufijo", "[data-" + subcadena(v, 5, longitud(v)) + "]"]] }
    para g en ["group", "peer"] {
        si (texto_empieza_con(v, g + "-")) {
            sea interno = _es_variante(subcadena(v, longitud(g) + 1, longitud(v)))
            si (interno == nulo) { retornar nulo }
            sea suf = ""
            sea medio = nulo
            para p en interno {
                si (p[0] == "sufijo") { suf = suf + p[1] }
                si (p[0] == "medio") { medio = p[1] }
            }
            sea rel = " *"
            si (g == "peer") { rel = " ~ *" }
            sea r = []
            si (medio != nulo) { r.agregar(["medio", medio]) }
            r.agregar(["sufijo", ":is(:where(." + g + ")" + suf + rel + ")"])
            retornar r
        }
    }
    retornar nulo
}

// Divide "md:hover:bg-red-500" en ["md", "hover", "bg-red-500"] sin cortar
// dentro de corchetes.
funcion _es_partir(c) {
    sea r = []
    sea actual = ""
    sea prof = 0
    sea i = 0
    mientras (i < longitud(c)) {
        sea ch = subcadena(c, i, i + 1)
        si (ch == "[") { prof = prof + 1 }
        si (ch == "]") { prof = prof - 1 }
        si (ch == ":" y prof == 0) {
            r.agregar(actual)
            actual = ""
        } sino { actual = actual + ch }
        i = i + 1
    }
    r.agregar(actual)
    retornar r
}

/// Regla para una clase: {"selector", "medios", "decl"} o nulo.
funcion estilos_regla(clase, ctx_) {
    sea ctx = ctx_ ?? {"vars": {}, "props": {}, "propiedades_tw": {}}
    sea partes = _es_partir(clase)
    sea u = partes[longitud(partes) - 1]
    sea importante = falso
    si (texto_empieza_con(u, "!")) { importante = verdadero  u = subcadena(u, 1, longitud(u)) }
    si (texto_termina_con(u, "!")) { importante = verdadero  u = subcadena(u, 0, longitud(u) - 1) }
    ctx["hijos"] = nulo
    // Las variantes se revisan antes, para no registrar variables de una
    // clase que al final no se genera.
    sea k0 = 0
    mientras (k0 < longitud(partes) - 1) {
        si (_es_variante(partes[k0]) == nulo) { retornar nulo }
        k0 = k0 + 1
    }
    sea ctx2 = {"vars": {}, "props": {}, "propiedades_tw": {}, "hijos": nulo}
    si (_es_utilidad(u, ctx2) == nulo) { retornar nulo }
    sea decl = _es_utilidad(u, ctx)
    si (decl == nulo) { retornar nulo }
    sea sel = "." + _es_escapar(clase)
    sea medios = []
    sea i = 0
    mientras (i < longitud(partes) - 1) {
        sea v = _es_variante(partes[i])
        si (v == nulo) { retornar nulo }
        para p en v {
            si (p[0] == "sufijo") { sel = sel + p[1] }
            si (p[0] == "medio") { medios.agregar(p[1]) }
            si (p[0] == "padre") { sel = texto_reemplazar(p[1], _ES_LL + "sel" + _ES_RR, sel) }
            si (p[0] == "contenido") {
                ctx["propiedades_tw"]["--tw-content"] = verdadero
                sea d3 = [["content", p[1]]]
                para d en decl { d3.agregar(d) }
                decl = d3
            }
        }
        i = i + 1
    }
    si (ctx["hijos"] != nulo) { sel = texto_reemplazar(ctx["hijos"], _ES_LL + "sel" + _ES_RR, sel) }
    si (importante) {
        sea d2 = []
        para d en decl {
            si (tipo(d[1]) == "lista") {
                sea dd = []
                para y2 en d[1] { dd.agregar([y2[0], y2[1] + " !important"]) }
                d2.agregar([d[0], dd])
            } sino { d2.agregar([d[0], d[1] + " !important"]) }
        }
        decl = d2
    }
    retornar {"selector": sel, "medios": medios, "decl": decl}
}

/// Clases candidatas dentro de un texto (HTML, plantillas, código).
funcion estilos_clases(texto) {
    sea r = []
    sea vistos = {}
    sea actual = ""
    sea prof = 0
    sea t = "" + texto + " "
    sea i = 0
    mientras (i < longitud(t)) {
        sea c = subcadena(t, i, i + 1)
        sea b = byte_en(t, i)
        si (c == "[") { prof = prof + 1 }
        si (c == "]") { prof = maximo(0, prof - 1) }
        sea corta = (b <= 32 o c == "\"" o c == "'" o c == "`" o c == "<" o c == ">" o c == "=" o c == "," o c == ";" o c == "{" o c == "}" o c == "(" o c == ")") y prof == 0
        si (corta) {
            si (actual != "" y tiene_clave(vistos, actual) == falso) {
                vistos[actual] = verdadero
                r.agregar(actual)
            }
            actual = ""
        } sino { actual = actual + c }
        i = i + 1
    }
    retornar r
}

sea _ES_INICIALES = {"--tw-border-style": "solid", "--tw-shadow": "0 0 #0000", "--tw-shadow-alpha": "100%", "--tw-inset-shadow": "0 0 #0000", "--tw-inset-shadow-alpha": "100%", "--tw-ring-shadow": "0 0 #0000", "--tw-inset-ring-shadow": "0 0 #0000", "--tw-ring-offset-width": "0px", "--tw-ring-offset-color": "#fff", "--tw-ring-offset-shadow": "0 0 #0000", "--tw-outline-style": "solid", "--tw-space-x-reverse": "0", "--tw-space-y-reverse": "0", "--tw-content": "\"\""}

funcion _es_decl_texto(decl, sangria) {
    sea l = []
    para d en decl {
        si (tipo(d[1]) == "lista") {
            l.agregar(sangria + d[0] + " " + _ES_LL)
            para y2 en d[1] { l.agregar(sangria + "  " + y2[0] + ": " + y2[1] + ";") }
            l.agregar(sangria + _ES_RR)
        } sino { l.agregar(sangria + d[0] + ": " + d[1] + ";") }
    }
    retornar l
}

/// CSS para las clases usadas en entrada (texto o lista de clases), al
/// estilo de Tailwind CSS v4: sólo las utilidades usadas, con sus
/// variantes, y las variables del tema que necesitan.
/// opciones: tema (mapa que reemplaza o agrega valores del tema), raiz
/// (falso: sin el bloque :root), propiedades (falso: sin @property).
funcion estilos_css(entrada, opciones) {
    sea o = opciones ?? {}
    si ((o["tema"] ?? nulo) != nulo) {
        _es_tema()
        para k en claves(o["tema"]) {
            si (tiene_clave(_ES_TEMA, k) == falso) { _ES_ORDEN_TEMA.agregar(k) }
            _ES_TEMA[k] = o["tema"][k]
        }
    }
    sea lista = entrada
    si (tipo(entrada) == "texto") { lista = estilos_clases(entrada) }
    sea ctx = {"vars": {}, "props": {}, "propiedades_tw": {}}
    sea salida = []
    sea desconocidas = []
    para c en lista {
        sea r = estilos_regla(c, ctx)
        si (r == nulo) { desconocidas.agregar(c) } sino {
            sea sangria = ""
            sea abre = []
            para m en r["medios"] {
                abre.agregar(sangria + "@media " + m + " " + _ES_LL)
                sangria = sangria + "  "
            }
            para a en abre { salida.agregar(a) }
            salida.agregar(sangria + r["selector"] + " " + _ES_LL)
            para l en _es_decl_texto(r["decl"], sangria + "  ") { salida.agregar(l) }
            salida.agregar(sangria + _ES_RR)
            sea k = longitud(r["medios"])
            mientras (k > 0) {
                k = k - 1
                sea s2 = ""
                sea q = 0
                mientras (q < k) { s2 = s2 + "  "  q = q + 1 }
                salida.agregar(s2 + _ES_RR)
            }
        }
    }
    si ((o["raiz"] ?? verdadero) y longitud(claves(ctx["vars"])) > 0) {
        salida.agregar(":root, :host " + _ES_LL)
        para n en _ES_ORDEN_TEMA { si (tiene_clave(ctx["vars"], n)) { salida.agregar("  --" + n + ": " + _ES_TEMA[n] + ";") } }
        salida.agregar(_ES_RR)
    }
    si (o["propiedades"] ?? verdadero) {
        para p en claves(ctx["propiedades_tw"]) {
            salida.agregar("@property " + p + " " + _ES_LL)
            salida.agregar("  syntax: \"*\";")
            salida.agregar("  inherits: false;")
            si (tiene_clave(_ES_INICIALES, p)) { salida.agregar("  initial-value: " + _ES_INICIALES[p] + ";") }
            salida.agregar(_ES_RR)
        }
    }
    retornar unir(salida, "\n") + "\n"
}

/// Clases que no se reconocen (para avisar de errores de tipeo).
funcion estilos_desconocidas(entrada) {
    sea lista = entrada
    si (tipo(entrada) == "texto") { lista = estilos_clases(entrada) }
    sea r = []
    para c en lista { si (estilos_regla(c, nulo) == nulo) { r.agregar(c) } }
    retornar r
}

// ── Unir clases sin conflictos (como clsx + tailwind-merge) ────────────────

sea _ES_CUBRE = {"padding": ["padding-inline", "padding-block", "padding-top", "padding-right", "padding-bottom", "padding-left", "padding-inline-start", "padding-inline-end"], "padding-inline": ["padding-left", "padding-right", "padding-inline-start", "padding-inline-end"], "padding-block": ["padding-top", "padding-bottom"],
    "margin": ["margin-inline", "margin-block", "margin-top", "margin-right", "margin-bottom", "margin-left", "margin-inline-start", "margin-inline-end"], "margin-inline": ["margin-left", "margin-right", "margin-inline-start", "margin-inline-end"], "margin-block": ["margin-top", "margin-bottom"],
    "inset": ["inset-inline", "inset-block", "top", "right", "bottom", "left"], "inset-inline": ["left", "right"], "inset-block": ["top", "bottom"], "gap": ["column-gap", "row-gap"],
    "border-radius": ["border-top-left-radius", "border-top-right-radius", "border-bottom-right-radius", "border-bottom-left-radius"], "border-width": ["border-top-width", "border-right-width", "border-bottom-width", "border-left-width", "border-inline-width", "border-block-width"], "border-color": ["border-top-color", "border-right-color", "border-bottom-color", "border-left-color", "border-inline-color", "border-block-color"]}

funcion _es_firma(c) {
    sea ctx = {"vars": {}, "props": {}, "propiedades_tw": {}}
    sea r = estilos_regla(c, ctx)
    si (r == nulo) { retornar nulo }
    sea props = []
    para d en r["decl"] { si (texto_empieza_con(d[0], "--") == falso y texto_empieza_con(d[0], "@") == falso) { props.agregar(d[0]) } }
    sea partes = _es_partir(c)
    sea variantes = []
    sea i = 0
    mientras (i < longitud(partes) - 1) { variantes.agregar(partes[i])  i = i + 1 }
    variantes = ordenar(variantes, funcion(a, b) { si (a < b) { retornar -1 }  retornar 1 })
    retornar {"variantes": unir(variantes, ":"), "props": props}
}

funcion _es_cubre(p_nuevo, p_viejo) {
    // ¿Las propiedades nuevas pisan todas las viejas?
    para v en p_viejo {
        sea cubierta = falso
        para n en p_nuevo {
            si (n == v) { cubierta = verdadero }
            para x en _ES_CUBRE[n] ?? [] { si (x == v) { cubierta = verdadero } }
            // Dos niveles: padding cubre padding-inline que cubre padding-left.
            para x en _ES_CUBRE[n] ?? [] { para y2 en _ES_CUBRE[x] ?? [] { si (y2 == v) { cubierta = verdadero } } }
        }
        si (cubierta == falso) { retornar falso }
    }
    retornar longitud(p_viejo) > 0
}

/// Une clases (textos, listas, o mapas {clase: condición}) y quita las que
/// quedan pisadas por otra posterior con las mismas variantes:
/// estilos_unir(["p-2 text-red-500", {"p-4": verdadero}]) → "text-red-500 p-4".
funcion estilos_unir(partes) {
    sea lista = []
    sea entrada = partes
    si (tipo(partes) != "lista") { entrada = [partes] }
    para p en entrada {
        si (tipo(p) == "texto") { para c en texto_dividir(p, " ") { si (c != "") { lista.agregar(c) } } }
        si (tipo(p) == "mapa") { para k en claves(p) { si (p[k] == verdadero) { para c en texto_dividir(k, " ") { si (c != "") { lista.agregar(c) } } } } }
        si (tipo(p) == "lista") { para c en p { si (tipo(c) == "texto") { lista.agregar(c) } } }
    }
    sea firmas = []
    para c en lista { firmas.agregar(_es_firma(c)) }
    sea r = []
    sea i = 0
    mientras (i < longitud(lista)) {
        sea pisada = falso
        si (firmas[i] != nulo) {
            sea j = i + 1
            mientras (j < longitud(lista) y pisada == falso) {
                si (firmas[j] != nulo y firmas[j]["variantes"] == firmas[i]["variantes"] y _es_cubre(firmas[j]["props"], firmas[i]["props"])) { pisada = verdadero }
                j = j + 1
            }
        }
        // Repetidas exactas: queda la última.
        sea j2 = i + 1
        mientras (j2 < longitud(lista) y pisada == falso) {
            si (lista[j2] == lista[i]) { pisada = verdadero }
            j2 = j2 + 1
        }
        si (pisada == falso) { r.agregar(lista[i]) }
        i = i + 1
    }
    retornar unir(r, " ")
}
