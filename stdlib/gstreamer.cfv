// stdlib/gstreamer.cfv — Tuberías multimedia (estilo GStreamer): nombres en inglés del módulo "tuberia".
// English names for the "tuberia" module; both can be used together.

importar "tuberia"

funcion _gstreamer_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_gstreamer_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _gstreamer_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _GSTREAMER_RES = {"estado": "state", "mensajes": "messages", "sumideros": "sinks", "texto": "text", "origen": "source", "pico": "peak"}

funcion gst_parse(descripcion) { retornar tuberia_analizar(descripcion) }
funcion gst_launch(descripcion) { retornar _gstreamer_tr(tuberia_lanzar(descripcion), _GSTREAMER_RES) }
funcion gst_elements() { retornar tuberia_elementos() }
