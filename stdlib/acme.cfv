// stdlib/acme.cfv — certificados HTTPS automáticos con ACME: nombres en inglés del módulo "certifica".
// English names for the "certifica" module; both can be used together.

importar "certifica"

funcion _acme_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_acme_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _acme_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _ACME_RES = {"privada": "private", "dominio": "domain", "tipo": "type", "clave_autorizacion": "key_authorization", "ruta": "path", "valor_dns": "dns_value", "nombre_dns": "dns_name", "autorizacion": "authorization", "estado": "status", "url": "url", "token": "token", "alpn_sha256": "alpn_sha256", "nueva": "created", "certificado": "certificate", "clave": "key", "clave_pem": "key_pem", "pedido": "order"}

funcion acme_es256_sign(clave, mensaje) { retornar certifica_firmar(clave, mensaje) }
funcion acme_key_pem(clave) { retornar certifica_clave_pem(clave) }
funcion acme_public_pem(clave) { retornar certifica_publica_pem(clave) }
funcion acme_csr(clave, dominios) { retornar certifica_csr(clave, dominios) }
funcion acme_csr_pem(clave, dominios) { retornar certifica_csr_pem(clave, dominios) }
funcion acme_jwk(clave) { retornar certifica_jwk(clave) }
funcion acme_thumbprint(clave) { retornar certifica_huella(clave) }
funcion acme_new_order(c, dominios) { retornar certifica_pedido(c, dominios) }
funcion acme_challenges(c, pedido) { retornar _acme_tr(certifica_desafios(c, pedido), _ACME_RES) }
funcion acme_respond(c, desafio) { retornar certifica_responder(c, desafio) }
funcion acme_poll(c, url, listos, intentos) { retornar certifica_esperar(c, url, listos, intentos) }
funcion acme_finalize(c, pedido, clave_cert, dominios) { retornar certifica_finalizar(c, pedido, clave_cert, dominios) }
funcion acme_download(c, pedido) { retornar certifica_bajar(c, pedido) }
funcion acme_revoke(c, cert_pem, motivo) { retornar certifica_revocar(c, cert_pem, motivo) }
funcion acme_not_after(cert_pem) { retornar certifica_vence(cert_pem) }

funcion _acme_ambas(k) { retornar {"privada": k["privada"], "private": k["privada"], "x": k["x"], "y": k["y"]} }
// P-256 key pair: {"private", "x", "y"} (32 bytes each).
funcion acme_keypair(private_key) { retornar _acme_ambas(certifica_claves(private_key)) }
// Read a P-256 key from PEM (SEC1 or PKCS#8).
funcion acme_read_key(pem) { retornar _acme_ambas(certifica_leer_clave(pem)) }
sea ACME_LETS_ENCRYPT = CERTIFICA_LETS_ENCRYPT
sea ACME_LETS_ENCRYPT_STAGING = CERTIFICA_LETS_ENCRYPT_PRUEBAS
// Verify an ES256 signature (r||s) with {"x", "y"}.
funcion acme_es256_verify(public_key, message, signature) { retornar certifica_verificar(public_key, message, signature) }
// ACME client. options: "key" (PEM or acme_keypair), "transport", "poll_ms".
funcion acme_client(directory, options) {
    sea o = options ?? {}
    sea op = {}
    si (tiene_clave(o, "key")) { op["clave"] = o["key"] }
    si (tiene_clave(o, "transport")) { op["transporte"] = o["transport"] }
    si (tiene_clave(o, "poll_ms")) { op["espera_ms"] = o["poll_ms"] }
    retornar certifica_cliente(directory, op)
}
// Create or fetch the account. options: "contact", "agree_tos", "only_existing".
funcion acme_account(c, options) {
    sea o = options ?? {}
    sea op = {}
    si (tiene_clave(o, "contact")) { op["contacto"] = o["contact"] }
    si (tiene_clave(o, "agree_tos")) { op["aceptar_terminos"] = o["agree_tos"] }
    si (tiene_clave(o, "only_existing")) { op["solo_existente"] = o["only_existing"] }
    retornar _acme_tr(certifica_cuenta(c, op), _ACME_RES)
}
// Everything: order, challenges (publish(challenge) makes it reachable),
// finalize and download. options: "type" (http-01, dns-01…), "certificate_key", "contact", "attempts".
funcion acme_issue(c, domains, publish, options) {
    sea o = options ?? {}
    sea op = {}
    si (tiene_clave(o, "type")) { op["tipo"] = o["type"] }
    si (tiene_clave(o, "certificate_key")) { op["clave_certificado"] = o["certificate_key"] }
    si (tiene_clave(o, "contact")) { op["contacto"] = o["contact"] }
    si (tiene_clave(o, "attempts")) { op["intentos"] = o["attempts"] }
    retornar _acme_tr(certifica_emitir(c, domains, funcion(d) { publish(_acme_tr(d, _ACME_RES)) }, op), _ACME_RES)
}
