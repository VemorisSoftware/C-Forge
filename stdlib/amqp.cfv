// stdlib/amqp.cfv — cliente AMQP 0-9-1: nombres en inglés del módulo "colas".
// English names for the "colas" module; both can be used together.


importar "colas"

funcion _amqp_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_amqp_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _amqp_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _AMQP_RES = {"clase": "class", "tam_cuerpo": "body_size", "propiedades": "properties", "etiqueta": "delivery_tag", "cuerpo": "body", "intercambio": "exchange", "clave": "routing_key", "reentregado": "redelivered", "quedan": "message_count", "consumidor": "consumer_tag", "canal": "channel", "devuelto": "returned"}
sea _AMQP_OPT = {"transport": "transporte", "heartbeat": "latido", "name": "nombre", "exclusive": "exclusiva", "passive": "pasivo", "arguments": "argumentos", "tag": "etiqueta", "no_ack": "sin_ack"}

funcion amqp_value(tipo_v, valor) { retornar colas_valor(tipo_v, valor) }
funcion amqp_table(m) { retornar colas_tabla(m) }
funcion amqp_method(nombre, args) { retornar colas_metodo(nombre, args) }
funcion amqp_read_method(t) { retornar colas_leer_metodo(t) }
funcion amqp_frame(tipo_t, canal, contenido) { retornar colas_trama(tipo_t, canal, contenido) }
funcion amqp_header(tam_cuerpo, props) { retornar colas_cabecera(tam_cuerpo, props) }
funcion amqp_read_header(t) { retornar _amqp_tr(colas_leer_cabecera(t), _AMQP_RES) }
funcion amqp_read_frame(t, p) { retornar colas_leer_trama(t, p) }
funcion amqp_connect(url, opciones) { retornar colas_conectar(url, _amqp_opt(opciones)) }
funcion amqp_channel(c) { retornar colas_canal(c) }
funcion amqp_exchange_declare(ch, nombre, tipo_i, opciones) { retornar colas_declarar_intercambio(ch, nombre, tipo_i, _amqp_opt(opciones)) }
funcion amqp_queue_declare(ch, nombre, opciones) { retornar colas_declarar_cola(ch, nombre, _amqp_opt(opciones)) }
funcion amqp_queue_bind(ch, cola, intercambio, clave, argumentos) { retornar colas_enlazar(ch, cola, intercambio, clave, argumentos) }
funcion amqp_queue_unbind(ch, cola, intercambio, clave) { retornar colas_desenlazar(ch, cola, intercambio, clave) }
funcion amqp_queue_purge(ch, cola) { retornar colas_vaciar(ch, cola) }
funcion amqp_queue_delete(ch, cola) { retornar colas_borrar_cola(ch, cola) }
funcion amqp_qos(ch, cantidad) { retornar colas_qos(ch, cantidad) }
funcion amqp_confirm_select(ch) { retornar colas_confirmaciones(ch) }
funcion amqp_publish(ch, intercambio, clave, cuerpo, props, obligatorio) { retornar colas_publicar(ch, intercambio, clave, cuerpo, props, obligatorio) }
funcion amqp_wait_confirms(ch) { retornar colas_esperar_confirmaciones(ch) }
funcion amqp_get(ch, cola, sin_ack) { retornar _amqp_tr(colas_obtener(ch, cola, sin_ack), _AMQP_RES) }
funcion amqp_consume(ch, cola, opciones) { retornar colas_consumir(ch, cola, _amqp_opt(opciones)) }
funcion amqp_cancel(ch, etiqueta) { retornar colas_cancelar(ch, etiqueta) }
funcion amqp_next(c) { retornar _amqp_tr(colas_siguiente(c), _AMQP_RES) }
funcion amqp_ack(ch, etiqueta, multiple) { retornar colas_ack(ch, etiqueta, multiple) }
funcion amqp_nack(ch, etiqueta, reencolar) { retornar colas_nack(ch, etiqueta, reencolar) }
funcion amqp_reject(ch, etiqueta, reencolar) { retornar colas_rechazar(ch, etiqueta, reencolar) }
funcion amqp_channel_close(ch) { retornar colas_cerrar_canal(ch) }
funcion amqp_close(c) { retornar colas_cerrar(c) }

funcion _amqp_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_AMQP_OPT[k] ?? k] = o[k] }
    retornar r
}
