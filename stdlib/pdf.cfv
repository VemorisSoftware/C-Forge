// stdlib/pdf.cfv — PDF: nombres en inglés del módulo "documento".
// English names for the "documento" module; both can be used together.


importar "documento"

funcion _pdf_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_pdf_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _pdf_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _PDF_RES = {"paginas": "pages", "titulo": "title", "autor": "author", "texto": "text"}
sea _PDF_OPT = {"size": "tamano", "landscape": "horizontal", "title": "titulo", "author": "autor", "subject": "asunto", "compress": "comprimir", "font": "fuente", "color": "color", "bold": "negrita", "italic": "cursiva", "align": "alinear", "underline": "subrayado", "width": "grosor", "fill": "relleno", "stroke": "borde", "radius": "radio", "dash": "guiones"}

funcion pdf_font(nombre, negrita, cursiva) { retornar documento_fuente(nombre, negrita, cursiva) }
funcion pdf_winansi(t) { retornar documento_winansi(t) }
funcion pdf_text_width(texto, fuente, tamano) { retornar documento_ancho(texto, fuente, tamano) }
funcion pdf_new(opciones) { retornar documento_nuevo(_pdf_opt(opciones)) }
funcion pdf_add_page(d, tamano) { retornar documento_pagina(d, tamano) }
funcion pdf_page_count(d) { retornar documento_paginas(d) }
funcion pdf_page_height(d) { retornar documento_alto(d) }
funcion pdf_page_width(d) { retornar documento_ancho_pagina(d) }
funcion pdf_text(d, x, y, texto, opciones) { retornar documento_texto(d, x, y, texto, _pdf_opt(opciones)) }
funcion pdf_line(d, x1, y1, x2, y2, opciones) { retornar documento_linea(d, x1, y1, x2, y2, _pdf_opt(opciones)) }
funcion pdf_rect(d, x, y, w, h_, opciones) { retornar documento_rect(d, x, y, w, h_, _pdf_opt(opciones)) }
funcion pdf_circle(d, cx, cy, r, opciones) { retornar documento_circulo(d, cx, cy, r, _pdf_opt(opciones)) }
funcion pdf_image(d, datos, x, y, w, h_) { retornar documento_imagen(d, datos, x, y, w, h_) }
funcion pdf_link(d, x, y, w, h_, url) { retornar documento_enlace(d, x, y, w, h_, url) }
funcion pdf_raw(d, ops) { retornar documento_crudo(d, ops) }
funcion pdf_bytes(d) { retornar documento_bytes(d) }
funcion pdf_read(pdf) { retornar _pdf_tr(documento_leer(pdf), _PDF_RES) }

funcion _pdf_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_PDF_OPT[k] ?? k] = o[k] }
    retornar r
}
