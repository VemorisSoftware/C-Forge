// stdlib/ids.cfv — UUID v4/v7, ULID y NanoID (alias en inglés de "ident").
// English names for the "ident" module; both can be used together.

importar "ident"

funcion id_uuid4() { retornar ident_uuid4() }
funcion id_uuid7() { retornar ident_uuid7() }
funcion id_is_uuid(t) { retornar ident_es_uuid(t) }
funcion id_uuid_version(t) { retornar ident_version_uuid(t) }
funcion id_uuid7_ms(t) { retornar ident_uuid7_ms(t) }
funcion id_ulid() { retornar ident_ulid() }
funcion id_ulid_ms(u) { retornar ident_ulid_ms(u) }
funcion id_nanoid(largo) { retornar ident_nanoid(largo) }
