// stdlib/tesseract.cfv — OCR (estilo Tesseract): nombres en inglés del módulo "lector".
// English names for the "lector" module; both can be used together.


importar "lector"

funcion _tesseract_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_tesseract_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _tesseract_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _TESSERACT_RES = {"ancho": "width", "alto": "height", "tinta": "ink", "umbral": "threshold", "texto": "text", "caja": "box", "confianza": "conf", "renglon": "line"}
sea _TESSERACT_OPT = {"alphabet": "alfabeto", "size": "tamano"}

funcion tess_binarize(img) { retornar _tesseract_tr(lector_binarizar(img), _TESSERACT_RES) }
funcion tess_model(f, opciones) { retornar lector_modelo(f, _tesseract_opt(opciones)) }
funcion tess_image_to_data(img, modelo) { retornar _tesseract_tr(lector_datos(img, modelo), _TESSERACT_RES) }
funcion tess_image_to_string(img, modelo) { retornar lector_texto(img, modelo) }
funcion tess_charset(modelo) { retornar lector_alfabeto(modelo) }

funcion _tesseract_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_TESSERACT_OPT[k] ?? k] = o[k] }
    retornar r
}
