// stdlib/fft.cfv — procesamiento de señales: nombres en inglés del módulo "fourier".
// English names for the "fourier" module; both can be used together.

importar "fourier"

funcion fft_transform(xs, inversa) { retornar fourier_fft(xs, inversa) }
funcion fft_inverse(xs) { retornar fourier_ifft(xs) }
/// "hann", "hamming", "blackman" or "rectangular".
funcion fft_window(nombre, n) { retornar fourier_ventana(nombre, n) }
/// {"frequencies", "magnitudes"}
funcion fft_spectrum(xs, tasa, ventana) {
    sea e = fourier_espectro(xs, tasa, ventana)
    retornar {"frequencies": e["frecuencias"], "magnitudes": e["magnitudes"]}
}
funcion fft_dominant(xs, tasa) { retornar fourier_dominante(xs, tasa) }
funcion fft_spectrogram(xs, tasa, tamano, salto) { retornar fourier_espectrograma(xs, tasa, tamano, salto) }
funcion fft_convolve(a, b) { retornar fourier_convolucion(a, b) }
funcion fft_correlate(a, b) { retornar fourier_correlacion(a, b) }
/// kind: "low" or "high".
funcion fft_filter(xs, tasa, corte, tipo_f) {
    sea t = tipo_f ?? "low"
    si (t == "high") { t = "alto" }
    si (t == "low") { t = "bajo" }
    retornar fourier_filtrar(xs, tasa, corte, t)
}
funcion fft_tone(f, tasa, segundos, amplitud) { retornar fourier_tono(f, tasa, segundos, amplitud) }
