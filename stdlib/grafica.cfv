// stdlib/grafica.cfv — gráficos en SVG listos para web, PDF o informes:
// líneas, barras, áreas, dispersión y torta, con ejes con valores
// "redondos", leyenda, título y paleta accesible. El texto se escapa (sin
// inyección de SVG). Inspirada en ImPlot / Vega (MIT/BSD). En inglés:
// importar "chart".
//
//   importar "grafica"
//   sea svg = grafica_lineas(["Ene", "Feb", "Mar"], [{"nombre": "Ventas", "valores": [120, 180, 150]}], {"titulo": "Ventas 2026"})
//   escribir_archivo("ventas.svg", svg)
//   grafica_barras(etiquetas, series, {"apiladas": verdadero})
//   grafica_torta(["A", "B"], [60, 40])

sea _GF_PALETA = ["#2563eb", "#dc2626", "#16a34a", "#d97706", "#7c3aed", "#0891b2", "#db2777", "#4b5563"]

funcion _gf_esc(t) { retornar texto_reemplazar(texto_reemplazar(texto_reemplazar(texto_reemplazar("" + t, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "\"", "&quot;") }

funcion _gf_op(o, k, d) {
    si (o != nulo) { si (tiene_clave(o, k)) { retornar o[k] } }
    retornar d
}

funcion _gf_num(v) {
    si (absoluto(v - redondear(v, 0)) < 0.0000001) { retornar "" + redondear(v, 0) }
    retornar "" + redondear(v, 2)
}

/// Marcas "redondas" para un eje de min a max (≈ n divisiones).
funcion grafica_marcas(min, max, n) {
    sea lo = min
    sea hi = max
    si (hi == lo) { hi = lo + 1 }
    sea bruto = (hi - lo) / (n ?? 5)
    sea mag = potencia(10, piso(logaritmo(bruto) / logaritmo(10)))
    sea paso = mag
    para f en [1, 2, 2.5, 5, 10] { si (paso == mag y f * mag >= bruto) { paso = f * mag } }
    si (paso < bruto) { paso = 10 * mag }
    sea ini = piso(lo / paso) * paso
    sea fin = techo(hi / paso) * paso
    sea r = []
    sea v = ini
    mientras (v <= fin + paso / 1000) { r.agregar(redondear(v, 10))  v = v + paso }
    retornar r
}

funcion _gf_marco(o, ancho, alto) {
    sea l = ["<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 " + ancho + " " + alto + "\" width=\"" + ancho + "\" height=\"" + alto + "\" font-family=\"system-ui, sans-serif\" font-size=\"12\">"]
    l.agregar("<rect width=\"100%\" height=\"100%\" fill=\"" + _gf_esc(_gf_op(o, "fondo", "#ffffff")) + "\"/>")
    sea t = _gf_op(o, "titulo", _gf_op(o, "title", nulo))
    si (t != nulo) { l.agregar("<text x=\"" + (ancho / 2) + "\" y=\"22\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"600\">" + _gf_esc(t) + "</text>") }
    retornar l
}

funcion _gf_leyenda(l, series, x, y) {
    sea i = 0
    para s en series {
        sea c = _GF_PALETA[i % longitud(_GF_PALETA)]
        si (tiene_clave(s, "color")) { c = s["color"] }
        l.agregar("<rect x=\"" + x + "\" y=\"" + (y + i * 18) + "\" width=\"12\" height=\"12\" fill=\"" + _gf_esc(c) + "\"/>")
        l.agregar("<text x=\"" + (x + 18) + "\" y=\"" + (y + i * 18 + 10) + "\">" + _gf_esc(s["nombre"] ?? ("Serie " + (i + 1))) + "</text>")
        i = i + 1
    }
}

funcion _gf_color(s, i) {
    si (tiene_clave(s, "color")) { retornar s["color"] }
    retornar _GF_PALETA[i % longitud(_GF_PALETA)]
}

// Ejes comunes; devuelve funciones de escala.
funcion _gf_ejes(l, etiquetas, min, max, o, ancho, alto, barras) {
    sea izq = 56
    sea der = ancho - 20
    sea arriba = 40
    sea abajo = alto - 40
    si (_gf_op(o, "leyenda", verdadero) != falso) { der = ancho - 130 }
    sea marcas = grafica_marcas(min, max, 5)
    sea lo = marcas[0]
    sea hi = marcas[longitud(marcas) - 1]
    sea ey = funcion(v) { retornar abajo - (v - lo) / (hi - lo) * (abajo - arriba) }
    sea n = maximo(1, longitud(etiquetas))
    sea ex = funcion(i) {
        si (barras) { retornar izq + (der - izq) * (i + 0.5) / n }
        si (n == 1) { retornar (izq + der) / 2 }
        retornar izq + (der - izq) * i / (n - 1)
    }
    para v en marcas {
        l.agregar("<line x1=\"" + izq + "\" x2=\"" + der + "\" y1=\"" + ey(v) + "\" y2=\"" + ey(v) + "\" stroke=\"#e5e7eb\"/>")
        l.agregar("<text x=\"" + (izq - 6) + "\" y=\"" + (ey(v) + 4) + "\" text-anchor=\"end\" fill=\"#4b5563\">" + _gf_num(v) + "</text>")
    }
    l.agregar("<line x1=\"" + izq + "\" x2=\"" + der + "\" y1=\"" + abajo + "\" y2=\"" + abajo + "\" stroke=\"#9ca3af\"/>")
    sea paso = maximo(1, techo(n / 12))
    sea i = 0
    mientras (i < longitud(etiquetas)) {
        si (i % paso == 0) { l.agregar("<text x=\"" + ex(i) + "\" y=\"" + (abajo + 18) + "\" text-anchor=\"middle\" fill=\"#4b5563\">" + _gf_esc(etiquetas[i]) + "</text>") }
        i = i + 1
    }
    retornar {"ex": ex, "ey": ey, "izq": izq, "der": der, "arriba": arriba, "abajo": abajo, "lo": lo, "hi": hi}
}

funcion _gf_rango(series, apiladas, n) {
    sea min = 0
    sea max = 0
    sea primero = verdadero
    si (apiladas) {
        sea i = 0
        mientras (i < n) {
            sea s = 0
            para x en series { si (i < longitud(x["valores"])) { s = s + (x["valores"][i] ?? 0) } }
            max = maximo(max, s)
            i = i + 1
        }
        retornar [0, max]
    }
    para x en series {
        para v en x["valores"] {
            si (v != nulo) {
                si (primero) { min = v  max = v  primero = falso } sino { min = minimo(min, v)  max = maximo(max, v) }
            }
        }
    }
    retornar [minimo(0, min), max]
}

/// Líneas (area = verdadero rellena bajo la curva). Los nulos cortan la línea.
funcion grafica_lineas(etiquetas, series, opciones) {
    sea ancho = _gf_op(opciones, "ancho", 640)
    sea alto = _gf_op(opciones, "alto", 360)
    sea l = _gf_marco(opciones, ancho, alto)
    sea r = _gf_rango(series, falso, longitud(etiquetas))
    sea e = _gf_ejes(l, etiquetas, r[0], r[1], opciones, ancho, alto, falso)
    sea k = 0
    para s en series {
        sea c = _gf_color(s, k)
        sea tramo = []
        sea tramos = []
        sea i = 0
        mientras (i < longitud(s["valores"])) {
            sea v = s["valores"][i]
            si (v == nulo) {
                si (longitud(tramo) > 0) { tramos.agregar(tramo)  tramo = [] }
            } sino { tramo.agregar([e["ex"](i), e["ey"](v)]) }
            i = i + 1
        }
        si (longitud(tramo) > 0) { tramos.agregar(tramo) }
        para t en tramos {
            sea pts = []
            para p en t { pts.agregar(redondear(p[0], 2) + "," + redondear(p[1], 2)) }
            si (_gf_op(opciones, "area", falso)) {
                sea base = e["ey"](maximo(e["lo"], 0))
                l.agregar("<polygon points=\"" + redondear(t[0][0], 2) + "," + redondear(base, 2) + " " + unir(pts, " ") + " " + redondear(t[longitud(t) - 1][0], 2) + "," + redondear(base, 2) + "\" fill=\"" + _gf_esc(c) + "\" fill-opacity=\"0.18\"/>")
            }
            l.agregar("<polyline points=\"" + unir(pts, " ") + "\" fill=\"none\" stroke=\"" + _gf_esc(c) + "\" stroke-width=\"2\" stroke-linejoin=\"round\"/>")
            si (_gf_op(opciones, "puntos", verdadero)) { para p en t { l.agregar("<circle cx=\"" + redondear(p[0], 2) + "\" cy=\"" + redondear(p[1], 2) + "\" r=\"3\" fill=\"" + _gf_esc(c) + "\"/>") } }
        }
        k = k + 1
    }
    si (_gf_op(opciones, "leyenda", verdadero) != falso) { _gf_leyenda(l, series, ancho - 120, 46) }
    l.agregar("</svg>")
    retornar unir(l, "\n")
}

/// Barras agrupadas o apiladas (apiladas = verdadero).
funcion grafica_barras(etiquetas, series, opciones) {
    sea ancho = _gf_op(opciones, "ancho", 640)
    sea alto = _gf_op(opciones, "alto", 360)
    sea apiladas = _gf_op(opciones, "apiladas", falso)
    sea l = _gf_marco(opciones, ancho, alto)
    sea r = _gf_rango(series, apiladas, longitud(etiquetas))
    sea e = _gf_ejes(l, etiquetas, r[0], r[1], opciones, ancho, alto, verdadero)
    sea n = maximo(1, longitud(etiquetas))
    sea grupo = (e["der"] - e["izq"]) / n * 0.8
    sea i = 0
    mientras (i < longitud(etiquetas)) {
        sea acumulado = 0
        sea k = 0
        para s en series {
            sea v = 0
            si (i < longitud(s["valores"])) { v = s["valores"][i] ?? 0 }
            sea x = 0
            sea w = 0
            sea y0 = 0
            sea y1 = 0
            si (apiladas) {
                w = grupo
                x = e["ex"](i) - w / 2
                y0 = e["ey"](acumulado)
                y1 = e["ey"](acumulado + v)
                acumulado = acumulado + v
            } sino {
                w = grupo / longitud(series)
                x = e["ex"](i) - grupo / 2 + k * w
                y0 = e["ey"](0)
                y1 = e["ey"](v)
            }
            sea top = minimo(y0, y1)
            l.agregar("<rect x=\"" + redondear(x, 2) + "\" y=\"" + redondear(top, 2) + "\" width=\"" + redondear(w * 0.92, 2) + "\" height=\"" + redondear(absoluto(y1 - y0), 2) + "\" fill=\"" + _gf_esc(_gf_color(s, k)) + "\"><title>" + _gf_esc((s["nombre"] ?? "") + ": " + _gf_num(v)) + "</title></rect>")
            k = k + 1
        }
        i = i + 1
    }
    si (_gf_op(opciones, "leyenda", verdadero) != falso) { _gf_leyenda(l, series, ancho - 120, 46) }
    l.agregar("</svg>")
    retornar unir(l, "\n")
}

/// Dispersión: series con "puntos": [[x, y], …].
funcion grafica_dispersion(series, opciones) {
    sea ancho = _gf_op(opciones, "ancho", 640)
    sea alto = _gf_op(opciones, "alto", 360)
    sea l = _gf_marco(opciones, ancho, alto)
    sea xs = []
    sea ys = []
    para s en series { para p en s["puntos"] { xs.agregar(p[0])  ys.agregar(p[1]) } }
    sea mx = grafica_marcas(_gf_min(xs), _gf_max(xs), 6)
    sea etiquetas = []
    para v en mx { etiquetas.agregar(_gf_num(v)) }
    sea e = _gf_ejes(l, etiquetas, _gf_min(ys), _gf_max(ys), opciones, ancho, alto, falso)
    sea x0 = mx[0]
    sea x1 = mx[longitud(mx) - 1]
    sea k = 0
    para s en series {
        para p en s["puntos"] {
            sea px = e["izq"] + (p[0] - x0) / (x1 - x0) * (e["der"] - e["izq"])
            l.agregar("<circle cx=\"" + redondear(px, 2) + "\" cy=\"" + redondear(e["ey"](p[1]), 2) + "\" r=\"4\" fill=\"" + _gf_esc(_gf_color(s, k)) + "\" fill-opacity=\"0.75\"/>")
        }
        k = k + 1
    }
    si (_gf_op(opciones, "leyenda", verdadero) != falso) { _gf_leyenda(l, series, ancho - 120, 46) }
    l.agregar("</svg>")
    retornar unir(l, "\n")
}

funcion _gf_min(l) {
    sea m = l[0]
    para v en l { m = minimo(m, v) }
    retornar m
}
funcion _gf_max(l) {
    sea m = l[0]
    para v en l { m = maximo(m, v) }
    retornar m
}

/// Torta (o dona con dona = verdadero), con porcentajes.
funcion grafica_torta(etiquetas, valores, opciones) {
    sea ancho = _gf_op(opciones, "ancho", 480)
    sea alto = _gf_op(opciones, "alto", 320)
    sea l = _gf_marco(opciones, ancho, alto)
    sea total = 0
    para v en valores { si (v < 0) { lanzar "grafica: la torta no admite valores negativos" }  total = total + v }
    si (total == 0) { lanzar "grafica: la torta necesita valores mayores que 0" }
    sea cx = 150
    sea cy = alto / 2 + 10
    sea r = minimo(120, alto / 2 - 30)
    sea ang = 0 - pi() / 2
    sea series = []
    sea i = 0
    mientras (i < longitud(valores)) {
        sea frac = valores[i] / total
        sea a2 = ang + frac * 2 * pi()
        sea c = _GF_PALETA[i % longitud(_GF_PALETA)]
        si (frac >= 0.9999) {
            l.agregar("<circle cx=\"" + cx + "\" cy=\"" + cy + "\" r=\"" + r + "\" fill=\"" + c + "\"/>")
        } sino {
            sea grande = 0
            si (frac > 0.5) { grande = 1 }
            sea x1 = cx + r * coseno(ang)
            sea y1 = cy + r * seno(ang)
            sea x2 = cx + r * coseno(a2)
            sea y2 = cy + r * seno(a2)
            l.agregar("<path d=\"M" + cx + "," + cy + " L" + redondear(x1, 2) + "," + redondear(y1, 2) + " A" + r + "," + r + " 0 " + grande + " 1 " + redondear(x2, 2) + "," + redondear(y2, 2) + " Z\" fill=\"" + c + "\" stroke=\"#ffffff\" stroke-width=\"1\"/>")
        }
        series.agregar({"nombre": etiquetas[i] + " (" + redondear(frac * 100, 1) + " %)"})
        ang = a2
        i = i + 1
    }
    si (_gf_op(opciones, "dona", falso)) { l.agregar("<circle cx=\"" + cx + "\" cy=\"" + cy + "\" r=\"" + (r * 0.55) + "\" fill=\"" + _gf_esc(_gf_op(opciones, "fondo", "#ffffff")) + "\"/>") }
    _gf_leyenda(l, series, 300, 60)
    l.agregar("</svg>")
    retornar unir(l, "\n")
}

/// Mini gráfico de línea sin ejes (para tablas o tableros).
funcion grafica_mini(valores, ancho, alto, color) {
    sea w = ancho ?? 100
    sea h = alto ?? 24
    sea lo = _gf_min(valores)
    sea hi = _gf_max(valores)
    si (hi == lo) { hi = lo + 1 }
    sea pts = []
    sea i = 0
    mientras (i < longitud(valores)) {
        sea x = w * i / maximo(1, longitud(valores) - 1)
        sea yv = h - 2 - (valores[i] - lo) / (hi - lo) * (h - 4)
        pts.agregar(redondear(x, 2) + "," + redondear(yv, 2))
        i = i + 1
    }
    retornar "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 " + w + " " + h + "\" width=\"" + w + "\" height=\"" + h + "\"><polyline points=\"" + unir(pts, " ") + "\" fill=\"none\" stroke=\"" + _gf_esc(color ?? "#2563eb") + "\" stroke-width=\"1.5\"/></svg>"
}
