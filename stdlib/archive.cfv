// stdlib/archive.cfv — ZIP y TAR seguros: nombres en inglés del módulo "archivador".
// English names for the "archivador" module; both can be used together.

importar "archivador"

funcion archive_safe_path(ruta) { retornar archivador_ruta_segura(ruta) }
funcion _archive_es(entradas) {
    sea r = []
    para e en entradas {
        sea x = {}
        para k en claves(e) { x[k] = e[k] }
        si (tiene_clave(e, "name")) { x["nombre"] = e["name"] }
        si (tiene_clave(e, "data")) { x["datos"] = e["data"] }
        si (tiene_clave(e, "date_ms")) { x["fecha_ms"] = e["date_ms"] }
        r.agregar(x)
    }
    retornar r
}

funcion _archive_en(entradas) {
    sea r = []
    para e en entradas { r.agregar({"name": e["nombre"], "data": e["datos"], "size": e["tamano"], "is_dir": e["es_carpeta"]}) }
    retornar r
}

/// entries: [{"name", "data", "date_ms"?}]
funcion archive_zip(entradas, comprimir) { retornar archivador_zip(_archive_es(entradas), comprimir) }
/// [{"name", "data", "size", "is_dir"}]; options: max_total, max_ratio, only.
funcion archive_read_zip(zip, opciones) {
    sea o = {}
    si (opciones != nulo) {
        para k en claves(opciones) { o[k] = opciones[k] }
        si (tiene_clave(opciones, "max_ratio")) { o["max_razon"] = opciones["max_ratio"] }
        si (tiene_clave(opciones, "only")) { o["solo"] = opciones["only"] }
    }
    retornar _archive_en(archivador_leer_zip(zip, o))
}
funcion archive_zip_entry(zip, nombre) { retornar archivador_zip_archivo(zip, nombre) }
funcion archive_tar(entradas) { retornar archivador_tar(_archive_es(entradas)) }
funcion archive_read_tar(tar, opciones) { retornar _archive_en(archivador_leer_tar(tar, opciones)) }
