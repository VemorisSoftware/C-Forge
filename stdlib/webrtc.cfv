// stdlib/webrtc.cfv — WebRTC propio (ICE, DTLS, SCTP, canales y SRTP): nombres en inglés del módulo "directo".
// English names for the "directo" module; both can be used together.


importar "directo"

funcion _webrtc_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_webrtc_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _webrtc_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _WEBRTC_RES = {"tipo": "type", "canal": "channel", "etiqueta": "label", "datos": "data", "binario": "binary", "mensaje": "message", "carga": "payload", "marcador": "marker"}
sea _WEBRTC_OPT = {"ip": "ip", "certificate": "certificado", "unordered": "desordenado", "protocol": "protocolo", "cookie": "cookie", "remote_fingerprint": "huella_remota"}

funcion webrtc_stun_build(tipo_m, txid, atributos, clave) { retornar directo_stun_armar(tipo_m, txid, atributos, clave) }
funcion webrtc_is_stun(p) { retornar directo_es_stun(p) }
funcion webrtc_stun_parse(p, clave) { retornar directo_stun_leer(p, clave) }
funcion webrtc_dtls(rol, opciones) { retornar directo_dtls(rol, _webrtc_opt(opciones)) }
funcion webrtc_certificate() { retornar directo_certificado() }
funcion webrtc_fingerprint(der) { retornar directo_huella(der) }
funcion webrtc_dtls_start(d, ahora) { retornar directo_dtls_iniciar(d, ahora) }
funcion webrtc_dtls_output(d) { retornar directo_dtls_salida(d) }
funcion webrtc_dtls_read(d) { retornar directo_dtls_leer(d) }
funcion webrtc_dtls_ready(d) { retornar directo_dtls_listo(d) }
funcion webrtc_dtls_write(d, datos) { retornar directo_dtls_escribir(d, datos) }
funcion webrtc_dtls_tick(d, ahora) { retornar directo_dtls_tic(d, ahora) }
funcion webrtc_dtls_export(d, etiqueta, largo) { retornar directo_dtls_exportar(d, etiqueta, largo) }
funcion webrtc_dtls_input(d, datagrama, ahora) { retornar directo_dtls_entrada(d, datagrama, ahora) }
funcion webrtc_sctp(opciones) { retornar directo_sctp(_webrtc_opt(opciones)) }
funcion webrtc_sctp_start(s, ahora) { retornar directo_sctp_iniciar(s, ahora) }
funcion webrtc_sctp_output(s) { retornar directo_sctp_salida(s) }
funcion webrtc_sctp_read(s) { retornar directo_sctp_leer(s) }
funcion webrtc_sctp_send(s, stream, ppid, datos, desordenado) { retornar directo_sctp_enviar(s, stream, ppid, datos, desordenado) }
funcion webrtc_sctp_tick(s, ahora) { retornar directo_sctp_tic(s, ahora) }
funcion webrtc_sctp_input(s, p, ahora) { retornar directo_sctp_entrada(s, p, ahora) }
funcion webrtc_sctp_reset_streams(s, streams) { retornar directo_sctp_reiniciar(s, streams) }
funcion webrtc_sdp_parse(sdp) { retornar directo_sdp_leer(sdp) }
funcion webrtc_peer(opciones) { retornar directo_par(_webrtc_opt(opciones)) }
funcion webrtc_create_offer(p) { retornar directo_oferta(p) }
funcion webrtc_create_answer(p, oferta) { retornar directo_respuesta(p, oferta) }
funcion webrtc_set_answer(p, respuesta) { retornar directo_aplicar_respuesta(p, respuesta) }
funcion webrtc_add_remote_candidate(p, ip, puerto) { retornar directo_candidato(p, ip, puerto) }
funcion webrtc_is_connected(p) { retornar directo_conectado(p) }
funcion webrtc_create_data_channel(p, etiqueta, opciones) { retornar directo_canal(p, etiqueta, _webrtc_opt(opciones)) }
funcion webrtc_send(p, canal, datos, binario) { retornar directo_enviar(p, canal, datos, binario) }
funcion webrtc_close_data_channel(p, canal) { retornar directo_cerrar_canal(p, canal) }
funcion webrtc_channel_label(p, canal) { retornar directo_etiqueta(p, canal) }
funcion webrtc_input(p, datos, ip, puerto, ahora) { retornar directo_entrada(p, datos, ip, puerto, ahora) }
funcion webrtc_tick(p, ahora) { retornar directo_tic(p, ahora) }
funcion webrtc_output(p) { retornar directo_salida(p) }
funcion webrtc_add_local_candidate(p, ip, puerto) { retornar directo_candidato_local(p, ip, puerto) }
funcion webrtc_bind(p, puerto) { retornar directo_vincular(p, puerto) }
funcion webrtc_poll(p) { retornar directo_procesar(p) }
funcion webrtc_run(pares, ms, condicion) { retornar directo_atender(pares, ms, condicion) }
funcion webrtc_close(p) { retornar directo_cerrar(p) }
funcion webrtc_rtp_build(c) { retornar directo_rtp_armar(c) }
funcion webrtc_rtp_parse(p) { retornar _webrtc_tr(directo_rtp_leer(p), _WEBRTC_RES) }
funcion webrtc_srtp(clave_maestra, sal_maestra) { retornar directo_srtp(clave_maestra, sal_maestra) }
funcion webrtc_srtp_contexts(d) { retornar directo_srtp_contextos(d) }
funcion webrtc_srtp_protect(ctx, rtp) { retornar directo_srtp_proteger(ctx, rtp) }
funcion webrtc_srtp_unprotect(ctx, srtp) { retornar directo_srtp_desproteger(ctx, srtp) }
funcion webrtc_send_rtp(p, rtp) { retornar directo_enviar_rtp(p, rtp) }
funcion webrtc_received_rtp(p) { retornar directo_rtp_recibidos(p) }

funcion _webrtc_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_WEBRTC_OPT[k] ?? k] = o[k] }
    retornar r
}

// Event types in English.
funcion webrtc_events(p) {
    sea r = []
    para e en directo_eventos(p) {
        sea t = {"conectado": "connected", "canal": "datachannel", "abierto": "open", "mensaje": "message", "cerrado": "close", "error": "error"}[e["tipo"]] ?? e["tipo"]
        sea x = {"type": t}
        para k en claves(e) { si (k != "tipo") { x[{"canal": "channel", "etiqueta": "label", "datos": "data", "binario": "binary", "mensaje": "message"}[k] ?? k] = e[k] } }
        r.agregar(x)
    }
    retornar r
}
