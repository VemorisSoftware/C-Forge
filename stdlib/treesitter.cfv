// stdlib/treesitter.cfv — Árboles de sintaxis (estilo tree-sitter): nombres en inglés del módulo "sintaxis".
// English names for the "sintaxis" module; both can be used together.

importar "sintaxis"

funcion ts_parse(codigo, lenguaje) { retornar sintaxis_analizar(codigo, lenguaje) }
funcion ts_sexp(arbol_o_nodo) { retornar sintaxis_sexp(arbol_o_nodo) }
funcion ts_node_text(arbol, nodo) { retornar sintaxis_texto(arbol, nodo) }
funcion ts_child_by_field(nodo, campo) { retornar sintaxis_hijo(nodo, campo) }
funcion ts_children_by_field(nodo, campo) { retornar sintaxis_hijos_campo(nodo, campo) }
funcion ts_find_all(arbol_o_nodo, tipo_n) { retornar sintaxis_buscar(arbol_o_nodo, tipo_n) }
funcion ts_descendant_for_range(arbol, a, b) { retornar sintaxis_nodo_en(arbol, a, b) }
funcion ts_query_captures(arbol, consulta) { retornar sintaxis_consulta(arbol, consulta) }
funcion ts_query_matches(arbol, consulta) { retornar sintaxis_coincidencias(arbol, consulta) }
