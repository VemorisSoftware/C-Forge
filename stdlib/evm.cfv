// stdlib/evm.cfv — Ethereum y EVM: nombres en inglés del módulo "cadena".
// English names for the "cadena" module; both can be used together.

importar "cadena"

funcion _evm_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_evm_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _evm_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _EVM_RES = {"crudo": "raw", "de": "from"}

funcion keccak256(datos) { retornar cadena_keccak(datos) }
funcion evm_int_to_bytes(v) { retornar cadena_entero_bytes(v) }
funcion evm_bytes_to_int(b) { retornar cadena_bytes_entero(b) }
funcion evm_to_wei(cantidad, unidad) { retornar cadena_wei(cantidad, unidad) }
funcion evm_format_units(wei, unidad) { retornar cadena_formatear(wei, unidad) }
funcion evm_checksum_address(dir) { retornar cadena_checksum(dir) }
funcion evm_is_address(dir) { retornar cadena_direccion_valida(dir) }
funcion evm_address(clave) { retornar cadena_direccion(clave) }
funcion rlp_encode(v) { retornar cadena_rlp(v) }
funcion rlp_decode(b) { retornar cadena_de_rlp(b) }
funcion abi_encode(tipos, valores) { retornar cadena_abi(tipos, valores) }
funcion abi_selector(firma) { retornar cadena_selector(firma) }
funcion abi_encode_call(firma, valores) { retornar cadena_abi_llamada(firma, valores) }
funcion abi_event_topic(firma) { retornar cadena_topico(firma) }
funcion abi_decode(tipos, datos) { retornar cadena_abi_decodificar(tipos, datos) }
funcion evm_hash_message(mensaje) { retornar cadena_hash_mensaje(mensaje) }
funcion evm_sign_message(priv, mensaje) { retornar cadena_firmar_mensaje(priv, mensaje) }
funcion evm_sign_hash(priv, hash) { retornar cadena_firmar_hash(priv, hash) }
funcion evm_recover(mensaje, firma_hex, es_hash) { retornar cadena_recuperar(mensaje, firma_hex, es_hash) }
funcion eip712_hash(separador, hash_struct) { retornar cadena_hash_712(separador, hash_struct) }
funcion evm_sign_transaction(priv, t) { retornar _evm_tr(cadena_firmar_tx(priv, t), _EVM_RES) }
funcion evm_contract_address(de, nonce) { retornar cadena_direccion_contrato(de, nonce) }
