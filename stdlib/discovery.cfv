// stdlib/discovery.cfv — descubrimiento con etcd y Consul: nombres en inglés del módulo "descubre".
// English names for the "descubre" module; both can be used together.


importar "descubre"

funcion _discovery_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_discovery_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _discovery_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _DISCOVERY_RES = {"clave": "key", "valor": "value", "creado": "create_revision", "modificado": "mod_revision", "arriendo": "lease", "tipo": "type", "exito": "succeeded", "respuestas": "responses", "tomado": "acquired", "direccion": "address", "puerto": "port", "etiquetas": "tags", "sano": "healthy", "nodo": "node", "indice": "index"}
sea _DISCOVERY_OPT = {"transport": "transporte", "user": "usuario", "password": "clave", "prefix": "prefijo", "limit": "limite", "keys_only": "solo_claves", "lease": "arriendo"}

funcion etcd_client(url, opciones) { retornar descubre_etcd(url, _discovery_opt(opciones)) }
funcion etcd_prefix_end(p) { retornar descubre_fin_prefijo(p) }
funcion etcd_put(cli, clave, valor, opciones) { retornar descubre_etcd_poner(cli, clave, valor, _discovery_opt(opciones)) }
funcion etcd_get(cli, clave) { retornar descubre_etcd_obtener(cli, clave) }
funcion etcd_range(cli, clave, opciones) { retornar _discovery_tr(descubre_etcd_rango(cli, clave, _discovery_opt(opciones)), _DISCOVERY_RES) }
funcion etcd_delete(cli, clave, prefijo) { retornar descubre_etcd_borrar(cli, clave, prefijo) }
funcion etcd_lease_grant(cli, ttl) { retornar descubre_etcd_arriendo(cli, ttl) }
funcion etcd_lease_keepalive(cli, id) { retornar descubre_etcd_renovar(cli, id) }
funcion etcd_lease_revoke(cli, id) { retornar descubre_etcd_revocar(cli, id) }
funcion etcd_txn(cli, comparar, exito, fallo) { retornar _discovery_tr(descubre_etcd_txn(cli, comparar, exito, fallo), _DISCOVERY_RES) }
funcion etcd_create(cli, clave, valor, arriendo) { retornar descubre_etcd_crear(cli, clave, valor, arriendo) }
funcion etcd_lock(cli, nombre, dueno, ttl) { retornar _discovery_tr(descubre_etcd_bloquear(cli, nombre, dueno, ttl), _DISCOVERY_RES) }
funcion etcd_unlock(cli, nombre, b) { retornar descubre_etcd_soltar(cli, nombre, b) }
funcion etcd_elect(cli, eleccion, candidato, ttl) { retornar descubre_etcd_elegir(cli, eleccion, candidato, ttl) }
funcion etcd_events(texto) { retornar _discovery_tr(descubre_etcd_eventos(texto), _DISCOVERY_RES) }
funcion consul_client(url, opciones) { retornar descubre_consul(url, _discovery_opt(opciones)) }
funcion consul_register(cli, s) { retornar descubre_consul_registrar(cli, s) }
funcion consul_deregister(cli, id) { retornar descubre_consul_baja(cli, id) }
funcion consul_check_ttl(cli, id_chequeo, estado, nota) { retornar descubre_consul_ttl(cli, id_chequeo, estado, nota) }
funcion consul_service(cli, nombre, sanos, etiqueta) { retornar _discovery_tr(descubre_consul_servicio(cli, nombre, sanos, etiqueta), _DISCOVERY_RES) }
funcion consul_services(cli) { retornar descubre_consul_servicios(cli) }
funcion consul_kv_get(cli, clave) { retornar descubre_consul_obtener(cli, clave) }
funcion consul_kv_prefix(cli, prefijo) { retornar _discovery_tr(descubre_consul_prefijo(cli, prefijo), _DISCOVERY_RES) }
funcion consul_kv_put(cli, clave, valor, cas) { retornar descubre_consul_poner(cli, clave, valor, cas) }
funcion consul_kv_delete(cli, clave, recursivo) { retornar descubre_consul_borrar(cli, clave, recursivo) }
funcion discovery_pick(instancias, politica, bal) { retornar _discovery_tr(descubre_elegir(instancias, politica, bal), _DISCOVERY_RES) }
funcion discovery_url(inst, esquema) { retornar descubre_url(inst, esquema) }

funcion _discovery_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_DISCOVERY_OPT[k] ?? k] = o[k] }
    retornar r
}
