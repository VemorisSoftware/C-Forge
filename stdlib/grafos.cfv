// stdlib/grafos.cfv — grafos y sus algoritmos al estilo petgraph:
// dirigidos o no, con pesos y datos; recorridos, caminos mínimos (Dijkstra,
// A*, Bellman-Ford, Floyd-Warshall, k caminos de Yen), orden topológico,
// componentes (conexas y fuertemente conexas), árbol de expansión mínima,
// flujo máximo y corte mínimo, emparejamiento bipartito, puentes y puntos de
// articulación, coloreo, PageRank, intermediación, camino euleriano y
// exportación a DOT. Inspirada en petgraph y NetworkX (MIT/BSD).
// En inglés: importar "graph".
//
//   importar "grafos"
//   sea g = grafos_nuevo(falso)
//   grafos_arista(g, "a", "b", 4)
//   grafos_arista(g, "b", "c", 1)
//   grafos_dijkstra(g, "a", "c")      // {"distancia": 5, "camino": [a, b, c]}

// ══ Montículo de prioridad ═════════════════════════════════════════════════

funcion _gf_monticulo() { retornar {"h": [], "n": 0} }

funcion _gf_menor(a, b) {
    si (a[0] != b[0]) { retornar a[0] < b[0] }
    retornar a[1] < b[1]
}

funcion _gf_meter(m, prioridad, valor) {
    m["n"] = m["n"] + 1
    sea h = m["h"]
    h.agregar([prioridad, m["n"], valor])
    sea i = longitud(h) - 1
    mientras (i > 0) {
        sea p = cociente(i - 1, 2)
        si (_gf_menor(h[i], h[p])) {
            sea t = h[i]
            h[i] = h[p]
            h[p] = t
            i = p
        } sino { romper }
    }
}

funcion _gf_sacar(m) {
    sea h = m["h"]
    sea r = h[0]
    sea ult = quitar_ultimo(h)
    si (longitud(h) > 0) {
        h[0] = ult
        sea i = 0
        sea n = longitud(h)
        mientras (verdadero) {
            sea a = 2 * i + 1
            sea b = a + 1
            sea m2 = i
            si (a < n y _gf_menor(h[a], h[m2])) { m2 = a }
            si (b < n y _gf_menor(h[b], h[m2])) { m2 = b }
            si (m2 == i) { romper }
            sea t = h[i]
            h[i] = h[m2]
            h[m2] = t
            i = m2
        }
    }
    retornar r
}

funcion _gf_vacio(m) { retornar longitud(m["h"]) == 0 }

// ══ Estructura ═════════════════════════════════════════════════════════════
// Nodos por id (texto). Aristas en listas de adyacencia [destino, peso, id].

funcion grafos_nuevo(dirigido) {
    retornar {"dirigido": dirigido == verdadero, "nodos": {}, "orden": [], "ady": {}, "entrada": {}, "aristas": {}, "sig_arista": 0}
}

funcion _gf_id(x) { retornar "" + x }

/// Agrega (o actualiza) un nodo con datos opcionales.
funcion grafos_nodo(g, id, datos) {
    sea k = _gf_id(id)
    si (tiene_clave(g["nodos"], k) == falso) {
        g["orden"].agregar(k)
        g["ady"][k] = []
        g["entrada"][k] = []
        g["nodos"][k] = datos
    } sino { si (datos != nulo) { g["nodos"][k] = datos } }
    retornar k
}

/// Agrega una arista (crea los nodos que falten). Devuelve su id.
funcion grafos_arista(g, a, b, peso, datos) {
    sea x = grafos_nodo(g, a, nulo)
    sea y = grafos_nodo(g, b, nulo)
    sea id = g["sig_arista"]
    g["sig_arista"] = id + 1
    sea w = peso ?? 1
    g["aristas"]["" + id] = {"desde": x, "hasta": y, "peso": w, "datos": datos}
    g["ady"][x].agregar([y, w, id])
    g["entrada"][y].agregar([x, w, id])
    si (g["dirigido"] == falso y x != y) {
        g["ady"][y].agregar([x, w, id])
        g["entrada"][x].agregar([y, w, id])
    }
    retornar id
}

funcion grafos_quitar_arista(g, id) {
    sea k = "" + id
    si (tiene_clave(g["aristas"], k) == falso) { retornar falso }
    quitar_clave(g["aristas"], k)
    para n en g["orden"] {
        sea r = []
        para e en g["ady"][n] { si (e[2] != id) { r.agregar(e) } }
        g["ady"][n] = r
        sea r2 = []
        para e en g["entrada"][n] { si (e[2] != id) { r2.agregar(e) } }
        g["entrada"][n] = r2
    }
    retornar verdadero
}

funcion grafos_quitar_nodo(g, id) {
    sea k = _gf_id(id)
    si (tiene_clave(g["nodos"], k) == falso) { retornar falso }
    para e en claves(g["aristas"]) {
        sea a = g["aristas"][e]
        si (a["desde"] == k o a["hasta"] == k) { quitar_clave(g["aristas"], e) }
    }
    quitar_clave(g["nodos"], k)
    quitar_clave(g["ady"], k)
    quitar_clave(g["entrada"], k)
    sea o = []
    para n en g["orden"] { si (n != k) { o.agregar(n) } }
    g["orden"] = o
    para n en o {
        sea r = []
        para e en g["ady"][n] { si (e[0] != k) { r.agregar(e) } }
        g["ady"][n] = r
        sea r2 = []
        para e en g["entrada"][n] { si (e[0] != k) { r2.agregar(e) } }
        g["entrada"][n] = r2
    }
    retornar verdadero
}

funcion grafos_nodos(g) { retornar g["orden"] }
funcion grafos_datos(g, id) { retornar g["nodos"][_gf_id(id)] ?? nulo }
funcion grafos_cantidad_nodos(g) { retornar longitud(g["orden"]) }
funcion grafos_cantidad_aristas(g) { retornar longitud(claves(g["aristas"])) }

/// Aristas como [{"id", "desde", "hasta", "peso", "datos"}].
funcion grafos_aristas(g) {
    sea r = []
    sea ids = []
    para k en claves(g["aristas"]) { ids.agregar(a_numero(k)) }
    ids = ordenar(ids, funcion(a, b) { retornar a - b })
    para i en ids {
        sea a = g["aristas"]["" + i]
        r.agregar({"id": i, "desde": a["desde"], "hasta": a["hasta"], "peso": a["peso"], "datos": a["datos"]})
    }
    retornar r
}

funcion grafos_vecinos(g, id) {
    sea r = []
    sea vistos = {}
    para e en g["ady"][_gf_id(id)] ?? [] {
        si (tiene_clave(vistos, e[0]) == falso) { vistos[e[0]] = verdadero  r.agregar(e[0]) }
    }
    retornar r
}

funcion grafos_grado(g, id) { retornar longitud(g["ady"][_gf_id(id)] ?? []) }
funcion grafos_grado_entrada(g, id) { retornar longitud(g["entrada"][_gf_id(id)] ?? []) }

funcion grafos_tiene_arista(g, a, b) {
    para e en g["ady"][_gf_id(a)] ?? [] { si (e[0] == _gf_id(b)) { retornar verdadero } }
    retornar falso
}

// ══ Recorridos ═════════════════════════════════════════════════════════════

funcion grafos_bfs(g, inicio) {
    sea s = _gf_id(inicio)
    sea r = [s]
    sea visto = {}
    visto[s] = verdadero
    sea i = 0
    mientras (i < longitud(r)) {
        para e en g["ady"][r[i]] {
            si (tiene_clave(visto, e[0]) == falso) { visto[e[0]] = verdadero  r.agregar(e[0]) }
        }
        i = i + 1
    }
    retornar r
}

/// DFS en preorden (iterativo; visita vecinos en orden de inserción).
funcion grafos_dfs(g, inicio) {
    sea r = []
    sea visto = {}
    sea pila = [_gf_id(inicio)]
    mientras (longitud(pila) > 0) {
        sea n = quitar_ultimo(pila)
        si (tiene_clave(visto, n) == falso) {
            visto[n] = verdadero
            r.agregar(n)
            sea v = g["ady"][n]
            sea i = longitud(v) - 1
            mientras (i >= 0) {
                si (tiene_clave(visto, v[i][0]) == falso) { pila.agregar(v[i][0]) }
                i = i - 1
            }
        }
    }
    retornar r
}

// ══ Caminos mínimos ════════════════════════════════════════════════════════

funcion _gf_camino(prev, destino) {
    sea r = []
    sea x = destino
    mientras (x != nulo) {
        r.agregar(x)
        x = prev[x] ?? nulo
    }
    retornar lista_invertir(r)
}

/// Dijkstra (pesos no negativos). Con destino: {"distancia", "camino"} (o
/// nulo si no se llega). Sin destino: {"distancias": {nodo: d}, "previos"}.
funcion grafos_dijkstra(g, inicio, destino) {
    retornar grafos_astar(g, inicio, destino, nulo)
}

/// A*: heuristica(nodo) → estimación admisible de la distancia al destino.
funcion grafos_astar(g, inicio, destino, heuristica) {
    sea s = _gf_id(inicio)
    sea t = nulo
    si (destino != nulo) { t = _gf_id(destino) }
    sea dist = {}
    sea prev = {}
    sea cerrado = {}
    dist[s] = 0
    sea m = _gf_monticulo()
    _gf_meter(m, 0, s)
    mientras (_gf_vacio(m) == falso) {
        sea x = _gf_sacar(m)
        sea u = x[2]
        si (tiene_clave(cerrado, u) == falso) {
            cerrado[u] = verdadero
            si (u == t) { retornar {"distancia": dist[u], "camino": _gf_camino(prev, u), "explorados": longitud(claves(cerrado))} }
            para e en g["ady"][u] {
                si (e[1] < 0) { lanzar "grafos: Dijkstra/A* no admite pesos negativos (usa grafos_bellman_ford)" }
                sea nd = dist[u] + e[1]
                si (tiene_clave(dist, e[0]) == falso o nd < dist[e[0]]) {
                    dist[e[0]] = nd
                    prev[e[0]] = u
                    sea h = 0
                    si (heuristica != nulo) { h = heuristica(e[0]) }
                    _gf_meter(m, nd + h, e[0])
                }
            }
        }
    }
    si (t != nulo) { retornar nulo }
    retornar {"distancias": dist, "previos": prev}
}

/// Bellman-Ford: admite pesos negativos. {"distancias", "previos"} o lanza
/// si hay un ciclo negativo alcanzable.
funcion grafos_bellman_ford(g, inicio) {
    sea s = _gf_id(inicio)
    sea dist = {}
    sea prev = {}
    dist[s] = 0
    sea lista = []
    para k en claves(g["aristas"]) {
        sea a = g["aristas"][k]
        lista.agregar([a["desde"], a["hasta"], a["peso"]])
        si (g["dirigido"] == falso) { lista.agregar([a["hasta"], a["desde"], a["peso"]]) }
    }
    sea i = 0
    mientras (i < longitud(g["orden"]) - 1) {
        sea cambio = falso
        para e en lista {
            si (tiene_clave(dist, e[0]) y (tiene_clave(dist, e[1]) == falso o dist[e[0]] + e[2] < dist[e[1]])) {
                dist[e[1]] = dist[e[0]] + e[2]
                prev[e[1]] = e[0]
                cambio = verdadero
            }
        }
        si (cambio == falso) { romper }
        i = i + 1
    }
    para e en lista {
        si (tiene_clave(dist, e[0]) y dist[e[0]] + e[2] < (dist[e[1]] ?? 1e308)) { lanzar "grafos: hay un ciclo de peso negativo" }
    }
    retornar {"distancias": dist, "previos": prev}
}

/// Floyd-Warshall: distancias entre todos los pares {a: {b: d}} (sin
/// camino → no aparece).
funcion grafos_floyd_warshall(g) {
    sea d = {}
    para a en g["orden"] {
        d[a] = {}
        d[a][a] = 0
    }
    para k en claves(g["aristas"]) {
        sea e = g["aristas"][k]
        si (e["peso"] < (d[e["desde"]][e["hasta"]] ?? 1e308)) { d[e["desde"]][e["hasta"]] = e["peso"] }
        si (g["dirigido"] == falso y e["peso"] < (d[e["hasta"]][e["desde"]] ?? 1e308)) { d[e["hasta"]][e["desde"]] = e["peso"] }
    }
    para k en g["orden"] {
        para i en g["orden"] {
            si (tiene_clave(d[i], k)) {
                sea dik = d[i][k]
                para j en claves(d[k]) {
                    sea nd = dik + d[k][j]
                    si (nd < (d[i][j] ?? 1e308)) { d[i][j] = nd }
                }
            }
        }
    }
    para i en g["orden"] { si ((d[i][i] ?? 0) < 0) { lanzar "grafos: hay un ciclo de peso negativo" } }
    retornar d
}

/// Los k caminos más cortos sin ciclos (algoritmo de Yen).
funcion grafos_k_caminos(g, inicio, destino, k) {
    sea s = _gf_id(inicio)
    sea t = _gf_id(destino)
    sea primero = grafos_dijkstra(g, s, t)
    si (primero == nulo) { retornar [] }
    sea a = [primero]
    sea candidatos = []
    mientras (longitud(a) < k) {
        sea ultimo = a[longitud(a) - 1]["camino"]
        sea i = 0
        mientras (i < longitud(ultimo) - 1) {
            sea espuela = ultimo[i]
            sea raiz = []
            sea j = 0
            mientras (j <= i) { raiz.agregar(ultimo[j])  j = j + 1 }
            // Grafo reducido: sin las aristas usadas por caminos con la misma raíz
            // y sin los nodos de la raíz (salvo la espuela).
            sea prohibidas = {}
            para c en a {
                sea p = c["camino"]
                si (longitud(p) > i + 1) {
                    sea igual_raiz = verdadero
                    j = 0
                    mientras (j <= i) { si (p[j] != raiz[j]) { igual_raiz = falso }  j = j + 1 }
                    si (igual_raiz) { prohibidas[p[i] + caracter(1) + p[i + 1]] = verdadero }
                }
            }
            sea fuera = {}
            j = 0
            mientras (j < i) { fuera[raiz[j]] = verdadero  j = j + 1 }
            sea h = grafos_nuevo(g["dirigido"])
            para n en g["orden"] { si (tiene_clave(fuera, n) == falso) { grafos_nodo(h, n, nulo) } }
            para ke en claves(g["aristas"]) {
                sea e = g["aristas"][ke]
                si (tiene_clave(fuera, e["desde"]) == falso y tiene_clave(fuera, e["hasta"]) == falso y tiene_clave(prohibidas, e["desde"] + caracter(1) + e["hasta"]) == falso y (g["dirigido"] o tiene_clave(prohibidas, e["hasta"] + caracter(1) + e["desde"]) == falso)) { grafos_arista(h, e["desde"], e["hasta"], e["peso"], nulo) }
            }
            sea sp = grafos_dijkstra(h, espuela, t)
            si (sp != nulo) {
                sea total = []
                j = 0
                mientras (j < i) { total.agregar(raiz[j])  j = j + 1 }
                para x en sp["camino"] { total.agregar(x) }
                sea costo = _gf_costo(g, total)
                sea repetido = falso
                para c en candidatos { si (unir(c["camino"], caracter(1)) == unir(total, caracter(1))) { repetido = verdadero } }
                para c en a { si (unir(c["camino"], caracter(1)) == unir(total, caracter(1))) { repetido = verdadero } }
                si (repetido == falso) { candidatos.agregar({"distancia": costo, "camino": total}) }
            }
            i = i + 1
        }
        si (longitud(candidatos) == 0) { romper }
        candidatos = ordenar(candidatos, funcion(x, z) {
            si (x["distancia"] != z["distancia"]) { retornar x["distancia"] - z["distancia"] }
            retornar longitud(x["camino"]) - longitud(z["camino"])
        })
        a.agregar(candidatos[0])
        sea resto = []
        sea q = 1
        mientras (q < longitud(candidatos)) { resto.agregar(candidatos[q])  q = q + 1 }
        candidatos = resto
    }
    retornar a
}

funcion _gf_costo(g, camino) {
    sea c = 0
    sea i = 0
    mientras (i < longitud(camino) - 1) {
        sea mejor = nulo
        para e en g["ady"][camino[i]] { si (e[0] == camino[i + 1] y (mejor == nulo o e[1] < mejor)) { mejor = e[1] } }
        c = c + mejor
        i = i + 1
    }
    retornar c
}

// ══ Estructura del grafo ═══════════════════════════════════════════════════

/// Orden topológico (Kahn, estable). Lanza si hay un ciclo.
funcion grafos_topologico(g) {
    sea grado = {}
    para n en g["orden"] { grado[n] = 0 }
    para n en g["orden"] { para e en g["ady"][n] { grado[e[0]] = grado[e[0]] + 1 } }
    sea cola = []
    para n en g["orden"] { si (grado[n] == 0) { cola.agregar(n) } }
    sea r = []
    sea i = 0
    mientras (i < longitud(cola)) {
        sea n = cola[i]
        r.agregar(n)
        para e en g["ady"][n] {
            grado[e[0]] = grado[e[0]] - 1
            si (grado[e[0]] == 0) { cola.agregar(e[0]) }
        }
        i = i + 1
    }
    si (longitud(r) != longitud(g["orden"])) { lanzar "grafos: el grafo tiene un ciclo" }
    retornar r
}

funcion grafos_tiene_ciclo(g) {
    si (g["dirigido"]) {
        sea hay = falso
        intentar { grafos_topologico(g) } capturar (e) { hay = verdadero }
        retornar hay
    }
    // No dirigido: un ciclo existe si alguna componente tiene aristas ≥ nodos.
    sea uf = _gf_uf(g["orden"])
    para k en claves(g["aristas"]) {
        sea e = g["aristas"][k]
        si (_gf_uf_buscar(uf, e["desde"]) == _gf_uf_buscar(uf, e["hasta"])) { retornar verdadero }
        _gf_uf_unir(uf, e["desde"], e["hasta"])
    }
    retornar falso
}

// Unión-búsqueda con compresión de caminos y unión por rango.
funcion _gf_uf(nodos) {
    sea p = {}
    sea r = {}
    para n en nodos { p[n] = n  r[n] = 0 }
    retornar {"p": p, "r": r}
}

funcion _gf_uf_buscar(uf, x) {
    sea raiz = x
    mientras (uf["p"][raiz] != raiz) { raiz = uf["p"][raiz] }
    mientras (uf["p"][x] != raiz) {
        sea s = uf["p"][x]
        uf["p"][x] = raiz
        x = s
    }
    retornar raiz
}

funcion _gf_uf_unir(uf, a, b) {
    sea x = _gf_uf_buscar(uf, a)
    sea y = _gf_uf_buscar(uf, b)
    si (x == y) { retornar falso }
    si (uf["r"][x] < uf["r"][y]) { uf["p"][x] = y } sino {
        uf["p"][y] = x
        si (uf["r"][x] == uf["r"][y]) { uf["r"][x] = uf["r"][x] + 1 }
    }
    retornar verdadero
}

/// Componentes conexas (débilmente conexas si es dirigido), cada una en
/// orden de inserción.
funcion grafos_componentes(g) {
    sea uf = _gf_uf(g["orden"])
    para k en claves(g["aristas"]) { _gf_uf_unir(uf, g["aristas"][k]["desde"], g["aristas"][k]["hasta"]) }
    sea grupos = {}
    sea orden = []
    para n en g["orden"] {
        sea r = _gf_uf_buscar(uf, n)
        si (tiene_clave(grupos, r) == falso) { grupos[r] = []  orden.agregar(r) }
        grupos[r].agregar(n)
    }
    sea res = []
    para r en orden { res.agregar(grupos[r]) }
    retornar res
}

/// Componentes fuertemente conexas (Tarjan, iterativo).
funcion grafos_fuertemente_conexas(g) {
    sea indice = {}
    sea bajo = {}
    sea en_pila = {}
    sea pila = []
    sea res = []
    sea contador = 0
    para raiz en g["orden"] {
        si (tiene_clave(indice, raiz) == falso) {
            sea llamadas = [[raiz, 0]]
            indice[raiz] = contador
            bajo[raiz] = contador
            contador = contador + 1
            pila.agregar(raiz)
            en_pila[raiz] = verdadero
            mientras (longitud(llamadas) > 0) {
                sea marco = llamadas[longitud(llamadas) - 1]
                sea v = marco[0]
                sea ady = g["ady"][v]
                si (marco[1] < longitud(ady)) {
                    sea w = ady[marco[1]][0]
                    marco[1] = marco[1] + 1
                    si (tiene_clave(indice, w) == falso) {
                        indice[w] = contador
                        bajo[w] = contador
                        contador = contador + 1
                        pila.agregar(w)
                        en_pila[w] = verdadero
                        llamadas.agregar([w, 0])
                    } sino {
                        si (en_pila[w] ?? falso) { bajo[v] = minimo(bajo[v], indice[w]) }
                    }
                } sino {
                    quitar_ultimo(llamadas)
                    si (longitud(llamadas) > 0) {
                        sea padre = llamadas[longitud(llamadas) - 1][0]
                        bajo[padre] = minimo(bajo[padre], bajo[v])
                    }
                    si (bajo[v] == indice[v]) {
                        sea comp = []
                        mientras (verdadero) {
                            sea w = quitar_ultimo(pila)
                            en_pila[w] = falso
                            comp.agregar(w)
                            si (w == v) { romper }
                        }
                        res.agregar(comp)
                    }
                }
            }
        }
    }
    retornar res
}

/// Árbol (bosque) de expansión mínima con Kruskal: {"peso", "aristas"}.
/// maximo: verdadero para el de expansión máxima.
funcion grafos_arbol_minimo(g, maximo) {
    sea es = grafos_aristas(g)
    es = ordenar(es, funcion(a, b) {
        si (a["peso"] != b["peso"]) {
            si (maximo == verdadero) { retornar b["peso"] - a["peso"] }
            retornar a["peso"] - b["peso"]
        }
        retornar a["id"] - b["id"]
    })
    sea uf = _gf_uf(g["orden"])
    sea r = []
    sea total = 0
    para e en es {
        si (_gf_uf_unir(uf, e["desde"], e["hasta"])) {
            r.agregar(e)
            total = total + e["peso"]
        }
    }
    retornar {"peso": total, "aristas": r}
}

/// Flujo máximo (Dinic) de fuente a sumidero usando los pesos como
/// capacidades. {"flujo", "corte": [nodos del lado de la fuente],
/// "flujos": {"a>b": f}}.
funcion grafos_flujo_maximo(g, fuente, sumidero) {
    sea s = _gf_id(fuente)
    sea t = _gf_id(sumidero)
    // Red residual: aristas [destino, capacidad, índice de la inversa].
    sea red = {}
    para n en g["orden"] { red[n] = [] }
    sea originales = []
    para k en claves(g["aristas"]) {
        sea e = g["aristas"][k]
        sea a = e["desde"]
        sea b = e["hasta"]
        sea cap_inv = 0
        si (g["dirigido"] == falso) { cap_inv = e["peso"] }
        red[a].agregar([b, e["peso"], longitud(red[b])])
        red[b].agregar([a, cap_inv, longitud(red[a]) - 1])
        originales.agregar([a, longitud(red[a]) - 1, e["peso"]])
    }
    sea flujo = 0
    mientras (verdadero) {
        // BFS de niveles.
        sea nivel = {}
        nivel[s] = 0
        sea cola = [s]
        sea i = 0
        mientras (i < longitud(cola)) {
            sea u = cola[i]
            para e en red[u] {
                si (e[1] > 0 y tiene_clave(nivel, e[0]) == falso) {
                    nivel[e[0]] = nivel[u] + 1
                    cola.agregar(e[0])
                }
            }
            i = i + 1
        }
        si (tiene_clave(nivel, t) == falso) { romper }
        sea ptr = {}
        para n en g["orden"] { ptr[n] = 0 }
        // DFS iterativa de caminos de aumento en la red de niveles.
        mientras (verdadero) {
            sea camino = []
            sea u = s
            sea pila = [s]
            sea encontrado = falso
            mientras (verdadero) {
                si (u == t) { encontrado = verdadero  romper }
                sea avanzo = falso
                mientras (ptr[u] < longitud(red[u])) {
                    sea e = red[u][ptr[u]]
                    si (e[1] > 0 y tiene_clave(nivel, e[0]) y nivel[e[0]] == nivel[u] + 1) {
                        camino.agregar([u, ptr[u]])
                        u = e[0]
                        pila.agregar(u)
                        avanzo = verdadero
                        romper
                    }
                    ptr[u] = ptr[u] + 1
                }
                si (avanzo == falso) {
                    si (u == s) { romper }
                    // Callejón: se descarta y se retrocede.
                    quitar_ultimo(pila)
                    sea atras = quitar_ultimo(camino)
                    u = atras[0]
                    ptr[u] = ptr[u] + 1
                }
            }
            si (encontrado == falso) { romper }
            sea f = 1e308
            para paso en camino { f = minimo(f, red[paso[0]][paso[1]][1]) }
            para paso en camino {
                sea e = red[paso[0]][paso[1]]
                e[1] = e[1] - f
                red[e[0]][e[2]][1] = red[e[0]][e[2]][1] + f
            }
            flujo = flujo + f
        }
    }
    // Corte mínimo: lo alcanzable en la red residual.
    sea alcanzable = {}
    alcanzable[s] = verdadero
    sea cola2 = [s]
    sea j = 0
    mientras (j < longitud(cola2)) {
        para e en red[cola2[j]] { si (e[1] > 0 y tiene_clave(alcanzable, e[0]) == falso) { alcanzable[e[0]] = verdadero  cola2.agregar(e[0]) } }
        j = j + 1
    }
    sea corte = []
    para n en g["orden"] { si (tiene_clave(alcanzable, n)) { corte.agregar(n) } }
    sea flujos = {}
    para o en originales {
        sea e = red[o[0]][o[1]]
        sea usado = o[2] - e[1]
        si (usado > 0) { flujos[o[0] + ">" + e[0]] = (flujos[o[0] + ">" + e[0]] ?? 0) + usado }
    }
    retornar {"flujo": flujo, "corte": corte, "flujos": flujos}
}

/// Emparejamiento máximo en un grafo bipartito (Hopcroft-Karp). izquierda:
/// lista de nodos de un lado. Devuelve {nodo_izq: nodo_der}.
funcion grafos_emparejamiento(g, izquierda) {
    sea par_i = {}
    sea par_d = {}
    sea izq = []
    para x en izquierda { izq.agregar(_gf_id(x)) }
    mientras (verdadero) {
        // BFS desde los libres de la izquierda.
        sea dist = {}
        sea cola = []
        para u en izq { si (tiene_clave(par_i, u) == falso) { dist[u] = 0  cola.agregar(u) } }
        sea hay = falso
        sea i = 0
        mientras (i < longitud(cola)) {
            sea u = cola[i]
            para e en g["ady"][u] {
                sea v = e[0]
                si (tiene_clave(par_d, v) == falso) { hay = verdadero } sino {
                    sea w = par_d[v]
                    si (tiene_clave(dist, w) == falso) { dist[w] = dist[u] + 1  cola.agregar(w) }
                }
            }
            i = i + 1
        }
        si (hay == falso) { romper }
        // DFS de caminos de aumento.
        para u en izq {
            si (tiene_clave(par_i, u) == falso) { _gf_hk_dfs(g, u, par_i, par_d, dist) }
        }
    }
    retornar par_i
}

funcion _gf_hk_dfs(g, u, par_i, par_d, dist) {
    para e en g["ady"][u] {
        sea v = e[0]
        sea w = par_d[v] ?? nulo
        si (w == nulo o ((dist[w] ?? -1) == dist[u] + 1 y _gf_hk_dfs(g, w, par_i, par_d, dist))) {
            par_i[u] = v
            par_d[v] = u
            retornar verdadero
        }
    }
    dist[u] = -1
    retornar falso
}

/// Puentes y puntos de articulación de un grafo no dirigido:
/// {"puentes": [[a, b]], "articulaciones": [nodos]}.
funcion grafos_puentes(g) {
    sea indice = {}
    sea bajo = {}
    sea puentes = []
    sea artic = {}
    sea contador = 0
    para raiz en g["orden"] {
        si (tiene_clave(indice, raiz) == falso) {
            indice[raiz] = contador
            bajo[raiz] = contador
            contador = contador + 1
            sea llamadas = [[raiz, 0, -1]]
            sea hijos_raiz = 0
            mientras (longitud(llamadas) > 0) {
                sea marco = llamadas[longitud(llamadas) - 1]
                sea v = marco[0]
                sea ady = g["ady"][v]
                si (marco[1] < longitud(ady)) {
                    sea e = ady[marco[1]]
                    marco[1] = marco[1] + 1
                    si (e[2] != marco[2]) {
                        sea w = e[0]
                        si (tiene_clave(indice, w) == falso) {
                            indice[w] = contador
                            bajo[w] = contador
                            contador = contador + 1
                            si (v == raiz) { hijos_raiz = hijos_raiz + 1 }
                            llamadas.agregar([w, 0, e[2]])
                        } sino { bajo[v] = minimo(bajo[v], indice[w]) }
                    }
                } sino {
                    quitar_ultimo(llamadas)
                    si (longitud(llamadas) > 0) {
                        sea p = llamadas[longitud(llamadas) - 1][0]
                        bajo[p] = minimo(bajo[p], bajo[v])
                        si (bajo[v] > indice[p]) { puentes.agregar([p, v]) }
                        si (p != raiz y bajo[v] >= indice[p]) { artic[p] = verdadero }
                    }
                }
            }
            si (hijos_raiz > 1) { artic[raiz] = verdadero }
        }
    }
    sea a = []
    para n en g["orden"] { si (tiene_clave(artic, n)) { a.agregar(n) } }
    retornar {"puentes": puentes, "articulaciones": a}
}

/// Coloreo voraz (Welsh-Powell: de mayor a menor grado). {nodo: color}.
funcion grafos_colorear(g) {
    sea nodos = ordenar(g["orden"], funcion(a, b) {
        sea d = grafos_grado(g, b) - grafos_grado(g, a)
        si (d != 0) { retornar d }
        si (a < b) { retornar -1 }
        retornar 1
    })
    sea color = {}
    para n en nodos {
        sea usados = {}
        para e en g["ady"][n] { si (tiene_clave(color, e[0])) { usados["" + color[e[0]]] = verdadero } }
        para e en g["entrada"][n] { si (tiene_clave(color, e[0])) { usados["" + color[e[0]]] = verdadero } }
        sea c = 0
        mientras (tiene_clave(usados, "" + c)) { c = c + 1 }
        color[n] = c
    }
    retornar color
}

/// PageRank (amortiguación 0.85). {nodo: puntaje}, suma 1.
funcion grafos_pagerank(g, amortiguacion, iteraciones) {
    sea d = amortiguacion ?? 0.85
    sea n = longitud(g["orden"])
    si (n == 0) { retornar {} }
    sea pr = {}
    para x en g["orden"] { pr[x] = 1 / n }
    sea salida = {}
    para x en g["orden"] {
        sea w = 0
        para e en g["ady"][x] { w = w + e[1] }
        salida[x] = w
    }
    sea it = 0
    mientras (it < (iteraciones ?? 100)) {
        sea nuevo = {}
        sea colgantes = 0
        para x en g["orden"] { si (salida[x] == 0) { colgantes = colgantes + pr[x] } }
        para x en g["orden"] { nuevo[x] = (1 - d) / n + d * colgantes / n }
        para x en g["orden"] {
            si (salida[x] > 0) {
                para e en g["ady"][x] { nuevo[e[0]] = nuevo[e[0]] + d * pr[x] * e[1] / salida[x] }
            }
        }
        sea dif = 0
        para x en g["orden"] { dif = dif + absoluto(nuevo[x] - pr[x]) }
        pr = nuevo
        si (dif < n * 1e-10) { romper }
        it = it + 1
    }
    retornar pr
}

/// Centralidad de intermediación (Brandes, sin pesos). normalizar:
/// verdadero divide por (n-1)(n-2) (o la mitad si no es dirigido).
funcion grafos_intermediacion(g, normalizar) {
    sea cb = {}
    para v en g["orden"] { cb[v] = 0 }
    para s en g["orden"] {
        sea pila = []
        sea pred = {}
        sea sigma = {}
        sea dist = {}
        para v en g["orden"] { pred[v] = []  sigma[v] = 0 }
        sigma[s] = 1
        dist[s] = 0
        sea cola = [s]
        sea i = 0
        mientras (i < longitud(cola)) {
            sea v = cola[i]
            pila.agregar(v)
            para w en grafos_vecinos(g, v) {
                si (tiene_clave(dist, w) == falso) {
                    dist[w] = dist[v] + 1
                    cola.agregar(w)
                }
                si (dist[w] == dist[v] + 1) {
                    sigma[w] = sigma[w] + sigma[v]
                    pred[w].agregar(v)
                }
            }
            i = i + 1
        }
        sea delta = {}
        para v en g["orden"] { delta[v] = 0 }
        mientras (longitud(pila) > 0) {
            sea w = quitar_ultimo(pila)
            para v en pred[w] { delta[v] = delta[v] + sigma[v] / sigma[w] * (1 + delta[w]) }
            si (w != s) { cb[w] = cb[w] + delta[w] }
        }
    }
    sea n = longitud(g["orden"])
    para v en g["orden"] {
        si (g["dirigido"] == falso) { cb[v] = cb[v] / 2 }
        si (normalizar == verdadero y n > 2) {
            sea esc = (n - 1) * (n - 2)
            si (g["dirigido"] == falso) { esc = esc / 2 }
            cb[v] = cb[v] / esc
        }
    }
    retornar cb
}

/// Camino (o circuito) euleriano con Hierholzer, o nulo si no existe.
funcion grafos_euleriano(g) {
    sea usado = {}
    sea grado_s = {}
    sea grado_e = {}
    para n en g["orden"] { grado_s[n] = 0  grado_e[n] = 0 }
    para k en claves(g["aristas"]) {
        sea e = g["aristas"][k]
        grado_s[e["desde"]] = grado_s[e["desde"]] + 1
        grado_e[e["hasta"]] = grado_e[e["hasta"]] + 1
    }
    sea inicio = nulo
    si (g["dirigido"]) {
        sea mas = 0
        sea menos = 0
        para n en g["orden"] {
            sea d = grado_s[n] - grado_e[n]
            si (d == 1) { mas = mas + 1  inicio = n }
            si (d == -1) { menos = menos + 1 }
            si (d > 1 o d < -1) { retornar nulo }
        }
        si (mas > 1 o menos > 1 o mas != menos) { retornar nulo }
    } sino {
        sea impares = []
        para n en g["orden"] { si ((grado_s[n] + grado_e[n]) % 2 == 1) { impares.agregar(n) } }
        si (longitud(impares) != 0 y longitud(impares) != 2) { retornar nulo }
        si (longitud(impares) == 2) { inicio = impares[0] }
    }
    si (inicio == nulo) {
        para n en g["orden"] { si (inicio == nulo y longitud(g["ady"][n]) > 0) { inicio = n } }
    }
    si (inicio == nulo) { retornar [] }
    sea ptr = {}
    para n en g["orden"] { ptr[n] = 0 }
    sea pila = [inicio]
    sea r = []
    mientras (longitud(pila) > 0) {
        sea v = pila[longitud(pila) - 1]
        sea ady = g["ady"][v]
        mientras (ptr[v] < longitud(ady) y tiene_clave(usado, "" + ady[ptr[v]][2])) { ptr[v] = ptr[v] + 1 }
        si (ptr[v] < longitud(ady)) {
            sea e = ady[ptr[v]]
            usado["" + e[2]] = verdadero
            pila.agregar(e[0])
        } sino { r.agregar(quitar_ultimo(pila)) }
    }
    si (longitud(r) != longitud(claves(g["aristas"])) + 1) { retornar nulo }
    retornar lista_invertir(r)
}

/// Texto en formato DOT de Graphviz.
funcion grafos_dot(g, nombre) {
    sea tipo_ = "graph"
    sea flecha = " -- "
    si (g["dirigido"]) { tipo_ = "digraph"  flecha = " -> " }
    sea l = [tipo_ + " " + _gf_dot_id(nombre ?? "G") + " " + caracter(123)]
    para n en g["orden"] { l.agregar("  " + _gf_dot_id(n) + ";") }
    para e en grafos_aristas(g) {
        sea attr = ""
        si (e["peso"] != 1) { attr = " [label=\"" + e["peso"] + "\"]" }
        l.agregar("  " + _gf_dot_id(e["desde"]) + flecha + _gf_dot_id(e["hasta"]) + attr + ";")
    }
    l.agregar(caracter(125))
    retornar unir(l, "\n") + "\n"
}

funcion _gf_dot_id(t) { retornar "\"" + texto_reemplazar(texto_reemplazar("" + t, "\\", "\\\\"), "\"", "\\\"") + "\"" }
