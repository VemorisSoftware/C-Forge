// stdlib/orden.cfv — argumentos de línea de comandos con validación y ayuda
// automática. Inspirada en clap (MIT/Apache). En inglés: importar "cli".
//
//   importar "orden"
//   sea o = orden_nuevo("copiar", "Copia archivos")
//   orden_bandera(o, "verboso", "v", "Muestra detalles")
//   orden_opcion(o, "nivel", "n", "Nivel de compresión", "6")
//   orden_posicional(o, "origen", "Archivo de origen", verdadero)
//   sea a = orden_analizar(o, argumentos())     // {"verboso": falso, "nivel": "6", "origen": "x"}
//   si (a["ayuda"]) { mostrar(orden_ayuda(o)) salir(0) }

funcion orden_nuevo(nombre, descripcion) {
    retornar {"nombre": nombre, "descripcion": descripcion ?? "", "opciones": [], "posicionales": []}
}

/// Interruptor sin valor (--verboso / -v).
funcion orden_bandera(o, largo, corto, descripcion) {
    o["opciones"].agregar({"largo": largo, "corto": corto, "descripcion": descripcion ?? "", "bandera": verdadero, "defecto": falso, "requerida": falso})
    retornar o
}

/// Opción con valor (--nivel 6, --nivel=6, -n 6).
funcion orden_opcion(o, largo, corto, descripcion, defecto, requerida) {
    o["opciones"].agregar({"largo": largo, "corto": corto, "descripcion": descripcion ?? "", "bandera": falso, "defecto": defecto, "requerida": requerida == verdadero})
    retornar o
}

/// Argumento por posición.
funcion orden_posicional(o, nombre, descripcion, requerido) {
    o["posicionales"].agregar({"nombre": nombre, "descripcion": descripcion ?? "", "requerido": requerido == verdadero})
    retornar o
}

funcion _orden_buscar(o, largo, corto) {
    para op en o["opciones"] {
        si ((largo != nulo y op["largo"] == largo) o (corto != nulo y op["corto"] == corto)) { retornar op }
    }
    retornar nulo
}

/// Analiza la lista de argumentos. Devuelve un mapa con cada opción,
/// bandera y posicional, más "resto" (lo que va después de --) y "ayuda".
/// Lanza un error claro si algo no cuadra.
funcion orden_analizar(o, args) {
    sea r = {"ayuda": falso, "resto": []}
    para op en o["opciones"] { r[op["largo"]] = op["defecto"] }
    para p en o["posicionales"] { r[p["nombre"]] = nulo }
    sea sueltos = []
    sea i = 0
    sea fin_opciones = falso
    mientras (i < longitud(args)) {
        sea a = args[i]
        si (fin_opciones) { r["resto"].agregar(a) } sino {
            si (a == "--") { fin_opciones = verdadero } sino {
                si (a == "--ayuda" o a == "--help" o a == "-h") { r["ayuda"] = verdadero } sino {
                    si (texto_empieza_con(a, "--") o (texto_empieza_con(a, "-") y longitud(a) == 2)) {
                        sea nombre = subcadena(a, 2, longitud(a))
                        sea valor = nulo
                        sea op = nulo
                        si (texto_empieza_con(a, "--")) {
                            sea igual = texto_indice(nombre, "=")
                            si (igual >= 0) {
                                valor = subcadena(nombre, igual + 1, longitud(nombre))
                                nombre = subcadena(nombre, 0, igual)
                            }
                            op = _orden_buscar(o, nombre, nulo)
                        } sino { op = _orden_buscar(o, nulo, subcadena(a, 1, 2)) }
                        si (op == nulo) { lanzar o["nombre"] + ": opción desconocida " + a }
                        si (op["bandera"]) {
                            si (valor != nulo) { lanzar o["nombre"] + ": --" + op["largo"] + " no lleva valor" }
                            r[op["largo"]] = verdadero
                        } sino {
                            si (valor == nulo) {
                                si (i + 1 >= longitud(args)) { lanzar o["nombre"] + ": falta el valor de --" + op["largo"] }
                                i = i + 1
                                valor = args[i]
                            }
                            r[op["largo"]] = valor
                        }
                    } sino { sueltos.agregar(a) }
                }
            }
        }
        i = i + 1
    }
    si (r["ayuda"]) { retornar r }
    sea k = 0
    mientras (k < longitud(sueltos)) {
        si (k >= longitud(o["posicionales"])) { lanzar o["nombre"] + ": argumento de más: " + sueltos[k] }
        r[o["posicionales"][k]["nombre"]] = sueltos[k]
        k = k + 1
    }
    para p en o["posicionales"] {
        si (p["requerido"] y r[p["nombre"]] == nulo) { lanzar o["nombre"] + ": falta <" + p["nombre"] + ">" }
    }
    para op en o["opciones"] {
        si (op["requerida"] y r[op["largo"]] == nulo) { lanzar o["nombre"] + ": falta --" + op["largo"] }
    }
    retornar r
}

/// Texto de ayuda generado.
funcion orden_ayuda(o) {
    sea uso = "uso: " + o["nombre"]
    si (longitud(o["opciones"]) > 0) { uso = uso + " [opciones]" }
    para p en o["posicionales"] {
        si (p["requerido"]) { uso = uso + " <" + p["nombre"] + ">" } sino { uso = uso + " [" + p["nombre"] + "]" }
    }
    sea l = [uso]
    si (o["descripcion"] != "") { l.agregar("") l.agregar(o["descripcion"]) }
    si (longitud(o["posicionales"]) > 0) {
        l.agregar("")
        l.agregar("argumentos:")
        para p en o["posicionales"] { l.agregar("  " + p["nombre"] + texto_repetir(" ", maximo(1, 22 - longitud(p["nombre"]))) + p["descripcion"]) }
    }
    l.agregar("")
    l.agregar("opciones:")
    para op en o["opciones"] {
        sea izq = "      --" + op["largo"]
        si (op["corto"] != nulo) { izq = "  -" + op["corto"] + ", --" + op["largo"] }
        si (op["bandera"] == falso) { izq = izq + " <valor>" }
        sea der = op["descripcion"]
        si (op["bandera"] == falso y op["defecto"] != nulo) { der = der + " (por defecto: " + op["defecto"] + ")" }
        l.agregar(izq + texto_repetir(" ", maximo(1, 24 - longitud(izq))) + der)
    }
    l.agregar("  -h, --ayuda" + texto_repetir(" ", 12) + "Muestra esta ayuda")
    retornar unir(l, "\n")
}
