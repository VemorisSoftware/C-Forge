// stdlib/quaternion.cfv — rotaciones y transformaciones 3D: nombres en inglés del módulo "cuaternion".
// English names for the "cuaternion" module; both can be used together.

importar "cuaternion"

funcion _quaternion_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_quaternion_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _quaternion_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _QUATERNION_RES = {"traslacion": "translation", "rotacion": "rotation", "escala": "scale", "eje": "axis", "angulo": "angle"}

funcion vec3_add(a, b) { retornar cuaternion_sumar(a, b) }
funcion vec3_sub(a, b) { retornar cuaternion_restar(a, b) }
funcion vec3_scale(a, k) { retornar cuaternion_escalar(a, k) }
funcion vec3_dot(a, b) { retornar cuaternion_punto(a, b) }
funcion vec3_cross(a, b) { retornar cuaternion_cruz(a, b) }
funcion vec3_length(a) { retornar cuaternion_largo(a) }
funcion vec3_normalize(a) { retornar cuaternion_unitario(a) }
funcion quat_identity() { retornar cuaternion_identidad() }
funcion quat_normalize(q) { retornar cuaternion_normalizar(q) }
funcion quat_mul(a, b) { retornar cuaternion_mul(a, b) }
funcion quat_conjugate(q) { retornar cuaternion_conjugado(q) }
funcion quat_inverse(q) { retornar cuaternion_inverso(q) }
funcion quat_canonical(q) { retornar cuaternion_canonico(q) }
funcion quat_from_rotvec(v) { retornar cuaternion_desde_vector_rotacion(v) }
funcion quat_to_rotvec(q) { retornar cuaternion_a_vector_rotacion(q) }
funcion quat_rotate(q, v) { retornar cuaternion_rotar(q, v) }
funcion quaternion_slerp(a, b, t) { retornar cuaternion_slerp(a, b, t) }
funcion quat_from_two_vectors(a, b) { retornar cuaternion_entre_vectores(a, b) }
funcion quat_look_rotation(direccion, arriba) { retornar cuaternion_mirar(direccion, arriba) }
funcion quat_to_matrix(q) { retornar cuaternion_a_matriz(q) }
funcion quat_from_matrix(m) { retornar cuaternion_desde_matriz(m) }
funcion mat4_identity() { retornar cuaternion_m4_identidad() }
funcion mat4_mul(a, b) { retornar cuaternion_m4_mul(a, b) }
funcion mat4_translation(t) { retornar cuaternion_m4_traslacion(t) }
funcion mat4_scale(s) { retornar cuaternion_m4_escala(s) }
funcion mat4_rotation(q) { retornar cuaternion_m4_rotacion(q) }
funcion mat4_trs(t, q, s) { retornar cuaternion_m4_trs(t, q, s) }
funcion mat4_decompose(m) { retornar _quaternion_tr(cuaternion_m4_descomponer(m), _QUATERNION_RES) }
funcion mat4_orthographic(izq, der, abajo, arriba, cerca, lejos) { retornar cuaternion_m4_ortografica(izq, der, abajo, arriba, cerca, lejos) }
funcion mat4_look_at(ojo, objetivo, arriba) { retornar cuaternion_m4_mirar(ojo, objetivo, arriba) }
funcion mat4_inverse(m) { retornar cuaternion_m4_inversa(m) }
funcion mat4_transform_point(m, p) { retornar cuaternion_m4_punto(m, p) }
funcion mat4_transform_vector(m, v) { retornar cuaternion_m4_vector(m, v) }
funcion mat4_normal_matrix(m) { retornar cuaternion_m4_normal(m) }
funcion quat_allclose(a, b, tol) { retornar cuaternion_casi_igual(a, b, tol) }

funcion _qt_u(u) {
    si (u == "degrees" o u == "deg" o u == "grados") { retornar "grados" }
    retornar nulo
}
/// Angles in radians, or "degrees".
funcion vec3_angle(a, b, unit) { retornar cuaternion_angulo_entre(a, b, _qt_u(unit)) }
funcion quat_from_axis_angle(axis, angle, unit) { retornar cuaternion_eje_angulo(axis, angle, _qt_u(unit)) }
funcion quat_to_axis_angle(q, unit) {
    sea r = cuaternion_a_eje_angulo(q, _qt_u(unit))
    retornar {"axis": r["eje"], "angle": r["angulo"]}
}
funcion quat_angle(a, b, unit) { retornar cuaternion_angulo(a, b, _qt_u(unit)) }
funcion quat_from_euler(angles, seq, unit) { retornar cuaternion_desde_euler(angles, seq, _qt_u(unit)) }
funcion quat_to_euler(q, seq, unit) { retornar cuaternion_a_euler(q, seq, _qt_u(unit)) }
funcion mat4_perspective(fov, aspect, near, far, unit) { retornar cuaternion_m4_perspectiva(fov, aspect, near, far, _qt_u(unit)) }
