// stdlib/bio.cfv — bioinformática: nombres en inglés del módulo "genoma".
// English names for the "genoma" module; both can be used together.


importar "genoma"

funcion _bio_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_bio_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _bio_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _BIO_RES = {"descripcion": "description", "secuencia": "sequence", "calidad": "quality", "hebra": "strand", "inicio": "start", "fin": "end", "proteina": "protein", "puntaje": "score", "identidad": "identity"}
sea _BIO_OPT = {"match": "coincide", "mismatch": "distinto", "gap": "hueco"}

funcion bio_read_fasta(texto) { retornar _bio_tr(genoma_fasta(texto), _BIO_RES) }
funcion bio_write_fasta(registros, ancho) { retornar genoma_escribir_fasta(registros, ancho) }
funcion bio_read_fastq(texto) { retornar _bio_tr(genoma_fastq(texto), _BIO_RES) }
funcion bio_reverse_complement(s) { retornar genoma_complemento_reverso(s) }
funcion bio_gc_content(s) { retornar genoma_gc(s) }
funcion bio_count(s) { retornar genoma_conteo(s) }
funcion bio_translate(s, hasta_parada) { retornar genoma_traducir(s, hasta_parada) }
funcion bio_frames(s) { retornar genoma_marcos(s) }
funcion bio_orfs(s, min_aa) { retornar _bio_tr(genoma_orfs(s, min_aa), _BIO_RES) }
funcion bio_kmers(s, k) { retornar genoma_kmeros(s, k) }
funcion bio_find_motif(s, motivo) { retornar genoma_buscar(s, motivo) }
funcion bio_align(a, b, opciones) { retornar _bio_tr(genoma_alinear(a, b, _bio_opt(opciones)), _BIO_RES) }
funcion bio_protein_weight(p) { retornar genoma_peso_proteina(p) }

funcion _bio_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_BIO_OPT[k] ?? k] = o[k] }
    retornar r
}

/// English records ({"id", "description", "sequence"}) → FASTA.
funcion bio_write_fasta_en(records, width) {
    sea r = []
    para x en records { r.agregar({"id": x["id"], "descripcion": x["description"] ?? "", "secuencia": x["sequence"]}) }
    retornar genoma_escribir_fasta(r, width)
}
