// stdlib/quant.cfv — finanzas cuantitativas: nombres en inglés del módulo "derivados".
// English names for the "derivados" module; both can be used together.

importar "derivados"

funcion quant_norm_pdf(x) { retornar derivados_normal_pdf(x) }
funcion quant_norm_cdf(x) { retornar derivados_normal_cdf(x) }
/// {"price", "delta", "gamma", "vega", "theta", "rho", "d1", "d2"}
funcion quant_black_scholes(tipo_o, S, K, T, r, sigma, q) {
    sea x = derivados_black_scholes(tipo_o, S, K, T, r, sigma, q)
    x["price"] = x["precio"]
    retornar x
}
funcion quant_implied_vol(tipo_o, precio, S, K, T, r, q) { retornar derivados_vol_implicita(tipo_o, precio, S, K, T, r, q) }
funcion quant_binomial(tipo_o, S, K, T, r, sigma, pasos, americana) { retornar derivados_binomial(tipo_o, S, K, T, r, sigma, pasos, americana) }
funcion quant_npv(tasa, flujos) { retornar derivados_van(tasa, flujos) }
funcion quant_irr(flujos) { retornar derivados_tir(flujos) }
funcion quant_bond_price(cupon, rendimiento, anios, frecuencia, nominal) { retornar derivados_bono_precio(cupon, rendimiento, anios, frecuencia, nominal) }
funcion quant_bond_yield(precio, cupon, anios, frecuencia, nominal) { retornar derivados_bono_rendimiento(precio, cupon, anios, frecuencia, nominal) }
/// {"macaulay", "modified", "convexity", "price"}
funcion quant_bond_duration(cupon, rendimiento, anios, frecuencia, nominal) {
    sea r = derivados_bono_duracion(cupon, rendimiento, anios, frecuencia, nominal)
    retornar {"macaulay": r["macaulay"], "modified": r["modificada"], "convexity": r["convexidad"], "price": r["precio"]}
}
funcion quant_payment(monto, tasa_anual, meses) { retornar derivados_cuota(monto, tasa_anual, meses) }
funcion quant_amortization(monto, tasa_anual, meses) { retornar derivados_amortizacion(monto, tasa_anual, meses) }
funcion quant_future_value(inicial, tasa, periodos, aporte) { retornar derivados_valor_futuro(inicial, tasa, periodos, aporte) }
