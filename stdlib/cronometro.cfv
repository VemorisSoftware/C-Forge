// stdlib/cronometro.cfv — micro-benchmarks con estadística: calienta,
// elige solo cuántas vueltas medir, repite muestras y reporta media,
// mediana, desviación, intervalo de confianza y operaciones por segundo;
// también compara dos funciones. Inspirada en Criterion (MIT/Apache). En
// inglés: importar "bench".
//
//   importar "cronometro"
//   sea r = cronometro_medir("ordenar 1000", funcion() { ordenar(datos) })
//   mostrar(cronometro_texto(r))
//   cronometro_comparar(funcion() { a() }, funcion() { b() })   // {"rapida", "veces"}

funcion _cr_op(o, k, d) {
    si (o != nulo) { si (tiene_clave(o, k)) { retornar o[k] } }
    retornar d
}

funcion _cr_ahora_us() { retornar cfv_fecha_ahora_ms() * 1000 }

/// opciones: muestras (20), objetivo_ms por muestra (50), calentamiento_ms (100).
funcion cronometro_medir(nombre, f, opciones) {
    sea muestras = _cr_op(opciones, "muestras", 20)
    sea objetivo = _cr_op(opciones, "objetivo_ms", 50)
    sea calentar = _cr_op(opciones, "calentamiento_ms", 100)
    // Calentamiento + estimación de vueltas por muestra.
    sea vueltas = 0
    sea t0 = cfv_fecha_ahora_ms()
    mientras (cfv_fecha_ahora_ms() - t0 < calentar o vueltas < 1) { f()  vueltas = vueltas + 1 }
    sea por_vuelta = maximo(0.0001, (cfv_fecha_ahora_ms() - t0) / vueltas)
    sea n = maximo(1, piso(objetivo / por_vuelta))
    sea tiempos = []
    sea k = 0
    mientras (k < muestras) {
        sea ini = cfv_fecha_ahora_ms()
        sea i = 0
        mientras (i < n) { f()  i = i + 1 }
        tiempos.agregar((cfv_fecha_ahora_ms() - ini) / n)
        k = k + 1
    }
    retornar cronometro_estadistica(nombre, tiempos, n)
}

/// Estadística de una lista de tiempos (ms por operación).
funcion cronometro_estadistica(nombre, tiempos, vueltas) {
    sea o = ordenar(tiempos, funcion(a, b) { retornar a - b })
    sea n = longitud(o)
    sea s = 0
    para t en o { s = s + t }
    sea media = s / n
    sea v = 0
    para t en o { v = v + (t - media) * (t - media) }
    sea d = 0
    si (n > 1) { d = raiz(v / (n - 1)) }
    sea mediana = o[cociente(n, 2)]
    si (n % 2 == 0) { mediana = (o[n / 2 - 1] + o[n / 2]) / 2 }
    // Atípicos: fuera de 1.5 × rango intercuartil.
    sea q1 = o[piso(n / 4)]
    sea q3 = o[minimo(n - 1, piso(3 * n / 4))]
    sea iqr = q3 - q1
    sea atipicos = 0
    para t en o { si (t < q1 - 1.5 * iqr o t > q3 + 1.5 * iqr) { atipicos = atipicos + 1 } }
    sea margen = 1.96 * d / raiz(n)
    sea ops = 0
    si (media > 0) { ops = 1000 / media }
    retornar {"nombre": nombre, "muestras": n, "vueltas": vueltas ?? 1, "media_ms": media, "mediana_ms": mediana, "desviacion_ms": d, "min_ms": o[0], "max_ms": o[n - 1], "ic95_ms": [media - margen, media + margen], "ops_por_s": ops, "atipicos": atipicos}
}

funcion _cr_tiempo(ms) {
    si (ms < 0.001) { retornar redondear(ms * 1000000, 1) + " ns" }
    si (ms < 1) { retornar redondear(ms * 1000, 2) + " µs" }
    si (ms < 1000) { retornar redondear(ms, 2) + " ms" }
    retornar redondear(ms / 1000, 2) + " s"
}

funcion cronometro_texto(r) {
    sea ops = r["ops_por_s"]
    sea t_ops = "" + redondear(ops, 0)
    si (ops >= 1000000) { t_ops = redondear(ops / 1000000, 2) + " M" }
    si (ops >= 1000 y ops < 1000000) { t_ops = redondear(ops / 1000, 2) + " k" }
    retornar r["nombre"] + ": " + _cr_tiempo(r["media_ms"]) + " ± " + _cr_tiempo(r["desviacion_ms"]) + " (mediana " + _cr_tiempo(r["mediana_ms"]) + ", " + t_ops + " op/s, " + r["muestras"] + " muestras × " + r["vueltas"] + ", " + r["atipicos"] + " atípicos)"
}

/// Mide ambas y dice cuál es más rápida y cuántas veces.
funcion cronometro_comparar(a, b, opciones) {
    sea ra = cronometro_medir("a", a, opciones)
    sea rb = cronometro_medir("b", b, opciones)
    sea rapida = "a"
    sea veces = rb["mediana_ms"] / maximo(0.0000001, ra["mediana_ms"])
    si (rb["mediana_ms"] < ra["mediana_ms"]) { rapida = "b"  veces = ra["mediana_ms"] / maximo(0.0000001, rb["mediana_ms"]) }
    // Significativa si los intervalos de confianza no se tocan.
    sea significativa = ra["ic95_ms"][1] < rb["ic95_ms"][0] o rb["ic95_ms"][1] < ra["ic95_ms"][0]
    retornar {"rapida": rapida, "veces": veces, "significativa": significativa, "a": ra, "b": rb}
}
