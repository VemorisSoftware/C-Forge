// stdlib/crowd.cfv — simulación de multitudes: nombres en inglés del módulo "multitud".
// English names for the "multitud" module; both can be used together.

importar "multitud"

funcion crowd_new(opciones) { retornar multitud_nueva(opciones) }
/// options: target [x, y], max_speed, max_force, radius, group, vx, vy.
funcion crowd_add(m, x, y, opciones) {
    sea o = {}
    sea en = {"target": "destino", "max_speed": "velocidad_max", "max_force": "fuerza_max", "radius": "radio", "group": "grupo"}
    si (opciones != nulo) { para k en claves(opciones) { si (tiene_clave(en, k)) { o[en[k]] = opciones[k] } sino { o[k] = opciones[k] } } }
    retornar multitud_agregar(m, x, y, o)
}
funcion crowd_obstacle(m, x, y, radio) { retornar multitud_obstaculo(m, x, y, radio) }
funcion crowd_target(a, x, y) { retornar multitud_destino(a, x, y) }
funcion crowd_agents(m) { retornar multitud_agentes(m) }
funcion crowd_step(m, dt) { retornar multitud_paso(m, dt) }
funcion crowd_arrived(m) { retornar multitud_llegaron(m) }
funcion crowd_min_distance(m) { retornar multitud_distancia_minima(m) }
