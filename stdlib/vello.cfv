// stdlib/vello.cfv — Gráficos vectoriales (estilo Vello): nombres en inglés del módulo "trazo".
// English names for the "trazo" module; both can be used together.


importar "trazo"

funcion _vello_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_vello_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _vello_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _VELLO_OPT = {"width": "grosor", "join": "union", "cap": "extremo", "miter_limit": "inglete", "dash": "guiones", "dash_offset": "desfase", "transform": "transformacion", "brush_transform": "transformacion_pincel", "fill_rule": "regla", "blend": "mezcla", "alpha": "alfa", "background": "fondo", "tolerance": "tolerancia"}

funcion vello_path() { retornar trazo_camino() }
funcion vello_move_to(c, x, y) { retornar trazo_mover(c, x, y) }
funcion vello_line_to(c, x, y) { retornar trazo_linea(c, x, y) }
funcion vello_quad_to(c, x1, y1, x, y) { retornar trazo_cuadratica(c, x1, y1, x, y) }
funcion vello_cubic_to(c, x1, y1, x2, y2, x, y) { retornar trazo_curva(c, x1, y1, x2, y2, x, y) }
funcion vello_close(c) { retornar trazo_cerrar(c) }
funcion vello_rect(c, x, y, w, h) { retornar trazo_rectangulo(c, x, y, w, h) }
funcion vello_ellipse(c, cx, cy, rx, ry) { retornar trazo_elipse(c, cx, cy, rx, ry) }
funcion vello_circle(c, cx, cy, r) { retornar trazo_circulo(c, cx, cy, r) }
funcion vello_rounded_rect(c, x, y, w, h, r) { retornar trazo_rectangulo_redondeado(c, x, y, w, h, r) }
funcion vello_path_from_svg(d) { retornar trazo_camino_svg(d) }
funcion vello_identity() { retornar trazo_identidad() }
funcion vello_translate(x, y) { retornar trazo_traslacion(x, y) }
funcion vello_scale(sx, sy) { retornar trazo_escala(sx, sy) }
funcion vello_rotate(a) { retornar trazo_rotacion(a) }
funcion vello_compose(m1, m2) { retornar trazo_componer(m1, m2) }
funcion vello_color(c) { retornar trazo_color(c) }
funcion vello_linear_gradient(x0, y0, x1, y1, paradas, extension) { retornar trazo_lineal(x0, y0, x1, y1, paradas, extension) }
funcion vello_radial_gradient(x0, y0, r0, x1, y1, r1, paradas, extension) { retornar trazo_radial(x0, y0, r0, x1, y1, r1, paradas, extension) }
funcion vello_sweep_gradient(cx, cy, angulo0, angulo1, paradas, extension) { retornar trazo_conico(cx, cy, angulo0, angulo1, paradas, extension) }
funcion vello_scene() { retornar trazo_escena() }
funcion vello_fill(e, camino, pincel, opciones) { retornar trazo_rellenar(e, camino, pincel, _vello_opt(opciones)) }
funcion vello_stroke(e, camino, pincel, opciones) { retornar trazo_trazar(e, camino, pincel, _vello_opt(opciones)) }
funcion vello_push_layer(e, recorte, opciones) { retornar trazo_abrir_capa(e, recorte, _vello_opt(opciones)) }
funcion vello_pop_layer(e) { retornar trazo_cerrar_capa(e) }
funcion vello_append(e, otra, m) { retornar trazo_anexar(e, otra, m) }
funcion vello_scene_len(e) { retornar trazo_tamano(e) }
funcion vello_render(e, ancho, alto, opciones) { retornar trazo_renderizar(e, ancho, alto, _vello_opt(opciones)) }
funcion vello_coverage(camino, ancho, alto, opciones) { retornar trazo_cobertura(camino, ancho, alto, _vello_opt(opciones)) }

funcion _vello_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_VELLO_OPT[k] ?? k] = o[k] }
    retornar r
}
