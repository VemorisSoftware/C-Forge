// stdlib/zeroconf.cfv — descubrimiento mDNS/DNS-SD: nombres en inglés del módulo "vecinos".
// English names for the "vecinos" module; both can be used together.

importar "vecinos"

funcion _zeroconf_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_zeroconf_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _zeroconf_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _ZEROCONF_RES = {"nombre": "name", "instancia": "instance", "tipo": "type", "equipo": "host", "puerto": "port", "direcciones": "addresses"}

funcion dns_txt(datos) { retornar vecinos_txt(datos) }
funcion dns_encode(m) { retornar vecinos_codificar(m) }
funcion dns_decode(t) { retornar vecinos_decodificar(t) }
funcion zeroconf_service(s) { retornar vecinos_servicio(s) }
funcion zeroconf_announce(servicio, ttl_cero) { retornar vecinos_anuncio(servicio, ttl_cero) }
funcion zeroconf_respond(servicios, paquete) { retornar vecinos_responder(servicios, paquete) }
funcion zeroconf_query(nombre, tipo_r, id) { retornar vecinos_pregunta(nombre, tipo_r, id) }
funcion zeroconf_collect(mensajes, tipo_s) { retornar _zeroconf_tr(vecinos_reunir(mensajes, tipo_s), _ZEROCONF_RES) }
funcion zeroconf_browse(tipo_s, ms, destino, puerto) { retornar _zeroconf_tr(vecinos_buscar(tipo_s, ms, destino, puerto), _ZEROCONF_RES) }
funcion zeroconf_serve(servicios, puerto, ms) { retornar vecinos_atender(servicios, puerto, ms) }
