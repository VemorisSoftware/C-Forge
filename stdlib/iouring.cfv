// stdlib/iouring.cfv — E/S asíncrona con io_uring: nombres en inglés del módulo "anillo".
// English names for the "anillo" module; both can be used together.

importar "anillo"

funcion _iouring_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_iouring_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _iouring_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _IOURING_RES = {"dato": "user_data", "op": "op", "res": "res", "datos": "data", "fd": "fd", "puerto": "port"}

funcion uring_available() { retornar anillo_disponible() }
funcion uring_new(entradas) { retornar anillo_nuevo(entradas) }
funcion uring_listen(host, puerto) { retornar anillo_escuchar(host, puerto) }
funcion uring_socket() { retornar anillo_socket() }
funcion uring_close_now(fd) { retornar anillo_cerrar_ya(fd) }
funcion uring_link_begin(r) { retornar anillo_cadena(r) }
funcion uring_link_end(r) { retornar anillo_fin_cadena(r) }
funcion uring_nop(r, dato) { retornar anillo_nop(r, dato) }
funcion uring_read(r, fd, n, desplaz, dato) { retornar anillo_leer(r, fd, n, desplaz, dato) }
funcion uring_write(r, fd, datos, desplaz, dato) { retornar anillo_escribir(r, fd, datos, desplaz, dato) }
funcion uring_fsync(r, fd, dato) { retornar anillo_fsync(r, fd, dato) }
funcion uring_open(r, ruta, banderas, modo, dato) { retornar anillo_abrir(r, ruta, banderas, modo, dato) }
funcion uring_close(r, fd, dato) { retornar anillo_cerrar_fd(r, fd, dato) }
funcion uring_poll(r, fd, eventos, dato) { retornar anillo_poll(r, fd, eventos, dato) }
funcion uring_timeout(r, ms, dato) { retornar anillo_temporizador(r, ms, dato) }
funcion uring_accept(r, fd, dato) { retornar anillo_aceptar(r, fd, dato) }
funcion uring_connect(r, fd, host, puerto, dato) { retornar anillo_conectar(r, fd, host, puerto, dato) }
funcion uring_recv(r, fd, n, dato) { retornar anillo_recibir(r, fd, n, dato) }
funcion uring_send(r, fd, datos, dato) { retornar anillo_enviar_datos(r, fd, datos, dato) }
funcion uring_cancel(r, dato_buscado, dato) { retornar anillo_cancelar(r, dato_buscado, dato) }
funcion uring_submit(r) { retornar anillo_enviar(r) }
funcion uring_wait(r, minimo) { retornar _iouring_tr(anillo_completar(r, minimo), _IOURING_RES) }
funcion uring_in_flight(r) { retornar anillo_en_vuelo(r) }
funcion uring_destroy(r) { retornar anillo_cerrar(r) }
funcion uring_read_file(ruta, bloque) { retornar anillo_leer_archivo(ruta, bloque) }
funcion uring_write_file(ruta, datos) { retornar anillo_escribir_archivo(ruta, datos) }
