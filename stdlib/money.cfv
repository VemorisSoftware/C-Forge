// stdlib/money.cfv — Decimales exactos para dinero (alias en inglés de "dinero"); redondeo "even" (bancario) o "up".
// English names for the "dinero" module; both can be used together.

importar "dinero"

funcion money(v) { retornar dinero(v) }
funcion money_add(a, b) { retornar dinero_sumar(a, b) }
funcion money_subtract(a, b) { retornar dinero_restar(a, b) }
funcion money_multiply(a, b) { retornar dinero_por(a, b) }
funcion money_round(a, decimales, modo) { retornar dinero_redondear(a, decimales, modo) }
funcion money_divide(a, b, decimales) { retornar dinero_dividir(a, b, decimales) }
funcion money_compare(a, b) { retornar dinero_comparar(a, b) }
funcion money_equals(a, b) { retornar dinero_igual(a, b) }
funcion money_allocate(a, n, decimales) { retornar dinero_repartir(a, n, decimales) }
funcion money_text(a) { retornar dinero_texto(a) }
funcion money_format(a, decimales, miles, coma) { retornar dinero_formato(a, decimales, miles, coma) }
