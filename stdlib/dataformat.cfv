// stdlib/dataformat.cfv — datos estructurados: nombres en inglés del módulo "formatos".
// English names for the "formatos" module; both can be used together.


importar "formatos"

funcion _dataformat_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_dataformat_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _dataformat_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _DATAFORMAT_RES = {"valido": "valid", "errores": "errors", "ruta": "path", "mensaje": "message"}
sea _DATAFORMAT_OPT = {"pretty": "bonito", "root": "raiz", "columns": "columnas", "formats": "formatos", "indent": "sangria"}

funcion data_equal(a, b) { retornar formatos_iguales(a, b) }
funcion data_parse(texto, formato) { retornar formatos_leer(texto, formato) }
funcion data_stringify(v, formato, opciones) { retornar formatos_escribir(v, formato, _dataformat_opt(opciones)) }
funcion data_convert(texto, de, a, opciones) { retornar formatos_convertir(texto, de, a, _dataformat_opt(opciones)) }
funcion json_pointer(doc, puntero) { retornar formatos_puntero(doc, puntero) }
funcion json_pointer_exists(doc, puntero) { retornar formatos_puntero_existe(doc, puntero) }
funcion json_patch(doc, parche) { retornar formatos_parche(doc, parche) }
funcion json_diff(a, b) { retornar formatos_diferencias(a, b) }
funcion json_merge_patch(doc, parche) { retornar formatos_mezcla(doc, parche) }
funcion json_merge_diff(a, b) { retornar formatos_mezcla_diferencias(a, b) }
funcion jsonpath(doc, consulta) { retornar formatos_jsonpath(doc, consulta) }
funcion jsonpath_paths(doc, consulta) { retornar formatos_jsonpath_rutas(doc, consulta) }
funcion json_schema_validate(esquema, doc, opciones) { retornar _dataformat_tr(formatos_validar(esquema, doc, _dataformat_opt(opciones)), _DATAFORMAT_RES) }

funcion _dataformat_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_DATAFORMAT_OPT[k] ?? k] = o[k] }
    retornar r
}
