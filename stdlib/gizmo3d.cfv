// stdlib/gizmo3d.cfv — gizmos 3D de editor: nombres en inglés del módulo "manipulador".
// English names for the "manipulador" module; both can be used together.

importar "manipulador"

funcion _gizmo3d_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_gizmo3d_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _gizmo3d_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _GIZMO3D_RES = {"traslacion": "translation", "rotacion": "rotation", "escala": "scale", "origen": "origin", "dir": "dir", "parte": "part", "modo": "mode", "tipo": "kind", "puntos": "points", "radio": "radius", "color": "color", "activa": "active", "matriz": "matrix", "activo": "active", "delta": "delta", "valor": "value"}

funcion gizmo_identity() { retornar manipulador_identidad() }
funcion gizmo_mul(a, b) { retornar manipulador_multiplicar(a, b) }
funcion gizmo_inverse(m) { retornar manipulador_inversa(m) }
funcion gizmo_translation(x, y, z) { retornar manipulador_traslacion(x, y, z) }
funcion gizmo_rotation(eje, grados) { retornar manipulador_rotacion(eje, grados) }
funcion gizmo_scaling(x, y, z) { retornar manipulador_escala(x, y, z) }
funcion gizmo_look_at(ojo, centro, arriba) { retornar manipulador_mirar(ojo, centro, arriba) }
funcion gizmo_perspective(fov, aspecto, cerca, lejos) { retornar manipulador_perspectiva(fov, aspecto, cerca, lejos) }
funcion gizmo_ortho(izq, der, abajo, arriba, cerca, lejos) { retornar manipulador_ortografica(izq, der, abajo, arriba, cerca, lejos) }
funcion gizmo_decompose(m) { retornar _gizmo3d_tr(manipulador_descomponer(m), _GIZMO3D_RES) }
funcion gizmo_compose(traslacion, rotacion, escala) { retornar manipulador_componer(traslacion, rotacion, escala) }
funcion gizmo_set_camera(g, vista, proyeccion, ancho, alto, x0, y0) { retornar manipulador_camara(g, vista, proyeccion, ancho, alto, x0, y0) }
funcion gizmo_project(g, p) { retornar manipulador_a_pantalla(g, p) }
funcion gizmo_ray(g, x, y) { retornar _gizmo3d_tr(manipulador_rayo(g, x, y), _GIZMO3D_RES) }
funcion gizmo_draw_list(g, m) { retornar _gizmo3d_tr(manipulador_dibujar(g, m), _GIZMO3D_RES) }
funcion gizmo_is_using(g) { retornar manipulador_activo(g) }
funcion gizmo_cancel(g) { retornar manipulador_cancelar(g) }
funcion gizmo_render_vector(g, m, lienzo) { retornar manipulador_dibujar_vector(g, m, lienzo) }

sea _GZ_MODOS = {"translate": "mover", "rotate": "rotar", "scale": "escalar", "universal": "todo", "all": "todo"}
sea _GZ_MODOS_EN = {"mover": "translate", "rotar": "rotate", "escalar": "scale", "todo": "universal"}
sea _GZ_ESPACIOS = {"world": "mundo", "local": "local"}
sea _GZ_AJUSTE = {"translate": "mover", "rotate": "rotar", "scale": "escalar"}
funcion _gz_ajuste(a) {
    si (a == nulo) { retornar nulo }
    sea r = {}
    para k en claves(a) { r[_GZ_AJUSTE[k] ?? k] = a[k] }
    retornar r
}
// Gizmo nuevo. options: "mode" (translate, rotate, scale, universal),
// "space" (world, local), "size" (pixels), "snap" ({"translate", "rotate",
// "scale"}), "tolerance" (pixels).
funcion gizmo_new(options) {
    sea o = options ?? {}
    sea op = {}
    si (tiene_clave(o, "mode")) { op["modo"] = _GZ_MODOS[o["mode"]] ?? o["mode"] }
    si (tiene_clave(o, "space")) { op["espacio"] = _GZ_ESPACIOS[o["space"]] ?? o["space"] }
    si (tiene_clave(o, "size")) { op["tam"] = o["size"] }
    si (tiene_clave(o, "snap")) { op["ajuste"] = _gz_ajuste(o["snap"]) }
    si (tiene_clave(o, "tolerance")) { op["tolerancia"] = o["tolerance"] }
    retornar manipulador_nuevo(op)
}
funcion gizmo_set_mode(g, mode) { manipulador_modo(g, _GZ_MODOS[mode] ?? mode) }
funcion gizmo_set_space(g, space) { manipulador_espacio(g, _GZ_ESPACIOS[space] ?? space) }
funcion gizmo_set_snap(g, snap) { manipulador_ajuste(g, _gz_ajuste(snap)) }
funcion _gz_parte(r) {
    si (r == nulo) { retornar nulo }
    sea x = {}
    para k en claves(r) { x[k] = r[k] }
    si (tiene_clave(x, "modo") y x["modo"] != nulo) { x["modo"] = _GZ_MODOS_EN[x["modo"]] ?? x["modo"] }
    retornar _gizmo3d_tr(x, _GIZMO3D_RES)
}
// Part under the mouse: {"part", "mode"} or nulo.
funcion gizmo_hover(g, m, x, y) { retornar _gz_parte(manipulador_encima(g, m, x, y)) }
// Feed the mouse: {"matrix", "active", "part", "mode", "delta", "value"}.
funcion gizmo_mouse(g, m, x, y, down) { retornar _gz_parte(manipulador_raton(g, m, x, y, down)) }
