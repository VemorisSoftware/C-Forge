// stdlib/pipeline.cfv — tuberías de red al estilo Netty: nombres en inglés del módulo "torrente".
// English names for the "torrente" module; both can be used together.

importar "torrente"

funcion _pipeline_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_pipeline_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _pipeline_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _PIPELINE_RES = {"entrada": "inbound", "salida": "outbound", "eventos": "events", "cerrado": "closed"}

funcion pipe_add_last(canal, nombre, h) { retornar torrente_agregar(canal, nombre, h) }
funcion pipe_add_first(canal, nombre, h) { retornar torrente_agregar_primero(canal, nombre, h) }
funcion pipe_remove(canal, nombre) { retornar torrente_quitar(canal, nombre) }
funcion pipe_names(canal) { retornar torrente_nombres(canal) }
funcion pipe_fire_read(ctx, msg) { retornar torrente_pasar(ctx, msg) }
funcion pipe_fire_event(ctx, nombre) { retornar torrente_pasar_evento(ctx, nombre) }
funcion pipe_fire_error(ctx, e) { retornar torrente_pasar_error(ctx, e) }
funcion pipe_fire_user_event(ctx, ev) { retornar torrente_pasar_usuario(ctx, ev) }
funcion pipe_write(ctx, msg) { retornar torrente_escribir(ctx, msg) }
funcion pipe_channel_write(canal, msg) { retornar torrente_escribir_canal(canal, msg) }
funcion pipe_close(ctx) { retornar torrente_cerrar(ctx) }
funcion pipe_channel_close(canal) { retornar torrente_cerrar_canal(canal) }
funcion pipe_attr(canal, clave, valor) { retornar torrente_atributo(canal, clave, valor) }
funcion pipe_line_decoder(maximo) { retornar torrente_lineas(maximo) }
funcion pipe_length_field_decoder(maximo, desplaz, bytes_largo, ajuste, quitar, orden) { retornar torrente_campo_largo(maximo, desplaz, bytes_largo, ajuste, quitar, orden) }
funcion pipe_length_prepender(bytes_largo) { retornar torrente_prefijo_largo(bytes_largo) }
funcion pipe_delimiter_decoder(delim, maximo) { retornar torrente_delimitador(delim, maximo) }
funcion pipe_fixed_length_decoder(n) { retornar torrente_largo_fijo(n) }
funcion pipe_json_codec(linea) { retornar torrente_json(linea) }
funcion pipe_idle_state(bucle, lectura_ms, escritura_ms) { retornar torrente_inactividad(bucle, lectura_ms, escritura_ms) }
funcion pipe_server(bucle, host, puerto, inicializador) { retornar torrente_servidor(bucle, host, puerto, inicializador) }
funcion pipe_client(bucle, host, puerto, inicializador, listo) { retornar torrente_cliente(bucle, host, puerto, inicializador, listo) }
funcion pipe_embedded(manejadores) { retornar torrente_embebido(manejadores) }
funcion pipe_embedded_write_inbound(canal, datos) { retornar torrente_embebido_entrar(canal, datos) }
funcion pipe_embedded_write_outbound(canal, msg) { retornar torrente_embebido_salir(canal, msg) }
funcion pipe_embedded_read(canal) { retornar _pipeline_tr(torrente_embebido_leer(canal), _PIPELINE_RES) }
funcion pipe_embedded_finish(canal) { retornar torrente_embebido_fin(canal) }

// Manejadores con nombres de evento en inglés: active, read, read_complete,
// inactive, error, write, close, user_event.
sea _PIPELINE_EV = {"active": "activo", "read": "leer", "read_complete": "leido", "inactive": "inactivo", "error": "error", "write": "escribir", "close": "cerrar", "user_event": "evento"}
funcion pipe_handler(h) {
    sea r = {}
    para k en claves(h) { r[_PIPELINE_EV[k] ?? k] = h[k] }
    retornar r
}
