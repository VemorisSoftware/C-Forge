// stdlib/hdwallet.cfv — BIP-39 y BIP-32: nombres en inglés del módulo "semilla".
// English names for the "semilla" module; both can be used together.

importar "semilla"

funcion _hdwallet_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_hdwallet_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _hdwallet_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _HDWALLET_RES = {"programa": "program"}

funcion bip39_from_entropy(entropia, idioma) { retornar semilla_desde_entropia(entropia, idioma) }
funcion bip39_generate(palabras, idioma) { retornar semilla_nueva(palabras, idioma) }
funcion bip39_to_entropy(frase, idioma) { retornar semilla_a_entropia(frase, idioma) }
funcion bip39_is_valid(frase, idioma) { retornar semilla_valida(frase, idioma) }
funcion pbkdf2_sha512(clave, sal, iteraciones, largo) { retornar semilla_pbkdf2_sha512(clave, sal, iteraciones, largo) }
funcion bip39_to_seed(frase, contrasena) { retornar semilla_a_semilla(frase, contrasena) }
funcion ripemd160(datos) { retornar semilla_ripemd160(datos) }
funcion hash160(x) { retornar semilla_hash160(x) }
funcion base58_encode(b) { retornar semilla_base58(b) }
funcion base58_decode(s) { retornar semilla_de_base58(s) }
funcion base58check_encode(b) { retornar semilla_base58check(b) }
funcion base58check_decode(s) { retornar semilla_de_base58check(s) }
funcion segwit_encode(hrp, version, programa) { retornar semilla_segwit(hrp, version, programa) }
funcion segwit_decode(dir) { retornar _hdwallet_tr(semilla_de_segwit(dir), _HDWALLET_RES) }
funcion hd_master(semilla) { retornar semilla_maestra(semilla) }
funcion hd_child(nodo, i) { retornar semilla_hija(nodo, i) }
funcion hd_derive(nodo, ruta) { retornar semilla_derivar(nodo, ruta) }
funcion hd_neuter(nodo) { retornar semilla_neutra(nodo) }
funcion hd_serialize(nodo, publica, red) { retornar semilla_extendida(nodo, publica, red) }
funcion hd_parse(texto) { retornar semilla_de_extendida(texto) }
funcion hd_fingerprint(nodo) { retornar semilla_huella(nodo) }
funcion hd_wif(nodo, red) { retornar semilla_wif(nodo, red) }
funcion hd_address(nodo, tipo_, red) { retornar semilla_direccion(nodo, tipo_, red) }

funcion hd_private_key(node) { retornar node["privada"] }
funcion hd_public_key(node) { retornar node["publica"] }
funcion hd_chain_code(node) { retornar node["cadena"] }
funcion hd_depth(node) { retornar node["profundidad"] }
