// stdlib/vitest.cfv — pruebas con mocks y snapshots: nombres en inglés del módulo "ensayo".
// English names for the "ensayo" module; both can be used together.


importar "ensayo"

funcion _vitest_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_vitest_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _vitest_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _VITEST_RES = {"pasaron": "passed", "fallaron": "failed", "saltadas": "skipped", "pendientes": "todo", "nombre": "name", "error": "error"}
sea _VITEST_OPT = {"silent": "silencioso", "throw": "lanzar"}

funcion describe(nombre, f) { retornar ensayo_describir(nombre, f) }
funcion describe_skip(nombre, f) { retornar ensayo_describir_saltar(nombre, f) }
funcion describe_only(nombre, f) { retornar ensayo_describir_solo(nombre, f) }
funcion it(nombre, f) { retornar ensayo_prueba(nombre, f) }
funcion it_skip(nombre, f) { retornar ensayo_saltar(nombre, f) }
funcion it_only(nombre, f) { retornar ensayo_solo(nombre, f) }
funcion it_todo(nombre) { retornar ensayo_pendiente(nombre) }
funcion it_each(casos, plantilla, f) { retornar ensayo_cada(casos, plantilla, f) }
funcion before_all(f) { retornar ensayo_antes_de_todo(f) }
funcion after_all(f) { retornar ensayo_despues_de_todo(f) }
funcion before_each(f) { retornar ensayo_antes_de_cada(f) }
funcion after_each(f) { retornar ensayo_despues_de_cada(f) }
funcion run_tests(opciones) { retornar _vitest_tr(ensayo_correr(_vitest_opt(opciones)), _VITEST_RES) }
funcion diff_values(esperado, recibido) { retornar ensayo_diferencia(esperado, recibido) }
funcion expect_equal(recibido, esperado, mensaje) { retornar ensayo_igual(recibido, esperado, mensaje) }
funcion expect_not_equal(recibido, no_esperado, mensaje) { retornar ensayo_distinto(recibido, no_esperado, mensaje) }
funcion expect_true(v, mensaje) { retornar ensayo_verdadero(v, mensaje) }
funcion expect_false(v, mensaje) { retornar ensayo_falso(v, mensaje) }
funcion expect_null(v, mensaje) { retornar ensayo_nulo(v, mensaje) }
funcion expect_close_to(recibido, esperado, decimales) { retornar ensayo_cerca(recibido, esperado, decimales) }
funcion expect_contains(contenedor, elemento) { retornar ensayo_contiene(contenedor, elemento) }
funcion expect_match_object(recibido, parcial) { retornar ensayo_coincide(recibido, parcial) }
funcion expect_throws(f, patron) { retornar ensayo_lanza(f, patron) }
funcion expect_length(v, n) { retornar ensayo_largo(v, n) }
funcion expect_greater(a, b) { retornar ensayo_mayor(a, b) }
funcion expect_less(a, b) { retornar ensayo_menor(a, b) }
funcion expect_type(v, t) { retornar ensayo_tipo(v, t) }
funcion mock_fn(aridad, implementacion) { retornar ensayo_mock(aridad, implementacion) }
funcion mock_return_value(m, v) { retornar ensayo_mock_devolver(m, v) }
funcion mock_return_value_once(m, v) { retornar ensayo_mock_devolver_una_vez(m, v) }
funcion mock_throw_once(m, error) { retornar ensayo_mock_lanzar_una_vez(m, error) }
funcion mock_implementation(m, f) { retornar ensayo_mock_implementar(m, f) }
funcion mock_reset(m) { retornar ensayo_mock_reiniciar(m) }
funcion expect_called(m, veces) { retornar ensayo_llamado(m, veces) }
funcion expect_called_with(m, args) { retornar ensayo_llamado_con(m, args) }
funcion expect_last_called_with(m, args) { retornar ensayo_ultima_llamada(m, args) }
funcion spy_on(objeto, clave, aridad) { retornar ensayo_espiar(objeto, clave, aridad) }
funcion mock_restore(m) { retornar ensayo_restaurar(m) }
funcion fake_clock(inicio) { retornar ensayo_reloj(inicio) }
funcion snapshot_file(ruta) { retornar ensayo_archivo_instantaneas(ruta) }
funcion expect_snapshot(v, nombre) { retornar ensayo_instantanea(v, nombre) }
funcion diff_text(a, b) { retornar ensayo_diferencia_texto(a, b) }

funcion _vitest_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_VITEST_OPT[k] ?? k] = o[k] }
    retornar r
}

// Mock fields in English: calls, results.
funcion mock_calls(m) { retornar m["llamadas"] }
funcion mock_results(m) { retornar m["resultados"] }
/// Fake clock: now(), advance(ms), schedule(ms, f), pending().
funcion fake_clock_en(start) {
    sea r = ensayo_reloj(start)
    retornar {"now": r["ahora"], "advance": r["avanzar"], "schedule": r["programar"], "pending": r["pendientes"]}
}
