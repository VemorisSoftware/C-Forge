// stdlib/metrics.cfv — métricas Prometheus: nombres en inglés del módulo "metricas".
// English names for the "metricas" module; both can be used together.

importar "metricas"

funcion metrics_registry() { retornar metricas_registro() }
funcion metrics_counter(r, nombre, ayuda, etiquetas) { retornar metricas_contador(r, nombre, ayuda, etiquetas) }
funcion metrics_gauge(r, nombre, ayuda, etiquetas) { retornar metricas_medidor(r, nombre, ayuda, etiquetas) }
funcion metrics_histogram(r, nombre, ayuda, etiquetas, cubetas) { retornar metricas_histograma(r, nombre, ayuda, etiquetas, cubetas) }
funcion metrics_summary(r, nombre, ayuda, etiquetas, cuantiles, ventana) { retornar metricas_resumen(r, nombre, ayuda, etiquetas, cuantiles, ventana) }
funcion metrics_inc(m, n, etiquetas) { retornar metricas_sumar(m, n, etiquetas) }
funcion metrics_set(m, v, etiquetas) { retornar metricas_fijar(m, v, etiquetas) }
funcion metrics_observe(m, v, etiquetas) { retornar metricas_observar(m, v, etiquetas) }
funcion metrics_time(m, f, etiquetas) { retornar metricas_cronometrar(m, f, etiquetas) }
funcion metrics_value(m, etiquetas) { retornar metricas_valor(m, etiquetas) }
funcion metrics_render(r) { retornar metricas_texto(r) }
