// stdlib/portaudio.cfv — Audio en tiempo real (estilo PortAudio): nombres en inglés del módulo "estudio".
// English names for the "estudio" module; both can be used together.

importar "estudio"

funcion _portaudio_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_portaudio_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _portaudio_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _PORTAUDIO_RES = {"indice": "index", "nombre": "name", "max_entradas": "max_input_channels", "max_salidas": "max_output_channels", "tasa_defecto": "default_sample_rate", "latencia_baja": "default_low_latency", "latencia_alta": "default_high_latency", "tasa": "sample_rate", "latencia_entrada": "input_latency", "latencia_salida": "output_latency", "subcargas": "underflows", "sobrecargas": "overflows"}

funcion pa_initialize() { retornar estudio_iniciar() }
funcion pa_terminate() { retornar estudio_terminar() }
funcion pa_get_version_info() { retornar estudio_version() }
funcion pa_get_host_apis() { retornar estudio_apis() }
funcion pa_add_file_input(nombre, datos_wav) { retornar estudio_archivo_entrada(nombre, datos_wav) }
funcion pa_add_file_output(nombre, ruta) { retornar estudio_archivo_salida(nombre, ruta) }
funcion pa_get_devices() { retornar _portaudio_tr(estudio_dispositivos(), _PORTAUDIO_RES) }
funcion pa_get_default_output_device() { retornar estudio_salida_defecto() }
funcion pa_get_default_input_device() { retornar estudio_entrada_defecto() }
funcion pa_is_format_supported(entrada, salida, tasa) { retornar estudio_formato_soportado(entrada, salida, tasa) }
funcion pa_open_stream(opciones) { retornar estudio_abrir(opciones) }
funcion pa_open_default_stream(canales_entrada, canales_salida, formato, tasa, cuadros, callback) { retornar estudio_abrir_defecto(canales_entrada, canales_salida, formato, tasa, cuadros, callback) }
funcion pa_start_stream(f) { retornar estudio_iniciar_flujo(f) }
funcion pa_stop_stream(f) { retornar estudio_detener(f) }
funcion pa_abort_stream(f) { retornar estudio_abortar(f) }
funcion pa_close_stream(f) { retornar estudio_cerrar(f) }
funcion pa_is_stream_active(f) { retornar estudio_activo(f) }
funcion pa_is_stream_stopped(f) { retornar estudio_detenido(f) }
funcion pa_get_stream_time(f) { retornar estudio_tiempo(f) }
funcion pa_get_stream_info(f) { retornar _portaudio_tr(estudio_info(f), _PORTAUDIO_RES) }
funcion pa_convert_samples(muestras, de, a) { retornar estudio_convertir(muestras, de, a) }
funcion pa_process_stream(f, segundos) { retornar estudio_procesar(f, segundos) }
funcion pa_pump_stream(f) { retornar estudio_bombear(f) }
funcion pa_write_stream(f, muestras) { retornar estudio_escribir(f, muestras) }
funcion pa_read_stream(f, cuadros) { retornar estudio_leer(f, cuadros) }
funcion pa_get_stream_read_available(f) { retornar estudio_disponible_lectura(f) }
