// stdlib/ciencia.cfv — optimización e interpolación científica: mínimo de
// funciones (Nelder–Mead, sección dorada, descenso de gradiente), ajuste de
// curvas por mínimos cuadrados no lineales (Gauss–Newton amortiguado),
// interpolación lineal y spline cúbico natural, EDO con Runge–Kutta 4 y
// sistemas lineales. Inspirada en SciPy (BSD). En inglés: importar "science".
//
//   importar "ciencia"
//   ciencia_minimizar(funcion(p) { retornar (p[0] - 3) * (p[0] - 3) + (p[1] + 1) * (p[1] + 1) }, [0, 0])
//   sea s = ciencia_spline([0, 1, 2, 3], [0, 1, 0, 1])
//   ciencia_evaluar_spline(s, 1.5)
//   ciencia_ajustar(funcion(x, p) { retornar p[0] * exponencial(p[1] * x) }, xs, ys, [1, 0.1])

/// Nelder–Mead: {"x", "valor", "iteraciones"}.
funcion ciencia_minimizar(f, inicio, opciones) {
    sea tol = 0.0000000001
    sea max_it = 2000
    si (opciones != nulo) {
        si (tiene_clave(opciones, "tolerancia")) { tol = opciones["tolerancia"] }
        si (tiene_clave(opciones, "iteraciones")) { max_it = opciones["iteraciones"] }
    }
    sea n = longitud(inicio)
    sea simplex = [inicio]
    sea i = 0
    mientras (i < n) {
        sea p = []
        para v en inicio { p.agregar(v) }
        si (p[i] == 0) { p[i] = 0.00025 } sino { p[i] = p[i] * 1.05 }
        simplex.agregar(p)
        i = i + 1
    }
    sea vals = []
    para p en simplex { vals.agregar(f(p)) }
    sea it = 0
    mientras (it < max_it) {
        // Ordenar por valor.
        sea idx = []
        i = 0
        mientras (i <= n) { idx.agregar(i)  i = i + 1 }
        idx = ordenar(idx, funcion(a, b) { retornar vals[a] - vals[b] })
        sea s2 = []
        sea v2 = []
        para k en idx { s2.agregar(simplex[k])  v2.agregar(vals[k]) }
        simplex = s2
        vals = v2
        // Converge cuando los valores y los vértices están juntos (evita parar
        // con dos puntos simétricos que valen lo mismo).
        sea tam = 0
        i = 1
        mientras (i <= n) {
            sea q = 0
            mientras (q < n) { tam = maximo(tam, absoluto(simplex[i][q] - simplex[0][q]))  q = q + 1 }
            i = i + 1
        }
        sea escala = 1
        para v en simplex[0] { escala = maximo(escala, absoluto(v)) }
        si (absoluto(vals[n] - vals[0]) <= tol * (absoluto(vals[0]) + tol) y tam <= 0.00000001 * escala) { retornar {"x": simplex[0], "valor": vals[0], "iteraciones": it} }
        sea c = []
        sea d = 0
        mientras (d < n) {
            sea s = 0
            i = 0
            mientras (i < n) { s = s + simplex[i][d]  i = i + 1 }
            c.agregar(s / n)
            d = d + 1
        }
        sea mover = funcion(t) {
            sea r = []
            sea q = 0
            mientras (q < n) { r.agregar(c[q] + t * (simplex[n][q] - c[q]))  q = q + 1 }
            retornar r
        }
        sea xr = mover(-1)
        sea fr = f(xr)
        si (fr < vals[0]) {
            sea xe = mover(-2)
            sea fe = f(xe)
            si (fe < fr) { simplex[n] = xe  vals[n] = fe } sino { simplex[n] = xr  vals[n] = fr }
        } sino {
            si (fr < vals[n - 1]) { simplex[n] = xr  vals[n] = fr } sino {
                sea xc = mover(0.5)
                si (fr < vals[n]) { xc = mover(-0.5) }
                sea fc = f(xc)
                si (fc < minimo(fr, vals[n])) { simplex[n] = xc  vals[n] = fc } sino {
                    // Encoger hacia el mejor.
                    i = 1
                    mientras (i <= n) {
                        sea p = []
                        sea q = 0
                        mientras (q < n) { p.agregar(simplex[0][q] + 0.5 * (simplex[i][q] - simplex[0][q]))  q = q + 1 }
                        simplex[i] = p
                        vals[i] = f(p)
                        i = i + 1
                    }
                }
            }
        }
        it = it + 1
    }
    retornar {"x": simplex[0], "valor": vals[0], "iteraciones": it}
}

/// Mínimo de f en [a, b] (función unimodal), sección dorada.
funcion ciencia_minimo_1d(f, a, b, tol) {
    sea t = tol ?? 0.00000001
    sea g = (raiz(5) - 1) / 2
    sea c = b - g * (b - a)
    sea d = a + g * (b - a)
    mientras (absoluto(b - a) > t) {
        si (f(c) < f(d)) { b = d } sino { a = c }
        c = b - g * (b - a)
        d = a + g * (b - a)
    }
    retornar (a + b) / 2
}

/// Gradiente numérico.
funcion ciencia_gradiente(f, x, h) {
    sea paso = h ?? 0.000001
    sea g = []
    sea i = 0
    mientras (i < longitud(x)) {
        sea a = []
        sea b = []
        para v en x { a.agregar(v)  b.agregar(v) }
        a[i] = a[i] + paso
        b[i] = b[i] - paso
        g.agregar((f(a) - f(b)) / (2 * paso))
        i = i + 1
    }
    retornar g
}

/// Resuelve A·x = b (eliminación de Gauss con pivoteo parcial).
funcion ciencia_resolver(A, b) {
    sea n = longitud(A)
    sea M = []
    sea i = 0
    mientras (i < n) {
        sea fila = []
        para v en A[i] { fila.agregar(v) }
        fila.agregar(b[i])
        M.agregar(fila)
        i = i + 1
    }
    sea c = 0
    mientras (c < n) {
        sea piv = c
        sea r = c + 1
        mientras (r < n) { si (absoluto(M[r][c]) > absoluto(M[piv][c])) { piv = r }  r = r + 1 }
        si (absoluto(M[piv][c]) < 0.000000000001) { lanzar "ciencia: sistema singular" }
        sea t = M[c]  M[c] = M[piv]  M[piv] = t
        r = c + 1
        mientras (r < n) {
            sea fct = M[r][c] / M[c][c]
            sea q = c
            mientras (q <= n) { M[r][q] = M[r][q] - fct * M[c][q]  q = q + 1 }
            r = r + 1
        }
        c = c + 1
    }
    sea x = []
    i = 0
    mientras (i < n) { x.agregar(0)  i = i + 1 }
    i = n - 1
    mientras (i >= 0) {
        sea s = M[i][n]
        sea q = i + 1
        mientras (q < n) { s = s - M[i][q] * x[q]  q = q + 1 }
        x[i] = s / M[i][i]
        i = i - 1
    }
    retornar x
}

/// Ajusta f(x, p) a los datos (Levenberg–Marquardt). {"p", "residuo"}.
funcion ciencia_ajustar(f, xs, ys, p0, iteraciones) {
    sea p = []
    para v en p0 { p.agregar(v) }
    sea m = longitud(p)
    sea lambda = 0.001
    sea costo = funcion(q) {
        sea s = 0
        sea i = 0
        mientras (i < longitud(xs)) { sea e = ys[i] - f(xs[i], q)  s = s + e * e  i = i + 1 }
        retornar s
    }
    sea actual = costo(p)
    sea it = 0
    mientras (it < (iteraciones ?? 200)) {
        // Jacobiano numérico.
        sea JtJ = []
        sea Jtr = []
        sea a = 0
        mientras (a < m) {
            sea fila = []
            sea b = 0
            mientras (b < m) { fila.agregar(0)  b = b + 1 }
            JtJ.agregar(fila)
            Jtr.agregar(0)
            a = a + 1
        }
        sea i = 0
        mientras (i < longitud(xs)) {
            sea base = f(xs[i], p)
            sea r = ys[i] - base
            sea J = []
            a = 0
            mientras (a < m) {
                sea q = []
                para v en p { q.agregar(v) }
                sea h = maximo(0.00000001, absoluto(q[a]) * 0.000001)
                q[a] = q[a] + h
                J.agregar((f(xs[i], q) - base) / h)
                a = a + 1
            }
            a = 0
            mientras (a < m) {
                Jtr[a] = Jtr[a] + J[a] * r
                sea b = 0
                mientras (b < m) { JtJ[a][b] = JtJ[a][b] + J[a] * J[b]  b = b + 1 }
                a = a + 1
            }
            i = i + 1
        }
        sea mejoro = falso
        sea intentos = 0
        mientras (mejoro == falso y intentos < 20) {
            sea A = []
            a = 0
            mientras (a < m) {
                sea fila = []
                para v en JtJ[a] { fila.agregar(v) }
                fila[a] = fila[a] * (1 + lambda)
                A.agregar(fila)
                a = a + 1
            }
            sea delta = nulo
            intentar { delta = ciencia_resolver(A, Jtr) } capturar (e) { delta = nulo }
            si (delta != nulo) {
                sea q = []
                a = 0
                mientras (a < m) { q.agregar(p[a] + delta[a])  a = a + 1 }
                sea nuevo = costo(q)
                si (nuevo < actual) {
                    sea cambio = actual - nuevo
                    p = q
                    actual = nuevo
                    lambda = lambda / 10
                    mejoro = verdadero
                    si (cambio < 0.000000000001 * (actual + 0.000000000001)) { retornar {"p": p, "residuo": actual} }
                } sino { lambda = lambda * 10 }
            } sino { lambda = lambda * 10 }
            intentos = intentos + 1
        }
        si (mejoro == falso) { retornar {"p": p, "residuo": actual} }
        it = it + 1
    }
    retornar {"p": p, "residuo": actual}
}

/// Interpolación lineal en xs (crecientes); fuera del rango, extrapola.
funcion ciencia_interpolar(xs, ys, x) {
    sea n = longitud(xs)
    si (n < 2) { lanzar "ciencia: se necesitan al menos 2 puntos" }
    sea i = 0
    mientras (i < n - 2 y x > xs[i + 1]) { i = i + 1 }
    retornar ys[i] + (ys[i + 1] - ys[i]) * (x - xs[i]) / (xs[i + 1] - xs[i])
}

/// Spline cúbico natural: devuelve los coeficientes para evaluar.
funcion ciencia_spline(xs, ys) {
    sea n = longitud(xs) - 1
    si (n < 1) { lanzar "ciencia: se necesitan al menos 2 puntos" }
    sea h = []
    sea i = 0
    mientras (i < n) {
        sea d = xs[i + 1] - xs[i]
        si (d <= 0) { lanzar "ciencia: los x deben ser estrictamente crecientes" }
        h.agregar(d)
        i = i + 1
    }
    sea alfa = [0]
    i = 1
    mientras (i < n) { alfa.agregar(3 / h[i] * (ys[i + 1] - ys[i]) - 3 / h[i - 1] * (ys[i] - ys[i - 1]))  i = i + 1 }
    sea l = [1]
    sea mu = [0]
    sea z = [0]
    i = 1
    mientras (i < n) {
        l.agregar(2 * (xs[i + 1] - xs[i - 1]) - h[i - 1] * mu[i - 1])
        mu.agregar(h[i] / l[i])
        z.agregar((alfa[i] - h[i - 1] * z[i - 1]) / l[i])
        i = i + 1
    }
    sea c = []
    sea b = []
    sea d = []
    i = 0
    mientras (i <= n) { c.agregar(0)  i = i + 1 }
    i = 0
    mientras (i < n) { b.agregar(0)  d.agregar(0)  i = i + 1 }
    sea j = n - 1
    mientras (j >= 0) {
        c[j] = z[j] - mu[j] * c[j + 1]
        b[j] = (ys[j + 1] - ys[j]) / h[j] - h[j] * (c[j + 1] + 2 * c[j]) / 3
        d[j] = (c[j + 1] - c[j]) / (3 * h[j])
        j = j - 1
    }
    retornar {"x": xs, "a": ys, "b": b, "c": c, "d": d}
}

funcion ciencia_evaluar_spline(s, x) {
    sea xs = s["x"]
    sea i = 0
    mientras (i < longitud(xs) - 2 y x > xs[i + 1]) { i = i + 1 }
    sea t = x - xs[i]
    retornar s["a"][i] + s["b"][i] * t + s["c"][i] * t * t + s["d"][i] * t * t * t
}

/// EDO y' = f(t, y) con Runge–Kutta 4. y puede ser número o lista.
/// Devuelve [[t, y], …] con n pasos de t0 a t1.
funcion ciencia_edo(f, y0, t0, t1, n) {
    sea pasos = n ?? 100
    sea h = (t1 - t0) / pasos
    sea es_lista = tipo(y0) == "lista"
    sea suma = funcion(a, b, k) {
        si (es_lista == falso) { retornar a + b * k }
        sea r = []
        sea i = 0
        mientras (i < longitud(a)) { r.agregar(a[i] + b[i] * k)  i = i + 1 }
        retornar r
    }
    sea y = y0
    sea t = t0
    sea r = [[t, y]]
    sea k = 0
    mientras (k < pasos) {
        sea k1 = f(t, y)
        sea k2 = f(t + h / 2, suma(y, k1, h / 2))
        sea k3 = f(t + h / 2, suma(y, k2, h / 2))
        sea k4 = f(t + h, suma(y, k3, h))
        si (es_lista) {
            sea ny = []
            sea i = 0
            mientras (i < longitud(y)) { ny.agregar(y[i] + h / 6 * (k1[i] + 2 * k2[i] + 2 * k3[i] + k4[i]))  i = i + 1 }
            y = ny
        } sino { y = y + h / 6 * (k1 + 2 * k2 + 2 * k3 + k4) }
        t = t0 + (k + 1) * h
        r.agregar([t, y])
        k = k + 1
    }
    retornar r
}
