// stdlib/astronomy.cfv — astronomía práctica: nombres en inglés del módulo "astro".
// English names for the "astro" module; both can be used together.

importar "astro"

funcion astronomy_julian(ms) { retornar astro_juliano(ms) }
funcion astronomy_from_julian(jd) { retornar astro_desde_juliano(jd) }
/// {"altitude", "azimuth", "declination"}
funcion astronomy_sun_position(lat, lon, ms) {
    sea p = astro_posicion_sol(lat, lon, ms)
    retornar {"altitude": p["altura"], "azimuth": p["acimut"], "declination": p["declinacion"]}
}
/// {"sunrise_ms", "sunset_ms", "noon_ms", "day_hours", "civil_dawn_ms", "civil_dusk_ms", …}
funcion astronomy_sun_times(lat, lon, ms) {
    sea s = astro_sol(lat, lon, ms)
    retornar {"sunrise_ms": s["salida_ms"], "sunset_ms": s["puesta_ms"], "noon_ms": s["mediodia_ms"], "day_hours": s["duracion_h"], "civil_dawn_ms": s["alba_civil_ms"], "civil_dusk_ms": s["ocaso_civil_ms"], "nautical_dawn_ms": s["alba_nautica_ms"], "nautical_dusk_ms": s["ocaso_nautico_ms"], "max_altitude": s["altura_maxima"]}
}
/// {"phase", "illumination", "age_days", "name"}
funcion astronomy_moon(ms) {
    sea l = astro_luna(ms)
    sea en = {"luna nueva": "new moon", "creciente": "waxing crescent", "cuarto creciente": "first quarter", "gibosa creciente": "waxing gibbous", "luna llena": "full moon", "gibosa menguante": "waning gibbous", "cuarto menguante": "last quarter", "menguante": "waning crescent"}
    retornar {"phase": l["fase"], "illumination": l["iluminacion"], "age_days": l["edad_dias"], "name": en[l["nombre"]]}
}
funcion astronomy_season(lat, ms) {
    retornar {"verano": "summer", "otoño": "autumn", "invierno": "winter", "primavera": "spring"}[astro_estacion(lat, ms)]
}
funcion astronomy_sidereal(ms, lon) { retornar astro_sideral(ms, lon) }
