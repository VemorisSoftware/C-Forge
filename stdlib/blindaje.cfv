// stdlib/blindaje.cfv — TLS 1.3 propio en C-Forge puro, al estilo de
// Rustls/Ring: cliente y servidor (RFC 8446) con X25519 y P-256,
// AES-128-GCM, AES-256-GCM y ChaCha20-Poly1305, firmas Ed25519, ECDSA
// P-256/P-384 y RSA (PSS y PKCS#1 v1.5), certificados X.509 (lectura,
// cadena hasta las raíces del sistema o las que se den, fechas, nombre del
// servidor con comodines), SNI, ALPN, HelloRetryRequest, KeyUpdate, tickets
// ignorados y alertas. El núcleo no hace E/S ("sans-IO"): se le dan bytes
// y devuelve bytes, así que sirve sobre TCP, en memoria o para QUIC (modo
// "quic": mensajes por nivel de cifrado y secretos exportados). Incluye
// certificados autofirmados Ed25519 o P-256 para servidores de prueba.
// Idea de Rustls (MIT/Apache-2.0), escrito desde cero. En inglés:
// importar "rustls".
//
//   importar "blindaje"
//   sea c = blindaje_conectar("example.com", 443, nulo)
//   blindaje_enviar(c, "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
//   mostrar(blindaje_recibir_todo(c))
//   blindaje_cerrar(c)

importar "base64"

funcion __blindaje_declaraciones() {
    extern "libc" funcion socket(dominio: entero, tipo_s: entero, protocolo: entero): entero
    extern "libc" funcion setsockopt(fd: entero, nivel: entero, opcion: entero, valor: puntero, largo: entero): entero
    extern "libc" funcion bind(fd: entero, dir: puntero, largo: entero): entero
    extern "libc" funcion listen(fd: entero, cola: entero): entero
    extern "libc" funcion accept(fd: entero, dir: puntero, largo: puntero): entero
    extern "libc" funcion close(fd: entero): entero
}

// ---------- resúmenes, HMAC y HKDF ----------

funcion _bl_hash(alg, datos) {
    si (alg == 256) { retornar sha256_bytes(datos) }
    si (alg == 384) { retornar bytes_de_hex(sha384(datos)) }
    retornar sha512_bytes(datos)
}

funcion _bl_hlen(alg) { retornar alg / 8 }

funcion _bl_hmac(alg, clave, msj) {
    si (alg == 256) { retornar hmac_sha256_bytes(clave, msj) }
    si (alg == 512) { retornar hmac_sha512_bytes(clave, msj) }
    sea b = 128
    sea k = clave
    si (longitud(k) > b) { k = _bl_hash(alg, k) }
    sea ip = ""
    sea op = ""
    sea i = 0
    mientras (i < b) {
        sea x = 0
        si (i < longitud(k)) { x = byte_en(k, i) }
        ip = ip + char_de(bits_xo(x, 54))
        op = op + char_de(bits_xo(x, 92))
        i = i + 1
    }
    retornar _bl_hash(alg, op + _bl_hash(alg, ip + msj))
}

funcion _bl_extraer(alg, sal, ikm) {
    sea s = sal
    si (s == "") { s = _bl_ceros(_bl_hlen(alg)) }
    retornar _bl_hmac(alg, s, ikm)
}

funcion _bl_expandir(alg, prk, info, largo) {
    sea r = ""
    sea t = ""
    sea n = 1
    mientras (longitud(r) < largo) {
        t = _bl_hmac(alg, prk, t + info + char_de(n))
        r = r + t
        n = n + 1
    }
    retornar subtexto(r, 0, largo)
}

/// HKDF-Expand-Label de TLS 1.3 (etiqueta sin el prefijo "tls13 ").
funcion blindaje_expandir_etiqueta(alg, secreto, etiqueta, contexto, largo) {
    sea l = "tls13 " + etiqueta
    sea info = _bl_u16(largo) + char_de(longitud(l)) + l + char_de(longitud(contexto)) + contexto
    retornar _bl_expandir(alg, secreto, info, largo)
}

funcion _bl_derivar(alg, secreto, etiqueta, mensajes) { retornar blindaje_expandir_etiqueta(alg, secreto, etiqueta, _bl_hash(alg, mensajes), _bl_hlen(alg)) }

funcion _bl_ceros(n) {
    sea r = ""
    mientras (longitud(r) < n) { r = r + char_de(0) }
    retornar r
}

funcion _bl_u16(n) { retornar char_de(piso(n / 256) % 256) + char_de(n % 256) }
funcion _bl_u24(n) { retornar char_de(piso(n / 65536) % 256) + char_de(piso(n / 256) % 256) + char_de(n % 256) }
funcion _bl_l16(d, i) { retornar byte_en(d, i) * 256 + byte_en(d, i + 1) }
funcion _bl_l24(d, i) { retornar byte_en(d, i) * 65536 + byte_en(d, i + 1) * 256 + byte_en(d, i + 2) }
funcion _bl_v8(t) { retornar char_de(longitud(t)) + t }
funcion _bl_v16(t) { retornar _bl_u16(longitud(t)) + t }
funcion _bl_v24(t) { retornar _bl_u24(longitud(t)) + t }

funcion _bl_xor(a, b) {
    sea r = ""
    sea i = 0
    mientras (i < longitud(a)) {
        r = r + char_de(bits_xo(byte_en(a, i), byte_en(b, i)))
        i = i + 1
    }
    retornar r
}

// ---------- enteros grandes (base 2^24, del menos significativo) ----------

sea _BL_B = 16777216

funcion _bl_bn(b, k) {
    sea r = []
    sea i = 0
    mientras (i < k) {
        r.agregar(0)
        i = i + 1
    }
    sea n = longitud(b)
    i = 0
    mientras (i < n) {
        sea limb = piso(i / 3)
        si (limb < k) { r[limb] = r[limb] + byte_en(b, n - 1 - i) * _BL_P256[i % 3] }
        i = i + 1
    }
    retornar r
}

sea _BL_P256 = [1, 256, 65536]

funcion _bl_bn_bytes(a, largo) {
    sea r = ""
    sea j = largo - 1
    mientras (j >= 0) {
        sea limb = piso(j / 3)
        sea v = 0
        si (limb < longitud(a)) { v = piso(a[limb] / _BL_P256[j % 3]) % 256 }
        r = r + char_de(v)
        j = j - 1
    }
    retornar r
}

funcion _bl_cmp(a, b) {
    sea i = longitud(a) - 1
    mientras (i >= 0) {
        si (a[i] > b[i]) { retornar 1 }
        si (a[i] < b[i]) { retornar -1 }
        i = i - 1
    }
    retornar 0
}

funcion _bl_es_cero(a) {
    para x en a { si (x != 0) { retornar falso } }
    retornar verdadero
}

funcion _bl_sumar(a, b) {
    sea r = []
    sea c = 0
    sea i = 0
    mientras (i < longitud(a)) {
        sea v = a[i] + b[i] + c
        si (v >= _BL_B) {
            r.agregar(v - _BL_B)
            c = 1
        } sino {
            r.agregar(v)
            c = 0
        }
        i = i + 1
    }
    retornar r
}

funcion _bl_restar(a, b) {
    sea r = []
    sea c = 0
    sea i = 0
    mientras (i < longitud(a)) {
        sea v = a[i] - b[i] - c
        si (v < 0) {
            r.agregar(v + _BL_B)
            c = 1
        } sino {
            r.agregar(v)
            c = 0
        }
        i = i + 1
    }
    retornar r
}

funcion _bl_mul24(x, y) { retornar ((x % 4096) * y % _BL_B + (piso(x / 4096) * y % 4096) * 4096) % _BL_B }

// Módulo para Montgomery a partir de bytes big endian.
funcion _bl_modulo(nb) {
    sea k = piso((longitud(nb) * 8 + 23) / 24) + 1
    sea n = _bl_bn(nb, k)
    sea x = 1
    sea it = 0
    mientras (it < 6) {
        x = _bl_mul24(x, (2 - _bl_mul24(n[0], x) + _BL_B) % _BL_B)
        it = it + 1
    }
    sea m = {"n": n, "k": k, "ninv": (_BL_B - x) % _BL_B}
    sea r = []
    sea i = 0
    mientras (i < k) {
        r.agregar(0)
        i = i + 1
    }
    r[0] = 1
    i = 0
    mientras (i < 2 * 24 * k) {
        r = _bl_mod_sumar(m, r, r)
        i = i + 1
    }
    m["r2"] = r
    sea uno = _bl_bn("", k)
    uno[0] = 1
    m["uno"] = uno
    m["uno_m"] = _bl_mont(m, uno, r)
    retornar m
}

funcion _bl_mod_sumar(m, a, b) {
    sea s = _bl_sumar(a, b)
    si (_bl_cmp(s, m["n"]) >= 0) { retornar _bl_restar(s, m["n"]) }
    retornar s
}

funcion _bl_mod_restar(m, a, b) {
    si (_bl_cmp(a, b) >= 0) { retornar _bl_restar(a, b) }
    retornar _bl_restar(_bl_sumar(a, m["n"]), b)
}

funcion _bl_mont(m, a, b) {
    sea K = m["k"]
    sea n = m["n"]
    sea ninv = m["ninv"]
    sea t = []
    sea i = 0
    mientras (i < K + 2) {
        t.agregar(0)
        i = i + 1
    }
    i = 0
    mientras (i < K) {
        sea ai = a[i]
        sea c = 0
        sea j = 0
        mientras (j < K) {
            sea v = t[j] + ai * b[j] + c
            c = piso(v / _BL_B)
            t[j] = v - c * _BL_B
            j = j + 1
        }
        sea v = t[K] + c
        c = piso(v / _BL_B)
        t[K] = v - c * _BL_B
        t[K + 1] = t[K + 1] + c
        sea q = _bl_mul24(t[0], ninv)
        v = t[0] + q * n[0]
        c = piso(v / _BL_B)
        j = 1
        mientras (j < K) {
            v = t[j] + q * n[j] + c
            c = piso(v / _BL_B)
            t[j - 1] = v - c * _BL_B
            j = j + 1
        }
        v = t[K] + c
        c = piso(v / _BL_B)
        t[K - 1] = v - c * _BL_B
        t[K] = t[K + 1] + c
        t[K + 1] = 0
        i = i + 1
    }
    sea r = []
    i = 0
    mientras (i < K) {
        r.agregar(t[i])
        i = i + 1
    }
    si (t[K] > 0 o _bl_cmp(r, n) >= 0) { r = _bl_restar(r, n) }
    retornar r
}

funcion _bl_a_m(m, a) { retornar _bl_mont(m, a, m["r2"]) }
funcion _bl_de_m(m, a) { retornar _bl_mont(m, a, m["uno"]) }

// a^e con a en Montgomery y e en bytes big endian.
funcion _bl_pot(m, a, eb) {
    sea r = m["uno_m"]
    sea i = 0
    mientras (i < longitud(eb)) {
        sea b = byte_en(eb, i)
        sea bit = 7
        mientras (bit >= 0) {
            r = _bl_mont(m, r, r)
            si (piso(b / _BL_P8[bit]) % 2 == 1) { r = _bl_mont(m, r, a) }
            bit = bit - 1
        }
        i = i + 1
    }
    retornar r
}

sea _BL_P8 = [1, 2, 4, 8, 16, 32, 64, 128]

funcion _bl_inv(m, a) {
    // a^(n-2) (n primo).
    sea nb = _bl_bn_bytes(m["n"], m["k"] * 3)
    sea dos = _bl_bn("", m["k"])
    dos[0] = 2
    retornar _bl_pot(m, a, _bl_bn_bytes(_bl_restar(m["n"], dos), m["k"] * 3))
}

funcion _bl_reducir(a, m) {
    sea r = a
    mientras (_bl_cmp(r, m["n"]) >= 0) { r = _bl_restar(r, m["n"]) }
    retornar r
}

// ---------- RSA (verificación) ----------

funcion _bl_rsa_pub(n, e, firma) {
    sea m = _bl_modulo(n)
    sea k = longitud(n)
    // Quita ceros a la izquierda del módulo para el largo.
    mientras (k > 0 y byte_en(n, longitud(n) - k) == 0) { k = k - 1 }
    si (longitud(firma) != k) { retornar nulo }
    sea s = _bl_bn(firma, m["k"])
    si (_bl_cmp(s, m["n"]) >= 0) { retornar nulo }
    retornar _bl_bn_bytes(_bl_de_m(m, _bl_pot(m, _bl_a_m(m, s), e)), k)
}

sea _BL_DIGEST_INFO = {"256": "3031300d060960864801650304020105000420", "384": "3041300d060960864801650304020205000430", "512": "3051300d060960864801650304020305000440", "1": "3021300906052b0e03021a05000414"}

funcion _bl_rsa_pkcs1(clave, alg, msj, firma) {
    sea em = _bl_rsa_pub(clave["n"], clave["e"], firma)
    si (em == nulo) { retornar falso }
    sea h = ""
    si (alg == 1) { h = sha1_bytes(msj) } sino { h = _bl_hash(alg, msj) }
    sea t = bytes_de_hex(_BL_DIGEST_INFO["" + alg]) + h
    sea k = longitud(em)
    si (k < longitud(t) + 11) { retornar falso }
    sea esperado = char_de(0) + char_de(1)
    mientras (longitud(esperado) < k - longitud(t) - 1) { esperado = esperado + char_de(255) }
    esperado = esperado + char_de(0) + t
    retornar comparar_seguro(em, esperado)
}

funcion _bl_mgf1(alg, semilla, largo) {
    sea r = ""
    sea c = 0
    mientras (longitud(r) < largo) {
        r = r + _bl_hash(alg, semilla + bytes_entero(c, 4, 0))
        c = c + 1
    }
    retornar subtexto(r, 0, largo)
}

funcion _bl_rsa_pss(clave, alg, msj, firma) {
    sea em = _bl_rsa_pub(clave["n"], clave["e"], firma)
    si (em == nulo) { retornar falso }
    sea hl = _bl_hlen(alg)
    sea mhash = _bl_hash(alg, msj)
    // Bits del módulo.
    sea nb = clave["n"]
    mientras (longitud(nb) > 0 y byte_en(nb, 0) == 0) { nb = subtexto(nb, 1, longitud(nb)) }
    sea modbits = longitud(nb) * 8
    sea top = byte_en(nb, 0)
    sea b = 128
    mientras (b > 0 y bits_y(top, b) == 0) {
        modbits = modbits - 1
        b = piso(b / 2)
    }
    sea embits = modbits - 1
    sea emlen = piso((embits + 7) / 8)
    si (longitud(em) > emlen) {
        si (byte_en(em, 0) != 0) { retornar falso }
        em = subtexto(em, longitud(em) - emlen, longitud(em))
    }
    si (byte_en(em, emlen - 1) != 188) { retornar falso }
    sea mascara_db = subtexto(em, 0, emlen - hl - 1)
    sea h = subtexto(em, emlen - hl - 1, emlen - 1)
    sea db = _bl_xor(mascara_db, _bl_mgf1(alg, h, emlen - hl - 1))
    // Los bits de más arriba en 0.
    sea sobran = 8 * emlen - embits
    sea primero = byte_en(db, 0) % _BL_P8_SUP[8 - sobran]
    db = char_de(primero) + subtexto(db, 1, longitud(db))
    // Sal de largo hl: ceros, 0x01, sal.
    sea ps = emlen - hl - hl - 2
    si (ps < 0) { retornar falso }
    sea i = 0
    mientras (i < ps) {
        si (byte_en(db, i) != 0) { retornar falso }
        i = i + 1
    }
    si (byte_en(db, ps) != 1) { retornar falso }
    sea sal = subtexto(db, ps + 1, longitud(db))
    sea h2 = _bl_hash(alg, _bl_ceros(8) + mhash + sal)
    retornar comparar_seguro(h, h2)
}

sea _BL_P8_SUP = [1, 2, 4, 8, 16, 32, 64, 128, 256]

// ---------- curvas P-256 y P-384 (a = -3) ----------

sea _BL_CURVAS = {}

funcion _bl_curva(nombre) {
    si (tiene_clave(_BL_CURVAS, nombre)) { retornar _BL_CURVAS[nombre] }
    sea d = {}
    si (nombre == "P-256") {
        d = {"p": "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff", "n": "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551",
            "gx": "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296", "gy": "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5",
            "b": "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b", "bytes": 32}
    } sino si (nombre == "P-384") {
        d = {"p": "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff",
            "n": "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973",
            "gx": "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7",
            "gy": "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f",
            "b": "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef", "bytes": 48}
    } sino { lanzar "blindaje: curva " + nombre + " no soportada" }
    sea p = _bl_modulo(bytes_de_hex(d["p"]))
    sea n = _bl_modulo(bytes_de_hex(d["n"]))
    sea c = {"nombre": nombre, "p": p, "n": n, "bytes": d["bytes"], "b": _bl_a_m(p, _bl_bn(bytes_de_hex(d["b"]), p["k"])),
        "g": [_bl_a_m(p, _bl_bn(bytes_de_hex(d["gx"]), p["k"])), _bl_a_m(p, _bl_bn(bytes_de_hex(d["gy"]), p["k"])), p["uno_m"]]}
    _BL_CURVAS[nombre] = c
    retornar c
}

funcion _bl_doblar(c, P) {
    si (P == nulo) { retornar nulo }
    sea f = c["p"]
    si (_bl_es_cero(P[1])) { retornar nulo }
    sea delta = _bl_mont(f, P[2], P[2])
    sea gamma = _bl_mont(f, P[1], P[1])
    sea beta = _bl_mont(f, P[0], gamma)
    sea t = _bl_mont(f, _bl_mod_restar(f, P[0], delta), _bl_mod_sumar(f, P[0], delta))
    sea alfa = _bl_mod_sumar(f, _bl_mod_sumar(f, t, t), t)
    sea b4 = _bl_mod_sumar(f, beta, beta)
    b4 = _bl_mod_sumar(f, b4, b4)
    sea X3 = _bl_mod_restar(f, _bl_mont(f, alfa, alfa), _bl_mod_sumar(f, b4, b4))
    sea yz = _bl_mod_sumar(f, P[1], P[2])
    sea Z3 = _bl_mod_restar(f, _bl_mod_restar(f, _bl_mont(f, yz, yz), gamma), delta)
    sea g2 = _bl_mont(f, gamma, gamma)
    sea g8 = _bl_mod_sumar(f, g2, g2)
    g8 = _bl_mod_sumar(f, g8, g8)
    g8 = _bl_mod_sumar(f, g8, g8)
    sea Y3 = _bl_mod_restar(f, _bl_mont(f, alfa, _bl_mod_restar(f, b4, X3)), g8)
    retornar [X3, Y3, Z3]
}

funcion _bl_sumar_p(c, P, Q) {
    si (P == nulo) { retornar Q }
    si (Q == nulo) { retornar P }
    sea f = c["p"]
    sea Z1Z1 = _bl_mont(f, P[2], P[2])
    sea Z2Z2 = _bl_mont(f, Q[2], Q[2])
    sea U1 = _bl_mont(f, P[0], Z2Z2)
    sea U2 = _bl_mont(f, Q[0], Z1Z1)
    sea S1 = _bl_mont(f, P[1], _bl_mont(f, Q[2], Z2Z2))
    sea S2 = _bl_mont(f, Q[1], _bl_mont(f, P[2], Z1Z1))
    si (_bl_cmp(U1, U2) == 0) {
        si (_bl_cmp(S1, S2) != 0) { retornar nulo }
        retornar _bl_doblar(c, P)
    }
    sea H = _bl_mod_restar(f, U2, U1)
    sea R = _bl_mod_restar(f, S2, S1)
    sea HH = _bl_mont(f, H, H)
    sea HHH = _bl_mont(f, H, HH)
    sea V = _bl_mont(f, U1, HH)
    sea X3 = _bl_mod_restar(f, _bl_mod_restar(f, _bl_mont(f, R, R), HHH), _bl_mod_sumar(f, V, V))
    sea Y3 = _bl_mod_restar(f, _bl_mont(f, R, _bl_mod_restar(f, V, X3)), _bl_mont(f, S1, HHH))
    retornar [X3, Y3, _bl_mont(f, H, _bl_mont(f, P[2], Q[2]))]
}

// k (bytes big endian) · P.
funcion _bl_por(c, kb, P) {
    sea R = nulo
    sea i = 0
    mientras (i < longitud(kb)) {
        sea b = byte_en(kb, i)
        sea bit = 7
        mientras (bit >= 0) {
            R = _bl_doblar(c, R)
            si (piso(b / _BL_P8[bit]) % 2 == 1) { R = _bl_sumar_p(c, R, P) }
            bit = bit - 1
        }
        i = i + 1
    }
    retornar R
}

// u1·G + u2·Q a la vez (truco de Shamir).
funcion _bl_por2(c, ub1, P1, ub2, P2) {
    sea P12 = _bl_sumar_p(c, P1, P2)
    sea R = nulo
    sea i = 0
    mientras (i < longitud(ub1)) {
        sea a = byte_en(ub1, i)
        sea b = byte_en(ub2, i)
        sea bit = 7
        mientras (bit >= 0) {
            R = _bl_doblar(c, R)
            sea x = piso(a / _BL_P8[bit]) % 2
            sea y_ = piso(b / _BL_P8[bit]) % 2
            si (x == 1 y y_ == 1) { R = _bl_sumar_p(c, R, P12) }
            sino si (x == 1) { R = _bl_sumar_p(c, R, P1) }
            sino si (y_ == 1) { R = _bl_sumar_p(c, R, P2) }
            bit = bit - 1
        }
        i = i + 1
    }
    retornar R
}

funcion _bl_afin(c, P) {
    si (P == nulo) { retornar nulo }
    sea f = c["p"]
    sea zi = _bl_inv(f, P[2])
    sea zi2 = _bl_mont(f, zi, zi)
    retornar [_bl_de_m(f, _bl_mont(f, P[0], zi2)), _bl_de_m(f, _bl_mont(f, P[1], _bl_mont(f, zi2, zi)))]
}

// Punto público sin comprimir (0x04‖x‖y) → coordenadas, comprobando la curva.
funcion _bl_punto(c, pub) {
    sea nb = c["bytes"]
    si (longitud(pub) != 1 + 2 * nb o byte_en(pub, 0) != 4) { retornar nulo }
    sea f = c["p"]
    sea x = _bl_bn(subtexto(pub, 1, 1 + nb), f["k"])
    sea y_ = _bl_bn(subtexto(pub, 1 + nb, 1 + 2 * nb), f["k"])
    si (_bl_cmp(x, f["n"]) >= 0 o _bl_cmp(y_, f["n"]) >= 0) { retornar nulo }
    sea xm = _bl_a_m(f, x)
    sea ym = _bl_a_m(f, y_)
    // y² = x³ - 3x + b
    sea x3 = _bl_mont(f, _bl_mont(f, xm, xm), xm)
    sea tres_x = _bl_mod_sumar(f, _bl_mod_sumar(f, xm, xm), xm)
    sea der = _bl_mod_sumar(f, _bl_mod_restar(f, x3, tres_x), c["b"])
    si (_bl_cmp(_bl_mont(f, ym, ym), der) != 0) { retornar nulo }
    retornar [xm, ym, f["uno_m"]]
}

// ECDSA: resumen ya calculado, firma DER.
funcion _bl_ecdsa(c, pub, resumen, firma_der) {
    sea Q = _bl_punto(c, pub)
    si (Q == nulo) { retornar falso }
    sea rs = _bl_der_rs(firma_der)
    si (rs == nulo) { retornar falso }
    sea N = c["n"]
    sea nb = c["bytes"]
    sea r = _bl_bn(rs[0], N["k"])
    sea s = _bl_bn(rs[1], N["k"])
    si (_bl_es_cero(r) o _bl_es_cero(s) o _bl_cmp(r, N["n"]) >= 0 o _bl_cmp(s, N["n"]) >= 0) { retornar falso }
    // z = los nb bytes de más a la izquierda del resumen.
    sea zb = resumen
    si (longitud(zb) > nb) { zb = subtexto(zb, 0, nb) }
    sea z = _bl_reducir(_bl_bn(zb, N["k"]), N)
    sea w = _bl_inv(N, _bl_a_m(N, s))
    sea u1 = _bl_de_m(N, _bl_mont(N, _bl_a_m(N, z), w))
    sea u2 = _bl_de_m(N, _bl_mont(N, _bl_a_m(N, r), w))
    sea X = _bl_afin(c, _bl_por2(c, _bl_bn_bytes(u1, nb), c["g"], _bl_bn_bytes(u2, nb), Q))
    si (X == nulo) { retornar falso }
    retornar _bl_cmp(_bl_reducir(X[0], N), r) == 0
}

// ECDH: x de priv·pub.
funcion _bl_ecdh(c, priv, pub) {
    sea Q = _bl_punto(c, pub)
    si (Q == nulo) { lanzar "blindaje: punto público inválido" }
    sea X = _bl_afin(c, _bl_por(c, priv, Q))
    si (X == nulo) { lanzar "blindaje: secreto compartido inválido" }
    retornar _bl_bn_bytes(X[0], c["bytes"])
}

funcion _bl_ec_par(c) {
    sea N = c["n"]
    sea d = bytes_aleatorios(c["bytes"])
    mientras (_bl_es_cero(_bl_bn(d, N["k"])) o _bl_cmp(_bl_bn(d, N["k"]), N["n"]) >= 0) { d = bytes_aleatorios(c["bytes"]) }
    sea P = _bl_afin(c, _bl_por(c, d, c["g"]))
    retornar {"privada": d, "publica": char_de(4) + _bl_bn_bytes(P[0], c["bytes"]) + _bl_bn_bytes(P[1], c["bytes"])}
}

// Firma ECDSA (para el servidor) con resumen calculado; devuelve DER.
funcion _bl_ecdsa_firmar(c, priv, resumen) {
    sea N = c["n"]
    sea nb = c["bytes"]
    sea zb = resumen
    si (longitud(zb) > nb) { zb = subtexto(zb, 0, nb) }
    sea z = _bl_reducir(_bl_bn(zb, N["k"]), N)
    sea d = _bl_bn(priv, N["k"])
    mientras (verdadero) {
        sea kb = bytes_aleatorios(nb)
        sea k = _bl_bn(kb, N["k"])
        si (_bl_es_cero(k) == falso y _bl_cmp(k, N["n"]) < 0) {
            sea R = _bl_afin(c, _bl_por(c, kb, c["g"]))
            sea r = _bl_reducir(R[0], N)
            si (_bl_es_cero(r) == falso) {
                sea s = _bl_de_m(N, _bl_mont(N, _bl_inv(N, _bl_a_m(N, k)), _bl_mod_sumar(N, _bl_a_m(N, z), _bl_mont(N, _bl_a_m(N, r), _bl_a_m(N, d)))))
                si (_bl_es_cero(s) == falso) { retornar _bl_der_seq([_bl_der_entero(_bl_bn_bytes(r, nb)), _bl_der_entero(_bl_bn_bytes(s, nb))]) }
            }
        }
    }
}

// ---------- DER ----------

funcion _bl_der_largo(n) {
    si (n < 128) { retornar char_de(n) }
    sea b = ""
    sea x = n
    mientras (x > 0) {
        b = char_de(x % 256) + b
        x = piso(x / 256)
    }
    retornar char_de(128 + longitud(b)) + b
}

funcion _bl_tlv(etiqueta, contenido) { retornar char_de(etiqueta) + _bl_der_largo(longitud(contenido)) + contenido }
funcion _bl_der_seq(partes) { retornar _bl_tlv(48, unir(partes, "")) }

funcion _bl_der_entero(b) {
    sea x = b
    mientras (longitud(x) > 1 y byte_en(x, 0) == 0) { x = subtexto(x, 1, longitud(x)) }
    si (byte_en(x, 0) >= 128) { x = char_de(0) + x }
    retornar _bl_tlv(2, x)
}

funcion _bl_der_oid(texto) {
    sea p = texto_dividir(texto, ".")
    sea r = char_de(a_numero(p[0]) * 40 + a_numero(p[1]))
    sea i = 2
    mientras (i < longitud(p)) {
        sea v = a_numero(p[i])
        sea t = char_de(v % 128)
        v = piso(v / 128)
        mientras (v > 0) {
            t = char_de(128 + v % 128) + t
            v = piso(v / 128)
        }
        r = r + t
        i = i + 1
    }
    retornar _bl_tlv(6, r)
}

// [etiqueta, inicio del contenido, largo, fin] o nulo.
funcion _bl_leer(d, pos) {
    si (pos + 2 > longitud(d)) { retornar nulo }
    sea et = byte_en(d, pos)
    sea l = byte_en(d, pos + 1)
    sea p = pos + 2
    si (l >= 128) {
        sea n = l - 128
        si (n == 0 o n > 4) { retornar nulo }
        l = 0
        sea k = 0
        mientras (k < n) {
            l = l * 256 + byte_en(d, p + k)
            k = k + 1
        }
        p = p + n
    }
    si (p + l > longitud(d)) { retornar nulo }
    retornar [et, p, l, p + l, pos]
}

funcion _bl_hijos(d, t) {
    sea r = []
    sea p = t[1]
    mientras (p < t[3]) {
        sea h = _bl_leer(d, p)
        si (h == nulo) { lanzar "blindaje: DER dañado" }
        r.agregar(h)
        p = h[3]
    }
    retornar r
}

funcion _bl_cont(d, t) { retornar subtexto(d, t[1], t[3]) }
funcion _bl_crudo(d, t, pos) { retornar subtexto(d, pos, t[3]) }

funcion _bl_oid_texto(b) {
    si (longitud(b) == 0) { retornar "" }
    sea r = "" + piso(byte_en(b, 0) / 40) + "." + (byte_en(b, 0) % 40)
    sea v = 0
    sea i = 1
    mientras (i < longitud(b)) {
        sea x = byte_en(b, i)
        v = v * 128 + x % 128
        si (x < 128) {
            r = r + "." + v
            v = 0
        }
        i = i + 1
    }
    retornar r
}

funcion _bl_der_rs(der) {
    sea t = _bl_leer(der, 0)
    si (t == nulo o t[0] != 48) { retornar nulo }
    sea h = _bl_hijos(der, t)
    si (longitud(h) != 2) { retornar nulo }
    retornar [_bl_cont(der, h[0]), _bl_cont(der, h[1])]
}

// ---------- PEM ----------

/// Bloques DER de un texto PEM (por ejemplo, varios certificados).
funcion blindaje_pem(texto, tipo_bloque) {
    sea r = []
    sea marca = "-----BEGIN " + (tipo_bloque ?? "CERTIFICATE") + "-----"
    sea fin = "-----END " + (tipo_bloque ?? "CERTIFICATE") + "-----"
    sea p = texto_indice(texto, marca)
    mientras (p >= 0) {
        sea resto = subtexto(texto, p + longitud(marca), longitud(texto))
        sea q = texto_indice(resto, fin)
        si (q < 0) { romper }
        sea b64 = texto_reemplazar(texto_reemplazar(texto_reemplazar(subtexto(resto, 0, q), "\n", ""), "\r", ""), " ", "")
        r.agregar(base64_decodificar(b64))
        texto = subtexto(resto, q + longitud(fin), longitud(resto))
        p = texto_indice(texto, marca)
    }
    retornar r
}

funcion _bl_a_pem(tipo_bloque, der) {
    sea b = base64_codificar(der)
    sea l = []
    sea i = 0
    mientras (i < longitud(b)) {
        l.agregar(subtexto(b, i, minimo(longitud(b), i + 64)))
        i = i + 64
    }
    retornar "-----BEGIN " + tipo_bloque + "-----\n" + unir(l, "\n") + "\n-----END " + tipo_bloque + "-----\n"
}

// ---------- X.509 ----------

sea _BL_OID = {
    "1.2.840.113549.1.1.1": "rsa", "1.2.840.10045.2.1": "ec", "1.3.101.112": "ed25519", "1.2.840.113549.1.1.10": "rsa_pss",
    "1.2.840.10045.3.1.7": "P-256", "1.3.132.0.34": "P-384",
    "1.2.840.113549.1.1.11": "rsa_sha256", "1.2.840.113549.1.1.12": "rsa_sha384", "1.2.840.113549.1.1.13": "rsa_sha512",
    "1.2.840.10045.4.3.2": "ecdsa_sha256", "1.2.840.10045.4.3.3": "ecdsa_sha384", "1.2.840.10045.4.3.4": "ecdsa_sha512",
    "2.5.4.3": "CN", "2.5.4.6": "C", "2.5.4.7": "L", "2.5.4.8": "ST", "2.5.4.10": "O", "2.5.4.11": "OU",
    "2.5.29.17": "san", "2.5.29.19": "basicos", "2.5.29.15": "usos", "2.5.29.37": "usos_ext"}

funcion _bl_nombre(d, t) {
    // Name: SEQUENCE OF SET OF AttributeTypeAndValue.
    sea r = {}
    sea partes = []
    para rdn en _bl_hijos(d, t) {
        para atv en _bl_hijos(d, rdn) {
            sea h = _bl_hijos(d, atv)
            sea oid = _bl_oid_texto(_bl_cont(d, h[0]))
            sea k = _BL_OID[oid] ?? oid
            sea v = _bl_cont(d, h[1])
            r[k] = v
            partes.agregar(k + "=" + v)
        }
    }
    r["texto"] = unir(partes, ", ")
    retornar r
}

// Fecha UTCTime o GeneralizedTime → segundos Unix.
funcion _bl_fecha(d, t) {
    sea s = _bl_cont(d, t)
    sea anio = 0
    sea resto = ""
    si (t[0] == 23) {
        anio = a_numero(subtexto(s, 0, 2))
        si (anio < 50) { anio = anio + 2000 } sino { anio = anio + 1900 }
        resto = subtexto(s, 2, longitud(s))
    } sino {
        anio = a_numero(subtexto(s, 0, 4))
        resto = subtexto(s, 4, longitud(s))
    }
    sea mes = a_numero(subtexto(resto, 0, 2))
    sea dia = a_numero(subtexto(resto, 2, 4))
    sea h = a_numero(subtexto(resto, 4, 6))
    sea mi = a_numero(subtexto(resto, 6, 8))
    sea se = a_numero(subtexto(resto, 8, 10))
    retornar _bl_dias(anio, mes, dia) * 86400 + h * 3600 + mi * 60 + se
}

// Días desde 1970-01-01 (algoritmo de Howard Hinnant).
funcion _bl_dias(y0, m, d) {
    sea y = y0
    si (m <= 2) { y = y - 1 }
    sea era = piso(y / 400)
    sea yoe = y - era * 400
    sea mp = (m + 9) % 12
    sea doy = piso((153 * mp + 2) / 5) + d - 1
    sea doe = yoe * 365 + piso(yoe / 4) - piso(yoe / 100) + doy
    retornar era * 146097 + doe - 719468
}

/// Lee un certificado X.509 (DER): sujeto, emisor, fechas, clave pública,
/// nombres (SAN), si es CA, y lo necesario para verificar su firma.
funcion blindaje_certificado(der) {
    sea c = _bl_leer(der, 0)
    si (c == nulo o c[0] != 48) { lanzar "blindaje: certificado dañado" }
    sea h = _bl_hijos(der, c)
    sea tbs_t = h[0]
    sea tbs = subtexto(der, c[1], tbs_t[3])
    sea alg = _BL_OID[_bl_oid_texto(_bl_cont(der, _bl_hijos(der, h[1])[0]))] ?? "?"
    sea firma = _bl_cont(der, h[2])
    firma = subtexto(firma, 1, longitud(firma))
    sea campos = _bl_hijos(der, tbs_t)
    sea i = 0
    si (campos[0][0] == 160) { i = 1 }
    sea serie = _bl_cont(der, campos[i])
    sea emisor = _bl_nombre(der, campos[i + 2])
    sea validez = _bl_hijos(der, campos[i + 3])
    sea sujeto = _bl_nombre(der, campos[i + 4])
    sea spki_t = campos[i + 5]
    sea clave = _bl_clave_publica(der, spki_t)
    sea r = {"der": der, "tbs": tbs, "alg_firma": alg, "firma": firma, "serie": hex_de_bytes(serie), "emisor": emisor, "sujeto": sujeto,
        "desde": _bl_fecha(der, validez[0]), "hasta": _bl_fecha(der, validez[1]), "clave": clave, "nombres": [], "ips": [], "ca": falso, "largo_ruta": nulo,
        "spki": subtexto(der, _bl_inicio_tlv(der, spki_t), spki_t[3])}
    // Extensiones ([3]).
    sea k = i + 6
    mientras (k < longitud(campos)) {
        si (campos[k][0] == 163) {
            sea exts = _bl_hijos(der, _bl_hijos(der, campos[k])[0])
            para e en exts {
                sea eh = _bl_hijos(der, e)
                sea oid = _BL_OID[_bl_oid_texto(_bl_cont(der, eh[0]))] ?? ""
                sea valor = _bl_cont(der, eh[longitud(eh) - 1])
                si (oid == "san") {
                    sea st = _bl_leer(valor, 0)
                    para n en _bl_hijos(valor, st) {
                        si (n[0] == 130) { r["nombres"].agregar(texto_minusculas(_bl_cont(valor, n))) }
                        si (n[0] == 135) { r["ips"].agregar(_bl_cont(valor, n)) }
                    }
                } sino si (oid == "basicos") {
                    sea st = _bl_leer(valor, 0)
                    para n en _bl_hijos(valor, st) {
                        si (n[0] == 1) { r["ca"] = byte_en(_bl_cont(valor, n), 0) != 0 }
                        si (n[0] == 2) { r["largo_ruta"] = byte_en(_bl_cont(valor, n), 0) }
                    }
                } sino si (oid == "usos") {
                    sea b = valor
                    sea bs = _bl_leer(b, 0)
                    r["usos"] = subtexto(b, bs[1] + 1, bs[3])
                }
            }
        }
        k = k + 1
    }
    retornar r
}

funcion _bl_inicio_tlv(d, t) { retornar t[4] }

funcion _bl_clave_publica(d, spki_t) {
    sea h = _bl_hijos(d, spki_t)
    sea alg_h = _bl_hijos(d, h[0])
    sea tipo_c = _BL_OID[_bl_oid_texto(_bl_cont(d, alg_h[0]))] ?? "?"
    sea bits = _bl_cont(d, h[1])
    bits = subtexto(bits, 1, longitud(bits))
    si (tipo_c == "rsa" o tipo_c == "rsa_pss") {
        sea st = _bl_leer(bits, 0)
        sea ne = _bl_hijos(bits, st)
        retornar {"tipo": "rsa", "n": _bl_cont(bits, ne[0]), "e": _bl_cont(bits, ne[1]), "bits": (longitud(_bl_sin_ceros(_bl_cont(bits, ne[0])))) * 8}
    }
    si (tipo_c == "ec") {
        sea curva = _BL_OID[_bl_oid_texto(_bl_cont(d, alg_h[1]))] ?? "?"
        retornar {"tipo": "ec", "curva": curva, "punto": bits}
    }
    si (tipo_c == "ed25519") { retornar {"tipo": "ed25519", "punto": bits} }
    retornar {"tipo": tipo_c}
}

funcion _bl_sin_ceros(b) {
    sea x = b
    mientras (longitud(x) > 1 y byte_en(x, 0) == 0) { x = subtexto(x, 1, longitud(x)) }
    retornar x
}

// Verifica una firma con una clave pública según el algoritmo (nombres de X.509 o de TLS).
funcion _bl_verificar(clave, alg, msj, firma) {
    intentar {
        si (alg == "ed25519") { retornar clave["tipo"] == "ed25519" y ed25519_verificar(clave["punto"], msj, firma) }
        si (texto_empieza_con(alg, "ecdsa_")) {
            si (clave["tipo"] != "ec") { retornar falso }
            sea h = 256
            si (texto_termina_con(alg, "384")) { h = 384 }
            si (texto_termina_con(alg, "512")) { h = 512 }
            retornar _bl_ecdsa(_bl_curva(clave["curva"]), clave["punto"], _bl_hash(h, msj), firma)
        }
        si (texto_empieza_con(alg, "rsa_pss_")) {
            si (clave["tipo"] != "rsa") { retornar falso }
            sea h = 256
            si (texto_termina_con(alg, "384")) { h = 384 }
            si (texto_termina_con(alg, "512")) { h = 512 }
            retornar _bl_rsa_pss(clave, h, msj, firma)
        }
        si (texto_empieza_con(alg, "rsa_")) {
            si (clave["tipo"] != "rsa") { retornar falso }
            sea h = 256
            si (texto_termina_con(alg, "384")) { h = 384 }
            si (texto_termina_con(alg, "512")) { h = 512 }
            retornar _bl_rsa_pkcs1(clave, h, msj, firma)
        }
    } capturar (e) { retornar falso }
    retornar falso
}

// ---------- raíces y cadena ----------

sea _BL_RAICES = {}

/// Raíces de confianza: de un PEM dado o del sistema (las primeras rutas
/// que existan de Linux, macOS o BSD).
funcion blindaje_raices(pem) {
    si (pem != nulo) {
        sea r = []
        para d en blindaje_pem(pem, "CERTIFICATE") { intentar { r.agregar(blindaje_certificado(d)) } capturar (e) { } }
        retornar r
    }
    si (tiene_clave(_BL_RAICES, "sistema")) { retornar _BL_RAICES["sistema"] }
    sea rutas = ["/etc/ssl/certs/ca-certificates.crt", "/etc/pki/tls/certs/ca-bundle.crt", "/etc/ssl/ca-bundle.pem", "/etc/ssl/cert.pem", "/usr/local/etc/openssl/cert.pem", "/opt/homebrew/etc/openssl@3/cert.pem"]
    sea r = []
    para ruta en rutas {
        si (longitud(r) == 0 y existe_archivo(ruta)) {
            para d en blindaje_pem(leer_archivo(ruta), "CERTIFICATE") { intentar { r.agregar(blindaje_certificado(d)) } capturar (e) { } }
        }
    }
    _BL_RAICES["sistema"] = r
    retornar r
}

funcion _bl_coincide_nombre(patron, nombre) {
    sea p = texto_minusculas(patron)
    sea n = texto_minusculas(nombre)
    si (p == n) { retornar verdadero }
    si (texto_empieza_con(p, "*.")) {
        sea punto = texto_indice(n, ".")
        si (punto <= 0) { retornar falso }
        retornar subtexto(n, punto, longitud(n)) == subtexto(p, 1, longitud(p))
    }
    retornar falso
}

/// ¿El certificado vale para ese nombre (SAN, o CN si no hay SAN)?
funcion blindaje_nombre_valido(cert, nombre) {
    // IP literal.
    sea partes = texto_dividir(nombre, ".")
    si (longitud(partes) == 4 y longitud(cert["ips"]) > 0) {
        sea ip = ""
        sea ok = verdadero
        para p en partes {
            si (_bl_digitos(p) == falso) { ok = falso } sino { ip = ip + char_de(a_numero(p) % 256) }
        }
        si (ok) { para x en cert["ips"] { si (x == ip) { retornar verdadero } } }
    }
    si (longitud(cert["nombres"]) > 0) {
        para n en cert["nombres"] { si (_bl_coincide_nombre(n, nombre)) { retornar verdadero } }
        retornar falso
    }
    retornar _bl_coincide_nombre(cert["sujeto"]["CN"] ?? "", nombre)
}

/// Verifica la cadena (hoja primero) hasta una raíz de confianza, las
/// fechas (ahora: segundos Unix; nulo = hora actual) y el nombre. Devuelve
/// nulo si está bien o el motivo del rechazo.
funcion blindaje_verificar_cadena(cadena, raices, nombre, ahora) {
    si (longitud(cadena) == 0) { retornar "el servidor no mandó certificados" }
    sea t = ahora ?? piso(tiempo_ms() / 1000)
    sea hoja = cadena[0]
    si (nombre != nulo y nombre != "" y blindaje_nombre_valido(hoja, nombre) == falso) { retornar "el certificado no es para " + nombre + " (es para " + unir(hoja["nombres"], ", ") + hoja["sujeto"]["texto"] + ")" }
    sea actual = hoja
    sea usados = 0
    mientras (usados < 10) {
        si (t < actual["desde"]) { retornar "certificado todavía no válido: " + actual["sujeto"]["texto"] }
        si (t > actual["hasta"]) { retornar "certificado vencido: " + actual["sujeto"]["texto"] }
        // ¿Lo firmó directamente una raíz?
        para r en raices {
            si (r["sujeto"]["texto"] == actual["emisor"]["texto"] y _bl_verificar(r["clave"], actual["alg_firma"], actual["tbs"], actual["firma"])) { retornar nulo }
            // La propia raíz en la cadena.
            si (r["der"] == actual["der"]) { retornar nulo }
        }
        // Siguiente de la cadena que lo firmó.
        sea sig = nulo
        para c en cadena {
            si (sig == nulo y c["der"] != actual["der"] y c["sujeto"]["texto"] == actual["emisor"]["texto"] y c["ca"] y _bl_verificar(c["clave"], actual["alg_firma"], actual["tbs"], actual["firma"])) { sig = c }
        }
        si (sig == nulo) { retornar "la cadena no llega a una raíz de confianza (emisor: " + actual["emisor"]["texto"] + ")" }
        actual = sig
        usados = usados + 1
    }
    retornar "cadena demasiado larga"
}

// ---------- TLS 1.3 ----------

sea _BL_SUITES = {"4865": {"nombre": "TLS_AES_128_GCM_SHA256", "aead": "aes", "klen": 16, "hash": 256},
    "4866": {"nombre": "TLS_AES_256_GCM_SHA384", "aead": "aes", "klen": 32, "hash": 384},
    "4867": {"nombre": "TLS_CHACHA20_POLY1305_SHA256", "aead": "chacha", "klen": 32, "hash": 256}}
sea _BL_ESQUEMAS = {"1027": "ecdsa_sha256", "1283": "ecdsa_sha384", "1539": "ecdsa_sha512", "2052": "rsa_pss_sha256", "2053": "rsa_pss_sha384", "2054": "rsa_pss_sha512",
    "2057": "rsa_pss_sha256", "2058": "rsa_pss_sha384", "2059": "rsa_pss_sha512", "2055": "ed25519", "1025": "rsa_sha256", "1281": "rsa_sha384", "1537": "rsa_sha512"}
sea _BL_HRR = "cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c"
sea _BL_ALERTAS = {"0": "close_notify", "10": "unexpected_message", "20": "bad_record_mac", "40": "handshake_failure", "42": "bad_certificate", "43": "unsupported_certificate",
    "45": "certificate_expired", "46": "certificate_unknown", "47": "illegal_parameter", "48": "unknown_ca", "50": "decode_error", "51": "decrypt_error", "70": "protocol_version",
    "80": "internal_error", "109": "missing_extension", "110": "unsupported_extension", "112": "unrecognized_name", "116": "certificate_required", "120": "no_application_protocol"}

funcion _bl_conexion(rol, op) {
    sea c = {"rol": rol, "op": op, "estado": "inicio", "transcripcion": "", "entrada": "", "hs": "", "salida": "", "app": "", "leer": nulo, "escribir": nulo,
        "quic": op["quic"] ?? falso, "quic_salida": {"inicial": "", "handshake": "", "aplicacion": ""}, "quic_hs": {"inicial": "", "handshake": "", "aplicacion": ""},
        "secretos": {}, "cerrado_par": falso, "cerrado": falso, "alpn": nulo, "sni": nulo, "cadena_par": [], "hrr": falso, "error": nulo, "nivel_leer": "inicial"}
    retornar c
}

funcion _bl_fallar(c, alerta, msj) {
    c["error"] = msj
    si (c["quic"] == falso y c["cerrado"] == falso) {
        intentar { _bl_registro(c, 21, char_de(2) + char_de(alerta)) } capturar (e) { }
    }
    c["cerrado"] = verdadero
    lanzar "blindaje: " + msj
}

// ---------- registros ----------

funcion _bl_nonce(k) {
    sea s = bytes_entero(k["sec"], 8, 0)
    retornar _bl_xor(k["iv"], _bl_ceros(4) + s)
}

funcion _bl_sellar(k, aad, texto) {
    sea n = _bl_nonce(k)
    k["sec"] = k["sec"] + 1
    si (k["aead"] == "aes") { retornar aes_gcm_cifrar(k["clave"], n, texto, aad) }
    retornar chacha20_poly1305_cifrar(k["clave"], n, texto, aad)
}

funcion _bl_abrir(k, aad, cifrado) {
    sea n = _bl_nonce(k)
    k["sec"] = k["sec"] + 1
    si (k["aead"] == "aes") { retornar aes_gcm_descifrar(k["clave"], n, cifrado, aad) }
    retornar chacha20_poly1305_descifrar(k["clave"], n, cifrado, aad)
}

funcion _bl_claves(c, secreto) {
    sea s = c["suite"]
    retornar {"secreto": secreto, "clave": blindaje_expandir_etiqueta(s["hash"], secreto, "key", "", s["klen"]), "iv": blindaje_expandir_etiqueta(s["hash"], secreto, "iv", "", 12), "sec": 0, "aead": s["aead"]}
}

// Envía un registro (cifrado si ya hay claves).
funcion _bl_registro(c, tipo_r, datos) {
    sea p = 0
    mientras (p < longitud(datos) o (longitud(datos) == 0 y p == 0)) {
        sea trozo = subtexto(datos, p, minimo(longitud(datos), p + 16384))
        si (c["escribir"] == nulo o tipo_r == 20) {
            sea version = (char_de(3) + char_de(3))
            si (c["estado"] == "inicio" y c["rol"] == "cliente") { version = (char_de(3) + char_de(1)) }
            c["salida"] = c["salida"] + char_de(tipo_r) + version + _bl_v16(trozo)
        } sino {
            sea interno = trozo + char_de(tipo_r)
            sea aad = char_de(23) + (char_de(3) + char_de(3)) + _bl_u16(longitud(interno) + 16)
            c["salida"] = c["salida"] + aad + _bl_sellar(c["escribir"], aad, interno)
        }
        p = p + 16384
        si (longitud(datos) == 0) { romper }
    }
}

funcion _bl_mensaje(tipo_m, cuerpo) { retornar char_de(tipo_m) + _bl_v24(cuerpo) }

// Envía un mensaje de handshake y lo agrega a la transcripción.
funcion _bl_enviar_hs(c, msj, nivel) {
    c["transcripcion"] = c["transcripcion"] + msj
    si (c["quic"]) { c["quic_salida"][nivel] = c["quic_salida"][nivel] + msj } sino { _bl_registro(c, 22, msj) }
}

/// Bytes pendientes de enviar (y los quita).
funcion blindaje_salida(c) {
    sea s = c["salida"]
    c["salida"] = ""
    retornar s
}

/// Datos de la aplicación recibidos (y los quita).
funcion blindaje_leer(c) {
    sea s = c["app"]
    c["app"] = ""
    retornar s
}

/// ¿Terminó el handshake?
funcion blindaje_listo(c) { retornar c["estado"] == "conectado" }

/// Cifra datos de la aplicación para enviarlos.
funcion blindaje_escribir(c, datos) {
    si (c["estado"] != "conectado") { lanzar "blindaje: el handshake no terminó" }
    si (c["cerrado"]) { lanzar "blindaje: la conexión está cerrada" }
    _bl_registro(c, 23, datos)
}

/// Avisa el cierre (close_notify).
funcion blindaje_aviso_cierre(c) {
    si (c["cerrado"] == falso) {
        _bl_registro(c, 21, char_de(1) + char_de(0))
        c["cerrado"] = verdadero
    }
}

/// Pide renovar las claves (KeyUpdate); solicitar: que el otro también renueve.
funcion blindaje_renovar_claves(c, solicitar) {
    sea v = 0
    si (solicitar) { v = 1 }
    _bl_registro(c, 22, _bl_mensaje(24, char_de(v)))
    _bl_actualizar(c, "escribir")
}

funcion _bl_actualizar(c, lado) {
    sea s = c["suite"]
    sea nuevo = blindaje_expandir_etiqueta(s["hash"], c[lado]["secreto"], "traffic upd", "", _bl_hlen(s["hash"]))
    c[lado] = _bl_claves(c, nuevo)
}

/// Procesa bytes recibidos de la red.
funcion blindaje_entrada(c, datos) {
    c["entrada"] = c["entrada"] + datos
    mientras (longitud(c["entrada"]) >= 5) {
        sea d = c["entrada"]
        sea tipo_r = byte_en(d, 0)
        sea largo = _bl_l16(d, 3)
        si (largo > 16384 + 256) { _bl_fallar(c, 22, "registro demasiado largo") }
        si (longitud(d) < 5 + largo) { romper }
        sea cuerpo = subtexto(d, 5, 5 + largo)
        c["entrada"] = subtexto(d, 5 + largo, longitud(d))
        si (tipo_r == 20) {
            // ChangeCipherSpec de compatibilidad: se ignora.
        } sino si (tipo_r == 23 y c["leer"] != nulo) {
            sea plano = ""
            intentar { plano = _bl_abrir(c["leer"], subtexto(d, 0, 5), cuerpo) } capturar (e) { _bl_fallar(c, 20, "no se pudo descifrar un registro (bad_record_mac)") }
            // Quita el relleno de ceros y saca el tipo interno.
            sea n = longitud(plano)
            mientras (n > 0 y byte_en(plano, n - 1) == 0) { n = n - 1 }
            si (n == 0) { _bl_fallar(c, 10, "registro interno vacío") }
            sea interno = byte_en(plano, n - 1)
            _bl_despachar(c, interno, subtexto(plano, 0, n - 1))
        } sino si (tipo_r == 22 y c["leer"] == nulo) {
            _bl_despachar(c, 22, cuerpo)
        } sino si (tipo_r == 21 y c["leer"] == nulo) {
            _bl_despachar(c, 21, cuerpo)
        } sino { _bl_fallar(c, 10, "registro inesperado de tipo " + tipo_r) }
    }
}

funcion _bl_despachar(c, tipo_r, datos) {
    si (tipo_r == 21) {
        sea nivel = byte_en(datos, 0)
        sea desc = byte_en(datos, 1)
        si (desc == 0) {
            c["cerrado_par"] = verdadero
            retornar nulo
        }
        c["cerrado"] = verdadero
        c["error"] = "alerta del otro lado: " + (_BL_ALERTAS["" + desc] ?? ("" + desc))
        lanzar "blindaje: " + c["error"]
    }
    si (tipo_r == 23) {
        si (c["estado"] != "conectado") { _bl_fallar(c, 10, "datos antes de terminar el handshake") }
        c["app"] = c["app"] + datos
        retornar nulo
    }
    si (tipo_r != 22) { _bl_fallar(c, 10, "tipo de contenido desconocido") }
    c["hs"] = c["hs"] + datos
    _bl_mensajes(c, "hs")
}

/// Modo QUIC: datos de handshake recibidos en un nivel ("inicial",
/// "handshake" o "aplicacion").
funcion blindaje_quic_recibir(c, nivel, datos) {
    c["quic_hs"][nivel] = c["quic_hs"][nivel] + datos
    c["nivel_leer"] = nivel
    _bl_mensajes_quic(c, nivel)
}

/// Modo QUIC: mensajes de handshake para enviar en un nivel (y los quita).
funcion blindaje_quic_salida(c, nivel) {
    sea s = c["quic_salida"][nivel]
    c["quic_salida"][nivel] = ""
    retornar s
}

/// Modo QUIC: secretos por nivel {"handshake"/"aplicacion": {"cliente", "servidor"}} y el hash.
funcion blindaje_quic_secretos(c) { retornar c["secretos"] }

funcion _bl_mensajes_quic(c, nivel) {
    mientras (longitud(c["quic_hs"][nivel]) >= 4) {
        sea d = c["quic_hs"][nivel]
        sea largo = _bl_l24(d, 1)
        si (longitud(d) < 4 + largo) { romper }
        sea msj = subtexto(d, 0, 4 + largo)
        c["quic_hs"][nivel] = subtexto(d, 4 + largo, longitud(d))
        _bl_procesar(c, byte_en(msj, 0), subtexto(msj, 4, longitud(msj)), msj)
    }
}

funcion _bl_mensajes(c, campo) {
    mientras (longitud(c[campo]) >= 4) {
        sea d = c[campo]
        sea largo = _bl_l24(d, 1)
        si (longitud(d) < 4 + largo) { romper }
        sea msj = subtexto(d, 0, 4 + largo)
        c[campo] = subtexto(d, 4 + largo, longitud(d))
        _bl_procesar(c, byte_en(msj, 0), subtexto(msj, 4, longitud(msj)), msj)
    }
}

// Extensiones: mapa de número a contenido.
funcion _bl_extensiones(d) {
    sea r = {}
    sea p = 0
    mientras (p + 4 <= longitud(d)) {
        sea t = _bl_l16(d, p)
        sea l = _bl_l16(d, p + 2)
        r["" + t] = subtexto(d, p + 4, p + 4 + l)
        p = p + 4 + l
    }
    retornar r
}

funcion _bl_ext(t, cuerpo) { retornar _bl_u16(t) + _bl_v16(cuerpo) }

funcion _bl_procesar(c, tipo_m, cuerpo, msj) {
    si (c["rol"] == "cliente") { _bl_cliente_msj(c, tipo_m, cuerpo, msj) } sino { _bl_servidor_msj(c, tipo_m, cuerpo, msj) }
}

// ---------- cliente ----------

funcion _bl_grupos_op(op) { retornar op["grupos"] ?? ["x25519", "P-256"] }
sea _BL_GRUPO_ID = {"x25519": 29, "P-256": 23, "P-384": 24}
sea _BL_GRUPO_NOMBRE = {"29": "x25519", "23": "P-256", "24": "P-384"}

funcion _bl_par_grupo(g) {
    si (g == "x25519") {
        sea s = bytes_aleatorios(32)
        retornar {"grupo": g, "privada": s, "publica": x25519_base(s)}
    }
    sea p = _bl_ec_par(_bl_curva(g))
    p["grupo"] = g
    retornar p
}

funcion _bl_compartido(par, pub) {
    si (par["grupo"] == "x25519") {
        si (longitud(pub) != 32) { lanzar "blindaje: clave X25519 inválida" }
        sea s = x25519(par["privada"], pub)
        si (s == _bl_ceros(32)) { lanzar "blindaje: secreto X25519 nulo" }
        retornar s
    }
    retornar _bl_ecdh(_bl_curva(par["grupo"]), par["privada"], pub)
}

/// Crea una conexión cliente (sin E/S). opciones: "raices" (PEM), "verificar"
/// (falso para no verificar el certificado), "alpn" (lista), "suites"
/// (lista de números), "grupos" (["x25519", "P-256"]), "quic" y
/// "quic_parametros" (bytes de transport_parameters), "ahora" (segundos).
funcion blindaje_cliente(nombre_servidor, opciones) {
    sea op = opciones ?? {}
    sea c = _bl_conexion("cliente", op)
    c["sni"] = nombre_servidor
    c["aleatorio"] = bytes_aleatorios(32)
    c["sesion"] = ""
    si (c["quic"] == falso) { c["sesion"] = bytes_aleatorios(32) }
    sea grupos = _bl_grupos_op(op)
    c["par"] = _bl_par_grupo(grupos[0])
    _bl_enviar_ch(c, nulo)
    c["estado"] = "esperando_sh"
    retornar c
}

funcion _bl_enviar_ch(c, cookie) {
    sea op = c["op"]
    sea suites = op["suites"] ?? [4865, 4867, 4866]
    sea ss = ""
    para s en suites { ss = ss + _bl_u16(s) }
    sea exts = ""
    si (c["sni"] != nulo y c["sni"] != "" y _bl_es_ip(c["sni"]) == falso) { exts = exts + _bl_ext(0, _bl_v16(char_de(0) + _bl_v16(c["sni"]))) }
    sea gs = ""
    para g en _bl_grupos_op(op) { gs = gs + _bl_u16(_BL_GRUPO_ID[g]) }
    exts = exts + _bl_ext(10, _bl_v16(gs))
    sea alg = ""
    para a en [2055, 1027, 1283, 2052, 2053, 2054, 1025, 1281, 1537] { alg = alg + _bl_u16(a) }
    exts = exts + _bl_ext(13, _bl_v16(alg))
    si (tiene_clave(op, "alpn")) {
        sea l = ""
        para p en op["alpn"] { l = l + _bl_v8(p) }
        exts = exts + _bl_ext(16, _bl_v16(l))
    }
    exts = exts + _bl_ext(43, _bl_v8((char_de(3) + char_de(4))))
    exts = exts + _bl_ext(45, _bl_v8(char_de(1)))
    exts = exts + _bl_ext(51, _bl_v16(_bl_u16(_BL_GRUPO_ID[c["par"]["grupo"]]) + _bl_v16(c["par"]["publica"])))
    si (cookie != nulo) { exts = exts + _bl_ext(44, cookie) }
    si (c["quic"]) { exts = exts + _bl_ext(57, op["quic_parametros"] ?? "") }
    sea cuerpo = (char_de(3) + char_de(3)) + c["aleatorio"] + _bl_v8(c["sesion"]) + _bl_v16(ss) + (char_de(1) + char_de(0)) + _bl_v16(exts)
    _bl_enviar_hs(c, _bl_mensaje(1, cuerpo), "inicial")
}

funcion _bl_es_ip(n) {
    sea p = texto_dividir(n, ".")
    si (longitud(p) != 4) { retornar contiene(n, ":") }
    para x en p { si (_bl_digitos(x) == falso) { retornar falso } }
    retornar verdadero
}

funcion _bl_digitos(t) {
    si (longitud(t) == 0 o longitud(t) > 3) { retornar falso }
    sea i = 0
    mientras (i < longitud(t)) {
        sea b = byte_en(t, i)
        si (b < 48 o b > 57) { retornar falso }
        i = i + 1
    }
    retornar verdadero
}

funcion _bl_cliente_msj(c, tipo_m, cuerpo, msj) {
    sea st = c["estado"]
    si (tipo_m == 2 y st == "esperando_sh") {
        sea aleatorio = subtexto(cuerpo, 2, 34)
        sea ls = byte_en(cuerpo, 34)
        sea p = 35 + ls
        sea suite = _bl_l16(cuerpo, p)
        sea exts = _bl_extensiones(subtexto(cuerpo, p + 5, longitud(cuerpo)))
        si (tiene_clave(_BL_SUITES, "" + suite) == falso o contiene(c["op"]["suites"] ?? [4865, 4867, 4866], suite) == falso) { _bl_fallar(c, 47, "el servidor eligió una suite que no se ofreció") }
        si ((exts["43"] ?? "") != (char_de(3) + char_de(4))) { _bl_fallar(c, 70, "el servidor no habla TLS 1.3") }
        c["suite"] = _BL_SUITES["" + suite]
        c["suite_id"] = suite
        sea alg = c["suite"]["hash"]
        si (hex_de_bytes(aleatorio) == _BL_HRR) {
            // HelloRetryRequest: otro grupo y quizás una cookie.
            si (c["hrr"]) { _bl_fallar(c, 10, "segundo HelloRetryRequest") }
            c["hrr"] = verdadero
            sea g = _BL_GRUPO_NOMBRE["" + _bl_l16(exts["51"] ?? (char_de(0) + char_de(0)), 0)] ?? nulo
            si (g == nulo o contiene(_bl_grupos_op(c["op"]), g) == falso o g == c["par"]["grupo"]) { _bl_fallar(c, 47, "HelloRetryRequest con un grupo no ofrecido") }
            c["par"] = _bl_par_grupo(g)
            c["transcripcion"] = _bl_mensaje(254, _bl_hash(alg, c["transcripcion"])) + msj
            _bl_enviar_ch(c, exts["44"] ?? nulo)
            retornar nulo
        }
        sea ks = exts["51"] ?? ""
        si (longitud(ks) < 4) { _bl_fallar(c, 109, "falta key_share") }
        sea g = _BL_GRUPO_NOMBRE["" + _bl_l16(ks, 0)] ?? ""
        si (g != c["par"]["grupo"]) { _bl_fallar(c, 47, "key_share de otro grupo") }
        sea compartido = _bl_compartido(c["par"], subtexto(ks, 4, 4 + _bl_l16(ks, 2)))
        c["grupo"] = g
        c["transcripcion"] = c["transcripcion"] + msj
        _bl_secretos_hs(c, compartido)
        c["leer"] = _bl_claves(c, c["secretos"]["handshake"]["servidor"])
        c["estado"] = "esperando_ee"
        c["nivel_escribir"] = "handshake"
        retornar nulo
    }
    si (tipo_m == 8 y st == "esperando_ee") {
        c["transcripcion"] = c["transcripcion"] + msj
        sea exts = _bl_extensiones(subtexto(cuerpo, 2, longitud(cuerpo)))
        si (tiene_clave(exts, "16")) {
            sea a = exts["16"]
            c["alpn"] = subtexto(a, 3, 3 + byte_en(a, 2))
            si (contiene(c["op"]["alpn"] ?? [], c["alpn"]) == falso) { _bl_fallar(c, 120, "ALPN no ofrecido") }
        }
        si (tiene_clave(exts, "57")) { c["quic_parametros_par"] = exts["57"] }
        c["estado"] = "esperando_cert"
        retornar nulo
    }
    si (tipo_m == 13 y st == "esperando_cert") {
        c["transcripcion"] = c["transcripcion"] + msj
        c["pide_cert"] = subtexto(cuerpo, 1, 1 + byte_en(cuerpo, 0))
        retornar nulo
    }
    si (tipo_m == 11 y st == "esperando_cert") {
        c["transcripcion"] = c["transcripcion"] + msj
        sea ctx = byte_en(cuerpo, 0)
        sea p = 1 + ctx
        sea total = _bl_l24(cuerpo, p)
        p = p + 3
        sea fin = p + total
        sea cadena = []
        mientras (p < fin) {
            sea l = _bl_l24(cuerpo, p)
            sea der = subtexto(cuerpo, p + 3, p + 3 + l)
            p = p + 3 + l
            sea le = _bl_l16(cuerpo, p)
            p = p + 2 + le
            intentar { cadena.agregar(blindaje_certificado(der)) } capturar (e) { _bl_fallar(c, 42, "certificado ilegible: " + e) }
        }
        c["cadena_par"] = cadena
        si ((c["op"]["verificar"] ?? verdadero) != falso) {
            sea raices = blindaje_raices(c["op"]["raices"] ?? nulo)
            sea motivo = blindaje_verificar_cadena(cadena, raices, c["sni"], c["op"]["ahora"] ?? nulo)
            si (motivo != nulo) {
                sea alerta = 42
                si (contiene(motivo, "vencido")) { alerta = 45 }
                si (contiene(motivo, "raíz")) { alerta = 48 }
                _bl_fallar(c, alerta, motivo)
            }
        }
        c["estado"] = "esperando_cv"
        retornar nulo
    }
    si (tipo_m == 15 y st == "esperando_cv") {
        sea esquema = _bl_l16(cuerpo, 0)
        sea firma = subtexto(cuerpo, 4, 4 + _bl_l16(cuerpo, 2))
        sea alg = c["suite"]["hash"]
        sea contenido = _bl_repetir(" ", 64) + "TLS 1.3, server CertificateVerify" + char_de(0) + _bl_hash(alg, c["transcripcion"])
        sea nombre = _BL_ESQUEMAS["" + esquema] ?? nulo
        si (nombre == nulo o texto_empieza_con(nombre, "rsa_sha")) { _bl_fallar(c, 47, "esquema de firma no permitido: " + esquema) }
        si (longitud(c["cadena_par"]) == 0 o _bl_verificar(c["cadena_par"][0]["clave"], nombre, contenido, firma) == falso) { _bl_fallar(c, 51, "la firma del servidor (CertificateVerify) no es válida") }
        c["esquema"] = nombre
        c["transcripcion"] = c["transcripcion"] + msj
        c["estado"] = "esperando_fin"
        retornar nulo
    }
    si (tipo_m == 20 y (st == "esperando_fin" o (st == "esperando_cert" y c["op"]["psk"] != nulo))) {
        sea alg = c["suite"]["hash"]
        sea esperado = _bl_finished(alg, c["secretos"]["handshake"]["servidor"], c["transcripcion"])
        si (comparar_seguro(cuerpo, esperado) == falso) { _bl_fallar(c, 51, "Finished del servidor inválido") }
        c["transcripcion"] = c["transcripcion"] + msj
        _bl_secretos_app(c)
        // CCS de compatibilidad, certificado vacío si lo pidieron y Finished.
        si (c["quic"] == falso) { _bl_registro(c, 20, char_de(1)) }
        c["escribir"] = _bl_claves(c, c["secretos"]["handshake"]["cliente"])
        si (tiene_clave(c, "pide_cert")) { _bl_enviar_hs(c, _bl_mensaje(11, _bl_v8(c["pide_cert"]) + _bl_v24("")), "handshake") }
        sea fin = _bl_finished(alg, c["secretos"]["handshake"]["cliente"], c["transcripcion"])
        _bl_enviar_hs(c, _bl_mensaje(20, fin), "handshake")
        c["escribir"] = _bl_claves(c, c["secretos"]["aplicacion"]["cliente"])
        c["leer"] = _bl_claves(c, c["secretos"]["aplicacion"]["servidor"])
        c["estado"] = "conectado"
        retornar nulo
    }
    si (st == "conectado") {
        si (tipo_m == 4) { retornar nulo }
        si (tipo_m == 24) {
            _bl_actualizar(c, "leer")
            si (byte_en(cuerpo, 0) == 1) { blindaje_renovar_claves(c, falso) }
            retornar nulo
        }
    }
    _bl_fallar(c, 10, "mensaje de handshake inesperado " + tipo_m + " en " + st)
}

funcion _bl_repetir(t, n) {
    sea r = ""
    sea i = 0
    mientras (i < n) {
        r = r + t
        i = i + 1
    }
    retornar r
}

funcion _bl_finished(alg, base, transcripcion) {
    sea clave = blindaje_expandir_etiqueta(alg, base, "finished", "", _bl_hlen(alg))
    retornar _bl_hmac(alg, clave, _bl_hash(alg, transcripcion))
}

funcion _bl_secretos_hs(c, compartido) {
    sea alg = c["suite"]["hash"]
    sea hl = _bl_hlen(alg)
    sea temprano = _bl_extraer(alg, "", _bl_ceros(hl))
    sea derivado = _bl_derivar(alg, temprano, "derived", "")
    sea hs = _bl_extraer(alg, derivado, compartido)
    c["secreto_hs"] = hs
    c["secretos"]["hash"] = alg
    c["secretos"]["suite"] = c["suite"]
    c["secretos"]["handshake"] = {"cliente": _bl_derivar(alg, hs, "c hs traffic", c["transcripcion"]), "servidor": _bl_derivar(alg, hs, "s hs traffic", c["transcripcion"])}
}

funcion _bl_secretos_app(c) {
    sea alg = c["suite"]["hash"]
    sea hl = _bl_hlen(alg)
    sea derivado = _bl_derivar(alg, c["secreto_hs"], "derived", "")
    sea maestro = _bl_extraer(alg, derivado, _bl_ceros(hl))
    c["secretos"]["aplicacion"] = {"cliente": _bl_derivar(alg, maestro, "c ap traffic", c["transcripcion"]), "servidor": _bl_derivar(alg, maestro, "s ap traffic", c["transcripcion"])}
    c["secretos"]["exportador"] = _bl_derivar(alg, maestro, "exp master", c["transcripcion"])
}

/// Exportador de claves (RFC 8446 7.5).
funcion blindaje_exportar(c, etiqueta, contexto, largo) {
    sea alg = c["suite"]["hash"]
    sea s = _bl_derivar(alg, c["secretos"]["exportador"], etiqueta, "")
    retornar blindaje_expandir_etiqueta(alg, s, "exporter", _bl_hash(alg, contexto ?? ""), largo)
}

// ---------- servidor ----------

/// Crea una conexión servidor (sin E/S). opciones: "cadena" (lista de
/// certificados DER, hoja primero), "clave" ({"tipo": "ed25519",
/// "semilla"} o {"tipo": "ec", "curva": "P-256", "privada"}), "alpn"
/// (preferencias), "suites", "grupos", "quic", "quic_parametros".
funcion blindaje_servidor(opciones) {
    sea op = opciones ?? {}
    si (tiene_clave(op, "cadena") == falso o tiene_clave(op, "clave") == falso) { lanzar "blindaje: el servidor necesita 'cadena' y 'clave' (ver blindaje_autofirmado)" }
    sea c = _bl_conexion("servidor", op)
    c["estado"] = "esperando_ch"
    retornar c
}

funcion _bl_servidor_msj(c, tipo_m, cuerpo, msj) {
    sea st = c["estado"]
    si (tipo_m == 1 y (st == "esperando_ch" o st == "esperando_ch2")) {
        sea op = c["op"]
        sea p = 34
        sea ls = byte_en(cuerpo, p)
        c["sesion"] = subtexto(cuerpo, p + 1, p + 1 + ls)
        p = p + 1 + ls
        sea ns = _bl_l16(cuerpo, p)
        sea ofrecidas = []
        sea k = 0
        mientras (k < ns) {
            ofrecidas.agregar(_bl_l16(cuerpo, p + 2 + k))
            k = k + 2
        }
        p = p + 2 + ns
        p = p + 1 + byte_en(cuerpo, p)
        sea exts = _bl_extensiones(subtexto(cuerpo, p + 2, p + 2 + _bl_l16(cuerpo, p)))
        // Versión.
        sea vs = exts["43"] ?? ""
        sea tiene13 = falso
        k = 1
        mientras (k + 1 < longitud(vs)) {
            si (_bl_l16(vs, k) == 772) { tiene13 = verdadero }
            k = k + 2
        }
        si (tiene13 == falso) { _bl_fallar(c, 70, "el cliente no ofrece TLS 1.3") }
        // Suite.
        sea suite = nulo
        para s en op["suites"] ?? [4865, 4867, 4866] { si (suite == nulo y contiene(ofrecidas, s)) { suite = s } }
        si (suite == nulo) { _bl_fallar(c, 40, "no hay suites en común") }
        si (st == "esperando_ch2" y suite != c["suite_id"]) { _bl_fallar(c, 47, "cambió la suite tras HelloRetryRequest") }
        c["suite"] = _BL_SUITES["" + suite]
        c["suite_id"] = suite
        sea alg = c["suite"]["hash"]
        // SNI y ALPN.
        si (tiene_clave(exts, "0")) {
            sea sn = exts["0"]
            c["sni"] = subtexto(sn, 5, 5 + _bl_l16(sn, 3))
        }
        si (tiene_clave(exts, "16") y tiene_clave(op, "alpn")) {
            sea a = exts["16"]
            sea lista = []
            sea q = 2
            mientras (q < longitud(a)) {
                sea l = byte_en(a, q)
                lista.agregar(subtexto(a, q + 1, q + 1 + l))
                q = q + 1 + l
            }
            para pref en op["alpn"] { si (c["alpn"] == nulo y contiene(lista, pref)) { c["alpn"] = pref } }
            si (c["alpn"] == nulo) { _bl_fallar(c, 120, "ningún protocolo ALPN en común") }
        }
        // Grupos y claves.
        sea mis = _bl_grupos_op(op)
        sea gs = exts["10"] ?? ""
        sea grupos_cli = []
        k = 2
        mientras (k + 1 < longitud(gs)) {
            grupos_cli.agregar(_BL_GRUPO_NOMBRE["" + _bl_l16(gs, k)] ?? "?")
            k = k + 2
        }
        sea compartes = {}
        sea ks = exts["51"] ?? ""
        k = 2
        mientras (k + 4 <= longitud(ks)) {
            sea gid = _bl_l16(ks, k)
            sea l = _bl_l16(ks, k + 2)
            compartes[_BL_GRUPO_NOMBRE["" + gid] ?? "?"] = subtexto(ks, k + 4, k + 4 + l)
            k = k + 4 + l
        }
        sea elegido = nulo
        para g en mis { si (elegido == nulo y tiene_clave(compartes, g)) { elegido = g } }
        si (elegido == nulo) {
            sea otro = nulo
            para g en mis { si (otro == nulo y contiene(grupos_cli, g)) { otro = g } }
            si (otro == nulo o st == "esperando_ch2") { _bl_fallar(c, 40, "no hay grupos en común") }
            // HelloRetryRequest.
            c["transcripcion"] = _bl_mensaje(254, _bl_hash(alg, msj))
            sea ext_hrr = _bl_ext(43, (char_de(3) + char_de(4))) + _bl_ext(51, _bl_u16(_BL_GRUPO_ID[otro]))
            sea hrr = (char_de(3) + char_de(3)) + bytes_de_hex(_BL_HRR) + _bl_v8(c["sesion"]) + _bl_u16(suite) + char_de(0) + _bl_v16(ext_hrr)
            _bl_enviar_hs(c, _bl_mensaje(2, hrr), "inicial")
            si (c["quic"] == falso) { _bl_registro(c, 20, char_de(1)) }
            c["ccs_enviado"] = verdadero
            c["estado"] = "esperando_ch2"
            retornar nulo
        }
        si (c["quic"] y tiene_clave(exts, "57")) { c["quic_parametros_par"] = exts["57"] }
        // Esquema de firma según la clave del certificado y lo que acepta el cliente.
        sea sa = exts["13"] ?? ""
        sea acepta = []
        k = 2
        mientras (k + 1 < longitud(sa)) {
            acepta.agregar(_bl_l16(sa, k))
            k = k + 2
        }
        sea clave = op["clave"]
        sea esquema = 2055
        si (clave["tipo"] == "ec") {
            esquema = 1027
            si ((clave["curva"] ?? "P-256") == "P-384") { esquema = 1283 }
        }
        si (contiene(acepta, esquema) == falso) { _bl_fallar(c, 40, "el cliente no acepta la firma de nuestro certificado") }
        // ServerHello.
        sea par = _bl_par_grupo(elegido)
        sea compartido = _bl_compartido(par, compartes[elegido])
        c["grupo"] = elegido
        c["transcripcion"] = c["transcripcion"] + msj
        sea ext_sh = _bl_ext(43, (char_de(3) + char_de(4))) + _bl_ext(51, _bl_u16(_BL_GRUPO_ID[elegido]) + _bl_v16(par["publica"]))
        sea sh = (char_de(3) + char_de(3)) + bytes_aleatorios(32) + _bl_v8(c["sesion"]) + _bl_u16(suite) + char_de(0) + _bl_v16(ext_sh)
        _bl_enviar_hs(c, _bl_mensaje(2, sh), "inicial")
        si (c["quic"] == falso y (c["ccs_enviado"] ?? falso) == falso) { _bl_registro(c, 20, char_de(1)) }
        _bl_secretos_hs(c, compartido)
        c["escribir"] = _bl_claves(c, c["secretos"]["handshake"]["servidor"])
        c["leer"] = _bl_claves(c, c["secretos"]["handshake"]["cliente"])
        // EncryptedExtensions.
        sea ee = ""
        si (c["alpn"] != nulo) { ee = ee + _bl_ext(16, _bl_v16(_bl_v8(c["alpn"]))) }
        si (c["quic"]) { ee = ee + _bl_ext(57, op["quic_parametros"] ?? "") }
        _bl_enviar_hs(c, _bl_mensaje(8, _bl_v16(ee)), "handshake")
        // Certificate.
        sea lista = ""
        para der en op["cadena"] { lista = lista + _bl_v24(der) + _bl_u16(0) }
        _bl_enviar_hs(c, _bl_mensaje(11, char_de(0) + _bl_v24(lista)), "handshake")
        // CertificateVerify.
        sea contenido = _bl_repetir(" ", 64) + "TLS 1.3, server CertificateVerify" + char_de(0) + _bl_hash(alg, c["transcripcion"])
        sea firma = ""
        si (clave["tipo"] == "ed25519") { firma = ed25519_firmar(clave["semilla"], contenido) }
        sino si (esquema == 1027) { firma = _bl_ecdsa_firmar(_bl_curva("P-256"), clave["privada"], sha256_bytes(contenido)) }
        sino { firma = _bl_ecdsa_firmar(_bl_curva("P-384"), clave["privada"], _bl_hash(384, contenido)) }
        _bl_enviar_hs(c, _bl_mensaje(15, _bl_u16(esquema) + _bl_v16(firma)), "handshake")
        // Finished.
        _bl_enviar_hs(c, _bl_mensaje(20, _bl_finished(alg, c["secretos"]["handshake"]["servidor"], c["transcripcion"])), "handshake")
        _bl_secretos_app(c)
        c["escribir"] = _bl_claves(c, c["secretos"]["aplicacion"]["servidor"])
        c["estado"] = "esperando_fin_cli"
        retornar nulo
    }
    si (tipo_m == 11 y st == "esperando_fin_cli") {
        // Certificado del cliente (no lo pedimos; se acepta vacío).
        c["transcripcion"] = c["transcripcion"] + msj
        retornar nulo
    }
    si (tipo_m == 20 y st == "esperando_fin_cli") {
        sea alg = c["suite"]["hash"]
        sea esperado = _bl_finished(alg, c["secretos"]["handshake"]["cliente"], c["transcripcion"])
        si (comparar_seguro(cuerpo, esperado) == falso) { _bl_fallar(c, 51, "Finished del cliente inválido") }
        c["transcripcion"] = c["transcripcion"] + msj
        c["leer"] = _bl_claves(c, c["secretos"]["aplicacion"]["cliente"])
        c["estado"] = "conectado"
        retornar nulo
    }
    si (st == "conectado" y tipo_m == 24) {
        _bl_actualizar(c, "leer")
        si (byte_en(cuerpo, 0) == 1) { blindaje_renovar_claves(c, falso) }
        retornar nulo
    }
    _bl_fallar(c, 10, "mensaje de handshake inesperado " + tipo_m + " en " + st)
}

/// Resumen de la conexión: versión, suite, grupo, ALPN, SNI, esquema de
/// firma y la cadena del otro lado.
funcion blindaje_info(c) {
    sea suite = nulo
    si (tiene_clave(c, "suite")) { suite = c["suite"]["nombre"] }
    retornar {"version": "TLSv1.3", "suite": suite, "grupo": c["grupo"] ?? nulo, "alpn": c["alpn"], "sni": c["sni"], "esquema": c["esquema"] ?? nulo,
        "certificados": c["cadena_par"], "reintento": c["hrr"], "estado": c["estado"]}
}

// ---------- certificados autofirmados y claves ----------

funcion _bl_nombre_der(cn) { retornar _bl_der_seq([_bl_tlv(49, _bl_der_seq([_bl_der_oid("2.5.4.3"), _bl_tlv(12, cn)]))]) }

funcion _bl_fecha_der(seg) {
    // GeneralizedTime AAAAMMDDhhmmssZ.
    sea dias = piso(seg / 86400)
    sea resto = seg - dias * 86400
    // Inverso de _bl_dias (Howard Hinnant).
    sea z = dias + 719468
    sea era = piso(z / 146097)
    sea doe = z - era * 146097
    sea yoe = piso((doe - piso(doe / 1460) + piso(doe / 36524) - piso(doe / 146096)) / 365)
    sea y = yoe + era * 400
    sea doy = doe - (365 * yoe + piso(yoe / 4) - piso(yoe / 100))
    sea mp = piso((5 * doy + 2) / 153)
    sea d = doy - piso((153 * mp + 2) / 5) + 1
    sea m = mp + 3
    si (m > 12) { m = m - 12 }
    si (m <= 2) { y = y + 1 }
    retornar _bl_tlv(24, "" + y + _bl_dos(m) + _bl_dos(d) + _bl_dos(piso(resto / 3600)) + _bl_dos(piso(resto / 60) % 60) + _bl_dos(resto % 60) + "Z")
}

funcion _bl_dos(n) {
    si (n < 10) { retornar "0" + n }
    retornar "" + n
}

/// Clave para el servidor: tipo "ed25519" (por defecto) o "P-256".
funcion blindaje_clave_nueva(tipo_clave) {
    si ((tipo_clave ?? "ed25519") == "ed25519") {
        sea s = bytes_aleatorios(32)
        retornar {"tipo": "ed25519", "semilla": s, "publica": ed25519_publica(s)}
    }
    sea par = _bl_ec_par(_bl_curva(tipo_clave))
    retornar {"tipo": "ec", "curva": tipo_clave, "privada": par["privada"], "publica": par["publica"]}
}

funcion _bl_spki(clave) {
    si (clave["tipo"] == "ed25519") { retornar _bl_der_seq([_bl_der_seq([_bl_der_oid("1.3.101.112")]), _bl_tlv(3, char_de(0) + clave["publica"])]) }
    sea oid_curva = "1.2.840.10045.3.1.7"
    si (clave["curva"] == "P-384") { oid_curva = "1.3.132.0.34" }
    retornar _bl_der_seq([_bl_der_seq([_bl_der_oid("1.2.840.10045.2.1"), _bl_der_oid(oid_curva)]), _bl_tlv(3, char_de(0) + clave["publica"])])
}

funcion _bl_firmar_x509(clave, tbs) {
    si (clave["tipo"] == "ed25519") { retornar [_bl_der_seq([_bl_der_oid("1.3.101.112")]), ed25519_firmar(clave["semilla"], tbs)] }
    si (clave["curva"] == "P-384") { retornar [_bl_der_seq([_bl_der_oid("1.2.840.10045.4.3.3")]), _bl_ecdsa_firmar(_bl_curva("P-384"), clave["privada"], _bl_hash(384, tbs))] }
    retornar [_bl_der_seq([_bl_der_oid("1.2.840.10045.4.3.2")]), _bl_ecdsa_firmar(_bl_curva("P-256"), clave["privada"], sha256_bytes(tbs))]
}

/// Emite un certificado X.509 v3 para nombres (el primero va como CN).
/// opciones: "clave" (de blindaje_clave_nueva; se crea una Ed25519 si no
/// hay), "emisor" ({"certificado": der, "clave"} para firmar con una CA;
/// sin emisor es autofirmado), "ca" (para emitir una CA), "dias" (365).
/// Devuelve {"der", "pem", "clave", "clave_pem"}.
funcion blindaje_emitir(nombres, opciones) {
    sea op = opciones ?? {}
    sea clave = op["clave"] ?? blindaje_clave_nueva("ed25519")
    sea ahora = piso(tiempo_ms() / 1000)
    sea dias = op["dias"] ?? 365
    sea cn = nombres[0]
    sea emisor_nombre = _bl_nombre_der(cn)
    sea clave_firma = clave
    sea emisor_cert = nulo
    si (tiene_clave(op, "emisor")) {
        emisor_cert = blindaje_certificado(op["emisor"]["certificado"])
        clave_firma = op["emisor"]["clave"]
        sea t = _bl_leer(op["emisor"]["certificado"], 0)
        sea h = _bl_hijos(op["emisor"]["certificado"], _bl_hijos(op["emisor"]["certificado"], t)[0])
        sea i = 0
        si (h[0][0] == 160) { i = 1 }
        emisor_nombre = subtexto(op["emisor"]["certificado"], h[i + 4][4], h[i + 4][3])
    }
    sea alg_firma = _bl_firmar_x509(clave_firma, "")[0]
    sea exts = []
    si (op["ca"] ?? falso) {
        exts.agregar(_bl_der_seq([_bl_der_oid("2.5.29.19"), _bl_tlv(1, char_de(255)), _bl_tlv(4, _bl_der_seq([_bl_tlv(1, char_de(255))]))]))
        exts.agregar(_bl_der_seq([_bl_der_oid("2.5.29.15"), _bl_tlv(1, char_de(255)), _bl_tlv(4, _bl_tlv(3, char_de(1) + char_de(6)))]))
    } sino {
        sea san = ""
        para n en nombres {
            si (_bl_es_ip(n) y contiene(n, ":") == falso) {
                sea ip = ""
                para p en texto_dividir(n, ".") { ip = ip + char_de(a_numero(p)) }
                san = san + _bl_tlv(135, ip)
            } sino { san = san + _bl_tlv(130, n) }
        }
        exts.agregar(_bl_der_seq([_bl_der_oid("2.5.29.17"), _bl_tlv(4, _bl_tlv(48, san))]))
        exts.agregar(_bl_der_seq([_bl_der_oid("2.5.29.19"), _bl_tlv(4, _bl_der_seq([]))]))
    }
    sea tbs = _bl_der_seq([_bl_tlv(160, _bl_der_entero(char_de(2))), _bl_der_entero(char_de(1) + bytes_aleatorios(15)), alg_firma, emisor_nombre,
        _bl_der_seq([_bl_fecha_der(ahora - 3600), _bl_fecha_der(ahora + dias * 86400)]), _bl_nombre_der(cn), _bl_spki(clave), _bl_tlv(163, _bl_der_seq(exts))])
    sea f = _bl_firmar_x509(clave_firma, tbs)
    sea der = _bl_der_seq([tbs, f[0], _bl_tlv(3, char_de(0) + f[1])])
    retornar {"der": der, "pem": _bl_a_pem("CERTIFICATE", der), "clave": clave, "clave_pem": blindaje_clave_pem(clave)}
}

/// Clave privada en PEM PKCS#8 (Ed25519 o EC).
funcion blindaje_clave_pem(clave) {
    si (clave["tipo"] == "ed25519") { retornar _bl_a_pem("PRIVATE KEY", _bl_der_seq([_bl_der_entero(char_de(0)), _bl_der_seq([_bl_der_oid("1.3.101.112")]), _bl_tlv(4, _bl_tlv(4, clave["semilla"]))])) }
    sea oid_curva = "1.2.840.10045.3.1.7"
    si (clave["curva"] == "P-384") { oid_curva = "1.3.132.0.34" }
    sea ec = _bl_der_seq([_bl_der_entero(char_de(1)), _bl_tlv(4, clave["privada"]), _bl_tlv(161, _bl_tlv(3, char_de(0) + clave["publica"]))])
    retornar _bl_a_pem("PRIVATE KEY", _bl_der_seq([_bl_der_entero(char_de(0)), _bl_der_seq([_bl_der_oid("1.2.840.10045.2.1"), _bl_der_oid(oid_curva)]), _bl_tlv(4, ec)]))
}

/// Lee una clave privada PEM (PKCS#8 Ed25519 o EC, o "EC PRIVATE KEY").
funcion blindaje_leer_clave(pem) {
    sea bloques = blindaje_pem(pem, "PRIVATE KEY")
    si (longitud(bloques) > 0) {
        sea d = bloques[0]
        sea h = _bl_hijos(d, _bl_leer(d, 0))
        sea alg = _bl_hijos(d, h[1])
        sea oid = _bl_oid_texto(_bl_cont(d, alg[0]))
        sea privado = _bl_cont(d, h[2])
        si (oid == "1.3.101.112") {
            sea s = _bl_cont(privado, _bl_leer(privado, 0))
            retornar {"tipo": "ed25519", "semilla": s, "publica": ed25519_publica(s)}
        }
        si (oid == "1.2.840.10045.2.1") {
            sea curva = _BL_OID[_bl_oid_texto(_bl_cont(d, alg[1]))] ?? "?"
            retornar _bl_clave_ec(privado, curva)
        }
        lanzar "blindaje: tipo de clave no soportado (" + oid + ")"
    }
    sea ec = blindaje_pem(pem, "EC PRIVATE KEY")
    si (longitud(ec) > 0) { retornar _bl_clave_ec(ec[0], nulo) }
    lanzar "blindaje: no se encontró una clave privada en el PEM"
}

funcion _bl_clave_ec(d, curva) {
    sea h = _bl_hijos(d, _bl_leer(d, 0))
    sea priv = _bl_cont(d, h[1])
    sea cv = curva
    sea pub = nulo
    sea i = 2
    mientras (i < longitud(h)) {
        si (h[i][0] == 160) { cv = _BL_OID[_bl_oid_texto(_bl_cont(d, _bl_leer(d, h[i][1])))] ?? cv }
        si (h[i][0] == 161) {
            sea b = _bl_cont(d, _bl_leer(d, h[i][1]))
            pub = subtexto(b, 1, longitud(b))
        }
        i = i + 1
    }
    si (pub == nulo) {
        sea c = _bl_curva(cv)
        sea P = _bl_afin(c, _bl_por(c, priv, c["g"]))
        pub = char_de(4) + _bl_bn_bytes(P[0], c["bytes"]) + _bl_bn_bytes(P[1], c["bytes"])
    }
    retornar {"tipo": "ec", "curva": cv, "privada": priv, "publica": pub}
}

// ---------- sobre sockets ----------

funcion _bl_vaciar(c) {
    sea s = blindaje_salida(c)
    si (longitud(s) > 0) { net_enviar(c["fd"], s) }
}

funcion _bl_handshake(c) {
    _bl_vaciar(c)
    mientras (c["estado"] != "conectado") {
        sea d = net_recibir(c["fd"], 65536)
        si (d == "") { lanzar "blindaje: la conexión se cerró durante el handshake" }
        intentar { blindaje_entrada(c, d) } capturar (e) {
            intentar { _bl_vaciar(c) } capturar (e2) { }
            lanzar e
        }
        _bl_vaciar(c)
    }
}

/// Conecta por TCP y hace el handshake como cliente (mismas opciones que
/// blindaje_cliente).
funcion blindaje_conectar(host, puerto, opciones) {
    sea fd = net_conectar(host, puerto)
    sea op = opciones ?? {}
    sea c = blindaje_cliente(op["sni"] ?? host, op)
    c["fd"] = fd
    intentar { _bl_handshake(c) } capturar (e) {
        net_cerrar(fd)
        lanzar e
    }
    retornar c
}

/// Escucha en un puerto TCP (todas las interfaces). Devuelve el socket.
funcion blindaje_escuchar(puerto) {
    sea fd = socket(2, 1, 0)
    si (fd < 0) { lanzar "blindaje: no se pudo crear el socket" }
    sea uno = c_reservar(4)
    c_escribir32(uno, 0, 1)
    si (existe_archivo("/proc/meminfo")) { setsockopt(fd, 1, 2, uno, 4) } sino { setsockopt(fd, 65535, 4, uno, 4) }
    c_liberar(uno)
    sea dir = char_de(2) + char_de(0)
    si (existe_archivo("/proc/meminfo") == falso) { dir = char_de(16) + char_de(2) }
    dir = dir + char_de(piso(puerto / 256)) + char_de(puerto % 256) + _bl_ceros(12)
    sea pd = c_desde_bytes(dir)
    sea r = bind(fd, pd, 16)
    c_liberar(pd)
    si (r != 0) {
        close(fd)
        lanzar "blindaje: no se pudo escuchar en el puerto " + puerto
    }
    listen(fd, 16)
    retornar fd
}

/// Acepta una conexión y hace el handshake como servidor.
funcion blindaje_aceptar(escucha, opciones) {
    sea fd = accept(escucha, c_reservar(16), c_reservar(4))
    si (fd < 0) { lanzar "blindaje: accept falló" }
    sea c = blindaje_servidor(opciones)
    c["fd"] = fd
    intentar { _bl_handshake(c) } capturar (e) {
        net_cerrar(fd)
        lanzar e
    }
    retornar c
}

/// Envía datos cifrados.
funcion blindaje_enviar(c, datos) {
    blindaje_escribir(c, datos)
    _bl_vaciar(c)
}

/// Recibe datos (espera hasta que llegue algo); "" si el otro cerró.
funcion blindaje_recibir(c) {
    mientras (longitud(c["app"]) == 0 y c["cerrado_par"] == falso) {
        sea d = net_recibir(c["fd"], 65536)
        si (d == "") { retornar blindaje_leer(c) }
        blindaje_entrada(c, d)
        _bl_vaciar(c)
    }
    retornar blindaje_leer(c)
}

/// Todo hasta que el otro cierre.
funcion blindaje_recibir_todo(c) {
    sea r = ""
    mientras (verdadero) {
        sea d = blindaje_recibir(c)
        si (d == "") { retornar r }
        r = r + d
    }
}

/// Cierra con close_notify.
funcion blindaje_cerrar(c) {
    intentar {
        blindaje_aviso_cierre(c)
        _bl_vaciar(c)
    } capturar (e) { }
    net_cerrar(c["fd"])
}
