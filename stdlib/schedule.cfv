// stdlib/schedule.cfv — zonas horarias y cron: nombres en inglés del módulo "agenda".
// English names for the "agenda" module; both can be used together.

importar "agenda"

funcion _schedule_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_schedule_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _schedule_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _SCHEDULE_RES = {"desfase": "offset", "abrev": "abbr", "verano": "dst", "anio": "year", "mes": "month", "dia": "day", "hora": "hour", "minuto": "minute", "segundo": "second", "ms": "ms", "dia_semana": "weekday"}

funcion tz_parse_posix(texto) { retornar agenda_posix(texto) }
funcion tz_from_tzif(nombre, d) { retornar agenda_zona_bytes(nombre, d) }
funcion tz_from_posix(regla) { retornar agenda_zona_posix(regla) }
funcion tz_load(nombre) { retornar agenda_zona(nombre) }
funcion tz_offset(zona, ms) { retornar _schedule_tr(agenda_desfase(zona, ms), _SCHEDULE_RES) }
funcion tz_local(zona, ms) { retornar _schedule_tr(agenda_local(zona, ms), _SCHEDULE_RES) }
funcion tz_format(zona, ms) { retornar agenda_formato(zona, ms) }
funcion tz_from_local(zona, anio, mes, dia, hora, minuto, segundo, opcion) { retornar agenda_desde_local(zona, anio, mes, dia, hora, minuto, segundo, opcion) }
funcion schedule_cron(expr, zona) { retornar agenda_cron(expr, zona) }
funcion schedule_next(a, ms) { retornar agenda_siguiente(a, ms) }
funcion schedule_upcoming(a, ms, n) { retornar agenda_proximas(a, ms, n) }
funcion tz_convert(zona, ms) { retornar agenda_en(zona, ms) }
