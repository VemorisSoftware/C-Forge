// stdlib/notify.cfv — vigilar cambios en archivos: nombres en inglés del módulo "vigia".
// English names for the "vigia" module; both can be used together.


importar "vigia"

funcion _notify_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_notify_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _notify_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _NOTIFY_RES = {"tipo": "kind", "ruta": "path", "desde": "from", "carpeta": "is_dir", "tamano": "size", "modificado_ns": "modified_ns", "creado": "created", "modificado": "modified", "borrado": "removed", "renombrado": "renamed"}
sea _NOTIFY_OPT = {"recursive": "recursivo", "ignore": "ignorar", "debounce_ms": "rebote_ms", "mode": "modo", "interval_ms": "intervalo_ms", "attributes": "atributos"}

funcion notify_glob_match(patron, nombre) { retornar vigia_coincide(patron, nombre) }
funcion watcher_new(opciones) { retornar vigia_nuevo(_notify_opt(opciones)) }
funcion watcher_add(v, ruta) { retornar vigia_agregar(v, ruta) }
funcion file_status(ruta) { retornar _notify_tr(vigia_estado(ruta), _NOTIFY_RES) }
funcion watcher_run(v, f) { retornar vigia_mirar(v, f) }
funcion watcher_close(v) { retornar vigia_cerrar(v) }

funcion _notify_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_NOTIFY_OPT[k] ?? k] = o[k] }
    retornar r
}

sea _NT_TIPOS = {"creado": "created", "modificado": "modified", "borrado": "removed", "renombrado": "renamed", "atributos": "attributes"}
/// Events: [{"kind": "created"|"modified"|"removed"|"renamed", "path", "from", "is_dir"}].
funcion watcher_events(v, wait_ms) {
    sea r = []
    para e en vigia_eventos(v, wait_ms) {
        sea x = _notify_tr(e, _NOTIFY_RES)
        x["kind"] = _NT_TIPOS[e["tipo"]] ?? e["tipo"]
        r.agregar(x)
    }
    retornar r
}
/// Calls f(event) for each change, forever (or until f returns false).
funcion watcher_run_en(v, f) {
    mientras (verdadero) {
        para e en watcher_events(v, 1000) { si (f(e) == falso) { retornar nulo } }
    }
}
