// stdlib/kafka.cfv — Streaming de eventos (protocolo de Kafka): nombres en inglés del módulo "flujo".
// English names for the "flujo" module; both can be used together.


importar "flujo"

funcion _kafka_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_kafka_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _kafka_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _KAFKA_RES = {"temas": "topics", "nodo": "node_id", "tema": "topic", "particion": "partition", "clave": "key", "valor": "value", "cabeceras": "headers", "marca_tiempo": "timestamp"}
sea _KAFKA_OPT = {"from": "desde", "partitions": "particiones", "node_id": "nodo", "auto_create_topics": "crear_temas"}

funcion kafka_connect(host, puerto) { retornar flujo_conectar(host, puerto) }
funcion kafka_connect_local(b) { retornar flujo_conectar_local(b) }
funcion kafka_metadata(c, temas) { retornar _kafka_tr(flujo_metadatos(c, temas), _KAFKA_RES) }
funcion kafka_create_topic(c, tema, particiones) { retornar flujo_crear_tema(c, tema, particiones) }
funcion kafka_producer(c, opciones) { retornar flujo_productor(c, _kafka_opt(opciones)) }
funcion kafka_send(p, tema, valor, clave, particion) { retornar flujo_enviar(p, tema, valor, clave, particion) }
funcion kafka_send_record(p, tema, reg) { retornar flujo_enviar_con(p, tema, reg) }
funcion kafka_flush(p) { retornar _kafka_tr(flujo_vaciar(p), _KAFKA_RES) }
funcion kafka_consumer(c, temas, opciones) { retornar flujo_consumidor(c, temas, _kafka_opt(opciones)) }
funcion kafka_list_offset(c, tema, particion, tiempo) { retornar flujo_offset(c, tema, particion, tiempo) }
funcion kafka_seek(k, tema, particion, offset) { retornar flujo_buscar(k, tema, particion, offset) }
funcion kafka_poll(k, espera_ms) { retornar _kafka_tr(flujo_sondear(k, espera_ms), _KAFKA_RES) }
funcion kafka_close(c) { retornar flujo_cerrar(c) }
funcion kafka_broker(opciones) { retornar flujo_broker(_kafka_opt(opciones)) }
funcion kafka_broker_create_topic(b, tema, particiones) { retornar flujo_broker_crear_tema(b, tema, particiones) }
funcion kafka_broker_handle(b, peticion) { retornar flujo_broker_atender(b, peticion) }
funcion kafka_broker_serve(b, host, puerto, hasta, max_ms) { retornar flujo_broker_servir(b, host, puerto, hasta, max_ms) }
funcion kafka_record_batch(registros, base_offset) { retornar flujo_lote(registros, base_offset) }
funcion kafka_read_batches(d) { retornar _kafka_tr(flujo_leer_lotes(d), _KAFKA_RES) }
funcion kafka_crc32c(d) { retornar flujo_crc32c(d) }
funcion kafka_murmur2(d) { retornar flujo_murmur2(d) }
funcion kafka_partition_for_key(clave, n) { retornar flujo_particion_clave(clave, n) }

funcion _kafka_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_KAFKA_OPT[k] ?? k] = o[k] }
    retornar r
}
