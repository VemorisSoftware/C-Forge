// stdlib/xlsx.cfv — crear planillas .xlsx: nombres en inglés del módulo "hoja".
// English names for the "hoja" module; both can be used together.

importar "hoja"

funcion xlsx_workbook() { retornar hoja_libro() }
funcion xlsx_add_sheet(libro, nombre) { retornar hoja_agregar(libro, nombre) }
/// options: {"header": true} (bold, frozen and filtered first row).
funcion xlsx_rows(h, filas, opciones) {
    sea o = opciones
    si (opciones != nulo) { si (tiene_clave(opciones, "header")) { o = {"cabecera": opciones["header"]} } }
    sea f = []
    para fila en filas {
        sea r = []
        para v en fila {
            si (tipo(v) == "mapa") {
                si (tiene_clave(v, "date_ms")) { r.agregar({"fecha_ms": v["date_ms"]}) } sino {
                    si (tiene_clave(v, "text")) { r.agregar({"texto": v["text"]}) } sino { r.agregar(v) }
                }
            } sino { r.agregar(v) }
        }
        f.agregar(r)
    }
    retornar hoja_filas(h, f, o)
}
funcion xlsx_widths(h, anchos) { retornar hoja_anchos(h, anchos) }
funcion xlsx_column(i) { retornar hoja_columna(i) }
funcion xlsx_bytes(libro) { retornar hoja_xlsx(libro) }
