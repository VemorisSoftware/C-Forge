// stdlib/libgit2.cfv — Repositorios Git nativos (estilo libgit2): nombres en inglés del módulo "historia".
// English names for the "historia" module; both can be used together.


importar "historia"

funcion _libgit2_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_libgit2_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _libgit2_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _LIBGIT2_RES = {"tipo": "type", "datos": "data", "arbol": "tree", "padres": "parents", "autor": "author", "confirmador": "committer", "mensaje": "message", "nombre": "name", "correo": "email", "fecha": "time", "zona": "offset", "modo": "mode", "ruta": "path", "cambio": "change", "tamano": "size", "preparados": "staged", "modificados": "modified", "borrados": "deleted", "sin_seguimiento": "untracked", "contenido": "content"}
sea _LIBGIT2_OPT = {"author": "autor", "committer": "confirmador", "parents": "padres"}

funcion git_repository_open(ruta) { retornar historia_abrir(ruta) }
funcion git_object_lookup(r, sha) { retornar _libgit2_tr(historia_objeto(r, sha), _LIBGIT2_RES) }
funcion git_revparse(r, rev) { retornar historia_resolver(r, rev) }
funcion git_branches(r) { retornar historia_ramas(r) }
funcion git_tags(r) { retornar historia_etiquetas(r) }
funcion git_current_branch(r) { retornar historia_rama_actual(r) }
funcion git_commit_lookup(r, rev) { retornar _libgit2_tr(historia_commit(r, rev), _LIBGIT2_RES) }
funcion git_tree_entries(r, sha) { retornar _libgit2_tr(historia_arbol(r, sha), _LIBGIT2_RES) }
funcion git_list_files(r, rev) { retornar historia_listar(r, rev) }
funcion git_file_at(r, rev, ruta) { retornar historia_archivo(r, rev, ruta) }
funcion git_log(r, rev, maximo) { retornar _libgit2_tr(historia_log(r, rev, maximo), _LIBGIT2_RES) }
funcion git_diff_trees(r, rev_a, rev_b) { retornar _libgit2_tr(historia_diferencias(r, rev_a, rev_b), _LIBGIT2_RES) }
funcion git_index_entries(r) { retornar _libgit2_tr(historia_indice(r), _LIBGIT2_RES) }
funcion git_status(r) { retornar _libgit2_tr(historia_estado(r), _LIBGIT2_RES) }
funcion git_repository_init(ruta, rama) { retornar historia_iniciar(ruta, rama) }
funcion git_object_write(r, tipo_o, datos) { retornar historia_guardar_objeto(r, tipo_o, datos) }
funcion git_commit_create(r, archivos, mensaje, opciones) { retornar historia_confirmar(r, archivos, mensaje, _libgit2_opt(opciones)) }
funcion git_branch_create(r, nombre, rev) { retornar historia_crear_rama(r, nombre, rev) }
funcion git_checkout_branch(r, nombre) { retornar historia_cambiar_rama(r, nombre) }
funcion git_tag_create(r, nombre, rev, mensaje, opciones) { retornar historia_etiquetar(r, nombre, rev, mensaje, _libgit2_opt(opciones)) }
funcion git_hash_blob(datos) { retornar historia_hash(datos) }

funcion _libgit2_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_LIBGIT2_OPT[k] ?? k] = o[k] }
    retornar r
}
