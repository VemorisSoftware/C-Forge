// stdlib/hcl.cfv — configuración estilo HCL: nombres en inglés del módulo "infra".
// English names for the "infra" module; both can be used together.

importar "infra"

funcion hcl_parse(texto, contexto) { retornar infra_leer(texto, contexto) }
funcion hcl_stringify(datos) { retornar infra_texto(datos) }
