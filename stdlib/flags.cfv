// stdlib/flags.cfv — banderas de funcionalidad: nombres en inglés del módulo "interruptor".
// English names for the "interruptor" module; both can be used together.

importar "interruptor"

funcion flags_new() { retornar interruptor_nuevo() }
funcion flags_define(f, nombre, opciones) { retornar interruptor_definir(f, nombre, opciones) }
funcion flags_override(f, nombre, valor) { retornar interruptor_forzar(f, nombre, valor) }
funcion flags_bucket(nombre, id) { retornar interruptor_cubeta(nombre, id) }
funcion flags_enabled(f, nombre, contexto) { retornar interruptor_activo(f, nombre, contexto) }
funcion flags_variant(f, nombre, contexto) { retornar interruptor_variante(f, nombre, contexto) }
funcion flags_from_json(texto) { retornar interruptor_desde_json(texto) }
