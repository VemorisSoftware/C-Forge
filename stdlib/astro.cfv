// stdlib/astro.cfv — astronomía práctica: fecha juliana, posición del Sol,
// salida y puesta del sol (y crepúsculos), fase y edad de la Luna, estación
// del año por hemisferio y hora sideral. Precisión de ~1–2 minutos para el Sol
// (algoritmos de NOAA / Meeus). Inspirada en NOVAS (dominio público). En
// inglés: importar "astro".
//
//   importar "astro"
//   sea s = astro_sol(-33.45, -70.67, 1763683200000)   // Santiago
//   s["salida_ms"], s["puesta_ms"], s["duracion_h"]
//   astro_luna(1763683200000)                          // {"fase", "iluminacion", "nombre"}

funcion _as_rad(g) { retornar g * pi() / 180 }
funcion _as_grad(r) { retornar r * 180 / pi() }

funcion _as_atan2(y_, x) {
    si (x > 0) { retornar arcotangente(y_ / x) }
    si (x < 0 y y_ >= 0) { retornar arcotangente(y_ / x) + pi() }
    si (x < 0 y y_ < 0) { retornar arcotangente(y_ / x) - pi() }
    si (y_ > 0) { retornar pi() / 2 }
    si (y_ < 0) { retornar 0 - pi() / 2 }
    retornar 0
}

funcion _as_arccos(x) { retornar pi() / 2 - arcoseno(x) }

funcion _as_mod(a, b) {
    sea r = a - b * piso(a / b)
    retornar r
}

/// Día juliano de un instante en ms UTC.
funcion astro_juliano(ms) { retornar ms / 86400000 + 2440587.5 }

funcion astro_desde_juliano(jd) { retornar redondear((jd - 2440587.5) * 86400000, 0) }

// Posición aparente del Sol para el siglo juliano T (Meeus cap. 25).
funcion _as_sol_T(T) {
    sea L0 = _as_mod(280.46646 + T * (36000.76983 + 0.0003032 * T), 360)
    sea M = 357.52911 + T * (35999.05029 - 0.0001537 * T)
    sea e = 0.016708634 - T * (0.000042037 + 0.0000001267 * T)
    sea C = seno(_as_rad(M)) * (1.914602 - T * (0.004817 + 0.000014 * T)) + seno(_as_rad(2 * M)) * (0.019993 - 0.000101 * T) + seno(_as_rad(3 * M)) * 0.000289
    sea lon = L0 + C
    sea omega = 125.04 - 1934.136 * T
    sea lambda = lon - 0.00569 - 0.00478 * seno(_as_rad(omega))
    sea eps0 = 23 + (26 + (21.448 - T * (46.815 + T * (0.00059 - T * 0.001813))) / 60) / 60
    sea eps = eps0 + 0.00256 * coseno(_as_rad(omega))
    sea dec = _as_grad(arcoseno(seno(_as_rad(eps)) * seno(_as_rad(lambda))))
    sea ra = _as_mod(_as_grad(_as_atan2(coseno(_as_rad(eps)) * seno(_as_rad(lambda)), coseno(_as_rad(lambda)))), 360)
    sea y_ = potencia(seno(_as_rad(eps / 2)), 2)
    sea eq = 4 * _as_grad(y_ * seno(2 * _as_rad(L0)) - 2 * e * seno(_as_rad(M)) + 4 * e * y_ * seno(_as_rad(M)) * coseno(2 * _as_rad(L0)) - 0.5 * y_ * y_ * seno(4 * _as_rad(L0)) - 1.25 * e * e * seno(2 * _as_rad(M)))
    retornar {"declinacion": dec, "ascension": ra, "ecuacion_min": eq, "longitud": lambda}
}

/// Altura y acimut del Sol (grados) en un lugar e instante.
funcion astro_posicion_sol(lat, lon, ms) {
    sea jd = astro_juliano(ms)
    sea p = _as_sol_T((jd - 2451545) / 36525)
    sea minutos = _as_mod(ms / 60000, 1440)
    sea tst = _as_mod(minutos + p["ecuacion_min"] + 4 * lon, 1440)
    sea ha = tst / 4 - 180
    sea fi = _as_rad(lat)
    sea d = _as_rad(p["declinacion"])
    sea cz = seno(fi) * seno(d) + coseno(fi) * coseno(d) * coseno(_as_rad(ha))
    cz = maximo(-1, minimo(1, cz))
    sea cenit = _as_grad(_as_arccos(cz))
    sea az = 0
    // Acimut desde el norte, sentido horario.
    sea y_ = 0 - seno(_as_rad(ha)) * coseno(d)
    sea x = coseno(fi) * seno(d) - seno(fi) * coseno(d) * coseno(_as_rad(ha))
    az = _as_mod(_as_grad(_as_atan2(y_, x)), 360)
    retornar {"altura": 90 - cenit, "acimut": az, "declinacion": p["declinacion"]}
}

// Instante (ms) del evento solar con ángulo de cenit z, iterando 3 veces.
funcion _as_evento(lat, lon, dia_ms, z, salida) {
    sea t = dia_ms + 43200000 - lon * 240000
    sea k = 0
    mientras (k < 3) {
        sea p = _as_sol_T((astro_juliano(t) - 2451545) / 36525)
        sea fi = _as_rad(lat)
        sea d = _as_rad(p["declinacion"])
        sea c = coseno(_as_rad(z)) / (coseno(fi) * coseno(d)) - (seno(fi) * seno(d)) / (coseno(fi) * coseno(d))
        si (c > 1 o c < -1) { retornar nulo }
        sea ha = _as_grad(_as_arccos(c))
        si (salida) { ha = 0 - ha }
        sea mediodia = 720 - 4 * lon - p["ecuacion_min"]
        t = dia_ms + (mediodia + 4 * ha) * 60000
        k = k + 1
    }
    retornar redondear(t, 0)
}

/// Salida, puesta, mediodía solar y crepúsculos para el día UTC de ms.
/// Si el sol no sale o no se pone (cerca de los polos), los ms son nulo.
funcion astro_sol(lat, lon, ms) {
    sea dia = piso(ms / 86400000) * 86400000
    sea p = _as_sol_T((astro_juliano(dia + 43200000) - 2451545) / 36525)
    sea mediodia = redondear(dia + (720 - 4 * lon - p["ecuacion_min"]) * 60000, 0)
    sea salida = _as_evento(lat, lon, dia, 90.833, verdadero)
    sea puesta = _as_evento(lat, lon, dia, 90.833, falso)
    sea dur = nulo
    si (salida != nulo y puesta != nulo) { dur = (puesta - salida) / 3600000 } sino {
        // Día polar o noche polar.
        si (astro_posicion_sol(lat, lon, mediodia)["altura"] > 0) { dur = 24 } sino { dur = 0 }
    }
    retornar {
        "salida_ms": salida, "puesta_ms": puesta, "mediodia_ms": mediodia, "duracion_h": dur,
        "alba_civil_ms": _as_evento(lat, lon, dia, 96, verdadero), "ocaso_civil_ms": _as_evento(lat, lon, dia, 96, falso),
        "alba_nautica_ms": _as_evento(lat, lon, dia, 102, verdadero), "ocaso_nautico_ms": _as_evento(lat, lon, dia, 102, falso),
        "altura_maxima": 90 - absoluto(lat - p["declinacion"])
    }
}

/// Fase de la Luna: {"fase" (0 nueva … 0.5 llena … 1), "iluminacion" (0–1),
/// "edad_dias", "nombre"}.
funcion astro_luna(ms) {
    sea jd = astro_juliano(ms)
    sea T = (jd - 2451545) / 36525
    // Elongación media, anomalías y argumento (Meeus cap. 47–48, términos principales).
    sea D = _as_mod(297.8501921 + 445267.1114034 * T, 360)
    sea M = _as_mod(357.5291092 + 35999.0502909 * T, 360)
    sea Mp = _as_mod(134.9633964 + 477198.8675055 * T, 360)
    sea i = 180 - D - 6.289 * seno(_as_rad(Mp)) + 2.1 * seno(_as_rad(M)) - 1.274 * seno(_as_rad(2 * D - Mp)) - 0.658 * seno(_as_rad(2 * D)) - 0.214 * seno(_as_rad(2 * Mp)) - 0.11 * seno(_as_rad(D))
    sea ilum = (1 + coseno(_as_rad(i))) / 2
    // Elongación verdadera aproximada para la fase creciente/menguante.
    sea elong = _as_mod(D + 6.289 * seno(_as_rad(Mp)) - 2.1 * seno(_as_rad(M)) + 1.274 * seno(_as_rad(2 * D - Mp)) + 0.658 * seno(_as_rad(2 * D)), 360)
    sea fase = elong / 360
    sea nombres = ["luna nueva", "creciente", "cuarto creciente", "gibosa creciente", "luna llena", "gibosa menguante", "cuarto menguante", "menguante"]
    sea idx = piso(fase * 8 + 0.5) % 8
    retornar {"fase": fase, "iluminacion": ilum, "edad_dias": fase * 29.530588853, "nombre": nombres[idx]}
}

/// Estación astronómica aproximada ("verano", "otoño", "invierno", "primavera").
funcion astro_estacion(lat, ms) {
    sea lon = _as_mod(_as_sol_T((astro_juliano(ms) - 2451545) / 36525)["longitud"], 360)
    sea norte = ["primavera", "verano", "otoño", "invierno"]
    sea sur = ["otoño", "invierno", "primavera", "verano"]
    sea k = piso(lon / 90) % 4
    si (lat < 0) { retornar sur[k] }
    retornar norte[k]
}

/// Hora sideral media de Greenwich (grados) y local si se da la longitud.
funcion astro_sideral(ms, lon) {
    sea jd = astro_juliano(ms)
    sea T = (jd - 2451545) / 36525
    sea g = _as_mod(280.46061837 + 360.98564736629 * (jd - 2451545) + 0.000387933 * T * T - T * T * T / 38710000, 360)
    retornar _as_mod(g + (lon ?? 0), 360)
}
