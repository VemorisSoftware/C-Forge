// stdlib/pregunta.cfv — preguntas interactivas en la terminal: texto con
// validación, sí/no, número en un rango y elegir de una lista. Vuelve a
// preguntar ante una respuesta inválida. Inspirada en Dialoguer (MIT).
// En inglés: importar "prompt".
//
//   importar "pregunta"
//   sea nombre = pregunta_texto("¿Cómo te llamas?", {"requerido": verdadero})
//   si (pregunta_confirmar("¿Continuar?", verdadero)) { … }
//   sea plan = pregunta_elegir("Plan", ["Básico", "Pro", "Empresa"])   // índice
//   sea edad = pregunta_numero("Edad", 0, 120)
//
// Para pruebas o guiones: pregunta_simular(["Ana", "s", "2"]) responde
// desde la lista y guarda lo mostrado en pregunta_salida().

sea _PR = {"entrada": nulo, "salida": nulo, "idioma": "es"}

funcion pregunta_simular(respuestas) {
    _PR["entrada"] = respuestas
    _PR["salida"] = []
}

funcion pregunta_salida() { retornar _PR["salida"] }

funcion pregunta_idioma(idioma) { _PR["idioma"] = idioma }

funcion _pr_t(es, en) {
    si (_PR["idioma"] == "en") { retornar en }
    retornar es
}

funcion _pr_mostrar(t) {
    si (_PR["salida"] != nulo) { _PR["salida"].agregar(t) } sino { mostrar(t) }
}

funcion _pr_leer(mensaje) {
    si (_PR["entrada"] != nulo) {
        _PR["salida"].agregar(mensaje)
        si (longitud(_PR["entrada"]) == 0) { lanzar "pregunta: se acabaron las respuestas simuladas" }
        sea r = _PR["entrada"][0]
        sea resto = []
        sea i = 1
        mientras (i < longitud(_PR["entrada"])) { resto.agregar(_PR["entrada"][i])  i = i + 1 }
        _PR["entrada"] = resto
        retornar "" + r
    }
    sea r = leer(mensaje)
    si (r == nulo) { lanzar "pregunta: la entrada terminó" }
    retornar r
}

funcion _pr_numero(t) {
    si (t == "") { retornar nulo }
    sea v = nulo
    intentar { v = a_numero(t) } capturar (e) { v = nulo }
    retornar v
}

funcion _pr_op(o, k, en, d) {
    si (o != nulo) {
        si (tiene_clave(o, k)) { retornar o[k] }
        si (tiene_clave(o, en)) { retornar o[en] }
    }
    retornar d
}

/// Texto. opciones: defecto, requerido, validar (f(t) → nulo si está bien o
/// el mensaje de error), intentos (10).
funcion pregunta_texto(mensaje, opciones) {
    sea defecto = _pr_op(opciones, "defecto", "default", nulo)
    sea requerido = _pr_op(opciones, "requerido", "required", falso)
    sea validar = _pr_op(opciones, "validar", "validate", nulo)
    sea intentos = _pr_op(opciones, "intentos", "attempts", 10)
    sea p = mensaje
    si (defecto != nulo) { p = p + " [" + defecto + "]" }
    sea n = 0
    mientras (n < intentos) {
        sea r = texto_recortar(_pr_leer(p + " "))
        si (r == "" y defecto != nulo) { r = "" + defecto }
        sea error = nulo
        si (r == "" y requerido) { error = _pr_t("Este dato es obligatorio.", "This field is required.") }
        si (error == nulo y validar != nulo) { error = validar(r) }
        si (error == nulo) { retornar r }
        _pr_mostrar("✗ " + error)
        n = n + 1
    }
    lanzar "pregunta: demasiados intentos"
}

/// Sí/no (acepta s, si, sí, y, yes, n, no). Enter = defecto.
funcion pregunta_confirmar(mensaje, defecto) {
    sea marca = " (s/n)"
    si (_PR["idioma"] == "en") { marca = " (y/n)" }
    si (defecto == verdadero) { marca = _pr_t(" [S/n]", " [Y/n]") }
    si (defecto == falso) { marca = _pr_t(" [s/N]", " [y/N]") }
    sea n = 0
    mientras (n < 10) {
        sea r = texto_minusculas(texto_recortar(_pr_leer(mensaje + marca + " ")))
        si (r == "" y defecto != nulo) { retornar defecto }
        si (r == "s" o r == "si" o r == "sí" o r == "y" o r == "yes") { retornar verdadero }
        si (r == "n" o r == "no") { retornar falso }
        _pr_mostrar(_pr_t("✗ Responde s o n.", "✗ Answer y or n."))
        n = n + 1
    }
    lanzar "pregunta: demasiados intentos"
}

/// Número entre min y max (incluidos; nulo = sin límite).
funcion pregunta_numero(mensaje, min, max, opciones) {
    sea defecto = _pr_op(opciones, "defecto", "default", nulo)
    sea entero = _pr_op(opciones, "entero", "integer", falso)
    sea n = 0
    mientras (n < 10) {
        sea p = mensaje
        si (defecto != nulo) { p = p + " [" + defecto + "]" }
        sea r = texto_reemplazar(texto_recortar(_pr_leer(p + " ")), ",", ".")
        si (r == "" y defecto != nulo) { retornar defecto }
        sea v = _pr_numero(r)
        sea error = nulo
        si (v == nulo o r == "") { error = _pr_t("Escribe un número.", "Enter a number.") } sino {
            si (entero y piso(v) != v) { error = _pr_t("Escribe un número entero.", "Enter a whole number.") }
            si (error == nulo y min != nulo) { si (v < min) { error = _pr_t("Debe ser al menos ", "Must be at least ") + min + "." } }
            si (error == nulo y max != nulo) { si (v > max) { error = _pr_t("Debe ser como máximo ", "Must be at most ") + max + "." } }
        }
        si (error == nulo) { retornar v }
        _pr_mostrar("✗ " + error)
        n = n + 1
    }
    lanzar "pregunta: demasiados intentos"
}

/// Muestra opciones numeradas y devuelve el índice elegido (0, 1, …).
/// También acepta escribir el texto de la opción.
funcion pregunta_elegir(mensaje, opciones_l, defecto) {
    si (longitud(opciones_l) == 0) { lanzar "pregunta: no hay opciones" }
    _pr_mostrar(mensaje)
    sea i = 0
    mientras (i < longitud(opciones_l)) {
        sea marca = "  "
        si (defecto != nulo) { si (defecto == i) { marca = "> " } }
        _pr_mostrar(marca + (i + 1) + ") " + opciones_l[i])
        i = i + 1
    }
    sea n = 0
    mientras (n < 10) {
        sea r = texto_recortar(_pr_leer(_pr_t("Elige 1-", "Choose 1-") + longitud(opciones_l) + ": "))
        si (r == "" y defecto != nulo) { retornar defecto }
        sea v = _pr_numero(r)
        si (v != nulo y r != "") { si (piso(v) == v y v >= 1 y v <= longitud(opciones_l)) { retornar v - 1 } }
        i = 0
        mientras (i < longitud(opciones_l)) {
            si (texto_minusculas("" + opciones_l[i]) == texto_minusculas(r)) { retornar i }
            i = i + 1
        }
        _pr_mostrar(_pr_t("✗ Opción inválida.", "✗ Invalid option."))
        n = n + 1
    }
    lanzar "pregunta: demasiados intentos"
}

/// Varias opciones separadas por coma ("1,3"). Devuelve la lista de índices.
funcion pregunta_varias(mensaje, opciones_l) {
    _pr_mostrar(mensaje)
    sea i = 0
    mientras (i < longitud(opciones_l)) { _pr_mostrar("  " + (i + 1) + ") " + opciones_l[i])  i = i + 1 }
    sea n = 0
    mientras (n < 10) {
        sea r = texto_recortar(_pr_leer(_pr_t("Elige (ej. 1,3): ", "Choose (e.g. 1,3): ")))
        sea ok = verdadero
        sea vistos = {}
        sea elegidos = []
        para p en texto_dividir(r, ",") {
            sea t = texto_recortar(p)
            si (t != "") {
                sea v = _pr_numero(t)
                si (v == nulo) { ok = falso } sino {
                    si (piso(v) != v o v < 1 o v > longitud(opciones_l)) { ok = falso } sino {
                        si (tiene_clave(vistos, t) == falso) { vistos[t] = verdadero  elegidos.agregar(v - 1) }
                    }
                }
            }
        }
        si (ok) { retornar ordenar(elegidos, funcion(a, b) { retornar a - b }) }
        _pr_mostrar(_pr_t("✗ Opción inválida.", "✗ Invalid option."))
        n = n + 1
    }
    lanzar "pregunta: demasiados intentos"
}
