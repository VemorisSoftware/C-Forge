// stdlib/progress.cfv — Barras de progreso y spinners (alias en inglés de "progreso").
// English names for the "progreso" module; both can be used together.

importar "progreso"

funcion progress_new(total, etiqueta) { retornar progreso_nuevo(total, etiqueta) }
funcion progress_line(p) { retornar progreso_linea(p) }
funcion progress_advance(p, n) { retornar progreso_avanzar(p, n) }
funcion progress_finish(p) { retornar progreso_terminar(p) }
funcion progress_spinner(etiqueta) { retornar progreso_spinner(etiqueta) }
funcion progress_spin(s) { retornar progreso_girar(s) }
funcion progress_done(s, mensaje) { retornar progreso_listo(s, mensaje) }
