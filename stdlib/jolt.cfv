// stdlib/jolt.cfv — Física 3D de cuerpos rígidos (estilo Jolt): nombres en inglés del módulo "solido".
// English names for the "solido" module; both can be used together.


importar "solido"

funcion _jolt_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_jolt_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _jolt_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _JOLT_RES = {"cuerpo": "body", "distancia": "distance", "punto": "point"}
sea _JOLT_OPT = {"shape": "forma", "type": "tipo", "position": "posicion", "rotation": "rotacion", "velocity": "velocidad", "angular_velocity": "velocidad_angular", "density": "densidad", "mass": "masa", "friction": "friccion", "restitution": "restitucion", "damping": "amortiguacion", "angular_damping": "amortiguacion_angular", "data": "datos", "gravity": "gravedad", "iterations": "iteraciones", "substeps": "subpasos", "sleep": "dormir", "length": "largo", "rope": "cuerda"}

funcion jolt_quat_axis_angle(eje, angulo) { retornar solido_cuaternion(eje, angulo) }
funcion jolt_sphere(r) { retornar solido_esfera(r) }
funcion jolt_box(medias) { retornar solido_caja(medias) }
funcion jolt_capsule(radio, media_altura) { retornar solido_capsula(radio, media_altura) }
funcion jolt_plane(normal, distancia) { retornar solido_plano(normal, distancia) }
funcion jolt_world(opciones) { retornar solido_mundo(_jolt_opt(opciones)) }
funcion jolt_body(m, opciones) { retornar solido_cuerpo(m, _jolt_opt(opciones)) }
funcion jolt_position(m, id) { retornar solido_posicion(m, id) }
funcion jolt_rotation(m, id) { retornar solido_rotacion(m, id) }
funcion jolt_velocity(m, id) { retornar solido_velocidad(m, id) }
funcion jolt_angular_velocity(m, id) { retornar solido_velocidad_angular(m, id) }
funcion jolt_is_sleeping(m, id) { retornar solido_dormido(m, id) }
funcion jolt_set_transform(m, id, posicion, rotacion) { retornar solido_poner(m, id, posicion, rotacion) }
funcion jolt_set_velocity(m, id, v, w) { retornar solido_poner_velocidad(m, id, v, w) }
funcion jolt_add_force(m, id, f, punto) { retornar solido_fuerza(m, id, f, punto) }
funcion jolt_add_impulse(m, id, j, punto) { retornar solido_impulso(m, id, j, punto) }
funcion jolt_point_constraint(m, a, b, punto) { retornar solido_punto(m, a, b, punto) }
funcion jolt_distance_constraint(m, a, b, punto_a, punto_b, opciones) { retornar solido_distancia(m, a, b, punto_a, punto_b, _jolt_opt(opciones)) }
funcion jolt_hinge_constraint(m, a, b, punto, eje, opciones) { retornar solido_bisagra(m, a, b, punto, eje, _jolt_opt(opciones)) }
funcion jolt_fixed_constraint(m, a, b) { retornar solido_fija(m, a, b) }
funcion jolt_hinge_angle(m, r) { retornar solido_angulo(m, r) }
funcion jolt_islands(m) { retornar solido_islas(m) }
funcion jolt_step(m, dt) { retornar solido_paso(m, dt) }
funcion jolt_raycast(m, origen, direccion, distancia_max, ignorar) { retornar _jolt_tr(solido_rayo(m, origen, direccion, distancia_max, ignorar), _JOLT_RES) }
funcion jolt_overlap_sphere(m, centro, radio) { retornar solido_superpuestos(m, centro, radio) }
funcion jolt_kinetic_energy(m) { retornar solido_energia(m) }

funcion _jolt_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_JOLT_OPT[k] ?? k] = o[k] }
    retornar r
}
