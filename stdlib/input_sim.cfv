// stdlib/input_sim.cfv — simular teclado y ratón: nombres en inglés del módulo "teclado".
// English names for the "teclado" module; both can be used together.

importar "teclado"

funcion input_key_name(n) { retornar teclado_nombre_tecla(n) }
funcion input_key_down(t, nombre) { retornar teclado_pulsar(t, nombre) }
funcion input_key_up(t, nombre) { retornar teclado_soltar(t, nombre) }
funcion input_key(t, nombre) { retornar teclado_tecla(t, nombre) }
funcion input_shortcut(t, teclas) { retornar teclado_atajo(t, teclas) }
funcion input_text(t, texto) { retornar teclado_texto(t, texto) }
funcion input_move_mouse(t, x, y) { retornar teclado_mover(t, x, y) }
funcion input_move_mouse_rel(t, dx, dy) { retornar teclado_mover_relativo(t, dx, dy) }
funcion input_button_down(t, boton) { retornar teclado_boton_abajo(t, boton) }
funcion input_button_up(t, boton) { retornar teclado_boton_arriba(t, boton) }
funcion input_click(t, boton, veces) { retornar teclado_clic(t, boton, veces) }
funcion input_drag(t, x0, y0, x1, y1, pasos) { retornar teclado_arrastrar(t, x0, y0, x1, y1, pasos) }
funcion input_scroll(t, dx, dy) { retornar teclado_rueda(t, dx, dy) }
funcion input_mouse_position(t) { retornar teclado_posicion(t) }
funcion input_screen_size(t) { retornar teclado_pantalla(t) }
funcion input_close(t) { retornar teclado_cerrar(t) }

// Open the simulator. options: "display" (X11, e.g. ":0"), "delay" (ms
// between events), "restore_keys" (X11, default true).
funcion input_new(options) {
    sea o = options ?? {}
    sea op = {}
    si (tiene_clave(o, "display")) { op["pantalla"] = o["display"] }
    si (tiene_clave(o, "delay")) { op["retraso"] = o["delay"] }
    si (tiene_clave(o, "restore_keys")) { op["restaurar_teclas"] = o["restore_keys"] }
    retornar teclado_nuevo(op)
}
