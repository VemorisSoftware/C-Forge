// stdlib/serialport.cfv — puertos serie: nombres en inglés del módulo "serie".
// English names for the "serie" module; both can be used together.


importar "serie"

funcion _serialport_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_serialport_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _serialport_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _SERIALPORT_RES = {"ruta": "path", "tipo": "type", "maestro": "master", "esclavo": "slave", "unidad": "unit", "funcion": "function", "valores": "values", "direccion": "address", "valor": "value"}
sea _SERIALPORT_OPT = {"baud": "velocidad", "data_bits": "datos", "parity": "paridad", "stop_bits": "parada", "flush": "vaciar", "delimiter": "delimitador", "include": "incluir", "length": "longitud", "start": "inicio", "end": "fin", "timeout_ms": "tiempo_ms", "discard": "descartar"}

funcion serial_baud_code(v) { retornar serie_codigo_velocidad(v) }
funcion serial_cflag(base, opciones, k) { retornar serie_cflag(base, _serialport_opt(opciones), k) }
funcion serial_open(ruta, opciones) { retornar serie_abrir(ruta, _serialport_opt(opciones)) }
funcion serial_write(p, datos) { retornar serie_escribir(p, datos) }
funcion serial_drain(p) { retornar serie_drenar(p) }
funcion serial_read(p) { retornar serie_leer(p) }
funcion serial_read_exact(p, n, tiempo_max) { retornar serie_leer_exacto(p, n, tiempo_max) }
funcion serial_read_line(p, tiempo_max, delimitador) { retornar serie_leer_linea(p, tiempo_max, delimitador) }
funcion serial_lines(p, ms) { retornar serie_lineas(p, ms) }
funcion serial_flush(p) { retornar serie_vaciar(p) }
funcion serial_close(p) { retornar serie_cerrar(p) }
funcion serial_list() { retornar _serialport_tr(serie_listar(), _SERIALPORT_RES) }
funcion serial_pty() { retornar _serialport_tr(serie_pty(), _SERIALPORT_RES) }
funcion serial_parser(tipo_a, opciones) { retornar serie_analizador(tipo_a, _serialport_opt(opciones)) }
funcion serial_feed(a, datos) { retornar serie_alimentar(a, datos) }
funcion slip_encode(datos) { retornar serie_slip_codificar(datos) }
funcion slip_decode(datos) { retornar serie_slip_decodificar(datos) }
funcion cobs_encode(datos, delimitar) { retornar serie_cobs_codificar(datos, delimitar) }
funcion cobs_decode(datos) { retornar serie_cobs_decodificar(datos) }
funcion modbus_crc(datos) { retornar serie_crc_modbus(datos) }
funcion modbus_request(unidad, funcion_m, direccion, valor) { retornar serie_modbus_peticion(unidad, funcion_m, direccion, valor) }
funcion modbus_response(datos, cantidad) { retornar _serialport_tr(serie_modbus_respuesta(datos, cantidad), _SERIALPORT_RES) }
funcion modbus_call(p, unidad, funcion_m, direccion, valor, opciones) { retornar _serialport_tr(serie_modbus(p, unidad, funcion_m, direccion, valor, _serialport_opt(opciones)), _SERIALPORT_RES) }

funcion _serialport_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_SERIALPORT_OPT[k] ?? k] = o[k] }
    retornar r
}
