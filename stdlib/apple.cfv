// stdlib/apple.cfv -- Puente con Objective-C para macOS e iOS
// Uso: importar "apple"
//
// Llama a las API nativas de Apple (Foundation, AppKit, UIKit...) desde
// C-Forge con objc_getClass, sel_registerName y objc_msgSend de
// libobjc.A.dylib, mediante extern (ABI AAPCS64 en Apple Silicon e iOS,
// System V en Mac Intel).
//
//   sea info = objc_enviar(objc_clase("NSProcessInfo"), "processInfo")
//   mostrar(texto_de_ns(objc_enviar(info, "operatingSystemVersionString")))
//
// Los argumentos de objc_enviar son objetos, enteros o textos (los textos se
// convierten a NSString). Los selectores con argumentos llevan ":" como en
// Objective-C: objc_enviar(cadena, "stringByAppendingString:", "!").

extern "/usr/lib/libobjc.A.dylib" funcion objc_getClass(nombre: texto): puntero
extern "/usr/lib/libobjc.A.dylib" funcion sel_registerName(nombre: texto): puntero
extern "/usr/lib/libobjc.A.dylib" funcion objc_msgSend_0(objeto: puntero, selector: puntero): puntero como "objc_msgSend"
extern "/usr/lib/libobjc.A.dylib" funcion objc_msgSend_1(objeto: puntero, selector: puntero, a: puntero): puntero como "objc_msgSend"
extern "/usr/lib/libobjc.A.dylib" funcion objc_msgSend_2(objeto: puntero, selector: puntero, a: puntero, b: puntero): puntero como "objc_msgSend"
extern "/usr/lib/libobjc.A.dylib" funcion objc_msgSend_3(objeto: puntero, selector: puntero, a: puntero, b: puntero, c: puntero): puntero como "objc_msgSend"
extern "/usr/lib/libobjc.A.dylib" funcion objc_msgSend_4(objeto: puntero, selector: puntero, a: puntero, b: puntero, c: puntero, d: puntero): puntero como "objc_msgSend"
extern "/usr/lib/libobjc.A.dylib" funcion objc_msgSend_texto(objeto: puntero, selector: puntero, a: texto): puntero como "objc_msgSend"
extern "/usr/lib/libobjc.A.dylib" funcion objc_msgSend_a_texto(objeto: puntero, selector: puntero): texto como "objc_msgSend"
extern "/usr/lib/libobjc.A.dylib" funcion objc_msgSend_doble(objeto: puntero, selector: puntero): numero como "objc_msgSend"
extern "/usr/lib/libobjc.A.dylib" funcion objc_msgSend_bool(objeto: puntero, selector: puntero, a: puntero): booleano como "objc_msgSend"
// Foundation se carga al usarse por primera vez (NSString, NSArray, ...).
extern "/System/Library/Frameworks/Foundation.framework/Foundation" funcion NSHomeDirectory(): puntero

sea apple_listo_ = falso

funcion apple_preparar() {
    si (no apple_listo_) {
        NSHomeDirectory()
        apple_listo_ = verdadero
    }
}

// Clase de Objective-C por nombre ("NSString"), o 0 si no existe.
funcion objc_clase(nombre: texto): puntero {
    apple_preparar()
    retornar objc_getClass(nombre)
}

// Selector ("length", "stringByAppendingString:").
funcion objc_sel(nombre: texto): puntero {
    retornar sel_registerName(nombre)
}

funcion objc_argumento_(v) {
    si (tipo_de(v) == "texto") { retornar ns_texto(v) }
    si (v == nulo) { retornar 0 }
    si (v == verdadero) { retornar 1 }
    si (v == falso) { retornar 0 }
    retornar v
}

// [objeto selector:args...] con objetos, enteros o textos (hasta 4).
funcion objc_enviar(objeto, selector: texto, ...args) {
    apple_preparar()
    sea s = objc_sel(selector)
    sea n = longitud(args)
    si (n == 0) { retornar objc_msgSend_0(objeto, s) }
    si (n == 1) { retornar objc_msgSend_1(objeto, s, objc_argumento_(args[0])) }
    si (n == 2) { retornar objc_msgSend_2(objeto, s, objc_argumento_(args[0]), objc_argumento_(args[1])) }
    si (n == 3) { retornar objc_msgSend_3(objeto, s, objc_argumento_(args[0]), objc_argumento_(args[1]), objc_argumento_(args[2])) }
    si (n == 4) { retornar objc_msgSend_4(objeto, s, objc_argumento_(args[0]), objc_argumento_(args[1]), objc_argumento_(args[2]), objc_argumento_(args[3])) }
    lanzar "objc_enviar admite hasta 4 argumentos"
}

// [objeto selector] que devuelve un double (NSTimeInterval, CGFloat...).
funcion objc_enviar_doble(objeto, selector: texto): numero {
    apple_preparar()
    retornar objc_msgSend_doble(objeto, objc_sel(selector))
}

// Texto de C-Forge → NSString.
funcion ns_texto(s: texto): puntero {
    apple_preparar()
    retornar objc_msgSend_texto(objc_getClass("NSString"), objc_sel("stringWithUTF8String:"), s)
}

// NSString (o cualquier objeto, con description) → texto de C-Forge.
funcion texto_de_ns(objeto): texto {
    si (objeto == 0 o objeto == nulo) { retornar "" }
    sea cadena = objeto
    si (no objc_msgSend_bool(objeto, objc_sel("isKindOfClass:"), objc_getClass("NSString"))) {
        cadena = objc_msgSend_0(objeto, objc_sel("description"))
    }
    // Copia propia en UTF-8 (el búfer de -UTF8String es temporal).
    sea largo = objc_enviar(cadena, "lengthOfBytesUsingEncoding:", 4) + 1
    sea memoria = c_reservar(largo)
    objc_msgSend_3(cadena, objc_sel("getCString:maxLength:encoding:"), memoria, largo, 4)
    sea r = c_texto(memoria)
    c_liberar(memoria)
    retornar r
}

// NSArray → lista de C-Forge (de objetos).
funcion lista_de_ns(arreglo) {
    sea r = []
    sea n = objc_enviar(arreglo, "count")
    sea i = 0
    mientras (i < n) {
        agregar(r, objc_enviar(arreglo, "objectAtIndex:", i))
        i = i + 1
    }
    retornar r
}
