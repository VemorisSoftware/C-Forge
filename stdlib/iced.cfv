// stdlib/iced.cfv — GUI reactiva (estilo Iced): nombres en inglés del módulo "nativa".
// English names for the "nativa" module; both can be used together.


importar "nativa"

funcion _iced_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_iced_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _iced_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _ICED_OPT = {"size": "tam", "color": "color", "align": "alinear", "width": "ancho", "height": "alto", "wrap": "ajustar_lineas", "style": "estilo", "padding": "relleno", "spacing": "espacio", "max_width": "ancho_max", "center_x": "centrar_x", "center_y": "centrar_y", "background": "fondo", "border": "borde", "radius": "radio", "align_x": "alinear_x", "align_y": "alinear_y", "on_submit": "al_enviar", "secure": "secreto", "step": "paso", "placeholder": "marcador", "state": "estado", "update": "actualizar", "view": "vista", "subscriptions": "suscripciones", "title": "titulo", "theme": "tema", "font": "fuente", "rows": "filas", "columns": "columnas"}

funcion iced_text(t, opciones) { retornar nativa_texto(t, _iced_opt(opciones)) }
funcion iced_button(contenido, mensaje, opciones) { retornar nativa_boton(contenido, mensaje, _iced_opt(opciones)) }
funcion iced_column(hijos, opciones) { retornar nativa_columna(hijos, _iced_opt(opciones)) }
funcion iced_row(hijos, opciones) { retornar nativa_fila(hijos, _iced_opt(opciones)) }
funcion iced_container(hijo, opciones) { retornar nativa_contenedor(hijo, _iced_opt(opciones)) }
funcion iced_text_input(marcador, valor, al_cambiar, opciones) { retornar nativa_entrada(marcador, valor, al_cambiar, _iced_opt(opciones)) }
funcion iced_checkbox(etiqueta, marcado, al_cambiar) { retornar nativa_casilla(etiqueta, marcado, al_cambiar) }
funcion iced_toggler(etiqueta, activo, al_cambiar) { retornar nativa_interruptor(etiqueta, activo, al_cambiar) }
funcion iced_radio(etiqueta, valor, seleccionado, al_elegir) { retornar nativa_radio(etiqueta, valor, seleccionado, al_elegir) }
funcion iced_slider(min, max, valor, al_cambiar, opciones) { retornar nativa_deslizador(min, max, valor, al_cambiar, _iced_opt(opciones)) }
funcion iced_progress_bar(min, max, valor, opciones) { retornar nativa_progreso(min, max, valor, _iced_opt(opciones)) }
funcion iced_space(ancho, alto) { retornar nativa_espacio(ancho, alto) }
funcion iced_rule() { retornar nativa_separador() }
funcion iced_scrollable(hijo, opciones) { retornar nativa_desplazable(hijo, _iced_opt(opciones)) }
funcion iced_pick_list(opciones_lista, seleccionada, al_elegir, opciones) { retornar nativa_selector(opciones_lista, seleccionada, al_elegir, _iced_opt(opciones)) }
funcion iced_application(opciones) { retornar nativa_app(_iced_opt(opciones)) }
funcion iced_state(app) { retornar nativa_estado(app) }
funcion iced_layout(app, ancho, alto) { retornar nativa_disponer(app, ancho, alto) }
funcion iced_mouse_move(app, x, py) { retornar nativa_mover(app, x, py) }
funcion iced_mouse_down(app, x, py) { retornar nativa_presionar(app, x, py) }
funcion iced_mouse_up(app, x, py) { retornar nativa_soltar(app, x, py) }
funcion iced_click(app, x, py) { retornar nativa_clic(app, x, py) }
funcion iced_wheel(app, delta) { retornar nativa_rueda(app, delta) }
funcion iced_type_text(app, texto) { retornar nativa_escribir(app, texto) }
funcion iced_key(app, tecla_dada, mayus) { retornar nativa_tecla(app, tecla_dada, mayus) }
funcion iced_selection(app) { retornar nativa_seleccion(app) }
funcion iced_advance(app, ms) { retornar nativa_avanzar(app, ms) }
funcion iced_send(app, mensaje) { retornar nativa_enviar(app, mensaje) }
funcion iced_draw_commands(app) { retornar nativa_comandos(app) }
funcion iced_draw(app, lienzo) { retornar nativa_dibujar(app, lienzo) }
funcion iced_simulate(app, ancho, alto) { retornar nativa_simular(app, ancho, alto) }
funcion iced_find(app, texto_o_id) { retornar nativa_buscar(app, texto_o_id) }
funcion iced_click_on(app, texto_o_id) { retornar nativa_clic_en(app, texto_o_id) }
funcion iced_run(app, ancho, alto) { retornar nativa_ejecutar(app, ancho, alto) }
funcion iced_grid(hijos, opciones) { retornar nativa_rejilla(hijos, _iced_opt(opciones)) }
funcion iced_grid_cell(hijo, fila, columna, tramo_filas, tramo_columnas) { retornar nativa_celda(hijo, fila, columna, tramo_filas, tramo_columnas) }

funcion _iced_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_ICED_OPT[k] ?? k] = o[k] }
    retornar r
}
