// stdlib/shader.cfv — traductor de shaders WGSL: nombres en inglés del módulo "sombreador".
// English names for the "sombreador" module; both can be used together.

importar "sombreador"

funcion _shader_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_shader_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _shader_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _SHADER_RES = {"linea": "line", "columna": "column", "mensaje": "message", "nombre": "name", "etapa": "stage", "grupo_trabajo": "workgroup_size", "grupo": "group", "enlace": "binding", "clase": "kind", "tipo": "type", "acceso": "access", "ranura_msl": "msl_slot", "tipo_msl": "msl_kind", "textura": "texture", "textura_almacen": "storage_texture", "muestreador": "sampler"}

funcion shader_parse(fuente) { retornar sombreador_analizar(fuente) }
funcion shader_validate(fuente) { retornar _shader_tr(sombreador_validar(fuente), _SHADER_RES) }
funcion shader_entry_points(fuente) { retornar _shader_tr(sombreador_entradas(fuente), _SHADER_RES) }
funcion shader_bindings(fuente) { retornar _shader_tr(sombreador_enlaces(fuente), _SHADER_RES) }

// Translate WGSL to "glsl", "msl", "hlsl" or "wgsl". options: "entry"
// (needed for GLSL when there are several), "version" ("450" or "300 es").
funcion shader_translate(source, target, options) {
    sea o = options ?? {}
    sea op = {}
    si (tiene_clave(o, "entry")) { op["entrada"] = o["entry"] }
    si (tiene_clave(o, "version")) { op["version"] = o["version"] }
    retornar sombreador_traducir(source, target, op)
}
