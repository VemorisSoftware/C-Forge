// stdlib/yara.cfv — Reglas de detección de patrones (estilo YARA): nombres en inglés del módulo "huella".
// English names for the "huella" module; both can be used together.

importar "huella"

funcion yara_compile(texto) { retornar huella_compilar(texto) }
funcion yara_scan(reglas, datos) { retornar huella_escanear(reglas, datos) }
funcion yara_scan_file(reglas, ruta) { retornar huella_escanear_archivo(reglas, ruta) }
funcion yara_matching_rules(reglas, datos) { retornar huella_coincidencias(reglas, datos) }
funcion yara_validate(texto) { retornar huella_validar(texto) }
