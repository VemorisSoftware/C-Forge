// stdlib/wireguard.cfv — el protocolo de WireGuard: nombres en inglés del módulo "tunel".
// English names for the "tunel" module; both can be used together.

importar "tunel"

funcion _wireguard_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_wireguard_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _wireguard_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _WIREGUARD_RES = {"privada": "private", "publica": "public", "privada_b64": "private_b64", "publica_b64": "public_b64", "enviar": "send", "paquetes": "packets", "evento": "event", "errores": "errors", "sesion": "session", "enviados": "sent", "recibido_hace_ms": "last_received_ms", "iniciador": "initiator"}

funcion wg_blake2s(datos, n, clave) { retornar tunel_blake2s(datos, n, clave) }
funcion wg_xchacha_seal(k, n24, texto, ad) { retornar tunel_xchacha_cifrar(k, n24, texto, ad) }
funcion wg_xchacha_open(k, n24, cifrado, ad) { retornar tunel_xchacha_descifrar(k, n24, cifrado, ad) }
funcion wg_keypair(privada) { retornar _wireguard_tr(tunel_claves(privada), _WIREGUARD_RES) }
funcion wg_initiate(t) { retornar tunel_iniciar(t) }
funcion wg_encrypt(t, paquete) { retornar tunel_cifrar(t, paquete) }
funcion wg_keepalive(t, forzar) { retornar tunel_keepalive(t, forzar) }
funcion wg_status(t) { retornar _wireguard_tr(tunel_estado(t), _WIREGUARD_RES) }
funcion wg_under_load(t, si_) { retornar tunel_bajo_carga(t, si_) }
funcion wg_udp_packet(origen, destino, puerto_o, puerto_d, datos) { retornar tunel_paquete_udp(origen, destino, puerto_o, puerto_d, datos) }

sea _WG_EVENTOS = {"sesion": "session", "keepalive": "keepalive", "cookie": "cookie"}
sea _WG_ERRORES = {"paquete repetido": "replayed packet", "paquete que no se pudo descifrar": "decryption failed", "índice desconocido": "unknown index",
    "iniciación repetida": "replayed initiation", "iniciación de un par desconocido": "unknown peer", "iniciación que no se pudo descifrar": "bad initiation",
    "respuesta que no se pudo descifrar": "bad response"}
// Process an incoming UDP datagram: {"send", "packets", "event", "errors"}.
funcion wg_receive(t, datagram, origin) {
    sea r = tunel_recibir(t, datagram, origin)
    sea errs = []
    para e en r["errores"] { errs.agregar(_WG_ERRORES[e] ?? e) }
    sea ev = nulo
    si (r["evento"] != nulo) { ev = _WG_EVENTOS[r["evento"]] ?? r["evento"] }
    retornar {"send": r["enviar"], "packets": r["paquetes"], "event": ev, "errors": errs}
}
// New tunnel with a peer. options: "psk", "keepalive" (seconds), "index",
// "ephemeral" (fixed, for tests).
funcion wg_new(private_key, peer_public, options) {
    sea o = options ?? {}
    sea op = {}
    si (tiene_clave(o, "psk")) { op["psk"] = o["psk"] }
    si (tiene_clave(o, "keepalive")) { op["keepalive"] = o["keepalive"] }
    si (tiene_clave(o, "index")) { op["indice"] = o["index"] }
    si (tiene_clave(o, "ephemeral")) { op["efimera"] = o["ephemeral"] }
    retornar tunel_nuevo(private_key, peer_public, op)
}
