// stdlib/simdjson.cfv — JSON rápido bajo demanda (estilo simdjson): nombres en inglés del módulo "rayo_json".
// English names for the "rayo_json" module; both can be used together.

importar "rayo_json"

funcion _simdjson_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_simdjson_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _simdjson_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _SIMDJSON_RES = {"valido": "valid", "mensaje": "message", "posicion": "position", "linea": "line", "columna": "column"}

funcion simdjson_open(texto) { retornar rayo_json_abrir(texto) }
funcion simdjson_raw(d, puntero) { retornar rayo_json_crudo(d, puntero) }
funcion simdjson_at(d, puntero) { retornar rayo_json_en(d, puntero) }
funcion simdjson_exists(d, puntero) { retornar rayo_json_existe(d, puntero) }
funcion simdjson_sub(d, puntero) { retornar rayo_json_sub(d, puntero) }
funcion simdjson_for_each(d, puntero, fn) { retornar rayo_json_recorrer(d, puntero, fn) }
funcion simdjson_count(d, puntero) { retornar rayo_json_contar(d, puntero) }
funcion simdjson_keys(d, puntero) { retornar rayo_json_claves(d, puntero) }
funcion simdjson_value(d) { retornar rayo_json_valor(d) }
funcion simdjson_columns(d, puntero, campos) { retornar rayo_json_columnas(d, puntero, campos) }
funcion simdjson_structural_index(texto) { retornar rayo_json_indice(texto) }
funcion simdjson_validate(texto) { retornar _simdjson_tr(rayo_json_validar(texto), _SIMDJSON_RES) }
funcion simdjson_parse(texto) { retornar rayo_json_parsear(texto) }
funcion simdjson_minify(texto) { retornar rayo_json_minificar(texto) }
funcion simdjson_ndjson_for_each(texto, fn) { retornar rayo_json_lineas_recorrer(texto, fn) }
funcion simdjson_ndjson(texto) { retornar rayo_json_lineas(texto) }
funcion simdjson_to_ndjson(valores) { retornar rayo_json_a_lineas(valores) }

/// Type of the value: "object", "array", "string", "number", "boolean", "null" (or nulo).
funcion simdjson_type(d, pointer) {
    sea t = rayo_json_tipo(d, pointer)
    si (t == nulo) { retornar nulo }
    retornar {"objeto": "object", "lista": "array", "texto": "string", "numero": "number", "booleano": "boolean", "nulo": "null"}[t]
}
