// stdlib/marcado.cfv — Markdown a HTML, seguro por defecto: todo el texto se
// escapa (sin HTML crudo) y los enlaces con javascript:, data: o vbscript:
// se neutralizan. Inspirada en pulldown-cmark (MIT). En inglés:
// importar "markdown".
//
// Soporta: títulos (#), párrafos, **negrita**, *cursiva*, ~~tachado~~,
// `código`, bloques ``` (con lenguaje), citas (>), listas (-, *, 1.),
// enlaces [texto](url), imágenes ![alt](url), línea horizontal (---) y
// salto forzado (dos espacios o \ al final).
//
//   importar "marcado"
//   mostrar(marcado_html("# Hola\n\nEsto es **C-Forge**."))

funcion marcado_escapar(t) {
    sea s = texto_reemplazar("" + t, "&", "&amp;")
    s = texto_reemplazar(s, "<", "&lt;")
    s = texto_reemplazar(s, ">", "&gt;")
    retornar texto_reemplazar(s, "\"", "&quot;")
}

funcion _md_url(u) {
    sea l = texto_minusculas(texto_reemplazar(texto_reemplazar(texto_recortar(u), " ", ""), "\t", ""))
    si (texto_empieza_con(l, "javascript:") o texto_empieza_con(l, "vbscript:") o texto_empieza_con(l, "data:")) { retornar "#" }
    retornar marcado_escapar(texto_recortar(u))
}

// Busca el cierre "fin" desde i; -1 si no está. "fallos" recuerda desde
// dónde ya se buscó cada cierre sin encontrarlo: si no está desde p, tampoco
// está desde ninguna posición posterior, así que no se vuelve a recorrer el
// texto (con miles de "[" o "`" sin cerrar el tiempo era cuadrático).
funcion _md_hasta(t, fin, i, fallos) {
    si (tiene_clave(fallos, fin) y i >= fallos[fin]) { retornar 0 - 1 }
    // Lo mismo con un acierto: si desde d el primero estaba en p, desde
    // cualquier i entre d y p también es p.
    sea clave = "+" + fin
    si (tiene_clave(fallos, clave) y i >= fallos[clave][0] y i <= fallos[clave][1]) { retornar fallos[clave][1] }
    sea p = texto_indice_desde(t, fin, i)
    si (p < 0) { fallos[fin] = i } sino { fallos[clave] = [i, p] }
    retornar p
}

// Topes contra entradas hostiles: anidamiento de formato y de citas, y largo
// de una URL entre paréntesis.
funcion _md_max_anidamiento() { retornar 32 }
funcion _md_max_url() { retornar 4096 }

// Formato en línea (el texto ya viene sin escapar).
funcion _md_linea(t) { retornar _md_linea_en(t, 0) }

funcion _md_linea_en(t, prof) {
    si (prof > _md_max_anidamiento()) { retornar marcado_escapar(t) }
    sea fallos = {}
    sea r = []
    sea i = 0
    sea n = longitud(t)
    mientras (i < n) {
        sea c = subcadena(t, i, i + 1)
        sea dos = subcadena(t, i, i + 2)
        sea hecho = falso
        si (c == "`") {
            sea f = _md_hasta(t, "`", i + 1, fallos)
            si (f > i) {
                r.agregar("<code>" + marcado_escapar(subcadena(t, i + 1, f)) + "</code>")
                i = f + 1
                hecho = verdadero
            }
        }
        si (hecho == falso y (dos == "**" o dos == "__")) {
            sea f = _md_hasta(t, dos, i + 2, fallos)
            si (f > i + 2) {
                r.agregar("<strong>" + _md_linea_en(subcadena(t, i + 2, f), prof + 1) + "</strong>")
                i = f + 2
                hecho = verdadero
            }
        }
        si (hecho == falso y dos == "~~") {
            sea f = _md_hasta(t, "~~", i + 2, fallos)
            si (f > i + 2) {
                r.agregar("<del>" + _md_linea_en(subcadena(t, i + 2, f), prof + 1) + "</del>")
                i = f + 2
                hecho = verdadero
            }
        }
        si (hecho == falso y (c == "*" o c == "_") y i + 1 < n y subcadena(t, i + 1, i + 2) != " ") {
            sea f = _md_hasta(t, c, i + 1, fallos)
            si (f > i + 1) {
                r.agregar("<em>" + _md_linea_en(subcadena(t, i + 1, f), prof + 1) + "</em>")
                i = f + 1
                hecho = verdadero
            }
        }
        si (hecho == falso y (c == "[" o dos == "![")) {
            sea imagen = dos == "!["
            sea a = i + 1
            si (imagen) { a = i + 2 }
            sea cierra = _md_hasta(t, "](", a, fallos)
            si (cierra > 0) {
                // El ")" que cierra (la URL puede tener paréntesis).
                sea fin = 0 - 1
                sea prof = 0
                sea k = cierra + 2
                sea tope = cierra + 2 + _md_max_url()
                // Sin ningún ")" más adelante no hay enlace: no se recorre.
                si (_md_hasta(t, ")", k, fallos) < 0) { k = n }
                mientras (k < n y k < tope y fin < 0) {
                    sea ck = byte_en(t, k)
                    si (ck == 40) { prof = prof + 1 }
                    // Como CommonMark: la URL no cruza líneas ni lleva más de 32
                    // paréntesis anidados (si no, cada "[" recorría miles de bytes).
                    si (prof > 32 o ck == 10) { k = n }
                    si (ck == 41) { si (prof == 0) { fin = k } sino { prof = prof - 1 } }
                    k = k + 1
                }
                si (fin > 0) {
                    sea texto = subcadena(t, a, cierra)
                    sea url = _md_url(subcadena(t, cierra + 2, fin))
                    si (imagen) { r.agregar("<img src=\"" + url + "\" alt=\"" + marcado_escapar(texto) + "\">") } sino { r.agregar("<a href=\"" + url + "\">" + _md_linea_en(texto, prof + 1) + "</a>") }
                    i = fin + 1
                    hecho = verdadero
                }
            }
        }
        si (hecho == falso y c == "\\" y i + 1 < n y texto_indice("\\`*_{}[]()#+-.!~>", subcadena(t, i + 1, i + 2)) >= 0) {
            r.agregar(marcado_escapar(subcadena(t, i + 1, i + 2)))
            i = i + 2
            hecho = verdadero
        }
        si (hecho == falso) {
            r.agregar(marcado_escapar(c))
            i = i + 1
        }
    }
    retornar unir(r, "")
}

funcion _md_lista_item(l) {
    sea s = texto_recortar(l)
    si (texto_empieza_con(s, "- ") o texto_empieza_con(s, "* ") o texto_empieza_con(s, "+ ")) { retornar ["ul", subcadena(s, 2, longitud(s))] }
    sea k = 0
    mientras (k < longitud(s) y texto_indice("0123456789", subcadena(s, k, k + 1)) >= 0) { k = k + 1 }
    si (k > 0 y k < 10 y subcadena(s, k, k + 2) == ". ") { retornar ["ol", subcadena(s, k + 2, longitud(s))] }
    retornar nulo
}

/// Markdown → HTML.
funcion marcado_html(texto) { retornar _md_html(texto, 0) }

funcion _md_html(texto, prof_cita) {
    sea lineas = texto_dividir(texto_reemplazar("" + texto, "\r\n", "\n"), "\n")
    sea r = []
    sea parrafo = []
    sea i = 0
    sea n = longitud(lineas)
    sea cerrar_parrafo = funcion() {
        si (longitud(parrafo) > 0) {
            sea partes = []
            sea k = 0
            mientras (k < longitud(parrafo)) {
                sea l = parrafo[k]
                sea salto = texto_termina_con(l, "  ") o texto_termina_con(l, "\\")
                sea limpia = texto_recortar(l)
                si (texto_termina_con(limpia, "\\")) { limpia = subcadena(limpia, 0, longitud(limpia) - 1) }
                sea h = _md_linea(limpia)
                si (salto y k < longitud(parrafo) - 1) { h = h + "<br>" }
                partes.agregar(h)
                k = k + 1
            }
            r.agregar("<p>" + unir(partes, "\n") + "</p>")
            parrafo = []
        }
    }
    mientras (i < n) {
        sea l = lineas[i]
        sea s = texto_recortar(l)
        si (texto_empieza_con(s, "```")) {
            cerrar_parrafo()
            sea lenguaje = texto_recortar(subcadena(s, 3, longitud(s)))
            sea codigo = []
            i = i + 1
            mientras (i < n y texto_empieza_con(texto_recortar(lineas[i]), "```") == falso) {
                codigo.agregar(lineas[i])
                i = i + 1
            }
            sea clase = ""
            si (lenguaje != "") { clase = " class=\"language-" + marcado_escapar(lenguaje) + "\"" }
            r.agregar("<pre><code" + clase + ">" + marcado_escapar(unir(codigo, "\n")) + "</code></pre>")
            i = i + 1
        } sino {
            si (s == "") {
                cerrar_parrafo()
                i = i + 1
            } sino {
                si (texto_empieza_con(s, "#")) {
                    sea nivel = 0
                    mientras (nivel < longitud(s) y subcadena(s, nivel, nivel + 1) == "#") { nivel = nivel + 1 }
                    si (nivel <= 6 y (nivel == longitud(s) o subcadena(s, nivel, nivel + 1) == " ")) {
                        cerrar_parrafo()
                        sea titulo = texto_recortar(subcadena(s, nivel, longitud(s)))
                        mientras (texto_termina_con(titulo, "#")) { titulo = texto_recortar(subcadena(titulo, 0, longitud(titulo) - 1)) }
                        r.agregar("<h" + nivel + ">" + _md_linea(titulo) + "</h" + nivel + ">")
                    } sino { parrafo.agregar(l) }
                    i = i + 1
                } sino {
                    si (s == "---" o s == "***" o s == "___") {
                        cerrar_parrafo()
                        r.agregar("<hr>")
                        i = i + 1
                    } sino {
                        si (texto_empieza_con(s, ">") y prof_cita < _md_max_anidamiento()) {
                            cerrar_parrafo()
                            sea cita = []
                            mientras (i < n y texto_empieza_con(texto_recortar(lineas[i]), ">")) {
                                sea c = texto_recortar(lineas[i])
                                c = subcadena(c, 1, longitud(c))
                                si (texto_empieza_con(c, " ")) { c = subcadena(c, 1, longitud(c)) }
                                cita.agregar(c)
                                i = i + 1
                            }
                            r.agregar("<blockquote>\n" + _md_html(unir(cita, "\n"), prof_cita + 1) + "</blockquote>")
                        } sino {
                            sea item = _md_lista_item(l)
                            si (item != nulo) {
                                cerrar_parrafo()
                                sea tipo_lista = item[0]
                                r.agregar("<" + tipo_lista + ">")
                                mientras (i < n y _md_lista_item(lineas[i]) != nulo y _md_lista_item(lineas[i])[0] == tipo_lista) {
                                    r.agregar("<li>" + _md_linea(_md_lista_item(lineas[i])[1]) + "</li>")
                                    i = i + 1
                                }
                                r.agregar("</" + tipo_lista + ">")
                            } sino {
                                parrafo.agregar(l)
                                i = i + 1
                            }
                        }
                    }
                }
            }
        }
    }
    cerrar_parrafo()
    retornar unir(r, "\n") + "\n"
}
