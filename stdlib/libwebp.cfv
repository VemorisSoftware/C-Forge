// stdlib/libwebp.cfv — WebP sin pérdida (estilo libwebp): nombres en inglés del módulo "formato_web".
// English names for the "formato_web" module; both can be used together.

importar "formato_web"

funcion _libwebp_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_libwebp_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _libwebp_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _LIBWEBP_RES = {"ancho": "width", "alto": "height", "sin_perdida": "lossless"}

funcion webp_decode(datos) { retornar webp_decodificar(datos) }
funcion webp_encode_lossless(img) { retornar webp_codificar(img) }
funcion webp_get_info(datos) { retornar _libwebp_tr(webp_info(datos), _LIBWEBP_RES) }
