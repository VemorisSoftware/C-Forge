// stdlib/quinn.cfv — QUIC v1 y HTTP/3: nombres en inglés del módulo "veloz".
// English names for the "veloz" module; both can be used together.

importar "veloz"

funcion quic_varint(v) { retornar veloz_varint(v) }
funcion quic_protect_packet(k, cabecera, pn, pn_pos, pn_largo, carga) { retornar veloz_proteger(k, cabecera, pn, pn_pos, pn_largo, carga) }
funcion quic_receive(q, datos, ahora) { retornar veloz_recibir(q, datos, ahora) }
funcion quic_poll_transmit(q, ahora) { retornar veloz_salida(q, ahora) }
funcion quic_timeout(q, ahora) { retornar veloz_espera(q, ahora) }
funcion quic_is_connected(q) { retornar veloz_conectado(q) }
funcion quic_open_stream(q, bidireccional) { retornar veloz_flujo_abrir(q, bidireccional) }
funcion quic_stream_write(q, id, datos, fin) { retornar veloz_flujo_escribir(q, id, datos, fin) }
funcion quic_accept_streams(q) { retornar veloz_flujos_nuevos(q) }
funcion quic_close(q, codigo, razon) { retornar veloz_cerrar(q, codigo, razon) }
funcion qpack_encode(cabeceras) { retornar veloz_qpack_codificar(cabeceras) }
funcion qpack_decode(d) { retornar veloz_qpack_decodificar(d) }
funcion hpack_huffman_decode(d) { retornar veloz_huffman_decodificar(d) }

sea _QUINN_OP = {"roots": "raices", "verify": "verificar", "alpn": "alpn", "chain": "cadena", "key": "clave", "idle_ms": "inactividad_ms", "sni": "sni",
    "method": "metodo", "headers": "cabeceras", "body": "cuerpo", "timeout_ms": "espera_ms", "max_ms": "max_ms", "max_requests": "max_solicitudes", "groups": "grupos", "suites": "suites"}
funcion _quinn_op(o) {
    si (o == nulo) { retornar nulo }
    sea r = {}
    para k en claves(o) { r[_QUINN_OP[k] ?? k] = o[k] }
    retornar r
}
// Initial keys from the client DCID: {"client", "server"} with key, iv, hp.
funcion quic_initial_keys(dcid) {
    sea k = veloz_claves_iniciales(dcid)
    retornar {"client": {"key": k["cliente"]["clave"], "iv": k["cliente"]["iv"], "hp": k["cliente"]["hp"]}, "server": {"key": k["servidor"]["clave"], "iv": k["servidor"]["iv"], "hp": k["servidor"]["hp"]}}
}
// Client connection without I/O. options: "roots", "verify", "alpn", "idle_ms".
funcion quic_client(server_name, options) { retornar veloz_cliente(server_name, _quinn_op(options)) }
// Server connection without I/O. options: "chain", "key", "alpn".
funcion quic_server(options) { retornar veloz_servidor(_quinn_op(options)) }
// Read a stream: {"data", "fin"}.
funcion quic_stream_read(q, id) {
    sea r = veloz_flujo_leer(q, id)
    retornar {"data": r["datos"], "fin": r["fin"]}
}
// Pending events, translated: connected, stream, data, reset, closed.
funcion quic_events(q) {
    sea tipos = {"conectado": "connected", "flujo": "stream", "datos": "data", "reinicio": "reset", "cerrado": "closed"}
    sea r = []
    para e en veloz_eventos(q) {
        sea x = {"type": tipos[e["tipo"]] ?? e["tipo"]}
        si (tiene_clave(e, "id")) { x["id"] = e["id"] }
        si (tiene_clave(e, "codigo")) { x["code"] = e["codigo"] }
        si (tiene_clave(e, "razon")) { x["reason"] = e["razon"] }
        r.agregar(x)
    }
    retornar r
}
// Send an HTTP/3 request on a new stream; returns the stream id.
funcion h3_request(q, method, authority, path, headers, body) { retornar veloz_h3_solicitar(q, method, authority, path, headers, body) }
// Response so far: {"status", "headers", "body", "fin"}.
funcion h3_response(q, id) {
    sea r = veloz_h3_respuesta(q, id)
    retornar {"status": r["estado"], "headers": r["cabeceras"], "body": r["cuerpo"], "fin": r["fin"]}
}
// Serve complete requests with handler(req) where req = {"method", "path",
// "authority", "headers", "body"} and it returns {"status", "headers", "body"}.
funcion h3_serve_requests(q, handler) {
    retornar veloz_h3_atender(q, funcion(req) {
        sea r = handler({"method": req["metodo"], "path": req["ruta"], "authority": req["autoridad"], "headers": req["cabeceras"], "body": req["cuerpo"]})
        retornar {"estado": r["status"] ?? 200, "cabeceras": r["headers"] ?? {}, "cuerpo": r["body"] ?? ""}
    })
}
// HTTP/3 request over UDP. options: "roots", "verify", "method", "headers", "body", "timeout_ms".
funcion h3_fetch(url, options) {
    sea r = veloz_http3_get(url, _quinn_op(options))
    retornar {"status": r["estado"], "headers": r["cabeceras"], "body": r["cuerpo"], "alpn": r["alpn"]}
}
// HTTP/3 server over UDP. options: "chain", "key", "max_ms", "max_requests".
funcion h3_listen(port, options, handler) {
    retornar veloz_http3_servir(port, _quinn_op(options), funcion(req) {
        sea r = handler({"method": req["metodo"], "path": req["ruta"], "authority": req["autoridad"], "headers": req["cabeceras"], "body": req["cuerpo"]})
        retornar {"estado": r["status"] ?? 200, "cabeceras": r["headers"] ?? {}, "cuerpo": r["body"] ?? ""}
    })
}
