// stdlib/dap.cfv — cliente del Debug Adapter Protocol: nombres en inglés del módulo "depura".
// English names for the "depura" module; both can be used together.


importar "depura"

funcion _dap_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_dap_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _dap_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _DAP_OPT = {"transport": "transporte", "reverse_requests": "inversas"}

funcion dap_encode(m) { retornar depura_codificar(m) }
funcion dap_connect(host, puerto, opciones) { retornar depura_conectar(host, puerto, _dap_opt(opciones)) }
funcion dap_send(c, comando, argumentos) { retornar depura_enviar(c, comando, argumentos) }
funcion dap_response(c, seq) { retornar depura_respuesta(c, seq) }
funcion dap_request(c, comando, argumentos) { retornar depura_pedir(c, comando, argumentos) }
funcion dap_error_text(e) { retornar depura_error_texto(e) }
funcion dap_wait_event(c, nombre, filtro) { retornar depura_esperar_evento(c, nombre, filtro) }
funcion dap_output(c, categoria) { retornar depura_salida(c, categoria) }
funcion dap_initialize(c, opciones) { retornar depura_inicializar(c, _dap_opt(opciones)) }
funcion dap_set_breakpoints(c, ruta, lineas) { retornar depura_puntos(c, ruta, lineas) }
funcion dap_function_breakpoints(c, nombres) { retornar depura_puntos_funcion(c, nombres) }
funcion dap_exception_breakpoints(c, filtros) { retornar depura_excepciones(c, filtros) }
funcion dap_configuration_done(c) { retornar depura_configuracion_lista(c) }
funcion dap_threads(c) { retornar depura_hilos(c) }
funcion dap_stack(c, hilo) { retornar depura_pila(c, hilo) }
funcion dap_scopes(c, marco) { retornar depura_ambitos(c, marco) }
funcion dap_variables(c, referencia) { retornar depura_variables(c, referencia) }
funcion dap_locals(c, marco) { retornar depura_locales(c, marco) }
funcion dap_evaluate(c, expresion, marco, contexto) { retornar depura_evaluar(c, expresion, marco, contexto) }
funcion dap_continue(c, hilo) { retornar depura_continuar(c, hilo) }
funcion dap_next(c, hilo) { retornar depura_siguiente(c, hilo) }
funcion dap_step_in(c, hilo) { retornar depura_entrar(c, hilo) }
funcion dap_step_out(c, hilo) { retornar depura_salir(c, hilo) }
funcion dap_pause(c, hilo) { retornar depura_pausar(c, hilo) }
funcion dap_step(c, hilo, tipo_paso) { retornar depura_paso(c, hilo, tipo_paso) }
funcion dap_disconnect(c, terminar) { retornar depura_desconectar(c, terminar) }
funcion dap_mock(ruta, programa) { retornar depura_simulado(ruta, programa) }

funcion _dap_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_DAP_OPT[k] ?? k] = o[k] }
    retornar r
}
