// stdlib/fulltext.cfv — búsqueda full-text: nombres en inglés del módulo "buscador".
// English names for the "buscador" module; both can be used together.


importar "buscador"

funcion _fulltext_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_fulltext_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _fulltext_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _FULLTEXT_RES = {"resultados": "hits", "puntaje": "score", "fragmento": "snippet", "facetas": "facets"}
sea _FULLTEXT_OPT = {"fields": "campos", "language": "idioma", "stemming": "raices", "stopwords": "vacias", "facets": "facetas", "synonyms": "sinonimos", "limit": "limite", "offset": "desde", "typos": "tolerancia", "sort": "orden", "filter": "filtro", "highlight": "resaltar"}

funcion fulltext_new(opciones) { retornar buscador_nuevo(_fulltext_opt(opciones)) }
funcion fulltext_analyze(b, texto) { retornar buscador_analizar(b, texto) }
funcion fulltext_add(b, id, doc) { retornar buscador_agregar(b, id, doc) }
funcion fulltext_remove(b, id) { retornar buscador_quitar(b, id) }
funcion fulltext_count(b) { retornar buscador_cantidad(b) }
funcion levenshtein(a, b, tope) { retornar buscador_distancia(a, b, tope) }
funcion fulltext_search(b, consulta, opciones) { retornar _fulltext_tr(buscador_buscar(b, consulta, _fulltext_opt(opciones)), _FULLTEXT_RES) }
funcion fulltext_snippet(b, texto, terminos) { retornar buscador_fragmento(b, texto, terminos) }
funcion fulltext_suggest(b, prefijo, n) { retornar buscador_sugerir(b, prefijo, n) }

funcion _fulltext_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_FULLTEXT_OPT[k] ?? k] = o[k] }
    retornar r
}
