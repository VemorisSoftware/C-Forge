// stdlib/trpc.cfv — APIs con tipos compartidos: nombres en inglés del módulo "extremo".
// English names for the "extremo" module; both can be used together.


importar "extremo"

funcion _trpc_tr(v, tabla) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(_trpc_tr(x, tabla)) }
        retornar r
    }
    si (tipo(v) == "mapa") {
        sea r = {}
        para k en claves(v) { r[tabla[k] ?? k] = _trpc_tr(v[k], tabla) }
        retornar r
    }
    retornar v
}

sea _TRPC_RES = {"estado": "status", "tipo": "type", "cabeceras": "headers", "cuerpo": "body"}
sea _TRPC_OPT = {"output": "salida", "middlewares": "middlewares", "prefix": "prefijo", "context": "contexto", "headers": "cabeceras", "method": "metodo", "path": "ruta", "body": "cuerpo"}

funcion trpc_query(entrada, f, opciones) { retornar extremo_consulta(entrada, f, _trpc_opt(opciones)) }
funcion trpc_mutation(entrada, f, opciones) { retornar extremo_mutacion(entrada, f, _trpc_opt(opciones)) }
funcion trpc_router(procs, middlewares) { retornar extremo_enrutador(procs, middlewares) }
funcion trpc_middleware(f) { retornar extremo_middleware(f) }
funcion trpc_error(codigo, mensaje, datos) { retornar extremo_error(codigo, mensaje, datos) }
funcion trpc_call(enrutador, ruta, entrada, ctx) { retornar extremo_llamar(enrutador, ruta, entrada, ctx) }
funcion trpc_handle(enrutador, solicitud, opciones) { retornar _trpc_tr(extremo_manejar(enrutador, solicitud, _trpc_opt(opciones)), _TRPC_RES) }
funcion trpc_serve(enrutador, puerto, opciones) { retornar extremo_servir(enrutador, puerto, _trpc_opt(opciones)) }
funcion trpc_client(url, opciones) { retornar extremo_cliente(url, _trpc_opt(opciones)) }
funcion trpc_client_query(cliente, ruta, entrada) { retornar extremo_consultar(cliente, ruta, entrada) }
funcion trpc_client_mutate(cliente, ruta, entrada) { retornar extremo_mutar(cliente, ruta, entrada) }
funcion trpc_error_message(e) { retornar extremo_mensaje(e) }
funcion trpc_typescript(enrutador, nombre) { retornar extremo_tipos_ts(enrutador, nombre) }

funcion _trpc_opt(o) {
    si (o == nulo o tipo(o) != "mapa") { retornar o }
    sea r = {}
    para k en claves(o) { r[_TRPC_OPT[k] ?? k] = o[k] }
    retornar r
}

/// request: {"method", "path", "body", "headers"} → {"status", "type", "headers", "body"}.
funcion trpc_handle_en(router, request, options) { retornar _trpc_tr(extremo_manejar(router, _trpc_opt(request), _trpc_opt(options)), _TRPC_RES) }
