// stdlib/progreso.cfv — barras de progreso y spinners para la terminal.
// Inspirada en indicatif (MIT). Se redibuja en la misma línea (\r).
//
//   importar "progreso"
//   sea p = progreso_nuevo(100, "Descargando")
//   para i en rango(100) { progreso_avanzar(p, 1) }
//   progreso_terminar(p)

funcion progreso_nuevo(total, etiqueta) {
    retornar {"total": total, "actual": 0, "etiqueta": etiqueta ?? "", "inicio": cfv_fecha_ahora_ms(), "ancho": 30, "ultimo": 0 - 1000, "salida": verdadero}
}

funcion _progreso_tiempo(ms) {
    sea s = piso(ms / 1000)
    si (s < 60) { retornar "" + s + "s" }
    retornar "" + piso(s / 60) + "m" + (s % 60) + "s"
}

/// Texto de la barra (sin \r), p. ej. "Etiqueta [██████░░░░] 60% 60/100 eta 2s".
funcion progreso_linea(p) {
    sea total = p["total"]
    sea actual = p["actual"]
    sea fraccion = 0
    si (total > 0) { fraccion = actual / total }
    si (fraccion > 1) { fraccion = 1 }
    sea llenos = piso(fraccion * p["ancho"])
    sea barra = texto_repetir("█", llenos) + texto_repetir("░", p["ancho"] - llenos)
    sea transcurrido = cfv_fecha_ahora_ms() - p["inicio"]
    sea eta = "?"
    si (actual > 0 y actual < total) { eta = _progreso_tiempo(transcurrido * (total - actual) / actual) }
    si (actual >= total) { eta = _progreso_tiempo(transcurrido) }
    sea pre = ""
    si (p["etiqueta"] != "") { pre = p["etiqueta"] + " " }
    retornar pre + "[" + barra + "] " + piso(fraccion * 100) + "% " + actual + "/" + total + " " + eta
}

/// Avanza n pasos y redibuja (como mucho cada 50 ms para no frenar el programa).
funcion progreso_avanzar(p, n) {
    p["actual"] = p["actual"] + (n ?? 1)
    sea ahora = cfv_fecha_ahora_ms()
    si (p["salida"] y (ahora - p["ultimo"] >= 50 o p["actual"] >= p["total"])) {
        p["ultimo"] = ahora
        escribir("\r" + progreso_linea(p))
    }
}

/// Termina la barra (al 100 % si se pide) y baja de línea.
funcion progreso_terminar(p) {
    si (p["salida"]) { escribir("\r" + progreso_linea(p) + "\n") }
}

sea _PROGRESO_GIROS = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]

/// Spinner: progreso_girar(s) en cada vuelta de un trabajo sin total conocido.
funcion progreso_spinner(etiqueta) { retornar {"paso": 0, "etiqueta": etiqueta ?? ""} }

funcion progreso_girar(s) {
    escribir("\r" + _PROGRESO_GIROS[s["paso"] % longitud(_PROGRESO_GIROS)] + " " + s["etiqueta"])
    s["paso"] = s["paso"] + 1
}

funcion progreso_listo(s, mensaje) { escribir("\r✓ " + (mensaje ?? s["etiqueta"]) + "\n") }
