// Conditions and loops
function classify(n) {
    if (n < 0) { return "negative" }
    if (n == 0) { return "zero" }
    return "positive"
}

print(classify(-5))
print(classify(42))

let sum = 0
let i = 1
while (i <= 10) {
    sum = sum + i
    i = i + 1
}
print(sum)

for fruit in ["apple", "pear"] {
    print(fruit)
}
