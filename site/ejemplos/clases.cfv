// Clases con estado y métodos
clase Cuenta {
    sea saldo = 0

    funcion constructor(inicial) {
        esto.saldo = inicial
    }

    funcion depositar(monto) {
        esto.saldo = esto.saldo + monto
        retornar esto.saldo
    }
}

sea cuenta = Cuenta(100)
cuenta.depositar(50)
mostrar(cuenta.saldo)
