// Condiciones y ciclos
funcion clasificar(n) {
    si (n < 0) { retornar "negativo" }
    si (n == 0) { retornar "cero" }
    retornar "positivo"
}

mostrar(clasificar(-5))
mostrar(clasificar(42))

sea suma = 0
sea i = 1
mientras (i <= 10) {
    suma = suma + i
    i = i + 1
}
mostrar(suma)

para fruta en ["manzana", "pera"] {
    mostrar(fruta)
}
