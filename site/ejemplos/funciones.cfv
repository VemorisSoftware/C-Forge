// Funciones, recursión y closures
funcion factorial(n) {
    si (n <= 1) { retornar 1 }
    retornar n * factorial(n - 1)
}

funcion crear_sumador(base) {
    retornar funcion(valor) {
        retornar base + valor
    }
}

sea sumar_diez = crear_sumador(10)
mostrar(factorial(6))
mostrar(sumar_diez(32))
