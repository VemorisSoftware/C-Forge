// La forja — física de las partículas de c-forge.org, escrita en C-Forge y
// compilada a WebAssembly (cforge build forja.cfv --target wasm --release).
//
// Todo en enteros de punto fijo (1000 = una unidad del mundo): cada cuadro
// usa sumas, productos y cociente() en línea, sin crear objetos. JavaScript
// solo dibuja: lee las posiciones directamente de la memoria de estas listas.
//
// Formas (según el scroll): 0 núcleo · 1 malla ondulada · 2 letras CF ·
// 3 galaxia. El mouse empuja las partículas y el calor sube con la velocidad.

extern "js" funcion forja_entrada(k: entero): entero
extern "js" funcion forja_listas(x: puntero, y: puntero, z: puntero, calor: puntero, n: entero)

sea N = forja_entrada(0)

// Seno y coseno con una tabla de 4096 pasos por vuelta (valores × 1024).
sea SENO = []
para i en rango(4096) { SENO.agregar(piso(seno(i * 2 * pi() / 4096) * 1024 + 0.5)) }
funcion tsen(a) { retornar SENO[bits_y(a, 4095)] }
funcion tcos(a) { retornar SENO[bits_y(a + 1024, 4095)] }

// Azar reproducible (congruencial).
sea semilla = 1234567
funcion azar(n) {
    semilla = (semilla * 1103515245 + 12345) % 2147483648
    retornar semilla % n
}
// Aproximación de una normal × 1000 (suma de cuatro uniformes).
funcion gauss() { retornar azar(1000) + azar(1000) + azar(1000) + azar(1000) - 2000 }

// ── Formas base ──
sea ex = []
sea ey = []
sea ez = []
sea mu = []
sea mv = []
sea lx = []
sea ly = []
sea lz = []
sea gr = []
sea ga = []
sea gz = []
sea lado = piso(raiz(N)) + 1
para i en rango(N) {
    // Núcleo: esfera de Fibonacci con capas.
    sea y = 1 - (i / (N - 1.0)) * 2
    sea r = raiz(1 - y * y)
    sea th = i * 2.399963
    sea capa = 1000 + cociente(gauss() * 6, 100)
    si (azar(100) < 12) { capa = capa + azar(600) }
    ex.agregar(cociente(piso(coseno(th) * r * 1000) * capa, 1000))
    ey.agregar(cociente(piso(y * 1000) * capa, 1000))
    ez.agregar(cociente(piso(seno(th) * r * 1000) * capa, 1000))
    // Malla: u, v en -1000..1000.
    mu.agregar(cociente((i % lado) * 2000, lado - 1) - 1000)
    mv.agregar(cociente(cociente(i, lado) * 2000, lado - 1) - 1000)
    // Letras C y F trazadas con geometría.
    sea parte = azar(100)
    sea px = 0
    sea py = 0
    si (parte < 55) {
        sea ang = 455 + azar(3186)
        sea rad = 1050 + azar(260)
        px = 0 - 1350 + cociente(tcos(ang) * rad, 1024)
        py = 200 + cociente(tsen(ang) * rad, 1024)
    } sino {
        si (parte < 75) {
            px = 450 + azar(280)
            py = 0 - 1050 + azar(2400)
        } sino {
            si (parte < 89) {
                px = 450 + azar(1250)
                py = 1080 + azar(270)
            } sino {
                px = 450 + azar(950)
                py = 120 + azar(260)
            }
        }
    }
    lx.agregar(px)
    ly.agregar(py)
    lz.agregar(cociente(gauss() * 12, 100))
    // Galaxia de dos brazos.
    sea u = azar(10000) / 10000.0
    sea radio = piso(potencia(u, 0.7) * 3400)
    gr.agregar(radio)
    ga.agregar((i % 2) * 2048 + cociente(radio * 1238, 1000) + cociente(gauss() * 180, 400 + cociente(radio * 3, 10)))
    gz.agregar(cociente(gauss() * 7 * (3600 - radio), 100000))
}

// ── Estado: posiciones, velocidades y calor ──
sea X = []
sea Y = []
sea Z = []
sea VX = []
sea VY = []
sea VZ = []
sea CALOR = []
para i en rango(N) {
    X.agregar(ex[i] * 4 + cociente(gauss(), 5))
    Y.agregar(ey[i] * 4 + cociente(gauss(), 5))
    Z.agregar(ez[i] * 4)
    VX.agregar(0)
    VY.agregar(0)
    VZ.agregar(0)
    CALOR.agregar(0)
}
forja_listas(lista_direccion(X), lista_direccion(Y), lista_direccion(Z), lista_direccion(CALOR), N)

// Un cuadro: t (ms), etapa y mezcla (× 1000), centro del núcleo y mouse
// (× 1000) llegan desde JavaScript con forja_entrada. Todo va en línea (sin
// llamadas por partícula) para que el cuadro quepa en unos pocos ms.
funcion forja_paso(nada) {
    sea t = forja_entrada(1)
    sea etapa = forja_entrada(2)
    sea mezcla = forja_entrada(3)
    sea cx = forja_entrada(4)
    sea cy = forja_entrada(5)
    sea mx = forja_entrada(6)
    sea my = forja_entrada(7)
    sea raton = forja_entrada(8)
    sea fa = minimo(3, cociente(etapa, 1000))
    sea fb = minimo(3, fa + 1)
    // Lo que depende solo del tiempo, una vez por cuadro.
    sea giro = cociente(t * 167, 1024)
    sea ca = tcos(giro)
    sea sa = tsen(giro)
    sea t847 = cociente(t * 867, 1024)
    sea t652 = cociente(t * 668, 1024)
    sea t587 = cociente(t * 601, 1024)
    sea t391 = cociente(t * 400, 1024)
    sea t913 = cociente(t * 935, 1024)
    sea t1043 = cociente(t * 1068, 1024)
    sea mezclar = mezcla > 1
    sea tx = 0
    sea ty = 0
    sea tz = 0
    sea ux = 0
    sea uy = 0
    sea uz = 0
    sea i = 0
    mientras (i < N) {
        si (fa == 0) {
            sea x0 = ex[i]
            sea y0 = ey[i]
            sea z0 = ez[i]
            sea a1 = cociente(x0 * 2070, 1024) + t847
            sea a2 = cociente(y0 * 1802, 1024) - t652
            sea ondula = 900 + cociente(80 * SENO[bits_y(a1, 4095)] * SENO[bits_y(a2 + 1024, 4095)], 1048576)
            tx = cx + cociente(cociente(x0 * ca - z0 * sa, 1024) * ondula, 1024)
            ty = cy + cociente(y0 * ondula, 1024)
            tz = cociente(cociente(x0 * sa + z0 * ca, 1024) * ondula, 1024)
        } sino {
            si (fa == 1) {
                sea u = mu[i]
                sea v = mv[i]
                sea b1 = cociente(u * 2136, 1024) + t587
                sea b2 = cociente(v * 1535, 1024) + t391
                sea b3 = cociente(u * 4673, 1024) - t913
                tx = cociente(u * 6656, 1024)
                tz = v * 3 - 1200
                ty = 0 - 1100 + cociente(420 * SENO[bits_y(b1, 4095)] * SENO[bits_y(b2 + 1024, 4095)], 1048576) + cociente(184 * SENO[bits_y(b3, 4095)], 1024)
            } sino {
                si (fa == 2) {
                    sea qx = lx[i]
                    sea qy = ly[i]
                    sea c1 = t1043 + qx
                    sea c2 = t652 + qy * 2
                    sea resp = 1024 + cociente(31 * SENO[bits_y(c1, 4095)], 1024)
                    tx = cociente(qx * resp, 1024)
                    ty = cociente(qy * resp, 1024) + 200
                    tz = lz[i] + cociente(80 * SENO[bits_y(c2, 4095)], 1024)
                } sino {
                    sea radio = gr[i]
                    sea ang = ga[i] + cociente(t * 52, 300 + cociente(radio, 4))
                    sea gx = cociente(SENO[bits_y(ang + 1024, 4095)] * radio, 1024)
                    sea gy = cociente(SENO[bits_y(ang, 4095)] * radio, 1024)
                    tx = gx
                    ty = cociente(gy * 430, 1024) + gz[i] - 200
                    tz = cociente(gy * 922, 1024) - gz[i]
                }
            }
        }
        si (mezclar) {
            si (fb == 0) {
                sea x0 = ex[i]
                sea y0 = ey[i]
                sea z0 = ez[i]
                sea a1 = cociente(x0 * 2070, 1024) + t847
                sea a2 = cociente(y0 * 1802, 1024) - t652
                sea ondula = 900 + cociente(80 * SENO[bits_y(a1, 4095)] * SENO[bits_y(a2 + 1024, 4095)], 1048576)
                ux = cx + cociente(cociente(x0 * ca - z0 * sa, 1024) * ondula, 1024)
                uy = cy + cociente(y0 * ondula, 1024)
                uz = cociente(cociente(x0 * sa + z0 * ca, 1024) * ondula, 1024)
            } sino {
                si (fb == 1) {
                    sea u = mu[i]
                    sea v = mv[i]
                    sea b1 = cociente(u * 2136, 1024) + t587
                    sea b2 = cociente(v * 1535, 1024) + t391
                    sea b3 = cociente(u * 4673, 1024) - t913
                    ux = cociente(u * 6656, 1024)
                    uz = v * 3 - 1200
                    uy = 0 - 1100 + cociente(420 * SENO[bits_y(b1, 4095)] * SENO[bits_y(b2 + 1024, 4095)], 1048576) + cociente(184 * SENO[bits_y(b3, 4095)], 1024)
                } sino {
                    si (fb == 2) {
                        sea qx = lx[i]
                        sea qy = ly[i]
                        sea c1 = t1043 + qx
                        sea c2 = t652 + qy * 2
                        sea resp = 1024 + cociente(31 * SENO[bits_y(c1, 4095)], 1024)
                        ux = cociente(qx * resp, 1024)
                        uy = cociente(qy * resp, 1024) + 200
                        uz = lz[i] + cociente(80 * SENO[bits_y(c2, 4095)], 1024)
                    } sino {
                        sea radio = gr[i]
                        sea ang = ga[i] + cociente(t * 52, 300 + cociente(radio, 4))
                        sea gx = cociente(SENO[bits_y(ang + 1024, 4095)] * radio, 1024)
                        sea gy = cociente(SENO[bits_y(ang, 4095)] * radio, 1024)
                        ux = gx
                        uy = cociente(gy * 430, 1024) + gz[i] - 200
                        uz = cociente(gy * 922, 1024) - gz[i]
                    }
                }
            }
            tx = tx + cociente((ux - tx) * mezcla, 1024)
            ty = ty + cociente((uy - ty) * mezcla, 1024)
            tz = tz + cociente((uz - tz) * mezcla, 1024)
        }
        sea x = X[i]
        sea y = Y[i]
        sea z = Z[i]
        sea vx = VX[i] + cociente((tx - x) * 36, 1024)
        sea vy = VY[i] + cociente((ty - y) * 36, 1024)
        sea vz = VZ[i] + cociente((tz - z) * 36, 1024)
        // El mouse empuja lo que está cerca (en el plano de la pantalla).
        si (raton == 1) {
            sea dx = x - mx
            sea dy = y - my
            si (dx > 0 - 1300 y dx < 1300 y dy > 0 - 1300 y dy < 1300) {
                sea d2 = cociente(dx * dx + dy * dy, 1024)
                si (d2 < 1562) {
                    sea w = 1562 - d2
                    vx = vx + cociente(dx * w * 75, 1048576)
                    vy = vy + cociente(dy * w * 75, 1048576)
                    vz = vz + cociente(w * 26, 1024)
                }
            }
        }
        vx = cociente(vx * 901, 1024)
        vy = cociente(vy * 901, 1024)
        vz = cociente(vz * 901, 1024)
        X[i] = x + vx
        Y[i] = y + vy
        Z[i] = z + vz
        VX[i] = vx
        VY[i] = vy
        VZ[i] = vz
        sea rapidez = vx + vy + vz
        si (vx < 0) { rapidez = rapidez - vx - vx }
        si (vy < 0) { rapidez = rapidez - vy - vy }
        si (vz < 0) { rapidez = rapidez - vz - vz }
        si (rapidez > 250) { rapidez = 250 }
        CALOR[i] = rapidez * 4
        i = i + 1
    }
    retornar 0
}
