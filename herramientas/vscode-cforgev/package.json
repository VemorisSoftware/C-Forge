{
  "name": "cforgev-language",
  "displayName": "C-Forge Language Support",
  "description": "Soporte oficial de C-Forge (.cfv): servidor de lenguaje (diagnósticos, autocompletado, ir a la definición, formateo), resaltado y comandos.",
  "version": "4.4.0",
  "publisher": "vemoris-group",
  "author": {
    "name": "Vemoris Group"
  },
  "license": "SEE LICENSE IN LICENSE",
  "icon": "images/icon.png",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:cforge"
  ],
  "pricing": "Free",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "c-forge",
    "cforge",
    "cforgev",
    "cfv",
    "programming language",
    "syntax highlighting",
    "vemoris",
    "compiler"
  ],
  "galleryBanner": {
    "color": "#FF6A32",
    "theme": "light"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VemorisSoftware/C-Forge.git"
  },
  "homepage": "https://c-forge.org",
  "bugs": {
    "url": "https://github.com/VemorisSoftware/C-Forge/issues"
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "cforge.runFile",
        "title": "C-Forge: Ejecutar archivo"
      },
      {
        "command": "cforge.checkFile",
        "title": "C-Forge: Comprobar archivo"
      },
      {
        "command": "cforge.formatFile",
        "title": "C-Forge: Formatear archivo"
      },
      {
        "command": "cforge.restartServer",
        "title": "C-Forge: Reiniciar el servidor de lenguaje"
      }
    ],
    "languages": [
      {
        "id": "cforge",
        "aliases": [
          "C-Forge",
          "cforge",
          "cforgev"
        ],
        "extensions": [
          ".cfv"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/icon.png",
          "dark": "./images/icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "cforge",
        "scopeName": "source.cforgev",
        "path": "./syntaxes/cforgev.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cforge",
        "path": "./syntaxes/snippets.json"
      }
    ],
    "configuration": {
      "title": "C-Forge",
      "properties": {
        "cforge.ruta": {
          "type": "string",
          "default": "cforge",
          "description": "Ruta del ejecutable cforge (por defecto, el del PATH)."
        },
        "cforge.lsp.habilitado": {
          "type": "boolean",
          "default": true,
          "description": "Iniciar el servidor de lenguaje (cforge lsp)."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
