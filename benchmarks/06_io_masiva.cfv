// I/O: construye ~5,5 MiB, escribe, lee y verifica el tamaño.
sea bloque = "C-Forge benchmark io 0123456789 abcdefghijklmnopqrstuvwxyz ABCDEFGHIJKLMNOPQRSTUVWXYZ\n";
// Duplicar el bloque 16 veces: 88 B · 2^16 ≈ 5,5 MiB con pocas copias.
sea contenido = bloque;
sea indice = 0;

mientras (indice < 16) {
    contenido = contenido + contenido;
    indice = indice + 1;
}

sea inicio_escritura = tiempo_actual();
file_write("../build/benchmarks/io-masiva.txt", contenido);
sea fin_escritura = tiempo_actual();

sea inicio_lectura = tiempo_actual();
sea leido = file_read("../build/benchmarks/io-masiva.txt");
sea fin_lectura = tiempo_actual();

mostrar("=== I/O: archivo masivo ===");
mostrar("Bytes aproximados:");
mostrar(longitud(leido));
mostrar("Segundos de escritura:");
mostrar(fin_escritura - inicio_escritura);
mostrar("Segundos de lectura:");
mostrar(fin_lectura - inicio_lectura);
afirmar(longitud(leido) == longitud(contenido), "La lectura no coincide con la escritura");
