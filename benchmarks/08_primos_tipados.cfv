// Primos hasta 200 000 con parámetros anotados: n se comprueba una vez al
// entrar a es_primo y el bucle usa aritmética y comparaciones sin volver a
// comprobar tipos (v5: ~35 ms con --release; sin anotar, ~43 ms).
funcion es_primo(n: entero): booleano {
    si (n < 2) { retornar falso }
    sea d: entero = 2
    mientras (d * d <= n) {
        si (n % d == 0) { retornar falso }
        d = d + 1
    }
    retornar verdadero
}
sea cantidad = 0
para i en rango(200001) { si (es_primo(i)) { cantidad = cantidad + 1 } }
mostrar(cantidad)
