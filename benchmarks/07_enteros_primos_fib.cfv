// CPU con enteros: primos hasta 200 000 por división de prueba y fib(30)
// recursivo. En la máquina de desarrollo: ~73 ms con --release (gcc -O2:
// 25 ms, Java 21: 67 ms; C-Forge 4.1: 460 ms).
funcion fib(n) {
    si (n < 2) { retornar n }
    retornar fib(n - 1) + fib(n - 2)
}
sea cantidad = 0
sea c = 2
mientras (c <= 200000) {
    sea d = 2
    sea primo = verdadero
    mientras (d * d <= c y primo) {
        si (c % d == 0) { primo = falso }
        d = d + 1
    }
    si (primo) { cantidad = cantidad + 1 }
    c = c + 1
}
mostrar(cantidad)
mostrar(fib(30))
