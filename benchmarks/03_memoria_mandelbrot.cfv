// Memoria + CPU: genera un fractal monocromático en formato PGM.
sea ancho = 160;
sea alto = 100;
sea max_iteraciones = 40;
sea imagen = "P2\n160 100\n255\n";
sea fila = 0;
sea inicio = tiempo_actual();

mientras (fila < alto) {
    sea columna = 0;
    mientras (columna < ancho) {
        sea cx = columna * 3.5 / ancho - 2.5;
        sea cy = fila * 2.0 / alto - 1.0;
        sea zx = 0.0;
        sea zy = 0.0;
        sea iteracion = 0;
        sea dentro = verdadero;
        mientras (iteracion < max_iteraciones y dentro) {
            sea zx_nuevo = zx * zx - zy * zy + cx;
            zy = 2.0 * zx * zy + cy;
            zx = zx_nuevo;
            si (zx * zx + zy * zy > 4.0) {
                dentro = falso;
            }
            iteracion = iteracion + 1;
        }
        si (dentro) {
            imagen = imagen + "0 ";
        } sino {
            imagen = imagen + "255 ";
        }
        columna = columna + 1;
    }
    imagen = imagen + "\n";
    fila = fila + 1;
}

file_write("../build/benchmarks/mandelbrot.pgm", imagen);
sea duracion = tiempo_actual() - inicio;
mostrar("=== Memoria: Mandelbrot ===");
mostrar("Píxeles:");
mostrar(ancho * alto);
mostrar("Bytes generados:");
mostrar(longitud(imagen));
mostrar("Segundos:");
mostrar(duracion);
