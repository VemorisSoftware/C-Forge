// Referencia para la prueba del lexer nativo: tokens del lexer Core (Stage 0).
sea argumentos_ref: lista = argumentos_programa()
sea tokens_ref: lista = tokenizar_core(leer_archivo(argumentos_ref[1]))
sea salida_ref: texto = ""
sea i_ref: numero = 0
mientras (i_ref < longitud(tokens_ref)) {
    sea t_ref: cualquiera = tokens_ref[i_ref]
    salida_ref = salida_ref + t_ref.tipo + " " + t_ref.lexema + " " + a_texto(t_ref.linea) + "\n"
    i_ref = i_ref + 1
}
escribir_archivo(argumentos_ref[2], salida_ref)
