// cforge-nativo: compila uno o más archivos .cfv a un ejecutable ELF x86-64
// estático, sin libc ni herramientas externas.
// Uso: cforge-nativo -o salida archivo1.cfv [archivo2.cfv ...]
// Los archivos se unen en orden (primero el runtime, luego el programa).

sea argumentos_nativo: lista = argumentos_programa()
afirmar(
    longitud(argumentos_nativo) >= 4 y argumentos_nativo[1] == "-o",
    "uso: cforge-nativo -o salida archivo.cfv [más archivos .cfv]"
)
sea salida_nativo: texto = argumentos_nativo[2]
sea fuente_nativo: texto = ""
sea indice_nativo: numero = 3
mientras (indice_nativo < longitud(argumentos_nativo)) {
    fuente_nativo = fuente_nativo + leer_archivo(argumentos_nativo[indice_nativo]) + "\n"
    indice_nativo = indice_nativo + 1
}
sea programa_nativo: cualquiera = parsear_tokens_core(tokenizar_core(fuente_nativo))
sea contexto_nativo: cualquiera = compilar_programa_nativo(programa_nativo)
sea ejecutable_nativo: lista = empaquetar_elf_nativo(contexto_nativo)
afirmar(escribir_bytes(salida_nativo, ejecutable_nativo), "no se pudo escribir " + salida_nativo)
afirmar(hacer_ejecutable(salida_nativo), "no se pudo marcar como ejecutable " + salida_nativo)
mostrar("C-Forge nativo creó: " + salida_nativo + " (" + a_texto(longitud(ejecutable_nativo)) + " bytes, sin libc)")
