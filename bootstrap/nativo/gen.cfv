// bootstrap/nativo/gen.cfv — capa intermedia del generador de código.
//
// El compilador (cforge_self.cfv) no emite bytes de máquina: pide
// operaciones de una máquina de pila sencilla y cada backend las traduce:
//   gen_x64.cfv  x86-64 (Linux, Windows y macOS Intel)
//   gen_a64.cfv  AArch64 (macOS Apple Silicon y Linux ARM64)
//   gen_wasm.cfv WebAssembly (navegadores y Node.js)
//
// Registros virtuales (numeración de x86-64): 0 a (resultado) · 1 b ·
// 2 c · 3 d · 4 pila · 5 marco · 6 e · 7 f · 8-15 auxiliares.
// La pila crece hacia abajo de a 8 bytes; el marco de una función guarda
// [marco] = marco anterior, [marco + 8] = retorno, [marco + 16 + 8i] =
// argumentos (el último en 16) y las locales en [marco - 8k].

funcion op_empujar(c) {
    si (es_wasm(c)) { retornar w_empujar_reg(c, 0) }
    __guardar64(c + 552, __cargar64(c + 512))                  // mirilla: el push anterior
    __guardar64(c + 512, posicion_codigo(c))                   // y este push rax
    si (es_arm64(c)) { retornar a64_empujar_reg(c, 0) }
    retornar x64_empujar_reg(c, 0)
}
funcion op_empujar_reg(c, r) {
    si (es_wasm(c)) { retornar w_empujar_reg(c, r) }
    si (es_arm64(c)) { retornar a64_empujar_reg(c, r) }
    retornar x64_empujar_reg(c, r)
}
funcion op_sacar(c, r) {
    si (es_wasm(c)) { retornar w_sacar(c, r) }
    sea pos = posicion_codigo(c)
    si (es_arm64(c)) {
        // str x0, [x28, #-8]!; ldr xr, [x28], #8 → mov xr, x0 (o nada)
        si (a64_tras_push(c, pos - 4)) {
            __guardar64(ctx_codigo(c), pos - 4)
            mem_fijar_global(51, 0 - 1)
            __guardar64(c + 512, 0 - 1)
            si (r != 0) { a64_mov_op(c, r, 0) }
            retornar 0
        }
        retornar a64_sacar(c, r)
    }
    // push rax; pop r → mov r, rax (o nada)
    si (r < 8 y x64_tras_push(c, pos - 1)) {
        __guardar64(ctx_codigo(c), pos - 1)
        mem_fijar_global(51, 0 - 1)
        __guardar64(c + 512, 0 - 1)
        si (r != 0) { x64_mov(c, r, 0) }
        retornar 0
    }
    retornar x64_sacar(c, r)
}

// Mirilla de x86-64: ¿hay un "push rax" en p, sin etiquetas ni arreglos
// desde ahí? (c + 512: posición del último push rax · c + 544: última
// etiqueta o arreglo)
funcion x64_tras_push(c, p) {
    si (p < 0 o __cargar64(c + 512) != p o __cargar64(c + 544) > p) { retornar 0 }
    retornar str_byte(ctx_codigo(c), p) == 80
}

funcion a64_tras_push(c, p) {
    si (p < 0 o __cargar64(c + 512) != p o __cargar64(c + 544) > p) { retornar 0 }
    retornar a64_palabra(ctx_codigo(c), p) == 4162817920 + a64_r(0)
}

funcion a64_palabra(codigo, p) { retornar str_byte(codigo, p) + str_byte(codigo, p + 1) * 256 + str_byte(codigo, p + 2) * 65536 + str_byte(codigo, p + 3) * 16777216 }

// ARM64: push x0; (mov x0, k | ldur x0, [x29, #d]); (mov x1, x0; pop x0)
// → la misma carga a x1. Devuelve 1 si lo hizo.
funcion a64_mirilla_rcx(c) {
    sea pos = posicion_codigo(c)
    sea p = __cargar64(c + 512)
    si (a64_tras_push(c, p) == 0 o pos <= p + 4 o pos - p > 20 o (pos - p) % 4 != 0) { retornar 0 }
    sea codigo = ctx_codigo(c)
    sea palabras = vec_nuevo()
    sea q = p + 4
    mientras (q < pos) {
        sea w = a64_palabra(codigo, q)
        sea ok = 0
        // movz / movn / movk x0, #k (con desplazamiento)
        si (__y_bits(w, 4286578719) == 3531603968 o __y_bits(w, 4286578719) == 2457862144 o __y_bits(w, 4286578719) == 4068474880) { ok = 1 }
        // ldur x0, [x29, #d]
        si (__y_bits(w, 4292874239) == 4164944800 y pos - p == 8) { ok = 1 }
        si (ok == 0) {
            vec_liberar(palabras)
            retornar 0
        }
        vec_agregar(palabras, w + 1)                            // destino x1
        q = q + 4
    }
    __guardar64(codigo, p)
    mem_fijar_global(51, 0 - 1)
    __guardar64(c + 512, 0 - 1)
    __guardar64(c + 520, 0 - 1)
    sea i = 0
    mientras (i < vec_largo(palabras)) {
        a64(c, vec_obtener(palabras, i))
        i = i + 1
    }
    vec_liberar(palabras)
    retornar 1
}

// push rax; mov rax, X; (mov rcx, rax; pop rax) → mov rcx, X, si X es un
// inmediato o una local (c + 520: dónde empieza · 528: 1 inmediato, 2 local
// · 536: valor o desplazamiento). Devuelve 1 si lo hizo.
funcion x64_mirilla_rcx(c) {
    sea pos = posicion_codigo(c)
    sea inicio = __cargar64(c + 520)
    sea p = __cargar64(c + 512)
    si (inicio != p + 1 o x64_tras_push(c, p) == 0) { retornar 0 }
    sea tipo = __cargar64(c + 528)
    sea v = __cargar64(c + 536)
    sea codigo = ctx_codigo(c)
    sea largo = 0
    si (tipo == 1 y str_byte(codigo, inicio) == 72 y str_byte(codigo, inicio + 1) == 199 y str_byte(codigo, inicio + 2) == 192) { largo = 7 }
    si (tipo == 1 y str_byte(codigo, inicio) == 72 y str_byte(codigo, inicio + 1) == 184) { largo = 10 }
    si (tipo == 2 y str_byte(codigo, inicio) == 72 y str_byte(codigo, inicio + 1) == 139 y str_byte(codigo, inicio + 2) == 133) { largo = 7 }
    si (largo == 0 o inicio + largo != pos) { retornar 0 }
    __guardar64(codigo, p)
    mem_fijar_global(51, 0 - 1)
    __guardar64(c + 512, 0 - 1)
    __guardar64(c + 520, 0 - 1)
    si (tipo == 1) { op_constante_rcx(c, v) } sino { x64_cargar32(c, 1, 5, v) }
    retornar 1
}
funcion op_mov(c, destino, origen) {
    si (es_wasm(c)) { retornar w_mov(c, destino, origen) }
    si (es_arm64(c)) { retornar a64_mov_op(c, destino, origen) }
    retornar x64_mov(c, destino, origen)
}
funcion op_inmediato(c, valor) {
    si (es_wasm(c)) { retornar w_inmediato(c, valor) }
    si (es_arm64(c)) { retornar a64_inmediato(c, valor) }
    __guardar64(c + 520, posicion_codigo(c))
    __guardar64(c + 528, 1)
    __guardar64(c + 536, valor)
    retornar x64_inmediato(c, valor)
}

funcion op_cargar(c, destino, base, d) {
    si (es_wasm(c)) { retornar w_cargar(c, destino, base, d) }
    si (es_arm64(c)) { retornar a64_cargar(c, destino, base, d) }
    retornar x64_cargar(c, destino, base, d)
}
funcion op_cargar32(c, destino, base, d) {
    si (es_wasm(c)) { retornar w_cargar(c, destino, base, d) }
    si (es_arm64(c)) { retornar a64_cargar(c, destino, base, d) }
    si (destino == 0 y base == 5) {
        __guardar64(c + 520, posicion_codigo(c))
        __guardar64(c + 528, 2)
        __guardar64(c + 536, d)
    }
    retornar x64_cargar32(c, destino, base, d)
}
funcion op_guardar(c, base, d, origen) {
    si (es_wasm(c)) { retornar w_guardar(c, base, d, origen) }
    si (es_arm64(c)) { retornar a64_guardar(c, base, d, origen) }
    retornar x64_guardar(c, base, d, origen)
}
funcion op_guardar32(c, base, d, origen) {
    si (es_wasm(c)) { retornar w_guardar(c, base, d, origen) }
    si (es_arm64(c)) { retornar a64_guardar(c, base, d, origen) }
    retornar x64_guardar32(c, base, d, origen)
}

// a ← byte [a] · byte [a] ← b
funcion op_cargar8(c) {
    si (es_wasm(c)) { retornar w_cargar8(c) }
    si (es_arm64(c)) { retornar a64_cargar8(c) }
    e3(c, 15, 182, 0) retornar 0
}
funcion op_guardar8(c) {
    si (es_wasm(c)) { retornar w_guardar8(c) }
    si (es_arm64(c)) { retornar a64_guardar8(c) }
    e2(c, 136, 8) retornar 0
}

// a ← dirección (1 dato, 2 global, 3 tabla de clases, 4 etiqueta)
funcion op_direccion(c, tipo, valor) {
    si (es_wasm(c)) { retornar w_direccion_op(c, tipo, valor) }
    si (es_arm64(c)) { retornar a64_direccion(c, tipo, valor) }
    retornar x64_direccion(c, tipo, valor)
}
funcion op_cargar_global(c, d) {
    si (es_wasm(c)) { retornar w_cargar_absoluto(c, 2, d) }
    si (es_arm64(c)) { retornar a64_cargar_absoluto(c, 2, d) }
    retornar x64_cargar_absoluto(c, 2, d)
}
funcion op_guardar_global(c, d) {
    si (es_wasm(c)) { retornar w_guardar_absoluto(c, 2, d) }
    si (es_arm64(c)) { retornar a64_guardar_absoluto(c, 2, d) }
    retornar x64_guardar_absoluto(c, 2, d)
}
funcion op_cargar_dato(c, d) {
    si (es_wasm(c)) { retornar w_cargar_absoluto(c, 1, d) }
    si (es_arm64(c)) { retornar a64_cargar_absoluto(c, 1, d) }
    retornar x64_cargar_absoluto(c, 1, d)
}
funcion op_guardar_dato(c, d) {
    si (es_wasm(c)) { retornar w_guardar_absoluto(c, 1, d) }
    si (es_arm64(c)) { retornar a64_guardar_absoluto(c, 1, d) }
    retornar x64_guardar_absoluto(c, 1, d)
}

// a ← [a + b·8 + d]
funcion op_cargar_indexado(c, d) {
    si (es_wasm(c)) { retornar w_cargar_indexado(c, d) }
    si (es_arm64(c)) { retornar a64_cargar_indexado(c, d) }
    retornar x64_cargar_indexado(c, d)
}
// Apila una copia de [pila + d] (d = 0: duplica el tope).
funcion op_empujar_pila(c, d) {
    si (es_wasm(c)) { retornar w_empujar_pila(c, d) }
    si (es_arm64(c)) { retornar a64_empujar_pila(c, d) }
    retornar x64_empujar_pila(c, d)
}
funcion op_duplicar(c) {
    si (es_wasm(c)) { retornar w_empujar_pila(c, 0) }
    si (es_arm64(c)) { retornar a64_empujar_pila(c, 0) }
    retornar x64_empujar_pila(c, 0)
}
// Retira n bytes de la pila.
funcion op_liberar_pila(c, n) {
    si (es_wasm(c)) { retornar w_sumar_pila(c, n) }
    si (es_arm64(c)) { retornar a64_liberar_pila(c, n) }
    e3(c, 72, 129, 196) e32(c, n) retornar 0
}

funcion op_aritmetica(c, op) {
    si (es_wasm(c)) { retornar w_aritmetica(c, op) }
    si (es_arm64(c)) { retornar a64_aritmetica(c, op) }
    retornar x64_aritmetica(c, op)
}
// rax ← rax op rcx (op 1 suma · 2 resta · 3 multiplicación, con signo) y
// salta a etiqueta si el resultado no cabe en 64 bits. Es la base de los
// enteros sin límite: la ruta rápida pasa al runtime al desbordar.
funcion op_aritmetica_vigilada(c, op, etiqueta) {
    si (es_wasm(c)) { retornar w_aritmetica_vigilada(c, op, etiqueta) }
    si (es_arm64(c)) { retornar a64_aritmetica_vigilada(c, op, etiqueta) }
    x64_aritmetica(c, op)                                      // add/sub/imul fijan OF
    e2(c, 15, 128)                                             // jo rel32
    nuevo_arreglo(c, 0, etiqueta)
    retornar 0
}
funcion op_negar(c) {
    si (es_wasm(c)) { retornar w_negar(c) }
    si (es_arm64(c)) { retornar a64_negar(c) }
    e3(c, 72, 247, 216) retornar 0
}
funcion op_sumar_inmediato(c, k) {
    si (es_wasm(c)) { retornar w_sumar_k(c, k) }
    si (es_arm64(c)) { retornar a64_sumar_inmediato(c, k) }
    e4(c, 72, 131, 192, k) retornar 0
}
// rax >>= k (aritmético, k de 1 a 63).
funcion op_sar_constante(c, k) {
    si (es_wasm(c)) { retornar w_con_constante(c, 135, k) }
    si (es_arm64(c)) { retornar a64(c, 2470509568 + k * 65536) }      // asr x0, x0, #k
    e4(c, 72, 193, 248, k) retornar 0                          // sar rax, imm8
}
// rax <<= k (k de 1 a 63).
funcion op_shl_constante(c, k) {
    si (es_wasm(c)) { retornar w_con_constante(c, 134, k) }
    si (es_arm64(c)) { retornar a64(c, 3544186880 + ((64 - k) % 64) * 65536 + (63 - k) * 1024) }   // lsl x0, x0, #k
    e4(c, 72, 193, 224, k) retornar 0                          // shl rax, imm8
}
// rax >>= k sin signo (k de 1 a 63).
funcion op_shr_constante(c, k) {
    si (es_wasm(c)) { retornar w_con_constante(c, 136, k) }
    si (es_arm64(c)) { retornar a64(c, 3544186880 + k * 65536 + 64512) }     // lsr x0, x0, #k
    e4(c, 72, 193, 232, k) retornar 0                          // shr rax, imm8
}

// Reducción de fuerza (enteros sin etiquetar en rax, 1 ≤ k ≤ 62), con el
// redondeo hacia cero de idiv: x / 2^k y x % 2^k sin dividir.
funcion op_dividir_potencia2(c, k) {
    op_mov(c, 1, 0)                                            // rcx = x
    op_sar_constante(c, 63)
    op_shr_constante(c, 64 - k)                                // sesgo: 2^k - 1 si x < 0
    op_aritmetica(c, 1)                                        // x + sesgo
    op_sar_constante(c, k)
    retornar 0
}
funcion op_resto_potencia2(c, k) {
    op_mov(c, 1, 0)                                            // rcx = x
    op_sar_constante(c, 63)
    op_shr_constante(c, 64 - k)                                // sesgo
    op_empujar(c)
    op_aritmetica(c, 1)                                        // x + sesgo
    op_constante_rcx(c, __desplazar_izq(1, k) - 1)
    op_aritmetica(c, 6)                                        // & (2^k - 1)
    op_mov(c, 1, 0)
    op_sacar(c, 0)                                             // rax = sesgo
    op_aritmetica(c, 2)                                        // sesgo - r
    op_negar(c)                                                // r - sesgo
    retornar 0
}

// rcx ← k (sin tocar rax).
funcion op_constante_rcx(c, k) {
    si (es_wasm(c)) { retornar w_constante_rcx(c, k) }
    si (es_arm64(c)) { retornar a64_constante(c, 1, k) }
    si (k >= 0 - 2147483648 y k <= 2147483647) {
        e3(c, 72, 199, 193)                                    // mov rcx, imm32
        e32(c, k)
        retornar 0
    }
    e2(c, 72, 185)                                             // movabs rcx, imm64
    e32(c, k)
    e32(c, __desplazar_der(k, 32))
    retornar 0
}
// rax &= 1.
funcion op_y_uno(c) {
    si (es_wasm(c)) { retornar w_con_constante(c, 131, 1) }
    si (es_arm64(c)) { retornar a64(c, 2453667840) }                   // and x0, x0, #1
    e4(c, 72, 131, 224, 1) retornar 0
}
// rax += k (k de -128 a 127, con signo, en los dos backends).
funcion op_sumar_constante(c, k) {
    si (es_wasm(c)) { retornar w_sumar_k(c, k) }
    si (es_arm64(c)) {
        si (k < 0) { retornar a64_restar_inm(c, 0, 0, 0 - k) }
        retornar a64_sumar_inm(c, 0, 0, k)
    }
    e4(c, 72, 131, 192, __y_bits(k, 255)) retornar 0
}
funcion op_etiquetar(c, k) {
    si (es_wasm(c)) { retornar w_etiquetar(c, k) }
    si (es_arm64(c)) { retornar a64_etiquetar(c, k) }
    retornar x64_etiquetar(c, k)
}
funcion op_extender32(c) {
    si (es_wasm(c)) { retornar w_unaria(c, 196) }
    si (es_arm64(c)) { retornar a64_extender32(c) }
    e3(c, 72, 99, 192) retornar 0
}
funcion op_byte_bajo(c) {
    si (es_wasm(c)) { retornar w_con_constante(c, 131, 255) }
    si (es_arm64(c)) { retornar a64_byte_bajo(c) }
    e3(c, 15, 182, 192) retornar 0
}
funcion op_barrera(c) {
    si (es_wasm(c)) { retornar 0 }                             // un solo hilo
    si (es_arm64(c)) { retornar a64(c, 3573759935) }           // dmb ish
    e3(c, 15, 174, 240)                                        // mfence
    retornar 0
}

funcion op_intercambiar(c) {
    si (es_wasm(c)) { retornar w_intercambiar(c) }
    si (es_arm64(c)) { retornar a64_intercambiar(c) }
    e3(c, 72, 135, 8)                                          // xchg [rax], rcx
    e3(c, 72, 137, 200)                                        // mov rax, rcx
    retornar 0
}

funcion op_comparar(c, codigo) {
    si (es_wasm(c)) { retornar w_comparar(c, codigo) }
    si (es_arm64(c)) { retornar a64_comparar(c, codigo) }
    retornar x64_comparar(c, codigo)
}
funcion op_es_cero(c) {
    si (es_wasm(c)) { retornar w_cero(c, 1) }
    si (es_arm64(c)) { retornar a64_es_cero(c) }
    e3(c, 72, 133, 192)
    e3(c, 15, 148, 192)
    e3(c, 15, 182, 192)
    retornar 0
}
funcion op_no_cero(c) {
    si (es_wasm(c)) { retornar w_cero(c, 0) }
    si (es_arm64(c)) { retornar a64_no_cero(c) }
    e3(c, 72, 133, 192)
    e3(c, 15, 149, 192)
    e3(c, 15, 182, 192)
    retornar 0
}

funcion op_saltar(c, etiqueta) {
    si (es_wasm(c)) { retornar w_ir(c, etiqueta, 0) }
    si (es_arm64(c)) { retornar a64_b(c, etiqueta) }
    e1(c, 233)
    nuevo_arreglo(c, 0, etiqueta)
    retornar 0
}
funcion op_saltar_si_cero(c, etiqueta) {
    si (es_wasm(c)) { retornar w_saltar_si(c, 1, etiqueta) }
    si (es_arm64(c)) { retornar a64_saltar_si(c, 1, etiqueta) }
    retornar x64_saltar_si(c, 1, etiqueta)
}
// Condición de si/mientras (el valor ya no se usa): tras una comparación,
// cmp + salto directo, sin pasar por 0/1.
funcion op_saltar_si_falso(c, etiqueta) {
    si (es_wasm(c)) { retornar op_saltar_si_cero(c, etiqueta) }
    si (es_arm64(c)) {
        // cmp x0, x1; cset x0, cc → b.(no cc)
        sea pa = posicion_codigo(c)
        sea ca = ctx_codigo(c)
        si (pa >= 8 y __cargar64(c + 544) <= pa - 8 y a64_palabra(ca, pa - 8) == 3942711327 y __y_bits(a64_palabra(ca, pa - 4), 4294905855) == 2594113504) {
            sea no_cc = __y_bits(__desplazar_der(a64_palabra(ca, pa - 4), 12), 15)
            __guardar64(ca, pa - 4)
            mem_fijar_global(51, 0 - 1)
            a64_arreglo(c, 11, etiqueta)
            retornar a64(c, 1409286144 + no_cc)
        }
        retornar op_saltar_si_cero(c, etiqueta)
    }
    sea pos = posicion_codigo(c)
    sea k = pos - 9
    sea codigo = ctx_codigo(c)
    // cmp rax, imm32 (6 bytes) en vez de cmp rax, rcx (3)
    sea cmp_inm = pos >= 12 y str_byte(codigo, pos - 12) == 72 y str_byte(codigo, pos - 11) == 61
    si (cmp_inm) { k = pos - 12 }
    sea ok_cmp = cmp_inm o (k >= 0 y str_byte(codigo, k) == 72 y str_byte(codigo, k + 1) == 57 y str_byte(codigo, k + 2) == 200)
    si (k >= 0 y ok_cmp y __cargar64(c + 544) <= k y str_byte(codigo, pos - 6) == 15 y str_byte(codigo, pos - 4) == 192 y str_byte(codigo, pos - 3) == 15 y str_byte(codigo, pos - 2) == 182 y str_byte(codigo, pos - 1) == 192) {
        sea cc = str_byte(codigo, pos - 5)
        si (cc >= 144 y cc <= 159) {
            __guardar64(codigo, pos - 6)                       // queda el cmp
            mem_fijar_global(51, 0 - 1)
            e2(c, 15, __xo_bits(cc, 1) - 16)                   // j(no cc) etiqueta
            nuevo_arreglo(c, 0, etiqueta)
            retornar 0
        }
    }
    retornar x64_saltar_si(c, 1, etiqueta)
}

funcion op_saltar_si_no_cero(c, etiqueta) {
    si (es_wasm(c)) { retornar w_saltar_si(c, 0, etiqueta) }
    si (es_arm64(c)) { retornar a64_saltar_si(c, 0, etiqueta) }
    retornar x64_saltar_si(c, 0, etiqueta)
}
// Salta si a >= b (con signo).
funcion op_saltar_si_mayor_igual(c, etiqueta) {
    si (es_wasm(c)) { retornar w_saltar_si_mayor_igual(c, etiqueta) }
    si (es_arm64(c)) { retornar a64_saltar_si_mayor_igual(c, etiqueta) }
    e3(c, 72, 57, 200)                                         // cmp rax, rcx
    e2(c, 15, 141)                                             // jge
    nuevo_arreglo(c, 0, etiqueta)
    retornar 0
}
// Ruta rápida de comprobar_pila: salta a bien si base (global 63) - sp < tope.
// En x86-64 son cuatro instrucciones (sin cargar el tope en rcx).
funcion op_pila_rapida(c, tope, bien) {
    op_cargar_global(c, 504)                                   // rax = base
    si (es_arm64(c)) {
        op_mov(c, 1, 4)
        op_aritmetica(c, 2)
        op_constante_rcx(c, tope)
        retornar op_saltar_si_menor_sin_signo(c, bien)
    }
    e3(c, 72, 41, 224)                                         // sub rax, rsp
    e2(c, 72, 61)                                              // cmp rax, imm32
    e32(c, tope)
    e2(c, 15, 130)                                             // jb
    nuevo_arreglo(c, 0, bien)
    retornar 0
}

// Salta si rax < rcx sin signo (x86-64 jb · ARM64 b.lo). No se usa en WebAssembly.
funcion op_saltar_si_menor_sin_signo(c, etiqueta) {
    si (es_arm64(c)) {
        a64(c, 3942711327)                                     // cmp x0, x1
        a64(c, 1409286210)                                     // b.hs +8
        retornar a64_b(c, etiqueta)
    }
    e3(c, 72, 57, 200)                                         // cmp rax, rcx
    e2(c, 15, 130)                                             // jb
    nuevo_arreglo(c, 0, etiqueta)
    retornar 0
}
funcion op_saltar_reg(c, r) {
    si (es_wasm(c)) { retornar w_ir_reg(c, r) }
    si (es_arm64(c)) { retornar a64_saltar_reg(c, r) }
    e2(c, 255, 224 + r) retornar 0
}
funcion op_llamar(c, etiqueta) {
    si (es_wasm(c)) { retornar w_llamar(c, etiqueta) }
    si (es_arm64(c)) { retornar a64_bl(c, etiqueta) }
    e1(c, 232)
    nuevo_arreglo(c, 0, etiqueta)
    retornar 0
}
funcion op_llamar_reg(c, r) {
    si (es_wasm(c)) { retornar w_llamar_reg(c, r) }
    si (es_arm64(c)) { retornar a64_llamar_reg(c, r) }
    si (r >= 8) { e1(c, 65) }
    e2(c, 255, 208 + __y_bits(r, 7))
    retornar 0
}

funcion op_prologo(c) {
    si (es_wasm(c)) { retornar w_prologo(c) }
    si (es_arm64(c)) { retornar a64_prologo(c) }
    retornar x64_prologo(c)
}
funcion op_fijar_marco(c, posicion, tamano) {
    si (es_wasm(c)) { retornar w_fijar_marco(c, posicion, tamano) }
    si (es_arm64(c)) { retornar a64_fijar_marco(c, posicion, tamano) }
    parchear32(ctx_codigo(c), posicion, tamano)
    retornar 0
}
funcion op_epilogo(c) {
    si (es_wasm(c)) { retornar w_epilogo(c) }
    si (es_arm64(c)) { retornar a64_epilogo(c) }
    e3(c, 72, 137, 236)                                        // mov rsp, rbp
    e2(c, 93, 195)                                             // pop rbp; ret
    retornar 0
}

// Flotantes (bits de un double en a y b).
funcion op_f64(c, operacion) {
    si (es_wasm(c)) { retornar w_f64(c, operacion) }
    si (es_arm64(c)) { retornar a64_f64(c, operacion) }
    retornar x64_f64(c, operacion)
}
funcion op_f64_desde_entero(c) {
    si (es_wasm(c)) { retornar w_f64_desde_entero(c) }
    si (es_arm64(c)) { retornar a64_f64_desde_entero(c) }
    e5(c, 242, 72, 15, 42, 192)                                // cvtsi2sd xmm0, rax
    e5(c, 102, 72, 15, 126, 192)
    retornar 0
}
funcion op_f64_a_entero(c) {
    si (es_wasm(c)) { retornar w_f64_a_entero(c) }
    si (es_arm64(c)) { retornar a64_f64_a_entero(c) }
    e5(c, 102, 72, 15, 110, 192)
    e5(c, 242, 72, 15, 44, 192)                                // cvttsd2si rax, xmm0
    retornar 0
}
funcion op_f64_raiz(c) {
    si (es_wasm(c)) { retornar w_f64_raiz(c) }
    si (es_arm64(c)) { retornar a64_f64_raiz(c) }
    e5(c, 102, 72, 15, 110, 192)                               // movq xmm0, rax
    e4(c, 242, 15, 81, 192)                                    // sqrtsd xmm0, xmm0
    e5(c, 102, 72, 15, 126, 192)                               // movq rax, xmm0
    retornar 0
}
funcion op_f64_menor(c) {
    si (es_wasm(c)) { retornar w_f64_menor(c) }
    si (es_arm64(c)) { retornar a64_f64_menor(c) }
    e5(c, 102, 72, 15, 110, 192)
    e5(c, 102, 72, 15, 110, 201)
    e4(c, 102, 15, 46, 193)                                    // ucomisd xmm0, xmm1
    e3(c, 15, 146, 192)                                        // setb al
    e3(c, 15, 182, 192)
    retornar 0
}
// a ← resultado flotante de una llamada C.
funcion op_resultado_flotante(c) {
    si (es_wasm(c)) { retornar 0 }
    si (es_arm64(c)) { retornar a64_resultado_flotante(c) }
    e5(c, 102, 72, 15, 126, 192) retornar 0
}

// Llamadas al sistema y a C.
funcion op_syscall(c, n) {
    si (es_wasm(c)) { retornar w_syscall(c, n) }
    si (es_arm64(c)) { retornar a64_syscall(c, n) }
    retornar x64_syscall(c, n)
}
funcion op_hilo(c) {
    si (es_wasm(c)) { retornar w_hilo(c) }
    si (es_macos(c)) { error_en(c, "__hilo solo existe en Linux") }
    si (es_arm64(c)) { retornar a64_hilo(c) }
    retornar x64_hilo(c)
}
funcion op_ccall(c, n) {
    si (es_wasm(c)) { retornar w_no_disponible(c, 1002, n) }
    si (es_arm64(c)) { retornar a64_ccall(c, n) }
    si (es_windows(c)) { retornar x64_ccall_windows(c, n) }
    retornar x64_ccall(c, n)
}
funcion op_llamar_importada(c, indice, n) {
    si (es_wasm(c)) { retornar w_no_disponible(c, 1003, n) }
    si (es_arm64(c)) { retornar a64_llamar_importada(c, indice, n) }
    si (es_windows(c)) { retornar x64_llamar_iat(c, indice, n) }
    retornar x64_llamar_importada(c, indice, n)
}
funcion op_llamada_externa(c, casilla, tipos, convertidos) {
    si (es_wasm(c)) { retornar w_llamada_externa(c, casilla, tipos, convertidos) }
    si (es_arm64(c)) { retornar a64_llamada_externa(c, casilla, tipos, convertidos) }
    si (es_windows(c)) { retornar x64_llamada_externa_windows(c, casilla, tipos, convertidos) }
    retornar x64_llamada_externa(c, casilla, tipos, convertidos)
}
funcion op_inicio(c, principal) {
    si (es_wasm(c)) { retornar w_inicio(c, principal) }
    si (es_arm64(c)) { retornar a64_inicio(c, principal) }
    retornar x64_inicio(c, principal)
}
funcion op_trampolin_hilo(c) {
    si (es_wasm(c)) { retornar w_no_disponible(c, 1005, 0) }
    si (es_arm64(c)) { retornar a64_trampolin_hilo(c) }
    retornar x64_trampolin_hilo(c)
}

// ── Resto por una constante sin dividir ──────────────────────────────────
// rax = x (|x| < 2^62) → rax = x % d (truncado, como idiv), con d en
// [3, 2^31) y no potencia de 2. q = (mulhi(x, M) >> s) + (x < 0), con
// 2^s en (d/4, d/2) y M = floor(2^(64+s) / d) + 1 < 2^63: el error
// M·d − 2^(64+s) ≤ d y d·2^62 < 2^(64+s), así que q es exacto en el rango.
// WebAssembly no tiene mulhi de 64 bits: ahí sigue la división.
funcion magia_corrimiento(d) {
    sea s = 0
    mientras (__desplazar_izq(1, s + 2) <= d) { s = s + 1 }
    retornar s
}

// floor(2^k / d) por división larga (resto < d < 2^62, cociente < 2^63).
funcion magia_multiplicador(d, s) {
    sea r = 1
    sea q = 0
    sea i = 0
    mientras (i < 64 + s) {
        r = r * 2
        q = q * 2
        si (r >= d) {
            r = r - d
            q = q + 1
        }
        i = i + 1
    }
    retornar q + 1
}

funcion resto_constante_valido(c, d) {
    si (es_wasm(c)) { retornar 0 }
    retornar d >= 3 y d < 2147483648
}

funcion a64_mov_constante(c, reg, v) {
    a64(c, 3531603968 + __y_bits(v, 65535) * 32 + reg)                             // movz reg, #v0
    a64(c, 4070572032 + __y_bits(__desplazar_der(v, 16), 65535) * 32 + reg)        // movk reg, #v1, lsl 16
    a64(c, 4072669184 + __y_bits(__desplazar_der(v, 32), 65535) * 32 + reg)        // movk reg, #v2, lsl 32
    a64(c, 4074766336 + __y_bits(__desplazar_der(v, 48), 65535) * 32 + reg)        // movk reg, #v3, lsl 48
    retornar 0
}

funcion op_resto_constante(c, d) {
    sea s = magia_corrimiento(d)
    sea m = magia_multiplicador(d, s)
    si (es_arm64(c)) {
        a64(c, 2852127728)                                         // mov x16, x0
        a64_mov_constante(c, 17, m)
        a64(c, 2604694528 + 17 * 65536 + 16 * 32)                  // smulh x0, x16, x17
        si (s > 0) { a64(c, 2470509568 + s * 65536) }              // asr x0, x0, #s
        a64(c, 2470509568 + 63 * 65536 + 16 * 32 + 2)              // asr x2, x16, #63
        a64(c, 3405774848 + 2 * 65536)                             // sub x0, x0, x2
        a64_mov_constante(c, 17, d)
        a64(c, 2600501248 + 17 * 65536 + 16 * 1024)                // msub x0, x0, x17, x16
        retornar 0
    }
    e3(c, 72, 137, 193)                                            // mov rcx, rax
    e2(c, 72, 186)                                                 // mov rdx, imm64
    e32(c, __y_bits(m, 4294967295))
    e32(c, __desplazar_der(m, 32))
    e3(c, 72, 247, 234)                                            // imul rdx (rdx:rax = rax·rdx)
    e3(c, 72, 137, 208)                                            // mov rax, rdx
    si (s > 0) { e4(c, 72, 193, 248, s) }                          // sar rax, s
    e3(c, 72, 137, 202)                                            // mov rdx, rcx
    e4(c, 72, 193, 250, 63)                                        // sar rdx, 63
    e3(c, 72, 41, 208)                                             // sub rax, rdx
    e3(c, 72, 105, 192)                                            // imul rax, rax, imm32
    e32(c, d)
    e3(c, 72, 41, 193)                                             // sub rcx, rax
    e3(c, 72, 137, 200)                                            // mov rax, rcx
    retornar 0
}
