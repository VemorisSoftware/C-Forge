// bootstrap/nativo/gen.cfv — capa intermedia del generador de código.
//
// El compilador (cforge_self.cfv) no emite bytes de máquina: pide
// operaciones de una máquina de pila sencilla y cada backend las traduce:
//   gen_x64.cfv  x86-64 (Linux, Windows y macOS Intel)
//   gen_a64.cfv  AArch64 (macOS Apple Silicon y Linux ARM64)
//
// Registros virtuales (numeración de x86-64): 0 a (resultado) · 1 b ·
// 2 c · 3 d · 4 pila · 5 marco · 6 e · 7 f · 8-15 auxiliares.
// La pila crece hacia abajo de a 8 bytes; el marco de una función guarda
// [marco] = marco anterior, [marco + 8] = retorno, [marco + 16 + 8i] =
// argumentos (el último en 16) y las locales en [marco - 8k].

funcion op_empujar(c) {
    si (es_arm64(c)) { retornar a64_empujar_reg(c, 0) }
    retornar x64_empujar_reg(c, 0)
}
funcion op_empujar_reg(c, r) {
    si (es_arm64(c)) { retornar a64_empujar_reg(c, r) }
    retornar x64_empujar_reg(c, r)
}
funcion op_sacar(c, r) {
    si (es_arm64(c)) { retornar a64_sacar(c, r) }
    retornar x64_sacar(c, r)
}
funcion op_mov(c, destino, origen) {
    si (es_arm64(c)) { retornar a64_mov_op(c, destino, origen) }
    retornar x64_mov(c, destino, origen)
}
funcion op_inmediato(c, valor) {
    si (es_arm64(c)) { retornar a64_inmediato(c, valor) }
    retornar x64_inmediato(c, valor)
}

funcion op_cargar(c, destino, base, d) {
    si (es_arm64(c)) { retornar a64_cargar(c, destino, base, d) }
    retornar x64_cargar(c, destino, base, d)
}
funcion op_cargar32(c, destino, base, d) {
    si (es_arm64(c)) { retornar a64_cargar(c, destino, base, d) }
    retornar x64_cargar32(c, destino, base, d)
}
funcion op_guardar(c, base, d, origen) {
    si (es_arm64(c)) { retornar a64_guardar(c, base, d, origen) }
    retornar x64_guardar(c, base, d, origen)
}
funcion op_guardar32(c, base, d, origen) {
    si (es_arm64(c)) { retornar a64_guardar(c, base, d, origen) }
    retornar x64_guardar32(c, base, d, origen)
}

// a ← byte [a] · byte [a] ← b
funcion op_cargar8(c) {
    si (es_arm64(c)) { retornar a64_cargar8(c) }
    e3(c, 15, 182, 0) retornar 0
}
funcion op_guardar8(c) {
    si (es_arm64(c)) { retornar a64_guardar8(c) }
    e2(c, 136, 8) retornar 0
}

// a ← dirección (1 dato, 2 global, 3 tabla de clases, 4 etiqueta)
funcion op_direccion(c, tipo, valor) {
    si (es_arm64(c)) { retornar a64_direccion(c, tipo, valor) }
    retornar x64_direccion(c, tipo, valor)
}
funcion op_cargar_global(c, d) {
    si (es_arm64(c)) { retornar a64_cargar_absoluto(c, 2, d) }
    retornar x64_cargar_absoluto(c, 2, d)
}
funcion op_guardar_global(c, d) {
    si (es_arm64(c)) { retornar a64_guardar_absoluto(c, 2, d) }
    retornar x64_guardar_absoluto(c, 2, d)
}
funcion op_cargar_dato(c, d) {
    si (es_arm64(c)) { retornar a64_cargar_absoluto(c, 1, d) }
    retornar x64_cargar_absoluto(c, 1, d)
}
funcion op_guardar_dato(c, d) {
    si (es_arm64(c)) { retornar a64_guardar_absoluto(c, 1, d) }
    retornar x64_guardar_absoluto(c, 1, d)
}

// a ← [a + b·8 + d]
funcion op_cargar_indexado(c, d) {
    si (es_arm64(c)) { retornar a64_cargar_indexado(c, d) }
    retornar x64_cargar_indexado(c, d)
}
// Apila una copia de [pila + d] (d = 0: duplica el tope).
funcion op_empujar_pila(c, d) {
    si (es_arm64(c)) { retornar a64_empujar_pila(c, d) }
    retornar x64_empujar_pila(c, d)
}
funcion op_duplicar(c) {
    si (es_arm64(c)) { retornar a64_empujar_pila(c, 0) }
    retornar x64_empujar_pila(c, 0)
}
// Retira n bytes de la pila.
funcion op_liberar_pila(c, n) {
    si (es_arm64(c)) { retornar a64_liberar_pila(c, n) }
    e3(c, 72, 129, 196) e32(c, n) retornar 0
}

funcion op_aritmetica(c, op) {
    si (es_arm64(c)) { retornar a64_aritmetica(c, op) }
    retornar x64_aritmetica(c, op)
}
funcion op_negar(c) {
    si (es_arm64(c)) { retornar a64_negar(c) }
    e3(c, 72, 247, 216) retornar 0
}
funcion op_sumar_inmediato(c, k) {
    si (es_arm64(c)) { retornar a64_sumar_inmediato(c, k) }
    e4(c, 72, 131, 192, k) retornar 0
}
// rax >>= k (aritmético, k de 1 a 63).
funcion op_sar_constante(c, k) {
    si (es_arm64(c)) { retornar a64(c, 2470509568 + k * 65536) }      // asr x0, x0, #k
    e4(c, 72, 193, 248, k) retornar 0                          // sar rax, imm8
}
// rcx ← k (sin tocar rax).
funcion op_constante_rcx(c, k) {
    si (es_arm64(c)) { retornar a64_constante(c, 1, k) }
    si (k >= 0 - 2147483648 y k <= 2147483647) {
        e3(c, 72, 199, 193)                                    // mov rcx, imm32
        e32(c, k)
        retornar 0
    }
    e2(c, 72, 185)                                             // movabs rcx, imm64
    e32(c, k)
    e32(c, __desplazar_der(k, 32))
    retornar 0
}
// rax &= 1.
funcion op_y_uno(c) {
    si (es_arm64(c)) { retornar a64(c, 2453667840) }                   // and x0, x0, #1
    e4(c, 72, 131, 224, 1) retornar 0
}
// rax += k (k de -128 a 127, con signo, en los dos backends).
funcion op_sumar_constante(c, k) {
    si (es_arm64(c)) {
        si (k < 0) { retornar a64_restar_inm(c, 0, 0, 0 - k) }
        retornar a64_sumar_inm(c, 0, 0, k)
    }
    e4(c, 72, 131, 192, __y_bits(k, 255)) retornar 0
}
funcion op_etiquetar(c, k) {
    si (es_arm64(c)) { retornar a64_etiquetar(c, k) }
    retornar x64_etiquetar(c, k)
}
funcion op_extender32(c) {
    si (es_arm64(c)) { retornar a64_extender32(c) }
    e3(c, 72, 99, 192) retornar 0
}
funcion op_byte_bajo(c) {
    si (es_arm64(c)) { retornar a64_byte_bajo(c) }
    e3(c, 15, 182, 192) retornar 0
}
funcion op_intercambiar(c) {
    si (es_arm64(c)) { retornar a64_intercambiar(c) }
    e3(c, 72, 135, 8)                                          // xchg [rax], rcx
    e3(c, 72, 137, 200)                                        // mov rax, rcx
    retornar 0
}

funcion op_comparar(c, codigo) {
    si (es_arm64(c)) { retornar a64_comparar(c, codigo) }
    retornar x64_comparar(c, codigo)
}
funcion op_es_cero(c) {
    si (es_arm64(c)) { retornar a64_es_cero(c) }
    e3(c, 72, 133, 192)
    e3(c, 15, 148, 192)
    e3(c, 15, 182, 192)
    retornar 0
}
funcion op_no_cero(c) {
    si (es_arm64(c)) { retornar a64_no_cero(c) }
    e3(c, 72, 133, 192)
    e3(c, 15, 149, 192)
    e3(c, 15, 182, 192)
    retornar 0
}

funcion op_saltar(c, etiqueta) {
    si (es_arm64(c)) { retornar a64_b(c, etiqueta) }
    e1(c, 233)
    nuevo_arreglo(c, 0, etiqueta)
    retornar 0
}
funcion op_saltar_si_cero(c, etiqueta) {
    si (es_arm64(c)) { retornar a64_saltar_si(c, 1, etiqueta) }
    retornar x64_saltar_si(c, 1, etiqueta)
}
funcion op_saltar_si_no_cero(c, etiqueta) {
    si (es_arm64(c)) { retornar a64_saltar_si(c, 0, etiqueta) }
    retornar x64_saltar_si(c, 0, etiqueta)
}
// Salta si a >= b (con signo).
funcion op_saltar_si_mayor_igual(c, etiqueta) {
    si (es_arm64(c)) { retornar a64_saltar_si_mayor_igual(c, etiqueta) }
    e3(c, 72, 57, 200)                                         // cmp rax, rcx
    e2(c, 15, 141)                                             // jge
    nuevo_arreglo(c, 0, etiqueta)
    retornar 0
}
funcion op_saltar_reg(c, r) {
    si (es_arm64(c)) { retornar a64_saltar_reg(c, r) }
    e2(c, 255, 224 + r) retornar 0
}
funcion op_llamar(c, etiqueta) {
    si (es_arm64(c)) { retornar a64_bl(c, etiqueta) }
    e1(c, 232)
    nuevo_arreglo(c, 0, etiqueta)
    retornar 0
}
funcion op_llamar_reg(c, r) {
    si (es_arm64(c)) { retornar a64_llamar_reg(c, r) }
    si (r >= 8) { e1(c, 65) }
    e2(c, 255, 208 + __y_bits(r, 7))
    retornar 0
}

funcion op_prologo(c) {
    si (es_arm64(c)) { retornar a64_prologo(c) }
    retornar x64_prologo(c)
}
funcion op_fijar_marco(c, posicion, tamano) {
    si (es_arm64(c)) { retornar a64_fijar_marco(c, posicion, tamano) }
    parchear32(ctx_codigo(c), posicion, tamano)
    retornar 0
}
funcion op_epilogo(c) {
    si (es_arm64(c)) { retornar a64_epilogo(c) }
    e3(c, 72, 137, 236)                                        // mov rsp, rbp
    e2(c, 93, 195)                                             // pop rbp; ret
    retornar 0
}

// Flotantes (bits de un double en a y b).
funcion op_f64(c, operacion) {
    si (es_arm64(c)) { retornar a64_f64(c, operacion) }
    retornar x64_f64(c, operacion)
}
funcion op_f64_desde_entero(c) {
    si (es_arm64(c)) { retornar a64_f64_desde_entero(c) }
    e5(c, 242, 72, 15, 42, 192)                                // cvtsi2sd xmm0, rax
    e5(c, 102, 72, 15, 126, 192)
    retornar 0
}
funcion op_f64_a_entero(c) {
    si (es_arm64(c)) { retornar a64_f64_a_entero(c) }
    e5(c, 102, 72, 15, 110, 192)
    e5(c, 242, 72, 15, 44, 192)                                // cvttsd2si rax, xmm0
    retornar 0
}
funcion op_f64_raiz(c) {
    si (es_arm64(c)) { retornar a64_f64_raiz(c) }
    e5(c, 102, 72, 15, 110, 192)                               // movq xmm0, rax
    e4(c, 242, 15, 81, 192)                                    // sqrtsd xmm0, xmm0
    e5(c, 102, 72, 15, 126, 192)                               // movq rax, xmm0
    retornar 0
}
funcion op_f64_menor(c) {
    si (es_arm64(c)) { retornar a64_f64_menor(c) }
    e5(c, 102, 72, 15, 110, 192)
    e5(c, 102, 72, 15, 110, 201)
    e4(c, 102, 15, 46, 193)                                    // ucomisd xmm0, xmm1
    e3(c, 15, 146, 192)                                        // setb al
    e3(c, 15, 182, 192)
    retornar 0
}
// a ← resultado flotante de una llamada C.
funcion op_resultado_flotante(c) {
    si (es_arm64(c)) { retornar a64_resultado_flotante(c) }
    e5(c, 102, 72, 15, 126, 192) retornar 0
}

// Llamadas al sistema y a C.
funcion op_syscall(c, n) {
    si (es_arm64(c)) { retornar a64_syscall(c, n) }
    retornar x64_syscall(c, n)
}
funcion op_hilo(c) {
    si (es_macos(c)) { error_en(c, "__hilo solo existe en Linux") }
    si (es_arm64(c)) { retornar a64_hilo(c) }
    retornar x64_hilo(c)
}
funcion op_ccall(c, n) {
    si (es_arm64(c)) { retornar a64_ccall(c, n) }
    si (es_windows(c)) { retornar x64_ccall_windows(c, n) }
    retornar x64_ccall(c, n)
}
funcion op_llamar_importada(c, indice, n) {
    si (es_arm64(c)) { retornar a64_llamar_importada(c, indice, n) }
    si (es_windows(c)) { retornar x64_llamar_iat(c, indice, n) }
    retornar x64_llamar_importada(c, indice, n)
}
funcion op_llamada_externa(c, casilla, tipos, convertidos) {
    si (es_arm64(c)) { retornar a64_llamada_externa(c, casilla, tipos, convertidos) }
    si (es_windows(c)) { retornar x64_llamada_externa_windows(c, casilla, tipos, convertidos) }
    retornar x64_llamada_externa(c, casilla, tipos, convertidos)
}
funcion op_inicio(c, principal) {
    si (es_arm64(c)) { retornar a64_inicio(c, principal) }
    retornar x64_inicio(c, principal)
}
funcion op_trampolin_hilo(c) {
    si (es_arm64(c)) { retornar a64_trampolin_hilo(c) }
    retornar x64_trampolin_hilo(c)
}
