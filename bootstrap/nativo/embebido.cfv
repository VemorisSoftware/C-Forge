    si (i == 8) { retornar "// runtime/sys_linux_arm64_ext.cfv — funciones de sistema de Linux AArch64\n// para los programas del lenguaje (tiempo, hilos, futex, sockets).\n\nfuncion sys_reloj_ns() {\n    sea ts = mem_reservar(16)\n    __syscall(113, 0, ts)                                      // CLOCK_REALTIME\n    sea ns = __cargar64(ts) * 1000000000 + __cargar64(ts + 8)\n    mem_liberar(ts)\n    retornar ns\n}\n\nfuncion sys_nucleos() {\n    sea mascara = mem_reservar(128)\n    mem_llenar(mascara, 0, 128)\n    sea n = __syscall(123, 0, 128, mascara)                    // sched_getaffinity\n    sea total = 0\n    si (n > 0) {\n        sea i = 0\n        mientras (i < n) {\n            sea b = __cargar8(mascara + i)\n            mientras (b > 0) {\n                total = total + __y_bits(b, 1)\n                b = __desplazar_der(b, 1)\n            }\n            i = i + 1\n        }\n    }\n    mem_liberar(mascara)\n    si (total < 1) { total = 1 }\n    retornar total\n}\n\nfuncion sys_dormir_ms(n) {\n    sea ts = mem_reservar(16)\n    __guardar64(ts, n / 1000)\n    __guardar64(ts + 8, (n % 1000) * 1000000)\n    __syscall(101, ts, 0)                                       // nanosleep\n    mem_liberar(ts)\n    retornar 0\n}\n\n// op 128: FUTEX_WAIT_PRIVATE · op 0: FUTEX_WAIT compartido (tid de clone).\nfuncion sys_futex_esperar(direccion, valor, ms, op) {\n    si (ms < 0) {\n        __syscall(98, direccion, op, __y_bits(valor, 4294967295), 0)\n        retornar 0\n    }\n    sea ts = mem_reservar(16)\n    __guardar64(ts, ms / 1000)\n    __guardar64(ts + 8, (ms % 1000) * 1000000)\n    __syscall(98, direccion, op, __y_bits(valor, 4294967295), ts)\n    mem_liberar(ts)\n    retornar 0\n}\n\nfuncion sys_futex_despertar(direccion) {\n    __syscall(98, direccion, 129, 2147483647)                 // FUTEX_WAKE_PRIVATE\n    retornar 0\n}\n\n// Hilo con clone en la pila [base, base + tam) que ejecuta dyn_hilo_inicio(t);\n// al terminar, el kernel pone en 0 el tid de base + 1