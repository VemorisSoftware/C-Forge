ea j = 0\n        sea hija = sangria\n        si (sangria >= 0) { hija = sangria + 1 }\n        mientras (j < vec_largo(orden)) {\n            sea k = vec_obtener(orden, j)\n            si (j > 0) { str_agregar_byte(r, 44) }\n            si (sangria >= 0) { dyn_json_sangria(r, hija) }\n            dyn_json_escapar_en(r, k)\n            str_agregar_byte(r, 58)\n            si (sangria >= 0) { str_agregar_byte(r, 32) }\n            dyn_json_agregar(r, map_obtener(m, k), hija, prof + 1)\n            j = j + 1\n        }\n        vec_liberar(orden)\n        si (sangria >= 0) { dyn_json_sangria(r, sangria) }\n        str_agregar_byte(r, 125)\n        retornar 0\n    }\n    dyn_error(\"json_serializar: valor no serializable\")\n    retornar 0\n}\n\nfuncion dyn_json_sangria(r, n) {\n    str_agregar_byte(r, 10)\n    sea i = 0\n    mientras (i < n) {\n        str_agregar(r, \"  \")\n        i = i + 1\n    }\n    retornar 0\n}\n\nfuncion dyn_json_serializar(v) {\n    sea r = str_nuevo(64)\n    dyn_json_agregar(r, v, 0 - 1, 0)\n    retornar dyn_texto(r)\n}\n\nfuncion dyn_json_bonito(v) {\n    sea r = str_nuevo(64)\n    dyn_json_agregar(r, v, 0, 0)\n    retornar dyn_texto(r)\n}\n\n// Cantidad de cifras decimales de un entero (chico o grande).\nfuncion dyn_longitud_decimal(v) {\n    sea s = dyn_a_str(v)\n    si (str_byte(s, 0) == 45) { retornar str_largo(s) - 1 }\n    retornar str_largo(s)\n}\n" }
    si (i == 16) { retornar "// runtime/cripto.cfv — criptografía moderna en C-Forge puro (puente).\n//\n// SHA-512 / SHA-384, HMAC (SHA-256 y SHA-512), HKDF, comparación en tiempo\n// constante, AES-256-GCM, X25519 y Ed25519 (aritmética de TweetNaCl: campo\n// 2^255 - 19 en 16 cifras de 16 bits) y RSA-OAEP (Montgomery con cifras de\n// 16 bits). Los textos son bytes; las funciones del lenguaje reciben y\n// devuelven textos (bytes crudos) salvo las que dicen \"hex\".\n\n// ── SHA-512 ──────────────────────────────────────────────────────────────\n\nfuncion cr_hex64(s, i) {\n    sea v = 0\n    sea k = 0\n    mientras (k < 16) {\n        v = __o_bits(__desplazar_izq(v, 4), valor_hex(str_byte(s, i + k)))\n        k = k + 1\n    }\n    retornar v\n}\n\nfuncion sha512_k() {\n    sea k = mem_global(29)\n    si (k != 0) { retornar k }\n    sea t = \"428a2f98d728ae22 7137449123ef65cd b5c0fbcfec4d3b2f e9b5dba58189dbbc 3956c25bf348b538 59f111f1b605d019 923f82a4af194f9b ab1c5ed5da6d8118 d807aa98a3030242 12835b0145706fbe 243185be4ee4b28c 550c7dc3d5ffb4e2 72be5d74f27b896f 80deb1fe3b1696b1 9bdc06a725c71235 c19bf174cf692694 e49b69c19ef14ad2 efbe4786384f25e3 0fc19dc68b8cd5b5 240ca1cc77ac9c65 2de92c6f592b0275 4a7484aa6ea6e483 5cb0a9dcbd41fbd4 76f988da831153b5 983e5152ee66dfab a831c66d2db43210 b00327c898fb213f bf597fc7beef0ee4 c6e00bf33da88fc2 d5a79147930aa725 06ca6351e003826f 142929670a0e6e70 27b70a8546d22ffc 2e1b21385c26c926 4d2c6dfc5ac42aed 53380d139d95b3df 650a73548baf63de 766a0abb3c77b2a8 81c2c92e47edaee6 92722c851482353b a2bfe8a14cf10364 a81a664bbc423001 c24b8b70d0f89791 c76c51a30654be30 d192e819d6ef5218 d69906245565a910 f40e35855771202a 106aa07032bbd1b8 19a4c116b8d2d0c8 1e376c085141ab53 2748774cdf8eeb99 34b0bcb5e19b48a8 391c0cb3c5c95a63 4ed8aa4ae3418acb 5b9cca4f7763e373 682e6ff3d6b2b8a3 748f82ee5defb2fc 78a5636f43172f60 84c87814a1f0ab72 8cc702081a6439ec 90befffa23631e28 a4506cebde82bde9 bef9a3f7b2c67915 c67178f2e372532b ca273eceea26619c d186b8c721c0c207 eada7dd6cde0eb1e f57d4f7fee6ed178 06f067aa72176fba 0a637dc5a2c898a6 113f9804bef90dae 1b710b35131c471b 28db77f523047d84 32caab7b40c72493 3c9ebe0a15c9bebc 431d67c49c100d4c 4cc5d4becb3e42b6 597f299cfc657e2a 5fcb6fab3ad6faec 6c44198c4a475817\"\n    k = mem_reservar(80 * 8)\n    sea i = 0\n    mientras (i < 80) {\n        __guardar64(k + i * 8, cr_hex64(t, i * 17))\n        i = i + 1\n    }\n    mem_fijar_global(29, k)\n    retornar k\n}\n\nfuncion rotd64(x, n) { retornar __o_bits(__desplazar_der(x, n), __desplazar_izq(x, 64 - n)) }\n\n// Bytes crudos → resumen de 64 bytes (o 48 con sha384).\nfuncion sha512_crudo(m, es384) {\n    sea h = mem_reservar(64)\n    si (es384) {\n        __guardar64(h, cr_hex64(\"cbbb9d5dc1059ed8\", 0))\n        __guardar64(h + 8, cr_hex64(\"629a292a367cd507\", 0))\n        __guardar64(h + 16, cr_hex64(\"9159015a3070dd17\", 0))\n        __guardar64(h + 24, cr_hex64(\"152fecd8f70e5939\", 0))\n        __guardar64(h + 32, cr_hex64(\"67332667ffc00b31\", 0))\n        __guardar64(h + 40, cr_hex64(\"8eb44a8768581511\", 0))\n        __guardar64(h + 48, cr_hex64(\"db0c2e0d64f98fa7\", 0))\n        __guardar64(h + 56, cr_hex64(\"47b5481dbefa4fa4\", 0))\n    } sino {\n        __guardar64(h, cr_hex64(\"6a09e667f3bcc908\", 0))\n        __guardar64(h + 8, cr_hex64(\"bb67ae8584caa73b\", 0))\n        __guardar64(h + 16, cr_hex64(\"3c6ef372fe94f82b\", 0))\n        __guardar64(h + 24, cr_hex64(\"a54ff53a5f1d36f1\", 0))\n        __guardar64(h + 32, cr_hex64(\"510e527fade682d1\", 0))\n        __guardar64(h + 40, cr_hex64(\"9b05688c2b3e6c1f\", 0))\n        __guardar64(h + 48, cr_hex64(\"1f83d9abfb41bd6b\", 0))\n        __guardar64(h + 56, cr_hex64(\"5be0cd19137e2179\", 0))\n    }\n    // Relleno a bloques de 128 bytes con la longitud (128 bits) al final.\n    sea s = str_nuevo(str_largo(m) + 144)\n    str_agregar(s, m)\n    str_agregar_byte(s, 128)\n    mientras (str_largo(s) % 128 != 112) { str_agregar_byte(s, 0) }\n    sea bits = str_largo(m) * 8\n    sea i = 0\n    mientras (i < 8) {\n        str_agregar_byte(s, 0)\n        i = i + 1\n    }\n    i = 0\n    mientras (i < 8) {\n        str_agregar_byte(s, __y_bits(__desplazar_der(bits, (7 - i) * 8), 255))\n        i = i + 1\n    }\n    sea k = sha512_k()\n    sea w = mem_reservar(80 * 8)\n    sea bloque = 0\n    mientras (bloque < str_largo(s)) {\n        i = 0\n        mientras (i < 16) {\n            sea v = 0\n            sea j = 0\n            mientras (j < 8) {\n                v = __o_bits(__desplazar_izq(v, 8), str_byte(s, bloque + i * 8 + j))\n                j = j + 1\n            }\n            __guardar64(w + i * 8, v)\n            i = i + 1\n        }\n        mientras (i < 80) {\n            sea w15 = __cargar64(w + (i - 15) * 8)\n            sea w2 = __cargar64(w + (i - 2) * 8)\n            sea s0 = __xo_bits(__xo_bits(rotd64(w15, 1), rotd64(w15, 8)), __desplazar_der(w15, 7))\n            sea s1 = __xo_bits(__xo_bits(rotd64(w2, 19), rotd64(w2, 61)), __desplazar_der(w2, 6))\n            __guardar64(w + i * 8, __cargar64(w + (i - 16) * 8) + s0 + __cargar64(w + (i - 7) * 8) + s1)\n            i = i + 1\n        }\n        sea a = __cargar64(h)\n        sea b = __cargar64(h + 8)\n        sea c = __cargar64(h + 16)\n        sea d = __cargar64(h + 24)\n        sea e = __cargar64(h + 32)\n        sea f = __cargar64(h + 40)\n        sea g = __cargar64(h + 48)\n        sea hh = __cargar64(h + 56)\n        i = 0\n        mientras (i < 80) {\n            sea S1 = __xo_bits(__xo_bits(rotd64(e, 14), rotd64(e, 18)), rotd64(e, 41))\n            sea ch = __xo_bits(__y_bits(e, f), __y_bits(__xo_bits(e, 0 - 1), g))\n            sea t1 = hh + S1 + ch + __cargar64(k + i * 8) + __cargar64(w + i * 8)\n            sea S0 = __xo_bits(__xo_bits(rotd64(a, 28), rotd64(a, 34)), rotd64(a, 39))\n            sea mayoria = __xo_bits(__xo_bits(__y_bits(a, b), __y_bits(a, c)), __y_bits(b, c))\n            sea t2 = S0 + mayoria\n            hh = g\n            g = f\n            f = e\n            e = d + t1\n            d = c\n            c = b\n            b = a\n            a = t1 + t2\n            i = i + 1\n        }\n        __guardar64(h, __cargar64(h) + a)\n        __guardar64(h + 8, __cargar64(h + 8) + b)\n        __guardar64(h + 16, __cargar64(h + 16) + c)\n        __guardar64(h + 24, __cargar64(h + 24) + d)\n        __guardar64(h + 32, __cargar64(h + 32) + e)\n        __guardar64(h + 40, __cargar64(h + 40) + f)\n        __guardar64(h + 48, __cargar64(h + 48) + g)\n        __guardar64(h + 56, __cargar64(h + 56) + hh)\n        bloque = bloque + 128\n    }\n    sea largo = 64\n    si (es384) { largo = 48 }\n    sea r = str_nuevo(64)\n    i = 0\n    mientras (i < largo) {\n        str_agregar_byte(r, __y_bits(__desplazar_der(__cargar64(h + (i / 8) * 8), (7 - i % 8) * 8), 255))\n        i = i + 1\n    }\n    cr_liberar(w)\n    cr_liberar(h)\n    retornar r\n}\n\nfuncion sha256_crudo(m) { retornar hex_a_bytes(dyn_texto_de(cfv_sha256(dyn_texto(m)), \"sha256\")) }\nfuncion sha1_crudo_bytes(m) { retornar hex_a_bytes(sha1_crudo(m)) }\n\n// Resumen por nombre: 1 sha1 · 256 sha256 · 384 · 512.\nfuncion cr_resumen(alg, m) {\n    si (alg == 1) { retornar sha1_crudo_bytes(m) }\n    si (alg == 256) { retornar sha256_crudo(m) }\n    si (alg == 384) { retornar sha512_crudo(m, 1) }\n    retornar sha512_crudo(m, 0)\n}\n\nfuncion cr_bloque(alg) {\n    si (alg == 384 o alg == 512) { retornar 128 }\n    retornar 64\n}\n\nfuncion cr_hex(s) {\n    sea r = str_nuevo(str_largo(s) * 2)\n    hex_de_memoria(r, str_datos(s), str_largo(s))\n    retornar r\n}\n\n// HMAC (RFC 2104) con bytes crudos.\nfuncion hmac_crudo(alg, k, m) {\n    sea b = cr_bloque(alg)\n    si (str_largo(k) > b) { k = cr_resumen(alg, k) }\n    sea interno = str_nuevo(b + str_largo(m))\n    sea externo = str_nuevo(b + 64)\n    sea i = 0\n    mientras (i < b) {\n        sea x = 0\n        si (i < str_largo(k)) { x = str_byte(k, i) }\n        str_agregar_byte(interno, __xo_bits(x, 54))\n        str_agregar_byte(externo, __xo_bits(x, 92))\n        i = i + 1\n    }\n    str_agregar(interno, m)\n    str_agregar(externo, cr_resumen(alg, interno))\n    retornar cr_resumen(alg, externo)\n}\n\n// HKDF (RFC 5869): extraer y expandir.\nfuncion hkdf_crudo(alg, ikm, sal, info, largo) {\n    sea hlen = str_largo(cr_resumen(alg, \"\"))\n    si (str_largo(sal) == 0) {\n        sal = str_nuevo(hlen)\n        sea z = 0\n        mientras (z < hlen) {\n            str_agregar_byte(sal, 0)\n            z = z + 1\n        }\n    }\n    sea prk = hmac_crudo(alg, sal, ikm)\n    sea r = str_nuevo(largo + hlen)\n    sea t = \"\"\n    sea n = 1\n    mientras (str_largo(r) < largo) {\n        sea entrada = str_nuevo(str_largo(t) + str_largo(info) + 1)\n        str_agregar(entrada, t)\n        str_agregar(entrada, info)\n        str_agregar_byte(entrada, n)\n        t = hmac_crudo(alg, prk, entrada)\n        str_agregar(r, t)\n        n = n + 1\n    }\n    retornar str_rebanar(r, 0, largo)\n}\n\n// ── Funciones del lenguaje (hash y MAC) ──\nfuncion sha512(t) { retornar dyn_texto(cr_hex(sha512_crudo(dyn_a_str(t), 0))) }\nfuncion sha384(t) { retornar dyn_texto(cr_hex(sha512_crudo(dyn_a_str(t), 1))) }\nfuncion sha512_bytes(t) { retornar dyn_texto(sha512_crudo(dyn_a_str(t), 0)) }\nfuncion hmac_sha512(clave, mensaje) { retornar dyn_texto(cr_hex(hmac_crudo(512, dyn_a_str(clave), dyn_a_str(mensaje)))) }\nfuncion hmac_sha512_bytes(clave, mensaje) { retornar dyn_texto(hmac_crudo(512, dyn_a_str(clave), dyn_a_str(mensaje))) }\nfuncion hkdf_sha256(ikm, sal, info, largo) { retornar dyn_texto(hkdf_crudo(256, dyn_a_str(ikm), dyn_a_str(sal), dyn_a_str(info), dyn_valor_entero(largo))) }\nfuncion hkdf_sha512(ikm, sal, info, largo) { retornar dyn_texto(hkdf_crudo(512, dyn_a_str(ikm), dyn_a_str(sal), dyn_a_str(info), dyn_valor_entero(largo))) }\n\n// Igualdad en tiempo constante (para comparar firmas, MAC, tokens).\nfuncion comparar_seguro(a, b) {\n    sea x = dyn_a_str(a)\n    sea y = dyn_a_str(b)\n    sea d = __xo_bits(str_largo(x), str_largo(y))\n    sea n = str_largo(x)\n    si (str_largo(y) < n) { n = str_largo(y) }\n    sea i = 0\n    mientras (i < n) {\n        d = __o_bits(d, __xo_bits(str_byte(x, i), str_byte(y, i)))\n        i = i + 1\n    }\n    retornar dyn_bool(d == 0)\n}\n\nfuncion bytes_aleatorios(n) {\n    sea k = dyn_valor_entero(n)\n    si (k < 0 o k > 65536) { dyn_error(\"bytes_aleatorios: n debe ser 0..65536\") }\n    sea r = str_nuevo(k)\n    si (k > 0 y sys_aleatorio(str_datos(r), k) != 0) { dyn_error(\"bytes_aleatorios: el sistema no entregó bytes aleatorios\") }\n    __guardar64(r, k)\n    retornar dyn_texto(r)\n}\n\n// ── AES-256-GCM (NIST SP 800-38D) ───────────────────────────────────────\n\nfuncion cr_be64(s, i) {\n    sea v = 0\n    sea k = 0\n    mientras (k < 8) {\n        v = __o_bits(__desplazar_izq(v, 8), str_byte(s, i + k))\n        k = k + 1\n    }\n    retornar v\n}\n\nfuncion cr_poner_be64(p, v) {\n    sea k = 0\n    mientras (k < 8) {\n        __guardar8(p + k, __y_bits(__desplazar_der(v, (7 - k) * 8), 255))\n        k = k + 1\n    }\n    retornar 0\n}\n\n// GHASH: y ← (y ⊕ bloque) · h en GF(2^128); y y h como [alto][bajo].\nfuncion ghash_bloque(y, h, bloque, i) {\n    sea x_alto = __xo_bits(__cargar64(y), cr_be64(bloque, i))\n    sea x_bajo = __xo_bits(__cargar64(y + 8), cr_be64(bloque, i + 8))\n    sea z_alto = 0\n    sea z_bajo = 0\n    sea v_alto = __cargar64(h)\n    sea v_bajo = __cargar64(h + 8)\n    sea r = __desplazar_izq(225, 56)\n    sea k = 0\n    mientras (k < 128) {\n        sea bit = 0\n        si (k < 64) { bit = __y_bits(__desplazar_der(x_alto, 63 - k), 1) } sino { bit = __y_bits(__desplazar_der(x_bajo, 127 - k), 1) }\n        // Sin ramas sobre datos secretos: máscaras.\n        sea mascara = 0 - bit\n        z_alto = __xo_bits(z_alto, __y_bits(v_alto, mascara))\n        z_bajo = __xo_bits(z_bajo, __y_bits(v_bajo, mascara))\n        sea lsb = 0 - __y_bits(v_bajo, 1)\n        v_bajo = __o_bits(__desplazar_der(v_bajo, 1), __desplazar_izq(v_alto, 63))\n        v_alto = __xo_bits(__desplazar_der(v_alto, 1), __y_bits(r, lsb))\n        k = k + 1\n    }\n    __guardar64(y, z_alto)\n    __guardar64(y + 8, z_bajo)\n    retornar 0\n}\n\nfuncion ghash_texto(y, h, s) {\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        sea b = str_nuevo(16)\n        sea k = 0\n        mientras (k < 16) {\n            si (i + k < str_largo(s)) { str_agregar_byte(b, str_byte(s, i + k)) } sino { str_agregar_byte(b, 0) }\n            k = k + 1\n        }\n        ghash_bloque(y, h, b, 0)\n        i = i + 16\n    }\n    retornar 0\n}\n\n// Contador de 32 bits del bloque (bytes 12..15) + 1.\nfuncion gcm_incrementar(p) {\n    sea v = __o_bits(__o_bits(__desplazar_izq(__cargar8(p + 12), 24), __desplazar_izq(__cargar8(p + 13), 16)), __o_bits(__desplazar_izq(__cargar8(p + 14), 8), __cargar8(p + 15)))\n    v = __y_bits(v + 1, 4294967295)\n    __guardar8(p + 12, __y_bits(__desplazar_der(v, 24), 255))\n    __guardar8(p + 13, __y_bits(__desplazar_der(v, 16), 255))\n    __guardar8(p + 14, __y_bits(__desplazar_der(v, 8), 255))\n    __guardar8(p + 15, __y_bits(v, 255))\n    retornar 0\n}\n\n// cifrar: texto → cifrado || etiqueta (16); descifrar: lo inverso (o -1).\nfuncion gcm_crudo(clave, nonce, texto, aad, cifrar) {\n    si (str_largo(clave) != 32 y str_largo(clave) != 16) { dyn_error(\"aes_gcm: la clave debe tener 16 o 32 bytes\") }\n    si (str_largo(nonce) != 12) { dyn_error(\"aes_gcm: el nonce debe tener 12 bytes\") }\n    sea nr = 14\n    si (str_largo(clave) == 16) { nr = 10 }\n    sea w = aes_expandir_n(str_datos(clave), str_largo(clave))\n    sea h = mem_reservar(16)\n    mem_llenar(h, 0, 16)\n    aes_bloque_cifrar_r(h, w, nr)\n    sea hs = str_nuevo(16)\n    sea k = 0\n    mientras (k < 16) {\n        str_agregar_byte(hs, __cargar8(h + k))\n        k = k + 1\n    }\n    __guardar64(h, cr_be64(hs, 0))\n    __guardar64(h + 8, cr_be64(hs, 8))\n    sea j0 = mem_reservar(16)\n    k = 0\n    mientras (k < 12) {\n        __guardar8(j0 + k, str_byte(nonce, k))\n        k = k + 1\n    }\n    __guardar8(j0 + 12, 0)\n    __guardar8(j0 + 13, 0)\n    __guardar8(j0 + 14, 0)\n    __guardar8(j0 + 15, 1)\n    sea etiqueta_rec = \"\"\n    sea n = str_largo(texto)\n    si (cifrar == 0) {\n        si (n < 16) { retornar 0 - 1 }\n        etiqueta_rec = str_rebanar(texto, n - 16, n)\n        texto = str_rebanar(texto, 0, n - 16)\n        n = n - 16\n    }\n    // CTR desde J0 + 1.\n    sea contador = mem_reservar(16)\n    sea flujo = mem_reservar(16)\n    k = 0\n    mientras (k < 16) {\n        __guardar8(contador + k, __cargar8(j0 + k))\n        k = k + 1\n    }\n    sea salida = str_nuevo(n + 16)\n    sea i = 0\n    mientras (i < n) {\n        gcm_incrementar(contador)\n        k = 0\n        mientras (k < 16) {\n            __guardar8(flujo + k, __cargar8(contador + k))\n            k = k + 1\n        }\n        aes_bloque_cifrar_r(flujo, w, nr)\n        k = 0\n        mientras (k < 16 y i + k < n) {\n            str_agregar_byte(salida, __xo_bits(str_byte(texto, i + k), __cargar8(flujo + k)))\n            k = k + 1\n        }\n        i = i + 16\n    }\n    // Etiqueta: GHASH(aad, cifrado, longitudes) ⊕ AES(J0).\n    sea cifrado = salida\n    si (cifrar == 0) { cifrado = texto }\n    sea y = mem_reservar(16)\n    mem_llenar(y, 0, 16)\n    ghash_texto(y, h, aad)\n    ghash_texto(y, h, cifrado)\n    sea largos = str_nuevo(16)\n    sea lp = mem_reservar(16)\n    cr_poner_be64(lp, str_largo(aad) * 8)\n    cr_poner_be64(lp + 8, n * 8)\n    k = 0\n    mientras (k < 16) {\n        str_agregar_byte(largos, __cargar8(lp + k))\n        k = k + 1\n    }\n    ghash_bloque(y, h, largos, 0)\n    aes_bloque_cifrar_r(j0, w, nr)\n    sea etiqueta = str_nuevo(16)\n    cr_poner_be64(lp, __cargar64(y))\n    cr_poner_be64(lp + 8, __cargar64(y + 8))\n    k = 0\n    mientras (k < 16) {\n        str_agregar_byte(etiqueta, __xo_bits(__cargar8(lp + k), __cargar8(j0 + k)))\n        k = k + 1\n    }\n    cr_liberar(w)\n    si (cifrar) {\n        str_agregar(salida, etiqueta)\n        retornar salida\n    }\n    sea d = 0\n    k = 0\n    mientras (k < 16) {\n        d = __o_bits(d, __xo_bits(str_byte(etiqueta, k), str_byte(etiqueta_rec, k)))\n        k = k + 1\n    }\n    si (d != 0) { retornar 0 - 1 }\n    retornar salida\n}\n\n// Un bloque AES en modo ECB (para la protección de cabeceras de QUIC).\nfuncion aes_bloque(clave, bloque) {\n    sea k = dyn_a_str(clave)\n    sea b = dyn_a_str(bloque)\n    si (str_largo(k) != 16 y str_largo(k) != 32) { dyn_error(\"aes_bloque: la clave debe tener 16 o 32 bytes\") }\n    si (str_largo(b) != 16) { dyn_error(\"aes_bloque: el bloque debe tener 16 bytes\") }\n    sea nr = 14\n    si (str_largo(k) == 16) { nr = 10 }\n    sea w = aes_expandir_n(str_datos(k), str_largo(k))\n    sea e = mem_reservar(16)\n    sea i = 0\n    mientras (i < 16) {\n        __guardar8(e + i, str_byte(b, i))\n        i = i + 1\n    }\n    aes_bloque_cifrar_r(e, w, nr)\n    sea r = str_nuevo(16)\n    i = 0\n    mientras (i < 16) {\n        str_agregar_byte(r, __cargar8(e + i))\n        i = i + 1\n    }\n    cr_liberar(w)\n    retornar dyn_texto(r)\n}\n\nfuncion aes_gcm_cifrar(clave, nonce, texto, aad) {\n    sea a = \"\"\n    si (aad != 0) { a = dyn_a_str(aad) }\n    retornar dyn_texto(gcm_crudo(dyn_a_str(clave), dyn_a_str(nonce), dyn_a_str(texto), a, 1))\n}\n\nfuncion aes_gcm_descifrar(clave, nonce, cifrado, aad) {\n    sea a = \"\"\n    si (aad != 0) { a = dyn_a_str(aad) }\n    sea r = gcm_crudo(dyn_a_str(clave), dyn_a_str(nonce), dyn_a_str(cifrado), a, 0)\n    si (r == 0 - 1) { dyn_error(\"aes_gcm_descifrar: la etiqueta no coincide (clave, nonce o datos alterados)\") }\n    retornar dyn_texto(r)\n}\n\n// ── Curva 25519 (X25519 y Ed25519), aritmética de TweetNaCl ──────────────\n// gf: 16 cifras de 16 bits con signo en enteros de 64 bits.\n\nfuncion gf_nuevo() {\n    sea p = mem_reservar(128)\n    mem_llenar(p, 0, 128)\n    retornar p\n}\nfuncion gf(p, i) { retornar __cargar64(p + i * 8) }\nfuncion gf_fijar(p, i, v) {\n    __guardar64(p + i * 8, v)\n    retornar 0\n}\nfuncion gf_de(valores) {\n    // valores: texto de 16 cifras hex de 4 dígitos separadas por espacio.\n    sea p = gf_nuevo()\n    sea i = 0\n    mientras (i < 16) {\n        sea v = 0\n        sea k = 0\n        mientras (k < 4) {\n            v = v * 16 + valor_hex(str_byte(valores, i * 5 + k))\n            k = k + 1\n        }\n        gf_fijar(p, i, v)\n        i = i + 1\n    }\n    retornar p\n}\nfuncion gf_copiar(r, a) {\n    sea i = 0\n    mientras (i < 16) {\n        gf_fijar(r, i, gf(a, i))\n        i = i + 1\n    }\n    retornar 0\n}\n\nfuncion car25519(o) {\n    sea i = 0\n    mientras (i < 16) {\n        gf_fijar(o, i, gf(o, i) + 65536)\n        sea c = __desplazar_aritmetico(gf(o, i), 16)\n        si (i < 15) {\n            gf_fijar(o, i + 1, gf(o, i + 1) + c - 1)\n        } sino {\n            gf_fijar(o, 0, gf(o, 0) + c - 1 + 37 * (c - 1))\n        }\n        gf_fijar(o, i, gf(o, i) - __desplazar_izq(c, 16))\n        i = i + 1\n    }\n    retornar 0\n}\n\n// Intercambio condicional sin ramas (b = 0 o 1).\nfuncion sel25519(p, q, b) {\n    sea c = 0 - b\n    sea i = 0\n    mientras (i < 16) {\n        sea t = __y_bits(c, __xo_bits(gf(p, i), gf(q, i)))\n        gf_fijar(p, i, __xo_bits(gf(p, i), t))\n        gf_fijar(q, i, __xo_bits(gf(q, i), t))\n        i = i + 1\n    }\n    retornar 0\n}\n\nfuncion pack25519(o, n) {\n    sea m = gf_nuevo()\n    sea t = gf_nuevo()\n    gf_copiar(t, n)\n    car25519(t)\n    car25519(t)\n    car25519(t)\n    sea j = 0\n    mientras (j < 2) {\n        gf_fijar(m, 0, gf(t, 0) - 65517)\n        sea i = 1\n        mientras (i < 15) {\n            gf_fijar(m, i, gf(t, i) - 65535 - __y_bits(__desplazar_aritmetico(gf(m, i - 1), 16), 1))\n            gf_fijar(m, i - 1, __y_bits(gf(m, i - 1), 65535))\n            i = i + 1\n        }\n        gf_fijar(m, 15, gf(t, 15) - 32767 - __y_bits(__desplazar_aritmetico(gf(m, 14), 16), 1))\n        sea b = __y_bits(__desplazar_aritmetico(gf(m, 15), 16), 1)\n        gf_fijar(m, 14, __y_bits(gf(m, 14), 65535))\n        sel25519(t, m, 1 - b)\n        j = j + 1\n    }\n    sea i = 0\n    mientras (i < 16) {\n        __guardar8(o + 2 * i, __y_bits(gf(t, i), 255))\n        __guardar8(o + 2 * i + 1, __y_bits(__desplazar_aritmetico(gf(t, i), 8), 255))\n        i = i + 1\n    }\n    cr_liberar(m)\n    cr_liberar(t)\n    retornar 0\n}\n\nfuncion iguales32(a, b) {\n    sea d = 0\n    sea i = 0\n    mientras (i < 32) {\n        d = __o_bits(d, __xo_bits(__cargar8(a + i), __cargar8(b + i)))\n        i = i + 1\n    }\n    retornar d == 0\n}\n\nfuncion neq25519(a, b) {\n    sea c = mem_reservar(32)\n    sea d = mem_reservar(32)\n    pack25519(c, a)\n    pack25519(d, b)\n    sea r = iguales32(c, d) == 0\n    cr_liberar(c)\n    cr_liberar(d)\n    retornar r\n}\n\nfuncion par25519(a) {\n    sea d = mem_reservar(32)\n    pack25519(d, a)\n    sea r = __y_bits(__cargar8(d), 1)\n    cr_liberar(d)\n    retornar r\n}\n\nfuncion unpack25519(o, n) {\n    sea i = 0\n    mientras (i < 16) {\n        gf_fijar(o, i, __cargar8(n + 2 * i) + __desplazar_izq(__cargar8(n + 2 * i + 1), 8))\n        i = i + 1\n    }\n    gf_fijar(o, 15, __y_bits(gf(o, 15), 32767))\n    retornar 0\n}\n\nfuncion gf_A(o, a, b) {\n    sea i = 0\n    mientras (i < 16) {\n        gf_fijar(o, i, gf(a, i) + gf(b, i))\n        i = i + 1\n    }\n    retornar 0\n}\nfuncion gf_Z(o, a, b) {\n    sea i = 0\n    mientras (i < 16) {\n        gf_fijar(o, i, gf(a, i) - gf(b, i))\n        i = i + 1\n    }\n    retornar 0\n}\nfuncion gf_M(o, a, b) {\n    sea t = mem_reservar(31 * 8)\n    mem_llenar(t, 0, 31 * 8)\n    sea i = 0\n    mientras (i < 16) {\n        sea ai = gf(a, i)\n        sea j = 0\n        mientras (j < 16) {\n            __guardar64(t + (i + j) * 8, __cargar64(t + (i + j) * 8) + ai * gf(b, j))\n            j = j + 1\n        }\n        i = i + 1\n    }\n    i = 0\n    mientras (i < 15) {\n        __guardar64(t + i * 8, __carg