oportado)\") }\n                        md_validar_dimensiones(\"jpeg\", ancho, alto)\n                        si (__cargar64(comps + 48) != 0) { dyn_error(\"jpeg: más de un SOF\") }\n                        si (nf != 1 y nf != 3 y nf != 4) { dyn_error(\"jpeg: cantidad de componentes no soportada\") }\n                        si (m == 194) { __guardar64(j + 40, 1) }\n                        sea c = 0\n                        mientras (c < nf) {\n                            sea comp = comps + c * 104\n                            __guardar64(comp, __cargar8(seg + 6 + c * 3))\n                            __guardar64(comp + 8, __desplazar_der(__cargar8(seg + 7 + c * 3), 4))\n                            __guardar64(comp + 16, __y_bits(__cargar8(seg + 7 + c * 3), 15))\n                            __guardar64(comp + 24, __y_bits(__cargar8(seg + 8 + c * 3), 3))\n                            si (__cargar64(comp + 8) == 0 o __cargar64(comp + 16) == 0 o __cargar64(comp + 8) > 4 o __cargar64(comp + 16) > 4) { dyn_error(\"jpeg: muestreo inválido\") }\n                            si (__cargar64(comp + 8) > hmax) { hmax = __cargar64(comp + 8) }\n                            si (__cargar64(comp + 16) > vmax) { vmax = __cargar64(comp + 16) }\n                            c = c + 1\n                        }\n                        mcux = (ancho + 8 * hmax - 1) / (8 * hmax)\n                        mcuy = (alto + 8 * vmax - 1) / (8 * vmax)\n                        c = 0\n                        mientras (c < nf) {\n                            sea comp = comps + c * 104\n                            sea bw = mcux * __cargar64(comp + 8)\n                            sea bh = mcuy * __cargar64(comp + 16)\n                            __guardar64(comp + 32, bw)\n                            __guardar64(comp + 40, bh)\n                            __guardar64(comp + 80, (ancho * __cargar64(comp + 8) + hmax - 1) / hmax)\n                            __guardar64(comp + 88, (alto * __cargar64(comp + 16) + vmax - 1) / vmax)\n                            sea coef = mem_reservar(bw * bh * 128)\n                            mem_llenar(coef, 0, bw * bh * 128)\n                            __guardar64(comp + 48, coef)\n                            c = c + 1\n                        }\n                    }\n                    si (m == 195 o (m >= 197 y m <= 207 y m != 200 y m != 204)) { dyn_error(\"jpeg: formato no soportado (sin pérdidas, jerárquico o aritmético)\") }\n                    si (m == 221) { ri = md_be16(seg) }\n                    si (m == 238 y sl >= 12) {\n                        si (__cargar8(seg) == 65 y __cargar8(seg + 1) == 100 y __cargar8(seg + 2) == 111 y __cargar8(seg + 3) == 98 y __cargar8(seg + 4) == 101) { adobe = __cargar8(seg + 11) }\n                    }\n                    si (m == 218) {\n                        si (nf == 0) { dyn_error(\"jpeg: SOS antes de SOF\") }\n                        sea ns = __cargar8(seg)\n                        sea lista = mem_reservar(4 * 8)\n                        sea k = 0\n                        mientras (k < ns) {\n                            sea cid = __cargar8(seg + 1 + k * 2)\n                            sea tabla = __cargar8(seg + 2 + k * 2)\n                            sea c = 0\n                            sea hallado = 0 - 1\n                            mientras (c < nf) {\n                                si (__cargar64(comps + c * 104) == cid) { hallado = c }\n                                c = c + 1\n                            }\n                            si (hallado < 0) { dyn_error(\"jpeg: componente desconocido en SOS\") }\n                            sea comp = comps + hallado * 104\n                            __guardar64(comp + 64, __y_bits(__desplazar_der(tabla, 4), 3))\n                            __guardar64(comp + 72, __y_bits(tabla, 3))\n                            __guardar64(comp + 56, 0)\n                            __guardar64(lista + k * 8, comp)\n                            k = k + 1\n                        }\n                        __guardar64(j + 8, __cargar8(seg + 1 + ns * 2))\n                        __guardar64(j + 16, __cargar8(seg + 2 + ns * 2))\n                        __guardar64(j + 24, __desplazar_der(__cargar8(seg + 3 + ns * 2), 4))\n                        __guardar64(j + 32, __y_bits(__cargar8(seg + 3 + ns * 2), 15))\n                        __guardar64(j, 0)\n                        si (__cargar64(j + 40) == 0) {\n                            __guardar64(j + 8, 0)\n                            __guardar64(j + 16, 63)\n                        } sino {\n                            // Progresivo: banda espectral y aproximación válidas\n                            // (si no, se leería y escribiría fuera del bloque).\n                            sea ss = __cargar64(j + 8)\n                            sea se = __cargar64(j + 16)\n                            si (ss > 63 o se > 63 o ss > se o (ss == 0 y se != 0) o (ss > 0 y ns != 1)) { dyn_error(\"jpeg: banda espectral inválida en SOS\") }\n                            si (__cargar64(j + 24) > 13 o __cargar64(j + 32) > 13) { dyn_error(\"jpeg: aproximación sucesiva inválida\") }\n                        }\n                        __guardar64(r, p)\n                        __guardar64(r + 8, n)\n                        __guardar64(r + 16, pos + largo)\n                        __guardar64(r + 24, 0)\n                        __guardar64(r + 32, 0)\n                        __guardar64(r + 40, 0)\n                        sea unidades = 0\n                        sea total_u = 0\n                        si (ns == 1) {\n                            sea comp = __cargar64(lista)\n                            sea bwc = (__cargar64(comp + 80) + 7) / 8\n                            sea bhc = (__cargar64(comp + 88) + 7) / 8\n                            total_u = bwc * bhc\n                            sea by = 0\n                            mientras (by < bhc) {\n                                sea bx = 0\n                                mientras (bx < bwc) {\n                                    md_jpeg_bloque(r, j, comp, __cargar64(comp + 48) + (by * __cargar64(comp + 32) + bx) * 128)\n                                    unidades = unidades + 1\n                                    si (ri > 0 y unidades % ri == 0 y unidades < total_u) {\n                                        md_reiniciar(r)\n                                        __guardar64(comp + 56, 0)\n                                        __guardar64(j, 0)\n                                    }\n                                    bx = bx + 1\n                                }\n                                by = by + 1\n                            }\n                        } sino {\n                            total_u = mcux * mcuy\n                            sea my = 0\n                            mientras (my < mcuy) {\n                                sea mx = 0\n                                mientras (mx < mcux) {\n                                    k = 0\n                                    mientras (k < ns) {\n                                        sea comp = __cargar64(lista + k * 8)\n                                        sea h = __cargar64(comp + 8)\n                                        sea v = __cargar64(comp + 16)\n                                        sea yy = 0\n                                        mientras (yy < v) {\n                                            sea xx = 0\n                                            mientras (xx < h) {\n                                                md_jpeg_bloque(r, j, comp, __cargar64(comp + 48) + ((my * v + yy) * __cargar64(comp + 32) + mx * h + xx) * 128)\n                                                xx = xx + 1\n                                            }\n                                            yy = yy + 1\n                                        }\n                                        k = k + 1\n                                    }\n                                    unidades = unidades + 1\n                                    si (ri > 0 y unidades % ri == 0 y unidades < total_u) {\n                                        md_reiniciar(r)\n                                        k = 0\n                                        mientras (k < ns) {\n                                            __guardar64(__cargar64(lista + k * 8) + 56, 0)\n                                            k = k + 1\n                                        }\n                                        __guardar64(j, 0)\n                                    }\n                                    mx = mx + 1\n                                }\n                                my = my + 1\n                            }\n                        }\n                        mem_liberar(lista)\n                        // Continuar en el siguiente marcador (no RST ni relleno).\n                        pos = __cargar64(r + 16)\n                        sea buscando = 1\n                        mientras (buscando == 1 y pos + 1 < n) {\n                            si (__cargar8(p + pos) == 255 y __cargar8(p + pos + 1) != 0 y (__cargar8(p + pos + 1) < 208 o __cargar8(p + pos + 1) > 215)) { buscando = 0 } sino { pos = pos + 1 }\n                        }\n                        largo = 0\n                    }\n                    pos = pos + largo\n                }\n            }\n        }\n    }\n    si (nf == 0) { dyn_error(\"jpeg: no se encontró la imagen (SOF)\") }\n    // IDCT de todos los bloques a planos de 8 bits.\n    sea tmp = mem_reservar(64 * 8)\n    sea val = mem_reservar(64 * 8)\n    sea c = 0\n    mientras (c < nf) {\n        sea comp = comps + c * 104\n        sea bw = __cargar64(comp + 32)\n        sea bh = __cargar64(comp + 40)\n        sea paso = bw * 8\n        sea plano = mem_reservar(bw * bh * 64)\n        __guardar64(comp + 96, plano)\n        sea q = qt + __cargar64(comp + 24) * 64 * 8\n        sea coef = __cargar64(comp + 48)\n        sea by = 0\n        mientras (by < bh) {\n            sea bx = 0\n            mientras (bx < bw) {\n                sea blk = coef + (by * bw + bx) * 128\n                sea k = 0\n                mientras (k < 64) {\n                    __guardar64(tmp + k * 8, md_c16(blk + k * 2) * __cargar64(q + k * 8))\n                    k = k + 1\n                }\n                k = 0\n                mientras (k < 8) {\n                    md_idct_1d(tmp, k, 8, val, 0, 0)\n                    k = k + 1\n                }\n                k = 0\n                mientras (k < 8) {\n                    md_idct_1d(val, k * 8, 1, 0, plano + (by * 8 + k) * paso + bx * 8, 1)\n                    k = k + 1\n                }\n                bx = bx + 1\n            }\n            by = by + 1\n        }\n        mem_liberar(coef)\n        c = c + 1\n    }\n    mem_liberar(tmp)\n    mem_liberar(val)\n    // Color: YCbCr (o RGB / YCCK / CMYK de Adobe) a RGBA.\n    sea salida = md_buffer_seguro(ancho, alto, 4)\n    sea sp = str_datos(salida)\n    sea transformar = 1\n    si (nf == 3) {\n        si (adobe == 0) { transformar = 0 }\n        si (__cargar64(comps) == 82 y __cargar64(comps + 104) == 71 y __cargar64(comps + 208) == 66) { transformar = 0 }\n    }\n    si (nf == 4) {\n        transformar = 0\n        si (adobe == 2) { transformar = 1 }\n    }\n    sea yy = 0\n    mientras (yy < alto) {\n        sea xx = 0\n        mientras (xx < ancho) {\n            sea po = sp + (yy * ancho + xx) * 4\n            sea a0 = md_muestra_comp(comps, xx, yy, hmax, vmax)\n            sea rr = a0\n            sea gg = a0\n            sea bb = a0\n            si (nf >= 3) {\n                sea a1 = md_muestra_comp(comps + 104, xx, yy, hmax, vmax)\n                sea a2 = md_muestra_comp(comps + 208, xx, yy, hmax, vmax)\n                si (transformar == 1) {\n                    sea yf = __desplazar_izq(a0, 20) + 524288\n                    sea cr = a2 - 128\n                    sea cb = a1 - 128\n                    rr = md_acotar8(__desplazar_aritmetico(yf + cr * 1470208, 20))\n                    gg = md_acotar8(__desplazar_aritmetico(yf - cr * 748800 - cb * 360960, 20))\n                    bb = md_acotar8(__desplazar_aritmetico(yf + cb * 1858048, 20))\n                } sino {\n                    rr = a0\n                    gg = a1\n                    bb = a2\n                }\n                si (nf == 4) {\n                    sea kk = md_muestra_comp(comps + 312, xx, yy, hmax, vmax)\n                    si (transformar == 1) {\n                        rr = 255 - rr\n                        gg = 255 - gg\n                        bb = 255 - bb\n                    }\n                    rr = (rr * kk + 127) / 255\n                    gg = (gg * kk + 127) / 255\n                    bb = (bb * kk + 127) / 255\n                }\n            }\n            __guardar8(po, rr)\n            __guardar8(po + 1, gg)\n            __guardar8(po + 2, bb)\n            __guardar8(po + 3, 255)\n            xx = xx + 1\n        }\n        yy = yy + 1\n    }\n    c = 0\n    mientras (c < nf) {\n        mem_liberar(__cargar64(comps + c * 104 + 96))\n        c = c + 1\n    }\n    mem_liberar(qt)\n    mem_liberar(tdc)\n    mem_liberar(tac)\n    mem_liberar(comps)\n    mem_liberar(j)\n    mem_liberar(r)\n    retornar md_lista3(dyn_entero(ancho), dyn_entero(alto), dyn_texto(salida))\n}\n\n// ── Rasterizado RGBA ───────────────────────────────────────────────────────\n\n// Mezcla \"src over\" de un píxel RGBA sin premultiplicar.\nfuncion md_mezclar(q, r, g, b, a) {\n    si (a <= 0) { retornar 0 }\n    si (a >= 255) {\n        __guardar8(q, r)\n        __guardar8(q + 1, g)\n        __guardar8(q + 2, b)\n        __guardar8(q + 3, 255)\n        retornar 0\n    }\n    sea da = __cargar8(q + 3)\n    sea t = da * (255 - a)\n    sea oa = a * 255 + t\n    sea mitad = oa / 2\n    __guardar8(q, (r * a * 255 + __cargar8(q) * t + mitad) / oa)\n    __guardar8(q + 1, (g * a * 255 + __cargar8(q + 1) * t + mitad) / oa)\n    __guardar8(q + 2, (b * a * 255 + __cargar8(q + 2) * t + mitad) / oa)\n    __guardar8(q + 3, (oa + 127) / 255)\n    retornar 0\n}\n\nfuncion md_pixeles(pix, w, h) {\n    sea s = dyn_a_str(pix)\n    si (str_largo(s) < w * h * 4) { dyn_error(\"lienzo: el búfer de píxeles es más chico que ancho × alto × 4\") }\n    si (__cargar64(s + 24) != 1) { dyn_error(\"lienzo: los píxeles deben ser un búfer propio\") }\n    retornar str_datos(s)\n}\n\nfuncion lienzo_llenar(pix, ancho, alto, r, g, b, a) {\n    sea w = md_ent(ancho)\n    sea h = md_ent(alto)\n    sea p = md_pixeles(pix, w, h)\n    sea vr = md_ent(r)\n    sea vg = md_ent(g)\n    sea vb = md_ent(b)\n    sea va = md_ent(a)\n    __guardar8(p, vr)\n    __guardar8(p + 1, vg)\n    __guardar8(p + 2, vb)\n    __guardar8(p + 3, va)\n    md_duplicar(p, 4, w * h * 4)\n    retornar 0\n}\n\n// Repite los primeros `hecho` bytes hasta llenar `total` (copias que doblan).\nfuncion md_duplicar(p, hecho, total) {\n    mientras (hecho < total) {\n        sea n = hecho\n        si (hecho + n > total) { n = total - hecho }\n        mem_copiar(p + hecho, p, n)\n        hecho = hecho + n\n    }\n    retornar 0\n}\n\n// Devuelve el z-buffer al fondo sin crear uno nuevo.\nfuncion lienzo_zlimpiar(zbuf, ancho, alto) {\n    sea w = md_ent(ancho)\n    sea h = md_ent(alto)\n    sea zp = md_zbuf(zbuf, w, h)\n    __guardar64(zp, 4611686018427387904)\n    md_duplicar(zp, 8, w * h * 8)\n    retornar 0\n}\n\nfuncion lienzo_rect(pix, ancho, alto, x, y, rw, rh, r, g, b, a) {\n    sea w = md_ent(ancho)\n    sea h = md_ent(alto)\n    sea p = md_pixeles(pix, w, h)\n    sea x0 = md_ent(x)\n    sea y0 = md_ent(y)\n    sea x1 = x0 + md_ent(rw)\n    sea y1 = y0 + md_ent(rh)\n    si (x0 < 0) { x0 = 0 }\n    si (y0 < 0) { y0 = 0 }\n    si (x1 > w) { x1 = w }\n    si (y1 > h) { y1 = h }\n    sea vr = md_ent(r)\n    sea vg = md_ent(g)\n    sea vb = md_ent(b)\n    sea va = md_ent(a)\n    sea fy = y0\n    mientras (fy < y1) {\n        sea fx = x0\n        mientras (fx < x1) {\n            md_mezclar(p + (fy * w + fx) * 4, vr, vg, vb, va)\n            fx = fx + 1\n        }\n        fy = fy + 1\n    }\n    retornar 0\n}\n\n// Polígono con antialiasing (8 subfilas, cobertura horizontal exacta).\n// contornos: lista de listas [x0, y0, x1, y1, ...] en 1/256 de píxel.\n// regla: 0 = nonzero (TrueType), 1 = par-impar.\nfuncion lienzo_poligono(pix, ancho, alto, contornos, r, g, b, a, regla) {\n    sea w = md_ent(ancho)\n    sea h = md_ent(alto)\n    sea p = md_pixeles(pix, w, h)\n    sea vr = md_ent(r)\n    sea vg = md_ent(g)\n    sea vb = md_ent(b)\n    sea va = md_ent(a)\n    sea par_impar = 0\n    si (regla != 0) { par_impar = md_ent(regla) }\n    // Aristas: [xa][ya][xb][yb][dir] con ya < yb.\n    sea lista = dyn_dato(contornos)\n    sea total = 0\n    sea c = 0\n    mientras (c < vec_largo(lista)) {\n        total = total + vec_largo(dyn_dato(vec_obtener(lista, c))) / 2\n        c = c + 1\n    }\n    si (total == 0) { retornar 0 }\n    sea aristas = mem_reservar(total * 40 + 40)\n    sea na = 0\n    sea ymin = 2147483647\n    sea ymax = 0 - 2147483647\n    sea xmin = 2147483647\n    sea xmax = 0 - 2147483647\n    c = 0\n    mientras (c < vec_largo(lista)) {\n        sea pts = dyn_dato(vec_obtener(lista, c))\n        sea np = vec_largo(pts) / 2\n        sea i = 0\n        mientras (i < np) {\n            sea ax = md_ent(vec_obtener(pts, i * 2))\n            sea ay = md_ent(vec_obtener(pts, i * 2 + 1))\n            sea k = i + 1\n            si (k == np) { k = 0 }\n            sea bx = md_ent(vec_obtener(pts, k * 2))\n            sea by = md_ent(vec_obtener(pts, k * 2 + 1))\n            si (ax < xmin) { xmin = ax }\n            si (ax > xmax) { xmax = ax }\n            si (ay < ymin) { ymin = ay }\n            si (ay > ymax) { ymax = ay }\n            si (ay != by) {\n                sea e = aristas + na * 40\n                si (ay < by) {\n                    __guardar64(e, ax)\n                    __guardar64(e + 8, ay)\n                    __guardar64(e + 16, bx)\n                    __guardar64(e + 24, by)\n                    __guardar64(e + 32, 1)\n                } sino {\n                    __guardar64(e, bx)\n                    __guardar64(e + 8, by)\n                    __guardar64(e + 16, ax)\n                    __guardar64(e + 24, ay)\n                    __guardar64(e + 32, 0 - 1)\n                }\n                na = na + 1\n            }\n            i = i + 1\n        }\n        c = c + 1\n    }\n    sea py0 = __desplazar_aritmetico(ymin, 8)\n    sea py1 = __desplazar_aritmetico(ymax + 255, 8)\n    si (py0 < 0) { py0 = 0 }\n    si (py1 > h) { py1 = h }\n    sea px0 = __desplazar_aritmetico(xmin, 8)\n    sea px1 = __desplazar_aritmetico(xmax + 255, 8) + 1\n    si (px0 < 0) { px0 = 0 }\n    si (px1 > w) { px1 = w }\n    si (na == 0 o py0 >= py1 o px0 >= px1) {\n        mem_liberar(aristas)\n        retornar 0\n    }\n    sea acc = mem_reservar((w + 2) * 8)\n    sea cx = mem_reservar(na * 16 + 16)\n    sea limite = w * 256\n    sea fy = py0\n    mientras (fy < py1) {\n        mem_llenar(acc + px0 * 8, 0, (px1 - px0 + 1) * 8)\n        sea sub = 0\n        mientras (sub < 8) {\n            sea sy = fy * 256 + sub * 32 + 16\n            // Cruces de esta subfila, ordenados por x (inserción).\n            sea nc = 0\n            sea i = 0\n            mientras (i < na) {\n                sea e = aristas + i * 40\n                sea ya = __cargar64(e + 8)\n                sea yb = __cargar64(e + 24)\n                si (ya <= sy y sy < yb) {\n                    sea xa = __cargar64(e)\n                    sea xx = xa + (sy - ya) * (__cargar64(e + 16) - xa) / (yb - ya)\n                    sea d = __cargar64(e + 32)\n                    sea k = nc\n                    mientras (k > 0 y __cargar64(cx + (k - 1) * 16) > xx) {\n                        __guardar64(cx + k * 16, __cargar64(cx + (k - 1) * 16))\n                        __guardar64(cx + k * 16 + 8, __cargar64(cx + (k - 1) * 16 + 8))\n                        k = k - 1\n                    }\n                    __guardar64(cx + k * 16, xx)\n                    __guardar64(cx + k * 16 + 8, d)\n                    nc = nc + 1\n                }\n                i = i + 1\n            }\n            sea giro = 0\n            i = 0\n            mientras (i + 1 < nc) {\n                giro = giro + __cargar64(cx + i * 16 + 8)\n                sea dentro = 0\n                si (par_impar == 1) { dentro = __y_bits(i + 1, 1) } sino { si (giro != 0) { dentro = 1 } }\n                si (dentro == 1) {\n                    sea xa = __cargar64(cx + i * 16)\n                    sea xb = __cargar64(cx + (i + 1) * 16)\n                    si (xa < 0) { xa = 0 }\n                    si (xb > limite) { xb = limite }\n                    si (xa < xb) {\n                        sea pa = __desplazar_der(xa, 8)\n                        sea pb = __desplazar_der(xb, 8)\n                        si (pa == pb) { __guardar64(acc + pa * 8, __cargar64(acc + pa * 8) + xb - xa) } sino {\n                            __guardar64(acc + pa * 8, __cargar64(acc + pa * 8) + 256 - __y_bits(xa, 255))\n                            sea q = pa + 1\n                            mientras (q < pb) {\n                                __guardar64(acc + q * 8, __cargar64(acc + q * 8) + 256)\n                                q = q + 1\n                            }\n                            si (pb < w) { __guardar64(acc + pb * 8, __cargar64(acc + pb * 8) + __y_bits(xb, 255)) }\n                        }\n                    }\n                }\n                i = i + 1\n            }\n            sub = sub + 1\n        }\n        sea fx = px0\n        mientras (fx < px1) {\n            sea cob = __cargar64(acc + fx * 8)\n            si (cob > 0) {\n                si (cob > 2048) { cob = 2048 }\n                md_mezclar(p + (fy * w + fx) * 4, vr, vg, vb, (cob * va + 1024) / 2048)\n            }\n            fx = fx + 1\n        }\n        fy = fy + 1\n    }\n    mem_liberar(acc)\n    mem_liberar(cx)\n    mem_liberar(aristas)\n    retornar 0\n}\n\nfuncion md_texel(t, tw, th, u, v, bilineal, salida) {\n    // u, v en 16.16 sobre el tamaño de la textura; repite en los bordes.\n    si (bilineal == 0) { retornar md_texel_crudo(t, tw, th, __desplazar_aritmetico(u, 16), __desplazar_aritmetico(v, 16), salida) }\n    u = u - 32768\n    v = v - 32768\n    sea x0 = __desplazar_aritmetico(u, 16)\n    sea y0 = __desplazar_aritmetico(v, 16)\n    sea fx = __desplazar_der(__y_bits(u, 65535), 8)\n    sea fy = __desplazar_der(__y_bits(v, 65535), 8)\n    sea k = 0\n    mientras (k < 4) {\n        sea a = md_canal(t, tw, th, x0, y0, k) * (256 - fx) + md_canal(t, tw, th, x0 + 1, y0, k) * fx\n        sea b = md_canal(t, tw, th, x0, y0 + 1, k) * (256 - fx) + md_canal(t, tw, th, x0 + 1, y0 + 1, k) * fx\n        __guardar64(salida + k * 8, __desplazar_der(a * (256 - fy) + b * fy + 32768, 16))\n        k = k + 1\n    }\n    retornar 0\n}\n\nfuncion md_canal(t, tw, th, x, y, k) {\n    x = x % tw\n    si (x < 0) { x = x + tw }\n    y = y % th\n    si (y < 0) { y = y + th }\n    retornar __cargar8(t + (y * tw + x) * 4 + k)\n}\n\nfuncion md_texel_crudo(t, tw, th, x, y, salida) {\n    x = x % tw\n    si (x < 0) { x = x + tw }\n    y = y % th\n    si (y < 0) { y = y + th }\n    sea q = t + (y * tw + x) * 4\n    __guardar64(salida, __cargar8(q))\n    __guardar64(salida + 8, __cargar8(q + 1))\n    __guardar64(salida + 16, __cargar8(q + 2))\n    __guardar64(salida + 24, __cargar8(q + 3))\n    retornar 0\n}\n\n// Copia (escalada) de una imagen RGBA sobre el lienzo con mezcla alfa.\n// params: [dx, dy, dw, dh, sx, sy, sw, sh, alfa, bilineal, tinte r, g, b]\nfuncion lienzo_copiar(pix, ancho, alto, src, sancho, salto, params) {\n    sea w = md_ent(ancho)\n    sea h = md_ent(alto)\n    sea p = md_pixeles(pix, w, h)\n    sea tw = md_ent(sancho)\n    sea th = md_ent(salto)\n    sea ss = dyn_a_str(src)\n    si (str_largo(ss) < tw * th * 4) { dyn_error(\"lienzo_copiar: imagen de origen incompleta\") }\n    sea t = str_datos(ss)\n    sea v = dyn_dato(params)\n    sea dx = md_ent(vec_obtener(v, 0))\n    sea dy = md_ent(vec_obtener(v, 1))\n    sea dw = md_ent(vec_obtener(v, 2))\n    sea dh = md_ent(vec_obtener(v, 3))\n    sea sx = md_ent(vec_obtener(v, 4))\n    sea sy = md_ent(vec_obtener(v, 5))\n    sea sw = md_ent(vec_obtener(v, 6))\n    sea sh = md_ent(vec_obtener(v, 7))\n    sea alfa = md_ent(vec_obtener(v, 8))\n    sea bil = md_ent(vec_obtener(v, 9))\n    sea tr = md_ent(vec_obtener(v, 10))\n    sea tg = md_ent(vec_obtener(v, 11))\n    sea tb = md_ent(vec_obtener(v, 12))\n    si (dw <= 0 o dh <= 0 o sw == 0 o sh == 0) { retornar 0 }\n    sea x0 = dx\n    sea y0 = dy\n    sea x1 = dx + dw\n    sea y1 = dy + dh\n    si (x0 < 0) { x0 = 0 }\n    si (y0 < 0) { y0 = 0 }\n    si (x1 > w) { x1 = w }\n    si (y1 > h) { y1 = h }\n    sea tx = mem_reservar(32)\n    sea exacto = 0\n    si (sw == dw y sh == dh y bil == 0 y sx >= 0 y sy >= 0 y sx + sw <= tw y sy + sh <= th) { exacto = 1 }\n    sea fy = y0\n    mientras (fy < y1) {\n        sea fx = x0\n        mientras (fx < x1) {\n            sea cr = 0\n            sea cg = 0\n            sea cb = 0\n            sea ca = 0\n            si (exacto == 1) {\n                sea q = t + ((sy + fy - dy) * tw + sx + fx - dx) * 4\n                cr = __cargar8(q)\n                cg = __cargar8(q + 1)\n                cb = __cargar8(q + 2)\n                ca = __cargar8(q + 3)\n            } sino {\n                // Centro del píxel destino llevado al origen (16.16).\n                sea u = sx * 65536 + ((fx - dx) * 2 + 1) * sw * 32768 / dw\n                sea vv = sy * 65536 + ((fy - dy) * 2 + 1) * sh * 32768 / dh\n                si (bil == 1) { md_texel(t, tw, th, u, vv, 1, tx) } sino { md_texel_crudo(t, tw, th, __desplazar_aritmetico(u, 16), __desplazar_aritmetico(vv, 16), tx) }\n                cr = __cargar64(tx)\n                cg = __cargar64(tx + 8)\n                cb = __cargar64(tx + 16)\n                ca = __cargar64(tx + 24)\n            }\n            si (tr != 255) { cr = (cr * tr + 127) / 255 }\n            si (tg != 255) { cg = (cg * tg + 127) / 255 }\n            si (tb != 255) { cb = (cb * tb + 127) / 255 }\n            si (alfa != 255) { ca = (ca * alfa + 127) / 255 }\n            md_mezclar(p + (fy * w + fx) * 4, cr, cg, cb, ca)\n            fx = fx + 1\n        }\n        fy = fy + 1\n    }\n    mem_liberar(tx)\n    retornar 0\n}\n\n// Triángulo 3D con z-buffer, color por vértice y textura con corrección de\n// perspectiva. vertices: 30 enteros, por vértice [x, y] en 1/16 de píxel,\n// z (0..2^24, menor = más cerca), iw (1/w normalizado a 0..65536),\n// r, g, b, a (0..255) y u, v (16.16 sobre la textura).\n// opciones: 1 descartar caras traseras, 2 prueba z, 4 escribir z,\n// 8 textura bilineal, 16 mezcla alfa.\nfuncion lienzo_triangulo(pix, zbuf, ancho, alto, vertices, textura, tancho, talto, opciones) {\n    sea w = md_ent(ancho)\n    sea h = md_ent(alto)\n    sea p = md_pixeles(pix, w, h)\n    sea op = md_ent(opciones)\n    sea zp = md_zbuf(zbuf, w, h)\n    sea t = 0\n    sea tw = 0\n    sea th = 0\n    si (textura != 0) {\n        tw = md_ent(tancho)\n        th = md_ent(talto)\n        t = md_textura(textura, tw, th)\n    }\n    sea vs = dyn_dato(vertices)\n    sea vt = mem_reservar(30 * 8)\n    sea i = 0\n    mientras (i < 30) {\n        __guardar64(vt + i * 8, md_ent(vec_obtener(vs, i)))\n        i = i + 1\n    }\n    md_tri(p, zp, w, h, vt, t, tw, th, op)\n    mem_liberar(vt)\n    retornar 0\n}\n\nfuncion md_zbuf(zbuf, w, h) {\n    si (zbuf == 0) { retornar 0 }\n    sea zs = dyn_a_str(zbuf)\n    si (str_largo(zs) < w * h * 8) { dyn_error(\"lienzo: z-buffer incompleto\") }\n    retornar str_datos(zs)\n}\n\nfuncion md_textura(textura, tw, th) {\n    sea ts = dyn_a_str(textura)\n    si (str_largo(ts) < tw * th * 4) { dyn_error(\"lienzo: textura incompleta\") }\n    retornar str_datos(ts)\n}\n\n// Todos los triángulos de una malla. tabla: 11 enteros por vértice\n// [x, y, z, iw, r, g, b, a, u, v, recortar]; los triángulos con algún\n// vértice marcado para recortar se saltan (los recorta graficos.cfv).\n// Dibuja (i0, i2, i1) para pasar de antihorario en el mundo a pantalla.\nfuncion lienzo_triangulos(pix, zbuf, ancho, alto, tabla, indices, textura, tancho, talto, opciones) {\n    sea w = md_ent(ancho)\n    sea h = md_ent(alto)\n    sea p = md_pixeles(pix, w, h)\n    sea op = md_ent(opciones)\n    sea zp = md_zbuf(zbuf, w, h)\n    sea t = 0\n    sea tw = 0\n    sea th = 0\n    si (textura != 0) {\n        tw = md_ent(tancho)\n        th = md_ent(talto)\n        t = md_textura(textura, tw, th)\n    }\n    sea tv = dyn_dato(tabla)\n    sea nv = vec_largo(tv) / 11\n    // Copia cruda de la tabla para no convertir en cada triángulo.\n    sea crudo = mem_reservar(nv * 88 + 8)\n    sea i = 0\n    mientras (i < nv * 11) {\n        __guardar64(crudo + i * 8, md_ent(vec_obtener(tv, i)))\n        i = i + 1\n    }\n    sea ix = dyn_dato(indices)\n    sea vt = mem_reservar(30 * 8)\n    sea dibujados = 0\n    sea k = 0\n    mientras (k + 2 < vec_largo(ix)) {\n        sea a = md_ent(vec_obtener(ix, k))\n        sea b = md_ent(vec_obtener(ix, k + 2))\n        sea c = md_ent(vec_obtener(ix, k + 1))\n        si (a >= 0 y b >= 0 y c >= 0 y a < nv y b < nv y c < nv) {\n            si (__cargar64(crudo + a * 88 + 80) == 0 y __cargar64(crudo + b * 88 + 80) == 0 y __cargar64(crudo + c * 88 + 80) == 0) {\n                mem_copiar(vt, crudo + a * 88, 80)\n                mem_copiar(vt + 80, crudo + b * 88, 80)\n                mem_copiar(vt + 160, crudo + c * 88, 80)\n                md_tri(p, zp, w, h, vt, t, tw, th, op)\n                dibujados = dibujados + 1\n            }\n        }\n        k = k + 3\n    }\n    mem_liberar(vt)\n    mem_liberar(crudo)\n    retornar dyn_entero(dibujados)\n}\n\nfuncion md_tri(p, zp, w, h, vt, t, tw, th, op) {\n    // 1/w relativo: el mayor de los tres pasa a 65536.\n    sea mx = __cargar64(vt + 24)\n    si (__cargar64(vt + 104) > mx) { mx = __cargar64(vt + 104) }\n    si (__cargar64(vt + 184) > mx) { mx = __cargar64(vt + 184) }\n    si (mx > 65536) {\n        __guardar64(vt + 24, __cargar64(vt + 24) * 65536 / mx)\n        __guardar64(vt + 104, __cargar64(vt + 104) * 65536 / mx)\n        __guardar64(vt + 184, __cargar64(vt + 184) * 65536 / mx)\n    }\n    sea area = (__cargar64(vt + 80) - __cargar64(vt)) * (__cargar64(vt + 168) - __cargar64(vt + 8)) - (__cargar64(vt + 88) - __cargar64(vt + 8)) * (__cargar64(vt + 160) - __cargar64(vt))\n    si (area == 0 o (__y_bits(op, 1) != 0 y area < 0)) { retornar 0 }\n    si (area < 0) {\n        // Ordenar en sentido positivo intercambiando v1 y v2.\n        sea k = 0\n        mientras (k < 10) {\n            sea a1 = __cargar64(vt + (10 + k) * 8)\n            __guardar64(vt + (10 + k) * 8, __cargar64(vt + (20 + k) * 8))\n            __guardar64(vt + (20 + k) * 8, a1)\n            k = k + 1\n        }\n        area = 0 - area\n    }\n    sea x0 = __cargar64(vt)\n    sea y0 = __cargar64(vt + 8)\n    sea x1 = __cargar64(vt + 80)\n    sea y1 = __cargar64(vt + 88)\n    sea x2 = __cargar64(vt + 160)\n    sea y2 = __cargar64(vt + 168)\n    sea minx = x0\n    si (x1 < minx) { minx = x1 }\n    si (x2 < minx) { minx = x2 }\n    sea maxx = x0\n    si (x1 > maxx) { maxx = x1 }\n    si (x2 > maxx) { maxx = x2 }\n    sea miny = y0\n    si (y1 < miny) { miny = y1 }\n    si (y2 < miny) { miny = y2 }\n    sea maxy = y0\n    si (y1 > maxy) { maxy = y1 }\n    si (y2 > maxy) { maxy = y2 }\n    sea bx0 = __desplazar_aritmetico(minx, 4)\n    sea bx1 = __desplazar_aritmetico(maxx + 15, 4)\n    sea by0 = __desplazar_aritmetico(miny, 4)\n    sea by1 = __desplazar_aritmetico(maxy + 15, 4)\n    si (bx0 < 0) { bx0 = 0 }\n    si (by0 < 0) { by0 = 0 }\n    si (bx1 > w) { bx1 = w }\n    si (by1 > h) { by1 = h }\n    // Regla arriba-izquierda: las aristas que no lo son excluyen el borde.\n    sea s0 = md_sesgo(x1, y1, x2, y2)\n    sea s1 = md_sesgo(x2, y2, x0, y0)\n    sea s2 = md_sesgo(x0, y0, x1, y1)\n    sea a01 = y0 - y1\n    sea b01 = x1 - x0\n    sea a12 = y1 - y2\n    sea b12 = x2 - x1\n    sea a20 = y2 - y0\n    sea b20 = x0 - x2\n    sea px = bx0 * 16 + 8\n    sea py = by0 * 16 + 8\n    sea w0f = (x2 - x1) * (py - y1) - (y2 - y1) * (px - x1)\n    sea w1f = (x0 - x2) * (py - y2) - (y0 - y2) * (px - x2)\n    sea w2f = (x1 - x0) * (py - y0) - (y1 - y0) * (px - x0)\n    sea iw0 = __cargar64(vt + 24)\n    sea iw1 = __cargar64(vt + 104)\n    sea iw2 = __cargar64(vt + 184)\n    sea z0 = __cargar64(vt + 16)\n    sea z1 = __cargar64(vt + 96)\n    sea z2 = __cargar64(vt + 176)\n    sea tx = mem_reservar(32)\n    sea fy = by0\n    mientras (fy < by1) {\n        sea e0 = w0f\n        sea e1 = w1f\n        sea e2 = w2f\n        sea fx = bx0\n        mientras (fx < bx1) {\n            si (e0 + s0 >= 0 y e1 + s1 >= 0 y e2 + s2 >= 0) {\n                sea z = (e0 * z0 + e1 * z1 + e2 * z2) / area\n                sea idx = fy * w + fx\n                sea pasa = 1\n                si (zp != 0 y __y_bits(op, 2) != 0) { si (z >= __cargar64(zp + idx * 8)) { pasa = 0 } }\n                si (pasa == 1) {\n                    sea q0 = __desplazar_aritmetico(e0 * iw0, 16)\n                    sea q1 = __desplazar_aritmetico(e1 * iw1, 16)\n                    sea q2 = __desplazar_aritmetico(e2 * iw2, 16)\n                    sea qs = q0 + q1 + q2\n                    si (qs <= 0) {\n                        q0 = e0\n                        q1 = e1\n                        q2 = e2\n                        qs = area\n                    }\n                    sea cr = (q0 * __cargar64(vt + 32) + q1 * __cargar64(vt + 112) + q2 * __cargar64(vt + 192)) / qs\n                    sea cg = (q0 * __cargar64(vt + 40) + q1 * __cargar64(vt + 120) + q2 * __cargar64(vt + 200)) / qs\n                    sea cb = (q0 * __cargar64(vt + 48) + q1 * __cargar64(vt + 128) + q2 * __cargar64(vt + 208)) / qs\n                    sea ca = (q0 * __cargar64(vt + 56) + q1 * __cargar64(vt + 136) + q2 * __cargar64(vt + 216)) / qs\n                    si (t != 0) {\n                        sea u = (q0 * __cargar64(vt + 64) + q1 * __cargar64(vt + 144) + q2 * __cargar64(vt + 224)) / qs\n                        sea vv = (q0 * __cargar64(vt + 72) + q1 * __cargar64(vt + 152) + q2 * __cargar64(vt + 232)) / qs\n                        si (__y_bits(op, 8) != 0) { md_texel(t, tw, th, u, vv, 1, tx) } sino { md_texel_crudo(t, tw, th, __desplazar_aritmetico(u, 16), __desplazar_aritmetico(vv, 16), tx) }\n                        cr = (cr * __cargar64(tx) + 127) / 255\n                        cg = (cg * __cargar64(tx + 8) + 127) / 255\n                        cb = (cb * __cargar64(tx + 16) + 127) / 255\n                        ca = (ca * __cargar64(tx + 24) + 127) / 255\n                    }\n                    sea q = p + idx * 4\n                    si (__y_bits(op, 16) != 0) { md_mezclar(q, cr, cg, cb, ca) } sino {\n                        __guardar8(q, md_acotar8(cr))\n                        __guardar8(q + 1, md_acotar8(cg))\n                        __guardar8(q + 2, md_acotar8(cb))\n                        __guardar8(q + 3, 255)\n                    }\n                    si (zp != 0 y __y_bits(op, 4) != 0) { __guardar64(zp + idx * 8, z) }\n                }\n            }\n            e0 = e0 - (y2 - y1) * 16\n            e1 = e1 - (y0 - y2) * 16\n            e2 = e2 - (y1 - y0) * 16\n            fx = fx + 1\n        }\n        w0f = w0f + (x2 - x1) * 16\n        w1f = w1f + (x0 - x2) * 16\n        w2f = w2f + (x1 - x0) * 16\n        fy = fy + 1\n    }\n    mem_liberar(tx)\n    retornar 0\n}\n\n// 0 para aristas superiores o izquierdas (incluyen el borde), -1 si no.\nfuncion md_sesgo(ax, ay, bx, by) {\n    si (ay == by y bx < ax) { retornar 0 }\n    si (by < ay) { retornar 0 }\n    retornar 0 - 1\n}\n\n// Z-buffer nuevo (8 bytes por píxel, todo al fondo).\nfuncion lienzo_zbuffer(ancho, alto) {\n    sea s = md_buffer_seguro(md_ent(ancho), md_ent(alto), 8)\n    sea n = md_ent(ancho) * md_ent(alto)\n    sea p = str_datos(s)\n    __guardar64(p, 4611686018427387904)\n    md_duplicar(p, 8, n * 8)\n    retornar dyn_texto(s)\n}\n\nfuncion lienzo_nuevo_buffer(ancho, alto) {\n    retornar dyn_texto(md_buffer_seguro(md_ent(ancho), md_ent(alto), 4))\n}\n\nfuncion lienzo_fijar_pixel(pix, ancho, alto, x, y, r, g, b, a) {\n    sea w = md_ent(ancho)\n    sea h = md_ent(alto)\n    sea p = md_pixeles(pix, w, h)\n    sea fx = md_ent(x)\n    sea fy = md_ent(y)\n    si (fx < 0 o fy < 0 o fx >= w o fy >= h) { retornar 0 }\n    sea q = p + (fy * w + fx) * 4\n    __guardar8(q, md_ent(r))\n    __guardar8(q + 1, md_ent(g))\n    __guardar8(q + 2, md_ent(b))\n    __guardar8(q + 3, md_ent(a))\n    retornar 0\n}\n\n// Puntos de código de un texto UTF-8 (los bytes inválidos dan U+FFFD).\nfuncion texto_codigos(t) {\n    sea s = dyn_a_str(t)\n    sea p = str_datos(s)\n    sea n = str_largo(s)\n    sea v = vec_nuevo()\n    sea i = 0\n    mientras (i < n) {\n        sea b = __cargar8(p + i)\n        sea cp = 65533\n        sea largo = 1\n        si (b < 128) { cp = b } sino {\n            si (b >= 194 y b < 224 y i + 1 < n) {\n                cp = __o_bits(__desplazar_izq(__y_bits(b, 31), 6), __y_bits(__cargar8(p + i + 1), 63))\n                largo = 2\n            } sino {\n                si (b >= 224 y b < 240 y i + 2 < n) {\n                    cp = __o_bits(__o_bits(__desplazar_izq(__y_bits(b, 15), 12), __desplazar_izq(__y_bits(__cargar8(p + i + 1), 63), 6)), __y_bits(__cargar8(p + i + 2), 63))\n                    largo = 3\n                } sino {\n                    si (b >= 240 y b < 245 y i + 3 < n) {\n                        cp = __o_bits(__o_bits(__desplazar_izq(__y_bits(b, 7), 18), __desplazar_izq(__y_bits(__cargar8(p + i + 1), 63), 12)), __o_bits(__desplazar_izq(__y_bits(__cargar8(p + i + 2), 63), 6), __y_bits(__cargar8(p + i + 3), 63)))\n                        largo = 4\n                    }\n                }\n            }\n        }\n        vec_agregar(v, dyn_entero(cp))\n        i = i + largo\n    }\n    retornar dyn_caja(2, v)\n}\n\n// ── Audio PCM ──────────────────────────────────────────────────────────────\n\n// WAV (PCM 8/16/24/32 bits y flotante de 32 bits) → [tasa, canales, pcm s16].\nfuncion wav_decodificar(datos) {\n    sea s = dyn_a_str(datos)\n    sea p = str_datos(s)\n    sea n = str_largo(s)\n    si (n < 12 o md_be32(p) != 1380533830 o md_be32(p + 8) != 1463899717) { dyn_error(\"wav: no es un archivo RIFF/WAVE\") }\n    sea pos = 12\n    sea formato = 0\n    sea canales = 0\n    sea tasa = 0\n    sea bits = 0\n    sea dp = 0\n    sea dn = 0\n    mientras (pos + 8 <= n) {\n        sea id = md_be32(p + pos)\n        sea largo = md_le32(p + pos + 4)\n        sea d = p + pos + 8\n        si (id == 1718449184) {\n            formato = md_le16(d)\n            canales = md_le16(d + 2)\n            tasa = md_le32(d + 4)\n            bits = md_le16(d + 14)\n            si (formato == 65534 y largo >= 26) { formato = md_le16(d + 24) }\n        }\n        si (id == 1684108385) {\n            dp = d\n            dn = largo\n            si (pos + 8 + dn > n) { dn = n - pos - 8 }\n        }\n        pos = pos + 8 + largo + __y_bits(largo, 1)\n    }\n    si (canales == 0 o dp == 0) { dyn_error(\"wav: faltan los bloques fmt o data\") }\n    si (formato != 1 y formato != 3) { dyn_error(\"wav: solo PCM entero o flotante (sin compresión)\") }\n    sea bpm = bits / 8\n    sea total = dn / bpm\n    sea r = md_buffer_seguro(total, 2, 1)\n    sea q = str_datos(r)\n    sea i = 0\n    mientras (i < total) {\n        sea a = dp + i * bpm\n        sea v = 0\n        si (formato == 3) {\n            si (bits != 32) { dyn_error(\"wav: flotante solo de 32 bits\") }\n            // f32 → s16 sin coma flotante: exponente y mantisa.\n            sea b = md_le32(a)\n            sea e = __y_bits(__desplazar_der(b, 23), 255)\n            sea m = __o_bits(__y_bits(b, 8388607), 8388608)\n            si (e == 0) { v = 0 } sino {\n                // valor = m * 2^(e - 150); escalar por 32767.\n                sea k = e - 150\n                v = m * 32767\n                si (k >= 0) { v = __desplazar_izq(v, k) } sino {\n                    si (k > 0 - 63) { v = __desplazar_der(v, 0 - k) } sino { v = 0 }\n                }\n                si (v > 32767) { v = 32767 }\n                si (__y_bits(b, 2147483648) != 0) { v = 0 - v }\n            }\n        } sino {\n            si (bits == 8) { v = (__cargar8(a) - 128) * 256 }\n            si (bits == 16) { v = md_c16(a) }\n            si (bits == 24) { v = md_c16(a + 1) }\n            si (bits == 32) { v = md_c16(a + 2) }\n        }\n        md_g16(q + i * 2, v)\n        i = i + 1\n    }\n    retornar md_lista3(dyn_entero(tasa), dyn_entero(canales), dyn_texto(r))\n}\n\nfuncion wav_codificar(pcm, tasa, canales) {\n    sea s = dyn_a_str(pcm)\n    sea n = str_largo(s)\n    sea c = md_ent(canales)\n    sea t = md_ent(tasa)\n    sea r = str_nuevo(n + 44)\n    md_agregar_bytes(r, \"82,73,70,70\")\n    md_agregar_le32(r, n + 36)\n    md_agregar_bytes(r, \"87,65,86,69,102,109,116,32,16,0,0,0,1,0\")\n    str_agregar_byte(r, c)\n    str_agregar_byte(r, 0)\n    md_agregar_le32(r, t)\n    md_agregar_le32(r, t * c * 2)\n    str_agregar_byte(r, c * 2)\n    md_agregar_bytes(r, \"0,16,0,100,97,116,97\")\n    md_agregar_le32(r, n)\n    str_agregar(r, s)\n    retornar dyn_texto(r)\n}\n\nfuncion md_agregar_le32(s, v) {\n    str_agregar_byte(s, __y_bits(v, 255))\n    str_agregar_byte(s, __y_bits(__desplazar_der(v, 8), 255))\n    str_agregar_byte(s, __y_bits(__desplazar_der(v, 16), 255))\n    str_agregar_byte(s, __y_bits(__desplazar_der(v, 24), 255))\n    retornar 0\n}\n\n// Lista de enteros (−32768..32767) → PCM s16.\nfuncion pcm_de_lista(lista) {\n    sea v = dyn_dato(lista)\n    sea n = vec_largo(v)\n    sea r = md_buffer_seguro(n, 2, 1)\n    sea q = str_datos(r)\n    sea i = 0\n    mientras (i < n) {\n        sea x = md_ent(vec_obtener(v, i))\n        si (x > 32767) { x = 32767 }\n        si (x < 0 - 32768) { x = 0 - 32768 }\n        md_g16(q + i * 2, x)\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion pcm_muestra(pcm, i) { retornar dyn_entero(md_c16(str_datos(dyn_a_str(pcm)) + md_ent(i) * 2)) }\n\n// Mezcla una voz en un búfer estéreo s16 de `cuadros` cuadros.\n// params: [posición 16.16, paso 16.16, volumen izq, volumen der (0..65536),\n// bucle 0/1]. Devuelve la nueva posición o -1 si terminó.\nfuncion pcm_mezclar(destino, cuadros, fuente, canales, params) {\n    sea dp = md_pixeles_audio(destino, md_ent(cuadros))\n    sea nc = md_ent(cuadros)\n    sea fs = dyn_a_str(fuente)\n    sea fp = str_datos(fs)\n    sea ch = md_ent(canales)\n    sea total = str_largo(fs) / 2 / ch\n    sea v = dyn_dato(params)\n    sea pos = md_ent(vec_obtener(v, 0))\n    sea paso = md_ent(vec_obtener(v, 1))\n    sea vi = md_ent(vec_obtener(v, 2))\n    sea vd = md_ent(vec_obtener(v, 3))\n    sea bucle = md_ent(vec_obtener(v, 4))\n    si (total == 0) { retornar dyn_entero(0 - 1) }\n    sea i = 0\n    mientras (i < nc) {\n        sea k = __desplazar_der(pos, 16)\n        si (k >= total) {\n            si (bucle == 1) {\n                pos = pos - __desplazar_izq(total, 16)\n                k = __desplazar_der(pos, 16)\n            } sino { retornar dyn_entero(0 - 1) }\n        }\n        sea fr = __y_bits(pos, 65535)\n        sea k2 = k + 1\n        si (k2 >= total) {\n            si (bucle == 1) { k2 = 0 } sino { k2 = k }\n        }\n        sea l = 0\n        sea r = 0\n        sea a0 = md_c16(fp + k * ch * 2)\n        sea a1 = md_c16(fp + k2 * ch * 2)\n        l = a0 + __desplazar_aritmetico((a1 - a0) * fr, 16)\n        si (ch >= 2) {\n            sea b0 = md_c16(fp + (k * ch + 1) * 2)\n            sea b1 = md_c16(fp + (k2 * ch + 1) * 2)\n            r = b0 + __desplazar_aritmetico((b1 - b0) * fr, 16)\n        } sino { r = l }\n        sea q = dp + i * 4\n        sea ml = md_c16(q) + __desplazar_aritmetico(l * vi, 16)\n        sea mr = md_c16(q + 2) + __desplazar_aritmetico(r * vd, 16)\n        si (ml > 32767) { ml = 32767 }\n        si (ml < 0 - 32768) { ml = 0 - 32768 }\n        si (mr > 32767) { mr = 32767 }\n        si (mr < 0 - 32768) { mr = 0 - 32768 }\n        md_g16(q, ml)\n        md_g16(q + 2, mr)\n        pos = pos + paso\n        i = i + 1\n    }\n    retornar dyn_entero(pos)\n}\n\nfuncion md_pixeles_audio(destino, cuadros) {\n    sea s = dyn_a_str(destino)\n    si (str_largo(s) < cuadros * 4) { dyn_error(\"pcm_mezclar: el destino es más chico que cuadros × 4 bytes\") }\n    si (__cargar64(s + 24) != 1) { dyn_error(\"pcm_mezclar: el destino debe ser un búfer propio\") }\n    retornar str_datos(s)\n}\n\nfuncion pcm_silencio(bytes) { retornar dyn_texto(md_buffer_seguro(md_ent(bytes), 1, 1)) }\n\n// Copia rápida de bytes a memoria C (para pasar píxeles a OpenGL o SDL).\nfuncion c_desde_bytes(t) {\n    sea s = dyn_a_str(t)\n    sea p = mem_reservar(str_largo(s) + 1)\n    mem_copiar(p, str_datos(s), str_largo(s))\n    __guardar8(p + str_largo(s), 0)\n    retornar dyn_caja(11, p)\n}\n\n// Dirección de los datos de un texto (sin copiar). Válida mientras el texto\n// siga vivo y no cambie de tamaño.\nfuncion bytes_direccion(t) { retornar dyn_caja(11, str_datos(dyn_a_str(t))) }\n" }
    si (i == 18) { retornar "// runtime/lenguaje.cfv — funciones del lenguaje escritas en C-Forge completo.\n//\n// Se compila en modo \"lenguaje\" (--lenguaje): es código dinámico normal,\n// pero un programa puede redefinir cualquiera de estas funciones.\n\n// Tareas: cada una corre en un hilo nativo (clone) con su propia pila.\n// esperar(t[, ms]) espera a que termine y devuelve su resultado; si la tarea\n// lanzó un error, esperar lo vuelve a lanzar.\nfuncion tarea(f) {\n    // Todas las claves existen antes de lanzar el hilo: después solo se\n    // reemplazan valores (sin modificar la estructura del mapa en paralelo).\n    sea t = {\"__tarea\": verdadero, \"f\": f, \"resultado\": nulo, \"error\": nulo, \"fallo\": falso, \"hilo\": nulo}\n    t[\"hilo\"] = dyn_hilo_lanzar(t)\n    retornar t\n}\n\nfuncion tarea_ejecutar(t) {\n    intentar {\n        t[\"resultado\"] = t[\"f\"]()\n    } capturar (e) {\n        t[\"error\"] = e\n        t[\"fallo\"] = verdadero\n    }\n}\n\nfuncion esperar(t, limite_ms) {\n    si (no dyn_hilo_esperar(t[\"hilo\"], limite_ms)) { lanzar \"esperar: la tarea no terminó en \" + limite_ms + \" ms\" }\n    si (t[\"fallo\"]) { lanzar t[\"error\"] }\n    retornar t[\"resultado\"]\n}\n\nfuncion hilo(f) { retornar tarea(f) }\n\n// paralelo(f, lista): f(x) para cada elemento, repartido en 8 hilos; los\n// resultados quedan en el orden de la lista.\nfuncion paralelo(f, elementos) {\n    si (tipo_de(f) == \"texto\") { lanzar \"paralelo: pasa la función (paralelo(f, lista)), no su nombre\" }\n    sea n = longitud(elementos)\n    sea resultados = []\n    sea i = 0\n    mientras (i < n) {\n        agregar(resultados, nulo)\n        i = i + 1\n    }\n    sea grupos = 8\n    sea tareas = []\n    sea g = 0\n    mientras (g < grupos) {\n        sea primero = g\n        agregar(tareas, tarea(funcion() {\n            sea k = primero\n            mientras (k < n) {\n                resultados[k] = f(elementos[k])\n                k = k + grupos\n            }\n            retornar nulo\n        }))\n        g = g + 1\n    }\n    para t en tareas { esperar(t) }\n    retornar resultados\n}\n\nfuncion mapear(lista, f) {\n    sea r = []\n    para x en lista { r.agregar(f(x)) }\n    retornar r\n}\n\nfuncion filtrar(lista, f) {\n    sea r = []\n    para x en lista {\n        si (f(x)) { r.agregar(x) }\n    }\n    retornar r\n}\n\nfuncion reducir(lista, f, inicial) {\n    sea acumulado = inicial\n    para x en lista { acumulado = f(acumulado, x) }\n    retornar acumulado\n}\n\n// ── JSON ──────────────────────────────────────────────────────────────────\n\nfuncion json_escapar(t) { retornar dyn_json_escapar(t) }\nfuncion cfv_json_serializar(v) { retornar dyn_json_serializar(v) }\nfuncion json_texto(v) { retornar dyn_json_serializar(v) }\nfuncion cfv_json_bonito(v) { retornar dyn_json_bonito(v) }\nfuncion cfv_json_parsear(texto) { retornar dyn_json_parsear(texto) }\n\n// ── Expresiones regulares (retroceso) ─────────────────────────────────────\n// Soporta: literales, ., [..], [^..], rangos, \\d \\w \\s \\D \\W \\S, ^, $,\n// grupos (..), alternativas |, y cuantificadores * + ? {m}, {m,}, {m,n}.\n\nfuncion re_clase_escape(e) {\n    si (e == \"d\") { retornar {\"t\": \"set\", \"neg\": falso, \"rangos\": [[48, 57]]} }\n    si (e == \"D\") { retornar {\"t\": \"set\", \"neg\": verdadero, \"rangos\": [[48, 57]]} }\n    si (e == \"w\") { retornar {\"t\": \"set\", \"neg\": falso, \"rangos\": [[48, 57], [65, 90], [97, 122], [95, 95]]} }\n    si (e == \"W\") { retornar {\"t\": \"set\", \"neg\": verdadero, \"rangos\": [[48, 57], [65, 90], [97, 122], [95, 95]]} }\n    si (e == \"s\") { retornar {\"t\": \"set\", \"neg\": falso, \"rangos\": [[32, 32], [9, 10], [13, 13], [12, 12], [11, 11]]} }\n    si (e == \"S\") { retornar {\"t\": \"set\", \"neg\": verdadero, \"rangos\": [[32, 32], [9, 10], [13, 13], [12, 12], [11, 11]]} }\n    retornar nulo\n}\n\nfuncion re_codigo_escape(e) {\n    si (e == \"n\") { retornar 10 }\n    si (e == \"t\") { retornar 9 }\n    si (e == \"r\") { retornar 13 }\n    retornar byte_en(e, 0)\n}\n\nfuncion re_numero(estado) {\n    sea p = estado[\"p\"]\n    sea n = 0\n    sea hay = falso\n    mientras (estado[\"i\"] < longitud(p) y contiene(\"0123456789\", p[estado[\"i\"]])) {\n        n = n * 10 + byte_en(p, estado[\"i\"]) - 48\n        estado[\"i\"] += 1\n        hay = verdadero\n    }\n    si (no hay) { retornar nulo }\n    retornar n\n}\n\nfuncion re_conjunto(estado) {\n    sea p = estado[\"p\"]\n    estado[\"i\"] += 1\n    sea nodo = {\"t\": \"set\", \"neg\": falso, \"rangos\": []}\n    si (estado[\"i\"] < longitud(p) y p[estado[\"i\"]] == \"^\") {\n        nodo[\"neg\"] = verdadero\n        estado[\"i\"] += 1\n    }\n    sea primero = verdadero\n    mientras (estado[\"i\"] < longitud(p) y (p[estado[\"i\"]] != \"]\" o primero)) {\n        primero = falso\n        sea desde = byte_en(p, estado[\"i\"])\n        si (p[estado[\"i\"]] == \"\\\\\") {\n            sea e = p[estado[\"i\"] + 1]\n            estado[\"i\"] += 2\n            sea clase = re_clase_escape(e)\n            si (clase != nulo y no clase[\"neg\"]) {\n                para r en clase[\"rangos\"] { nodo[\"rangos\"].agregar(r) }\n                continuar\n            }\n            desde = re_codigo_escape(e)\n        } sino {\n            estado[\"i\"] += 1\n        }\n        sea hasta = desde\n        si (estado[\"i\"] + 1 < longitud(p) y p[estado[\"i\"]] == \"-\" y p[estado[\"i\"] + 1] != \"]\") {\n            hasta = byte_en(p, estado[\"i\"] + 1)\n            estado[\"i\"] += 2\n        }\n        nodo[\"rangos\"].agregar([desde, hasta])\n    }\n    si (estado[\"i\"] >= longitud(p)) { lanzar \"regex: falta ']'\" }\n    estado[\"i\"] += 1\n    retornar nodo\n}\n\nfuncion re_atomo(estado) {\n    sea p = estado[\"p\"]\n    sea c = p[estado[\"i\"]]\n    si (c == \"(\") {\n        estado[\"i\"] += 1\n        si (subtexto(p, estado[\"i\"], estado[\"i\"] + 2) == \"?:\") { estado[\"i\"] += 2 }\n        sea alt = re_alternativas(estado)\n        si (estado[\"i\"] >= longitud(p) o p[estado[\"i\"]] != \")\") { lanzar \"regex: falta ')'\" }\n        estado[\"i\"] += 1\n        retornar {\"t\": \"grupo\", \"alt\": alt}\n    }\n    si (c == \"[\") { retornar re_conjunto(estado) }\n    estado[\"i\"] += 1\n    si (c == \".\") { retornar {\"t\": \"any\"} }\n    si (c == \"^\") { retornar {\"t\": \"bol\"} }\n    si (c == \"$\") { retornar {\"t\": \"eol\"} }\n    si (c == \"\\\\\") {\n        sea e = p[estado[\"i\"]]\n        estado[\"i\"] += 1\n        sea clase = re_clase_escape(e)\n        si (clase != nulo) { retornar clase }\n        retornar {\"t\": \"char\", \"c\": re_codigo_escape(e)}\n    }\n    retornar {\"t\": \"char\", \"c\": byte_en(c, 0)}\n}\n\nfuncion re_secuencia(estado) {\n    sea p = estado[\"p\"]\n    sea items = []\n    mientras (estado[\"i\"] < longitud(p) y p[estado[\"i\"]] != \"|\" y p[estado[\"i\"]] != \")\") {\n        sea nodo = re_atomo(estado)\n        nodo[\"min\"] = 1\n        nodo[\"max\"] = 1\n        nodo[\"perezoso\"] = falso\n        si (estado[\"i\"] < longitud(p)) {\n            sea q = p[estado[\"i\"]]\n            si (q == \"*\") { nodo[\"min\"] = 0  nodo[\"max\"] = -1  estado[\"i\"] += 1 }\n            sino si (q == \"+\") { nodo[\"max\"] = -1  estado[\"i\"] += 1 }\n            sino si (q == \"?\") { nodo[\"min\"] = 0  estado[\"i\"] += 1 }\n            sino si (q == \"\\{\") {\n                estado[\"i\"] += 1\n                sea m = re_numero(estado)\n                nodo[\"min\"] = m\n                nodo[\"max\"] = m\n                si (p[estado[\"i\"]] == \",\") {\n                    estado[\"i\"] += 1\n                    sea n = re_numero(estado)\n                    si (n == nulo) { nodo[\"max\"] = -1 } sino { nodo[\"max\"] = n }\n                }\n                si (p[estado[\"i\"]] != \"\\}\") { lanzar \"regex: cuantificador inválido\" }\n                estado[\"i\"] += 1\n            }\n            si (estado[\"i\"] < longitud(p) y p[estado[\"i\"]] == \"?\") {\n                nodo[\"perezoso\"] = verdadero\n                estado[\"i\"] += 1\n            }\n        }\n        items.agregar(nodo)\n    }\n    retornar items\n}\n\nfuncion re_alternativas(estado) {\n    sea opciones = [re_secuencia(estado)]\n    mientras (estado[\"i\"] < longitud(estado[\"p\"]) y estado[\"p\"][estado[\"i\"]] == \"|\") {\n        estado[\"i\"] += 1\n        opciones.agregar(re_secuencia(estado))\n    }\n    retornar opciones\n}\n\nfuncion re_compilar(patron) {\n    sea estado = {\"p\": patron, \"i\": 0}\n    sea alt = re_alternativas(estado)\n    si (estado[\"i\"] != longitud(patron)) { lanzar \"regex: ')' sin abrir\" }\n    retornar re_programa(alt)\n}\n\nfuncion re_en_conjunto(nodo, b) {\n    sea dentro = falso\n    para r en nodo[\"rangos\"] {\n        si (b >= r[0] y b <= r[1]) { dentro = verdadero }\n    }\n    si (nodo[\"neg\"]) { retornar no dentro }\n    retornar dentro\n}\n\n// ── Máquina de hilos (Pike VM) ───────────────────────────────────────────\n// El árbol se compila a un programa y se ejecuta avanzando todos los hilos a\n// la vez, una posición del texto por paso: tiempo O(texto · programa) sin\n// retroceso. Prioridad de hilos = semántica de primera alternativa (como\n// Perl); los cuantificadores con \"?\" son perezosos.\n// Instrucciones: 0 char(c) · 1 any · 2 set(i) · 3 bol · 4 eol\n//                5 split(x, y) (x primero) · 6 jmp(x) · 7 match\n//                8 vuelta(x, salida): jmp al inicio del bucle; si la vuelta no\n//                  consumió nada (x ya visitado aquí), sale del bucle (Perl)\n//                9 control(x, salida): igual, pero si consumió sigue de largo\n\nfuncion re_emitir(prog, op, a, b) {\n    si (longitud(prog[\"op\"]) >= 200000) { lanzar \"regex: el patrón es demasiado grande\" }\n    prog[\"op\"].agregar(op)\n    prog[\"a\"].agregar(a)\n    prog[\"b\"].agregar(b)\n    retornar longitud(prog[\"op\"]) - 1\n}\n\nfuncion re_prog_alt(prog, opciones) {\n    sea saltos = []\n    sea i = 0\n    mientras (i < longitud(opciones)) {\n        si (i < longitud(opciones) - 1) {\n            sea division = re_emitir(prog, 5, 0, 0)\n            prog[\"a\"][division] = division + 1\n            re_prog_seq(prog, opciones[i])\n            saltos.agregar(re_emitir(prog, 6, 0, 0))\n            prog[\"b\"][division] = longitud(prog[\"op\"])\n        } sino {\n            re_prog_seq(prog, opciones[i])\n        }\n        i += 1\n    }\n    para j en saltos { prog[\"a\"][j] = longitud(prog[\"op\"]) }\n}\n\nfuncion re_prog_seq(prog, items) {\n    para nodo en items { re_prog_rep(prog, nodo) }\n}\n\n// split hacia el cuerpo y la salida, en el orden que pide el cuantificador\nfuncion re_split(prog, nodo, division, cuerpo, salida) {\n    si (nodo[\"perezoso\"]) {\n        prog[\"a\"][division] = salida\n        prog[\"b\"][division] = cuerpo\n    } sino {\n        prog[\"a\"][division] = cuerpo\n        prog[\"b\"][division] = salida\n    }\n}\n\nfuncion re_prog_rep(prog, nodo) {\n    sea i = 0\n    mientras (i < nodo[\"min\"]) {\n        re_prog_atomo(prog, nodo)\n        i += 1\n    }\n    si (nodo[\"max\"] < 0) {\n        sea division = re_emitir(prog, 5, 0, 0)\n        re_prog_atomo(prog, nodo)\n        sea vuelta = re_emitir(prog, 8, division, 0)\n        prog[\"b\"][vuelta] = longitud(prog[\"op\"])\n        re_split(prog, nodo, division, division + 1, longitud(prog[\"op\"]))\n        retornar nulo\n    }\n    sea pendientes = []\n    sea controles = []\n    mientras (i < nodo[\"max\"]) {\n        sea division = re_emitir(prog, 5, 0, 0)\n        re_prog_atomo(prog, nodo)\n        controles.agregar(re_emitir(prog, 9, division, 0))\n        pendientes.agregar(division)\n        i += 1\n    }\n    sea salida = longitud(prog[\"op\"])\n    para d en pendientes { re_split(prog, nodo, d, d + 1, salida) }\n    para c en controles { prog[\"b\"][c] = salida }\n}\n\nfuncion re_prog_atomo(prog, nodo) {\n    sea t = nodo[\"t\"]\n    si (t == \"char\") { re_emitir(prog, 0, nodo[\"c\"], 0) }\n    sino si (t == \"any\") { re_emitir(prog, 1, 0, 0) }\n    sino si (t == \"set\") {\n        prog[\"sets\"].agregar(nodo)\n        re_emitir(prog, 2, longitud(prog[\"sets\"]) - 1, 0)\n    }\n    sino si (t == \"bol\") { re_emitir(prog, 3, 0, 0) }\n    sino si (t == \"eol\") { re_emitir(prog, 4, 0, 0) }\n    sino { re_prog_alt(prog, nodo[\"alt\"]) }\n}\n\nfuncion re_programa(alt) {\n    sea prog = {\"op\": [], \"a\": [], \"b\": [], \"sets\": []}\n    re_prog_alt(prog, alt)\n    re_emitir(prog, 7, 0, 0)\n    sea n = longitud(prog[\"op\"])\n    prog[\"marca\"] = lista_repetir(-1, n)\n    prog[\"gen\"] = 0\n    // listas de hilos (actual y siguiente) y pila, de tamaño fijo: cada pc\n    // entra a lo más una vez por posición\n    prog[\"pcs\"] = [lista_repetir(0, n), lista_repetir(0, n)]\n    prog[\"inicios\"] = [lista_repetir(0, n), lista_repetir(0, n)]\n    prog[\"pila\"] = lista_repetir(0, 2 * n + 2)\n    // tabla de bytes por conjunto (evita recorrer rangos en cada paso)\n    sea tablas = []\n    para c en prog[\"sets\"] {\n        sea tabla = lista_repetir(falso, 256)\n        sea b = 0\n        mientras (b < 256) {\n            tabla[b] = re_en_conjunto(c, b)\n            b += 1\n        }\n        tablas.agregar(tabla)\n    }\n    prog[\"tablas\"] = tablas\n    retornar prog\n}\n\n// Agrega el hilo pc (y lo que alcanza sin consumir) a la lista desde la\n// posición cuenta, en orden de prioridad; devuelve la nueva cuenta. marca\n// evita repetir un pc en la misma posición.\nfuncion re_agregar_hilo(prog, pcs, inicios, cuenta, pc, inicio, pos, n, gen) {\n    sea op = prog[\"op\"]\n    sea arg_a = prog[\"a\"]\n    sea arg_b = prog[\"b\"]\n    sea marca = prog[\"marca\"]\n    sea pila = prog[\"pila\"]\n    sea tope = 1\n    pila[0] = pc\n    mientras (tope > 0) {\n        tope -= 1\n        sea p = pila[tope]\n        si (marca[p] == gen) { continuar }\n        marca[p] = gen\n        sea o = op[p]\n        si (o == 6) {\n            pila[tope] = arg_a[p]\n            tope += 1\n        } sino si (o == 5) {\n            pila[tope] = arg_b[p]\n            pila[tope + 1] = arg_a[p]\n            tope += 2\n        } sino si (o == 8) {\n            si (marca[arg_a[p]] == gen) { pila[tope] = arg_b[p] } sino { pila[tope] = arg_a[p] }\n            tope += 1\n        } sino si (o == 9) {\n            si (marca[arg_a[p]] == gen) { pila[tope] = arg_b[p] } sino { pila[tope] = p + 1 }\n            tope += 1\n        } sino si (o == 3) {\n            si (pos == 0) {\n                pila[tope] = p + 1\n                tope += 1\n            }\n        } sino si (o == 4) {\n            si (pos == n) {\n                pila[tope] = p + 1\n                tope += 1\n            }\n        } sino {\n            pcs[cuenta] = p\n            inicios[cuenta] = inicio\n            cuenta += 1\n        }\n    }\n    retornar cuenta\n}\n\n// Primera coincidencia desde inicio: [comienzo, fin] o nulo.\nfuncion re_buscar_desde(prog, s, inicio) {\n    sea n = longitud(s)\n    sea op = prog[\"op\"]\n    sea arg = prog[\"a\"]\n    sea tablas = prog[\"tablas\"]\n    sea pcs = prog[\"pcs\"][0]\n    sea inicios = prog[\"inicios\"][0]\n    sea npcs = prog[\"pcs\"][1]\n    sea ninicios = prog[\"inicios\"][1]\n    sea cuenta = 0\n    sea hallado = nulo\n    sea pos = inicio\n    // generación de marcas: única entre búsquedas sobre el mismo programa\n    prog[\"gen\"] += 1\n    sea gen = prog[\"gen\"]\n    mientras (pos <= n) {\n        si (hallado == nulo) { cuenta = re_agregar_hilo(prog, pcs, inicios, cuenta, 0, pos, pos, n, gen) }\n        si (cuenta == 0 y hallado != nulo) { romper }\n        sea b = -1\n        si (pos < n) { b = byte_en(s, pos) }\n        sea ncuenta = 0\n        sea i = 0\n        mientras (i < cuenta) {\n            sea pc = pcs[i]\n            sea o = op[pc]\n            si (o == 7) {\n                hallado = [inicios[i], pos]\n                romper\n            }\n            sea ok = falso\n            si (b >= 0) {\n                si (o == 0) { ok = b == arg[pc] }\n                sino si (o == 1) { ok = b != 10 }\n                sino si (o == 2) { ok = tablas[arg[pc]][b] }\n            }\n            si (ok) { ncuenta = re_agregar_hilo(prog, npcs, ninicios, ncuenta, pc + 1, inicios[i], pos + 1, n, gen + 1) }\n            i += 1\n        }\n        sea tp = pcs\n        pcs = npcs\n        npcs = tp\n        sea ti = inicios\n        inicios = ninicios\n        ninicios = ti\n        cuenta = ncuenta\n        gen += 1\n        pos += 1\n    }\n    prog[\"gen\"] = gen + 1\n    retornar hallado\n}\n\nfuncion re_todas(prog, s) {\n    sea r = []\n    sea i = 0\n    mientras (i <= longitud(s)) {\n        sea m = re_buscar_desde(prog, s, i)\n        si (m == nulo) { romper }\n        r.agregar(m)\n        si (m[1] > m[0]) { i = m[1] } sino { i = m[0] + 1 }\n    }\n    retornar r\n}\n\nfuncion cfv_regex_coincidir(patron, texto) {\n    retornar re_buscar_desde(re_compilar(patron), texto, 0) != nulo\n}\n\nfuncion cfv_regex_buscar(patron, texto) {\n    sea m = re_buscar_desde(re_compilar(patron), texto, 0)\n    si (m == nulo) { retornar nulo }\n    retornar subtexto(texto, m[0], m[1])\n}\n\nfuncion cfv_regex_buscar_todos(patron, texto) {\n    sea r = []\n    para m en re_todas(re_compilar(patron), texto) { r.agregar(subtexto(texto, m[0], m[1])) }\n    retornar r\n}\n\nfuncion cfv_regex_reemplazar(patron, texto, reemplazo) {\n    sea r = \"\"\n    sea ultimo = 0\n    para m en re_todas(re_compilar(patron), texto) {\n        r = r + subtexto(texto, ultimo, m[0]) + reemplazo\n        ultimo = m[1]\n    }\n    retornar r + subtexto(texto, ultimo, longitud(texto))\n}\n\nfuncion cfv_regex_dividir(patron, texto) {\n    sea r = []\n    sea ultimo = 0\n    para m en re_todas(re_compilar(patron), texto) {\n        si (m[1] > m[0]) {\n            r.agregar(subtexto(texto, ultimo, m[0]))\n            ultimo = m[1]\n        }\n    }\n    r.agregar(subtexto(texto, ultimo, longitud(texto)))\n    retornar r\n}\n\n// ── Ordenamiento (mergesort estable) ──────────────────────────────────────\n// comparar(a, b) < 0 si a va antes que b; sin función se usa el orden natural.\n\nfuncion ordenar(lista, comparar) {\n    si (comparar == nulo) { retornar dyn_ordenar_natural(lista) }\n    // Con función: mergesort estable de abajo arriba sobre dos listas.\n    sea n = longitud(lista)\n    sea a = []\n    para v en lista { a.agregar(v) }\n    si (n < 2) { retornar a }\n    sea b = lista_repetir(nulo, n)\n    sea ancho = 1\n    mientras (ancho < n) {\n        sea inicio = 0\n        mientras (inicio < n) {\n            sea medio = inicio + ancho\n            sea fin = inicio + 2 * ancho\n            si (medio > n) { medio = n }\n            si (fin > n) { fin = n }\n            sea i = inicio\n            sea j = medio\n            sea k = inicio\n            mientras (i < medio y j < fin) {\n                si (comparar(a[i], a[j]) <= 0) {\n                    b[k] = a[i]\n                    i += 1\n                } sino {\n                    b[k] = a[j]\n                    j += 1\n                }\n                k += 1\n            }\n            mientras (i < medio) {\n                b[k] = a[i]\n                i += 1\n                k += 1\n            }\n            mientras (j < fin) {\n                b[k] = a[j]\n                j += 1\n                k += 1\n            }\n            inicio = fin\n        }\n        sea t = a\n        a = b\n        b = t\n        ancho = ancho * 2\n    }\n    retornar a\n}\n\nfuncion lista_ordenar(lista) { retornar ordenar(lista, nulo) }\n\nfuncion lista_aplanar(lista) {\n    sea r = []\n    para x en lista {\n        si (tipo_de(x) == \"lista\") {\n            para y en lista_aplanar(x) { r.agregar(y) }\n        } sino {\n            r.agregar(x)\n        }\n    }\n    retornar r\n}\n\nfuncion para_cada(lista, f) {\n    para x en lista { f(x) }\n}\n\n// rango(fin) · rango(inicio, fin) · rango(inicio, fin, paso)\nfuncion rango(a, b, paso) {\n    si (b == nulo) {\n        b = a\n        a = 0\n    }\n    si (paso == nulo) { paso = 1 }\n    si (paso == 0) { lanzar \"rango: el paso no puede ser 0\" }\n    si ((b - a) / paso > 268435456) { lanzar \"rango: demasiados elementos (máximo 268435456)\" }\n    sea r = []\n    sea i = a\n    si (paso > 0) {\n        mientras (i < b) {\n            r.agregar(i)\n            i += paso\n        }\n    } sino {\n        mientras (i > b) {\n            r.agregar(i)\n            i += paso\n        }\n    }\n    retornar r\n}\n\n// ── Nombres de la biblioteca de 3.x ───────────────────────────────────────\n\nfuncion eliminar_clave(m, clave) { retornar quitar_clave(m, clave) }\nfuncion reloj_ms() { retornar tiempo_ms() }\nfuncion tiempo_segundos() { retornar piso(tiempo_ms() / 1000) }\nfuncion tipo(v) { retornar tipo_de(v) }\nfuncion separar(t, separador) { retornar texto_dividir(t, separador) }\nfuncion unir(lista, separador) { retornar texto_unir(lista, separador) }\nfuncion lista_unir(lista, separador) { retornar texto_unir(lista, separador) }\nfuncion texto_buscar(t, buscado) { retornar texto_indice(t, buscado) }\nfuncion lista_filtrar(lista, f) { retornar filtrar(lista, f) }\nfuncion lista_mapear(lista, f) { retornar mapear(lista, f) }\n\nfuncion texto_subcadena(t, inicio, fin) {\n    si (fin == nulo) { fin = longitud(t) }\n    retornar subtexto(t, inicio, fin)\n}\n\n// Elementos [inicio, fin) de una lista, como lista nueva.\nfuncion subarray(lista, inicio, fin) {\n    si (fin == nulo o fin > longitud(lista)) { fin = longitud(lista) }\n    si (inicio < 0) { inicio = 0 }\n    sea r = []\n    sea i = inicio\n    mientras (i < fin) {\n        r.agregar(lista[i])\n        i += 1\n    }\n    retornar r\n}\n\nfuncion lista_repetir(v, n) {\n    si (n > 268435456) { lanzar \"lista_repetir: demasiados elementos (máximo 268435456)\" }\n    sea r = []\n    sea i = 0\n    mientras (i < n) {\n        r.agregar(v)\n        i += 1\n    }\n    retornar r\n}\n\n// Número uniforme en [minimo, maximo).\nfuncion cfv_aleatorio_uniforme(minimo_v, maximo_v) {\n    si (minimo_v >= maximo_v) { lanzar \"aleatorio_uniforme: min debe ser < max\" }\n    retornar minimo_v + aleatorio() * (maximo_v - minimo_v)\n}\nfuncion aleatorio_uniforme(minimo_v, maximo_v) { retornar cfv_aleatorio_uniforme(minimo_v, maximo_v) }\n\n// ── Cliente HTTP/1.1 (HTTPS llega con la capa TLS) ────────────────────────\n\nfuncion http_partir_url(url) {\n    sea seguro = falso\n    sea resto = url\n    si (texto_empieza_con(url, \"https://\")) {\n        seguro = verdadero\n        resto = subtexto(url, 8, longitud(url))\n    } sino si (texto_empieza_con(url, \"http://\")) {\n        resto = subtexto(url, 7, longitud(url))\n    }\n    sea barra = texto_indice(resto, \"/\")\n    sea anfitrion = resto\n    sea ruta = \"/\"\n    si (barra >= 0) {\n        anfitrion = subtexto(resto, 0, barra)\n        ruta = subtexto(resto, barra, longitud(resto))\n    }\n    sea puerto = 80\n    si (seguro) { puerto = 443 }\n    sea dos_puntos = texto_indice(anfitrion, \":\")\n    si (dos_puntos >= 0) {\n        puerto = a_numero(subtexto(anfitrion, dos_puntos + 1, longitud(anfitrion)))\n        anfitrion = subtexto(anfitrion, 0, dos_puntos)\n    }\n    retornar {\"seguro\": seguro, \"anfitrion\": anfitrion, \"puerto\": puerto, \"ruta\": ruta}\n}\n\nfuncion http_hex_a_numero(t) {\n    sea n = 0\n    para c en texto_minusculas(texto_recortar(t)) {\n        sea d = texto_indice(\"0123456789abcdef\", c)\n        si (d < 0) { romper }\n        n = n * 16 + d\n    }\n    retornar n\n}\n\nfuncion http_quitar_chunked(cuerpo) {\n    sea r = []\n    sea i = 0\n    mientras (i < longitud(cuerpo)) {\n        sea fin = texto_indice(subtexto(cuerpo, i, longitud(cuerpo)), \"\\r\\n\")\n        si (fin < 0) { romper }\n        sea n = http_hex_a_numero(subtexto(cuerpo, i, i + fin))\n        si (n == 0) { romper }\n        sea inicio = i + fin + 2\n        r.agregar(subtexto(cuerpo, inicio, minimo(inicio + n, longitud(cuerpo))))\n        i = inicio + n + 2\n    }\n    retornar texto_unir(r, \"\")\n}\n\nfuncion http_conexion(partes) {\n    sea sock = net_conectar(partes[\"anfitrion\"], partes[\"puerto\"])\n    si (partes[\"seguro\"]) {\n        sea t = tls_abrir(sock, partes[\"anfitrion\"])\n        retornar {\"enviar\": funcion(d) { retornar tls_enviar(t, d) }, \"todo\": funcion() { retornar tls_recibir_todo(t) }, \"cerrar\": funcion() { retornar tls_cerrar(t) }}\n    }\n    retornar {\"enviar\": funcion(d) { retornar net_enviar(sock, d) }, \"todo\": funcion() { retornar net_recibir_todo(sock) }, \"cerrar\": funcion() { retornar net_cerrar(sock) }}\n}\n\n// Un salto de línea en el método, la ruta o una cabecera inyectaría\n// cabeceras o un segundo pedido: se rechaza.\nfuncion http_sin_saltos(t, que) {\n    sea s = \"\" + t\n    si (texto_contiene(s, \"\\r\") o texto_contiene(s, \"\\n\") o texto_contiene(s, caracter(0))) { lanzar \"http_solicitud: \" + que + \" con saltos de línea\" }\n    retornar s\n}\n\n// opciones: {\"cuerpo\", \"tipo\", \"cabeceras\": mapa, \"redirecciones\": n}\n// → {\"estado\", \"cuerpo\", \"cabeceras\" (mapa en minúsculas), \"cabeceras_texto\"}\nfuncion http_solicitud(metodo, url, opciones) {\n    si (opciones == nulo) { opciones = {} }\n    sea saltos = 5\n    si (tiene_clave(opciones, \"redirecciones\")) { saltos = opciones[\"redirecciones\"] }\n    sea actual = url\n    mientras (verdadero) {\n        sea partes = http_partir_url(actual)\n        sea cuerpo = \"\"\n        si (tiene_clave(opciones, \"cuerpo\") y opciones[\"cuerpo\"] != nulo) { cuerpo = a_texto(opciones[\"cuerpo\"]) }\n        sea anfitrion = partes[\"anfitrion\"]\n        si ((partes[\"seguro\"] y partes[\"puerto\"] != 443) o (no partes[\"seguro\"] y partes[\"puerto\"] != 80)) {\n            anfitrion = anfitrion + \":\" + partes[\"puerto\"]\n        }\n        http_sin_saltos(metodo, \"método\")\n        si (texto_contiene(metodo, \" \")) { lanzar \"http_solicitud: método inválido\" }\n        http_sin_saltos(partes[\"ruta\"], \"ruta\")\n        http_sin_saltos(anfitrion, \"anfitrión\")\n        sea ruta_p = texto_reemplazar(partes[\"ruta\"], \" \", \"%20\")\n        sea pedido = metodo + \" \" + ruta_p + \" HTTP/1.1\\r\\nHost: \" + anfitrion + \"\\r\\nConnection: close\\r\\nUser-Agent: C-Forge/4.1\\r\\nAccept-Encoding: identity\\r\\n\"\n        si (tiene_clave(opciones, \"tipo\") y opciones[\"tipo\"] != nulo) { pedido = pedido + \"Content-Type: \" + http_sin_saltos(opciones[\"tipo\"], \"tipo\") + \"\\r\\n\" }\n        si (longitud(cuerpo) > 0 o metodo == \"POST\" o metodo == \"PUT\" o metodo == \"PATCH\") {\n            pedido = pedido + \"Content-Length: \" + longitud(cuerpo) + \"\\r\\n\"\n        }\n        si (tiene_clave(opciones, \"cabeceras\") y opciones[\"cabeceras\"] != nulo) {\n            para k en claves(opciones[\"cabeceras\"]) {\n                si (texto_contiene(k, \":\") o longitud(k) == 0) { lanzar \"http_solicitud: nombre de cabecera inválido: \" + k }\n                pedido = pedido + http_sin_saltos(k, \"cabecera\") + \": \" + http_sin_saltos(opciones[\"cabeceras\"][k], \"cabecera \" + k) + \"\\r\\n\"\n            }\n        }\n        pedido = pedido + \"\\r\\n\" + cuerpo\n        sea con = http_conexion(partes)\n        con[\"enviar\"](pedido)\n        sea crudo = con[\"todo\"]()\n        con[\"cerrar\"]()\n        sea fin = texto_indice(crudo, \"\\r\\n\\r\\n\")\n        sea texto_cab = crudo\n        sea resto = \"\"\n        si (fin >= 0) {\n            texto_cab = subtexto(crudo, 0, fin)\n            resto = subtexto(crudo, fin + 4, longitud(crudo))\n        }\n        sea lineas = texto_dividir(texto_cab, \"\\r\\n\")\n        sea estado = 0\n        sea primera = texto_dividir(lineas[0], \" \")\n        si (longitud(primera) >= 2) { estado = a_numero(primera[1]) }\n        sea cab = {}\n        sea i = 1\n        mientras (i < longitud(lineas)) {\n            sea p = texto_indice(lineas[i], \":\")\n            si (p > 0) { cab[texto_minusculas(texto_recortar(subtexto(lineas[i], 0, p)))] = texto_recortar(subtexto(lineas[i], p + 1, longitud(lineas[i]))) }\n            i += 1\n        }\n        si (tiene_clave(cab, \"transfer-encoding\") y texto_contiene(texto_minusculas(cab[\"transfer-encoding\"]), \"chunked\")) {\n            resto = http_quitar_chunked(resto)\n        } sino si (tiene_clave(cab, \"content-length\")) {\n            sea largo = a_numero(cab[\"content-length\"])\n            si (largo < longitud(resto)) { resto = subtexto(resto, 0, largo) }\n        }\n        si (estado >= 300 y estado < 400 y tiene_clave(cab, \"location\") y saltos > 0) {\n            sea destino = cab[\"location\"]\n            si (texto_empieza_con(destino, \"/\")) {\n                sea esquema = \"http://\"\n                si (partes[\"seguro\"]) { esquema = \"https://\" }\n                destino = esquema + anfitrion + destino\n            }\n            actual = destino\n            saltos -= 1\n            si (estado == 303) { metodo = \"GET\" }\n        } sino {\n            retornar {\"estado\": estado, \"cuerpo\": resto, \"cabeceras\": cab, \"cabeceras_texto\": texto_cab}\n        }\n    }\n}\n\nfuncion http_get(url) { retornar http_solicitud(\"GET\", url, {})[\"cuerpo\"] }\nfuncion http_post(url, cuerpo, tipo) {\n    si (tipo == nulo) { tipo = \"application/json\" }\n    retornar http_solicitud(\"POST\", url, {\"cuerpo\": cuerpo, \"tipo\": tipo})[\"cuerpo\"]\n}\nfuncion http_put(url, cuerpo) { retornar http_solicitud(\"PUT\", url, {\"cuerpo\": cuerpo, \"tipo\": \"application/json\"})[\"cuerpo\"] }\nfuncion http_delete(url) { retornar http_solicitud(\"DELETE\", url, {})[\"cuerpo\"] }\n\n// cforge repl: muestra el valor de una expresión (salvo nulo).\n// comptime { … } dentro de código que ya se ejecuta al compilar.\nfuncion comptime_ejecutar(f) { retornar f() }\n\nfuncion repl_valor(v) {\n    si (v != nulo) { mostrar(v) }\n}\n\n// ── Resultado<T, E> y Opcion<T> de primera clase ──────────────────────────\n// Ok(v) / Error(e) y Alguno(v) / Ninguno: funcionan con el operador ? (un\n// Error o un Ninguno se retorna de la función) y con coincidir.\nfuncion Ok(v) { retornar {\"ok\": verdadero, \"valor\": v, \"error\": nulo} }\nfuncion Error(e) { retornar {\"ok\": falso, \"valor\": nulo, \"error\": e} }\nfuncion Alguno(v) { retornar {\"presente\": verdadero, \"valor\": v} }\nfuncion Ninguno() { retornar {\"presente\": falso, \"valor\": nulo} }\n\n// await / aguardar: espera una tarea (de una async funcion o de tarea(f)) y\n// entrega su resultado; si falló, relanza su error. Otro valor pasa tal cual.\nfuncion aguardar(v) {\n    si (tipo_de(v) == \"mapa\" y tiene_clave(v, \"__tarea\")) { retornar esperar(v) }\n    retornar v\n}\n\n" }
    si (i == 19) { retornar "// runtime/sdl.cfv — gráficos con SDL2, escritos en C-Forge sobre extern.\n//\n// Mismas funciones que el intérprete (sdl_init, sdl_ventana, sdl_renderer,\n// sdl_color, sdl_rect, …). SDL2 se carga con dlopen al primer uso; cforge\n// incluye este módulo solo si el programa usa funciones sdl_.\n\n// Las declaraciones se registran al compilar y cada función se resuelve\n// (dlopen + dlsym) la primera vez que se llama.\nfuncion __sdl_declaraciones() {\n    extern \"SDL2\" funcion SDL_Init(banderas: entero): entero\n    extern \"SDL2\" funcion SDL_CreateWindow(titulo: texto, x: entero, y: entero, ancho: entero, alto: entero, banderas: entero): puntero\n    extern \"SDL2\" funcion SDL_CreateRenderer(ventana: puntero, indice: entero, banderas: entero): puntero\n    extern \"SDL2\" funcion SDL_SetRenderDrawColor(ren: puntero, r: entero, g: entero, b: entero, a: entero): entero\n    extern \"SDL2\" funcion SDL_RenderClear(ren: puntero): entero\n    extern \"SDL2\" funcion SDL_RenderPresent(ren: puntero): nulo\n    extern \"SDL2\" funcion SDL_RenderFillRect(ren: puntero, rect: puntero): entero\n    extern \"SDL2\" funcion SDL_RenderDrawRect(ren: puntero, rect: puntero): entero\n    extern \"SDL2\" funcion SDL_RenderDrawLine(ren: puntero, x1: entero, y1: entero, x2: entero, y2: entero): entero\n    extern \"SDL2\" funcion SDL_RenderDrawPoint(ren: puntero, x: entero, y: entero): entero\n    extern \"SDL2\" funcion SDL_PollEvent(evento: puntero): entero\n    extern \"SDL2\" funcion SDL_GetTicks(): entero\n    extern \"SDL2\" funcion SDL_Delay(ms: entero): nulo\n    extern \"SDL2\" funcion SDL_SetWindowTitle(ventana: puntero, titulo: texto): nulo\n    extern \"SDL2\" funcion SDL_DestroyRenderer(ren: puntero): nulo\n    extern \"SDL2\" funcion SDL_DestroyWindow(ventana: puntero): nulo\n    extern \"SDL2\" funcion SDL_Quit(): nulo\n    extern \"SDL2_ttf\" funcion TTF_RenderUTF8_Blended(fuente: puntero, texto: texto, color: entero): puntero\n    extern \"SDL2\" funcion SDL_CreateTextureFromSurface(ren: puntero, superficie: puntero): puntero\n    extern \"SDL2\" funcion SDL_FreeSurface(superficie: puntero): nulo\n    extern \"SDL2\" funcion SDL_QueryTexture(textura: puntero, formato: puntero, acceso: puntero, ancho: puntero, alto: puntero): entero\n    extern \"SDL2\" funcion SDL_RenderCopy(ren: puntero, textura: puntero, origen: puntero, destino: puntero): entero\n    extern \"SDL2\" funcion SDL_DestroyTexture(textura: puntero): nulo\n}\n\n// Estado creado al primer uso (el módulo se agrega después del programa).\nsea __sdl = nulo\n\nfuncion __sdl_estado() {\n    si (__sdl == nulo) { __sdl = {\"ventanas\": [], \"renderers\": [], \"fuentes\": [], \"rect\": nulo, \"evento\": nulo, \"ttf\": nulo} }\n    retornar __sdl\n}\n\nfuncion __sdl_rect(x, y, ancho, alto) {\n    sea estado = __sdl_estado()\n    si (estado[\"rect\"] == nulo) { estado[\"rect\"] = c_reservar(16) }\n    sea r = __sdl_estado()[\"rect\"]\n    c_escribir32(r, 0, piso(x))\n    c_escribir32(r, 4, piso(y))\n    c_escribir32(r, 8, piso(ancho))\n    c_escribir32(r, 12, piso(alto))\n    retornar r\n}\n\nfuncion sdl_disponible() {\n    intentar {\n        SDL_GetTicks()\n        retornar verdadero\n    } capturar (e) {\n        retornar falso\n    }\n}\n\nfuncion sdl_init(banderas) {\n    intentar {\n        SDL_GetTicks()\n    } capturar (e) {\n        lanzar \"sdl_init: SDL2 no encontrado. Instala libSDL2.\"\n    }\n    si (banderas == nulo) { banderas = 48 }                    // VIDEO | AUDIO\n    si (SDL_Init(banderas) != 0) { lanzar \"sdl_init: fallo al inicializar SDL2\" }\n    retornar verdadero\n}\n\nfuncion sdl_iniciar(banderas) { retornar sdl_init(banderas) }\n\nfuncion sdl_ventana(titulo, ancho, alto, banderas) {\n    si (tipo_de(titulo) != \"texto\") { titulo = \"C-Forge\" }\n    si (ancho == nulo) { ancho = 800 }\n    si (alto == nulo) { alto = 600 }\n    si (banderas == nulo) { banderas = 4 }                     // SHOWN\n    sea v = SDL_CreateWindow(titulo, 536805376, 536805376, piso(ancho), piso(alto), banderas)\n    si (v == 0) { lanzar \"sdl_ventana: no se pudo crear la ventana\" }\n    __sdl_estado()[\"ventanas\"].agregar(v)\n    retornar v\n}\n\nfuncion sdl_renderer(ventana) {\n    sea r = SDL_CreateRenderer(ventana, -1, 6)                 // ACCELERATED | PRESENTVSYNC\n    si (r == 0) { r = SDL_CreateRenderer(ventana, -1, 0) }\n    si (r == 0) { lanzar \"sdl_renderer: no se pudo crear renderer\" }\n    __sdl_estado()[\"renderers\"].agregar(r)\n    retornar r\n}\n\nfuncion sdl_color(ren, r, g, b, a) {\n    SDL_SetRenderDrawColor(ren, piso(r ?? 255), piso(g ?? 255), piso(b ?? 255), piso(a ?? 255))\n}\n\nfuncion sdl_limpiar(ren) { SDL_RenderClear(ren) }\nfuncion sdl_presentar(ren) { SDL_RenderPresent(ren) }\nfuncion sdl_mostrar(ren) { SDL_RenderPresent(ren) }\n\nfuncion sdl_rect(ren, x, y, ancho, alto, relleno) {\n    sea r = __sdl_rect(x, y, ancho, alto)\n    si (relleno == falso) { SDL_RenderDrawRect(ren, r) } sino { SDL_RenderFillRect(ren, r) }\n}\n\nfuncion sdl_dibujar_rect(ren, x, y, ancho, alto, relleno) { sdl_rect(ren, x, y, ancho, alto, relleno) }\nfuncion sdl_linea(ren, x1, y1, x2, y2) { SDL_RenderDrawLine(ren, piso(x1), piso(y1), piso(x2), piso(y2)) }\nfuncion sdl_dibujar_linea(ren, x1, y1, x2, y2) { sdl_linea(ren, x1, y1, x2, y2) }\nfuncion sdl_dibujar_pixel(ren, x, y) { SDL_RenderDrawPoint(ren, piso(x), piso(y)) }\n\nfuncion sdl_dibujar_circulo(ren, cx, cy, radio) {\n    sea x = radio\n    sea y = 0\n    sea error = 0\n    mientras (x >= y) {\n        para p en [[x, y], [y, x], [-y, x], [-x, y], [-x, -y], [-y, -x], [y, -x], [x, -y]] {\n            SDL_RenderDrawPoint(ren, piso(cx + p[0]), piso(cy + p[1]))\n        }\n        y += 1\n        error += 1 + 2 * y\n        si (2 * (error - x) + 1 > 0) {\n            x -= 1\n            error += 1 - 2 * x\n        }\n    }\n}\n\n// Lista de eventos: mapas {tipo, tecla, presionada, x, y, boton, salir}.\nfuncion sdl_eventos() {\n    sea estado = __sdl_estado()\n    si (estado[\"evento\"] == nulo) { estado[\"evento\"] = c_reservar(64) }\n    sea e = estado[\"evento\"]\n    sea lista = []\n    mientras (SDL_PollEvent(e) != 0) {\n        sea tipo = c_leer32(e, 0)\n        sea ev = {\"tipo\": tipo}\n        si (tipo == 768 o tipo == 769) {\n            ev[\"tecla\"] = c_leer32(e, 16)\n            ev[\"presionada\"] = tipo == 768\n        } sino si (tipo == 1024 o tipo == 1025 o tipo == 1026) {\n            ev[\"x\"] = c_leer32(e, 20)\n            ev[\"y\"] = c_leer32(e, 24)\n            si (tipo == 1025) { ev[\"boton\"] = c_leer8(e, 16) }\n        } sino si (tipo == 256) {\n            ev[\"salir\"] = verdadero\n        }\n        lista.agregar(ev)\n    }\n    retornar lista\n}\n\nfuncion sdl_ticks() { retornar SDL_GetTicks() }\nfuncion sdl_tiempo() { retornar SDL_GetTicks() }\nfuncion sdl_esperar(ms) { SDL_Delay(piso(ms ?? 16)) }\nfuncion sdl_delay(ms) { sdl_esperar(ms) }\nfuncion sdl_titulo(ventana, titulo) { SDL_SetWindowTitle(ventana, titulo) }\n\nfuncion sdl_cerrar() {\n    para r en __sdl_estado()[\"renderers\"] { SDL_DestroyRenderer(r) }\n    para v en __sdl_estado()[\"ventanas\"] { SDL_DestroyWindow(v) }\n    sea estado = __sdl_estado()\n    estado[\"renderers\"] = []\n    estado[\"ventanas\"] = []\n    SDL_Quit()\n}\n\n// Texto con SDL2_ttf (opcional, como en el intérprete).\nfuncion sdl_cargar_fuente(ruta, tam) {\n    intentar {\n        extern \"SDL2_ttf\" funcion TTF_Init(): entero\n        extern \"SDL2_ttf\" funcion TTF_OpenFont(ruta: texto, tam: entero): puntero\n    } capturar (e) {\n        lanzar \"sdl_cargar_fuente: SDL2_ttf no disponible\"\n    }\n    sea estado = __sdl_estado()\n    si (estado[\"ttf\"] == nulo) {\n        TTF_Init()\n        estado[\"ttf\"] = verdadero\n    }\n    sea f = TTF_OpenFont(ruta, piso(tam ?? 16))\n    si (f == 0) { lanzar \"sdl_cargar_fuente: no se pudo abrir '\" + ruta + \"'\" }\n    estado[\"fuentes\"].agregar(f)\n    retornar f\n}\n\nfuncion sdl_texto(ren, fuente, txt, x, y, r, g, b) {\n    // Sin fuente (SDL2_ttf ausente o no cargada) no se dibuja, como en el intérprete.\n    si (no lista_contiene(__sdl_estado()[\"fuentes\"], fuente)) { retornar nulo }\n    sea color = piso(r ?? 255) + piso(g ?? 255) * 256 + piso(b ?? 255) * 65536 + 255 * 16777216\n    sea s = TTF_RenderUTF8_Blended(fuente, a_texto(txt), color)\n    si (s == 0) { retornar nulo }\n    sea t = SDL_CreateTextureFromSurface(ren, s)\n    SDL_FreeSurface(s)\n    sea medidas = c_reservar(8)\n    SDL_QueryTexture(t, 0, 0, medidas, medidas + 4)\n    SDL_RenderCopy(ren, t, 0, __sdl_rect(x, y, c_leer32(medidas, 0), c_leer32(medidas, 4)))\n    c_liberar(medidas)\n    SDL_DestroyTexture(t)\n}\n\n// Texturas con SDL2_image (opcional, como en el intérprete).\nfuncion sdl_cargar_textura(ren, ruta) {\n    intentar {\n        extern \"SDL2_image\" funcion IMG_LoadTexture(ren: puntero, ruta: texto): puntero\n    } capturar (e) {\n        lanzar \"sdl_cargar_textura: no se pudo cargar '\" + ruta + \"'. Instala libSDL2-image.\"\n    }\n    sea t = IMG_LoadTexture(ren, ruta)\n    si (t == 0) { lanzar \"sdl_cargar_textura: no se pudo cargar '\" + ruta + \"'. Instala libSDL2-image.\" }\n    retornar t\n}\n\nfuncion sdl_dibujar_textura(ren, textura, x, y, ancho, alto, angulo) {\n    SDL_RenderCopy(ren, textura, 0, __sdl_rect(x, y, ancho, alto))\n}\n\nfuncion sdl_destruir_textura(textura) {\n    SDL_DestroyTexture(textura)\n}\n" }
    si (i == 20) { retornar "// runtime/gl3d.cfv — OpenGL 3.3 core sobre SDL2, escrito en C-Forge.\n//\n// Mismas funciones que el intérprete de 3.x (gl3d_iniciar, gl3d_vbo,\n// gl3d_shader, …). cforge incluye este módulo solo si el programa usa\n// funciones gl3d_. Las funciones de OpenGL se obtienen con\n// SDL_GL_GetProcAddress (Linux, macOS y Windows, donde opengl32.dll solo\n// exporta GL 1.1) y se llaman con c_llamar; los float van por puntero\n// (glClearBufferfv, glUniform*fv) porque las llamadas C son enteras.\n\nfuncion __gl3d_declaraciones() {\n    extern \"SDL2\" funcion SDL_GL_SetAttribute(atributo: entero, valor: entero): entero\n    extern \"SDL2\" funcion SDL_GL_CreateContext(ventana: puntero): puntero\n    extern \"SDL2\" funcion SDL_GL_DeleteContext(contexto: puntero): nulo\n    extern \"SDL2\" funcion SDL_GL_GetProcAddress(nombre: texto): puntero\n    extern \"SDL2\" funcion SDL_GL_SetSwapInterval(intervalo: entero): entero\n    extern \"SDL2\" funcion SDL_GL_SwapWindow(ventana: puntero): nulo\n    extern \"SDL2\" funcion SDL_GL_GetDrawableSize(ventana: puntero, ancho: puntero, alto: puntero): nulo\n    extern \"SDL2\" funcion SDL_GetWindowSize(ventana: puntero, ancho: puntero, alto: puntero): nulo\n    extern \"SDL2\" funcion SDL_GetError(): puntero\n    extern \"SDL2\" funcion SDL_InitSubSystem(banderas: entero): entero\n    extern \"SDL2\" funcion SDL_CreateWindow(titulo: texto, x: entero, y: entero, ancho: entero, alto: entero, banderas: entero): puntero\n}\n\nsea __gl3d = nulo\n\nfuncion __gl3d_estado() {\n    si (__gl3d == nulo) { __gl3d = {\"funciones\": {}, \"tmp\": c_reservar(64)} }\n    retornar __gl3d\n}\n\n// Puntero a la función de OpenGL (con caché).\nfuncion __gl(nombre) {\n    sea f = __gl3d_estado()[\"funciones\"]\n    si (tiene_clave(f, nombre)) { retornar f[nombre] }\n    sea p = SDL_GL_GetProcAddress(nombre)\n    si (p == 0) { lanzar \"gl3d: OpenGL no ofrece \" + nombre + \" (¿contexto 3.3 creado con gl3d_iniciar?)\" }\n    f[nombre] = p\n    retornar p\n}\n\n// Ventana SDL lista para OpenGL 3.3 core (atributos antes de crearla).\nfuncion gl3d_ventana(titulo, ancho, alto) {\n    si (SDL_InitSubSystem(32) != 0) { lanzar \"gl3d_ventana: \" + c_texto(SDL_GetError()) }   // VIDEO\n    SDL_GL_SetAttribute(17, 3)                                 // CONTEXT_MAJOR_VERSION\n    SDL_GL_SetAttribute(18, 3)                                 // CONTEXT_MINOR_VERSION\n    SDL_GL_SetAttribute(21, 1)                                 // PROFILE_MASK: CORE\n    SDL_GL_SetAttribute(20, 2)                                 // CONTEXT_FLAGS: FORWARD_COMPATIBLE (macOS)\n    SDL_GL_SetAttribute(5, 1)                                  // DOUBLEBUFFER\n    SDL_GL_SetAttribute(6, 24)                                 // DEPTH_SIZE\n    si (tipo_de(titulo) != \"texto\") { titulo = \"C-Forge 3D\" }\n    sea v = SDL_CreateWindow(titulo, 536805376, 536805376, piso(ancho ?? 800), piso(alto ?? 600), 8198)   // OPENGL | SHOWN | ALLOW_HIGHDPI\n    si (v == 0) { lanzar \"gl3d_ventana: \" + c_texto(SDL_GetError()) }\n    retornar v\n}\n\nfuncion gl3d_iniciar(ventana) {\n    sea ctx = SDL_GL_CreateContext(ventana)\n    si (ctx == 0) { lanzar \"gl3d_iniciar: \" + c_texto(SDL_GetError()) }\n    SDL_GL_SetSwapInterval(1)\n    retornar ctx\n}\n\nfuncion gl3d_cerrar(ctx) { SDL_GL_DeleteContext(ctx) }\nfuncion gl3d_intercambiar(ventana) { SDL_GL_SwapWindow(ventana) }\n\nfuncion __gl3d_tamano(ventana, dibujable) {\n    sea t = __gl3d_estado()[\"tmp\"]\n    si (dibujable) { SDL_GL_GetDrawableSize(ventana, t, t + 4) } sino { SDL_GetWindowSize(ventana, t, t + 4) }\n    retornar {\"ancho\": c_leer32(t, 0), \"alto\": c_leer32(t, 4)}\n}\n\nfuncion sdl_tamanio_ventana(ventana) { retornar __gl3d_tamano(ventana, falso) }\nfuncion gl3d_tamanio_dibujable(ventana) { retornar __gl3d_tamano(ventana, verdadero) }\n\nfuncion gl3d_viewport(x, y, ancho, alto) { c_llamar(__gl(\"glViewport\"), piso(x), piso(y), piso(ancho), piso(alto)) }\n\nfuncion gl3d_profundidad(activa) {\n    si (activa) {\n        c_llamar(__gl(\"glEnable\"), 2929)                       // GL_DEPTH_TEST\n        c_llamar(__gl(\"glDepthFunc\"), 513)                     // GL_LESS\n    } sino {\n        c_llamar(__gl(\"glDisable\"), 2929)\n    }\n}\n\n// Color 0..255 (como en 3.x) y profundidad a 1.\nfuncion gl3d_limpiar(r, g, b, a) {\n    sea t = __gl3d_estado()[\"tmp\"]\n    c_escribir_f32(t, 0, (r ?? 0) / 255)\n    c_escribir_f32(t, 4, (g ?? 0) / 255)\n    c_escribir_f32(t, 8, (b ?? 0) / 255)\n    c_escribir_f32(t, 12, (a ?? 255) / 255)\n    c_escribir_f32(t, 16, 1)\n    c_llamar(__gl(\"glClearBufferfv\"), 6144, 0, t)              // GL_COLOR\n    c_llamar(__gl(\"glClearBufferfv\"), 6145, 0, t + 16)         // GL_DEPTH\n}\n\n// VAO + VBO con los vértices (float); devuelve vao·2^32 + vbo.\nfuncion gl3d_vbo(datos) {\n    sea n = longitud(datos)\n    sea buf = c_reservar(n * 4 + 4)\n    sea i = 0\n    mientras (i < n) {\n        c_escribir_f32(buf, i * 4, datos[i])\n        i += 1\n    }\n    sea t = __gl3d_estado()[\"tmp\"]\n    c_llamar(__gl(\"glGenVertexArrays\"), 1, t)\n    c_llamar(__gl(\"glGenBuffers\"), 1, t + 4)\n    sea vao = c_leer32(t, 0)\n    sea vbo = c_leer32(t, 4)\n    c_llamar(__gl(\"glBindVertexArray\"), vao)\n    c_llamar(__gl(\"glBindBuffer\"), 34962, vbo)                 // GL_ARRAY_BUFFER\n    c_llamar(__gl(\"glBufferData\"), 34962, n * 4, buf, 35044)   // GL_STATIC_DRAW\n    c_liberar(buf)\n    retornar vao * 4294967296 + vbo\n}\n\nfuncion __gl3d_vao(id) { retornar piso(id / 4294967296) }\nfuncion __gl3d_vbo_de(id) { retornar id - __gl3d_vao(id) * 4294967296 }\n\n// Atributo idx: tam floats por vértice, stride y desplazamiento en floats.\nfuncion gl3d_atributo(id, idx, tam, stride, desplazamiento) {\n    c_llamar(__gl(\"glBindVertexArray\"), __gl3d_vao(id))\n    c_llamar(__gl(\"glBindBuffer\"), 34962, __gl3d_vbo_de(id))\n    c_llamar(__gl(\"glVertexAttribPointer\"), idx, tam, 5126, 0, stride * 4, desplazamiento * 4)   // GL_FLOAT\n    c_llamar(__gl(\"glEnableVertexAttribArray\"), idx)\n}\n\nfuncion gl3d_dibujar(id, vertices, modo) {\n    sea m = 4                                                  // GL_TRIANGLES\n    si (modo == \"lineas\") { m = 1 }\n    si (modo == \"puntos\") { m = 0 }\n    si (modo == \"tiras\") { m = 5 }\n    si (modo == \"abanico\") { m = 6 }\n    c_llamar(__gl(\"glBindVertexArray\"), __gl3d_vao(id))\n    c_llamar(__gl(\"glDrawArrays\"), m, 0, piso(vertices))\n}\n\nfuncion __gl3d_registro(objeto, es_programa) {\n    sea buf = c_reservar(1024)\n    si (es_programa) {\n        c_llamar(__gl(\"glGetProgramInfoLog\"), objeto, 1024, 0, buf)\n    } sino {\n        c_llamar(__gl(\"glGetShaderInfoLog\"), objeto, 1024, 0, buf)\n    }\n    sea t = c_texto(buf)\n    c_liberar(buf)\n    retornar t\n}\n\nfuncion gl3d_shader(tipo, codigo) {\n    sea gl_tipo = 35632                                        // GL_FRAGMENT_SHADER\n    si (tipo == \"vertex\" o tipo == \"vertice\" o tipo == \"vértice\") { gl_tipo = 35633 }\n    sea s = c_i32(c_llamar(__gl(\"glCreateShader\"), gl_tipo))\n    sea fuente = c_cadena(codigo)\n    sea t = __gl3d_estado()[\"tmp\"]\n    c_escribir64(t, 0, fuente)\n    c_llamar(__gl(\"glShaderSource\"), s, 1, t, 0)\n    c_llamar(__gl(\"glCompileShader\"), s)\n    c_liberar(fuente)\n    c_llamar(__gl(\"glGetShaderiv\"), s, 35713, t + 8)           // GL_COMPILE_STATUS\n    si (c_leer32(t, 8) == 0) {\n        sea registro = __gl3d_registro(s, falso)\n        c_llamar(__gl(\"glDeleteShader\"), s)\n        lanzar \"gl3d_shader error: \" + registro\n    }\n    retornar s\n}\n\nfuncion gl3d_programa(vertice, fragmento) {\n    sea p = c_i32(c_llamar(__gl(\"glCreateProgram\")))\n    c_llamar(__gl(\"glAttachShader\"), p, vertice)\n    c_llamar(__gl(\"glAttachShader\"), p, fragmento)\n    c_llamar(__gl(\"glLinkProgram\"), p)\n    sea t = __gl3d_estado()[\"tmp\"]\n    c_llamar(__gl(\"glGetProgramiv\"), p, 35714, t)              // GL_LINK_STATUS\n    si (c_leer32(t, 0) == 0) {\n        sea registro = __gl3d_registro(p, verdadero)\n        c_llamar(__gl(\"glDeleteProgram\"), p)\n        lanzar \"gl3d_programa error: \" + registro\n    }\n    c_llamar(__gl(\"glDeleteShader\"), vertice)\n    c_llamar(__gl(\"glDeleteShader\"), fragmento)\n    retornar p\n}\n\nfuncion gl3d_usar_programa(p) { c_llamar(__gl(\"glUseProgram\"), p) }\n\nfuncion __gl3d_ubicacion(p, nombre) {\n    sea c = c_cadena(nombre)\n    sea u = c_i32(c_llamar(__gl(\"glGetUniformLocation\"), p, c))\n    c_liberar(c)\n    retornar u\n}\n\nfuncion gl3d_uniforme_mat4(p, nombre, m) {\n    si (longitud(m) < 16) { lanzar \"gl3d_uniforme_mat4: requiere lista de 16 numeros\" }\n    sea u = __gl3d_ubicacion(p, nombre)\n    si (u < 0) { retornar nulo }\n    sea buf = c_reservar(64)\n    sea i = 0\n    mientras (i < 16) {\n        c_escribir_f32(buf, i * 4, m[i])\n        i += 1\n    }\n    c_llamar(__gl(\"glUseProgram\"), p)\n    c_llamar(__gl(\"glUniformMatrix4fv\"), u, 1, 0, buf)\n    c_liberar(buf)\n}\n\nfuncion gl3d_uniforme_f(p, nombre, valor) {\n    sea u = __gl3d_ubicacion(p, nombre)\n    si (u < 0) { retornar nulo }\n    sea t = __gl3d_estado()[\"tmp\"]\n    c_escribir_f32(t, 0, valor)\n    c_llamar(__gl(\"glUseProgram\"), p)\n    c_llamar(__gl(\"glUniform1fv\"), u, 1, t)\n}\n\nfuncion gl3d_uniforme_vec3(p, nombre, x, y, z) {\n    sea u = __gl3d_ubicacion(p, nombre)\n    si (u < 0) { retornar nulo }\n    sea t = __gl3d_estado()[\"tmp\"]\n    c_escribir_f32(t, 0, x)\n    c_escribir_f32(t, 4, y)\n    c_escribir_f32(t, 8, z)\n    c_llamar(__gl(\"glUseProgram\"), p)\n    c_llamar(__gl(\"glUniform3fv\"), u, 1, t)\n}\n\n// Color RGBA (0..255) del píxel x, y (origen abajo a la izquierda).\nfuncion gl3d_leer_pixel(x, y) {\n    sea t = __gl3d_estado()[\"tmp\"]\n    c_escribir32(t, 32, 0)\n    c_llamar(__gl(\"glReadPixels\"), piso(x), piso(y), 1, 1, 6408, 5121, t + 32)   // GL_RGBA, GL_UNSIGNED_BYTE\n    retornar [c_leer8(t, 32), c_leer8(t, 33), c_leer8(t, 34), c_leer8(t, 35)]\n}\n\nfunci