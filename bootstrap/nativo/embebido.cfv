    si (i == 12) { retornar "// runtime/sys_macos_ext.cfv — funciones de sistema de macOS para los\n// programas del lenguaje (tiempo, directorios, hilos, red, dlopen).\n\nfuncion sys_reloj_ns() {\n    sea ts = mem_reservar(16)\n    __libsistema(\"clock_gettime\", 0, ts)                       // CLOCK_REALTIME\n    sea ns = __cargar64(ts) * 1000000000 + __cargar64(ts + 8)\n    mem_liberar(ts)\n    retornar ns\n}\n\nfuncion sys_dormir_ms(n) {\n    __libsistema(\"usleep\", n * 1000)\n    retornar 0\n}\n\nfuncion sys_nucleos() {\n    sea n = __libsistema(\"sysconf\", 58)                        // _SC_NPROCESSORS_ONLN\n    si (n < 1) { n = 1 }\n    retornar n\n}\n\n// macOS no expone futex; espera breve y vuelve a mirar.\nfuncion sys_futex_esperar(direccion, valor, ms, op) {\n    si (__y_bits(__cargar64(direccion), 4294967295) == __y_bits(valor, 4294967295)) { __libsistema(\"usleep\", 1000) }\n    retornar 0\n}\n\nfuncion sys_futex_despertar(direccion) { retornar 0 }\n\n// Hilo con pthread_create: el trampolín del compilador (rdi = registro)\n// cambia a la pila [base, base + tam) y llama a dyn_hilo_inicio(t).\nfuncion sys_hilo_crear(base, tam, t) {\n    __guardar64(base + 24, t)\n    __guardar64(base + 32, __dir(\"dyn_hilo_inicio\"))\n    sea id = mem_reservar(8)\n    sea r = sys_i32(__libsistema(\"pthread_create\", id, 0, __trampolin_hilo(), base))\n    si (r != 0) { retornar 0 - 1 }\n    __libsistema(\"pthread_detach\", __cargar64(id))\n    retornar 0\n}\n\nfuncion sys_dl_disponible() { retornar 1 }\n// RTLD_NOW | RTLD_GLOBAL. Sin ruta, también se busca donde instala\n// Homebrew (/opt/homebrew/lib en Apple Silicon, /usr/local/lib en Intel).\nfuncion sys_cargar_biblioteca(nombre) {\n    sea h = __libsistema(\"dlopen\", str_c(nombre), 10)\n    si (h != 0 o str_buscar_texto(nombre, \"/\") >= 0) { retornar h }\n    h = __libsistema(\"dlopen\", str_c(str_concatenar(\"/opt/homebrew/lib/\", nombre)), 10)\n    si (h != 0) { retornar h }\n    retornar __libsistema(\"dlopen\", str_c(str_concatenar(\"/usr/local/lib/\", nombre)), 10)\n}\n\nfuncion str_buscar_texto(pajar, aguja) {\n    sea i = 0\n    mientras (i + str_largo(aguja) <= str_largo(pajar)) {\n        si (str_igual(str_rebanar(pajar, i, i + str_largo(aguja)), aguja)) { retornar i }\n        i = i + 1\n    }\n    retornar 0 - 1\n}\nfuncion sys_simbolo(h, nombre) { retornar __libsistema(\"dlsym\", h, str_c(nombre)) }\n\nfuncion sys_red_escuchar(puerto, ip) {\n    sea fd = sys_i32(__libsistema(\"socket\", 2, 1, 0))\n    si (fd < 0) { retornar 0 - 1 }\n    sea uno = mem_reservar(8)\n    __guardar64(uno, 1)\n    __libsistema(\"setsockopt\", fd, 65535, 4, uno, 4)           // SOL_SOCKET, SO_REUSEADDR\n    mem_liberar(uno)\n    sea dir = mem_reservar(16)\n    mem_llenar(dir, 0, 16)\n    __guardar8(dir, 16)                                        // sin_len\n    __guardar8(dir + 1, 2)                                     // AF_INET\n    __guardar8(dir + 2, __desplazar_der(puerto, 8))\n    __guardar8(dir + 3, __y_bits(puerto, 255))\n    __guardar8(dir + 4, __y_bits(__desplazar_der(ip, 24), 255))   // dirección IPv4 (0 = todas)\n    __guardar8(dir + 5, __y_bits(__desplazar_der(ip, 16), 255))\n    __guardar8(dir + 6, __y_bits(__desplazar_der(ip, 8), 255))\n    __guardar8(dir + 7, __y_bits(ip, 255))\n    sea r = sys_i32(__libsistema(\"bind\", fd, dir, 16))\n    mem_liberar(dir)\n    si (r != 0) { retornar 0 - 2 }\n    si (sys_i32(__libsistema(\"listen\", fd, 64)) != 0) { retornar 0 - 3 }\n    retornar fd\n}\n\nfuncion sys_red_aceptar(fd, dir, largo_dir) { retornar sys_i32(__libsistema(\"accept\", fd, dir, largo_dir)) }\nfuncion sys_red_leer(fd, buf, n) { retornar __libsistema(\"read\", fd, buf, n) }\nfuncion sys_red_escribir(fd, buf, n) { retornar __libsistema(\"write\", fd, buf, n) }\nfuncion sys_red_cerrar(fd) { retornar sys_i32(__libsistema(\"close\", fd)) }\n\n// Bytes aleatorios del sistema (getentropy, de a 256 bytes).\nfuncion sys_aleatorio(buf, n) {\n    sea hecho = 0\n    mientras (hecho < n) {\n        sea parte = n - hecho\n        si (parte > 256) { parte = 256 }\n        si (sys_i32(__libsistema(\"getentropy\", buf + hecho, parte)) != 0) { retornar 0 - 1 }\n        hecho = hecho + parte\n    }\n    retornar 0\n}\n\n// ── Cliente TCP y UDP (IPv4; ip = a·2^24 + b·2^16 + c·2^8 + d) ────────────\n\nfuncion sys_dir_ipv4(dir, ip, puerto) {\n    mem_llenar(dir, 0, 16)\n    __guardar8(dir, 16)                                        // sin_len\n    __guardar8(dir + 1, 2)                                     // AF_INET\n    __guardar8(dir + 2, __desplazar_der(puerto, 8))\n    __guardar8(dir + 3, __y_bits(puerto, 255))\n    __guardar8(dir + 4, __y_bits(__desplazar_der(ip, 24), 255))\n    __guardar8(dir + 5, __y_bits(__desplazar_der(ip, 16), 255))\n    __guardar8(dir + 6, __y_bits(__desplazar_der(ip, 8), 255))\n    __guardar8(dir + 7, __y_bits(ip, 255))\n    retornar dir\n}\n\nfuncion sys_red_conectar(ip, puerto) {\n    sea fd = sys_i32(__libsistema(\"socket\", 2, 1, 0))\n    si (fd < 0) { retornar 0 - 1 }\n    sea dir = sys_dir_ipv4(mem_reservar(16), ip, puerto)\n    sea r = sys_i32(__libsistema(\"connect\", fd, dir, 16))\n    mem_liberar(dir)\n    si (r != 0) {\n        __libsistema(\"close\", fd)\n        retornar 0 - 2\n    }\n    retornar fd\n}\n\nfuncion sys_red_espera(fd, ms) {\n    sea tv = mem_reservar(16)\n    __guardar64(tv, ms / 1000)\n    __guardar64(tv + 8, (ms % 1000) * 1000)\n    __libsistema(\"setsockopt\", fd, 65535, 4102, tv, 16)        // SO_RCVTIMEO\n    __libsistema(\"setsockopt\", fd, 65535, 4101, tv, 16)        // SO_SNDTIMEO\n    mem_liberar(tv)\n    retornar 0\n}\n\nfuncion sys_udp_crear(puerto) {\n    sea fd = sys_i32(__libsistema(\"socket\", 2, 2, 0))\n    si (fd < 0) { retornar 0 - 1 }\n    si (puerto > 0) {\n        sea uno = mem_reservar(8)\n        __guardar64(uno, 1)\n        __libsistema(\"setsockopt\", fd, 65535, 4, uno, 4)\n        mem_liberar(uno)\n        sea dir = sys_dir_ipv4(mem_reservar(16), 0, puerto)\n        sea r = sys_i32(__libsistema(\"bind\", fd, dir, 16))\n        mem_liberar(dir)\n        si (r != 0) {\n            __libsistema(\"close\", fd)\n            retornar 0 - 2\n        }\n    }\n    retornar fd\n}\n\nfuncion sys_udp_enviar(fd, ip, puerto, buf, n) {\n    sea dir = sys_dir_ipv4(mem_reservar(16), ip, puerto)\n    sea r = __libsistema(\"sendto\", fd, buf, n, 0, dir, 16)\n    mem_liberar(dir)\n    retornar r\n}\n\nfuncion sys_udp_recibir(fd, buf, n, dir, bloquear) {\n    sea largo = mem_reservar(8)\n    __guardar64(largo, 16)\n    sea banderas = 128                                         // MSG_DONTWAIT\n    si (bloquear) { banderas = 0 }\n    sea r = __libsistema(\"recvfrom\", fd, buf, n, banderas, dir, largo)\n    mem_liberar(largo)\n    retornar r\n}\n\n// getaddrinfo (IPv4): la dirección en addrinfo.ai_addr (+32).\nfuncion sys_resolver(nombre) {\n    sea pistas = mem_reservar(48)\n    mem_llenar(pistas, 0, 48)\n    __guardar8(pistas + 4, 2)                                  // AF_INET\n    __guardar8(pistas + 8, 1)                                  // SOCK_STREAM\n    sea res = mem_reservar(8)\n    __guardar64(res, 0)\n    sea ip = 0\n    si (sys_i32(__libsistema(\"getaddrinfo\", nombre, 0, pistas, res)) == 0 y __cargar64(res) != 0) {\n        sea dir = __cargar64(__cargar64(res) + 32)\n        ip = __cargar8(dir + 4) * 16777216 + __cargar8(dir + 5) * 65536 + __cargar8(dir + 6) * 256 + __cargar8(dir + 7)\n        __libsistema(\"freeaddrinfo\", __cargar64(res))\n    }\n    mem_liberar(res)\n    mem_liberar(pistas)\n    retornar ip\n}\n\n// Schannel solo existe en Windows; aquí TLS usa OpenSSL (biblioteca.cfv).\nfuncion sys_tls_abrir(estado, host) { retornar 0 - 1 }\nfuncion sys_tls_enviar(estado, p, n) { retornar 0 - 1 }\nfuncion sys_tls_recibir_todo(estado) { retornar str_nuevo(1) }\nfuncion sys_tls_cerrar(estado) { retornar 0 }\nfuncion sys_tls_version(estado) { retornar \"desconocida\" }\n" }
    si (i == 13) { retornar "// runtime/map.cfv — tablas hash con claves de texto, 100 % C-Forge.\n//\n// Direccionamiento abierto con sondeo lineal sobre una tabla de ranuras\n// (potencia de 2) y entradas guardadas en orden de inserción, así que\n// recorrer las claves respeta el orden en que se agregaron.\n//\n// Un mapa es un puntero a 48 bytes:\n//   [vivos][capacidad][ranuras][claves][valores][hashes]\n// Cada ranura guarda 0 (vacía) o índice de entrada + 1. Una entrada borrada\n// conserva su ranura con clave 0 (lápida) hasta el siguiente crecimiento.\n\nfuncion map_hash(clave) {\n    // FNV-1a de 64 bits sobre los bytes del texto.\n    sea h = 2166136261\n    sea datos = str_datos(clave)\n    sea i = 0\n    sea n = str_largo(clave)\n    mientras (i < n) {\n        h = __xo_bits(h, __cargar8(datos + i))\n        h = h * 1099511628211\n        i = i + 1\n    }\n    retornar h\n}\n\nfuncion map_ranuras_nuevas(capacidad) {\n    sea r = mem_reservar(capacidad * 8)\n    mem_llenar(r, 0, capacidad * 8)\n    retornar r\n}\n\nfuncion map_nuevo() {\n    sea m = mem_reservar(48)\n    __guardar64(m, 0)\n    __guardar64(m + 8, 16)\n    __guardar64(m + 16, map_ranuras_nuevas(16))\n    __guardar64(m + 24, vec_nuevo())\n    __guardar64(m + 32, vec_nuevo())\n    __guardar64(m + 40, vec_nuevo())\n    retornar m\n}\n\nfuncion map_tamano(m) { retornar __cargar64(m) }\n\n// Índice de la entrada con esa clave, o -1.\nfuncion map_buscar(m, clave) {\n    sea h = map_hash(clave)\n    sea mascara = __cargar64(m + 8) - 1\n    sea ranuras = __cargar64(m + 16)\n    sea claves = __cargar64(m + 24)\n    sea hashes = __cargar64(m + 40)\n    sea i = __y_bits(h, mascara)\n    mientras (verdadero) {\n        sea r = __cargar64(ranuras + i * 8)\n        si (r == 0) { retornar 0 - 1 }\n        sea e = r - 1\n        si (vec_obtener(hashes, e) == h) {\n            sea k = vec_obtener(claves, e)\n            si (k != 0) {\n                si (str_igual(k, clave)) { retornar e }\n            }\n        }\n        i = __y_bits(i + 1, mascara)\n    }\n    retornar 0 - 1\n}\n\nfuncion map_tiene(m, clave) { retornar map_buscar(m, clave) >= 0 }\n\nfuncion map_obtener_o(m, clave, por_defecto) {\n    sea e = map_buscar(m, clave)\n    si (e < 0) { retornar por_defecto }\n    retornar vec_obtener(__cargar64(m + 32), e)\n}\n\nfuncion map_obtener(m, clave) {\n    sea e = map_buscar(m, clave)\n    si (e < 0) { rt_panico(str_concatenar(\"clave inexistente: \", clave)) }\n    retornar vec_obtener(__cargar64(m + 32), e)\n}\n\nfuncion map_insertar_ranura(ranuras, mascara, h, entrada) {\n    sea i = __y_bits(h, mascara)\n    mientras (__cargar64(ranuras + i * 8) != 0) { i = __y_bits(i + 1, mascara) }\n    __guardar64(ranuras + i * 8, entrada + 1)\n    retornar 0\n}\n\n// Compacta las entradas borradas y duplica la tabla si hace falta (si casi\n// todo son lápidas, como al insertar y borrar la misma clave muchas veces,\n// la capacidad no cambia).\nfuncion map_crecer(m) {\n    sea claves = __cargar64(m + 24)\n    sea valores = __cargar64(m + 32)\n    sea hashes = __cargar64(m + 40)\n    sea capacidad = __cargar64(m + 8)\n    si ((__cargar64(m) + 1) * 3 > capacidad) { capacidad = capacidad * 2 }\n    sea ranuras = map_ranuras_nuevas(capacidad)\n    sea nuevas_claves = vec_nuevo()\n    sea nuevos_valores = vec_nuevo()\n    sea nuevos_hashes = vec_nuevo()\n    sea i = 0\n    mientras (i < vec_largo(claves)) {\n        sea k = vec_obtener(claves, i)\n        si (k != 0) {\n            sea h = vec_obtener(hashes, i)\n            map_insertar_ranura(ranuras, capacidad - 1, h, vec_largo(nuevas_claves))\n            vec_agregar(nuevas_claves, k)\n            vec_agregar(nuevos_valores, vec_obtener(valores, i))\n            vec_agregar(nuevos_hashes, h)\n        }\n        i = i + 1\n    }\n    mem_liberar(__cargar64(m + 16))\n    vec_liberar(claves)\n    vec_liberar(valores)\n    vec_liberar(hashes)\n    __guardar64(m + 8, capacidad)\n    __guardar64(m + 16, ranuras)\n    __guardar64(m + 24, nuevas_claves)\n    __guardar64(m + 32, nuevos_valores)\n    __guardar64(m + 40, nuevos_hashes)\n    retornar 0\n}\n\nfuncion map_fijar(m, clave, valor) {\n    sea e = map_buscar(m, clave)\n    si (e >= 0) {\n        vec_fijar(__cargar64(m + 32), e, valor)\n        retornar 0\n    }\n    // Las entradas (con lápidas) no superan 2/3 de las ranuras.\n    si ((vec_largo(__cargar64(m + 24)) + 1) * 3 > __cargar64(m + 8) * 2) { map_crecer(m) }\n    sea h = map_hash(clave)\n    sea claves = __cargar64(m + 24)\n    map_insertar_ranura(__cargar64(m + 16), __cargar64(m + 8) - 1, h, vec_largo(claves))\n    vec_agregar(claves, clave)\n    vec_agregar(__cargar64(m + 32), valor)\n    vec_agregar(__cargar64(m + 40), h)\n    __guardar64(m, __cargar64(m) + 1)\n    retornar 0\n}\n\nfuncion map_quitar(m, clave) {\n    sea e = map_buscar(m, clave)\n    si (e < 0) { retornar 0 }\n    vec_fijar(__cargar64(m + 24), e, 0)\n    vec_fijar(__cargar64(m + 32), e, 0)\n    __guardar64(m, __cargar64(m) - 1)\n    retornar 1\n}\n\n// Claves vivas en orden de inserción (lista nueva de textos).\nfuncion map_claves(m) {\n    sea claves = __cargar64(m + 24)\n    sea r = vec_nuevo()\n    sea i = 0\n    mientras (i < vec_largo(claves)) {\n        sea k = vec_obtener(claves, i)\n        si (k != 0) { vec_agregar(r, k) }\n        i = i + 1\n    }\n    retornar r\n}\n\n// Acceso por posición de entrada (incluye lápidas con clave 0).\nfuncion map_entradas(m) { retornar vec_largo(__cargar64(m + 24)) }\nfuncion map_clave_en(m, i) { retornar vec_obtener(__cargar64(m + 24), i) }\nfuncion map_valor_en(m, i) { retornar vec_obtener(__cargar64(m + 32), i) }\n" }
    si (i == 14) { retornar "// runtime/dyn.cfv — valores dinámicos del lenguaje C-Forge completo.\n//\n// Escrito en el dialecto nativo, pero con la convención de valores del\n// lenguaje (el compilador lo carga en modo \"puente\"). Cada valor es una\n// palabra de 64 bits con etiqueta:\n//\n//   0           nulo\n//   2 / 4       falso / verdadero\n//   impar       entero: n * 2 + 1\n//   puntero     caja de 16 bytes [tipo][dato]:\n//                 1 texto (dato: texto del runtime)\n//                 2 lista (dato: vec del runtime)\n//                 3 mapa  (dato: map del runtime)\n//                 4 flotante (dato: bits IEEE-754)\n//                 7 función (dato: [código][aridad][n][celdas capturadas]*)\n//                 8 puntero (dato: [bloque (lista)][desplazamiento])\n//\n// Los números siguen la semántica del intérprete: un resultado con valor\n// entero se representa como entero; si no, como flotante.\n\n// ── Construcción y consulta ───────────────────────────────────────────────\n\nfuncion dyn_caja(tipo, dato) {\n    sea c = mem_reservar(16)\n    __guardar64(c, tipo)\n    __guardar64(c + 8, dato)\n    retornar c\n}\n\n// 0 nulo · 1 texto · 2 lista · 3 mapa · 4 flotante · 5 booleano · 6 entero\nfuncion dyn_tipo(v) {\n    si (v == 0) { retornar 0 }\n    si (__y_bits(v, 1) == 1) { retornar 6 }\n    si (v == 2 o v == 4) { retornar 5 }\n    retornar __cargar64(v)\n}\n\nfuncion dyn_dato(v) { retornar __cargar64(v + 8) }\nfuncion dyn_entero(n) { retornar n * 2 + 1 }\nfuncion dyn_valor_entero(v) { retornar (v - 1) / 2 }\nfuncion dyn_bool(b) { si (b) { retornar 4 } retornar 2 }\nfuncion dyn_texto(s) { retornar dyn_caja(1, s) }\nfuncion dyn_lista_nueva() { retornar dyn_caja(2, vec_nuevo()) }\nfuncion dyn_mapa_nuevo() { retornar dyn_caja(3, map_nuevo()) }\n\nfuncion dyn_nombre_tipo(v) {\n    sea t = dyn_tipo(v)\n    si (t == 0) { retornar \"nulo\" }\n    si (t == 1) { retornar \"texto\" }\n    si (t == 2) { retornar \"lista\" }\n    si (t == 3) { retornar \"mapa\" }\n    si (t == 5) { retornar \"booleano\" }\n    si (t == 7) { retornar \"funcion\" }\n    si (t == 8) { retornar \"puntero\" }\n    si (t == 11) { retornar \"puntero\" }\n    si (t == 9) { retornar \"canal\" }\n    si (t == 10) { retornar \"mutex\" }\n    retornar \"numero\"\n}\n\nfuncion dyn_error_tipo(operacion, v) {\n    sea m = str_concatenar(operacion, \": valor de tipo \")\n    str_agregar(m, dyn_nombre_tipo(v))\n    dyn_error(m)\n    retornar 0\n}\n\nfuncion dyn_verdad(v) {\n    si (v == 4) { retornar 1 }\n    si (v == 2) { retornar 0 }\n    dyn_error(\"se esperaba verdadero o falso\")\n    retornar 0\n}\n\n// ── Errores: intentar / capturar / lanzar ────────────────────────────────\n// Global 21: pila de manejadores [rsp][rbp][dirección de captura].\n\n// Cada hilo tiene su pila de manejadores: el hilo principal usa la global\n// 21; un hilo creado por tarea() la guarda en su registro (base de su pila).\nfuncion dyn_manejadores() {\n    sea registro = dyn_registro_hilo()\n    sea casilla = __globales() + 168\n    si (registro != 0) { casilla = registro + 8 }\n    sea h = __cargar64(casilla)\n    si (h == 0) {\n        h = vec_nuevo()\n        __guardar64(casilla, h)\n    }\n    retornar h\n}\n\n// Registro del hilo actual (base alineada de su pila de 8 MiB) o 0 si es el\n// hilo principal. Las bases de los hilos creados por tarea() se anotan en la\n// global 34; así no se lee memoria que podría no estar asignada.\nfuncion dyn_registro_hilo() {\n    sea bases = __cargar64(__globales() + 272)\n    si (bases == 0) { retornar 0 }\n    sea base = __y_bits(__pila(), 0 - 8388608)\n    sea i = 0\n    mientras (i < vec_largo(bases)) {\n        si (vec_obtener(bases, i) == base) { retornar base }\n        i = i + 1\n    }\n    retornar 0\n}\n\nfuncion dyn_anotar_hilo(base) {\n    sea cerrojo = __globales() + 280\n    mientras (__intercambiar(cerrojo, 1) != 0) { sys_ceder() }\n    sea bases = __cargar64(__globales() + 272)\n    si (bases == 0) {\n        bases = vec_nuevo()\n        __guardar64(__globales() + 272, bases)\n    }\n    vec_agregar(bases, base)\n    __guardar64(cerrojo, 0)\n    retornar 0\n}\n\nfuncion dyn_intentar_entrar(pila, marco, destino) {\n    sea r = mem_reservar(24)\n    __guardar64(r, pila)\n    __guardar64(r + 8, marco)\n    __guardar64(r + 16, destino)\n    vec_agregar(dyn_manejadores(), r)\n    retornar 0\n}\n\nfuncion dyn_intentar_salir() {\n    mem_liberar(vec_quitar_ultimo(dyn_manejadores()))\n    retornar 0\n}\n\nfuncion dyn_lanzar(v) {\n    sea h = dyn_manejadores()\n    si (vec_largo(h) == 0) {\n        rt_panico(str_concatenar(\"error no capturado: \", dyn_a_str(v)))\n    }\n    sea r = vec_quitar_ultimo(h)\n    __saltar(__cargar64(r + 8), __cargar64(r), __cargar64(r + 16), v)\n    retornar 0\n}\n\n// Error del lenguaje: se puede capturar con intentar/capturar.\nfuncion dyn_error(mensaje) {\n    si (vec_largo(dyn_manejadores()) > 0) { dyn_lanzar(dyn_texto(mensaje)) }\n    rt_panico(mensaje)\n    retornar 0\n}\n\n// ── Funciones anónimas y celdas ──────────────────────────────────────────\n\nfuncion dyn_celda_nueva(v) {\n    sea celda = mem_reservar(8)\n    __guardar64(celda, v)\n    retornar celda\n}\n\nfuncion dyn_cierre_nuevo(codigo, aridad, capturas) {\n    sea r = mem_reservar(24 + capturas * 8)\n    __guardar64(r, codigo)\n    __guardar64(r + 8, aridad)\n    __guardar64(r + 16, capturas)\n    retornar dyn_caja(7, r)\n}\n\nfuncion dyn_cierre_fijar(f, i, celda) {\n    __guardar64(dyn_dato(f) + 24 + i * 8, celda)\n    retornar f\n}\n\n// Dirección del código de f para una llamada con n argumentos.\nfuncion dyn_codigo_cierre(f, n) {\n    si (dyn_tipo(f) != 7) { dyn_error_tipo(\"no se puede llamar\", f) }\n    sea r = dyn_dato(f)\n    si (__cargar64(r + 8) != n) {\n        sea m = str_concatenar(\"la función espera \", str_desde_entero(__cargar64(r + 8)))\n        str_agregar(m, \" argumentos y recibió \")\n        str_agregar(m, str_desde_entero(n))\n        dyn_error(m)\n    }\n    retornar __cargar64(r)\n}\n\n// ── Números ───────────────────────────────────────────────────────────────\n\nfuncion dyn_es_numero(v) {\n    sea t = dyn_tipo(v)\n    retornar t == 6 o t == 4 o t == 12\n}\n\nfuncion dyn_a_f64(v) {\n    sea t = dyn_tipo(v)\n    si (t == 6) { retornar __f64_desde_entero(dyn_valor_entero(v)) }\n    si (t == 4) { retornar dyn_dato(v) }\n    si (t == 12) { retornar dyn_gr_a_f64(dyn_dato(v)) }\n    dyn_error_tipo(\"se esperaba un número\", v)\n    retornar 0\n}\n\n// Normaliza: un flotante con valor entero exacto vuelve a ser entero.\nfuncion dyn_desde_f64(bits) {\n    sea e = __f64_a_entero(bits)\n    si (e > 0 - 4503599627370496 y e < 4503599627370496) {\n        si (__f64_desde_entero(e) == bits) { retornar dyn_entero(e) }\n        // -0.0 también es el entero 0.\n        si (__desplazar_izq(bits, 1) == 0) { retornar dyn_entero(0) }\n    }\n    retornar dyn_caja(4, bits)\n}\n\nfuncion dyn_flotante(bits) { retornar dyn_desde_f64(bits) }\n\n// Parámetros anotados: se comprueban una vez al entrar a la función.\nfuncion dyn_parametro_mal(v, nombre, esperado) {\n    sea m = str_concatenar(\"error de tipos: el parámetro \", dyn_a_str(nombre))\n    str_agregar(m, \" espera \")\n    str_agregar(m, esperado)\n    str_agregar(m, \" y recibe \")\n    str_agregar(m, dyn_nombre_tipo(v))\n    dyn_error(m)\n    retornar v\n}\n\nfuncion dyn_parametro_entero(v, nombre) {\n    si (__y_bits(v, 1) == 1 o dyn_tipo(v) == 12) { retornar v }\n    retornar dyn_parametro_mal(v, nombre, \"entero\")\n}\n\nfuncion dyn_parametro_numero(v, nombre) {\n    si (dyn_es_numero(v)) { retornar v }\n    retornar dyn_parametro_mal(v, nombre, \"decimal\")\n}\n\nfuncion dyn_ambos_enteros(a, b) {\n    retornar __y_bits(__y_bits(a, b), 1) == 1\n}\n\n// Recolector de basura (runtime/mem.cfv): raíces en las casillas globales\n// y las variables de nivel superior. La cantidad de globales está después\n// de la tabla de clases: [n][registro]*[globales].\nfuncion dyn_gc_iniciar() {\n    si (sys_variable_entorno(\"CFORGE_GC\") != 0) {\n        si (str_igual(sys_variable_entorno(\"CFORGE_GC\"), \"0\")) { retornar 0 }\n    }\n    sea tabla = __clases()\n    sea cantidad = __cargar64(tabla + 8 + __cargar64(tabla) * 8)\n    // CFORGE_GC_ESTRES=1: recolectar cada 64 KiB (pruebas del recolector).\n    sea minimo = 8388608\n    si (sys_variable_entorno(\"CFORGE_GC_ESTRES\") != 0) { minimo = 65536 }\n    gc_activar(__globales() + 512 + cantidad * 8, minimo)\n    retornar 0\n}\n\n// Programa escrito en inglés: valores impresos en inglés (global 20).\nfuncion dyn_fijar_ingles() { mem_fijar_global(20, 1) retornar 0 }\nfuncion dyn_ingles() { retornar mem_global(20) == 1 }\n\n// ── Clases ────────────────────────────────────────────────────────────────\n// El compilador deja en datos la tabla __clases(): [n][registro]*, con cada\n// registro [nombre][padre o 0][n métodos]([nombre][código][aridad])*.\n// Una instancia es un mapa con la clave \"__clase\".\n\nfuncion dyn_registro_clase(nombre) {\n    sea tabla = __clases()\n    sea i = 0\n    mientras (i < __cargar64(tabla)) {\n        sea r = __cargar64(tabla + 8 + i * 8)\n        si (str_igual(__cargar64(r), nombre)) { retornar r }\n        i = i + 1\n    }\n    retornar 0\n}\n\n// Dirección del método (o 0) para objeto.nombre(...) con aridad total n.\nfuncion dyn_buscar_metodo(objeto, nombre, n) {\n    si (dyn_tipo(objeto) != 3) { retornar 0 }\n    sea m = dyn_dato(objeto)\n    sea e = map_buscar(m, \"__clase\")\n    si (e < 0) { retornar 0 }\n    sea clase = map_valor_en(m, e)\n    si (dyn_tipo(clase) != 1) { retornar 0 }\n    sea r = dyn_registro_clase(dyn_dato(clase))\n    mientras (r != 0) {\n        sea cantidad = __cargar64(r + 16)\n        sea i = 0\n        mientras (i < cantidad) {\n            sea entrada = r + 24 + i * 24\n            si (str_igual(__cargar64(entrada), nombre)) {\n                si (__cargar64(entrada + 16) != n) {\n                    dyn_error(str_concatenar(\"cantidad de argumentos incorrecta en el método \", nombre))\n                }\n                retornar __cargar64(entrada + 8)\n            }\n            i = i + 1\n        }\n        si (__cargar64(r + 8) == 0) { r = 0 } sino { r = dyn_registro_clase(__cargar64(r + 8)) }\n    }\n    retornar 0\n}\n\nfuncion dyn_metodo_desconocido(objeto, nombre) {\n    sea m = str_concatenar(\"método desconocido '\", nombre)\n    str_agregar(m, \"' para un valor de tipo \")\n    str_agregar(m, dyn_nombre_tipo(objeto))\n    dyn_error(m)\n    retornar 0\n}\n\n// ── Claves ordenadas (como el intérprete: orden por bytes) ───────────────\n\nfuncion dyn_str_comparar(x, y) {\n    sea i = 0\n    mientras (i < str_largo(x) y i < str_largo(y)) {\n        sea cx = str_byte(x, i)\n        sea cy = str_byte(y, i)\n        si (cx < cy) { retornar 0 - 1 }\n        si (cx > cy) { retornar 1 }\n        i = i + 1\n    }\n    si (str_largo(x) < str_largo(y)) { retornar 0 - 1 }\n    si (str_largo(x) > str_largo(y)) { retornar 1 }\n    retornar 0\n}\n\n// Ordena por mezcla el tramo [desde, hasta) de v usando aux.\nfuncion dyn_ordenar_tramo(v, aux, desde, hasta) {\n    si (hasta - desde < 2) { retornar 0 }\n    sea medio = (desde + hasta) / 2\n    dyn_ordenar_tramo(v, aux, desde, medio)\n    dyn_ordenar_tramo(v, aux, medio, hasta)\n    sea i = desde\n    sea j = medio\n    sea k = desde\n    mientras (k < hasta) {\n        si (j >= hasta o (i < medio y dyn_str_comparar(vec_obtener(v, i), vec_obtener(v, j)) <= 0)) {\n            vec_fijar(aux, k, vec_obtener(v, i))\n            i = i + 1\n        } sino {\n            vec_fijar(aux, k, vec_obtener(v, j))\n            j = j + 1\n        }\n        k = k + 1\n    }\n    k = desde\n    mientras (k < hasta) {\n        vec_fijar(v, k, vec_obtener(aux, k))\n        k = k + 1\n    }\n    retornar 0\n}\n\n// Claves del mapa (textos del runtime) en orden.\nfuncion dyn_claves_ordenadas(m) {\n    sea v = map_claves(m)\n    sea aux = vec_nuevo()\n    sea i = 0\n    mientras (i < vec_largo(v)) {\n        vec_agregar(aux, 0)\n        i = i + 1\n    }\n    dyn_ordenar_tramo(v, aux, 0, vec_largo(v))\n    vec_liberar(aux)\n    retornar v\n}\n\n// ── Texto ─────────────────────────────────────────────────────────────────\n\nfuncion dyn_agregar_valor(r, v, comillas) {\n    sea t = dyn_tipo(v)\n    si (t == 1 y comillas) {\n        str_agregar_byte(r, 34)\n        str_agregar(r, dyn_dato(v))\n        str_agregar_byte(r, 34)\n        retornar 0\n    }\n    si (t == 1) { str_agregar(r, dyn_dato(v)) retornar 0 }\n    si (t == 0) {\n        si (dyn_ingles()) { str_agregar(r, \"null\") } sino { str_agregar(r, \"nulo\") }\n        retornar 0\n    }\n    si (t == 5) {\n        si (dyn_ingles()) {\n            si (v == 4) { str_agregar(r, \"true\") } sino { str_agregar(r, \"false\") }\n        } sino {\n            si (v == 4) { str_agregar(r, \"verdadero\") } sino { str_agregar(r, \"falso\") }\n        }\n        retornar 0\n    }\n    si (t == 6) {\n        str_agregar_entero(r, dyn_valor_entero(v))\n        retornar 0\n    }\n    si (t == 4) {\n        dyn_formato_g(r, dyn_dato(v))\n        retornar 0\n    }\n    si (t == 12) {\n        dyn_gr_agregar_texto(r, dyn_dato(v))\n        retornar 0\n    }\n    si (t == 2) {\n        sea l = dyn_dato(v)\n        str_agregar_byte(r, 91)\n        sea i = 0\n        mientras (i < vec_largo(l)) {\n            si (i > 0) { str_agregar(r, \", \") }\n            dyn_agregar_valor(r, vec_obtener(l, i), 0)\n            i = i + 1\n        }\n        str_agregar_byte(r, 93)\n        retornar 0\n    }\n    si (t == 3) {\n        sea m = dyn_dato(v)\n        str_agregar_byte(r, 123)\n        sea orden = dyn_claves_ordenadas(m)\n        sea j = 0\n        mientras (j < vec_largo(orden)) {\n            sea k = vec_obtener(orden, j)\n            si (j > 0) { str_agregar(r, \", \") }\n            str_agregar_byte(r, 34)\n            str_agregar(r, k)\n            str_agregar(r, \"\\\": \")\n            dyn_agregar_valor(r, map_obtener(m, k), 0)\n            j = j + 1\n        }\n        vec_liberar(orden)\n        str_agregar_byte(r, 125)\n        retornar 0\n    }\n    si (t == 7) { str_agregar(r, \"<funcion>\") retornar 0 }\n    si (t == 9) { str_agregar(r, \"<canal>\") retornar 0 }\n    si (t == 10) { str_agregar(r, \"<mutex>\") retornar 0 }\n    si (t == 8) { str_agregar(r, \"<puntero>\") retornar 0 }\n    si (t == 11) { str_agregar(r, \"<puntero>\") retornar 0 }\n    dyn_error(\"valor desconocido\")\n    retornar 0\n}\n\n// Texto del runtime con la representación del valor.\nfuncion dyn_a_str(v) {\n    si (dyn_tipo(v) == 1) { retornar dyn_dato(v) }\n    sea r = str_nuevo(16)\n    dyn_agregar_valor(r, v, 0)\n    retornar r\n}\n\nfuncion dyn_texto_de(v, operacion) {\n    si (dyn_tipo(v) != 1) { dyn_error_tipo(operacion, v) }\n    retornar dyn_dato(v)\n}\n\n// ── Operadores ────────────────────────────────────────────────────────────\n\n// a + b con a y b enteros chicos; si no cabe, entero grande.\nfuncion dyn_suma_entera(a, b) {\n    sea r = a - 1 + b\n    si (__y_bits(__xo_bits(a - 1, r), __xo_bits(b, r)) < 0) { retornar dyn_gr_op_suma(a, b) }\n    retornar r\n}\n\nfuncion dyn_resta_entera(a, b) {\n    sea b2 = b - 1\n    sea r = a - b2\n    si (__y_bits(__xo_bits(a, b2), __xo_bits(a, r)) < 0) { retornar dyn_gr_op_resta(a, b) }\n    retornar r\n}\n\nfuncion dyn_mul_entera(a, b) {\n    sea x = dyn_valor_entero(a)\n    sea y2 = b - 1\n    sea r = x * y2\n    si (x != 0) {\n        si ((x == 0 - 1 y y2 == __desplazar_izq(1, 63)) o (x != 0 - 1 y r / x != y2)) { retornar dyn_gr_op_mul(a, b) }\n    }\n    retornar r + 1\n}\n\nfuncion dyn_ambos_enteros_gr(a, b) { retornar dyn_gr_es_entero(a) y dyn_gr_es_entero(b) }\n\nfuncion dyn_suma(a, b) {\n    si (dyn_ambos_enteros(a, b)) { retornar dyn_suma_entera(a, b) }\n    si (dyn_ambos_enteros_gr(a, b)) { retornar dyn_gr_op_suma(a, b) }\n    si (dyn_tipo(a) == 8 y __y_bits(b, 1) == 1) { retornar dyn_puntero(__cargar64(dyn_dato(a)), __cargar64(dyn_dato(a) + 8) + dyn_valor_entero(b)) }\n    // Puntero de C + desplazamiento (memoria de c_reservar).\n    si (dyn_tipo(a) == 11 y __y_bits(b, 1) == 1) { retornar dyn_caja(11, dyn_dato(a) + dyn_valor_entero(b)) }\n    si (dyn_tipo(a) == 2 y dyn_tipo(b) == 2) {\n        // lista + lista: una lista nueva con los elementos de ambas.\n        sea r = vec_nuevo()\n        sea x = dyn_dato(a)\n        sea y = dyn_dato(b)\n        sea i = 0\n        mientras (i < vec_largo(x)) {\n            vec_agregar(r, vec_obtener(x, i))\n            i = i + 1\n        }\n        i = 0\n        mientras (i < vec_largo(y)) {\n            vec_agregar(r, vec_obtener(y, i))\n            i = i + 1\n        }\n        retornar dyn_caja(2, r)\n    }\n    si (dyn_tipo(a) == 1) { retornar dyn_texto_sumar(a, b) }\n    si (dyn_tipo(b) == 1) {\n        sea r = str_nuevo(16)\n        dyn_agregar_valor(r, a, 0)\n        dyn_agregar_valor(r, b, 0)\n        retornar dyn_texto(r)\n    }\n    retornar dyn_desde_f64(__f64_suma(dyn_a_f64(a), dyn_a_f64(b)))\n}\n\nfuncion dyn_resta(a, b) {\n    si (dyn_ambos_enteros(a, b)) { retornar dyn_resta_entera(a, b) }\n    si (dyn_ambos_enteros_gr(a, b)) { retornar dyn_gr_op_resta(a, b) }\n    si (dyn_tipo(a) == 8 y __y_bits(b, 1) == 1) { retornar dyn_puntero(__cargar64(dyn_dato(a)), __cargar64(dyn_dato(a) + 8) - dyn_valor_entero(b)) }\n    retornar dyn_desde_f64(__f64_resta(dyn_a_f64(a), dyn_a_f64(b)))\n}\n\nfuncion dyn_mul(a, b) {\n    si (dyn_ambos_enteros(a, b)) { retornar dyn_mul_entera(a, b) }\n    si (dyn_ambos_enteros_gr(a, b)) { retornar dyn_gr_op_mul(a, b) }\n    retornar dyn_desde_f64(__f64_mul(dyn_a_f64(a), dyn_a_f64(b)))\n}\n\nfuncion dyn_div(a, b) {\n    si (dyn_ambos_enteros(a, b)) {\n        sea x = dyn_valor_entero(a)\n        sea y = dyn_valor_entero(b)\n        si (y == 0) { dyn_error(\"división por cero\") }\n        si (x % y == 0) { retornar cociente(a, b) }\n    }\n    si (dyn_ambos_enteros(a, b) == 0 y dyn_ambos_enteros_gr(a, b)) {\n        // Exacta si el resto es cero; si no, como siempre, decimal.\n        si (dyn_gr_op_dividir(a, b, 1) == 1) { retornar dyn_gr_op_dividir(a, b, 0) }\n    }\n    retornar dyn_desde_f64(__f64_div(dyn_a_f64(a), dyn_a_f64(b)))\n}\n\nfuncion dyn_mod(a, b) {\n    si (dyn_ambos_enteros(a, b)) {\n        sea y = dyn_valor_entero(b)\n        si (y == 0) { dyn_error(\"división por cero\") }\n        retornar dyn_entero(dyn_valor_entero(a) % y)\n    }\n    si (dyn_ambos_enteros_gr(a, b)) { retornar dyn_gr_op_dividir(a, b, 1) }\n    // fmod: a - trunc(a / b) * b\n    sea x = dyn_a_f64(a)\n    sea y = dyn_a_f64(b)\n    sea cociente = __f64_desde_entero(__f64_a_entero(__f64_div(x, y)))\n    retornar dyn_desde_f64(__f64_resta(x, __f64_mul(cociente, y)))\n}\n\nfuncion dyn_neg(a) {\n    si (__y_bits(a, 1) == 1) { retornar dyn_resta_entera(1, a) }\n    si (dyn_tipo(a) == 12) { retornar dyn_gr_negar(a) }\n    retornar dyn_desde_f64(__f64_resta(__f64_desde_entero(0), dyn_a_f64(a)))\n}\n\nfuncion dyn_no(a) { retornar dyn_bool(dyn_verdad(a) == 0) }\n\nfuncion dyn_igual_crudo(a, b) { retornar dyn_igual_prof(a, b, 0) }\n\n// Listas y mapas se comparan por contenido (como en Python o JavaScript con\n// deepEqual); las instancias de clase, por identidad. prof corta los ciclos.\nfuncion dyn_igual_prof(a, b, prof) {\n    si (a == b) { retornar 1 }\n    sea ta = dyn_tipo(a)\n    sea tb = dyn_tipo(b)\n    si (ta == 1 y tb == 1) { retornar str_igual(dyn_dato(a), dyn_dato(b)) }\n    si (ta == 2 y tb == 2) {\n        si (prof > 200) { retornar 0 }\n        sea x = dyn_dato(a)\n        sea y = dyn_dato(b)\n        sea n = vec_largo(x)\n        si (n != vec_largo(y)) { retornar 0 }\n        sea i = 0\n        mientras (i < n) {\n            si (dyn_igual_prof(vec_obtener(x, i), vec_obtener(y, i), prof + 1) == 0) { retornar 0 }\n            i = i + 1\n        }\n        retornar 1\n    }\n    si (ta == 3 y tb == 3) {\n        si (prof > 200) { retornar 0 }\n        sea x = dyn_dato(a)\n        sea y = dyn_dato(b)\n        si (map_buscar(x, \"__clase\") >= 0 o map_buscar(y, \"__clase\") >= 0) { retornar 0 }\n        si (map_tamano(x) != map_tamano(y)) { retornar 0 }\n        sea i = 0\n        sea n = map_entradas(x)\n        mientras (i < n) {\n            sea k = map_clave_en(x, i)\n            si (k != 0) {\n                sea e = map_buscar(y, k)\n                si (e < 0) { retornar 0 }\n                si (dyn_igual_prof(map_valor_en(x, i), map_valor_en(y, e), prof + 1) == 0) { retornar 0 }\n            }\n            i = i + 1\n        }\n        retornar 1\n    }\n    si (ta == 11 y tb == 11) { retornar dyn_dato(a) == dyn_dato(b) }\n    si (dyn_es_numero(a) y dyn_es_numero(b)) {\n        si (ta == 6 y tb == 6) { retornar 0 }\n        si ((ta == 6 o ta == 12) y (tb == 6 o tb == 12)) { retornar dyn_gr_op_comparar(a, b) == 0 }\n        sea x = dyn_a_f64(a)\n        sea y = dyn_a_f64(b)\n        retornar __f64_menor(x, y) == 0 y __f64_menor(y, x) == 0\n    }\n    retornar 0\n}\n\nfuncion dyn_igual(a, b) { retornar dyn_bool(dyn_igual_crudo(a, b)) }\n// ¿Son el mismo objeto? (identidad: la lista o el mapa exactos, no una copia).\nfuncion es_mismo(a, b) { retornar dyn_bool(a == b) }\nfuncion dyn_distinto(a, b) { retornar dyn_bool(dyn_igual_crudo(a, b) == 0) }\n\n// -1, 0 o 1 para números o textos.\nfuncion dyn_comparar(a, b) {\n    si (dyn_ambos_enteros(a, b)) {\n        si (a < b) { retornar 0 - 1 }\n        si (a > b) { retornar 1 }\n        retornar 0\n    }\n    si (dyn_ambos_enteros_gr(a, b)) { retornar dyn_gr_op_comparar(a, b) }\n    si (dyn_tipo(a) == 1 y dyn_tipo(b) == 1) {\n        sea x = dyn_dato(a)\n        sea y = dyn_dato(b)\n        sea i = 0\n        mientras (i < str_largo(x) y i < str_largo(y)) {\n            sea cx = str_byte(x, i)\n            sea cy = str_byte(y, i)\n            si (cx < cy) { retornar 0 - 1 }\n            si (cx > cy) { retornar 1 }\n            i = i + 1\n        }\n        si (str_largo(x) < str_largo(y)) { retornar 0 - 1 }\n        si (str_largo(x) > str_largo(y)) { retornar 1 }\n        retornar 0\n    }\n    sea fx = dyn_a_f64(a)\n    sea fy = dyn_a_f64(b)\n    si (__f64_menor(fx, fy)) { retornar 0 - 1 }\n    si (__f64_menor(fy, fx)) { retornar 1 }\n    retornar 0\n}\n\nfuncion dyn_menor(a, b) { retornar dyn_bool(dyn_comparar(a, b) < 0) }\nfuncion dyn_menor_igual(a, b) { retornar dyn_bool(dyn_comparar(a, b) <= 0) }\nfuncion dyn_mayor(a, b) { retornar dyn_bool(dyn_comparar(a, b) > 0) }\nfuncion dyn_mayor_igual(a, b) { retornar dyn_bool(dyn_comparar(a, b) >= 0) }\n\n// ── Indexación e iteración ────────────────────────────────────────────────\n\nfuncion dyn_indice_lista(l, i) {\n    si (dyn_tipo(i) == 12) { dyn_error(\"índice de lista inválido\") }\n    si (__y_bits(i, 1) != 1) { dyn_error(\"el índice de lista debe ser un número entero\") }\n    sea n = dyn_valor_entero(i)\n    si (n < 0 o n >= vec_largo(l)) { dyn_error(\"índice de lista inválido\") }\n    retornar n\n}\n\nfuncion dyn_clave(k) {\n    si (dyn_tipo(k) != 1) { dyn_error(\"la clave debe ser texto\") }\n    retornar dyn_dato(k)\n}\n\nfuncion dyn_indice(c, k) {\n    sea t = dyn_tipo(c)\n    si (t == 2) {\n        sea l = dyn_dato(c)\n        retornar vec_obtener(l, dyn_indice_lista(l, k))\n    }\n    si (t == 3) {\n        sea m = dyn_dato(c)\n        sea e = map_buscar(m, dyn_clave(k))\n        si (e < 0) { dyn_error(\"clave inexistente\") }\n        retornar map_valor_en(m, e)\n    }\n    si (t == 1) {\n        sea s = dyn_dato(c)\n        si (__y_bits(k, 1) != 1) { dyn_error(\"el índice de texto debe ser un número entero\") }\n        sea n = dyn_valor_entero(k)\n        si (n < 0 o n >= str_largo(s)) { dyn_error(\"índice de texto inválido\") }\n        retornar dyn_texto(str_rebanar(s, n, n + 1))\n    }\n    dyn_error_tipo(\"no se puede indexar\", c)\n    retornar 0\n}\n\n// c[k] seguido de ??: nulo si el contenedor es nulo, la clave no existe o el\n// índice está fuera de rango.\nfuncion dyn_indice_opcional(c, k) {\n    si (c == 0) { retornar 0 }\n    sea t = dyn_tipo(c)\n    si (t == 3) {\n        sea m = dyn_dato(c)\n        sea e = map_buscar(m, dyn_clave(k))\n        si (e < 0) { retornar 0 }\n        retornar map_valor_en(m, e)\n    }\n    si (t == 2) {\n        sea l = dyn_dato(c)\n        si (__y_bits(k, 1) == 1) {\n            sea n = dyn_valor_entero(k)\n            si (n < 0 o n >= vec_largo(l)) { retornar 0 }\n        }\n    }\n    retornar dyn_indice(c, k)\n}\n\n// valor.campo: campo de un mapa/instancia; .longitud de listas y textos.\nfuncion dyn_campo(c, k) {\n    sea t = dyn_tipo(c)\n    si (t == 3) { retornar dyn_indice(c, k) }\n    si ((t == 1 o t == 2) y (str_igual(dyn_dato(k), \"longitud\") o str_igual(dyn_dato(k), \"largo\") o str_igual(dyn_dato(k), \"length\"))) {\n        retornar longitud(c)\n    }\n    si (t == 0) { dyn_error(str_concatenar(\"acceso a campo de nulo: \", dyn_dato(k))) }\n    dyn_error_tipo(str_concatenar(\"no tiene el campo \", dyn_dato(k)), c)\n    retornar 0\n}\n\n// Resultado/Opción: ¿es un fallo? (raw 0/1) — {\"ok\": falso} o {\"presente\": falso}\nfuncion dyn_es_fallo(v) {\n    si (dyn_tipo(v) != 3) { retornar 0 }\n    sea m = dyn_dato(v)\n    si (map_obtener_o(m, \"ok\", 0) == 2) { retornar 1 }\n    si (map_obtener_o(m, \"presente\", 0) == 2) { retornar 1 }\n    retornar 0\n}\n\n// coincidir: ¿v es la variante k? (1 Ok, 2 Error, 3 Alguno, 4 Ninguno).\n// Devuelve 0/1 crudo.\nfuncion dyn_variante(v, k) {\n    si (dyn_tipo(v) != 3) { retornar 0 }\n    sea m = dyn_dato(v)\n    si (k <= 2) {\n        si (map_tiene(m, \"ok\") == 0) { retornar 0 }\n        sea ok = map_obtener(m, \"ok\") == 4\n        si (k == 1) { retornar ok }\n        retornar ok == 0\n    }\n    si (map_tiene(m, \"presente\") == 0) { retornar 0 }\n    sea p = map_obtener(m, \"presente\") == 4\n    si (k == 3) { retornar p }\n    retornar p == 0\n}\n\n// Lo que envuelve la variante: el error para Error(e), el valor si no.\nfuncion dyn_variante_valor(v, k) {\n    sea m = dyn_dato(v)\n    si (k == 2) { retornar map_obtener_o(m, \"error\", 0) }\n    retornar map_obtener_o(m, \"valor\", 0)\n}\n\nfuncion dyn_desenvolver(v) {\n    si (dyn_tipo(v) != 3) { retornar v }\n    sea m = dyn_dato(v)\n    si (map_tiene(m, \"valor\") y (map_tiene(m, \"ok\") o map_tiene(m, \"presente\"))) { retornar map_obtener(m, \"valor\") }\n    retornar v\n}\n\nfuncion dyn_fijar_indice(c, k, v) {\n    sea t = dyn_tipo(c)\n    si (t == 2) {\n        sea l = dyn_dato(c)\n        vec_fijar(l, dyn_indice_lista(l, k), v)\n        retornar 0\n    }\n    si (t == 3) {\n        map_fijar(dyn_dato(c), dyn_clave(k), v)\n        retornar 0\n    }\n    dyn_error_tipo(\"no se puede asignar por índice\", c)\n    retornar 0\n}\n\n// Para \"para x en c\": cantidad de elementos (entero crudo) y elemento i.\nfuncion dyn_iter_largo(c) {\n    sea t = dyn_tipo(c)\n    si (t == 2) { retornar vec_largo(dyn_dato(c)) }\n    si (t == 1) { retornar str_largo(dyn_dato(c)) }\n    dyn_error_tipo(\"no se puede recorrer\", c)\n    retornar 0\n}\n\nfuncion dyn_iter_obtener(c, i) {\n    si (dyn_tipo(c) == 2) { retornar vec_obtener(dyn_dato(c), i) }\n    retornar dyn_texto(str_rebanar(dyn_dato(c), i, i + 1))\n}\n\n// ── Funciones del lenguaje ────────────────────────────────────────────────\n\nfuncion mostrar(v) {\n    rt_mostrar(dyn_a_str(v))\n    retornar 0\n}\n\n// Como mostrar, pero sin salto de línea (barras de progreso, prompts…).\nfuncion escribir(v) {\n    rt_escribir_texto(1, dyn_a_str(v))\n    retornar 0\n}\n\nfuncion afirmar(condicion, mensaje) {\n    si (dyn_verdad(condicion) == 0) { dyn_error(dyn_a_str(mensaje)) }\n    retornar 0\n}\n\nfuncion a_texto(v) {\n    si (dyn_tipo(v) == 1) { retornar v }\n    retornar dyn_texto(dyn_a_str(v))\n}\n\nfuncion longitud(v) {\n    sea t = dyn_tipo(v)\n    si (t == 2) { retornar dyn_entero(vec_largo(dyn_dato(v))) }\n    si (t == 1) { retornar dyn_entero(str_largo(dyn_dato(v))) }\n    si (t == 3) { retornar dyn_entero(map_tamano(dyn_dato(v))) }\n    dyn_error_tipo(\"longitud\", v)\n    retornar 0\n}\n\nfuncion agregar(l, v) {\n    si (dyn_tipo(l) != 2) { dyn_error_tipo(\"agregar\", l) }\n    vec_agregar(dyn_dato(l), v)\n    retornar 0\n}\n\nfuncion claves(m) {\n    si (dyn_tipo(m) != 3) { dyn_error_tipo(\"claves\", m) }\n    sea crudas = dyn_claves_ordenadas(dyn_dato(m))\n    sea r = vec_nuevo()\n    sea i = 0\n    mientras (i < vec_largo(crudas)) {\n        vec_agregar(r, dyn_texto(vec_obtener(crudas, i)))\n        i = i + 1\n    }\n    vec_liberar(crudas)\n    retornar dyn_caja(2, r)\n}\n\nfuncion tiene_clave(m, k) {\n    si (dyn_tipo(m) != 3) { dyn_error_tipo(\"tiene_clave\", m) }\n    retornar dyn_bool(map_tiene(dyn_dato(m), dyn_clave(k)))\n}\n\nfuncion quitar_clave(m, k) {\n    si (dyn_tipo(m) != 3) { dyn_error_tipo(\"quitar_clave\", m) }\n    retornar dyn_bool(map_quitar(dyn_dato(m), dyn_clave(k)))\n}\n\nfuncion lista_rango(inicio, fin) {\n    si (__y_bits(inicio, 1) != 1 o __y_bits(fin, 1) != 1) { dyn_error(\"lista_rango: se esperaban enteros\") }\n    sea r = vec_nuevo()\n    sea i = dyn_valor_entero(inicio)\n    sea n = dyn_valor_entero(fin)\n    si (n - i > dyn_max_elementos()) { dyn_error(\"lista_rango: demasiados elementos\") }\n    mientras (i < n) {\n        vec_agregar(r, dyn_entero(i))\n        i = i + 1\n    }\n    retornar dyn_caja(2, r)\n}\n\nfuncion lista_invertir(l) {\n    si (dyn_tipo(l) != 2) { dyn_error_tipo(\"lista_invertir\", l) }\n    sea origen = dyn_dato(l)\n    sea r = vec_nuevo()\n    sea i = vec_largo(origen) - 1\n    mientras (i >= 0) {\n        vec_agregar(r, vec_obtener(origen, i))\n        i = i - 1\n    }\n    retornar dyn_caja(2, r)\n}\n\nfuncion lista_contiene(l, v) {\n    si (dyn_tipo(l) != 2) { dyn_error_tipo(\"lista_contiene\", l) }\n    sea origen = dyn_dato(l)\n    sea i = 0\n    mientras (i < vec_largo(origen)) {\n        si (dyn_igual_crudo(vec_obtener(origen, i), v)) { retornar 4 }\n        i = i + 1\n    }\n    retornar 2\n}\n\nfuncion quitar_ultimo(l) {\n    si (dyn_tipo(l) != 2) { dyn_error_tipo(\"quitar_ultimo\", l) }\n    si (vec_largo(dyn_dato(l)) == 0) { dyn_error(\"quitar_ultimo: la lista está vacía\") }\n    retornar vec_quitar_ultimo(dyn_dato(l))\n}\n\nfuncion piso(v) {\n    si (dyn_gr_es_entero(v)) { retornar v }\n    sea x = dyn_a_f64(v)\n    sea e = __f64_a_entero(x)\n    si (__f64_menor(x, __f64_desde_entero(e))) { e = e - 1 }\n    retornar dyn_entero(e)\n}\n\nfuncion techo(v) {\n    si (dyn_gr_es_entero(v)) { retornar v }\n    sea x = dyn_a_f64(v)\n    sea e = __f64_a_entero(x)\n    si (__f64_menor(__f64_desde_entero(e), x)) { e = e + 1 }\n    retornar dyn_entero(e)\n}\n\nfuncion a_numero(v) {\n    si (dyn_es_numero(v)) { retornar v }\n    sea s = dyn_texto_de(v, \"a_numero\")\n    sea i = 0\n    sea n = str_largo(s)\n    sea negativo = 0\n    si (n > 0 y (str_byte(s, 0) == 45 o str_byte(s, 0) == 43)) {\n        negativo = str_byte(s, 0) == 45\n        i = 1\n    }\n    // Solo cifras y más de 18: entero exacto (sin límite).\n    si (n - i > 18) {\n        sea todas = 1\n        sea k = i\n        mientras (k < n y todas) {\n            si (str_byte(s, k) < 48 o str_byte(s, k) > 57) { todas = 0 }\n            k = k + 1\n        }\n        si (todas) { retornar dyn_gr_desde_cifras(s, i, n, negativo) }\n    }\n    // M con hasta 18 cifras significativas y exponente decimal E.\n    sea m = 0\n    sea e = 0\n    sea cifras = 0\n    sea digitos = 0\n    mientras (i < n y str_byte(s, i) >= 48 y str_byte(s, i) <= 57) {\n        si (cifras < 18) {\n            m = m * 10 + str_byte(s, i) - 48\n            si (m > 0) { cifras = cifras + 1 }\n        } sino { e = e + 1 }\n        digitos = digitos + 1\n        i = i + 1\n    }\n    si (i < n y str_byte(s, i) == 46) {\n        i = i + 1\n        mientras (i < n y str_byte(s, i) >= 48 y str_byte(s, i) <= 57) {\n            si (cifras < 18) {\n                m = m * 10 + str_byte(s, i) - 48\n                e = e - 1\n                si (m > 0) { cifras = cifras + 1 }\n            }\n            digitos = digitos + 1\n            i = i + 1\n        }\n    }\n    si (digitos > 0 y i < n y (str_byte(s, i) == 101 o str_byte(s, i) == 69)) {\n        sea j = i + 1\n        sea signo = 1\n        si (j < n y (str_byte(s, j) == 45 o str_byte(s, j) == 43)) {\n            si (str_byte(s, j) == 45) { signo = 0 - 1 }\n            j = j + 1\n        }\n        sea x = 0\n        sea hay = 0\n        mientras (j < n y str_byte(s, j) >= 48 y str_byte(s, j) <= 57) {\n            si (x < 100000) { x = x * 10 + str_byte(s, j) - 48 }\n            hay = 1\n            j = j + 1\n        }\n        si (hay) {\n            e = e + signo * x\n            i = j\n        }\n    }\n    si (digitos == 0 o i != n) { dyn_error(str_concatenar(\"no es un número: \", s)) }\n    sea valor = rt_decimal_a_f64(m, e)\n    si (negativo) { valor = __f64_resta(__f64_desde_entero(0), valor) }\n    retornar dyn_desde_f64(valor)\n}\n\n// cociente(a, b): división entera truncada (7, 2 → 3; -7, 2 → -3). El\n// compilador la hace en línea cuando los dos son enteros.\nfuncion cociente(a, b) {\n    si (__y_bits(a, 1) == 1 y __y_bits(b, 1) == 1) {\n        si (dyn_valor_entero(b) == 0) { dyn_error(\"división por cero\") }\n        sea x = dyn_valor_entero(a)\n        sea y = dyn_valor_entero(b)\n        si (y == 0 - 1) { retornar dyn_resta_entera(1, a) }       // -MIN no cabe\n        retornar dyn_entero(x / y)\n    }\n    si (dyn_ambos_enteros_gr(a, b)) { retornar dyn_gr_op_dividir(a, b, 0) }\n    sea x = dyn_a_f64(a)\n    sea y = dyn_a_f64(b)\n    retornar dyn_entero(__f64_a_entero(__f64_div(x, y)))\n}\n\n// Operaciones de bits entre enteros (el compilador las hace en línea).\nfuncion bits_entero(v, que) {\n    // Entero grande: sus 64 bits bajos en complemento a dos (como el\n    // desborde de antes), para que el código de hash y cifrado que hace\n    // x * y y luego enmascara con bits_y siga dando lo mismo.\n    si (dyn_tipo(v) == 12) { retornar dyn_gr_bajos64(dyn_dato(v)) }\n    si (__y_bits(v, 1) != 1) { dyn_error(str_concatenar(que, \": se esperaban enteros\")) }\n    retornar dyn_valor_entero(v)\n}\nfuncion bits_y(a, b) { retornar dyn_entero_de_crudo(__y_bits(bits_entero(a, \"bits_y\"), bits_entero(b, \"bits_y\"))) }\nfuncion bits_o(a, b) { retornar dyn_entero_de_crudo(__o_bits(bits_entero(a, \"bits_o\"), bits_entero(b, \"bits_o\"))) }\nfuncion bits_xo(a, b) { retornar dyn_entero_de_crudo(__xo_bits(bits_entero(a, \"bits_xo\"), bits_entero(b, \"bits_xo\"))) }\n\n// Entero crudo de 64 bits → valor del lenguaje (chico o grande).\nfuncion dyn_entero_de_crudo(x) {\n    si (x >= 0 - 4611686018427387904 y x < 4611686018427387904) { retornar dyn_entero(x) }\n    retornar dyn_gr_valor(dyn_gr_desde_crudo(x))\n}\n\nfuncion tipo_de(v) { retornar dyn_texto(dyn_nombre_tipo(v)) }\n\nfuncion dyn_cambiar_letras(v, desde, hasta, operacion) {\n    sea s = dyn_texto_de(v, operacion)\n    sea r = str_nuevo(str_largo(s))\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        sea b = str_byte(s, i)\n        si (b >= desde y b <= hasta) { b = __xo_bits(b, 32) }\n        str_agregar_byte(r, b)\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion texto_mayusculas(v) { retornar dyn_cambiar_letras(v, 97, 122, \"texto_mayusculas\") }\nfuncion texto_minusculas(v) { retornar dyn_cambiar_letras(v, 65, 90, \"texto_minusculas\") }\n\n// ── Punteros de bloques inseguro (con límites verificados) ───────────────\n\nfuncion dyn_puntero(bloque, desplazamiento) {\n    sea r = mem_reservar(16)\n    __guardar64(r, bloque)\n    __guardar64(r + 8, desplazamiento)\n    retornar dyn_caja(8, r)\n}\n\n// @x: puntero al inicio de un bloque (lista) o el mismo puntero.\nfuncion dyn_direccion(v) {\n    si (dyn_tipo(v) == 8) { retornar v }\n    si (dyn_tipo(v) != 2) { dyn_error_tipo(\"@ requiere un bloque de memoria\", v) }\n    retornar dyn_puntero(v, 0)\n}\n\nfuncion dyn_posicion_puntero(p) {\n    si (dyn_tipo(p) != 8) { dyn_error_tipo(\"* requiere un puntero\", p) }\n    sea bloque = __cargar64(dyn_dato(p))\n    sea i = __cargar64(dyn_dato(p) + 8)\n    si (i < 0 o i >= vec_largo(dyn_dato(bloque))) { dyn_error(\"acceso inseguro fuera del bloque de memoria\") }\n    retornar i\n}\n\nfuncion dyn_leer_puntero(p) {\n    sea i = dyn_posicion_puntero(p)\n    retornar vec_obtener(dyn_dato(__cargar64(dyn_dato(p))), i)\n}\n\nfuncion dyn_escribir_puntero(p, v) {\n    sea i = dyn_posicion_puntero(p)\n    vec_fijar(dyn_dato(__cargar64(dyn_dato(p))), i, v)\n    retornar 0\n}\n\nfuncion memoria_asignar(n) {\n    sea r = vec_nuevo()\n    sea i = 0\n    mientras (i < dyn_valor_entero(n)) {\n        vec_agregar(r, 1)\n        i = i + 1\n    }\n    retornar dyn_caja(2, r)\n}\n\nfuncion memoria_liberar(bloque) {\n    si (dyn_tipo(bloque) == 2) { __guardar64(dyn_dato(bloque), 0) }\n    retornar 0\n}\n\n// ── comptime ──────────────────────────────────────────────────────────────\n// El compilador ejecuta comptime(expr) en un subproceso; el valor vuelve como\n// un literal del lenguaje (nulo, booleano, número, texto, lista o mapa).\n\nfuncion comptime_literal(v) {\n    sea s = str_nuevo(64)\n    comptime_escribir(s, v)\n    retornar dyn_texto(s)\n}\n\nfuncion comptime_escribir(s, v) {\n    sea t = dyn_tipo(v)\n    si (t == 0) { str_agregar(s, \"nulo\") retornar 0 }\n    si (v == 4) { str_agregar(s, \"verdadero\") retornar 0 }\n    si (v == 2) { str_agregar(s, \"falso\") retornar 0 }\n    si (t == 6 o t == 12) { str_agregar(s, dyn_a_str(v)) retornar 0 }\n    si (t == 4) {\n        sea n = dyn_a_str(v)\n        sea i = 0\n        sea decimal = 0\n        mientras (i < str_largo(n)) {\n            sea b = str_byte(n, i)\n            si (b == 46 o b == 101 o b == 69) { decimal = 1 }\n            si (b == 110 o b == 105) { dyn_error(\"comptime: un número no finito no se puede escribir como literal\") }\n            i = i + 1\n        }\n        str_agregar(s, n)\n        si (decimal == 0) { str_agregar(s, \".0\") }\n        retornar 0\n    }\n    si (t == 1) {\n        sea x = dyn_dato(v)\n        str_agregar_byte(s, 34)\n        sea i = 0\n        mientras (i < str_largo(x)) {\n            sea b = str_byte(x, i)\n            si (b == 34 o b == 92 o b == 123) {\n                str_agregar_byte(s, 92)\n                str_agregar_byte(s, b)\n            } sino {\n                si (b == 10) { str_agregar(s, \"\\\\n\") } sino {\n                    si (b == 9) { str_agregar(s, \"\\\\t\") } sino {\n                        si (b == 13) { str_agregar(s, \"\\\\r\") } sino { str_agregar_byte(s, b) }\n                    }\n                }\n            }\n            i = i + 1\n        }\n        str_agregar_byte(s, 34)\n        retornar 0\n    }\n    si (t == 2) {\n        sea l = dyn_dato(v)\n        str_agregar(s, \"[\")\n        sea i = 0\n        mientras (i < vec_largo(l)) {\n            si (i > 0) { str_agregar(s, \", \") }\n            comptime_escribir(s, vec_obtener(l, i))\n            i = i + 1\n        }\n        str_agregar(s, \"]\")\n        retornar 0\n    }\n    si (t == 3) {\n        sea m = dyn_dato(v)\n        si (map_tiene(m, \"__clase\")) { dyn_error(\"comptime: un objeto no se puede escribir como literal (usa listas o mapas)\") }\n        sea k = dyn_claves_ordenadas(m)\n        str_agregar(s, \"{\")\n        sea i = 0\n        mientras (i < vec_largo(k)) {\n            si (i > 0) { str_agregar(s, \", \") }\n            comptime_escribir(s, dyn_texto(vec_obtener(k, i)))\n            str_agregar(s, \": \")\n            comptime_escribir(s, map_obtener(m, vec_obtener(k, i)))\n            i = i + 1\n        }\n        str_agregar(s, \"}\")\n        retornar 0\n    }\n    dyn_error_tipo(\"comptime: no se puede escribir como literal\", v)\n    retornar 0\n}\n\n// ── Enteros sin límite ───────────────────────────────────────────────────\n// Un entero chico es una palabra etiquetada (n·2+1, rango [-2^62, 2^62)).\n// Si una operación no cabe, el resultado es una caja de tipo 12 con\n// [signo (1 o -1)][n][cifras]* en base 10^9, de la menos significativa a la\n// más significativa y sin ceros a la izquierda. Al volver a caber, el\n// resultado se normaliza a entero chico: un mismo número tiene siempre una\n// sola representación.\n\nfuncion dyn_gr_base() { retornar 1000000000 }\n\nfuncion dyn_gr_nuevo(n) {\n    sea g = mem_reservar(16 + n * 8)\n    __guardar64(g, 1)\n    __guardar64(g + 8, n)\n    sea i = 0\n    mientras (i < n) {\n        __guardar64(g + 16 + i * 8, 0)\n        i = i + 1\n    }\n    retornar g\n}\nfuncion dyn_gr_signo(g) { retornar __cargar64(g) }\nfuncion dyn_gr_largo(g) { retornar __cargar64(g + 8) }\nfuncion dyn_gr_cifra(g, i) {\n    si (i >= __cargar64(g + 8)) { retornar 0 }\n    retornar __cargar64(g + 16 + i * 8)\n}\nfuncion dyn_gr_fijar(g, i, d) { __guardar64(g + 16 + i * 8, d) retornar 0 }\n\n// Entero crudo de 64 bits (incluido el mínimo) → grande.\nfuncion dyn_gr_desde_crudo(x) {\n    sea g = dyn_gr_nuevo(3)\n    si (x < 0) { __guardar64(g, 0 - 1) }\n    sea i = 0\n    mientras (x != 0) {\n        sea d = x % 1000000000\n        si (d < 0) { d = 0 - d }\n        dyn_gr_fijar(g, i, d)\n        x = x / 1000000000\n        i = i + 1\n    }\n    __guardar64(g + 8, i)\n    retornar g\n}\n\n// ¿Es un entero del lenguaje (chico o grande)?\nfuncion dyn_gr_es_entero(v) {\n    si (__y_bits(v, 1) == 1) { retornar 1 }\n    retornar dyn_tipo(v) == 12\n}\n\nfuncion dyn_gr_de(v) {\n    si (__y_bits(v, 1) == 1) { retornar dyn_gr_desde_crudo(dyn_valor_entero(v)) }\n    retornar dyn_dato(v)\n}\n\n// Quita ceros a la izquierda y devuelve el valor del lenguaje: entero chico\n// si cabe, si no la caja.\nfuncion dyn_gr_valor(g) {\n    sea n = dyn_gr_largo(g)\n    mientras (n > 0 y dyn_gr_cifra(g, n - 1) == 0) { n = n - 1 }\n    __guardar64(g + 8, n)\n    si (n == 0) { retornar 1 }\n    si (n <= 3 y dyn_gr_cifra(g, 2) <= 4) {\n        sea m = dyn_gr_cifra(g, 2) * 1000000000000000000 + dyn_gr_cifra(g, 1) * 1000000000 + dyn_gr_cifra(g, 0)\n        sea limite = 4611686018427387904\n        si (dyn_gr_signo(g) > 0 y m < limite) { retornar dyn_entero(m) }\n        si (dyn_gr_signo(g) < 0 y m <= limite) { retornar dyn_entero(0 - m) }\n    }\n    retornar dyn_caja(12, g)\n}\n\n// Compara magnitudes: -1, 0 o 1.\nfuncion dyn_gr_comparar_mag(a, b) {\n    sea na = dyn_gr_largo(a)\n    sea nb = dyn_gr_largo(b)\n    si (na != nb) {\n        si (na < nb) { retornar 0 - 1 }\n        retornar 1\n    }\n    sea i = na - 1\n    mientras (i >= 0) {\n        sea x = dyn_gr_cifra(a, i)\n        sea y = dyn_gr_cifra(b, i)\n        si (x < y) { retornar 0 - 1 }\n        si (x > y) { retornar 1 }\n        i = i - 1\n    }\n    retornar 0\n}\n\nfuncion dyn_gr_es_cero(g) { retornar dyn_gr_largo(g) == 0 }\n\nfuncion dyn_gr_comparar(a, b) {\n    sea sa = dyn_gr_signo(a)\n    sea sb = dyn_gr_signo(b)\n    si (dyn_gr_es_cero(a)) { sa = 0 }\n    si (dyn_gr_es_cero(b)) { sb = 0 }\n    si (sa != sb) {\n        si (sa < sb) { retornar 0 - 1 }\n        retornar 1\n    }\n    si (sa == 0) { retornar 0 }\n    retornar dyn_gr_comparar_mag(a, b) * sa\n}\n\n// |a| + |b| con signo s.\nfuncion dyn_gr_sumar_mag(a, b, s) {\n    sea n = dyn_gr_maximo(dyn_gr_largo(a), dyn_gr_largo(b)) + 1\n    sea r = dyn_gr_nuevo(n)\n    __guardar64(r, s)\n    sea acarreo = 0\n    sea i = 0\n    mientras (i < n) {\n        sea t = dyn_gr_cifra(a, i) + dyn_gr_cifra(b, i) + acarreo\n        acarreo = 0\n        si (t >= 1000000000) {\n            t = t - 1000000000\n            acarreo = 1\n        }\n        dyn_gr_fijar(r, i, t)\n        i = i + 1\n    }\n    retornar r\n}\n\n// |a| - |b| (|a| >= |b|) con signo s.\nfuncion dyn_gr_restar_mag(a, b, s) {\n    sea n = dyn_gr_largo(a)\n    sea r = dyn_gr_nuevo(n)\n    __guardar64(r, s)\n    sea prestamo = 0\n    sea i = 0\n    mientras (i < n) {\n        sea t = dyn_gr_cifra(a, i) - dyn_gr_cifra(b, i) - prestamo\n        prestamo = 0\n        si (t < 0) {\n            t = t + 1000000000\n            prestamo = 1\n        }\n        dyn_gr_fijar(r, i, t)\n        i = i + 1\n    }\n    retornar r\n}\n\nfuncion dyn_gr_maximo(a, b) {\n    si (a > b) { retornar a }\n    retornar b\n}\n\n// a + b·sb (sb = 1 suma, -1 resta).\nfuncion dyn_gr_sumar(a, b, sb) {\n    sea signo_b = dyn_gr_signo(b) * sb\n    si (dyn_gr_signo(a) == signo_b) { retornar dyn_gr_sumar_mag(a, b, dyn_gr_signo(a)) }\n    sea c = dyn_gr_comparar_mag(a, b)\n    si (c == 0) { retornar dyn_gr_nuevo(0) }\n    si (c > 0) { retornar dyn_gr_restar_mag(a, b, dyn_gr_signo(a)) }\n    retornar dyn_gr_restar_mag(b, a, signo_b)\n}\n\n// Multiplicación de magnitudes sobre cifras crudas (base 10^9).\n// r[0..na+nb) = a[0..na) · b[0..nb). Escolar para operandos chicos y\n// Karatsuba para los grandes; tmp es memoria de trabajo (≥ 4·max + 256).\nfuncion dyn_gr_mul_escolar(r, a, na, b, nb) {\n    // Por columnas: cada producto (< 2^60) se parte en 32 bits altos y bajos\n    // y la división por 10^9 se hace una vez por columna, no por producto.\n    // Requiere min(na, nb) < 2^20 (aquí siempre es < 64).\n    si (na < nb) { retornar dyn_gr_mul_escolar(r, b, nb, a, na) }\n    sea mascara = 4294967295\n    sea acarreo = 0\n    sea n = na + nb\n    sea k = 0\n    mientras (k < n - 1) {\n        sea lo = acarreo\n        sea hi = 0\n        sea i = 0\n        si (k >= nb) { i = k - nb + 1 }\n        sea fin = k\n        si (fin > na - 1) { fin = na - 1 }\n        sea pa = a + i * 8\n        sea pb = b + (k - i) * 8\n        mientras (i <= fin) {\n            sea p = __cargar64(pa) * __cargar64(pb)\n            lo = lo + __y_bits(p, mascara)\n            hi = hi + __desplazar_der(p, 32)\n            pa = pa + 8\n            pb = pb - 8\n            i = i + 1\n        }\n        hi = hi + __desplazar_der(lo, 32)\n        lo = __y_bits(lo, mascara)\n        sea hq = hi / 1000000000\n        sea medio = (hi - hq * 1000000000) * 4294967296 + lo\n        sea mq = medio / 1000000000\n        __guardar64(r + k * 8, medio - mq * 1000000000)\n        acarreo = hq * 4294967296 + mq\n        k = k + 1\n    }\n    __guardar64(r + (n - 1) * 8, acarreo)\n    retornar 0\n}\n\n// r[0..n) += x[0..nx) (nx <= n); el acarreo que sobra se descarta.\nfuncion dyn_gr_sumar_en(r, n, x, nx) {\n    sea acarreo = 0\n    sea i = 0\n    mientras (i < nx o (acarreo != 0 y i < n)) {\n        sea t = __cargar64(r + i * 8) + acarreo\n        si (i < nx) { t = t + __cargar64(x + i * 8) }\n        acarreo = 0\n        si (t >= 1000000000) {\n            t = t - 1000000000\n            acarreo = 1\n        }\n        __guardar64(r + i * 8, t)\n        i = i + 1\n    }\n    retornar 0\n}\n\n// r[0..n) -= x[0..nx) (el resultado no es negativo).\nfuncion dyn_gr_restar_en(r, n, x, nx) {\n    sea prestamo = 0\n    sea i = 0\n    mientras (i < nx o (prestamo != 0 y i < n)) {\n        sea t = __cargar64(r + i * 8) - prestamo\n        si (i < nx) { t = t - __cargar64(x + i * 8) }\n        prestamo = 0\n        si (t < 0) {\n            t = t + 1000000000\n            prestamo = 1\n        }\n        __guardar64(r + i * 8, t)\n        i = i + 1\n    }\n    retornar 0\n}\n\n// s[0..m+1) = x[0..m) + y[0..ny) (ny <= m).\nfuncion dyn_gr_sumar_mitades(s, x, m, y, ny) {\n    sea acarreo = 0\n    sea i = 0\n    mientras (i < m) {\n        sea t = __cargar64(x + i * 8) + acarreo\n        si (i < ny) { t = t + __cargar64(y + i * 8) }\n        acarreo = 0\n        si (t >= 1000000000) {\n            t = t - 1000000000\n            acarreo = 1\n        }\n        __guardar64(s + i * 8, t)\n        i = i + 1\n    }\n    __guardar64(s + m * 8, acarreo)\n    retornar 0\n}\n\nfuncion dyn_gr_kara(r, a, na, b, nb, tmp) {\n    si (na < nb) { retornar dyn_gr_kara(r, b, nb, a, na, tmp) }\n    si (nb < 48) { retornar dyn_gr_mul_escolar(r, a, na, b, nb) }\n    si (na >= 2 * nb) {\n        // Desbalanceado: a por trozos del largo de b.\n        sea i = 0\n        mientras (i < na + nb) {\n            __guardar64(r + i * 8, 0)\n            i = i + 1\n        }\n        sea prod = tmp\n        sea resto = tmp + (2 * nb + 2) * 8\n        sea off = 0\n        mientras (off < na) {\n            sea largo = nb\n            si (na - off < largo) { largo = na - off }\n            dyn_gr_kara(prod, a + off * 8, largo, b, nb, resto)\n            dyn_gr_sumar_en(r + off * 8, na + nb - off, prod, largo + nb)\n            off = off + nb\n        }\n        retornar 0\n    }\n    sea m = (na + 1) / 2\n    // z0 en r[0..2m), z2 en r[2m..na+nb)\n    dyn_gr_kara(r, a, m, b, m, tmp)\n    dyn_gr_kara(r + 2 * m * 8, a + m * 8, na - m, b + m * 8, nb - m, tmp)\n    sea sa = tmp\n    sea sb = tmp + (m + 1) * 8\n    sea z1 = tmp + (2 * m + 2) * 8\n    dyn_gr_sumar_mitades(sa, a, m, a + m * 8, na - m)\n    dyn_gr_sumar_mitades(sb, b, m, b + m * 8, nb - m)\n    dyn_gr_kara(z1, sa, m + 1, sb, m + 1, tmp + (4 * m + 4) * 8)\n    dyn_gr_restar_en(z1, 2 * m + 2, r, 2 * m)\n    dyn_gr_restar_en(z1, 2 * m + 2, r + 2 * m * 8, na + nb - 2 * m)\n    // z1 cabe en na + nb - m cifras (las de arriba son cero)\n    sea nz = 2 * m + 2\n    si (nz > na + nb - m) { nz = na + nb - m }\n    dyn_gr_sumar_en(r + m * 8, na + nb - m, z1, nz)\n    retornar 0\n}\n\n// ── Multiplicación por NTT (operandos muy grandes) ───────────────────────\n// Convolución exacta con tres primos p = c·2^k + 1 (< 2^30) y reconstrucción\n// por CRT (Garner) a base 10^9. Los productos modulares usan Montgomery con\n// R = 2^32 (sin divisiones). Cota: cada coeficiente < 10^18 · min(na, nb)\n// < p1·p2·p3 ≈ 5,9·10^25 mientras min(na, nb) < 5·10^7 cifras.\n\n// Montgomery: a·b·2^-32 mod p (a, b < p < 2^30).\nfuncion dyn_gr_mont(a, b, p, np) {\n    sea t = a * b\n    sea m = __y_bits(__y_bits(t, 4294967295) * np, 4294967295)\n    t = __desplazar_der(t + m * p, 32)\n    si (t >= p) { t = t - p }\n    retornar t\n}\n\n// -p^-1 mod 2^32 (p impar).\nfuncion dyn_gr_mont_np(p) {\n    sea inv = p\n    sea i = 0\n    mientras (i < 5) {\n        sea x = __y_bits(p * inv, 4294967295)\n        inv = __y_bits(inv * __y_bits(2 - x, 4294967295), 4294967295)\n        i = i + 1\n    }\n    retornar __y_bits(4294967296 - inv, 4294967295)\n}\n\nfuncion dyn_gr_potmod(b, e, p) {\n    sea r = 1\n    b = b % p\n    mientras (e > 0) {\n        si (__y_bits(e, 1) == 1) { r = r * b % p }\n        b = b * b % p\n        e = __desplazar_der(e, 1)\n    }\n    retornar r\n}\n\n// Transformada en el sitio de x[0..n) (n potencia de 2). raices[j] = w^j·R,\n// j < n/2, con w raíz n-ésima primitiva (o su inversa), en forma Montgomery.\nfuncion dyn_gr_ntt(x, n, p, np, raices) {\n    // permutación por inversión de bits\n    sea j = 0\n    sea i = 1\n    mientras (i < n) {\n        sea bit = __desplazar_der(n, 1)\n        mientras (__y_bits(j, bit) != 0) {\n            j = j - bit\n            bit = __desplazar_der(bit, 1)\n        }\n        j = j + bit\n        si (i < j) {\n            sea t = __cargar64(x + i * 8)\n            __guardar64(x + i * 8, __cargar64(x + j * 8))\n            __guardar64(x + j * 8, t)\n        }\n        i = i + 1\n    }\n    sea largo = 2\n    mientras (largo <= n) {\n        sea mitad = __desplazar_der(largo, 1)\n        sea paso = (n / largo) * 8\n        sea bloque = 0\n        mientras (bloque < n) {\n            sea pu = x + bloque * 8\n            sea pv = pu + mitad * 8\n            sea pw = raices\n            sea k = 0\n            mientras (k < mitad) {\n                sea u = __cargar64(pu)\n                sea t = __cargar64(pv) * __cargar64(pw)\n                sea m = __y_bits(__y_bits(t, 4294967295) * np, 4294967295)\n                sea v = __desplazar_der(t + m * p, 32)\n                si (v >= p) { v = v - p }\n                sea s = u + v\n                si (s >= p) { s = s - p }\n                sea d = u - v\n                si (d < 0) { d = d + p }\n                __guardar64(pu, s)\n                __guardar64(pv, d)\n                pu = pu + 8\n                pv = pv + 8\n                pw = pw + paso\n                k = k + 1\n            }\n            bloque = bloque + largo\n        }\n        largo = largo * 2\n    }\n    retornar 0\n}\n\nfuncion dyn_gr_raices(raices, n, p, w) {\n    sea r = 4294967296 % p\n    sea j = 0\n    mientras (j < __desplazar_der(n, 1)) {\n        __guardar64(raices + j * 8, r)\n        r = r * w % p\n        j = j + 1\n    }\n    retornar 0\n}\n\n// Convolución de a y b (cifras crudas) módulo p en sal[0..n).\nfuncion dyn_gr_conv_mod(sal, a, na, b, nb, n, p, g, aux, raices) {\n    sea i = 0\n    mientras (i < n) {\n        sea v = 0\n        si (i < na) { v = __cargar64(a + i * 8) % p }\n        __guardar64(sal + i * 8, v)\n        i = i + 1\n    }\n    sea np = dyn_gr_mont_np(p)\n    sea w = dyn_gr_potmod(g, (p - 1) / n, p)\n    dyn_gr_raices(raices, n, p, w)\n    dyn_gr_ntt(sal, n, p, np, raices)\n    si (a == b y na == nb) {\n        i = 0\n        mientras (i < n) {\n            sea v = __cargar64(sal + i * 8)\n            __guardar64(sal + i * 8, dyn_gr_mont(v, v, p, np))\n            i = i + 1\n        }\n    } sino {\n        i = 0\n        mientras (i < n) {\n            sea v = 0\n            si (i < nb) { v = __cargar64(b + i * 8) % p }\n            __guardar64(aux + i * 8, v)\n            i = i + 1\n        }\n        dyn_gr_ntt(aux, n, p, np, raices)\n        i = 0\n        mientras (i < n) {\n            __guardar64(sal + i * 8, dyn_gr_mont(__cargar64(sal + i * 8), __cargar64(aux + i * 8), p, np))\n            i = i + 1\n        }\n    }\n    dyn_gr_raices(raices, n, p, dyn_gr_potmod(w, p - 2, p))\n    dyn_gr_ntt(sal, n, p, np, raices)\n    // valores = n·conv·R^-1: se escalan por n^-1·R² con un producto Montgomery\n    sea rr = 4294967296 % p\n    sea escala = dyn_gr_potmod(n, p - 2, p) * (rr * rr % p) % p\n    i = 0\n    mientras (i < n) {\n        __guardar64(sal + i * 8, dyn_gr_mont(__cargar64(sal + i * 8), escala, p, np))\n        i = i + 1\n    }\n    retornar 0\n}\n\n// r[0..na+nb) = a · b por NTT.\nfuncion dyn_gr_mul_ntt(r, a, na, b, nb) {\n    sea n = 1\n    mientras (n < na + nb) { n = n * 2 }\n    sea p1 = 469762049\n    sea p2 = 754974721\n    sea p3 = 167772161\n    sea bloque = mem_reservar(n * 8 * 5)\n    sea c1 = bloque\n    sea c2 = bloque + n * 8\n    sea c3 = bloque + n * 16\n    sea aux = bloque + n * 24\n    sea raices = bloque + n * 32\n    dyn_gr_conv_mod(c1, a, na, b, nb, n, p1, 3, aux, raices)\n    dyn_gr_conv_mod(c2, a, na, b, nb, n, p2, 11, aux, raices)\n    dyn_gr_conv_mod(c3, a, na, b, nb, n, p3, 3, aux, raices)\n    // Garner: x = r1 + p1·(t2 + p2·t3)\n    sea inv_p1_p2 = dyn_gr_potmod(p1 % p2, p2 - 2, p2)\n    sea p1p2_p3 = (p1 % p3) * (p2 % p3) % p3\n    sea inv_p1p2_p3 = dyn_gr_potmod(p1p2_p3, p3 - 2, p3)\n    sea base = 1000000000\n    // p1 = p1_hi·10^9 + p1_lo ; p1·p2 = q_hi·10^9 + q_lo\n    sea p1p2 = p1 * p2\n    sea q_hi = p1p2 / base\n    sea q_lo = p1p2 - q_hi * base\n    // acarreo de 3 cifras en base 10^9 (c0 + c1·B + c2·B²)\n    sea k0 = 0\n    sea k1 = 0\n    sea k2 = 0\n    sea total = na + nb\n    sea i = 0\n    mientras (i < total) {\n        sea r1 = __cargar64(c1 + i * 8)\n        sea r2 = __cargar64(c2 + i * 8)\n        sea r3 = __cargar64(c3 + i * 8)\n        sea t2 = (r2 - r1 % p2 + p2) % p2 * inv_p1_p2 % p2\n        // x mod p3 con lo ya conocido\n        sea y = (r1 % p3 + (p1 % p3) * t2) % p3\n        sea t3 = (r3 - y + p3) % p3 * inv_p1p2_p3 % p3\n        // x = r1 + p1·t2 + p1p2·t3  (en base 10^9 sumado al acarreo)\n        sea x01 = r1 + p1 * t2\n        sea d0 = k0 + x01 % base + q_lo * (t3 % base)\n        sea d1 = k1 + x01 / base + q_hi * (t3 % base) + q_lo * (t3 / base)\n        sea d2 = k2 + q_hi * (t3 / base)\n        // normalizar: d0 → cifra\n        sea c = d0 / base\n        __guardar64(r + i * 8, d0 - c * base)\n        d1 = d1 + c\n        c = d1 / base\n        k0 = d1 - c * base\n        d2 = d2 + c\n        c = d2 / base\n        k1 = d2 - c * base\n        k2 = c\n        i = i + 1\n    }\n    mem_liberar(bloque)\n    retornar 0\n}\n\nfuncion dyn_gr_multiplicar(a, b) {\n    sea na = dyn_gr_largo(a)\n    sea nb = dyn_gr_largo(b)\n    sea r = dyn_gr_nuevo(na + nb)\n    __guardar64(r, dyn_gr_signo(a) * dyn_gr_signo(b))\n    si (na == 0 o nb == 0) { retornar r }\n    sea mayor = na\n    si (nb > mayor) { mayor = nb }\n    si (na < 48 o nb < 48) {\n        dyn_gr_mul_escolar(r + 16, a + 16, na, b + 16, nb)\n        retornar r\n    }\n    si (na >= 1500 y nb >= 1500) {\n        dyn_gr_mul_ntt(r + 16, a + 16, na, b + 16, nb)\n        retornar r\n    }\n    sea tmp = mem_reservar((4 * mayor + 256) * 8)\n    dyn_gr_kara(r + 16, a + 16, na, b + 16, nb, tmp)\n    mem_liberar(tmp)\n    retornar r\n}\n\n// |g| · d + k con d, k < 10^9 (en una caja nueva, signo 1).\nfuncion dyn_gr_mul_chico(g, d) {\n    sea n = dyn_gr_largo(g)\n    sea r = dyn_gr_nuevo(n + 1)\n    sea acarreo = 0\n    sea i = 0\n    mientras (i < n) {\n        sea t = dyn_gr_cifra(g, i) * d + acarreo\n        acarreo = t / 1000000000\n        dyn_gr_fijar(r, i, t % 1000000000)\n        i = i + 1\n    }\n    dyn_gr_fijar(r, n, acarreo)\n    sea m = n + 1\n    mientras (m > 0 y dyn_gr_cifra(r, m - 1) == 0) { m = m - 1 }\n    __guardar64(r + 8, m)\n    retornar r\n}\n\n// División truncada de magnitudes: devuelve [cociente][resto] (signo 1).\n// División larga en base 10^9; cada cifra del cociente se busca por\n// bisección (30 pasos), simple y exacta.\nfuncion dyn_gr_dividir_mag(a, b) {\n    sea na = dyn_gr_largo(a)\n    sea q = dyn_gr_nuevo(na)\n    sea resto = dyn_gr_nuevo(0)\n    sea i = na - 1\n    mientras (i >= 0) {\n        // resto = resto · 10^9 + a[i]\n        sea nr = dyn_gr_nuevo(dyn_gr_largo(resto) + 1)\n        dyn_gr_fijar(nr, 0, dyn_gr_cifra(a, i))\n        sea j = 0\n        mientras (j < dyn_gr_largo(resto)) {\n            dyn_gr_fijar(nr, j + 1, dyn_gr_cifra(resto, j))\n            j = j + 1\n        }\n        sea m = dyn_gr_largo(nr)\n        mientras (m > 0 y dyn_gr_cifra(nr, m - 1) == 0) { m = m - 1 }\n        __guardar64(nr + 8, m)\n        resto = nr\n        // mayor d con b·d <= resto\n        sea bajo = 0\n        sea alto = 999999999\n        mientras (bajo < alto) {\n            sea medio = (bajo + alto + 1) / 2\n            si (dyn_gr_comparar_mag(dyn_gr_mul_chico(b, medio), resto) <= 0) { bajo = medio } sino { alto = medio - 1 }\n        }\n        si (bajo > 0) { resto = dyn_gr_restar_mag(resto, dyn_gr_mul_chico(b, bajo), 1) }\n        sea mr = dyn_gr_largo(resto)\n        mientras (mr > 0 y dyn_gr_cifra(resto, mr - 1) == 0) { mr = mr - 1 }\n        __guardar64(resto + 8, mr)\n        dyn_gr_fijar(q, i, bajo)\n        i = i - 1\n    }\n    sea par = mem_reservar(16)\n    __guardar64(par, q)\n    __guardar64(par + 8, resto)\n    retornar par\n}\n\n// Operaciones con valores del lenguaje (al menos uno grande o desbordado).\nfuncion dyn_gr_op_suma(a, b) { retornar dyn_gr_valor(dyn_gr_sumar(dyn_gr_de(a), dyn_gr_de(b), 1)) }\nfuncion dyn_gr_op_resta(a, b) { retornar dyn_gr_valor(dyn_gr_sumar(dyn_gr_de(a), dyn_gr_de(b), 0 - 1)) }\nfuncion dyn_gr_op_mul(a, b) { retornar dyn_gr_valor(dyn_gr_multiplicar(dyn_gr_de(a), dyn_gr_de(b))) }\n\n// que: 0 cociente truncado · 1 resto (signo del dividendo).\nfuncion dyn_gr_op_dividir(a, b, que) {\n    sea x = dyn_gr_de(a)\n    sea y = dyn_gr_de(b)\n    si (dyn_gr_es_cero(y)) { dyn_error(\"división por cero\") }\n    sea par = dyn_gr_dividir_mag(x, y)\n    sea q = __cargar64(par)\n    sea r = __cargar64(par + 8)\n    __guardar64(q, dyn_gr_signo(x) * dyn_gr_signo(y))\n    __guardar64(r, dyn_gr_signo(x))\n    si (que == 0) { retornar dyn_gr_valor(q) }\n    retornar dyn_gr_valor(r)\n}\n\nfuncion dyn_gr_op_comparar(a, b) { retornar dyn_gr_comparar(dyn_gr_de(a), dyn_gr_de(b)) }\n\nfuncion dyn_gr_negar(v) {\n    sea g = dyn_gr_de(v)\n    sea r = dyn_gr_nuevo(dyn_gr_largo(g))\n    __guardar64(r, 0 - dyn_gr_signo(g))\n    sea i = 0\n    mientras (i < dyn_gr_largo(g)) {\n        dyn_gr_fijar(r, i, dyn_gr_cifra(g, i))\n        i = i + 1\n    }\n    retornar dyn_gr_valor(r)\n}\n\nfuncion dyn_gr_agregar_texto(s, g) {\n    sea n = dyn_gr_largo(g)\n    si (n == 0) {\n        str_agregar_byte(s, 48)\n        retornar 0\n    }\n    si (dyn_gr_signo(g) < 0) { str_agregar_byte(s, 45) }\n    str_agregar_entero(s, dyn_gr_cifra(g, n - 1))\n    sea i = n - 2\n    mientras (i >= 0) {\n        sea d = dyn_gr_cifra(g, i)\n        sea p = 100000000\n        mientras (p > 0) {\n            str_agregar_byte(s, 48 + (d / p) % 10)\n            p = p / 10\n        }\n        i = i - 1\n    }\n    retornar 0\n}\n\nfuncion dyn_gr_a_f64(g) {\n    sea x = __f64_desde_entero(0)\n    sea base = __f64_desde_entero(1000000000)\n    sea i = dyn_gr_largo(g) - 1\n    mientras (i >= 0) {\n        x = __f64_suma(__f64_mul(x, base), __f64_desde_entero(dyn_gr_cifra(g, i)))\n        i = i - 1\n    }\n    si (dyn_gr_signo(g) < 0) { x = __f64_resta(__f64_desde_entero(0), x) }\n    retornar x\n}\n\n// Cifras decimales s[desde, hasta) → valor del lenguaje (entero exacto).\nfuncion dyn_gr_desde_cifras(s, desde, hasta, negativo) {\n    sea n = (hasta - desde + 8) / 9\n    sea g = dyn_gr_nuevo(n)\n    si (negativo) { __guardar64(g, 0 - 1) }\n    sea i = 0\n    sea fin = hasta\n    mientras (i < n) {\n        sea ini = fin - 9\n        si (ini < desde) { ini = desde }\n        sea d = 0\n        sea k = ini\n        mientras (k < fin) {\n            d = d * 10 + str_byte(s, k) - 48\n            k = k + 1\n        }\n        dyn_gr_fijar(g, i, d)\n        fin = ini\n        i = i + 1\n    }\n    retornar dyn_gr_valor(g)\n}\n\n// Literal entero del código fuente que no cabe en un entero chico (el\n// compilador lo deja como texto de cifras).\nfuncion dyn_entero_literal(v) {\n    sea s = dyn_dato(v)\n    retornar dyn_gr_desde_cifras(s, 0, str_largo(s), 0)\n}\n\n// 64 bits bajos (complemento a dos) de un entero grande: la aritmética\n// nativa ya trabaja módulo 2^64.\nfuncion dyn_gr_bajos64(g) {\n    sea r = 0\n    sea i = dyn_gr_largo(g) - 1\n    mientras (i >= 0) {\n        r = r * 1000000000 + dyn_gr_cifra(g, i)\n        i = i - 1\n    }\n    si (dyn_gr_signo(g) < 0) { r = 0 - r }\n    retornar r\n}\n\n// Tope de elementos para crear de una vez (listas y textos): por encima la\n// memoria se agotaría igual, así que mejor un error claro que colgarse.\nfuncion dyn_max_elementos() { retornar 268435456 }\n\n// Ruta lenta de la comprobación de pila del compilador (comprobar_pila):\n// decide con precisión si la pila se acabó. Pilas ajenas (llamadas desde C\n// en hilos que no creó tarea()) no se comprueban.\nfuncion dyn_pila_lenta() {\n    sea sp = __pila()\n    sea registro = dyn_registro_hilo()\n    si (registro != 0) {\n        si (__y_bits(sp, 8388607) < 1048576) { dyn_error(\"desbordamiento de pila: recursión demasiado profunda\") }\n        retornar 0\n    }\n    sea base = mem_global(63)\n    si (sp <= base y base - sp < 67108864) { dyn_error(\"desbordamiento de pila: recursión demasiado profunda\") }\n    retornar 0\n}\n\n// ── Ordenamiento natural (ordenar sin función) ───────────────────────────\n// Mergesort estable de abajo arriba sobre las palabras crudas, con tramos\n// iniciales por inserción. Si todos son enteros chicos se comparan las\n// palabras directamente (la etiqueta n·2+1 conserva el orden). Para listas\n// mixtas hay un orden total: nulo < booleanos < números < textos < listas <\n// mapas < lo demás; dentro de un mismo tipo sin orden natural (listas,\n// mapas, funciones) se conserva el orden original.\n\nfuncion dyn_ord_rango(v) {\n    sea t = dyn_tipo(v)\n    si (t == 0) { retornar 0 }\n    si (t == 5) { retornar 1 }\n    si (t == 6 o t == 4 o t == 12) { retornar 2 }\n    si (t == 1) { retornar 3 }\n    si (t == 2) { retornar 4 }\n    si (t == 3) { retornar 5 }\n    retornar 6\n}\n\nfuncion dyn_ord_comparar(a, b) {\n    si (__y_bits(a, 1) == 1 y __y_bits(b, 1) == 1) {\n        si (a < b) { retornar 0 - 1 }\n        si (a > b) { retornar 1 }\n        retornar 0\n    }\n    sea ra = dyn_ord_rango(a)\n    sea rb = dyn_ord_rango(b)\n    si (ra != rb) {\n        si (ra < rb) { retornar 0 - 1 }\n        retornar 1\n    }\n    si (ra == 1) {\n        si (a < b) { retornar 0 - 1 }\n        si (a > b) { retornar 1 }\n        retornar 0\n    }\n    si (ra == 2 o ra == 3) { retornar dyn_comparar(a, b) }\n    retornar 0\n}\n\n// Inserción estable de x[desde..hasta).\nfuncion dyn_ord_insercion(x, desde, hasta, enteros) {\n    sea i = desde + 1\n    mientras (i < hasta) {\n        sea v = __cargar64(x + i * 8)\n        sea j = i - 1\n        si (enteros == 1) {\n            mientras (j >= desde y __cargar64(x + j * 8) > v) {\n                __guardar64(x + (j + 1) * 8, __cargar64(x + j * 8))\n                j = j - 1\n            }\n        } sino {\n            mientras (j >= desde y dyn_ord_comparar(__cargar64(x + j * 8), v) > 0) {\n                __guardar64(x + (j + 1) * 8, __cargar64(x + j * 8))\n                j = j - 1\n            }\n        }\n        __guardar64(x + (j + 1) * 8, v)\n        i = i + 1\n    }\n    retornar 0\n}\n\n// Mezcla estable de x[a..m) y x[m..b) en y[a..b).\nfuncion dyn_ord_mezclar(x, y, a, m, b, enteros) {\n    sea i = a\n    sea j = m\n    sea k = a\n    mientras (i < m y j < b) {\n        sea u = __cargar64(x + i * 8)\n        sea v = __cargar64(x + j * 8)\n        sea tomar_derecha = 0\n        si (enteros == 1) {\n            si (v < u) { tomar_derecha = 1 }\n        } sino {\n            si (dyn_ord_comparar(u, v) > 0) { tomar_derecha = 1 }\n        }\n        si (tomar_derecha == 1) {\n            __guardar64(y + k * 8, v)\n            j = j + 1\n        } sino {\n            __guardar64(y + k * 8, u)\n            i = i + 1\n        }\n        k = k + 1\n    }\n    mientras (i < m) {\n        __guardar64(y + k * 8, __cargar64(x + i * 8))\n        i = i + 1\n        k = k + 1\n    }\n    mientras (j < b) {\n        __guardar64(y + k * 8, __cargar64(x + j * 8))\n        j = j + 1\n        k = k + 1\n    }\n    retornar 0\n}\n\nfuncion dyn_ordenar_natural(l) {\n    si (dyn_tipo(l) != 2) { dyn_error_tipo(\"ordenar\", l) }\n    sea origen = dyn_dato(l)\n    sea n = vec_largo(origen)\n    // resultado: un vec propio con capacidad exacta\n    sea r = vec_nuevo()\n    sea cap = n\n    si (cap < 8) { cap = 8 }\n    mem_liberar(__cargar64(r + 16))\n    __guardar64(r + 16, mem_reservar(cap * 8))\n    __guardar64(r + 8, cap)\n    sea x = __cargar64(r + 16)\n    mem_copiar(x, __cargar64(origen + 16), n * 8)\n    __guardar64(r, n)\n    si (n < 2) { retornar dyn_caja(2, r) }\n    sea enteros = 1\n    sea i = 0\n    mientras (i < n) {\n        si (__y_bits(__cargar64(x + i * 8), 1) != 1) {\n            enteros = 0\n            romper\n        }\n        i = i + 1\n    }\n    // ¿ya ordenada? (caso común y barato de detectar)\n    sea ordenada = 1\n    i = 1\n    mientras (i < n) {\n        sea u = __cargar64(x + (i - 1) * 8)\n        sea v = __cargar64(x + i * 8)\n        si (enteros == 1) {\n            si (v < u) { ordenada = 0 }\n        } sino {\n            si (dyn_ord_comparar(u, v) > 0) { ordenada = 0 }\n        }\n        si (ordenada == 0) { romper }\n        i = i + 1\n    }\n    si (ordenada == 1) { retornar dyn_caja(2, r) }\n    sea tramo = 24\n    i = 0\n    mientras (i < n) {\n        sea fin = i + tramo\n        si (fin > n) { fin = n }\n        dyn_ord_insercion(x, i, fin, enteros)\n        i = fin\n    }\n    sea y = mem_reservar(n * 8)\n    sea a = x\n    sea b = y\n    sea ancho = tramo\n    mientras (ancho < n) {\n        sea inicio = 0\n        mientras (inicio < n) {\n            sea medio = inicio + ancho\n            sea fin = inicio + 2 * ancho\n            si (medio > n) { medio = n }\n            si (fin > n) { fin = n }\n            dyn_ord_mezclar(a, b, inicio, medio, fin, enteros)\n            inicio = fin\n        }\n        sea t = a\n        a = b\n        b = t\n        ancho = ancho * 2\n    }\n    si (a != x) { mem_copiar(x, a, n * 8) }\n    mem_liberar(y)\n    retornar dyn_caja(2, r)\n}\n\n// ── Concatenación de textos con búfer compartido ─────────────────────────\n// a + b copia a y b; en un bucle (t = t + x) eso es cuadrático. Cuando el\n// resultado pasa de 32 bytes se guarda en un búfer con el doble de\n// capacidad, marcado como compartido (propio = 2) y con un contador de bytes\n// usados al final del bloque. Si después se suma algo a un texto cuyo largo\n// coincide con lo usado del búfer (nadie escribió más allá), los bytes se\n// agregan en el mismo búfer y el texto nuevo es otra cabecera sobre él: los\n// textos anteriores siguen viendo solo su prefijo, que no cambia. Así una\n// cadena de sumas cuesta O(n) amortizado. str_c repone el 0 final si hace\n// falta (str_c_propio) y str_asegurar copia antes de modificar.\n\nfuncion dyn_cat_usado_dir(datos, cap) { retornar datos + __y_bits(cap + 8, 0 - 8) }\n\nfuncion dyn_cat_nuevo(cap) {\n    sea s = mem_reservar(32)\n    sea datos = mem_reservar(__y_bits(cap + 8, 0 - 8) + 8)\n    __guardar64(s, 0)\n    __guardar64(s + 8, cap)\n    __guardar64(s + 16, datos)\n    __guardar64(s + 24, 2)\n    __guardar64(dyn_cat_usado_dir(datos, cap), 0)\n    retornar s\n}\n\nfuncion dyn_texto_sumar(a, b) {\n    // b como bytes (los números, nulo, etc. se escriben como en a_texto)\n    sea sb = 0\n    si (dyn_tipo(b) == 1) {\n        sb = dyn_dato(b)\n    } sino {\n        sb = str_nuevo(16)\n        dyn_agregar_valor(sb, b, 0)\n    }\n    sea sa = dyn_dato(a)\n    sea la = __cargar64(sa)\n    sea lb = __cargar64(sb)\n    sea total = la + lb\n    si (mem_global(34) == 0) {\n        // Agregar en el sitio: búfer compartido, nadie más allá de a, cabe.\n        si (__cargar64(sa + 24) == 2) {\n            sea cap = __cargar64(sa + 8)\n            sea datos = __cargar64(sa + 16)\n            sea usado = dyn_cat_usado_dir(datos, cap)\n            si (__cargar64(usado) == la y total <= cap) {\n                mem_copiar(datos + la, __cargar64(sb + 16), lb)\n                __guardar8(datos + total, 0)\n                __guardar64(usado, total)\n                sea r = mem_reservar(32)\n                __guardar64(r, total)\n                __guardar64(r + 8, cap)\n                __guardar64(r + 16, datos)\n                __guardar64(r + 24, 2)\n                retornar dyn_texto(r)\n            }\n        }\n        si (total >= 32) {\n            sea r = dyn_cat_nuevo(total * 2)\n            sea datos = __cargar64(r + 16)\n            mem_copiar(datos, __cargar64(sa + 16), la)\n            mem_copiar(datos + la, __cargar64(sb + 16), lb)\n            __guardar8(datos + total, 0)\n            __guardar64(r, total)\n            __guardar64(dyn_cat_usado_dir(datos, total * 2), total)\n            retornar dyn_texto(r)\n        }\n    }\n    sea r = str_nuevo(total)\n    str_agregar(r, sa)\n    str_agregar(r, sb)\n    retornar dyn_texto(r)\n}\n" }
    si (i == 15) { retornar "// runtime/biblioteca.cfv — biblioteca estándar nativa, 100 % C-Forge.\n//\n// Se compila en modo puente (como dyn.cfv): código del dialecto nativo que\n// recibe y devuelve valores del lenguaje. Sin libc: la matemática usa series\n// propias, el tiempo usa clock_gettime y los archivos usan syscalls.\n\n// ── Flotantes: constantes y ayudas ────────────────────────────────────────\n\nfuncion f_(n) { retornar __f64_desde_entero(n) }\nfuncion f_pi() { retornar 4614256656552045848 }               // 0x400921FB54442D18\nfuncion f_ln2() { retornar 4604418534313441775 }              // 0x3FE62E42FEFA39EF\nfuncion f_neg(x) { retornar __f64_resta(f_(0), x) }\nfuncion f_abs(x) { retornar __desplazar_der(__desplazar_izq(x, 1), 1) }\nfuncion f_mayor(a, b) { retornar __f64_menor(b, a) }\n\n// Redondeo a entero, mitades lejos del cero.\nfuncion f_redondear(x) {\n    si (__f64_menor(x, f_(0))) {\n        retornar 0 - __f64_a_entero(__f64_suma(f_abs(x), __f64_div(f_(1), f_(2))))\n    }\n    retornar __f64_a_entero(__f64_suma(x, __f64_div(f_(1), f_(2))))\n}\n\nfuncion f_potencia10(n) {\n    si (n > 400) { n = 400 }                                   // ya es infinito\n    sea r = f_(1)\n    sea i = 0\n    mientras (i < n) {\n        r = __f64_mul(r, f_(10))\n        i = i + 1\n    }\n    retornar r\n}\n\n// seno en [-pi/2, pi/2] por serie de Taylor.\nfuncion f_seno_reducido(x) {\n    sea x2 = __f64_mul(x, x)\n    sea termino = x\n    sea suma = x\n    sea k = 1\n    mientras (k < 10) {\n        termino = __f64_div(__f64_mul(f_neg(termino), x2), f_((2 * k) * (2 * k + 1)))\n        suma = __f64_suma(suma, termino)\n        k = k + 1\n    }\n    retornar suma\n}\n\nfuncion f_coseno_reducido(x) {\n    sea x2 = __f64_mul(x, x)\n    sea termino = f_(1)\n    sea suma = f_(1)\n    sea k = 1\n    mientras (k < 11) {\n        termino = __f64_div(__f64_mul(f_neg(termino), x2), f_((2 * k - 1) * (2 * k)))\n        suma = __f64_suma(suma, termino)\n        k = k + 1\n    }\n    retornar suma\n}\n\n// Lleva x a [-pi, pi].\nfuncion f_reducir_angulo(x) {\n    sea dos_pi = __f64_mul(f_(2), f_pi())\n    sea k = f_redondear(__f64_div(x, dos_pi))\n    retornar __f64_resta(x, __f64_mul(f_(k), dos_pi))\n}\n\nfuncion f_seno(x) {\n    x = f_reducir_angulo(x)\n    sea medio_pi = __f64_div(f_pi(), f_(2))\n    si (f_mayor(x, medio_pi)) { x = __f64_resta(f_pi(), x) }\n    si (__f64_menor(x, f_neg(medio_pi))) { x = __f64_resta(f_neg(f_pi()), x) }\n    retornar f_seno_reducido(x)\n}\n\nfuncion f_coseno(x) {\n    x = f_abs(f_reducir_angulo(x))\n    si (f_mayor(x, __f64_div(f_pi(), f_(2)))) {\n        retornar f_neg(f_coseno_reducido(__f64_resta(f_pi(), x)))\n    }\n    retornar f_coseno_reducido(x)\n}\n\nfuncion f_arcotangente(x) {\n    sea negativo = __f64_menor(x, f_(0))\n    x = f_abs(x)\n    sea invertido = 0\n    si (f_mayor(x, f_(1))) {\n        x = __f64_div(f_(1), x)\n        invertido = 1\n    }\n    // atan(x) = 2·atan(x / (1 + sqrt(1 + x²))), dos veces.\n    sea factor = 1\n    sea i = 0\n    mientras (i < 2) {\n        x = __f64_div(x, __f64_suma(f_(1), __f64_raiz(__f64_suma(f_(1), __f64_mul(x, x)))))\n        factor = factor * 2\n        i = i + 1\n    }\n    sea x2 = __f64_mul(x, x)\n    sea potencia = x\n    sea suma = x\n    sea k = 1\n    mientras (k < 12) {\n        potencia = __f64_mul(f_neg(potencia), x2)\n        suma = __f64_suma(suma, __f64_div(potencia, f_(2 * k + 1)))\n        k = k + 1\n    }\n    sea r = __f64_mul(suma, f_(factor))\n    si (invertido) { r = __f64_resta(__f64_div(f_pi(), f_(2)), r) }\n    si (negativo) { r = f_neg(r) }\n    retornar r\n}\n\nfuncion f_arcoseno(x) {\n    si (f_mayor(f_abs(x), f_(1))) { dyn_error(\"arcoseno fuera de [-1, 1]\") }\n    si (f_abs(x) == f_(1)) {\n        sea medio = __f64_div(f_pi(), f_(2))\n        si (__f64_menor(x, f_(0))) { retornar f_neg(medio) }\n        retornar medio\n    }\n    retornar f_arcotangente(__f64_div(x, __f64_raiz(__f64_resta(f_(1), __f64_mul(x, x)))))\n}\n\nfuncion f_exponencial(x) {\n    sea k = f_redondear(__f64_div(x, f_ln2()))\n    // Fuera de rango el resultado es infinito o cero (sin iterar 2^60 veces).\n    si (k > 1100) { retornar 9218868437227405312 }\n    si (k < 0 - 1100) { retornar 0 }\n    sea r = __f64_resta(x, __f64_mul(f_(k), f_ln2()))\n    sea termino = f_(1)\n    sea suma = f_(1)\n    sea i = 1\n    mientras (i < 22) {\n        termino = __f64_div(__f64_mul(termino, r), f_(i))\n        suma = __f64_suma(suma, termino)\n        i = i + 1\n    }\n    mientras (k > 0) {\n        suma = __f64_mul(suma, f_(2))\n        k = k - 1\n    }\n    mientras (k < 0) {\n        suma = __f64_div(suma, f_(2))\n        k = k + 1\n    }\n    retornar suma\n}\n\nfuncion f_logaritmo(x) {\n    si (__f64_menor(f_(0), x) == 0) { dyn_error(\"logaritmo de un número no positivo\") }\n    sea e = __y_bits(__desplazar_der(x, 52), 2047) - 1023\n    sea m = __o_bits(__y_bits(x, 4503599627370495), 4607182418800017408)   // mantisa en [1, 2)\n    si (f_mayor(m, __f64_raiz(f_(2)))) {\n        m = __f64_div(m, f_(2))\n        e = e + 1\n    }\n    sea t = __f64_div(__f64_resta(m, f_(1)), __f64_suma(m, f_(1)))\n    sea t2 = __f64_mul(t, t)\n    sea potencia = t\n    sea suma = t\n    sea k = 1\n    mientras (k < 18) {\n        potencia = __f64_mul(potencia, t2)\n        suma = __f64_suma(suma, __f64_div(potencia, f_(2 * k + 1)))\n        k = k + 1\n    }\n    retornar __f64_suma(__f64_mul(f_(2), suma), __f64_mul(f_(e), f_ln2()))\n}\n\n// ── Formato de números (como %g con 6 cifras, igual que el intérprete) ───\n\nfuncion dyn_formato_g(r, bits) { retornar dyn_formato_cifras(r, bits, 6) }\n\n// Número con cifras significativas: 6 para mostrar (como %g), 15 para JSON\n// (ida y vuelta sin perder datos; los enteros exactos van sin decimales).\n// Entero grande en base 10^9 (vec, la cifra menos significativa primero)\n// por m (m·10^9 cabe en 64 bits).\nfuncion dyn_dec_mul(v, m) {\n    sea acarreo = 0\n    sea i = 0\n    mientras (i < vec_largo(v)) {\n        sea t = vec_obtener(v, i) * m + acarreo\n        vec_fijar(v, i, t % 1000000000)\n        acarreo = t / 1000000000\n        i = i + 1\n    }\n    mientras (acarreo > 0) {\n        vec_agregar(v, acarreo % 1000000000)\n        acarreo = acarreo / 1000000000\n    }\n    retornar 0\n}\n\n// Las \"cifras\" primeras cifras decimales exactas de x (> 0, finito),\n// redondeadas con mitad al par; deja en celda_e el exponente decimal.\nfuncion dyn_cifras_exactas(x, cifras, celda_e) {\n    sea exp_bits = __y_bits(__desplazar_der(x, 52), 2047)\n    sea f = __y_bits(x, 4503599627370495)\n    sea p = 0 - 1074\n    si (exp_bits != 0) {\n        f = f + 4503599627370496\n        p = exp_bits - 1075\n    }\n    sea v = vec_nuevo()\n    vec_agregar(v, f % 1000000000)\n    vec_agregar(v, f / 1000000000)\n    sea desplazar = 0\n    si (p >= 0) {\n        sea k = p\n        mientras (k >= 29) {\n            dyn_dec_mul(v, 536870912)\n            k = k - 29\n        }\n        si (k > 0) { dyn_dec_mul(v, __desplazar_izq(1, k)) }\n    } sino {\n        // f / 2^-p = f · 5^-p / 10^-p\n        sea k = 0 - p\n        mientras (k >= 12) {\n            dyn_dec_mul(v, 244140625)\n            k = k - 12\n        }\n        sea q = 1\n        mientras (k > 0) {\n            q = q * 5\n            k = k - 1\n        }\n        si (q > 1) { dyn_dec_mul(v, q) }\n        desplazar = p\n    }\n    mientras (vec_largo(v) > 1 y vec_obtener(v, vec_largo(v) - 1) == 0) { vec_quitar_ultimo(v) }\n    sea d = str_nuevo(vec_largo(v) * 9 + 1)\n    sea i = vec_largo(v) - 1\n    str_agregar(d, str_desde_entero(vec_obtener(v, i)))\n    i = i - 1\n    mientras (i >= 0) {\n        sea parte = str_desde_entero(vec_obtener(v, i))\n        sea relleno = 9 - str_largo(parte)\n        mientras (relleno > 0) {\n            str_agregar_byte(d, 48)\n            relleno = relleno - 1\n        }\n        str_agregar(d, parte)\n        i = i - 1\n    }\n    vec_liberar(v)\n    sea n = str_largo(d)\n    sea e = n - 1 + desplazar\n    sea r = str_nuevo(cifras + 1)\n    si (n <= cifras) {\n        str_agregar(r, d)\n        mientras (str_largo(r) < cifras) { str_agregar_byte(r, 48) }\n    } sino {\n        str_agregar(r, str_rebanar(d, 0, cifras))\n        sea siguiente = str_byte(d, cifras)\n        sea resto = 0\n        sea j = cifras + 1\n        mientras (j < n y resto == 0) {\n            si (str_byte(d, j) != 48) { resto = 1 }\n            j = j + 1\n        }\n        sea subir = siguiente > 53 o (siguiente == 53 y (resto o __y_bits(str_byte(r, cifras - 1), 1) == 1))\n        si (subir) {\n            sea k = cifras - 1\n            sea seguir = 1\n            mientras (seguir y k >= 0) {\n                sea b = str_byte(r, k)\n                si (b == 57) {\n                    __guardar8(str_datos(r) + k, 48)\n                    k = k - 1\n                } sino {\n                    __guardar8(str_datos(r) + k, b + 1)\n                    seguir = 0\n                }\n            }\n            si (seguir) {\n                // 99…9 → 100…0 con un exponente más.\n                __guardar8(str_datos(r), 49)\n                e = e + 1\n            }\n        }\n    }\n    __guardar64(celda_e, e)\n    retornar r\n}\n\nfuncion dyn_formato_cifras(r, bits, cifras) {\n    sea exponente_bits = __y_bits(__desplazar_der(bits, 52), 2047)\n    sea negativo = bits < 0\n    sea x = f_abs(bits)\n    si (exponente_bits == 2047) {\n        si (__desplazar_izq(bits, 12) != 0) { str_agregar(r, \"nan\") retornar 0 }\n        si (negativo) { str_agregar_byte(r, 45) }\n        str_agregar(r, \"inf\")\n        retornar 0\n    }\n    si (x == 0) { str_agregar_byte(r, 48) retornar 0 }\n    si (negativo) { str_agregar_byte(r, 45) }\n    // Cifras exactas (el double es f·2^p: se pasa a decimal sin redondeos\n    // intermedios) redondeadas a \"cifras\" con mitad al par.\n    sea celda_e = mem_reservar(8)\n    sea digitos = dyn_cifras_exactas(x, cifras, celda_e)\n    sea e = __cargar64(celda_e)\n    mem_liberar(celda_e)\n    // Quitar ceros finales.\n    sea utiles = cifras\n    mientras (utiles > 1 y str_byte(digitos, utiles - 1) == 48) { utiles = utiles - 1 }\n    si (e < 0 - 4 o e >= cifras) {\n        str_agregar_byte(r, str_byte(digitos, 0))\n        si (utiles > 1) {\n            str_agregar_byte(r, 46)\n            str_agregar(r, str_rebanar(digitos, 1, utiles))\n        }\n        str_agregar_byte(r, 101)\n        si (e < 0) {\n            str_agregar_byte(r, 45)\n            e = 0 - e\n        } sino {\n            str_agregar_byte(r, 43)\n        }\n        si (e < 10) { str_agregar_byte(r, 48) }\n        str_agregar(r, str_desde_entero(e))\n        retornar 0\n    }\n    si (e >= 0) {\n        str_agregar(r, str_rebanar(digitos, 0, e + 1))\n        si (utiles > e + 1) {\n            str_agregar_byte(r, 46)\n            str_agregar(r, str_rebanar(digitos, e + 1, utiles))\n        }\n        retornar 0\n    }\n    str_agregar(r, \"0.\")\n    sea ceros = 0 - e - 1\n    mientras (ceros > 0) {\n        str_agregar_byte(r, 48)\n        ceros = ceros - 1\n    }\n    str_agregar(r, str_rebanar(digitos, 0, utiles))\n    retornar 0\n}\n\n// ── Matemática del lenguaje ───────────────────────────────────────────────\n\nfuncion absoluto(v) {\n    si (__y_bits(v, 1) == 1) {\n        si (v < 0) { retornar dyn_neg(v) }\n        retornar v\n    }\n    si (dyn_tipo(v) == 12) {\n        si (dyn_comparar(v, 1) < 0) { retornar dyn_neg(v) }\n        retornar v\n    }\n    retornar dyn_desde_f64(f_abs(dyn_a_f64(v)))\n}\n\nfuncion minimo(a, b) {\n    si (dyn_comparar(b, a) < 0) { retornar b }\n    retornar a\n}\n\nfuncion maximo(a, b) {\n    si (dyn_comparar(b, a) > 0) { retornar b }\n    retornar a\n}\n\nfuncion raiz(v) {\n    sea x = dyn_a_f64(v)\n    si (__f64_menor(x, f_(0))) { dyn_error(\"raíz de un número negativo\") }\n    retornar dyn_desde_f64(__f64_raiz(x))\n}\n\nfuncion potencia(base, exponente) {\n    // Base entera y exponente entero >= 0: resultado exacto (sin límite),\n    // por cuadrados sucesivos.\n    si (dyn_gr_es_entero(base) y __y_bits(exponente, 1) == 1 y exponente >= 1) {\n        sea e = dyn_valor_entero(exponente)\n        // Tope: 4 millones de cifras (unos pocos segundos).\n        sea cifras = dyn_longitud_decimal(base)\n        si (cifras > 15) {\n            si (e > 4000000 / (cifras - 1)) { dyn_error(\"potencia: el resultado tendría más de 4 millones de cifras\") }\n        } sino {\n            sea mag = absoluto_crudo(dyn_valor_entero(base))\n            si (mag > 1) {\n                sea estimadas = __f64_mul(f_(e), __f64_div(f_logaritmo(f_(mag)), f_logaritmo(f_(10))))\n                si (__f64_menor(f_(4000000), estimadas)) { dyn_error(\"potencia: el resultado tendría más de 4 millones de cifras\") }\n            }\n        }\n        sea r = dyn_entero(1)\n        sea b = base\n        mientras (e > 0) {\n            si (__y_bits(e, 1) == 1) { r = dyn_mul(r, b) }\n            e = __desplazar_der(e, 1)\n            si (e > 0) { b = dyn_mul(b, b) }\n        }\n        retornar r\n    }\n    sea x = dyn_a_f64(base)\n    sea y = dyn_a_f64(exponente)\n    si (x == f_(0)) {\n        si (__f64_menor(f_(0), y)) { retornar dyn_entero(0) }\n        si (y == f_(0)) { retornar dyn_entero(1) }\n        dyn_error(\"potencia: cero elevado a un exponente negativo\")\n    }\n    si (__f64_menor(x, f_(0))) {\n        sea entero = __f64_a_entero(y)\n        si (f_(entero) != y) { dyn_error(\"potencia: base negativa con exponente fraccionario\") }\n        sea magnitud = f_exponencial(__f64_mul(y, f_logaritmo(f_abs(x))))\n        si (__y_bits(entero, 1) == 1) { magnitud = f_neg(magnitud) }\n        retornar dyn_desde_f64(magnitud)\n    }\n    retornar dyn_desde_f64(f_exponencial(__f64_mul(y, f_logaritmo(x))))\n}\n\nfuncion absoluto_crudo(n) {\n    si (n < 0) { retornar 0 - n }\n    retornar n\n}\n\nfuncion redondear(v, decimales) {\n    si (dyn_gr_es_entero(v)) { retornar v }\n    sea x = dyn_a_f64(v)\n    si (decimales == 0) { retornar dyn_entero(f_redondear(x)) }\n    // Más de 17 decimales ya no cambian un double: el mismo número.\n    si (__y_bits(decimales, 1) == 1 y dyn_valor_entero(decimales) > 17) { retornar v }\n    sea escala = f_potencia10(dyn_valor_entero(decimales))\n    retornar dyn_desde_f64(__f64_div(f_(f_redondear(__f64_mul(x, escala))), escala))\n}\n\nfuncion seno(v) { retornar dyn_desde_f64(f_seno(dyn_a_f64(v))) }\nfuncion coseno(v) { retornar dyn_desde_f64(f_coseno(dyn_a_f64(v))) }\nfuncion tangente(v) {\n    sea x = dyn_a_f64(v)\n    retornar dyn_desde_f64(__f64_div(f_seno(x), f_coseno(x)))\n}\nfuncion arcoseno(v) { retornar dyn_desde_f64(f_arcoseno(dyn_a_f64(v))) }\nfuncion arccoseno(v) {\n    retornar dyn_desde_f64(__f64_resta(__f64_div(f_pi(), f_(2)), f_arcoseno(dyn_a_f64(v))))\n}\nfuncion arcotangente(v) { retornar dyn_desde_f64(f_arcotangente(dyn_a_f64(v))) }\nfuncion exponencial(v) { retornar dyn_desde_f64(f_exponencial(dyn_a_f64(v))) }\nfuncion logaritmo(v) { retornar dyn_desde_f64(f_logaritmo(dyn_a_f64(v))) }\nfuncion sen(v) { retornar seno(v) }\nfuncion cos(v) { retornar coseno(v) }\nfuncion tan(v) { retornar tangente(v) }\nfuncion pi() { retornar dyn_desde_f64(f_pi()) }\n\n// Generador xorshift64* (global 22), sembrado con el reloj.\nfuncion aleatorio_crudo() {\n    sea x = mem_global(22)\n    si (x == 0) { x = __o_bits(sys_reloj_ns(), 1) }\n    x = __xo_bits(x, __desplazar_der(x, 12))\n    x = __xo_bits(x, __desplazar_izq(x, 25))\n    x = __xo_bits(x, __desplazar_der(x, 27))\n    mem_fijar_global(22, x)\n    retornar __desplazar_der(x * 2685821657736338717, 11)        // 53 bits\n}\n\nfuncion aleatorio() {\n    retornar dyn_caja(4, __f64_div(f_(aleatorio_crudo()), f_(9007199254740992)))\n}\n\nfuncion aleatorio_entero(minimo_v, maximo_v) {\n    sea a = dyn_valor_entero(minimo_v)\n    sea b = dyn_valor_entero(maximo_v)\n    si (b < a) { dyn_error(\"aleatorio_entero: el máximo es menor que el mínimo\") }\n    retornar dyn_entero(a + aleatorio_crudo() % (b - a + 1))\n}\n\n// ── Texto ─────────────────────────────────────────────────────────────────\n\n// Posición de aguja en pajar desde inicio, o -1.\nfuncion str_buscar(pajar, aguja, inicio) {\n    sea n = str_largo(pajar)\n    sea m = str_largo(aguja)\n    sea i = inicio\n    mientras (i + m <= n) {\n        sea j = 0\n        mientras (j < m y str_byte(pajar, i + j) == str_byte(aguja, j)) { j = j + 1 }\n        si (j == m) { retornar i }\n        i = i + 1\n    }\n    retornar 0 - 1\n}\n\nfuncion texto_reemplazar(t, buscado, reemplazo) {\n    sea s = dyn_texto_de(t, \"texto_reemplazar\")\n    sea a = dyn_texto_de(buscado, \"texto_reemplazar\")\n    sea b = dyn_a_str(reemplazo)\n    si (str_largo(a) == 0) { retornar t }\n    sea r = str_nuevo(str_largo(s))\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        sea p = str_buscar(s, a, i)\n        si (p < 0) {\n            str_agregar(r, str_rebanar(s, i, str_largo(s)))\n            i = str_largo(s)\n        } sino {\n            str_agregar(r, str_rebanar(s, i, p))\n            str_agregar(r, b)\n            i = p + str_largo(a)\n        }\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion contiene(coleccion, v) {\n    sea t = dyn_tipo(coleccion)\n    si (t == 1) {\n        retornar dyn_bool(str_buscar(dyn_dato(coleccion), dyn_a_str(v), 0) >= 0)\n    }\n    si (t == 2) { retornar lista_contiene(coleccion, v) }\n    si (t == 3) { retornar tiene_clave(coleccion, v) }\n    dyn_error_tipo(\"contiene\", coleccion)\n    retornar 2\n}\n\nfuncion texto_contiene(t, sub) { retornar contiene(t, sub) }\n\nfuncion subtexto(t, inicio, fin) {\n    sea s = dyn_texto_de(t, \"subtexto\")\n    retornar dyn_texto(str_rebanar(s, dyn_valor_entero(inicio), dyn_valor_entero(fin)))\n}\n\nfuncion texto_dividir(t, separador) {\n    sea s = dyn_texto_de(t, \"texto_dividir\")\n    sea sep = dyn_texto_de(separador, \"texto_dividir\")\n    sea r = vec_nuevo()\n    si (str_largo(sep) == 0) {\n        sea k = 0\n        mientras (k < str_largo(s)) {\n            vec_agregar(r, dyn_texto(str_rebanar(s, k, k + 1)))\n            k = k + 1\n        }\n        retornar dyn_caja(2, r)\n    }\n    sea i = 0\n    sea seguir = 1\n    mientras (seguir) {\n        sea p = str_buscar(s, sep, i)\n        si (p < 0) {\n            vec_agregar(r, dyn_texto(str_rebanar(s, i, str_largo(s))))\n            seguir = 0\n        } sino {\n            vec_agregar(r, dyn_texto(str_rebanar(s, i, p)))\n            i = p + str_largo(sep)\n        }\n    }\n    retornar dyn_caja(2, r)\n}\n\nfuncion texto_unir(lista, separador) {\n    si (dyn_tipo(lista) != 2) { dyn_error_tipo(\"texto_unir\", lista) }\n    sea l = dyn_dato(lista)\n    sea r = str_nuevo(16)\n    sea i = 0\n    mientras (i < vec_largo(l)) {\n        si (i > 0) { dyn_agregar_valor(r, separador, 0) }\n        dyn_agregar_valor(r, vec_obtener(l, i), 0)\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion es_blanco(b) { retornar b == 32 o b == 9 o b == 10 o b == 13 }\n\nfuncion texto_recortar(t) {\n    sea s = dyn_texto_de(t, \"texto_recortar\")\n    sea i = 0\n    sea j = str_largo(s)\n    mientras (i < j y es_blanco(str_byte(s, i))) { i = i + 1 }\n    mientras (j > i y es_blanco(str_byte(s, j - 1))) { j = j - 1 }\n    retornar dyn_texto(str_rebanar(s, i, j))\n}\n\n// Código Unicode del primer carácter (UTF-8).\nfuncion cfv_codigo_char(t) {\n    sea s = dyn_texto_de(t, \"codigo_char\")\n    si (str_largo(s) == 0) { dyn_error(\"codigo_char: texto vacío\") }\n    sea b = str_byte(s, 0)\n    si (b < 128) { retornar dyn_entero(b) }\n    sea extra = 1\n    sea valor = __y_bits(b, 31)\n    si (b >= 240) {\n        extra = 3\n        valor = __y_bits(b, 7)\n    } sino {\n        si (b >= 224) {\n            extra = 2\n            valor = __y_bits(b, 15)\n        }\n    }\n    sea i = 1\n    mientras (i <= extra y i < str_largo(s)) {\n        valor = valor * 64 + __y_bits(str_byte(s, i), 63)\n        i = i + 1\n    }\n    retornar dyn_entero(valor)\n}\n\nfuncion str_agregar_utf8(r, n) {\n    si (n < 128) { str_agregar_byte(r, n) retornar 0 }\n    si (n < 2048) {\n        str_agregar_byte(r, 192 + n / 64)\n        str_agregar_byte(r, 128 + n % 64)\n        retornar 0\n    }\n    si (n < 65536) {\n        str_agregar_byte(r, 224 + n / 4096)\n        str_agregar_byte(r, 128 + (n / 64) % 64)\n        str_agregar_byte(r, 128 + n % 64)\n        retornar 0\n    }\n    str_agregar_byte(r, 240 + n / 262144)\n    str_agregar_byte(r, 128 + (n / 4096) % 64)\n    str_agregar_byte(r, 128 + (n / 64) % 64)\n    str_agregar_byte(r, 128 + n % 64)\n    retornar 0\n}\n\nfuncion caracter(codigo) {\n    sea r = str_nuevo(4)\n    str_agregar_utf8(r, dyn_valor_entero(codigo))\n    retornar dyn_texto(r)\n}\n\n// Byte i del texto como entero (para bibliotecas escritas en C-Forge).\nfuncion byte_en(t, i) {\n    sea s = dyn_texto_de(t, \"byte_en\")\n    si (__y_bits(i, 1) != 1) { dyn_error(\"byte_en: el índice debe ser un entero\") }\n    sea k = dyn_valor_entero(i)\n    si (k < 0 o k >= str_largo(s)) { dyn_error(\"byte_en: índice fuera del texto\") }\n    retornar dyn_entero(str_byte(s, k))\n}\n\n// ── Base64 y URL ──────────────────────────────────────────────────────────\n\nfuncion base64_simbolo(n) {\n    si (n < 26) { retornar 65 + n }\n    si (n < 52) { retornar 97 + n - 26 }\n    si (n < 62) { retornar 48 + n - 52 }\n    si (n == 62) { retornar 43 }\n    retornar 47\n}\n\nfuncion base64_valor(b) {\n    si (b >= 65 y b <= 90) { retornar b - 65 }\n    si (b >= 97 y b <= 122) { retornar b - 97 + 26 }\n    si (b >= 48 y b <= 57) { retornar b - 48 + 52 }\n    si (b == 43 o b == 45) { retornar 62 }\n    si (b == 47 o b == 95) { retornar 63 }\n    retornar 0 - 1\n}\n\nfuncion cfv_base64_codificar(t) {\n    sea s = dyn_a_str(t)\n    sea n = str_largo(s)\n    sea r = str_nuevo(n * 4 / 3 + 4)\n    sea i = 0\n    mientras (i < n) {\n        sea b0 = str_byte(s, i)\n        sea b1 = 0\n        sea b2 = 0\n        si (i + 1 < n) { b1 = str_byte(s, i + 1) }\n        si (i + 2 < n) { b2 = str_byte(s, i + 2) }\n        sea grupo = b0 * 65536 + b1 * 256 + b2\n        str_agregar_byte(r, base64_simbolo(__y_bits(__desplazar_der(grupo, 18), 63)))\n        str_agregar_byte(r, base64_simbolo(__y_bits(__desplazar_der(grupo, 12), 63)))\n        si (i + 1 < n) { str_agregar_byte(r, base64_simbolo(__y_bits(__desplazar_der(grupo, 6), 63))) } sino { str_agregar_byte(r, 61) }\n        si (i + 2 < n) { str_agregar_byte(r, base64_simbolo(__y_bits(grupo, 63))) } sino { str_agregar_byte(r, 61) }\n        i = i + 3\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion cfv_base64_decodificar(t) {\n    sea s = dyn_texto_de(t, \"base64_decodificar\")\n    sea r = str_nuevo(str_largo(s))\n    sea acumulado = 0\n    sea bits = 0\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        sea v = base64_valor(str_byte(s, i))\n        si (v >= 0) {\n            acumulado = __y_bits(acumulado * 64 + v, 16777215)\n            bits = bits + 6\n            si (bits >= 8) {\n                bits = bits - 8\n                str_agregar_byte(r, __y_bits(__desplazar_der(acumulado, bits), 255))\n            }\n        }\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion hex_digito(n) {\n    si (n < 10) { retornar 48 + n }\n    retornar 55 + n\n}\n\nfuncion valor_hex(b) {\n    si (b >= 48 y b <= 57) { retornar b - 48 }\n    si (b >= 65 y b <= 70) { retornar b - 55 }\n    si (b >= 97 y b <= 102) { retornar b - 87 }\n    retornar 0 - 1\n}\n\nfuncion url_reservado(b) {\n    si ((b >= 65 y b <= 90) o (b >= 97 y b <= 122) o (b >= 48 y b <= 57)) { retornar 0 }\n    si (b == 45 o b == 95 o b == 46 o b == 126) { retornar 0 }\n    retornar 1\n}\n\nfuncion cfv_url_codificar(t) {\n    sea s = dyn_a_str(t)\n    sea r = str_nuevo(str_largo(s) * 3)\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        sea b = str_byte(s, i)\n        si (url_reservado(b)) {\n            str_agregar_byte(r, 37)\n            str_agregar_byte(r, hex_digito(b / 16))\n            str_agregar_byte(r, hex_digito(b % 16))\n        } sino {\n            str_agregar_byte(r, b)\n        }\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion cfv_url_decodificar(t) {\n    sea s = dyn_texto_de(t, \"url_decodificar\")\n    sea r = str_nuevo(str_largo(s))\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        sea b = str_byte(s, i)\n        si (b == 37 y i + 2 < str_largo(s) y valor_hex(str_byte(s, i + 1)) >= 0 y valor_hex(str_byte(s, i + 2)) >= 0) {\n            str_agregar_byte(r, valor_hex(str_byte(s, i + 1)) * 16 + valor_hex(str_byte(s, i + 2)))\n            i = i + 3\n        } sino {\n            si (b == 43) { str_agregar_byte(r, 32) } sino { str_agregar_byte(r, b) }\n            i = i + 1\n        }\n    }\n    retornar dyn_texto(r)\n}\n\n// ── SHA-256 y MD5 (aritmética de 32 bits sobre enteros de 64) ─────────────\n\nfuncion u32(x) { retornar __y_bits(x, 4294967295) }\nfuncion rotd32(x, n) { retornar u32(__o_bits(__desplazar_der(x, n), __desplazar_izq(x, 32 - n))) }\nfuncion roti32(x, n) { retornar u32(__o_bits(__desplazar_izq(x, n), __desplazar_der(x, 32 - n))) }\n\nfuncion hex_agregar(r, valor, bytes, invertido) {\n    sea i = 0\n    mientras (i < bytes) {\n        sea desplazamiento = (bytes - 1 - i) * 8\n        si (invertido) { desplazamiento = i * 8 }\n        sea b = __y_bits(__desplazar_der(valor, desplazamiento), 255)\n        str_agregar_byte(r, __o_bits(hex_digito(b / 16), 32))\n        str_agregar_byte(r, __o_bits(hex_digito(b % 16), 32))\n        i = i + 1\n    }\n    retornar 0\n}\n\n// Mensaje con relleno de 64 bytes; longitud en bits al final (BE o LE).\nfuncion hash_relleno(s, little) {\n    sea r = str_nuevo(str_largo(s) + 72)\n    str_agregar(r, s)\n    str_agregar_byte(r, 128)\n    mientras (str_largo(r) % 64 != 56) { str_agregar_byte(r, 0) }\n    sea bits = str_largo(s) * 8\n    sea i = 0\n    mientras (i < 8) {\n        si (little) {\n            str_agregar_byte(r, __y_bits(__desplazar_der(bits, i * 8), 255))\n        } sino {\n            str_agregar_byte(r, __y_bits(__desplazar_der(bits, (7 - i) * 8), 255))\n        }\n        i = i + 1\n    }\n    retornar r\n}\n\nfuncion sha256_k() {\n    sea k = mem_global(23)\n    si (k != 0) { retornar k }\n    k = vec_nuevo()\n    sea valores = \"428a2f98 71374491 b5c0fbcf e9b5dba5 3956c25b 59f111f1 923f82a4 ab1c5ed5 d807aa98 12835b01 243185be 550c7dc3 72be5d74 80deb1fe 9bdc06a7 c19bf174 e49b69c1 efbe4786 0fc19dc6 240ca1cc 2de92c6f 4a7484aa 5cb0a9dc 76f988da 983e5152 a831c66d b00327c8 bf597fc7 c6e00bf3 d5a79147 06ca6351 14292967 27b70a85 2e1b2138 4d2c6dfc 53380d13 650a7354 766a0abb 81c2c92e 92722c85 a2bfe8a1 a81a664b c24b8b70 c76c51a3 d192e819 d6990624 f40e3585 106aa070 19a4c116 1e376c08 2748774c 34b0bcb5 391c0cb3 4ed8aa4a 5b9cca4f 682e6ff3 748f82ee 78a5636f 84c87814 8cc70208 90befffa a4506ceb bef9a3f7 c67178f2\"\n    sea i = 0\n    mientras (i < str_largo(valores)) {\n        sea v = 0\n        sea j = 0\n        mientras (j < 8) {\n            v = v * 16 + valor_hex(str_byte(valores, i + j))\n            j = j + 1\n        }\n        vec_agregar(k, v)\n        i = i + 9\n    }\n    mem_fijar_global(23, k)\n    retornar k\n}\n\nfuncion cfv_sha256(t) {\n    sea m = hash_relleno(dyn_a_str(t), 0)\n    sea k = sha256_k()\n    sea h = vec_nuevo()\n    vec_agregar(h, 1779033703)\n    vec_agregar(h, 3144134277)\n    vec_agregar(h, 1013904242)\n    vec_agregar(h, 2773480762)\n    vec_agregar(h, 1359893119)\n    vec_agregar(h, 2600822924)\n    vec_agregar(h, 528734635)\n    vec_agregar(h, 1541459225)\n    sea w = vec_nuevo()\n    sea i = 0\n    mientras (i < 64) {\n        vec_agregar(w, 0)\n        i = i + 1\n    }\n    sea bloque = 0\n    mientras (bloque < str_largo(m)) {\n        i = 0\n        mientras (i < 16) {\n            sea p = bloque + i * 4\n            vec_fijar(w, i, str_byte(m, p) * 16777216 + str_byte(m, p + 1) * 65536 + str_byte(m, p + 2) * 256 + str_byte(m, p + 3))\n            i = i + 1\n        }\n        mientras (i < 64) {\n            sea w15 = vec_obtener(w, i - 15)\n            sea w2 = vec_obtener(w, i - 2)\n            sea s0 = __xo_bits(__xo_bits(rotd32(w15, 7), rotd32(w15, 18)), __desplazar_der(w15, 3))\n            sea s1 = __xo_bits(__xo_bits(rotd32(w2, 17), rotd32(w2, 19)), __desplazar_der(w2, 10))\n            vec_fijar(w, i, u32(vec_obtener(w, i - 16) + s0 + vec_obtener(w, i - 7) + s1))\n            i = i + 1\n        }\n        sea a = vec_obtener(h, 0)\n        sea b = vec_obtener(h, 1)\n        sea c = vec_obtener(h, 2)\n        sea d = vec_obtener(h, 3)\n        sea e = vec_obtener(h, 4)\n        sea f = vec_obtener(h, 5)\n        sea g = vec_obtener(h, 6)\n        sea hh = vec_obtener(h, 7)\n        i = 0\n        mientras (i < 64) {\n            sea S1 = __xo_bits(__xo_bits(rotd32(e, 6), rotd32(e, 11)), rotd32(e, 25))\n            sea ch = __xo_bits(__y_bits(e, f), __y_bits(__xo_bits(e, 4294967295), g))\n            sea t1 = u32(hh + S1 + ch + vec_obtener(k, i) + vec_obtener(w, i))\n            sea S0 = __xo_bits(__xo_bits(rotd32(a, 2), rotd32(a, 13)), rotd32(a, 22))\n            sea mayoria = __xo_bits(__xo_bits(__y_bits(a, b), __y_bits(a, c)), __y_bits(b, c))\n            sea t2 = u32(S0 + mayoria)\n            hh = g\n            g = f\n            f = e\n            e = u32(d + t1)\n            d = c\n            c = b\n            b = a\n            a = u32(t1 + t2)\n            i = i + 1\n        }\n        vec_fijar(h, 0, u32(vec_obtener(h, 0) + a))\n        vec_fijar(h, 1, u32(vec_obtener(h, 1) + b))\n        vec_fijar(h, 2, u32(vec_obtener(h, 2) + c))\n        vec_fijar(h, 3, u32(vec_obtener(h, 3) + d))\n        vec_fijar(h, 4, u32(vec_obtener(h, 4) + e))\n        vec_fijar(h, 5, u32(vec_obtener(h, 5) + f))\n        vec_fijar(h, 6, u32(vec_obtener(h, 6) + g))\n        vec_fijar(h, 7, u32(vec_obtener(h, 7) + hh))\n        bloque = bloque + 64\n    }\n    sea r = str_nuevo(64)\n    i = 0\n    mientras (i < 8) {\n        hex_agregar(r, vec_obtener(h, i), 4, 0)\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion md5_tablas() {\n    sea t = mem_global(24)\n    si (t != 0) { retornar t }\n    t = vec_nuevo()\n    // K[i] = floor(|sin(i + 1)| · 2^32)\n    sea i = 0\n    mientras (i < 64) {\n        sea s = f_abs(f_seno(f_(i + 1)))\n        vec_agregar(t, __f64_a_entero(__f64_mul(s, f_(4294967296))))\n        i = i + 1\n    }\n    mem_fijar_global(24, t)\n    retornar t\n}\n\nfuncion md5_desplazamiento(i) {\n    sea ronda = i / 16\n    sea j = i % 4\n    si (ronda == 0) {\n        si (j == 0) { retornar 7 }\n        si (j == 1) { retornar 12 }\n        si (j == 2) { retornar 17 }\n        retornar 22\n    }\n    si (ronda == 1) {\n        si (j == 0) { retornar 5 }\n        si (j == 1) { retornar 9 }\n        si (j == 2) { retornar 14 }\n        retornar 20\n    }\n    si (ronda == 2) {\n        si (j == 0) { retornar 4 }\n        si (j == 1) { retornar 11 }\n        si (j == 2) { retornar 16 }\n        retornar 23\n    }\n    si (j == 0) { retornar 6 }\n    si (j == 1) { retornar 10 }\n    si (j == 2) { retornar 15 }\n    retornar 21\n}\n\nfuncion cfv_md5(t) {\n    sea m = hash_relleno(dyn_a_str(t), 1)\n    sea k = md5_tablas()\n    sea a0 = 1732584193\n    sea b0 = 4023233417\n    sea c0 = 2562383102\n    sea d0 = 271733878\n    sea palabras = vec_nuevo()\n    sea i = 0\n    mientras (i < 16) {\n        vec_agregar(palabras, 0)\n        i = i + 1\n    }\n    sea bloque = 0\n    mientras (bloque < str_largo(m)) {\n        i = 0\n        mientras (i < 16) {\n            sea p = bloque + i * 4\n            vec_fijar(palabras, i, str_byte(m, p) + str_byte(m, p + 1) * 256 + str_byte(m, p + 2) * 65536 + str_byte(m, p + 3) * 16777216)\n            i = i + 1\n        }\n        sea a = a0\n        sea b = b0\n        sea c = c0\n        sea d = d0\n        i = 0\n        mientras (i < 64) {\n            sea f = 0\n            sea g = 0\n            si (i < 16) {\n                f = __o_bits(__y_bits(b, c), __y_bits(__xo_bits(b, 4294967295), d))\n                g = i\n            } sino {\n                si (i < 32) {\n                    f = __o_bits(__y_bits(d, b), __y_bits(__xo_bits(d, 4294967295), c))\n                    g = (5 * i + 1) % 16\n                } sino {\n                    si (i < 48) {\n                        f = __xo_bits(__xo_bits(b, c), d)\n                        g = (3 * i + 5) % 16\n                    } sino {\n                        f = __xo_bits(c, __o_bits(b, __xo_bits(d, 4294967295)))\n                        g = (7 * i) % 16\n                    }\n                }\n            }\n            f = u32(f + a + vec_obtener(k, i) + vec_obtener(palabras, g))\n            a = d\n            d = c\n            c = b\n            b = u32(b + roti32(f, md5_desplazamiento(i)))\n            i = i + 1\n        }\n        a0 = u32(a0 + a)\n        b0 = u32(b0 + b)\n        c0 = u32(c0 + c)\n        d0 = u32(d0 + d)\n        bloque = bloque + 64\n    }\n    sea r = str_nuevo(32)\n    hex_agregar(r, a0, 4, 1)\n    hex_agregar(r, b0, 4, 1)\n    hex_agregar(r, c0, 4, 1)\n    hex_agregar(r, d0, 4, 1)\n    retornar dyn_texto(r)\n}\n\n// ── Archivos ──────────────────────────────────────────────────────────────\n\n// Los errores de E/S son capturables con intentar/capturar; sin manejador,\n// dyn_error termina el programa con el mismo mensaje de siempre.\nfuncion leer_archivo(ruta) {\n    sea r = dyn_texto_de(ruta, \"leer_archivo\")\n    sea contenido = archivo_intentar_leer(r)\n    si (contenido == 0) { dyn_error(str_concatenar(\"no se pudo abrir \", r)) }\n    retornar dyn_texto(contenido)\n}\n\nfuncion escribir_archivo(ruta, contenido) {\n    sea r = dyn_texto_de(ruta, \"escribir_archivo\")\n    sea n = archivo_intentar_escribir(r, dyn_a_str(contenido))\n    si (n == -1) { dyn_error(str_concatenar(\"no se pudo escribir \", r)) }\n    si (n == -2) { dyn_error(str_concatenar(\"escritura incompleta en \", r)) }\n    retornar 0\n}\n\n// En Windows, \"/tmp/…\" es la carpeta temporal (igual que al abrir archivos).\nfuncion rt_ruta_carpeta(s) {\n    si (sys_es_windows() y str_largo(s) >= 5) {\n        si (str_igual(str_rebanar(s, 0, 5), \"/tmp/\")) { retornar str_concatenar(sys_ruta_temporal(), str_rebanar(s, 5, str_largo(s))) }\n    }\n    si (sys_es_windows() y str_igual(s, \"/tmp\")) { retornar sys_ruta_temporal() }\n    retornar s\n}\n\n// Nombres dentro de una carpeta (sin \".\" ni \"..\"), o nulo si no es carpeta.\nfuncion listar_carpeta(ruta) {\n    sea l = sys_listar(rt_ruta_carpeta(dyn_texto_de(ruta, \"listar_carpeta\")))\n    si (l == 0) { retornar 0 }\n    sea r = vec_nuevo()\n    sea i = 0\n    mientras (i < vec_largo(l)) {\n        sea n = vec_obtener(l, i)\n        si (str_igual(n, \".\") == 0 y str_igual(n, \"..\") == 0) { vec_agregar(r, dyn_texto(n)) }\n        i = i + 1\n    }\n    retornar dyn_caja(2, r)\n}\n\n// Crea la carpeta y las que falten en el camino (como mkdir -p).\nfuncion crear_carpeta(ruta) {\n    sea s = rt_ruta_carpeta(dyn_texto_de(ruta, \"crear_carpeta\"))\n    sea i = 1\n    mientras (i <= str_largo(s)) {\n        si (i == str_largo(s) o str_byte(s, i) == 47 o str_byte(s, i) == 92) {\n            sea parte = str_rebanar(s, 0, i)\n            si (sys_listar(parte) == 0) {\n                si (sys_crear_directorio(str_c(parte)) != 0) { retornar dyn_bool(0) }\n            }\n        }\n        i = i + 1\n    }\n    retornar dyn_bool(sys_listar(s) != 0)\n}\n\nfuncion es_carpeta(ruta) { retornar dyn_bool(sys_listar(rt_ruta_carpeta(dyn_texto_de(ruta, \"es_carpeta\"))) != 0) }\n\nfuncion existe_archivo(ruta) {\n    sea fd = sys_abrir(str_c(dyn_texto_de(ruta, \"existe_archivo\")), sys_abrir_lectura(), 0)\n    si (fd < 0) { retornar 2 }\n    sys_cerrar(fd)\n    retornar 4\n}\n\n// ── Tiempo (clock_gettime) ────────────────────────────────────────────────\n\n\nfuncion cfv_fecha_ahora_ms() { retornar dyn_entero(sys_reloj_ns() / 1000000) }\n\n// Fecha civil (UTC) a partir de días desde 1970 (algoritmo de H. Hinnant).\nfuncion cfv_fecha_ahora() {\n    sea segundos = sys_reloj_ns() / 1000000000\n    sea dias = segundos / 86400\n    sea resto = segundos % 86400\n    sea z = dias + 719468\n    sea era = z / 146097\n    sea doe = z - era * 146097\n    sea yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365\n    sea y = yoe + era * 400\n    sea doy = doe - (365 * yoe + yoe / 4 - yoe / 100)\n    sea mp = (5 * doy + 2) / 153\n    sea d = doy - (153 * mp + 2) / 5 + 1\n    sea m = mp + 3\n    si (m > 12) { m = m - 12 }\n    si (m <= 2) { y = y + 1 }\n    sea r = map_nuevo()\n    map_fijar(r, \"anio\", dyn_entero(y))\n    map_fijar(r, \"mes\", dyn_entero(m))\n    map_fijar(r, \"dia\", dyn_entero(d))\n    map_fijar(r, \"hora\", dyn_entero(resto / 3600))\n    map_fijar(r, \"minuto\", dyn_entero((resto % 3600) / 60))\n    map_fijar(r, \"segundo\", dyn_entero(resto % 60))\n    map_fijar(r, \"dia_semana\", dyn_entero((dias + 3) % 7))       // 0 = lunes\n    retornar dyn_caja(3, r)\n}\n\n// ── Sistema y rutas ───────────────────────────────────────────────────────\n\n\nfuncion sys_info() {\n    sea r = map_nuevo()\n    // sys_nombre_plataforma(): \"Linux x86-64\", \"macOS ARM64\", \"Windows x86-64\"…\n    sea p = sys_nombre_plataforma()\n    sea so = \"linux\"\n    si (str_largo(p) >= 5 y str_igual(str_rebanar(p, 0, 5), \"macOS\")) { so = \"macos\" }\n    si (str_largo(p) >= 7 y str_igual(str_rebanar(p, 0, 7), \"Windows\")) { so = \"windows\" }\n    sea cpu = \"x86_64\"\n    si (str_largo(p) >= 5 y str_igual(str_rebanar(p, str_largo(p) - 5, str_largo(p)), \"ARM64\")) { cpu = \"arm64\" }\n    map_fijar(r, \"sistema\", dyn_texto(so))\n    map_fijar(r, \"cpu\", dyn_texto(cpu))\n    map_fijar(r, \"plataforma\", dyn_texto(p))\n    map_fijar(r, \"nucleos\", dyn_entero(sys_nucleos()))\n    retornar dyn_caja(3, r)\n}\n\nfuncion ruta_nombre(ruta) {\n    sea s = dyn_texto_de(ruta, \"ruta_nombre\")\n    sea i = str_largo(s)\n    mientras (i > 0 y str_byte(s, i - 1) != 47) { i = i - 1 }\n    retornar dyn_texto(str_rebanar(s, i, str_largo(s)))\n}\n\nfuncion ruta_extension(ruta) {\n    sea s = dyn_dato(ruta_nombre(ruta))\n    sea i = str_largo(s)\n    mientras (i > 0 y str_byte(s, i - 1) != 46) { i = i - 1 }\n    si (i <= 1) { retornar dyn_texto(\"\") }\n    retornar dyn_texto(str_rebanar(s, i - 1, str_largo(s)))\n}\n\n// ── Listas y mapas ────────────────────────────────────────────────────────\n\nfuncion insertar(lista, posicion, v) {\n    si (dyn_tipo(lista) != 2) { dyn_error_tipo(\"insertar\", lista) }\n    sea l = dyn_dato(lista)\n    sea p = dyn_valor_entero(posicion)\n    si (p < 0 o p > vec_largo(l)) { dyn_error(\"insertar: posición inválida\") }\n    vec_agregar(l, 0)\n    sea i = vec_largo(l) - 1\n    mientras (i > p) {\n        vec_fijar(l, i, vec_obtener(l, i - 1))\n        i = i - 1\n    }\n    vec_fijar(l, p, v)\n    retornar 0\n}\n\nfuncion eliminar(lista, posicion) {\n    si (dyn_tipo(lista) != 2) { dyn_error_tipo(\"eliminar\", lista) }\n    sea l = dyn_dato(lista)\n    sea p = dyn_valor_entero(posicion)\n    si (p < 0 o p >= vec_largo(l)) { dyn_error(\"eliminar: posición inválida\") }\n    sea v = vec_obtener(l, p)\n    sea i = p\n    mientras (i + 1 < vec_largo(l)) {\n        vec_fijar(l, i, vec_obtener(l, i + 1))\n        i = i + 1\n    }\n    vec_quitar_ultimo(l)\n    retornar v\n}\n\nfuncion mapa_claves(m) { retornar claves(m) }\n\n// ── Conversión de valores para extern (ABI System V AMD64) ────────────────\n\n// Entero de 64 bits de C → valor del lenguaje: un entero si cabe en 63\n// bits con signo (n·2+1); si no (p. ej. un tagged pointer de Objective-C\n// en ARM64, con el bit 63), una caja de puntero de C (tipo 11) exacta.\nfuncion dyn_entero_desde_c(x) {\n    si (__desplazar_der(x, 63) == __y_bits(__desplazar_der(x, 62), 1)) { retornar x + x + 1 }\n    retornar dyn_caja(11, x)\n}\n\nfuncion dyn_entero_c(v) {\n    sea t = dyn_tipo(v)\n    si (t == 6) { retornar dyn_valor_entero(v) }\n    si (t == 11) { retornar dyn_dato(v) }\n    si (t == 5) { retornar v == 4 }\n    si (t == 0) { retornar 0 }\n    si (t == 4) { retornar __f64_a_entero(dyn_dato(v)) }\n    dyn_error_tipo(\"extern: se esperaba un número entero\", v)\n    retornar 0\n}\n\n// char* terminado en cero (los textos del runtime ya lo están).\nfuncion dyn_texto_c(v) {\n    si (v == 0) { retornar 0 }\n    retornar str_datos(dyn_texto_de(v, \"extern: se esperaba texto\"))\n}\n\nfuncion dyn_texto_desde_c(p) {\n    si (p == 0) { retornar 0 }\n    retornar dyn_texto(str_desde_c(p))\n}\n\n// ── Carga diferida de bibliotecas compartidas (dlopen / dlsym) ───────────\n\n\n// \"sqlite3\" → libsqlite3.so.0, \"SDL2\" → libSDL2-2.0.so.0: busca en los\n// directorios del sistema un archivo lib<nombre>.so* o lib<nombre>-*.so*.\nfuncion buscar_biblioteca(base) {\n    sea dirs = vec_nuevo()\n    vec_agregar(dirs, \"/lib/x86_64-linux-gnu\")\n    vec_agregar(dirs, \"/usr/lib/x86_64-linux-gnu\")\n    vec_agregar(dirs, \"/lib/aarch64-linux-gnu\")\n    vec_agregar(dirs, \"/usr/lib/aarch64-linux-gnu\")\n    vec_agregar(dirs, \"/usr/local/lib\")\n    vec_agregar(dirs, \"/usr/lib64\")\n    vec_agregar(dirs, \"/lib64\")\n    vec_agregar(dirs, \"/usr/lib\")\n    sea con_so = str_concatenar(base, \".so\")\n    sea con_guion = str_concatenar(base, \"-\")\n    sea i = 0\n    mientras (i < vec_largo(dirs)) {\n        sea nombres = sys_listar(vec_obtener(dirs, i))\n        si (nombres != 0) {\n            sea j = 0\n            mientras (j < vec_largo(nombres)) {\n                sea n = vec_obtener(nombres, j)\n                si ((dyn_empieza(n, con_so) o dyn_empieza(n, con_guion)) y str_buscar(n, \".so\", 0) >= 0) {\n                    retornar str_concatenar(str_concatenar(vec_obtener(dirs, i), \"/\"), n)\n                }\n                j = j + 1\n            }\n        }\n        i = i + 1\n    }\n    retornar 0\n}\n\nfuncion dyn_empieza(s, prefijo) {\n    si (str_largo(s) < str_largo(prefijo)) { retornar 0 }\n    retornar str_igual(str_rebanar(s, 0, str_largo(prefijo)), prefijo)\n}\n\nfuncion dyn_abrir_biblioteca(nombre) {\n    si (sys_dl_disponible() == 0) { retornar 0 }\n    sea cache = mem_global(31)\n    si (cache == 0) {\n        cache = map_nuevo()\n        mem_fijar_global(31, cache)\n    }\n    sea h = map_obtener_o(cache, nombre, 0)\n    si (h != 0) { retornar h }\n    h = sys_cargar_biblioteca(nombre)\n    si (h == 0 y str_buscar(nombre, \"/\", 0) < 0 y str_buscar(nombre, \"\\\\\", 0) < 0) {\n        sea base = nombre\n        si (str_buscar(nombre, \".so\", 0) >= 0) { base = str_rebanar(nombre, 0, str_buscar(nombre, \".so\", 0)) }\n        si (str_buscar(nombre, \".dylib\", 0) >= 0) { base = str_rebanar(nombre, 0, str_buscar(nombre, \".dylib\", 0)) }\n        si (str_buscar(nombre, \".dll\", 0) >= 0) { base = str_rebanar(nombre, 0, str_buscar(nombre, \".dll\", 0)) }\n        si (sys_es_windows()) {\n            // \"libsqlite3\" → sqlite3.dll, winsqlite3.dll (la del sistema), libsqlite3.dll\n            sea sin_lib = base\n            si (dyn_empieza(base, \"lib\")) { sin_lib = str_rebanar(base, 3, str_largo(base)) }\n            h = sys_cargar_biblioteca(str_concatenar(sin_lib, \".dll\"))\n            si (h == 0) { h = sys_cargar_biblioteca(str_concatenar(str_concatenar(\"win\", sin_lib), \".dll\")) }\n            si (h == 0) { h = sys_cargar_biblioteca(str_concatenar(base, \".dll\")) }\n        } sino {\n            si (__plataforma() == 2 o __plataforma() == 3) {\n                sea con_dylib = str_concatenar(base, \".dylib\")\n                h = sys_cargar_biblioteca(con_dylib)\n                si (h == 0) { h = sys_cargar_biblioteca(str_concatenar(\"/usr/lib/\", con_dylib)) }\n                si (h == 0) { h = sys_cargar_biblioteca(str_concatenar(\"/opt/homebrew/lib/\", con_dylib)) }\n                si (h == 0) { h = sys_cargar_biblioteca(str_concatenar(\"/usr/local/lib/\", con_dylib)) }\n            } sino {\n                sea encontrada = buscar_biblioteca(base)\n                si (encontrada != 0) { h = sys_cargar_biblioteca(encontrada) }\n            }\n        }\n    }\n    si (h != 0) { map_fijar(cache, nombre, h) }\n    retornar h\n}\n\n// Dirección de simbolo en biblioteca; error capturable si no existe.\nfuncion dyn_extern_resolver(simbolo, biblioteca) {\n    sea h = dyn_abrir_biblioteca(biblioteca)\n    si (h == 0) {\n        sea m = str_concatenar(\"extern: no se pudo cargar la biblioteca \", biblioteca)\n        str_agregar(m, \" (para '\")\n        str_agregar(m, simbolo)\n        str_agregar(m, \"')\")\n        dyn_error(m)\n    }\n    sea p = sys_simbolo(h, simbolo)\n    si (p == 0) { dyn_simbolo_faltante(simbolo, biblioteca) }\n    retornar p\n}\n\nfuncion dyn_simbolo_faltante(simbolo, biblioteca) {\n    sea m = str_concatenar(\"extern: no se encontró el símbolo '\", simbolo)\n    str_agregar(m, \"' en \")\n    str_agregar(m, biblioteca)\n    dyn_error(m)\n    retornar 0\n}\n\n// ── Programa: argumentos, entrada y salida ────────────────────────────────\n\nfuncion argumentos_programa() {\n    sea r = vec_nuevo()\n    sea i = 1\n    mientras (i < rt_argc()) {\n        vec_agregar(r, dyn_texto(rt_argumento(i)))\n        i = i + 1\n    }\n    retornar dyn_caja(2, r)\n}\n\nfuncion argumentos() { retornar argumentos_programa() }\n\n// Lee una línea de la entrada estándar (sin el salto final); nulo al final.\nfuncion leer(mensaje) {\n    si (mensaje != 0) { rt_escribir_texto(1, dyn_a_str(mensaje)) }\n    sea r = str_nuevo(64)\n    sea b = mem_reservar(8)\n    sea leidos = 0\n    sea seguir = 1\n    mientras (seguir) {\n        sea n = sys_leer(0, b, 1)\n        si (n <= 0) {\n            seguir = 0\n        } sino {\n            leidos = leidos + 1\n            si (__cargar8(b) == 10) { seguir = 0 } sino { str_agregar_byte(r, __cargar8(b)) }\n        }\n    }\n    mem_liberar(b)\n    si (leidos == 0) { retornar 0 }\n    retornar dyn_texto(r)\n}\n\nfuncion cobertura_iniciar(ruta) { retornar cobertura_iniciar_ruta(dyn_a_str(ruta)) }\n\nfuncion salir(codigo) {\n    sea c = 0\n    si (__y_bits(codigo, 1) == 1) { c = dyn_valor_entero(codigo) }\n    cobertura_volcar()\n    sys_salir(c)\n    retornar 0\n}\n\nfuncion numero_a_texto(v) { retornar a_texto(v) }\nfuncion subcadena(t, inicio, fin) { retornar subtexto(t, inicio, fin) }\n\n// ── Texto (más) ───────────────────────────────────────────────────────────\n\nfuncion texto_empieza_con(t, prefijo) { retornar dyn_bool(dyn_empieza(dyn_texto_de(t, \"texto_empieza_con\"), dyn_texto_de(prefijo, \"texto_empieza_con\"))) }\n\nfuncion texto_termina_con(t, sufijo) {\n    sea s = dyn_texto_de(t, \"texto_termina_con\")\n    sea f = dyn_texto_de(sufijo, \"texto_termina_con\")\n    si (str_largo(f) > str_largo(s)) { retornar 2 }\n    retornar dyn_bool(str_igual(str_rebanar(s, str_largo(s) - str_largo(f), str_largo(s)), f))\n}\n\nfuncion texto_indice(t, buscado) {\n    retornar dyn_entero(str_buscar(dyn_texto_de(t, \"texto_indice\"), dyn_texto_de(buscado, \"texto_indice\"), 0))\n}\n\n// Como texto_indice, pero busca desde la posición \"desde\" sin copiar el texto\n// (para analizadores lineales).\nfuncion texto_indice_desde(t, buscado, desde) {\n    sea s = dyn_texto_de(t, \"texto_indice_desde\")\n    sea d = 0\n    si (__y_bits(desde, 1) == 1) { d = dyn_valor_entero(desde) } sino { dyn_error(\"texto_indice_desde: la posición debe ser un entero\") }\n    si (d < 0) { d = 0 }\n    si (d > str_largo(s)) { retornar dyn_entero(0 - 1) }\n    retornar dyn_entero(str_buscar(s, dyn_texto_de(buscado, \"texto_indice_desde\"), d))\n}\n\nfuncion texto_invertir(t) {\n    sea s = dyn_texto_de(t, \"texto_invertir\")\n    sea r = str_nuevo(str_largo(s))\n    sea i = str_largo(s) - 1\n    mientras (i >= 0) {\n        str_agregar_byte(r, str_byte(s, i))\n        i = i - 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion texto_repetir(t, veces) {\n    sea s = dyn_a_str(t)\n    si (__y_bits(veces, 1) != 1) { dyn_error(\"texto_repetir: la cantidad debe ser un entero\") }\n    si (dyn_valor_entero(veces) > 0 y str_largo(s) > 0 y dyn_valor_entero(veces) > 2147483648 / str_largo(s)) { dyn_error(\"texto_repetir: el texto sería demasiado grande\") }\n    sea r = str_nuevo(16)\n    sea i = 0\n    mientras (i < dyn_valor_entero(veces)) {\n        str_agregar(r, s)\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion texto_a_numero(t) { retornar a_numero(t) }\n\n// ── Tiempo ────────────────────────────────────────────────────────────────\n\nfuncion tiempo_ms() { retornar dyn_entero(sys_reloj_ns() / 1000000) }\n\n// ── HMAC-SHA256 y bytes aleatorios del sistema ────────────────────────────\n\n// Texto hexadecimal → bytes crudos.\nfuncion hex_a_bytes(h) {\n    sea r = str_nuevo(str_largo(h) / 2)\n    sea i = 0\n    mientras (i + 1 < str_largo(h)) {\n        str_agregar_byte(r, valor_hex(str_byte(h, i)) * 16 + valor_hex(str_byte(h, i + 1)))\n        i = i + 2\n    }\n    retornar r\n}\n\n// HMAC-SHA256 (RFC 2104) en hexadecimal, igual que en 3.x.\nfuncion hmac_sha256(clave, mensaje) {\n    sea k = dyn_a_str(clave)\n    si (str_largo(k) > 64) { k = hex_a_bytes(dyn_texto_de(cfv_sha256(dyn_texto(k)), \"hmac_sha256\")) }\n    sea interno = str_nuevo(64 + str_largo(dyn_a_str(mensaje)))\n    sea externo = str_nuevo(96)\n    sea i = 0\n    mientras (i < 64) {\n        sea b = 0\n        si (i < str_largo(k)) { b = str_byte(k, i) }\n        str_agregar_byte(interno, __xo_bits(b, 54))\n        str_agregar_byte(externo, __xo_bits(b, 92))\n        i = i + 1\n    }\n    str_agregar(interno, dyn_a_str(mensaje))\n    str_agregar(externo, hex_a_bytes(dyn_texto_de(cfv_sha256(dyn_texto(interno)), \"hmac_sha256\")))\n    retornar cfv_sha256(dyn_texto(externo))\n}\n\n// n bytes aleatorios criptográficos del sistema, en hexadecimal.\nfuncion crypto_rand_bytes(n) {\n    sea k = dyn_valor_entero(n)\n    si (k < 1 o k > 65536) { dyn_error(\"crypto_rand_bytes: n debe ser 1..65536\") }\n    sea buf = mem_reservar(k)\n    si (sys_aleatorio(buf, k) != 0) { dyn_error(\"crypto_rand_bytes: el sistema no entregó bytes aleatorios\") }\n    sea r = str_nuevo(k * 2)\n    sea i = 0\n    mientras (i < k) {\n        sea b = __cargar8(buf + i)\n        str_agregar_byte(r, __o_bits(hex_digito(b / 16), 32))\n        str_agregar_byte(r, __o_bits(hex_digito(b % 16), 32))\n        i = i + 1\n    }\n    mem_liberar(buf)\n    retornar dyn_texto(r)\n}\n\n// ── AES-256-CBC con PKCS#7 (FIPS 197), en C-Forge puro ────────────────────\n// Formato compatible con 3.x: hex(iv) + \":\" + hex(cifrado); la clave es el\n// SHA-256 del texto que pasa el programa.\n\nfuncion aes_xtime(b) {\n    sea r = b * 2\n    si (r >= 256) { r = __xo_bits(r, 283) }\n    retornar r\n}\n\nfuncion aes_mul(a, b) {\n    sea r = 0\n    mientras (b > 0) {\n        si (__y_bits(b, 1)) { r = __xo_bits(r, a) }\n        a = aes_xtime(a)\n        b = __desplazar_der(b, 1)\n    }\n    retornar r\n}\n\n// S-box (0..255) y su inversa (256..511), una sola vez (global 15; ver docs/GLOBALES.md\n// para el mapa de casillas).\nfuncion aes_tablas() {\n    sea t = mem_global(15)\n    si (t != 0) { retornar t }\n    t = mem_reservar(512)\n    sea p = 1\n    sea q = 1\n    __guardar8(t, 99)\n    __guardar8(t + 256 + 99, 0)\n    sea vuelta = 0\n    sea x = 0\n    sea k = 0\n    mientras (vuelta < 255) {\n        // p · 3, q / 3 en GF(2^8)\n        p = __xo_bits(p, aes_xtime(p))\n        q = __xo_bits(q, q * 2)\n        q = __xo_bits(q, q * 4)\n        q = __xo_bits(q, q * 16)\n        q = __y_bits(q, 255)\n        si (__y_bits(q, 128)) { q = __xo_bits(q, 9) }\n        x = __xo_bits(q, 99)\n        k = 1\n        mientras (k <= 4) {\n            x = __xo_bits(x, __y_bits(__o_bits(__desplazar_izq(q, k), __desplazar_der(q, 8 - k)), 255))\n            k = k + 1\n        }\n        __guardar8(t + p, x)\n        __guardar8(t + 256 + x, p)\n        vuelta = vuelta + 1\n    }\n    mem_fijar_global(15, t)\n    retornar t\n}\n\n// Expansión de la clave de 32 bytes → 240 bytes (15 claves de ronda).\nfuncion aes_expandir(clave) { retornar aes_expandir_n(clave, 32) }\n\n// Expansión para claves de 16 (AES-128, 11 claves de ronda) o 32 bytes (AES-256).\nfuncion aes_expandir_n(clave, nbytes) {\n    sea s = aes_tablas()\n    sea total = 240\n    si (nbytes == 16) { total = 176 }\n    sea w = mem_reservar(total)\n    sea i = 0\n    mientras (i < nbytes) {\n        __guardar8(w + i, __cargar8(clave + i))\n        i = i + 1\n    }\n    sea rcon = 1\n    mientras (i < total) {\n        sea a = __cargar8(w + i - 4)\n        sea b = __cargar8(w + i - 3)\n        sea c = __cargar8(w + i - 2)\n        sea d = __cargar8(w + i - 1)\n        si (i % nbytes == 0) {\n            sea tmp = a\n            a = __xo_bits(__cargar8(s + b), rcon)\n            b = __cargar8(s + c)\n            c = __cargar8(s + d)\n            d = __cargar8(s + tmp)\n            rcon = aes_xtime(rcon)\n        } sino {\n            si (nbytes == 32 y i % 32 == 16) {\n                a = __cargar8(s + a)\n                b = __cargar8(s + b)\n                c = __cargar8(s + c)\n                d = __cargar8(s + d)\n            }\n        }\n        __guardar8(w + i, __xo_bits(__cargar8(w + i - nbytes), a))\n        __guardar8(w + i + 1, __xo_bits(__cargar8(w + i - nbytes + 1), b))\n        __guardar8(w + i + 2, __xo_bits(__cargar8(w + i - nbytes + 2), c))\n        __guardar8(w + i + 3, __xo_bits(__cargar8(w + i - nbytes + 3), d))\n        i = i + 4\n    }\n    retornar w\n}\n\nfuncion aes_sumar_clave(e, w, ronda) {\n    sea i = 0\n    mientras (i < 16) {\n        __guardar8(e + i, __xo_bits(__cargar8(e + i), __cargar8(w + ronda * 16 + i)))\n        i = i + 1\n    }\n    retornar 0\n}\n\n// SubBytes + ShiftRows (directo o inverso) sobre el estado e (16 bytes).\nfuncion aes_sustituir_desplazar(e, tabla, inverso) {\n    sea tmp = mem_reservar(16)\n    sea i = 0\n    mientras (i < 16) {\n        sea fila = i % 4\n        sea col = i / 4\n        sea origen = ((col + fila) % 4) * 4 + fila\n        si (inverso) { origen = ((col + 4 - fila) % 4) * 4 + fila }\n        __guardar8(tmp + i, __cargar8(tabla + __cargar8(e + origen)))\n        i = i + 1\n    }\n    i = 0\n    mientras (i < 16) {\n        __guardar8(e + i, __cargar8(tmp + i))\n        i = i + 1\n    }\n    mem_liberar(tmp)\n    retornar 0\n}\n\nfuncion aes_mezclar(e, inverso) {\n    sea c = 0\n    mientras (c < 4) {\n        sea p = e + c * 4\n        sea a0 = __cargar8(p)\n        sea a1 = __cargar8(p + 1)\n        sea a2 = __cargar8(p + 2)\n        sea a3 = __cargar8(p + 3)\n        si (inverso) {\n            __guardar8(p, __xo_bits(__xo_bits(aes_mul(a0, 14), aes_mul(a1, 11)), __xo_bits(aes_mul(a2, 13), aes_mul(a3, 9))))\n            __guardar8(p + 1, __xo_bits(__xo_bits(aes_mul(a0, 9), aes_mul(a1, 14)), __xo_bits(aes_mul(a2, 11), aes_mul(a3, 13))))\n            __guardar8(p + 2, __xo_bits(__xo_bits(aes_mul(a0, 13), aes_mul(a1, 9)), __xo_bits(aes_mul(a2, 14), aes_mul(a3, 11))))\n            __guardar8(p + 3, __xo_bits(__xo_bits(aes_mul(a0, 11), aes_mul(a1, 13)), __xo_bits(aes_mul(a2, 9), aes_mul(a3, 14))))\n        } sino {\n            __guardar8(p, __xo_bits(__xo_bits(aes_xtime(a0), __xo_bits(aes_xtime(a1), a1)), __xo_bits(a2, a3)))\n            __guardar8(p + 1, __xo_bits(__xo_bits(a0, aes_xtime(a1)), __xo_bits(__xo_bits(aes_xtime(a2), a2), a3)))\n            __guardar8(p + 2, __xo_bits(__xo_bits(a0, a1), __xo_bits(aes_xtime(a2), __xo_bits(aes_xtime(a3), a3))))\n            __guardar8(p + 3, __xo_bits(__xo_bits(__xo_bits(aes_xtime(a0), a0), a1), __xo_bits(a2, aes_xtime(a3))))\n        }\n        c = c + 1\n    }\n    retornar 0\n}\n\nfuncion aes_bloque_cifrar(e, w) { retornar aes_bloque_cifrar_r(e, w, 14) }\n\n// Cifra un bloque con nr rondas (10 para AES-128, 14 para AES-256).\nfuncion aes_bloque_cifrar_r(e, w, nr) {\n    sea s = aes_tablas()\n    aes_sumar_clave(e, w, 0)\n    sea r = 1\n    mientras (r < nr) {\n        aes_sustituir_desplazar(e, s, 0)\n        aes_mezclar(e, 0)\n        aes_sumar_clave(e, w, r)\n        r = r + 1\n    }\n    aes_sustituir_desplazar(e, s, 0)\n    aes_sumar_clave(e, w, nr)\n    retornar 0\n}\n\nfuncion aes_bloque_descifrar(e, w) {\n    sea s = aes_tablas() + 256\n    aes_sumar_clave(e, w, 14)\n    sea r = 13\n    mientras (r > 0) {\n        aes_sustituir_desplazar(e, s, 1)\n        aes_sumar_clave(e, w, r)\n        aes_mezclar(e, 1)\n        r = r - 1\n    }\n    aes_sustituir_desplazar(e, s, 1)\n    aes_sumar_clave(e, w, 0)\n    retornar 0\n}\n\nfuncion aes_clave_de(clave) {\n    sea k = hex_a_bytes(dyn_texto_de(cfv_sha256(dyn_texto(dyn_a_str(clave))), \"aes\"))\n    retornar aes_expandir(str_datos(k))\n}\n\nfuncion hex_de_memoria(r, p, n) {\n    sea i = 0\n    mientras (i < n) {\n        sea b = __cargar8(p + i)\n        str_agregar_byte(r, __o_bits(hex_digito(b / 16), 32))\n        str_agregar_byte(r, __o_bits(hex_digito(b % 16), 32))\n        i = i + 1\n    }\n    retornar 0\n}\n\nfuncion aes_cifrar(clave, texto) {\n    sea w = aes_clave_de(clave)\n    sea m = dyn_a_str(texto)\n    sea n = str_largo(m)\n    sea relleno = 16 - n % 16\n    sea total = n + relleno\n    sea datos = mem_reservar(total)\n    sea i = 0\n    mientras (i < n) {\n        __guardar8(datos + i, str_byte(m, i))\n        i = i + 1\n    }\n    mientras (i < total) {\n        __guardar8(datos + i, relleno)\n        i = i + 1\n    }\n    sea iv = mem_reservar(16)\n    si (sys_aleatorio(iv, 16) != 0) { dyn_error(\"aes_cifrar: el sistema no entregó bytes aleatorios\") }\n    sea previo = iv\n    sea b = 0\n    mientras (b < total) {\n        sea j = 0\n        mientras (j < 16) {\n            __guardar8(datos + b + j, __xo_bits(__cargar8(datos + b + j), __cargar8(previo + j)))\n            j = j + 1\n        }\n        aes_bloque_cifrar(datos + b, w)\n        previo = datos + b\n        b = b + 16\n    }\n    sea r = str_nuevo(33 + total * 2)\n    hex_de_memoria(r, iv, 16)\n    str_agregar_byte(r, 58)\n    hex_de_memoria(r, datos, total)\n    mem_liberar(datos)\n    mem_liberar(iv)\n    mem_liberar(w)\n    retornar dyn_texto(r)\n}\n\nfuncion aes_descifrar(clave, cifrado) {\n    sea c = dyn_texto_de(cifrado, \"aes_descifrar\")\n    si (str_largo(c) < 33 o str_byte(c, 32) != 58) { dyn_error(\"aes_descifrar: formato invalido (usar salida de aes_cifrar)\") }\n    sea iv = hex_a_bytes(str_rebanar(c, 0, 32))\n    sea ct = hex_a_bytes(str_rebanar(c, 33, str_largo(c)))\n    sea total = str_largo(ct)\n    si (total == 0 o total % 16 != 0) { dyn_error(\"aes_descifrar: clave incorrecta o datos corruptos\") }\n    sea w = aes_clave_de(clave)\n    sea datos = mem_reservar(total)\n    sea i = 0\n    mientras (i < total) {\n        __guardar8(datos + i, str_byte(ct, i))\n        i = i + 1\n    }\n    sea b = total - 16\n    mientras (b >= 0) {\n        aes_bloque_descifrar(datos + b, w)\n        sea j = 0\n        mientras (j < 16) {\n            sea anterior = 0\n            si (b == 0) { anterior = str_byte(iv, j) } sino { anterior = str_byte(ct, b - 16 + j) }\n            __guardar8(datos + b + j, __xo_bits(__cargar8(datos + b + j), anterior))\n            j = j + 1\n        }\n        b = b - 16\n    }\n    sea relleno = __cargar8(datos + total - 1)\n    sea valido = relleno >= 1 y relleno <= 16\n    i = 0\n    mientras (valido y i < relleno) {\n        si (__cargar8(datos + total - 1 - i) != relleno) { valido = 0 }\n        i = i + 1\n    }\n    mem_liberar(w)\n    si (valido == 0) {\n        mem_liberar(datos)\n        dyn_error(\"aes_descifrar: clave incorrecta o datos corruptos\")\n    }\n    sea r = str_nuevo(total)\n    i = 0\n    mientras (i < total - relleno) {\n        str_agregar_byte(r, __cargar8(datos + i))\n        i = i + 1\n    }\n    mem_liberar(datos)\n    retornar dyn_texto(r)\n}\n\n// ── Red: nombres, TCP y UDP (IPv4) ────────────────────────────────────────\n\n// \"a.b.c.d\" → ip (entero de 32 bits) o -1.\nfuncion red_ip_de_texto(s) {\n    sea ip = 0\n    sea parte = 0\n    sea digitos = 0\n    sea puntos = 0\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        sea b = str_byte(s, i)\n        si (b >= 48 y b <= 57) {\n            parte = parte * 10 + b - 48\n            digitos = digitos + 1\n            si (parte > 255 o digitos > 3) { retornar 0 - 1 }\n        } sino {\n            si (b != 46 o digitos == 0) { retornar 0 - 1 }\n            ip = ip * 256 + parte\n            parte = 0\n            digitos = 0\n            puntos = puntos + 1\n        }\n        i = i + 1\n    }\n    si (puntos != 3 o digitos == 0) { retornar 0 - 1 }\n    retornar ip * 256 + parte\n}\n\nfuncion red_texto_de_ip(ip) {\n    sea r = str_nuevo(16)\n    sea k = 3\n    mientras (k >= 0) {\n        str_agregar(r, str_desde_entero(__y_bits(__desplazar_der(ip, k * 8), 255)))\n        si (k > 0) { str_agregar_byte(r, 46) }\n        k = k - 1\n    }\n    retornar r\n}\n\n// Contenido de un archivo, o 0 si no existe.\nfuncion red_leer_si_existe(ruta) {\n    sea fd = sys_abrir(str_c(ruta), sys_abrir_lectura(), 0)\n    si (fd < 0) { retornar 0 }\n    sys_cerrar(fd)\n    retornar archivo_leer(ruta)\n}\n\n// Siguiente palabra (separada por espacios o tabs) desde *pos; avanza pos.\nfuncion red_palabra(linea, pos) {\n    sea i = __cargar64(pos)\n    mientras (i < str_largo(linea) y (str_byte(linea, i) == 32 o str_byte(linea, i) == 9)) { i = i + 1 }\n    sea inicio = i\n    mientras (i < str_largo(linea) y str_byte(linea, i) != 32 y str_byte(linea, i) != 9) { i = i + 1 }\n    __guardar64(pos, i)\n    retornar str_rebanar(linea, inicio, i)\n}\n\nfuncion red_igual_sin_mayusculas(a, b) {\n    si (str_largo(a) != str_largo(b)) { retornar 0 }\n    sea i = 0\n    mientras (i < str_largo(a)) {\n        sea x = str_byte(a, i)\n        sea y = str_byte(b, i)\n        si (x >= 65 y x <= 90) { x = x + 32 }\n        si (y >= 65 y y <= 90) { y = y + 32 }\n        si (x != y) { retornar 0 }\n        i = i + 1\n    }\n    retornar 1\n}\n\n// Busca nombre en un archivo con el formato de /etc/hosts o resolv.conf:\n// en hosts devuelve la ip de la línea que lo nombra; con nombre == 0\n// devuelve la ip del primer \"nameserver\".\nfuncion red_buscar_en_archivo(ruta, nombre) {\n    sea texto = red_leer_si_existe(ruta)\n    si (texto == 0) { retornar 0 - 1 }\n    sea pos = mem_reservar(8)\n    sea inicio = 0\n    sea i = 0\n    sea resultado = 0 - 1\n    mientras (i <= str_largo(texto) y resultado < 0) {\n        si (i == str_largo(texto) o str_byte(texto, i) == 10) {\n            sea linea = str_rebanar(texto, inicio, i)\n            sea comentario = str_buscar(linea, \"#\", 0)\n            si (comentario >= 0) { linea = str_rebanar(linea, 0, comentario) }\n            __guardar64(pos, 0)\n            sea primera = red_palabra(linea, pos)\n            si (nombre == 0) {\n                si (str_igual(primera, \"nameserver\")) { resultado = red_ip_de_texto(red_palabra(linea, pos)) }\n            } sino {\n                sea ip = red_ip_de_texto(primera)\n                si (ip >= 0) {\n                    sea otra = red_palabra(linea, pos)\n                    mientras (str_largo(otra) > 0 y resultado < 0) {\n                        si (red_igual_sin_mayusculas(otra, nombre)) { resultado = ip }\n                        otra = red_palabra(linea, pos)\n                    }\n                }\n            }\n            inicio = i + 1\n        }\n        i = i + 1\n    }\n    mem_liberar(pos)\n    retornar resultado\n}\n\n// Salta un nombre DNS (etiquetas o puntero comprimido) desde p.\nfuncion red_dns_saltar_nombre(m, p) {\n    mientras (p < str_largo(m)) {\n        sea n = str_byte(m, p)\n        si (n == 0) { retornar p + 1 }\n        si (n >= 192) { retornar p + 2 }\n        p = p + 1 + n\n    }\n    retornar p\n}\n\n// Consulta A al servidor DNS (UDP 53). Devuelve la ip o -1.\nfuncion red_dns_consultar(nombre, servidor) {\n    sea q = str_nuevo(32 + str_largo(nombre))\n    sea id_buf = mem_reservar(8)\n    sys_aleatorio(id_buf, 2)\n    sea id = __y_bits(__cargar64(id_buf), 65535)\n    mem_liberar(id_buf)\n    str_agregar_byte(q, __desplazar_der(id, 8))\n    str_agregar_byte(q, __y_bits(id, 255))\n    str_agregar_byte(q, 1)                                     // RD\n    str_agregar_byte(q, 0)\n    str_agregar_byte(q, 0)\n    str_agregar_byte(q, 1)                                     // QDCOUNT = 1\n    sea k = 0\n    mientras (k < 6) {\n        str_agregar_byte(q, 0)\n        k = k + 1\n    }\n    sea inicio = 0\n    sea i = 0\n    mientras (i <= str_largo(nombre)) {\n        si (i == str_largo(nombre) o str_byte(nombre, i) == 46) {\n            si (i > inicio) {\n                str_agregar_byte(q, i - inicio)\n                str_agregar(q, str_rebanar(nombre, inicio, i))\n            }\n            inicio = i + 1\n        }\n        i = i + 1\n    }\n    str_agregar_byte(q, 0)\n    str_agregar_byte(q, 0)\n    str_agregar_byte(q, 1)                                     // QTYPE A\n    str_agregar_byte(q, 0)\n    str_agregar_byte(q, 1)                                     // QCLASS IN\n    sea fd = sys_udp_crear(0)\n    si (fd < 0) { retornar 0 - 1 }\n    sys_red_espera(fd, 2500)\n    sea buf = mem_reservar(1500)\n    sea dir = mem_reservar(16)\n    sea resultado = 0 - 1\n    sea intento = 0\n    mientras (intento < 2 y resultado < 0) {\n        sys_udp_enviar(fd, servidor, 53, str_datos(q), str_largo(q))\n        sea n = sys_udp_recibir(fd, buf, 1500, dir, 1)\n        si (n >= 12 y __cargar8(buf) * 256 + __cargar8(buf + 1) == id) {\n            sea m = str_nuevo(n)\n            sea j = 0\n            mientras (j < n) {\n                str_agregar_byte(m, __cargar8(buf + j))\n                j = j + 1\n            }\n            sea respuestas = str_byte(m, 6) * 256 + str_byte(m, 7)\n            sea p = red_dns_saltar_nombre(m, 12) + 4\n            sea r = 0\n            mientras (r < respuestas y resultado < 0 y p + 10 <= n) {\n                p = red_dns_saltar_nombre(m, p)\n                sea tipo = str_byte(m, p) * 256 + str_byte(m, p + 1)\n                sea largo = str_byte(m, p + 8) * 256 + str_byte(m, p + 9)\n                p = p + 10\n                si (tipo == 1 y largo == 4 y p + 4 <= n) {\n                    resultado = str_byte(m, p) * 16777216 + str_byte(m, p + 1) * 65536 + str_byte(m, p + 2) * 256 + str_byte(m, p + 3)\n                }\n                p = p + largo\n                r = r + 1\n            }\n            intento = 2\n        }\n        intento = intento + 1\n    }\n    mem_liberar(dir)\n    mem_liberar(buf)\n    sys_red_cerrar(fd)\n    retornar resultado\n}\n\n// Nombre de máquina → ip: dirección literal, localhost, el resolvedor del\n// sistema (macOS, Windows) o /etc/hosts y DNS propio (Linux). -1 si falla.\nfuncion red_resolver_crudo(nombre) {\n    sea ip = red_ip_de_texto(nombre)\n    si (ip >= 0) { retornar ip }\n    si (red_igual_sin_mayusculas(nombre, \"localhost\")) { retornar 2130706433 }\n    ip = sys_resolver(str_c(nombre))\n    si (ip != 0) { retornar ip }\n    ip = red_buscar_en_archivo(\"/etc/hosts\", nombre)\n    si (ip >= 0) { retornar ip }\n    sea servidor = red_buscar_en_archivo(\"/etc/resolv.conf\", 0)\n    si (servidor < 0) { servidor = 16843009 }                  // 1.1.1.1\n    retornar red_dns_consultar(nombre, servidor)\n}\n\nfuncion red_resolver(nombre) {\n    sea ip = red_resolver_crudo(dyn_texto_de(nombre, \"red_resolver\"))\n    si (ip < 0) { retornar 0 }\n    retornar dyn_texto(red_texto_de_ip(ip))\n}\n\n// ── TCP ──\n\nfuncion net_conectar(host, puerto) {\n    sea nombre = dyn_texto_de(host, \"net_conectar\")\n    sea ip = red_resolver_crudo(nombre)\n    si (ip < 0) { dyn_error(str_concatenar(\"net_conectar: no se pudo resolver \", nombre)) }\n    sea fd = sys_red_conectar(ip, dyn_valor_entero(puerto))\n    si (fd < 0) { dyn_error(str_concatenar(\"net_conectar: no se pudo conectar a \", nombre)) }\n    sys_red_espera(fd, 15000)\n    retornar dyn_entero(fd)\n}\n\nfuncion net_espera(sock, ms) {\n    sys_red_espera(dyn_valor_entero(sock), dyn_valor_entero(ms))\n    retornar 0\n}\n\nfuncion net_enviar(sock, datos) {\n    sea fd = dyn_valor_entero(sock)\n    sea s = dyn_a_str(datos)\n    sea hecho = 0\n    mientras (hecho < str_largo(s)) {\n        sea n = sys_red_escribir(fd, str_datos(s) + hecho, str_largo(s) - hecho)\n        si (n <= 0) { dyn_error(\"net_enviar: la conexión se cerró\") }\n        hecho = hecho + n\n    }\n    retornar dyn_entero(hecho)\n}\n\n// Lee hasta max bytes (por defecto 65536). \"\" si la conexión terminó o se\n// agotó la espera.\nfuncion net_recibir(sock, max) {\n    sea limite = 65536\n    si (max != 0) { limite = dyn_valor_entero(max) }\n    sea r = str_nuevo(limite)\n    sea n = sys_red_leer(dyn_valor_entero(sock), str_datos(r), limite)\n    si (n > 0) { __guardar64(r, n) }\n    retornar dyn_texto(r)\n}\n\n// Todo lo que llegue hasta que la otra parte cierre.\nfuncion net_recibir_todo(sock) {\n    sea fd = dyn_valor_entero(sock)\n    sea r = str_nuevo(4096)\n    sea seguir = 1\n    mientras (seguir) {\n        str_asegurar(r, str_largo(r) + 65536)\n        sea n = sys_red_leer(fd, str_datos(r) + str_largo(r), 65536)\n        si (n <= 0) { seguir = 0 } sino { __guardar64(r, str_largo(r) + n) }\n    }\n    retornar dyn_texto(r)\n}\n\n// Envía y devuelve la respuesta: espera el primer bloque y sigue leyendo\n// mientras lleguen datos (pausa de 100 ms).\nfuncion net_enviar_recibir(sock, datos) {\n    sea fd = dyn_valor_entero(sock)\n    net_enviar(sock, datos)\n    sea r = str_nuevo(4096)\n    sea seguir = 1\n    sea primero = 1\n    mientras (seguir) {\n        str_asegurar(r, str_largo(r) + 65536)\n        sea n = sys_red_leer(fd, str_datos(r) + str_largo(r), 65536)\n        si (n <= 0) {\n            seguir = 0\n        } sino {\n            __guardar64(r, str_largo(r) + n)\n            si (primero) {\n                sys_red_espera(fd, 100)\n                primero = 0\n            }\n        }\n    }\n    sys_red_espera(fd, 15000)\n    retornar dyn_texto(r)\n}\n\nfuncion net_cerrar(sock) {\n    sys_red_cerrar(dyn_valor_entero(sock))\n    retornar 0\n}\n\n// ── UDP ──\n\nfuncion udp_crear(puerto) {\n    sea p = 0\n    si (puerto != 0) { p = dyn_valor_entero(puerto) }\n    sea fd = sys_udp_crear(p)\n    si (fd < 0) { dyn_error(str_concatenar(\"udp_crear: no se pudo abrir el puerto \", str_desde_entero(p))) }\n    retornar dyn_entero(fd)\n}\n\nfuncion udp_enviar(sock, host, puerto, datos) {\n    sea nombre = dyn_texto_de(host, \"udp_enviar\")\n    sea ip = red_resolver_crudo(nombre)\n    si (ip < 0) { dyn_error(str_concatenar(\"udp_enviar: dirección inválida \", nombre)) }\n    sea s = dyn_a_str(datos)\n    sys_udp_enviar(dyn_valor_entero(sock), ip, dyn_valor_entero(puerto), str_datos(s), str_largo(s))\n    retornar 0\n}\n\n// {\"datos\", \"origen\", \"puerto\"} o nulo si no hay datagramas (no bloquea).\nfuncion udp_recibir(sock) {\n    sea buf = mem_reservar(65536)\n    sea dir = mem_reservar(16)\n    sea n = sys_udp_recibir(dyn_valor_entero(sock), buf, 65536, dir, 0)\n    si (n <= 0) {\n        mem_liberar(buf)\n        mem_liberar(dir)\n        retornar 0\n    }\n    sea datos = str_nuevo(n)\n    sea i = 0\n    mientras (i < n) {\n        str_agregar_byte(datos, __cargar8(buf + i))\n        i = i + 1\n    }\n    sea ip = __cargar8(dir + 4) * 16777216 + __cargar8(dir + 5) * 65536 + __cargar8(dir + 6) * 256 + __cargar8(dir + 7)\n    sea m = map_nuevo()\n    map_fijar(m, \"datos\", dyn_texto(datos))\n    map_fijar(m, \"origen\", dyn_texto(red_texto_de_ip(ip)))\n    map_fijar(m, \"puerto\", dyn_entero(__cargar8(dir + 2) * 256 + __cargar8(dir + 3)))\n    mem_liberar(buf)\n    mem_liberar(dir)\n    retornar dyn_caja(3, m)\n}\n\nfuncion udp_cerrar(sock) {\n    sys_red_cerrar(dyn_valor_entero(sock))\n    retornar 0\n}\n\n// ── TLS (HTTPS) con la biblioteca del sistema ─────────────────────────────\n// Linux y macOS: OpenSSL 3 (o 1.1) cargado en tiempo de ejecución, con\n// verificación de certificados contra el almacén del sistema y SNI.\n// Windows: Schannel (SSPI). El estado de una conexión es un bloque de\n// 64 bytes: [ssl][ctx][fd][tipo][...].\n\nfuncion tls_i32(x) {\n    sea v = __y_bits(x, 4294967295)\n    si (v >= 2147483648) { retornar v - 4294967296 }\n    retornar v\n}\n\n// Handle de libssl (global 16), o 0 si no está disponible.\nfuncion tls_libssl() {\n    sea h = mem_global(16)\n    si (h != 0) { retornar h }\n    si (sys_dl_disponible() == 0) { retornar 0 }\n    sea candidatos = vec_nuevo()\n    si (__plataforma() == 2 o __plataforma() == 3) {\n        vec_agregar(candidatos, \"/opt/homebrew/opt/openssl@3/lib/libssl.3.dylib\")\n        vec_agregar(candidatos, \"/usr/local/opt/openssl@3/lib/libssl.3.dylib\")\n        vec_agregar(candidatos, \"/opt/homebrew/lib/libssl.3.dylib\")\n        vec_agregar(candidatos, \"/usr/local/lib/libssl.3.dylib\")\n    } sino {\n        vec_agregar(candidatos, \"libssl.so.3\")\n        vec_agregar(candidatos, \"libssl.so.1.1\")\n    }\n    sea i = 0\n    mientras (i < vec_largo(candidatos) y h == 0) {\n        h = dyn_abrir_biblioteca(vec_obtener(candidatos, i))\n        i = i + 1\n    }\n    si (h != 0) {\n        mem_fijar_global(16, h)\n        __ccall(sys_simbolo(h, \"OPENSSL_init_ssl\"), 0, 0)\n    }\n    retornar h\n}\n\nfuncion tls_f(nombre) {\n    sea p = sys_simbolo(tls_libssl(), nombre)\n    si (p == 0) { dyn_error(str_concatenar(\"tls: falta el símbolo de OpenSSL \", nombre)) }\n    retornar p\n}\n\nfuncion tls_error(estado, mensaje) {\n    sys_red_cerrar(__cargar64(estado + 16))\n    dyn_error(mensaje)\n    retornar 0\n}\n\nfuncion tls_abrir(sock, anfitrion) {\n    sea fd = dyn_valor_entero(sock)\n    sea host = dyn_texto_de(anfitrion, \"tls_abrir\")\n    sea estado = mem_reservar(64)\n    mem_llenar(estado, 0, 64)\n    __guardar64(estado + 16, fd)\n    __guardar64(estado + 56, tls_marca())\n    si (sys_es_windows()) { retornar tls_abrir_schannel(estado, host) }\n    si (tls_libssl() == 0) {\n        si (sys_dl_disponible() == 0) { tls_error(estado, \"https: agrega importar \\\"tls\\\" (o \\\"red\\\") al programa para usar TLS\") }\n        tls_error(estado, \"https: no se encontró OpenSSL (libssl 3 o 1.1); en macOS: brew install openssl@3\")\n    }\n    sea ctx = __ccall(tls_f(\"SSL_CTX_new\"), __ccall(tls_f(\"TLS_client_method\")))\n    si (ctx == 0) { tls_error(estado, \"tls: SSL_CTX_new falló\") }\n    __ccall(tls_f(\"SSL_CTX_set_default_verify_paths\"), ctx)\n    __ccall(tls_f(\"SSL_CTX_set_verify\"), ctx, 1, 0)             // SSL_VERIFY_PEER\n    // TLS 1.2 como mínimo (SSL_CTRL_SET_MIN_PROTO_VERSION) y, en 1.2, solo\n    // suites AEAD con ECDHE (TLS 1.3 ya es AEAD siempre).\n    __ccall(tls_f(\"SSL_CTX_ctrl\"), ctx, 123, 771, 0)\n    __ccall(tls_f(\"SSL_CTX_set_cipher_list\"), ctx, str_c(\"ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305\"))\n    sea ssl = __ccall(tls_f(\"SSL_new\"), ctx)\n    __guardar64(estado, ssl)\n    __guardar64(estado + 8, ctx)\n    __guardar64(estado + 24, 1)\n    __ccall(tls_f(\"SSL_set_fd\"), ssl, fd)\n    sea host_c = str_c(host)\n    __ccall(tls_f(\"SSL_ctrl\"), ssl, 55, 0, host_c)              // SNI\n    __ccall(tls_f(\"SSL_set1_host\"), ssl, host_c)                // nombre del certificado\n    si (tls_i32(__ccall(tls_f(\"SSL_connect\"), ssl)) != 1) {\n        sea v = __ccall(tls_f(\"SSL_get_verify_result\"), ssl)\n        __ccall(tls_f(\"SSL_free\"), ssl)\n        __ccall(tls_f(\"SSL_CTX_free\"), ctx)\n        si (v != 0) { tls_error(estado, str_concatenar(str_concatenar(\"tls: certificado no válido para \", host), str_concatenar(\" (código \", str_concatenar(str_desde_entero(v), \")\")))) }\n        tls_error(estado, str_concatenar(\"tls: no se pudo establecer la sesión con \", host))\n    }\n    retornar dyn_caja(11, estado)\n}\n\n// Marca de una conexión TLS viva: sin ella (un número cualquiera, nulo o una\n// conexión ya cerrada) las funciones dan un error en vez de leer memoria ajena.\nfuncion tls_marca() { retornar 5527379 }\n\nfuncion tls_estado(t) {\n    si (dyn_tipo(t) != 11) { dyn_error(\"tls: se esperaba una conexión de tls_abrir\") }\n    sea estado = dyn_dato(t)\n    si (estado == 0 o __cargar64(estado + 56) != tls_marca()) { dyn_error(\"tls: la conexión no es válida o ya se cerró\") }\n    retornar estado\n}\n\nfuncion tls_enviar(t, datos) {\n    sea estado = tls_estado(t)\n    si (__cargar64(estado + 24) == 2) { retornar tls_enviar_schannel(estado, datos) }\n    sea s = dyn_a_str(datos)\n    sea hecho = 0\n    mientras (hecho < str_largo(s)) {\n        sea n = tls_i32(__ccall(tls_f(\"SSL_write\"), __cargar64(estado), str_datos(s) + hecho, str_largo(s) - hecho))\n        si (n <= 0) { dyn_error(\"tls: la conexión se cerró al enviar\") }\n        hecho = hecho + n\n    }\n    retornar dyn_entero(hecho)\n}\n\nfuncion tls_recibir_todo(t) {\n    sea estado = tls_estado(t)\n    si (__cargar64(estado + 24) == 2) { retornar tls_recibir_todo_schannel(estado) }\n    sea r = str_nuevo(4096)\n    sea leer = tls_f(\"SSL_read\")\n    sea seguir = 1\n    mientras (seguir) {\n        str_asegurar(r, str_largo(r) + 16384)\n        sea n = tls_i32(__ccall(leer, __cargar64(estado), str_datos(r) + str_largo(r), 16384))\n        si (n <= 0) { seguir = 0 } sino { __guardar64(r, str_largo(r) + n) }\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion tls_cerrar(t) {\n    sea estado = tls_estado(t)\n    // Sin marca, cualquier uso posterior da error (no se libera la memoria:\n    // el recolector la reclama cuando nadie la usa, sin usos tras liberar).\n    __guardar64(estado + 56, 0)\n    si (__cargar64(estado + 24) == 2) { retornar tls_cerrar_schannel(estado) }\n    si (__cargar64(estado) != 0) {\n        __ccall(tls_f(\"SSL_shutdown\"), __cargar64(estado))\n        __ccall(tls_f(\"SSL_free\"), __cargar64(estado))\n        __ccall(tls_f(\"SSL_CTX_free\"), __cargar64(estado + 8))\n    }\n    sys_red_cerrar(__cargar64(estado + 16))\n    retornar 0\n}\n\n// Versión negociada (\"TLSv1.3\", \"TLSv1.2\"…).\nfuncion tls_version(t) {\n    sea estado = tls_estado(t)\n    si (__cargar64(estado + 24) == 2) { retornar dyn_texto(sys_tls_version(estado)) }\n    si (__cargar64(estado) == 0) { retornar dyn_texto(\"desconocida\") }\n    retornar dyn_texto(str_desde_c(__ccall(tls_f(\"SSL_get_version\"), __cargar64(estado))))\n}\n\n// Schannel (Windows): el trabajo está en sys_windows_ext.cfv.\nfuncion tls_abrir_schannel(estado, host) {\n    __guardar64(estado + 24, 2)\n    sea r = sys_tls_abrir(estado, host)\n    si (r != 0) {\n        sea m = str_concatenar(\"tls: no se pudo establecer la sesión con \", host)\n        str_agregar(m, \" (SSPI 0x\")\n        sea k = 7\n        mientras (k >= 0) {\n            str_agregar_byte(m, __o_bits(hex_digito(__y_bits(__desplazar_der(r, k * 4), 15)), 32))\n            k = k - 1\n        }\n        str_agregar(m, \")\")\n        tls_error(estado, m)\n    }\n    retornar dyn_caja(11, estado)\n}\n\nfuncion tls_enviar_schannel(estado, datos) {\n    sea s = dyn_a_str(datos)\n    si (sys_tls_enviar(estado, str_datos(s), str_largo(s)) != 0) { dyn_error(\"tls: la conexión se cerró al enviar\") }\n    retornar dyn_entero(str_largo(s))\n}\n\nfuncion tls_recibir_todo_schannel(estado) { retornar dyn_texto(sys_tls_recibir_todo(estado)) }\n\nfuncion tls_cerrar_schannel(estado) {\n    sys_tls_cerrar(estado)\n    sys_red_cerrar(__cargar64(estado + 16))\n    retornar 0\n}\n\n// cforge repl: omitir las primeras n líneas de mostrar y anotar cuántas\n// se mostraron en el archivo de conteo.\nfuncion repl_preparar(omitir, archivo_conteo) {\n    sea r = mem_reservar(24)\n    __guardar64(r, dyn_valor_entero(omitir))\n    __guardar64(r + 8, 0)\n    __guardar64(r + 16, dyn_texto_de(archivo_conteo, \"repl_preparar\"))\n    si (archivo_intentar_escribir(__cargar64(r + 16), \"0\") < 0) { dyn_error(\"repl: no se pudo escribir el archivo de estado\") }\n    mem_fijar_global(17, r)\n    retornar 0\n}\n\n// Estado de la memoria: bytes en uso, recolecciones, bytes liberados por el\n// recolector y bytes de arena usados.\nfuncion memoria_estadisticas() {\n    sea m = map_nuevo()\n    map_fijar(m, \"en_uso\", dyn_entero(mem_global(14)))\n    sea gc = mem_global(18)\n    sea recolecciones = 0\n    sea liberados = 0\n    sea arena = 0\n    si (gc != 0) {\n        recolecciones = __cargar64(gc + 64)\n        liberados = __cargar64(gc + 72)\n        sea n = __cargar64(gc)\n        sea i = 0\n        mientras (i < n) {\n            sea r = gc + 128 + i * 32\n            sea fin = __cargar64(r + 8)\n            si (i == n - 1) { fin = mem_global(0) }\n            arena = arena + fin - __cargar64(r)\n            i = i + 1\n        }\n    }\n    map_fijar(m, \"recolecciones\", dyn_entero(recolecciones))\n    map_fijar(m, \"liberados\", dyn_entero(liberados))\n    map_fijar(m, \"arena\", dyn_entero(arena))\n    map_fijar(m, \"recolector\", dyn_bool(gc != 0))\n    retornar dyn_caja(3, m)\n}\n\n// Un byte como texto de un carácter (sin codificar UTF-8).\nfuncion char_de(n) {\n    sea r = str_nuevo(1)\n    str_agregar_byte(r, __y_bits(dyn_valor_entero(n), 255))\n    retornar dyn_texto(r)\n}\n// Segundos desde la época (Unix) con decimales.\nfuncion tiempo_actual() { retornar dyn_desde_f64(__f64_div(__f64_desde_entero(sys_reloj_ns()), __f64_desde_entero(1000000000))) }\n\nfuncion hilo_dormir(ms) {\n    sys_dormir_ms(dyn_valor_entero(ms))\n    retornar 0\n}\n\nfuncion dormir(ms) { retornar hilo_dormir(ms) }\n\n// ── Hilos, canales y mutex (clone + futex) ────────────────────────────────\n\nfuncion futex_esperar(direccion, valor, ms) { retornar futex_esperar_op(direccion, valor, ms, 128) }\n\n// op 128: FUTEX_WAIT_PRIVATE · op 0: FUTEX_WAIT (el kernel despierta el tid\n// de CLONE_CHILD_CLEARTID con un FUTEX_WAKE compartido).\nfuncion futex_esperar_op(direccion, valor, ms, op) {\n    sys_futex_esperar(direccion, valor, ms, op)\n    retornar 0\n}\n\nfuncion futex_despertar(direccion) {\n    sys_futex_despertar(direccion)\n    retornar 0\n}\n\nfuncion cerrojo_tomar(direccion) {\n    mientras (__intercambiar(direccion, 1) != 0) { futex_esperar(direccion, 1, 0 - 1) }\n    retornar 0\n}\n\nfuncion cerrojo_soltar(direccion) {\n    __guardar64(direccion, 0)\n    futex_despertar(direccion)\n    retornar 0\n}\n\n// Hilo nuevo con pila propia de 8 MiB alineada; su registro (en la base de\n// la pila): [hilo vivo][manejadores de intentar][tid].\n// La función de entrada es tarea_ejecutar(t) (runtime/lenguaje.cfv).\nfuncion dyn_hilo_lanzar(t) {\n    sea tam = 8388608\n    sea zona = sys_mapear(tam * 2)\n    si (zona < 0) { dyn_error(\"no se pudo reservar la pila del hilo\") }\n    sea base = __y_bits(zona + tam - 1, 0 - tam)\n    __guardar64(base, 1)\n    __guardar64(base + 8, 0)\n    __guardar64(base + 16, 1)\n    dyn_anotar_hilo(base)\n    si (sys_hilo_crear(base, tam, t) < 0) { dyn_error(\"no se pudo crear el hilo\") }\n    retornar dyn_entero(base)\n}\n\nfuncion dyn_hilo_inicio(t) {\n    tarea_ejecutar(t)\n    retornar 0\n}\n\n// Espera a que el hilo termine (CLONE_CHILD_CLEARTID pone el tid en 0).\n// Devuelve verdadero si terminó, falso si venció el plazo (ms, o nulo).\nfuncion dyn_hilo_esperar(base_v, limite) {\n    sea base = dyn_valor_entero(base_v)\n    sea ms = 0 - 1\n    si (__y_bits(limite, 1) == 1) { ms = dyn_valor_entero(limite) }\n    sea inicio = sys_reloj_ns() / 1000000\n    // El futex se espera con el mismo valor que se comprobó: si se volviera\n    // a leer, el hilo podría terminar entre las dos lecturas y la espera\n    // con 0 no despertaría nunca.\n    sea tid = __y_bits(__cargar64(base + 16), 4294967295)\n    mientras (tid != 0) {\n        si (ms >= 0) {\n            sea resta = ms - (sys_reloj_ns() / 1000000 - inicio)\n            si (resta <= 0) { retornar 2 }\n            futex_esperar_op(base + 16, tid, resta, 0)\n        } sino {\n            futex_esperar_op(base + 16, tid, 0 - 1, 0)\n        }\n        tid = __y_bits(__cargar64(base + 16), 4294967295)\n    }\n    retornar 4\n}\n\n// Canal: [cerrojo][secuencia][cola][inicio][capacidad][cerrado]\nfuncion canal_nuevo(capacidad) {\n    sea r = mem_reservar(48)\n    __guardar64(r, 0)\n    __guardar64(r + 8, 0)\n    __guardar64(r + 16, vec_nuevo())\n    __guardar64(r + 24, 0)\n    sea cap = 0\n    si (__y_bits(capacidad, 1) == 1) { cap = dyn_valor_entero(capacidad) }\n    __guardar64(r + 32, cap)\n    __guardar64(r + 40, 0)\n    retornar dyn_caja(9, r)\n}\n\nfuncion canal_de(v) {\n    si (dyn_tipo(v) != 9) { dyn_error_tipo(\"se esperaba un canal\", v) }\n    retornar dyn_dato(v)\n}\n\nfuncion canal_tam_crudo(r) { retornar vec_largo(__cargar64(r + 16)) - __cargar64(r + 24) }\n\nfuncion canal_avisar(r) {\n    __guardar64(r + 8, __cargar64(r + 8) + 1)\n    cerrojo_soltar(r)\n    futex_despertar(r + 8)\n    retornar 0\n}\n\nfuncion canal_enviar(canal, v) {\n    sea r = canal_de(canal)\n    mientras (verdadero) {\n        cerrojo_tomar(r)\n        si (__cargar64(r + 40)) {\n            cerrojo_soltar(r)\n            dyn_error(\"canal_enviar: el canal está cerrado\")\n        }\n        si (__cargar64(r + 32) == 0 o canal_tam_crudo(r) < __cargar64(r + 32)) {\n            vec_agregar(__cargar64(r + 16), v)\n            canal_avisar(r)\n            retornar 0\n        }\n        sea secuencia = __cargar64(r + 8)\n        cerrojo_soltar(r)\n        futex_esperar(r + 8, secuencia, 0 - 1)\n    }\n    retornar 0\n}\n\n// Bloquea hasta recibir un valor; nulo si el canal está cerrado y vacío.\nfuncion canal_recibir(canal) {\n    sea r = canal_de(canal)\n    mientras (verdadero) {\n        cerrojo_tomar(r)\n        si (canal_tam_crudo(r) > 0) {\n            sea cola = __cargar64(r + 16)\n            sea inicio = __cargar64(r + 24)\n            sea v = vec_obtener(cola, inicio)\n            inicio = inicio + 1\n            si (inicio == vec_largo(cola)) {\n                __guardar64(cola, 0)\n                inicio = 0\n            }\n            __guardar64(r + 24, inicio)\n            canal_avisar(r)\n            retornar v\n        }\n        si (__cargar64(r + 40)) {\n            cerrojo_soltar(r)\n            retornar 0\n        }\n        sea secuencia = __cargar64(r + 8)\n        cerrojo_soltar(r)\n        futex_esperar(r + 8, secuencia, 0 - 1)\n    }\n    retornar 0\n}\n\nfuncion canal_tam(canal) {\n    sea r = canal_de(canal)\n    cerrojo_tomar(r)\n    sea n = canal_tam_crudo(r)\n    cerrojo_soltar(r)\n    retornar dyn_entero(n)\n}\n\nfuncion canal_cerrar(canal) {\n    sea r = canal_de(canal)\n    cerrojo_tomar(r)\n    __guardar64(r + 40, 1)\n    canal_avisar(r)\n    retornar 0\n}\n\n// Mutex: [estado] con futex.\nfuncion mutex_crear() {\n    sea r = mem_reservar(8)\n    __guardar64(r, 0)\n    retornar dyn_caja(10, r)\n}\n\nfuncion mutex_de(v) {\n    si (dyn_tipo(v) != 10) { dyn_error_tipo(\"se esperaba un mutex\", v) }\n    retornar dyn_dato(v)\n}\n\nfuncion mutex_bloquear(m) { cerrojo_tomar(mutex_de(m)) retornar 0 }\nfuncion mutex_desbloquear(m) { cerrojo_soltar(mutex_de(m)) retornar 0 }\nfuncion mutex_liberar(m) { retornar mutex_desbloquear(m) }\n\n// ── Servidor HTTP (socket, bind, listen, accept) ──────────────────────────\n// Servidores en la global 32: [descriptor del socket][cliente activo].\n\nfuncion http_servidores() {\n    sea v = mem_global(32)\n    si (v == 0) {\n        v = vec_nuevo()\n        mem_fijar_global(32, v)\n    }\n    retornar v\n}\n\nfuncion http_servidor(id) {\n    sea v = http_servidores()\n    sea i = dyn_valor_entero(id)\n    si (__y_bits(id, 1) != 1 o i < 0 o i >= vec_largo(v)) { dyn_error(\"servidor http: id inválido\") }\n    retornar vec_obtener(v, i)\n}\n\n// IPv4 \"a.b.c.d\" (o \"localhost\") como entero; -1 si no es válida.\nfuncion http_ip_entero(s) {\n    si (str_igual(s, \"localhost\")) { retornar 2130706433 }\n    si (str_largo(s) == 0) { retornar 0 }\n    sea r = 0\n    sea parte = 0 - 1\n    sea partes = 0\n    sea i = 0\n    mientras (i <= str_largo(s)) {\n        sea b = 46\n        si (i < str_largo(s)) { b = str_byte(s, i) }\n        si (b == 46) {\n            si (parte < 0 o parte > 255) { retornar 0 - 1 }\n            r = r * 256 + parte\n            partes = partes + 1\n            parte = 0 - 1\n        } sino {\n            si (b < 48 o b > 57) { retornar 0 - 1 }\n            si (parte < 0) { parte = 0 }\n            parte = parte * 10 + b - 48\n            si (parte > 255) { retornar 0 - 1 }\n        }\n        i = i + 1\n    }\n    si (partes != 4) { retornar 0 - 1 }\n    retornar r\n}\n\n// Escucha solo en 127.0.0.1 (este equipo): seguro por defecto. Para\n// atender a otros equipos, servidor_http_escuchar_en(\"0.0.0.0\", puerto) o\n// la variable de entorno CFORGE_HTTP_HOST (p. ej. CFORGE_HTTP_HOST=0.0.0.0\n// en un contenedor).\nfuncion servidor_http_escuchar(puerto) {\n    sea h = sys_variable_entorno(\"CFORGE_HTTP_HOST\")\n    si (h == 0) { h = \"127.0.0.1\" }\n    retornar servidor_http_escuchar_en(dyn_texto(h), puerto)\n}\n\nfuncion servidor_http_escuchar_en(host, puerto) {\n    sea ip = http_ip_entero(dyn_texto_de(host, \"servidor_http_escuchar_en\"))\n    si (ip < 0) { dyn_error(str_concatenar(\"servidor_http_escuchar_en: dirección IPv4 inválida: \", dyn_dato(host))) }\n    sea p = dyn_valor_entero(puerto)\n    si (__y_bits(puerto, 1) != 1 o p < 1 o p > 65535) { dyn_error(\"servidor_http_escuchar: puerto invalido\") }\n    sea fd = sys_red_escuchar(p, ip)\n    si (fd == 0 - 1) { dyn_error(\"servidor_http_escuchar: no se pudo crear socket\") }\n    si (fd == 0 - 2) { dyn_error(str_concatenar(\"servidor_http_escuchar: no se pudo enlazar al puerto \", str_desde_entero(p))) }\n    si (fd < 0) { dyn_error(\"servidor_http_escuchar: no se pudo escuchar\") }\n    // [socket][cliente][máx. cabeceras][máx. cuerpo][ms por lectura][ms cabeceras]\n    sea r = mem_reservar(48)\n    __guardar64(r, fd)\n    __guardar64(r + 8, 0 - 1)\n    __guardar64(r + 16, 8192)\n    __guardar64(r + 24, 16777216)\n    __guardar64(r + 32, 10000)\n    __guardar64(r + 40, 5000)\n    sea v = http_servidores()\n    vec_agregar(v, r)\n    retornar dyn_entero(vec_largo(v) - 1)\n}\n\nfuncion http_linea_hasta(s, desde, aguja) {\n    sea p = str_buscar(s, aguja, desde)\n    si (p < 0) { retornar str_largo(s) }\n    retornar p\n}\n\nfuncion http_minusculas(s) {\n    sea r = str_nuevo(str_largo(s))\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        sea b = str_byte(s, i)\n        si (b >= 65 y b <= 90) { b = b + 32 }\n        str_agregar_byte(r, b)\n        i = i + 1\n    }\n    retornar r\n}\n\n// Límites del servidor: bytes de cabeceras, bytes de cuerpo, ms de espera\n// por lectura y ms para recibir todas las cabeceras (anti Slowloris).\nfuncion servidor_http_limites(id, cabeceras, cuerpo, ms_lectura, ms_cabeceras) {\n    sea srv = http_servidor(id)\n    si (cabeceras != 0) { __guardar64(srv + 16, dyn_valor_entero(cabeceras)) }\n    si (cuerpo != 0) { __guardar64(srv + 24, dyn_valor_entero(cuerpo)) }\n    si (ms_lectura != 0) { __guardar64(srv + 32, dyn_valor_entero(ms_lectura)) }\n    si (ms_cabeceras != 0) { __guardar64(srv + 40, dyn_valor_entero(ms_cabeceras)) }\n    retornar 0\n}\n\nfuncion http_rechazar(cliente, estado) {\n    sea r = str_concatenar(\"HTTP/1.1 \", estado)\n    str_agregar(r, \"\\r\\nContent-Length: 0\\r\\nConnection: close\\r\\n\\r\\n\")\n    sys_red_escribir(cliente, str_datos(r), str_largo(r))\n    sys_red_cerrar(cliente)\n    retornar 0\n}\n\n// Valida las cabeceras (en minúsculas) de una solicitud. Devuelve el largo\n// del cuerpo, o un código negativo: -400 solicitud ambigua o inválida\n// (Content-Length y Transfer-Encoding a la vez, Content-Length repetido o no\n// numérico), -501 Transfer-Encoding no soportado, -413 cuerpo demasiado\n// grande.\nfuncion http_largo_cuerpo(cabeceras, maximo) {\n    sea largo = 0\n    sea vistos = 0\n    sea te = 0\n    sea pos = 0\n    mientras (pos < str_largo(cabeceras)) {\n        sea nl = http_linea_hasta(cabeceras, pos, \"\\r\\n\")\n        sea l = str_rebanar(cabeceras, pos, nl)\n        si (str_largo(l) > 0 y (str_byte(l, 0) == 32 o str_byte(l, 0) == 9)) { retornar 0 - 400 }     // obs-fold\n        sea dp = str_buscar(l, \":\", 0)\n        si (dp > 0) {\n            sea nombre = str_rebanar(l, 0, dp)\n            si (str_byte(nombre, str_largo(nombre) - 1) == 32 o str_byte(nombre, str_largo(nombre) - 1) == 9) { retornar 0 - 400 }\n            sea v = dp + 1\n            mientras (v < str_largo(l) y (str_byte(l, v) == 32 o str_byte(l, v) == 9)) { v = v + 1 }\n            sea f = str_largo(l)\n            mientras (f > v y (str_byte(l, f - 1) == 32 o str_byte(l, f - 1) == 9)) { f = f - 1 }\n            si (str_igual(nombre, \"transfer-encoding\")) { te = 1 }\n            si (str_igual(nombre, \"content-length\")) {\n                si (f == v o f - v > 15) { retornar 0 - 400 }\n                sea n = 0\n                sea k = v\n                mientras (k < f) {\n                    sea c = str_byte(l, k)\n                    si (c < 48 o c > 57) { retornar 0 - 400 }\n                    n = n * 10 + c - 48\n                    k = k + 1\n                }\n                si (vistos == 1 y n != largo) { retornar 0 - 400 }\n                largo = n\n                vistos = 1\n            }\n        }\n        pos = nl + 2\n    }\n    si (te == 1 y vistos == 1) { retornar 0 - 400 }\n    si (te == 1) { retornar 0 - 501 }\n    si (largo > maximo) { retornar 0 - 413 }\n    retornar largo\n}\n\n// Espera una petición y la devuelve como mapa: metodo, ruta, query,\n// cuerpo, cabeceras (en minúsculas), ip y _srv_id. Las solicitudes\n// inválidas, demasiado grandes o lentas se responden con 400/408/413/431/501\n// y se sigue esperando la siguiente.\nfuncion servidor_http_solicitud(id) {\n    sea r = 0\n    mientras (r == 0) { r = servidor_http_intentar(id) }\n    retornar r\n}\n\nfuncion servidor_http_intentar(id) {\n    sea srv = http_servidor(id)\n    si (__cargar64(srv + 8) >= 0) {\n        sys_red_cerrar(__cargar64(srv + 8))\n        __guardar64(srv + 8, 0 - 1)\n    }\n    sea dir = mem_reservar(16)\n    sea largo_dir = mem_reservar(8)\n    __guardar64(largo_dir, 16)\n    sea cliente = sys_red_aceptar(__cargar64(srv), dir, largo_dir)\n    si (cliente < 0) { dyn_error(\"servidor_http_solicitud: accept fallo\") }\n    sea ip = str_nuevo(16)\n    sea k = 0\n    mientras (k < 4) {\n        si (k > 0) { str_agregar_byte(ip, 46) }\n        str_agregar(ip, str_desde_entero(__cargar8(dir + 4 + k)))\n        k = k + 1\n    }\n    mem_liberar(dir)\n    mem_liberar(largo_dir)\n    sea max_cab = __cargar64(srv + 16)\n    sea max_cuerpo = __cargar64(srv + 24)\n    sys_red_espera(cliente, __cargar64(srv + 32))\n    sea limite_cab = sys_reloj_ns() / 1000000 + __cargar64(srv + 40)\n    // Leer cabeceras y luego el cuerpo según Content-Length.\n    sea crudo = str_nuevo(4096)\n    sea buf = mem_reservar(4096)\n    sea fin_cabeceras = 0 - 1\n    sea esperado = 0 - 1\n    sea seguir = 1\n    sea rechazo = 0\n    mientras (seguir) {\n        sea pedir = 4096\n        si (fin_cabeceras >= 0 y esperado - (str_largo(crudo) - fin_cabeceras - 4) < pedir) { pedir = esperado - (str_largo(crudo) - fin_cabeceras - 4) }\n        sea n = 0\n        si (pedir > 0) { n = sys_red_leer(cliente, buf, pedir) }\n        si (n <= 0) {\n            seguir = 0\n            si (fin_cabeceras < 0) {\n                si (str_largo(crudo) > 0) { rechazo = 408 } sino { rechazo = 1 }\n            }\n        } sino {\n            sea i = 0\n            mientras (i < n) {\n                str_agregar_byte(crudo, __cargar8(buf + i))\n                i = i + 1\n            }\n            si (fin_cabeceras < 0) {\n                fin_cabeceras = str_buscar(crudo, \"\\r\\n\\r\\n\", 0)\n                si (fin_cabeceras < 0) {\n                    si (str_largo(crudo) > max_cab) { rechazo = 431 }\n                    si (sys_reloj_ns() / 1000000 > limite_cab) { rechazo = 408 }\n                } sino {\n                    si (fin_cabeceras > max_cab) { rechazo = 431 } sino {\n                        esperado = http_largo_cuerpo(http_minusculas(str_rebanar(crudo, 0, fin_cabeceras)), max_cuerpo)\n                        si (esperado < 0) { rechazo = 0 - esperado }\n                    }\n                }\n                si (rechazo != 0) { seguir = 0 }\n            }\n            si (seguir y fin_cabeceras >= 0 y str_largo(crudo) - fin_cabeceras - 4 >= esperado) { seguir = 0 }\n        }\n    }\n    si (rechazo != 0) {\n        mem_liberar(buf)\n        si (rechazo == 1) { sys_red_cerrar(cliente) }\n        si (rechazo == 400) { http_rechazar(cliente, \"400 Bad Request\") }\n        si (rechazo == 408) { http_rechazar(cliente, \"408 Request Timeout\") }\n        si (rechazo == 413) { http_rechazar(cliente, \"413 Content Too Large\") }\n        si (rechazo == 431) { http_rechazar(cliente, \"431 Request Header Fields Too Large\") }\n        si (rechazo == 501) { http_rechazar(cliente, \"501 Not Implemented\") }\n        retornar 0\n    }\n    // Cuerpo incompleto (la conexión se cortó o expiró): no se entrega.\n    si (fin_cabeceras >= 0 y str_largo(crudo) - fin_cabeceras - 4 < esperado) {\n        mem_liberar(buf)\n        http_rechazar(cliente, \"400 Bad Request\")\n        retornar 0\n    }\n    __guardar64(srv + 8, cliente)\n    mem_liberar(buf)\n    si (fin_cabeceras < 0) { fin_cabeceras = str_largo(crudo) }\n    // Línea de petición: MÉTODO RUTA PROTOCOLO\n    sea fin_linea = http_linea_hasta(crudo, 0, \"\\r\\n\")\n    sea linea = str_rebanar(crudo, 0, fin_linea)\n    sea e1 = str_buscar(linea, \" \", 0)\n    sea metodo = \"GET\"\n    sea ruta = \"/\"\n    si (e1 > 0) {\n        metodo = str_rebanar(linea, 0, e1)\n        sea e2 = str_buscar(linea, \" \", e1 + 1)\n        si (e2 < 0) { e2 = str_largo(linea) }\n        ruta = str_rebanar(linea, e1 + 1, e2)\n    }\n    sea consulta = \"\"\n    sea q = str_buscar(ruta, \"?\", 0)\n    si (q >= 0) {\n        consulta = str_rebanar(ruta, q + 1, str_largo(ruta))\n        ruta = str_rebanar(ruta, 0, q)\n    }\n    sea cabeceras = map_nuevo()\n    sea pos = fin_linea + 2\n    mientras (pos < fin_cabeceras) {\n        sea nl = http_linea_hasta(crudo, pos, \"\\r\\n\")\n        si (nl > fin_cabeceras) { nl = fin_cabeceras }\n        sea l = str_rebanar(crudo, pos, nl)\n        sea dos_puntos = str_buscar(l, \":\", 0)\n        si (dos_puntos > 0) {\n            sea valor_inicio = dos_puntos + 1\n            mientras (valor_inicio < str_largo(l) y (str_byte(l, valor_inicio) == 32 o str_byte(l, valor_inicio) == 9)) { valor_inicio = valor_inicio + 1 }\n            map_fijar(cabeceras, http_minusculas(str_rebanar(l, 0, dos_puntos)), dyn_texto(str_rebanar(l, valor_inicio, str_largo(l))))\n        }\n        pos = nl + 2\n    }\n    sea cuerpo = \"\"\n    si (fin_cabeceras + 4 <= str_largo(crudo)) { cuerpo = str_rebanar(crudo, fin_cabeceras + 4, str_largo(crudo)) }\n    sea r = map_nuevo()\n    map_fijar(r, \"metodo\", dyn_texto(metodo))\n    map_fijar(r, \"ruta\", dyn_texto(ruta))\n    map_fijar(r, \"query\", dyn_texto(consulta))\n    map_fijar(r, \"cuerpo\", dyn_texto(cuerpo))\n    map_fijar(r, \"cabeceras\", dyn_caja(3, cabeceras))\n    map_fijar(r, \"ip\", dyn_texto(ip))\n    map_fijar(r, \"_srv_id\", id)\n    retornar dyn_caja(3, r)\n}\n\nfuncion http_texto_estado(estado) {\n    si (estado == 201) { retornar \"Created\" }\n    si (estado == 204) { retornar \"No Content\" }\n    si (estado == 400) { retornar \"Bad Request\" }\n    si (estado == 401) { retornar \"Unauthorized\" }\n    si (estado == 403) { retornar \"Forbidden\" }\n    si (estado == 404) { retornar \"Not Found\" }\n    si (estado == 405) { retornar \"Method Not Allowed\" }\n    si (estado == 422) { retornar \"Unprocessable Entity\" }\n    si (estado == 500) { retornar \"Internal Server Error\" }\n    retornar \"OK\"\n}\n\nfuncion servidor_http_responder(id, estado, cuerpo, tipo) { retornar servidor_http_responder_con(id, estado, cuerpo, tipo, 0) }\n\n// ¿Texto seguro para una cabecera? (sin CR, LF ni NUL: evita la inyección\n// de cabeceras y la división de respuestas).\nfuncion http_cabecera_segura(s) {\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        sea b = str_byte(s, i)\n        si (b == 13 o b == 10 o b == 0) { retornar 0 }\n        i = i + 1\n    }\n    retornar 1\n}\n\n// Como servidor_http_responder, con un mapa de cabeceras extra\n// ({\"Location\": \"/\", \"Set-Cookie\": \"a=1\", \"Access-Control-Allow-Origin\": \"*\"}).\n// Ya no se agrega CORS por defecto: cada respuesta decide si lo quiere.\nfuncion servidor_http_responder_con(id, estado, cuerpo, tipo, cabeceras) {\n    sea srv = http_servidor(id)\n    sea cliente = __cargar64(srv + 8)\n    si (cliente < 0) { dyn_error(\"servidor_http_responder: sin cliente activo\") }\n    sea e = dyn_valor_entero(estado)\n    si (__y_bits(estado, 1) != 1 o e < 100 o e > 999) { dyn_error(\"servidor_http_responder: estado HTTP inválido\") }\n    sea c = dyn_a_str(cuerpo)\n    sea t = \"text/plain; charset=utf-8\"\n    si (dyn_tipo(tipo) == 1) { t = dyn_dato(tipo) }\n    si (http_cabecera_segura(t) == 0) { dyn_error(\"servidor_http_responder: Content-Type con saltos de línea\") }\n    sea r = str_nuevo(str_largo(c) + 256)\n    str_agregar(r, \"HTTP/1.1 \")\n    str_agregar(r, str_desde_entero(e))\n    str_agregar_byte(r, 32)\n    str_agregar(r, http_texto_estado(e))\n    str_agregar(r, \"\\r\\nContent-Type: \")\n    str_agregar(r, t)\n    str_agregar(r, \"\\r\\nContent-Length: \")\n    str_agregar(r, str_desde_entero(str_largo(c)))\n    str_agregar(r, \"\\r\\nConnection: close\\r\\n\")\n    si (dyn_tipo(cabeceras) == 3) {\n        sea m = dyn_dato(cabeceras)\n        sea orden = dyn_claves_ordenadas(m)\n        sea j = 0\n        mientras (j < vec_largo(orden)) {\n            sea k = vec_obtener(orden, j)\n            sea kl = http_minusculas(k)\n            // Las que arma el servidor no se duplican.\n            si (str_igual(kl, \"content-length\") == 0 y str_igual(kl, \"content-type\") == 0 y str_igual(kl, \"connection\") == 0 y str_igual(kl, \"transfer-encoding\") == 0) {\n                sea v = map_obtener(m, k)\n                sea valores = vec_nuevo()\n                si (dyn_tipo(v) == 2) {\n                    sea q = 0\n                    mientras (q < vec_largo(dyn_dato(v))) {\n                        vec_agregar(valores, dyn_a_str(vec_obtener(dyn_dato(v), q)))\n                        q = q + 1\n                    }\n                } sino { si (v != 0) { vec_agregar(valores, dyn_a_str(v)) } }\n                si (http_cabecera_segura(k) == 0 o str_buscar(k, \":\", 0) >= 0 o str_largo(k) == 0) {\n                    dyn_error(str_concatenar(\"servidor_http_responder: nombre de cabecera inválido: \", k))\n                }\n                sea q = 0\n                mientras (q < vec_largo(valores)) {\n                    si (http_cabecera_segura(vec_obtener(valores, q)) == 0) {\n                        dyn_error(str_concatenar(\"servidor_http_responder: la cabecera tiene saltos de línea: \", k))\n                    }\n                    str_agregar(r, k)\n                    str_agregar(r, \": \")\n                    str_agregar(r, vec_obtener(valores, q))\n                    str_agregar(r, \"\\r\\n\")\n                    q = q + 1\n                }\n            }\n            j = j + 1\n        }\n        vec_liberar(orden)\n    }\n    str_agregar(r, \"\\r\\n\")\n    str_agregar(r, c)\n    sea enviado = 0\n    mientras (enviado < str_largo(r)) {\n        sea n = sys_red_escribir(cliente, str_datos(r) + enviado, str_largo(r) - enviado)\n        si (n <= 0) { enviado = str_largo(r) } sino { enviado = enviado + n }\n    }\n    sys_red_cerrar(cliente)\n    __guardar64(srv + 8, 0 - 1)\n    retornar 0\n}\n\nfuncion servidor_http_cerrar(id) {\n    sea srv = http_servidor(id)\n    si (__cargar64(srv + 8) >= 0) { sys_red_cerrar(__cargar64(srv + 8)) }\n    sys_red_cerrar(__cargar64(srv))\n    retornar 0\n}\n\n// ── Memoria C para bibliotecas externas (estructuras, búferes) ────────────\nfuncion c_reservar(bytes) {\n    sea n = dyn_valor_entero(bytes)\n    sea p = mem_reservar(n)\n    mem_llenar(p, 0, n)\n    retornar dyn_caja(11, p)\n}\nfuncion c_liberar(p) { mem_liberar(dyn_entero_c(p)) retornar 0 }\nfuncion c_escribir32(p, desplazamiento, v) {\n    sea d = dyn_entero_c(p) + dyn_valor_entero(desplazamiento)\n    sea x = dyn_entero_c(v)\n    __guardar8(d, __y_bits(x, 255))\n    __guardar8(d + 1, __y_bits(__desplazar_der(x, 8), 255))\n    __guardar8(d + 2, __y_bits(__desplazar_der(x, 16), 255))\n    __guardar8(d + 3, __y_bits(__desplazar_der(x, 24), 255))\n    retornar 0\n}\nfuncion c_leer32(p, desplazamiento) {\n    sea d = dyn_entero_c(p) + dyn_valor_entero(desplazamiento)\n    sea x = __cargar8(d) + __cargar8(d + 1) * 256 + __cargar8(d + 2) * 65536 + __cargar8(d + 3) * 16777216\n    si (x >= 2147483648) { x = x - 4294967296 }\n    retornar dyn_entero(x)\n}\n// Texto del lenguaje a partir de una cadena C (terminada en 0) en p.\nfuncion c_texto(p) { retornar dyn_texto(str_desde_c(dyn_entero_c(p))) }\n// Llama a la función C en f (puntero, p. ej. de SDL_GL_GetProcAddress) con\n// hasta 8 argumentos enteros o punteros; los que faltan valen 0.\nfuncion c_llamar(f, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10) {\n    sea r = 0\n    si (a9 == 0 y a10 == 0) { r = __ccall(dyn_entero_c(f), dyn_entero_c(a1), dyn_entero_c(a2), dyn_entero_c(a3), dyn_entero_c(a4), dyn_entero_c(a5), dyn_entero_c(a6), dyn_entero_c(a7), dyn_entero_c(a8)) } sino {\n        r = __ccall(dyn_entero_c(f), dyn_entero_c(a1), dyn_entero_c(a2), dyn_entero_c(a3), dyn_entero_c(a4), dyn_entero_c(a5), dyn_entero_c(a6), dyn_entero_c(a7), dyn_entero_c(a8), dyn_entero_c(a9), dyn_entero_c(a10))\n    }\n    retornar dyn_entero_desde_c(r)\n}\n\n// Resultado int de C (32 bits con signo) a partir de un valor de 64 bits.\nfuncion c_i32(v) {\n    sea x = __y_bits(dyn_entero_c(v), 4294967295)\n    si (x >= 2147483648) { x = x - 4294967296 }\n    retornar dyn_entero(x)\n}\n\n// Bits IEEE-754 de 32 bits (float) del número, redondeando al par.\nfuncion f32_bits(d) {\n    sea signo = __y_bits(__desplazar_der(d, 63), 1) * 2147483648\n    sea e = __y_bits(__desplazar_der(d, 52), 2047)\n    sea m = __y_bits(d, 4503599627370495)\n    si (e == 2047) {\n        si (m != 0) { retornar 2143289344 }                    // NaN\n        retornar signo + 2139095040                            // ±inf\n    }\n    sea e8 = e - 1023 + 127\n    si (e8 >= 255) { retornar signo + 2139095040 }\n    si (e8 <= 0) {\n        // Subnormal de float (o cero).\n        si (e8 < 0 - 23) { retornar signo }\n        sea completa = __o_bits(m, 4503599627370496)          // con el 1 implícito\n        sea corrimiento = 29 + 1 - e8\n        sea r = __desplazar_der(completa, corrimiento)\n        sea resto = __y_bits(completa, __desplazar_izq(1, corrimiento) - 1)\n        sea mitad = __desplazar_izq(1, corrimiento - 1)\n        si (resto > mitad o (resto == mitad y __y_bits(r, 1) == 1)) { r = r + 1 }\n        retornar signo + r\n    }\n    sea r = __desplazar_der(m, 29)\n    sea resto = __y_bits(m, 536870911)\n    si (resto > 268435456 o (resto == 268435456 y __y_bits(r, 1) == 1)) { r = r + 1 }\n    si (r == 8388608) {\n        r = 0\n        e8 = e8 + 1\n        si (e8 >= 255) { retornar signo + 2139095040 }\n    }\n    retornar signo + e8 * 8388608 + r\n}\n\nfuncion c_f32(v) { retornar dyn_entero(f32_bits(dyn_a_f64(v))) }\n\nfuncion c_escribir_f32(p, desplazamiento, v) {\n    sea d = dyn_entero_c(p) + dyn_valor_entero(desplazamiento)\n    sea x = f32_bits(dyn_a_f64(v))\n    __guardar8(d, __y_bits(x, 255))\n    __guardar8(d + 1, __y_bits(__desplazar_der(x, 8), 255))\n    __guardar8(d + 2, __y_bits(__desplazar_der(x, 16), 255))\n    __guardar8(d + 3, __y_bits(__desplazar_der(x, 24), 255))\n    retornar 0\n}\n\n// Copia del texto como cadena C terminada en 0 (liberar con c_liberar).\nfuncion c_cadena(t) {\n    sea s = dyn_a_str(t)\n    sea p = mem_reservar(str_largo(s) + 1)\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        __guardar8(p + i, str_byte(s, i))\n        i = i + 1\n    }\n    __guardar8(p + str_largo(s), 0)\n    retornar dyn_caja(11, p)\n}\n\n// Entero de 64 bits (o puntero) en p + desplazamiento.\nfuncion c_leer64(p, desplazamiento) {\n    retornar dyn_entero_desde_c(__cargar64(dyn_entero_c(p) + dyn_valor_entero(desplazamiento)))\n}\nfuncion c_escribir64(p, desplazamiento, v) {\n    __guardar64(dyn_entero_c(p) + dyn_valor_entero(desplazamiento), dyn_entero_c(v))\n    retornar 0\n}\nfuncion c_leer8(p, desplazamiento) {\n    retornar dyn_entero(__cargar8(dyn_entero_c(p) + dyn_valor_entero(desplazamiento)))\n}\n\n// ── Bytes, SHA-1, PBKDF2 (WebSocket, PostgreSQL, MySQL) ───────────────────\n// Los textos son bytes: estas funciones arman y leen protocolos binarios.\n\n// n en \"ancho\" bytes; orden 0 = big endian (red), 1 = little endian.\n// Entero de un número dinámico: los decimales se truncan (antes un decimal\n// como 2^53 se leía como si fuera entero y salía basura).\nfuncion dyn_entero_truncado(n, operacion) {\n    si (__y_bits(n, 1) == 1) { retornar dyn_valor_entero(n) }\n    si (dyn_tipo(n) == 12) { retornar dyn_gr_bajos64(dyn_dato(n)) }\n    si (dyn_tipo(n) == 4) { retornar __f64_a_entero(dyn_a_f64(n)) }\n    dyn_error_tipo(operacion, n)\n    retornar 0\n}\n\nfuncion bytes_entero(n, ancho, orden) {\n    sea v = dyn_entero_truncado(n, \"bytes_entero\")\n    si (__y_bits(ancho, 1) != 1) { dyn_error(\"bytes_entero: el ancho debe ser un entero de 0 a 1048576\") }\n    sea w = dyn_valor_entero(ancho)\n    si (w < 0 o w > 1048576) { dyn_error(\"bytes_entero: el ancho debe ser un entero de 0 a 1048576\") }\n    sea r = str_nuevo(w)\n    sea i = 0\n    mientras (i < w) {\n        sea d = (w - 1 - i) * 8\n        si (dyn_valor_entero(orden) == 1) { d = i * 8 }\n        // Más allá de 64 bits: extensión del signo (0 o 255).\n        si (d >= 64) {\n            si (v < 0) { str_agregar_byte(r, 255) } sino { str_agregar_byte(r, 0) }\n        } sino { str_agregar_byte(r, __y_bits(__desplazar_der(v, d), 255)) }\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\n// Entero sin signo de \"ancho\" bytes desde pos.\nfuncion bytes_leer_entero(t, pos, ancho, orden) {\n    sea s = dyn_texto_de(t, \"bytes_leer_entero\")\n    sea p = dyn_valor_entero(pos)\n    sea w = dyn_valor_entero(ancho)\n    si (p < 0 o p + w > str_largo(s)) { dyn_error(\"bytes_leer_entero: fuera del texto\") }\n    sea v = 0\n    sea i = 0\n    mientras (i < w) {\n        si (dyn_valor_entero(orden) == 1) {\n            v = __o_bits(v, __desplazar_izq(str_byte(s, p + i), i * 8))\n        } sino {\n            v = __o_bits(__desplazar_izq(v, 8), str_byte(s, p + i))\n        }\n        i = i + 1\n    }\n    retornar dyn_entero(v)\n}\n\nfuncion bytes_xor(a, b) {\n    sea x = dyn_a_str(a)\n    sea y = dyn_a_str(b)\n    sea n = str_largo(x)\n    sea m = str_largo(y)\n    si (m == 0 y n > 0) { dyn_error(\"bytes_xor: la clave está vacía\") }\n    sea r = str_nuevo(n)\n    sea px = str_datos(x)\n    sea py = str_datos(y)\n    sea pr = str_datos(r)\n    sea i = 0\n    sea j = 0\n    mientras (i < n) {\n        __guardar8(pr + i, __xo_bits(__cargar8(px + i), __cargar8(py + j)))\n        i = i + 1\n        j = j + 1\n        si (j == m) { j = 0 }\n    }\n    __guardar8(pr + n, 0)\n    __guardar64(r, n)\n    retornar dyn_texto(r)\n}\n\nfuncion bytes_de_hex(h) { retornar dyn_texto(hex_a_bytes(dyn_texto_de(h, \"bytes_de_hex\"))) }\n\nfuncion hex_de_bytes(t) {\n    sea s = dyn_a_str(t)\n    sea r = str_nuevo(str_largo(s) * 2)\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        hex_agregar(r, str_byte(s, i), 1, 0)\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion sha1_crudo(s) {\n    sea m = hash_relleno(s, 0)\n    sea h0 = 1732584193\n    sea h1 = 4023233417\n    sea h2 = 2562383102\n    sea h3 = 271733878\n    sea h4 = 3285377520\n    sea w = mem_reservar(80 * 8)\n    sea bloque = 0\n    mientras (bloque < str_largo(m)) {\n        sea i = 0\n        mientras (i < 16) {\n            sea p = bloque + i * 4\n            __guardar64(w + i * 8, str_byte(m, p) * 16777216 + str_byte(m, p + 1) * 65536 + str_byte(m, p + 2) * 256 + str_byte(m, p + 3))\n            i = i + 1\n        }\n        mientras (i < 80) {\n            __guardar64(w + i * 8, roti32(__xo_bits(__xo_bits(__cargar64(w + (i - 3) * 8), __cargar64(w + (i - 8) * 8)), __xo_bits(__cargar64(w + (i - 14) * 8), __cargar64(w + (i - 16) * 8))), 1))\n            i = i + 1\n        }\n        sea a = h0\n        sea b = h1\n        sea c = h2\n        sea d = h3\n        sea e = h4\n        i = 0\n        mientras (i < 80) {\n            sea f = 0\n            sea k = 0\n            si (i < 20) {\n                f = __o_bits(__y_bits(b, c), __y_bits(__xo_bits(b, 4294967295), d))\n                k = 1518500249\n            } sino {\n                si (i < 40) {\n                    f = __xo_bits(__xo_bits(b, c), d)\n                    k = 1859775393\n                } sino {\n                    si (i < 60) {\n                        f = __o_bits(__o_bits(__y_bits(b, c), __y_bits(b, d)), __y_bits(c, d))\n                        k = 2400959708\n                    } sino {\n                        f = __xo_bits(__xo_bits(b, c), d)\n                        k = 3395469782\n                    }\n                }\n            }\n            sea t = u32(roti32(a, 5) + f + e + k + __cargar64(w + i * 8))\n            e = d\n            d = c\n            c = roti32(b, 30)\n            b = a\n            a = t\n            i = i + 1\n        }\n        h0 = u32(h0 + a)\n        h1 = u32(h1 + b)\n        h2 = u32(h2 + c)\n        h3 = u32(h3 + d)\n        h4 = u32(h4 + e)\n        bloque = bloque + 64\n    }\n    mem_liberar(w)\n    sea r = str_nuevo(40)\n    hex_agregar(r, h0, 4, 0)\n    hex_agregar(r, h1, 4, 0)\n    hex_agregar(r, h2, 4, 0)\n    hex_agregar(r, h3, 4, 0)\n    hex_agregar(r, h4, 4, 0)\n    retornar r\n}\n\n// SHA-1 en hexadecimal (WebSocket, mysql_native_password).\nfuncion cfv_sha1(t) { retornar dyn_texto(sha1_crudo(dyn_a_str(t))) }\nfuncion sha1_bytes(t) { retornar dyn_texto(hex_a_bytes(sha1_crudo(dyn_a_str(t)))) }\nfuncion sha256_bytes(t) { retornar dyn_texto(hex_a_bytes(dyn_texto_de(cfv_sha256(t), \"sha256_bytes\"))) }\nfuncion hmac_sha256_bytes(clave, mensaje) { retornar dyn_texto(hex_a_bytes(dyn_texto_de(hmac_sha256(clave, mensaje), \"hmac_sha256_bytes\"))) }\n\n// PBKDF2-HMAC-SHA256 (RFC 8018): \"largo\" bytes (SCRAM-SHA-256 usa 32).\nfuncion pbkdf2_sha256(clave, sal, iteraciones, largo) {\n    si (__y_bits(iteraciones, 1) != 1 o __y_bits(largo, 1) != 1) { dyn_error(\"pbkdf2_sha256: iteraciones y largo deben ser enteros\") }\n    sea n = dyn_valor_entero(iteraciones)\n    sea total = dyn_valor_entero(largo)\n    si (n < 1 o n > 100000000) { dyn_error(\"pbkdf2_sha256: las iteraciones van de 1 a 100000000\") }\n    si (total < 1 o total > 1048576) { dyn_error(\"pbkdf2_sha256: el largo va de 1 a 1048576 bytes\") }\n    sea r = str_nuevo(total)\n    sea bloque = 1\n    mientras (str_largo(r) < total) {\n        sea primero = str_concatenar(dyn_a_str(sal), dyn_texto_de(bytes_entero(dyn_entero(bloque), dyn_entero(4), dyn_entero(0)), \"pbkdf2\"))\n        sea u = hmac_sha256_bytes(clave, dyn_texto(primero))\n        sea x = u\n        sea i = 1\n        mientras (i < n) {\n            u = hmac_sha256_bytes(clave, u)\n            x = bytes_xor(x, u)\n            i = i + 1\n        }\n        str_agregar(r, dyn_dato(x))\n        bloque = bloque + 1\n    }\n    retornar dyn_texto(str_rebanar(r, 0, total))\n}\n\n// Lee exactamente n bytes (o menos si la conexión se cierra o vence la espera).\nfuncion net_recibir_exacto(sock, n) {\n    sea fd = dyn_valor_entero(sock)\n    sea total = dyn_valor_entero(n)\n    si (total < 0) { dyn_error(\"net_reci