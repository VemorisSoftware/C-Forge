   si (e >= 0) {\n        vec_fijar(__cargar64(m + 32), e, valor)\n        retornar 0\n    }\n    // Las entradas (con lápidas) no superan 2/3 de las ranuras.\n    si ((vec_largo(__cargar64(m + 24)) + 1) * 3 > __cargar64(m + 8) * 2) { map_crecer(m) }\n    sea h = map_hash(clave)\n    sea claves = __cargar64(m + 24)\n    map_insertar_ranura(__cargar64(m + 16), __cargar64(m + 8) - 1, h, vec_largo(claves))\n    vec_agregar(claves, clave)\n    vec_agregar(__cargar64(m + 32), valor)\n    vec_agregar(__cargar64(m + 40), h)\n    __guardar64(m, __cargar64(m) + 1)\n    retornar 0\n}\n\nfuncion map_quitar(m, clave) {\n    sea e = map_buscar(m, clave)\n    si (e < 0) { retornar 0 }\n    vec_fijar(__cargar64(m + 24), e, 0)\n    vec_fijar(__cargar64(m + 32), e, 0)\n    __guardar64(m, __cargar64(m) - 1)\n    retornar 1\n}\n\n// Claves vivas en orden de inserción (lista nueva de textos).\nfuncion map_claves(m) {\n    sea claves = __cargar64(m + 24)\n    sea r = vec_nuevo()\n    sea i = 0\n    mientras (i < vec_largo(claves)) {\n        sea k = vec_obtener(claves, i)\n        si (k != 0) { vec_agregar(r, k) }\n        i = i + 1\n    }\n    retornar r\n}\n\n// Acceso por posición de entrada (incluye lápidas con clave 0).\nfuncion map_entradas(m) { retornar vec_largo(__cargar64(m + 24)) }\nfuncion map_clave_en(m, i) { retornar vec_obtener(__cargar64(m + 24), i) }\nfuncion map_valor_en(m, i) { retornar vec_obtener(__cargar64(m + 32), i) }\n" }
    si (i == 14) { retornar "// runtime/dyn.cfv — valores dinámicos del lenguaje C-Forge completo.\n//\n// Escrito en el dialecto nativo, pero con la convención de valores del\n// lenguaje (el compilador lo carga en modo \"puente\"). Cada valor es una\n// palabra de 64 bits con etiqueta:\n//\n//   0           nulo\n//   2 / 4       falso / verdadero\n//   impar       entero: n * 2 + 1\n//   puntero     caja de 16 bytes [tipo][dato]:\n//                 1 texto (dato: texto del runtime)\n//                 2 lista (dato: vec del runtime)\n//                 3 mapa  (dato: map del runtime)\n//                 4 flotante (dato: bits IEEE-754)\n//                 7 función (dato: [código][aridad][n][celdas capturadas]*)\n//                 8 puntero (dato: [bloque (lista)][desplazamiento])\n//\n// Los números siguen la semántica del intérprete: un resultado con valor\n// entero se representa como entero; si no, como flotante.\n\n// ── Construcción y consulta ───────────────────────────────────────────────\n\nfuncion dyn_caja(tipo, dato) {\n    sea c = mem_reservar(16)\n    __guardar64(c, tipo)\n    __guardar64(c + 8, dato)\n    retornar c\n}\n\n// 0 nulo · 1 texto · 2 lista · 3 mapa · 4 flotante · 5 booleano · 6 entero\nfuncion dyn_tipo(v) {\n    si (v == 0) { retornar 0 }\n    si (__y_bits(v, 1) == 1) { retornar 6 }\n    si (v == 2 o v == 4) { retornar 5 }\n    retornar __cargar64(v)\n}\n\nfuncion dyn_dato(v) { retornar __cargar64(v + 8) }\nfuncion dyn_entero(n) { retornar n * 2 + 1 }\nfuncion dyn_valor_entero(v) { retornar (v - 1) / 2 }\nfuncion dyn_bool(b) { si (b) { retornar 4 } retornar 2 }\nfuncion dyn_texto(s) { retornar dyn_caja(1, s) }\nfuncion dyn_lista_nueva() { retornar dyn_caja(2, vec_nuevo()) }\nfuncion dyn_mapa_nuevo() { retornar dyn_caja(3, map_nuevo()) }\n\nfuncion dyn_nombre_tipo(v) {\n    sea t = dyn_tipo(v)\n    si (t == 0) { retornar \"nulo\" }\n    si (t == 1) { retornar \"texto\" }\n    si (t == 2) { retornar \"lista\" }\n    si (t == 3) { retornar \"mapa\" }\n    si (t == 5) { retornar \"booleano\" }\n    si (t == 7) { retornar \"funcion\" }\n    si (t == 8) { retornar \"puntero\" }\n    si (t == 11) { retornar \"puntero\" }\n    si (t == 9) { retornar \"canal\" }\n    si (t == 10) { retornar \"mutex\" }\n    retornar \"numero\"\n}\n\nfuncion dyn_error_tipo(operacion, v) {\n    sea m = str_concatenar(operacion, \": valor de tipo \")\n    str_agregar(m, dyn_nombre_tipo(v))\n    dyn_error(m)\n    retornar 0\n}\n\nfuncion dyn_verdad(v) {\n    si (v == 4) { retornar 1 }\n    si (v == 2) { retornar 0 }\n    dyn_error(\"se esperaba verdadero o falso\")\n    retornar 0\n}\n\n// ── Errores: intentar / capturar / lanzar ────────────────────────────────\n// Global 21: pila de manejadores [rsp][rbp][dirección de captura].\n\n// Cada hilo tiene su pila de manejadores: el hilo principal usa la global\n// 21; un hilo creado por tarea() la guarda en su registro (base de su pila).\nfuncion dyn_manejadores() {\n    sea registro = dyn_registro_hilo()\n    sea casilla = __globales() + 168\n    si (registro != 0) { casilla = registro + 8 }\n    sea h = __cargar64(casilla)\n    si (h == 0) {\n        h = vec_nuevo()\n        __guardar64(casilla, h)\n    }\n    retornar h\n}\n\n// Registro del hilo actual (base alineada de su pila de 8 MiB) o 0 si es el\n// hilo principal. Las bases de los hilos creados por tarea() se anotan en la\n// global 34; así no se lee memoria que podría no estar asignada.\nfuncion dyn_registro_hilo() {\n    sea bases = __cargar64(__globales() + 272)\n    si (bases == 0) { retornar 0 }\n    sea base = __y_bits(__pila(), 0 - 8388608)\n    sea i = 0\n    mientras (i < vec_largo(bases)) {\n        si (vec_obtener(bases, i) == base) { retornar base }\n        i = i + 1\n    }\n    retornar 0\n}\n\nfuncion dyn_anotar_hilo(base) {\n    sea cerrojo = __globales() + 280\n    mientras (__intercambiar(cerrojo, 1) != 0) { sys_ceder() }\n    sea bases = __cargar64(__globales() + 272)\n    si (bases == 0) {\n        bases = vec_nuevo()\n        __guardar64(__globales() + 272, bases)\n    }\n    vec_agregar(bases, base)\n    __guardar64(cerrojo, 0)\n    retornar 0\n}\n\nfuncion dyn_intentar_entrar(pila, marco, destino) {\n    sea r = mem_reservar(24)\n    __guardar64(r, pila)\n    __guardar64(r + 8, marco)\n    __guardar64(r + 16, destino)\n    vec_agregar(dyn_manejadores(), r)\n    retornar 0\n}\n\nfuncion dyn_intentar_salir() {\n    mem_liberar(vec_quitar_ultimo(dyn_manejadores()))\n    retornar 0\n}\n\nfuncion dyn_lanzar(v) {\n    sea h = dyn_manejadores()\n    si (vec_largo(h) == 0) {\n        rt_panico(str_concatenar(\"error no capturado: \", dyn_a_str(v)))\n    }\n    sea r = vec_quitar_ultimo(h)\n    __saltar(__cargar64(r + 8), __cargar64(r), __cargar64(r + 16), v)\n    retornar 0\n}\n\n// Error del lenguaje: se puede capturar con intentar/capturar.\nfuncion dyn_error(mensaje) {\n    si (vec_largo(dyn_manejadores()) > 0) { dyn_lanzar(dyn_texto(mensaje)) }\n    rt_panico(mensaje)\n    retornar 0\n}\n\n// ── Funciones anónimas y celdas ──────────────────────────────────────────\n\nfuncion dyn_celda_nueva(v) {\n    sea celda = mem_reservar(8)\n    __guardar64(celda, v)\n    retornar celda\n}\n\nfuncion dyn_cierre_nuevo(codigo, aridad, capturas) {\n    sea r = mem_reservar(24 + capturas * 8)\n    __guardar64(r, codigo)\n    __guardar64(r + 8, aridad)\n    __guardar64(r + 16, capturas)\n    retornar dyn_caja(7, r)\n}\n\nfuncion dyn_cierre_fijar(f, i, celda) {\n    __guardar64(dyn_dato(f) + 24 + i * 8, celda)\n    retornar f\n}\n\n// Dirección del código de f para una llamada con n argumentos.\nfuncion dyn_codigo_cierre(f, n) {\n    si (dyn_tipo(f) != 7) { dyn_error_tipo(\"no se puede llamar\", f) }\n    sea r = dyn_dato(f)\n    si (__cargar64(r + 8) != n) {\n        sea m = str_concatenar(\"la función espera \", str_desde_entero(__cargar64(r + 8)))\n        str_agregar(m, \" argumentos y recibió \")\n        str_agregar(m, str_desde_entero(n))\n        dyn_error(m)\n    }\n    retornar __cargar64(r)\n}\n\n// ── Números ───────────────────────────────────────────────────────────────\n\nfuncion dyn_es_numero(v) {\n    sea t = dyn_tipo(v)\n    retornar t == 6 o t == 4\n}\n\nfuncion dyn_a_f64(v) {\n    sea t = dyn_tipo(v)\n    si (t == 6) { retornar __f64_desde_entero(dyn_valor_entero(v)) }\n    si (t == 4) { retornar dyn_dato(v) }\n    dyn_error_tipo(\"se esperaba un número\", v)\n    retornar 0\n}\n\n// Normaliza: un flotante con valor entero exacto vuelve a ser entero.\nfuncion dyn_desde_f64(bits) {\n    sea e = __f64_a_entero(bits)\n    si (e > 0 - 4503599627370496 y e < 4503599627370496) {\n        si (__f64_desde_entero(e) == bits) { retornar dyn_entero(e) }\n        // -0.0 también es el entero 0.\n        si (__desplazar_izq(bits, 1) == 0) { retornar dyn_entero(0) }\n    }\n    retornar dyn_caja(4, bits)\n}\n\nfuncion dyn_flotante(bits) { retornar dyn_desde_f64(bits) }\n\nfuncion dyn_ambos_enteros(a, b) {\n    retornar __y_bits(__y_bits(a, b), 1) == 1\n}\n\n// Programa escrito en inglés: valores impresos en inglés (global 20).\nfuncion dyn_fijar_ingles() { mem_fijar_global(20, 1) retornar 0 }\nfuncion dyn_ingles() { retornar mem_global(20) == 1 }\n\n// ── Clases ────────────────────────────────────────────────────────────────\n// El compilador deja en datos la tabla __clases(): [n][registro]*, con cada\n// registro [nombre][padre o 0][n métodos]([nombre][código][aridad])*.\n// Una instancia es un mapa con la clave \"__clase\".\n\nfuncion dyn_registro_clase(nombre) {\n    sea tabla = __clases()\n    sea i = 0\n    mientras (i < __cargar64(tabla)) {\n        sea r = __cargar64(tabla + 8 + i * 8)\n        si (str_igual(__cargar64(r), nombre)) { retornar r }\n        i = i + 1\n    }\n    retornar 0\n}\n\n// Dirección del método (o 0) para objeto.nombre(...) con aridad total n.\nfuncion dyn_buscar_metodo(objeto, nombre, n) {\n    si (dyn_tipo(objeto) != 3) { retornar 0 }\n    sea m = dyn_dato(objeto)\n    sea e = map_buscar(m, \"__clase\")\n    si (e < 0) { retornar 0 }\n    sea clase = map_valor_en(m, e)\n    si (dyn_tipo(clase) != 1) { retornar 0 }\n    sea r = dyn_registro_clase(dyn_dato(clase))\n    mientras (r != 0) {\n        sea cantidad = __cargar64(r + 16)\n        sea i = 0\n        mientras (i < cantidad) {\n            sea entrada = r + 24 + i * 24\n            si (str_igual(__cargar64(entrada), nombre)) {\n                si (__cargar64(entrada + 16) != n) {\n                    dyn_error(str_concatenar(\"cantidad de argumentos incorrecta en el método \", nombre))\n                }\n                retornar __cargar64(entrada + 8)\n            }\n            i = i + 1\n        }\n        si (__cargar64(r + 8) == 0) { r = 0 } sino { r = dyn_registro_clase(__cargar64(r + 8)) }\n    }\n    retornar 0\n}\n\nfuncion dyn_metodo_desconocido(objeto, nombre) {\n    sea m = str_concatenar(\"método desconocido '\", nombre)\n    str_agregar(m, \"' para un valor de tipo \")\n    str_agregar(m, dyn_nombre_tipo(objeto))\n    dyn_error(m)\n    retornar 0\n}\n\n// ── Claves ordenadas (como el intérprete: orden por bytes) ───────────────\n\nfuncion dyn_str_comparar(x, y) {\n    sea i = 0\n    mientras (i < str_largo(x) y i < str_largo(y)) {\n        sea cx = str_byte(x, i)\n        sea cy = str_byte(y, i)\n        si (cx < cy) { retornar 0 - 1 }\n        si (cx > cy) { retornar 1 }\n        i = i + 1\n    }\n    si (str_largo(x) < str_largo(y)) { retornar 0 - 1 }\n    si (str_largo(x) > str_largo(y)) { retornar 1 }\n    retornar 0\n}\n\n// Ordena por mezcla el tramo [desde, hasta) de v usando aux.\nfuncion dyn_ordenar_tramo(v, aux, desde, hasta) {\n    si (hasta - desde < 2) { retornar 0 }\n    sea medio = (desde + hasta) / 2\n    dyn_ordenar_tramo(v, aux, desde, medio)\n    dyn_ordenar_tramo(v, aux, medio, hasta)\n    sea i = desde\n    sea j = medio\n    sea k = desde\n    mientras (k < hasta) {\n        si (j >= hasta o (i < medio y dyn_str_comparar(vec_obtener(v, i), vec_obtener(v, j)) <= 0)) {\n            vec_fijar(aux, k, vec_obtener(v, i))\n            i = i + 1\n        } sino {\n            vec_fijar(aux, k, vec_obtener(v, j))\n            j = j + 1\n        }\n        k = k + 1\n    }\n    k = desde\n    mientras (k < hasta) {\n        vec_fijar(v, k, vec_obtener(aux, k))\n        k = k + 1\n    }\n    retornar 0\n}\n\n// Claves del mapa (textos del runtime) en orden.\nfuncion dyn_claves_ordenadas(m) {\n    sea v = map_claves(m)\n    sea aux = vec_nuevo()\n    sea i = 0\n    mientras (i < vec_largo(v)) {\n        vec_agregar(aux, 0)\n        i = i + 1\n    }\n    dyn_ordenar_tramo(v, aux, 0, vec_largo(v))\n    vec_liberar(aux)\n    retornar v\n}\n\n// ── Texto ─────────────────────────────────────────────────────────────────\n\nfuncion dyn_agregar_valor(r, v, comillas) {\n    sea t = dyn_tipo(v)\n    si (t == 1 y comillas) {\n        str_agregar_byte(r, 34)\n        str_agregar(r, dyn_dato(v))\n        str_agregar_byte(r, 34)\n        retornar 0\n    }\n    si (t == 1) { str_agregar(r, dyn_dato(v)) retornar 0 }\n    si (t == 0) {\n        si (dyn_ingles()) { str_agregar(r, \"null\") } sino { str_agregar(r, \"nulo\") }\n        retornar 0\n    }\n    si (t == 5) {\n        si (dyn_ingles()) {\n            si (v == 4) { str_agregar(r, \"true\") } sino { str_agregar(r, \"false\") }\n        } sino {\n            si (v == 4) { str_agregar(r, \"verdadero\") } sino { str_agregar(r, \"falso\") }\n        }\n        retornar 0\n    }\n    si (t == 6) {\n        sea s = str_desde_entero(dyn_valor_entero(v))\n        str_agregar(r, s)\n        str_liberar(s)\n        retornar 0\n    }\n    si (t == 4) {\n        dyn_formato_g(r, dyn_dato(v))\n        retornar 0\n    }\n    si (t == 2) {\n        sea l = dyn_dato(v)\n        str_agregar_byte(r, 91)\n        sea i = 0\n        mientras (i < vec_largo(l)) {\n            si (i > 0) { str_agregar(r, \", \") }\n            dyn_agregar_valor(r, vec_obtener(l, i), 0)\n            i = i + 1\n        }\n        str_agregar_byte(r, 93)\n        retornar 0\n    }\n    si (t == 3) {\n        sea m = dyn_dato(v)\n        str_agregar_byte(r, 123)\n        sea orden = dyn_claves_ordenadas(m)\n        sea j = 0\n        mientras (j < vec_largo(orden)) {\n            sea k = vec_obtener(orden, j)\n            si (j > 0) { str_agregar(r, \", \") }\n            str_agregar_byte(r, 34)\n            str_agregar(r, k)\n            str_agregar(r, \"\\\": \")\n            dyn_agregar_valor(r, map_obtener(m, k), 0)\n            j = j + 1\n        }\n        vec_liberar(orden)\n        str_agregar_byte(r, 125)\n        retornar 0\n    }\n    si (t == 7) { str_agregar(r, \"<funcion>\") retornar 0 }\n    si (t == 9) { str_agregar(r, \"<canal>\") retornar 0 }\n    si (t == 10) { str_agregar(r, \"<mutex>\") retornar 0 }\n    si (t == 8) { str_agregar(r, \"<puntero>\") retornar 0 }\n    si (t == 11) { str_agregar(r, \"<puntero>\") retornar 0 }\n    dyn_error(\"valor desconocido\")\n    retornar 0\n}\n\n// Texto del runtime con la representación del valor.\nfuncion dyn_a_str(v) {\n    si (dyn_tipo(v) == 1) { retornar dyn_dato(v) }\n    sea r = str_nuevo(16)\n    dyn_agregar_valor(r, v, 0)\n    retornar r\n}\n\nfuncion dyn_texto_de(v, operacion) {\n    si (dyn_tipo(v) != 1) { dyn_error_tipo(operacion, v) }\n    retornar dyn_dato(v)\n}\n\n// ── Operadores ────────────────────────────────────────────────────────────\n\nfuncion dyn_suma(a, b) {\n    si (dyn_ambos_enteros(a, b)) { retornar a + b - 1 }\n    si (dyn_tipo(a) == 8 y __y_bits(b, 1) == 1) { retornar dyn_puntero(__cargar64(dyn_dato(a)), __cargar64(dyn_dato(a) + 8) + dyn_valor_entero(b)) }\n    si (dyn_tipo(a) == 1 o dyn_tipo(b) == 1) {\n        sea r = str_nuevo(16)\n        dyn_agregar_valor(r, a, 0)\n        dyn_agregar_valor(r, b, 0)\n        retornar dyn_texto(r)\n    }\n    retornar dyn_desde_f64(__f64_suma(dyn_a_f64(a), dyn_a_f64(b)))\n}\n\nfuncion dyn_resta(a, b) {\n    si (dyn_ambos_enteros(a, b)) { retornar a - b + 1 }\n    si (dyn_tipo(a) == 8 y __y_bits(b, 1) == 1) { retornar dyn_puntero(__cargar64(dyn_dato(a)), __cargar64(dyn_dato(a) + 8) - dyn_valor_entero(b)) }\n    retornar dyn_desde_f64(__f64_resta(dyn_a_f64(a), dyn_a_f64(b)))\n}\n\nfuncion dyn_mul(a, b) {\n    si (dyn_ambos_enteros(a, b)) {\n        retornar dyn_entero(dyn_valor_entero(a) * dyn_valor_entero(b))\n    }\n    retornar dyn_desde_f64(__f64_mul(dyn_a_f64(a), dyn_a_f64(b)))\n}\n\nfuncion dyn_div(a, b) {\n    si (dyn_ambos_enteros(a, b)) {\n        sea x = dyn_valor_entero(a)\n        sea y = dyn_valor_entero(b)\n        si (y == 0) { dyn_error(\"división por cero\") }\n        si (x % y == 0) { retornar dyn_entero(x / y) }\n    }\n    retornar dyn_desde_f64(__f64_div(dyn_a_f64(a), dyn_a_f64(b)))\n}\n\nfuncion dyn_mod(a, b) {\n    si (dyn_ambos_enteros(a, b)) {\n        sea y = dyn_valor_entero(b)\n        si (y == 0) { dyn_error(\"división por cero\") }\n        retornar dyn_entero(dyn_valor_entero(a) % y)\n    }\n    // fmod: a - trunc(a / b) * b\n    sea x = dyn_a_f64(a)\n    sea y = dyn_a_f64(b)\n    sea cociente = __f64_desde_entero(__f64_a_entero(__f64_div(x, y)))\n    retornar dyn_desde_f64(__f64_resta(x, __f64_mul(cociente, y)))\n}\n\nfuncion dyn_neg(a) {\n    si (__y_bits(a, 1) == 1) { retornar 2 - a }\n    retornar dyn_desde_f64(__f64_resta(__f64_desde_entero(0), dyn_a_f64(a)))\n}\n\nfuncion dyn_no(a) { retornar dyn_bool(dyn_verdad(a) == 0) }\n\nfuncion dyn_igual_crudo(a, b) {\n    si (a == b) { retornar 1 }\n    sea ta = dyn_tipo(a)\n    sea tb = dyn_tipo(b)\n    si (ta == 1 y tb == 1) { retornar str_igual(dyn_dato(a), dyn_dato(b)) }\n    si (ta == 11 y tb == 11) { retornar dyn_dato(a) == dyn_dato(b) }\n    si (dyn_es_numero(a) y dyn_es_numero(b)) {\n        si (ta == 6 y tb == 6) { retornar 0 }\n        sea x = dyn_a_f64(a)\n        sea y = dyn_a_f64(b)\n        retornar __f64_menor(x, y) == 0 y __f64_menor(y, x) == 0\n    }\n    retornar 0\n}\n\nfuncion dyn_igual(a, b) { retornar dyn_bool(dyn_igual_crudo(a, b)) }\nfuncion dyn_distinto(a, b) { retornar dyn_bool(dyn_igual_crudo(a, b) == 0) }\n\n// -1, 0 o 1 para números o textos.\nfuncion dyn_comparar(a, b) {\n    si (dyn_ambos_enteros(a, b)) {\n        si (a < b) { retornar 0 - 1 }\n        si (a > b) { retornar 1 }\n        retornar 0\n    }\n    si (dyn_tipo(a) == 1 y dyn_tipo(b) == 1) {\n        sea x = dyn_dato(a)\n        sea y = dyn_dato(b)\n        sea i = 0\n        mientras (i < str_largo(x) y i < str_largo(y)) {\n            sea cx = str_byte(x, i)\n            sea cy = str_byte(y, i)\n            si (cx < cy) { retornar 0 - 1 }\n            si (cx > cy) { retornar 1 }\n            i = i + 1\n        }\n        si (str_largo(x) < str_largo(y)) { retornar 0 - 1 }\n        si (str_largo(x) > str_largo(y)) { retornar 1 }\n        retornar 0\n    }\n    sea fx = dyn_a_f64(a)\n    sea fy = dyn_a_f64(b)\n    si (__f64_menor(fx, fy)) { retornar 0 - 1 }\n    si (__f64_menor(fy, fx)) { retornar 1 }\n    retornar 0\n}\n\nfuncion dyn_menor(a, b) { retornar dyn_bool(dyn_comparar(a, b) < 0) }\nfuncion dyn_menor_igual(a, b) { retornar dyn_bool(dyn_comparar(a, b) <= 0) }\nfuncion dyn_mayor(a, b) { retornar dyn_bool(dyn_comparar(a, b) > 0) }\nfuncion dyn_mayor_igual(a, b) { retornar dyn_bool(dyn_comparar(a, b) >= 0) }\n\n// ── Indexación e iteración ────────────────────────────────────────────────\n\nfuncion dyn_indice_lista(l, i) {\n    si (__y_bits(i, 1) != 1) { dyn_error(\"el índice de lista debe ser un número entero\") }\n    sea n = dyn_valor_entero(i)\n    si (n < 0 o n >= vec_largo(l)) { dyn_error(\"índice de lista inválido\") }\n    retornar n\n}\n\nfuncion dyn_clave(k) {\n    si (dyn_tipo(k) != 1) { dyn_error(\"la clave debe ser texto\") }\n    retornar dyn_dato(k)\n}\n\nfuncion dyn_indice(c, k) {\n    sea t = dyn_tipo(c)\n    si (t == 2) {\n        sea l = dyn_dato(c)\n        retornar vec_obtener(l, dyn_indice_lista(l, k))\n    }\n    si (t == 3) {\n        sea m = dyn_dato(c)\n        sea e = map_buscar(m, dyn_clave(k))\n        si (e < 0) { dyn_error(\"clave inexistente\") }\n        retornar map_valor_en(m, e)\n    }\n    si (t == 1) {\n        sea s = dyn_dato(c)\n        si (__y_bits(k, 1) != 1) { dyn_error(\"el índice de texto debe ser un número entero\") }\n        sea n = dyn_valor_entero(k)\n        si (n < 0 o n >= str_largo(s)) { dyn_error(\"índice de texto inválido\") }\n        retornar dyn_texto(str_rebanar(s, n, n + 1))\n    }\n    dyn_error_tipo(\"no se puede indexar\", c)\n    retornar 0\n}\n\n// valor.campo: campo de un mapa/instancia; .longitud de listas y textos.\nfuncion dyn_campo(c, k) {\n    sea t = dyn_tipo(c)\n    si (t == 3) { retornar dyn_indice(c, k) }\n    si ((t == 1 o t == 2) y (str_igual(dyn_dato(k), \"longitud\") o str_igual(dyn_dato(k), \"largo\") o str_igual(dyn_dato(k), \"length\"))) {\n        retornar longitud(c)\n    }\n    si (t == 0) { dyn_error(str_concatenar(\"acceso a campo de nulo: \", dyn_dato(k))) }\n    dyn_error_tipo(str_concatenar(\"no tiene el campo \", dyn_dato(k)), c)\n    retornar 0\n}\n\n// Resultado/Opción: ¿es un fallo? (raw 0/1) — {\"ok\": falso} o {\"presente\": falso}\nfuncion dyn_es_fallo(v) {\n    si (dyn_tipo(v) != 3) { retornar 0 }\n    sea m = dyn_dato(v)\n    si (map_obtener_o(m, \"ok\", 0) == 2) { retornar 1 }\n    si (map_obtener_o(m, \"presente\", 0) == 2) { retornar 1 }\n    retornar 0\n}\n\nfuncion dyn_desenvolver(v) {\n    si (dyn_tipo(v) != 3) { retornar v }\n    sea m = dyn_dato(v)\n    si (map_tiene(m, \"valor\") y (map_tiene(m, \"ok\") o map_tiene(m, \"presente\"))) { retornar map_obtener(m, \"valor\") }\n    retornar v\n}\n\nfuncion dyn_fijar_indice(c, k, v) {\n    sea t = dyn_tipo(c)\n    si (t == 2) {\n        sea l = dyn_dato(c)\n        vec_fijar(l, dyn_indice_lista(l, k), v)\n        retornar 0\n    }\n    si (t == 3) {\n        map_fijar(dyn_dato(c), dyn_clave(k), v)\n        retornar 0\n    }\n    dyn_error_tipo(\"no se puede asignar por índice\", c)\n    retornar 0\n}\n\n// Para \"para x en c\": cantidad de elementos (entero crudo) y elemento i.\nfuncion dyn_iter_largo(c) {\n    sea t = dyn_tipo(c)\n    si (t == 2) { retornar vec_largo(dyn_dato(c)) }\n    si (t == 1) { retornar str_largo(dyn_dato(c)) }\n    dyn_error_tipo(\"no se puede recorrer\", c)\n    retornar 0\n}\n\nfuncion dyn_iter_obtener(c, i) {\n    si (dyn_tipo(c) == 2) { retornar vec_obtener(dyn_dato(c), i) }\n    retornar dyn_texto(str_rebanar(dyn_dato(c), i, i + 1))\n}\n\n// ── Funciones del lenguaje ────────────────────────────────────────────────\n\nfuncion mostrar(v) {\n    rt_mostrar(dyn_a_str(v))\n    retornar 0\n}\n\nfuncion afirmar(condicion, mensaje) {\n    si (dyn_verdad(condicion) == 0) { dyn_error(dyn_a_str(mensaje)) }\n    retornar 0\n}\n\nfuncion a_texto(v) {\n    si (dyn_tipo(v) == 1) { retornar v }\n    retornar dyn_texto(dyn_a_str(v))\n}\n\nfuncion longitud(v) {\n    sea t = dyn_tipo(v)\n    si (t == 2) { retornar dyn_entero(vec_largo(dyn_dato(v))) }\n    si (t == 1) { retornar dyn_entero(str_largo(dyn_dato(v))) }\n    si (t == 3) { retornar dyn_entero(map_tamano(dyn_dato(v))) }\n    dyn_error_tipo(\"longitud\", v)\n    retornar 0\n}\n\nfuncion agregar(l, v) {\n    si (dyn_tipo(l) != 2) { dyn_error_tipo(\"agregar\", l) }\n    vec_agregar(dyn_dato(l), v)\n    retornar 0\n}\n\nfuncion claves(m) {\n    si (dyn_tipo(m) != 3) { dyn_error_tipo(\"claves\", m) }\n    sea crudas = dyn_claves_ordenadas(dyn_dato(m))\n    sea r = vec_nuevo()\n    sea i = 0\n    mientras (i < vec_largo(crudas)) {\n        vec_agregar(r, dyn_texto(vec_obtener(crudas, i)))\n        i = i + 1\n    }\n    vec_liberar(crudas)\n    retornar dyn_caja(2, r)\n}\n\nfuncion tiene_clave(m, k) {\n    si (dyn_tipo(m) != 3) { dyn_error_tipo(\"tiene_clave\", m) }\n    retornar dyn_bool(map_tiene(dyn_dato(m), dyn_clave(k)))\n}\n\nfuncion quitar_clave(m, k) {\n    si (dyn_tipo(m) != 3) { dyn_error_tipo(\"quitar_clave\", m) }\n    retornar dyn_bool(map_quitar(dyn_dato(m), dyn_clave(k)))\n}\n\nfuncion lista_rango(inicio, fin) {\n    sea r = vec_nuevo()\n    sea i = dyn_valor_entero(inicio)\n    sea n = dyn_valor_entero(fin)\n    mientras (i < n) {\n        vec_agregar(r, dyn_entero(i))\n        i = i + 1\n    }\n    retornar dyn_caja(2, r)\n}\n\nfuncion lista_invertir(l) {\n    si (dyn_tipo(l) != 2) { dyn_error_tipo(\"lista_invertir\", l) }\n    sea origen = dyn_dato(l)\n    sea r = vec_nuevo()\n    sea i = vec_largo(origen) - 1\n    mientras (i >= 0) {\n        vec_agregar(r, vec_obtener(origen, i))\n        i = i - 1\n    }\n    retornar dyn_caja(2, r)\n}\n\nfuncion lista_contiene(l, v) {\n    si (dyn_tipo(l) != 2) { dyn_error_tipo(\"lista_contiene\", l) }\n    sea origen = dyn_dato(l)\n    sea i = 0\n    mientras (i < vec_largo(origen)) {\n        si (dyn_igual_crudo(vec_obtener(origen, i), v)) { retornar 4 }\n        i = i + 1\n    }\n    retornar 2\n}\n\nfuncion quitar_ultimo(l) {\n    si (dyn_tipo(l) != 2) { dyn_error_tipo(\"quitar_ultimo\", l) }\n    retornar vec_quitar_ultimo(dyn_dato(l))\n}\n\nfuncion piso(v) {\n    si (__y_bits(v, 1) == 1) { retornar v }\n    sea x = dyn_a_f64(v)\n    sea e = __f64_a_entero(x)\n    si (__f64_menor(x, __f64_desde_entero(e))) { e = e - 1 }\n    retornar dyn_entero(e)\n}\n\nfuncion techo(v) {\n    si (__y_bits(v, 1) == 1) { retornar v }\n    sea x = dyn_a_f64(v)\n    sea e = __f64_a_entero(x)\n    si (__f64_menor(__f64_desde_entero(e), x)) { e = e + 1 }\n    retornar dyn_entero(e)\n}\n\nfuncion a_numero(v) {\n    si (dyn_es_numero(v)) { retornar v }\n    sea s = dyn_texto_de(v, \"a_numero\")\n    sea i = 0\n    sea n = str_largo(s)\n    sea negativo = 0\n    si (n > 0 y str_byte(s, 0) == 45) {\n        negativo = 1\n        i = 1\n    }\n    sea entero = 0\n    sea digitos = 0\n    mientras (i < n y str_byte(s, i) >= 48 y str_byte(s, i) <= 57) {\n        entero = entero * 10 + str_byte(s, i) - 48\n        digitos = digitos + 1\n        i = i + 1\n    }\n    sea valor = __f64_desde_entero(entero)\n    si (i < n y str_byte(s, i) == 46) {\n        i = i + 1\n        sea fraccion = 0\n        sea escala = 1\n        mientras (i < n y str_byte(s, i) >= 48 y str_byte(s, i) <= 57) {\n            fraccion = fraccion * 10 + str_byte(s, i) - 48\n            escala = escala * 10\n            digitos = digitos + 1\n            i = i + 1\n        }\n        valor = __f64_suma(valor, __f64_div(__f64_desde_entero(fraccion), __f64_desde_entero(escala)))\n    }\n    si (digitos == 0 o i != n) { dyn_error(str_concatenar(\"no es un número: \", s)) }\n    si (negativo) { valor = __f64_resta(__f64_desde_entero(0), valor) }\n    retornar dyn_desde_f64(valor)\n}\n\nfuncion tipo_de(v) { retornar dyn_texto(dyn_nombre_tipo(v)) }\n\nfuncion dyn_cambiar_letras(v, desde, hasta, operacion) {\n    sea s = dyn_texto_de(v, operacion)\n    sea r = str_nuevo(str_largo(s))\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        sea b = str_byte(s, i)\n        si (b >= desde y b <= hasta) { b = __xo_bits(b, 32) }\n        str_agregar_byte(r, b)\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion texto_mayusculas(v) { retornar dyn_cambiar_letras(v, 97, 122, \"texto_mayusculas\") }\nfuncion texto_minusculas(v) { retornar dyn_cambiar_letras(v, 65, 90, \"texto_minusculas\") }\n\n// ── Punteros de bloques inseguro (con límites verificados) ───────────────\n\nfuncion dyn_puntero(bloque, desplazamiento) {\n    sea r = mem_reservar(16)\n    __guardar64(r, bloque)\n    __guardar64(r + 8, desplazamiento)\n    retornar dyn_caja(8, r)\n}\n\n// @x: puntero al inicio de un bloque (lista) o el mismo puntero.\nfuncion dyn_direccion(v) {\n    si (dyn_tipo(v) == 8) { retornar v }\n    si (dyn_tipo(v) != 2) { dyn_error_tipo(\"@ requiere un bloque de memoria\", v) }\n    retornar dyn_puntero(v, 0)\n}\n\nfuncion dyn_posicion_puntero(p) {\n    si (dyn_tipo(p) != 8) { dyn_error_tipo(\"* requiere un puntero\", p) }\n    sea bloque = __cargar64(dyn_dato(p))\n    sea i = __cargar64(dyn_dato(p) + 8)\n    si (i < 0 o i >= vec_largo(dyn_dato(bloque))) { dyn_error(\"acceso inseguro fuera del bloque de memoria\") }\n    retornar i\n}\n\nfuncion dyn_leer_puntero(p) {\n    sea i = dyn_posicion_puntero(p)\n    retornar vec_obtener(dyn_dato(__cargar64(dyn_dato(p))), i)\n}\n\nfuncion dyn_escribir_puntero(p, v) {\n    sea i = dyn_posicion_puntero(p)\n    vec_fijar(dyn_dato(__cargar64(dyn_dato(p))), i, v)\n    retornar 0\n}\n\nfuncion memoria_asignar(n) {\n    sea r = vec_nuevo()\n    sea i = 0\n    mientras (i < dyn_valor_entero(n)) {\n        vec_agregar(r, 1)\n        i = i + 1\n    }\n    retornar dyn_caja(2, r)\n}\n\nfuncion memoria_liberar(bloque) {\n    si (dyn_tipo(bloque) == 2) { __guardar64(dyn_dato(bloque), 0) }\n    retornar 0\n}\n" }
    si (i == 15) { retornar "// runtime/biblioteca.cfv — biblioteca estándar nativa, 100 % C-Forge.\n//\n// Se compila en modo puente (como dyn.cfv): código del dialecto nativo que\n// recibe y devuelve valores del lenguaje. Sin libc: la matemática usa series\n// propias, el tiempo usa clock_gettime y los archivos usan syscalls.\n\n// ── Flotantes: constantes y ayudas ────────────────────────────────────────\n\nfuncion f_(n) { retornar __f64_desde_entero(n) }\nfuncion f_pi() { retornar 4614256656552045848 }               // 0x400921FB54442D18\nfuncion f_ln2() { retornar 4604418534313441775 }              // 0x3FE62E42FEFA39EF\nfuncion f_neg(x) { retornar __f64_resta(f_(0), x) }\nfuncion f_abs(x) { retornar __desplazar_der(__desplazar_izq(x, 1), 1) }\nfuncion f_mayor(a, b) { retornar __f64_menor(b, a) }\n\n// Redondeo a entero, mitades lejos del cero.\nfuncion f_redondear(x) {\n    si (__f64_menor(x, f_(0))) {\n        retornar 0 - __f64_a_entero(__f64_suma(f_abs(x), __f64_div(f_(1), f_(2))))\n    }\n    retornar __f64_a_entero(__f64_suma(x, __f64_div(f_(1), f_(2))))\n}\n\nfuncion f_potencia10(n) {\n    sea r = f_(1)\n    sea i = 0\n    mientras (i < n) {\n        r = __f64_mul(r, f_(10))\n        i = i + 1\n    }\n    retornar r\n}\n\n// seno en [-pi/2, pi/2] por serie de Taylor.\nfuncion f_seno_reducido(x) {\n    sea x2 = __f64_mul(x, x)\n    sea termino = x\n    sea suma = x\n    sea k = 1\n    mientras (k < 10) {\n        termino = __f64_div(__f64_mul(f_neg(termino), x2), f_((2 * k) * (2 * k + 1)))\n        suma = __f64_suma(suma, termino)\n        k = k + 1\n    }\n    retornar suma\n}\n\nfuncion f_coseno_reducido(x) {\n    sea x2 = __f64_mul(x, x)\n    sea termino = f_(1)\n    sea suma = f_(1)\n    sea k = 1\n    mientras (k < 11) {\n        termino = __f64_div(__f64_mul(f_neg(termino), x2), f_((2 * k - 1) * (2 * k)))\n        suma = __f64_suma(suma, termino)\n        k = k + 1\n    }\n    retornar suma\n}\n\n// Lleva x a [-pi, pi].\nfuncion f_reducir_angulo(x) {\n    sea dos_pi = __f64_mul(f_(2), f_pi())\n    sea k = f_redondear(__f64_div(x, dos_pi))\n    retornar __f64_resta(x, __f64_mul(f_(k), dos_pi))\n}\n\nfuncion f_seno(x) {\n    x = f_reducir_angulo(x)\n    sea medio_pi = __f64_div(f_pi(), f_(2))\n    si (f_mayor(x, medio_pi)) { x = __f64_resta(f_pi(), x) }\n    si (__f64_menor(x, f_neg(medio_pi))) { x = __f64_resta(f_neg(f_pi()), x) }\n    retornar f_seno_reducido(x)\n}\n\nfuncion f_coseno(x) {\n    x = f_abs(f_reducir_angulo(x))\n    si (f_mayor(x, __f64_div(f_pi(), f_(2)))) {\n        retornar f_neg(f_coseno_reducido(__f64_resta(f_pi(), x)))\n    }\n    retornar f_coseno_reducido(x)\n}\n\nfuncion f_arcotangente(x) {\n    sea negativo = __f64_menor(x, f_(0))\n    x = f_abs(x)\n    sea invertido = 0\n    si (f_mayor(x, f_(1))) {\n        x = __f64_div(f_(1), x)\n        invertido = 1\n    }\n    // atan(x) = 2·atan(x / (1 + sqrt(1 + x²))), dos veces.\n    sea factor = 1\n    sea i = 0\n    mientras (i < 2) {\n        x = __f64_div(x, __f64_suma(f_(1), __f64_raiz(__f64_suma(f_(1), __f64_mul(x, x)))))\n        factor = factor * 2\n        i = i + 1\n    }\n    sea x2 = __f64_mul(x, x)\n    sea potencia = x\n    sea suma = x\n    sea k = 1\n    mientras (k < 12) {\n        potencia = __f64_mul(f_neg(potencia), x2)\n        suma = __f64_suma(suma, __f64_div(potencia, f_(2 * k + 1)))\n        k = k + 1\n    }\n    sea r = __f64_mul(suma, f_(factor))\n    si (invertido) { r = __f64_resta(__f64_div(f_pi(), f_(2)), r) }\n    si (negativo) { r = f_neg(r) }\n    retornar r\n}\n\nfuncion f_arcoseno(x) {\n    si (f_mayor(f_abs(x), f_(1))) { dyn_error(\"arcoseno fuera de [-1, 1]\") }\n    si (f_abs(x) == f_(1)) {\n        sea medio = __f64_div(f_pi(), f_(2))\n        si (__f64_menor(x, f_(0))) { retornar f_neg(medio) }\n        retornar medio\n    }\n    retornar f_arcotangente(__f64_div(x, __f64_raiz(__f64_resta(f_(1), __f64_mul(x, x)))))\n}\n\nfuncion f_exponencial(x) {\n    sea k = f_redondear(__f64_div(x, f_ln2()))\n    sea r = __f64_resta(x, __f64_mul(f_(k), f_ln2()))\n    sea termino = f_(1)\n    sea suma = f_(1)\n    sea i = 1\n    mientras (i < 22) {\n        termino = __f64_div(__f64_mul(termino, r), f_(i))\n        suma = __f64_suma(suma, termino)\n        i = i + 1\n    }\n    mientras (k > 0) {\n        suma = __f64_mul(suma, f_(2))\n        k = k - 1\n    }\n    mientras (k < 0) {\n        suma = __f64_div(suma, f_(2))\n        k = k + 1\n    }\n    retornar suma\n}\n\nfuncion f_logaritmo(x) {\n    si (__f64_menor(f_(0), x) == 0) { dyn_error(\"logaritmo de un número no positivo\") }\n    sea e = __y_bits(__desplazar_der(x, 52), 2047) - 1023\n    sea m = __o_bits(__y_bits(x, 4503599627370495), 4607182418800017408)   // mantisa en [1, 2)\n    si (f_mayor(m, __f64_raiz(f_(2)))) {\n        m = __f64_div(m, f_(2))\n        e = e + 1\n    }\n    sea t = __f64_div(__f64_resta(m, f_(1)), __f64_suma(m, f_(1)))\n    sea t2 = __f64_mul(t, t)\n    sea potencia = t\n    sea suma = t\n    sea k = 1\n    mientras (k < 18) {\n        potencia = __f64_mul(potencia, t2)\n        suma = __f64_suma(suma, __f64_div(potencia, f_(2 * k + 1)))\n        k = k + 1\n    }\n    retornar __f64_suma(__f64_mul(f_(2), suma), __f64_mul(f_(e), f_ln2()))\n}\n\n// ── Formato de números (como %g con 6 cifras, igual que el intérprete) ───\n\nfuncion dyn_formato_g(r, bits) {\n    sea exponente_bits = __y_bits(__desplazar_der(bits, 52), 2047)\n    sea negativo = bits < 0\n    sea x = f_abs(bits)\n    si (exponente_bits == 2047) {\n        si (__desplazar_izq(bits, 12) != 0) { str_agregar(r, \"nan\") retornar 0 }\n        si (negativo) { str_agregar_byte(r, 45) }\n        str_agregar(r, \"inf\")\n        retornar 0\n    }\n    si (x == 0) { str_agregar_byte(r, 48) retornar 0 }\n    si (negativo) { str_agregar_byte(r, 45) }\n    // Exponente decimal e tal que 10^e <= x < 10^(e+1).\n    sea e = 0\n    sea y = x\n    mientras (__f64_menor(y, f_(10)) == 0) {\n        y = __f64_div(y, f_(10))\n        e = e + 1\n    }\n    mientras (__f64_menor(y, f_(1))) {\n        y = __f64_mul(y, f_(10))\n        e = e - 1\n    }\n    // Seis cifras significativas como entero m (100000 <= m < 1000000).\n    sea m = 0\n    si (e - 5 >= 0) {\n        m = f_redondear(__f64_div(x, f_potencia10(e - 5)))\n    } sino {\n        m = f_redondear(__f64_mul(x, f_potencia10(5 - e)))\n    }\n    si (m >= 1000000) {\n        m = (m + 5) / 10\n        e = e + 1\n    }\n    si (m < 100000) {\n        m = m * 10\n        e = e - 1\n    }\n    sea digitos = str_desde_entero(m)\n    // Quitar ceros finales.\n    sea utiles = 6\n    mientras (utiles > 1 y str_byte(digitos, utiles - 1) == 48) { utiles = utiles - 1 }\n    si (e < 0 - 4 o e >= 6) {\n        str_agregar_byte(r, str_byte(digitos, 0))\n        si (utiles > 1) {\n            str_agregar_byte(r, 46)\n            str_agregar(r, str_rebanar(digitos, 1, utiles))\n        }\n        str_agregar_byte(r, 101)\n        si (e < 0) {\n            str_agregar_byte(r, 45)\n            e = 0 - e\n        } sino {\n            str_agregar_byte(r, 43)\n        }\n        si (e < 10) { str_agregar_byte(r, 48) }\n        str_agregar(r, str_desde_entero(e))\n        retornar 0\n    }\n    si (e >= 0) {\n        str_agregar(r, str_rebanar(digitos, 0, e + 1))\n        si (utiles > e + 1) {\n            str_agregar_byte(r, 46)\n            str_agregar(r, str_rebanar(digitos, e + 1, utiles))\n        }\n        retornar 0\n    }\n    str_agregar(r, \"0.\")\n    sea ceros = 0 - e - 1\n    mientras (ceros > 0) {\n        str_agregar_byte(r, 48)\n        ceros = ceros - 1\n    }\n    str_agregar(r, str_rebanar(digitos, 0, utiles))\n    retornar 0\n}\n\n// ── Matemática del lenguaje ───────────────────────────────────────────────\n\nfuncion absoluto(v) {\n    si (__y_bits(v, 1) == 1) {\n        si (v < 0) { retornar 2 - v }\n        retornar v\n    }\n    retornar dyn_desde_f64(f_abs(dyn_a_f64(v)))\n}\n\nfuncion minimo(a, b) {\n    si (dyn_comparar(b, a) < 0) { retornar b }\n    retornar a\n}\n\nfuncion maximo(a, b) {\n    si (dyn_comparar(b, a) > 0) { retornar b }\n    retornar a\n}\n\nfuncion raiz(v) {\n    sea x = dyn_a_f64(v)\n    si (__f64_menor(x, f_(0))) { dyn_error(\"raíz de un número negativo\") }\n    retornar dyn_desde_f64(__f64_raiz(x))\n}\n\nfuncion potencia(base, exponente) {\n    si (dyn_ambos_enteros(base, exponente) y exponente >= 1) {\n        sea b = dyn_valor_entero(base)\n        sea e = dyn_valor_entero(exponente)\n        sea r = 1\n        sea desborda = 0\n        mientras (e > 0 y desborda == 0) {\n            si (r > 1152921504606846976 / (absoluto_crudo(b) + 1)) { desborda = 1 }\n            r = r * b\n            e = e - 1\n        }\n        si (desborda == 0) { retornar dyn_entero(r) }\n    }\n    sea x = dyn_a_f64(base)\n    sea y = dyn_a_f64(exponente)\n    si (x == f_(0)) {\n        si (__f64_menor(f_(0), y)) { retornar dyn_entero(0) }\n        si (y == f_(0)) { retornar dyn_entero(1) }\n        dyn_error(\"potencia: cero elevado a un exponente negativo\")\n    }\n    si (__f64_menor(x, f_(0))) {\n        sea entero = __f64_a_entero(y)\n        si (f_(entero) != y) { dyn_error(\"potencia: base negativa con exponente fraccionario\") }\n        sea magnitud = f_exponencial(__f64_mul(y, f_logaritmo(f_abs(x))))\n        si (__y_bits(entero, 1) == 1) { magnitud = f_neg(magnitud) }\n        retornar dyn_desde_f64(magnitud)\n    }\n    retornar dyn_desde_f64(f_exponencial(__f64_mul(y, f_logaritmo(x))))\n}\n\nfuncion absoluto_crudo(n) {\n    si (n < 0) { retornar 0 - n }\n    retornar n\n}\n\nfuncion redondear(v, decimales) {\n    si (__y_bits(v, 1) == 1) { retornar v }\n    sea x = dyn_a_f64(v)\n    si (decimales == 0) { retornar dyn_entero(f_redondear(x)) }\n    sea escala = f_potencia10(dyn_valor_entero(decimales))\n    retornar dyn_desde_f64(__f64_div(f_(f_redondear(__f64_mul(x, escala))), escala))\n}\n\nfuncion seno(v) { retornar dyn_desde_f64(f_seno(dyn_a_f64(v))) }\nfuncion coseno(v) { retornar dyn_desde_f64(f_coseno(dyn_a_f64(v))) }\nfuncion tangente(v) {\n    sea x = dyn_a_f64(v)\n    retornar dyn_desde_f64(__f64_div(f_seno(x), f_coseno(x)))\n}\nfuncion arcoseno(v) { retornar dyn_desde_f64(f_arcoseno(dyn_a_f64(v))) }\nfuncion arccoseno(v) {\n    retornar dyn_desde_f64(__f64_resta(__f64_div(f_pi(), f_(2)), f_arcoseno(dyn_a_f64(v))))\n}\nfuncion arcotangente(v) { retornar dyn_desde_f64(f_arcotangente(dyn_a_f64(v))) }\nfuncion exponencial(v) { retornar dyn_desde_f64(f_exponencial(dyn_a_f64(v))) }\nfuncion logaritmo(v) { retornar dyn_desde_f64(f_logaritmo(dyn_a_f64(v))) }\nfuncion sen(v) { retornar seno(v) }\nfuncion cos(v) { retornar coseno(v) }\nfuncion tan(v) { retornar tangente(v) }\nfuncion pi() { retornar dyn_desde_f64(f_pi()) }\n\n// Generador xorshift64* (global 22), sembrado con el reloj.\nfuncion aleatorio_crudo() {\n    sea x = mem_global(22)\n    si (x == 0) { x = __o_bits(sys_reloj_ns(), 1) }\n    x = __xo_bits(x, __desplazar_der(x, 12))\n    x = __xo_bits(x, __desplazar_izq(x, 25))\n    x = __xo_bits(x, __desplazar_der(x, 27))\n    mem_fijar_global(22, x)\n    retornar __desplazar_der(x * 2685821657736338717, 11)        // 53 bits\n}\n\nfuncion aleatorio() {\n    retornar dyn_caja(4, __f64_div(f_(aleatorio_crudo()), f_(9007199254740992)))\n}\n\nfuncion aleatorio_entero(minimo_v, maximo_v) {\n    sea a = dyn_valor_entero(minimo_v)\n    sea b = dyn_valor_entero(maximo_v)\n    si (b < a) { dyn_error(\"aleatorio_entero: el máximo es menor que el mínimo\") }\n    retornar dyn_entero(a + aleatorio_crudo() % (b - a + 1))\n}\n\n// ── Texto ─────────────────────────────────────────────────────────────────\n\n// Posición de aguja en pajar desde inicio, o -1.\nfuncion str_buscar(pajar, aguja, inicio) {\n    sea n = str_largo(pajar)\n    sea m = str_largo(aguja)\n    sea i = inicio\n    mientras (i + m <= n) {\n        sea j = 0\n        mientras (j < m y str_byte(pajar, i + j) == str_byte(aguja, j)) { j = j + 1 }\n        si (j == m) { retornar i }\n        i = i + 1\n    }\n    retornar 0 - 1\n}\n\nfuncion texto_reemplazar(t, buscado, reemplazo) {\n    sea s = dyn_texto_de(t, \"texto_reemplazar\")\n    sea a = dyn_texto_de(buscado, \"texto_reemplazar\")\n    sea b = dyn_a_str(reemplazo)\n    si (str_largo(a) == 0) { retornar t }\n    sea r = str_nuevo(str_largo(s))\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        sea p = str_buscar(s, a, i)\n        si (p < 0) {\n            str_agregar(r, str_rebanar(s, i, str_largo(s)))\n            i = str_largo(s)\n        } sino {\n            str_agregar(r, str_rebanar(s, i, p))\n            str_agregar(r, b)\n            i = p + str_largo(a)\n        }\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion contiene(coleccion, v) {\n    sea t = dyn_tipo(coleccion)\n    si (t == 1) {\n        retornar dyn_bool(str_buscar(dyn_dato(coleccion), dyn_a_str(v), 0) >= 0)\n    }\n    si (t == 2) { retornar lista_contiene(coleccion, v) }\n    si (t == 3) { retornar tiene_clave(coleccion, v) }\n    dyn_error_tipo(\"contiene\", coleccion)\n    retornar 2\n}\n\nfuncion texto_contiene(t, sub) { retornar contiene(t, sub) }\n\nfuncion subtexto(t, inicio, fin) {\n    sea s = dyn_texto_de(t, \"subtexto\")\n    retornar dyn_texto(str_rebanar(s, dyn_valor_entero(inicio), dyn_valor_entero(fin)))\n}\n\nfuncion texto_dividir(t, separador) {\n    sea s = dyn_texto_de(t, \"texto_dividir\")\n    sea sep = dyn_texto_de(separador, \"texto_dividir\")\n    sea r = vec_nuevo()\n    si (str_largo(sep) == 0) {\n        sea k = 0\n        mientras (k < str_largo(s)) {\n            vec_agregar(r, dyn_texto(str_rebanar(s, k, k + 1)))\n            k = k + 1\n        }\n        retornar dyn_caja(2, r)\n    }\n    sea i = 0\n    sea seguir = 1\n    mientras (seguir) {\n        sea p = str_buscar(s, sep, i)\n        si (p < 0) {\n            vec_agregar(r, dyn_texto(str_rebanar(s, i, str_largo(s))))\n            seguir = 0\n        } sino {\n            vec_agregar(r, dyn_texto(str_rebanar(s, i, p)))\n            i = p + str_largo(sep)\n        }\n    }\n    retornar dyn_caja(2, r)\n}\n\nfuncion texto_unir(lista, separador) {\n    si (dyn_tipo(lista) != 2) { dyn_error_tipo(\"texto_unir\", lista) }\n    sea l = dyn_dato(lista)\n    sea r = str_nuevo(16)\n    sea i = 0\n    mientras (i < vec_largo(l)) {\n        si (i > 0) { dyn_agregar_valor(r, separador, 0) }\n        dyn_agregar_valor(r, vec_obtener(l, i), 0)\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion es_blanco(b) { retornar b == 32 o b == 9 o b == 10 o b == 13 }\n\nfuncion texto_recortar(t) {\n    sea s = dyn_texto_de(t, \"texto_recortar\")\n    sea i = 0\n    sea j = str_largo(s)\n    mientras (i < j y es_blanco(str_byte(s, i))) { i = i + 1 }\n    mientras (j > i y es_blanco(str_byte(s, j - 1))) { j = j - 1 }\n    retornar dyn_texto(str_rebanar(s, i, j))\n}\n\n// Código Unicode del primer carácter (UTF-8).\nfuncion cfv_codigo_char(t) {\n    sea s = dyn_texto_de(t, \"codigo_char\")\n    si (str_largo(s) == 0) { dyn_error(\"codigo_char: texto vacío\") }\n    sea b = str_byte(s, 0)\n    si (b < 128) { retornar dyn_entero(b) }\n    sea extra = 1\n    sea valor = __y_bits(b, 31)\n    si (b >= 240) {\n        extra = 3\n        valor = __y_bits(b, 7)\n    } sino {\n        si (b >= 224) {\n            extra = 2\n            valor = __y_bits(b, 15)\n        }\n    }\n    sea i = 1\n    mientras (i <= extra y i < str_largo(s)) {\n        valor = valor * 64 + __y_bits(str_byte(s, i), 63)\n        i = i + 1\n    }\n    retornar dyn_entero(valor)\n}\n\nfuncion str_agregar_utf8(r, n) {\n    si (n < 128) { str_agregar_byte(r, n) retornar 0 }\n    si (n < 2048) {\n        str_agregar_byte(r, 192 + n / 64)\n        str_agregar_byte(r, 128 + n % 64)\n        retornar 0\n    }\n    si (n < 65536) {\n        str_agregar_byte(r, 224 + n / 4096)\n        str_agregar_byte(r, 128 + (n / 64) % 64)\n        str_agregar_byte(r, 128 + n % 64)\n        retornar 0\n    }\n    str_agregar_byte(r, 240 + n / 262144)\n    str_agregar_byte(r, 128 + (n / 4096) % 64)\n    str_agregar_byte(r, 128 + (n / 64) % 64)\n    str_agregar_byte(r, 128 + n % 64)\n    retornar 0\n}\n\nfuncion caracter(codigo) {\n    sea r = str_nuevo(4)\n    str_agregar_utf8(r, dyn_valor_entero(codigo))\n    retornar dyn_texto(r)\n}\n\n// Byte i del texto como entero (para bibliotecas escritas en C-Forge).\nfuncion byte_en(t, i) {\n    retornar dyn_entero(str_byte(dyn_texto_de(t, \"byte_en\"), dyn_valor_entero(i)))\n}\n\n// ── Base64 y URL ──────────────────────────────────────────────────────────\n\nfuncion base64_simbolo(n) {\n    si (n < 26) { retornar 65 + n }\n    si (n < 52) { retornar 97 + n - 26 }\n    si (n < 62) { retornar 48 + n - 52 }\n    si (n == 62) { retornar 43 }\n    retornar 47\n}\n\nfuncion base64_valor(b) {\n    si (b >= 65 y b <= 90) { retornar b - 65 }\n    si (b >= 97 y b <= 122) { retornar b - 97 + 26 }\n    si (b >= 48 y b <= 57) { retornar b - 48 + 52 }\n    si (b == 43 o b == 45) { retornar 62 }\n    si (b == 47 o b == 95) { retornar 63 }\n    retornar 0 - 1\n}\n\nfuncion cfv_base64_codificar(t) {\n    sea s = dyn_a_str(t)\n    sea n = str_largo(s)\n    sea r = str_nuevo(n * 4 / 3 + 4)\n    sea i = 0\n    mientras (i < n) {\n        sea b0 = str_byte(s, i)\n        sea b1 = 0\n        sea b2 = 0\n        si (i + 1 < n) { b1 = str_byte(s, i + 1) }\n        si (i + 2 < n) { b2 = str_byte(s, i + 2) }\n        sea grupo = b0 * 65536 + b1 * 256 + b2\n        str_agregar_byte(r, base64_simbolo(__y_bits(__desplazar_der(grupo, 18), 63)))\n        str_agregar_byte(r, base64_simbolo(__y_bits(__desplazar_der(grupo, 12), 63)))\n        si (i + 1 < n) { str_agregar_byte(r, base64_simbolo(__y_bits(__desplazar_der(grupo, 6), 63))) } sino { str_agregar_byte(r, 61) }\n        si (i + 2 < n) { str_agregar_byte(r, base64_simbolo(__y_bits(grupo, 63))) } sino { str_agregar_byte(r, 61) }\n        i = i + 3\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion cfv_base64_decodificar(t) {\n    sea s = dyn_texto_de(t, \"base64_decodificar\")\n    sea r = str_nuevo(str_largo(s))\n    sea acumulado = 0\n    sea bits = 0\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        sea v = base64_valor(str_byte(s, i))\n        si (v >= 0) {\n            acumulado = __y_bits(acumulado * 64 + v, 16777215)\n            bits = bits + 6\n            si (bits >= 8) {\n                bits = bits - 8\n                str_agregar_byte(r, __y_bits(__desplazar_der(acumulado, bits), 255))\n            }\n        }\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion hex_digito(n) {\n    si (n < 10) { retornar 48 + n }\n    retornar 55 + n\n}\n\nfuncion valor_hex(b) {\n    si (b >= 48 y b <= 57) { retornar b - 48 }\n    si (b >= 65 y b <= 70) { retornar b - 55 }\n    si (b >= 97 y b <= 102) { retornar b - 87 }\n    retornar 0 - 1\n}\n\nfuncion url_reservado(b) {\n    si ((b >= 65 y b <= 90) o (b >= 97 y b <= 122) o (b >= 48 y b <= 57)) { retornar 0 }\n    si (b == 45 o b == 95 o b == 46 o b == 126) { retornar 0 }\n    retornar 1\n}\n\nfuncion cfv_url_codificar(t) {\n    sea s = dyn_a_str(t)\n    sea r = str_nuevo(str_largo(s) * 3)\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        sea b = str_byte(s, i)\n        si (url_reservado(b)) {\n            str_agregar_byte(r, 37)\n            str_agregar_byte(r, hex_digito(b / 16))\n            str_agregar_byte(r, hex_digito(b % 16))\n        } sino {\n            str_agregar_byte(r, b)\n        }\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion cfv_url_decodificar(t) {\n    sea s = dyn_texto_de(t, \"url_decodificar\")\n    sea r = str_nuevo(str_largo(s))\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        sea b = str_byte(s, i)\n        si (b == 37 y i + 2 < str_largo(s) y valor_hex(str_byte(s, i + 1)) >= 0 y valor_hex(str_byte(s, i + 2)) >= 0) {\n            str_agregar_byte(r, valor_hex(str_byte(s, i + 1)) * 16 + valor_hex(str_byte(s, i + 2)))\n            i = i + 3\n        } sino {\n            si (b == 43) { str_agregar_byte(r, 32) } sino { str_agregar_byte(r, b) }\n            i = i + 1\n        }\n    }\n    retornar dyn_texto(r)\n}\n\n// ── SHA-256 y MD5 (aritmética de 32 bits sobre enteros de 64) ─────────────\n\nfuncion u32(x) { retornar __y_bits(x, 4294967295) }\nfuncion rotd32(x, n) { retornar u32(__o_bits(__desplazar_der(x, n), __desplazar_izq(x, 32 - n))) }\nfuncion roti32(x, n) { retornar u32(__o_bits(__desplazar_izq(x, n), __desplazar_der(x, 32 - n))) }\n\nfuncion hex_agregar(r, valor, bytes, invertido) {\n    sea i = 0\n    mientras (i < bytes) {\n        sea desplazamiento = (bytes - 1 - i) * 8\n        si (invertido) { desplazamiento = i * 8 }\n        sea b = __y_bits(__desplazar_der(valor, desplazamiento), 255)\n        str_agregar_byte(r, __o_bits(hex_digito(b / 16), 32))\n        str_agregar_byte(r, __o_bits(hex_digito(b % 16), 32))\n        i = i + 1\n    }\n    retornar 0\n}\n\n// Mensaje con relleno de 64 bytes; longitud en bits al final (BE o LE).\nfuncion hash_relleno(s, little) {\n    sea r = str_nuevo(str_largo(s) + 72)\n    str_agregar(r, s)\n    str_agregar_byte(r, 128)\n    mientras (str_largo(r) % 64 != 56) { str_agregar_byte(r, 0) }\n    sea bits = str_largo(s) * 8\n    sea i = 0\n    mientras (i < 8) {\n        si (little) {\n            str_agregar_byte(r, __y_bits(__desplazar_der(bits, i * 8), 255))\n        } sino {\n            str_agregar_byte(r, __y_bits(__desplazar_der(bits, (7 - i) * 8), 255))\n        }\n        i = i + 1\n    }\n    retornar r\n}\n\nfuncion sha256_k() {\n    sea k = mem_global(23)\n    si (k != 0) { retornar k }\n    k = vec_nuevo()\n    sea valores = \"428a2f98 71374491 b5c0fbcf e9b5dba5 3956c25b 59f111f1 923f82a4 ab1c5ed5 d807aa98 12835b01 243185be 550c7dc3 72be5d74 80deb1fe 9bdc06a7 c19bf174 e49b69c1 efbe4786 0fc19dc6 240ca1cc 2de92c6f 4a7484aa 5cb0a9dc 76f988da 983e5152 a831c66d b00327c8 bf597fc7 c6e00bf3 d5a79147 06ca6351 14292967 27b70a85 2e1b2138 4d2c6dfc 53380d13 650a7354 766a0abb 81c2c92e 92722c85 a2bfe8a1 a81a664b c24b8b70 c76c51a3 d192e819 d6990624 f40e3585 106aa070 19a4c116 1e376c08 2748774c 34b0bcb5 391c0cb3 4ed8aa4a 5b9cca4f 682e6ff3 748f82ee 78a5636f 84c87814 8cc70208 90befffa a4506ceb bef9a3f7 c67178f2\"\n    sea i = 0\n    mientras (i < str_largo(valores)) {\n        sea v = 0\n        sea j = 0\n        mientras (j < 8) {\n            v = v * 16 + valor_hex(str_byte(valores, i + j))\n            j = j + 1\n        }\n        vec_agregar(k, v)\n        i = i + 9\n    }\n    mem_fijar_global(23, k)\n    retornar k\n}\n\nfuncion cfv_sha256(t) {\n    sea m = hash_relleno(dyn_a_str(t), 0)\n    sea k = sha256_k()\n    sea h = vec_nuevo()\n    vec_agregar(h, 1779033703)\n    vec_agregar(h, 3144134277)\n    vec_agregar(h, 1013904242)\n    vec_agregar(h, 2773480762)\n    vec_agregar(h, 1359893119)\n    vec_agregar(h, 2600822924)\n    vec_agregar(h, 528734635)\n    vec_agregar(h, 1541459225)\n    sea w = vec_nuevo()\n    sea i = 0\n    mientras (i < 64) {\n        vec_agregar(w, 0)\n        i = i + 1\n    }\n    sea bloque = 0\n    mientras (bloque < str_largo(m)) {\n        i = 0\n        mientras (i < 16) {\n            sea p = bloque + i * 4\n            vec_fijar(w, i, str_byte(m, p) * 16777216 + str_byte(m, p + 1) * 65536 + str_byte(m, p + 2) * 256 + str_byte(m, p + 3))\n            i = i + 1\n        }\n        mientras (i < 64) {\n            sea w15 = vec_obtener(w, i - 15)\n            sea w2 = vec_obtener(w, i - 2)\n            sea s0 = __xo_bits(__xo_bits(rotd32(w15, 7), rotd32(w15, 18)), __desplazar_der(w15, 3))\n            sea s1 = __xo_bits(__xo_bits(rotd32(w2, 17), rotd32(w2, 19)), __desplazar_der(w2, 10))\n            vec_fijar(w, i, u32(vec_obtener(w, i - 16) + s0 + vec_obtener(w, i - 7) + s1))\n            i = i + 1\n        }\n        sea a = vec_obtener(h, 0)\n        sea b = vec_obtener(h, 1)\n        sea c = vec_obtener(h, 2)\n        sea d = vec_obtener(h, 3)\n        sea e = vec_obtener(h, 4)\n        sea f = vec_obtener(h, 5)\n        sea g = vec_obtener(h, 6)\n        sea hh = vec_obtener(h, 7)\n        i = 0\n        mientras (i < 64) {\n            sea S1 = __xo_bits(__xo_bits(rotd32(e, 6), rotd32(e, 11)), rotd32(e, 25))\n            sea ch = __xo_bits(__y_bits(e, f), __y_bits(__xo_bits(e, 4294967295), g))\n            sea t1 = u32(hh + S1 + ch + vec_obtener(k, i) + vec_obtener(w, i))\n            sea S0 = __xo_bits(__xo_bits(rotd32(a, 2), rotd32(a, 13)), rotd32(a, 22))\n            sea mayoria = __xo_bits(__xo_bits(__y_bits(a, b), __y_bits(a, c)), __y_bits(b, c))\n            sea t2 = u32(S0 + mayoria)\n            hh = g\n            g = f\n            f = e\n            e = u32(d + t1)\n            d = c\n            c = b\n            b = a\n            a = u32(t1 + t2)\n            i = i + 1\n        }\n        vec_fijar(h, 0, u32(vec_obtener(h, 0) + a))\n        vec_fijar(h, 1, u32(vec_obtener(h, 1) + b))\n        vec_fijar(h, 2, u32(vec_obtener(h, 2) + c))\n        vec_fijar(h, 3, u32(vec_obtener(h, 3) + d))\n        vec_fijar(h, 4, u32(vec_obtener(h, 4) + e))\n        vec_fijar(h, 5, u32(vec_obtener(h, 5) + f))\n        vec_fijar(h, 6, u32(vec_obtener(h, 6) + g))\n        vec_fijar(h, 7, u32(vec_obtener(h, 7) + hh))\n        bloque = bloque + 64\n    }\n    sea r = str_nuevo(64)\n    i = 0\n    mientras (i < 8) {\n        hex_agregar(r, vec_obtener(h, i), 4, 0)\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion md5_tablas() {\n    sea t = mem_global(24)\n    si (t != 0) { retornar t }\n    t = vec_nuevo()\n    // K[i] = floor(|sin(i + 1)| · 2^32)\n    sea i = 0\n    mientras (i < 64) {\n        sea s = f_abs(f_seno(f_(i + 1)))\n        vec_agregar(t, __f64_a_entero(__f64_mul(s, f_(4294967296))))\n        i = i + 1\n    }\n    mem_fijar_global(24, t)\n    retornar t\n}\n\nfuncion md5_desplazamiento(i) {\n    sea ronda = i / 16\n    sea j = i % 4\n    si (ronda == 0) {\n        si (j == 0) { retornar 7 }\n        si (j == 1) { retornar 12 }\n        si (j == 2) { retornar 17 }\n        retornar 22\n    }\n    si (ronda == 1) {\n        si (j == 0) { retornar 5 }\n        si (j == 1) { retornar 9 }\n        si (j == 2) { retornar 14 }\n        retornar 20\n    }\n    si (ronda == 2) {\n        si (j == 0) { retornar 4 }\n        si (j == 1) { retornar 11 }\n        si (j == 2) { retornar 16 }\n        retornar 23\n    }\n    si (j == 0) { retornar 6 }\n    si (j == 1) { retornar 10 }\n    si (j == 2) { retornar 15 }\n    retornar 21\n}\n\nfuncion cfv_md5(t) {\n    sea m = hash_relleno(dyn_a_str(t), 1)\n    sea k = md5_tablas()\n    sea a0 = 1732584193\n    sea b0 = 4023233417\n    sea c0 = 2562383102\n    sea d0 = 271733878\n    sea palabras = vec_nuevo()\n    sea i = 0\n    mientras (i < 16) {\n        vec_agregar(palabras, 0)\n        i = i + 1\n    }\n    sea bloque = 0\n    mientras (bloque < str_largo(m)) {\n        i = 0\n        mientras (i < 16) {\n            sea p = bloque + i * 4\n            vec_fijar(palabras, i, str_byte(m, p) + str_byte(m, p + 1) * 256 + str_byte(m, p + 2) * 65536 + str_byte(m, p + 3) * 16777216)\n            i = i + 1\n        }\n        sea a = a0\n        sea b = b0\n        sea c = c0\n        sea d = d0\n        i = 0\n        mientras (i < 64) {\n            sea f = 0\n            sea g = 0\n            si (i < 16) {\n                f = __o_bits(__y_bits(b, c), __y_bits(__xo_bits(b, 4294967295), d))\n                g = i\n            } sino {\n                si (i < 32) {\n                    f = __o_bits(__y_bits(d, b), __y_bits(__xo_bits(d, 4294967295), c))\n                    g = (5 * i + 1) % 16\n                } sino {\n                    si (i < 48) {\n                        f = __xo_bits(__xo_bits(b, c), d)\n                        g = (3 * i + 5) % 16\n                    } sino {\n                        f = __xo_bits(c, __o_bits(b, __xo_bits(d, 4294967295)))\n                        g = (7 * i) % 16\n                    }\n                }\n            }\n            f = u32(f + a + vec_obtener(k, i) + vec_obtener(palabras, g))\n            a = d\n            d = c\n            c = b\n            b = u32(b + roti32(f, md5_desplazamiento(i)))\n            i = i + 1\n        }\n        a0 = u32(a0 + a)\n        b0 = u32(b0 + b)\n        c0 = u32(c0 + c)\n        d0 = u32(d0 + d)\n        bloque = bloque + 64\n    }\n    sea r = str_nuevo(32)\n    hex_agregar(r, a0, 4, 1)\n    hex_agregar(r, b0, 4, 1)\n    hex_agregar(r, c0, 4, 1)\n    hex_agregar(r, d0, 4, 1)\n    retornar dyn_texto(r)\n}\n\n// ── Archivos ──────────────────────────────────────────────────────────────\n\nfuncion leer_archivo(ruta) { retornar dyn_texto(archivo_leer(dyn_texto_de(ruta, \"leer_archivo\"))) }\n\nfuncion escribir_archivo(ruta, contenido) {\n    archivo_escribir(dyn_texto_de(ruta, \"escribir_archivo\"), dyn_a_str(contenido))\n    retornar 0\n}\n\nfuncion existe_archivo(ruta) {\n    sea fd = sys_abrir(str_c(dyn_texto_de(ruta, \"existe_archivo\")), sys_abrir_lectura(), 0)\n    si (fd < 0) { retornar 2 }\n    sys_cerrar(fd)\n    retornar 4\n}\n\n// ── Tiempo (clock_gettime) ────────────────────────────────────────────────\n\n\nfuncion cfv_fecha_ahora_ms() { retornar dyn_entero(sys_reloj_ns() / 1000000) }\n\n// Fecha civil (UTC) a partir de días desde 1970 (algoritmo de H. Hinnant).\nfuncion cfv_fecha_ahora() {\n    sea segundos = sys_reloj_ns() / 1000000000\n    sea dias = segundos / 86400\n    sea resto = segundos % 86400\n    sea z = dias + 719468\n    sea era = z / 146097\n    sea doe = z - era * 146097\n    sea yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365\n    sea y = yoe + era * 400\n    sea doy = doe - (365 * yoe + yoe / 4 - yoe / 100)\n    sea mp = (5 * doy + 2) / 153\n    sea d = doy - (153 * mp + 2) / 5 + 1\n    sea m = mp + 3\n    si (m > 12) { m = m - 12 }\n    si (m <= 2) { y = y + 1 }\n    sea r = map_nuevo()\n    map_fijar(r, \"anio\", dyn_entero(y))\n    map_fijar(r, \"mes\", dyn_entero(m))\n    map_fijar(r, \"dia\", dyn_entero(d))\n    map_fijar(r, \"hora\", dyn_entero(resto / 3600))\n    map_fijar(r, \"minuto\", dyn_entero((resto % 3600) / 60))\n    map_fijar(r, \"segundo\", dyn_entero(resto % 60))\n    map_fijar(r, \"dia_semana\", dyn_entero((dias + 3) % 7))       // 0 = lunes\n    retornar dyn_caja(3, r)\n}\n\n// ── Sistema y rutas ───────────────────────────────────────────────────────\n\n\nfuncion sys_info() {\n    sea r = map_nuevo()\n    map_fijar(r, \"sistema\", dyn_texto(\"linux\"))\n    map_fijar(r, \"cpu\", dyn_texto(\"x86_64\"))\n    map_fijar(r, \"nucleos\", dyn_entero(sys_nucleos()))\n    retornar dyn_caja(3, r)\n}\n\nfuncion ruta_nombre(ruta) {\n    sea s = dyn_texto_de(ruta, \"ruta_nombre\")\n    sea i = str_largo(s)\n    mientras (i > 0 y str_byte(s, i - 1) != 47) { i = i - 1 }\n    retornar dyn_texto(str_rebanar(s, i, str_largo(s)))\n}\n\nfuncion ruta_extension(ruta) {\n    sea s = dyn_dato(ruta_nombre(ruta))\n    sea i = str_largo(s)\n    mientras (i > 0 y str_byte(s, i - 1) != 46) { i = i - 1 }\n    si (i <= 1) { retornar dyn_texto(\"\") }\n    retornar dyn_texto(str_rebanar(s, i - 1, str_largo(s)))\n}\n\n// ── Listas y mapas ────────────────────────────────────────────────────────\n\nfuncion insertar(lista, posicion, v) {\n    si (dyn_tipo(lista) != 2) { dyn_error_tipo(\"insertar\", lista) }\n    sea l = dyn_dato(lista)\n    sea p = dyn_valor_entero(posicion)\n    si (p < 0 o p > vec_largo(l)) { dyn_error(\"insertar: posición inválida\") }\n    vec_agregar(l, 0)\n    sea i = vec_largo(l) - 1\n    mientras (i > p) {\n        vec_fijar(l, i, vec_obtener(l, i - 1))\n        i = i - 1\n    }\n    vec_fijar(l, p, v)\n    retornar 0\n}\n\nfuncion eliminar(lista, posicion) {\n    si (dyn_tipo(lista) != 2) { dyn_error_tipo(\"eliminar\", lista) }\n    sea l = dyn_dato(lista)\n    sea p = dyn_valor_entero(posicion)\n    si (p < 0 o p >= vec_largo(l)) { dyn_error(\"eliminar: posición inválida\") }\n    sea v = vec_obtener(l, p)\n    sea i = p\n    mientras (i + 1 < vec_largo(l)) {\n        vec_fijar(l, i, vec_obtener(l, i + 1))\n        i = i + 1\n    }\n    vec_quitar_ultimo(l)\n    retornar v\n}\n\nfuncion mapa_claves(m) { retornar claves(m) }\n\n// ── Conversión de valores para extern (ABI System V AMD64) ────────────────\n\n// Entero de 64 bits de C → valor del lenguaje: un entero si cabe en 63\n// bits con signo (n·2+1); si no (p. ej. un tagged pointer de Objective-C\n// en ARM64, con el bit 63), una caja de puntero de C (tipo 11) exacta.\nfuncion dyn_entero_desde_c(x) {\n    si (__desplazar_der(x, 63) == __y_bits(__desplazar_der(x, 62), 1)) { retornar x + x + 1 }\n    retornar dyn_caja(11, x)\n}\n\nfuncion dyn_entero_c(v) {\n    sea t = dyn_tipo(v)\n    si (t == 6) { retornar dyn_valor_entero(v) }\n    si (t == 11) { retornar dyn_dato(v) }\n    si (t == 5) { retornar v == 4 }\n    si (t == 0) { retornar 0 }\n    si (t == 4) { retornar __f64_a_entero(dyn_dato(v)) }\n    dyn_error_tipo(\"extern: se esperaba un número entero\", v)\n    retornar 0\n}\n\n// char* terminado en cero (los textos del runtime ya lo están).\nfuncion dyn_texto_c(v) {\n    si (v == 0) { retornar 0 }\n    retornar str_datos(dyn_texto_de(v, \"extern: se esperaba texto\"))\n}\n\nfuncion dyn_texto_desde_c(p) {\n    si (p == 0) { retornar 0 }\n    retornar dyn_texto(str_desde_c(p))\n}\n\n// ── Carga diferida de bibliotecas compartidas (dlopen / dlsym) ───────────\n\n\n// \"sqlite3\" → libsqlite3.so.0, \"SDL2\" → libSDL2-2.0.so.0: busca en los\n// directorios del sistema un archivo lib<nombre>.so* o lib<nombre>-*.so*.\nfuncion buscar_biblioteca(base) {\n    sea dirs = vec_nuevo()\n    vec_agregar(dirs, \"/lib/x86_64-linux-gnu\")\n    vec_agregar(dirs, \"/usr/lib/x86_64-linux-gnu\")\n    vec_agregar(dirs, \"/usr/local/lib\")\n    vec_agregar(dirs, \"/usr/lib64\")\n    vec_agregar(dirs, \"/lib64\")\n    vec_agregar(dirs, \"/usr/lib\")\n    sea con_so = str_concatenar(base, \".so\")\n    sea con_guion = str_concatenar(base, \"-\")\n    sea i = 0\n    mientras (i < vec_largo(dirs)) {\n        sea nombres = sys_listar(vec_obtener(dirs, i))\n        si (nombres != 0) {\n            sea j = 0\n            mientras (j < vec_largo(nombres)) {\n                sea n = vec_obtener(nombres, j)\n                si ((dyn_empieza(n, con_so) o dyn_empieza(n, con_guion)) y str_buscar(n, \".so\", 0) >= 0) {\n                    retornar str_concatenar(str_concatenar(vec_obtener(dirs, i), \"/\"), n)\n                }\n                j = j + 1\n            }\n        }\n        i = i + 1\n    }\n    retornar 0\n}\n\nfuncion dyn_empieza(s, prefijo) {\n    si (str_largo(s) < str_largo(prefijo)) { retornar 0 }\n    retornar str_igual(str_rebanar(s, 0, str_largo(prefijo)), prefijo)\n}\n\nfuncion dyn_abrir_biblioteca(nombre) {\n    si (sys_dl_disponible() == 0) { retornar 0 }\n    sea cache = mem_global(31)\n    si (cache == 0) {\n        cache = map_nuevo()\n        mem_fijar_global(31, cache)\n    }\n    sea h = map_obtener_o(cache, nombre, 0)\n    si (h != 0) { retornar h }\n    h = sys_cargar_biblioteca(nombre)\n    si (h == 0 y str_buscar(nombre, \"/\", 0) < 0) {\n        sea base = nombre\n        si (str_buscar(nombre, \".so\", 0) >= 0) { base = str_rebanar(nombre, 0, str_buscar(nombre, \".so\", 0)) }\n        sea encontrada = buscar_biblioteca(base)\n        si (encontrada != 0) { h = sys_cargar_biblioteca(encontrada) }\n    }\n    si (h != 0) { map_fijar(cache, nombre, h) }\n    retornar h\n}\n\n// Dirección de simbolo en biblioteca; error capturable si no existe.\nfuncion dyn_extern_resolver(simbolo, biblioteca) {\n    sea h = dyn_abrir_biblioteca(biblioteca)\n    si (h == 0) {\n        sea m = str_concatenar(\"extern: no se pudo cargar la biblioteca \", biblioteca)\n        str_agregar(m, \" (para '\")\n        str_agregar(m, simbolo)\n        str_agregar(m, \"')\")\n        dyn_error(m)\n    }\n    sea p = sys_simbolo(h, simbolo)\n    si (p == 0) { dyn_simbolo_faltante(simbolo, biblioteca) }\n    retornar p\n}\n\nfuncion dyn_simbolo_faltante(simbolo, biblioteca) {\n    sea m = str_concatenar(\"extern: no se encontró el símbolo '\", simbolo)\n    str_agregar(m, \"' en \")\n    str_agregar(m, biblioteca)\n    dyn_error(m)\n    retornar 0\n}\n\n// ── Programa: argumentos, entrada y salida ────────────────────────────────\n\nfuncion argumentos_programa() {\n    sea r = vec_nuevo()\n    sea i = 1\n    mientras (i < rt_argc()) {\n        vec_agregar(r, dyn_texto(rt_argumento(i)))\n        i = i + 1\n    }\n    retornar dyn_caja(2, r)\n}\n\nfuncion argumentos() { retornar argumentos_programa() }\n\n// Lee una línea de la entrada estándar (sin el salto final); nulo al final.\nfuncion leer(mensaje) {\n    si (mensaje != 0) { rt_escribir_texto(1, dyn_a_str(mensaje)) }\n    sea r = str_nuevo(64)\n    sea b = mem_reservar(8)\n    sea leidos = 0\n    sea seguir = 1\n    mientras (seguir) {\n        sea n = sys_leer(0, b, 1)\n        si (n <= 0) {\n            seguir = 0\n        } sino {\n            leidos = leidos + 1\n            si (__cargar8(b) == 10) { seguir = 0 } sino { str_agregar_byte(r, __cargar8(b)) }\n        }\n    }\n    mem_liberar(b)\n    si (leidos == 0) { retornar 0 }\n    retornar dyn_texto(r)\n}\n\nfuncion salir(codigo) {\n    sea c = 0\n    si (__y_bits(codigo, 1) == 1) { c = dyn_valor_entero(codigo) }\n    sys_salir(c)\n    retornar 0\n}\n\nfuncion numero_a_texto(v) { retornar a_texto(v) }\nfuncion subcadena(t, inicio, fin) { retornar subtexto(t, inicio, fin) }\n\n// ── Texto (más) ───────────────────────────────────────────────────────────\n\nfuncion texto_empieza_con(t, prefijo) { retornar dyn_bool(dyn_empieza(dyn_texto_de(t, \"texto_empieza_con\"), dyn_texto_de(prefijo, \"texto_empieza_con\"))) }\n\nfuncion texto_termina_con(t, sufijo) {\n    sea s = dyn_texto_de(t, \"texto_termina_con\")\n    sea f = dyn_texto_de(sufijo, \"texto_termina_con\")\n    si (str_largo(f) > str_largo(s)) { retornar 2 }\n    retornar dyn_bool(str_igual(str_rebanar(s, str_largo(s) - str_largo(f), str_largo(s)), f))\n}\n\nfuncion texto_indice(t, buscado) {\n    retornar dyn_entero(str_buscar(dyn_texto_de(t, \"texto_indice\"), dyn_texto_de(buscado, \"texto_indice\"), 0))\n}\n\nfuncion texto_invertir(t) {\n    sea s = dyn_texto_de(t, \"texto_invertir\")\n    sea r = str_nuevo(str_largo(s))\n    sea i = str_largo(s) - 1\n    mientras (i >= 0) {\n        str_agregar_byte(r, str_byte(s, i))\n        i = i - 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion texto_repetir(t, veces) {\n    sea s = dyn_a_str(t)\n    sea r = str_nuevo(16)\n    sea i = 0\n    mientras (i < dyn_valor_entero(veces)) {\n        str_agregar(r, s)\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\nfuncion texto_a_numero(t) { retornar a_numero(t) }\n\n// ── Tiempo ────────────────────────────────────────────────────────────────\n\nfuncion tiempo_ms() { retornar dyn_entero(sys_reloj_ns() / 1000000) }\n// Segundos desde la época (Unix) con decimales.\nfuncion tiempo_actual() { retornar dyn_desde_f64(__f64_div(__f64_desde_entero(sys_reloj_ns()), __f64_desde_entero(1000000000))) }\n\nfuncion hilo_dormir(ms) {\n    sys_dormir_ms(dyn_valor_entero(ms))\n    retornar 0\n}\n\nfuncion dormir(ms) { retornar hilo_dormir(ms) }\n\n// ── Hilos, canales y mutex (clone + futex) ────────────────────────────────\n\nfuncion futex_esperar(direccion, valor, ms) { retornar futex_esperar_op(direccion, valor, ms, 128) }\n\n// op 128: FUTEX_WAIT_PRIVATE · op 0: FUTEX_WAIT (el kernel despierta el tid\n// de CLONE_CHILD_CLEARTID con un FUTEX_WAKE compartido).\nfuncion futex_esperar_op(direccion, valor, ms, op) {\n    sys_futex_esperar(direccion, valor, ms, op)\n    retornar 0\n}\n\nfuncion futex_despertar(direccion) {\n    sys_futex_despertar(direccion)\n    retornar 0\n}\n\nfuncion cerrojo_tomar(direccion) {\n    mientras (__intercambiar(direccion, 1) != 0) { futex_esperar(direccion, 1, 0 - 1) }\n    retornar 0\n}\n\nfuncion cerrojo_soltar(direccion) {\n    __guardar64(direccion, 0)\n    futex_despertar(direccion)\n    retornar 0\n}\n\n// Hilo nuevo con pila propia de 8 MiB alineada; su registro (en la base de\n// la pila): [hilo vivo][manejadores de intentar][tid].\n// La función de entrada es tarea_ejecutar(t) (runtime/lenguaje.cfv).\nfuncion dyn_hilo_lanzar(t) {\n    sea tam = 8388608\n    sea zona = sys_mapear(tam * 2)\n    si (zona < 0) { dyn_error(\"no se pudo reservar la pila del hilo\") }\n    sea base = __y_bits(zona + tam - 1, 0 - tam)\n    __guardar64(base, 1)\n    __guardar64(base + 8, 0)\n    __guardar64(base + 16, 1)\n    dyn_anotar_hilo(base)\n    si (sys_hilo_crear(base, tam, t) < 0) { dyn_error(\"no se pudo crear el hilo\") }\n    retornar dyn_entero(base)\n}\n\nfuncion dyn_hilo_inicio(t) {\n    tarea_ejecutar(t)\n    retornar 0\n}\n\n// Espera a que el hilo termine (CLONE_CHILD_CLEARTID pone el tid en 0).\n// Devuelve verdadero si terminó, falso si venció el plazo (ms, o nulo).\nfuncion dyn_hilo_esperar(base_v, limite) {\n    sea base = dyn_valor_entero(base_v)\n    sea ms = 0 - 1\n    si (__y_bits(limite, 1) == 1) { ms = dyn_valor_entero(limite) }\n    sea inicio = sys_reloj_ns() / 1000000\n    mientras (__y_bits(__cargar64(base + 16), 4294967295) != 0) {\n        si (ms >= 0) {\n            sea resta = ms - (sys_reloj_ns() / 1000000 - inicio)\n            si (resta <= 0) { retornar 2 }\n            futex_esperar_op(base + 16, __cargar64(base + 16), resta, 0)\n        } sino {\n            futex_esperar_op(base + 16, __cargar64(base + 16), 0 - 1, 0)\n        }\n    }\n    retornar 4\n}\n\n// Canal: [cerrojo][secuencia][cola][inicio][capacidad][cerrado]\nfuncion canal_nuevo(capacidad) {\n    sea r = mem_reservar(48)\n    __guardar64(r, 0)\n    __guardar64(r + 8, 0)\n    __guardar64(r + 16, vec_nuevo())\n    __guardar64(r + 24, 0)\n    sea cap = 0\n    si (__y_bits(capacidad, 1) == 1) { cap = dyn_valor_entero(capacidad) }\n    __guardar64(r + 32, cap)\n    __guardar64(r + 40, 0)\n    retornar dyn_caja(9, r)\n}\n\nfuncion canal_de(v) {\n    si (dyn_tipo(v) != 9) { dyn_error_tipo(\"se esperaba un canal\", v) }\n    retornar dyn_dato(v)\n}\n\nfuncion canal_tam_crudo(r) { retornar vec_largo(__cargar64(r + 16)) - __cargar64(r + 24) }\n\nfuncion canal_avisar(r) {\n    __guardar64(r + 8, __cargar64(r + 8) + 1)\n    cerrojo_soltar(r)\n    futex_despertar(r + 8)\n    retornar 0\n}\n\nfuncion canal_enviar(canal, v) {\n    sea r = canal_de(canal)\n    mientras (verdadero) {\n        cerrojo_tomar(r)\n        si (__cargar64(r + 40)) {\n            cerrojo_soltar(r)\n            dyn_error(\"canal_enviar: el canal está cerrado\")\n        }\n        si (__cargar64(r + 32) == 0 o canal_tam_crudo(r) < __cargar64(r + 32)) {\n            vec_agregar(__cargar64(r + 16), v)\n            canal_avisar(r)\n            retornar 0\n        }\n        sea secuencia = __cargar64(r + 8)\n        cerrojo_soltar(r)\n        futex_esperar(r + 8, secuencia, 0 - 1)\n    }\n    retornar 0\n}\n\n// Bloquea hasta recibir un valor; nulo si el canal está cerrado y vacío.\nfuncion canal_recibir(canal) {\n    sea r = canal_de(canal)\n    mientras (verdadero) {\n        cerrojo_tomar(r)\n        si (canal_tam_crudo(r) > 0) {\n            sea cola = __cargar64(r + 16)\n            sea inicio = __cargar64(r + 24)\n            sea v = vec_obtener(cola, inicio)\n            inicio = inicio + 1\n            si (inicio == vec_largo(cola)) {\n                __guardar64(cola, 0)\n                inicio = 0\n            }\n            __guardar64(r + 24, inicio)\n            canal_avisar(r)\n            retornar v\n        }\n        si (__cargar64(r + 40)) {\n            cerrojo_soltar(r)\n            retornar 0\n        }\n        sea secuencia = __cargar64(r + 8)\n        cerrojo_soltar(r)\n        futex_esperar(r + 8, secuencia, 0 - 1)\n    }\n    retornar 0\n}\n\nfuncion canal_tam(canal) {\n    sea r = canal_de(canal)\n    cerrojo_tomar(r)\n    sea n = canal_tam_crudo(r)\n    cerrojo_soltar(r)\n    retornar dyn_entero(n)\n}\n\nfuncion canal_cerrar(canal) {\n    sea r = canal_de(canal)\n    cerrojo_tomar(r)\n    __guardar64(r + 40, 1)\n    canal_avisar(r)\n    retornar 0\n}\n\n// Mutex: [estado] con futex.\nfuncion mutex_crear() {\n    sea r = mem_reservar(8)\n    __guardar64(r, 0)\n    retornar dyn_caja(10, r)\n}\n\nfuncion mutex_de(v) {\n    si (dyn_tipo(v) != 10) { dyn_error_tipo(\"se esperaba un mutex\", v) }\n    retornar dyn_dato(v)\n}\n\nfuncion mutex_bloquear(m) { cerrojo_tomar(mutex_de(m)) retornar 0 }\nfuncion mutex_desbloquear(m) { cerrojo_soltar(mutex_de(m)) retornar 0 }\nfuncion mutex_liberar(m) { retornar mutex_desbloquear(m) }\n\n// ── Servidor HTTP (socket, bind, listen, accept) ──────────────────────────\n// Servidores en la global 32: [descriptor del socket][cliente activo].\n\nfuncion http_servidores() {\n    sea v = mem_global(32)\n    si (v == 0) {\n        v = vec_nuevo()\n        mem_fijar_global(32, v)\n    }\n    retornar v\n}\n\nfuncion http_servidor(id) {\n    sea v = http_servidores()\n    sea i = dyn_valor_entero(id)\n    si (__y_bits(id, 1) != 1 o i < 0 o i >= vec_largo(v)) { dyn_error(\"servidor http: id inválido\") }\n    retornar vec_obtener(v, i)\n}\n\nfuncion servidor_http_escuchar(puerto) {\n    sea p = dyn_valor_entero(puerto)\n    si (p < 1 o p > 65535) { dyn_error(\"servidor_http_escuchar: puerto invalido\") }\n    sea fd = sys_red_escuchar(p)\n    si (fd == 0 - 1) { dyn_error(\"servidor_http_escuchar: no se pudo crear socket\") }\n    si (fd == 0 - 2) { dyn_error(str_concatenar(\"servidor_http_escuchar: no se pudo enlazar al puerto \", str_desde_entero(p))) }\n    si (fd < 0) { dyn_error(\"servidor_http_escuchar: no se pudo escuchar\") }\n    sea r = mem_reservar(16)\n    __guardar64(r, fd)\n    __guardar64(r + 8, 0 - 1)\n    sea v = http_servidores()\n    vec_agregar(v, r)\n    retornar dyn_entero(vec_largo(v) - 1)\n}\n\nfuncion http_linea_hasta(s, desde, aguja) {\n    sea p = str_buscar(s, aguja, desde)\n    si (p < 0) { retornar str_largo(s) }\n    retornar p\n}\n\nfuncion http_minusculas(s) {\n    sea r = str_nuevo(str_largo(s))\n    sea i = 0\n    mientras (i < str_largo(s)) {\n        sea b = str_byte(s, i)\n        si (b >= 65 y b <= 90) { b = b + 32 }\n        str_agregar_byte(r, b)\n        i = i + 1\n    }\n    retornar r\n}\n\n// Espera una petición y la devuelve como mapa: metodo, ruta, query,\n// cuerpo, cabeceras (en minúsculas), ip y _srv_id.\nfuncion servidor_http_solicitud(id) {\n    sea srv = http_servidor(id)\n    si (__cargar64(srv + 8) >= 0) {\n        sys_red_cerrar(__cargar64(srv + 8))\n        __guardar64(srv + 8, 0 - 1)\n    }\n    sea dir = mem_reservar(16)\n    sea largo_dir = mem_reservar(8)\n    __guardar64(largo_dir, 16)\n    sea cliente = sys_red_aceptar(__cargar64(srv), dir, largo_dir)\n    si (cliente < 0) { dyn_error(\"servidor_http_solicitud: accept fallo\") }\n    __guardar64(srv + 8, cliente)\n    sea ip = str_nuevo(16)\n    sea k = 0\n    mientras (k < 4) {\n        si (k > 0) { str_agregar_byte(ip, 46) }\n        str_agregar(ip, str_desde_entero(__cargar8(dir + 4 + k)))\n        k = k + 1\n    }\n    mem_liberar(dir)\n    mem_liberar(largo_dir)\n    // Leer cabeceras y luego el cuerpo según Content-Length.\n    sea crudo = str_nuevo(4096)\n    sea buf = mem_reservar(4096)\n    sea fin_cabeceras = 0 - 1\n    sea esperado = 0 - 1\n    sea seguir = 1\n    mientras (seguir) {\n        sea n = sys_red_leer(cliente, buf, 4096)\n        si (n <= 0) {\n            seguir = 0\n        } sino {\n            sea i = 0\n            mientras (i < n) {\n                str_agregar_byte(crudo, __cargar8(buf + i))\n                i = i + 1\n            }\n            si (fin_cabeceras < 0) {\n                fin_cabeceras = str_buscar(crudo, \"\\r\\n\\r\\n\", 0)\n                si (fin_cabeceras >= 0) {\n                    esperado = 0\n                    sea cabeceras = http_minusculas(str_rebanar(crudo, 0, fin_cabeceras))\n                    sea p = str_buscar(cabeceras, \"content-length:\", 0)\n                    si (p >= 0) {\n                        p = p + 15\n                        mientras (str_byte(cabeceras, p) == 32) { p = p + 1 }\n                        mientras (p < str_largo(cabeceras) y str_byte(cabeceras, p) >= 48 y str_byte(cabeceras, p) <= 57) {\n                            esperado = esperado * 10 + str_byte(cabeceras, p) - 48\n                            p = p + 1\n                        }\n                    }\n                }\n            }\n            si (fin_cabeceras >= 0 y str_largo(crudo) - fin_cabeceras - 4 >= esperado) { seguir = 0 }\n        }\n    }\n    mem_liberar(buf)\n    si (fin_cabeceras < 0) { fin_cabeceras = str_largo(crudo) }\n    // Línea de petición: MÉTODO RUTA PROTOCOLO\n    sea fin_linea = http_linea_hasta(crudo, 0, \"\\r\\n\")\n    sea linea = str_rebanar(crudo, 0, fin_linea)\n    sea e1 = str_buscar(linea, \" \", 0)\n    sea metodo = \"GET\"\n    sea ruta = \"/\"\n    si (e1 > 0) {\n        metodo = str_rebanar(linea, 0, e1)\n        sea e2 = str_buscar(linea, \" \", e1 + 1)\n        si (e2 < 0) { e2 = str_largo(linea) }\n        ruta = str_rebanar(linea, e1 + 1, e2)\n    }\n    sea consulta = \"\"\n    sea q = str_buscar(ruta, \"?\", 0)\n    si (q >= 0) {\n        consulta = str_rebanar(ruta, q + 1, str_largo(ruta))\n        ruta = str_rebanar(ruta, 0, q)\n    }\n    sea cabeceras = map_nuevo()\n    sea pos = fin_linea + 2\n    mientras (pos < fin_cabeceras) {\n        sea nl = http_linea_hasta(crudo, pos, \"\\r\\n\")\n        si (nl > fin_cabeceras) { nl = fin_cabeceras }\n        sea l = str_rebanar(crudo, pos, nl)\n        sea dos_puntos = str_buscar(l, \":\", 0)\n        si (dos_puntos > 0) {\n            sea valor_inicio = dos_puntos + 1\n            mientras (valor_inicio < str_largo(l) y (str_byte(l, valor_inicio) == 32 o str_byte(l, valor_inicio) == 9)) { valor_inicio = valor_inicio + 1 }\n            map_fijar(cabeceras, http_minusculas(str_rebanar(l, 0, dos_puntos)), dyn_texto(str_rebanar(l, valor_inicio, str_largo(l))))\n        }\n        pos = nl + 2\n    }\n    sea cuerpo = \"\"\n    si (fin_cabeceras + 4 <= str_largo(crudo)) { cuerpo = str_rebanar(crudo, fin_cabeceras + 4, str_largo(crudo)) }\n    sea r = map_nuevo()\n    map_fijar(r, \"metodo\", dyn_texto(metodo))\n    map_fijar(r, \"ruta\", dyn_texto(ruta))\n    map_fijar(r, \"query\", dyn_texto(consulta))\n    map_fijar(r, \"cuerpo\", dyn_texto(cuerpo))\n    map_fijar(r, \"cabeceras\", dyn_caja(3, cabeceras))\n    map_fijar(r, \"ip\", dyn_texto(ip))\n    map_fijar(r, \"_srv_id\", id)\n    retornar dyn_caja(3, r)\n}\n\nfuncion http_texto_estado(estado) {\n    si (estado == 201) { retornar \"Created\" }\n    si (estado == 204) { retornar \"No Content\" }\n    si (estado == 400) { retornar \"Bad Request\" }\n    si (estado == 401) { retornar \"Unauthorized\" }\n    si (estado == 403) { retornar \"Forbidden\" }\n    si (estado == 404) { retornar \"Not Found\" }\n    si (estado == 405) { retornar \"Method Not Allowed\" }\n    si (estado == 422) { retornar \"Unprocessable Entity\" }\n    si (estado == 500) { retornar \"Internal Server Error\" }\n    retornar \"OK\"\n}\n\nfuncion servidor_http_responder(id, estado, cuerpo, tipo) {\n    sea srv = http_servidor(id)\n    sea cliente = __cargar64(srv + 8)\n    si (cliente < 0) { dyn_error(\"servidor_http_responder: sin cliente activo\") }\n    sea e = dyn_valor_entero(estado)\n    sea c = dyn_a_str(cuerpo)\n    sea t = \"text/plain; charset=utf-8\"\n    si (dyn_tipo(tipo) == 1) { t = dyn_dato(tipo) }\n    sea r = str_nuevo(str_largo(c) + 256)\n    str_agregar(r, \"HTTP/1.1 \")\n    str_agregar(r, str_desde_entero(e))\n    str_agregar_byte(r, 32)\n    str_agregar(r, http_texto_estado(e))\n    str_agregar(r, \"\\r\\nContent-Type: \")\n    str_agregar(r, t)\n    str_agregar(r, \"\\r\\nContent-Length: \")\n    str_agregar(r, str_desde_entero(str_largo(c)))\n    str_agregar(r, \"\\r\\nConnection: close\\r\\nAccess-Control-Allow-Origin: *\\r\\n\\r\\n\")\n    str_agregar(r, c)\n    sea enviado = 0\n    mientras (enviado < str_largo(r)) {\n        sea n = sys_red_escribir(cliente, str_datos(r) + enviado, str_largo(r) - enviado)\n        si (n <= 0) { enviado = str_largo(r) } sino { enviado = enviado + n }\n    }\n    sys_red_cerrar(cliente)\n    __guardar64(srv + 8, 0 - 1)\n    retornar 0\n}\n\nfuncion servidor_http_cerrar(id) {\n    sea srv = http_servidor(id)\n    si (__cargar64(srv + 8) >= 0) { sys_red_cerrar(__cargar64(srv + 8)) }\n    sys_red_cerrar(__cargar64(srv))\n    retornar 0\n}\n\n// ── Memoria C para bibliotecas externas (estructuras, búferes) ────────────\nfuncion c_reservar(bytes) {\n    sea n = dyn_valor_entero(bytes)\n    sea p = mem_reservar(n)\n    mem_llenar(p, 0, n)\n    retornar dyn_entero(p)\n}\nfuncion c_liberar(p) { mem_liberar(dyn_valor_entero(p)) retornar 0 }\nfuncion c_escribir32(p, desplazamiento, v) {\n    sea d = dyn_valor_entero(p) + dyn_valor_entero(desplazamiento)\n    sea x = dyn_entero_c(v)\n    __guardar8(d, __y_bits(x, 255))\n    __guardar8(d + 1, __y_bits(__desplazar_der(x, 8), 255))\n    __guardar8(d + 2, __y_bits(__desplazar_der(x, 16), 255))\n    __guardar8(d + 3, __y_bits(__desplazar_der(x, 24), 255))\n    retornar 0\n}\nfuncion c_leer32(p, desplazamiento) {\n    sea d = dyn_valor_entero(p) + dyn_valor_entero(desplazamiento)\n    sea x = __cargar8(d) + __cargar8(d + 1) * 256 + __cargar8(d + 2) * 65536 + __cargar8(d + 3) * 16777216\n    si (x >= 2147483648) { x = x - 4294967296 }\n    retornar dyn_entero(x)\n}\n// Texto del lenguaje a partir de una cadena C (terminada en 0) en p.\nfuncion c_texto(p) { retornar dyn_texto(str_desde_c(dyn_entero_c(p))) }\nfuncion c_leer8(p, desplazamiento) {\n    retornar dyn_entero(__cargar8(dyn_valor_entero(p) + dyn_valor_entero(desplazamiento)))\n}\n" }
    si (i == 16) { retornar "// runtime/lenguaje.cfv — funciones del lenguaje escritas en C-Forge completo.\n//\n// Se compila en modo \"lenguaje\" (--lenguaje): es código dinámico normal,\n// pero un programa puede redefinir cualquiera de estas funciones.\n\n// Tareas: cada una corre en un hilo nativo (clone) con su propia pila.\n// esperar(t[, ms]) espera a que termine y devuelve su resultado; si la tarea\n// lanzó un error, esperar lo vuelve a lanzar.\nfuncion tarea(f) {\n    // Todas las claves existen antes de lanzar el hilo: después solo se\n    // reemplazan valores (sin modificar la estructura del mapa en paralelo).\n    sea t = {\"__tarea\": verdadero, \"f\": f, \"resultado\": nulo, \"error\": nulo, \"fallo\": falso, \"hilo\": nulo}\n    t[\"hilo\"] = dyn_hilo_lanzar(t)\n    retornar t\n}\n\nfuncion tarea_ejecutar(t) {\n    intentar {\n        t[\"resultado\"] = t[\"f\"]()\n    } capturar (e) {\n        t[\"error\"] = e\n        t[\"fallo\"] = verdadero\n    }\n}\n\nfuncion esperar(t, limite_ms) {\n    si (no dyn_hilo_esperar(t[\"hilo\"], limite_ms)) { lanzar \"esperar: la tarea no terminó en \" + limite_ms + \" ms\" }\n    si (t[\"fallo\"]) { lanzar t[\"error\"] }\n    retornar t[\"resultado\"]\n}\n\nfuncion hilo(f) { retornar tarea(f) }\n\n// paralelo(f, lista): f(x) para cada elemento, repartido en 8 hilos; los\n// resultados quedan en el orden de la lista.\nfuncion paralelo(f, elementos) {\n    si (tipo_de(f) == \"texto\") { lanzar \"paralelo: pasa la función (paralelo(f, lista)), no su nombre\" }\n    sea n = longitud(elementos)\n    sea resultados = []\n    sea i = 0\n    mientras (i < n) {\n        agregar(resultados, nulo)\n        i = i + 1\n    }\n    sea grupos = 8\n    sea tareas = []\n    sea g = 0\n    mientras (g < grupos) {\n        sea primero = g\n        agregar(tareas, tarea(funcion() {\n            sea k = primero\n            mientras (k < n) {\n                resultados[k] = f(elementos[k])\n                k = k + grupos\n            }\n            retornar nulo\n        }))\n        g = g + 1\n    }\n    para t en tareas { esperar(t) }\n    retornar resultados\n}\n\nfuncion mapear(lista, f) {\n    sea r = []\n    para x en lista { r.agregar(f(x)) }\n    retornar r\n}\n\nfuncion filtrar(lista, f) {\n    sea r = []\n    para x en lista {\n        si (f(x)) { r.agregar(x) }\n    }\n    retornar r\n}\n\nfuncion reducir(lista, f, inicial) {\n    sea acumulado = inicial\n    para x en lista { acumulado = f(acumulado, x) }\n    retornar acumulado\n}\n\n// ── JSON ──────────────────────────────────────────────────────────────────\n\nfuncion json_escapar(t) {\n    sea r = \"\\\"\"\n    sea i = 0\n    mientras (i < longitud(t)) {\n        sea b = byte_en(t, i)\n        si (b == 34) { r = r + \"\\\\\\\"\" }\n        sino si (b == 92) { r = r + \"\\\\\\\\\" }\n        sino si (b == 10) { r = r + \"\\\\n\" }\n        sino si (b == 13) { r = r + \"\\\\r\" }\n        sino si (b == 9) { r = r + \"\\\\t\" }\n        sino si (b < 32) { r = r + \"\\\\u00\" + cfv_hex2(b) }\n        sino { r = r + t[i] }\n        i = i + 1\n    }\n    retornar r + \"\\\"\"\n}\n\nfuncion cfv_hex2(n) {\n    sea digitos = \"0123456789abcdef\"\n    retornar digitos[piso(n / 16)] + digitos[n % 16]\n}\n\nfuncion cfv_json_serializar(v) {\n    sea tipo = tipo_de(v)\n    si (tipo == \"nulo\") { retornar \"null\" }\n    si (tipo == \"booleano\") { si (v) { retornar \"true\" } retornar \"false\" }\n    si (tipo == \"numero\") { retornar a_texto(v) }\n    si (tipo == \"texto\") { retornar json_escapar(v) }\n    si (tipo == \"lista\") {\n        sea partes = []\n        para x en v { partes.agregar(cfv_json_serializar(x)) }\n        retornar \"[\" + texto_unir(partes, \",\") + \"]\"\n    }\n    si (tipo == \"mapa\") {\n        sea partes = []\n        para k en claves(v) { partes.agregar(json_escapar(k) + \":\" + cfv_json_serializar(v[k])) }\n        retornar \"\\{\" + texto_unir(partes, \",\") + \"\\}\"\n    }\n    lanzar \"json_serializar: valor no serializable\"\n}\n\nfuncion json_texto(v) { retornar cfv_json_serializar(v) }\n\nfuncion cfv_json_bonito_con(v, sangria) {\n    sea tipo = tipo_de(v)\n    sea interior = sangria + \"  \"\n    si (tipo == \"lista\") {\n        si (longitud(v) == 0) { retornar \"[]\" }\n        sea partes = []\n        para x en v { partes.agregar(interior + cfv_json_bonito_con(x, interior)) }\n        retornar \"[\\n\" + texto_unir(partes, \",\\n\") + \"\\n\" + sangria + \"]\"\n    }\n    si (tipo == \"mapa\") {\n        si (longitud(v) == 0) { retornar \"\\{\\}\" }\n        sea partes = []\n        para k en claves(v) { partes.agregar(interior + json_escapar(k) + \": \" + cfv_json_bonito_con(v[k], interior)) }\n        retornar \"\\{\\n\" + texto_unir(partes, \",\\n\") + \"\\n\" + sangria + \"\\}\"\n    }\n    retornar cfv_json_serializar(v)\n}\n\nfuncion cfv_json_bonito(v) { retornar cfv_json_bonito_con(v, \"\") }\n\nfuncion json_error(estado) {\n    lanzar \"json_parsear: token inválido en la posición \" + estado[\"i\"]\n}\n\nfuncion json_espacios(estado) {\n    sea s = estado[\"s\"]\n    mientras (estado[\"i\"] < longitud(s)) {\n        sea b = byte_en(s, estado[\"i\"])\n        si (b == 32 o b == 9 o b == 10 o b == 13) { estado[\"i\"] += 1 } sino { retornar nulo }\n    }\n}\n\nfuncion json_esperar(estado, texto) {\n    sea s = estado[\"s\"]\n    si (subtexto(s, estado[\"i\"], estado[\"i\"] + longitud(texto)) != texto) { json_error(estado) }\n    estado[\"i\"] += longitud(texto)\n}\n\nfuncion json_texto_crudo(estado) {\n    sea s = estado[\"s\"]\n    estado[\"i\"] += 1\n    sea r = \"\"\n    mientras (verdadero) {\n        si (estado[\"i\"] >= longitud(s)) { json_error(estado) }\n        sea b = byte_en(s, estado[\"i\"])\n        si (b == 34) {\n            estado[\"i\"] += 1\n            retornar r\n        }\n        si (b == 92) {\n            sea e = s[estado[\"i\"] + 1]\n            estado[\"i\"] += 2\n            si (e == \"n\") { r = r + \"\\n\" }\n            sino si (e == \"t\") { r = r + \"\\t\" }\n            sino si (e == \"r\") { r = r + \"\\r\" }\n            sino si (e == \"b\") { r = r + caracter(8) }\n            sino si (e == \"f\") { r = r + caracter(12) }\n            sino si (e == \"u\") {\n                sea codigo = 0\n                para d en subtexto(s, estado[\"i\"], estado[\"i\"] + 4) {\n                    sea v = byte_en(d, 0)\n                    si (v >= 97) { v = v - 87 } sino si (v >= 65) { v = v - 55 } sino { v = v - 48 }\n                    codigo = codigo * 16 + v\n                }\n                estado[\"i\"] += 4\n                r = r + caracter(codigo)\n            }\n            sino { r = r + e }\n        } sino {\n            r = r + s[estado[\"i\"]]\n            estado[\"i\"] += 1\n        }\n    }\n}\n\nfuncion json_numero(estado) {\n    sea s = estado[\"s\"]\n    sea inicio = estado[\"i\"]\n    mientras (estado[\"i\"] < longitud(s) y contiene(\"+-0123456789.\", s[estado[\"i\"]])) { estado[\"i\"] += 1 }\n    sea base = a_numero(subtexto(s, inicio, estado[\"i\"]))\n    si (estado[\"i\"] < longitud(s) y (s[estado[\"i\"]] == \"e\" o s[estado[\"i\"]] == \"E\")) {\n        estado[\"i\"] += 1\n        sea inicio_exp = estado[\"i\"]\n        mientras (estado[\"i\"] < longitud(s) y contiene(\"+-0123456789\", s[estado[\"i\"]])) { estado[\"i\"] += 1 }\n        sea exponente = subtexto(s, inicio_exp, estado[\"i\"])\n        si (exponente[0] == \"+\") { exponente = subtexto(exponente, 1, longitud(exponente)) }\n        retornar base * potencia(10, a_numero(exponente))\n    }\n    retornar base\n}\n\nfuncion json_valor(estado) {\n    json_espacios(estado)\n    sea s = estado[\"s\"]\n    si (estado[\"i\"] >= longitud(s)) { json_error(estado) }\n    sea c = s[estado[\"i\"]]\n    si (c == \"\\{\") {\n        estado[\"i\"] += 1\n        sea m = {}\n        json_espacios(estado)\n        si (s[estado[\"i\"]] == \"\\}\") {\n            estado[\"i\"] += 1\n            retornar m\n        }\n        mientras (verdadero) {\n            json_espacios(estado)\n            si (estado[\"i\"] >= longitud(s) o s[estado[\"i\"]] != \"\\\"\") { json_error(estado) }\n            sea clave = json_texto_crudo(estado)\n            json_espacios(estado)\n            json_esperar(estado, \":\")\n            m[clave] = json_valor(estado)\n            json_espacios(estado)\n            si (estado[\"i\"] < longitud(s) y s[estado[\"i\"]] == \",\") {\n                estado[\"i\"] += 1\n            } sino {\n                json_esperar(estado, \"\\}\")\n                retornar m\n            }\n        }\n    }\n    si (c == \"[\") {\n        estado[\"i\"] += 1\n        sea l = []\n        json_espacios(estado)\n        si (s[estado[\"i\"]] == \"]\") {\n            estado[\"i\"] += 1\n            retornar l\n        }\n        mientras (verdadero) {\n            l.agregar(json_valor(estado))\n            json_espacios(estado)\n            si (estado[\"i\"] < longitud(s) y s[estado[\"i\"]] == \",\") {\n                estado[\"i\"] += 1\n            } sino {\n                json_esperar(estado, \"]\")\n                retornar l\n            }\n        }\n    }\n    si (c == \"\\\"\") { retornar json_texto_crudo(estado) }\n    si (c == \"t\") { json_esperar(estado, \"true\") retornar verdadero }\n    si (c == \"f\") { json_esperar(estado, \"false\") retornar falso }\n    si (c == \"n\") { json_esperar(estado, \"null\") retornar nulo }\n    si (contiene(\"-0123456789\", c)) { retornar json_numero(estado) }\n    json_error(estado)\n}\n\nfuncion cfv_json_parsear(texto) {\n    sea estado = {\"s\": texto, \"i\": 0}\n    sea v = json_valor(estado)\n    json_espacios(estado)\n    si (estado[\"i\"] != longitud(texto)) { json_error(estado) }\n    retornar v\n}\n\n// ── Expresiones regulares (retroceso) ─────────────────────────────────────\n// Soporta: literales, ., [..], [^..], rangos, \\d \\w \\s \\D \\W \\S, ^, $,\n// grupos (..), alternativas |, y cuantificadores * + ? {m}, {m,}, {m,n}.\n\nfuncion re_clase_escape(e) {\n    si (e == \"d\") { retornar {\"t\": \"set\", \"neg\": falso, \"rangos\": [[48, 57]]} }\n    si (e == \"D\") { retornar {\"t\": \"set\", \"neg\": verdadero, \"rangos\": [[48, 57]]} }\n    si (e == \"w\") { retornar {\"t\": \"set\", \"neg\": falso, \"rangos\": [[48, 57], [65, 90], [97, 122], [95, 95]]} }\n    si (e == \"W\") { retornar {\"t\": \"set\", \"neg\": verdadero, \"rangos\": [[48, 57], [65, 90], [97, 122], [95, 95]]} }\n    si (e == \"s\") { retornar {\"t\": \"set\", \"neg\": falso, \"rangos\": [[32, 32], [9, 10], [13, 13], [12, 12], [11, 11]]} }\n    si (e == \"S\") { retornar {\"t\": \"set\", \"neg\": verdadero, \"rangos\": [[32, 32], [9, 10], [13, 13], [12, 12], [11, 11]]} }\n    retornar nulo\n}\n\nfuncion re_codigo_escape(e) {\n    si (e == \"n\") { retornar 10 }\n    si (e == \"t\") { retornar 9 }\n    si (e == \"r\") { retornar 13 }\n    retornar byte_en(e, 0)\n}\n\nfuncion re_numero(estado) {\n    sea p = estado[\"p\"]\n    sea n = 0\n    sea hay = falso\n    mientras (estado[\"i\"] < longitud(p) y contiene(\"0123456789\", p[estado[\"i\"]])) {\n        n = n * 10 + byte_en(p, estado[\"i\"]) - 48\n        estado[\"i\"] += 1\n        hay = verdadero\n    }\n    si (no hay) { retornar nulo }\n    retornar n\n}\n\nfuncion re_conjunto(estado) {\n    sea p = estado[\"p\"]\n    estado[\"i\"] += 1\n    sea nodo = {\"t\": \"set\", \"neg\": falso, \"rangos\": []}\n    si (estado[\"i\"] < longitud(p) y p[estado[\"i\"]] == \"^\") {\n        nodo[\"neg\"] = verdadero\n        estado[\"i\"] += 1\n    }\n    sea primero = verdadero\n    mientras (estado[\"i\"] < longitud(p) y (p[estado[\"i\"]] != \"]\" o primero)) {\n        primero = falso\n        sea desde = byte_en(p, estado[\"i\"])\n        si (p[estado[\"i\"]] == \"\\\\\") {\n            sea e = p[estado[\"i\"] + 1]\n            estado[\"i\"] += 2\n            sea clase = re_clase_escape(e)\n            si (clase != nulo y no clase[\"neg\"]) {\n                para r en clase[\"rangos\"] { nodo[\"rangos\"].agregar(r) }\n                continuar\n            }\n            desde = re_codigo_escape(e)\n        } sino {\n            estado[\"i\"] += 1\n        }\n        sea hasta = desde\n        si (estado[\"i\"] + 1 < longitud(p) y p[estado[\"i\"]] == \"-\" y p[estado[\"i\"] + 1] != \"]\") {\n            hasta = byte_en(p, estado[\"i\"] + 1)\n            estado[\"i\"] += 2\n        }\n        nodo[\"rangos\"].agregar([desde, hasta])\n    }\n    si (estado[\"i\"] >= longitud(p)) { lanzar \"regex: falta ']'\" }\n    estado[\"i\"] += 1\n    retornar nodo\n}\n\nfuncion re_atomo(estado) {\n    sea p = estado[\"p\"]\n    sea c = p[estado[\"i\"]]\n    si (c == \"(\") {\n        estado[\"i\"] += 1\n        si (subtexto(p, estado[\"i\"], estado[\"i\"] + 2) == \"?:\") { estado[\"i\"] += 2 }\n        sea alt = re_alternativas(estado)\n        si (estado[\"i\"] >= longitud(p) o p[estado[\"i\"]] != \")\") { lanzar \"regex: falta ')'\" }\n        estado[\"i\"] += 1\n        retornar {\"t\": \"grupo\", \"alt\": alt}\n    }\n    si (c == \"[\") { retornar re_conjunto(estado) }\n    estado[\"i\"] += 1\n    si (c == \".\") { retornar {\"t\": \"any\"} }\n    si (c == \"^\") { retornar {\"t\": \"bol\"} }\n    si (c == \"$\") { retornar {\"t\": \"eol\"} }\n    si (c == \"\\\\\") {\n        sea e = p[estado[\"i\"]]\n        estado[\"i\"] += 1\n        sea clase = re_clase_escape(e)\n        si (clase != nulo) { retornar clase }\n        retornar {\"t\": \"char\", \"c\": re_codigo_escape(e)}\n    }\n    retornar {\"t\": \"char\", \"c\": byte_en(c, 0)}\n}\n\nfuncion re_secuencia(estado) {\n    sea p = estado[\"p\"]\n    sea items = []\n    mientras (estado[\"i\"] < longitud(p) y p[estado[\"i\"]] != \"|\" y p[estado[\"i\"]] != \")\") {\n        sea nodo = re_atomo(estado)\n        nodo[\"min\"] = 1\n        nodo[\"max\"] = 1\n        si (estado[\"i\"] < longitud(p)) {\n            sea q = p[estado[\"i\"]]\n            si (q == \"*\") { nodo[\"min\"] = 0  nodo[\"max\"] = -1  estado[\"i\"] += 1 }\n            sino si (q == \"+\") { nodo[\"max\"] = -1  estado[\"i\"] += 1 }\n            sino si (q == \"?\") { nodo[\"min\"] = 0  estado[\"i\"] += 1 }\n            sino si (q == \"\\{\") {\n                estado[\"i\"] += 1\n                sea m = re_numero(estado)\n                nodo[\"min\"] = m\n                nodo[\"max\"] = m\n                si (p[estado[\"i\"]] == \",\") {\n                    estado[\"i\"] += 1\n                    sea n = re_numero(estado)\n                    si (n == nulo) { nodo[\"max\"] = -1 } sino { nodo[\"max\"] = n }\n                }\n                si (p[estado[\"i\"]] != \"\\}\") { lanzar \"regex: cuantificador inválido\" }\n                estado[\"i\"] += 1\n            }\n            si (estado[\"i\"] < longitud(p) y p[estado[\"i\"]] == \"?\") { estado[\"i\"] += 1 }\n        }\n        items.agregar(nodo)\n    }\n    retornar items\n}\n\nfuncion re_alternativas(estado) {\n    sea opciones = [re_secuencia(estado)]\n    mientras (estado[\"i\"] < longitud(estado[\"p\"]) y estado[\"p\"][estado[\"i\"]] == \"|\") {\n        estado[\"i\"] += 1\n        opciones.agregar(re_secuencia(estado))\n    }\n    retornar opciones\n}\n\nfuncion re_compilar(patron) {\n    sea estado = {\"p\": patron, \"i\": 0}\n    sea alt = re_alternativas(estado)\n    si (estado[\"i\"] != longitud(patron)) { lanzar \"regex: ')' sin abrir\" }\n    retornar alt\n}\n\nfuncion re_en_conjunto(nodo, b) {\n    sea dentro = falso\n    para r en nodo[\"rangos\"] {\n        si (b >= r[0] y b <= r[1]) { dentro = verdadero }\n    }\n    si (nodo[\"neg\"]) { retornar no dentro }\n    retornar dentro\n}\n\n// Una repetición del nodo desde pos: posición final o -1.\nfuncion re_uno(nodo, s, pos) {\n    sea t = nodo[\"t\"]\n    si (t == \"char\") {\n        si (pos < longitud(s) y byte_en(s, pos) == nodo[\"c\"]) { retornar pos + 1 }\n        retornar -1\n    }\n    si (t == \"any\") {\n        si (pos < longitud(s) y byte_en(s, pos) != 10) { retornar pos + 1 }\n        retornar -1\n    }\n    si (t == \"set\") {\n        si (pos < longitud(s) y re_en_conjunto(nodo, byte_en(s, pos))) { retornar pos + 1 }\n        retornar -1\n    }\n    si (t == \"bol\") { si (pos == 0) { retornar pos } retornar -1 }\n    si (t == \"eol\") { si (pos == longitud(s)) { retornar pos } retornar -1 }\n    retornar re_alt(nodo[\"alt\"], s, pos, funcion(x) { retornar x })\n}\n\nfuncion re_seq(items, k, s, pos, cont) {\n    si (k == longitud(items)) { retornar cont(pos) }\n    sea nodo = items[k]\n    sea posiciones = [pos]\n    sea ultima = pos\n    sea cuenta = 0\n    mientras (nodo[\"max\"] < 0 o cuenta < nodo[\"max\"]) {\n        sea siguiente = re_uno(nodo, s, ultima)\n        si (siguiente < 0 o (siguiente == ultima y cuenta >= nodo[\"min\"])) { romper }\n        posiciones.agregar(siguiente)\n        ultima = siguiente\n        cuenta += 1\n    }\n    sea i = longitud(posiciones) - 1\n    mientras (i >= nodo[\"min\"]) {\n        sea r = re_seq(items, k + 1, s, posiciones[i], cont)\n        si (r >= 0) { retornar r }\n        i -= 1\n    }\n    retornar -1\n}\n\nfuncion re_alt(opciones, s, pos, cont) {\n    para items en opciones {\n        sea r = re_seq(items, 0, s, pos, cont)\n        si (r >= 0) { retornar r }\n    }\n    retornar -1\n}\n\n// Primera coincidencia desde inicio: [comienzo, fin] o nulo.\nfuncion re_buscar_desde(alt, s, inicio) {\n    sea i = inicio\n    mientras (i <= longitud(s)) {\n        sea fin = re_alt(alt, s, i, funcion(x) { retornar x })\n        si (fin >= 0) { retornar [i, fin] }\n        i += 1\n    }\n    retornar nulo\n}\n\nfuncion re_todas(alt, s) {\n    sea r = []\n    sea i = 0\n    mientras (i <= longitud(s)) {\n        sea m = re_buscar_desde(alt, s, i)\n        si (m == nulo) { romper }\n        r.agregar(m)\n        si (m[1] > m[0]) { i = m[1] } sino { i = m[0] + 1 }\n    }\n    retornar r\n}\n\nfuncion cfv_regex_coincidir(patron, texto) {\n    retornar re_buscar_desde(re_compilar(patron), texto, 0) != nulo\n}\n\nfuncion cfv_regex_buscar(patron, texto) {\n    sea m = re_buscar_desde(re_compilar(patron), texto, 0)\n    si (m == nulo) { retornar nulo }\n    retornar subtexto(texto, m[0], m[1])\n}\n\nfuncion cfv_regex_buscar_todos(patron, texto) {\n    sea r = []\n    para m en re_todas(re_compilar(patron), texto) { r.agregar(subtexto(texto, m[0], m[1])) }\n    retornar r\n}\n\nfuncion cfv_regex_reemplazar(patron, texto, reemplazo) {\n    sea r = \"\"\n    sea ultimo = 0\n    para m en re_todas(re_compilar(patron), texto) {\n        r = r + subtexto(texto, ultimo, m[0]) + reemplazo\n        ultimo = m[1]\n    }\n    retornar r + subtexto(texto, ultimo, longitud(texto))\n}\n\nfuncion cfv_regex_dividir(patron, texto) {\n    sea r = []\n    sea ultimo = 0\n    para m en re_todas(re_compilar(patron), texto) {\n        si (m[1] > m[0]) {\n            r.agregar(subtexto(texto, ultimo, m[0]))\n            ultimo = m[1]\n        }\n    }\n    r.agregar(subtexto(texto, ultimo, longitud(texto)))\n    retornar r\n}\n\n// ── Ordenamiento (mergesort estable) ──────────────────────────────────────\n// comparar(a, b) < 0 si a va antes que b; sin función se usa el orden natural.\n\nfuncion ordenar(lista, comparar) {\n    si (longitud(lista) <= 1) { retornar lista_invertir(lista_invertir(lista)) }\n    sea medio = piso(longitud(lista) / 2)\n    sea izquierda = []\n    sea derecha = []\n    sea i = 0\n    para x en lista {\n        si (i < medio) { izquierda.agregar(x) } sino { derecha.agregar(x) }\n        i += 1\n    }\n    izquierda = ordenar(izquierda, comparar)\n    derecha = ordenar(derecha, comparar)\n    sea r = []\n    sea a = 0\n    sea b = 0\n    mientras (a < longitud(izquierda) o b < longitud(derecha)) {\n        sea tomar_izquierda = b >= longitud(derecha)\n        si (a < longitud(izquierda) y b < longitud(derecha)) {\n            si (comparar == nulo) {\n                tomar_izquierda = no (derecha[b] < izquierda[a])\n            } sino {\n                tomar_izquierda = comparar(izquierda[a], derecha[b]) <= 0\n            }\n        }\n        si (tomar_izquierda) {\n            r.agregar(izquierda[a])\n            a += 1\n        } sino {\n            r.agregar(derecha[b])\n            b += 1\n        }\n    }\n    retornar r\n}\n\nfuncion lista_ordenar(lista) { retornar ordenar(lista, nulo) }\n\nfuncion lista_aplanar(lista) {\n    sea r = []\n    para x en lista {\n        si (tipo_de(x) == \"lista\") {\n            para y en lista_aplanar(x) { r.agregar(y) }\n        } sino {\n            r.agregar(x)\n        }\n    }\n    retornar r\n}\n\nfuncion para_cada(lista, f) {\n    para x en lista { f(x) }\n}\n\n// rango(fin) · rango(inicio, fin) · rango(inicio, fin, paso)\nfuncion rango(a, b, paso) {\n    si (b == nulo) {\n        b = a\n        a = 0\n    }\n    si (paso == nulo) { paso = 1 }\n    sea r = []\n    sea i = a\n    si (paso > 0) {\n        mientras (i < b) {\n            r.agregar(i)\n            i += paso\n        }\n    } sino {\n        mientras (i > b) {\n            r.agregar(i)\n            i += paso\n        }\n    }\n    retornar r\n}\n" }
    si (i == 17) { retornar "// runtime/sdl.cfv — gráficos con SDL2, escritos en C-Forge sobre extern.\n//\n// Mismas funciones que el intérprete (sdl_init, sdl_ventana, sdl_renderer,\n// sdl_color, sdl_rect, …). SDL2 se carga con dlopen al primer uso; cforge\n// incluye este módulo solo si el programa usa funciones sdl_.\n\n// Las declaraciones se registran al compilar y cada función se resuelve\n// (dlopen + dlsym) la primera vez que se llama.\nfuncion __sdl_declaraciones() {\n    extern \"SDL2\" funcion SDL_Init(banderas: entero): entero\n    extern \"SDL2\" funcion SDL_CreateWindow(titulo: texto, x: entero, y: entero, ancho: entero, alto: entero, banderas: entero): puntero\n    extern \"SDL2\" funcion SDL_CreateRenderer(ventana: puntero, indice: entero, banderas: entero): puntero\n    extern \"SDL2\" funcion SDL_SetRenderDrawColor(ren: puntero, r: entero, g: entero, b: entero, a: entero): entero\n    extern \"SDL2\" funcion SDL_RenderClear(ren: puntero): entero\n    extern \"SDL2\" funcion SDL_RenderPresent(ren: puntero): nulo\n    extern \"SDL2\" funcion SDL_RenderFillRect(ren: puntero, rect: puntero): entero\n    extern \"SDL2\" funcion SDL_RenderDrawRect(ren: puntero, rect: puntero): entero\n    extern \"SDL2\" funcion SDL_RenderDrawLine(ren: puntero, x1: entero, y1: entero, x2: entero, y2: entero): entero\n    extern \"SDL2\" funcion SDL_RenderDrawPoint(ren: puntero, x: entero, y: entero): entero\n    extern \"SDL2\" funcion SDL_PollEvent(evento: puntero): entero\n    extern \"SDL2\" funcion SDL_GetTicks(): entero\n    extern \"SDL2\" funcion SDL_Delay(ms: entero): nulo\n    extern \"SDL2\" funcion SDL_SetWindowTitle(ventana: puntero, titulo: texto): nulo\n    extern \"SDL2\" funcion SDL_DestroyRenderer(ren: puntero): nulo\n    extern \"SDL2\" funcion SDL_DestroyWindow(ventana: puntero): nulo\n    extern \"SDL2\" funcion SDL_Quit(): nulo\n    extern \"SDL2_ttf\" funcion TTF_RenderUTF8_Blended(fuente: puntero, texto: texto, color: entero): puntero\n    extern \"SDL2\" funcion SDL_CreateTextureFromSurface(ren: puntero, superficie: puntero): puntero\n    extern \"SDL2\" funcion SDL_FreeSurface(superficie: puntero): nulo\n    extern \"SDL2\" funcion SDL_QueryTexture(textura: puntero, formato: puntero, acceso: puntero, ancho: puntero, alto: puntero): entero\n    extern \"SDL2\" funcion SDL_RenderCopy(ren: puntero, textura: puntero, origen: puntero, destino: puntero): entero\n    extern \"SDL2\" funcion SDL_DestroyTexture(textura: puntero): nulo\n}\n\n// Estado creado al primer uso (el módulo se agrega después del programa).\nsea __sdl = nulo\n\nfuncion __sdl_estado() {\n    si (__sdl == nulo) { __sdl = {\"ventanas\": [], \"renderers\": [], \"fuentes\": [], \"rect\": nulo, \"evento\": nulo, \"ttf\": nulo} }\n    retornar __sdl\n}\n\nfuncion __sdl_rect(x, y, ancho, alto) {\n    sea estado = __sdl_estado()\n    si (estado[\"rect\"] == nulo) { estado[\"rect\"] = c_reservar(16) }\n    sea r = __sdl_estado()[\"rect\"]\n    c_escribir32(r, 0, piso(x))\n    c_escribir32(r, 4, piso(y))\n    c_escribir32(r, 8, piso(ancho))\n    c_escribir32(r, 12, piso(alto))\n    retornar r\n}\n\nfuncion sdl_disponible() {\n    intentar {\n        SDL_GetTicks()\n        retornar verdadero\n    } capturar (e) {\n        retornar falso\n    }\n}\n\nfuncion sdl_init(banderas) {\n    intentar {\n        SDL_GetTicks()\n    } capturar (e) {\n        lanzar \"sdl_init: SDL2 no encontrado. Instala libSDL2.\"\n    }\n    si (banderas == nulo) { banderas = 48 }                    // VIDEO | AUDIO\n    si (SDL_Init(banderas) != 0) { lanzar \"sdl_init: fallo al inicializar SDL2\" }\n    retornar verdadero\n}\n\nfuncion sdl_iniciar(banderas) { retornar sdl_init(banderas) }\n\nfuncion sdl_ventana(titulo, ancho, alto, banderas) {\n    si (tipo_de(titulo) != \"texto\") { titulo = \"C-Forge\" }\n    si (ancho == nulo) { ancho = 800 }\n    si (alto == nulo) { alto = 600 }\n    si (banderas == nulo) { banderas = 4 }                     // SHOWN\n    sea v = SDL_CreateWindow(titulo, 536805376, 536805376, piso(ancho), piso(alto), banderas)\n    si (v == 0) { lanzar \"sdl_ventana: no se pudo crear la ventana\" }\n    __sdl_estado()[\"ventanas\"].agregar(v)\n    retornar v\n}\n\nfuncion sdl_renderer(ventana) {\n    sea r = SDL_CreateRenderer(ventana, -1, 6)                 // ACCELERATED | PRESENTVSYNC\n    si (r == 0) { r = SDL_CreateRenderer(ventana, -1, 0) }\n    si (r == 0) { lanzar \"sdl_renderer: no se pudo crear renderer\" }\n    __sdl_estado()[\"renderers\"].agregar(r)\n    retornar r\n}\n\nfuncion sdl_color(ren, r, g, b, a) {\n    SDL_SetRenderDrawColor(ren, piso(r ?? 255), piso(g ?? 255), piso(b ?? 255), piso(a ?? 255))\n}\n\nfuncion sdl_limpiar(ren) { SDL_RenderClear(ren) }\nfuncion sdl_presentar(ren) { SDL_RenderPresent(ren) }\nfuncion sdl_mostrar(ren) { SDL_RenderPresent(ren) }\n\nfuncion sdl_rect(ren, x, y, ancho, alto, relleno) {\n    sea r = __sdl_rect(x, y, ancho, alto)\n    si (relleno == falso) { SDL_RenderDrawRect(ren, r) } sino { SDL_RenderFillRect(ren, r) }\n}\n\nfuncion sdl_dibujar_rect(ren, x, y, ancho, alto, relleno) { sdl_rect(ren, x, y, ancho, alto, relleno) }\nfuncion sdl_linea(ren, x1, y1, x2, y2) { SDL_RenderDrawLine(ren, piso(x1), piso(y1), piso(x2), piso(y2)) }\nfuncion sdl_dibujar_linea(ren, x1, y1, x2, y2) { sdl_linea(ren, x1, y1, x2, y2) }\nfuncion sdl_dibujar_pixel(ren, x, y) { SDL_RenderDrawPoint(ren, piso(x), piso(y)) }\n\nfuncion sdl_dibujar_circulo(ren, cx, cy, radio) {\n    sea x = radio\n    sea y = 0\n    sea error = 0\n    mientras (x >= y) {\n        para p en [[x, y], [y, x], [-y, x], [-x, y], [-x, -y], [-y, -x], [y, -x], [x, -y]] {\n            SDL_RenderDrawPoint(ren, piso(cx + p[0]), piso(cy + p[1]))\n        }\n        y += 1\n        error += 1 + 2 * y\n        si (2 * (error - x) + 1 > 0) {\n            x -= 1\n            error += 1 - 2 * x\n        }\n    }\n}\n\n// Lista de eventos: mapas {tipo, tecla, presionada, x, y, boton, salir}.\nfuncion sdl_eventos() {\n    sea estado = __sdl_estado()\n    si (estado[\"evento\"] == nulo) { estado[\"evento\"] = c_reservar(64) }\n    sea e = estado[\"evento\"]\n    sea lista = []\n    mientras (SDL_PollEvent(e) != 0) {\n        sea tipo = c_leer32(e, 0)\n        sea ev = {\"tipo\": tipo}\n        si (tipo == 768 o tipo == 769) {\n            ev[\"tecla\"] = c_leer32(e, 16)\n            ev[\"presionada\"] = tipo == 768\n        } sino si (tipo == 1024 o tipo == 1025 o tipo == 1026) {\n            ev[\"x\"] = c_leer32(e, 20)\n            ev[\"y\"] = c_leer32(e, 24)\n            si (tipo == 1025) { ev[\"boton\"] = c_leer8(e, 16) }\n        } sino si (tipo == 256) {\n            ev[\"salir\"] = verdadero\n        }\n        lista.agregar(ev)\n    }\n    retornar lista\n}\n\nfuncion sdl_ticks() { retornar SDL_GetTicks() }\nfuncion sdl_tiempo() { retornar SDL_GetTicks() }\nfuncion sdl_esperar(ms) { SDL_Delay(piso(ms ?? 16)) }\nfuncion sdl_delay(ms) { sdl_esperar(ms) }\nfuncion sdl_titulo(ventana, titulo) { SDL_SetWindowTitle(ventana, titulo) }\n\nfuncion sdl_cerrar() {\n    para r en __sdl_estado()[\"renderers\"] { SDL_DestroyRenderer(r) }\n    para v en __sdl_estado()[\"ventanas\"] { SDL_DestroyWindow(v) }\n    sea estado = __sdl_estado()\n    estado[\"renderers\"] = []\n    estado[\"ventanas\"] = []\n    SDL_Quit()\n}\n\n// Texto con SDL2_ttf (opcional, como en el intérprete).\nfuncion sdl_cargar_fuente(ruta, tam) {\n    intentar {\n        extern \"SDL2_ttf\" funcion TTF_Init(): entero\n        extern \"SDL2_ttf\" funcion TTF_OpenFont(ruta: texto, tam: entero): puntero\n    } capturar (e) {\n        lanzar \"sdl_cargar_fuente: SDL2_ttf no disponible\"\n    }\n    sea estado = __sdl_estado()\n    si (estado[\"ttf\"] == nulo) {\n        TTF_Init()\n        estado[\"ttf\"] = verdadero\n    }\n    sea f = TTF_OpenFont(ruta, piso(tam ?? 16))\n    si (f == 0) { lanzar \"sdl_cargar_fuente: no se pudo abrir '\" + ruta + \"'\" }\n    estado[\"fuentes\"].agregar(f)\n    retornar f\n}\n\nfuncion sdl_texto(ren, fuente, txt, x, y, r, g, b) {\n    // Sin fuente (SDL2_ttf ausente o no cargada) no se dibuja, como en el intérprete.\n    si (no lista_contiene(__sdl_estado()[\"fuentes\"], fuente)) { retornar nulo }\n    sea color = piso(r ?? 255) + piso(g ?? 255) * 256 + piso(b ?? 255) * 65536 + 255 * 16777216\n    sea s = TTF_RenderUTF8_Blended(fuente, a_texto(txt), color)\n    si (s == 0) { retornar nulo }\n    sea t = SDL_CreateTextureFromSurface(ren, s)\n    SDL_FreeSurface(s)\n    sea medidas = c_reservar(8)\n    SDL_QueryTexture(t, 0, 0, medidas, medidas + 4)\n    SDL_RenderCopy(ren, t, 0, __sdl_rect(x, y, c_leer32(medidas, 0), c_leer32(medidas, 4)))\n    c_liberar(medidas)\n    SDL_DestroyTexture(t)\n}\n\n// Texturas con SDL2_image (opcional, como en el intérprete).\nfuncion sdl_cargar_textura(ren, ruta) {\n    intentar {\n        extern \"SDL2_image\" funcion IMG_LoadTexture(ren: puntero, ruta: texto): puntero\n    } capturar (e) {\n        lanzar \"sdl_cargar_textura: no se pudo cargar '\" + ruta + \"'. Instala libSDL2-image.\"\n    }\n    sea t = IMG_LoadTexture(ren, ruta)\n    si (t == 0) { lanzar \"sdl_cargar_textura: no se pudo cargar '\" + ruta + \"'. Instala libSDL2-image.\" }\n    retornar t\n}\n\nfuncion sdl_dibujar_textura(ren, textura, x, y, ancho, alto, angulo) {\n    SDL_RenderCopy(ren, textura, 0, __sdl_rect(x, y, ancho, alto))\n}\n\nfuncion sdl_destruir_textura(textura) {\n    SDL_DestroyTexture(textura)\n}\n" }
    retornar ""
}
