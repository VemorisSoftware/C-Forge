c)\n        gf_S(b, a)\n        gf_Z(c, d, f)\n        gf_M(a, c, k121665)\n        gf_A(a, a, d)\n        gf_M(c, c, a)\n        gf_M(a, d, f)\n        gf_M(d, b, x)\n        gf_S(b, e)\n        sel25519(a, b, r)\n        sel25519(c, d, r)\n        i = i - 1\n    }\n    inv25519(c, c)\n    gf_M(a, a, c)\n    pack25519(q, a)\n    retornar 0\n}\n\nfuncion cr_memoria_de(s, n) {\n    si (str_largo(s) != n) { retornar 0 }\n    sea p = mem_reservar(n)\n    sea i = 0\n    mientras (i < n) {\n        __guardar8(p + i, str_byte(s, i))\n        i = i + 1\n    }\n    retornar p\n}\n\nfuncion cr_texto_de(p, n) {\n    sea r = str_nuevo(n)\n    sea i = 0\n    mientras (i < n) {\n        str_agregar_byte(r, __cargar8(p + i))\n        i = i + 1\n    }\n    retornar r\n}\n\nfuncion x25519(escalar, punto) {\n    sea n = cr_memoria_de(dyn_a_str(escalar), 32)\n    sea p = cr_memoria_de(dyn_a_str(punto), 32)\n    si (n == 0 o p == 0) { dyn_error(\"x25519: el escalar y el punto deben tener 32 bytes\") }\n    sea q = mem_reservar(32)\n    x25519_crudo(q, n, p)\n    retornar dyn_texto(cr_texto_de(q, 32))\n}\n\nfuncion x25519_base(escalar) {\n    sea nueve = str_nuevo(32)\n    str_agregar_byte(nueve, 9)\n    sea i = 1\n    mientras (i < 32) {\n        str_agregar_byte(nueve, 0)\n        i = i + 1\n    }\n    retornar x25519(escalar, dyn_texto(nueve))\n}\n\n// ── Ed25519 (RFC 8032) ──\n// Punto: 4 gf seguidos (x, y, z, t) en 512 bytes.\nfuncion ed_punto() {\n    sea p = mem_reservar(512)\n    mem_llenar(p, 0, 512)\n    retornar p\n}\nfuncion ed_c(p, k) { retornar p + k * 128 }\n\nfuncion ed_D2() { retornar gf_de(\"f159 26b2 9b94 ebd6 b156 8283 149a 00e0 d130 eef3 80f2 198e fce7 56df d9dc 2406\") }\nfuncion ed_D() { retornar gf_de(\"78a3 1359 4dca 75eb d8ab 4141 0a4d 0070 e898 7779 4079 8cc7 fe73 2b6f 6cee 5203\") }\n\nfuncion ed_sumar(p, q) {\n    sea a = gf_nuevo()\n    sea b = gf_nuevo()\n    sea c = gf_nuevo()\n    sea d = gf_nuevo()\n    sea t = gf_nuevo()\n    sea e = gf_nuevo()\n    sea f = gf_nuevo()\n    sea g = gf_nuevo()\n    sea h = gf_nuevo()\n    gf_Z(a, ed_c(p, 1), ed_c(p, 0))\n    gf_Z(t, ed_c(q, 1), ed_c(q, 0))\n    gf_M(a, a, t)\n    gf_A(b, ed_c(p, 0), ed_c(p, 1))\n    gf_A(t, ed_c(q, 0), ed_c(q, 1))\n    gf_M(b, b, t)\n    gf_M(c, ed_c(p, 3), ed_c(q, 3))\n    sea d2 = ed_D2()\n    gf_M(c, c, d2)\n    gf_M(d, ed_c(p, 2), ed_c(q, 2))\n    gf_A(d, d, d)\n    gf_Z(e, b, a)\n    gf_Z(f, d, c)\n    gf_A(g, d, c)\n    gf_A(h, b, a)\n    gf_M(ed_c(p, 0), e, f)\n    gf_M(ed_c(p, 1), h, g)\n    gf_M(ed_c(p, 2), g, f)\n    gf_M(ed_c(p, 3), e, h)\n    cr_liberar(a) cr_liberar(b) cr_liberar(c) cr_liberar(d) cr_liberar(t)\n    cr_liberar(e) cr_liberar(f) cr_liberar(g) cr_liberar(h) cr_liberar(d2)\n    retornar 0\n}\n\nfuncion ed_cswap(p, q, b) {\n    sea i = 0\n    mientras (i < 4) {\n        sel25519(ed_c(p, i), ed_c(q, i), b)\n        i = i + 1\n    }\n    retornar 0\n}\n\nfuncion ed_empaquetar(r, p) {\n    sea tx = gf_nuevo()\n    sea ty = gf_nuevo()\n    sea zi = gf_nuevo()\n    inv25519(zi, ed_c(p, 2))\n    gf_M(tx, ed_c(p, 0), zi)\n    gf_M(ty, ed_c(p, 1), zi)\n    pack25519(r, ty)\n    __guardar8(r + 31, __xo_bits(__cargar8(r + 31), __desplazar_izq(par25519(tx), 7)))\n    cr_liberar(tx) cr_liberar(ty) cr_liberar(zi)\n    retornar 0\n}\n\nfuncion ed_multiplicar(p, q, s) {\n    gf_fijar(ed_c(p, 0), 0, 0)\n    gf_fijar(ed_c(p, 1), 0, 1)\n    gf_fijar(ed_c(p, 2), 0, 1)\n    gf_fijar(ed_c(p, 3), 0, 0)\n    sea i = 255\n    mientras (i >= 0) {\n        sea b = __y_bits(__desplazar_der(__cargar8(s + i / 8), __y_bits(i, 7)), 1)\n        ed_cswap(p, q, b)\n        ed_sumar(q, p)\n        ed_sumar(p, p)\n        ed_cswap(p, q, b)\n        i = i - 1\n    }\n    retornar 0\n}\n\nfuncion ed_base(p, s) {\n    sea q = ed_punto()\n    sea x = gf_de(\"d51a 8f25 2d60 c956 a7b2 9525 c760 692c dc5c fdd6 e231 c0a4 53fe cd6e 36d3 2169\")\n    sea y = gf_de(\"6658 6666 6666 6666 6666 6666 6666 6666 6666 6666 6666 6666 6666 6666 6666 6666\")\n    gf_copiar(ed_c(q, 0), x)\n    gf_copiar(ed_c(q, 1), y)\n    gf_fijar(ed_c(q, 2), 0, 1)\n    gf_M(ed_c(q, 3), x, y)\n    ed_multiplicar(p, q, s)\n    cr_liberar(q) cr_liberar(x) cr_liberar(y)\n    retornar 0\n}\n\n// L = 2^252 + 27742317777372353535851937790883648493 (orden del grupo).\nfuncion ed_L(j) {\n    si (j == 31) { retornar 16 }\n    si (j >= 16) { retornar 0 }\n    sea t = \"edd3f55c1a631258d69cf7a2def9de14\"\n    retornar valor_hex(str_byte(t, j * 2)) * 16 + valor_hex(str_byte(t, j * 2 + 1))\n}\n\n// r (32 bytes) ← x (64 cifras en enteros) mod L.\nfuncion ed_modL(r, x) {\n    sea i = 63\n    mientras (i >= 32) {\n        sea carry = 0\n        sea j = i - 32\n        mientras (j < i - 12) {\n            __guardar64(x + j * 8, __cargar64(x + j * 8) + carry - 16 * __cargar64(x + i * 8) * ed_L(j - (i - 32)))\n            carry = __desplazar_aritmetico(__cargar64(x + j * 8) + 128, 8)\n            __guardar64(x + j * 8, __cargar64(x + j * 8) - __desplazar_izq(carry, 8))\n            j = j + 1\n        }\n        __guardar64(x + j * 8, __cargar64(x + j * 8) + carry)\n        __guardar64(x + i * 8, 0)\n        i = i - 1\n    }\n    sea carry = 0\n    sea j = 0\n    mientras (j < 32) {\n        __guardar64(x + j * 8, __cargar64(x + j * 8) + carry - __desplazar_aritmetico(__cargar64(x + 31 * 8), 4) * ed_L(j))\n        carry = __desplazar_aritmetico(__cargar64(x + j * 8), 8)\n        __guardar64(x + j * 8, __y_bits(__cargar64(x + j * 8), 255))\n        j = j + 1\n    }\n    j = 0\n    mientras (j < 32) {\n        __guardar64(x + j * 8, __cargar64(x + j * 8) - carry * ed_L(j))\n        j = j + 1\n    }\n    i = 0\n    mientras (i < 32) {\n        __guardar64(x + (i + 1) * 8, __cargar64(x + (i + 1) * 8) + __desplazar_aritmetico(__cargar64(x + i * 8), 8))\n        __guardar8(r + i, __y_bits(__cargar64(x + i * 8), 255))\n        i = i + 1\n    }\n    retornar 0\n}\n\n// r (64 bytes) → r mod L en los primeros 32.\nfuncion ed_reducir(r) {\n    sea x = mem_reservar(65 * 8)\n    mem_llenar(x, 0, 65 * 8)\n    sea i = 0\n    mientras (i < 64) {\n        __guardar64(x + i * 8, __cargar8(r + i))\n        __guardar8(r + i, 0)\n        i = i + 1\n    }\n    ed_modL(r, x)\n    cr_liberar(x)\n    retornar 0\n}\n\n// Semilla de 32 bytes → d = SHA-512(semilla) recortado; publica = d·B.\nfuncion ed_clave(semilla) {\n    sea d = sha512_crudo(semilla, 0)\n    sea dp = cr_memoria_de(d, 64)\n    __guardar8(dp, __y_bits(__cargar8(dp), 248))\n    __guardar8(dp + 31, __o_bits(__y_bits(__cargar8(dp + 31), 127), 64))\n    retornar dp\n}\n\nfuncion ed25519_crudo_publica(dp) {\n    sea p = ed_punto()\n    sea pk = mem_reservar(32)\n    ed_base(p, dp)\n    ed_empaquetar(pk, p)\n    cr_liberar(p)\n    retornar pk\n}\n\nfuncion ed25519_publica(semilla) {\n    sea s = dyn_a_str(semilla)\n    si (str_largo(s) != 32) { dyn_error(\"ed25519_publica: la semilla debe tener 32 bytes\") }\n    retornar dyn_texto(cr_texto_de(ed25519_crudo_publica(ed_clave(s)), 32))\n}\n\nfuncion ed25519_firmar(semilla, mensaje) {\n    sea s = dyn_a_str(semilla)\n    sea m = dyn_a_str(mensaje)\n    si (str_largo(s) != 32) { dyn_error(\"ed25519_firmar: la semilla debe tener 32 bytes\") }\n    sea dp = ed_clave(s)\n    sea pk = ed25519_crudo_publica(dp)\n    // r = SHA-512(prefijo || m) mod L\n    sea entrada = str_nuevo(32 + str_largo(m))\n    str_agregar(entrada, cr_texto_de(dp + 32, 32))\n    str_agregar(entrada, m)\n    sea rp = cr_memoria_de(sha512_crudo(entrada, 0), 64)\n    ed_reducir(rp)\n    sea p = ed_punto()\n    ed_base(p, rp)\n    sea firma = mem_reservar(64)\n    ed_empaquetar(firma, p)\n    // h = SHA-512(R || A || m) mod L\n    sea entrada2 = str_nuevo(64 + str_largo(m))\n    str_agregar(entrada2, cr_texto_de(firma, 32))\n    str_agregar(entrada2, cr_texto_de(pk, 32))\n    str_agregar(entrada2, m)\n    sea hp = cr_memoria_de(sha512_crudo(entrada2, 0), 64)\n    ed_reducir(hp)\n    // S = (r + h·d) mod L\n    sea x = mem_reservar(65 * 8)\n    mem_llenar(x, 0, 65 * 8)\n    sea i = 0\n    mientras (i < 32) {\n        __guardar64(x + i * 8, __cargar8(rp + i))\n        i = i + 1\n    }\n    i = 0\n    mientras (i < 32) {\n        sea j = 0\n        mientras (j < 32) {\n            __guardar64(x + (i + j) * 8, __cargar64(x + (i + j) * 8) + __cargar8(hp + i) * __cargar8(dp + j))\n            j = j + 1\n        }\n        i = i + 1\n    }\n    ed_modL(firma + 32, x)\n    retornar dyn_texto(cr_texto_de(firma, 64))\n}\n\n// r ← -A desde la clave pública (32 bytes); 0 si es válida.\nfuncion ed_desempaquetar_negativo(r, p) {\n    sea t = gf_nuevo()\n    sea chk = gf_nuevo()\n    sea num = gf_nuevo()\n    sea den = gf_nuevo()\n    sea den2 = gf_nuevo()\n    sea den4 = gf_nuevo()\n    sea den6 = gf_nuevo()\n    sea d = ed_D()\n    sea uno = gf_nuevo()\n    gf_fijar(uno, 0, 1)\n    gf_copiar(ed_c(r, 2), uno)\n    unpack25519(ed_c(r, 1), p)\n    gf_S(num, ed_c(r, 1))\n    gf_M(den, num, d)\n    gf_Z(num, num, ed_c(r, 2))\n    gf_A(den, ed_c(r, 2), den)\n    gf_S(den2, den)\n    gf_S(den4, den2)\n    gf_M(den6, den4, den2)\n    gf_M(t, den6, num)\n    gf_M(t, t, den)\n    pow2523(t, t)\n    gf_M(t, t, num)\n    gf_M(t, t, den)\n    gf_M(t, t, den)\n    gf_M(ed_c(r, 0), t, den)\n    gf_S(chk, ed_c(r, 0))\n    gf_M(chk, chk, den)\n    si (neq25519(chk, num)) {\n        sea raiz_i = gf_de(\"a0b0 4a0e 1b27 c4ee e478 ad2f 1806 2f43 d7a7 3dfb 0099 2b4d df0b 4fc1 2480 2b83\")\n        gf_M(ed_c(r, 0), ed_c(r, 0), raiz_i)\n    }\n    gf_S(chk, ed_c(r, 0))\n    gf_M(chk, chk, den)\n    si (neq25519(chk, num)) { retornar 0 - 1 }\n    si (par25519(ed_c(r, 0)) == __desplazar_der(__cargar8(p + 31), 7)) {\n        sea cero = gf_nuevo()\n        gf_Z(ed_c(r, 0), cero, ed_c(r, 0))\n    }\n    gf_M(ed_c(r, 3), ed_c(r, 0), ed_c(r, 1))\n    retornar 0\n}\n\nfuncion ed25519_verificar(publica, mensaje, firma) {\n    sea pk_s = dyn_a_str(publica)\n    sea f_s = dyn_a_str(firma)\n    sea m = dyn_a_str(mensaje)\n    si (str_largo(pk_s) != 32 o str_largo(f_s) != 64) { retornar dyn_bool(0) }\n    sea pk = cr_memoria_de(pk_s, 32)\n    sea sm = cr_memoria_de(f_s, 64)\n    // S debe ser menor que L (sin maleabilidad).\n    sea i = 31\n    sea decidido = 0\n    mientras (i >= 0 y decidido == 0) {\n        sea a = __cargar8(sm + 32 + i)\n        sea b = ed_L(i)\n        si (a < b) { decidido = 1 }\n        si (a > b) { retornar dyn_bool(0) }\n        i = i - 1\n    }\n    si (decidido == 0) { retornar dyn_bool(0) }\n    sea q = ed_punto()\n    si (ed_desempaquetar_negativo(q, pk) != 0) { retornar dyn_bool(0) }\n    sea entrada = str_nuevo(64 + str_largo(m))\n    str_agregar(entrada, cr_texto_de(sm, 32))\n    str_agregar(entrada, pk_s)\n    str_agregar(entrada, m)\n    sea hp = cr_memoria_de(sha512_crudo(entrada, 0), 64)\n    ed_reducir(hp)\n    sea p = ed_punto()\n    ed_multiplicar(p, q, hp)\n    sea q2 = ed_punto()\n    ed_base(q2, sm + 32)\n    ed_sumar(p, q2)\n    sea t = mem_reservar(32)\n    ed_empaquetar(t, p)\n    retornar dyn_bool(iguales32(sm, t))\n}\n\n// ── RSA-OAEP (cifrar con una clave pública PEM) ─────────────────────────\n// Números: [cifras][16 bits por cifra, little endian] en enteros de 64 bits.\n\nfuncion bn_nuevo(k) {\n    sea p = mem_reservar(k * 8 + 8)\n    mem_llenar(p, 0, k * 8 + 8)\n    retornar p\n}\nfuncion bn(p, i) { retornar __cargar64(p + i * 8) }\nfuncion bn_fijar(p, i, v) {\n    __guardar64(p + i * 8, v)\n    retornar 0\n}\n\n// Bytes big endian → número de k cifras.\nfuncion bn_de_bytes(s, k) {\n    sea p = bn_nuevo(k)\n    sea n = str_largo(s)\n    sea i = 0\n    mientras (i < n) {\n        sea b = str_byte(s, n - 1 - i)\n        sea cifra = i / 2\n        si (cifra < k) {\n            si (i % 2 == 0) { bn_fijar(p, cifra, bn(p, cifra) + b) } sino { bn_fijar(p, cifra, bn(p, cifra) + b * 256) }\n        }\n        i = i + 1\n    }\n    retornar p\n}\n\nfuncion bn_a_bytes(p, k, largo) {\n    sea r = str_nuevo(largo)\n    sea i = largo - 1\n    mientras (i >= 0) {\n        sea cifra = i / 2\n        sea v = 0\n        si (cifra < k) { v = bn(p, cifra) }\n        si (i % 2 == 0) { str_agregar_byte(r, __y_bits(v, 255)) } sino { str_agregar_byte(r, __y_bits(__desplazar_der(v, 8), 255)) }\n        i = i - 1\n    }\n    retornar r\n}\n\n// a >= b (k cifras)\nfuncion bn_mayor_igual(a, b, k) {\n    sea i = k - 1\n    mientras (i >= 0) {\n        si (bn(a, i) > bn(b, i)) { retornar 1 }\n        si (bn(a, i) < bn(b, i)) { retornar 0 }\n        i = i - 1\n    }\n    retornar 1\n}\n\nfuncion bn_restar(a, b, k) {\n    sea prestamo = 0\n    sea i = 0\n    mientras (i < k) {\n        sea v = bn(a, i) - bn(b, i) - prestamo\n        prestamo = 0\n        si (v < 0) {\n            v = v + 65536\n            prestamo = 1\n        }\n        bn_fijar(a, i, v)\n        i = i + 1\n    }\n    retornar 0\n}\n\n// Montgomery: r = a · b · R^-1 mod n (R = 2^(16k)); ni = -n^-1 mod 2^16.\nfuncion bn_mont(r, a, b, n, ni, k) {\n    sea t = bn_nuevo(k + 2)\n    sea i = 0\n    mientras (i < k) {\n        sea ai = bn(a, i)\n        sea carry = 0\n        sea j = 0\n        mientras (j < k) {\n            sea v = bn(t, j) + ai * bn(b, j) + carry\n            bn_fijar(t, j, __y_bits(v, 65535))\n            carry = __desplazar_der(v, 16)\n            j = j + 1\n        }\n        sea v2 = bn(t, k) + carry\n        bn_fijar(t, k, __y_bits(v2, 65535))\n        bn_fijar(t, k + 1, bn(t, k + 1) + __desplazar_der(v2, 16))\n        sea m = __y_bits(bn(t, 0) * ni, 65535)\n        carry = 0\n        j = 0\n        mientras (j < k) {\n            sea v = bn(t, j) + m * bn(n, j) + carry\n            bn_fijar(t, j, __y_bits(v, 65535))\n            carry = __desplazar_der(v, 16)\n            j = j + 1\n        }\n        v2 = bn(t, k) + carry\n        bn_fijar(t, k, __y_bits(v2, 65535))\n        bn_fijar(t, k + 1, bn(t, k + 1) + __desplazar_der(v2, 16))\n        // t ← t / 2^16\n        j = 0\n        mientras (j <= k) {\n            bn_fijar(t, j, bn(t, j + 1))\n            j = j + 1\n        }\n        bn_fijar(t, k + 1, 0)\n        i = i + 1\n    }\n    si (bn(t, k) != 0 o bn_mayor_igual(t, n, k)) { bn_restar(t, n, k + 1) }\n    i = 0\n    mientras (i < k) {\n        bn_fijar(r, i, bn(t, i))\n        i = i + 1\n    }\n    cr_liberar(t)\n    retornar 0\n}\n\n// m^e mod n (bytes big endian); el largo del resultado es el de n.\nfuncion rsa_crudo(mensaje, n_bytes, e_bytes) {\n    sea largo = str_largo(n_bytes)\n    sea k = (largo + 1) / 2 + 1\n    sea n = bn_de_bytes(n_bytes, k)\n    // ni = -n^-1 mod 2^16 (Newton sobre el inverso).\n    sea x = 1\n    sea it = 0\n    mientras (it < 5) {\n        x = __y_bits(x * (2 - __y_bits(bn(n, 0) * x, 65535)), 65535)\n        it = it + 1\n    }\n    sea ni = __y_bits(65536 - x, 65535)\n    // R^2 mod n por duplicaciones.\n    sea r2 = bn_nuevo(k + 1)\n    bn_fijar(r2, 0, 1)\n    sea paso = 0\n    mientras (paso < 2 * 16 * k) {\n        sea carry = 0\n        sea j = 0\n        mientras (j <= k) {\n            sea v = bn(r2, j) * 2 + carry\n            bn_fijar(r2, j, __y_bits(v, 65535))\n            carry = __desplazar_der(v, 16)\n            j = j + 1\n        }\n        si (bn(r2, k) != 0 o bn_mayor_igual(r2, n, k)) { bn_restar(r2, n, k + 1) }\n        paso = paso + 1\n    }\n    sea m = bn_de_bytes(mensaje, k)\n    sea mm = bn_nuevo(k)\n    bn_mont(mm, m, r2, n, ni, k)\n    sea uno = bn_nuevo(k)\n    bn_fijar(uno, 0, 1)\n    sea acc = bn_nuevo(k)\n    bn_mont(acc, uno, r2, n, ni, k)\n    // Exponenciación de izquierda a derecha.\n    sea i = 0\n    mientras (i < str_largo(e_bytes)) {\n        sea b = 7\n        mientras (b >= 0) {\n            bn_mont(acc, acc, acc, n, ni, k)\n            si (__y_bits(__desplazar_der(str_byte(e_bytes, i), b), 1) == 1) { bn_mont(acc, acc, mm, n, ni, k) }\n            b = b - 1\n        }\n        i = i + 1\n    }\n    sea resultado = bn_nuevo(k)\n    bn_mont(resultado, acc, uno, n, ni, k)\n    retornar bn_a_bytes(resultado, k, largo)\n}\n\n// DER: [etiqueta][largo][contenido] → posición del contenido y su largo.\nfuncion der_leer(s, i) {\n    sea r = mem_reservar(24)\n    __guardar64(r, str_byte(s, i))\n    sea l = str_byte(s, i + 1)\n    sea pos = i + 2\n    si (l >= 128) {\n        sea bytes = l - 128\n        l = 0\n        sea k = 0\n        mientras (k < bytes) {\n            l = l * 256 + str_byte(s, pos + k)\n            k = k + 1\n        }\n        pos = pos + bytes\n    }\n    __guardar64(r + 8, pos)\n    __guardar64(r + 16, l)\n    retornar r\n}\n\nfuncion der_entero(s, i) {\n    sea d = der_leer(s, i)\n    sea inicio = __cargar64(d + 8)\n    sea largo = __cargar64(d + 16)\n    mientras (largo > 1 y str_byte(s, inicio) == 0) {\n        inicio = inicio + 1\n        largo = largo - 1\n    }\n    retornar str_rebanar(s, inicio, inicio + largo)\n}\n\n// Clave pública PEM (SubjectPublicKeyInfo o PKCS#1) → [n][e] en bytes.\nfuncion rsa_clave(pem) {\n    sea b64 = str_nuevo(str_largo(pem))\n    sea i = 0\n    sea dentro = 0\n    mientras (i < str_largo(pem)) {\n        sea fin_linea = str_buscar(pem, \"\\n\", i)\n        si (fin_linea < 0) { fin_linea = str_largo(pem) }\n        sea linea = str_rebanar(pem, i, fin_linea)\n        si (str_largo(linea) > 0 y str_byte(linea, str_largo(linea) - 1) == 13) { linea = str_rebanar(linea, 0, str_largo(linea) - 1) }\n        si (str_buscar(linea, \"-----BEGIN\", 0) == 0) { dentro = 1 } sino {\n            si (str_buscar(linea, \"-----END\", 0) == 0) { dentro = 0 } sino {\n                si (dentro) { str_agregar(b64, linea) }\n            }\n        }\n        i = fin_linea + 1\n    }\n    sea der = dyn_dato(cfv_base64_decodificar(dyn_texto(b64)))\n    sea seq = der_leer(der, 0)\n    sea p = __cargar64(seq + 8)\n    sea primero = der_leer(der, p)\n    si (__cargar64(primero) == 48) {\n        // SPKI: SEQUENCE { algoritmo } BIT STRING { 0, SEQUENCE { n, e } }\n        sea bits = der_leer(der, __cargar64(primero + 8) + __cargar64(primero + 16))\n        p = __cargar64(bits + 8) + 1\n        sea interna = der_leer(der, p)\n        p = __cargar64(interna + 8)\n    }\n    sea n = der_entero(der, p)\n    sea dn = der_leer(der, p)\n    sea e = der_entero(der, __cargar64(dn + 8) + __cargar64(dn + 16))\n    sea r = mem_reservar(16)\n    __guardar64(r, n)\n    __guardar64(r + 8, e)\n    retornar r\n}\n\n// MGF1 con el resumen alg.\nfuncion mgf1(alg, semilla, largo) {\n    sea r = str_nuevo(largo + 64)\n    sea contador = 0\n    mientras (str_largo(r) < largo) {\n        sea entrada = str_nuevo(str_largo(semilla) + 4)\n        str_agregar(entrada, semilla)\n        str_agregar_byte(entrada, __y_bits(__desplazar_der(contador, 24), 255))\n        str_agregar_byte(entrada, __y_bits(__desplazar_der(contador, 16), 255))\n        str_agregar_byte(entrada, __y_bits(__desplazar_der(contador, 8), 255))\n        str_agregar_byte(entrada, __y_bits(contador, 255))\n        str_agregar(r, cr_resumen(alg, entrada))\n        contador = contador + 1\n    }\n    retornar str_rebanar(r, 0, largo)\n}\n\n// RSAES-OAEP (RFC 8017) con SHA-1 (alg 1) o SHA-256 (256), etiqueta vacía.\nfuncion rsa_oaep_crudo(pem, mensaje, alg) {\n    sea clave = rsa_clave(pem)\n    sea n = __cargar64(clave)\n    sea e = __cargar64(clave + 8)\n    sea k = str_largo(n)\n    sea lhash = cr_resumen(alg, \"\")\n    sea hlen = str_largo(lhash)\n    si (str_largo(mensaje) > k - 2 * hlen - 2) { dyn_error(\"rsa_oaep_cifrar: mensaje demasiado largo para la clave\") }\n    sea db = str_nuevo(k)\n    str_agregar(db, lhash)\n    sea relleno = k - str_largo(mensaje) - 2 * hlen - 2\n    sea i = 0\n    mientras (i < relleno) {\n        str_agregar_byte(db, 0)\n        i = i + 1\n    }\n    str_agregar_byte(db, 1)\n    str_agregar(db, mensaje)\n    sea semilla = str_nuevo(hlen)\n    si (sys_aleatorio(str_datos(semilla), hlen) != 0) { dyn_error(\"rsa_oaep_cifrar: sin bytes aleatorios\") }\n    __guardar64(semilla, hlen)\n    sea mascara_db = mgf1(alg, semilla, k - hlen - 1)\n    sea db_m = str_nuevo(k)\n    i = 0\n    mientras (i < str_largo(db)) {\n        str_agregar_byte(db_m, __xo_bits(str_byte(db, i), str_byte(mascara_db, i)))\n        i = i + 1\n    }\n    sea mascara_s = mgf1(alg, db_m, hlen)\n    sea em = str_nuevo(k)\n    str_agregar_byte(em, 0)\n    i = 0\n    mientras (i < hlen) {\n        str_agregar_byte(em, __xo_bits(str_byte(semilla, i), str_byte(mascara_s, i)))\n        i = i + 1\n    }\n    str_agregar(em, db_m)\n    retornar rsa_crudo(em, n, e)\n}\n\nfuncion rsa_oaep_cifrar(pem, mensaje, resumen) {\n    sea alg = 1\n    si (resumen != 0 y str_igual(dyn_texto_de(resumen, \"rsa_oaep_cifrar\"), \"sha256\")) { alg = 256 }\n    retornar dyn_texto(rsa_oaep_crudo(dyn_texto_de(pem, \"rsa_oaep_cifrar\"), dyn_a_str(mensaje), alg))\n}\n\n// ── Utilidades de bytes (little endian) ─────────────────────────────────\n\nfuncion le32(s, i) {\n    retornar __o_bits(__o_bits(str_byte(s, i), __desplazar_izq(str_byte(s, i + 1), 8)), __o_bits(__desplazar_izq(str_byte(s, i + 2), 16), __desplazar_izq(str_byte(s, i + 3), 24)))\n}\nfuncion le64(s, i) { retornar __o_bits(le32(s, i), __desplazar_izq(le32(s, i + 4), 32)) }\nfuncion agregar_le32(r, v) {\n    sea k = 0\n    mientras (k < 4) {\n        str_agregar_byte(r, __y_bits(__desplazar_der(v, k * 8), 255))\n        k = k + 1\n    }\n    retornar 0\n}\nfuncion agregar_le64(r, v) {\n    sea k = 0\n    mientras (k < 8) {\n        str_agregar_byte(r, __y_bits(__desplazar_der(v, k * 8), 255))\n        k = k + 1\n    }\n    retornar 0\n}\nfuncion m32(p, i) { retornar __cargar64(p + i * 8) }\nfuncion f32(p, i, v) {\n    __guardar64(p + i * 8, __y_bits(v, 4294967295))\n    retornar 0\n}\n\n// Borra el contenido de un texto (bytes en 0): para claves y contraseñas.\n// Borra bytes con escrituras volátiles en la práctica: cada byte se escribe\n// por separado y una barrera de memoria cierra el borrado (como\n// OPENSSL_cleanse o explicit_bzero), para que nada lo elimine ni reordene.\nfuncion mem_borrar_seguro(p, n) {\n    sea i = 0\n    mientras (i < n) {\n        __guardar8(p + i, 0)\n        i = i + 1\n    }\n    __barrera()\n    retornar 0\n}\n\n// Libera memoria temporal de la criptografía borrándola antes (claves,\n// estados, escalares, memoria de Argon2): no quedan secretos en bloques\n// libres que otro código podría reutilizar o volcar.\nfuncion cr_liberar(p) {\n    si (p == 0) { retornar 0 }\n    sea cab = __cargar64(p - 8)\n    sea n = 0\n    si (cab < 0) { n = 0 - cab - 8 } sino { n = mem_tamano_clase(__y_bits(cab, 127)) - 8 }\n    mem_borrar_seguro(p, n)\n    mem_liberar(p)\n    retornar 0\n}\n\n// Borra un secreto en su lugar. Solo textos propios del montículo: un\n// literal del programa es de solo lectura y puede estar compartido.\nfuncion borrar_texto(t) {\n    si (dyn_tipo(t) != 1) { retornar 0 }\n    sea s = dyn_dato(t)\n    si (__cargar64(s + 24) != 1) { retornar dyn_bool(0) }\n    mem_borrar_seguro(str_datos(s), str_largo(s))\n    retornar dyn_bool(1)\n}\n\n// ── ChaCha20 (RFC 8439) ─────────────────────────────────────────────────\n\nfuncion chacha_cuarto(x, a, b, c, d) {\n    f32(x, a, m32(x, a) + m32(x, b)) f32(x, d, roti32(__xo_bits(m32(x, d), m32(x, a)), 16))\n    f32(x, c, m32(x, c) + m32(x, d)) f32(x, b, roti32(__xo_bits(m32(x, b), m32(x, c)), 12))\n    f32(x, a, m32(x, a) + m32(x, b)) f32(x, d, roti32(__xo_bits(m32(x, d), m32(x, a)), 8))\n    f32(x, c, m32(x, c) + m32(x, d)) f32(x, b, roti32(__xo_bits(m32(x, b), m32(x, c)), 7))\n    retornar 0\n}\n\n// Estado inicial: constantes, clave (32), contador y nonce (16 bytes en\n// total: contador de 32 bits + nonce de 96, o 64 + 64 en la variante original).\nfuncion chacha_estado(clave, contador, nonce) {\n    sea x = mem_reservar(16 * 8)\n    f32(x, 0, 1634760805) f32(x, 1, 857760878) f32(x, 2, 2036477234) f32(x, 3, 1797285236)\n    sea i = 0\n    mientras (i < 8) {\n        f32(x, 4 + i, le32(clave, i * 4))\n        i = i + 1\n    }\n    f32(x, 12, contador)\n    f32(x, 13, le32(nonce, 0))\n    f32(x, 14, le32(nonce, 4))\n    f32(x, 15, le32(nonce, 8))\n    retornar x\n}\n\nfuncion chacha_rondas(x) {\n    sea r = 0\n    mientras (r < 10) {\n        chacha_cuarto(x, 0, 4, 8, 12) chacha_cuarto(x, 1, 5, 9, 13)\n        chacha_cuarto(x, 2, 6, 10, 14) chacha_cuarto(x, 3, 7, 11, 15)\n        chacha_cuarto(x, 0, 5, 10, 15) chacha_cuarto(x, 1, 6, 11, 12)\n        chacha_cuarto(x, 2, 7, 8, 13) chacha_cuarto(x, 3, 4, 9, 14)\n        r = r + 1\n    }\n    retornar 0\n}\n\n// Bloque de 64 bytes de flujo.\nfuncion chacha_bloque(clave, contador, nonce) {\n    sea x = chacha_estado(clave, contador, nonce)\n    sea w = mem_reservar(16 * 8)\n    sea i = 0\n    mientras (i < 16) {\n        __guardar64(w + i * 8, m32(x, i))\n        i = i + 1\n    }\n    chacha_rondas(w)\n    sea r = str_nuevo(64)\n    i = 0\n    mientras (i < 16) {\n        agregar_le32(r, m32(w, i) + m32(x, i))\n        i = i + 1\n    }\n    cr_liberar(w)\n    cr_liberar(x)\n    retornar r\n}\n\nfuncion chacha20_xor(clave, contador, nonce, texto) {\n    sea r = str_nuevo(str_largo(texto))\n    sea i = 0\n    mientras (i < str_largo(texto)) {\n        sea flujo = chacha_bloque(clave, contador, nonce)\n        sea k = 0\n        mientras (k < 64 y i + k < str_largo(texto)) {\n            str_agregar_byte(r, __xo_bits(str_byte(texto, i + k), str_byte(flujo, k)))\n            k = k + 1\n        }\n        contador = contador + 1\n        i = i + 64\n    }\n    retornar r\n}\n\n// HChaCha20: subclave de 32 bytes para XChaCha20 (nonce de 24 bytes).\nfuncion hchacha20(clave, n16) {\n    sea x = mem_reservar(16 * 8)\n    f32(x, 0, 1634760805) f32(x, 1, 857760878) f32(x, 2, 2036477234) f32(x, 3, 1797285236)\n    sea i = 0\n    mientras (i < 8) {\n        f32(x, 4 + i, le32(clave, i * 4))\n        i = i + 1\n    }\n    i = 0\n    mientras (i < 4) {\n        f32(x, 12 + i, le32(n16, i * 4))\n        i = i + 1\n    }\n    chacha_rondas(x)\n    sea r = str_nuevo(32)\n    i = 0\n    mientras (i < 4) {\n        agregar_le32(r, m32(x, i))\n        i = i + 1\n    }\n    i = 12\n    mientras (i < 16) {\n        agregar_le32(r, m32(x, i))\n        i = i + 1\n    }\n    cr_liberar(x)\n    retornar r\n}\n\n// ── Poly1305 (cifras de 26 bits, como poly1305-donna) ────────────────────\n\nfuncion poly1305_crudo(clave, m) {\n    sea r0 = __y_bits(le32(clave, 0), 67108863)\n    sea r1 = __y_bits(__desplazar_der(le32(clave, 3), 2), 67108611)\n    sea r2 = __y_bits(__desplazar_der(le32(clave, 6), 4), 67092735)\n    sea r3 = __y_bits(__desplazar_der(le32(clave, 9), 6), 66076671)\n    sea r4 = __y_bits(__desplazar_der(le32(clave, 12), 8), 1048575)\n    sea s1 = r1 * 5\n    sea s2 = r2 * 5\n    sea s3 = r3 * 5\n    sea s4 = r4 * 5\n    sea h0 = 0\n    sea h1 = 0\n    sea h2 = 0\n    sea h3 = 0\n    sea h4 = 0\n    sea i = 0\n    mientras (i < str_largo(m)) {\n        sea b = str_nuevo(17)\n        sea k = 0\n        mientras (k < 16 y i + k < str_largo(m)) {\n            str_agregar_byte(b, str_byte(m, i + k))\n            k = k + 1\n        }\n        sea alto = 16777216\n        si (k < 16) {\n            str_agregar_byte(b, 1)\n            k = k + 1\n            mientras (k < 17) {\n                str_agregar_byte(b, 0)\n                k = k + 1\n            }\n            alto = 0\n        } sino {\n            str_agregar_byte(b, 0)\n        }\n        h0 = h0 + __y_bits(le32(b, 0), 67108863)\n        h1 = h1 + __y_bits(__desplazar_der(le32(b, 3), 2), 67108863)\n        h2 = h2 + __y_bits(__desplazar_der(le32(b, 6), 4), 67108863)\n        h3 = h3 + __y_bits(__desplazar_der(le32(b, 9), 6), 67108863)\n        h4 = h4 + __o_bits(__desplazar_der(le32(b, 12), 8), alto)\n        sea d0 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1\n        sea d1 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2\n        sea d2 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3\n        sea d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4\n        sea d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0\n        sea c = __desplazar_der(d0, 26)\n        h0 = __y_bits(d0, 67108863)\n        d1 = d1 + c\n        c = __desplazar_der(d1, 26)\n        h1 = __y_bits(d1, 67108863)\n        d2 = d2 + c\n        c = __desplazar_der(d2, 26)\n        h2 = __y_bits(d2, 67108863)\n        d3 = d3 + c\n        c = __desplazar_der(d3, 26)\n        h3 = __y_bits(d3, 67108863)\n        d4 = d4 + c\n        c = __desplazar_der(d4, 26)\n        h4 = __y_bits(d4, 67108863)\n        h0 = h0 + c * 5\n        c = __desplazar_der(h0, 26)\n        h0 = __y_bits(h0, 67108863)\n        h1 = h1 + c\n        i = i + 16\n    }\n    // Reducción final y suma de s (mod 2^128).\n    sea c = __desplazar_der(h1, 26)\n    h1 = __y_bits(h1, 67108863)\n    h2 = h2 + c\n    c = __desplazar_der(h2, 26)\n    h2 = __y_bits(h2, 67108863)\n    h3 = h3 + c\n    c = __desplazar_der(h3, 26)\n    h3 = __y_bits(h3, 67108863)\n    h4 = h4 + c\n    c = __desplazar_der(h4, 26)\n    h4 = __y_bits(h4, 67108863)\n    h0 = h0 + c * 5\n    c = __desplazar_der(h0, 26)\n    h0 = __y_bits(h0, 67108863)\n    h1 = h1 + c\n    sea g0 = h0 + 5\n    c = __desplazar_der(g0, 26)\n    g0 = __y_bits(g0, 67108863)\n    sea g1 = h1 + c\n    c = __desplazar_der(g1, 26)\n    g1 = __y_bits(g1, 67108863)\n    sea g2 = h2 + c\n    c = __desplazar_der(g2, 26)\n    g2 = __y_bits(g2, 67108863)\n    sea g3 = h3 + c\n    c = __desplazar_der(g3, 26)\n    g3 = __y_bits(g3, 67108863)\n    sea g4 = h4 + c - 67108864\n    // Si g4 no es negativo, h ≥ p: usar g (selección sin ramas).\n    sea mascara = __desplazar_aritmetico(g4, 63)\n    sea usar_g = __xo_bits(mascara, 0 - 1)\n    h0 = __o_bits(__y_bits(h0, mascara), __y_bits(g0, usar_g))\n    h1 = __o_bits(__y_bits(h1, mascara), __y_bits(g1, usar_g))\n    h2 = __o_bits(__y_bits(h2, mascara), __y_bits(g2, usar_g))\n    h3 = __o_bits(__y_bits(h3, mascara), __y_bits(g3, usar_g))\n    h4 = __o_bits(__y_bits(h4, mascara), __y_bits(__y_bits(g4, 67108863), usar_g))\n    sea f0 = __y_bits(__o_bits(h0, __desplazar_izq(h1, 26)), 4294967295)\n    sea f1 = __y_bits(__o_bits(__desplazar_der(h1, 6), __desplazar_izq(h2, 20)), 4294967295)\n    sea f2 = __y_bits(__o_bits(__desplazar_der(h2, 12), __desplazar_izq(h3, 14)), 4294967295)\n    sea f3 = __y_bits(__o_bits(__desplazar_der(h3, 18), __desplazar_izq(h4, 8)), 4294967295)\n    sea t0 = f0 + le32(clave, 16)\n    sea t1 = f1 + le32(clave, 20) + __desplazar_der(t0, 32)\n    sea t2 = f2 + le32(clave, 24) + __desplazar_der(t1, 32)\n    sea t3 = f3 + le32(clave, 28) + __desplazar_der(t2, 32)\n    sea r = str_nuevo(16)\n    agregar_le32(r, t0)\n    agregar_le32(r, t1)\n    agregar_le32(r, t2)\n    agregar_le32(r, t3)\n    retornar r\n}\n\n// ── AEAD ChaCha20-Poly1305 (RFC 8439) y XChaCha20-Poly1305 ─────────────\n\nfuncion relleno16(r, n) {\n    mientras (n % 16 != 0) {\n        str_agregar_byte(r, 0)\n        n = n + 1\n    }\n    retornar 0\n}\n\nfuncion aead_etiqueta(clave, nonce, aad, cifrado) {\n    sea otk = str_rebanar(chacha_bloque(clave, 0, nonce), 0, 32)\n    sea mac = str_nuevo(str_largo(aad) + str_largo(cifrado) + 48)\n    str_agregar(mac, aad)\n    relleno16(mac, str_largo(aad))\n    str_agregar(mac, cifrado)\n    relleno16(mac, str_largo(cifrado))\n    agregar_le64(mac, str_largo(aad))\n    agregar_le64(mac, str_largo(cifrado))\n    retornar poly1305_crudo(otk, mac)\n}\n\n// cifrar → cifrado || etiqueta; descifrar → texto o -1.\nfuncion aead_crudo(clave, nonce, texto, aad, cifrar) {\n    si (str_largo(clave) != 32) { dyn_error(\"chacha20_poly1305: la clave debe tener 32 bytes\") }\n    si (str_largo(nonce) == 24) {\n        clave = hchacha20(clave, str_rebanar(nonce, 0, 16))\n        sea n12 = str_nuevo(12)\n        agregar_le32(n12, 0)\n        str_agregar(n12, str_rebanar(nonce, 16, 24))\n        nonce = n12\n    }\n    si (str_largo(nonce) != 12) { dyn_error(\"chacha20_poly1305: el nonce debe tener 12 bytes (o 24 con XChaCha20)\") }\n    si (cifrar) {\n        sea c = chacha20_xor(clave, 1, nonce, texto)\n        str_agregar(c, aead_etiqueta(clave, nonce, aad, c))\n        retornar c\n    }\n    sea n = str_largo(texto)\n    si (n < 16) { retornar 0 - 1 }\n    sea cifrado = str_rebanar(texto, 0, n - 16)\n    sea etiqueta = aead_etiqueta(clave, nonce, aad, cifrado)\n    sea d = 0\n    sea i = 0\n    mientras (i < 16) {\n        d = __o_bits(d, __xo_bits(str_byte(etiqueta, i), str_byte(texto, n - 16 + i)))\n        i = i + 1\n    }\n    si (d != 0) { retornar 0 - 1 }\n    retornar chacha20_xor(clave, 1, nonce, cifrado)\n}\n\nfuncion chacha20_poly1305_cifrar(clave, nonce, texto, aad) {\n    sea a = \"\"\n    si (aad != 0) { a = dyn_a_str(aad) }\n    retornar dyn_texto(aead_crudo(dyn_a_str(clave), dyn_a_str(nonce), dyn_a_str(texto), a, 1))\n}\n\nfuncion chacha20_poly1305_descifrar(clave, nonce, cifrado, aad) {\n    sea a = \"\"\n    si (aad != 0) { a = dyn_a_str(aad) }\n    sea r = aead_crudo(dyn_a_str(clave), dyn_a_str(nonce), dyn_a_str(cifrado), a, 0)\n    si (r == 0 - 1) { dyn_error(\"chacha20_poly1305_descifrar: la etiqueta no coincide (clave, nonce o datos alterados)\") }\n    retornar dyn_texto(r)\n}\n\nfuncion poly1305(clave, mensaje) {\n    sea k = dyn_a_str(clave)\n    si (str_largo(k) != 32) { dyn_error(\"poly1305: la clave debe tener 32 bytes\") }\n    retornar dyn_texto(poly1305_crudo(k, dyn_a_str(mensaje)))\n}\n\n// Caja segura por defecto (como crypto_secretbox / aead de Monocypher):\n// XChaCha20-Poly1305 con nonce aleatorio de 24 bytes al inicio. El usuario\n// no maneja nonces: caja_abrir(clave, caja_cerrar(clave, t)) == t.\nfuncion caja_cerrar(clave, texto) {\n    sea nonce = str_nuevo(24)\n    si (sys_aleatorio(str_datos(nonce), 24) != 0) { dyn_error(\"caja_cerrar: sin bytes aleatorios\") }\n    __guardar64(nonce, 24)\n    sea r = str_nuevo(str_largo(dyn_a_str(texto)) + 40)\n    str_agregar(r, nonce)\n    str_agregar(r, aead_crudo(dyn_a_str(clave), nonce, dyn_a_str(texto), \"\", 1))\n    retornar dyn_texto(r)\n}\n\nfuncion caja_abrir(clave, caja) {\n    sea c = dyn_a_str(caja)\n    si (str_largo(c) < 40) { dyn_error(\"caja_abrir: datos incompletos\") }\n    sea r = aead_crudo(dyn_a_str(clave), str_rebanar(c, 0, 24), str_rebanar(c, 24, str_largo(c)), \"\", 0)\n    si (r == 0 - 1) { dyn_error(\"caja_abrir: la clave no corresponde o los datos fueron alterados\") }\n    retornar dyn_texto(r)\n}\n\n// ── BLAKE2b (RFC 7693) ──────────────────────────────────────────────────\n\nfuncion b2_iv(i) {\n    si (i == 0) { retornar cr_hex64(\"6a09e667f3bcc908\", 0) }\n    si (i == 1) { retornar cr_hex64(\"bb67ae8584caa73b\", 0) }\n    si (i == 2) { retornar cr_hex64(\"3c6ef372fe94f82b\", 0) }\n    si (i == 3) { retornar cr_hex64(\"a54ff53a5f1d36f1\", 0) }\n    si (i == 4) { retornar cr_hex64(\"510e527fade682d1\", 0) }\n    si (i == 5) { retornar cr_hex64(\"9b05688c2b3e6c1f\", 0) }\n    si (i == 6) { retornar cr_hex64(\"1f83d9abfb41bd6b\", 0) }\n    retornar cr_hex64(\"5be0cd19137e2179\", 0)\n}\n\nfuncion b2_sigma() {\n    retornar \"0123456789abcdefea489fd61c02b753b8c052fdae3671947931dcbe265a40f8905724afe1bc683d2c6a0b834d75fe19c51fed4a0763928bdb7ec13950f4862a6fe9b308c2d714a5a2847615fb9e3cd0\"\n}\n\nfuncion b2_g(v, a, b, c, d, x, y) {\n    __guardar64(v + a * 8, __cargar64(v + a * 8) + __cargar64(v + b * 8) + x)\n    __guardar64(v + d * 8, rotd64(__xo_bits(__cargar64(v + d * 8), __cargar64(v + a * 8)), 32))\n    __guardar64(v + c * 8, __cargar64(v + c * 8) + __cargar64(v + d * 8))\n    __guardar64(v + b * 8, rotd64(__xo_bits(__cargar64(v + b * 8), __cargar64(v + c * 8)), 24))\n    __guardar64(v + a * 8, __cargar64(v + a * 8) + __cargar64(v + b * 8) + y)\n    __guardar64(v + d * 8, rotd64(__xo_bits(__cargar64(v + d * 8), __cargar64(v + a * 8)), 16))\n    __guardar64(v + c * 8, __cargar64(v + c * 8) + __cargar64(v + d * 8))\n    __guardar64(v + b * 8, rotd64(__xo_bits(__cargar64(v + b * 8), __cargar64(v + c * 8)), 63))\n    retornar 0\n}\n\n// Comprime el bloque de 128 bytes en h (8 palabras).\nfuncion b2_comprimir(h, bloque, t, ultimo) {\n    sea v = mem_reservar(16 * 8)\n    sea m = mem_reservar(16 * 8)\n    sea i = 0\n    mientras (i < 8) {\n        __guardar64(v + i * 8, __cargar64(h + i * 8))\n        __guardar64(v + (i + 8) * 8, b2_iv(i))\n        i = i + 1\n    }\n    i = 0\n    mientras (i < 16) {\n        __guardar64(m + i * 8, le64(bloque, i * 8))\n        i = i + 1\n    }\n    __guardar64(v + 12 * 8, __xo_bits(__cargar64(v + 12 * 8), t))\n    si (ultimo) { __guardar64(v + 14 * 8, __xo_bits(__cargar64(v + 14 * 8), 0 - 1)) }\n    sea sg = b2_sigma()\n    sea r = 0\n    mientras (r < 12) {\n        sea base = (r % 10) * 16\n        sea s = mem_reservar(16 * 8)\n        sea k = 0\n        mientras (k < 16) {\n            __guardar64(s + k * 8, valor_hex(str_byte(sg, base + k)))\n            k = k + 1\n        }\n        b2_g(v, 0, 4, 8, 12, __cargar64(m + __cargar64(s) * 8), __cargar64(m + __cargar64(s + 8) * 8))\n        b2_g(v, 1, 5, 9, 13, __cargar64(m + __cargar64(s + 16) * 8), __cargar64(m + __cargar64(s + 24) * 8))\n        b2_g(v, 2, 6, 10, 14, __cargar64(m + __cargar64(s + 32) * 8), __cargar64(m + __cargar64(s + 40) * 8))\n        b2_g(v, 3, 7, 11, 15, __cargar64(m + __cargar64(s + 48) * 8), __cargar64(m + __cargar64(s + 56) * 8))\n        b2_g(v, 0, 5, 10, 15, __cargar64(m + __cargar64(s + 64) * 8), __cargar64(m + __cargar64(s + 72) * 8))\n        b2_g(v, 1, 6, 11, 12, __cargar64(m + __cargar64(s + 80) * 8), __cargar64(m + __cargar64(s + 88) * 8))\n        b2_g(v, 2, 7, 8, 13, __cargar64(m + __cargar64(s + 96) * 8), __cargar64(m + __cargar64(s + 104) * 8))\n        b2_g(v, 3, 4, 9, 14, __cargar64(m + __cargar64(s + 112) * 8), __cargar64(m + __cargar64(s + 120) * 8))\n        cr_liberar(s)\n        r = r + 1\n    }\n    i = 0\n    mientras (i < 8) {\n        __guardar64(h + i * 8, __xo_bits(__xo_bits(__cargar64(h + i * 8), __cargar64(v + i * 8)), __cargar64(v + (i + 8) * 8)))\n        i = i + 1\n    }\n    cr_liberar(v)\n    cr_liberar(m)\n    retornar 0\n}\n\n// BLAKE2b con salida de n bytes (1..64) y clave opcional (0..64).\nfuncion blake2b_crudo(m, n, clave) {\n    sea h = mem_reservar(8 * 8)\n    sea i = 0\n    mientras (i < 8) {\n        __guardar64(h + i * 8, b2_iv(i))\n        i = i + 1\n    }\n    __guardar64(h, __xo_bits(__cargar64(h), __o_bits(__o_bits(16842752, __desplazar_izq(str_largo(clave), 8)), n)))\n    sea datos = m\n    si (str_largo(clave) > 0) {\n        datos = str_nuevo(128 + str_largo(m))\n        str_agregar(datos, clave)\n        relleno_hasta(datos, 128)\n        str_agregar(datos, m)\n    }\n    sea total = str_largo(datos)\n    sea t = 0\n    sea pos = 0\n    mientras (total - pos > 128) {\n        t = t + 128\n        b2_comprimir(h, str_rebanar(datos, pos, pos + 128), t, 0)\n        pos = pos + 128\n    }\n    sea ultimo = str_rebanar(datos, pos, total)\n    t = t + str_largo(ultimo)\n    relleno_hasta(ultimo, 128)\n    b2_comprimir(h, ultimo, t, 1)\n    sea r = str_nuevo(64)\n    i = 0\n    mientras (i < 8) {\n        agregar_le64(r, __cargar64(h + i * 8))\n        i = i + 1\n    }\n    cr_liberar(h)\n    retornar str_rebanar(r, 0, n)\n}\n\nfuncion relleno_hasta(s, n) {\n    mientras (str_largo(s) < n) { str_agregar_byte(s, 0) }\n    retornar 0\n}\n\nfuncion blake2b(mensaje, largo, clave) {\n    sea n = 64\n    si (largo != 0 y dyn_valor_entero(largo) != 0) { n = dyn_valor_entero(largo) }\n    si (n < 1 o n > 64) { dyn_error(\"blake2b: el largo debe ser 1..64\") }\n    sea k = \"\"\n    si (clave != 0) { k = dyn_a_str(clave) }\n    si (str_largo(k) > 64) { dyn_error(\"blake2b: la clave admite hasta 64 bytes\") }\n    retornar dyn_texto(blake2b_crudo(dyn_a_str(mensaje), n, k))\n}\n\n// H' de Argon2 (resumen de largo variable).\nfuncion argon2_h(largo, entrada) {\n    sea x = str_nuevo(str_largo(entrada) + 4)\n    agregar_le32(x, largo)\n    str_agregar(x, entrada)\n    si (largo <= 64) { retornar blake2b_crudo(x, largo, \"\") }\n    sea r = str_nuevo(largo)\n    sea v = blake2b_crudo(x, 64, \"\")\n    str_agregar(r, str_rebanar(v, 0, 32))\n    mientras (largo - str_largo(r) > 64) {\n        v = blake2b_crudo(v, 64, \"\")\n        str_agregar(r, str_rebanar(v, 0, 32))\n    }\n    v = blake2b_crudo(v, largo - str_largo(r), \"\")\n    str_agregar(r, v)\n    retornar r\n}\n\n// ── Argon2id (RFC 9106) ─────────────────────────────────────────────────\n// Bloques de 1024 bytes (128 palabras de 64 bits) en memoria propia.\n\nfuncion bla_mka(x, y) {\n    retornar x + y + 2 * __y_bits(x, 4294967295) * __y_bits(y, 4294967295)\n}\n\nfuncion argon2_gb(v, a, b, c, d) {\n    __guardar64(v + a * 8, bla_mka(__cargar64(v + a * 8), __cargar64(v + b * 8)))\n    __guardar64(v + d * 8, rotd64(__xo_bits(__cargar64(v + d * 8), __cargar64(v + a * 8)), 32))\n    __guardar64(v + c * 8, bla_mka(__cargar64(v + c * 8), __cargar64(v + d * 8)))\n    __guardar64(v + b * 8, rotd64(__xo_bits(__cargar64(v + b * 8), __cargar64(v + c * 8)), 24))\n    __guardar64(v + a * 8, bla_mka(__cargar64(v + a * 8), __cargar64(v + b * 8)))\n    __guardar64(v + d * 8, rotd64(__xo_bits(__cargar64(v + d * 8), __cargar64(v + a * 8)), 16))\n    __guardar64(v + c * 8, bla_mka(__cargar64(v + c * 8), __cargar64(v + d * 8)))\n    __guardar64(v + b * 8, rotd64(__xo_bits(__cargar64(v + b * 8), __cargar64(v + c * 8)), 63))\n    retornar 0\n}\n\n// P sobre 16 palabras en posiciones dadas (i0..i15 en el arreglo idx).\nfuncion argon2_p(z, idx) {\n    sea v = mem_reservar(16 * 8)\n    sea k = 0\n    mientras (k < 16) {\n        __guardar64(v + k * 8, __cargar64(z + __cargar64(idx + k * 8) * 8))\n        k = k + 1\n    }\n    argon2_gb(v, 0, 4, 8, 12)\n    argon2_gb(v, 1, 5, 9, 13)\n    argon2_gb(v, 2, 6, 10, 14)\n    argon2_gb(v, 3, 7, 11, 15)\n    argon2_gb(v, 0, 5, 10, 15)\n    argon2_gb(v, 1, 6, 11, 12)\n    argon2_gb(v, 2, 7, 8, 13)\n    argon2_gb(v, 3, 4, 9, 14)\n    k = 0\n    mientras (k < 16) {\n        __guardar64(z + __cargar64(idx + k * 8) * 8, __cargar64(v + k * 8))\n        k = k + 1\n    }\n    cr_liberar(v)\n    retornar 0\n}\n\n// destino ← G(x, y) (si xorear, destino ← destino ⊕ G(x, y)).\nfuncion argon2_g(destino, x, y, xorear) {\n    sea r = mem_reservar(1024)\n    sea z = mem_reservar(1024)\n    sea k = 0\n    mientras (k < 128) {\n        sea w = __xo_bits(__cargar64(x + k * 8), __cargar64(y + k * 8))\n        __guardar64(r + k * 8, w)\n        __guardar64(z + k * 8, w)\n        k = k + 1\n    }\n    sea idx = mem_reservar(16 * 8)\n    // Filas: 8 grupos de 16 palabras seguidas.\n    sea f = 0\n    mientras (f < 8) {\n        k = 0\n        mientras (k < 16) {\n            __guardar64(idx + k * 8, f * 16 + k)\n            k = k + 1\n        }\n        argon2_p(z, idx)\n        f = f + 1\n    }\n    // Columnas: pares de palabras 2c, 2c+1 de cada fila.\n    sea col = 0\n    mientras (col < 8) {\n        k = 0\n        mientras (k < 8) {\n            __guardar64(idx + (2 * k) * 8, k * 16 + 2 * col)\n            __guardar64(idx + (2 * k + 1) * 8, k * 16 + 2 * col + 1)\n            k = k + 1\n        }\n        argon2_p(z, idx)\n        col = col + 1\n    }\n    k = 0\n    mientras (k < 128) {\n        sea w = __xo_bits(__cargar64(z + k * 8), __cargar64(r + k * 8))\n        si (xorear) { w = __xo_bits(w, __cargar64(destino + k * 8)) }\n        __guardar64(destino + k * 8, w)\n        k = k + 1\n    }\n    cr_liberar(r)\n    cr_liberar(z)\n    cr_liberar(idx)\n    retornar 0\n}\n\nfuncion bloque_de_texto(p, s) {\n    sea k = 0\n    mientras (k < 128) {\n        __guardar64(p + k * 8, le64(s, k * 8))\n        k = k + 1\n    }\n    retornar 0\n}\n\nfuncion argon2id_crudo(clave, sal, t_coste, m_coste, lanes, largo, secreto, extra) {\n    si (lanes < 1) { lanes = 1 }\n    si (m_coste < 8 * lanes) { m_coste = 8 * lanes }\n    sea q = (m_coste / (4 * lanes)) * 4\n    sea m = q * lanes\n    sea seg = q / 4\n    // H0\n    sea h = str_nuevo(256)\n    agregar_le32(h, lanes)\n    agregar_le32(h, largo)\n    agregar_le32(h, m_coste)\n    agregar_le32(h, t_coste)\n    agregar_le32(h, 19)\n    agregar_le32(h, 2)\n    agregar_le32(h, str_largo(clave)) str_agregar(h, clave)\n    agregar_le32(h, str_largo(sal)) str_agregar(h, sal)\n    agregar_le32(h, str_largo(secreto)) str_agregar(h, secreto)\n    agregar_le32(h, str_largo(extra)) str_agregar(h, extra)\n    sea h0 = blake2b_crudo(h, 64, \"\")\n    sea memoria = mem_reservar(m * 1024)\n    sea l = 0\n    mientras (l < lanes) {\n        sea k = 0\n        mientras (k < 2) {\n            sea e = str_nuevo(72)\n            str_agregar(e, h0)\n            agregar_le32(e, k)\n            agregar_le32(e, l)\n            bloque_de_texto(memoria + (l * q + k) * 1024, argon2_h(1024, e))\n            k = k + 1\n        }\n        l = l + 1\n    }\n    sea cero = mem_reservar(1024)\n    mem_llenar(cero, 0, 1024)\n    sea entrada = mem_reservar(1024)\n    sea direcciones = mem_reservar(1024)\n    sea pasada = 0\n    mientras (pasada < t_coste) {\n        sea s = 0\n        mientras (s < 4) {\n            l = 0\n            mientras (l < lanes) {\n                sea independiente = pasada == 0 y s < 2\n                si (independiente) {\n                    mem_llenar(entrada, 0, 1024)\n                    __guardar64(entrada, pasada)\n                    __guardar64(entrada + 8, l)\n                    __guardar64(entrada + 16, s)\n                    __guardar64(entrada + 24, m)\n                    __guardar64(entrada + 32, t_coste)\n                    __guardar64(entrada + 40, 2)\n                }\n                sea i = 0\n                si (pasada == 0 y s == 0) {\n                    i = 2\n                    si (independiente) {\n                        __guardar64(entrada + 48, __cargar64(entrada + 48) + 1)\n                        argon2_g(direcciones, cero, entrada, 0)\n                        argon2_g(direcciones, cero, direcciones, 0)\n                    }\n                }\n                mientras (i < seg) {\n                    sea j = l * q + s * seg + i\n                    sea previo = j - 1\n                    si (s * seg + i == 0) { previo = l * q + q - 1 }\n                    sea pseudo = 0\n                    si (independiente) {\n                        si (i % 128 == 0) {\n                            __guardar64(entrada + 48, __cargar64(entrada + 48) + 1)\n                            argon2_g(direcciones, cero, entrada, 0)\n                            argon2_g(direcciones, cero, direcciones, 0)\n                        }\n                        pseudo = __cargar64(direcciones + (i % 128) * 8)\n                    } sino {\n                        pseudo = __cargar64(memoria + previo * 1024)\n                    }\n                    sea j1 = __y_bits(pseudo, 4294967295)\n                    sea j2 = __desplazar_der(pseudo, 32)\n                    sea carril = j2 % lanes\n                    si (pasada == 0 y s == 0) { carril = l }\n                    // Tamaño del conjunto de referencia (RFC 9106 §3.4.1.2).\n                    sea area = 0\n                    si (pasada == 0) {\n                        si (carril == l) { area = s * seg + i - 1 } sino {\n                            area = s * seg\n                            si (i == 0) { area = area - 1 }\n                        }\n                    } sino {\n                        si (carril == l) { area = q - seg + i - 1 } sino {\n                            area = q - seg\n                            si (i == 0) { area = area - 1 }\n                        }\n                    }\n                    sea x = __desplazar_der(j1 * j1, 32)\n                    sea y = __desplazar_der(area * x, 32)\n                    sea zz = area - 1 - y\n                    sea inicio = 0\n                    si (pasada != 0 y s != 3) { inicio = (s + 1) * seg }\n                    sea ref = carril * q + (inicio + zz) % q\n                    argon2_g(memoria + j * 1024, memoria + previo * 1024, memoria + ref * 1024, pasada > 0)\n                    i = i + 1\n                }\n                l = l + 1\n            }\n            s = s + 1\n        }\n        pasada = pasada + 1\n    }\n    // XOR de los últimos bloques de cada carril y H' final.\n    sea final = mem_reservar(1024)\n    mem_llenar(final, 0, 1024)\n    l = 0\n    mientras (l < lanes) {\n        sea k = 0\n        mientras (k < 128) {\n            __guardar64(final + k * 8, __xo_bits(__cargar64(final + k * 8), __cargar64(memoria + (l * q + q - 1) * 1024 + k * 8)))\n            k = k + 1\n        }\n        l = l + 1\n    }\n    sea bytes = str_nuevo(1024)\n    sea k = 0\n    mientras (k < 128) {\n        agregar_le64(bytes, __cargar64(final + k * 8))\n        k = k + 1\n    }\n    mem_llenar(memoria, 0, m * 1024)\n    cr_liberar(memoria)\n    retornar argon2_h(largo, bytes)\n}\n\nfuncion argon2id(clave, sal, iteraciones, memoria_kib, paralelismo, largo) {\n    sea s = dyn_a_str(sal)\n    si (str_largo(s) < 8) { dyn_error(\"argon2id: la sal debe tener al menos 8 bytes\") }\n    retornar dyn_texto(argon2id_crudo(dyn_a_str(clave), s, dyn_valor_entero(iteraciones), dyn_valor_entero(memoria_kib), dyn_valor_entero(paralelismo), dyn_valor_entero(largo), \"\", \"\"))\n}\n\n// ── BLAKE3 ──────────────────────────────────────────────────────────────\n\nfuncion b3_iv(i) {\n    si (i == 0) { retornar 1779033703 }\n    si (i == 1) { retornar 3144134277 }\n    si (i == 2) { retornar 1013904242 }\n    si (i == 3) { retornar 2773480762 }\n    si (i == 4) { retornar 1359893119 }\n    si (i == 5) { retornar 2600822924 }\n    si (i == 6) { retornar 528734635 }\n    retornar 1541459225\n}\n\nfuncion b3_g(v, a, b, c, d, x, y) {\n    f32(v, a, m32(v, a) + m32(v, b) + x) f32(v, d, rotd32(__xo_bits(m32(v, d), m32(v, a)), 16))\n    f32(v, c, m32(v, c) + m32(v, d)) f32(v, b, rotd32(__xo_bits(m32(v, b), m32(v, c)), 12))\n    f32(v, a, m32(v, a) + m32(v, b) + y) f32(v, d, rotd32(__xo_bits(m32(v, d), m32(v, a)), 8))\n    f32(v, c, m32(v, c) + m32(v, d)) f32(v, b, rotd32(__xo_bits(m32(v, b), m32(v, c)), 7))\n    retornar 0\n}\n\n// Compresión: cv (8 palabras), bloque (16 palabras), contador, largo y\n// banderas → 16 palabras de salida.\nfuncion b3_comprimir(cv, m, contador, largo, banderas) {\n    sea v = mem_reservar(16 * 8)\n    sea i = 0\n    mientras (i < 8) {\n        f32(v, i, m32(cv, i))\n        i = i + 1\n    }\n    f32(v, 8, b3_iv(0)) f32(v, 9, b3_iv(1)) f32(v, 10, b3_iv(2)) f32(v, 11, b3_iv(3))\n    f32(v, 12, contador) f32(v, 13, __desplazar_der(contador, 32)) f32(v, 14, largo) f32(v, 15, banderas)\n    sea w = mem_reservar(16 * 8)\n    i = 0\n    mientras (i < 16) {\n        f32(w, i, m32(m, i))\n        i = i + 1\n    }\n    sea perm = \"263a704d1bc59ef8\"\n    sea r = 0\n    mientras (r < 7) {\n        b3_g(v, 0, 4, 8, 12, m32(w, 0), m32(w, 1))\n        b3_g(v, 1, 5, 9, 13, m32(w, 2), m32(w, 3))\n        b3_g(v, 2, 6, 10, 14, m32(w, 4), m32(w, 5))\n        b3_g(v, 3, 7, 11, 15, m32(w, 6), m32(w, 7))\n        b3_g(v, 0, 5, 10, 15, m32(w, 8), m32(w, 9))\n        b3_g(v, 1, 6, 11, 12, m32(w, 10), m32(w, 11))\n        b3_g(v, 2, 7, 8, 13, m32(w, 12), m32(w, 13))\n        b3_g(v, 3, 4, 9, 14, m32(w, 14), m32(w, 15))\n        sea p = mem_reservar(16 * 8)\n        i = 0\n        mientras (i < 16) {\n            f32(p, i, m32(w, valor_hex(str_byte(perm, i))))\n            i = i + 1\n        }\n        cr_liberar(w)\n        w = p\n        r = r + 1\n    }\n    i = 0\n    mientras (i < 8) {\n        f32(v, i, __xo_bits(m32(v, i), m32(v, i + 8)))\n        f32(v, i + 8, __xo_bits(m32(v, i + 8), m32(cv, i)))\n        i = i + 1\n    }\n    cr_liberar(w)\n    retornar v\n}\n\nfuncion b3_palabras(s, i) {\n    sea m = mem_reservar(16 * 8)\n    sea b = str_nuevo(64)\n    sea k = 0\n    mientras (k < 64) {\n        si (i + k < str_largo(s)) { str_agregar_byte(b, str_byte(s, i + k)) } sino { str_agregar_byte(b, 0) }\n        k = k + 1\n    }\n    k = 0\n    mientras (k < 16) {\n        f32(m, k, le32(b, k * 4))\n        k = k + 1\n    }\n    retornar m\n}\n\n// Chunk de hasta 1024 bytes → salida \"pendiente\" [cv o clave, bloque, largo, banderas, contador].\nfuncion b3_nodo(cv, m, contador, largo, banderas) {\n    sea n = mem_reservar(48)\n    __guardar64(n, cv)\n    __guardar64(n + 8, m)\n    __guardar64(n + 16, contador)\n    __guardar64(n + 24, largo)\n    __guardar64(n + 32, banderas)\n    retornar n\n}\n\nfuncion b3_chunk(clave, s, inicio, fin, contador, banderas_base) {\n    sea cv = mem_reservar(8 * 8)\n    sea i = 0\n    mientras (i < 8) {\n        f32(cv, i, m32(clave, i))\n        i = i + 1\n    }\n    sea pos = inicio\n    sea bloques = (fin - inicio + 63) / 64\n    si (bloques == 0) { bloques = 1 }\n    sea b = 0\n    mientras (b < bloques - 1) {\n        sea banderas = banderas_base\n        si (b == 0) { banderas = __o_bits(banderas, 1) }\n        sea salida = b3_comprimir(cv, b3_palabras(str_rebanar(s, pos, pos + 64), 0), contador, 64, banderas)\n        i = 0\n        mientras (i < 8) {\n            f32(cv, i, m32(salida, i))\n            i = i + 1\n        }\n        pos = pos + 64\n        b = b + 1\n    }\n    sea banderas = __o_bits(banderas_base, 2)\n    si (bloques == 1) { banderas = __o_bits(banderas, 1) }\n    retornar b3_nodo(cv, b3_palabras(str_rebanar(s, pos, fin), 0), contador, fin - pos, banderas)\n}\n\nfuncion b3_cv_de(nodo) {\n    sea o = b3_comprimir(__cargar64(nodo), __cargar64(nodo + 8), __cargar64(nodo + 16), __cargar64(nodo + 24), __cargar64(nodo + 32))\n    retornar o\n}\n\nfuncion b3_padre(clave, izq, der, banderas_base) {\n    sea m = mem_reservar(16 * 8)\n    sea i = 0\n    mientras (i < 8) {\n        f32(m, i, m32(izq, i))\n        f32(m, i + 8, m32(der, i))\n        i = i + 1\n    }\n    retornar b3_nodo(clave, m, 0, 64, __o_bits(banderas_base, 4))\n}\n\n// BLAKE3 (modo hash, keyed o derive_key) con salida de n bytes.\nfuncion blake3_crudo(clave_palabras, s, n, banderas_base) {\n    sea total = str_largo(s)\n    sea chunks = (total + 1023) / 1024\n    si (chunks == 0) { chunks = 1 }\n    sea pila = vec_nuevo()\n    sea nodo = 0\n    sea c = 0\n    mientras (c < chunks) {\n        sea fin = (c + 1) * 1024\n        si (fin > total) { fin = total }\n        nodo = b3_chunk(clave_palabras, s, c * 1024, fin, c, banderas_base)\n        si (c < chunks - 1) {\n            // Cerrar el chunk y combinar según los bits del contador.\n            sea cv = b3_cv_de(nodo)\n            sea t = c + 1\n            mientras (t % 2 == 0) {\n                cv = b3_cv_de(b3_padre(clave_palabras, vec_quitar_ultimo(pila), cv, banderas_base))\n                t = t / 2\n            }\n            vec_agregar(pila, cv)\n        }\n        c = c + 1\n    }\n    mientras (vec_largo(pila) > 0) {\n        nodo = b3_padre(clave_palabras, vec_quitar_ultimo(pila), b3_cv_de(nodo), banderas_base)\n    }\n    // Raíz con salida extensible (XOF).\n    sea r = str_nuevo(n + 64)\n    sea contador = 0\n    mientras (str_largo(r) < n) {\n        sea o = b3_comprimir(__cargar64(nodo), __cargar64(nodo + 8), contador, __cargar64(nodo + 24), __o_bits(__cargar64(nodo + 32), 8))\n        sea i = 0\n        mientras (i < 16) {\n            agregar_le32(r, m32(o, i))\n            i = i + 1\n        }\n        contador = contador + 1\n    }\n    retornar str_rebanar(r, 0, n)\n}\n\nfuncion b3_clave_iv() {\n    sea k = mem_reservar(8 * 8)\n    sea i = 0\n    mientras (i < 8) {\n        f32(k, i, b3_iv(i))\n        i = i + 1\n    }\n    retornar k\n}\n\nfuncion b3_clave_de(s) {\n    sea k = mem_reservar(8 * 8)\n    sea i = 0\n    mientras (i < 8) {\n        f32(k, i, le32(s, i * 4))\n        i = i + 1\n    }\n    retornar k\n}\n\nfuncion blake3(mensaje, largo, clave) {\n    sea n = 32\n    si (largo != 0 y dyn_valor_entero(largo) != 0) { n = dyn_valor_entero(largo) }\n    si (clave != 0) {\n        sea k = dyn_a_str(clave)\n        si (str_largo(k) != 32) { dyn_error(\"blake3: la clave debe tener 32 bytes\") }\n        retornar dyn_texto(blake3_crudo(b3_clave_de(k), dyn_a_str(mensaje), n, 16))\n    }\n    retornar dyn_texto(blake3_crudo(b3_clave_iv(), dyn_a_str(mensaje), n, 0))\n}\n\n// derive_key de BLAKE3: contexto fijo de la aplicación + material.\nfuncion blake3_derivar(contexto, material, largo) {\n    sea ck = blake3_crudo(b3_clave_iv(), dyn_a_str(contexto), 32, 32)\n    retornar dyn_texto(blake3_crudo(b3_clave_de(ck), dyn_a_str(material), dyn_valor_entero(largo), 64))\n}\n" }
    si (i == 17) { retornar "// runtime/medios.cfv — imágenes, compresión y rasterizado en C-Forge puro.\n//\n// Código puente (enteros crudos y memoria) para que decodificar, comprimir y\n// pintar sea rápido sin depender de zlib, libpng, libjpeg, stb ni SDL_image:\n//   · CRC-32, Adler-32, inflate (RFC 1951) y deflate con LZ77 + Huffman.\n//   · PNG: todos los tipos de color, profundidades 1–16, paleta, tRNS y\n//     entrelazado Adam7; codificador RGBA/RGB con filtros adaptativos.\n//   · JPEG: baseline y progresivo, Huffman, IDCT entera, submuestreo\n//     4:4:4 / 4:2:2 / 4:2:0, escala de grises y CMYK de Adobe.\n//   · BMP de 8, 24 y 32 bits.\n//   · Rasterizado RGBA: rectángulos con mezcla alfa, líneas, polígonos con\n//     antialiasing (regla nonzero, el mismo método sirve para fuentes TTF),\n//     copia de imágenes escaladas y triángulos 3D con z-buffer, color por\n//     vértice y texturas con corrección de perspectiva.\n// Las imágenes son RGBA de 8 bits por canal, fila por fila, de arriba abajo.\n\nfuncion md_ent(v) {\n    si (__y_bits(v, 1) == 1) { retornar dyn_valor_entero(v) }\n    retornar __f64_a_entero(dyn_a_f64(v))\n}\n\n// Texto nuevo de n bytes en cero (con el 0 final).\nfuncion md_buffer(n) {\n    si (n < 0) { dyn_error(\"medios: tamaño de búfer negativo\") }\n    sea s = str_nuevo(n)\n    mem_llenar(str_datos(s), 0, n + 1)\n    __guardar64(s, n)\n    retornar s\n}\n\n// Búfer de ancho × alto × bpp bytes con aritmética saturada: ningún factor\n// negativo y el producto se comprueba contra el tope ANTES de multiplicar\n// (a > tope / b), así un desbordamiento nunca produce un búfer chico.\n// Tope: 4 GiB (una imagen válida ocupa como máximo 1 GiB en RGBA).\nfuncion md_buffer_seguro(ancho, alto, bpp) {\n    sea tope = 4294967296\n    si (ancho < 0 o alto < 0 o bpp < 0) { dyn_error(\"medios: dimensiones negativas\") }\n    si (ancho > 0 y alto > tope / ancho) { dyn_error(\"medios: búfer demasiado grande (desbordamiento)\") }\n    sea pixeles = ancho * alto\n    si (bpp > 0 y pixeles > tope / bpp) { dyn_error(\"medios: búfer demasiado grande (desbordamiento)\") }\n    retornar md_buffer(pixeles * bpp)\n}\n\n// Imágenes: como máximo 65535 por lado y 268 megapíxeles (1 GiB en RGBA),\n// para que una cabecera falsa no haga reservar y llenar decenas de GiB.\nfuncion md_validar_dimensiones(formato, ancho, alto) {\n    si (ancho <= 0 o alto <= 0 o ancho > 65535 o alto > 65535) { dyn_error(str_concatenar(formato, \": dimensiones inválidas\")) }\n    si (ancho * alto > 268435456) { dyn_error(str_concatenar(formato, \": imagen demasiado grande (máx. 268 megapíxeles)\")) }\n    retornar 0\n}\n\nfuncion md_lista3(a, b, c) {\n    sea v = vec_nuevo()\n    vec_agregar(v, a)\n    vec_agregar(v, b)\n    vec_agregar(v, c)\n    retornar dyn_caja(2, v)\n}\n\nfuncion md_be32(p) {\n    retornar __o_bits(__o_bits(__desplazar_izq(__cargar8(p), 24), __desplazar_izq(__cargar8(p + 1), 16)), __o_bits(__desplazar_izq(__cargar8(p + 2), 8), __cargar8(p + 3)))\n}\nfuncion md_be16(p) { retornar __o_bits(__desplazar_izq(__cargar8(p), 8), __cargar8(p + 1)) }\nfuncion md_le16(p) { retornar __o_bits(__cargar8(p), __desplazar_izq(__cargar8(p + 1), 8)) }\nfuncion md_le32(p) { retornar __o_bits(md_le16(p), __desplazar_izq(md_le16(p + 2), 16)) }\n// Agrega bytes escritos en decimal separados por comas (\"1,2,255\").\nfuncion md_agregar_bytes(s, lista) {\n    sea v = 0\n    sea i = 0\n    mientras (i <= str_largo(lista)) {\n        sea b = 44\n        si (i < str_largo(lista)) { b = str_byte(lista, i) }\n        si (b == 44) {\n            str_agregar_byte(s, v)\n            v = 0\n        } sino { v = v * 10 + b - 48 }\n        i = i + 1\n    }\n    retornar 0\n}\n\nfuncion md_agregar_be32(s, v) {\n    str_agregar_byte(s, __y_bits(__desplazar_der(v, 24), 255))\n    str_agregar_byte(s, __y_bits(__desplazar_der(v, 16), 255))\n    str_agregar_byte(s, __y_bits(__desplazar_der(v, 8), 255))\n    str_agregar_byte(s, __y_bits(v, 255))\n    retornar 0\n}\n\n// ── CRC-32 y Adler-32 ──────────────────────────────────────────────────────\n\nfuncion md_tabla_crc() {\n    sea t = mem_global(30)\n    si (t != 0) { retornar t }\n    t = mem_reservar(256 * 8)\n    sea n = 0\n    mientras (n < 256) {\n        sea c = n\n        sea k = 0\n        mientras (k < 8) {\n            si (__y_bits(c, 1) != 0) { c = __xo_bits(3988292384, __desplazar_der(c, 1)) } sino { c = __desplazar_der(c, 1) }\n            k = k + 1\n        }\n        __guardar64(t + n * 8, c)\n        n = n + 1\n    }\n    mem_fijar_global(30, t)\n    retornar t\n}\n\nfuncion md_crc(crc, p, n) {\n    sea t = md_tabla_crc()\n    sea c = __xo_bits(crc, 4294967295)\n    sea i = 0\n    mientras (i < n) {\n        c = __xo_bits(__cargar64(t + __y_bits(__xo_bits(c, __cargar8(p + i)), 255) * 8), __desplazar_der(c, 8))\n        i = i + 1\n    }\n    retornar __xo_bits(c, 4294967295)\n}\n\nfuncion md_adler(p, n) {\n    sea a = 1\n    sea b = 0\n    sea i = 0\n    mientras (i < n) {\n        // 5552 bytes como máximo entre reducciones (igual que zlib).\n        sea fin = i + 5552\n        si (fin > n) { fin = n }\n        mientras (i < fin) {\n            a = a + __cargar8(p + i)\n            b = b + a\n            i = i + 1\n        }\n        a = a % 65521\n        b = b % 65521\n    }\n    retornar __o_bits(__desplazar_izq(b, 16), a)\n}\n\nfuncion crc32(datos) {\n    sea s = dyn_a_str(datos)\n    retornar dyn_entero(md_crc(0, str_datos(s), str_largo(s)))\n}\n\nfuncion adler32(datos) {\n    sea s = dyn_a_str(datos)\n    retornar dyn_entero(md_adler(str_datos(s), str_largo(s)))\n}\n\n// ── Inflate (RFC 1951) ─────────────────────────────────────────────────────\n// Estado del lector: [datos][largo][pos][bits][cantidad].\n// Tabla Huffman: 16 conteos, 320 símbolos y una tabla rápida de 9 bits.\n\nfuncion md_llenar(st, n) {\n    sea buf = __cargar64(st + 24)\n    sea cnt = __cargar64(st + 32)\n    sea pos = __cargar64(st + 16)\n    sea largo = __cargar64(st + 8)\n    sea d = __cargar64(st)\n    mientras (cnt < n y pos < largo) {\n        buf = __o_bits(buf, __desplazar_izq(__cargar8(d + pos), cnt))\n        pos = pos + 1\n        cnt = cnt + 8\n    }\n    __guardar64(st + 24, buf)\n    __guardar64(st + 32, cnt)\n    __guardar64(st + 16, pos)\n    retornar cnt\n}\n\nfuncion md_bits(st, n) {\n    si (n == 0) { retornar 0 }\n    si (__cargar64(st + 32) < n) {\n        si (md_llenar(st, n) < n) { dyn_error(\"inflar: datos comprimidos truncados\") }\n    }\n    sea buf = __cargar64(st + 24)\n    __guardar64(st + 24, __desplazar_der(buf, n))\n    __guardar64(st + 32, __cargar64(st + 32) - n)\n    retornar __y_bits(buf, __desplazar_izq(1, n) - 1)\n}\n\nfuncion md_huff_construir(h, longs, n) {\n    mem_llenar(h, 0, 128)\n    sea i = 0\n    mientras (i < n) {\n        sea l = __cargar64(longs + i * 8)\n        __guardar64(h + l * 8, __cargar64(h + l * 8) + 1)\n        i = i + 1\n    }\n    sea offs = mem_reservar(17 * 8)\n    __guardar64(offs + 8, 0)\n    sea l = 1\n    mientras (l < 16) {\n        __guardar64(offs + (l + 1) * 8, __cargar64(offs + l * 8) + __cargar64(h + l * 8))\n        l = l + 1\n    }\n    i = 0\n    mientras (i < n) {\n        sea li = __cargar64(longs + i * 8)\n        si (li != 0) {\n            sea ofs = __cargar64(offs + li * 8)\n            __guardar64(h + 128 + ofs * 8, i)\n            __guardar64(offs + li * 8, ofs + 1)\n        }\n        i = i + 1\n    }\n    mem_liberar(offs)\n    sea rapida = h + 2688\n    mem_llenar(rapida, 0, 4096)\n    sea codigo = 0\n    sea indice = 0\n    l = 1\n    mientras (l < 16) {\n        sea c = __cargar64(h + l * 8)\n        sea j = 0\n        mientras (j < c) {\n            si (l <= 9) {\n                // Código invertido (el flujo es LSB primero).\n                sea r = 0\n                sea b = 0\n                mientras (b < l) {\n                    r = __o_bits(__desplazar_izq(r, 1), __y_bits(__desplazar_der(codigo, b), 1))\n                    b = b + 1\n                }\n                sea entrada = __desplazar_izq(__cargar64(h + 128 + indice * 8), 4) + l\n                sea k = r\n                mientras (k < 512) {\n                    __guardar64(rapida + k * 8, entrada)\n                    k = k + __desplazar_izq(1, l)\n                }\n            }\n            codigo = codigo + 1\n            indice = indice + 1\n            j = j + 1\n        }\n        codigo = __desplazar_izq(codigo, 1)\n        l = l + 1\n    }\n    retornar 0\n}\n\nfuncion md_huff_dec(st, h) {\n    sea cnt = __cargar64(st + 32)\n    si (cnt < 9) { cnt = md_llenar(st, 9) }\n    sea buf = __cargar64(st + 24)\n    sea e = __cargar64(h + 2688 + __y_bits(buf, 511) * 8)\n    si (e != 0) {\n        sea l = __y_bits(e, 15)\n        si (l <= cnt) {\n            __guardar64(st + 24, __desplazar_der(buf, l))\n            __guardar64(st + 32, cnt - l)\n            retornar __desplazar_der(e, 4)\n        }\n    }\n    // Camino lento (códigos de más de 9 bits), como puff de zlib.\n    sea codigo = 0\n    sea primero = 0\n    sea indice = 0\n    sea l = 1\n    mientras (l < 16) {\n        codigo = __o_bits(codigo, md_bits(st, 1))\n        sea c = __cargar64(h + l * 8)\n        si (codigo - c < primero) { retornar __cargar64(h + 128 + (indice + codigo - primero) * 8) }\n        indice = indice + c\n        primero = __desplazar_izq(primero + c, 1)\n        codigo = __desplazar_izq(codigo, 1)\n        l = l + 1\n    }\n    dyn_error(\"inflar: código Huffman inválido\")\n    retornar 0\n}\n\nfuncion md_tablas_deflate() {\n    sea t = mem_global(42)\n    si (t != 0) { retornar t }\n    // [base largo 29][extra largo 29][base distancia 30][extra distancia 30]\n    t = mem_reservar(118 * 8)\n    sea i = 0\n    sea base = 3\n    mientras (i < 28) {\n        sea e = 0\n        si (i >= 8) { e = (i - 4) / 4 }\n        __guardar64(t + i * 8, base)\n        __guardar64(t + (29 + i) * 8, e)\n        base = base + __desplazar_izq(1, e)\n        i = i + 1\n    }\n    __guardar64(t + 28 * 8, 258)\n    __guardar64(t + 57 * 8, 0)\n    i = 0\n    base = 1\n    mientras (i < 30) {\n        sea e = 0\n        si (i >= 4) { e = (i - 2) / 2 }\n        __guardar64(t + (58 + i) * 8, base)\n        __guardar64(t + (88 + i) * 8, e)\n        base = base + __desplazar_izq(1, e)\n        i = i + 1\n    }\n    mem_fijar_global(42, t)\n    retornar t\n}\n\n// Descomprime deflate crudo desde p (n bytes) y agrega a `salida`.\n// Devuelve los bytes consumidos.\n// Límite por defecto de lo que puede producir una descompresión: 256 MiB\n// (anti \"zip bomb\"). Las funciones públicas aceptan otro límite.\nfuncion md_limite_inflar(limite) {\n    si (limite == 0) { retornar 268435456 }\n    sea l = md_ent(limite)\n    si (l <= 0) { dyn_error(\"inflar: el límite debe ser positivo\") }\n    retornar l\n}\n\nfuncion md_inflar(p, n, salida) { retornar md_inflar_hasta(p, n, salida, 268435456) }\n\nfuncion md_exceso(salida, inicio, extra, limite) {\n    si (str_largo(salida) - inicio + extra > limite) { dyn_error(\"inflar: los datos se expanden más que el límite permitido (posible bomba de compresión)\") }\n    retornar 0\n}\n\nfuncion md_inflar_hasta(p, n, salida, limite) {\n    sea inicio_salida = str_largo(salida)\n    sea st = mem_reservar(48)\n    __guardar64(st, p)\n    __guardar64(st + 8, n)\n    __guardar64(st + 16, 0)\n    __guardar64(st + 24, 0)\n    __guardar64(st + 32, 0)\n    sea lit = mem_reservar(6784)\n    sea dist = mem_reservar(6784)\n    sea longs = mem_reservar(320 * 8)\n    sea cl = mem_reservar(6784)\n    sea tb = md_tablas_deflate()\n    sea orden = \"qrsaihjgkflemdncobp\"\n    sea final = 0\n    mientras (final == 0) {\n        final = md_bits(st, 1)\n        sea tipo = md_bits(st, 2)\n        si (tipo == 0) {\n            // Bloque guardado: volver al límite de byte.\n            sea cnt = __cargar64(st + 32)\n            __guardar64(st + 16, __cargar64(st + 16) - cnt / 8)\n            __guardar64(st + 24, 0)\n            __guardar64(st + 32, 0)\n            sea pos = __cargar64(st + 16)\n            si (pos + 4 > n) { dyn_error(\"inflar: bloque guardado truncado\") }\n            sea largo = md_le16(p + pos)\n            si (__xo_bits(largo, md_le16(p + pos + 2)) != 65535) { dyn_error(\"inflar: largo de bloque guardado inválido\") }\n            pos = pos + 4\n            si (pos + largo > n) { dyn_error(\"inflar: bloque guardado truncado\") }\n            md_exceso(salida, inicio_salida, largo, limite)\n            sea actual = str_largo(salida)\n            str_asegurar(salida, actual + largo + 1)\n            mem_copiar(str_datos(salida) + actual, p + pos, largo)\n            __guardar64(salida, actual + largo)\n            __guardar8(str_datos(salida) + actual + largo, 0)\n            __guardar64(st + 16, pos + largo)\n        } sino {\n            si (tipo == 3) { dyn_error(\"inflar: tipo de bloque inválido\") }\n            si (tipo == 1) {\n                sea i = 0\n                mientras (i < 288) {\n                    sea l = 8\n                    si (i >= 144 y i < 256) { l = 9 }\n                    si (i >= 256 y i < 280) { l = 7 }\n                    __guardar64(longs + i * 8, l)\n                    i = i + 1\n                }\n                md_huff_construir(lit, longs, 288)\n                i = 0\n                mientras (i < 30) {\n                    __guardar64(longs + i * 8, 5)\n                    i = i + 1\n                }\n                md_huff_construir(dist, longs, 30)\n            } sino {\n                sea hlit = md_bits(st, 5) + 257\n                sea hdist = md_bits(st, 5) + 1\n                sea hclen = md_bits(st, 4) + 4\n                mem_llenar(longs, 0, 19 * 8)\n                sea i = 0\n                mientras (i < hclen) {\n                    __guardar64(longs + (str_byte(orden, i) - 97) * 8, md_bits(st, 3))\n                    i = i + 1\n                }\n                md_huff_construir(cl, longs, 19)\n                i = 0\n                mientras (i < hlit + hdist) {\n                    sea s = md_huff_dec(st, cl)\n                    si (s < 16) {\n                        __guardar64(longs + i * 8, s)\n                        i = i + 1\n                    } sino {\n                        sea rep = 0\n                        sea valor = 0\n                        si (s == 16) {\n                            si (i == 0) { dyn_error(\"inflar: repetición sin longitud previa\") }\n                            valor = __cargar64(longs + (i - 1) * 8)\n                            rep = 3 + md_bits(st, 2)\n                        } sino {\n                            si (s == 17) { rep = 3 + md_bits(st, 3) } sino { rep = 11 + md_bits(st, 7) }\n                        }\n                        si (i + rep > hlit + hdist) { dyn_error(\"inflar: demasiadas longitudes\") }\n                        mientras (rep > 0) {\n                            __guardar64(longs + i * 8, valor)\n                            i = i + 1\n                            rep = rep - 1\n                        }\n                    }\n                }\n                md_huff_construir(lit, longs, hlit)\n                md_huff_construir(dist, longs + hlit * 8, hdist)\n            }\n            sea fin_bloque = 0\n            mientras (fin_bloque == 0) {\n                sea s = md_huff_dec(st, lit)\n                si (s < 256) {\n                    md_exceso(salida, inicio_salida, 1, limite)\n                    str_agregar_byte(salida, s)\n                } sino {\n                    si (s == 256) { fin_bloque = 1 } sino {\n                        s = s - 257\n                        si (s >= 29) { dyn_error(\"inflar: símbolo de largo inválido\") }\n                        sea largo = __cargar64(tb + s * 8) + md_bits(st, __cargar64(tb + (29 + s) * 8))\n                        sea ds = md_huff_dec(st, dist)\n                        si (ds >= 30) { dyn_error(\"inflar: símbolo de distancia inválido\") }\n                        sea d = __cargar64(tb + (58 + ds) * 8) + md_bits(st, __cargar64(tb + (88 + ds) * 8))\n                        sea actual = str_largo(salida)\n                        si (d > actual - inicio_salida) { dyn_error(\"inflar: distancia fuera de la ventana\") }\n                        md_exceso(salida, inicio_salida, largo, limite)\n                        str_asegurar(salida, actual + largo + 1)\n                        sea q = str_datos(salida) + actual\n                        sea k = 0\n                        // Sin solaparse dentro de 8 bytes: copia de a palabras.\n                        si (d >= 8) {\n                            mientras (k + 8 <= largo) {\n                                __guardar64(q + k, __cargar64(q + k - d))\n                                k = k + 8\n                            }\n                        }\n                        mientras (k < largo) {\n                            __guardar8(q + k, __cargar8(q + k - d))\n                            k = k + 1\n                        }\n                        __guardar64(salida, actual + largo)\n                        __guardar8(q + largo, 0)\n                    }\n                }\n            }\n        }\n    }\n    sea consumidos = __cargar64(st + 16) - __cargar64(st + 32) / 8\n    mem_liberar(st)\n    mem_liberar(lit)\n    mem_liberar(dist)\n    mem_liberar(longs)\n    mem_liberar(cl)\n    retornar consumidos\n}\n\n// zlib (RFC 1950): cabecera, deflate y Adler-32.\nfuncion md_zlib_inflar(p, n, salida) { retornar md_zlib_inflar_hasta(p, n, salida, 268435456) }\n\nfuncion md_zlib_inflar_hasta(p, n, salida, limite) {\n    si (n < 6) { dyn_error(\"zlib: datos demasiado cortos\") }\n    sea cmf = __cargar8(p)\n    sea flg = __cargar8(p + 1)\n    si (__y_bits(cmf, 15) != 8 o (cmf * 256 + flg) % 31 != 0) { dyn_error(\"zlib: cabecera inválida\") }\n    si (__y_bits(flg, 32) != 0) { dyn_error(\"zlib: diccionario predefinido no soportado\") }\n    sea inicio = str_largo(salida)\n    sea usados = md_inflar_hasta(p + 2, n - 2, salida, limite)\n    si (2 + usados + 4 <= n) {\n        sea esperado = md_be32(p + 2 + usados)\n        si (md_adler(str_datos(salida) + inicio, str_largo(salida) - inicio) != esperado) { dyn_error(\"zlib: Adler-32 no coincide\") }\n    }\n    retornar 0\n}\n\nfuncion inflar(datos, limite) {\n    sea s = dyn_a_str(datos)\n    sea r = str_nuevo(str_largo(s) * 4 + 64)\n    md_inflar_hasta(str_datos(s), str_largo(s), r, md_limite_inflar(limite))\n    retornar dyn_texto(r)\n}\n\nfuncion zlib_descomprimir(datos, limite) {\n    sea s = dyn_a_str(datos)\n    sea r = str_nuevo(str_largo(s) * 4 + 64)\n    md_zlib_inflar_hasta(str_datos(s), str_largo(s), r, md_limite_inflar(limite))\n    retornar dyn_texto(r)\n}\n\nfuncion gzip_descomprimir(datos, limite) {\n    sea s = dyn_a_str(datos)\n    sea p = str_datos(s)\n    sea n = str_largo(s)\n    si (n < 18 o __cargar8(p) != 31 o __cargar8(p + 1) != 139 o __cargar8(p + 2) != 8) { dyn_error(\"gzip: cabecera inválida\") }\n    sea flg = __cargar8(p + 3)\n    sea pos = 10\n    si (__y_bits(flg, 4) != 0) { pos = pos + 2 + md_le16(p + pos) }\n    si (__y_bits(flg, 8) != 0) {\n        mientras (pos < n y __cargar8(p + pos) != 0) { pos = pos + 1 }\n        pos = pos + 1\n    }\n    si (__y_bits(flg, 16) != 0) {\n        mientras (pos < n y __cargar8(p + pos) != 0) { pos = pos + 1 }\n        pos = pos + 1\n    }\n    si (__y_bits(flg, 2) != 0) { pos = pos + 2 }\n    si (pos >= n) { dyn_error(\"gzip: datos truncados\") }\n    sea r = str_nuevo(n * 4 + 64)\n    sea usados = md_inflar_hasta(p + pos, n - pos, r, md_limite_inflar(limite))\n    si (pos + usados + 8 <= n) {\n        si (md_crc(0, str_datos(r), str_largo(r)) != md_le32(p + pos + usados)) { dyn_error(\"gzip: CRC-32 no coincide\") }\n    }\n    retornar dyn_texto(r)\n}\n\n// ── Deflate: LZ77 con cadenas hash + Huffman fijo ──────────────────────────\n// Escritor de bits: [salida][bits][cantidad].\n\nfuncion md_poner(w, valor, n) {\n    sea buf = __o_bits(__cargar64(w + 8), __desplazar_izq(valor, __cargar64(w + 16)))\n    sea cnt = __cargar64(w + 16) + n\n    sea s = __cargar64(w)\n    mientras (cnt >= 8) {\n        str_agregar_byte(s, __y_bits(buf, 255))\n        buf = __desplazar_der(buf, 8)\n        cnt = cnt - 8\n    }\n    __guardar64(w + 8, buf)\n    __guardar64(w + 16, cnt)\n    retornar 0\n}\n\n// Código Huffman (MSB primero) invertido para el flujo LSB primero.\nfuncion md_poner_codigo(w, codigo, n) {\n    sea r = 0\n    sea i = 0\n    mientras (i < n) {\n        r = __o_bits(__desplazar_izq(r, 1), __y_bits(__desplazar_der(codigo, i), 1))\n        i = i + 1\n    }\n    retornar md_poner(w, r, n)\n}\n\nfuncion md_poner_literal(w, s) {\n    si (s < 144) { retornar md_poner_codigo(w, 48 + s, 8) }\n    si (s < 256) { retornar md_poner_codigo(w, 400 + s - 144, 9) }\n    si (s < 280) { retornar md_poner_codigo(w, s - 256, 7) }\n    retornar md_poner_codigo(w, 192 + s - 280, 8)\n}\n\nfuncion md_poner_par(w, largo, d, tb) {\n    sea i = 28\n    mientras (__cargar64(tb + i * 8) > largo) { i = i - 1 }\n    md_poner_literal(w, 257 + i)\n    md_poner(w, largo - __cargar64(tb + i * 8), __cargar64(tb + (29 + i) * 8))\n    sea j = 29\n    mientras (__cargar64(tb + (58 + j) * 8) > d) { j = j - 1 }\n    md_poner_codigo(w, j, 5)\n    md_poner(w, d - __cargar64(tb + (58 + j) * 8), __cargar64(tb + (88 + j) * 8))\n    retornar 0\n}\n\n// Longitudes de Huffman (limitadas) para n frecuencias.\nfuncion md_huff_longitudes(frec, n, limite, longs) {\n    sea w = mem_reservar(n * 2 * 8)\n    sea padre = mem_reservar(n * 2 * 8)\n    sea activo = mem_reservar(n * 2 * 8)\n    sea f = mem_reservar(n * 8)\n    mem_copiar(f, frec, n * 8)\n    sea listo = 0\n    mientras (listo == 0) {\n        mem_llenar(longs, 0, n * 8)\n        sea m = 0\n        sea i = 0\n        mientras (i < n) {\n            __guardar64(w + i * 8, __cargar64(f + i * 8))\n            __guardar64(padre + i * 8, 0 - 1)\n            sea act = 0\n            si (__cargar64(f + i * 8) > 0) {\n                act = 1\n                m = m + 1\n            }\n            __guardar64(activo + i * 8, act)\n            i = i + 1\n        }\n        si (m <= 1) {\n            i = 0\n            mientras (i < n) {\n                si (__cargar64(f + i * 8) > 0) { __guardar64(longs + i * 8, 1) }\n                i = i + 1\n            }\n            listo = 1\n        } sino {\n            sea nodos = n\n            sea paso = 0\n            mientras (paso < m - 1) {\n                sea a = 0 - 1\n                sea b = 0 - 1\n                i = 0\n                mientras (i < nodos) {\n                    si (__cargar64(activo + i * 8) == 1) {\n                        sea wi = __cargar64(w + i * 8)\n                        si (a < 0 o wi < __cargar64(w + a * 8)) {\n                            b = a\n                            a = i\n                        } sino {\n                            si (b < 0 o wi < __cargar64(w + b * 8)) { b = i }\n                        }\n                    }\n                    i = i + 1\n                }\n                __guardar64(activo + a * 8, 0)\n                __guardar64(activo + b * 8, 0)\n                __guardar64(w + nodos * 8, __cargar64(w + a * 8) + __cargar64(w + b * 8))\n                __guardar64(padre + nodos * 8, 0 - 1)\n                __guardar64(activo + nodos * 8, 1)\n                __guardar64(padre + a * 8, nodos)\n                __guardar64(padre + b * 8, nodos)\n                nodos = nodos + 1\n                paso = paso + 1\n            }\n            sea maximo = 0\n            i = 0\n            mientras (i < n) {\n                si (__cargar64(f + i * 8) > 0) {\n                    sea d = 0\n                    sea k = i\n                    mientras (__cargar64(padre + k * 8) >= 0) {\n                        k = __cargar64(padre + k * 8)\n                        d = d + 1\n                    }\n                    __guardar64(longs + i * 8, d)\n                    si (d > maximo) { maximo = d }\n                }\n                i = i + 1\n            }\n            si (maximo <= limite) { listo = 1 } sino {\n                // Aplanar las frecuencias y repetir.\n                i = 0\n                mientras (i < n) {\n                    sea fi = __cargar64(f + i * 8)\n                    si (fi > 0) { __guardar64(f + i * 8, fi / 2 + 1) }\n                    i = i + 1\n                }\n            }\n        }\n    }\n    mem_liberar(w)\n    mem_liberar(padre)\n    mem_liberar(activo)\n    mem_liberar(f)\n    retornar 0\n}\n\n// Códigos canónicos (MSB primero) para las longitudes dadas.\nfuncion md_codigos(longs, n) {\n    sea cuenta = mem_reservar(17 * 8)\n    mem_llenar(cuenta, 0, 17 * 8)\n    sea i = 0\n    mientras (i < n) {\n        sea l = __cargar64(longs + i * 8)\n        __guardar64(cuenta + l * 8, __cargar64(cuenta + l * 8) + 1)\n        i = i + 1\n    }\n    __guardar64(cuenta, 0)\n    sea siguiente = mem_reservar(17 * 8)\n    sea codigo = 0\n    sea l = 1\n    mientras (l < 17) {\n        codigo = __desplazar_izq(codigo + __cargar64(cuenta + (l - 1) * 8), 1)\n        __guardar64(siguiente + l * 8, codigo)\n        l = l + 1\n    }\n    sea c = mem_reservar(n * 8)\n    i = 0\n    mientras (i < n) {\n        sea li = __cargar64(longs + i * 8)\n        si (li != 0) {\n            __guardar64(c + i * 8, __cargar64(siguiente + li * 8))\n            __guardar64(siguiente + li * 8, __cargar64(siguiente + li * 8) + 1)\n        }\n        i = i + 1\n    }\n    mem_liberar(cuenta)\n    mem_liberar(siguiente)\n    retornar c\n}\n\nfuncion md_simbolo_largo(largo, tb) {\n    sea i = 28\n    mientras (__cargar64(tb + i * 8) > largo) { i = i - 1 }\n    retornar i\n}\n\nfuncion md_simbolo_distancia(d, tb) {\n    sea j = 29\n    mientras (__cargar64(tb + (58 + j) * 8) > d) { j = j - 1 }\n    retornar j\n}\n\n// Emite un bloque con Huffman dinámico. Cada token es un literal (< 256) o\n// 2^40 + largo * 65536 + distancia.\nfuncion md_bloque_dinamico(w, tok, nt, final, tb) {\n    sea flit = mem_reservar(288 * 8)\n    sea fdist = mem_reservar(30 * 8)\n    mem_llenar(flit, 0, 288 * 8)\n    mem_llenar(fdist, 0, 30 * 8)\n    sea i = 0\n    mientras (i < nt) {\n        sea t = __cargar64(tok + i * 8)\n        si (t < 256) { __guardar64(flit + t * 8, __cargar64(flit + t * 8) + 1) } sino {\n            sea li = 257 + md_simbolo_largo(__y_bits(__desplazar_der(t, 16), 65535), tb)\n            __guardar64(flit + li * 8, __cargar64(flit + li * 8) + 1)\n            sea dj = md_simbolo_distancia(__y_bits(t, 65535), tb)\n            __guardar64(fdist + dj * 8, __cargar64(fdist + dj * 8) + 1)\n        }\n        i = i + 1\n    }\n    __guardar64(flit + 256 * 8, 1)\n    sea hay_dist = 0\n    i = 0\n    mientras (i < 30) {\n        si (__cargar64(fdist + i * 8) > 0) { hay_dist = 1 }\n        i = i + 1\n    }\n    si (hay_dist == 0) { __guardar64(fdist, 1) }\n    sea llit = mem_reservar(288 * 8)\n    sea ldist = mem_reservar(30 * 8)\n    md_huff_longitudes(flit, 288, 15, llit)\n    md_huff_longitudes(fdist, 30, 15, ldist)\n    sea hlit = 286\n    mientras (hlit > 257 y __cargar64(llit + (hlit - 1) * 8) == 0) { hlit = hlit - 1 }\n    sea hdist = 30\n    mientras (hdist > 1 y __cargar64(ldist + (hdist - 1) * 8) == 0) { hdist = hdist - 1 }\n    // Longitudes concatenadas y codificadas con 16/17/18.\n    sea total = hlit + hdist\n    sea todas = mem_reservar(total * 8)\n    mem_copiar(todas, llit, hlit * 8)\n    mem_copiar(todas + hlit * 8, ldist, hdist * 8)\n    sea rs = mem_reservar(total * 16 + 16)\n    sea nr = 0\n    sea fcl = mem_reservar(19 * 8)\n    mem_llenar(fcl, 0, 19 * 8)\n    i = 0\n    mientras (i < total) {\n        sea v = __cargar64(todas + i * 8)\n        sea run = 1\n        mientras (i + run < total y __cargar64(todas + (i + run) * 8) == v) { run = run + 1 }\n        sea usado = 1\n        sea sim = v\n        sea extra = 0\n        si (v == 0 y run >= 3) {\n            si (run >= 11) {\n                usado = run\n                si (usado > 138) { usado = 138 }\n                sim = 18\n                extra = usado - 11\n            } sino {\n                usado = run\n                sim = 17\n                extra = usado - 3\n            }\n        } sino {\n            si (v != 0 y i > 0 y __cargar64(todas + (i - 1) * 8) == v y run >= 3) {\n                usado = run\n                si (usado > 6) { usado = 6 }\n                sim = 16\n                extra = usado - 3\n            }\n        }\n        __guardar64(rs + nr * 16, sim)\n        __guardar64(rs + nr * 16 + 8, extra)\n        nr = nr + 1\n        __guardar64(fcl + sim * 8, __cargar64(fcl + sim * 8) + 1)\n        i = i + usado\n    }\n    sea lcl = mem_reservar(19 * 8)\n    md_huff_longitudes(fcl, 19, 7, lcl)\n    sea orden = \"qrsaihjgkflemdncobp\"\n    sea hclen = 19\n    mientras (hclen > 4 y __cargar64(lcl + (str_byte(orden, hclen - 1) - 97) * 8) == 0) { hclen = hclen - 1 }\n    md_poner(w, final, 1)\n    md_poner(w, 2, 2)\n    md_poner(w, hlit - 257, 5)\n    md_poner(w, hdist - 1, 5)\n    md_poner(w, hclen - 4, 4)\n    i = 0\n    mientras (i < hclen) {\n        md_poner(w, __cargar64(lcl + (str_byte(orden, i) - 97) * 8), 3)\n        i = i + 1\n    }\n    sea ccl = md_codigos(lcl, 19)\n    i = 0\n    mientras (i < nr) {\n        sea sim = __cargar64(rs + i * 16)\n        md_poner_codigo(w, __cargar64(ccl + sim * 8), __cargar64(lcl + sim * 8))\n        si (sim == 16) { md_poner(w, __cargar64(rs + i * 16 + 8), 2) }\n        si (sim == 17) { md_poner(w, __cargar64(rs + i * 16 + 8), 3) }\n        si (sim == 18) { md_poner(w, __cargar64(rs + i * 16 + 8), 7) }\n        i = i + 1\n    }\n    sea clit = md_codigos(llit, 288)\n    sea cdist = md_codigos(ldist, 30)\n    i = 0\n    mientras (i < nt) {\n        sea t = __cargar64(tok + i * 8)\n        si (t < 256) { md_poner_codigo(w, __cargar64(clit + t * 8), __cargar64(llit + t * 8)) } sino {\n            sea largo = __y_bits(__desplazar_der(t, 16), 65535)\n            sea d = __y_bits(t, 65535)\n            sea li = md_simbolo_largo(largo, tb)\n            md_poner_codigo(w, __cargar64(clit + (257 + li) * 8), __cargar64(llit + (257 + li) * 8))\n            md_poner(w, largo - __cargar64(tb + li * 8), __cargar64(tb + (29 + li) * 8))\n            sea dj = md_simbolo_distancia(d, tb)\n            md_poner_codigo(w, __cargar64(cdist + dj * 8), __cargar64(ldist + dj * 8))\n            md_poner(w, d - __cargar64(tb + (58 + dj) * 8), __cargar64(tb + (88 + dj) * 8))\n        }\n        i = i + 1\n    }\n    md_poner_codigo(w, __cargar64(clit + 2048), __cargar64(llit + 2048))\n    mem_liberar(flit)\n    mem_liberar(fdist)\n    mem_liberar(llit)\n    mem_liberar(ldist)\n    mem_liberar(todas)\n    mem_liberar(rs)\n    mem_liberar(fcl)\n    mem_liberar(lcl)\n    mem_liberar(ccl)\n    mem_liberar(clit)\n    mem_liberar(cdist)\n    retornar 0\n}\n\nfuncion md_deflar(p, n, salida, nivel) {\n    sea tb = md_tablas_deflate()\n    sea w = mem_reservar(24)\n    __guardar64(w, salida)\n    __guardar64(w + 8, 0)\n    __guardar64(w + 16, 0)\n    si (nivel == 0) {\n        // Bloques guardados (sin comprimir).\n        sea pos = 0\n        sea hecho = 0\n        mientras (hecho == 0) {\n            sea largo = n - pos\n            si (largo > 65535) { largo = 65535 }\n            sea ultimo = 0\n            si (pos + largo >= n) { ultimo = 1 }\n            md_poner(w, ultimo, 1)\n            md_poner(w, 0, 2)\n            si (__cargar64(w + 16) > 0) { md_poner(w, 0, 8 - __cargar64(w + 16)) }\n            str_agregar_byte(salida, __y_bits(largo, 255))\n            str_agregar_byte(salida, __desplazar_der(largo, 8))\n            str_agregar_byte(salida, __y_bits(__xo_bits(largo, 65535), 255))\n            str_agregar_byte(salida, __desplazar_der(__xo_bits(largo, 65535), 8))\n            sea actual = str_largo(salida)\n            str_asegurar(salida, actual + largo + 1)\n            mem_copiar(str_datos(salida) + actual, p + pos, largo)\n            __guardar64(salida, actual + largo)\n            __guardar8(str_datos(salida) + actual + largo, 0)\n            pos = pos + largo\n            si (ultimo == 1) { hecho = 1 }\n        }\n        mem_liberar(w)\n        retornar 0\n    }\n    sea cadena = 8\n    si (nivel >= 6) { cadena = 32 }\n    si (nivel >= 9) { cadena = 256 }\n    sea cabeza = mem_reservar(32768 * 8)\n    sea previo = mem_reservar(32768 * 8)\n    mem_llenar(cabeza, 255, 32768 * 8)                         // todo -1: cubetas vacías\n    sea tmax = 65536\n    sea tok = mem_reservar(tmax * 8)\n    sea nt = 0\n    sea i = 0\n    mientras (i < n) {\n        sea mejor = 0\n        sea mejor_d = 0\n        si (i + 2 < n) {\n            sea h = __y_bits(__xo_bits(__xo_bits(__desplazar_izq(__cargar8(p + i), 10), __desplazar_izq(__cargar8(p + i + 1), 5)), __cargar8(p + i + 2)), 32767)\n            sea c = __cargar64(cabeza + h * 8)\n            sea intentos = cadena\n            sea maximo = n - i\n            si (maximo > 258) { maximo = 258 }\n            mientras (c >= 0 y i - c <= 32768 y intentos > 0) {\n                si (__cargar8(p + c + mejor) == __cargar8(p + i + mejor)) {\n                    // Comparación de a 8 bytes; el primer byte distinto sale\n                    // del XOR (los bytes bajos son los primeros en memoria).\n                    sea l = 0\n                    sea seguir = 1\n                    mientras (seguir y l + 8 <= maximo) {\n                        sea x = __xo_bits(__cargar64(p + c + l), __cargar64(p + i + l))\n                        si (x == 0) { l = l + 8 } sino {\n                            mientras (__y_bits(x, 255) == 0) {\n                                x = __desplazar_der(x, 8)\n                                l = l + 1\n                            }\n                            seguir = 0\n                        }\n                    }\n                    si (seguir) {\n                        mientras (l < maximo y __cargar8(p + c + l) == __cargar8(p + i + l)) { l = l + 1 }\n                    }\n                    si (l > mejor) {\n                        mejor = l\n                        mejor_d = i - c\n                    }\n                    si (l >= maximo) { intentos = 1 }\n                }\n                sea siguiente = __cargar64(previo + __y_bits(c, 32767) * 8)\n                si (siguiente >= c) { siguiente = 0 - 1 }\n                c = siguiente\n                intentos = intentos - 1\n            }\n            __guardar64(previo + __y_bits(i, 32767) * 8, __cargar64(cabeza + h * 8))\n            __guardar64(cabeza + h * 8, i)\n        }\n        si (nt >= tmax) {\n            md_bloque_dinamico(w, tok, nt, 0, tb)\n            nt = 0\n        }\n        si (mejor >= 3) {\n            __guardar64(tok + nt * 8, 1099511627776 + mejor * 65536 + mejor_d)\n            nt = nt + 1\n            // Registrar en el hash las posiciones saltadas.\n            sea j = i + 1\n            sea fin = i + mejor\n            mientras (j < fin) {\n                si (j + 2 < n) {\n                    sea h2 = __y_bits(__xo_bits(__xo_bits(__desplazar_izq(__cargar8(p + j), 10), __desplazar_izq(__cargar8(p + j + 1), 5)), __cargar8(p + j + 2)), 32767)\n                    __guardar64(previo + __y_bits(j, 32767) * 8, __cargar64(cabeza + h2 * 8))\n                    __guardar64(cabeza + h2 * 8, j)\n                }\n                j = j + 1\n            }\n            i = fin\n        } sino {\n            __guardar64(tok + nt * 8, __cargar8(p + i))\n            nt = nt + 1\n            i = i + 1\n        }\n    }\n    md_bloque_dinamico(w, tok, nt, 1, tb)\n    mem_liberar(tok)\n    si (__cargar64(w + 16) > 0) { md_poner(w, 0, 8 - __cargar64(w + 16)) }\n    mem_liberar(cabeza)\n    mem_liberar(previo)\n    mem_liberar(w)\n    retornar 0\n}\n\nfuncion md_zlib_deflar(p, n, salida, nivel) {\n    str_agregar_byte(salida, 120)\n    str_agregar_byte(salida, 156)\n    md_deflar(p, n, salida, nivel)\n    md_agregar_be32(salida, md_adler(p, n))\n    retornar 0\n}\n\nfuncion md_nivel(nivel) {\n    si (nivel == 0) { retornar 6 }\n    sea n = md_ent(nivel)\n    si (n < 0 o n > 9) { dyn_error(\"comprimir: el nivel va de 0 a 9\") }\n    retornar n\n}\n\nfuncion deflar(datos, nivel) {\n    sea s = dyn_a_str(datos)\n    sea r = str_nuevo(str_largo(s) / 2 + 64)\n    md_deflar(str_datos(s), str_largo(s), r, md_nivel(nivel))\n    retornar dyn_texto(r)\n}\n\nfuncion zlib_comprimir(datos, nivel) {\n    sea s = dyn_a_str(datos)\n    sea r = str_nuevo(str_largo(s) / 2 + 64)\n    md_zlib_deflar(str_datos(s), str_largo(s), r, md_nivel(nivel))\n    retornar dyn_texto(r)\n}\n\nfuncion gzip_comprimir(datos, nivel) {\n    sea s = dyn_a_str(datos)\n    sea r = str_nuevo(str_largo(s) / 2 + 64)\n    md_agregar_bytes(r, \"31,139,8,0,0,0,0,0,0,255\")\n    md_deflar(str_datos(s), str_largo(s), r, md_nivel(nivel))\n    sea c = md_crc(0, str_datos(s), str_largo(s))\n    sea n = str_largo(s)\n    sea i = 0\n    mientras (i < 4) {\n        str_agregar_byte(r, __y_bits(__desplazar_der(c, i * 8), 255))\n        i = i + 1\n    }\n    i = 0\n    mientras (i < 4) {\n        str_agregar_byte(r, __y_bits(__desplazar_der(n, i * 8), 255))\n        i = i + 1\n    }\n    retornar dyn_texto(r)\n}\n\n// ── PNG ────────────────────────────────────────────────────────────────────\n\nfuncion md_paeth(a, b, c) {\n    sea p = a + b - c\n    sea pa = p - a\n    si (pa < 0) { pa = 0 - pa }\n    sea pb = p - b\n    si (pb < 0) { pb = 0 - pb }\n    sea pc = p - c\n    si (pc < 0) { pc = 0 - pc }\n    si (pa <= pb y pa <= pc) { retornar a }\n    si (pb <= pc) { retornar b }\n    retornar c\n}\n\n// Quita el filtro de una fila (cur y prev tienen `ancho` bytes).\nfuncion md_desfiltrar(tipo, cur, prev, ancho, bpp) {\n    sea i = 0\n    si (tipo == 0) { retornar 0 }\n    si (tipo == 1) {\n        i = bpp\n        mientras (i < ancho) {\n            __guardar8(cur + i, __y_bits(__cargar8(cur + i) + __cargar8(cur + i - bpp), 255))\n            i = i + 1\n        }\n        retornar 0\n    }\n    si (tipo == 2) {\n        mientras (i < ancho) {\n            __guardar8(cur + i, __y_bits(__cargar8(cur + i) + __cargar8(prev + i), 255))\n            i = i + 1\n        }\n        retornar 0\n    }\n    si (tipo == 3) {\n        mientras (i < ancho) {\n            sea a = 0\n            si (i >= bpp) { a = __cargar8(cur + i - bpp) }\n            __guardar8(cur + i, __y_bits(__cargar8(cur + i) + (a + __cargar8(prev + i)) / 2, 255))\n            i = i + 1\n        }\n        retornar 0\n    }\n    si (tipo == 4) {\n        mientras (i < ancho) {\n            sea a = 0\n            sea c = 0\n            si (i >= bpp) {\n                a = __cargar8(cur + i - bpp)\n                c = __cargar8(prev + i - bpp)\n            }\n            __guardar8(cur + i, __y_bits(__cargar8(cur + i) + md_paeth(a, __cargar8(prev + i), c), 255))\n            i = i + 1\n        }\n        retornar 0\n    }\n    dyn_error(\"png: filtro de fila inválido\")\n    retornar 0\n}\n\n// Muestra k (0..) de una fila con la profundidad dada.\nfuncion md_muestra(fila, k, prof) {\n    si (prof == 8) { retornar __cargar8(fila + k) }\n    si (prof == 16) { retornar md_be16(fila + k * 2) }\n    sea bit = k * prof\n    sea b = __cargar8(fila + bit / 8)\n    retornar __y_bits(__desplazar_der(b, 8 - prof - bit % 8), __desplazar_izq(1, prof) - 1)\n}\n\nfuncion md_a8(v, prof) {\n    si (prof == 8) { retornar v }\n    si (prof == 16) { retornar __desplazar_der(v * 255 + 32895, 16) }\n    retornar v * 255 / (__desplazar_izq(1, prof) - 1)\n}\n\n// info: [ancho][alto][prof][tipo][paleta ptr][trns tipo][trns r][trns g][trns b]\nfuncion md_png_fila(info, fila, pw, salida, ancho_img, fy, x0, dx) {\n    sea prof = __cargar64(info + 16)\n    sea tipo = __cargar64(info + 24)\n    sea pal = __cargar64(info + 32)\n    sea tt = __cargar64(info + 40)\n    sea i = 0\n    mientras (i < pw) {\n        sea r = 0\n        sea g = 0\n        sea b = 0\n        sea a = 255\n        si (tipo == 0) {\n            sea v = md_muestra(fila, i, prof)\n            r = md_a8(v, prof)\n            g = r\n            b = r\n            si (tt == 1 y v == __cargar64(info + 48)) { a = 0 }\n        }\n        si (tipo == 2) {\n            sea vr = md_muestra(fila, i * 3, prof)\n            sea vg = md_muestra(fila, i * 3 + 1, prof)\n            sea vb = md_muestra(fila, i * 3 + 2, prof)\n            r = md_a8(vr, prof)\n            g = md_a8(vg, prof)\n            b = md_a8(vb, prof)\n            si (tt == 1 y vr == __cargar64(info + 48) y vg == __cargar64(info + 56) y vb == __cargar64(info + 64)) { a = 0 }\n        }\n        si (tipo == 3) {\n            sea ix = md_muestra(fila, i, prof)\n            si (ix >= __cargar64(info + 72)) { dyn_error(\"png: índice fuera de la paleta\") }\n            r = __cargar8(pal + ix * 4)\n            g = __cargar8(pal + ix * 4 + 1)\n            b = __cargar8(pal + ix * 4 + 2)\n            a = __cargar8(pal + ix * 4 + 3)\n        }\n        si (tipo == 4) {\n            r = md_a8(md_muestra(fila, i * 2, prof), prof)\n            g = r\n            b = r\n            a = md_a8(md_muestra(fila, i * 2 + 1, prof), prof)\n        }\n        si (tipo == 6) {\n            r = md_a8(md_muestra(fila, i * 4, prof), prof)\n            g = md_a8(md_muestra(fila, i * 4 + 1, prof), prof)\n            b = md_a8(md_muestra(fila, i * 4 + 2, prof), prof)\n            a = md_a8(md_muestra(fila, i * 4 + 3, prof), prof)\n        }\n        sea q = salida + (fy * ancho_img + x0 + i * dx) * 4\n        __guardar8(q, r)\n        __guardar8(q + 1, g)\n        __guardar8(q + 2, b)\n        __guardar8(q + 3, a)\n        i = i + 1\n    }\n    retornar 0\n}\n\nfuncion png_decodificar(datos) {\n    sea s = dyn_a_str(datos)\n    sea p = str_datos(s)\n    sea n = str_largo(s)\n    si (n < 33 o md_be32(p) != 2303741511 o md_be32(p + 4) != 218765834) { dyn_error(\"png: firma inválida\") }\n    sea info = mem_reservar(80)\n    mem_llenar(info, 0, 80)\n    sea pal = mem_reservar(1024)\n    mem_llenar(pal, 255, 1024)\n    __guardar64(info + 32, pal)\n    sea idat = str_nuevo(n)\n    sea pos = 8\n    sea visto_ihdr = 0\n    sea fin = 0\n    sea entrelazado = 0\n    mientras (fin == 0) {\n        si (pos + 12 > n) { dyn_error(\"png: archivo truncado\") }\n        sea largo = md_be32(p + pos)\n        sea tipo = md_be32(p + pos + 4)\n        si (pos + 12 + largo > n) { dyn_error(\"png: bloque truncado\") }\n        sea d = p + pos + 8\n        si (md_crc(0, p + pos + 4, largo + 4) != md_be32(d + largo)) { dyn_error(\"png: CRC inválido\") }\n        si (tipo == 1229472850) {\n            // IHDR\n            __guardar64(info, md_be32(d))\n            __guardar64(info + 8, md_be32(d + 4))\n            __guardar64(info + 16, __cargar8(d + 8))\n            __guardar64(info + 24, __cargar8(d + 9))\n            entrelazado = __cargar8(d + 12)\n            visto_ihdr = 1\n        }\n        si (tipo == 1347179589) {\n            // PLTE\n            sea k = 0\n            mientras (k < largo / 3 y k < 256) {\n                __guardar8(pal + k * 4, __cargar8(d + k * 3))\n                __guardar8(pal + k * 4 + 1, __cargar8(d + k * 3 + 1))\n                __guardar8(pal + k * 4 + 2, __cargar8(d + k * 3 + 2))\n                k = k + 1\n            }\n            __guardar64(info + 72, k)\n        }\n        si (tipo == 1951551059) {\n            // tRNS\n            sea ct = __cargar64(info + 24)\n            si (ct == 3) {\n                sea k = 0\n                mientras (k < largo y k < 256) {\n                    __guardar8(pal + k * 4 + 3, __cargar8(d + k))\n                    k = k + 1\n                }\n            }\n            si (ct == 0 y largo >= 2) {\n                __guardar64(info + 40, 1)\n                __guardar64(info + 48, md_be16(d))\n            }\n            si (ct == 2 y largo >= 6) {\n                __guardar64(info + 40, 1)\n                __guardar64(info + 48, md_be16(d))\n                __guardar64(info + 56, md_be16(d + 2))\n                __guardar64(info + 64, md_be16(d + 4))\n            }\n        }\n        si (tipo == 1229209940) { str_agregar(idat, str_rebanar(s, pos + 8, pos + 8 + largo)) }\n        si (tipo == 1229278788) { fin = 1 }\n        pos = pos + 12 + largo\n    }\n    si (visto_ihdr == 0) { dyn_error(\"png: falta IHDR\") }\n    sea ancho = __cargar64(info)\n    sea alto = __cargar64(info + 8)\n    sea prof = __cargar64(info + 16)\n    sea ct = __cargar64(info + 24)\n    md_validar_dimensiones(\"png\", ancho, alto)\n    sea canales = 0\n    si (ct == 0 o ct == 3) { canales = 1 }\n    si (ct == 2) { canales = 3 }\n    si (ct == 4) { canales = 2 }\n    si (ct == 6) { canales = 4 }\n    si (canales == 0) { dyn_error(\"png: tipo de color inválido\") }\n    si (prof != 1 y prof != 2 y prof != 4 y prof != 8 y prof != 16) { dyn_error(\"png: profundidad inválida\") }\n    si (ct == 3 y __cargar64(info + 72) == 0) { dyn_error(\"png: falta la paleta\") }\n    sea bits_px = canales * prof\n    sea bpp = bits_px / 8\n    si (bpp < 1) { bpp = 1 }\n    // Tamaño exacto de los datos filtrados (con Adam7, la suma de los pases):\n    // inflar no puede producir más.\n    sea esperado = 0\n    si (entrelazado == 1) {\n        sea a7l = \"aeacabaaaeacabiieeccbiiieecc\"\n        sea ps = 0\n        mientras (ps < 7) {\n            sea px0 = str_byte(a7l, ps) - 97\n            sea py0 = str_byte(a7l, 7 + ps) - 97\n            sea pdx = str_byte(a7l, 14 + ps) - 97\n            sea pdy = str_byte(a7l, 21 + ps) - 97\n            si (ancho > px0 y alto > py0) { esperado = esperado + ((alto - py0 + pdy - 1) / pdy) * (1 + (((ancho - px0 + pdx - 1) / pdx) * bits_px + 7) / 8) }\n            ps = ps + 1\n        }\n    } sino { esperado = alto * (1 + (ancho * bits_px + 7) / 8) }\n    si (esperado < 0 o esperado > 4294967296) { dyn_error(\"png: tamaño de datos inválido\") }\n    sea crudo = str_nuevo(esperado + 64)\n    md_zlib_inflar_hasta(str_datos(idat), str_largo(idat), crudo, esperado)\n    sea salida = md_buffer_seguro(ancho, alto, 4)\n    sea sp = str_datos(salida)\n    sea cp = str_datos(crudo)\n    sea total = str_largo(crudo)\n    sea ancho_fila_max = (ancho * bits_px + 7) / 8\n    sea prev = mem_reservar(ancho_fila_max + 8)\n    sea off = 0\n    sea pase = 0\n    sea pases = 1\n    si (entrelazado == 1) { pases = 7 }\n    // Adam7: inicio x, inicio y, paso x, paso y.\n    sea a7 = \"aeacabaaaeacabiieeccbiiieecc\"\n    mientras (pase < pases) {\n        sea x0 = 0\n        sea y0 = 0\n        sea dx = 1\n        sea dy = 1\n        si (entrelazado == 1) {\n            x0 = str_byte(a7, pase) - 97\n            y0 = str_byte(a7, 7 + pase) - 97\n            dx = str_byte(a7, 14 + pase) - 97\n            dy = str_byte(a7, 21 + pase) - 97\n        }\n        sea pw = 0\n        si (ancho > x0) { pw = (ancho - x0 + dx - 1) / dx }\n        sea ph = 0\n        si (alto > y0) { ph = (alto - y0 + dy - 1) / dy }\n        si (pw > 0 y ph > 0) {\n            sea fila_bytes = (pw * bits_px + 7) / 8\n            mem_llenar(prev, 0, fila_bytes)\n            sea yy = 0\n            mientras (yy < ph) {\n                si (off + 1 + fila_bytes > total) { dyn_error(\"png: datos de imagen incompletos\") }\n                sea cur = cp + off + 1\n                md_desfiltrar(__cargar8(cp + off), cur, prev, fila_bytes, bpp)\n                md_png_fila(info, cur, pw, sp, ancho, y0 + yy * dy, x0, dx)\n                mem_copiar(prev, cur, fila_bytes)\n                off = off + 1 + fila_bytes\n                yy = yy + 1\n            }\n        }\n        pase = pase + 1\n    }\n    mem_liberar(prev)\n    mem_liberar(info)\n    mem_liberar(pal)\n    retornar md_lista3(dyn_entero(ancho), dyn_entero(alto), dyn_texto(salida))\n}\n\nfuncion md_png_bloque(s, tipo, datos) {\n    md_agregar_be32(s, str_largo(datos))\n    sea inicio = str_largo(s)\n    str_agregar(s, tipo)\n    str_agregar(s, datos)\n    md_agregar_be32(s, md_crc(0, str_datos(s) + inicio, str_largo(datos) + 4))\n    retornar 0\n}\n\n// Codifica RGBA (o RGB si todo es opaco) con filtro adaptativo por fila.\nfuncion png_codificar(pixeles, ancho, alto, nivel) {\n    sea px = dyn_a_str(pixeles)\n    sea w = md_ent(ancho)\n    sea h = md_ent(alto)\n    si (w <= 0 o h <= 0 o str_largo(px) < w * h * 4) { dyn_error(\"png_codificar: dimensiones y píxeles no coinciden\") }\n    sea p = str_datos(px)\n    sea opaco = 1\n    sea i = 0\n    mientras (i < w * h y opaco == 1) {\n        si (__cargar8(p + i * 4 + 3) != 255) { opaco = 0 }\n        i = i + 1\n    }\n    sea canales = 4\n    si (opaco == 1) { canales = 3 }\n    sea fila = w * canales\n    sea crudo = md_buffer_seguro(fila + 1, h, 1)\n    sea cp = str_datos(crudo)\n    sea actual = mem_reservar(fila + 8)\n    sea previa = mem_reservar(fila + 8)\n    sea prueba = mem_reservar(fila + 8)\n    mem_llenar(previa, 0, fila)\n    sea yy = 0\n    mientras (yy < h) {\n        sea x = 0\n        mientras (x < w) {\n            sea c = 0\n            mientras (c < canales) {\n                __guardar8(actual + x * canales + c, __cargar8(p + (yy * w + x) * 4 + c))\n                c = c + 1\n            }\n            x = x + 1\n        }\n        // Elegir el filtro con menor suma de valores absolutos (con signo).\n        sea mejor = 0\n        sea mejor_suma = 0 - 1\n        sea f = 0\n        mientras (f < 5) {\n            sea suma = 0\n            sea k = 0\n            mientras (k < fila) {\n                sea a = 0\n                sea c = 0\n                si (k >= canales) {\n                    a = __cargar8(actual + k - canales)\n                    c = __cargar8(previa + k - canales)\n                }\n                sea b = __cargar8(previa + k)\n                sea v = __cargar8(actual + k)\n                si (f == 1) { v = v - a }\n                si (f == 2) { v = v - b }\n                si (f == 3) { v = v - (a + b) / 2 }\n                si (f == 4) { v = v - md_paeth(a, b, c) }\n                v = __y_bits(v, 255)\n                __guardar8(prueba + k, v)\n                si (v < 128) { suma = suma + v } sino { suma = suma + 256 - v }\n                k = k + 1\n            }\n            si (mejor_suma < 0 o suma < mejor_suma) {\n                mejor_suma = suma\n                mejor = f\n                mem_copiar(cp + yy * (fila + 1) + 1, prueba, fila)\n            }\n            f = f + 1\n        }\n        __guardar8(cp + yy * (fila + 1), mejor)\n        mem_copiar(previa, actual, fila)\n        yy = yy + 1\n    }\n    mem_liberar(actual)\n    mem_liberar(previa)\n    mem_liberar(prueba)\n    sea z = str_nuevo(str_largo(crudo) / 2 + 64)\n    md_zlib_deflar(cp, str_largo(crudo), z, md_nivel(nivel))\n    sea s = str_nuevo(str_largo(z) + 128)\n    md_agregar_bytes(s, \"137,80,78,71,13,10,26,10\")\n    sea ihdr = str_nuevo(13)\n    md_agregar_be32(ihdr, w)\n    md_agregar_be32(ihdr, h)\n    str_agregar_byte(ihdr, 8)\n    si (opaco == 1) { str_agregar_byte(ihdr, 2) } sino { str_agregar_byte(ihdr, 6) }\n    str_agregar_byte(ihdr, 0)\n    str_agregar_byte(ihdr, 0)\n    str_agregar_byte(ihdr, 0)\n    md_png_bloque(s, \"IHDR\", ihdr)\n    md_png_bloque(s, \"IDAT\", z)\n    md_png_bloque(s, \"IEND\", \"\")\n    retornar dyn_texto(s)\n}\n\n// ── BMP (8, 24 y 32 bits sin compresión) ───────────────────────────────────\n\nfuncion bmp_decodificar(datos) {\n    sea s = dyn_a_str(datos)\n    sea p = str_datos(s)\n    sea n = str_largo(s)\n    si (n < 54 o __cargar8(p) != 66 o __cargar8(p + 1) != 77) { dyn_error(\"bmp: firma inválida\") }\n    sea off = md_le32(p + 10)\n    sea cab = md_le32(p + 14)\n    sea w = md_le32(p + 18)\n    sea h = md_le32(p + 22)\n    si (h > 2147483647) { h = h - 4294967296 }\n    sea abajo_arriba = 1\n    si (h < 0) {\n        h = 0 - h\n        abajo_arriba = 0\n    }\n    md_validar_dimensiones(\"bmp\", w, h)\n    sea bits = md_le16(p + 28)\n    sea comp = md_le32(p + 30)\n    si (comp != 0 y comp != 3) { dyn_error(\"bmp: compresión no soportada\") }\n    si (bits != 8 y bits != 24 y bits != 32) { dyn_error(\"bmp: solo 8, 24 y 32 bits\") }\n    sea fila = __y_bits(w * bits / 8 + 3, 0 - 4)\n    si (off + fila * h > n) { dyn_error(\"bmp: datos truncados\") }\n    sea paleta = p + 14 + cab\n    sea salida = md_buffer_seguro(w, h, 4)\n    sea q = str_datos(salida)\n    sea yy = 0\n    mientras (yy < h) {\n        sea fy = yy\n        si (abajo_arriba == 1) { fy = h - 1 - yy }\n        sea r = p + off + fy * fila\n        sea x = 0\n        mientras (x < w) {\n            sea po = q + (yy * w + x) * 4\n            si (bits == 8) {\n                sea ix = __cargar8(r + x)\n                __guardar8(po, __cargar8(paleta + ix * 4 + 2))\n                __guardar8(po + 1, __cargar8(paleta + ix * 4 + 1))\n                __guardar8(po + 2, __cargar8(paleta + ix * 4))\n                __guardar8(po + 3, 255)\n            } sino {\n                sea b = bits / 8\n                __guardar8(po, __cargar8(r + x * b + 2))\n                __guardar8(po + 1, __cargar8(r + x * b + 1))\n                __guardar8(po + 2, __cargar8(r + x * b))\n                si (b == 4) { __guardar8(po + 3, __cargar8(r + x * b + 3)) } sino { __guardar8(po + 3, 255) }\n            }\n            x = x + 1\n        }\n        yy = yy + 1\n    }\n    retornar md_lista3(dyn_entero(w), dyn_entero(h), dyn_texto(salida))\n}\n\n// ── JPEG (baseline y progresivo, Huffman) ──────────────────────────────────\n\nfuncion md_zigzag() {\n    sea t = mem_global(43)\n    si (t != 0) { retornar t }\n    t = mem_reservar(64 * 8)\n    sea k = 0\n    sea s = 0\n    mientras (s < 15) {\n        sea lo = 0\n        si (s > 7) { lo = s - 7 }\n        sea hi = s\n        si (hi > 7) { hi = 7 }\n        si (s % 2 == 0) {\n            sea f = hi\n            mientras (f >= lo) {\n                __guardar64(t + k * 8, f * 8 + s - f)\n                k = k + 1\n                f = f - 1\n            }\n        } sino {\n            sea f = lo\n            mientras (f <= hi) {\n                __guardar64(t + k * 8, f * 8 + s - f)\n                k = k + 1\n                f = f + 1\n            }\n        }\n        s = s + 1\n    }\n    mem_fijar_global(43, t)\n    retornar t\n}\n\n// Tabla: [maxcode 17][mincode 17][valptr 17][vals 256][rápida 512] = 6552 B.\nfuncion md_jh_construir(h, conteos, vals) {\n    sea k = 0\n    sea codigo = 0\n    sea rapida = h + 2456\n    mem_llenar(rapida, 0, 4096)\n    sea i = 0\n    mientras (i < 256) {\n        __guardar64(h + 408 + i * 8, __cargar8(vals + i))\n        i = i + 1\n    }\n    sea l = 1\n    mientras (l <= 16) {\n        sea c = __cargar8(conteos + l - 1)\n        __guardar64(h + 272 + l * 8, k)\n        __guardar64(h + 136 + l * 8, codigo)\n        sea j = 0\n        mientras (j < c) {\n            si (l <= 9) {\n                sea entrada = __desplazar_izq(__cargar8(vals + k), 4) + l\n                sea base = __desplazar_izq(codigo, 9 - l)\n                sea m = 0\n                mientras (m < __desplazar_izq(1, 9 - l)) {\n                    __guardar64(rapida + (base + m) * 8, entrada)\n                    m = m + 1\n                }\n            }\n            codigo = codigo + 1\n            k = k + 1\n            j = j + 1\n        }\n        si (c > 0) { __guardar64(h + l * 8, codigo - 1) } sino { __guardar64(h + l * 8, 0 - 1) }\n        codigo = __desplazar_izq(codigo, 1)\n        l = l + 1\n    }\n    retornar 0\n}\n\n// Lector de bits: [p][n][pos][buf][cnt][marcador]\nfuncion md_jl_llenar(r) {\n    sea buf = __cargar64(r + 24)\n    sea cnt = __cargar64(r + 32)\n    sea pos = __cargar64(r + 16)\n    sea n = __cargar64(r + 8)\n    sea p = __cargar64(r)\n    mientras (cnt <= 48) {\n        sea b = 0\n        si (__cargar64(r + 40) == 0 y pos < n) {\n            b = __cargar8(p + pos)\n            si (b == 255) {\n                sea sig = 0\n                si (pos + 1 < n) { sig = __cargar8(p + pos + 1) }\n                si (sig == 0) { pos = pos + 2 } sino {\n                    __guardar64(r + 40, sig)\n                    b = 0\n                }\n            } sino { pos = pos + 1 }\n        }\n        buf = __o_bits(__desplazar_izq(buf, 8), b)\n        cnt = cnt + 8\n    }\n    __guardar64(r + 24, buf)\n    __guardar64(r + 32, cnt)\n    __guardar64(r + 16, pos)\n    retornar 0\n}\n\nfuncion md_jl_bits(r, n) {\n    si (n == 0) { retornar 0 }\n    si (__cargar64(r + 32) < n) { md_jl_llenar(r) }\n    sea cnt = __cargar64(r + 32) - n\n    sea buf = __cargar64(r + 24)\n    sea v = __y_bits(__desplazar_der(buf, cnt), __desplazar_izq(1, n) - 1)\n    __guardar64(r + 24, __y_bits(buf, __desplazar_izq(1, cnt) - 1))\n    __guardar64(r + 32, cnt)\n    retornar v\n}\n\nfuncion md_jl_dec(r, h) {\n    si (__cargar64(r + 32) < 16) { md_jl_llenar(r) }\n    sea cnt = __cargar64(r + 32)\n    sea buf = __cargar64(r + 24)\n    sea e = __cargar64(h + 2456 + __y_bits(__desplazar_der(buf, cnt - 9), 511) * 8)\n    si (e != 0) {\n        sea l = __y_bits(e, 15)\n        __guardar64(r + 32, cnt - l)\n        __guardar64(r + 24, __y_bits(buf, __desplazar_izq(1, cnt - l) - 1))\n        retornar __desplazar_der(e, 4)\n    }\n    sea l = 10\n    mientras (l <= 16) {\n        sea codigo = __desplazar_der(buf, cnt - l)\n        si (codigo <= __cargar64(h + l * 8)) {\n            __guardar64(r + 32, cnt - l)\n            __guardar64(r + 24, __y_bits(buf, __desplazar_izq(1, cnt - l) - 1))\n            retornar __cargar64(h + 408 + (__cargar64(h + 272 + l * 8) + codigo - __cargar64(h + 136 + l * 8)) * 8)\n        }\n        l = l + 1\n    }\n    dyn_error(\"jpeg: código Huffman inválido\")\n    retornar 0\n}\n\nfuncion md_extender(v, s) {\n    si (s == 0) { retornar 0 }\n    si (v < __desplazar_izq(1, s - 1)) { retornar v - __desplazar_izq(1, s) + 1 }\n    retornar v\n}\n\nfuncion md_c16(p) {\n    sea v = __o_bits(__cargar8(p), __despl