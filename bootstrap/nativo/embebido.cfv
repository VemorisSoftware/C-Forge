funcion runtime_fuente(i) {
    si (i == 0) { retornar "// runtime/sys_linux.cfv — llamadas al sistema de Linux x86-64.\n// Único archivo del runtime que conoce el sistema operativo: para Windows y\n// macOS se escribe sys_windows.cfv / sys_macos.cfv con las mismas funciones.\n\nfuncion sys_leer(fd, destino, cantidad) {\n    retornar __syscall(0, fd, destino, cantidad)\n}\n\nfuncion sys_escribir(fd, origen, cantidad) {\n    retornar __syscall(1, fd, origen, cantidad)\n}\n\n// banderas: 0 = solo lectura; 577 = escritura | crear | truncar\nfuncion sys_abrir(ruta_c, banderas, modo) {\n    retornar __syscall(2, ruta_c, banderas, modo)\n}\n\nfuncion sys_cerrar(fd) {\n    retornar __syscall(3, fd)\n}\n\n// Memoria anónima de lectura y escritura (PROT_READ|PROT_WRITE = 3,\n// MAP_PRIVATE|MAP_ANONYMOUS = 34).\nfuncion sys_mapear(tamano) {\n    retornar __syscall(9, 0, tamano, 3, 34, 0 - 1, 0)\n}\n\nfuncion sys_desmapear(direccion, tamano) {\n    retornar __syscall(11, direccion, tamano)\n}\n\n// Termina el proceso completo (todos los hilos): exit_group.\nfuncion sys_salir(codigo) {\n    retornar __syscall(231, codigo)\n}\n\nfuncion sys_argc() {\n    retornar __argc()\n}\n\nfuncion sys_argv(indice) {\n    retornar __argv(indice)\n}\n\n// Constantes del sistema para el resto del runtime.\nfuncion sys_abrir_lectura() { retornar 0 }\nfuncion sys_abrir_escritura() { retornar 577 }\nfuncion sys_modo_archivo() { retornar 420 }\n\n// Cambia los permisos de un archivo (chmod); 493 = 0755.\nfuncion sys_permisos(ruta_c, modo) {\n    retornar __syscall(90, ruta_c, modo)\n}\n\n// ── Procesos y rutas (para el CLI de cforge) ──────────────────────────────\nfuncion sys_proceso_id() { retornar __syscall(39) }\nfuncion sys_bifurcar() { retornar __syscall(57) }\nfuncion sys_ejecutar(ruta_c, argv, envp) { retornar __syscall(59, ruta_c, argv, envp) }\nfuncion sys_borrar(ruta_c) { retornar __syscall(87, ruta_c) }\n\n// Espera al proceso y devuelve su código de salida (128 + señal si murió).\nfuncion sys_esperar(pid) {\n    sea estado = mem_reservar(8)\n    __guardar64(estado, 0)\n    __syscall(61, pid, estado, 0, 0)\n    sea s = __y_bits(__cargar64(estado), 65535)\n    mem_liberar(estado)\n    si (__y_bits(s, 127) == 0) { retornar __y_bits(__desplazar_der(s, 8), 255) }\n    retornar 128 + __y_bits(s, 127)\n}\n\n// Destino de un enlace simbólico (p. ej. /proc/self/exe), o 0.\nfuncion sys_leer_enlace(ruta_c) {\n    sea buf = mem_reservar(4096)\n    sea n = __syscall(89, ruta_c, buf, 4095)\n    si (n < 0) {\n        mem_liberar(buf)\n        retornar 0\n    }\n    __guardar8(buf + n, 0)\n    sea r = str_desde_c(buf)\n    mem_liberar(buf)\n    retornar r\n}\n\n// Entorno del proceso: envp[i] o 0 (envp sigue a argv en la pila inicial).\nfuncion sys_entorno(i) { retornar __argv(sys_argc() + 1 + i) }\n\nfuncion sys_ceder() { __syscall(24) retornar 0 }                 // sched_yield\nfuncion sys_es_windows() { retornar 0 }\nfuncion sys_nombre_plataforma() { retornar \"Linux x86-64\" }\nfuncion sys_ruta_ejecutable() { retornar sys_leer_enlace(str_c(\"/proc/self/exe\")) }\nfuncion sys_ruta_temporal() { retornar \"/tmp/\" }\n\n// Valor de una variable de entorno o 0.\nfuncion sys_variable_entorno(nombre) {\n    sea prefijo = str_concatenar(nombre, \"=\")\n    sea i = 0\n    sea p = sys_entorno(0)\n    mientras (p != 0) {\n        sea e = str_desde_c(p)\n        si (str_largo(e) >= str_largo(prefijo)) {\n            si (str_igual(str_rebanar(e, 0, str_largo(prefijo)), prefijo)) { retornar str_rebanar(e, str_largo(prefijo), str_largo(e)) }\n        }\n        i = i + 1\n        p = sys_entorno(i)\n    }\n    retornar 0\n}\n\n// Ejecuta un programa con sus argumentos (lista de textos) y devuelve su\n// código de salida (fork + execve + wait4).\nfuncion sys_ejecutar_programa(ruta, argumentos) {\n    sea n = vec_largo(argumentos)\n    sea argv = mem_reservar((n + 2) * 8)\n    __guardar64(argv, str_c(ruta))\n    sea i = 0\n    mientras (i < n) {\n        __guardar64(argv + 8 + i * 8, str_c(vec_obtener(argumentos, i)))\n        i = i + 1\n    }\n    __guardar64(argv + 8 + n * 8, 0)\n    sea envp = __cargar64(__globales() + 504) + 8 * (sys_argc() + 2)\n    sea pid = sys_bifurcar()\n    si (pid == 0) {\n        sys_ejecutar(str_c(ruta), argv, envp)\n        sys_salir(127)\n    }\n    retornar sys_esperar(pid)\n}\n\n// Crea un directorio (0755); 0 si se creó o ya existía.\nfuncion sys_crear_directorio(ruta_c) {\n    sea r = __syscall(83, ruta_c, 493)\n    si (r == 0 - 17) { retornar 0 }                            // EEXIST\n    retornar r\n}\n\n// Directorio de trabajo actual (getcwd), o 0.\nfuncion sys_directorio_actual() {\n    sea buf = mem_reservar(4096)\n    sea r = 0\n    si (__syscall(79, buf, 4096) > 0) { r = str_desde_c(buf) }\n    mem_liberar(buf)\n    retornar r\n}\n\n// Nombres de archivo en un directorio (getdents64), o 0 si no existe.\nfuncion sys_listar(ruta) {\n    sea fd = sys_abrir(str_c(ruta), 65536, 0)                  // O_DIRECTORY\n    si (fd < 0) { retornar 0 }\n    sea r = vec_nuevo()\n    sea buf = mem_reservar(8192)\n    sea seguir = 1\n    mientras (seguir) {\n        sea n = __syscall(217, fd, buf, 8192)\n        si (n <= 0) {\n            seguir = 0\n        } sino {\n            sea p = 0\n            mientras (p < n) {\n                sea largo = __cargar8(buf + p + 16) + __cargar8(buf + p + 17) * 256\n                vec_agregar(r, str_desde_c(buf + p + 19))\n                p = p + largo\n            }\n        }\n    }\n    mem_liberar(buf)\n    sys_cerrar(fd)\n    retornar r\n}\n" }
    si (i == 1) { retornar "// runtime/mem.cfv — gestor de memoria propio (sin malloc ni libc).\n//\n// Bloques chicos (hasta 32 KiB) salen de arenas de 64 MiB pedidas con\n// sys_mapear y se reciclan con listas libres por clase de tamaño (potencias\n// de 2 desde 16 bytes). Los bloques grandes se mapean y desmapean directo.\n// Cada bloque lleva 8 bytes de cabecera: la clase (>= 0) o -tamaño mapeado.\n//\n// Globales (ver __globales): 0 = cursor de la arena, 1 = fin de la arena,\n// 2..13 = listas libres de las clases 0..11, 14 = bytes en uso.\n\nfuncion mem_global(i) {\n    retornar __cargar64(__globales() + i * 8)\n}\n\nfuncion mem_fijar_global(i, valor) {\n    __guardar64(__globales() + i * 8, valor)\n    retornar 0\n}\n\nfuncion mem_clase(total) {\n    sea clase = 0\n    sea tamano = 16\n    mientras (tamano < total) {\n        tamano = tamano * 2\n        clase = clase + 1\n    }\n    retornar clase\n}\n\nfuncion mem_tamano_clase(clase) {\n    retornar __desplazar_izq(16, clase)\n}\n\nfuncion mem_reservar_sin_cerrojo(bytes) {\n    sea total = bytes + 8\n    sea clase = mem_clase(total)\n    si (clase > 11) {\n        sea paginas = (total + 4095) / 4096 * 4096\n        sea grande = sys_mapear(paginas)\n        si (grande < 0) { rt_panico(\"sin memoria\") }\n        __guardar64(grande, 0 - paginas)\n        mem_fijar_global(14, mem_global(14) + paginas)\n        retornar grande + 8\n    }\n    sea libre = mem_global(2 + clase)\n    si (libre != 0) {\n        mem_fijar_global(2 + clase, __cargar64(libre))\n        __guardar64(libre - 8, clase)\n        mem_fijar_global(14, mem_global(14) + mem_tamano_clase(clase))\n        retornar libre\n    }\n    sea tamano = mem_tamano_clase(clase)\n    sea cursor = mem_global(0)\n    si (cursor == 0 o cursor + tamano > mem_global(1)) {\n        sea arena = sys_mapear(67108864)\n        si (arena < 0) { rt_panico(\"sin memoria\") }\n        cursor = arena\n        mem_fijar_global(1, arena + 67108864)\n    }\n    mem_fijar_global(0, cursor + tamano)\n    __guardar64(cursor, clase)\n    mem_fijar_global(14, mem_global(14) + tamano)\n    retornar cursor + 8\n}\n\nfuncion mem_liberar_sin_cerrojo(puntero) {\n    si (puntero == 0) { retornar 0 }\n    sea cabecera = __cargar64(puntero - 8)\n    si (cabecera < 0) {\n        mem_fijar_global(14, mem_global(14) + cabecera)\n        sys_desmapear(puntero - 8, 0 - cabecera)\n        retornar 0\n    }\n    __guardar64(puntero, mem_global(2 + cabecera))\n    mem_fijar_global(2 + cabecera, puntero)\n    mem_fijar_global(14, mem_global(14) - mem_tamano_clase(cabecera))\n    retornar 0\n}\n\nfuncion mem_en_uso() {\n    retornar mem_global(14)\n}\n\nfuncion mem_copiar(destino, origen, bytes) {\n    sea i = 0\n    mientras (i + 8 <= bytes) {\n        __guardar64(destino + i, __cargar64(origen + i))\n        i = i + 8\n    }\n    mientras (i < bytes) {\n        __guardar8(destino + i, __cargar8(origen + i))\n        i = i + 1\n    }\n    retornar destino\n}\n\nfuncion mem_llenar(destino, byte, bytes) {\n    sea i = 0\n    mientras (i < bytes) {\n        __guardar8(destino + i, byte)\n        i = i + 1\n    }\n    retornar destino\n}\n\n// ── Cerrojo del asignador (global 25) ─────────────────────────────────────\n// Los hilos (clone) comparten el heap: reservar y liberar se serializan con\n// un intercambio atómico (xchg); mientras está ocupado se cede la CPU.\nfuncion mem_cerrar() {\n    sea cerrojo = __globales() + 200\n    mientras (__intercambiar(cerrojo, 1) != 0) { sys_ceder() }\n    retornar 0\n}\n\nfuncion mem_abrir() {\n    __guardar64(__globales() + 200, 0)\n    retornar 0\n}\n\nfuncion mem_reservar(bytes) {\n    mem_cerrar()\n    sea p = mem_reservar_sin_cerrojo(bytes)\n    mem_abrir()\n    retornar p\n}\n\nfuncion mem_liberar(puntero) {\n    mem_cerrar()\n    mem_liberar_sin_cerrojo(puntero)\n    mem_abrir()\n    retornar 0\n}\n" }
    si (i == 2) { retornar "// runtime/str.cfv — textos dinámicos.\n//\n// Un texto es un puntero a 32 bytes: [largo][capacidad][datos][propio].\n// \"propio\" vale 1 si los datos son del montículo y 0 si son estáticos (los\n// literales del programa). Los datos siempre terminan en un byte 0 extra para\n// pasarlos al sistema operativo sin copiar.\n\nfuncion str_nuevo(capacidad) {\n    si (capacidad < 15) { capacidad = 15 }\n    sea s = mem_reservar(32)\n    __guardar64(s, 0)\n    __guardar64(s + 8, capacidad)\n    sea datos = mem_reservar(capacidad + 1)\n    __guardar8(datos, 0)\n    __guardar64(s + 16, datos)\n    __guardar64(s + 24, 1)\n    retornar s\n}\n\nfuncion str_largo(s) { retornar __cargar64(s) }\nfuncion str_datos(s) { retornar __cargar64(s + 16) }\n\nfuncion str_byte(s, i) {\n    si (i < 0 o i >= __cargar64(s)) { rt_panico(\"índice de texto fuera de rango\") }\n    retornar __cargar8(__cargar64(s + 16) + i)\n}\n\n// Garantiza espacio para al menos `minimo` bytes (más el 0 final).\nfuncion str_asegurar(s, minimo) {\n    sea capacidad = __cargar64(s + 8)\n    si (minimo <= capacidad y __cargar64(s + 24) == 1) { retornar 0 }\n    sea nueva = capacidad * 2\n    si (nueva < minimo) { nueva = minimo }\n    si (nueva < 15) { nueva = 15 }\n    sea datos = mem_reservar(nueva + 1)\n    mem_copiar(datos, __cargar64(s + 16), __cargar64(s))\n    __guardar8(datos + __cargar64(s), 0)\n    si (__cargar64(s + 24) == 1) { mem_liberar(__cargar64(s + 16)) }\n    __guardar64(s + 8, nueva)\n    __guardar64(s + 16, datos)\n    __guardar64(s + 24, 1)\n    retornar 0\n}\n\nfuncion str_agregar_byte(s, byte) {\n    sea largo = __cargar64(s)\n    str_asegurar(s, largo + 1)\n    sea datos = __cargar64(s + 16)\n    __guardar8(datos + largo, byte)\n    __guardar8(datos + largo + 1, 0)\n    __guardar64(s, largo + 1)\n    retornar s\n}\n\nfuncion str_agregar(s, otro) {\n    sea largo = __cargar64(s)\n    sea extra = __cargar64(otro)\n    str_asegurar(s, largo + extra)\n    sea datos = __cargar64(s + 16)\n    mem_copiar(datos + largo, __cargar64(otro + 16), extra)\n    __guardar8(datos + largo + extra, 0)\n    __guardar64(s, largo + extra)\n    retornar s\n}\n\nfuncion str_concatenar(a, b) {\n    sea r = str_nuevo(__cargar64(a) + __cargar64(b))\n    str_agregar(r, a)\n    str_agregar(r, b)\n    retornar r\n}\n\nfuncion str_rebanar(s, inicio, fin) {\n    si (inicio < 0) { inicio = 0 }\n    si (fin > __cargar64(s)) { fin = __cargar64(s) }\n    si (fin < inicio) { fin = inicio }\n    sea r = str_nuevo(fin - inicio)\n    mem_copiar(__cargar64(r + 16), __cargar64(s + 16) + inicio, fin - inicio)\n    __guardar8(__cargar64(r + 16) + fin - inicio, 0)\n    __guardar64(r, fin - inicio)\n    retornar r\n}\n\nfuncion str_igual(a, b) {\n    sea largo = __cargar64(a)\n    si (largo != __cargar64(b)) { retornar 0 }\n    sea da = __cargar64(a + 16)\n    sea db = __cargar64(b + 16)\n    sea i = 0\n    mientras (i < largo) {\n        si (__cargar8(da + i) != __cargar8(db + i)) { retornar 0 }\n        i = i + 1\n    }\n    retornar 1\n}\n\nfuncion str_desde_entero(n) {\n    sea r = str_nuevo(24)\n    si (n == 0) {\n        str_agregar_byte(r, 48)\n        retornar r\n    }\n    sea negativo = n < 0\n    sea inverso = str_nuevo(24)\n    mientras (n != 0) {\n        sea digito = n % 10\n        si (digito < 0) { digito = 0 - digito }\n        str_agregar_byte(inverso, 48 + digito)\n        n = n / 10\n    }\n    si (negativo) { str_agregar_byte(r, 45) }\n    sea i = __cargar64(inverso) - 1\n    mientras (i >= 0) {\n        str_agregar_byte(r, str_byte(inverso, i))\n        i = i - 1\n    }\n    str_liberar(inverso)\n    retornar r\n}\n\n// Texto a partir de una cadena C terminada en 0 (argv, entorno).\nfuncion str_desde_c(puntero) {\n    sea largo = 0\n    mientras (__cargar8(puntero + largo) != 0) { largo = largo + 1 }\n    sea r = str_nuevo(largo)\n    mem_copiar(__cargar64(r + 16), puntero, largo)\n    __guardar8(__cargar64(r + 16) + largo, 0)\n    __guardar64(r, largo)\n    retornar r\n}\n\n// Puntero a bytes terminados en 0, válido mientras el texto no cambie.\nfuncion str_c(s) {\n    si (__cargar64(s + 24) == 0) {\n        // Los literales ya terminan en 0.\n        retornar __cargar64(s + 16)\n    }\n    retornar __cargar64(s + 16)\n}\n\nfuncion str_liberar(s) {\n    si (__cargar64(s + 24) == 1) { mem_liberar(__cargar64(s + 16)) }\n    mem_liberar(s)\n    retornar 0\n}\n" }
    si (i == 3) { retornar "// runtime/vec.cfv — listas dinámicas de valores de 64 bits.\n// Una lista es un puntero a 24 bytes: [largo][capacidad][datos].\n\nfuncion vec_nuevo() {\n    sea v = mem_reservar(24)\n    __guardar64(v, 0)\n    __guardar64(v + 8, 8)\n    __guardar64(v + 16, mem_reservar(64))\n    retornar v\n}\n\nfuncion vec_largo(v) { retornar __cargar64(v) }\n\nfuncion vec_agregar(v, valor) {\n    sea largo = __cargar64(v)\n    sea capacidad = __cargar64(v + 8)\n    si (largo == capacidad) {\n        sea nueva = capacidad * 2\n        sea datos = mem_reservar(nueva * 8)\n        mem_copiar(datos, __cargar64(v + 16), largo * 8)\n        mem_liberar(__cargar64(v + 16))\n        __guardar64(v + 8, nueva)\n        __guardar64(v + 16, datos)\n    }\n    __guardar64(__cargar64(v + 16) + largo * 8, valor)\n    __guardar64(v, largo + 1)\n    retornar v\n}\n\nfuncion vec_obtener(v, i) {\n    si (i < 0 o i >= __cargar64(v)) { rt_panico(\"índice de lista fuera de rango\") }\n    retornar __cargar64(__cargar64(v + 16) + i * 8)\n}\n\nfuncion vec_fijar(v, i, valor) {\n    si (i < 0 o i >= __cargar64(v)) { rt_panico(\"índice de lista fuera de rango\") }\n    __guardar64(__cargar64(v + 16) + i * 8, valor)\n    retornar valor\n}\n\nfuncion vec_quitar_ultimo(v) {\n    sea largo = __cargar64(v)\n    si (largo == 0) { rt_panico(\"la lista está vacía\") }\n    __guardar64(v, largo - 1)\n    retornar __cargar64(__cargar64(v + 16) + (largo - 1) * 8)\n}\n\nfuncion vec_liberar(v) {\n    mem_liberar(__cargar64(v + 16))\n    mem_liberar(v)\n    retornar 0\n}\n" }
    si (i == 4) { retornar "// runtime/io.cfv — salida, archivos y argumentos del programa.\n\nfuncion rt_escribir_texto(fd, s) {\n    sea escritos = 0\n    sea largo = str_largo(s)\n    mientras (escritos < largo) {\n        sea n = sys_escribir(fd, str_datos(s) + escritos, largo - escritos)\n        si (n <= 0) { retornar 0 - 1 }\n        escritos = escritos + n\n    }\n    retornar escritos\n}\n\n// mostrar(texto) del programa llama aquí.\nfuncion rt_mostrar(s) {\n    // Con el modo diagnóstico (global 39) la salida va a stderr: stdout es\n    // el canal del protocolo del servidor de lenguaje.\n    si (mem_global(39) != 0) {\n        rt_escribir_texto(2, s)\n        rt_escribir_texto(2, \"\\n\")\n        retornar 0\n    }\n    rt_escribir_texto(1, s)\n    rt_escribir_texto(1, \"\\n\")\n    retornar 0\n}\n\nfuncion rt_panico(mensaje) {\n    // Modo diagnóstico (global 37 = ruta): el mensaje se guarda en ese\n    // archivo para el servidor de lenguaje (cforge lsp).\n    sea diagnosticos = mem_global(37)\n    si (diagnosticos != 0) {\n        mem_fijar_global(37, 0)\n        archivo_escribir(diagnosticos, mensaje)\n    }\n    rt_escribir_texto(2, \"[C-Forge] \")\n    rt_escribir_texto(2, mensaje)\n    rt_escribir_texto(2, \"\\n\")\n    sys_salir(1)\n    retornar 0\n}\n\nfuncion rt_argc() { retornar sys_argc() }\n\nfuncion rt_argumento(i) {\n    si (i < 0 o i >= sys_argc()) { rt_panico(\"argumento inexistente\") }\n    retornar str_desde_c(sys_argv(i))\n}\n\nfuncion archivo_leer(ruta) {\n    sea fd = sys_abrir(str_c(ruta), sys_abrir_lectura(), 0)\n    si (fd < 0) { rt_panico(str_concatenar(\"no se pudo abrir \", ruta)) }\n    sea contenido = str_nuevo(4096)\n    sea seguir = 1\n    mientras (seguir) {\n        str_asegurar(contenido, str_largo(contenido) + 65536)\n        sea n = sys_leer(fd, str_datos(contenido) + str_largo(contenido), 65536)\n        si (n < 0) { rt_panico(str_concatenar(\"error al leer \", ruta)) }\n        si (n == 0) {\n            seguir = 0\n        } sino {\n            __guardar64(contenido, str_largo(contenido) + n)\n        }\n    }\n    __guardar8(str_datos(contenido) + str_largo(contenido), 0)\n    sys_cerrar(fd)\n    retornar contenido\n}\n\nfuncion archivo_escribir(ruta, contenido) {\n    sea fd = sys_abrir(str_c(ruta), sys_abrir_escritura(), sys_modo_archivo())\n    si (fd < 0) { rt_panico(str_concatenar(\"no se pudo escribir \", ruta)) }\n    sea n = rt_escribir_texto(fd, contenido)\n    sys_cerrar(fd)\n    si (n < 0) { rt_panico(str_concatenar(\"escritura incompleta en \", ruta)) }\n    retornar n\n}\n" }
    si (i == 5) { retornar "// runtime/f64.cfv — números decimales (f64) a texto.\n//\n// Los f64 viajan como sus 64 bits. Formato: hasta 6 decimales sin ceros\n// sobrantes (\"3.5\", \"0.333333\", \"-2\"); notación científica desde 1e15;\n// \"nan\", \"inf\" y \"-inf\" para los valores especiales.\n\nfuncion f64_desde_entero(n) { retornar __f64_desde_entero(n) }\n\nfuncion f64_desde_fraccion(numerador, denominador) {\n    retornar __f64_div(__f64_desde_entero(numerador), __f64_desde_entero(denominador))\n}\n\nfuncion str_digitos_ceros(r, valor, ancho) {\n    sea digitos = str_desde_entero(valor)\n    sea faltan = ancho - str_largo(digitos)\n    mientras (faltan > 0) {\n        str_agregar_byte(r, 48)\n        faltan = faltan - 1\n    }\n    str_agregar(r, digitos)\n    str_liberar(digitos)\n    retornar r\n}\n\nfuncion str_desde_f64(bits) {\n    sea r = str_nuevo(32)\n    sea exponente = __y_bits(__desplazar_der(bits, 52), 2047)\n    sea negativo = bits < 0\n    // Valor absoluto: limpia el bit de signo.\n    sea absoluto = __desplazar_der(__desplazar_izq(bits, 1), 1)\n    si (exponente == 2047) {\n        si (__desplazar_izq(bits, 12) != 0) {\n            str_agregar(r, \"nan\")\n            retornar r\n        }\n        si (negativo) { str_agregar_byte(r, 45) }\n        str_agregar(r, \"inf\")\n        retornar r\n    }\n    si (negativo y absoluto != 0) { str_agregar_byte(r, 45) }\n    sea diez = __f64_desde_entero(10)\n    sea limite = __f64_desde_entero(1000000000)\n    limite = __f64_mul(limite, __f64_desde_entero(1000000))       // 1e15\n    sea exponente10 = 0\n    si (__f64_menor(absoluto, limite) == 0) {\n        mientras (__f64_menor(absoluto, diez) == 0) {\n            absoluto = __f64_div(absoluto, diez)\n            exponente10 = exponente10 + 1\n        }\n    }\n    sea millon = __f64_desde_entero(1000000)\n    sea medio = __f64_div(__f64_desde_entero(1), __f64_desde_entero(2))\n    sea entero = __f64_a_entero(absoluto)\n    sea fraccion = __f64_resta(absoluto, __f64_desde_entero(entero))\n    sea decimales = __f64_a_entero(__f64_suma(__f64_mul(fraccion, millon), medio))\n    si (decimales >= 1000000) {\n        entero = entero + 1\n        decimales = decimales - 1000000\n    }\n    sea parte = str_desde_entero(entero)\n    str_agregar(r, parte)\n    str_liberar(parte)\n    si (decimales > 0) {\n        mientras (decimales % 10 == 0) { decimales = decimales / 10 }\n        str_agregar_byte(r, 46)\n        str_digitos_ceros_decimales(r, fraccion, decimales)\n    }\n    si (exponente10 > 0) {\n        str_agregar(r, \"e+\")\n        sea e = str_desde_entero(exponente10)\n        str_agregar(r, e)\n        str_liberar(e)\n    }\n    retornar r\n}\n\n// Escribe los decimales conservando los ceros a la izquierda (3.05 → \"05\").\nfuncion str_digitos_ceros_decimales(r, fraccion, decimales) {\n    sea ceros = 0\n    sea escala = __f64_desde_entero(10)\n    sea f = fraccion\n    sea medio = __f64_div(__f64_desde_entero(1), __f64_desde_entero(2000000))\n    f = __f64_suma(f, medio)\n    sea seguir = 1\n    mientras (seguir y ceros < 6) {\n        f = __f64_mul(f, escala)\n        si (__f64_a_entero(f) == 0) {\n            ceros = ceros + 1\n        } sino {\n            seguir = 0\n        }\n    }\n    mientras (ceros > 0) {\n        str_agregar_byte(r, 48)\n        ceros = ceros - 1\n    }\n    sea digitos = str_desde_entero(decimales)\n    str_agregar(r, digitos)\n    str_liberar(digitos)\n    retornar r\n}\n" }
    si (i == 6) { retornar "// runtime/sys_linux_ext.cfv — funciones de sistema de Linux para los\n// programas del lenguaje (tiempo, hilos, futex, sockets, dlopen). No forman\n// parte del compilador: usan intrínsecos que solo tiene cforge_self.\n\nfuncion sys_reloj_ns() {\n    sea ts = mem_reservar(16)\n    __syscall(228, 0, ts)                                      // CLOCK_REALTIME\n    sea ns = __cargar64(ts) * 1000000000 + __cargar64(ts + 8)\n    mem_liberar(ts)\n    retornar ns\n}\n\nfuncion sys_nucleos() {\n    sea mascara = mem_reservar(128)\n    mem_llenar(mascara, 0, 128)\n    sea n = __syscall(204, 0, 128, mascara)                    // sched_getaffinity\n    sea total = 0\n    si (n > 0) {\n        sea i = 0\n        mientras (i < n) {\n            sea b = __cargar8(mascara + i)\n            mientras (b > 0) {\n                total = total + __y_bits(b, 1)\n                b = __desplazar_der(b, 1)\n            }\n            i = i + 1\n        }\n    }\n    mem_liberar(mascara)\n    si (total < 1) { total = 1 }\n    retornar total\n}\n\nfuncion sys_dormir_ms(n) {\n    sea ts = mem_reservar(16)\n    __guardar64(ts, n / 1000)\n    __guardar64(ts + 8, (n % 1000) * 1000000)\n    __syscall(35, ts, 0)                                       // nanosleep\n    mem_liberar(ts)\n    retornar 0\n}\n\n// op 128: FUTEX_WAIT_PRIVATE · op 0: FUTEX_WAIT compartido (tid de clone).\nfuncion sys_futex_esperar(direccion, valor, ms, op) {\n    si (ms < 0) {\n        __syscall(202, direccion, op, __y_bits(valor, 4294967295), 0)\n        retornar 0\n    }\n    sea ts = mem_reservar(16)\n    __guardar64(ts, ms / 1000)\n    __guardar64(ts + 8, (ms % 1000) * 1000000)\n    __syscall(202, direccion, op, __y_bits(valor, 4294967295), ts)\n    mem_liberar(ts)\n    retornar 0\n}\n\nfuncion sys_futex_despertar(direccion) {\n    __syscall(202, direccion, 129, 2147483647)                 // FUTEX_WAKE_PRIVATE\n    retornar 0\n}\n\n// Hilo con clone en la pila [base, base + tam) que ejecuta dyn_hilo_inicio(t);\n// al terminar, el kernel pone en 0 el tid de base + 16 y despierta (futex).\nfuncion sys_hilo_crear(base, tam, t) {\n    retornar __hilo(base + tam, __dir(\"dyn_hilo_inicio\"), t, base + 16)\n}\n\nfuncion sys_dl_disponible() { retornar __simbolo_dinamico(0) != 0 }\nfuncion sys_cargar_biblioteca(nombre) { retornar __ccall(__simbolo_dinamico(0), str_c(nombre), 258) }   // RTLD_NOW | RTLD_GLOBAL\nfuncion sys_simbolo(h, nombre) { retornar __ccall(__simbolo_dinamico(1), h, str_c(nombre)) }\n\n// Socket TCP escuchando en el puerto: descriptor, o -1 (socket), -2 (bind),\n// -3 (listen).\nfuncion sys_red_escuchar(puerto) {\n    sea fd = __syscall(41, 2, 1, 0)                            // socket(AF_INET, SOCK_STREAM)\n    si (fd < 0) { retornar 0 - 1 }\n    sea uno = mem_reservar(8)\n    __guardar64(uno, 1)\n    __syscall(54, fd, 1, 2, uno, 4)                            // SO_REUSEADDR\n    mem_liberar(uno)\n    sea dir = mem_reservar(16)\n    mem_llenar(dir, 0, 16)\n    __guardar8(dir, 2)                                         // AF_INET\n    __guardar8(dir + 2, __desplazar_der(puerto, 8))            // puerto (big-endian)\n    __guardar8(dir + 3, __y_bits(puerto, 255))\n    sea r = __syscall(49, fd, dir, 16)\n    mem_liberar(dir)\n    si (r != 0) { retornar 0 - 2 }\n    si (__syscall(50, fd, 64) != 0) { retornar 0 - 3 }\n    retornar fd\n}\n\nfuncion sys_red_aceptar(fd, dir, largo_dir) { retornar __syscall(43, fd, dir, largo_dir) }\nfuncion sys_red_leer(fd, buf, n) { retornar sys_leer(fd, buf, n) }\nfuncion sys_red_escribir(fd, buf, n) { retornar sys_escribir(fd, buf, n) }\nfuncion sys_red_cerrar(fd) { retornar sys_cerrar(fd) }\n" }
    si (i == 7) { retornar "// runtime/sys_linux_arm64.cfv — llamadas al sistema de Linux AArch64.\n// Mismas funciones que sys_linux.cfv con la tabla de syscalls genérica de\n// ARM64 (sin open/unlink/readlink: sus variantes *at con AT_FDCWD = -100).\n\nfuncion sys_leer(fd, destino, cantidad) {\n    retornar __syscall(63, fd, destino, cantidad)\n}\n\nfuncion sys_escribir(fd, origen, cantidad) {\n    retornar __syscall(64, fd, origen, cantidad)\n}\n\n// banderas: 0 = solo lectura; 577 = escritura | crear | truncar;\n// 65536 = O_DIRECTORY de x86-64 (16384 en ARM64)\nfuncion sys_abrir(ruta_c, banderas, modo) {\n    si (banderas == 65536) { banderas = 16384 }\n    retornar __syscall(56, 0 - 100, ruta_c, banderas, modo)\n}\n\nfuncion sys_cerrar(fd) {\n    retornar __syscall(57, fd)\n}\n\n// Memoria anónima de lectura y escritura (PROT_READ|PROT_WRITE = 3,\n// MAP_PRIVATE|MAP_ANONYMOUS = 34).\nfuncion sys_mapear(tamano) {\n    retornar __syscall(222, 0, tamano, 3, 34, 0 - 1, 0)\n}\n\nfuncion sys_desmapear(direccion, tamano) {\n    retornar __syscall(215, direccion, tamano)\n}\n\n// Termina el proceso completo (todos los hilos): exit_group.\nfuncion sys_salir(codigo) {\n    retornar __syscall(94, codigo)\n}\n\nfuncion sys_argc() {\n    retornar __argc()\n}\n\nfuncion sys_argv(indice) {\n    retornar __argv(indice)\n}\n\n// Constantes del sistema para el resto del runtime.\nfuncion sys_abrir_lectura() { retornar 0 }\nfuncion sys_abrir_escritura() { retornar 577 }\nfuncion sys_modo_archivo() { retornar 420 }\n\n// Cambia los permisos de un archivo (chmod); 493 = 0755.\nfuncion sys_permisos(ruta_c, modo) {\n    retornar __syscall(53, 0 - 100, ruta_c, modo, 0)\n}\n\n// ── Procesos y rutas (para el CLI de cforge) ──────────────────────────────\nfuncion sys_proceso_id() { retornar __syscall(172) }\nfuncion sys_bifurcar() { retornar __syscall(220, 17, 0, 0, 0, 0) }   // clone(SIGCHLD)\nfuncion sys_ejecutar(ruta_c, argv, envp) { retornar __syscall(221, ruta_c, argv, envp) }\nfuncion sys_borrar(ruta_c) { retornar __syscall(35, 0 - 100, ruta_c, 0) }\n\n// Espera al proceso y devuelve su código de salida (128 + señal si murió).\nfuncion sys_esperar(pid) {\n    sea estado = mem_reservar(8)\n    __guardar64(estado, 0)\n    __syscall(260, pid, estado, 0, 0)\n    sea s = __y_bits(__cargar64(estado), 65535)\n    mem_liberar(estado)\n    si (__y_bits(s, 127) == 0) { retornar __y_bits(__desplazar_der(s, 8), 255) }\n    retornar 128 + __y_bits(s, 127)\n}\n\n// Destino de un enlace simbólico (p. ej. /proc/self/exe), o 0.\nfuncion sys_leer_enlace(ruta_c) {\n    sea buf = mem_reservar(4096)\n    sea n = __syscall(78, 0 - 100, ruta_c, buf, 4095)\n    si (n < 0) {\n        mem_liberar(buf)\n        retornar 0\n    }\n    __guardar8(buf + n, 0)\n    sea r = str_desde_c(buf)\n    mem_liberar(buf)\n    retornar r\n}\n\n// Entorno del proceso: envp[i] o 0 (envp sigue a argv en la pila inicial).\nfuncion sys_entorno(i) { retornar __argv(sys_argc() + 1 + i) }\n\nfuncion sys_ceder() { __syscall(124) retornar 0 }                // sched_yield\nfuncion sys_es_windows() { retornar 0 }\nfuncion sys_nombre_plataforma() { retornar \"Linux ARM64\" }\nfuncion sys_ruta_ejecutable() { retornar sys_leer_enlace(str_c(\"/proc/self/exe\")) }\nfuncion sys_ruta_temporal() { retornar \"/tmp/\" }\n\n// Valor de una variable de entorno o 0.\nfuncion sys_variable_entorno(nombre) {\n    sea prefijo = str_concatenar(nombre, \"=\")\n    sea i = 0\n    sea p = sys_entorno(0)\n    mientras (p != 0) {\n        sea e = str_desde_c(p)\n        si (str_largo(e) >= str_largo(prefijo)) {\n            si (str_igual(str_rebanar(e, 0, str_largo(prefijo)), prefijo)) { retornar str_rebanar(e, str_largo(prefijo), str_largo(e)) }\n        }\n        i = i + 1\n        p = sys_entorno(i)\n    }\n    retornar 0\n}\n\n// Ejecuta un programa con sus argumentos (lista de textos) y devuelve su\n// código de salida (fork + execve + wait4).\nfuncion sys_ejecutar_programa(ruta, argumentos) {\n    sea n = vec