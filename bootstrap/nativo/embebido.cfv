 + i) == 69)) {\n            entero = 0\n            i = i + 1\n            si (i < n y (__cargar8(d + i) == 43 o __cargar8(d + i) == 45)) { i = i + 1 }\n            sea x = 0\n            mientras (i < n y __cargar8(d + i) >= 48 y __cargar8(d + i) <= 57) {\n                i = i + 1\n                x = x + 1\n            }\n            si (x == 0) { dyn_json_error(i) }\n        }\n        __guardar64(pos, i)\n        // Enteros cortos sin pasar por texto.\n        si (entero y dig <= 15) {\n            sea v = 0\n            sea k = ini\n            si (b == 45) { k = k + 1 }\n            mientras (k < i) {\n                v = v * 10 + __cargar8(d + k) - 48\n                k = k + 1\n            }\n            si (b == 45) { v = 0 - v }\n            retornar dyn_entero(v)\n        }\n        retornar a_numero(dyn_texto(str_rebanar_bytes(d, ini, i)))\n    }\n    dyn_json_error(i)\n    retornar 0\n}\n\nfuncion str_rebanar_bytes(d, ini, fin) {\n    sea r = str_nuevo(fin - ini)\n    mem_copiar(str_datos(r), d + ini, fin - ini)\n    __guardar64(r, fin - ini)\n    __guardar8(str_datos(r) + fin - ini, 0)\n    retornar r\n}\n\nfuncion dyn_json_parsear(texto) {\n    sea s = dyn_texto_de(texto, \"json_parsear\")\n    sea d = str_datos(s)\n    sea n = str_largo(s)\n    sea pos = mem_reservar(8)\n    __guardar64(pos, 0)\n    sea v = dyn_json_valor(d, 0, n, pos, 0)\n    sea i = dyn_json_ws(d, __cargar64(pos), n)\n    mem_liberar(pos)\n    si (i != n) { dyn_json_error(i) }\n    retornar v\n}\n\nfuncion dyn_json_escapar_en(r, s) {\n    sea d = str_datos(s)\n    sea n = str_largo(s)\n    str_agregar_byte(r, 34)\n    sea i = 0\n    sea hex = \"0123456789abcdef\"\n    mientras (i < n) {\n        sea b = __cargar8(d + i)\n        si (b == 34) { str_agregar(r, \"\\\\\\\"\") }\n        sino si (b == 92) { str_agregar(r, \"\\\\\\\\\") }\n        sino si (b == 10) { str_agregar(r, \"\\\\n\") }\n        sino si (b == 13) { str_agregar(r, \"\\\\r\") }\n        sino si (b == 9) { str_agr