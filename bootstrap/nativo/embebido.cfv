    si (i == 4) { retornar "// runtime/io.cfv — salida, archivos y argumentos del programa.\n\nfuncion rt_escribir_texto(fd, s) {\n    sea escritos = 0\n    sea largo = str_largo(s)\n    mientras (escritos < largo) {\n        sea n = sys_escribir(fd, str_datos(s) + escritos, largo - escritos)\n        si (n <= 0) { retornar 0 - 1 }\n        escritos = escritos + n\n    }\n    retornar escritos\n}\n\n// mostrar(texto) del programa llama aquí.\nfuncion rt_mostrar(s) {\n    // cforge repl (global 17 = [omitir][mostradas][archivo de conteo]): el\n    // programa acumulado se vuelve a ejecutar y solo aparece lo nuevo.\n    sea repl = mem_global(17)\n    si (repl != 0) {\n        __guardar64(repl + 8, __cargar64(repl + 8) + 1)\n        archivo_escribir(__cargar64(repl + 16), str_desde_entero(__cargar64(repl + 8)))\n        si (__cargar64(repl + 8) <= __cargar64(repl)) { retornar 0 }\n    }\n    // Con el modo diagnóstico (global 39) la salida va a stderr: stdout es\n    // el canal del protocolo del servidor de lenguaje.\n    si (mem_global(39) != 0) {\n        rt_escribir_texto(2, s)\n        rt_escribir_texto(2, \"\\n\")\n        retornar 0\n    }\n    rt_escribir_texto(1, s)\n    rt_escribir_texto(1, \"\\n\")\n    retornar 0\n}\n\n// Cobertura (cforge test --coverage). Global 57 del programa: bloque\n// [ruta de salida][lista de conteos por línea]; se vuelca al terminar.\nfuncion cobertura_volcar() {\n    sea b = mem_global(57)\n    si (b == 0) { retornar 0 }\n    mem_fijar_global(57, 0)\n    sea v = __cargar64(b + 8)\n    sea s = str_nuevo(256)\n    sea i = 0\n    mientras (i < vec_largo(v)) {\n        si (vec_obtener(v, i) > 0) {\n            str_agregar(s, str_desde_entero(i))\n            str_agregar_byte(s, 32)\n            str_agregar(s, str_desde_entero(vec_obtener(v, i)))\n            str_agregar_byte(s, 10)\n        }\n        i = i + 1\n    }\n    archivo_escribir(__cargar64(b), s)\n    retornar 0\n}\n\nfuncion cobertura_marcar(linea) {\n    sea b = mem_global(57)\n    si (b == 0) { retornar 0 }\n    sea v = __cargar64(b + 8)\n    mientras (vec_largo(v) <= linea) { vec_agregar(v, 0) }\n    vec_fijar(v, linea, vec_obtener(v, linea) + 1)\n    retornar 0\n}\n\nfuncion cobertura_iniciar_ruta(ruta) {\n    sea b = mem_reservar(16)\n    __guardar64(b, ruta)\n    __guardar64(b + 8, vec_nuevo())\n    mem_fijar_global(57, b)\n    retornar 0\n}\n\nfuncion rt_panico(mensaje) {\n    // Modo diagnóstico (global 37 = ruta): el mensaje se guarda en ese\n    // archivo para el servidor de lenguaje (cforge lsp).\n    sea diagnosticos = mem_global(37)\n    si (diagnosticos != 0) {\n        mem_fijar_global(37, 0)\n        archivo_escribir(diagnosticos, mensaje)\n        // El que pidió los diagnósticos (LSP, repl) los lee del archivo.\n        sys_salir(1)\n    }\n    rt_escribir_texto(2, \"[C-Forge] \")\n    rt_escribir_texto(2, mensaje)\n    rt_escribir_texto(2, \"\\n\")\n    cobertura_volcar()\n    sys_salir(1)\n    retornar 0\n}\n\nfuncion rt_argc() { retornar sys_argc() }\n\nfuncion rt_argumento(i) {\n    si (i < 0 o i >= sys_argc()) { rt_panico(\"argumento inexistente\") }\n    retornar str_desde_c(sys_argv(i))\n}\n\n// Lee un archivo completo. Devuelve 0 si no se puede abrir o leer (sin\n// abortar), para que la capa del lenguaje lo convierta en un error\n// capturable con intentar/capturar.\nfuncion archivo_intentar_leer(ruta) {\n    sea fd = sys_abrir(str_c(ruta), sys_abrir_lectura(), 0)\n    si (fd < 0) { retornar 0 }\n    sea contenido = str_nuevo(4096)\n    sea seguir = 1\n    mientras (seguir) {\n        str_asegurar(contenido, str_largo(contenido) + 65536)\n        sea n = sys_leer(fd, str_datos(contenido) + str_largo(contenido), 65536)\n        si (n < 0) {\n            sys_cerrar(fd)\n            retornar 0\n        }\n        si (n == 0) {\n            seguir = 0\n        } sino {\n            __guardar64(contenido, str_largo(contenido) + n)\n        }\n    }\n    __guardar8(str_datos(contenido) + str_largo(contenido), 0)\n    sys_cerrar(fd)\n    retornar contenido\n}\n\nfuncion archivo_leer(ruta) {\n    sea contenido = archivo_intentar_leer(ruta)\n    si (contenido == 0) { rt_panico(str_concatenar(\"no se pudo abrir \", ruta)) }\n    retornar contenido\n}\n\n// Escribe un archivo. Devuelve -1 si no se puede abrir, -2 si la escritura\n// queda incompleta; si no, los bytes escritos.\nfuncion archivo_intentar_escribir(ruta, contenido) {\n    sea fd = sys_abrir(str_c(ruta), sys_abrir_escritura(), sys_modo_archivo())\n    si (fd < 0) { retornar -1 }\n    sea n = rt_escribir_texto(fd, contenido)\n    sys_cerrar(fd)\n    si (n < 0) { retornar -2 }\n    retornar n\n}\n\nfuncion archivo_escribir(ruta, contenido) {\n    sea n = archivo_intentar_escribir(ruta, contenido)\n    si (n == -1) { rt_panico(str_concatenar(\"no se pudo escribir \", ruta)) }\n    si (n == -2) { rt_panico(str_concatenar(\"escritura incompleta en \", ruta)) }\n    retornar n\n}\n" }
    si (i == 5) { retornar "// runtime/f64.cfv — números decimales (f64) a texto.\n//\n// Los f64 viajan como sus 64 bits. Formato: hasta 6 decimales sin ceros\n// sobrantes (\"3.5\", \"0.333333\", \"-2\"); notación científica desde 1e15;\n// \"nan\", \"inf\" y \"-inf\" para los valores especiales.\n\nfuncion f64_desde_entero(n) { retornar __f64_desde_entero(n) }\n\nfuncion f64_desde_fraccion(numerador, denominador) {\n    retornar __f64_div(__f64_desde_entero(numerador), __f64_desde_entero(denominador))\n}\n\nfuncion str_digitos_ceros(r, valor, ancho) {\n    sea digitos = str_desde_entero(valor)\n    sea faltan = ancho - str_largo(digitos)\n    mientras (faltan > 0) {\n        str_agregar_byte(r, 48)\n        faltan = faltan - 1\n    }\n    str_agregar(r, digitos)\n    str_liberar(digitos)\n    retornar r\n}\n\nfuncion str_desde_f64(bits) {\n    sea r = str_nuevo(32)\n    sea exponente = __y_bits(__desplazar_der(bits, 52), 2047)\n    sea negativo = bits < 0\n    // Valor absoluto: limpia el bit de signo.\n    sea absoluto = __desplazar_der(__desplazar_izq(bits, 1), 1)\n    si (exponente == 2047) {\n        si (__desplazar_izq(bits, 12) != 0) {\n            str_agregar(r, \"nan\")\n            retornar r\n        }\n        si (negativo) { str_agregar_byte(r, 45) }\n        str_agregar(r, \"inf\")\n        retornar r\n    }\n    si (negativo y absoluto != 0) { str_agregar_byte(r, 45) }\n    sea diez = __f64_desde_entero(10)\n    sea limite = __f64_desde_entero(1000000000)\n    limite = __f64_mul(limite, __f64_desde_entero(1000000))       // 1e15\n    sea exponente10 = 0\n    si (__f64_menor(absoluto, limite) == 0) {\n        mientras (__f64_menor(absoluto, diez) == 0) {\n            absoluto = __f64_div(absoluto, diez)\n            exponente10 = exponente10 + 1\n        }\n    }\n    sea millon = __f64_desde_entero(1000000)\n    sea medio = __f64_div(__f64_desde_entero(1), __f64_desde_entero(2))\n    sea entero = __f64_a_entero(absoluto)\n    sea fraccion = __f64_resta(absoluto, __f64_desde_entero(entero))\n    sea decimales = __f64_a_entero(__f64_suma(__f64_mul(fraccion, millon), medio))\n    si (decimales >= 1000000) {\n        entero = entero + 1\n        decimales = decimales - 1000000\n    }\n    sea parte = str_desde_entero(entero)\n    str_agregar(r, parte)\n    str_liberar(parte)\n    si (decimales > 0) {\n        mientras (decimales % 10 == 0) { decimales = decimales / 10 }\n        str_agregar_byte(r, 46)\n        str_digitos_ceros_decimales(r, fraccion, decimales)\n    }\n    si (exponente10 > 0) {\n        str_agregar(r, \"e+\")\n        sea e = str_desde_entero(exponente10)\n        str_agregar(r, e)\n        str_liberar(e)\n    }\n    retornar r\n}\n\n// Escribe los decimales conservando los ceros a la izquierda (3.05 → \"05\").\nfuncion str_digitos_ceros_decimales(r, fraccion, decimales) {\n    sea ceros = 0\n    sea escala = __f64_desde_entero(10)\n    sea f = fraccion\n    sea medio = __f64_div(__f64_desde_entero(1), __f64_desde_entero(2000000))\n    f = __f64_suma(f, medio)\n    sea seguir = 1\n    mientras (seguir y ceros < 6) {\n        f = __f64_mul(f, escala)\n        si (__f64_a_entero(f) == 0) {\n            ceros = ceros + 1\n        } sino {\n            seguir = 0\n        }\n    }\n    mientras (ceros > 0) {\n        str_agregar_byte(r, 48)\n        ceros = ceros - 1\n    }\n    sea digitos = str_desde_entero(decimales)\n    str_agregar(r, digitos)\n    str_liberar(digitos)\n    retornar r\n}\n\n// ── Texto → decimal con un solo redondeo (misma técnica que los literales\n// del compilador: doble-doble de ~106 bits). Lo usan a_numero y JSON.\n\nfuncion rtdd_nuevo(hi, lo, e2) {\n    sea p = mem_reservar(24)\n    __guardar64(p, hi)\n    __guardar64(p + 8, lo)\n    __guardar64(p + 16, e2)\n    retornar p\n}\nfuncion rtdd_abs(x) { retornar __desplazar_der(__desplazar_izq(x, 1), 1) }\nfuncion rtdd_hi(p) { retornar __cargar64(p) }\nfuncion rtdd_lo(p) { retornar __cargar64(p + 8) }\nfuncion rtdd_e2(p) { retornar __cargar64(p + 16) }\n\nfuncion rtdd_rapida(a, b, e2) {\n    sea s = __f64_suma(a, b)\n    retornar rtdd_nuevo(s, __f64_resta(b, __f64_resta(s, a)), e2)\n}\n\n// 2^n exacto (|n| <= 1000) por multiplicaciones de 2.\nfuncion rtdd_dos_a(n) {\n    sea r = __f64_desde_entero(1)\n    sea base = __f64_desde_entero(2)\n    si (n < 0) { base = __f64_div(__f64_desde_entero(1), base) }\n    sea k = n\n    si (k < 0) { k = 0 - k }\n    mientras (k > 0) {\n        r = __f64_mul(r, base)\n        k = k - 1\n    }\n    retornar r\n}\n\n// Producto exacto a·b = p + error (Dekker).\nfuncion rtdd_partir_alto(a) {\n    sea t = __f64_mul(__f64_desde_entero(134217729), a)\n    retornar __f64_resta(t, __f64_resta(t, a))\n}\nfuncion rtdd_producto(a, b, e2) {\n    sea p = __f64_mul(a, b)\n    sea ah = rtdd_partir_alto(a)\n    sea al = __f64_resta(a, ah)\n    sea bh = rtdd_partir_alto(b)\n    sea bl = __f64_resta(b, bh)\n    sea err = __f64_suma(__f64_suma(__f64_suma(__f64_resta(__f64_mul(ah, bh), p), __f64_mul(ah, bl)), __f64_mul(al, bh)), __f64_mul(al, bl))\n    retornar rtdd_nuevo(p, err, e2)\n}\n\n// Mantiene hi en [2^-400, 2^400] moviendo la escala a e2 (exacto).\nfuncion rtdd_normalizar(x) {\n    sea alto = rtdd_dos_a(400)\n    sea bajo = rtdd_dos_a(0 - 400)\n    sea hi = rtdd_hi(x)\n    sea lo = rtdd_lo(x)\n    sea e2 = rtdd_e2(x)\n    mientras (__f64_menor(alto, rtdd_abs(hi))) {\n        hi = __f64_mul(hi, bajo)\n        lo = __f64_mul(lo, bajo)\n        e2 = e2 + 400\n    }\n    mientras (hi != 0 y __f64_menor(rtdd_abs(hi), bajo)) {\n        hi = __f64_mul(hi, alto)\n        lo = __f64_mul(lo, alto)\n        e2 = e2 - 400\n    }\n    retornar rtdd_nuevo(hi, lo, e2)\n}\n\nfuncion rtdd_mul(x, y) {\n    sea p = rtdd_producto(rtdd_hi(x), rtdd_hi(y), rtdd_e2(x) + rtdd_e2(y))\n    sea lo = __f64_suma(rtdd_lo(p), __f64_suma(__f64_mul(rtdd_hi(x), rtdd_lo(y)), __f64_mul(rtdd_lo(x), rtdd_hi(y))))\n    retornar rtdd_normalizar(rtdd_rapida(rtdd_hi(p), lo, rtdd_e2(p)))\n}\n\n// x - q·y con x, y en la misma escala.\nfuncion rtdd_menos_por(x, q, y) {\n    sea p = rtdd_producto(q, rtdd_hi(y), 0)\n    sea plo = __f64_suma(rtdd_lo(p), __f64_mul(q, rtdd_lo(y)))\n    sea s = __f64_resta(rtdd_hi(x), rtdd_hi(p))\n    sea bb = __f64_resta(s, rtdd_hi(x))\n    sea err = __f64_resta(__f64_resta(rtdd_hi(x), __f64_resta(s, bb)), __f64_suma(rtdd_hi(p), bb))\n    err = __f64_suma(err, __f64_resta(rtdd_lo(x), plo))\n    retornar rtdd_rapida(s, err, rtdd_e2(x))\n}\n\nfuncion rtdd_div(x, y) {\n    sea q1 = __f64_div(rtdd_hi(x), rtdd_hi(y))\n    sea r = rtdd_menos_por(x, q1, y)\n    sea q2 = __f64_div(rtdd_hi(r), rtdd_hi(y))\n    r = rtdd_menos_por(r, q2, y)\n    sea q3 = __f64_div(rtdd_hi(r), rtdd_hi(y))\n    sea q = rtdd_rapida(q1, q2, 0)\n    sea s = __f64_suma(rtdd_hi(q), q3)\n    sea lo = __f64_suma(__f64_resta(q3, __f64_resta(s, rtdd_hi(q))), rtdd_lo(q))\n    retornar rtdd_normalizar(rtdd_rapida(s, lo, rtdd_e2(x) - rtdd_e2(y)))\n}\n\n// 10^n (n >= 0) en doble-doble por cuadrados sucesivos.\nfuncion rtdd_potencia10(n) {\n    sea r = rtdd_nuevo(__f64_desde_entero(1), 0, 0)\n    sea b = rtdd_nuevo(__f64_desde_entero(10), 0, 0)\n    sea k = n\n    mientras (k > 0) {\n        si (k % 2 == 1) { r = rtdd_mul(r, b) }\n        k = k / 2\n        si (k > 0) { b = rtdd_mul(b, b) }\n    }\n    retornar r\n}\n\nfuncion rtdd_p10(n) {\n    sea p = __f64_desde_entero(1)\n    sea k = 0\n    mientras (k < n) {\n        p = __f64_mul(p, __f64_desde_entero(10))\n        k = k + 1\n    }\n    retornar p\n}\n\n// M · 10^E correctamente redondeado (salvo empates de 1 en 2^50).\nfuncion rt_decimal_a_f64(m, e) {\n    si (m == 0) { retornar __f64_desde_entero(0) }\n    si (m < 9007199254740992 y e >= 0 - 22 y e <= 22) {\n        si (e >= 0) { retornar __f64_mul(__f64_desde_entero(m), rtdd_p10(e)) }\n        retornar __f64_div(__f64_desde_entero(m), rtdd_p10(0 - e))\n    }\n    si (e > 330) { retornar __f64_div(__f64_desde_entero(1), __f64_desde_entero(0)) }\n    si (e < 0 - 360) { retornar __f64_desde_entero(0) }\n    sea hi = __f64_desde_entero(m)\n    sea mm = rtdd_nuevo(hi, __f64_desde_entero(m - __f64_a_entero(hi)), 0)\n    sea r = 0\n    si (e >= 0) { r = rtdd_mul(mm, rtdd_potencia10(e)) } sino { r = rtdd_div(mm, rtdd_potencia10(0 - e)) }\n    sea v = __f64_suma(rtdd_hi(r), rtdd_lo(r))\n    sea e2 = rtdd_e2(r)\n    mientras (e2 >= 400) { v = __f64_mul(v, rtdd_dos_a(400))  e2 = e2 - 400 }\n    mientras (e2 <= 0 - 400) { v = __f64_mul(v, rtdd_dos_a(0 - 400))  e2 = e2 + 400 }\n    retornar __f64_mul(v, rtdd_dos_a(e2))\n}\n\n" }
    si (i == 6) { retornar "// runtime/sys_linux_ext.cfv — funciones de sistema de Linux para los\n// programas del lenguaje (tiempo, hilos, futex, sockets, dlopen). No forman\n// parte del compilador: usan intrínsecos que solo tiene cforge_self.\n\nfuncion sys_reloj_ns() {\n    sea ts = mem_reservar(16)\n    __syscall(228, 0, ts)                                      // CLOCK_REALTIME\n    sea ns = __cargar64(ts) * 1000000000 + __cargar64(ts + 8)\n    mem_liberar(ts)\n    retornar ns\n}\n\nfuncion sys_nucleos() {\n    sea mascara = mem_reservar(128)\n    mem_llenar(mascara, 0, 128)\n    sea n = __syscall(204, 0, 128, mascara)                    // sched_getaffinity\n    sea total = 0\n    si (n > 0) {\n        sea i = 0\n        mientras (i < n) {\n            sea b = __cargar8(mascara + i)\n            mientras (b > 0) {\n                total = total + __y_bits(b, 1)\n                b = __desplazar_der(b, 1)\n            }\n            i = i + 1\n        }\n    }\n    mem_liberar(mascara)\n    si (total < 1) { total = 1 }\n    retornar total\n}\n\nfuncion sys_dormir_ms(n) {\n    sea ts = mem_reservar(16)\n    __guardar64(ts, n / 1000)\n    __guardar64(ts + 8, (n % 1000) * 1000000)\n    __syscall(35, ts, 0)                                       // nanosleep\n    mem_liberar(ts)\n    retornar 0\n}\n\n// op 128: FUTEX_WAIT_PRIVATE · op 0: FUTEX_WAIT compartido (tid de clone).\nfuncion sys_futex_esperar(direccion, valor, ms, op) {\n    si (ms < 0) {\n        __syscall(202, direccion, op, __y_bits(valor, 4294967295), 0)\n        retornar 0\n    }\n    sea ts = mem_reservar(16)\n    __guardar64(ts, ms / 1000)\n    __guardar64(ts + 8, (ms % 1000) * 1000000)\n    __syscall(202, direccion, op, __y_bits(valor, 4294967295), ts)\n    mem_liberar(ts)\n    retornar 0\n}\n\nfuncion sys_futex_despertar(direccion) {\n    __syscall(202, direccion, 129, 2147483647)                 // FUTEX_WAKE_PRIVATE\n    retornar 0\n}\n\n// Hilo con clone en la pila [base, base + tam) que ejecuta dyn_hilo_inicio(t);\n// al terminar, el kernel pone en 0 el tid de base + 16 y despierta (futex).\nfuncion sys_hilo_crear(base, tam, t) {\n    retornar __hilo(base + tam, __dir(\"dyn_hilo_inicio\"), t, base + 16)\n}\n\nfuncion sys_dl_disponible() { retornar __simbolo_dinamico(0) != 0 }\nfuncion sys_cargar_biblioteca(nombre) { retornar __ccall(__simbolo_dinamico(0), str_c(nombre), 258) }   // RTLD_NOW | RTLD_GLOBAL\nfuncion sys_simbolo(h, nombre) { retornar __ccall(__simbolo_dinamico(1), h, str_c(nombre)) }\n\n// Socket TCP escuchando en ip:puerto (ip IPv4 como entero, 0 = todas): descriptor, o -1 (socket), -2 (bind),\n// -3 (listen).\nfuncion sys_red_escuchar(puerto, ip) {\n    sea fd = __syscall(41, 2, 1, 0)                            // socket(AF_INET, SOCK_STREAM)\n    si (fd < 0) { retornar 0 - 1 }\n    sea uno = mem_reservar(8)\n    __guardar64(uno, 1)\n    __syscall(54, fd, 1, 2, uno, 4)                            // SO_REUSEADDR\n    mem_liberar(uno)\n    sea dir = mem_reservar(16)\n    mem_llenar(dir, 0, 16)\n    __guardar8(dir, 2)                                         // AF_INET\n    __guardar8(dir + 2, __desplazar_der(puerto, 8))            // puerto (big-endian)\n    __guardar8(dir + 3, __y_bits(puerto, 255))\n    __guardar8(dir + 4, __y_bits(__desplazar_der(ip, 24), 255))   // dirección IPv4 (0 = todas)\n    __guardar8(dir + 5, __y_bits(__desplazar_der(ip, 16), 255))\n    __guardar8(dir + 6, __y_bits(__desplazar_der(ip, 8), 255))\n    __guardar8(dir + 7, __y_bits(ip, 255))\n    sea r = __syscall(49, fd, dir, 16)\n    mem_liberar(dir)\n    si (r != 0) { retornar 0 - 2 }\n    si (__syscall(50, fd, 64) != 0) { retornar 0 - 3 }\n    retornar fd\n}\n\nfuncion sys_red_aceptar(fd, dir, largo_dir) { retornar __syscall(43, fd, dir, largo_dir) }\nfuncion sys_red_leer(fd, buf, n) { retornar sys_leer(fd, buf, n) }\nfuncion sys_red_escribir(fd, buf, n) { retornar sys_escribir(fd, buf, n) }\nfuncion sys_red_cerrar(fd) { retornar sys_cerrar(fd) }\n\n// Bytes aleatorios del sistema (getrandom). Devuelve 0 si salió bien.\nfuncion sys_aleatorio(buf, n) {\n    sea hecho = 0\n    mientras (hecho < n) {\n        sea r = __syscall(318, buf + hecho, n - hecho, 0)\n        si (r <= 0) { retornar 0 - 1 }\n        hecho = hecho + r\n    }\n    retornar 0\n}\n\n// ── Cliente TCP y UDP (IPv4; ip = a·2^24 + b·2^16 + c·2^8 + d) ────────────\n\nfuncion sys_dir_ipv4(dir, ip, puerto) {\n    mem_llenar(dir, 0, 16)\n    __guardar8(dir, 2)                                         // AF_INET\n    __guardar8(dir + 2, __desplazar_der(puerto, 8))\n    __guardar8(dir + 3, __y_bits(puerto, 255))\n    __guardar8(dir + 4, __y_bits(__desplazar_der(ip, 24), 255))\n    __guardar8(dir + 5, __y_bits(__desplazar_der(ip, 16), 255))\n    __guardar8(dir + 6, __y_bits(__desplazar_der(ip, 8), 255))\n    __guardar8(dir + 7, __y_bits(ip, 255))\n    retornar dir\n}\n\nfuncion sys_red_conectar(ip, puerto) {\n    sea fd = __syscall(41, 2, 1, 0)\n    si (fd < 0) { retornar 0 - 1 }\n    sea dir = sys_dir_ipv4(mem_reservar(16), ip, puerto)\n    sea r = __syscall(42, fd, dir, 16)\n    mem_liberar(dir)\n    si (r != 0) {\n        sys_cerrar(fd)\n        retornar 0 - 2\n    }\n    retornar fd\n}\n\n// Límite de espera (ms) para leer y escribir en el socket.\nfuncion sys_red_espera(fd, ms) {\n    sea tv = mem_reservar(16)\n    __guardar64(tv, ms / 1000)\n    __guardar64(tv + 8, (ms % 1000) * 1000)\n    __syscall(54, fd, 1, 20, tv, 16)                            // SO_RCVTIMEO\n    __syscall(54, fd, 1, 21, tv, 16)                            // SO_SNDTIMEO\n    mem_liberar(tv)\n    retornar 0\n}\n\nfuncion sys_udp_crear(puerto) {\n    sea fd = __syscall(41, 2, 2, 0)                            // SOCK_DGRAM\n    si (fd < 0) { retornar 0 - 1 }\n    si (puerto > 0) {\n        sea uno = mem_reservar(8)\n        __guardar64(uno, 1)\n        __syscall(54, fd, 1, 2, uno, 4)                         // SO_REUSEADDR\n        mem_liberar(uno)\n        sea dir = sys_dir_ipv4(mem_reservar(16), 0, puerto)\n        sea r = __syscall(49, fd, dir, 16)\n        mem_liberar(dir)\n        si (r != 0) {\n            sys_cerrar(fd)\n            retornar 0 - 2\n        }\n    }\n    retornar fd\n}\n\nfuncion sys_udp_enviar(fd, ip, puerto, buf, n) {\n    sea dir = sys_dir_ipv4(mem_reservar(16), ip, puerto)\n    sea r = __syscall(44, fd, buf, n, 0, dir, 16)\n    mem_liberar(dir)\n    retornar r\n}\n\n// Recibe un datagrama; dir (16 bytes) queda con el origen. Sin bloquear,\n// devuelve <= 0 si no hay nada.\nfuncion sys_udp_recibir(fd, buf, n, dir, bloquear) {\n    sea largo = mem_reservar(8)\n    __guardar64(largo, 16)\n    sea banderas = 64                                          // MSG_DONTWAIT\n    si (bloquear) { banderas = 0 }\n    sea r = __syscall(45, fd, buf, n, banderas, dir, largo)\n    mem_liberar(largo)\n    retornar r\n}\n\n// Linux no tiene resolvedor sin libc: el runtime usa su propio cliente DNS.\nfuncion sys_resolver(nombre) { retornar 0 }\n\n// Schannel solo existe en Windows; aquí TLS usa OpenSSL (biblioteca.cfv).\nfuncion sys_tls_abrir(estado, host) { retornar 0 - 1 }\nfuncion sys_tls_enviar(estado, p, n) { retornar 0 - 1 }\nfuncion sys_tls_recibir_todo(estado) { retornar str_nuevo(1) }\nfuncion sys_tls_cerrar(estado) { retornar 0 }\nfuncion sys_tls_version(estado) { retornar \"desconocida\" }\n" }
    si (i == 7) { retornar "// runtime/sys_linux_arm64.cfv — llamadas al sistema de Linux AArch64.\n// Mismas funciones que sys_linux.cfv con la tabla de syscalls genérica de\n// ARM64 (sin open/unlink/readlink: sus variantes *at con AT_FDCWD = -100).\n\nfuncion sys_leer(fd, destino, cantidad) {\n    retornar __syscall(63, fd, destino, cantidad)\n}\n\nfuncion sys_escribir(fd, origen, cantidad) {\n    retornar __syscall(64, fd, origen, cantidad)\n}\n\n// banderas: 0 = solo lectura; 577 = escritura | crear | truncar;\n// 65536 = O_DIRECTORY de x86-64 (16384 en ARM64)\nfuncion sys_abrir(ruta_c, banderas, modo) {\n    si (banderas == 65536) { banderas = 16384 }\n    retornar __syscall(56, 0 - 100, ruta_c, banderas, modo)\n}\n\nfuncion sys_cerrar(fd) {\n    retornar __syscall(57, fd)\n}\n\n// Memoria anónima de lectura y escritura (PROT_READ|PROT_WRITE = 3,\n// MAP_PRIVATE|MAP_ANONYMOUS = 34).\nfuncion sys_mapear(tamano) {\n    retornar __syscall(222, 0, tamano, 3, 34, 0 - 1, 0)\n}\n\nfuncion sys_desmapear(direccion, tamano) {\n    retornar __syscall(215, direccion, tamano)\n}\n\n// Termina el proceso completo (todos los hilos): exit_group.\nfuncion sys_salir(codigo) {\n    retornar __syscall(94, codigo)\n}\n\nfuncion sys_argc() {\n    retornar __argc()\n}\n\nfuncion sys_argv(indice) {\n    retornar __argv(indice)\n}\n\n// Constantes del sistema para el resto del runtime.\nfuncion sys_abrir_lectura() { retornar 0 }\nfuncion sys_abrir_escritura() { retornar 577 }\nfuncion sys_modo_archivo() { retornar 420 }\n\n// Cambia los permisos de un archivo (chmod); 493 = 0755.\nfuncion sys_permisos(ruta_c, modo) {\n    retornar __syscall(53, 0 - 100, ruta_c, modo, 0)\n}\n\n// ── Procesos y rutas (para el CLI de cforge) ──────────────────────────────\nfuncion sys_proceso_id() { retornar __syscall(172) }\nfuncion sys_bifurcar() { retornar __syscall(220, 17, 0, 0, 0, 0) }   // clone(SIGCHLD)\nfuncion sys_ejecutar(ruta_c, argv, envp) { retornar __syscall(221, ruta_c, argv, envp) }\nfuncion sys_borrar(ruta_c) { retornar __syscall(35, 0 - 100, ruta_c, 0) }\n\n// Espera al proceso y devuelve su código de salida (128 + señal si murió).\nfuncion sys_esperar(pid) {\n    sea estado = mem_reservar(8)\n    __guardar64(estado, 0)\n    __syscall(260, pid, estado, 0, 0)\n    sea s = __y_bits(__cargar64(estado), 65535)\n    mem_liberar(estado)\n    si (__y_bits(s, 127) == 0) { retornar __y_bits(__desplazar_der(s, 8), 255) }\n    retornar 128 + __y_bits(s, 127)\n}\n\n// Destino de un enlace simbólico (p. ej. /proc/self/exe), o 0.\nfuncion sys_leer_enlace(ruta_c) {\n    sea buf = mem_reservar(4096)\n    sea n = __syscall(78, 0 - 100, ruta_c, buf, 4095)\n    si (n < 0) {\n        mem_liberar(buf)\n        retornar 0\n    }\n    __guardar8(buf + n, 0)\n    sea r = str_desde_c(buf)\n    mem_liberar(buf)\n    retornar r\n}\n\n// Entorno del proceso: envp[i] o 0 (envp sigue a argv en la pila inicial).\nfuncion sys_entorno(i) { retornar __argv(sys_argc() + 1 + i) }\n\nfuncion sys_ceder() { __syscall(124) retornar 0 }                // sched_yield\nfuncion sys_es_windows() { retornar 0 }\nfuncion sys_nombre_plataforma() { retornar \"Linux ARM64\" }\nfuncion sys_ruta_ejecutable() { retornar sys_leer_enlace(str_c(\"/proc/self/exe\")) }\nfuncion sys_ruta_temporal() { retornar \"/tmp/\" }\n\n// Valor de una variable de entorno o 0.\nfuncion sys_variable_entorno(nombre) {\n    sea prefijo = str_concatenar(nombre, \"=\")\n    sea i = 0\n    sea p = sys_entorno(0)\n    mientras (p != 0) {\n        sea e = str_desde_c(p)\n        si (str_largo(e) >= str_largo(prefijo)) {\n            si (str_igual(str_rebanar(e, 0, str_largo(prefijo)), prefijo)) { retornar str_rebanar(e, str_largo(prefijo), str_largo(e)) }\n        }\n        i = i + 1\n        p = sys_entorno(i)\n    }\n    retornar 0\n}\n\n// Ejecuta un programa con sus argumentos (lista de textos) y devuelve su\n// código de salida (fork + execve + wait4).\nfuncion sys_ejecutar_programa(ruta, argumentos) {\n    sea n = vec