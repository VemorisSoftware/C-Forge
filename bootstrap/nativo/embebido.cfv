    si (i == 12) { retornar "// runtime/sys_macos_ext.cfv — funciones de sistema de macOS para los\n// programas del lenguaje (tiempo, directorios, hilos, red, dlopen).\n\nfuncion sys_reloj_ns() {\n    sea ts = mem_reservar(16)\n    __libsistema(\"clock_gettime\", 0, ts)                       // CLOCK_REALTIME\n    sea ns = __cargar64(ts) * 1000000000 + __cargar64(ts + 8)\n    mem_liberar(ts)\n    retornar ns\n}\n\nfuncion sys_dormir_ms(n) {\n    __libsistema(\"usleep\", n * 1000)\n    retornar 0\n}\n\nfuncion sys_nucleos() {\n    sea n = __libsistema(\"sysconf\", 58)                        // _SC_NPROCESSORS_ONLN\n    si (n < 1) { n = 1 }\n    retornar n\n}\n\n// macOS no expone futex; espera breve y vuelve a mirar.\nfuncion sys_futex_esperar(direccion, valor, ms, op) {\n    si (__y_bits(__cargar64(direccion), 4294967295) == __y_bits(valor, 4294967295)) { __libsistema(\"usleep\", 1000) }\n    retornar 0\n}\n\nfuncion sys_futex_despertar(direccion) { retornar 0 }\n\n// Hilo con pthread_create: el trampolín del compilador (rdi = registro)\n// cambia a la pila [base, base + tam) y llama a dyn_hilo_inicio(t).\nfuncion sys_hilo_crear(base, tam, t) {\n    __guardar64(base + 24, t)\n    __guardar64(base + 32, __dir(\"dyn_hilo_inicio\"))\n    sea id = mem_reservar(8)\n    sea r = sys_i32(__libsistema(\"pthread_create\", id, 0, __trampolin_hilo(), base))\n    si (r != 0) { retornar 0 - 1 }\n    __libsistema(\"pthread_detach\", __cargar64(id))\n    retornar 0\n}\n\nfuncion sys_dl_disponible() { retornar 1 }\n// RTLD_NOW | RTLD_GLOBAL. Sin ruta, también se busca donde instala\n// Homebrew (/opt/homebrew/lib en Apple Silicon, /usr/local/lib en Intel).\nfuncion sys_cargar_biblioteca(nombre) {\n    sea h = __libsistema(\"dlopen\", str_c(nombre), 10)\n    si (h != 0 o str_buscar_texto(nombre, \"/\") >= 0) { retornar h }\n    h = __libsistema(\"dlopen\", str_c(str_concatenar(\"/opt/homebrew/lib/\", nombre)), 10)\n    si (h != 0) { retornar h }\n    retornar __libsistema(\"dlopen\", str_c(str_concatenar(\"/usr/local/lib/\", nombre)), 10)\n}\n\nfuncion str_buscar_texto(pajar, aguja) {\n    sea i = 0\n    mientras (i + str_largo(aguja) <= str_largo(pajar)) {\n        si (str_igual(str_rebanar(pajar, i, i + str_largo(aguja)), aguja)) { retornar i }\n        i = i + 1\n    }\n    retornar 0 - 1\n}\nfuncion sys_simbolo(h, nombre) { retornar __libsistema(\"dlsym\", h, str_c(nombre)) }\n\nfuncion sys_red_escuchar(puerto) {\n    sea fd = sys_i32(__libsistema(\"socket\", 2, 1, 0))\n    si (fd < 0) { retornar 0 - 1 }\n    sea uno = mem_reservar(8)\n    __guardar64(uno, 1)\n    __libsistema(\"setsockopt\", fd, 65535, 4, uno, 4)           // SOL_SOCKET, SO_REUSEADDR\n    mem_liberar(uno)\n    sea dir = mem_reservar(16)\n    mem_llenar(dir, 0, 16)\n    __guardar8(dir, 16)                                        // sin_len\n    __guardar8(dir + 1, 2)                                     // AF_INET\n    __guardar8(dir + 2, __desplazar_der(puerto, 8))\n    __guardar8(dir + 3, __y_bits(puerto, 255))\n    sea r = sys_i32(__libsistema(\"bind\", fd, dir, 16))\n    mem_liberar(dir)\n    si (r != 0) { retornar 0 - 2 }\n    si (sys_i32(__libsistema(\"listen\", fd, 64)) != 0) { retornar 0 - 3 }\n    retornar fd\n}\n\nfuncion sys_red_aceptar(fd, dir, largo_dir) { retornar sys_i32(__libsistema(\"accept\", fd, dir, largo_dir)) }\nfuncion sys_red_leer(fd, buf, n) { retornar __libsistema(\"read\", fd, buf, n) }\nfuncion sys_red_escribir(fd, buf, n) { retornar __libsistema(\"write\", fd, buf, n) }\nfuncion sys_red_cerrar(fd) { retornar sys_i32(__libsistema(\"close\", fd)) }\n" }
