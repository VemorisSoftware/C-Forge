\nfuncion str_desde_entero(n) {\n    sea r = str_nuevo(24)\n    str_agregar_entero(r, n)\n    retornar r\n}\n\n// Texto a partir de una cadena C terminada en 0 (argv, entorno).\nfuncion str_desde_c(puntero) {\n    sea largo = 0\n    mientras (__cargar8(puntero + largo) != 0) { largo = largo + 1 }\n    sea r = str_nuevo(largo)\n    mem_copiar(__cargar64(r + 16), puntero, largo)\n    __guardar8(__cargar64(r + 16) + largo, 0)\n    __guardar64(r, largo)\n    retornar r\n}\n\n// Puntero a bytes terminados en 0, válido mientras el texto no cambie.\nfuncion str_c(s) {\n    si (__cargar64(s + 24) == 0) {\n        // Los literales ya terminan en 0.\n        retornar __cargar64(s + 16)\n    }\n    si (__cargar64(s + 24) == 2 y __cargar8(__cargar64(s + 16) + __cargar64(s)) != 0) {\n        // Búfer compartido con bytes de otro texto después de este: copia\n        // propia (str_asegurar copia siempre los compartidos).\n        str_asegurar(s, __cargar64(s))\n    }\n    retornar __cargar64(s + 16)\n}\n\nfuncion str_liberar(s) {\n    si (__cargar64(s + 24) == 1) { mem_liberar(__cargar64(s + 16)) }\n    mem_liberar(s)\n    retornar 0\n}\n" }
