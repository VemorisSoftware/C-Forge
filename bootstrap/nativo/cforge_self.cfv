}

funcion sha_rotr(x, n) {
    retornar __y_bits(__o_bits(__desplazar_der(x, n), __desplazar_izq(x, 32 - n)), 4294967295)
}

funcion sha_suma(a, b) { retornar __y_bits(a + b, 4294967295) }

// SHA-256 de los bytes [inicio, inicio + largo) de s: texto de 32 bytes.
funcion sha256(s, inicio, largo, k) {
    sea msg = str_nuevo(largo + 72)
    str_agregar(msg, str_rebanar(s, inicio, inicio + largo))
    str_agregar_byte(msg, 128)
    mientras (str_largo(msg) % 64 != 56) { str_agregar_byte(msg, 0) }
    bytes_be(msg, largo * 8, 8)
    sea h = mem_reservar(64)
    __guardar64(h + 0, 1779033703)
    __guardar64(h + 8, 3144134277)
    __guardar64(h + 16, 1013904242)
    __guardar64(h + 24, 2773480762)
    __guardar64(h + 32, 1359893119)
    __guardar64(h + 40, 2600822924)
    __guardar64(h + 48, 528734635)
    __guardar64(h + 56, 1541459225)
    sea w = mem_reservar(512)
    sea bloque = 0
    mientras (bloque < str_largo(msg)) {
        sea t = 0
        mientras (t < 16) {
            sea p = bloque + t * 4
            __guardar64(w + t * 8, str_byte(msg, p) * 16777216 + str_byte(msg, p + 1) * 65536 + str_byte(msg, p + 2) * 256 + str_byte(msg, p + 3))
            t = t + 1
        }
        mientras (t < 64) {
            sea w15 = __cargar64(w + (t - 15) * 8)
            sea w2 = __cargar64(w + (t - 2) * 8)
            sea s0 = __xo_bits(__xo_bits(sha_rotr(w15, 7), sha_rotr(w15, 18)), __desplazar_der(w15, 3))
            sea s1 = __xo_bits(__xo_bits(sha_rotr(w2, 17), sha_rotr(w2, 19)), __desplazar_der(w2, 10))
            __guardar64(w + t * 8, __y_bits(__cargar64(w + (t - 16) * 8) + s0 + __cargar64(w + (t - 7) * 8) + s1, 4294967295))
            t = t + 1
        }
        sea a = __cargar64(h)
        sea b = __cargar64(h + 8)
        sea cc = __cargar64(h + 16)
        sea d = __cargar64(h + 24)
        sea e = __cargar64(h + 32)
        sea f = __cargar64(h + 40)
        sea g = __cargar64(h + 48)
        sea hh = __cargar64(h + 56)
        t = 0
        mientras (t < 64) {
            sea S1 = __xo_bits(__xo_bits(sha_rotr(e, 6), sha_rotr(e, 11)), sha_rotr(e, 25))
            sea ch = __xo_bits(__y_bits(e, f), __y_bits(__xo_bits(e, 4294967295), g))
            sea t1 = __y_bits(hh + S1 + ch + vec_obtener(k, t) + __cargar64(w + t * 8), 4294967295)
            sea S0 = __xo_bits(__xo_bits(sha_rotr(a, 2), sha_rotr(a, 13)), sha_rotr(a, 22))
            sea may = __xo_bits(__xo_bits(__y_bits(a, b), __y_bits(a, cc)), __y_bits(b, cc))
            sea t2 = sha_suma(S0, may)
            hh = g
            g = f
            f = e
            e = sha_suma(d, t1)
            d = cc
            cc = b
            b = a
            a = sha_suma(t1, t2)
            t = t + 1
        }
        __guardar64(h, sha_suma(__cargar64(h), a))
        __guardar64(h + 8, sha_suma(__cargar64(h + 8), b))
        __guardar64(h + 16, sha_suma(__cargar64(h + 16), cc))
        __guardar64(h + 24, sha_suma(__cargar64(h + 24), d))
        __guardar64(h + 32, sha_suma(__cargar64(h + 32), e))
        __guardar64(h + 40, sha_suma(__cargar64(h + 40), f))
        __guardar64(h + 48, sha_suma(__cargar64(h + 48), g))
        __guardar64(h + 56, sha_suma(__cargar64(h + 56), hh))
        bloque = bloque + 64
    }
    sea r = str_nuevo(32)
    sea i = 0
    mientras (i < 8) {
        bytes_be(r, __cargar64(h + i * 8), 4)
        i = i + 1
    }
    mem_liberar(w)
    mem_liberar(h)
    str_liberar(msg)
    retornar r
}

// ── Programa ──────────────────────────────────────────────────────────────
//
// cforge-self -o salida [--stdlib DIR] archivos... [--puente archivos...]
//             [--dinamico archivos...] [--nativo archivos...]
//
// --nativo   (por defecto) dialecto nativo: enteros de 64 bits
// --puente   runtime del lenguaje escrito en dialecto nativo (runtime/dyn.cfv)
// --dinamico lenguaje C-Forge completo; resuelve importar "x" desde --stdlib

funcion uso() {
    rt_panico("uso: cforge-self -o salida [--stdlib DIR] archivo.cfv [--puente|--dinamico|--nativo archivos...]")
    retornar 0
}

funcion contar_lineas(s) {
    sea n = 0
    sea i = 0
    sea d = str_datos(s)
    sea largo = str_largo(s)
    mientras (i < largo) {
        si (__cargar8(d + i) == 10) { n = n + 1 }
        i = i + 1
    }
    retornar n
}

// Agrega un archivo a la fuente y anota en qué línea global empieza.
funcion agregar_fuente(fuente, modo, texto, nombre, archivos) {
    sea registro = mem_reservar(16)
    __guardar64(registro, contar_lineas(fuente) + 3)
    __guardar64(registro + 8, nombre)
    vec_agregar(archivos, registro)
    str_agregar(fuente, "\n__dialecto ")
    str_agregar(fuente, str_desde_entero(modo))
    str_agregar_byte(fuente, 10)
    str_agregar(fuente, texto)
    str_agregar_byte(fuente, 10)
    retornar 0
}

// Ruta de la biblioteca para importar "mapa" / "stdlib/mapa.cfv".
funcion ruta_importacion(stdlib, nombre) {
    sea n = nombre
    si (str_largo(n) > 7 y str_igual(str_rebanar(n, 0, 7), "stdlib/")) {
        n = str_rebanar(n, 7, str_largo(n))
    }
    sea r = str_concatenar(stdlib, "/")
    str_agregar(r, n)
    si (str_largo(n) < 4 o str_igual(str_rebanar(n, str_largo(n) - 4, str_largo(n)), ".cfv") == 0) {
        str_agregar(r, ".cfv")
    }
    retornar r
}

// importar "rust:crate" / importar "cpp:lib": módulos que genera
// `cforge bindgen` en $CFORGE_INTEROP (o ~/.cforge/interop). 0 si el nombre
// no es de otro lenguaje.
funcion ruta_interop(nombre) {
    sea corte = 0
    mientras (corte < str_largo(nombre) y str_byte(nombre, corte) != 58) { corte = corte + 1 }
    si (corte >= str_largo(nombre)) { retornar 0 }
    sea lenguaje = str_rebanar(nombre, 0, corte)
    si (str_igual(lenguaje, "rust") == 0 y str_igual(lenguaje, "cpp") == 0) { retornar 0 }
    sea dir = sys_variable_entorno("CFORGE_INTEROP")
    si (dir == 0) {
        dir = sys_variable_entorno("HOME")
        si (dir == 0) { dir = "/tmp" }
        dir = str_concatenar(dir, "/.cforge/interop")
    }
    // "rust:strsim@0.11" → strsim; "rust:../mi-crate" → mi_crate.
    sea ini = corte + 1
    sea fin = str_largo(nombre)
    sea k = ini
    mientras (k < fin) {
        si (str_byte(nombre, k) == 47) { ini = k + 1 }
        si (str_byte(nombre, k) == 64) { fin = k }
        k = k + 1
    }
    sea r = str_concatenar(dir, "/")
    str_agregar(r, lenguaje)
    str_agregar_byte(r, 95)
    k = ini
    mientras (k < fin) {
        si (str_byte(nombre, k) == 45) { str_agregar_byte(r, 95) } sino { str_agregar_byte(r, str_byte(nombre, k)) }
        k = k + 1
    }
    str_agregar(r, ".cfv")
    sea fd = sys_abrir(str_c(r), sys_abrir_lectura(), 0)
    si (fd < 0) {
        sea m = str_concatenar("importar \"", nombre)
        str_agregar(m, "\": falta el módulo; genéralo con: cforge bindgen ")
        si (str_igual(lenguaje, "rust")) { str_agregar(m, nombre) } sino { str_agregar(m, "cabecera.hpp --lib ") str_agregar(m, str_rebanar(nombre, corte + 1, str_largo(nombre))) }
        rt_panico(m)
    }
    sys_cerrar(fd)
    retornar r
}

// Primero junto al archivo que importa; si no, en la biblioteca estándar.
funcion ruta_importacion_desde(stdlib, importador, nombre) {
    sea interop = ruta_interop(nombre)
    si (interop != 0) { retornar interop }
    sea i = str_largo(importador)
    mientras (i > 0 y str_byte(importador, i - 1) != 47) { i = i - 1 }
    sea local = 0
    si (i == 0) { local = str_rebanar(ruta_importacion(".", nombre), 2, str_largo(ruta_importacion(".", nombre))) } sino { local = ruta_importacion(str_rebanar(importador, 0, i - 1), nombre) }
    // Un archivo no se importa a sí mismo (p. ej. json.cfv con importar "json").
    si (str_igual(local, importador)) { retornar ruta_importacion(stdlib, nombre) }
    sea fd = sys_abrir(str_c(local), sys_abrir_lectura(), 0)
    si (fd >= 0) {
        sys_cerrar(fd)
        retornar local
    }
    sea paquete = ruta_paquete(nombre)
    si (paquete != 0) { retornar paquete }
    retornar ruta_importacion(stdlib, nombre)
}

// Paquetes del proyecto (global 36, los registra el CLI desde cforge.toml):
// [alias][directorio][archivo principal]. "alias" → su archivo principal;
// "alias/modulo" → directorio/modulo.cfv.
funcion ruta_paquete(nombre) {
    sea paquetes = mem_global(36)
    si (paquetes == 0) { retornar 0 }
    sea corte = 0
    mientras (corte < str_largo(nombre) y str_byte(nombre, corte) != 47) { corte = corte + 1 }
    sea alias = str_rebanar(nombre, 0, corte)
    sea i = 0
    mientras (i < vec_largo(paquetes)) {
        sea p = vec_obtener(paquetes, i)
        si (str_igual(__cargar64(p), alias)) {
            sea r = str_concatenar(__cargar64(p + 8), "/")
            si (corte == str_largo(nombre)) {
                str_agregar(r, __cargar64(p + 16))
                retornar r
            }
            retornar ruta_importacion(__cargar64(p + 8), str_rebanar(nombre, corte + 1, str_largo(nombre)))
        }
        i = i + 1
    }
    retornar 0
}

funcion contiene_texto(lista, texto) {
    sea i = 0
    mientras (i < vec_largo(lista)) {
        si (str_igual(vec_obtener(lista, i), texto)) { retornar 1 }
        i = i + 1
    }
    retornar 0
}

// Agrega un archivo dinámico precedido por sus importaciones (cada módulo una
// sola vez, en profundidad), así las globales de un módulo existen antes de
// que el archivo que lo importa empiece a ejecutarse.
funcion agregar_con_importaciones(fuente, stdlib, texto, nombre, vistas, archivos) {
    sea tokens = tokenizar(texto)
    sea i = 0
    mientras (i + 1 < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, i)
        sea u = vec_obtener(tokens, i + 1)
        si (__cargar64(t) == 1 y __cargar64(u) == 3 y (str_igual(__cargar64(t + 8), "importar") o str_igual(__cargar64(t + 8), "import")) y tras_punto(tokens, i) == 0) {
            sea ruta = ruta_importacion_desde(stdlib, nombre, decodificar_literal(__cargar64(u + 8)))
            si (contiene_texto(vistas, ruta) == 0) {
                vec_agregar(vistas, ruta)
                agregar_con_importaciones(fuente, stdlib, archivo_leer(ruta), ruta, vistas, archivos)
            }
        }
        i = i + 1
    }
    agregar_fuente(fuente, 2, texto, nombre, archivos)
    retornar 0
}

// Compila la fuente concatenada y devuelve el ejecutable ELF.
funcion compilar_programa(fuente, archivos, puntaje) {
    sea tokens = expandir_comptime(traducir_ingles(tokenizar(fuente)), archivos)
    sea alcanzables = 0
    // --release (global 19): primera pasada para saber qué funciones se usan.
    si (mem_global(19) != 0 y mem_global(40) == 0) {
        sea previo = ctx_nuevo(tokens)
        __guardar64(previo + 296, mem_global(33))
        __guardar64(previo + 208, archivos)
        si (puntaje > 0) { __guardar64(previo + 200, 1) }
        __guardar64(previo + 408, vec_nuevo())
        sea total = 0
        sea k = 0
        mientras (k < vec_largo(tokens)) {
            si (es_simbolo(vec_obtener(tokens, k), "funcion") o (__cargar64(vec_obtener(tokens, k)) == 1 y str_igual(lexema_en(tokens, k), "funcion"))) { total = total + 1 }
            k = k + 1
        }
        k = 0
        mientras (k <= total + 1) {
            vec_agregar(__cargar64(previo + 408), vec_nuevo())
            k = k + 1
        }
        compilar(previo)
        alcanzables = funciones_alcanzables(previo)
    }
    sea contexto = ctx_nuevo(tokens)
    // Plataforma de destino (global 33): 0 Linux ELF · 1 Windows PE64.
    __guardar64(contexto + 296, mem_global(33))
    __guardar64(contexto + 208, archivos)
    si (puntaje > 0) { __guardar64(contexto + 200, 1) }
    __guardar64(contexto + 416, alcanzables)
    compilar(contexto)
    retornar empaquetar(contexto)
}

// ── comptime ──────────────────────────────────────────────────────────────
// comptime(expr) y comptime { … retornar v } se ejecutan al compilar: el
// compilador escribe un programa con las funciones, clases y constantes del
// usuario más la expresión, lo ejecuta (cforge run, en la máquina que compila)
// y pone en su lugar el literal que devuelve (nulo, booleano, número, texto,
// lista o mapa). Funciona igual al compilar para otra plataforma.

funcion es_comptime(tokens, i) {
    sea t = vec_obtener(tokens, i)
    si (__cargar64(t) != 1 o str_igual(__cargar64(t + 8), "comptime") == 0) { retornar 0 }
    si (i + 1 >= vec_largo(tokens)) { retornar 0 }
    sea sig = vec_obtener(tokens, i + 1)
    retornar es_simbolo(sig, "(") o es_simbolo(sig, "{")
}

funcion expandir_comptime(tokens, archivos) {
    sea modo = 0
    sea i = 0
    mientras (i < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, i)
        si (__cargar64(t) == 1 y str_igual(__cargar64(t + 8), "__dialecto")) { modo = numero_literal(lexema_en(tokens, i + 1)) }
        si (modo == 2 y es_comptime(tokens, i)) { tokens = evaluar_comptime(tokens, i, archivos) }
        i = i + 1
    }
    retornar tokens
}

// Índice del cierre que corresponde a la apertura en j.
funcion cierre_de(tokens, j) {
    sea nivel = 0
    mientras (j < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, j)
        si (__cargar64(t) == 4) {
            sea l = __cargar64(t + 8)
            si (str_igual(l, "(") o str_igual(l, "[") o str_igual(l, "{")) { nivel = nivel + 1 }
            si (str_igual(l, ")") o str_igual(l, "]") o str_igual(l, "}")) {
                nivel = nivel - 1
                si (nivel == 0) { retornar j }
            }
        }
        si (__cargar64(t) == 5) { retornar j }
        j = j + 1
    }
    retornar j
}

// Fin (exclusivo) de la sentencia de nivel superior que empieza en a: el
// primer token fuera de paréntesis y llaves en una línea nueva.
funcion fin_sentencia_superior(tokens, a) {
    sea nivel = 0
    sea j = a
    mientras (j < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, j)
        si (__cargar64(t) == 5) { retornar j }
        si (j > a y nivel == 0 y __cargar64(t + 16) != __cargar64(vec_obtener(tokens, j - 1) + 16)) { retornar j }
        si (__cargar64(t) == 1 y str_igual(__cargar64(t + 8), "__dialecto")) { si (j > a) { retornar j } }
        si (__cargar64(t) == 4) {
            sea l = __cargar64(t + 8)
            si (str_igual(l, "(") o str_igual(l, "[") o str_igual(l, "{")) { nivel = nivel + 1 }
            si (str_igual(l, ")") o str_igual(l, "]") o str_igual(l, "}")) { nivel = nivel - 1 }
        }
        j = j + 1
    }
    retornar j
}

// Copia los tokens [a, b) como texto; un comptime pendiente se ejecuta ahí
// mismo (el programa auxiliar ya corre al compilar).
funcion comptime_texto(s, tokens, a, b) {
    sea j = a
    mientras (j < b) {
        sea t = vec_obtener(tokens, j)
        si (j > a y __cargar64(t + 16) != __cargar64(vec_obtener(tokens, j - 1) + 16)) { str_agregar_byte(s, 10) } sino { str_agregar_byte(s, 32) }
        si (es_comptime(tokens, j)) {
            si (es_simbolo(vec_obtener(tokens, j + 1), "{")) {
                sea m = cierre_de(tokens, j + 1)
                str_agregar(s, "comptime_ejecutar(funcion() ")
                comptime_texto(s, tokens, j + 1, m + 1)
                str_agregar(s, ")")
                j = m + 1
            } sino {
                j = j + 1
            }
        } sino {
            si (__cargar64(t) != 5) { str_agregar(s, __cargar64(t + 8)) }
            j = j + 1
        }
    }
    retornar 0
}

funcion evaluar_comptime(tokens, i, archivos) {
    sea abre = i + 1
    sea cierra = cierre_de(tokens, abre)
    sea es_bloque = es_simbolo(vec_obtener(tokens, abre), "{")
    sea linea = __cargar64(vec_obtener(tokens, i) + 16)
    sea s = str_nuevo(65536)
    // Tope de tiempo: un comptime (o una constante "sea" que se evalúa para
    // él) que no termina no debe colgar el compilador. Un hilo vigía termina
    // el programa auxiliar con el código 124 a los 10 s.
    str_agregar(s, "tarea(funcion() { dormir(10000) salir(124) })\n")
    // Definiciones del programa (dialecto 2): funciones, clases, extern,
    // atributos y las constantes "sea" anteriores al comptime.
    sea modo = 0
    sea a = 0
    mientras (a < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, a)
        si (__cargar64(t) == 5) { a = vec_largo(tokens) } sino {
            si (__cargar64(t) == 1 y str_igual(__cargar64(t + 8), "__dialecto")) {
                modo = numero_literal(lexema_en(tokens, a + 1))
                a = a + 2
            } sino {
                sea b = fin_sentencia_superior(tokens, a)
                si (b <= a) { b = a + 1 }
                si (modo == 2) {
                    sea l = __cargar64(t + 8)
                    sea definicion = str_igual(l, "funcion") o str_igual(l, "clase") o str_igual(l, "extern") o str_igual(l, "#")
                    si (str_igual(l, "sea") y b <= i) { definicion = 1 }
                    si (definicion) {
                        comptime_texto(s, tokens, a, b)
                        str_agregar_byte(s, 10)
                    }
                }
                a = b
            }
        }
    }
    sea base = str_concatenar(sys_ruta_temporal(), "cforge-comptime-")
    str_agregar(base, str_desde_entero(sys_proceso_id()))
    str_agregar(base, "-")
    str_agregar(base, str_desde_entero(i))
    sea programa = str_concatenar(base, ".cfv")
    sea resultado = str_concatenar(base, ".txt")
    // En el literal del programa auxiliar, "/" también vale en Windows.
    sea ruta_literal = str_nuevo(str_largo(resultado))
    sea q = 0
    mientras (q < str_largo(resultado)) {
        si (str_byte(resultado, q) == 92) { str_agregar_byte(ruta_literal, 47) } sino { str_agregar_byte(ruta_literal, str_byte(resultado, q)) }
        q = q + 1
    }
    si (es_bloque) {
        str_agregar(s, "\nfuncion comptime_valor__() ")
        comptime_texto(s, tokens, abre, cierra + 1)
        str_agregar(s, "\nescribir_archivo(")
        str_agregar(s, comillas(ruta_literal))
        str_agregar(s, ", comptime_literal(comptime_valor__()))\n")
    } sino {
        str_agregar(s, "\nescribir_archivo(")
        str_agregar(s, comillas(ruta_literal))
        str_agregar(s, ", comptime_literal(")
        comptime_texto(s, tokens, abre + 1, cierra)
        str_agregar(s, "))\n")
    }
    archivo_escribir(programa, s)
    archivo_escribir(resultado, "")
    sea args = vec_nuevo()
    vec_agregar(args, "run")
    vec_agregar(args, programa)
    sea codigo = sys_ejecutar_programa(sys_ruta_ejecutable(), args)
    sea literal = archivo_leer(resultado)
    sys_borrar(str_c(programa))
    sys_borrar(str_c(resultado))
    si (codigo != 0 o str_largo(literal) == 0) {
        sea donde = ctx_nuevo(tokens)
        __guardar64(donde + 208, archivos)
        sea m = ubicacion(donde, linea)
        si (codigo == 124) {
            str_agregar(m, ": comptime: la evaluación al compilar no terminó en 10 s (¿un ciclo sin fin en el comptime o en una constante anterior?)")
        } sino {
            str_agregar(m, ": comptime: la evaluación al compilar falló")
        }
        rt_panico(m)
    }
    // Reemplazo: tokens[0, i) + literal + tokens(cierra, fin].
    sea nuevos = vec_nuevo()
    sea k = 0
    mientras (k < i) {
        vec_agregar(nuevos, vec_obtener(tokens, k))
        k = k + 1
    }
    sea lit = tokenizar(literal)
    k = 0
    vec_agregar(nuevos, token_nuevo(4, "(", linea))
    mientras (k < vec_largo(lit)) {
        sea u = vec_obtener(lit, k)
        si (__cargar64(u) != 5) {
            __guardar64(u + 16, linea)
            vec_agregar(nuevos, u)
        }
        k = k + 1
    }
    vec_agregar(nuevos, token_nuevo(4, ")", linea))
    k = cierra + 1
    mientras (k < vec_largo(tokens)) {
        vec_agregar(nuevos, vec_obtener(tokens, k))
        k = k + 1
    }
    retornar nuevos
}

// ¿La línea global pertenece a un archivo del usuario (no del runtime ni de
// la biblioteca estándar)? Sin información de archivos: sí (conservador).
funcion linea_de_usuario(c, linea) {
    sea archivos = __cargar64(c + 208)
    si (archivos == 0 o linea <= 0) { retornar 1 }
    sea nombre = 0
    sea i = 0
    mientras (i < vec_largo(archivos)) {
        sea a = vec_obtener(archivos, i)
        si (__cargar64(a) <= linea) { nombre = __cargar64(a + 8) }
        i = i + 1
    }
    si (nombre == 0) { retornar 1 }
    si (str_largo(nombre) >= 8 y str_igual(str_rebanar(nombre, 0, 8), "runtime/")) { retornar 0 }
    sea stdlib = ruta_stdlib()
    si (str_largo(nombre) > str_largo(stdlib) y str_igual(str_rebanar(nombre, 0, str_largo(stdlib)), stdlib)) { retornar 0 }
    retornar 1
}

// Funciones alcanzables desde el programa principal (1 byte por función).
funcion funciones_alcanzables(c) {
    sea n = vec_largo(__cargar64(c + 144))
    sea marca = mem_reservar(n + 1)
    mem_llenar(marca, 0, n + 1)
    sea refs = __cargar64(c + 408)
    sea pendientes = vec_nuevo()
    // WebAssembly: las funciones del programa se pueden llamar desde
    // JavaScript (cforge.llamar), así que las de los archivos del usuario son
    // raíces; las de la biblioteca y el runtime solo si se usan (más
    // navegador_despachar, que llama el cargador).
    si (es_wasm(c)) {
        sea k = 0
        mientras (k < n) {
            sea f = vec_obtener(__cargar64(c + 144), k)
            si (__cargar64(f + 24) == 2 y (linea_de_usuario(c, __cargar64(f + 64)) o str_igual(__cargar64(f), "navegador_despachar"))) { vec_agregar(pendientes, k) }
            k = k + 1
        }
    }
    sea raiz = vec_obtener(refs, 0)
    sea i = 0
    mientras (i < vec_largo(raiz)) {
        vec_agregar(pendientes, vec_obtener(raiz, i))
        i = i + 1
    }
    mientras (vec_largo(pendientes) > 0) {
        sea f = vec_quitar_ultimo(pendientes)
        si (f >= 0 y f < n y __cargar8(marca + f) == 0) {
            __guardar8(marca + f, 1)
            si (f + 1 < vec_largo(refs)) {
                sea usa = vec_obtener(refs, f + 1)
                sea j = 0
                mientras (j < vec_largo(usa)) {
                    vec_agregar(pendientes, vec_obtener(usa, j))
                    j = j + 1
                }
            }
        }
    }
    retornar marca
}

funcion escribir_ejecutable(salida, ejecutable) {
    archivo_escribir(salida, ejecutable)
    sys_permisos(str_c(salida), 493)
    retornar 0
}

// Modo de bajo nivel (arranque): -o salida [--stdlib DIR] archivos...
// con --nativo/--puente/--lenguaje/--dinamico antes de cada grupo.
funcion cli_bajo_nivel() {
    si (rt_argc() < 4) { uso() }
    si (str_igual(rt_argumento(1), "-o") == 0) { uso() }
    sea salida = rt_argumento(2)
    sea fuente = str_nuevo(1048576)
    sea stdlib = "stdlib"
    sea modo = 0
    sea vistas = vec_nuevo()
    sea archivos = vec_nuevo()
    sea puntaje = 0
    sea indice = 3
    mientras (indice < rt_argc()) {
        sea argumento = rt_argumento(indice)
        si (str_igual(argumento, "--stdlib")) {
            indice = indice + 1
            stdlib = rt_argumento(indice)
        } sino {
        si (str_igual(argumento, "--target")) {
            indice = indice + 1
            mem_fijar_global(33, numero_plataforma(rt_argumento(indice)))
        } sino {
            sea nuevo_modo = modo_de_opcion(argumento)
            si (nuevo_modo >= 0) {
                modo = nuevo_modo
            } sino {
                sea texto = archivo_leer(argumento)
                si (modo == 2) {
                    puntaje = puntaje + puntaje_ingles(tokenizar(texto))
                    agregar_con_importaciones(fuente, stdlib, texto, argumento, vistas, archivos)
                } sino {
                    agregar_fuente(fuente, modo, texto, argumento, archivos)
                }
            }
        }
        }
        indice = indice + 1
    }
    sea ejecutable = compilar_programa(fuente, archivos, puntaje)
    escribir_ejecutable(salida, ejecutable)
    sea mensaje = str_concatenar("C-Forge (autoalojado) creó: ", salida)
    str_agregar(mensaje, " (")
    str_agregar(mensaje, str_desde_entero(str_largo(ejecutable)))
    str_agregar(mensaje, " bytes)")
    mostrar(mensaje)
    retornar 0
}

// linux → 0 · windows → 1 · macos → 2 · macos-arm64 → 3 · linux-arm64 → 4
funcion numero_plataforma(nombre) {
    si (str_igual(nombre, "windows") o str_igual(nombre, "win64")) { retornar 1 }
    si (str_igual(nombre, "macos") o str_igual(nombre, "macos-x64") o str_igual(nombre, "darwin")) { retornar 2 }
    si (str_igual(nombre, "macos-arm64") o str_igual(nombre, "macos-aarch64")) { retornar 3 }
    si (str_igual(nombre, "linux-arm64") o str_igual(nombre, "linux-aarch64")) { retornar 4 }
    si (str_igual(nombre, "ios-arm64") o str_igual(nombre, "ios")) { retornar 5 }
    si (str_igual(nombre, "ios-sim-arm64") o str_igual(nombre, "ios-simulator")) { retornar 6 }
    si (str_igual(nombre, "linux") o str_igual(nombre, "linux-x64")) { retornar 0 }
    si (str_igual(nombre, "wasm") o str_igual(nombre, "wasm32") o str_igual(nombre, "web")) { retornar 7 }
    rt_panico(str_concatenar("plataforma desconocida: ", str_concatenar(nombre, " (linux, linux-arm64, windows, macos, macos-arm64, ios-arm64, ios-sim-arm64)")))
    retornar 0
}

funcion modo_de_opcion(argumento) {
    si (str_igual(argumento, "--nativo")) { retornar 0 }
    si (str_igual(argumento, "--puente")) { retornar 1 }
    si (str_igual(argumento, "--dinamico")) { retornar 2 }
    si (str_igual(argumento, "--lenguaje")) { retornar 3 }
    retornar 0 - 1
}

// Funciones del runtime del lenguaje (puente) que un programa puede llamar.
// Las demás son internas: usan la convención del runtime y llamarlas desde
// un programa podía corromper memoria. Una función nueva del runtime es
// privada hasta que se agrega aquí (seguro por defecto).
funcion runtime_publicas() {
    retornar " Alguno Error Ninguno Ok a_numero a_texto absoluto adler32 aes_bloque aes_cifrar aes_descifrar aes_gcm_cifrar aes_gcm_descifrar afirmar agregar aleatorio aleatorio_entero aleatorio_uniforme arccoseno arcoseno arcotangente argon2id argumentos argumentos_programa bits_o bits_xo bits_y blake2b blake3 blake3_derivar bmp_decodificar borrar_texto byte_en bytes_aleatorios bytes_bufer bytes_buscar bytes_de_hex bytes_desenmascarar bytes_direccion bytes_entero bytes_leer_entero bytes_xor c_bytes c_cadena c_desde_bytes c_escribir32 c_escribir64 c_escribir_f32 c_f32 c_i32 c_leer32 c_leer64 c_leer8 c_liberar c_llamar c_reservar c_texto caja_abrir caja_cerrar canal_cerrar canal_enviar canal_nuevo canal_recibir canal_tam caracter cfv_aleatorio_uniforme cfv_base64_codificar cfv_base64_decodificar cfv_codigo_char cfv_fecha_ahora cfv_fecha_ahora_ms cfv_json_bonito cfv_json_parsear cfv_json_serializar cfv_md5 cfv_regex_buscar cfv_regex_buscar_todos cfv_regex_coincidir cfv_regex_dividir cfv_regex_reemplazar cfv_sha1 cfv_sha256 cfv_url_codificar cfv_url_decodificar chacha20_poly1305_cifrar chacha20_poly1305_descifrar chacha20_xor char_de claves cobertura_iniciar cobertura_marcar cobertura_volcar cociente comparar_seguro comptime_escribir comptime_literal contiene cos coseno crc32 crear_carpeta crypto_rand_bytes deflar dormir dotnet_funcion dotnet_iniciar dotnet_llamar dotnet_llamar_texto ed25519_firmar ed25519_publica ed25519_verificar eliminar eliminar_archivo eliminar_clave es_carpeta es_mismo escribir escribir_archivo esperar existe_archivo exponencial f32 filtrar gl3d_atributo gl3d_cerrar gl3d_dibujar gl3d_error gl3d_iniciar gl3d_intercambiar gl3d_leer_pixel gl3d_leer_pixeles gl3d_limpiar gl3d_profundidad gl3d_programa gl3d_shader gl3d_tamanio_dibujable gl3d_textura gl3d_uniforme_f gl3d_uniforme_i gl3d_uniforme_mat4 gl3d_uniforme_mat4_filas gl3d_uniforme_vec3 gl3d_usar_programa gl3d_usar_textura gl3d_vbo gl3d_ventana gl3d_viewport gzip_comprimir gzip_descomprimir hex_de_bytes hilo hilo_dormir hkdf_sha256 hkdf_sha512 hmac_sha256 hmac_sha256_bytes hmac_sha512 hmac_sha512_bytes http_get http_solicitud inflar insertar java_estatico java_iniciar java_metodo java_nuevo java_soltar jpeg_decodificar json_texto leer leer_archivo lienzo_copiar lienzo_fijar_pixel lienzo_llenar lienzo_nuevo_buffer lienzo_poligono lienzo_rect lienzo_triangulo lienzo_triangulos lienzo_zbuffer lienzo_zlimpiar lista_aplanar lista_contiene lista_direccion lista_filtrar lista_invertir lista_mapear lista_rango lista_repetir lista_unir listar_carpeta logaritmo longitud mapa_claves mapear maximo memoria_asignar memoria_estadisticas memoria_liberar minimo mostrar mutex_bloquear mutex_crear mutex_desbloquear mutex_liberar net_cerrar net_conectar net_enviar net_enviar_recibir net_espera net_recibir net_recibir_en net_recibir_exacto net_recibir_todo numero_a_texto numero_preciso ordenar para_cada paralelo pbkdf2_sha256 pcm_de_lista pcm_mezclar pcm_muestra pcm_silencio pi piso png_codificar png_decodificar poly1305 potencia quitar_clave quitar_ultimo raiz rango red_resolver redondear reducir reloj_ms repl_preparar repl_valor rsa_oaep_cifrar ruta_extension ruta_nombre salir sdl_cargar_fuente sdl_cerrar sdl_color sdl_delay sdl_dibujar_textura sdl_esperar sdl_eventos sdl_init sdl_limpiar sdl_linea sdl_presentar sdl_rect sdl_renderer sdl_texto sdl_ticks sdl_ventana sen seno separar servidor_http_cerrar servidor_http_escuchar servidor_http_escuchar_en servidor_http_limites servidor_http_responder servidor_http_responder_con servidor_http_solicitud servidor_http_tomar_conexion sha1_bytes sha256_bytes sha384 sha512 sha512_bytes subarray subcadena subtexto sys_info tan tangente tarea techo texto_a_numero texto_buscar texto_codigos texto_contiene texto_dividir texto_empieza_con texto_indice texto_indice_desde texto_invertir texto_mayusculas texto_minusculas texto_recortar texto_reemplazar texto_repetir texto_subcadena texto_termina_con texto_unir tiempo_actual tiempo_ms tiempo_segundos tiene_clave tipo tipo_de tls_abrir tls_cerrar tls_enviar tls_recibir_todo tls_version u32 udp_cerrar udp_crear udp_enviar udp_recibir unir variable_entorno wav_codificar wav_decodificar x25519 x25519_base zlib_comprimir zlib_descomprimir "
}

// ¿nombre está en la lista (palabras separadas por espacios)?
funcion runtime_es_publica(nombre) {
    sea lista = runtime_publicas()
    sea n = str_largo(nombre)
    sea i = 0
    mientras (i + n + 1 < str_largo(lista)) {
        si (str_byte(lista, i) == 32 y str_byte(lista, i + n + 1) == 32) {
            sea j = 0
            mientras (j < n y str_byte(lista, i + 1 + j) == str_byte(nombre, j)) { j = j + 1 }
            si (j == n) { retornar 1 }
        }
        i = i + 1
    }
    retornar 0
}

// Desbordamiento de pila: al entrar a una función del lenguaje se mira cuánta
// pila queda; si no alcanza, el runtime lanza un error capturable
// ("desbordamiento de pila") en vez de que el proceso muera con SIGSEGV.
//   · Hilo principal: base (global 63) - sp < tope (Linux 7 MiB de los 8 del
//     límite habitual; macOS y Windows 48 MiB de los 64 que reserva el
//     ejecutable).
//   · Hilos de tarea(): pila de 8 MiB alineada; error a 1 MiB del fondo.
// Ruta rápida: una carga, una resta y una comparación sin signo.
funcion comprobar_pila(c) {
    si (dinamico(c) == 0 o es_wasm(c) o mem_global(40) != 0) { retornar 0 }
    si (buscar_funcion(c, "dyn_pila_lenta") == 0) { retornar 0 }
    sea tope = 7340032
    si (es_macos(c) o es_windows(c)) { tope = 50331648 }
    sea bien = nueva_etiqueta(c)
    sea lenta = nueva_etiqueta(c)
    op_pila_rapida(c, tope, bien)
    op_cargar_global(c, 504)
    op_mov(c, 1, 4)
    op_aritmetica(c, 2)                                         // rax = base - sp
    op_constante_rcx(c, 67108864)
    op_saltar_si_menor_sin_signo(c, lenta)                      // principal pasado el tope
    op_mov(c, 0, 4)
    op_constante_rcx(c, 8388607)
    op_aritmetica(c, 6)                                         // sp dentro de su bloque de 8 MiB
    op_constante_rcx(c, 1048576)
    op_saltar_si_menor_sin_signo(c, lenta)                      // hilo cerca del fondo
    op_saltar(c, bien)
    definir_etiqueta(c, lenta)
    llamar_runtime(c, "dyn_pila_lenta", 0)
    definir_etiqueta(c, bien)
    retornar 0
}

// ══ Modo turbo (x86-64) ══════════════════════════════════════════════════
// Una función cuyos parámetros y resultado son todos i64 y cuyo cuerpo solo
// usa enteros (+ - * %, comparaciones en condiciones, si/sino/mientras,
// llamadas a otras funciones turbo) se compila con registros en vez de la
// pila de valores: variables en rbx/r13/r14/r15 (y el marco si hay más),
// expresiones en rcx/rsi/rdi/r8-r11, comparar y saltar de una vez, resto
// por constante sin dividir.
//
// La semántica es exactamente la del lenguaje: la función también se compila
// en su forma normal ("dinámica"). Si un argumento no es un entero chico, o
// si en la cruda algo se sale de i64 (desborde, división por cero), se
// descarta el cálculo (la función es pura: no tiene efectos) y se repite con
// la dinámica, que da el entero grande o el error de siempre.
//
// Cada función turbo tiene tres entradas:
//   · la normal (etiqueta de la función): convención del lenguaje, valida
//     los argumentos, desetiqueta y llama a la cruda;
//   · la cruda: argumentos en rdi, rsi, rdx, rcx, r8, r9; resultado en rax
//     con la bandera de acarreo apagada (encendida: "hay que repetir con la
//     dinámica");
//   · la dinámica: el cuerpo compilado como siempre.
// Las llamadas entre funciones turbo van directo a la cruda.
//
// Tabla (c + 480): vec de entradas [nombre][f][cruda][aridad][token "("]
// [estado: 1 turbo, 0 no][llamadas (vec de nombres)]. c + 488: vec de
// etiquetas con el que se armó (si cambia, otra pasada: se rearma).

// Nodos: [tipo][a][b][c]
funcion tb_nodo(tipo, a, b, d) {
    sea n = mem_reservar(32)
    __guardar64(n, tipo)
    __guardar64(n + 8, a)
    __guardar64(n + 16, b)
    __guardar64(n + 24, d)
    retornar n
}

// Analizador: estado p = [c][fallo][llamadas][profundidad máxima][locales]
funcion tb_fallar(p) { __guardar64(p + 8, 1) retornar 0 }
funcion tb_fallo(p) { retornar __cargar64(p + 8) }

funcion tb_es_palabra(lex) {
    retornar str_igual(lex, "si") o str_igual(lex, "sino") o str_igual(lex, "mientras") o str_igual(lex, "retornar") o str_igual(lex, "sea") o str_igual(lex, "romper") o str_igual(lex, "continuar") o str_igual(lex, "y") o str_igual(lex, "o") o str_igual(lex, "no") o str_igual(lex, "verdadero") o str_igual(lex, "falso") o str_igual(lex, "nulo")
}

funcion tb_ver_y(c) { retornar ver(c, "y") o ver(c, "and") o ver(c, "&&") }
funcion tb_ver_o(c) { retornar ver(c, "o") o ver(c, "or") o ver(c, "||") }
funcion tb_ver_no(c) { retornar ver(c, "no") o ver(c, "not") o ver(c, "!") }

// Entero literal (hasta 18 cifras, sin punto ni exponente).
funcion tb_literal(lex) {
    si (str_largo(lex) > 18 o str_largo(lex) == 0) { retornar 0 }
    sea i = 0
    mientras (i < str_largo(lex)) {
        sea b = str_byte(lex, i)
        si (b < 48 o b > 57) { retornar 0 }
        i = i + 1
    }
    retornar 1
}

// primario: número, nombre, nombre(args), (expr), -primario
funcion tb_primario(p) {
    sea c = __cargar64(p)
    si (tb_fallo(p)) { retornar 0 }
    si (tomar(c, "-")) { retornar tb_nodo(4, tb_primario(p), 0, 0) }
    si (tomar(c, "(")) {
        sea e = tb_suma(p)
        si (tomar(c, ")") == 0) { retornar tb_fallar(p) }
        retornar e
    }
    si (tok_tipo(c) == 2) {
        sea lex = tok_lexema(c)
        si (tb_literal(lex) == 0) { retornar tb_fallar(p) }
        avanzar(c)
        retornar tb_nodo(1, numero_literal(lex), 0, 0)
    }
    si (tomar(c, "[")) {
        // solo la lista vacía []
        si (tomar(c, "]") == 0) { retornar tb_fallar(p) }
        retornar tb_nodo(30, 0, 0, 0)
    }
    si (tok_tipo(c) == 1 y tb_es_palabra(tok_lexema(c)) == 0) {
        sea nombre = __cargar64(avanzar(c) + 8)
        si (ver(c, "[")) {
            avanzar(c)
            sea idx = tb_suma(p)
            si (tomar(c, "]") == 0) { retornar tb_fallar(p) }
            si (ver(c, "[") o ver(c, ".")) { retornar tb_fallar(p) }
            retornar tb_nodo(32, nombre, idx, 0)
        }
        si (str_igual(nombre, "longitud") y ver(c, "(")) {
            avanzar(c)
            sea arg = tb_suma(p)
            si (tomar(c, ")") == 0) { retornar tb_fallar(p) }
            retornar tb_nodo(35, arg, 0, 0)
        }
        si (str_igual(nombre, "ordenar") y ver(c, "(")) {
            avanzar(c)
            sea arg = tb_suma(p)
            si (tomar(c, ")") == 0) { retornar tb_fallar(p) }
            retornar tb_nodo(36, arg, 0, 0)
        }
        si (str_igual(nombre, "lista_repetir") y ver(c, "(")) {
            avanzar(c)
            sea v = tb_suma(p)
            si (tomar(c, ",") == 0) { retornar tb_fallar(p) }
            sea cuantos = tb_suma(p)
            si (tomar(c, ")") == 0) { retornar tb_fallar(p) }
            retornar tb_nodo(31, v, cuantos, 0)
        }
        si (tomar(c, "(")) {
            sea args = vec_nuevo()
            si (ver(c, ")") == 0) {
                vec_agregar(args, tb_suma(p))
                mientras (tomar(c, ",")) { vec_agregar(args, tb_suma(p)) }
            }
            si (tomar(c, ")") == 0) { retornar tb_fallar(p) }
            si (vec_largo(args) > 6) { retornar tb_fallar(p) }
            vec_agregar(__cargar64(p + 16), nombre)
            retornar tb_nodo(6, nombre, args, 0)
        }
        si (ver(c, ".") o ver(c, "[")) { retornar tb_fallar(p) }
        retornar tb_nodo(2, nombre, 0, 0)
    }
    retornar tb_fallar(p)
}

funcion tb_producto(p) {
    sea c = __cargar64(p)
    sea e = tb_primario(p)
    mientras (tb_fallo(p) == 0 y (ver(c, "*") o ver(c, "%"))) {
        sea op = 3
        si (ver(c, "%")) { op = 5 }
        avanzar(c)
        e = tb_nodo(3, op, e, tb_primario(p))
    }
    // "/" da decimal en el lenguaje: no es turbo.
    si (ver(c, "/")) { retornar tb_fallar(p) }
    retornar e
}

funcion tb_suma(p) {
    sea c = __cargar64(p)
    sea e = tb_producto(p)
    mientras (tb_fallo(p) == 0 y (ver(c, "+") o ver(c, "-"))) {
        sea op = 1
        si (ver(c, "-")) { op = 2 }
        avanzar(c)
        e = tb_nodo(3, op, e, tb_producto(p))
    }
    retornar e
}

// Código de condición x86 (jcc = 0F 80+cc) del comparador, o -1.
funcion tb_cc(c) {
    si (ver(c, "<")) { retornar 12 }
    si (ver(c, ">=")) { retornar 13 }
    si (ver(c, "<=")) { retornar 14 }
    si (ver(c, ">")) { retornar 15 }
    si (ver(c, "==")) { retornar 4 }
    si (ver(c, "!=")) { retornar 5 }
    retornar 0 - 1
}

funcion tb_comparacion(p) {
    sea c = __cargar64(p)
    si (tb_ver_no(c)) {
        avanzar(c)
        retornar tb_nodo(13, 0, tb_comparacion(p), 0)
    }
    si (ver(c, "(")) {
        // ¿(condición) o (expresión) < ...? Se prueba como condición.
        sea guardado = __cargar64(c + 8)
        avanzar(c)
        sea interna = tb_o(p)
        si (tb_fallo(p) == 0 y tomar(c, ")") y tb_cc(c) < 0) { retornar interna }
        __guardar64(c + 8, guardado)
        __guardar64(p + 8, 0)
    }
    sea izq = tb_suma(p)
    sea cc = tb_cc(c)
    si (cc < 0) { retornar tb_fallar(p) }
    avanzar(c)
    retornar tb_nodo(10, cc, izq, tb_suma(p))
}

funcion tb_y(p) {
    sea c = __cargar64(p)
    sea e = tb_comparacion(p)
    mientras (tb_fallo(p) == 0 y tb_ver_y(c)) {
        avanzar(c)
        e = tb_nodo(11, 0, e, tb_comparacion(p))
    }
    retornar e
}

funcion tb_o(p) {
    sea c = __cargar64(p)
    sea e = tb_y(p)
    mientras (tb_fallo(p) == 0 y tb_ver_o(c)) {
        avanzar(c)
        e = tb_nodo(12, 0, e, tb_y(p))
    }
    retornar e
}

funcion tb_condicion(p) {
    sea c = __cargar64(p)
    si (tomar(c, "(") == 0) { retornar tb_fallar(p) }
    sea e = tb_o(p)
    si (tomar(c, ")") == 0) { retornar tb_fallar(p) }
    retornar e
}

funcion tb_bloque(p) {
    sea c = __cargar64(p)
    sea v = vec_nuevo()
    si (tomar(c, "{") == 0) { tb_fallar(p) retornar v }
    mientras (tb_fallo(p) == 0 y ver(c, "}") == 0) {
        si (tok_tipo(c) == 5) { tb_fallar(p) retornar v }
        vec_agregar(v, tb_sentencia(p))
        tomar(c, ";")
    }
    tomar(c, "}")
    retornar v
}

funcion tb_sentencia(p) {
    sea c = __cargar64(p)
    si (tomar(c, "sea")) {
        si (tok_tipo(c) != 1) { retornar tb_fallar(p) }
        sea nombre = __cargar64(avanzar(c) + 8)
        si (tomar(c, ":")) {
            si (tomar(c, "i64") == 0) { retornar tb_fallar(p) }
        }
        si (tomar(c, "=") == 0) { retornar tb_fallar(p) }
        __guardar64(p + 32, __cargar64(p + 32) + 1)
        retornar tb_nodo(20, nombre, tb_suma(p), 0)
    }
    si (tomar(c, "si")) {
        sea cond = tb_condicion(p)
        sea entonces = tb_bloque(p)
        sea otro = 0
        si (tomar(c, "sino")) {
            si (ver(c, "si")) {
                sea v = vec_nuevo()
                vec_agregar(v, tb_sentencia(p))
                otro = v
            } sino {
                otro = tb_bloque(p)
            }
        }
        retornar tb_nodo(22, cond, entonces, otro)
    }
    si (tomar(c, "mientras")) {
        sea cond = tb_condicion(p)
        retornar tb_nodo(23, cond, tb_bloque(p), 0)
    }
    si (tomar(c, "retornar")) { retornar tb_nodo(24, tb_suma(p), 0, 0) }
    si (tomar(c, "romper")) { retornar tb_nodo(25, 0, 0, 0) }
    si (tomar(c, "continuar")) { retornar tb_nodo(26, 0, 0, 0) }
    si (tok_tipo(c) == 1 y tb_es_palabra(tok_lexema(c)) == 0) {
        sea siguiente = tok_siguiente_lexema(c)
        sea nombre = tok_lexema(c)
        // l[i] = v
        si (str_igual(siguiente, "[")) {
            avanzar(c)
            avanzar(c)
            sea idx = tb_suma(p)
            si (tomar(c, "]") == 0 o tomar(c, "=") == 0) { retornar tb_fallar(p) }
            retornar tb_nodo(33, nombre, idx, tb_suma(p))
        }
        // l.agregar(v)
        si (str_igual(siguiente, ".")) {
            avanzar(c)
            avanzar(c)
            si (tomar(c, "agregar") == 0 o tomar(c, "(") == 0) { retornar tb_fallar(p) }
            sea v = tb_suma(p)
            si (tomar(c, ")") == 0) { retornar tb_fallar(p) }
            retornar tb_nodo(34, nombre, v, 0)
        }
        // agregar(l, v)
        si (str_igual(nombre, "agregar") y str_igual(siguiente, "(")) {
            avanzar(c)
            avanzar(c)
            si (tok_tipo(c) != 1) { retornar tb_fallar(p) }
            sea lista = __cargar64(avanzar(c) + 8)
            si (tomar(c, ",") == 0) { retornar tb_fallar(p) }
            sea v = tb_suma(p)
            si (tomar(c, ")") == 0) { retornar tb_fallar(p) }
            retornar tb_nodo(34, lista, v, 0)
        }
        si (str_igual(siguiente, "=")) {
            avanzar(c)
            avanzar(c)
            retornar tb_nodo(21, nombre, tb_suma(p), 0)
        }
        // x += e llega como "x" "+" "=" e
        sea op = 0
        sea tokens = __cargar64(c)
        sea j = __cargar64(c + 8)
        si (j + 2 < vec_largo(tokens) y str_igual(lexema_en(tokens, j + 2), "=")) {
            si (str_igual(siguiente, "+")) { op = 1 }
            si (str_igual(siguiente, "-")) { op = 2 }
            si (str_igual(siguiente, "*")) { op = 3 }
            si (str_igual(siguiente, "%")) { op = 5 }
        }
        si (op != 0) {
            avanzar(c)
            avanzar(c)
            avanzar(c)
            retornar tb_nodo(21, nombre, tb_nodo(3, op, tb_nodo(2, nombre, 0, 0), tb_suma(p)), 0)
        }
        si (str_igual(siguiente, "(")) { retornar tb_nodo(27, tb_primario(p), 0, 0) }
    }
    retornar tb_fallar(p)
}

// "(" a: i64, b: i64 ")" ":" "i64" "{" … "}" desde el cursor. Devuelve el
// estado del analizador ([4]: nombres de parámetros, [5]: cuerpo).
funcion tb_analizar_funcion(c) {
    sea p = mem_reservar(64)
    mem_llenar(p, 0, 64)
    __guardar64(p, c)
    __guardar64(p + 16, vec_nuevo())
    sea nombres = vec_nuevo()
    __guardar64(p + 40, nombres)
    si (tomar(c, "(") == 0) { tb_fallar(p) retornar p }
    si (ver(c, ")") == 0) {
        sea seguir = 1
        mientras (seguir) {
            si (tok_tipo(c) != 1) { tb_fallar(p) retornar p }
            vec_agregar(nombres, __cargar64(avanzar(c) + 8))
            // sin tipo: se especula que es un entero (si no lo es, la
            // entrada normal usa la forma dinámica)
            si (tomar(c, ":")) {
                si (tomar(c, "i64") == 0) { tb_fallar(p) retornar p }
            }
            si (ver(c, "=")) { tb_fallar(p) retornar p }              // valores por defecto: no
            si (tomar(c, ",") == 0) { seguir = 0 }
        }
    }
    si (tomar(c, ")") == 0) { tb_fallar(p) retornar p }
    si (tomar(c, ":")) {
        si (tomar(c, "i64") == 0) { tb_fallar(p) retornar p }
    }
    si (vec_largo(nombres) > 6) { tb_fallar(p) retornar p }
    __guardar64(p + 48, tb_bloque(p))
    retornar p
}

// Registros necesarios para evaluar e (Sethi-Ullman simplificado).
funcion tb_necesita(e) {
    sea t = __cargar64(e)
    si (t == 3 o t == 10) {
        sea a = tb_necesita(__cargar64(e + 16))
        sea b = tb_necesita(__cargar64(e + 24))
        si (b + 1 > a) { a = b + 1 }
        retornar a
    }
    si (t == 4 o t == 35 o t == 36) { retornar tb_necesita(__cargar64(e + 8)) + 1 }
    si (t == 32) { retornar tb_necesita(__cargar64(e + 16)) + 1 }
    si (t == 31) {
        sea a = tb_necesita(__cargar64(e + 8))
        sea b = tb_necesita(__cargar64(e + 16)) + 1
        si (b > a) { a = b }
        retornar a
    }
    si (t == 6) {
        sea args = __cargar64(e + 16)
        sea m = 1
        sea i = 0
        mientras (i < vec_largo(args)) {
            sea k = tb_necesita(vec_obtener(args, i))
            si (k > m) { m = k }
            i = i + 1
        }
        retornar m
    }
    retornar 1
}

// ¿Todas las expresiones caben en los 7 registros de trabajo?
funcion tb_cabe_bloque(v) {
    sea i = 0
    mientras (i < vec_largo(v)) {
        si (tb_cabe_sentencia(vec_obtener(v, i)) == 0) { retornar 0 }
        i = i + 1
    }
    retornar 1
}

funcion tb_cabe_cond(e) {
    sea t = __cargar64(e)
    si (t == 11 o t == 12) { retornar tb_cabe_cond(__cargar64(e + 16)) y tb_cabe_cond(__cargar64(e + 24)) }
    si (t == 13) { retornar tb_cabe_cond(__cargar64(e + 16)) }
    retornar tb_necesita(e) <= 7
}

funcion tb_cabe_sentencia(s) {
    sea t = __cargar64(s)
    si (t == 20 o t == 21) { retornar tb_necesita(__cargar64(s + 16)) <= 7 }
    si (t == 33) { retornar tb_necesita(__cargar64(s + 16)) <= 5 y tb_necesita(__cargar64(s + 24)) <= 5 }
    si (t == 34) { retornar tb_necesita(__cargar64(s + 16)) <= 5 }
    si (t == 24 o t == 27) { retornar tb_necesita(__cargar64(s + 8)) <= 7 }
    si (t == 22) {
        si (tb_cabe_cond(__cargar64(s + 8)) == 0 o tb_cabe_bloque(__cargar64(s + 16)) == 0) { retornar 0 }
        si (__cargar64(s + 24) != 0) { retornar tb_cabe_bloque(__cargar64(s + 24)) }
        retornar 1
    }
    si (t == 23) { retornar tb_cabe_cond(__cargar64(s + 8)) y tb_cabe_bloque(__cargar64(s + 16)) }
    retornar 1
}

// ¿Toda variable usada es un parámetro o una local declarada antes? (Las
// globales no se compilan en turbo.)
funcion tb_declarada(nombres, n) {
    sea i = vec_largo(nombres) - 1
    mientras (i >= 0) {
        si (str_igual(vec_obtener(nombres, i), n)) { retornar 1 }
        i = i - 1
    }
    retornar 0
}

// Clase de una expresión: 1 entero, 2 lista (las listas son locales: no
// salen de la función ni se pasan a otras). Las variables de lista se
// anotan en "nombres" con el prefijo "[]".
funcion tb_es_lista_var(nombres, n) {
    retornar tb_declarada(nombres, str_concatenar("[]", n))
}

funcion tb_clase(e, nombres) {
    sea t = __cargar64(e)
    si (t == 30 o t == 31 o t == 36) { retornar 2 }
    si (t == 2 y tb_es_lista_var(nombres, __cargar64(e + 8))) { retornar 2 }
    retornar 1
}

funcion tb_validar_lista(e, nombres) {
    sea t = __cargar64(e)
    si (t == 2) { retornar tb_es_lista_var(nombres, __cargar64(e + 8)) }
    si (t == 30) { retornar 1 }
    si (t == 31) { retornar tb_validar_expr(__cargar64(e + 8), nombres) y tb_validar_expr(__cargar64(e + 16), nombres) }
    si (t == 36) { retornar tb_validar_lista(__cargar64(e + 8), nombres) }
    retornar 0
}

funcion tb_validar_expr(e, nombres) {
    sea t = __cargar64(e)
    si (t == 2) { retornar tb_declarada(nombres, __cargar64(e + 8)) y tb_es_lista_var(nombres, __cargar64(e + 8)) == 0 }
    si (t == 30 o t == 31 o t == 36) { retornar 0 }
    si (t == 32) { retornar tb_es_lista_var(nombres, __cargar64(e + 8)) y tb_validar_expr(__cargar64(e + 16), nombres) }
    si (t == 35) { retornar tb_validar_lista(__cargar64(e + 8), nombres) }
    si (t == 3 o t == 10 o t == 11 o t == 12) { retornar tb_validar_expr(__cargar64(e + 16), nombres) y tb_validar_expr(__cargar64(e + 24), nombres) }
    si (t == 13) { retornar tb_validar_expr(__cargar64(e + 16), nombres) }
    si (t == 4) { retornar tb_validar_expr(__cargar64(e + 8), nombres) }
    si (t == 6) {
        sea args = __cargar64(e + 16)
        sea i = 0
        mientras (i < vec_largo(args)) {
            si (tb_validar_expr(vec_obtener(args, i), nombres) == 0) { retornar 0 }
            i = i + 1
        }
        // una local con el nombre de la función la taparía
        retornar tb_declarada(nombres, __cargar64(e + 8)) == 0
    }
    retornar 1
}

funcion tb_validar(v, nombres) {
    sea marca = vec_largo(nombres)
    sea ok = 1
    sea i = 0
    mientras (ok y i < vec_largo(v)) {
        sea s = vec_obtener(v, i)
        sea t = __cargar64(s)
        si (t == 20 y tb_declarada(nombres, __cargar64(s + 8))) { ok = 0 }  // sin variables tapadas
        si (ok y t == 20) {
            si (tb_clase(__cargar64(s + 16), nombres) == 2) {
                ok = tb_validar_lista(__cargar64(s + 16), nombres)
                vec_agregar(nombres, str_concatenar("[]", __cargar64(s + 8)))
            } sino {
                ok = tb_validar_expr(__cargar64(s + 16), nombres)
            }
            vec_agregar(nombres, __cargar64(s + 8))
        }
        si (t == 21) { ok = tb_declarada(nombres, __cargar64(s + 8)) y tb_es_lista_var(nombres, __cargar64(s + 8)) == 0 y tb_validar_expr(__cargar64(s + 16), nombres) }
        si (t == 33) { ok = tb_es_lista_var(nombres, __cargar64(s + 8)) y tb_validar_expr(__cargar64(s + 16), nombres) y tb_validar_expr(__cargar64(s + 24), nombres) }
        si (t == 34) { ok = tb_es_lista_var(nombres, __cargar64(s + 8)) y tb_validar_expr(__cargar64(s + 16), nombres) }
        si (t == 22) {
            ok = tb_validar_expr(__cargar64(s + 8), nombres) y tb_validar(__cargar64(s + 16), nombres)
            si (ok y __cargar64(s + 24) != 0) { ok = tb_validar(__cargar64(s + 24), nombres) }
        }
        si (t == 23) { ok = tb_validar_expr(__cargar64(s + 8), nombres) y tb_validar(__cargar64(s + 16), nombres) }
        si (t == 24 o t == 27) { ok = tb_validar_expr(__cargar64(s + 8), nombres) }
        i = i + 1
    }
    __guardar64(nombres, marca)
    retornar ok
}

funcion tb_copiar_vec(v) {
    sea r = vec_nuevo()
    sea i = 0
    mientras (i < vec_largo(v)) {
        vec_agregar(r, vec_obtener(v, i))
        i = i + 1
    }
    retornar r
}

// ¿El bloque siempre termina en retornar? (si no, el lenguaje devolvería
// nulo, que no es un i64: esa función no es turbo).
funcion tb_termina(v) {
    si (vec_largo(v) == 0) { retornar 0 }
    sea s = vec_obtener(v, vec_largo(v) - 1)
    sea t = __cargar64(s)
    si (t == 24) { retornar 1 }
    si (t == 22 y __cargar64(s + 24) != 0) { retornar tb_termina(__cargar64(s + 16)) y tb_termina(__cargar64(s + 24)) }
    retornar 0
}

// Arma la tabla de funciones turbo (una vez por pasada).
funcion tb_tabla(c) {
    si (__cargar64(c + 480) != 0 y __cargar64(c + 488) == __cargar64(c + 40)) { retornar __cargar64(c + 480) }
    sea tabla = vec_nuevo()
    __guardar64(c + 480, tabla)
    __guardar64(c + 488, __cargar64(c + 40))
    __guardar64(c + 496, 0)                                          // rutina de orden (por pasada)
    si (es_arm64(c) o es_wasm(c) o mem_global(40) != 0) { retornar tabla }
    si (variable_entorno_es(c, "CFORGE_TURBO", "0")) { retornar tabla }
    sea tokens = __cargar64(c)
    sea guardado = __cargar64(c + 8)
    sea profundidad = 0
    sea i = 0
    mientras (i + 2 < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, i)
        sea lex = __cargar64(t + 8)
        si (__cargar64(t) != 3) {
            si (str_igual(lex, "{")) { profundidad = profundidad + 1 }
            si (str_igual(lex, "}")) { profundidad = profundidad - 1 }
            si (profundidad == 0 y str_igual(lex, "funcion") y __cargar64(vec_obtener(tokens, i + 1)) == 1 y str_igual(lexema_en(tokens, i + 2), "(")) {
                sea nombre = lexema_en(tokens, i + 1)
                sea f = buscar_funcion(c, nombre)
                si (f != 0 y __cargar64(f + 24) == 2 y tb_buscar(tabla, nombre) == 0) {
                    __guardar64(c + 8, i + 2)
                    sea p = tb_analizar_funcion(c)
                    si (tb_fallo(p) == 0 y tb_cabe_bloque(__cargar64(p + 48)) y tb_termina(__cargar64(p + 48)) y tb_validar(__cargar64(p + 48), tb_copiar_vec(__cargar64(p + 40)))) {
                        sea e = mem_reservar(64)
                        __guardar64(e, nombre)
                        __guardar64(e + 8, f)
                        __guardar64(e + 16, nueva_etiqueta(c))
                        __guardar64(e + 24, vec_largo(__cargar64(p + 40)))
                        __guardar64(e + 32, i + 2)
                        __guardar64(e + 40, 1)
                        __guardar64(e + 48, __cargar64(p + 16))
                        vec_agregar(tabla, e)
                    }
                }
            }
        }
        i = i + 1
    }
    __guardar64(c + 8, guardado)
    // Punto fijo: solo llamadas a funciones turbo con la aridad correcta.
    sea cambio = 1
    mientras (cambio) {
        cambio = 0
        sea k = 0
        mientras (k < vec_largo(tabla)) {
            sea e = vec_obtener(tabla, k)
            si (__cargar64(e + 40) == 1) {
                sea llamadas = __cargar64(e + 48)
                sea j = 0
                mientras (j < vec_largo(llamadas)) {
                    sea otra = tb_buscar(tabla, vec_obtener(llamadas, j))
                    si (otra == 0 o __cargar64(otra + 40) != 1) {
                        __guardar64(e + 40, 0)
                        cambio = 1
                    }
                    j = j + 1
                }
            }
            k = k + 1
        }
    }
    retornar tabla
}

funcion variable_entorno_es(c, nombre, valor) {
    sea v = sys_variable_entorno(nombre)
    si (v == 0) { retornar 0 }
    retornar str_igual(v, valor)
}

funcion tb_buscar(tabla, nombre) {
    sea i = 0
    mientras (i < vec_largo(tabla)) {
        sea e = vec_obtener(tabla, i)
        si (str_igual(__cargar64(e), nombre)) { retornar e }
        i = i + 1
    }
    retornar 0
}

// Entrada turbo de f (o 0).
funcion tb_de(c, f) {
    si (dinamico(c) == 0) { retornar 0 }
    sea tabla = tb_tabla(c)
    sea i = 0
    mientras (i < vec_largo(tabla)) {
        sea e = vec_obtener(tabla, i)
        si (__cargar64(e + 8) == f y __cargar64(e + 40) == 1) { retornar e }
        i = i + 1
    }
    retornar 0
}

// ── Codificación x86-64 ──────────────────────────────────────────────────
// Registros: 0 rax 1 rcx 2 rdx 3 rbx 4 rsp 5 rbp 6 rsi 7 rdi 8-15 r8-r15.

funcion tb_rex(c, r, b) {
    sea x = 72
    si (r >= 8) { x = x + 4 }
    si (b >= 8) { x = x + 1 }
    e1(c, x)
    retornar 0
}

// op r/m64(dst), r64(src): mov 89, add 01, sub 29, cmp 39, test 85
funcion tb_rr(c, op, dst, src) {
    tb_rex(c, src, dst)
    e1(c, op)
    e1(c, 192 + __y_bits(src, 7) * 8 + __y_bits(dst, 7))
    retornar 0
}

funcion tb_mov(c, dst, src) {
    si (dst != src) { tb_rr(c, 137, dst, src) }
    retornar 0
}

funcion tb_imul(c, dst, src) {
    tb_rex(c, dst, src)
    e2(c, 15, 175)
    e1(c, 192 + __y_bits(dst, 7) * 8 + __y_bits(src, 7))
    retornar 0
}

funcion tb_cabe32(v) { retornar v >= 0 - 2147483648 y v <= 2147483647 }

funcion tb_inmediato(c, r, v) {
    si (v == 0) {
        si (r >= 8) { e1(c, 69) }                                    // REX.RB
        e2(c, 49, 192 + __y_bits(r, 7) * 9)                          // xor r32, r32
        retornar 0
    }
    si (tb_cabe32(v)) {
        tb_rex(c, 0, r)
        e2(c, 199, 192 + __y_bits(r, 7))
        e32(c, v)
    } sino {
        tb_rex(c, 0, r)
        e1(c, 184 + __y_bits(r, 7))
        e32(c, __y_bits(v, 4294967295))
        e32(c, __desplazar_der(v, 32))
    }
    retornar 0
}

// add/sub/cmp r, imm32 (ext: 0 add, 5 sub, 7 cmp)
funcion tb_op_inm(c, ext, r, v) {
    tb_rex(c, 0, r)
    e2(c, 129, 192 + ext * 8 + __y_bits(r, 7))
    e32(c, v)
    retornar 0
}

// [rbp + d]
funcion tb_memoria(c, op, r, d) {
    tb_rex(c, r, 0)
    e2(c, op, 133 + __y_bits(r, 7) * 8)
    e32(c, d)
    retornar 0
}

funcion tb_empujar(c, r) {
    si (r >= 8) { e1(c, 65) }
    e1(c, 80 + __y_bits(r, 7))
    retornar 0
}

funcion tb_sacar(c, r) {
    si (r >= 8) { e1(c, 65) }
    e1(c, 88 + __y_bits(r, 7))
    retornar 0
}

// Rellena con nop hasta múltiplo de 16 (entradas de función y ciclos: el
// procesador las busca más rápido y los tiempos no dependen de dónde caen).
funcion tb_alinear(c) {
    // En Linux el código empieza tras las cabeceras ELF (64 + 56 = 120 bytes).
    sea desfase = 0
    si (es_macos(c) == 0 y es_windows(c) == 0) { desfase = 120 }
    mientras (__y_bits(posicion_codigo(c) + desfase, 15) != 0) { e1(c, 144) }
    retornar 0
}

funcion tb_jcc(c, cc, etiqueta) {
    e2(c, 15, 128 + cc)
    nuevo_arreglo(c, 0, etiqueta)
    retornar 0
}

// Registros de trabajo, hogares de variables y de argumentos.
funcion tb_trabajo(i) {
    si (i == 0) { retornar 1 }
    si (i == 1) { retornar 6 }
    si (i == 2) { retornar 7 }
    retornar i + 5
}

funcion tb_hogar(k) {
    si (k == 0) { retornar 3 }
    retornar k + 12
}

funcion tb_argumento(i) {
    si (i == 0) { retornar 7 }
    si (i == 1) { retornar 6 }
    si (i == 2) { retornar 2 }
    si (i == 3) { retornar 1 }
    retornar i + 4
}

funcion tb_desplazamiento(k) { retornar 0 - 40 - (k - 4) * 8 }   // tras guardar los 4 hogares

funcion tb_cargar_var(c, r, k) {
    si (k < 4) { retornar tb_mov(c, r, tb_hogar(k)) }
    retornar tb_memoria(c, 139, r, tb_desplazamiento(k))
}

funcion tb_guardar_var(c, k, r) {
    si (k < 4) { retornar tb_mov(c, tb_hogar(k), r) }
    retornar tb_memoria(c, 137, r, tb_desplazamiento(k))
}

// ── Generación ───────────────────────────────────────────────────────────
// g = [c][nombres de variables (vec)][salida][desborde][div0][bucles (vec)]

funcion tb_variable(g, nombre) {
    sea v = __cargar64(g + 152)
    sea i = vec_largo(v) - 1
    mientras (i >= 0) {
        si (str_igual(vec_obtener(v, i), nombre)) { retornar i }
        i = i - 1
    }
    rt_panico(str_concatenar("turbo: variable desconocida ", nombre))
    retornar 0
}

// ── Listas locales ───────────────────────────────────────────────────
// mov dst, [base + d8]
funcion tb_carga_base(c, dst, base, d) {
    tb_rex(c, dst, base)
    e2(c, 139, 64 + __y_bits(dst, 7) * 8 + __y_bits(base, 7))
    e1(c, d)
    retornar 0
}

// mov [base + d8], src
funcion tb_guarda_base(c, base, d, src) {
    tb_rex(c, src, base)
    e2(c, 137, 64 + __y_bits(src, 7) * 8 + __y_bits(base, 7))
    e1(c, d)
    retornar 0
}

funcion tb_lista_desp(g, k) { retornar 0 - __cargar64(g + 112) - 8 * (k + 1) }

funcion tb_lista_slot(g, nombre) {
    sea v = __cargar64(g + 120)
    sea i = vec_largo(v) - 1
    mientras (i >= 0) {
        si (str_igual(vec_obtener(v, i), nombre)) { retornar i }
        i = i - 1
    }
    rt_panico(str_concatenar("turbo: lista desconocida ", nombre))
    retornar 0
}

funcion tb_lista_ancho(g, nombre) { retornar vec_obtener(__cargar64(g + 128), tb_lista_slot(g, nombre)) }

// Ancho de los elementos de la lista de e (1: bytes, 8: i64).
funcion tb_ancho_expr(g, e) {
    sea t = __cargar64(e)
    si (t == 2) { retornar tb_lista_ancho(g, __cargar64(e + 8)) }
    si (t == 36) { retornar tb_ancho_expr(g, __cargar64(e + 8)) }
    retornar 8
}

funcion tb_es_byte(e) { retornar __cargar64(e) == 1 y __cargar64(e + 8) >= 0 y __cargar64(e + 8) <= 255 }

// ¿Toda escritura a la lista "nombre" en v es una constante 0..255?
funcion tb_escrituras_byte(v, nombre) {
    sea i = 0
    mientras (i < vec_largo(v)) {
        sea s = vec_obtener(v, i)
        sea t = __cargar64(s)
        si ((t == 33 o t == 34) y str_igual(__cargar64(s + 8), nombre)) {
            sea valor = __cargar64(s + 16)
            si (t == 33) { valor = __cargar64(s + 24) }
            si (tb_es_byte(valor) == 0) { retornar 0 }
        }
        si (t == 22) {
            si (tb_escrituras_byte(__cargar64(s + 16), nombre) == 0) { retornar 0 }
            si (__cargar64(s + 24) != 0 y tb_escrituras_byte(__cargar64(s + 24), nombre) == 0) { retornar 0 }
        }
        si (t == 23 y tb_escrituras_byte(__cargar64(s + 16), nombre) == 0) { retornar 0 }
        i = i + 1
    }
    retornar 1
}

// Etiqueta un entero en r (r·2 + 1); fuera de 62 bits: repetir.
funcion tb_etiquetar(g, r) {
    sea c = __cargar64(g)
    tb_rr(c, 1, r, r)                                              // add r, r
    tb_jcc(c, 0, __cargar64(g + 24))
    tb_rex(c, 0, r)
    e3(c, 131, 200 + __y_bits(r, 7), 1)                           // or r, 1
    retornar 0
}

// Llamada al runtime desde código turbo: guarda los registros de trabajo
// vivos (0..d-1), apila los argumentos (registros) y deja el resultado en rax.
funcion tb_runtime(g, d, nombre, args) {
    sea c = __cargar64(g)
    sea i = 0
    mientras (i < d) {
        tb_empujar(c, tb_trabajo(i))
        i = i + 1
    }
    i = 0
    mientras (i < vec_largo(args)) {
        tb_empujar(c, vec_obtener(args, i))
        i = i + 1
    }
    llamar_runtime(c, nombre, vec_largo(args))
    i = d - 1
    mientras (i >= 0) {
        tb_sacar(c, tb_trabajo(i))
        i = i - 1
    }
    retornar 0
}

// Acceso [base + índice·ancho]: op 139 cargar r (ancho 8), 137 guardar r
// (ancho 8), "byte" con ancho 1 (movzx al cargar, mov r8 al guardar).
funcion tb_elemento(c, guardar, ancho, r, base, indice) {
    sea x = 64
    si (r >= 8) { x = x + 4 }
    si (indice >= 8) { x = x + 2 }
    si (base >= 8) { x = x + 1 }
    sea escala = 192
    si (ancho == 1) { escala = 0 }
    sea sib = escala + __y_bits(indice, 7) * 8 + __y_bits(base, 7)
    sea modrm = 4 + __y_bits(r, 7) * 8
    si (ancho == 8) {
        e1(c, x + 8)
        si (guardar) { e1(c, 137) } sino { e1(c, 139) }
        e2(c, modrm, sib)
        retornar 0
    }
    si (guardar) {
        e3(c, x, 136, modrm)                                       // mov byte [..], r8
        e1(c, sib)
        retornar 0
    }
    e4(c, x + 8, 15, 182, modrm)                                   // movzx r, byte [..]
    e1(c, sib)
    retornar 0
}

// mov byte/qword [base + índice·ancho], inmediato
funcion tb_elemento_inm(c, ancho, base, indice, v) {
    sea x = 64
    si (indice >= 8) { x = x + 2 }
    si (base >= 8) { x = x + 1 }
    sea escala = 192
    si (ancho == 1) { escala = 0 }
    sea sib = escala + __y_bits(indice, 7) * 8 + __y_bits(base, 7)
    si (ancho == 1) {
        si (x != 64) { e1(c, x) }
        e3(c, 198, 4, sib)
        e1(c, __y_bits(v, 255))
        retornar 0
    }
    e4(c, x + 8, 199, 4, sib)
    e32(c, v)
    retornar 0
}

// Una lista local del modo turbo es una lista cruda (ver dyn_crudo_*):
// sus elementos no llevan etiqueta y, si todo lo que se escribe en ella son
// constantes 0..255, ocupan un byte. No sale de la función (no se retorna ni
// se pasa a otras), así que nadie más la ve; si un índice queda fuera de
// rango, se repite con la forma dinámica, que da el error de siempre.
// Cabecera de la lista de e en el registro de trabajo d.
funcion tb_lista_expr(g, e, d) {
    sea c = __cargar64(g)
    sea r = tb_trabajo(d)
    sea t = __cargar64(e)
    si (t == 2) { retornar tb_memoria(c, 139, r, tb_lista_desp(g, tb_lista_slot(g, __cargar64(e + 8)))) }
    sea ancho = __cargar64(g + 136)
    si (t == 30) {
        tb_inmediato(c, r, ancho)
        sea args = vec_nuevo()
        vec_agregar(args, r)
        tb_runtime(g, d, "dyn_crudo_nueva", args)
        retornar tb_mov(c, r, 0)
    }
    si (t == 31) {
        tb_expr(g, __cargar64(e + 8), d)
        tb_expr(g, __cargar64(e + 16), d + 1)
        sea n = tb_trabajo(d + 1)
        tb_op_inm(c, 7, n, 268435456)
        tb_jcc(c, 7, __cargar64(g + 24))                           // ja (o negativo): lo decide la dinámica
        sea a = tb_trabajo(d + 2)
        tb_inmediato(c, a, ancho)
        sea args = vec_nuevo()
        vec_agregar(args, r)
        vec_agregar(args, n)
        vec_agregar(args, a)
        tb_runtime(g, d, "dyn_crudo_repetir", args)
        retornar tb_mov(c, r, 0)
    }
    si (t == 36) {
        tb_lista_expr(g, __cargar64(e + 8), d)
        sea args = vec_nuevo()
        vec_agregar(args, r)
        si (__cargar64(e + 16) == 1) {
            tb_runtime(g, d, "dyn_crudo_en_sitio", args)           // rax = la misma lista (o una copia ya ordenada)
        } sino {
            tb_runtime(g, d, "dyn_crudo_copia", args)             // rax = copia (ya ordenada si es corta o de bytes)
        }
        tb_ordenar_nativo(g, d)
        retornar tb_mov(c, r, 0)
    }
    rt_panico("turbo: lista inesperada")
    retornar 0
}

// Ordena en el sitio la copia (cabecera en rax) con la rutina nativa; deja
// la cabecera en rax. Los registros de trabajo vivos se guardan.
funcion tb_ordenar_nativo(g, d) {
    sea c = __cargar64(g)
    sea i = 0
    mientras (i < d) {
        tb_empujar(c, tb_trabajo(i))
        i = i + 1
    }
    sea saltar = nueva_etiqueta(c)
    e1(c, 80)                                                      // push rax (cabecera)
    e1(c, 80)                                                      // argumento
    llamar_runtime(c, "dyn_crudo_temporal", 1)                     // rax = búfer o 0
    e3(c, 72, 133, 192)                                            // test rax, rax
    tb_jcc(c, 4, saltar)
    e4(c, 76, 139, 28, 36)                                         // mov r11, [rsp]
    e1(c, 80)                                                      // push rax (búfer)
    e4(c, 73, 139, 123, 16)                                        // mov rdi, [r11 + 16]
    e3(c, 73, 139, 51)                                             // mov rsi, [r11]
    e3(c, 72, 137, 194)                                            // mov rdx, rax
    e4(c, 72, 141, 12, 240)                                        // lea rcx, [rax + rsi·8]
    op_llamar(c, tb_rutina_radix(c))
    llamar_runtime(c, "mem_liberar", 1)                            // (el búfer ya está apilado)
    definir_etiqueta(c, saltar)
    e1(c, 88)                                                      // pop rax (cabecera)
    i = d - 1
    mientras (i >= 0) {
        tb_sacar(c, tb_trabajo(i))
        i = i - 1
    }
    retornar 0
}

// Radix LSD de 11 bits (los contadores caben en la caché L1) sobre
// x - mínimo (solo las pasadas que cubren el rango), en código nativo.
// Entrada: rdi = x, rsi = n, rdx = búfer de n palabras, rcx = 2048
// contadores. Conserva rbx y r12–r15. Se emite una
// vez por programa (por pasada), en la primera lista que se ordena.
funcion tb_rutina_radix(c) {
    si (__cargar64(c + 496) != 0) { retornar __cargar64(c + 496) }
    sea rutina = nueva_etiqueta(c)
    __guardar64(c + 496, rutina)
    sea saltar = nueva_etiqueta(c)
    op_saltar(c, saltar)
    tb_alinear(c)
    definir_etiqueta(c, rutina)
    sea l1 = nueva_etiqueta(c)
    sea l1f = nueva_etiqueta(c)
    sea rango_ok = nueva_etiqueta(c)
    sea pasada = nueva_etiqueta(c)
    sea hecho = nueva_etiqueta(c)
    sea l2 = nueva_etiqueta(c)
    sea l2f = nueva_etiqueta(c)
    sea l3 = nueva_etiqueta(c)
    sea l3f = nueva_etiqueta(c)
    sea l4 = nueva_etiqueta(c)
    sea l4f = nueva_etiqueta(c)
    sea fin = nueva_etiqueta(c)
    e1(c, 83) e2(c, 65, 84) e2(c, 65, 85) e2(c, 65, 86) e2(c, 65, 87)   // push rbx, r12–r15
    e3(c, 73, 137, 248)                                            // mov r8, rdi   (a)
    e3(c, 73, 137, 209)                                            // mov r9, rdx   (b)
    e3(c, 73, 137, 254)                                            // mov r14, rdi  (x)
    e3(c, 72, 137, 207)                                            // mov rdi, rcx  (contadores)
    // mínimo y máximo
    e3(c, 77, 139, 16)                                             // mov r10, [r8]
    e3(c, 77, 137, 211)                                            // mov r11, r10
    e1(c, 187) e32(c, 1)                                           // mov ebx, 1
    definir_etiqueta(c, l1)
    e3(c, 72, 57, 243)                                             // cmp rbx, rsi
    tb_jcc(c, 13, l1f)
    e4(c, 73, 139, 4, 216)                                         // mov rax, [r8 + rbx·8]
    e3(c, 76, 57, 208)                                             // cmp rax, r10
    e4(c, 76, 15, 76, 208)                                         // cmovl r10, rax
    e3(c, 76, 57, 216)                                             // cmp rax, r11
    e4(c, 76, 15, 79, 216)                                         // cmovg r11, rax
    e3(c, 72, 255, 195)                                            // inc rbx
    op_saltar(c, l1)
    definir_etiqueta(c, l1f)
    e3(c, 77, 41, 211)                                             // sub r11, r10 (rango)
    tb_jcc(c, 1, rango_ok)                                         // jno
    e2(c, 73, 186) e32(c, 0) e32(c, 0 - 2147483648)                // mov r10, -2^63 (clave = v con el signo invertido)
    e3(c, 73, 199, 195) e32(c, 0 - 1)                              // mov r11, -1
    definir_etiqueta(c, rango_ok)
    e2(c, 49, 201)                                                 // xor ecx, ecx
    definir_etiqueta(c, pasada)
    e3(c, 131, 249, 64)                                            // cmp ecx, 64
    tb_jcc(c, 13, hecho)
    e3(c, 76, 137, 216)                                            // mov rax, r11
    e3(c, 72, 211, 232)                                            // shr rax, cl
    e3(c, 72, 133, 192)                                            // test rax, rax
    tb_jcc(c, 4, hecho)
    e3(c, 73, 137, 205)                                            // mov r13, rcx
    e3(c, 73, 137, 252)                                            // mov r12, rdi
    e2(c, 49, 192)                                                 // xor eax, eax
    e1(c, 185) e32(c, 2048)                                        // mov ecx, 2048
    e3(c, 243, 72, 171)                                            // rep stosq
    e3(c, 76, 137, 231)                                            // mov rdi, r12
    e3(c, 76, 137, 233)                                            // mov rcx, r13
    // conteo
    e2(c, 49, 219)                                                 // xor ebx, ebx
    definir_etiqueta(c, l2)
    e3(c, 72, 57, 243)
    tb_jcc(c, 13, l2f)
    e4(c, 73, 139, 4, 216)                                         // mov rax, [r8 + rbx·8]
    e3(c, 76, 41, 208)                                             // sub rax, r10
    e3(c, 72, 211, 232)                                            // shr rax, cl
    e1(c, 37) e32(c, 2047)                                         // and eax, 2047
    e4(c, 72, 255, 4, 199)                                         // inc qword [rdi + rax·8]
    e3(c, 72, 255, 195)
    op_saltar(c, l2)
    definir_etiqueta(c, l2f)
    // sumas prefijas
    e2(c, 49, 219)                                                 // xor ebx, ebx
    e2(c, 49, 210)                                                 // xor edx, edx
    definir_etiqueta(c, l3)
    e3(c, 72, 129, 251) e32(c, 2048)                               // cmp rbx, 2048
    tb_jcc(c, 13, l3f)
    e4(c, 72, 139, 4, 223)                                         // mov rax, [rdi + rbx·8]
    e4(c, 72, 137, 20, 223)                                        // mov [rdi + rbx·8], rdx
    e3(c, 72, 1, 194)                                              // add rdx, rax
    e3(c, 72, 255, 195)
    op_saltar(c, l3)
    definir_etiqueta(c, l3f)
    // reparto (estable)
    e2(c, 49, 219)
    definir_etiqueta(c, l4)
    e3(c, 72, 57, 243)
    tb_jcc(c, 13, l4f)
    e4(c, 73, 139, 20, 216)                                        // mov rdx, [r8 + rbx·8]
    e3(c, 72, 137, 208)                                            // mov rax, rdx
    e3(c, 76, 41, 208)                                             // sub rax, r10
    e3(c, 72, 211, 232)                                            // shr rax, cl
    e1(c, 37) e32(c, 2047)                                         // and eax, 2047
    e4(c, 76, 139, 36, 199)                                        // mov r12, [rdi + rax·8]
    e4(c, 75, 137, 20, 225)                                        // mov [r9 + r12·8], rdx
    e3(c, 73, 255, 196)                                            // inc r12
    e4(c, 76, 137, 36, 199)                                        // mov [rdi + rax·8], r12
    e3(c, 72, 255, 195)
    op_saltar(c, l4)
    definir_etiqueta(c, l4f)
    e3(c, 77, 135, 200)                                            // xchg r8, r9
    e3(c, 131, 193, 11)                                            // add ecx, 11
    op_saltar(c, pasada)
    definir_etiqueta(c, hecho)
    e3(c, 77, 57, 240)                                             // cmp r8, r14
    tb_jcc(c, 4, fin)
    e3(c, 76, 137, 247)                                            // mov rdi, r14
    e3(c, 72, 137, 241)                                            // mov rcx, rsi
    e3(c, 76, 137, 198)                                            // mov rsi, r8
    e3(c, 243, 72, 165)                                            // rep movsq
    definir_etiqueta(c, fin)
    e2(c, 65, 95) e2(c, 65, 94) e2(c, 65, 93) e2(c, 65, 92) e1(c, 91)   // pop r15–r12, rbx
    e1(c, 195)                                                     // ret
    definir_etiqueta(c, saltar)
    retornar rutina
}

// Datos de la lista "nombre" en b, con el índice (registro i) comprobado.
funcion tb_datos_comprobados(g, nombre, i, b) {
    sea c = __cargar64(g)
    si (__cargar64(g + 168) != 0 y str_igual(__cargar64(g + 168), nombre)) {
        tb_memoria(c, 59, i, __cargar64(g + 184))                  // cmp i, [largo]
        tb_jcc(c, 3, __cargar64(g + 24))
        retornar 12                                                // datos en r12
    }
    tb_memoria(c, 139, b, tb_lista_desp(g, tb_lista_slot(g, nombre)))
    tb_carga_base(c, 0, b, 0)                                      // rax = largo
    tb_rr(c, 57, i, 0)                                             // cmp i, largo
    tb_jcc(c, 3, __cargar64(g + 24))                               // jae (también i < 0): repetir
    tb_carga_base(c, b, b, 16)                                     // datos
    retornar b
}

// l[i] (lectura) en el registro d.
funcion tb_indice(g, e, d) {
    sea c = __cargar64(g)
    sea r = tb_trabajo(d)
    sea b = tb_trabajo(d + 1)
    sea nombre = __cargar64(e + 8)
    sea ri = tb_fuente(g, __cargar64(e + 16), d)
    b = tb_datos_comprobados(g, nombre, ri, b)
    tb_elemento(c, 0, tb_lista_ancho(g, nombre), r, b, ri)
    retornar 0
}

// Si e es una variable que vive en un registro, ese registro (se usa como
// operando sin copiarlo); si no, -1.
funcion tb_operando(g, e) {
    si (__cargar64(e) == 7) { retornar __cargar64(e + 8) }
    si (__cargar64(e) != 2) { retornar 0 - 1 }
    sea k = tb_variable(g, __cargar64(e + 8))
    si (k < 4) { retornar tb_hogar(k) }
    retornar 0 - 1
}

// Fuente de un operando derecho: registro de la variable o el registro de
// trabajo d (evaluándolo ahí).
funcion tb_fuente(g, e, d) {
    sea r = tb_operando(g, e)
    si (r >= 0) { retornar r }
    tb_expr(g, e, d)
    retornar tb_trabajo(d)
}

funcion tb_expr(g, e, d) {
    sea c = __cargar64(g)
    sea r = tb_trabajo(d)
    sea t = __cargar64(e)
    si (t == 1) { retornar tb_inmediato(c, r, __cargar64(e + 8)) }
    si (t == 2) { retornar tb_cargar_var(c, r, tb_variable(g, __cargar64(e + 8))) }
    si (t == 7) { retornar tb_mov(c, r, __cargar64(e + 8)) }
    si (t == 32) { retornar tb_indice(g, e, d) }
    si (t == 35) {
        sea interior = __cargar64(e + 8)
        __guardar64(g + 136, 8)
        tb_lista_expr(g, interior, d)
        tb_carga_base(c, r, r, 0)                                  // largo
        retornar 0
    }
    si (t == 4) {
        tb_expr(g, __cargar64(e + 8), d)
        tb_rex(c, 0, r)
        e2(c, 247, 216 + __y_bits(r, 7))                          // neg
        tb_jcc(c, 0, __cargar64(g + 24))
        retornar 0
    }
    si (t == 6) { retornar tb_llamada(g, e, d) }
    // binaria
    sea op = __cargar64(e + 8)
    sea izq = __cargar64(e + 16)
    sea der = __cargar64(e + 24)
    tb_expr(g, izq, d)
    sea literal = __cargar64(der) == 1 y tb_cabe32(__cargar64(der + 8))
    si (op == 5) { retornar tb_resto(g, der, d, __cargar64(der) == 1 y (literal o potencia_de_dos(__cargar64(der + 8)) > 0)) }
    si (literal) {
        sea v = __cargar64(der + 8)
        si (op == 1) { tb_op_inm(c, 0, r, v) }
        si (op == 2) { tb_op_inm(c, 5, r, v) }
        si (op == 3) {
            tb_rex(c, r, r)
            e2(c, 105, 192 + __y_bits(r, 7) * 9)                  // imul r, r, imm32
            e32(c, v)
        }
    } sino {
        sea s = tb_fuente(g, der, d + 1)
        si (op == 1) { tb_rr(c, 1, r, s) }
        si (op == 2) { tb_rr(c, 41, r, s) }
        si (op == 3) { tb_imul(c, r, s) }
    }
    tb_jcc(c, 0, __cargar64(g + 24))                              // jo desborde
    retornar 0
}

// izq ya en el registro d; der: literal o expresión.
funcion tb_resto(g, der, d, literal) {
    sea c = __cargar64(g)
    sea r = tb_trabajo(d)
    si (literal) {
        sea v = __cargar64(der + 8)
        si (v < 0) { v = 0 - v }
        si (v == 0) {
            op_saltar(c, __cargar64(g + 32))
            retornar 0
        }
        si (v >= 3 y potencia_de_dos(v) < 0 y tb_cabe32(v)) {
            // Resto por constante: q = (mulhi(x, M) >> s) + (x < 0); r = x - q·v
            sea s = magia_corrimiento(v)
            sea m = magia_multiplicador(v, s)
            e2(c, 72, 184)                                         // mov rax, M
            e32(c, __y_bits(m, 4294967295))
            e32(c, __desplazar_der(m, 32))
            tb_rex(c, 0, r)
            e2(c, 247, 232 + __y_bits(r, 7))                       // imul r (rdx:rax = rax·r)
            si (s > 0) { e4(c, 72, 193, 250, s) }                 // sar rdx, s
            tb_mov(c, 0, r)
            e4(c, 72, 193, 248, 63)                                // sar rax, 63
            e3(c, 72, 41, 194)                                     // sub rdx, rax
            e3(c, 72, 105, 210)                                    // imul rdx, rdx, v
            e32(c, v)
            tb_rr(c, 41, r, 2)                                     // sub r, rdx
            retornar 0
        }
        si (v == 1) { retornar tb_inmediato(c, r, 0) }
        sea k = potencia_de_dos(v)
        si (k >= 1 y k <= 62) {
            // x % 2^k (signo del dividendo): t = (x >> 63) >>> (64 - k);
            // r = ((x + t) & (2^k - 1)) - t
            tb_mov(c, 0, r)
            e4(c, 72, 193, 248, 63)                                // sar rax, 63
            e4(c, 72, 193, 232, 64 - k)                            // shr rax, 64 - k
            tb_rr(c, 1, r, 0)                                      // add r, rax
            si (tb_cabe32(v - 1)) {
                tb_op_inm(c, 4, r, v - 1)                          // and r, máscara
            } sino {
                tb_inmediato(c, 2, v - 1)
                tb_rr(c, 33, r, 2)                                 // and r, rdx
            }
            tb_rr(c, 41, r, 0)                                     // sub r, rax
            retornar 0
        }
        tb_inmediato(c, tb_trabajo(d + 1), __cargar64(der + 8))
    } sino {
        tb_expr(g, der, d + 1)
    }
    sea s = tb_trabajo(d + 1)
    tb_rr(c, 133, s, s)                                            // test s, s
    tb_jcc(c, 4, __cargar64(g + 32))                               // jz div0
    sea normal = nueva_etiqueta(c)
    sea fin = nueva_etiqueta(c)
    tb_op_inm(c, 7, s, 0 - 1)                                      // cmp s, -1
    tb_jcc(c, 5, normal)
    tb_inmediato(c, r, 0)                                          // x % -1 = 0 (sin #DE)
    op_saltar(c, fin)
    definir_etiqueta(c, normal)
    tb_mov(c, 0, r)
    e2(c, 72, 153)                                                 // cqo
    tb_rex(c, 0, s)
    e2(c, 247, 248 + __y_bits(s, 7))                               // idiv s
    tb_mov(c, r, 2)
    definir_etiqueta(c, fin)
    retornar 0
}

// Caso base en línea: si la función empieza con si (guarda) { retornar E }
// (guarda y E solo con el parámetro y literales), en cada llamada a sí
// misma se prueba la guarda antes de llamar: las hojas de la recursión no
// llaman.
funcion tb_simple(e, nombre) {
    sea t = __cargar64(e)
    si (t == 1) { retornar 1 }
    si (t == 2) { retornar str_igual(__cargar64(e + 8), nombre) }
    si (t == 3) { retornar __cargar64(e + 8) != 5 y tb_simple(__cargar64(e + 16), nombre) y tb_simple(__cargar64(e + 24), nombre) }
    si (t == 4) { retornar tb_simple(__cargar64(e + 8), nombre) }
    retornar 0
}

funcion tb_guarda_simple(e, nombre) {
    sea t = __cargar64(e)
    si (t == 10) {
        // operandos: parámetro o literal (se comparan sin registros extra)
        sea a = __cargar64(e + 16)
        sea b = __cargar64(e + 24)
        retornar (__cargar64(a) == 1 o (__cargar64(a) == 2 y str_igual(__cargar64(a + 8), nombre))) y (__cargar64(b) == 1 o (__cargar64(b) == 2 y str_igual(__cargar64(b + 8), nombre)))
    }
    si (t == 11 o t == 12) { retornar tb_guarda_simple(__cargar64(e + 16), nombre) y tb_guarda_simple(__cargar64(e + 24), nombre) }
    si (t == 13) { retornar tb_guarda_simple(__cargar64(e + 16), nombre) }
    retornar 0
}

// Copia de e con el parámetro cambiado por el registro r (nodo 7).
funcion tb_sustituir(e, nombre, r) {
    sea t = __cargar64(e)
    si (t == 2 y str_igual(__cargar64(e + 8), nombre)) { retornar tb_nodo(7, r, 0, 0) }
    si (t == 3 o t == 10 o t == 11 o t == 12) { retornar tb_nodo(t, __cargar64(e + 8), tb_sustituir(__cargar64(e + 16), nombre, r), tb_sustituir(__cargar64(e + 24), nombre, r)) }
    si (t == 13) { retornar tb_nodo(13, 0, tb_sustituir(__cargar64(e + 16), nombre, r), 0) }
    si (t == 4) { retornar tb_nodo(4, tb_sustituir(__cargar64(e + 8), nombre, r), 0, 0) }
    si (t == 6) {
        sea args = __cargar64(e + 16)
        sea nuevos = vec_nuevo()
        sea i = 0
        mientras (i < vec_largo(args)) {
            vec_agregar(nuevos, tb_sustituir(vec_obtener(args, i), nombre, r))
            i = i + 1
        }
        retornar tb_nodo(6, __cargar64(e + 8), nuevos, 0)
    }
    retornar e
}

funcion tb_llamada(g, e, d) {
    sea c = __cargar64(g)
    sea destino = tb_buscar(tb_tabla(c), __cargar64(e + 8))
    sea args = __cargar64(e + 16)
    sea guarda = __cargar64(g + 104)
    si (guarda != 0 y vec_largo(args) == 1 y str_igual(__cargar64(e + 8), __cargar64(g + 72)) y d < 6) {
        sea param = vec_obtener(__cargar64(g + 8), 0)
        sea r = tb_trabajo(d)
        tb_expr(g, vec_obtener(args, 0), d)
        sea llamar = nueva_etiqueta(c)
        sea fin = nueva_etiqueta(c)
        tb_cond(g, tb_sustituir(__cargar64(guarda + 8), param, r), llamar, 0)
        tb_expr(g, tb_sustituir(__cargar64(vec_obtener(__cargar64(guarda + 16), 0) + 8), param, r), d)
        op_saltar(c, fin)
        definir_etiqueta(c, llamar)
        sea j = 0
        mientras (j < d) {
            tb_empujar(c, tb_trabajo(j))
            j = j + 1
        }
        tb_mov(c, tb_argumento(0), r)
        op_llamar(c, __cargar64(destino + 16))
        tb_jcc(c, 2, __cargar64(g + 24))                           // jc: repetir con la dinámica
        tb_mov(c, r, 0)
        j = d - 1
        mientras (j >= 0) {
            tb_sacar(c, tb_trabajo(j))
            j = j - 1
        }
        definir_etiqueta(c, fin)
        retornar 0
    }
    sea i = 0
    mientras (i < d) {
        tb_empujar(c, tb_trabajo(i))
        i = i + 1
    }
    si (vec_largo(args) == 1) {
        tb_expr(g, vec_obtener(args, 0), d)
        tb_mov(c, tb_argumento(0), tb_trabajo(d))
    } sino {
        i = 0
        mientras (i < vec_largo(args)) {
            tb_expr(g, vec_obtener(args, i), d)
            tb_empujar(c, tb_trabajo(d))
            i = i + 1
        }
        i = vec_largo(args) - 1
        mientras (i >= 0) {
            tb_sacar(c, tb_argumento(i))
            i = i - 1
        }
    }
    op_llamar(c, __cargar64(destino + 16))
    tb_jcc(c, 2, __cargar64(g + 24))                               // jc: repetir con la dinámica
    tb_mov(c, tb_trabajo(d), 0)
    i = d - 1
    mientras (i >= 0) {
        tb_sacar(c, tb_trabajo(i))
        i = i - 1
    }
    retornar 0
}

// Salta a etiqueta si la condición vale "sentido" (1 verdadero, 0 falso).
funcion tb_cond(g, e, etiqueta, sentido) {
    sea c = __cargar64(g)
    sea t = __cargar64(e)
    si (t == 13) { retornar tb_cond(g, __cargar64(e + 16), etiqueta, 1 - sentido) }
    si (t == 11 o t == 12) {
        // y: salta si ambas (sentido 1) o si alguna falla (sentido 0); o al revés
        sea corto = (t == 11 y sentido == 0) o (t == 12 y sentido == 1)
        si (corto) {
            tb_cond(g, __cargar64(e + 16), etiqueta, sentido)
            tb_cond(g, __cargar64(e + 24), etiqueta, sentido)
        } sino {
            sea seguir = nueva_etiqueta(c)
            tb_cond(g, __cargar64(e + 16), seguir, 1 - sentido)
            tb_cond(g, __cargar64(e + 24), etiqueta, sentido)
            definir_etiqueta(c, seguir)
        }
        retornar 0
    }
    // comparación
    sea cc = __cargar64(e + 8)
    sea izq = __cargar64(e + 16)
    sea der = __cargar64(e + 24)
    sea a = tb_fuente(g, izq, 0)
    si (__cargar64(der) == 1 y tb_cabe32(__cargar64(der + 8))) {
        tb_op_inm(c, 7, a, __cargar64(der + 8))
    } sino {
        tb_rr(c, 57, a, tb_fuente(g, der, 1))
    }
    si (sentido == 0) { cc = __xo_bits(cc, 1) }
    tb_jcc(c, cc, etiqueta)
    retornar 0
}

funcion tb_bloque_gen(g, v) {
    sea nombres = __cargar64(g + 8)
    sea marca = vec_largo(nombres)
    sea i = 0
    mientras (i < vec_largo(v)) {
        tb_sentencia_gen(g, vec_obtener(v, i))
        i = i + 1
    }
    __guardar64(nombres, marca)
    retornar 0
}

funcion tb_sentencia_gen(g, s) {
    sea c = __cargar64(g)
    sea t = __cargar64(s)
    si (t == 20 y tb_clase_gen(g, __cargar64(s + 16)) == 2) {
        sea nombre = __cargar64(s + 8)
        sea inicial = __cargar64(s + 16)
        sea k = __cargar64(inicial)
        sea ancho = 8
        si (k == 36) { ancho = tb_ancho_expr(g, inicial) }
        si (k == 30 y tb_escrituras_byte(__cargar64(g + 144), nombre)) { ancho = 1 }
        si (k == 31 y tb_es_byte(__cargar64(inicial + 8)) y tb_escrituras_byte(__cargar64(g + 144), nombre)) { ancho = 1 }
        __guardar64(g + 136, ancho)
        tb_lista_expr(g, inicial, 0)
        vec_agregar(__cargar64(g + 120), nombre)
        vec_agregar(__cargar64(g + 128), ancho)
        tb_memoria(c, 137, tb_trabajo(0), tb_lista_desp(g, vec_largo(__cargar64(g + 120)) - 1))
        retornar 0
    }
    si (t == 33) {
        sea v = tb_trabajo(0)
        sea i = tb_trabajo(1)
        sea b = tb_trabajo(2)
        sea nombre = __cargar64(s + 8)
        sea ancho = tb_lista_ancho(g, nombre)
        sea valor = __cargar64(s + 24)
        sea inmediato = __cargar64(valor) == 1 y tb_cabe32(__cargar64(valor + 8))
        si (inmediato == 0) { v = tb_fuente(g, valor, 0) }
        i = tb_fuente(g, __cargar64(s + 16), 1)
        b = tb_datos_comprobados(g, nombre, i, b)
        si (inmediato) {
            tb_elemento_inm(c, ancho, b, i, __cargar64(valor + 8))
            retornar 0
        }
        tb_elemento(c, 1, ancho, v, b, i)                          // datos[i] = v
        retornar 0
    }
    si (t == 34) {
        sea v = tb_trabajo(0)
        sea h = tb_trabajo(1)
        sea b = tb_trabajo(2)
        sea nombre = __cargar64(s + 8)
        sea otra_vez = nueva_etiqueta(c)
        sea lento = nueva_etiqueta(c)
        sea fin = nueva_etiqueta(c)
        tb_expr(g, __cargar64(s + 16), 0)
        definir_etiqueta(c, otra_vez)
        tb_memoria(c, 139, h, tb_lista_desp(g, tb_lista_slot(g, nombre)))
        tb_carga_base(c, 0, h, 0)                                  // rax = largo
        tb_carga_base(c, b, h, 8)                                  // capacidad
        tb_rr(c, 57, 0, b)
        tb_jcc(c, 3, lento)
        tb_carga_base(c, b, h, 16)
        tb_elemento(c, 1, tb_lista_ancho(g, nombre), v, b, 0)      // datos[largo] = v
        tb_op_inm(c, 0, 0, 1)
        tb_guarda_base(c, h, 0, 0)                                 // largo + 1
        op_saltar(c, fin)
        definir_etiqueta(c, lento)
        sea args = vec_nuevo()
        vec_agregar(args, h)
        tb_runtime(g, 1, "dyn_crudo_crecer", args)
        op_saltar(c, otra_vez)
        definir_etiqueta(c, fin)
        retornar 0
    }
    si (t == 20) {
        tb_expr(g, __cargar64(s + 16), 0)
        sea nombres = __cargar64(g + 8)
        vec_agregar(nombres, __cargar64(s + 8))
        tb_guardar_var(c, tb_variable(g, __cargar64(s + 8)), tb_trabajo(0))
        retornar 0
    }
    si (t == 21) {
        sea k = tb_variable(g, __cargar64(s + 8))
        sea e = __cargar64(s + 16)
        // x = x + k / x = x - k con x en registro: una sola instrucción
        si (k < 4 y __cargar64(e) == 3 y (__cargar64(e + 8) == 1 o __cargar64(e + 8) == 2) y __cargar64(__cargar64(e + 16)) == 2 y str_igual(__cargar64(__cargar64(e + 16) + 8), __cargar64(s + 8)) y __cargar64(__cargar64(e + 24)) == 1 y tb_cabe32(__cargar64(__cargar64(e + 24) + 8))) {
            sea ext = 0
            si (__cargar64(e + 8) == 2) { ext = 5 }
            tb_op_inm(c, ext, tb_hogar(k), __cargar64(__cargar64(e + 24) + 8))
            tb_jcc(c, 0, __cargar64(g + 24))
            retornar 0
        }
        // x = x + E / x - E / x * E con x en registro: se opera en el sitio.
        si (k < 4 y __cargar64(e) == 3 y __cargar64(e + 8) != 5 y __cargar64(__cargar64(e + 16)) == 2 y str_igual(__cargar64(__cargar64(e + 16) + 8), __cargar64(s + 8)) y tb_usa(__cargar64(e + 24), __cargar64(s + 8)) == 0) {
            sea h = tb_hogar(k)
            sea fuente = tb_fuente(g, __cargar64(e + 24), 0)
            sea op = __cargar64(e + 8)
            si (op == 1) { tb_rr(c, 1, h, fuente) }
            si (op == 2) { tb_rr(c, 41, h, fuente) }
            si (op == 3) { tb_imul(c, h, fuente) }
            tb_jcc(c, 0, __cargar64(g + 24))
            retornar 0
        }
        tb_expr(g, e, 0)
        tb_guardar_var(c, k, tb_trabajo(0))
        retornar 0
    }
    si (t == 22) {
        sea otro = nueva_etiqueta(c)
        tb_cond(g, __cargar64(s + 8), otro, 0)
        tb_bloque_gen(g, __cargar64(s + 16))
        si (__cargar64(s + 24) != 0) {
            sea fin = nueva_etiqueta(c)
            op_saltar(c, fin)
            definir_etiqueta(c, otro)
            tb_bloque_gen(g, __cargar64(s + 24))
            definir_etiqueta(c, fin)
        } sino {
            definir_etiqueta(c, otro)
        }
        retornar 0
    }
    si (t == 23) {
        // mientras rotado: el salto de vuelta lleva la condición.
        sea cuerpo = nueva_etiqueta(c)
        sea prueba = nueva_etiqueta(c)
        sea fin = nueva_etiqueta(c)
        sea bucles = __cargar64(g + 40)
        vec_agregar(bucles, prueba)
        vec_agregar(bucles, fin)
        // La lista más usada del ciclo, si este la deja quieta: datos en r12
        // y largo en el marco, cargados una vez.
        sea fijada = 0
        si (__cargar64(g + 176) != 0 y __cargar64(g + 168) == 0 y tb_llama_expr(__cargar64(s + 8)) == 0 y tb_listas_quietas(__cargar64(s + 16))) {
            sea listas = __cargar64(g + 120)
            sea mejor = 0
            sea j = 0
            mientras (j < vec_largo(listas)) {
                sea nombre = vec_obtener(listas, j)
                sea k = tb_contar_accesos(__cargar64(s + 16), nombre) + tb_contar_accesos_expr(__cargar64(s + 8), nombre)
                si (k > mejor) {
                    mejor = k
                    fijada = nombre
                }
                j = j + 1
            }
        }
        tb_llenar_ciclo(g, s, fin)
        tb_reservar_ciclo(g, s)
        si (fijada != 0) {
            tb_memoria(c, 139, 0, tb_lista_desp(g, tb_lista_slot(g, fijada)))
            tb_carga_base(c, 12, 0, 16)                              // r12 = datos
            tb_carga_base(c, 0, 0, 0)
            tb_memoria(c, 137, 0, __cargar64(g + 184))               // largo al marco
            __guardar64(g + 168, fijada)
        }
        op_saltar(c, prueba)
        tb_alinear(c)
        definir_etiqueta(c, cuerpo)
        tb_bloque_gen(g, __cargar64(s + 16))
        definir_etiqueta(c, prueba)
        tb_cond(g, __cargar64(s + 8), cuerpo, 1)
        definir_etiqueta(c, fin)
        vec_quitar_ultimo(bucles)
        vec_quitar_ultimo(bucles)
        si (fijada != 0) { __guardar64(g + 168, 0) }
        retornar 0
    }
    si (t == 24) {
        sea e = __cargar64(s + 8)
        si (__cargar64(g + 64) != 0) { retornar tb_retornar_cola(g, e) }
        tb_marcar_en_sitio(g, e, e)
        tb_expr(g, e, 0)
        tb_mov(c, 0, tb_trabajo(0))
        op_saltar(c, __cargar64(g + 56))
        retornar 0
    }
    si (t == 25 o t == 26) {
        sea bucles = __cargar64(g + 40)
        si (vec_largo(bucles) == 0) { rt_panico("turbo: romper/continuar fuera de un ciclo") }
        si (t == 25) { op_saltar(c, vec_obtener(bucles, vec_largo(bucles) - 1)) }
        si (t == 26) { op_saltar(c, vec_obtener(bucles, vec_largo(bucles) - 2)) }
        retornar 0
    }
    si (t == 27) { retornar tb_expr(g, __cargar64(s + 8), 0) }
    retornar 0
}

// ── Recursión de cola con acumulador ──────────────────────────────────
// retornar T + f(args) (f la misma función) → acum += T; params = args; y
// se vuelve al comienzo sin llamar. retornar E → retornar acum + E. Así
// fib(n-1) + fib(n-2) hace la mitad de las llamadas. La suma se reordena,
// pero si algo se sale de i64 se repite con la forma normal: el resultado
// es el mismo.

// Términos de una suma (a + b + c …) en v.
funcion tb_terminos(e, v) {
    si (__cargar64(e) == 3 y __cargar64(e + 8) == 1) {
        tb_terminos(__cargar64(e + 16), v)
        tb_terminos(__cargar64(e + 24), v)
        retornar v
    }
    vec_agregar(v, e)
    retornar v
}

// Índice del último término que es una llamada a la propia función, o -1.
funcion tb_termino_cola(g, terminos) {
    sea i = vec_largo(terminos) - 1
    mientras (i >= 0) {
        sea e = vec_obtener(terminos, i)
        si (__cargar64(e) == 6 y str_igual(__cargar64(e + 8), __cargar64(g + 72)) y vec_largo(__cargar64(e + 16)) == __cargar64(g + 80)) { retornar i }
        i = i - 1
    }
    retornar 0 - 1
}

funcion tb_tiene_cola(g, v) {
    sea i = 0
    mientras (i < vec_largo(v)) {
        sea s = vec_obtener(v, i)
        sea t = __cargar64(s)
        si (t == 24 y tb_termino_cola(g, tb_terminos(__cargar64(s + 8), vec_nuevo())) >= 0) { retornar 1 }
        si (t == 22) {
            si (tb_tiene_cola(g, __cargar64(s + 16))) { retornar 1 }
            si (__cargar64(s + 24) != 0 y tb_tiene_cola(g, __cargar64(s + 24))) { retornar 1 }
        }
        si (t == 23 y tb_tiene_cola(g, __cargar64(s + 16))) { retornar 1 }
        i = i + 1
    }
    retornar 0
}

funcion tb_contar_vuelta(g) {
    sea c = __cargar64(g)
    sea vueltas = tb_variable(g, "  vueltas")
    tb_cargar_var(c, tb_trabajo(0), vueltas)
    tb_op_inm(c, 0, tb_trabajo(0), 1)
    tb_guardar_var(c, vueltas, tb_trabajo(0))
    tb_op_inm(c, 7, tb_trabajo(0), 10000)
    tb_jcc(c, 15, __cargar64(g + 24))                              // jg: repetir
    retornar 0
}

// acum += fuente
funcion tb_sumar_acumulador(g, fuente) {
    sea c = __cargar64(g)
    sea acum = __cargar64(g + 88)
    si (acum < 4) {
        tb_rr(c, 1, tb_hogar(acum), fuente)
        tb_jcc(c, 0, __cargar64(g + 24))
        retornar 0
    }
    tb_cargar_var(c, tb_trabajo(1), acum)
    tb_rr(c, 1, tb_trabajo(1), fuente)
    tb_jcc(c, 0, __cargar64(g + 24))
    tb_guardar_var(c, acum, tb_trabajo(1))
    retornar 0
}

// acum += f(arg) sin llamar: el cuerpo de f con su parámetro en el hogar
// "  interior" (guarda, términos al acumulador y el de cola como ciclo).
funcion tb_en_linea(g, llamada) {
    sea c = __cargar64(g)
    sea param = vec_obtener(__cargar64(g + 160), 0)
    sea rm = tb_hogar(tb_variable(g, "  interior"))
    sea guarda = __cargar64(g + 104)
    sea ret = __cargar64(vec_obtener(__cargar64(g + 144), 1) + 8)
    tb_expr(g, vec_obtener(__cargar64(llamada + 16), 0), 0)
    tb_mov(c, rm, tb_trabajo(0))
    sea ciclo = nueva_etiqueta(c)
    sea sigue = nueva_etiqueta(c)
    sea hecho = nueva_etiqueta(c)
    definir_etiqueta(c, ciclo)
    tb_cond(g, tb_sustituir(__cargar64(guarda + 8), param, rm), sigue, 0)
    tb_sumar_acumulador(g, tb_fuente(g, tb_sustituir(__cargar64(vec_obtener(__cargar64(guarda + 16), 0) + 8), param, rm), 0))
    op_saltar(c, hecho)
    definir_etiqueta(c, sigue)
    tb_contar_vuelta(g)
    sea terminos = tb_terminos(tb_sustituir(ret, param, rm), vec_nuevo())
    sea k = tb_termino_cola(g, terminos)
    sea i = 0
    mientras (i < vec_largo(terminos)) {
        si (i != k) { tb_sumar_acumulador(g, tb_fuente(g, vec_obtener(terminos, i), 0)) }
        i = i + 1
    }
    tb_expr(g, vec_obtener(__cargar64(vec_obtener(terminos, k) + 16), 0), 0)
    tb_mov(c, rm, tb_trabajo(0))
    op_saltar(c, ciclo)
    definir_etiqueta(c, hecho)
    retornar 0
}

funcion tb_retornar_cola(g, e) {
    sea c = __cargar64(g)
    sea acum = __cargar64(g + 88)                                   // índice de la variable
    sea terminos = tb_terminos(e, vec_nuevo())
    sea k = tb_termino_cola(g, terminos)
    si (k < 0) {
        // retornar acum + E (rax = acum; rax += E)
        sea fuente = tb_fuente(g, e, 0)
        tb_cargar_var(c, 0, acum)
        tb_rr(c, 1, 0, fuente)
        tb_jcc(c, 0, __cargar64(g + 24))
        op_saltar(c, __cargar64(g + 56))
        retornar 0
    }
    // acum += resto de los términos
    sea i = 0
    mientras (i < vec_largo(terminos)) {
        sea termino = vec_obtener(terminos, i)
        si (i != k y __cargar64(g + 192) != 0 y __cargar64(termino) == 6 y str_igual(__cargar64(termino + 8), __cargar64(g + 72)) y vec_largo(__cargar64(termino + 16)) == 1) {
            tb_en_linea(g, termino)
        } sino si (i != k) {
            sea fuente = tb_fuente(g, termino, 0)
            si (acum < 4) {
                tb_rr(c, 1, tb_hogar(acum), fuente)
                tb_jcc(c, 0, __cargar64(g + 24))
            } sino {
                tb_cargar_var(c, tb_trabajo(1), acum)
                tb_rr(c, 1, tb_trabajo(1), fuente)
                tb_jcc(c, 0, __cargar64(g + 24))
                tb_guardar_var(c, acum, tb_trabajo(1))
            }
        }
        i = i + 1
    }
    // nuevos argumentos: todos se evalúan antes de asignar
    sea args = __cargar64(vec_obtener(terminos, k) + 16)
    si (vec_largo(args) == 1) {
        sea a0 = vec_obtener(args, 0)
        // n = n ± k con n en registro: en el sitio
        si (__cargar64(a0) == 3 y (__cargar64(a0 + 8) == 1 o __cargar64(a0 + 8) == 2) y __cargar64(__cargar64(a0 + 16)) == 2 y str_igual(__cargar64(__cargar64(a0 + 16) + 8), vec_obtener(__cargar64(g + 160), 0)) y tb_variable(g, vec_obtener(__cargar64(g + 160), 0)) < 4 y __cargar64(__cargar64(a0 + 24)) == 1 y tb_cabe32(__cargar64(__cargar64(a0 + 24) + 8))) {
            sea ext = 0
            si (__cargar64(a0 + 8) == 2) { ext = 5 }
            tb_op_inm(c, ext, tb_hogar(tb_variable(g, vec_obtener(__cargar64(g + 160), 0))), __cargar64(__cargar64(a0 + 24) + 8))
            tb_jcc(c, 0, __cargar64(g + 24))
            op_saltar(c, __cargar64(g + 96))
            retornar 0
        }
    }
    i = 0
    mientras (i < vec_largo(args)) {
        tb_expr(g, vec_obtener(args, i), i)
        i = i + 1
    }
    i = 0
    mientras (i < vec_largo(args)) {
        tb_guardar_var(c, tb_variable(g, vec_obtener(__cargar64(g + 160), i)), tb_trabajo(i))
        i = i + 1
    }
    op_saltar(c, __cargar64(g + 96))
    retornar 0
}

// ¿La expresión menciona la variable? (Si x = x + f(x)… se evalúa aparte.)
funcion tb_usa(e, nombre) {
    sea t = __cargar64(e)
    si (t == 2) { retornar str_igual(__cargar64(e + 8), nombre) }
    si (t == 3) { retornar tb_usa(__cargar64(e + 16), nombre) o tb_usa(__cargar64(e + 24), nombre) }
    si (t == 4) { retornar tb_usa(__cargar64(e + 8), nombre) }
    si (t == 32) { retornar tb_usa(__cargar64(e + 16), nombre) }
    si (t == 30 o t == 31 o t == 35 o t == 36) { retornar 1 }
    si (t == 6) {
        // una llamada puede desbordar y repetir: el valor de x no debe cambiar antes
        retornar 1
    }
    retornar 0
}

funcion tb_hay_listas(v) {
    sea i = 0
    mientras (i < vec_largo(v)) {
        sea s = vec_obtener(v, i)
        sea t = __cargar64(s)
        si (t == 20) {
            sea k = __cargar64(__cargar64(s + 16))
            si (k == 30 o k == 31 o k == 36) { retornar 1 }
        }
        si (t == 22) {
            si (tb_hay_listas(__cargar64(s + 16))) { retornar 1 }
            si (__cargar64(s + 24) != 0 y tb_hay_listas(__cargar64(s + 24))) { retornar 1 }
        }
        si (t == 23 y tb_hay_listas(__cargar64(s + 16))) { retornar 1 }
        i = i + 1
    }
    retornar 0
}

// mientras (i < E) / (i <= E) con "i += 1" y "l.agregar(…)" en el cuerpo
// (sin si de por medio): se reserva de una vez lo que el ciclo va a
// agregar, como Vec::with_capacity. Si el ciclo sale antes, sobra
// capacidad; nada más cambia.
funcion tb_reservar_ciclo(g, s) {
    sea c = __cargar64(g)
    sea cond = __cargar64(s + 8)
    si (__cargar64(cond) != 10) { retornar 0 }
    sea cc = __cargar64(cond + 8)
    si (cc != 12 y cc != 14) { retornar 0 }
    sea izq = __cargar64(cond + 16)
    sea der = __cargar64(cond + 24)
    si (__cargar64(izq) != 2) { retornar 0 }
    sea i = __cargar64(izq + 8)
    si (__cargar64(der) != 1 y __cargar64(der) != 2) { retornar 0 }
    si (tb_es_lista_gen(g, i)) { retornar 0 }
    si (__cargar64(der) == 2 y tb_es_lista_gen(g, __cargar64(der + 8))) { retornar 0 }
    sea cuerpo = __cargar64(s + 16)
    sea paso = 0
    sea lista = 0
    sea veces = 0
    sea k = 0
    mientras (k < vec_largo(cuerpo)) {
        sea st = vec_obtener(cuerpo, k)
        sea t = __cargar64(st)
        si (t == 21 y str_igual(__cargar64(st + 8), i)) {
            sea e = __cargar64(st + 16)
            si (__cargar64(e) == 3 y __cargar64(e + 8) == 1 y __cargar64(__cargar64(e + 16)) == 2 y str_igual(__cargar64(__cargar64(e + 16) + 8), i) y __cargar64(__cargar64(e + 24)) == 1 y __cargar64(__cargar64(e + 24) + 8) == 1) { paso = paso + 1 } sino { retornar 0 }
        }
        si (t == 34) {
            si (lista != 0 y str_igual(lista, __cargar64(st + 8)) == 0) { retornar 0 }
            lista = __cargar64(st + 8)
            veces = veces + 1
        }
        si (t == 21 y __cargar64(der) == 2 y str_igual(__cargar64(st + 8), __cargar64(der + 8))) { retornar 0 }
        k = k + 1
    }
    si (paso != 1 o lista == 0) { retornar 0 }
    // rax = E - i (+1 si <=), ya multiplicado por las veces
    sea fuera = nueva_etiqueta(c)
    sea r = tb_trabajo(0)
    tb_expr(g, der, 0)
    tb_rr(c, 41, r, tb_fuente(g, izq, 1))                          // sub r, i
    tb_jcc(c, 0, fuera)
    si (cc == 14) {
        tb_op_inm(c, 0, r, 1)
        tb_jcc(c, 0, fuera)
    }
    tb_op_inm(c, 7, r, 0)
    tb_jcc(c, 14, fuera)                                           // jle: nada que reservar
    tb_op_inm(c, 7, r, 67108864)
    tb_jcc(c, 15, fuera)                                           // jg: demasiado; que crezca sola
    si (veces > 1) {
        tb_inmediato(c, tb_trabajo(1), veces)
        tb_imul(c, r, tb_trabajo(1))
    }
    sea h = tb_trabajo(1)
    tb_memoria(c, 139, h, tb_lista_desp(g, tb_lista_slot(g, lista)))
    sea args = vec_nuevo()
    vec_agregar(args, h)
    vec_agregar(args, r)
    tb_runtime(g, 0, "dyn_crudo_reservar", args)
    definir_etiqueta(c, fuera)
    retornar 0
}

// En "retornar …" las listas locales mueren: ordenar(l) puede ordenar l
// en su sitio si l no aparece en otra parte de la expresión.
funcion tb_menciones(e, nombre) {
    sea t = __cargar64(e)
    si (t == 2) { retornar str_igual(__cargar64(e + 8), nombre) }
    si (t == 32) { retornar str_igual(__cargar64(e + 8), nombre) + tb_menciones(__cargar64(e + 16), nombre) }
    si (t == 3 o t == 10 o t == 11 o t == 12) { retornar tb_menciones(__cargar64(e + 16), nombre) + tb_menciones(__cargar64(e + 24), nombre) }
    si (t == 13) { retornar tb_menciones(__cargar64(e + 16), nombre) }
    si (t == 4 o t == 35 o t == 36) { retornar tb_menciones(__cargar64(e + 8), nombre) }
    si (t == 31) { retornar tb_menciones(__cargar64(e + 8), nombre) + tb_menciones(__cargar64(e + 16), nombre) }
    si (t == 6) {
        sea args = __cargar64(e + 16)
        sea n = 0
        sea i = 0
        mientras (i < vec_largo(args)) {
            n = n + tb_menciones(vec_obtener(args, i), nombre)
            i = i + 1
        }
        retornar n
    }
    retornar 0
}

funcion tb_marcar_en_sitio(g, raiz, e) {
    sea t = __cargar64(e)
    si (t == 36) {
        sea x = __cargar64(e + 8)
        si (__cargar64(x) == 2 y tb_menciones(raiz, __cargar64(x + 8)) == 1) { __guardar64(e + 16, 1) }
        retornar tb_marcar_en_sitio(g, raiz, x)
    }
    si (t == 3 o t == 10 o t == 11 o t == 12) {
        tb_marcar_en_sitio(g, raiz, __cargar64(e + 16))
        retornar tb_marcar_en_sitio(g, raiz, __cargar64(e + 24))
    }
    si (t == 13) { retornar tb_marcar_en_sitio(g, raiz, __cargar64(e + 16)) }
    si (t == 4 o t == 35) { retornar tb_marcar_en_sitio(g, raiz, __cargar64(e + 8)) }
    si (t == 32) { retornar tb_marcar_en_sitio(g, raiz, __cargar64(e + 16)) }
    retornar 0
}

// mientras (i < E) { l.agregar(K) i += 1 } con K constante: se llena de
// una vez (como vec![K; n]) y se salta a fin con i ya en su valor final.
// Si la cuenta es <= 0 o muy grande, sigue el ciclo normal.
funcion tb_llenar_ciclo(g, s, fin) {
    sea c = __cargar64(g)
    sea cuerpo = __cargar64(s + 16)
    si (vec_largo(cuerpo) != 2) { retornar 0 }
    sea ag = vec_obtener(cuerpo, 0)
    sea inc = vec_obtener(cuerpo, 1)
    si (__cargar64(ag) != 34 o __cargar64(inc) != 21) { retornar 0 }
    sea valor = __cargar64(ag + 16)
    si (__cargar64(valor) != 1 o tb_cabe32(__cargar64(valor + 8)) == 0) { retornar 0 }
    sea cond = __cargar64(s + 8)
    si (__cargar64(cond) != 10) { retornar 0 }
    sea cc = __cargar64(cond + 8)
    si (cc != 12 y cc != 14) { retornar 0 }
    sea izq = __cargar64(cond + 16)
    sea der = __cargar64(cond + 24)
    si (__cargar64(izq) != 2 o (__cargar64(der) != 1 y __cargar64(der) != 2)) { retornar 0 }
    sea i = __cargar64(izq + 8)
    si (tb_es_lista_gen(g, i) o (__cargar64(der) == 2 y tb_es_lista_gen(g, __cargar64(der + 8)))) { retornar 0 }
    si (__cargar64(der) == 2 y str_igual(__cargar64(der + 8), i)) { retornar 0 }
    si (str_igual(__cargar64(inc + 8), i) == 0) { retornar 0 }
    sea e = __cargar64(inc + 16)
    si ((__cargar64(e) == 3 y __cargar64(e + 8) == 1 y __cargar64(__cargar64(e + 16)) == 2 y str_igual(__cargar64(__cargar64(e + 16) + 8), i) y __cargar64(__cargar64(e + 24)) == 1 y __cargar64(__cargar64(e + 24) + 8) == 1) == 0) { retornar 0 }
    sea normal = nueva_etiqueta(c)
    sea r = tb_trabajo(0)
    tb_expr(g, der, 0)
    tb_rr(c, 41, r, tb_fuente(g, izq, 1))                          // r = E - i
    tb_jcc(c, 0, normal)
    si (cc == 14) {
        tb_op_inm(c, 0, r, 1)
        tb_jcc(c, 0, normal)
    }
    tb_op_inm(c, 7, r, 0)
    tb_jcc(c, 14, normal)
    tb_op_inm(c, 7, r, 67108864)
    tb_jcc(c, 15, normal)
    sea h = tb_trabajo(1)
    sea v = tb_trabajo(2)
    tb_memoria(c, 139, h, tb_lista_desp(g, tb_lista_slot(g, __cargar64(ag + 8))))
    tb_inmediato(c, v, __cargar64(valor + 8))
    sea args = vec_nuevo()
    vec_agregar(args, h)
    vec_agregar(args, v)
    vec_agregar(args, r)
    tb_runtime(g, 1, "dyn_crudo_llenar", args)                     // conserva r
    // i = i + cuenta
    sea k = tb_variable(g, i)
    tb_cargar_var(c, tb_trabajo(1), k)
    tb_rr(c, 1, tb_trabajo(1), r)
    tb_guardar_var(c, k, tb_trabajo(1))
    op_saltar(c, fin)
    definir_etiqueta(c, normal)
    retornar 1
}

funcion tb_es_lista_gen(g, nombre) { retornar tb_declarada(__cargar64(g + 120), nombre) }

// ¿La expresión llama a algo (función o runtime)?
funcion tb_llama_expr(e) {
    sea t = __cargar64(e)
    si (t == 6 o t == 30 o t == 31 o t == 36) { retornar 1 }
    si (t == 3 o t == 10 o t == 11 o t == 12) { retornar tb_llama_expr(__cargar64(e + 16)) o tb_llama_expr(__cargar64(e + 24)) }
    si (t == 13) { retornar tb_llama_expr(__cargar64(e + 16)) }
    si (t == 4 o t == 35) { retornar tb_llama_expr(__cargar64(e + 8)) }
    si (t == 32) { retornar tb_llama_expr(__cargar64(e + 16)) }
    retornar 0
}

// ¿El bloque deja quietas las listas (sin agregar, sin listas nuevas y sin
// llamadas)? Entonces sus datos y su largo se pueden tener a mano.
funcion tb_listas_quietas(v) {
    sea i = 0
    mientras (i < vec_largo(v)) {
        sea s = vec_obtener(v, i)
        sea t = __cargar64(s)
        si (t == 34) { retornar 0 }
        si ((t == 20 o t == 21) y tb_llama_expr(__cargar64(s + 16))) { retornar 0 }
        si ((t == 24 o t == 27) y tb_llama_expr(__cargar64(s + 8))) { retornar 0 }
        si (t == 22) {
            si (tb_llama_expr(__cargar64(s + 8)) o tb_listas_quietas(__cargar64(s + 16)) == 0) { retornar 0 }
            si (__cargar64(s + 24) != 0 y tb_listas_quietas(__cargar64(s + 24)) == 0) { retornar 0 }
        }
        si (t == 23) {
            si (tb_llama_expr(__cargar64(s + 8)) o tb_listas_quietas(__cargar64(s + 16)) == 0) { retornar 0 }
        }
        si (t == 33 y (tb_llama_expr(__cargar64(s + 16)) o tb_llama_expr(__cargar64(s + 24)))) { retornar 0 }
        i = i + 1
    }
    retornar 1
}

funcion tb_contar_accesos_expr(e, nombre) {
    sea t = __cargar64(e)
    si (t == 32) { retornar str_igual(__cargar64(e + 8), nombre) + tb_contar_accesos_expr(__cargar64(e + 16), nombre) }
    si (t == 3 o t == 10 o t == 11 o t == 12) { retornar tb_contar_accesos_expr(__cargar64(e + 16), nombre) + tb_contar_accesos_expr(__cargar64(e + 24), nombre) }
    si (t == 13) { retornar tb_contar_accesos_expr(__cargar64(e + 16), nombre) }
    si (t == 4) { retornar tb_contar_accesos_expr(__cargar64(e + 8), nombre) }
    retornar 0
}

funcion tb_contar_accesos(v, nombre) {
    sea n = 0
    sea i = 0
    mientras (i < vec_largo(v)) {
        sea s = vec_obtener(v, i)
        sea t = __cargar64(s)
        si (t == 20 o t == 21) { n = n + tb_contar_accesos_expr(__cargar64(s + 16), nombre) }
        si (t == 24 o t == 27) { n = n + tb_contar_accesos_expr(__cargar64(s + 8), nombre) }
        si (t == 33) { n = n + str_igual(__cargar64(s + 8), nombre) + tb_contar_accesos_expr(__cargar64(s + 16), nombre) + tb_contar_accesos_expr(__cargar64(s + 24), nombre) }
        si (t == 22) {
            n = n + tb_contar_accesos_expr(__cargar64(s + 8), nombre) + tb_contar_accesos(__cargar64(s + 16), nombre)
            si (__cargar64(s + 24) != 0) { n = n + tb_contar_accesos(__cargar64(s + 24), nombre) }
        }
        si (t == 23) { n = n + tb_contar_accesos_expr(__cargar64(s + 8), nombre) + tb_contar_accesos(__cargar64(s + 16), nombre) }
        i = i + 1
    }
    retornar n
}

funcion tb_clase_gen(g, e) {
    sea t = __cargar64(e)
    si (t == 30 o t == 31 o t == 36) { retornar 2 }
    si (t == 2 y tb_declarada(__cargar64(g + 120), __cargar64(e + 8))) { retornar 2 }
    retornar 1
}

// ── Reparto de registros ─────────────────────────────────────────────
// Cada nombre (parámetro o "sea") recibe una casilla fija; las cuatro con
// más peso (usos ponderados ×10 por nivel de ciclo) van a rbx, r13, r14 y
// r15. Sin variables tapadas, dos "sea" con el mismo nombre nunca están
// vivas a la vez, así que comparten casilla.
funcion tb_peso_sumar(pesos, nombres, nombre, w) {
    sea i = 0
    mientras (i < vec_largo(nombres)) {
        si (str_igual(vec_obtener(nombres, i), nombre)) {
            vec_fijar(pesos, i, vec_obtener(pesos, i) + w)
            retornar 0
        }
        i = i + 1
    }
    vec_agregar(nombres, nombre)
    vec_agregar(pesos, w)
    retornar 0
}

funcion tb_peso_expr(pesos, nombres, e, w) {
    sea t = __cargar64(e)
    si (t == 2) { retornar tb_peso_sumar(pesos, nombres, __cargar64(e + 8), w) }
    si (t == 3 o t == 10 o t == 11 o t == 12) {
        tb_peso_expr(pesos, nombres, __cargar64(e + 16), w)
        retornar tb_peso_expr(pesos, nombres, __cargar64(e + 24), w)
    }
    si (t == 13) { retornar tb_peso_expr(pesos, nombres, __cargar64(e + 16), w) }
    si (t == 4) { retornar tb_peso_expr(pesos, nombres, __cargar64(e + 8), w) }
    si (t == 32) { retornar tb_peso_expr(pesos, nombres, __cargar64(e + 16), w) }
    si (t == 31) {
        tb_peso_expr(pesos, nombres, __cargar64(e + 8), w)
        retornar tb_peso_expr(pesos, nombres, __cargar64(e + 16), w)
    }
    si (t == 6) {
        sea args = __cargar64(e + 16)
        sea i = 0
        mientras (i < vec_largo(args)) {
            tb_peso_expr(pesos, nombres, vec_obtener(args, i), w)
            i = i + 1
        }
    }
    retornar 0
}

funcion tb_peso_bloque(pesos, nombres, v, w) {
    sea i = 0
    mientras (i < vec_largo(v)) {
        sea s = vec_obtener(v, i)
        sea t = __cargar64(s)
        si (t == 20 o t == 21) {
            // las listas no ocupan casilla de entero
            sea k = __cargar64(__cargar64(s + 16))
            si (t == 21 o (k != 30 y k != 31 y k != 36)) { tb_peso_sumar(pesos, nombres, __cargar64(s + 8), w) }
            tb_peso_expr(pesos, nombres, __cargar64(s + 16), w)
        }
        si (t == 22) {
            tb_peso_expr(pesos, nombres, __cargar64(s + 8), w)
            tb_peso_bloque(pesos, nombres, __cargar64(s + 16), w)
            si (__cargar64(s + 24) != 0) { tb_peso_bloque(pesos, nombres, __cargar64(s + 24), w) }
        }
        si (t == 23) {
            sea w2 = w * 10
            si (w2 > 100000) { w2 = 100000 }
            tb_peso_expr(pesos, nombres, __cargar64(s + 8), w2)
            tb_peso_bloque(pesos, nombres, __cargar64(s + 16), w2)
        }
        si (t == 24 o t == 27) { tb_peso_expr(pesos, nombres, __cargar64(s + 8), w) }
        si (t == 33) {
            tb_peso_expr(pesos, nombres, __cargar64(s + 16), w)
            tb_peso_expr(pesos, nombres, __cargar64(s + 24), w)
        }
        si (t == 34) { tb_peso_expr(pesos, nombres, __cargar64(s + 16), w) }
        i = i + 1
    }
    retornar 0
}

// Casillas en orden: primero las de más peso (a igual peso, el orden de
// aparición). extra: nombre con peso máximo (acumulador) o 0.
funcion tb_repartir(params, cuerpo, extra) {
    sea nombres = vec_nuevo()
    sea pesos = vec_nuevo()
    sea i = 0
    mientras (i < vec_largo(params)) {
        tb_peso_sumar(pesos, nombres, vec_obtener(params, i), 1)
        i = i + 1
    }
    si (extra != 0) { tb_peso_sumar(pesos, nombres, extra, 1000000000) }
    tb_peso_bloque(pesos, nombres, cuerpo, 1)
    sea orden = vec_nuevo()
    sea usado = vec_nuevo()
    i = 0
    mientras (i < vec_largo(nombres)) {
        vec_agregar(usado, 0)
        i = i + 1
    }
    mientras (vec_largo(orden) < vec_largo(nombres)) {
        sea mejor = 0 - 1
        i = 0
        mientras (i < vec_largo(nombres)) {
            si (vec_obtener(usado, i) == 0 y (mejor < 0 o vec_obtener(pesos, i) > vec_obtener(pesos, mejor))) { mejor = i }
            i = i + 1
        }
        vec_fijar(usado, mejor, 1)
        vec_agregar(orden, vec_obtener(nombres, mejor))
    }
    retornar orden
}

// Cuenta "sea" (cota de variables) para el tamaño del marco.
funcion tb_contar_sea(v) {
    sea n = 0
    sea i = 0
    mientras (i < vec_largo(v)) {
        sea s = vec_obtener(v, i)
        sea t = __cargar64(s)
        si (t == 20) { n = n + 1 }
        si (t == 22) {
            n = n + tb_contar_sea(__cargar64(s + 16))
            si (__cargar64(s + 24) != 0) { n = n + tb_contar_sea(__cargar64(s + 24)) }
        }
        si (t == 23) { n = n + tb_contar_sea(__cargar64(s + 16)) }
        i = i + 1
    }
    retornar n
}

// Emite la función turbo e (cursor en "("): dinámica, normal y cruda.
funcion tb_emitir(c, e) {
    sea f = __cargar64(e + 8)
    sea inicio = __cargar64(c + 8)

    // 1) Forma dinámica (la de siempre) con su propia etiqueta.
    sea normal = __cargar64(f + 8)
    sea dinamica = nueva_etiqueta(c)
    __guardar64(f + 8, dinamica)
    sea saltar_d = saltar_por_encima(c)
    sea nombres = parametros(c, vec_nuevo())
    sea estado = abrir_funcion(c, dinamica, nombres)
    vec_liberar(nombres)
    aplicar_defectos(c)
    aplicar_comprobaciones(c)
    bloque(c)
    cerrar_funcion(c, estado)
    definir_etiqueta(c, saltar_d)
    __guardar64(f + 8, normal)
    retornar tb_emitir_turbo(c, e, normal, dinamica, inicio)
}

// Cierre anónimo sin capturas: funcion(a, b) { … } como expresión. Si es
// turbo, emite la forma dinámica en "dinamica", la entrada normal en
// "etiqueta" y la cruda; devuelve aridad + 1 (o 0 si no es turbo). El
// cursor queda tras el cuerpo.
funcion tb_cierre(c, etiqueta) {
    si (dinamico(c) == 0) { retornar 0 }
    sea tabla = tb_tabla(c)
    si (es_arm64(c) o es_wasm(c) o mem_global(40) != 0 o variable_entorno_es(c, "CFORGE_TURBO", "0")) { retornar 0 }
    sea inicio = __cargar64(c + 8)
    sea p = tb_analizar_funcion(c)
    sea ok = tb_fallo(p) == 0 y tb_cabe_bloque(__cargar64(p + 48)) y tb_termina(__cargar64(p + 48)) y tb_validar(__cargar64(p + 48), tb_copiar_vec(__cargar64(p + 40)))
    si (ok) {
        sea llamadas = __cargar64(p + 16)
        sea j = 0
        mientras (j < vec_largo(llamadas)) {
            sea otra = tb_buscar(tabla, vec_obtener(llamadas, j))
            si (otra == 0 o __cargar64(otra + 40) != 1) { ok = 0 }
            j = j + 1
        }
    }
    __guardar64(c + 8, inicio)
    si (ok == 0) { retornar 0 }
    sea e = mem_reservar(64)
    __guardar64(e, " cierre")                                        // sin recursión por nombre
    __guardar64(e + 8, 0)
    __guardar64(e + 16, nueva_etiqueta(c))
    __guardar64(e + 24, vec_largo(__cargar64(p + 40)))
    __guardar64(e + 40, 1)
    // Forma dinámica del cierre (convención de cierres).
    sea dinamica = nueva_etiqueta(c)
    sea saltar_d = saltar_por_encima(c)
    sea nombres = parametros(c, un_nombre(str_nuevo(0)))
    sea estado = abrir_cierre(c, dinamica, nombres)
    vec_liberar(nombres)
    aplicar_defectos(c)
    aplicar_comprobaciones(c)
    bloque(c)
    cerrar_funcion(c, estado)
    definir_etiqueta(c, saltar_d)
    tb_emitir_turbo(c, e, etiqueta, dinamica, inicio)
    retornar __cargar64(e + 24) + 1
}

// Entrada normal y cruda (tras compilar la forma dinámica). El cursor
// vuelve a "inicio" para leer el cuerpo y queda tras él.
funcion tb_emitir_turbo(c, e, normal, dinamica, inicio) {
    sea fin_tokens = __cargar64(c + 8)
    __guardar64(c + 8, inicio)

    sea p = tb_analizar_funcion(c)
    si (tb_fallo(p)) { error_en(c, "turbo: la función cambió entre pasadas") }
    __guardar64(c + 8, fin_tokens)
    sea params = __cargar64(p + 40)
    sea n = vec_largo(params)
    sea cuerpo = __cargar64(p + 48)
    sea saltar = saltar_por_encima(c)

    // 2) Entrada normal (convención del lenguaje).
    definir_etiqueta(c, normal)
    e1(c, 85)                                                       // push rbp
    e3(c, 72, 137, 229)                                             // mov rbp, rsp
    sea repetir = nueva_etiqueta(c)
    sea i = 0
    mientras (i < n) {
        tb_memoria(c, 139, 0, 16 + 8 * (n - 1 - i))                 // mov rax, [rbp + …]
        e2(c, 168, 1)                                                // test al, 1
        tb_jcc(c, 4, repetir)                                        // no es entero chico
        e3(c, 72, 209, 248)                                          // sar rax, 1
        tb_mov(c, tb_argumento(i), 0)
        i = i + 1
    }
    op_llamar(c, __cargar64(e + 16))
    tb_jcc(c, 2, repetir)                                            // jc: repetir con la dinámica
    e3(c, 72, 137, 193)                                              // mov rcx, rax
    e3(c, 72, 1, 192)                                                // add rax, rax
    sea grande = nueva_etiqueta(c)
    tb_jcc(c, 0, grande)
    e4(c, 72, 131, 192, 1)                                           // add rax, 1
    e3(c, 72, 137, 236)                                              // mov rsp, rbp
    e2(c, 93, 195)                                                   // pop rbp; ret
    definir_etiqueta(c, grande)
    e1(c, 81)                                                        // push rcx
    llamar_runtime(c, "dyn_turbo_entero", 1)
    e3(c, 72, 137, 236)
    e2(c, 93, 195)
    // Repetir con la dinámica: misma pila de argumentos y dirección de vuelta.
    definir_etiqueta(c, repetir)
    e3(c, 72, 137, 236)                                              // mov rsp, rbp
    e1(c, 93)                                                        // pop rbp
    op_saltar(c, dinamica)

    // 3) Entrada cruda.
    sea g = mem_reservar(208)
    mem_llenar(g, 0, 208)
    __guardar64(g, c)
    __guardar64(g + 8, vec_nuevo())
    __guardar64(g + 16, nueva_etiqueta(c))                           // salida (rdx ya fijado)
    __guardar64(g + 24, nueva_etiqueta(c))                           // fuera de i64: repetir
    __guardar64(g + 32, __cargar64(g + 24))                          // división por cero: igual
    __guardar64(g + 40, vec_nuevo())
    __guardar64(g + 56, nueva_etiqueta(c))                           // salida normal (rdx = 0)
    __guardar64(g + 72, __cargar64(e))                               // nombre (recursión de cola)
    __guardar64(g + 80, n)
    __guardar64(g + 120, vec_nuevo())                                // listas locales
    __guardar64(g + 128, vec_nuevo())                                // y su ancho
    __guardar64(g + 144, cuerpo)
    sea cola = tb_tiene_cola(g, cuerpo)
    sea extra = 0
    si (cola) { extra = "  acumulador" }
    si (n == 1 y vec_largo(cuerpo) > 0) {
        sea primera = vec_obtener(cuerpo, 0)
        si (__cargar64(primera) == 22 y __cargar64(primera + 24) == 0 y vec_largo(__cargar64(primera + 16)) == 1) {
            sea ret = vec_obtener(__cargar64(primera + 16), 0)
            sea pn = vec_obtener(params, 0)
            si (__cargar64(ret) == 24 y tb_guarda_simple(__cargar64(primera + 8), pn) y tb_simple(__cargar64(ret + 8), pn)) { __guardar64(g + 104, primera) }
        }
    }
    // Desenrollar un nivel: cuerpo = [guarda, retornar f(a) + f(b) + …]; la
    // llamada que no es la de cola se hace en línea con su propio ciclo.
    sea desenrollar = 0
    si (cola y __cargar64(g + 104) != 0 y vec_largo(cuerpo) == 2 y __cargar64(vec_obtener(cuerpo, 1)) == 24) {
        sea terminos = tb_terminos(__cargar64(vec_obtener(cuerpo, 1) + 8), vec_nuevo())
        sea k = tb_termino_cola(g, terminos)
        sea j = 0
        mientras (j < vec_largo(terminos)) {
            sea t = vec_obtener(terminos, j)
            si (j != k y __cargar64(t) == 6 y str_igual(__cargar64(t + 8), __cargar64(g + 72)) y vec_largo(__cargar64(t + 16)) == 1) { desenrollar = 1 }
            j = j + 1
        }
    }
    __guardar64(g + 192, desenrollar)
    sea reparto = tb_repartir(params, cuerpo, extra)
    si (desenrollar) {
        // "  interior" (el parámetro de la llamada en línea) va a un hogar
        sea otro = vec_nuevo()
        vec_agregar(otro, vec_obtener(reparto, 0))
        vec_agregar(otro, "  interior")
        sea j = 1
        mientras (j < vec_largo(reparto)) {
            vec_agregar(otro, vec_obtener(reparto, j))
            j = j + 1
        }
        reparto = otro
    }
    si (cola) { vec_agregar(reparto, "  vueltas") }                 // al final: en el marco
    __guardar64(g + 152, reparto)
    __guardar64(g + 160, params)
    tb_alinear(c)
    definir_etiqueta(c, __cargar64(e + 16))
    // Solo se guardan los hogares que se usan (rbx, r13, r14, r15). Sin
    // variables en memoria no hace falta marco (rbp).
    sea total = n + tb_contar_sea(cuerpo) + cola * 2 + desenrollar
    sea usados = total
    si (usados > 4) { usados = 4 }
    // (Probado sin marco: resultó más lento en recursión; se deja el marco.)
    sea con_marco = 1
    sea hueco = 0
    si (con_marco) {
        e1(c, 85)                                                    // push rbp
        e3(c, 72, 137, 229)                                          // mov rbp, rsp
    }
    i = 0
    mientras (i < usados) {
        tb_empujar(c, tb_hogar(i))
        i = i + 1
    }
    si (hueco) { e1(c, 80) }                                         // push rax (hueco)
    sea ranuras = 0
    si (total > 4) { ranuras = total - 4 }
    // listas locales: una zona aparte del marco, debajo de las variables
    __guardar64(g + 112, 8 * usados + 8 * ranuras)
    si (tb_hay_listas(cuerpo)) {
        // listas, más el largo de la lista fijada y el r12 de quien llama
        __guardar64(g + 176, 1)
        __guardar64(g + 184, tb_lista_desp(g, total))
        ranuras = ranuras + total + 2
    }
    si (ranuras > 0) {
        e3(c, 72, 129, 236)                                          // sub rsp, imm32
        e32(c, 8 * ranuras)
    }
    si (__cargar64(g + 176) != 0) { tb_memoria(c, 137, 12, tb_lista_desp(g, total + 1)) }
    i = 0
    mientras (i < n) {
        vec_agregar(__cargar64(g + 8), vec_obtener(params, i))
        tb_guardar_var(c, tb_variable(g, vec_obtener(params, i)), tb_argumento(i))
        i = i + 1
    }
    comprobar_pila(c)
    si (cola) {
        // acumulador (después de los parámetros) y comienzo del ciclo
        vec_agregar(__cargar64(g + 8), "  acumulador")
        __guardar64(g + 88, tb_variable(g, "  acumulador"))
        tb_inmediato(c, tb_trabajo(0), 0)
        tb_guardar_var(c, __cargar64(g + 88), tb_trabajo(0))
        // Cada vuelta del ciclo es una llamada de la forma normal: pasadas
        // 10000, se repite con la dinámica, que llega al mismo límite de
        // pila (y al mismo error) que siempre.
        sea vueltas = tb_variable(g, "  vueltas")
        tb_guardar_var(c, vueltas, tb_trabajo(0))
        __guardar64(g + 96, nueva_etiqueta(c))
        tb_alinear(c)
        definir_etiqueta(c, __cargar64(g + 96))
        tb_contar_vuelta(g)
        __guardar64(g + 64, 1)
    }
    tb_bloque_gen(g, cuerpo)
    e3(c, 72, 49, 192)                                               // xor rax, rax (no se llega)
    definir_etiqueta(c, __cargar64(g + 56))
    e1(c, 248)                                                       // clc: resultado válido
    definir_etiqueta(c, __cargar64(g + 16))
    si (__cargar64(g + 176) != 0) { tb_memoria(c, 139, 12, tb_lista_desp(g, total + 1)) }
    si (con_marco) { e4(c, 72, 141, 101, __y_bits(256 - 8 * usados, 255)) }   // lea rsp, [rbp - 8·usados]
    si (hueco) { e4(c, 72, 141, 100, 36) e1(c, 8) }                  // lea rsp, [rsp + 8]
    i = usados - 1
    mientras (i >= 0) {
        tb_sacar(c, tb_hogar(i))
        i = i - 1
    }
    si (con_marco) { e1(c, 93) }                                     // pop rbp
    e1(c, 195)                                                       // ret
    definir_etiqueta(c, __cargar64(g + 24))
    e1(c, 249)                                                       // stc: repetir con la dinámica
    op_saltar(c, __cargar64(g + 16))
    definir_etiqueta(c, saltar)
    retornar 0
}
