// bootstrap/nativo/cforge_self.cfv — compilador C-Forge autoalojado.
//
// Compilador de una sola pasada para el dialecto nativo de C-Forge, escrito
// en ese mismo dialecto. El parser de descenso recursivo emite código
// x86-64 directamente mientras lee los tokens (sin árbol de sintaxis) y
// empaqueta un ELF estático: sin libc, enlazador ni ensamblador.
//
// Se compila a sí mismo junto con runtime/*.cfv y bootstrap/nativo/lexer.cfv:
//   stage1 = x64_nativo (Core) compila estas fuentes
//   stage2 = stage1 compila estas fuentes
//   stage3 = stage2 compila estas fuentes      → stage2 y stage3 idénticos
//
// Uso: cforge-self -o salida archivo1.cfv [archivo2.cfv ...]
//
// Modelo de ejecución (igual que x64_nativo.cfv): todo valor es un entero de
// 64 bits; argumentos apilados de izquierda a derecha; resultado en rax;
// locales en [rbp - 8k]; textos literales con forma de texto del runtime.

// ── Contexto (registro de 20 campos de 8 bytes) ──────────────────────────
//  0 tokens       8 posición     16 código      24 datos
// 32 arreglos    40 etiquetas   48 funciones   56 locales
// 64 n_locales   72 literales   80 reubicaciones de datos
// 88 base de locales visibles   96 fuente (para errores)
// 104 modo: 0 nativo · 1 puente (runtime con valores del lenguaje)
//           2 dinámico (lenguaje C-Forge completo)
// 112 punteros entre datos [campo][destino]   120 cajas de texto literales
// 128 etiqueta de "romper"   136 etiqueta de "continuar"
// 144 funciones en orden de definición       152 siguiente definición
// 160 clases (registros del compilador)       168 clase en compilación
// 176 punteros de datos a etiquetas [campo][etiqueta]
// 184 registros de clase en datos             192 tabla de clases en datos
// 200 programa en inglés (0/1)                208 archivos [línea inicial][nombre]
// 216 marco de función actual                  224 variables globales [nombre][casilla]
// 232 profundidad de bloque                    240 bloques intentar abiertos
// 248 bloques intentar abiertos al entrar al ciclo
// 256 funciones externas [símbolo][biblioteca][etiqueta][casilla GOT][tipos]
// 264 siguiente declaración externa
// 272 casillas de dlopen/dlsym en datos (o -1)
// 280 valores por defecto pendientes [nombre][posición del token]
// 288 atributos #[...] [atributo][argumentos][función]
// 296 plataforma objetivo: 0 Linux x86-64 (ELF) · 1 Windows (PE64) ·
//     2 macOS x86-64 (Mach-O) · 3 macOS ARM64 (Mach-O) · 4 Linux ARM64 (ELF) ·
//     5 iOS ARM64 (Mach-O) · 6 simulador de iOS en Apple Silicon (Mach-O)
// 304 importaciones de Windows [dll][función]
// 312 etiqueta del trampolín de hilos de Windows (o -1)
// 320 símbolos exportados de una biblioteca (--lib) [nombre][posición]
// Tipos estáticos (verificación antes de ejecutar, solo en el lenguaje):
// 328 tipo de la última expresión · 336 variables [nombre][tipo] · 344 tipos
// de los parámetros pendientes · 352 retorno pendiente · 360 retorno de la
// función actual · 368 tipo para la próxima variable declarada · 376 entero
// literal a la derecha del operador · 384/392 tipos de los dos operandos
// --release (eliminación de código muerto): 400 función que se compila (-1
// arriba) · 408 referencias [función][...] de la primera pasada · 416
// funciones alcanzables (segunda pasada; 0 = compilar todo) · wasm: 432
// bloques · 440 importaciones · 448 tipo del resultado de la externa actual

funcion ctx_nuevo(tokens) {
    mem_fijar_global(44, 0)                                    // nivel de anidamiento
    sea c = mem_reservar(456)
    mem_llenar(c, 0, 456)
    __guardar64(c + 400, 0 - 1)
    __guardar64(c, tokens)
    __guardar64(c + 8, 0)
    __guardar64(c + 16, str_nuevo(65536))
    __guardar64(c + 24, str_nuevo(65536))
    __guardar64(c + 32, vec_nuevo())
    __guardar64(c + 40, vec_nuevo())
    __guardar64(c + 48, vec_nuevo())
    __guardar64(c + 56, vec_nuevo())
    __guardar64(c + 64, 0)
    __guardar64(c + 72, vec_nuevo())
    __guardar64(c + 80, vec_nuevo())
    __guardar64(c + 88, 0)
    __guardar64(c + 96, 0)
    __guardar64(c + 104, 0)
    __guardar64(c + 112, vec_nuevo())
    __guardar64(c + 120, vec_nuevo())
    __guardar64(c + 128, 0 - 1)
    __guardar64(c + 136, 0 - 1)
    __guardar64(c + 144, vec_nuevo())
    __guardar64(c + 152, 0)
    __guardar64(c + 160, vec_nuevo())
    __guardar64(c + 168, 0)
    __guardar64(c + 176, vec_nuevo())
    __guardar64(c + 184, vec_nuevo())
    __guardar64(c + 192, 0)
    __guardar64(c + 200, 0)
    __guardar64(c + 208, vec_nuevo())
    // El programa principal usa celdas: sus variables de bloque (no globales)
    // pueden ser capturadas por funciones anónimas.
    __guardar64(c + 216, marco_nuevo(0, 1, 0, 0))
    __guardar64(__cargar64(c + 216) + 48, 1)
    __guardar64(c + 224, vec_nuevo())
    __guardar64(c + 232, 0)
    __guardar64(c + 240, 0)
    __guardar64(c + 248, 0)
    __guardar64(c + 256, vec_nuevo())
    __guardar64(c + 264, 0)
    __guardar64(c + 272, 0 - 1)
    __guardar64(c + 280, vec_nuevo())
    __guardar64(c + 288, vec_nuevo())
    __guardar64(c + 296, 0)
    __guardar64(c + 336, vec_nuevo())
    __guardar64(c + 344, vec_nuevo())
    __guardar64(c + 304, vec_nuevo())
    __guardar64(c + 312, 0 - 1)
    retornar c
}

funcion ctx_codigo(c) { retornar __cargar64(c + 16) }
funcion es_windows(c) { retornar __cargar64(c + 296) == 1 }
// Darwin (macOS e iOS): libSystem, dyld y Mach-O.
funcion es_macos(c) { retornar es_darwin_numero(__cargar64(c + 296)) }
funcion es_darwin_numero(t) { retornar t == 2 o t == 3 o t == 5 o t == 6 }
funcion es_ios(c) { retornar __cargar64(c + 296) == 5 o __cargar64(c + 296) == 6 }
funcion es_arm64(c) { retornar __cargar64(c + 296) >= 3 y __cargar64(c + 296) <= 6 }   // 3, 4, 5 y 6 (7: wasm)
funcion ctx_modo(c) { retornar __cargar64(c + 104) }
// 2: programa del usuario · 3: biblioteca del lenguaje (también dinámica)
funcion dinamico(c) { retornar __cargar64(c + 104) >= 2 }
funcion ctx_datos(c) { retornar __cargar64(c + 24) }

// ── Tokens ────────────────────────────────────────────────────────────────

funcion tok_actual(c) {
    retornar vec_obtener(__cargar64(c), __cargar64(c + 8))
}

funcion tok_tipo(c) { retornar __cargar64(tok_actual(c)) }
funcion tok_lexema(c) { retornar __cargar64(tok_actual(c) + 8) }
funcion tok_linea(c) { retornar __cargar64(tok_actual(c) + 16) }

funcion tok_siguiente_lexema(c) {
    sea i = __cargar64(c + 8) + 1
    si (i >= vec_largo(__cargar64(c))) { retornar str_nuevo(0) }
    retornar __cargar64(vec_obtener(__cargar64(c), i) + 8)
}

funcion avanzar(c) {
    sea t = tok_actual(c)
    si (__cargar64(t) != 5) { __guardar64(c + 8, __cargar64(c + 8) + 1) }
    retornar t
}

funcion ver(c, lexema) {
    sea t = tok_actual(c)
    si (__cargar64(t) == 3) { retornar 0 }
    retornar str_igual(__cargar64(t + 8), lexema)
}

funcion tomar(c, lexema) {
    si (ver(c, lexema)) {
        avanzar(c)
        retornar 1
    }
    retornar 0
}

// "archivo.cfv:42" a partir de la línea global de la fuente concatenada.
funcion ubicacion(c, linea) {
    sea archivos = __cargar64(c + 208)
    sea m = str_nuevo(32)
    sea i = vec_largo(archivos) - 1
    mientras (i >= 0) {
        sea a = vec_obtener(archivos, i)
        si (__cargar64(a) <= linea) {
            str_agregar(m, __cargar64(a + 8))
            str_agregar_byte(m, 58)
            str_agregar(m, str_desde_entero(linea - __cargar64(a) + 1))
            retornar m
        }
        i = i - 1
    }
    str_agregar(m, "línea ")
    str_agregar(m, str_desde_entero(linea))
    retornar m
}

funcion error_en(c, mensaje) {
    sea m = ubicacion(c, tok_linea(c))
    str_agregar(m, ": ")
    str_agregar(m, mensaje)
    str_agregar(m, " (cerca de '")
    str_agregar(m, tok_lexema(c))
    str_agregar(m, "')")
    rt_panico(m)
    retornar 0
}

funcion requerir(c, lexema) {
    si (tomar(c, lexema) == 0) {
        error_en(c, str_concatenar("se esperaba ", lexema))
    }
    retornar 0
}

funcion requerir_ident(c) {
    si (tok_tipo(c) != 1) { error_en(c, "se esperaba un nombre") }
    retornar __cargar64(avanzar(c) + 8)
}

// Anotación de tipo opcional: ": tipo"
funcion saltar_tipo(c) {
    sea t = 0
    si (tomar(c, ":")) {
        // ?T / ?*T: opcional (13), hay que comprobarlo antes de usarlo.
        // *T: puntero que nunca es nulo (12).
        sea opcional = tomar(c, "?")
        sea puntero = tomar(c, "*")
        t = tipo_por_nombre(requerir_ident(c))
        si (opcional) { t = 13 } sino { si (puntero) { t = 12 } }
        saltar_genericos(c)
        tomar(c, "?")
        mientras (ver(c, "[") y str_igual(tok_siguiente_lexema(c), "]")) {
            avanzar(c)
            avanzar(c)
            t = 4
        }
    }
    retornar t
}

// ── Tipos estáticos ───────────────────────────────────────────────────────
// 0 desconocido · 1 entero · 9 numero · 2 texto · 3 booleano · 4 lista ·
// 5 mapa · 6 nulo · 7 funcion. Lo desconocido (dinámico) es compatible con
// todo; nulo, con cualquier tipo; entero y numero, entre sí.

funcion tipo_por_nombre(n) {
    si (str_igual(n, "numero") o str_igual(n, "número") o str_igual(n, "number") o str_igual(n, "flotante") o str_igual(n, "float") o str_igual(n, "doble") o str_igual(n, "double") o str_igual(n, "decimal")) { retornar 9 }
    si (str_igual(n, "entero") o str_igual(n, "int") o str_igual(n, "integer") o str_igual(n, "largo") o str_igual(n, "long") o str_igual(n, "entero32")) { retornar 11 }
    si (str_igual(n, "texto") o str_igual(n, "string") o str_igual(n, "cadena") o str_igual(n, "str")) { retornar 2 }
    si (str_igual(n, "booleano") o str_igual(n, "bool") o str_igual(n, "boolean") o str_igual(n, "logico")) { retornar 3 }
    si (str_igual(n, "lista") o str_igual(n, "list") o str_igual(n, "arreglo") o str_igual(n, "array")) { retornar 4 }
    si (str_igual(n, "mapa") o str_igual(n, "map") o str_igual(n, "dict") o str_igual(n, "diccionario")) { retornar 5 }
    si (str_igual(n, "nulo") o str_igual(n, "null") o str_igual(n, "vacio") o str_igual(n, "void")) { retornar 6 }
    si (str_igual(n, "funcion") o str_igual(n, "function") o str_igual(n, "fn")) { retornar 7 }
    retornar 0
}

funcion nombre_de_tipo(t) {
    si (t == 1 o t == 11) { retornar "entero" }
    si (t == 9) { retornar "numero" }
    si (t == 2) { retornar "texto" }
    si (t == 3) { retornar "booleano" }
    si (t == 4) { retornar "lista" }
    si (t == 5) { retornar "mapa" }
    si (t == 6) { retornar "nulo" }
    si (t == 7) { retornar "funcion" }
    si (t == 12) { retornar "puntero *T" }
    si (t == 13) { retornar "opcional ?T" }
    si (t == 20) { retornar "tipo (comptime)" }
    retornar "desconocido"
}

// 1: entero probado (literal o variable que solo recibe enteros: el código
// puede omitir las comprobaciones) · 11: entero declarado (anotación).
funcion es_numerico(t) { retornar t == 1 o t == 9 o t == 11 }
funcion es_entero(t) { retornar t == 1 o t == 11 }
funcion tipo_actual(c) { retornar __cargar64(c + 328) }
funcion fijar_tipo(c, t) {
    __guardar64(c + 328, t)
    retornar 0
}

funcion tipos_compatibles(esperado, real) {
    // *T nunca recibe nulo ni un opcional sin comprobar; un opcional solo
    // se usa donde se acepta cualquier cosa o otro opcional.
    si (esperado == 12 y (real == 6 o real == 13)) { retornar 0 }
    si (real == 13 y esperado != 0 y esperado != 13) { retornar 0 }
    si (esperado == 0 o real == 0 o real == 6) { retornar 1 }
    // Punteros y opcionales: referencias (objetos, listas, mapas, funciones).
    si (esperado == 12 o esperado == 13) { retornar real == 12 o real == 13 o real == 4 o real == 5 o real == 7 }
    si (real == 12) { retornar 0 }
    si (es_numerico(esperado) y es_numerico(real)) { retornar 1 }
    retornar esperado == real
}

// Error de tipos en la línea de la expresión recién compilada.
funcion error_tipos(c, mensaje) {
    sea m = ubicacion(c, linea_previa(c))
    str_agregar(m, ": ")
    str_agregar(m, mensaje)
    rt_panico(m)
    retornar 0
}

funcion exigir_tipo(c, esperado, real, que) {
    si (dinamico(c) y tipos_compatibles(esperado, real) == 0) {
        sea m = str_concatenar("error de tipos: ", que)
        str_agregar(m, " espera ")
        str_agregar(m, nombre_de_tipo(esperado))
        str_agregar(m, " y recibe ")
        str_agregar(m, nombre_de_tipo(real))
        error_tipos(c, m)
    }
    retornar 0
}

// Tipo conocido de una variable (la declaración más reciente con ese nombre).
funcion tipo_variable(c, nombre) {
    sea v = __cargar64(c + 336)
    si (v == 0) { retornar 0 }
    sea i = vec_largo(v) - 1
    mientras (i >= 0) {
        sea e = vec_obtener(v, i)
        si (str_igual(__cargar64(e), nombre)) { retornar __cargar64(e + 8) }
        i = i - 1
    }
    retornar 0
}

funcion anotar_tipo_variable(c, nombre, tipo) {
    sea v = __cargar64(c + 336)
    si (v == 0 o dinamico(c) == 0) { retornar 0 }
    sea e = mem_reservar(16)
    __guardar64(e, nombre)
    __guardar64(e + 8, tipo)
    vec_agregar(v, e)
    retornar 0
}

// ¿Se vuelve a asignar "nombre" desde la posición desde hasta el final del
// bloque (o de todo el programa)? nombre =, nombre += …, para nombre en …
funcion reasignada(c, nombre, desde, todo) {
    sea tokens = __cargar64(c)
    sea i = desde
    // Una global: todo el código del programa (dialecto 2), no el runtime.
    sea modo = 2
    si (todo) {
        i = 0
        modo = 0
    }
    sea nivel = 0
    mientras (i + 1 < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, i)
        si (__cargar64(t) == 1 y str_igual(__cargar64(t + 8), "__dialecto")) { modo = numero_literal(lexema_en(tokens, i + 1)) }
        si (__cargar64(t) == 4) {
            si (str_igual(__cargar64(t + 8), "{")) { nivel = nivel + 1 }
            si (str_igual(__cargar64(t + 8), "}")) {
                nivel = nivel - 1
                si (nivel < 0 y todo == 0) { retornar 0 }
            }
        }
        si (modo == 2 y __cargar64(t) == 1 y str_igual(__cargar64(t + 8), nombre) y i != desde) {
            sea sig = vec_obtener(tokens, i + 1)
            sea ls = __cargar64(sig + 8)
            si (__cargar64(sig) == 4 y str_igual(ls, "=")) { retornar 1 }
            si (__cargar64(sig) == 4 y (str_igual(ls, "+") o str_igual(ls, "-") o str_igual(ls, "*") o str_igual(ls, "/") o str_igual(ls, "%")) y i + 2 < vec_largo(tokens) y es_simbolo(vec_obtener(tokens, i + 2), "=")) { retornar 1 }
            si (i > 0 y str_igual(lexema_en(tokens, i - 1), "para")) { retornar 1 }
        }
        i = i + 1
    }
    retornar 0
}

// ¿Todas las reasignaciones de "nombre" (en el mismo alcance que usa
// reasignada) son enteras: nombre = LIT, nombre = nombre ± LIT o
// nombre += / -= LIT? Así una variable que empieza entera sigue entera.
funcion reasignaciones_enteras(c, nombre, desde, todo) {
    sea tokens = __cargar64(c)
    sea i = desde
    sea modo = 2
    si (todo) {
        i = 0
        modo = 0
    }
    sea nivel = 0
    mientras (i + 1 < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, i)
        si (__cargar64(t) == 1 y str_igual(__cargar64(t + 8), "__dialecto")) { modo = numero_literal(lexema_en(tokens, i + 1)) }
        si (__cargar64(t) == 4) {
            si (str_igual(__cargar64(t + 8), "{")) { nivel = nivel + 1 }
            si (str_igual(__cargar64(t + 8), "}")) {
                nivel = nivel - 1
                si (nivel < 0 y todo == 0) { retornar 1 }
            }
        }
        si (modo == 2 y __cargar64(t) == 1 y str_igual(__cargar64(t + 8), nombre) y i != desde) {
            si (i > 0 y str_igual(lexema_en(tokens, i - 1), "para")) { retornar 0 }
            si (es_simbolo(vec_obtener(tokens, i + 1), "=")) {
                si (asignacion_entera(tokens, i + 2, nombre) == 0) { retornar 0 }
            } sino {
                si (i + 3 < vec_largo(tokens) y es_simbolo(vec_obtener(tokens, i + 2), "=")) {
                    sea op = vec_obtener(tokens, i + 1)
                    si (__cargar64(op) == 4 y (str_igual(__cargar64(op + 8), "+") o str_igual(__cargar64(op + 8), "-") o str_igual(__cargar64(op + 8), "*") o str_igual(__cargar64(op + 8), "/") o str_igual(__cargar64(op + 8), "%"))) {
                        si ((str_igual(__cargar64(op + 8), "+") o str_igual(__cargar64(op + 8), "-")) == 0) { retornar 0 }
                        si (literal_entero_suelto(tokens, i + 3) == 0) { retornar 0 }
                    }
                }
            }
        }
        i = i + 1
    }
    retornar 1
}

// ¿Hay en j un entero literal que termina la sentencia?
funcion literal_entero_suelto(tokens, j) {
    si (j >= vec_largo(tokens)) { retornar 0 }
    sea t = vec_obtener(tokens, j)
    si (__cargar64(t) != 2 o posicion_exponente(__cargar64(t + 8)) >= 0) { retornar 0 }
    retornar fin_de_sentencia(tokens, j + 1, __cargar64(t + 16))
}

funcion fin_de_sentencia(tokens, j, linea) {
    si (j >= vec_largo(tokens)) { retornar 1 }
    sea t = vec_obtener(tokens, j)
    si (__cargar64(t + 16) != linea) { retornar 1 }
    retornar es_simbolo(t, ";") o es_simbolo(t, "}") o __cargar64(t) == 5
}

// Lado derecho entero: LIT, o nombre + LIT / nombre - LIT.
funcion asignacion_entera(tokens, j, nombre) {
    si (literal_entero_suelto(tokens, j)) { retornar 1 }
    si (j + 2 >= vec_largo(tokens)) { retornar 0 }
    sea t = vec_obtener(tokens, j)
    si (__cargar64(t) != 1 o str_igual(__cargar64(t + 8), nombre) == 0) { retornar 0 }
    si ((es_simbolo(vec_obtener(tokens, j + 1), "+") o es_simbolo(vec_obtener(tokens, j + 1), "-")) == 0) { retornar 0 }
    retornar literal_entero_suelto(tokens, j + 2)
}

// Resultado y comprobación de un operador binario con tipos conocidos.
funcion tipo_binario(c, lex, tl, tr) {
    si (dinamico(c) == 0) { retornar 0 }
    sea conocidos = tl != 0 y tr != 0
    si (str_igual(lex, "==") o str_igual(lex, "!=")) { retornar fijar_tipo(c, 3) }
    si (str_igual(lex, "<") o str_igual(lex, "<=") o str_igual(lex, ">") o str_igual(lex, ">=")) {
        si (conocidos y (es_numerico(tl) y es_numerico(tr)) == 0 y (tl == 2 y tr == 2) == 0) {
            sea m = str_concatenar("error de tipos: no se puede comparar ", nombre_de_tipo(tl))
            str_agregar(m, " con ")
            str_agregar(m, nombre_de_tipo(tr))
            error_tipos(c, m)
        }
        retornar fijar_tipo(c, 3)
    }
    si (str_igual(lex, "+")) {
        si (tl == 2 o tr == 2) { retornar fijar_tipo(c, 2) }
        si (es_numerico(tl) y es_numerico(tr)) {
            si (tl == 1 y tr == 1) { retornar fijar_tipo(c, 1) }
            si (es_entero(tl) y es_entero(tr)) { retornar fijar_tipo(c, 11) }
            retornar fijar_tipo(c, 9)
        }
        si (tl == 4 y tr == 4) { retornar fijar_tipo(c, 4) }
        si (conocidos) {
            sea m = str_concatenar("error de tipos: no se puede sumar ", nombre_de_tipo(tl))
            str_agregar(m, " y ")
            str_agregar(m, nombre_de_tipo(tr))
            error_tipos(c, m)
        }
        retornar fijar_tipo(c, 0)
    }
    // - * / %: números.
    si ((tl != 0 y es_numerico(tl) == 0) o (tr != 0 y es_numerico(tr) == 0)) {
        sea m = str_concatenar("error de tipos: '", lex)
        str_agregar(m, "' necesita números y recibe ")
        str_agregar(m, nombre_de_tipo(tl))
        str_agregar(m, " y ")
        str_agregar(m, nombre_de_tipo(tr))
        error_tipos(c, m)
    }
    si (conocidos y tl == 1 y tr == 1 y str_igual(lex, "/") == 0) { retornar fijar_tipo(c, 1) }
    si (conocidos y es_entero(tl) y es_entero(tr) y str_igual(lex, "/") == 0) { retornar fijar_tipo(c, 11) }
    si (conocidos) { retornar fijar_tipo(c, 9) }
    retornar fijar_tipo(c, 0)
}

// Tipos de la firma "(a: t, b, ...): r" en tokens desde j (tras el "(").
// Devuelve [vec de tipos][retorno].
funcion firma_tipos(tokens, j) {
    sea r = mem_reservar(16)
    sea tipos = vec_nuevo()
    __guardar64(r, tipos)
    __guardar64(r + 8, 0)
    sea genericos = vec_nuevo()
    sea nivel = 1
    sea esperando = 1
    mientras (nivel > 0 y j < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, j)
        sea lex = __cargar64(t + 8)
        si (__cargar64(t) == 4 y (str_igual(lex, "(") o str_igual(lex, "[") o str_igual(lex, "{"))) { nivel = nivel + 1 }
        si (__cargar64(t) == 4 y (str_igual(lex, ")") o str_igual(lex, "]") o str_igual(lex, "}"))) { nivel = nivel - 1 }
        si (nivel == 1 y __cargar64(t) == 4 y str_igual(lex, ",")) { esperando = 1 }
        si (nivel == 1 y esperando y __cargar64(t) == 1) {
            esperando = 0
            sea tipo = 0
            si (str_igual(lex, "comptime") y j + 1 < vec_largo(tokens) y __cargar64(vec_obtener(tokens, j + 1)) == 1) {
                // comptime T: el argumento es un tipo conocido al compilar (20).
                vec_agregar(genericos, lexema_en(tokens, j + 1))
                vec_agregar(genericos, vec_largo(tipos))
                tipo = 20
            } sino {
                si (j + 2 < vec_largo(tokens) y es_simbolo(vec_obtener(tokens, j + 1), ":")) { tipo = tipo_generico(tokens, j + 2, genericos) }
            }
            vec_agregar(tipos, tipo)
        }
        j = j + 1
    }
    si (j + 1 < vec_largo(tokens) y es_simbolo(vec_obtener(tokens, j), ":")) { __guardar64(r + 8, tipo_generico(tokens, j + 1, genericos)) }
    retornar r
}

// ": T" con T un parámetro comptime número k → 100 + k (se resuelve en
// cada llamada con el tipo que recibe T).
funcion tipo_generico(tokens, k, genericos) {
    si (__cargar64(vec_obtener(tokens, k)) == 1) {
        sea i = 0
        mientras (i < vec_largo(genericos)) {
            si (str_igual(vec_obtener(genericos, i), lexema_en(tokens, k))) { retornar 100 + vec_obtener(genericos, i + 1) }
            i = i + 2
        }
    }
    retornar tipo_en_tokens(tokens, k)
}

funcion tipo_en_tokens(tokens, k) {
    sea marca = 0
    si (es_simbolo(vec_obtener(tokens, k), "?")) {
        marca = 13
        k = k + 1
    }
    si (es_simbolo(vec_obtener(tokens, k), "*")) {
        si (marca == 0) { marca = 12 }
        k = k + 1
    }
    sea t = vec_obtener(tokens, k)
    si (__cargar64(t) != 1) { retornar 0 }
    sea tipo = tipo_por_nombre(__cargar64(t + 8))
    si (marca != 0) { tipo = marca }
    sea fin = fin_genericos(tokens, k + 1)
    si (fin >= 0) { k = fin }
    k = k + 1
    si (k < vec_largo(tokens) y es_simbolo(vec_obtener(tokens, k), "?")) { k = k + 1 }
    si (k + 1 < vec_largo(tokens) y es_simbolo(vec_obtener(tokens, k), "[") y es_simbolo(vec_obtener(tokens, k + 1), "]")) { tipo = 4 }
    retornar tipo
}

// Fin (índice del ">" que cierra) de una lista de tipos genéricos que empieza
// en el "<" de la posición j, o -1 si no es una lista de tipos.
funcion fin_genericos(tokens, j) {
    si (es_simbolo(vec_obtener(tokens, j), "<") == 0) { retornar 0 - 1 }
    sea nivel = 0
    mientras (verdadero) {
        sea t = vec_obtener(tokens, j)
        si (es_simbolo(t, "<")) {
            nivel = nivel + 1
        } sino {
            si (es_simbolo(t, ">")) {
                nivel = nivel - 1
                si (nivel == 0) { retornar j }
            } sino {
                si (__cargar64(t) != 1 y es_simbolo(t, ",") == 0 y es_simbolo(t, "?") == 0 y es_simbolo(t, "*") == 0 y es_simbolo(t, "[") == 0 y es_simbolo(t, "]") == 0) { retornar 0 - 1 }
            }
        }
        j = j + 1
    }
    retornar 0 - 1
}

// <T, U ...> tras un nombre (genéricos: se aceptan y no generan código).
funcion saltar_genericos(c) {
    sea fin = fin_genericos(__cargar64(c), __cargar64(c + 8))
    si (fin >= 0) { __guardar64(c + 8, fin + 1) }
    retornar 0
}

// ── Sintaxis bilingüe ────────────────────────────────────────────────────
// Las palabras clave en inglés son alias exactos de las españolas (como en el
// intérprete). Tras un '.' no se traducen: son campos o métodos.

funcion alias_ingles(lex) {
    si (str_igual(lex, "let") o str_igual(lex, "var")) { retornar "sea" }
    si (str_igual(lex, "function")) { retornar "funcion" }
    si (str_igual(lex, "return")) { retornar "retornar" }
    si (str_igual(lex, "if")) { retornar "si" }
    si (str_igual(lex, "else")) { retornar "sino" }
    si (str_igual(lex, "while")) { retornar "mientras" }
    si (str_igual(lex, "for")) { retornar "para" }
    si (str_igual(lex, "in")) { retornar "en" }
    si (str_igual(lex, "try")) { retornar "intentar" }
    si (str_igual(lex, "catch")) { retornar "capturar" }
    si (str_igual(lex, "throw")) { retornar "lanzar" }
    si (str_igual(lex, "class")) { retornar "clase" }
    si (str_igual(lex, "struct")) { retornar "estructura" }
    si (str_igual(lex, "interface")) { retornar "interfaz" }
    si (str_igual(lex, "extends")) { retornar "extiende" }
    si (str_igual(lex, "implements")) { retornar "implementa" }
    si (str_igual(lex, "this") o str_igual(lex, "self")) { retornar "esto" }
    si (str_igual(lex, "import")) { retornar "importar" }
    si (str_igual(lex, "break")) { retornar "romper" }
    si (str_igual(lex, "continue")) { retornar "continuar" }
    si (str_igual(lex, "and")) { retornar "y" }
    si (str_igual(lex, "or")) { retornar "o" }
    si (str_igual(lex, "not")) { retornar "no" }
    si (str_igual(lex, "true")) { retornar "verdadero" }
    si (str_igual(lex, "false")) { retornar "falso" }
    si (str_igual(lex, "null")) { retornar "nulo" }
    si (str_igual(lex, "print")) { retornar "mostrar" }
    si (str_igual(lex, "assert")) { retornar "afirmar" }
    retornar 0
}

funcion es_clave_espanol(lex) {
    retornar str_igual(lex, "sea") o str_igual(lex, "funcion") o str_igual(lex, "retornar") o str_igual(lex, "si") o str_igual(lex, "sino") o str_igual(lex, "mientras") o str_igual(lex, "para") o str_igual(lex, "intentar") o str_igual(lex, "capturar") o str_igual(lex, "lanzar") o str_igual(lex, "clase") o str_igual(lex, "esto") o str_igual(lex, "importar") o str_igual(lex, "romper") o str_igual(lex, "continuar") o str_igual(lex, "verdadero") o str_igual(lex, "falso") o str_igual(lex, "nulo") o str_igual(lex, "mostrar") o str_igual(lex, "afirmar")
}

funcion tras_punto(tokens, i) {
    si (i == 0) { retornar 0 }
    sea p = vec_obtener(tokens, i - 1)
    retornar __cargar64(p) == 4 y str_igual(__cargar64(p + 8), ".")
}

// Traduce las palabras clave en inglés de la lista de tokens.
funcion traducir_ingles(tokens) {
    sea i = 0
    mientras (i < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, i)
        si (__cargar64(t) == 1 y tras_punto(tokens, i) == 0) {
            sea a = alias_ingles(__cargar64(t + 8))
            si (a != 0) { __guardar64(t + 8, a) }
            // fn / func solo como "fn nombre(": pueden ser nombres de variables.
            si ((str_igual(__cargar64(t + 8), "fn") o str_igual(__cargar64(t + 8), "func")) y i + 1 < vec_largo(tokens)) {
                si (__cargar64(vec_obtener(tokens, i + 1)) == 1) { __guardar64(t + 8, "funcion") }
            }
        }
        i = i + 1
    }
    retornar tokens
}

// Palabras clave en inglés menos palabras clave en español.
funcion puntaje_ingles(tokens) {
    sea puntaje = 0
    sea i = 0
    mientras (i < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, i)
        si (__cargar64(t) == 1 y tras_punto(tokens, i) == 0) {
            si (alias_ingles(__cargar64(t + 8)) != 0) { puntaje = puntaje + 1 }
            si (es_clave_espanol(__cargar64(t + 8))) { puntaje = puntaje - 1 }
        }
        i = i + 1
    }
    retornar puntaje
}

// Nombres en inglés de funciones del lenguaje (si el programa no las define).
funcion alias_funcion(nombre) {
    si (str_igual(nombre, "length")) { retornar "longitud" }
    si (str_igual(nombre, "append")) { retornar "agregar" }
    si (str_igual(nombre, "to_text")) { retornar "a_texto" }
    si (str_igual(nombre, "to_number")) { retornar "a_numero" }
    si (str_igual(nombre, "upper")) { retornar "texto_mayusculas" }
    si (str_igual(nombre, "lower")) { retornar "texto_minusculas" }
    si (str_igual(nombre, "replace")) { retornar "texto_reemplazar" }
    si (str_igual(nombre, "sort")) { retornar "lista_ordenar" }
    si (str_igual(nombre, "json_parse")) { retornar "json_parsear" }
    si (str_igual(nombre, "json_stringify")) { retornar "json_serializar" }
    si (str_igual(nombre, "json_pretty")) { retornar "json_bonito" }
    si (str_igual(nombre, "json_valid")) { retornar "json_valido" }
    si (str_igual(nombre, "keys")) { retornar "claves" }
    si (str_igual(nombre, "contains")) { retornar "contiene" }
    si (str_igual(nombre, "split")) { retornar "texto_dividir" }
    si (str_igual(nombre, "join")) { retornar "texto_unir" }
    si (str_igual(nombre, "trim")) { retornar "texto_recortar" }
    si (str_igual(nombre, "sqrt")) { retornar "raiz" }
    si (str_igual(nombre, "pow")) { retornar "potencia" }
    si (str_igual(nombre, "abs")) { retornar "absoluto" }
    si (str_igual(nombre, "floor")) { retornar "piso" }
    si (str_igual(nombre, "ceil")) { retornar "techo" }
    si (str_igual(nombre, "round")) { retornar "redondear" }
    si (str_igual(nombre, "min")) { retornar "minimo" }
    si (str_igual(nombre, "max")) { retornar "maximo" }
    si (str_igual(nombre, "range")) { retornar "lista_rango" }
    si (str_igual(nombre, "read_file")) { retornar "leer_archivo" }
    si (str_igual(nombre, "write_file")) { retornar "escribir_archivo" }
    si (str_igual(nombre, "file_write")) { retornar "escribir_archivo" }
    si (str_igual(nombre, "file_read")) { retornar "leer_archivo" }
    si (str_igual(nombre, "file_exists")) { retornar "existe_archivo" }
    retornar 0
}

// ── Emisión de bytes ──────────────────────────────────────────────────────

funcion e1(c, b) {
    str_agregar_byte(ctx_codigo(c), b)
    retornar 0
}

funcion e2(c, a, b) { e1(c, a) e1(c, b) retornar 0 }
funcion e3(c, a, b, d) { e1(c, a) e1(c, b) e1(c, d) retornar 0 }
funcion e4(c, a, b, d, f) { e1(c, a) e1(c, b) e1(c, d) e1(c, f) retornar 0 }
funcion e5(c, a, b, d, f, g) { e1(c, a) e1(c, b) e1(c, d) e1(c, f) e1(c, g) retornar 0 }

funcion e32(c, valor) {
    e1(c, __y_bits(valor, 255))
    e1(c, __y_bits(__desplazar_der(valor, 8), 255))
    e1(c, __y_bits(__desplazar_der(valor, 16), 255))
    e1(c, __y_bits(__desplazar_der(valor, 24), 255))
    retornar 0
}

funcion bytes_le(s, valor, cantidad) {
    sea i = 0
    mientras (i < cantidad) {
        str_agregar_byte(s, __y_bits(__desplazar_der(valor, i * 8), 255))
        i = i + 1
    }
    retornar 0
}

funcion parchear32(s, posicion, valor) {
    sea d = str_datos(s) + posicion
    __guardar8(d, __y_bits(valor, 255))
    __guardar8(d + 1, __y_bits(__desplazar_der(valor, 8), 255))
    __guardar8(d + 2, __y_bits(__desplazar_der(valor, 16), 255))
    __guardar8(d + 3, __y_bits(__desplazar_der(valor, 24), 255))
    retornar 0
}

funcion parchear64(s, posicion, valor) {
    parchear32(s, posicion, valor)
    parchear32(s, posicion + 4, __desplazar_der(valor, 32))
    retornar 0
}

funcion posicion_codigo(c) { retornar str_largo(ctx_codigo(c)) }

// ── Etiquetas y arreglos ──────────────────────────────────────────────────

funcion nueva_etiqueta(c) {
    sea etiquetas = __cargar64(c + 40)
    vec_agregar(etiquetas, 0 - 1)
    retornar vec_largo(etiquetas) - 1
}

funcion definir_etiqueta(c, etiqueta) {
    // WebAssembly: cada etiqueta empieza un bloque y su "dirección" es el
    // número del bloque (ver gen_wasm.cfv).
    si (es_wasm(c)) {
        vec_fijar(__cargar64(c + 40), etiqueta, w_nuevo_bloque(c))
        retornar 0
    }
    vec_fijar(__cargar64(c + 40), etiqueta, posicion_codigo(c))
    retornar 0
}

funcion nuevo_arreglo(c, tipo, valor) {
    sea a = mem_reservar(24)
    __guardar64(a, posicion_codigo(c))
    __guardar64(a + 8, tipo)
    __guardar64(a + 16, valor)
    vec_agregar(__cargar64(c + 32), a)
    e32(c, 0)
    retornar 0
}

// tipo 0: rel32 a etiqueta · 1: dirección en datos · 2: dirección en globales
funcion ref_etiqueta(c, etiqueta) { retornar nuevo_arreglo(c, 0, etiqueta) }
funcion ref_dato(c, desplazamiento) { retornar nuevo_arreglo(c, 1, desplazamiento) }
funcion ref_global(c, desplazamiento) { retornar nuevo_arreglo(c, 2, desplazamiento) }

// ── Funciones y variables ─────────────────────────────────────────────────

// Registro de función: [nombre][etiqueta][parámetros][modo]
funcion indice_funcion(c, nombre) {
    sea funciones = __cargar64(c + 48)
    sea i = 0
    mientras (i < vec_largo(funciones)) {
        si (str_igual(__cargar64(vec_obtener(funciones, i)), nombre)) { retornar i }
        i = i + 1
    }
    retornar 0 - 1
}

funcion buscar_funcion(c, nombre) {
    sea i = indice_funcion(c, nombre)
    si (i < 0) { retornar 0 }
    retornar vec_obtener(__cargar64(c + 48), i)
}

// Cada definición recibe su propio registro (en orden). Si el programa
// dinámico define una función con el nombre de una del lenguaje (puente),
// la del programa tiene prioridad, como en el intérprete.
funcion registrar_funcion(c, nombre, parametros, modo) {
    sea f = mem_reservar(64)
    __guardar64(f + 32, 0)
    __guardar64(f + 40, 0)
    __guardar64(f + 48, 0)
    __guardar64(f + 56, 0 - 1)
    __guardar64(f, nombre)
    __guardar64(f + 8, nueva_etiqueta(c))
    __guardar64(f + 16, parametros)
    __guardar64(f + 24, modo)
    __guardar64(f + 56, vec_largo(__cargar64(c + 144)))
    vec_agregar(__cargar64(c + 144), f)
    sea funciones = __cargar64(c + 48)
    sea i = indice_funcion(c, nombre)
    si (i < 0) {
        vec_agregar(funciones, f)
        retornar f
    }
    sea previa = __cargar64(vec_obtener(funciones, i) + 24)
    // El programa (2) tiene prioridad sobre el lenguaje (1 puente, 3 biblioteca).
    si ((previa == 1 o previa == 3) y modo == 2) {
        vec_fijar(funciones, i, f)
        retornar f
    }
    si (previa == 2 y (modo == 1 o modo == 3)) { retornar f }
    rt_panico(str_concatenar("función definida dos veces: ", nombre))
    retornar f
}

// Primera lectura rápida: registra cada "funcion nombre(...)" y su aridad
// para permitir llamadas hacia adelante.
funcion registrar_funciones(c) {
    sea tokens = __cargar64(c)
    sea i = 0
    sea profundidad = 0
    sea modo = 0
    mientras (i < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, i)
        sea lex = __cargar64(t + 8)
        si (__cargar64(t) == 4 y str_igual(lex, "{")) { profundidad = profundidad + 1 }
        si (__cargar64(t) == 4 y str_igual(lex, "}")) { profundidad = profundidad - 1 }
        si (profundidad == 0 y __cargar64(t) == 1 y str_igual(lex, "__dialecto")) {
            modo = numero_literal(__cargar64(vec_obtener(tokens, i + 1) + 8))
        }
        si (profundidad == 0 y modo >= 2 y __cargar64(t) == 1 y (str_igual(lex, "clase") o str_igual(lex, "estructura")) y __cargar64(vec_obtener(tokens, i + 1)) == 1) {
            i = registrar_clase(c, i)
        }
        si (profundidad == 0 y modo >= 2 y __cargar64(t) == 1 y str_igual(lex, "sea") y __cargar64(vec_obtener(tokens, i + 1)) == 1) {
            sea global = __cargar64(vec_obtener(tokens, i + 1) + 8)
            si (indice_global(c, global) < 0) { vec_agregar(__cargar64(c + 224), global) }
        }
        si (modo >= 2 y __cargar64(t) == 1 y str_igual(lex, "extern") y __cargar64(vec_obtener(tokens, i + 1)) == 3) {
            registrar_externa(c, i)
            i = i + 2
        }
        si (profundidad == 0 y __cargar64(t) == 1 y str_igual(lex, "funcion") y __cargar64(vec_obtener(tokens, i + 1)) == 1) {
            sea nombre = __cargar64(vec_obtener(tokens, i + 1) + 8)
            sea abre = i + 2
            sea fin_gen = fin_genericos(tokens, abre)
            si (fin_gen >= 0) { abre = fin_gen + 1 }
            sea f = registrar_funcion(c, nombre, contar_parametros(tokens, abre + 1), modo)
            __guardar64(f + 32, es_variadica(tokens, abre + 1))
            si (modo >= 2) {
                sea firma = firma_tipos(tokens, abre + 1)
                __guardar64(f + 40, __cargar64(firma))
                __guardar64(f + 48, __cargar64(firma + 8))
            }
            registrar_atributos(c, tokens, i, nombre)
            i = i + 1
        }
        i = i + 1
    }
    finalizar_clases(c)
    retornar 0
}

funcion lexema_en(tokens, i) { retornar __cargar64(vec_obtener(tokens, i) + 8) }

// ¿Tiene la firma un parámetro "...resto"? (j apunta tras el "(")
funcion es_variadica(tokens, j) {
    sea nivel = 1
    mientras (nivel > 0) {
        sea t = vec_obtener(tokens, j)
        si (es_simbolo(t, "(")) { nivel = nivel + 1 }
        si (es_simbolo(t, ")")) { nivel = nivel - 1 }
        si (nivel == 1 y es_simbolo(t, ".") y es_simbolo(vec_obtener(tokens, j + 1), ".") y es_simbolo(vec_obtener(tokens, j + 2), ".")) { retornar 1 }
        j = j + 1
    }
    retornar 0
}

// #[Atributo("a", "b")] antes de "funcion nombre" (i apunta a "funcion").
funcion registrar_atributos(c, tokens, i, nombre) {
    si (i < 2) { retornar 0 }
    si (es_simbolo(vec_obtener(tokens, i - 1), "]") == 0) { retornar 0 }
    sea j = i - 1
    sea hallado = 0
    mientras (j > 0 y hallado == 0) {
        si (es_simbolo(vec_obtener(tokens, j - 1), "#") y es_simbolo(vec_obtener(tokens, j), "[")) { hallado = 1 } sino { j = j - 1 }
    }
    si (hallado == 0) { retornar 0 }
    sea atributo = lexema_en(tokens, j + 1)
    sea argumentos = vec_nuevo()
    sea k = j + 2
    mientras (k < i - 1) {
        si (__cargar64(vec_obtener(tokens, k)) == 3) { vec_agregar(argumentos, lexema_en(tokens, k)) }
        k = k + 1
    }
    sea a = mem_reservar(24)
    __guardar64(a, atributo)
    __guardar64(a + 8, argumentos)
    __guardar64(a + 16, nombre)
    vec_agregar(__cargar64(c + 288), a)
    retornar 0
}

// Fin (token "," o ")" del nivel) de un valor por defecto que empieza en j.
funcion fin_valor_defecto(tokens, j) {
    sea nivel = 0
    mientras (verdadero) {
        sea t = vec_obtener(tokens, j)
        si (__cargar64(t) == 5) { retornar j }
        si (es_simbolo(t, "(") o es_simbolo(t, "[") o es_simbolo(t, "{")) { nivel = nivel + 1 }
        si (es_simbolo(t, ")") o es_simbolo(t, "]") o es_simbolo(t, "}")) {
            si (nivel == 0) { retornar j }
            nivel = nivel - 1
        }
        si (nivel == 0 y es_simbolo(t, ",")) { retornar j }
        j = j + 1
    }
    retornar j
}

// Parámetros de una firma; j apunta al token siguiente a '('.
funcion contar_parametros(tokens, j) {
    sea parametros = 0
    sea angulos = 0
    sea nivel = 1
    mientras (nivel > 0) {
        sea u = vec_obtener(tokens, j)
        sea ul = __cargar64(u + 8)
        si (__cargar64(u) == 4 y str_igual(ul, "(")) { nivel = nivel + 1 }
        si (__cargar64(u) == 4 y str_igual(ul, ")")) { nivel = nivel - 1 }
        si (nivel == 1 y es_simbolo(u, "<")) { angulos = angulos + 1 }
        si (nivel == 1 y es_simbolo(u, ">")) { angulos = angulos - 1 }
        // Un nombre de parámetro va tras "(", "," o "..." (no en el tipo).
        si (nivel == 1 y angulos == 0 y __cargar64(u) == 1) {
            sea previo = lexema_en(tokens, j - 1)
            si (str_igual(previo, "(") o str_igual(previo, ",") o str_igual(previo, ".")) { parametros = parametros + 1 }
        }
        si (nivel == 1 y es_simbolo(u, "=")) { j = fin_valor_defecto(tokens, j + 1) - 1 }
        j = j + 1
    }
    retornar parametros
}

// ── Funciones externas (extern "lib" funcion f(x: tipo): tipo) ─────────────
// El ejecutable se enlaza dinámicamente con la biblioteca (PT_INTERP,
// PT_DYNAMIC, símbolos débiles y GOT). Una envoltura convierte los valores
// del lenguaje a la ABI System V AMD64 y de vuelta.

// extern "lib" funcion nombre(parámetros) [: tipo] [como "símbolo"]
// Registro: [símbolo][biblioteca][etiqueta][casilla][original][nombre]
funcion registrar_externa(c, i) {
    sea tokens = __cargar64(c)
    sea nombre = lexema_en(tokens, i + 3)
    sea simbolo = simbolo_externo(tokens, i, nombre)
    // Repetir una declaración (como un prototipo de C) reutiliza la primera.
    sea externas = __cargar64(c + 256)
    sea k = 0
    mientras (k < vec_largo(externas)) {
        sea previa_e = vec_obtener(externas, k)
        si (__cargar64(previa_e + 32) == 0 y str_igual(__cargar64(previa_e + 40), nombre)) {
            sea alias = mem_reservar(48)
            __guardar64(alias + 40, nombre)
            __guardar64(alias, simbolo)
            __guardar64(alias + 8, __cargar64(previa_e + 8))
            __guardar64(alias + 16, __cargar64(previa_e + 16))
            __guardar64(alias + 24, 0 - 1)
            __guardar64(alias + 32, previa_e)
            vec_agregar(externas, alias)
            retornar 0
        }
        k = k + 1
    }
    // Una externa reemplaza a una función del lenguaje con el mismo nombre.
    sea previa = indice_funcion(c, nombre)
    si (previa >= 0) {
        sea modo_previo = __cargar64(vec_obtener(__cargar64(c + 48), previa) + 24)
        si (modo_previo != 1 y modo_previo != 3) {
            rt_panico(str_concatenar("función externa definida dos veces: ", nombre))
        }
    }
    sea e = mem_reservar(48)
    __guardar64(e + 40, nombre)
    __guardar64(e, simbolo)
    __guardar64(e + 8, decodificar_literal(lexema_en(tokens, i + 1)))
    __guardar64(e + 16, nueva_etiqueta(c))
    __guardar64(e + 24, 0 - 1)
    __guardar64(e + 32, 0)
    vec_agregar(__cargar64(c + 256), e)
    casillas_dl(c)
    sea f = mem_reservar(64)
    __guardar64(f + 32, 0)
    __guardar64(f + 40, 0)
    __guardar64(f + 48, 0)
    __guardar64(f + 56, 0 - 1)
    __guardar64(f, nombre)
    __guardar64(f + 8, __cargar64(e + 16))
    __guardar64(f + 16, contar_parametros(tokens, i + 5))
    __guardar64(f + 24, 2)
    si (previa >= 0) { vec_fijar(__cargar64(c + 48), previa, f) } sino { vec_agregar(__cargar64(c + 48), f) }
    retornar 0
}

// Símbolo C de una declaración externa: el texto tras "como"/"as" después
// de la firma, o el mismo nombre.
funcion simbolo_externo(tokens, i, nombre) {
    sea j = i + 5
    sea nivel = 1
    mientras (nivel > 0 y j < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, j)
        si (__cargar64(t) == 5) { retornar nombre }
        si (__cargar64(t) == 4 y str_igual(__cargar64(t + 8), "(")) { nivel = nivel + 1 }
        si (__cargar64(t) == 4 y str_igual(__cargar64(t + 8), ")")) { nivel = nivel - 1 }
        j = j + 1
    }
    si (j + 1 < vec_largo(tokens) y es_simbolo(vec_obtener(tokens, j), ":")) { j = j + 2 }
    si (j + 1 < vec_largo(tokens) y __cargar64(vec_obtener(tokens, j)) == 1 y (str_igual(lexema_en(tokens, j), "como") o str_igual(lexema_en(tokens, j), "as")) y __cargar64(vec_obtener(tokens, j + 1)) == 3) {
        retornar decodificar_literal(lexema_en(tokens, j + 1))
    }
    retornar nombre
}

// Dos casillas en datos que el enlazador dinámico llena con dlopen y dlsym.
funcion casillas_dl(c) {
    si (__cargar64(c + 272) >= 0) { retornar __cargar64(c + 272) }
    sea datos = ctx_datos(c)
    mientras (str_largo(datos) % 8 != 0) { str_agregar_byte(datos, 0) }
    __guardar64(c + 272, str_largo(datos))
    bytes_le(datos, 0, 16)
    retornar __cargar64(c + 272)
}

// rax ← dirección de la función externa e (se resuelve en el primer uso).
funcion asegurar_externa(c, e) {
    // WebAssembly: las externas son importaciones del módulo (no hay dlopen).
    si (es_wasm(c)) { retornar 0 }
    sea listo = nueva_etiqueta(c)
    op_cargar_dato(c, __cargar64(e + 24))
    op_saltar_si_no_cero(c, listo)
    cargar_texto_crudo(c, __cargar64(e))
    empujar(c)
    cargar_texto_crudo(c, nombre_biblioteca(__cargar64(e + 8)))
    empujar(c)
    llamar_runtime(c, "dyn_extern_resolver", 2)
    op_guardar_dato(c, __cargar64(e + 24))
    definir_etiqueta(c, listo)
    retornar 0
}

// Biblioteca compartida: "libc" → libc.so.6, "libm" → libm.so.6,
// "sqlite3" → libsqlite3.so, o el nombre tal cual si ya es un .so.
funcion nombre_biblioteca_windows(nombre) {
    si (str_igual(nombre, "libc") o str_igual(nombre, "c") o str_igual(nombre, "libm") o str_igual(nombre, "m")) { retornar "msvcrt.dll" }
    si (str_buscar_en(nombre, ".dll") >= 0 o str_buscar_en(nombre, "/") >= 0 o str_buscar_en(nombre, "\\") >= 0) { retornar nombre }
    retornar str_concatenar(nombre, ".dll")
}

funcion nombre_biblioteca_macos(nombre) {
    si (str_igual(nombre, "libc") o str_igual(nombre, "c") o str_igual(nombre, "libm") o str_igual(nombre, "m")) { retornar "/usr/lib/libSystem.B.dylib" }
    si (str_buscar_en(nombre, ".dylib") >= 0 o str_buscar_en(nombre, "/") >= 0) { retornar nombre }
    sea r = str_nuevo(16)
    si (str_largo(nombre) < 3 o str_igual(str_rebanar(nombre, 0, 3), "lib") == 0) { str_agregar(r, "lib") }
    str_agregar(r, nombre)
    str_agregar(r, ".dylib")
    retornar r
}

funcion nombre_biblioteca(nombre) {
    si (mem_global(33) == 1) { retornar nombre_biblioteca_windows(nombre) }
    si (es_darwin_numero(mem_global(33))) { retornar nombre_biblioteca_macos(nombre) }
    si (str_igual(nombre, "libc") o str_igual(nombre, "c")) { retornar "libc.so.6" }
    si (str_igual(nombre, "libm") o str_igual(nombre, "m")) { retornar "libm.so.6" }
    si (str_buscar_en(nombre, ".so") >= 0 o str_buscar_en(nombre, "/") >= 0) { retornar nombre }
    sea r = str_nuevo(16)
    si (str_largo(nombre) < 3 o str_igual(str_rebanar(nombre, 0, 3), "lib") == 0) { str_agregar(r, "lib") }
    str_agregar(r, nombre)
    str_agregar(r, ".so")
    retornar r
}

funcion str_buscar_en(pajar, aguja) {
    sea i = 0
    mientras (i + str_largo(aguja) <= str_largo(pajar)) {
        si (str_igual(str_rebanar(pajar, i, i + str_largo(aguja)), aguja)) { retornar i }
        i = i + 1
    }
    retornar 0 - 1
}

// Clase de un tipo C: 0 entero de 64 bits (largo, puntero) · 1 flotante
// (numero) · 2 texto (char*) · 3 booleano · 4 nulo · 5 entero de 32 bits
funcion clase_tipo(c, tipo) {
    si (str_igual(tipo, "numero") o str_igual(tipo, "flotante") o str_igual(tipo, "doble") o str_igual(tipo, "number") o str_igual(tipo, "double") o str_igual(tipo, "float")) { retornar 1 }
    si (str_igual(tipo, "texto") o str_igual(tipo, "cadena") o str_igual(tipo, "string")) { retornar 2 }
    si (str_igual(tipo, "booleano") o str_igual(tipo, "bool") o str_igual(tipo, "boolean")) { retornar 3 }
    si (str_igual(tipo, "nulo") o str_igual(tipo, "vacio") o str_igual(tipo, "void") o str_igual(tipo, "null")) { retornar 4 }
    si (str_igual(tipo, "entero") o str_igual(tipo, "int")) { retornar 5 }
    si (str_igual(tipo, "largo") o str_igual(tipo, "puntero") o str_igual(tipo, "long") o str_igual(tipo, "pointer") o str_igual(tipo, "size_t")) { retornar 0 }
    error_en(c, str_concatenar("tipo C no soportado en extern: ", tipo))
    retornar 0
}

funcion declaracion_externa(c) {
    // --release: una función con declaraciones extern siempre se emite.
    si (__cargar64(c + 408) != 0 y __cargar64(c + 400) >= 0) {
        vec_agregar(vec_obtener(__cargar64(c + 408), 0), __cargar64(c + 400))
    }
    requerir(c, "extern")
    avanzar(c)
    requerir(c, "funcion")
    requerir_ident(c)
    sea e = vec_obtener(__cargar64(c + 256), __cargar64(c + 264))
    __guardar64(c + 264, __cargar64(c + 264) + 1)
    si (__cargar64(e + 32) != 0) {
        // Declaración repetida: solo saltar la firma y resolver.
        mientras (ver(c, ")") == 0) { avanzar(c) }
        requerir(c, ")")
        si (tomar(c, ":")) { requerir_ident(c) }
        si (tomar(c, "como") o tomar(c, "as")) { avanzar(c) }
        tomar(c, ";")
        sea original = __cargar64(e + 32)
        si (__cargar64(original + 24) >= 0) { asegurar_externa(c, original) }
        retornar 0
    }
    // Firma: tipos de los parámetros y del resultado.
    sea tipos = vec_nuevo()
    requerir(c, "(")
    si (ver(c, ")") == 0) {
        sea seguir = 1
        mientras (seguir) {
            requerir_ident(c)
            requerir(c, ":")
            vec_agregar(tipos, clase_tipo(c, requerir_ident(c)))
            seguir = tomar(c, ",")
        }
    }
    requerir(c, ")")
    sea resultado = 4
    si (tomar(c, ":")) { resultado = clase_tipo(c, requerir_ident(c)) }
    si (tomar(c, "como") o tomar(c, "as")) { avanzar(c) }
    tomar(c, ";")
    // Casilla con la dirección de la función (se llena en el primer uso).
    sea datos = ctx_datos(c)
    mientras (str_largo(datos) % 8 != 0) { str_agregar_byte(datos, 0) }
    sea casilla = str_largo(datos)
    bytes_le(datos, 0, 8)
    __guardar64(e + 24, casilla)
    // Envoltura con la convención del lenguaje.
    sea n = vec_largo(tipos)
    sea saltar = saltar_por_encima(c)
    sea ocultos = vec_nuevo()
    sea i = 0
    mientras (i < n) {
        vec_agregar(ocultos, str_nuevo(0))
        i = i + 1
    }
    sea estado = abrir_funcion(c, __cargar64(e + 16), ocultos)
    asegurar_externa(c, e)
    sea convertidos = vec_nuevo()
    i = 0
    mientras (i < n) {
        sea clase = vec_obtener(tipos, i)
        cargar_local(c, 16 + (n - 1 - i) * 8)
        empujar(c)
        si (clase == 1) { llamar_runtime(c, "dyn_a_f64", 1) }
        si (clase == 2) { llamar_runtime(c, "dyn_texto_c", 1) }
        si (clase == 0 o clase == 3 o clase == 4 o clase == 5) { llamar_runtime(c, "dyn_entero_c", 1) }
        sea d = declarar_local(c, str_nuevo(0))
        guardar_local(c, d)
        vec_agregar(convertidos, d)
        i = i + 1
    }
    __guardar64(c + 448, resultado)
    op_llamada_externa(c, casilla, tipos, convertidos)
    si (resultado == 1) {
        op_resultado_flotante(c)
        empujar(c)
        llamar_runtime(c, "dyn_desde_f64", 1)
    }
    si (resultado == 5) {
        op_extender32(c)
        op_etiquetar(c, 1)
    }
    si (resultado == 0) {
        empujar(c)
        llamar_runtime(c, "dyn_entero_desde_c", 1)
    }
    si (resultado == 2) {
        empujar(c)
        llamar_runtime(c, "dyn_texto_desde_c", 1)
    }
    si (resultado == 3) {
        op_byte_bajo(c)
        op_no_cero(c)
        booleano_dinamico(c)
    }
    si (resultado == 4) { cargar_inmediato(c, 0) }
    epilogo(c)
    cerrar_funcion(c, estado)
    vec_liberar(ocultos)
    definir_etiqueta(c, saltar)
    // Al ejecutarse la declaración se resuelve: error capturable si la
    // biblioteca o el símbolo no existen.
    asegurar_externa(c, e)
    retornar 0
}

// ── Clases ────────────────────────────────────────────────────────────────
// Registro de clase (compilador):
//  0 nombre   8 padre (nombre o 0)   16 métodos [nombre][etiqueta][aridad]
// 24 campos (nombres)   32 etiqueta del constructor   40 etiqueta de campos
// 48 es estructura      56 inicializadores de campos  64 método siguiente
// Una instancia es un mapa del lenguaje con la clave "__clase" (igual que
// en el intérprete); los métodos se buscan en tiempo de ejecución en la
// tabla de clases del ejecutable, subiendo por la cadena de herencia.

funcion buscar_clase(c, nombre) {
    sea clases = __cargar64(c + 160)
    sea i = 0
    mientras (i < vec_largo(clases)) {
        sea k = vec_obtener(clases, i)
        si (str_igual(__cargar64(k), nombre)) { retornar k }
        i = i + 1
    }
    retornar 0
}

// Registra "clase Nombre [extiende Padre] [implementa ...] { ... }" y
// devuelve la posición de su '}' final.
funcion registrar_clase(c, i) {
    sea tokens = __cargar64(c)
    sea k = mem_reservar(72)
    __guardar64(k, lexema_en(tokens, i + 1))
    __guardar64(k + 8, 0)
    __guardar64(k + 16, vec_nuevo())
    __guardar64(k + 24, vec_nuevo())
    __guardar64(k + 32, nueva_etiqueta(c))
    __guardar64(k + 40, nueva_etiqueta(c))
    __guardar64(k + 48, str_igual(lexema_en(tokens, i), "estructura"))
    __guardar64(k + 56, vec_nuevo())
    __guardar64(k + 64, 0)
    si (buscar_clase(c, __cargar64(k)) != 0) {
        rt_panico(str_concatenar("clase definida dos veces: ", __cargar64(k)))
    }
    sea j = i + 2
    mientras (str_igual(lexema_en(tokens, j), "{") == 0) {
        si (str_igual(lexema_en(tokens, j), "extiende")) { __guardar64(k + 8, lexema_en(tokens, j + 1)) }
        j = j + 1
    }
    j = j + 1
    sea nivel = 1
    mientras (nivel > 0) {
        sea t = vec_obtener(tokens, j)
        sea lex = __cargar64(t + 8)
        si (__cargar64(t) == 5) { rt_panico(str_concatenar("falta '}' en la clase ", __cargar64(k))) }
        si (__cargar64(t) == 4 y str_igual(lex, "{")) { nivel = nivel + 1 }
        si (__cargar64(t) == 4 y str_igual(lex, "}")) { nivel = nivel - 1 }
        si (nivel == 1 y __cargar64(t) == 1) {
            sea siguiente = vec_obtener(tokens, j + 1)
            si ((str_igual(lex, "funcion") o str_igual(lex, "metodo")) y __cargar64(siguiente) == 1) {
                sea m = mem_reservar(24)
                __guardar64(m, __cargar64(siguiente + 8))
                __guardar64(m + 8, nueva_etiqueta(c))
                __guardar64(m + 16, contar_parametros(tokens, j + 3) + 1)
                vec_agregar(__cargar64(k + 16), m)
                j = j + 1
            } sino {
                si (str_igual(lex, "sea") o str_igual(lex, "campo")) {
                    vec_agregar(__cargar64(k + 24), __cargar64(siguiente + 8))
                    j = j + 1
                } sino {
                    si (__cargar64(k + 48) y __cargar64(siguiente) == 4 y str_igual(__cargar64(siguiente + 8), ":")) {
                        vec_agregar(__cargar64(k + 24), lex)
                        j = j + 2
                    }
                }
            }
        }
        j = j + 1
    }
    vec_agregar(__cargar64(c + 160), k)
    retornar j - 1
}

// Método con ese nombre en la clase o en sus ancestros (0 si no existe).
funcion metodo_en_cadena(c, k, nombre) {
    mientras (k != 0) {
        sea metodos = __cargar64(k + 16)
        sea i = 0
        mientras (i < vec_largo(metodos)) {
            sea m = vec_obtener(metodos, i)
            si (str_igual(__cargar64(m), nombre)) { retornar m }
            i = i + 1
        }
        si (__cargar64(k + 8) == 0) {
            k = 0
        } sino {
            sea padre = buscar_clase(c, __cargar64(k + 8))
            si (padre == 0) { rt_panico(str_concatenar("clase padre desconocida: ", __cargar64(k + 8))) }
            k = padre
        }
    }
    retornar 0
}

// Cada clase es también una función constructora: Nombre(args).
funcion finalizar_clases(c) {
    sea clases = __cargar64(c + 160)
    sea i = 0
    mientras (i < vec_largo(clases)) {
        sea k = vec_obtener(clases, i)
        sea aridad = 0
        sea ctor = metodo_en_cadena(c, k, "constructor")
        si (ctor != 0) {
            aridad = __cargar64(ctor + 16) - 1
        } sino {
            si (__cargar64(k + 48)) { aridad = vec_largo(__cargar64(k + 24)) }
        }
        si (buscar_funcion(c, __cargar64(k)) != 0) {
            rt_panico(str_concatenar("nombre usado por una clase y una función: ", __cargar64(k)))
        }
        sea f = mem_reservar(64)
        __guardar64(f + 32, 0)
        __guardar64(f + 40, 0)
        __guardar64(f + 48, 0)
        __guardar64(f + 56, 0 - 1)
        __guardar64(f, __cargar64(k))
        __guardar64(f + 8, __cargar64(k + 32))
        __guardar64(f + 16, aridad)
        __guardar64(f + 24, 2)
        vec_agregar(__cargar64(c + 48), f)
        i = i + 1
    }
    retornar 0
}

// Variable: [nombre][desplazamiento]
// ── Variables ─────────────────────────────────────────────────────────────
// Marco de función: [base de locales][celdas][capturas][padre][es cierre]
//                   [desplazamiento del entorno]
// En un marco con celdas (funciones que contienen funciones anónimas) cada
// variable vive en una celda del heap, así los cierres la comparten por
// referencia. Un cierre recibe su entorno como primer parámetro oculto.

funcion marco_nuevo(base, celdas, padre, es_cierre) {
    sea m = mem_reservar(56)
    __guardar64(m + 48, 0)
    __guardar64(m, base)
    __guardar64(m + 8, celdas)
    __guardar64(m + 16, vec_nuevo())
    __guardar64(m + 24, padre)
    __guardar64(m + 32, es_cierre)
    __guardar64(m + 40, 0)
    retornar m
}

// Variable: [nombre][desplazamiento][en celda]
funcion declarar_variable(c, nombre, desplazamiento) {
    anotar_tipo_variable(c, nombre, __cargar64(c + 368))
    __guardar64(c + 368, 0)
    sea v = mem_reservar(24)
    __guardar64(v, nombre)
    __guardar64(v + 8, desplazamiento)
    __guardar64(v + 16, 0)
    vec_agregar(__cargar64(c + 56), v)
    retornar desplazamiento
}

funcion declarar_local(c, nombre) {
    __guardar64(c + 64, __cargar64(c + 64) + 1)
    retornar declarar_variable(c, nombre, 0 - __cargar64(c + 64) * 8)
}

funcion marcar_ultima_celda(c) {
    sea locales = __cargar64(c + 56)
    __guardar64(vec_obtener(locales, vec_largo(locales) - 1) + 16, 1)
    retornar 0
}

// Declara una variable del programa con el valor de rax.
funcion declarar_usuario(c, nombre) {
    si (__cargar64(__cargar64(c + 216) + 8)) {
        empujar(c)
        llamar_runtime(c, "dyn_celda_nueva", 1)
        guardar_local(c, declarar_local(c, nombre))
        marcar_ultima_celda(c)
        retornar 0
    }
    guardar_local(c, declarar_local(c, nombre))
    retornar 0
}

funcion indice_global(c, nombre) {
    sea globales = __cargar64(c + 224)
    sea i = 0
    mientras (i < vec_largo(globales)) {
        si (str_igual(vec_obtener(globales, i), nombre)) { retornar i }
        i = i + 1
    }
    retornar 0 - 1
}

funcion acceso(tipo, valor) {
    sea a = mem_reservar(16)
    __guardar64(a, tipo)
    __guardar64(a + 8, valor)
    retornar a
}

// Busca en los locales [base, tope) del marco; si es un cierre, en sus
// capturas y luego en los marcos que lo rodean.
// Acceso: 0 local · 1 local en celda · 2 captura i · 3 global i
funcion resolver_en(c, marco, tope, nombre) {
    sea locales = __cargar64(c + 56)
    sea i = tope - 1
    mientras (i >= __cargar64(marco)) {
        sea v = vec_obtener(locales, i)
        si (str_igual(__cargar64(v), nombre)) { retornar acceso(__cargar64(v + 16), __cargar64(v + 8)) }
        i = i - 1
    }
    si (__cargar64(marco + 32) == 0) { retornar 0 }
    sea capturas = __cargar64(marco + 16)
    i = 0
    mientras (i < vec_largo(capturas)) {
        si (str_igual(vec_obtener(capturas, i), nombre)) { retornar acceso(2, i) }
        i = i + 1
    }
    sea externo = resolver_en(c, __cargar64(marco + 24), __cargar64(marco), nombre)
    si (externo == 0) { retornar 0 }
    si (__cargar64(externo) == 0) {
        error_en(c, str_concatenar("una función anónima no puede capturar esta variable: ", nombre))
    }
    vec_agregar(capturas, nombre)
    retornar acceso(2, vec_largo(capturas) - 1)
}

funcion resolver(c, nombre) {
    sea r = resolver_en(c, __cargar64(c + 216), vec_largo(__cargar64(c + 56)), nombre)
    si (r != 0) { retornar r }
    si (dinamico(c)) {
        sea g = indice_global(c, nombre)
        si (g >= 0) { retornar acceso(3, g) }
    }
    retornar 0
}

funcion variable(c, nombre) {
    sea r = resolver(c, nombre)
    si (r == 0) { error_en(c, str_concatenar("variable desconocida ", nombre)) }
    retornar r
}

// rax ← puntero a la celda de una captura del cierre actual.
funcion cargar_celda_captura(c, i) {
    cargar_local(c, __cargar64(__cargar64(c + 216) + 40))
    op_cargar(c, 0, 0, 8)                                      // a ← [a + 8]
    op_cargar32(c, 0, 0, 24 + i * 8)
    retornar 0
}

funcion cargar_var(c, a) {
    sea tipo = __cargar64(a)
    sea valor = __cargar64(a + 8)
    si (tipo == 0) { cargar_local(c, valor) retornar 0 }
    si (tipo == 1) {
        cargar_local(c, valor)
        op_cargar(c, 0, 0, 0)
        retornar 0
    }
    si (tipo == 2) {
        cargar_celda_captura(c, valor)
        op_cargar(c, 0, 0, 0)
        retornar 0
    }
    op_cargar_global(c, 512 + valor * 8)
    retornar 0
}

funcion guardar_var(c, a) {
    sea tipo = __cargar64(a)
    sea valor = __cargar64(a + 8)
    si (tipo == 0) { guardar_local(c, valor) retornar 0 }
    si (tipo == 1) {
        op_cargar32(c, 1, 5, valor)                            // b ← [marco + d]
        op_guardar(c, 1, 0, 0)                                 // [b] ← a
        retornar 0
    }
    si (tipo == 2) {
        empujar(c)
        cargar_celda_captura(c, valor)
        op_mov(c, 1, 0)
        op_sacar(c, 0)
        op_guardar(c, 1, 0, 0)
        retornar 0
    }
    op_guardar_global(c, 512 + valor * 8)
    retornar 0
}

// rax ← celda (no su valor) de una variable, para entregarla a un cierre.
funcion cargar_celda(c, a) {
    si (__cargar64(a) == 1) { cargar_local(c, __cargar64(a + 8)) retornar 0 }
    si (__cargar64(a) == 2) { cargar_celda_captura(c, __cargar64(a + 8)) retornar 0 }
    error_en(c, "variable no capturable")
    retornar 0
}

funcion cargar_local(c, d) { retornar op_cargar32(c, 0, 5, d) }
funcion guardar_local(c, d) { retornar op_guardar32(c, 5, d, 0) }

funcion cargar_inmediato(c, valor) {
    op_inmediato(c, valor)
    retornar 0
}

// ── Literales de texto ────────────────────────────────────────────────────

funcion decodificar_literal(lexema) {
    sea r = str_nuevo(str_largo(lexema))
    sea i = 1
    sea fin = str_largo(lexema) - 1
    mientras (i < fin) {
        sea b = str_byte(lexema, i)
        si (b == 92 y i + 1 < fin) {
            sea s = str_byte(lexema, i + 1)
            si (s == 110) {
                str_agregar_byte(r, 10)
            } sino {
                si (s == 116) {
                    str_agregar_byte(r, 9)
                } sino {
                    si (s == 114) {
                        str_agregar_byte(r, 13)
                    } sino {
                        si (s == 48) { str_agregar_byte(r, 0) } sino { str_agregar_byte(r, s) }
                    }
                }
            }
            i = i + 2
        } sino {
            str_agregar_byte(r, b)
            i = i + 1
        }
    }
    retornar r
}

// Literal: [lexema][desplazamiento en datos]
funcion literal(c, lexema) {
    sea literales = __cargar64(c + 72)
    sea i = 0
    mientras (i < vec_largo(literales)) {
        sea l = vec_obtener(literales, i)
        si (str_igual(__cargar64(l), lexema)) { retornar __cargar64(l + 8) }
        i = i + 1
    }
    sea datos = ctx_datos(c)
    mientras (str_largo(datos) % 8 != 0) { str_agregar_byte(datos, 0) }
    sea inicio = str_largo(datos)
    sea bytes = decodificar_literal(lexema)
    bytes_le(datos, str_largo(bytes), 8)
    bytes_le(datos, str_largo(bytes), 8)
    vec_agregar(__cargar64(c + 80), inicio + 16)
    bytes_le(datos, 0, 8)
    bytes_le(datos, 0, 8)
    str_agregar(datos, bytes)
    str_agregar_byte(datos, 0)
    sea registro = mem_reservar(16)
    __guardar64(registro, lexema)
    __guardar64(registro + 8, inicio)
    vec_agregar(literales, registro)
    retornar inicio
}

funcion numero_literal(lexema) {
    sea n = 0
    sea i = 0
    mientras (i < str_largo(lexema)) {
        n = n * 10 + str_byte(lexema, i) - 48
        i = i + 1
    }
    retornar n
}

// Caja [1][texto] en datos para un literal de texto del lenguaje dinámico.
funcion literal_caja(c, lexema) {
    sea cajas = __cargar64(c + 120)
    sea i = 0
    mientras (i < vec_largo(cajas)) {
        sea l = vec_obtener(cajas, i)
        si (str_igual(__cargar64(l), lexema)) { retornar __cargar64(l + 8) }
        i = i + 1
    }
    sea texto = literal(c, lexema)
    sea datos = ctx_datos(c)
    mientras (str_largo(datos) % 8 != 0) { str_agregar_byte(datos, 0) }
    sea caja = str_largo(datos)
    bytes_le(datos, 1, 8)
    sea puntero = mem_reservar(16)
    __guardar64(puntero, str_largo(datos))
    __guardar64(puntero + 8, texto)
    vec_agregar(__cargar64(c + 112), puntero)
    bytes_le(datos, 0, 8)
    sea registro = mem_reservar(16)
    __guardar64(registro, lexema)
    __guardar64(registro + 8, caja)
    vec_agregar(cajas, registro)
    retornar caja
}

// ── Expresiones (resultado en rax) ────────────────────────────────────────

funcion empujar(c) { retornar op_empujar(c) }
funcion rax_a_rcx_y_sacar(c) { op_mov(c, 1, 0) op_sacar(c, 0) retornar 0 }

funcion argumentos(c) {
    requerir(c, "(")
    sea n = 0
    si (ver(c, ")") == 0) {
        expresion(c)
        empujar(c)
        n = 1
        mientras (tomar(c, ",")) {
            expresion(c)
            empujar(c)
            n = n + 1
        }
    }
    requerir(c, ")")
    retornar n
}

// Dos argumentos: el primero en rax y el segundo en rcx.
funcion dos_argumentos(c) {
    sea n = argumentos(c)
    si (n != 2) { error_en(c, "se esperaban 2 argumentos") }
    op_sacar(c, 1)                                                  // pop rcx
    op_sacar(c, 0)                                                  // pop rax
    retornar 0
}

funcion un_argumento(c) {
    sea n = argumentos(c)
    si (n != 1) { error_en(c, "se esperaba 1 argumento") }
    op_sacar(c, 0)                                                  // pop rax
    retornar 0
}

funcion f64_dos(c, operacion) {
    dos_argumentos(c)
    op_f64(c, operacion)
    retornar 0
}

funcion intrinseco(c, nombre) {
    si (str_igual(nombre, "__trampolin_hilo")) {
        // Dirección del trampolín de hilos de Windows (CreateThread).
        argumentos(c)
        si (__cargar64(c + 312) < 0) { __guardar64(c + 312, nueva_etiqueta(c)) }
        op_direccion(c, 4, __cargar64(c + 312))
        retornar 1
    }
    si (str_igual(nombre, "__plataforma")) {
        // Plataforma de destino del ejecutable (ver el campo 296).
        argumentos(c)
        cargar_inmediato(c, __cargar64(c + 296))
        retornar 1
    }
    si (str_igual(nombre, "__libsistema")) {
        llamada_libsistema(c)
        retornar 1
    }
    si (str_igual(nombre, "__winapi")) {
        llamada_winapi(c)
        retornar 1
    }
    si (str_igual(nombre, "__syscall")) {
        si (es_windows(c)) { error_en(c, "__syscall no existe en Windows (usa __winapi)") }
        sea n = argumentos(c)
        si (n < 1 o n > 7) { error_en(c, "__syscall recibe de 1 a 7 argumentos") }
        op_syscall(c, n)
        retornar 1
    }
    si (str_igual(nombre, "__cargar64")) { un_argumento(c) op_cargar(c, 0, 0, 0) retornar 1 }
    si (str_igual(nombre, "__cargar8")) { un_argumento(c) op_cargar8(c) retornar 1 }
    si (str_igual(nombre, "__guardar64")) { dos_argumentos(c) op_guardar(c, 0, 0, 1) retornar 1 }
    si (str_igual(nombre, "__guardar8")) { dos_argumentos(c) op_guardar8(c) retornar 1 }
    si (str_igual(nombre, "__y_bits")) { dos_argumentos(c) op_aritmetica(c, 6) retornar 1 }
    si (str_igual(nombre, "__o_bits")) { dos_argumentos(c) op_aritmetica(c, 7) retornar 1 }
    si (str_igual(nombre, "__xo_bits")) { dos_argumentos(c) op_aritmetica(c, 8) retornar 1 }
    si (str_igual(nombre, "__desplazar_izq")) { dos_argumentos(c) op_aritmetica(c, 9) retornar 1 }
    si (str_igual(nombre, "__desplazar_der")) { dos_argumentos(c) op_aritmetica(c, 10) retornar 1 }
    si (str_igual(nombre, "__desplazar_aritmetico")) { dos_argumentos(c) op_aritmetica(c, 11) retornar 1 }
    si (str_igual(nombre, "__barrera")) {
        // Barrera de memoria: los stores previos (p. ej. borrar secretos)
        // quedan hechos antes de seguir; el compilador no los reordena.
        argumentos(c)
        op_barrera(c)
        retornar 1
    }
    // mem_global(k) / mem_fijar_global(k, v) con k literal (el runtime los
    // llama en cada reserva): acceso directo a la casilla, sin llamada.
    si (dinamico(c) == 0 y str_igual(nombre, "mem_global") y ver(c, "(") y entero_literal_en(__cargar64(c), __cargar64(c + 8) + 1) y str_igual(lexema_en(__cargar64(c), __cargar64(c + 8) + 2), ")")) {
        avanzar(c)
        sea k = numero_literal(__cargar64(avanzar(c) + 8))
        avanzar(c)
        op_cargar_global(c, k * 8)
        retornar 1
    }
    si (dinamico(c) == 0 y str_igual(nombre, "mem_fijar_global") y ver(c, "(") y entero_literal_en(__cargar64(c), __cargar64(c + 8) + 1) y str_igual(lexema_en(__cargar64(c), __cargar64(c + 8) + 2), ",")) {
        avanzar(c)
        sea k = numero_literal(__cargar64(avanzar(c) + 8))
        avanzar(c)
        expresion(c)
        requerir(c, ")")
        op_guardar_global(c, k * 8)
        cargar_inmediato(c, 0)
        retornar 1
    }
    si (str_igual(nombre, "__globales")) {
        argumentos(c)
        op_direccion(c, 2, 0)
        retornar 1
    }
    si (str_igual(nombre, "__intercambiar")) {
        dos_argumentos(c)
        op_intercambiar(c)
        retornar 1
    }
    si (str_igual(nombre, "__pila")) {
        argumentos(c)
        op_mov(c, 0, 4)
        retornar 1
    }
    si (str_igual(nombre, "__dir")) {
        // __dir("funcion"): dirección del código de una función.
        requerir(c, "(")
        sea f = buscar_funcion(c, decodificar_literal(__cargar64(avanzar(c) + 8)))
        requerir(c, ")")
        si (f == 0) { error_en(c, "__dir: función desconocida") }
        referenciar(c, f)
        op_direccion(c, 4, __cargar64(f + 8))
        retornar 1
    }
    si (str_igual(nombre, "__llamar_dir")) {
        // __llamar_dir(dir, a1..an): llamada con la convención del lenguaje.
        sea n = argumentos(c)
        op_cargar32(c, 11, 4, (n - 1) * 8)                     // dirección (el primer argumento)
        op_llamar_reg(c, 11)
        op_liberar_pila(c, n * 8)
        retornar 1
    }
    si (str_igual(nombre, "__hilo")) {
        // __hilo(tope_pila, funcion, arg, tid): clone con hilo nuevo que
        // ejecuta funcion(arg) en su pila y termina; devuelve el tid.
        si (argumentos(c) != 4) { error_en(c, "__hilo recibe 4 argumentos") }
        op_hilo(c)
        retornar 1
    }
    si (str_igual(nombre, "__ccall")) {
        // __ccall(funcion, a1..a12): llamada C con enteros (ABI del sistema).
        sea n = argumentos(c)
        si (n < 1 o n > 13) { error_en(c, "__ccall recibe de 1 a 13 argumentos") }
        op_ccall(c, n)
        retornar 1
    }
    si (str_igual(nombre, "__simbolo_dinamico")) {
        // 0: dlopen · 1: dlsym (0 si el programa no usa extern).
        un_argumento(c)
        op_mov(c, 1, 0)
        op_direccion(c, 1, casillas_dl(c))
        op_cargar_indexado(c, 0)
        retornar 1
    }
    si (str_igual(nombre, "__saltar")) {
        // __saltar(rbp, rsp, destino, valor): restaura el marco y salta.
        si (argumentos(c) != 4) { error_en(c, "__saltar recibe 4 argumentos") }
        op_sacar(c, 0)                                              // pop rax (valor)
        op_sacar(c, 2)                                              // pop rdx (destino)
        op_sacar(c, 1)                                              // pop rcx (rsp)
        op_sacar(c, 6)                                              // pop rsi (rbp)
        op_mov(c, 5, 6)                                        // marco ← e
        op_mov(c, 4, 1)                                        // pila ← b
        op_saltar_reg(c, 2)
        retornar 1
    }
    si (str_igual(nombre, "__clases")) {
        argumentos(c)
        op_direccion(c, 3, 0)
        retornar 1
    }
    si (str_igual(nombre, "__argc")) {
        argumentos(c)
        op_cargar_global(c, 504)
        op_cargar(c, 0, 0, 0)
        retornar 1
    }
    si (str_igual(nombre, "__argv")) {
        un_argumento(c)
        op_mov(c, 1, 0)
        op_cargar_global(c, 504)
        op_cargar_indexado(c, 8)
        retornar 1
    }
    si (str_igual(nombre, "__f64_desde_entero")) {
        un_argumento(c)
        op_f64_desde_entero(c)
        retornar 1
    }
    si (str_igual(nombre, "__f64_a_entero")) {
        un_argumento(c)
        op_f64_a_entero(c)
        retornar 1
    }
    si (str_igual(nombre, "__f64_raiz")) {
        un_argumento(c)
        op_f64_raiz(c)
        retornar 1
    }
    si (str_igual(nombre, "__f64_suma")) { f64_dos(c, 88) retornar 1 }
    si (str_igual(nombre, "__f64_resta")) { f64_dos(c, 92) retornar 1 }
    si (str_igual(nombre, "__f64_mul")) { f64_dos(c, 89) retornar 1 }
    si (str_igual(nombre, "__f64_div")) { f64_dos(c, 94) retornar 1 }
    si (str_igual(nombre, "__f64_menor")) {
        dos_argumentos(c)
        op_f64_menor(c)
        retornar 1
    }
    retornar 0
}

// Índice de una importación de Windows (dll, función), creándola si hace falta.
funcion importacion_windows(c, dll, funcion_win) {
    sea imps = __cargar64(c + 304)
    sea i = 0
    mientras (i < vec_largo(imps)) {
        sea r = vec_obtener(imps, i)
        si (str_igual(__cargar64(r), dll) y str_igual(__cargar64(r + 8), funcion_win)) { retornar i }
        i = i + 1
    }
    sea r = mem_reservar(16)
    __guardar64(r, dll)
    __guardar64(r + 8, funcion_win)
    vec_agregar(imps, r)
    retornar vec_largo(imps) - 1
}

// __libsistema("write", a1, ..., an): función de /usr/lib/libSystem.B.dylib.
funcion llamada_libsistema(c) {
    si (es_macos(c) == 0) { error_en(c, "__libsistema solo existe al compilar para macOS") }
    requerir(c, "(")
    sea simbolo = decodificar_literal(__cargar64(avanzar(c) + 8))
    sea n = 0
    mientras (tomar(c, ",")) {
        expresion(c)
        empujar(c)
        n = n + 1
    }
    requerir(c, ")")
    op_llamar_importada(c, importacion_windows(c, "libSystem", simbolo), n)
    retornar 0
}

// __winapi("kernel32.dll", "WriteFile", a1, ..., an)
funcion llamada_winapi(c) {
    si (es_windows(c) == 0) { error_en(c, "__winapi solo existe al compilar para Windows") }
    requerir(c, "(")
    sea dll = decodificar_literal(__cargar64(avanzar(c) + 8))
    requerir(c, ",")
    sea funcion_win = decodificar_literal(__cargar64(avanzar(c) + 8))
    sea n = 0
    mientras (tomar(c, ",")) {
        expresion(c)
        empujar(c)
        n = n + 1
    }
    requerir(c, ")")
    op_llamar_importada(c, importacion_windows(c, dll, funcion_win), n)
    retornar 0
}

funcion funcion_llamable(c, nombre) {
    sea f = buscar_funcion(c, nombre)
    si (f == 0 y alias_funcion(nombre) != 0) { f = buscar_funcion(c, alias_funcion(nombre)) }
    si (f == 0) { error_en(c, str_concatenar("función desconocida ", nombre)) }
    si (dinamico(c) y __cargar64(f + 24) == 0) {
        error_en(c, str_concatenar("función interna del runtime: ", nombre))
    }
    retornar f
}

// Llama a f con n argumentos ya apilados y los retira.
// Primera pasada de --release: la función actual usa f.
funcion referenciar(c, f) {
    sea refs = __cargar64(c + 408)
    si (refs == 0) { retornar 0 }
    sea i = __cargar64(f + 56)
    si (i < 0) { retornar 0 }
    vec_agregar(vec_obtener(refs, __cargar64(c + 400) + 1), i)
    retornar 0
}

funcion emitir_llamada(c, f, n) {
    referenciar(c, f)
    // En el lenguaje dinámico los argumentos que faltan valen nulo.
    si (dinamico(c) y n < __cargar64(f + 16)) {
        mientras (n < __cargar64(f + 16)) {
            cargar_inmediato(c, 0)
            empujar(c)
            n = n + 1
        }
    }
    si (n != __cargar64(f + 16)) {
        error_en(c, str_concatenar("cantidad de argumentos incorrecta en ", __cargar64(f)))
    }
    op_llamar(c, __cargar64(f + 8))
    si (n > 0) {
        op_liberar_pila(c, n * 8)
    }
    retornar 0
}

// Llamada del compilador a una función del runtime con n argumentos apilados.
// lista[i] con la lista en [pila + 8] y el índice en [pila]: si es una
// lista y un entero dentro del rango, se lee en línea; si no, dyn_indice.
// Comprueba en a: d ← contenedor; deja d = datos de la lista y b = n.
funcion comprobar_lista_en_linea(c, desp_contenedor, desp_indice, lento) {
    op_cargar(c, 0, 4, desp_indice)
    op_y_uno(c)
    op_saltar_si_cero(c, lento)                                // índice no entero
    op_cargar(c, 0, 4, desp_contenedor)
    op_mov(c, 2, 0)
    op_y_uno(c)
    op_saltar_si_no_cero(c, lento)                             // entero, no caja
    sea caja = nueva_etiqueta(c)
    op_mov(c, 0, 2)
    op_constante_rcx(c, 8)
    op_saltar_si_mayor_igual(c, caja)
    op_saltar(c, lento)                                        // nulo o booleano
    definir_etiqueta(c, caja)
    op_cargar(c, 0, 2, 0)
    op_constante_rcx(c, 2)
    op_comparar(c, 148)
    op_saltar_si_cero(c, lento)                                // no es lista
    op_cargar(c, 2, 2, 8)                                      // d ← vec
    op_cargar(c, 0, 4, desp_indice)
    op_sar_constante(c, 1)                                     // a ← n
    op_cargar(c, 1, 2, 0)                                      // b ← largo
    op_saltar_si_mayor_igual(c, lento)                         // n >= largo
    op_mov(c, 1, 0)                                            // b ← n
    op_inmediato(c, 0 - 1)
    op_saltar_si_mayor_igual(c, lento)                         // n < 0
    op_cargar(c, 2, 2, 16)                                     // d ← datos
    retornar 0
}

funcion indice_rapido(c) {
    sea lento = nueva_etiqueta(c)
    sea fin = nueva_etiqueta(c)
    comprobar_lista_en_linea(c, 8, 0, lento)
    op_mov(c, 0, 2)
    op_cargar_indexado(c, 0)                                   // a ← datos[n]
    op_liberar_pila(c, 16)
    op_saltar(c, fin)
    definir_etiqueta(c, lento)
    llamar_runtime(c, "dyn_indice", 2)
    definir_etiqueta(c, fin)
    retornar 0
}

// lista[i] = v con [pila + 16] lista, [pila + 8] índice y [pila] valor.
funcion fijar_indice_rapido(c) {
    sea lento = nueva_etiqueta(c)
    sea fin = nueva_etiqueta(c)
    comprobar_lista_en_linea(c, 16, 8, lento)
    op_mov(c, 0, 1)
    op_constante_rcx(c, 3)
    op_aritmetica(c, 9)                                        // a ← n · 8
    op_mov(c, 1, 2)
    op_aritmetica(c, 1)                                        // a ← datos + 8n
    op_cargar(c, 1, 4, 0)                                      // b ← valor
    op_guardar(c, 0, 0, 1)
    op_inmediato(c, 0)
    op_liberar_pila(c, 24)
    op_saltar(c, fin)
    definir_etiqueta(c, lento)
    llamar_runtime(c, "dyn_fijar_indice", 3)
    definir_etiqueta(c, fin)
    retornar 0
}

// cociente(expr, N) con N literal potencia de 2 (2..2^30): devuelve log2(N)
// o 0. Mira los tokens sin consumirlos: "(" … "," N ")" al mismo nivel.
funcion cociente_potencia_de_2(c) {
    sea tokens = __cargar64(c)
    sea j = __cargar64(c + 8)
    si (es_simbolo(vec_obtener(tokens, j), "(") == 0) { retornar 0 }
    sea nivel = 0
    mientras (j < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, j)
        si (__cargar64(t) == 5) { retornar 0 }
        si (es_simbolo(t, "(") o es_simbolo(t, "[") o es_simbolo(t, "{")) { nivel = nivel + 1 }
        si (es_simbolo(t, ")") o es_simbolo(t, "]") o es_simbolo(t, "}")) {
            nivel = nivel - 1
            si (nivel == 0) { retornar 0 }
        }
        si (nivel == 1 y es_simbolo(t, ",")) {
            si (j + 2 >= vec_largo(tokens)) { retornar 0 }
            sea lit = vec_obtener(tokens, j + 1)
            si (__cargar64(lit) != 2 o es_simbolo(vec_obtener(tokens, j + 2), ")") == 0) { retornar 0 }
            sea lexema = __cargar64(lit + 8)
            sea k = 0
            mientras (k < str_largo(lexema)) {
                sea b = str_byte(lexema, k)
                si (b < 48 o b > 57) { retornar 0 }
                k = k + 1
            }
            sea n = numero_literal(lexema)
            sea log = 0
            sea p = 1
            mientras (p < n y log < 31) {
                p = p * 2
                log = log + 1
            }
            si (p == n y log >= 1 y log <= 30) { retornar log }
            retornar 0
        }
        j = j + 1
    }
    retornar 0
}

funcion llamar_runtime(c, nombre, n) {
    sea f = buscar_funcion(c, nombre)
    si (f == 0) {
        error_en(c, str_concatenar("falta el runtime del lenguaje (runtime/dyn.cfv): ", nombre))
    }
    emitir_llamada(c, f, n)
    retornar 0
}

funcion llamada(c, nombre) {
    si (intrinseco(c, nombre)) {
        fijar_tipo(c, 0)
        retornar 0
    }
    // bits_y / bits_o / bits_xo entre enteros: una instrucción.
    si (dinamico(c) y (str_igual(nombre, "bits_y") o str_igual(nombre, "bits_o") o str_igual(nombre, "bits_xo")) y buscar_funcion(c, nombre) != 0 y __cargar64(buscar_funcion(c, nombre) + 24) != 2) {
        requerir(c, "(")
        expresion(c)
        empujar(c)
        requerir(c, ",")
        expresion(c)
        requerir(c, ")")
        operador_rapido(c, nombre, nombre)
        fijar_tipo(c, 0)
        retornar 0
    }
    // cociente(x, 2^k) con una potencia de 2 literal: desplazamiento.
    si (dinamico(c) y str_igual(nombre, "cociente") y buscar_funcion(c, "cociente") != 0 y __cargar64(buscar_funcion(c, "cociente") + 24) != 2 y cociente_potencia_de_2(c) > 0) {
        sea k = cociente_potencia_de_2(c)
        requerir(c, "(")
        expresion(c)
        requerir(c, ",")
        sea divisor = numero_literal(__cargar64(avanzar(c) + 8))
        requerir(c, ")")
        sea lento = nueva_etiqueta(c)
        sea fin = nueva_etiqueta(c)
        sea positivo = nueva_etiqueta(c)
        empujar(c)
        op_y_uno(c)
        op_saltar_si_cero(c, lento)
        op_cargar(c, 0, 4, 0)
        op_sar_constante(c, 1)
        op_constante_rcx(c, 0)
        op_saltar_si_mayor_igual(c, positivo)
        op_constante_rcx(c, divisor - 1)                       // truncar hacia cero
        op_aritmetica(c, 1)
        definir_etiqueta(c, positivo)
        op_sar_constante(c, k)
        op_etiquetar(c, 1)
        op_liberar_pila(c, 8)
        op_saltar(c, fin)
        definir_etiqueta(c, lento)
        cargar_inmediato(c, divisor * 2 + 1)
        empujar(c)
        llamar_runtime(c, "cociente", 2)
        definir_etiqueta(c, fin)
        fijar_tipo(c, 0)
        retornar 0
    }
    // cociente(a, b): división entera en línea (el runtime si no son enteros).
    si (dinamico(c) y str_igual(nombre, "cociente") y buscar_funcion(c, "cociente") != 0 y __cargar64(buscar_funcion(c, "cociente") + 24) != 2) {
        requerir(c, "(")
        expresion(c)
        empujar(c)
        requerir(c, ",")
        expresion(c)
        requerir(c, ")")
        operador_rapido(c, "cociente", "cociente")
        fijar_tipo(c, 0)
        retornar 0
    }
    sea f = funcion_llamable(c, nombre)
    si (__cargar64(f + 32)) {
        emitir_llamada(c, f, argumentos_variadicos(c, __cargar64(f + 16) - 1))
        fijar_tipo(c, 0)
        retornar 0
    }
    si (dinamico(c) y __cargar64(f + 40) != 0) {
        emitir_llamada(c, f, argumentos_tipados(c, f))
        fijar_tipo(c, __cargar64(c + 424))
        retornar 0
    }
    emitir_llamada(c, f, argumentos(c))
    fijar_tipo(c, 0)
    retornar 0
}

// Argumentos comprobados contra los tipos anotados de los parámetros.
funcion argumentos_tipados(c, f) {
    sea tipos = __cargar64(f + 40)
    requerir(c, "(")
    sea n = 0
    // Tipos que recibió cada parámetro comptime (por posición).
    sea vinculos = vec_nuevo()
    sea k = 0
    mientras (k < vec_largo(tipos)) {
        vec_agregar(vinculos, 0)
        k = k + 1
    }
    si (ver(c, ")") == 0) {
        sea seguir = 1
        mientras (seguir) {
            sea esperado = 0
            si (n < vec_largo(tipos)) { esperado = vec_obtener(tipos, n) }
            si (esperado == 20) {
                // El argumento de un parámetro comptime es un nombre de tipo.
                si (tok_tipo(c) != 1 o (ver_en(c, 1, ",") == 0 y ver_en(c, 1, ")") == 0)) { error_en(c, str_concatenar("comptime: se esperaba un tipo como argumento de ", __cargar64(f))) }
                sea nombre_tipo = __cargar64(avanzar(c) + 8)
                sea codigo = tipo_por_nombre(nombre_tipo)
                si (codigo == 0 y buscar_clase(c, nombre_tipo) == 0 y str_igual(nombre_tipo, "dinamico") == 0) { error_en(c, str_concatenar("comptime: tipo desconocido ", nombre_tipo)) }
                vec_fijar(vinculos, n, codigo)
                cargar_caja(c, nombre_tipo)
                fijar_tipo(c, 0)
            } sino {
                expresion(c)
            }
            si (esperado >= 100 y esperado - 100 < vec_largo(vinculos)) { esperado = vec_obtener(vinculos, esperado - 100) }
            si (esperado == 20) { esperado = 0 }
            si (n < vec_largo(tipos)) {
                sea que = str_concatenar("el argumento ", str_desde_entero(n + 1))
                str_agregar(que, " de ")
                str_agregar(que, __cargar64(f))
                exigir_tipo(c, esperado, tipo_actual(c), que)
            }
            empujar(c)
            n = n + 1
            seguir = tomar(c, ",")
        }
    }
    requerir(c, ")")
    // Tipo del resultado (": T" se resuelve con lo que recibió T).
    sea resultado = __cargar64(f + 48)
    si (resultado >= 100) {
        si (resultado - 100 < vec_largo(vinculos)) { resultado = vec_obtener(vinculos, resultado - 100) } sino { resultado = 0 }
    }
    __guardar64(c + 424, resultado)
    retornar n
}

// f(a, b, x, y, z) con f(a, b, ...resto): los argumentos desde el fijo
// número k se juntan en una lista.
funcion argumentos_variadicos(c, k) {
    requerir(c, "(")
    sea n = 0
    mientras (n < k y ver(c, ")") == 0) {
        expresion(c)
        empujar(c)
        n = n + 1
        si (ver(c, ")") == 0) { requerir(c, ",") }
    }
    mientras (n < k) {
        cargar_inmediato(c, 0)
        empujar(c)
        n = n + 1
    }
    llamar_runtime(c, "dyn_lista_nueva", 0)
    empujar(c)
    mientras (ver(c, ")") == 0) {
        op_duplicar(c)                                     // push qword [rsp]
        expresion(c)
        empujar(c)
        llamar_runtime(c, "agregar", 2)
        si (ver(c, ")") == 0) { requerir(c, ",") }
    }
    requerir(c, ")")
    retornar k + 1
}

// En modo dinámico convierte rax (valor del lenguaje) en 0/1 para saltos.
funcion condicion(c) {
    si (tipo_actual(c) == 14) {
        fijar_tipo(c, 3)
        retornar 0                                             // ya es 0 o distinto de 0
    }
    si (dinamico(c) y (tipo_actual(c) == 12 o tipo_actual(c) == 13)) {
        // si (p): verdadero si el puntero no es nulo.
        sea nulo_ = nueva_etiqueta(c)
        op_saltar_si_cero(c, nulo_)
        op_inmediato(c, 1)
        definir_etiqueta(c, nulo_)
        retornar 0
    }
    si (dinamico(c)) {
        exigir_tipo(c, 3, tipo_actual(c), "la condición")
        // Booleano seguro (comparación, y/o, no, literal): verdadero (4) → 2,
        // falso (2) → 0; los saltos solo miran si es cero.
        si (tipo_actual(c) == 3) {
            op_sumar_constante(c, 0 - 2)
            retornar 0
        }
        // verdadero (4) → 1, falso (2) → 0 en línea; otro valor: dyn_verdad.
        sea lento = nueva_etiqueta(c)
        sea fin = nueva_etiqueta(c)
        op_mov(c, 1, 0)
        op_inmediato(c, 4)
        op_comparar(c, 148)
        op_saltar_si_no_cero(c, fin)
        op_inmediato(c, 2)
        op_comparar(c, 148)
        op_saltar_si_cero(c, lento)
        op_inmediato(c, 0)
        op_saltar(c, fin)
        definir_etiqueta(c, lento)
        op_mov(c, 0, 1)
        empujar(c)
        llamar_runtime(c, "dyn_verdad", 1)
        definir_etiqueta(c, fin)
    }
    retornar 0
}

// 0/1 en rax → falso (2) / verdadero (4).
funcion booleano_dinamico(c) {
    op_etiquetar(c, 2)
    retornar 0
}

// Posición de la "e" del exponente en un literal numérico, o -1.
funcion posicion_exponente(lexema) {
    sea i = 0
    mientras (i < str_largo(lexema)) {
        si (str_byte(lexema, i) == 101 o str_byte(lexema, i) == 69) { retornar i }
        i = i + 1
    }
    retornar 0 - 1
}

// Exponente decimal ("-3", "+2", "5") → entero.
funcion valor_exponente(t) {
    si (str_largo(t) > 0 y str_byte(t, 0) == 45) { retornar 0 - numero_literal(str_rebanar(t, 1, str_largo(t))) }
    si (str_largo(t) > 0 y str_byte(t, 0) == 43) { retornar numero_literal(str_rebanar(t, 1, str_largo(t))) }
    retornar numero_literal(t)
}

// bits · 10^e en f64 (potencias exactas de 10 hasta 10^22 por tramo).
funcion escalar_potencia10(bits, e) {
    mientras (e != 0) {
        sea paso = e
        si (paso > 22) { paso = 22 }
        si (paso < 0 - 22) { paso = 0 - 22 }
        sea p = __f64_desde_entero(1)
        sea k = 0
        sea m = paso
        si (m < 0) { m = 0 - m }
        mientras (k < m) {
            p = __f64_mul(p, __f64_desde_entero(10))
            k = k + 1
        }
        si (paso > 0) { bits = __f64_mul(bits, p) } sino { bits = __f64_div(bits, p) }
        e = e - paso
    }
    retornar bits
}

funcion numero_dinamico(c) {
    sea lexema = __cargar64(avanzar(c) + 8)
    sea exponente = 0
    sea con_exponente = 0
    sea pe = posicion_exponente(lexema)
    si (pe >= 0) {
        exponente = valor_exponente(str_rebanar(lexema, pe + 1, str_largo(lexema)))
        lexema = str_rebanar(lexema, 0, pe)
        con_exponente = 1
    }
    sea entero = numero_literal(lexema)
    sea bits = __f64_desde_entero(entero)
    si (con_exponente == 0 y ver(c, ".") y __cargar64(vec_obtener(__cargar64(c), __cargar64(c + 8) + 1)) == 2) {
        avanzar(c)
        sea fraccion = __cargar64(avanzar(c) + 8)
        sea pf = posicion_exponente(fraccion)
        si (pf >= 0) {
            exponente = valor_exponente(str_rebanar(fraccion, pf + 1, str_largo(fraccion)))
            fraccion = str_rebanar(fraccion, 0, pf)
            con_exponente = 1
        }
        // Más de 17 cifras no cambian un double y desbordarían el entero.
        si (str_largo(fraccion) > 17) { fraccion = str_rebanar(fraccion, 0, 17) }
        sea escala = 1
        sea i = 0
        mientras (i < str_largo(fraccion)) {
            escala = escala * 10
            i = i + 1
        }
        sea parte = __f64_div(__f64_desde_entero(numero_literal(fraccion)), __f64_desde_entero(escala))
        bits = escalar_potencia10(__f64_suma(bits, parte), exponente)
        cargar_inmediato(c, bits)
        empujar(c)
        llamar_runtime(c, "dyn_flotante", 1)
        fijar_tipo(c, 9)
        retornar 0
    }
    si (con_exponente) {
        cargar_inmediato(c, escalar_potencia10(bits, exponente))
        empujar(c)
        llamar_runtime(c, "dyn_flotante", 1)
        fijar_tipo(c, 9)
        retornar 0
    }
    cargar_inmediato(c, entero * 2 + 1)
    fijar_tipo(c, 1)
    retornar 0
}

// [a, b, ...] → lista del lenguaje.
funcion lista_literal(c) {
    llamar_runtime(c, "dyn_lista_nueva", 0)
    empujar(c)
    si (ver(c, "]") == 0) {
        sea seguir = 1
        mientras (seguir) {
            op_duplicar(c)                                 // push qword [rsp]
            expresion(c)
            empujar(c)
            llamar_runtime(c, "agregar", 2)
            seguir = tomar(c, ",")
            si (ver(c, "]")) { seguir = 0 }
        }
    }
    requerir(c, "]")
    op_sacar(c, 0)                                                  // pop rax
    retornar 0
}

// {"clave": valor, ...} → mapa del lenguaje.
funcion mapa_literal(c) {
    llamar_runtime(c, "dyn_mapa_nuevo", 0)
    empujar(c)
    si (ver(c, "}") == 0) {
        sea seguir = 1
        mientras (seguir) {
            op_duplicar(c)                                 // push qword [rsp]
            expresion(c)
            empujar(c)
            requerir(c, ":")
            expresion(c)
            empujar(c)
            fijar_indice_rapido(c)
            seguir = tomar(c, ",")
            si (ver(c, "}")) { seguir = 0 }
        }
    }
    requerir(c, "}")
    op_sacar(c, 0)                                                  // pop rax
    retornar 0
}

funcion linea_previa(c) {
    retornar __cargar64(vec_obtener(__cargar64(c), __cargar64(c + 8) - 1) + 16)
}

// .campo o .metodo(args) sobre el valor de rax.
funcion sufijo_punto(c) {
    requerir(c, ".")
    sea nombre = requerir_ident(c)
    empujar(c)
    si (ver(c, "(")) {
        llamada_metodo(c, nombre)
    } sino {
        cargar_caja(c, nombre)
        empujar(c)
        llamar_runtime(c, "dyn_campo", 2)
    }
    retornar 0
}

// ¿Termina la expresión después del token actual? (para "valor?")
funcion fin_de_expresion_tras(c) {
    sea siguiente = vec_obtener(__cargar64(c), __cargar64(c + 8) + 1)
    si (__cargar64(siguiente) == 5) { retornar 1 }
    si (__cargar64(siguiente + 16) > tok_linea(c)) { retornar 1 }
    retornar es_simbolo(siguiente, ")") o es_simbolo(siguiente, ",") o es_simbolo(siguiente, "]") o es_simbolo(siguiente, "}") o es_simbolo(siguiente, ";")
}

// valor? : un Resultado con error (u Opción vacía) se retorna de la función
// actual; si no, queda su "valor".
funcion propagar_resultado(c) {
    empujar(c)
    op_duplicar(c)                                         // push qword [rsp]
    sea sigue = nueva_etiqueta(c)
    llamar_runtime(c, "dyn_es_fallo", 1)
    op_saltar_si_cero(c, sigue)
    op_sacar(c, 0)                                                  // pop rax (el fallo)
    si (__cargar64(c + 240) > 0) {
        empujar(c)
        salir_de_intentar(c, __cargar64(c + 240))
        op_sacar(c, 0)
    }
    epilogo(c)
    definir_etiqueta(c, sigue)
    llamar_runtime(c, "dyn_desenvolver", 1)
    retornar 0
}

// Sufijos del modo dinámico: valor[índice], valor.campo, valor.metodo(args),
// valor?.campo (nulo si valor es nulo), valor(args) y valor?.
funcion sufijos(c) {
    sea seguir = 1
    mientras (seguir) {
        sea hecho = 0
        si (ver(c, "?") y str_igual(tok_siguiente_lexema(c), ".")) {
            avanzar(c)
            sea fin = nueva_etiqueta(c)
            op_saltar_si_cero(c, fin)
            sufijo_punto(c)
            definir_etiqueta(c, fin)
            hecho = 1
        }
        si (hecho == 0 y ver(c, "?") y str_igual(tok_siguiente_lexema(c), "?") == 0 y fin_de_expresion_tras(c)) {
            avanzar(c)
            propagar_resultado(c)
            hecho = 1
        }
        si (hecho == 0 y ver(c, "(") y tok_linea(c) == linea_previa(c)) {
            llamada_cierre(c)
            hecho = 1
        }
        si (hecho == 0 y tomar(c, "[")) {
            empujar(c)
            expresion(c)
            empujar(c)
            requerir(c, "]")
            // m[k] ?? valor: una clave ausente (o un índice fuera de rango)
            // da nulo en vez de error, para que ?? elija el valor por defecto.
            si (dinamico(c) y ver(c, "?") y str_igual(tok_siguiente_lexema(c), "?")) {
                llamar_runtime(c, "dyn_indice_opcional", 2)
                fijar_tipo(c, 0)
            } sino { indice_rapido(c) }
            hecho = 1
        }
        si (hecho == 0 y ver(c, ".") y tok_tipo_en(c, 1) == 1) {
            sufijo_punto(c)
            hecho = 1
        }
        si (hecho == 0) { seguir = 0 }
    }
    retornar 0
}

// objeto.metodo(args) con el objeto ya apilado. Si el objeto es una
// instancia cuya clase (o un ancestro) define el método, se llama por
// despacho dinámico; si no, equivale a metodo(objeto, args).
funcion llamada_metodo(c, nombre) {
    sea n = argumentos(c)
    // Buscar el método: dyn_buscar_metodo(objeto, "nombre", n + 1).
    op_cargar32(c, 0, 4, n * 8)
    empujar(c)
    cargar_texto_crudo(c, nombre)
    empujar(c)
    cargar_inmediato(c, n + 1)
    empujar(c)
    llamar_runtime(c, "dyn_buscar_metodo", 3)
    sea alterna = nueva_etiqueta(c)
    sea fin = nueva_etiqueta(c)
    op_saltar_si_cero(c, alterna)
    op_llamar_reg(c, 0)
    op_saltar(c, fin)
    definir_etiqueta(c, alterna)
    sea f = buscar_funcion(c, nombre)
    si (f == 0 y alias_funcion(nombre) != 0) { f = buscar_funcion(c, alias_funcion(nombre)) }
    si (f != 0 y __cargar64(f + 16) == n + 1 y __cargar64(f + 24) != 0) {
        referenciar(c, f)
        op_llamar(c, __cargar64(f + 8))
    } sino {
        op_cargar32(c, 0, 4, n * 8)
        empujar(c)
        cargar_texto_crudo(c, nombre)
        empujar(c)
        llamar_runtime(c, "dyn_metodo_desconocido", 2)
    }
    definir_etiqueta(c, fin)
    op_liberar_pila(c, (n + 1) * 8)
    retornar 0
}

// super.metodo(args): método de la clase padre, resuelto al compilar.
funcion llamada_super(c) {
    sea k = __cargar64(c + 168)
    si (k == 0 o __cargar64(k + 8) == 0) { error_en(c, "super solo existe dentro de una clase con padre") }
    requerir(c, ".")
    sea nombre = requerir_ident(c)
    sea m = metodo_en_cadena(c, buscar_clase(c, __cargar64(k + 8)), nombre)
    si (m == 0) { error_en(c, str_concatenar("la clase padre no tiene el método ", nombre)) }
    cargar_var(c, variable(c, "esto"))
    empujar(c)
    sea n = argumentos(c)
    si (n + 1 != __cargar64(m + 16)) { error_en(c, str_concatenar("cantidad de argumentos incorrecta en ", nombre)) }
    llamar_etiqueta(c, __cargar64(m + 8), n + 1)
    retornar 0
}

funcion ver_en(c, salto, lexema) {
    sea i = __cargar64(c + 8) + salto
    si (i >= vec_largo(__cargar64(c))) { retornar 0 }
    retornar es_simbolo(vec_obtener(__cargar64(c), i), lexema)
}

funcion tok_tipo_en(c, salto) {
    sea i = __cargar64(c + 8) + salto
    si (i >= vec_largo(__cargar64(c))) { retornar 5 }
    retornar __cargar64(vec_obtener(__cargar64(c), i))
}

// ¿Empieza una interpolación en la posición i del literal? "{" seguida de
// una letra, "_" o "(", con su "}" antes del final. Así "{\"a\":1}" (JSON) o
// "main() {" (GLSL) quedan como texto literal.
funcion abre_interpolacion(lexema, i) {
    si (str_byte(lexema, i) != 123 o i + 1 >= str_largo(lexema) - 1) { retornar 0 }
    sea s = str_byte(lexema, i + 1)
    si (es_letra(s) == 0 y s != 40) { retornar 0 }
    sea nivel = 1
    sea k = i + 1
    mientras (k < str_largo(lexema) - 1) {
        sea b = str_byte(lexema, k)
        si (b == 34 o b == 92 o b == 10) { retornar 0 }
        si (b == 123) { nivel = nivel + 1 }
        si (b == 125) {
            nivel = nivel - 1
            si (nivel == 0) { retornar 1 }
        }
        k = k + 1
    }
    retornar 0
}

// ¿Tiene el literal alguna interpolación?
funcion tiene_interpolacion(lexema) {
    sea i = 1
    mientras (i < str_largo(lexema) - 1) {
        sea b = str_byte(lexema, i)
        si (b == 92) {
            i = i + 2
        } sino {
            si (abre_interpolacion(lexema, i)) { retornar 1 }
            i = i + 1
        }
    }
    retornar 0
}

// Compila una expresión escrita dentro de un texto: "Hola {nombre}".
funcion expresion_incrustada(c, texto) {
    sea tokens = __cargar64(c)
    sea posicion = __cargar64(c + 8)
    sea linea = tok_linea(c)
    sea nuevos = traducir_ingles(tokenizar(texto))
    sea i = 0
    mientras (i < vec_largo(nuevos)) {
        __guardar64(vec_obtener(nuevos, i) + 16, linea)
        i = i + 1
    }
    __guardar64(c, nuevos)
    __guardar64(c + 8, 0)
    expresion(c)
    si (tok_tipo(c) != 5) { error_en(c, "expresión inválida dentro del texto") }
    __guardar64(c, tokens)
    __guardar64(c + 8, posicion)
    retornar 0
}

// "a {x} b" → "a " + x + " b" (concatenación de textos del lenguaje).
funcion texto_interpolado(c, lexema) {
    cargar_caja(c, "")
    sea parte = str_nuevo(16)
    str_agregar_byte(parte, 34)
    sea i = 1
    sea fin = str_largo(lexema) - 1
    mientras (i < fin) {
        sea b = str_byte(lexema, i)
        si (b == 92 y i + 1 < fin) {
            str_agregar_byte(parte, b)
            str_agregar_byte(parte, str_byte(lexema, i + 1))
            i = i + 2
        } sino {
            si (abre_interpolacion(lexema, i)) {
                si (str_largo(parte) > 1) {
                    str_agregar_byte(parte, 34)
                    empujar(c)
                    op_direccion(c, 1, literal_caja(c, parte))
                    llamar_operador_suma(c)
                }
                parte = str_nuevo(16)
                str_agregar_byte(parte, 34)
                sea nivel = 1
                sea inicio = i + 1
                i = i + 1
                mientras (i < fin y nivel > 0) {
                    si (str_byte(lexema, i) == 123) { nivel = nivel + 1 }
                    si (str_byte(lexema, i) == 125) { nivel = nivel - 1 }
                    i = i + 1
                }
                si (nivel != 0) { error_en(c, "falta '}' en la interpolación del texto") }
                empujar(c)
                expresion_incrustada(c, str_rebanar(lexema, inicio, i - 1))
                llamar_operador_suma(c)
            } sino {
                str_agregar_byte(parte, b)
                i = i + 1
            }
        }
    }
    si (str_largo(parte) > 1) {
        str_agregar_byte(parte, 34)
        empujar(c)
        op_direccion(c, 1, literal_caja(c, parte))
        llamar_operador_suma(c)
    }
    retornar 0
}

// Izquierda apilada, derecha en rax → texto concatenado (dyn_suma).
funcion llamar_operador_suma(c) {
    empujar(c)
    llamar_runtime(c, "dyn_suma", 2)
    retornar 0
}

funcion primaria_dinamica(c) {
    sea tipo = tok_tipo(c)
    si (tipo == 2) { numero_dinamico(c) retornar 0 }
    si (tipo == 3) {
        sea lexema = __cargar64(avanzar(c) + 8)
        si (tiene_interpolacion(lexema)) {
            texto_interpolado(c, lexema)
            fijar_tipo(c, 2)
            retornar 0
        }
        sea d = literal_caja(c, lexema)
        op_direccion(c, 1, d)
        fijar_tipo(c, 2)
        retornar 0
    }
    si (tomar(c, "verdadero")) { cargar_inmediato(c, 4) fijar_tipo(c, 3) retornar 0 }
    si (tomar(c, "falso")) { cargar_inmediato(c, 2) fijar_tipo(c, 3) retornar 0 }
    si (tomar(c, "nulo")) { cargar_inmediato(c, 0) fijar_tipo(c, 6) retornar 0 }
    si (ver(c, "si") y str_igual(tok_siguiente_lexema(c), "(")) {
        // si(condición, a, b): solo se evalúa la rama elegida.
        avanzar(c)
        avanzar(c)
        expresion(c)
        condicion(c)
        sea otro = nueva_etiqueta(c)
        sea fin = nueva_etiqueta(c)
        op_saltar_si_cero(c, otro)
        requerir(c, ",")
        expresion(c)
        op_saltar(c, fin)
        definir_etiqueta(c, otro)
        requerir(c, ",")
        expresion(c)
        requerir(c, ")")
        definir_etiqueta(c, fin)
        fijar_tipo(c, 0)
        retornar 0
    }
    si (ver(c, "super") y str_igual(tok_siguiente_lexema(c), ".")) {
        avanzar(c)
        llamada_super(c)
        retornar 0
    }
    si (tomar(c, "[")) { lista_literal(c) fijar_tipo(c, 4) retornar 0 }
    si (tomar(c, "{")) { mapa_literal(c) fijar_tipo(c, 5) retornar 0 }
    si (tomar(c, "(")) {
        expresion(c)
        requerir(c, ")")
        retornar 0
    }
    si (ver(c, "funcion") y str_igual(tok_siguiente_lexema(c), "(")) {
        avanzar(c)
        funcion_anonima(c)
        fijar_tipo(c, 7)
        retornar 0
    }
    si (tipo == 1) {
        sea nombre = __cargar64(avanzar(c) + 8)
        sea a = resolver(c, nombre)
        si (a == 0 y ver(c, "<")) {
            // Nombre<Tipo>(...): genéricos en la instancia o llamada.
            sea fin_gen = fin_genericos(__cargar64(c), __cargar64(c + 8))
            si (fin_gen >= 0) {
                si (es_simbolo(vec_obtener(__cargar64(c), fin_gen + 1), "(")) { __guardar64(c + 8, fin_gen + 1) }
            }
        }
        si (a == 0 y str_igual(nombre, "rutas_compiladas") y buscar_funcion(c, nombre) == 0) {
            requerir(c, "(")
            requerir(c, ")")
            rutas_compiladas(c)
            retornar 0
        }
        si (ver(c, "(")) {
            si (a != 0) {
                si (tipo_variable(c, nombre) == 13) { error_en(c, str_concatenar("error de tipos: no se puede llamar a un opcional sin comprobarlo: ", nombre)) }
                cargar_var(c, a)
                llamada_cierre(c)
                fijar_tipo(c, 0)
            } sino {
                llamada(c, nombre)
            }
            retornar 0
        }
        si (a != 0) {
            cargar_var(c, a)
            fijar_tipo(c, tipo_variable(c, nombre))
            si (tipo_actual(c) == 13 y (ver(c, ".") o ver(c, "[") o ver(c, "("))) {
                sea m = str_concatenar("error de tipos: ", nombre)
                str_agregar(m, " puede ser nulo; compruébalo antes de usarlo: si (")
                str_agregar(m, nombre)
                str_agregar(m, ") |valor| { … }")
                error_en(c, m)
            }
            retornar 0
        }
        sea f = buscar_funcion(c, nombre)
        si (f != 0) {
            valor_funcion(c, f)
            fijar_tipo(c, 7)
            retornar 0
        }
        error_en(c, str_concatenar("variable desconocida ", nombre))
        retornar 0
    }
    error_en(c, "expresión inválida")
    retornar 0
}

// rutas_compiladas(): tabla de las funciones marcadas con #[Ruta("/r", "M")].
funcion rutas_compiladas(c) {
    llamar_runtime(c, "dyn_lista_nueva", 0)
    empujar(c)
    sea atributos = __cargar64(c + 288)
    sea i = 0
    mientras (i < vec_largo(atributos)) {
        sea a = vec_obtener(atributos, i)
        si (str_igual(__cargar64(a), "Ruta")) {
            sea args = __cargar64(a + 8)
            op_duplicar(c)                                 // push qword [rsp]
            llamar_runtime(c, "dyn_mapa_nuevo", 0)
            empujar(c)
            campo_texto(c, "manejador", comillas(__cargar64(a + 16)))
            sea manejador = buscar_funcion(c, __cargar64(a + 16))
            si (manejador != 0) { referenciar(c, manejador) }
            si (vec_largo(args) > 0) { campo_texto(c, "ruta", vec_obtener(args, 0)) }
            si (vec_largo(args) > 1) { campo_texto(c, "metodo", vec_obtener(args, 1)) } sino { campo_texto(c, "metodo", comillas("GET")) }
            llamar_runtime(c, "agregar", 2)
        }
        i = i + 1
    }
    op_sacar(c, 0)                                                  // pop rax
    retornar 0
}

// mapa (apilado)["clave"] = literal de texto
funcion campo_texto(c, clave, lexema) {
    op_duplicar(c)
    cargar_caja(c, clave)
    empujar(c)
    op_direccion(c, 1, literal_caja(c, lexema))
    empujar(c)
    fijar_indice_rapido(c)
    retornar 0
}

// Valor de función con nombre: un cierre sin capturas (la función ignora
// el entorno, que llega por debajo de sus parámetros).
funcion valor_funcion(c, f) {
    referenciar(c, f)
    op_direccion(c, 4, __cargar64(f + 8))
    empujar(c)
    cargar_inmediato(c, __cargar64(f + 16))
    empujar(c)
    cargar_inmediato(c, 0)
    empujar(c)
    llamar_runtime(c, "dyn_cierre_nuevo", 3)
    retornar 0
}

// Llamada a un cierre que está en rax: f(args).
funcion llamada_cierre(c) {
    empujar(c)
    sea n = argumentos(c)
    op_cargar32(c, 0, 4, n * 8)
    empujar(c)
    cargar_inmediato(c, n)
    empujar(c)
    llamar_runtime(c, "dyn_codigo_cierre", 2)
    op_llamar_reg(c, 0)
    op_liberar_pila(c, (n + 1) * 8)
    retornar 0
}

// funcion(p1, p2) { ... } como expresión.
funcion funcion_anonima(c) {
    sea saltar = saltar_por_encima(c)
    sea etiqueta = nueva_etiqueta(c)
    sea nombres = parametros(c, un_nombre(str_nuevo(0)))
    sea n = vec_largo(nombres) - 1
    sea estado = abrir_cierre(c, etiqueta, nombres)
    vec_liberar(nombres)
    sea marco = __cargar64(c + 216)
    aplicar_defectos(c)
    bloque(c)
    sea capturas = __cargar64(marco + 16)
    cerrar_funcion(c, estado)
    definir_etiqueta(c, saltar)
    op_direccion(c, 4, etiqueta)
    empujar(c)
    cargar_inmediato(c, n)
    empujar(c)
    cargar_inmediato(c, vec_largo(capturas))
    empujar(c)
    llamar_runtime(c, "dyn_cierre_nuevo", 3)
    sea i = 0
    mientras (i < vec_largo(capturas)) {
        empujar(c)
        cargar_inmediato(c, i)
        empujar(c)
        cargar_celda(c, variable(c, vec_obtener(capturas, i)))
        empujar(c)
        llamar_runtime(c, "dyn_cierre_fijar", 3)
        i = i + 1
    }
    retornar 0
}

funcion primaria(c) {
    si (dinamico(c)) {
        fijar_tipo(c, 0)
        primaria_dinamica(c)
        sea antes = __cargar64(c + 8)
        sea t = tipo_actual(c)
        sufijos(c)
        si (__cargar64(c + 8) != antes) { t = 0 }
        fijar_tipo(c, t)
        retornar 0
    }
    sea tipo = tok_tipo(c)
    si (tipo == 2) {
        cargar_inmediato(c, numero_literal(__cargar64(avanzar(c) + 8)))
        retornar 0
    }
    si (tipo == 3) {
        sea d = literal(c, __cargar64(avanzar(c) + 8))
        op_direccion(c, 1, d)
        retornar 0
    }
    si (tomar(c, "verdadero")) { cargar_inmediato(c, 1) retornar 0 }
    si (tomar(c, "falso")) { cargar_inmediato(c, 0) retornar 0 }
    si (tomar(c, "(")) {
        expresion(c)
        requerir(c, ")")
        retornar 0
    }
    si (tipo == 1) {
        sea nombre = __cargar64(avanzar(c) + 8)
        si (ver(c, "(")) {
            llamada(c, nombre)
            retornar 0
        }
        cargar_var(c, variable(c, nombre))
        retornar 0
    }
    error_en(c, "expresión inválida")
    retornar 0
}

funcion unaria(c) {
    si (tomar(c, "-")) {
        unaria(c)
        si (dinamico(c)) {
            sea t = tipo_actual(c)
            si (t != 0 y es_numerico(t) == 0) { exigir_tipo(c, 9, t, "'-'") }
            empujar(c)
            llamar_runtime(c, "dyn_neg", 1)
            fijar_tipo(c, t)
            retornar 0
        }
        op_negar(c)
        retornar 0
    }
    si (dinamico(c) y tomar(c, "@")) {
        unaria(c)
        empujar(c)
        llamar_runtime(c, "dyn_direccion", 1)
        fijar_tipo(c, 0)
        retornar 0
    }
    si (dinamico(c) y tomar(c, "*")) {
        unaria(c)
        empujar(c)
        llamar_runtime(c, "dyn_leer_puntero", 1)
        fijar_tipo(c, 0)
        retornar 0
    }
    si (tomar(c, "no")) {
        unaria(c)
        si (dinamico(c)) {
            exigir_tipo(c, 3, tipo_actual(c), "'no'")
            empujar(c)
            llamar_runtime(c, "dyn_no", 1)
            fijar_tipo(c, 3)
            retornar 0
        }
        op_es_cero(c)
        retornar 0
    }
    primaria(c)
    retornar 0
}

// Operación binaria: el operando izquierdo está apilado y el derecho en rax.
// Ruta rápida en línea para dos enteros etiquetados (n·2+1): la misma
// aritmética que dyn_suma/dyn_resta/dyn_mul/dyn_mod y las comparaciones,
// sin llamar al runtime. Si alguno no es entero, se llama a la función.
// Izquierda apilada, derecha en rax.
funcion operador_rapido(c, lex, nombre) {
    sea lento = nueva_etiqueta(c)
    sea fin = nueva_etiqueta(c)
    empujar(c)                                                      // [der][izq]
    op_cargar(c, 1, 4, 8)
    op_aritmetica(c, 6)                                             // der & izq
    op_y_uno(c)
    op_saltar_si_cero(c, lento)
    sea op = str_byte(lex, 0)
    si (str_largo(lex) == 1 y op == 43) {                           // a + b - 1
        op_cargar(c, 0, 4, 8)
        op_cargar(c, 1, 4, 0)
        op_aritmetica(c, 1)
        op_sumar_constante(c, 0 - 1)
    }
    si (str_largo(lex) == 1 y op == 45) {                           // a - b + 1
        op_cargar(c, 0, 4, 8)
        op_cargar(c, 1, 4, 0)
        op_aritmetica(c, 2)
        op_sumar_constante(c, 1)
    }
    si (str_largo(lex) == 1 y op == 42) {                           // (a >> 1)·(b - 1) + 1
        op_cargar(c, 0, 4, 0)
        op_sumar_constante(c, 0 - 1)
        op_mov(c, 1, 0)
        op_cargar(c, 0, 4, 8)
        op_sar_constante(c, 1)
        op_aritmetica(c, 3)
        op_sumar_constante(c, 1)
    }
    si (str_igual(lex, "bits_y")) {                                 // (2x+1) & (2y+1) = 2(x&y)+1
        op_cargar(c, 0, 4, 8)
        op_cargar(c, 1, 4, 0)
        op_aritmetica(c, 6)
    }
    si (str_igual(lex, "bits_o")) {
        op_cargar(c, 0, 4, 8)
        op_cargar(c, 1, 4, 0)
        op_aritmetica(c, 7)
    }
    si (str_igual(lex, "bits_xo")) {                                // 2(x^y) + 1
        op_cargar(c, 0, 4, 8)
        op_cargar(c, 1, 4, 0)
        op_aritmetica(c, 8)
        op_sumar_constante(c, 1)
    }
    si (str_igual(lex, "cociente")) {                               // (a' / b')·2 + 1, b' ≠ 0
        op_cargar(c, 0, 4, 0)
        op_sar_constante(c, 1)
        op_saltar_si_cero(c, lento)
        op_mov(c, 1, 0)
        op_cargar(c, 0, 4, 8)
        op_sar_constante(c, 1)
        op_aritmetica(c, 4)
        op_mov(c, 1, 0)
        op_aritmetica(c, 1)
        op_sumar_constante(c, 1)
    }
    si (str_largo(lex) == 1 y op == 37) {                           // (a' % b')·2 + 1, b' ≠ 0
        op_cargar(c, 0, 4, 0)
        op_sar_constante(c, 1)
        op_saltar_si_cero(c, lento)                                 // b == 0: el runtime da el error
        op_mov(c, 1, 0)
        op_cargar(c, 0, 4, 8)
        op_sar_constante(c, 1)
        op_aritmetica(c, 5)
        op_mov(c, 1, 0)
        op_aritmetica(c, 1)
        op_sumar_constante(c, 1)
    }
    sea codigo = 0
    si (str_igual(lex, "<")) { codigo = 156 }
    si (str_igual(lex, "<=")) { codigo = 158 }
    si (str_igual(lex, ">")) { codigo = 159 }
    si (str_igual(lex, ">=")) { codigo = 157 }
    si (str_igual(lex, "==")) { codigo = 148 }
    si (str_igual(lex, "!=")) { codigo = 149 }
    si (codigo != 0) {
        op_cargar(c, 0, 4, 8)
        op_cargar(c, 1, 4, 0)
        op_comparar(c, codigo)
        si (mem_global(46) == 0) { booleano_dinamico(c) }
    }
    op_liberar_pila(c, 16)
    op_saltar(c, fin)
    definir_etiqueta(c, lento)
    llamar_runtime(c, nombre, 2)
    si (mem_global(46) != 0) { op_sumar_constante(c, 0 - 2) }
    definir_etiqueta(c, fin)
    retornar 0
}

// Los dos operandos son enteros probados (tipos estáticos): la aritmética
// directa, sin comprobar etiquetas. Izquierda apilada, derecha en rax.
funcion operador_entero(c, lex, nombre) {
    sea op = str_byte(lex, 0)
    si (str_largo(lex) == 1 y op == 37) {
        sea lento = nueva_etiqueta(c)
        sea fin = nueva_etiqueta(c)
        op_empujar(c)
        op_sar_constante(c, 1)
        op_saltar_si_cero(c, lento)
        op_mov(c, 1, 0)
        op_cargar(c, 0, 4, 8)
        op_sar_constante(c, 1)
        op_aritmetica(c, 5)
        op_mov(c, 1, 0)
        op_aritmetica(c, 1)
        op_sumar_constante(c, 1)
        op_liberar_pila(c, 16)
        op_saltar(c, fin)
        definir_etiqueta(c, lento)
        llamar_runtime(c, nombre, 2)
        definir_etiqueta(c, fin)
        retornar 0
    }
    si (str_largo(lex) == 1 y op == 42) { op_sumar_constante(c, 0 - 1) }
    op_mov(c, 1, 0)                                                 // rcx = der
    op_sacar(c, 0)                                                  // rax = izq
    si (str_largo(lex) == 1 y op == 43) { op_aritmetica(c, 1) op_sumar_constante(c, 0 - 1) }
    si (str_largo(lex) == 1 y op == 45) { op_aritmetica(c, 2) op_sumar_constante(c, 1) }
    si (str_largo(lex) == 1 y op == 42) {
        op_sar_constante(c, 1)
        op_aritmetica(c, 3)
        op_sumar_constante(c, 1)
    }
    sea codigo = 0
    si (str_igual(lex, "<")) { codigo = 156 }
    si (str_igual(lex, "<=")) { codigo = 158 }
    si (str_igual(lex, ">")) { codigo = 159 }
    si (str_igual(lex, ">=")) { codigo = 157 }
    si (str_igual(lex, "==")) { codigo = 148 }
    si (str_igual(lex, "!=")) { codigo = 149 }
    si (codigo != 0) {
        op_comparar(c, codigo)
        si (mem_global(46) == 0) { booleano_dinamico(c) }
    }
    retornar 0
}

// Igual que operador_rapido, con el operando derecho entero literal v
// (etiquetado L = 2v + 1, ya en rax): solo se comprueba el izquierdo.
funcion operador_rapido_literal(c, lex, nombre, v, probado) {
    sea lento = nueva_etiqueta(c)
    sea fin = nueva_etiqueta(c)
    sea op = str_byte(lex, 0)
    // b == 0 en %: que el runtime dé el error.
    si (str_largo(lex) == 1 y op == 37 y v == 0) {
        empujar(c)
        llamar_runtime(c, nombre, 2)
        retornar 0
    }
    si (probado == 0) {
        op_cargar(c, 0, 4, 0)                                       // rax = izq
        op_y_uno(c)
        op_saltar_si_cero(c, lento)
    }
    op_sacar(c, 0)                                                  // rax = izq
    si (str_largo(lex) == 1 y op == 43) { op_constante_rcx(c, 2 * v) op_aritmetica(c, 1) }
    si (str_largo(lex) == 1 y op == 45) { op_constante_rcx(c, 2 * v) op_aritmetica(c, 2) }
    sea kp = potencia_de_dos(v)
    si (str_largo(lex) == 1 y op == 42 y kp > 0 y kp < 62) {
        op_sar_constante(c, 1)                                      // x'
        op_shl_constante(c, kp + 1)                                 // 2·x'·2^k
        op_sumar_constante(c, 1)
    }
    si (str_largo(lex) == 1 y op == 42 y (kp <= 0 o kp >= 62)) {
        op_sar_constante(c, 1)
        op_constante_rcx(c, 2 * v)
        op_aritmetica(c, 3)
        op_sumar_constante(c, 1)
    }
    si (str_largo(lex) == 1 y op == 37 y kp > 0) {
        op_sar_constante(c, 1)
        op_resto_potencia2(c, kp)
        op_mov(c, 1, 0)
        op_aritmetica(c, 1)
        op_sumar_constante(c, 1)
    }
    si (str_largo(lex) == 1 y op == 37 y kp <= 0) {
        op_sar_constante(c, 1)
        op_constante_rcx(c, v)
        op_aritmetica(c, 5)
        op_mov(c, 1, 0)
        op_aritmetica(c, 1)
        op_sumar_constante(c, 1)
    }
    sea codigo = 0
    si (str_igual(lex, "<")) { codigo = 156 }
    si (str_igual(lex, "<=")) { codigo = 158 }
    si (str_igual(lex, ">")) { codigo = 159 }
    si (str_igual(lex, ">=")) { codigo = 157 }
    si (str_igual(lex, "==")) { codigo = 148 }
    si (str_igual(lex, "!=")) { codigo = 149 }
    si (codigo != 0) {
        op_constante_rcx(c, 2 * v + 1)
        op_comparar(c, codigo)
        si (mem_global(46) == 0) { booleano_dinamico(c) }
    }
    op_saltar(c, fin)
    definir_etiqueta(c, lento)
    cargar_inmediato(c, 2 * v + 1)
    empujar(c)
    llamar_runtime(c, nombre, 2)
    si (mem_global(46) != 0) { op_sumar_constante(c, 0 - 2) }
    definir_etiqueta(c, fin)
    retornar 0
}

// k si v = 2^k (1 ≤ k ≤ 62), si no -1.
funcion potencia_de_dos(v) {
    si (v < 2) { retornar 0 - 1 }
    sea k = 0
    mientras (__y_bits(v, 1) == 0) {
        v = __desplazar_der(v, 1)
        k = k + 1
    }
    si (v != 1 o k > 62) { retornar 0 - 1 }
    retornar k
}

// ¿Token i es un entero literal simple (sin punto, exponente ni signo)?
funcion entero_literal_en(toks, i) {
    si (i >= vec_largo(toks)) { retornar 0 }
    sea t = vec_obtener(toks, i)
    si (__cargar64(t) != 2) { retornar 0 }
    sea lx = __cargar64(t + 8)
    si (posicion_exponente(lx) >= 0 o str_largo(lx) > 15) { retornar 0 }
    si (i + 1 < vec_largo(toks) y str_igual(lexema_en(toks, i + 1), ".")) { retornar 0 }
    retornar 1
}

// Plegado de constantes: "lit op lit op lit…" con operadores de este nivel
// (1: * / %, 2: + -) se calcula al compilar y se emite un solo literal.
// Devuelve 1 si plegó. En modo dinámico "/" da flotante: no se pliega.
funcion plegar_constantes(c, nivel) {
    sea toks = __cargar64(c)
    sea pos = __cargar64(c + 8)
    si (entero_literal_en(toks, pos) == 0) { retornar 0 }
    sea v = numero_literal(lexema_en(toks, pos))
    sea k = pos + 1
    sea plegados = 0
    sea seguir = 1
    mientras (seguir) {
        seguir = 0
        si (k + 1 < vec_largo(toks) y entero_literal_en(toks, k + 1)) {
            sea op = lexema_en(toks, k)
            sea siguiente = ""
            si (k + 2 < vec_largo(toks)) { siguiente = lexema_en(toks, k + 2) }
            // Lo que sigue al literal no puede ligar más fuerte.
            sea libre = str_igual(siguiente, "(") == 0 y str_igual(siguiente, "[") == 0 y str_igual(siguiente, ".") == 0
            si (nivel == 2) { libre = libre y str_igual(siguiente, "*") == 0 y str_igual(siguiente, "/") == 0 y str_igual(siguiente, "%") == 0 }
            sea w = numero_literal(lexema_en(toks, k + 1))
            sea r = 0
            sea ok = 0
            si (libre y nivel == 1 y str_igual(op, "*")) {
                r = v * w
                ok = 1
                si (v != 0 y r / v != w) { ok = 0 }
            }
            si (libre y nivel == 1 y str_igual(op, "%") y w != 0) {
                r = v % w
                ok = 1
            }
            si (libre y nivel == 1 y str_igual(op, "/") y w != 0 y dinamico(c) == 0) {
                r = v / w
                ok = 1
            }
            si (libre y nivel == 2 y str_igual(op, "+")) {
                r = v + w
                ok = 1
            }
            si (libre y nivel == 2 y str_igual(op, "-")) {
                r = v - w
                ok = 1
            }
            si (ok y r <= 9007199254740991 y r >= 0 - 9007199254740991) {
                v = r
                k = k + 2
                plegados = plegados + 1
                seguir = 1
            }
        }
    }
    si (plegados == 0) { retornar 0 }
    __guardar64(c + 8, k)
    si (dinamico(c)) {
        cargar_inmediato(c, v * 2 + 1)
        fijar_tipo(c, 1)
    } sino { cargar_inmediato(c, v) }
    // Para marcar_literal_entero: tramo de tokens plegado y su valor.
    mem_fijar_global(47, pos)
    mem_fijar_global(48, k)
    mem_fijar_global(49, v)
    retornar 1
}

// ¿El operando derecho fue un único entero literal (sin signo, sin punto
// ni exponente, y de valor chico)? Lo anota (etiquetado) en c + 376.
funcion marcar_literal_entero(c, pos) {
    __guardar64(c + 376, 0)
    mem_fijar_global(50, 0 - 1)
    sea plegado = mem_global(47) == pos y mem_global(48) == __cargar64(c + 8)
    si (dinamico(c) == 0) {
        // Modo tipado: solo interesa si es potencia de 2 (reducción de fuerza).
        si (plegado) { mem_fijar_global(50, potencia_de_dos(mem_global(49))) }
        si (__cargar64(c + 8) == pos + 1 y entero_literal_en(__cargar64(c), pos)) { mem_fijar_global(50, potencia_de_dos(numero_literal(lexema_en(__cargar64(c), pos)))) }
        retornar 0
    }
    si (plegado y mem_global(49) >= 0 y mem_global(49) < 1000000000) {
        __guardar64(c + 376, mem_global(49) * 2 + 1)
        retornar 0
    }
    si (__cargar64(c + 8) != pos + 1) { retornar 0 }
    sea t = vec_obtener(__cargar64(c), pos)
    si (__cargar64(t) != 2) { retornar 0 }
    sea lexema = __cargar64(t + 8)
    si (posicion_exponente(lexema) >= 0 o str_largo(lexema) > 9) { retornar 0 }
    __guardar64(c + 376, numero_literal(lexema) * 2 + 1)
    retornar 0
}

// rcx = k sin tocar rax.
funcion cargar_constante_en_rcx(c, k) {
    op_empujar(c)
    op_inmediato(c, k)
    op_mov(c, 1, 0)
    op_sacar(c, 0)
    retornar 0
}

// rax ↔ rcx (con la pila: dos movimientos y un registro temporal).
funcion op_intercambiar_rax_rcx(c) {
    op_empujar(c)
    op_mov(c, 0, 1)
    op_sacar(c, 1)
    retornar 0
}

funcion aplicar_operador(c, lex) {
    si (dinamico(c) y (str_igual(lex, "/") == 0)) {
        sea nombre_r = "dyn_suma"
        si (str_igual(lex, "-")) { nombre_r = "dyn_resta" }
        si (str_igual(lex, "*")) { nombre_r = "dyn_mul" }
        si (str_igual(lex, "%")) { nombre_r = "dyn_mod" }
        si (str_igual(lex, "<")) { nombre_r = "dyn_menor" }
        si (str_igual(lex, "<=")) { nombre_r = "dyn_menor_igual" }
        si (str_igual(lex, ">")) { nombre_r = "dyn_mayor" }
        si (str_igual(lex, ">=")) { nombre_r = "dyn_mayor_igual" }
        si (str_igual(lex, "==")) { nombre_r = "dyn_igual" }
        si (str_igual(lex, "!=")) { nombre_r = "dyn_distinto" }
        sea literal = __cargar64(c + 376)
        __guardar64(c + 376, 0)
        sea probado = __cargar64(c + 384) == 1
        si (literal != 0 y str_igual(lex, "/") == 0) {
            operador_rapido_literal(c, lex, nombre_r, (literal - 1) / 2, probado)
            retornar 0
        }
        si (probado y __cargar64(c + 392) == 1) {
            operador_entero(c, lex, nombre_r)
            retornar 0
        }
        operador_rapido(c, lex, nombre_r)
        retornar 0
    }
    si (dinamico(c)) {
        empujar(c)
        sea nombre = "dyn_suma"
        si (str_igual(lex, "-")) { nombre = "dyn_resta" }
        si (str_igual(lex, "*")) { nombre = "dyn_mul" }
        si (str_igual(lex, "/")) { nombre = "dyn_div" }
        si (str_igual(lex, "%")) { nombre = "dyn_mod" }
        si (str_igual(lex, "<")) { nombre = "dyn_menor" }
        si (str_igual(lex, "<=")) { nombre = "dyn_menor_igual" }
        si (str_igual(lex, ">")) { nombre = "dyn_mayor" }
        si (str_igual(lex, ">=")) { nombre = "dyn_mayor_igual" }
        si (str_igual(lex, "==")) { nombre = "dyn_igual" }
        si (str_igual(lex, "!=")) { nombre = "dyn_distinto" }
        llamar_runtime(c, nombre, 2)
        retornar 0
    }
    sea op = str_byte(lex, 0)
    sea k2 = mem_global(50)
    mem_fijar_global(50, 0 - 1)
    si (k2 > 0 y str_largo(lex) == 1 y (op == 42 o op == 47 o op == 37)) {
        // Reducción de fuerza: el literal (en rax) se descarta.
        op_sacar(c, 0)
        si (op == 42) { retornar op_shl_constante(c, k2) }
        si (op == 47) { retornar op_dividir_potencia2(c, k2) }
        retornar op_resto_potencia2(c, k2)
    }
    rax_a_rcx_y_sacar(c)
    si (str_largo(lex) == 1 y op == 43) { retornar op_aritmetica(c, 1) }
    si (str_largo(lex) == 1 y op == 45) { retornar op_aritmetica(c, 2) }
    si (str_largo(lex) == 1 y op == 42) { retornar op_aritmetica(c, 3) }
    si (str_largo(lex) == 1 y op == 47) { retornar op_aritmetica(c, 4) }
    si (str_largo(lex) == 1 y op == 37) { retornar op_aritmetica(c, 5) }
    sea codigo = 156
    si (str_igual(lex, "<=")) { codigo = 158 }
    si (str_igual(lex, ">")) { codigo = 159 }
    si (str_igual(lex, ">=")) { codigo = 157 }
    si (str_igual(lex, "==")) { codigo = 148 }
    si (str_igual(lex, "!=")) { codigo = 149 }
    op_comparar(c, codigo)
    retornar 0
}

funcion producto(c) {
    si (plegar_constantes(c, 1) == 0) { unaria(c) }
    sea seguir = 1
    mientras (seguir) {
        si (ver(c, "*") o ver(c, "/") o ver(c, "%")) {
            sea lex = __cargar64(avanzar(c) + 8)
            sea tl = tipo_actual(c)
            empujar(c)
            sea pos_der = __cargar64(c + 8)
            unaria(c)
            sea tr = tipo_actual(c)
            marcar_literal_entero(c, pos_der)
            __guardar64(c + 384, tl)
            __guardar64(c + 392, tr)
            aplicar_operador(c, lex)
            __guardar64(c + 384, 0)
            __guardar64(c + 392, 0)
            tipo_binario(c, lex, tl, tr)
        } sino {
            seguir = 0
        }
    }
    retornar 0
}

funcion suma(c) {
    si (plegar_constantes(c, 2) == 0) { producto(c) }
    sea seguir = 1
    mientras (seguir) {
        si (ver(c, "+") o ver(c, "-")) {
            sea lex = __cargar64(avanzar(c) + 8)
            sea tl = tipo_actual(c)
            empujar(c)
            sea pos_der = __cargar64(c + 8)
            producto(c)
            sea tr = tipo_actual(c)
            marcar_literal_entero(c, pos_der)
            __guardar64(c + 384, tl)
            __guardar64(c + 392, tr)
            aplicar_operador(c, lex)
            __guardar64(c + 384, 0)
            __guardar64(c + 392, 0)
            tipo_binario(c, lex, tl, tr)
        } sino {
            seguir = 0
        }
    }
    retornar 0
}

// ¿Esta comparación es lo último de la condición de un si/mientras? Entonces
// su ruta rápida deja 0/1 en rax y la condición salta directo (sin fabricar
// el booleano etiquetado ni volver a comprobarlo).
funcion es_condicion_cruda(c) {
    retornar dinamico(c) y mem_global(45) != 0 y mem_global(45) == mem_global(44) y ver(c, ")")
}

funcion comparacion(c) {
    suma(c)
    sea seguir = 1
    mientras (seguir) {
        si (ver(c, "<") o ver(c, "<=") o ver(c, ">") o ver(c, ">=")) {
            sea lex = __cargar64(avanzar(c) + 8)
            sea tl = tipo_actual(c)
            empujar(c)
            sea pos_der = __cargar64(c + 8)
            suma(c)
            sea tr = tipo_actual(c)
            marcar_literal_entero(c, pos_der)
            __guardar64(c + 384, tl)
            __guardar64(c + 392, tr)
            sea crudo = es_condicion_cruda(c)
            mem_fijar_global(46, crudo)
            aplicar_operador(c, lex)
            mem_fijar_global(46, 0)
            __guardar64(c + 384, 0)
            __guardar64(c + 392, 0)
            tipo_binario(c, lex, tl, tr)
            si (crudo) {
                fijar_tipo(c, 14)
                mem_fijar_global(45, 0)
            }
        } sino {
            seguir = 0
        }
    }
    retornar 0
}

funcion igualdad(c) {
    comparacion(c)
    sea seguir = 1
    mientras (seguir) {
        si (ver(c, "==") o ver(c, "!=")) {
            sea lex = __cargar64(avanzar(c) + 8)
            sea tl = tipo_actual(c)
            empujar(c)
            sea pos_der = __cargar64(c + 8)
            comparacion(c)
            sea tr = tipo_actual(c)
            marcar_literal_entero(c, pos_der)
            __guardar64(c + 384, tl)
            __guardar64(c + 392, tr)
            sea crudo = es_condicion_cruda(c)
            mem_fijar_global(46, crudo)
            aplicar_operador(c, lex)
            mem_fijar_global(46, 0)
            __guardar64(c + 384, 0)
            __guardar64(c + 392, 0)
            tipo_binario(c, lex, tl, tr)
            si (crudo) {
                fijar_tipo(c, 14)
                mem_fijar_global(45, 0)
            }
        } sino {
            seguir = 0
        }
    }
    retornar 0
}

// y / o con cortocircuito; el resultado se normaliza a booleano.
funcion logica(c, operador, siguiente) {
    sea fin = nueva_etiqueta(c)
    condicion(c)
    si (operador == 1) { op_saltar_si_cero(c, fin) } sino { op_saltar_si_no_cero(c, fin) }
    si (siguiente == 1) { igualdad(c) } sino { conjuncion(c) }
    condicion(c)
    definir_etiqueta(c, fin)
    op_no_cero(c)
    si (dinamico(c)) {
        booleano_dinamico(c)
        fijar_tipo(c, 3)
    }
    retornar 0
}

funcion conjuncion(c) {
    igualdad(c)
    mientras (tomar(c, "y")) { logica(c, 1, 1) }
    retornar 0
}

funcion disyuncion(c) {
    conjuncion(c)
    mientras (tomar(c, "o")) { logica(c, 2, 2) }
    retornar 0
}

// Anidamiento máximo de expresiones y bloques: más allá, un archivo
// malicioso o generado agotaría la pila del compilador.
funcion entrar_nivel(c) {
    sea n = mem_global(44) + 1
    si (n > 1000) { error_en(c, "anidamiento demasiado profundo (más de 1000 niveles)") }
    mem_fijar_global(44, n)
    retornar 0
}

funcion salir_nivel() {
    mem_fijar_global(44, mem_global(44) - 1)
    retornar 0
}

// a ?? b: a si no es nulo; si no, b (b solo se evalúa si hace falta).
funcion expresion(c) {
    entrar_nivel(c)
    expresion_sin_nivel(c)
    retornar salir_nivel()
}

funcion expresion_sin_nivel(c) {
    disyuncion(c)
    mientras (dinamico(c) y ver(c, "?") y str_igual(tok_siguiente_lexema(c), "?")) {
        avanzar(c)
        avanzar(c)
        sea fin = nueva_etiqueta(c)
        op_saltar_si_no_cero(c, fin)
        disyuncion(c)
        definir_etiqueta(c, fin)
        fijar_tipo(c, 0)
    }
    // condición ? a : b
    si (dinamico(c) y ver(c, "?") y str_igual(tok_siguiente_lexema(c), "?") == 0) {
        avanzar(c)
        condicion(c)
        sea otro = nueva_etiqueta(c)
        sea fin_ternario = nueva_etiqueta(c)
        op_saltar_si_cero(c, otro)
        expresion(c)
        requerir(c, ":")
        op_saltar(c, fin_ternario)
        definir_etiqueta(c, otro)
        expresion(c)
        definir_etiqueta(c, fin_ternario)
        fijar_tipo(c, 0)
    }
    retornar 0
}

// ── Sentencias ────────────────────────────────────────────────────────────

funcion epilogo(c) {
    op_epilogo(c)
    retornar 0
}

funcion bloque(c) {
    entrar_nivel(c)
    bloque_sin_nivel(c)
    retornar salir_nivel()
}

funcion bloque_sin_nivel(c) {
    requerir(c, "{")
    sea locales = __cargar64(c + 56)
    sea marca = vec_largo(locales)
    sea marca_tipos = 0
    si (__cargar64(c + 336) != 0) { marca_tipos = vec_largo(__cargar64(c + 336)) }
    __guardar64(c + 232, __cargar64(c + 232) + 1)
    mientras (ver(c, "}") == 0) {
        si (tok_tipo(c) == 5) { error_en(c, "falta '}'") }
        sentencia(c)
    }
    requerir(c, "}")
    __guardar64(c + 232, __cargar64(c + 232) - 1)
    __guardar64(locales, marca)
    si (__cargar64(c + 336) != 0) { __guardar64(__cargar64(c + 336), marca_tipos) }
    retornar 0
}

// Salto incondicional a una etiqueta guardada en el contexto (romper/continuar).
funcion saltar_a(c, campo, palabra) {
    sea etiqueta = __cargar64(c + campo)
    si (etiqueta < 0) { error_en(c, str_concatenar(palabra, " fuera de un ciclo")) }
    salir_de_intentar(c, __cargar64(c + 240) - __cargar64(c + 248))
    op_saltar(c, etiqueta)
    tomar(c, ";")
    retornar 0
}

// Cierra n bloques intentar abiertos (al salir con retornar/romper/continuar).
funcion salir_de_intentar(c, n) {
    sea i = 0
    mientras (i < n) {
        llamar_runtime(c, "dyn_intentar_salir", 0)
        i = i + 1
    }
    retornar 0
}

// intentar { A } [capturar (e) { B }] [finalmente { C }]
// El runtime guarda rsp, rbp y la dirección de captura; lanzar (o un error
// del runtime) restaura ese marco y salta a la captura con el valor en rax.
funcion bloque_intentar(c) {
    sea captura = nueva_etiqueta(c)
    sea despues = nueva_etiqueta(c)
    sea pendiente = declarar_local(c, str_nuevo(0))
    sea valor = declarar_local(c, str_nuevo(0))
    cargar_inmediato(c, 0)
    guardar_local(c, pendiente)
    op_mov(c, 0, 4)                                            // a ← pila
    empujar(c)
    op_mov(c, 0, 5)                                            // a ← marco
    empujar(c)
    op_direccion(c, 4, captura)
    empujar(c)
    llamar_runtime(c, "dyn_intentar_entrar", 3)
    __guardar64(c + 240, __cargar64(c + 240) + 1)
    bloque(c)
    __guardar64(c + 240, __cargar64(c + 240) - 1)
    llamar_runtime(c, "dyn_intentar_salir", 0)
    op_saltar(c, despues)
    definir_etiqueta(c, captura)
    si (tomar(c, "capturar")) {
        sea parentesis = tomar(c, "(")
        sea nombre = requerir_ident(c)
        si (parentesis) { requerir(c, ")") }
        sea locales = __cargar64(c + 56)
        sea marca = vec_largo(locales)
        declarar_usuario(c, nombre)
        bloque(c)
        __guardar64(locales, marca)
    } sino {
        guardar_local(c, valor)
        cargar_inmediato(c, 1)
        guardar_local(c, pendiente)
    }
    definir_etiqueta(c, despues)
    si (tomar(c, "finalmente")) { bloque(c) }
    // Sin capturar: el error sigue su camino después de finalmente.
    sea fin = nueva_etiqueta(c)
    cargar_local(c, pendiente)
    op_saltar_si_cero(c, fin)
    cargar_local(c, valor)
    empujar(c)
    llamar_runtime(c, "dyn_lanzar", 1)
    definir_etiqueta(c, fin)
    retornar 0
}

// Cuerpo de un ciclo con sus etiquetas de romper y continuar.
funcion cuerpo_ciclo(c, fin, continuar) {
    sea romper_previo = __cargar64(c + 128)
    sea continuar_previo = __cargar64(c + 136)
    sea intentar_previo = __cargar64(c + 248)
    __guardar64(c + 128, fin)
    __guardar64(c + 136, continuar)
    __guardar64(c + 248, __cargar64(c + 240))
    bloque(c)
    __guardar64(c + 128, romper_previo)
    __guardar64(c + 136, continuar_previo)
    __guardar64(c + 248, intentar_previo)
    retornar 0
}

// para x en coleccion { ... }   (listas y textos)
funcion ciclo_para(c) {
    sea nombre = requerir_ident(c)
    requerir(c, "en")
    expresion(c)
    sea coleccion = declarar_local(c, str_nuevo(0))
    guardar_local(c, coleccion)
    cargar_inmediato(c, 0)
    sea indice = declarar_local(c, str_nuevo(0))
    guardar_local(c, indice)
    sea celdas = __cargar64(__cargar64(c + 216) + 8)
    sea variable = declarar_local(c, nombre)
    si (celdas) { marcar_ultima_celda(c) }
    sea inicio = nueva_etiqueta(c)
    sea siguiente = nueva_etiqueta(c)
    sea fin = nueva_etiqueta(c)
    definir_etiqueta(c, inicio)
    cargar_local(c, coleccion)
    empujar(c)
    llamar_runtime(c, "dyn_iter_largo", 1)
    op_mov(c, 1, 0)
    cargar_local(c, indice)
    op_saltar_si_mayor_igual(c, fin)
    cargar_local(c, coleccion)
    empujar(c)
    cargar_local(c, indice)
    empujar(c)
    llamar_runtime(c, "dyn_iter_obtener", 2)
    si (celdas) {
        empujar(c)
        llamar_runtime(c, "dyn_celda_nueva", 1)
    }
    guardar_local(c, variable)
    cuerpo_ciclo(c, fin, siguiente)
    definir_etiqueta(c, siguiente)
    cargar_local(c, indice)
    op_sumar_inmediato(c, 1)
    guardar_local(c, indice)
    op_saltar(c, inicio)
    definir_etiqueta(c, fin)
    retornar 0
}

funcion es_simbolo(t, lexema) {
    retornar __cargar64(t) == 4 y str_igual(__cargar64(t + 8), lexema)
}

funcion es_operador_compuesto(t) {
    retornar es_simbolo(t, "+") o es_simbolo(t, "-") o es_simbolo(t, "*") o es_simbolo(t, "/") o es_simbolo(t, "%")
}

// ¿Empieza aquí "nombre([...] | .campo)+ =" (o un operador compuesto)?
funcion es_asignacion_indice(c) {
    sea tokens = __cargar64(c)
    sea j = __cargar64(c + 8) + 1
    sea grupos = 0
    sea seguir = 1
    mientras (seguir) {
        sea t = vec_obtener(tokens, j)
        si (es_simbolo(t, "[")) {
            sea nivel = 1
            j = j + 1
            mientras (nivel > 0) {
                sea u = vec_obtener(tokens, j)
                si (__cargar64(u) == 5) { retornar 0 }
                si (es_simbolo(u, "[")) { nivel = nivel + 1 }
                si (es_simbolo(u, "]")) { nivel = nivel - 1 }
                j = j + 1
            }
            grupos = grupos + 1
        } sino {
            si (es_simbolo(t, ".") y __cargar64(vec_obtener(tokens, j + 1)) == 1 y es_simbolo(vec_obtener(tokens, j + 2), "(") == 0) {
                j = j + 2
                grupos = grupos + 1
            } sino {
                seguir = 0
            }
        }
    }
    si (grupos == 0) { retornar 0 }
    sea t = vec_obtener(tokens, j)
    si (es_simbolo(t, "=")) { retornar 1 }
    retornar es_operador_compuesto(t) y es_simbolo(vec_obtener(tokens, j + 1), "=")
}

// nombre[i].campo...[k] = valor  (o += -= *= /= %=)
funcion asignacion_indice(c) {
    sea nombre = __cargar64(avanzar(c) + 8)
    cargar_var(c, variable(c, nombre))
    sea seguir = 1
    mientras (seguir) {
        empujar(c)
        si (tomar(c, "[")) {
            expresion(c)
            requerir(c, "]")
        } sino {
            requerir(c, ".")
            cargar_caja(c, requerir_ident(c))
        }
        empujar(c)
        si (ver(c, "[") o ver(c, ".")) {
            indice_rapido(c)
        } sino {
            seguir = 0
        }
    }
    si (tomar(c, "=")) {
        expresion(c)
    } sino {
        sea lex = __cargar64(avanzar(c) + 8)
        requerir(c, "=")
        op_empujar_pila(c, 8)                                  // índice y objeto otra vez
        op_empujar_pila(c, 8)
        indice_rapido(c)
        empujar(c)
        expresion(c)
        aplicar_operador(c, lex)
    }
    empujar(c)
    fijar_indice_rapido(c)
    tomar(c, ";")
    retornar 0
}

// x += e, x -= e, x *= e, x /= e, x %= e
funcion es_asignacion_compuesta(c) {
    si (tok_tipo(c) != 1 o tok_tipo_en(c, 1) != 4) { retornar 0 }
    sea op = tok_siguiente_lexema(c)
    si (str_igual(op, "+") o str_igual(op, "-") o str_igual(op, "*") o str_igual(op, "/") o str_igual(op, "%")) {
        sea i = __cargar64(c + 8) + 2
        sea t = vec_obtener(__cargar64(c), i)
        retornar __cargar64(t) == 4 y str_igual(__cargar64(t + 8), "=")
    }
    retornar 0
}

funcion sentencia(c) {
    si (tomar(c, ";")) { retornar 0 }
    si (tomar(c, "__dialecto")) {
        __guardar64(c + 104, numero_literal(__cargar64(avanzar(c) + 8)))
        retornar 0
    }
    si (ver(c, "importar") y tok_tipo_en(c, 1) == 3) {
        // Las importaciones se resuelven antes de compilar (ver el programa).
        avanzar(c)
        avanzar(c)
        tomar(c, ";")
        retornar 0
    }
    si (tomar(c, "sea")) {
        sea posicion_nombre = __cargar64(c + 8)
        sea nombre = requerir_ident(c)
        sea anotado = saltar_tipo(c)
        requerir(c, "=")
        sea g = indice_global(c, nombre)
        // sea f = funcion(..) { .. f(..) .. }: la celda existe antes del cuerpo,
        // así la función anónima puede llamarse a sí misma.
        sea es_global = dinamico(c) y g >= 0 y __cargar64(c + 232) == 0 y __cargar64(__cargar64(c + 216) + 48) == 1
        si (es_global == 0 y dinamico(c) y __cargar64(__cargar64(c + 216) + 8) y ver(c, "funcion") y str_igual(tok_siguiente_lexema(c), "(")) {
            cargar_inmediato(c, 0)
            declarar_usuario(c, nombre)
            expresion(c)
            guardar_var(c, variable(c, nombre))
            tomar(c, ";")
            retornar 0
        }
        expresion(c)
        sea tipo_var = anotado
        si (dinamico(c)) {
            sea que = str_concatenar("la variable ", nombre)
            exigir_tipo(c, anotado, tipo_actual(c), que)
            // Sin anotación: el tipo del valor, si nunca se vuelve a asignar.
            si (anotado == 0 y tipo_actual(c) != 6 y reasignada(c, nombre, posicion_nombre, es_global) == 0) { tipo_var = tipo_actual(c) }
            // Entero probado que solo recibe enteros: sigue siendo entero probado.
            si (anotado == 0 y tipo_actual(c) == 1 y reasignaciones_enteras(c, nombre, posicion_nombre, es_global)) { tipo_var = 1 }
        }
        si (dinamico(c) y g >= 0 y __cargar64(c + 232) == 0 y __cargar64(__cargar64(c + 216) + 48) == 1) {
            guardar_var(c, acceso(3, g))
            anotar_tipo_variable(c, nombre, tipo_var)
        } sino {
            __guardar64(c + 368, tipo_var)
            si (dinamico(c)) { declarar_usuario(c, nombre) } sino { guardar_local(c, declarar_local(c, nombre)) }
        }
        tomar(c, ";")
        retornar 0
    }
    si (tomar(c, "si")) {
        requerir(c, "(")
        // si (p) / si (p != nulo): dentro del bloque p es un puntero *T.
        sea estrechada = 0
        si (dinamico(c) y tok_tipo(c) == 1) {
            sea cand = tok_lexema(c)
            sea sig = tok_siguiente_lexema(c)
            si (str_igual(sig, ")") o (str_igual(sig, "!=") y str_igual(lexema_en(__cargar64(c), __cargar64(c + 8) + 2), "nulo") y str_igual(lexema_en(__cargar64(c), __cargar64(c + 8) + 3), ")"))) {
                si (tipo_variable(c, cand) == 13) { estrechada = cand }
            }
        }
        mem_fijar_global(45, mem_global(44) + 1)
        expresion(c)
        mem_fijar_global(45, 0)
        requerir(c, ")")
        // si (opcional) |v| { … }: v es el valor ya comprobado (*T).
        sea desempaque = 0
        si (dinamico(c) y ver(c, "|")) {
            avanzar(c)
            desempaque = requerir_ident(c)
            requerir(c, "|")
            __guardar64(c + 368, 12)
            declarar_usuario(c, desempaque)
            cargar_var(c, variable(c, desempaque))
            si (tipo_actual(c) != 12 y tipo_actual(c) != 13) { fijar_tipo(c, 13) }
        }
        condicion(c)
        sea otro = nueva_etiqueta(c)
        sea fin = nueva_etiqueta(c)
        op_saltar_si_cero(c, otro)
        sea marca_tipos = 0 - 1
        si (estrechada != 0 y __cargar64(c + 336) != 0) {
            marca_tipos = vec_largo(__cargar64(c + 336))
            anotar_tipo_variable(c, estrechada, 12)
        }
        bloque(c)
        si (marca_tipos >= 0) { __guardar64(__cargar64(c + 336), marca_tipos) }
        si (desempaque != 0) { anotar_tipo_variable(c, desempaque, 0) }
        op_saltar(c, fin)
        definir_etiqueta(c, otro)
        si (tomar(c, "sino")) {
            si (ver(c, "si")) { sentencia(c) } sino { bloque(c) }
        }
        definir_etiqueta(c, fin)
        retornar 0
    }
    si (tomar(c, "mientras")) {
        sea inicio = nueva_etiqueta(c)
        sea fin = nueva_etiqueta(c)
        definir_etiqueta(c, inicio)
        requerir(c, "(")
        mem_fijar_global(45, mem_global(44) + 1)
        expresion(c)
        mem_fijar_global(45, 0)
        requerir(c, ")")
        condicion(c)
        op_saltar_si_cero(c, fin)
        cuerpo_ciclo(c, fin, inicio)
        op_saltar(c, inicio)
        definir_etiqueta(c, fin)
        retornar 0
    }
    si (dinamico(c) y ver(c, "#") y str_igual(tok_siguiente_lexema(c), "[")) {
        // #[Atributo(...)]: ya registrado en la primera lectura.
        avanzar(c)
        sea nivel = 0
        sea seguir = 1
        mientras (seguir) {
            si (ver(c, "[")) { nivel = nivel + 1 }
            si (ver(c, "]")) { nivel = nivel - 1 }
            si (tok_tipo(c) == 5) { error_en(c, "falta ']' en el atributo") }
            avanzar(c)
            si (nivel == 0) { seguir = 0 }
        }
        retornar 0
    }
    si (dinamico(c) y ver(c, "inseguro") y str_igual(tok_siguiente_lexema(c), "{")) {
        // Bloque inseguro: punteros @x, *(p + i) sobre memoria del runtime
        // (con límites verificados).
        avanzar(c)
        bloque(c)
        retornar 0
    }
    si (dinamico(c) y tomar(c, "*")) {
        unaria(c)
        empujar(c)
        requerir(c, "=")
        expresion(c)
        empujar(c)
        llamar_runtime(c, "dyn_escribir_puntero", 2)
        tomar(c, ";")
        retornar 0
    }
    si (dinamico(c) y ver(c, "extern") y tok_tipo_en(c, 1) == 3) {
        declaracion_externa(c)
        retornar 0
    }
    si (dinamico(c) y (ver(c, "clase") o ver(c, "estructura") o ver(c, "interfaz") o ver(c, "abstracto")) y tok_tipo_en(c, 1) == 1) {
        definicion_clase(c)
        retornar 0
    }
    si (ver(c, "para") y tok_tipo_en(c, 1) == 1) {
        avanzar(c)
        ciclo_para(c)
        retornar 0
    }
    si (tomar(c, "romper")) { saltar_a(c, 128, "romper") retornar 0 }
    si (tomar(c, "continuar")) { saltar_a(c, 136, "continuar") retornar 0 }
    si (tomar(c, "retornar")) {
        si (ver(c, "}") o ver(c, ";")) {
            cargar_inmediato(c, 0)
            fijar_tipo(c, 6)
        } sino { expresion(c) }
        si (__cargar64(c + 360) != 6) { exigir_tipo(c, __cargar64(c + 360), tipo_actual(c), "el valor de retorno") }
        tomar(c, ";")
        si (__cargar64(c + 240) > 0) {
            empujar(c)
            salir_de_intentar(c, __cargar64(c + 240))
            op_sacar(c, 0)
        }
        epilogo(c)
        retornar 0
    }
    si (dinamico(c) y ver(c, "intentar") y str_igual(tok_siguiente_lexema(c), "{")) {
        avanzar(c)
        bloque_intentar(c)
        retornar 0
    }
    si (dinamico(c) y tomar(c, "lanzar")) {
        expresion(c)
        empujar(c)
        llamar_runtime(c, "dyn_lanzar", 1)
        tomar(c, ";")
        retornar 0
    }
    si (dinamico(c) == 0 y ver(c, "mostrar") y str_igual(tok_siguiente_lexema(c), "(")) {
        avanzar(c)
        llamada(c, "rt_mostrar")
        tomar(c, ";")
        retornar 0
    }
    si (tok_tipo(c) == 1 y str_igual(tok_siguiente_lexema(c), "=")) {
        sea nombre = __cargar64(avanzar(c) + 8)
        avanzar(c)
        expresion(c)
        exigir_tipo(c, tipo_variable(c, nombre), tipo_actual(c), str_concatenar("la variable ", nombre))
        guardar_var(c, variable(c, nombre))
        tomar(c, ";")
        retornar 0
    }
    si (es_asignacion_compuesta(c)) {
        sea nombre = __cargar64(avanzar(c) + 8)
        sea lex = __cargar64(avanzar(c) + 8)
        avanzar(c)
        sea d = variable(c, nombre)
        cargar_var(c, d)
        empujar(c)
        expresion(c)
        sea tr = tipo_actual(c)
        aplicar_operador(c, lex)
        tipo_binario(c, lex, tipo_variable(c, nombre), tr)
        exigir_tipo(c, tipo_variable(c, nombre), tipo_actual(c), str_concatenar("la variable ", nombre))
        guardar_var(c, d)
        tomar(c, ";")
        retornar 0
    }
    si (dinamico(c) y tok_tipo(c) == 1 y es_asignacion_indice(c)) {
        asignacion_indice(c)
        retornar 0
    }
    expresion(c)
    tomar(c, ";")
    retornar 0
}

// Prólogo con reserva de marco; devuelve la posición del tamaño a parchear.
funcion prologo(c) { retornar op_prologo(c) }

funcion cerrar_marco(c, posicion) {
    sea tamano = __cargar64(c + 64) * 8
    si (tamano % 16 != 0) { tamano = tamano + 8 }
    op_fijar_marco(c, posicion, tamano)
    retornar 0
}

// ¿El bloque que empieza en el token actual contiene una función anónima?
funcion contiene_cierre(c) {
    si (ver(c, "{") == 0) { retornar 0 }
    sea tokens = __cargar64(c)
    sea j = __cargar64(c + 8)
    sea nivel = 0
    sea seguir = 1
    mientras (seguir) {
        sea t = vec_obtener(tokens, j)
        si (__cargar64(t) == 5) { retornar 0 }
        si (es_simbolo(t, "{")) { nivel = nivel + 1 }
        si (es_simbolo(t, "}")) {
            nivel = nivel - 1
            si (nivel == 0) { seguir = 0 }
        }
        si (__cargar64(t) == 1 y str_igual(__cargar64(t + 8), "funcion") y es_simbolo(vec_obtener(tokens, j + 1), "(")) { retornar 1 }
        j = j + 1
    }
    retornar 0
}

// Abre una función: guarda el estado del código que la rodea, define su
// etiqueta, emite el prólogo y declara los parámetros. Devuelve el estado.
funcion abrir_marco(c, etiqueta, nombres, es_cierre) {
    sea estado = mem_reservar(96)
    sea tipos_param = __cargar64(c + 344)
    __guardar64(c + 344, vec_nuevo())
    si (__cargar64(c + 336) != 0) { __guardar64(estado + 80, vec_largo(__cargar64(c + 336))) } sino { __guardar64(estado + 80, 0) }
    __guardar64(estado + 88, __cargar64(c + 360))
    __guardar64(c + 360, __cargar64(c + 352))
    __guardar64(c + 352, 0)
    sea locales = __cargar64(c + 56)
    __guardar64(estado, vec_largo(locales))
    __guardar64(estado + 8, __cargar64(c + 64))
    __guardar64(estado + 16, __cargar64(c + 88))
    __guardar64(estado + 32, __cargar64(c + 128))
    __guardar64(estado + 40, __cargar64(c + 136))
    __guardar64(estado + 48, __cargar64(c + 216))
    __guardar64(estado + 56, __cargar64(c + 232))
    __guardar64(estado + 64, __cargar64(c + 240))
    __guardar64(estado + 72, __cargar64(c + 248))
    sea celdas = 0
    si (dinamico(c)) { celdas = contiene_cierre(c) }
    sea padre = 0
    si (es_cierre) { padre = __cargar64(c + 216) }
    sea marco = marco_nuevo(vec_largo(locales), celdas, padre, es_cierre)
    __guardar64(c + 216, marco)
    __guardar64(c + 88, vec_largo(locales))
    __guardar64(c + 64, 0)
    __guardar64(c + 128, 0 - 1)
    __guardar64(c + 136, 0 - 1)
    __guardar64(c + 232, 0)
    __guardar64(c + 240, 0)
    __guardar64(c + 248, 0)
    definir_etiqueta(c, etiqueta)
    __guardar64(estado + 24, prologo(c))
    sea n = vec_largo(nombres)
    sea i = 0
    mientras (i < n) {
        si (i < vec_largo(tipos_param)) { __guardar64(c + 368, vec_obtener(tipos_param, i)) }
        declarar_variable(c, vec_obtener(nombres, i), 16 + (n - 1 - i) * 8)
        i = i + 1
    }
    si (es_cierre) { __guardar64(marco + 40, 16 + (n - 1) * 8) }
    si (celdas) {
        // Cada parámetro pasa a una celda propia.
        i = 0
        si (es_cierre) { i = 1 }
        mientras (i < n) {
            cargar_local(c, 16 + (n - 1 - i) * 8)
            empujar(c)
            llamar_runtime(c, "dyn_celda_nueva", 1)
            si (i < vec_largo(tipos_param)) { __guardar64(c + 368, vec_obtener(tipos_param, i)) }
            guardar_local(c, declarar_local(c, vec_obtener(nombres, i)))
            marcar_ultima_celda(c)
            i = i + 1
        }
    }
    retornar estado
}

funcion abrir_funcion(c, etiqueta, nombres) { retornar abrir_marco(c, etiqueta, nombres, 0) }
funcion abrir_cierre(c, etiqueta, nombres) { retornar abrir_marco(c, etiqueta, nombres, 1) }

funcion cerrar_funcion(c, estado) {
    cargar_inmediato(c, 0)
    epilogo(c)
    cerrar_marco(c, __cargar64(estado + 24))
    __guardar64(__cargar64(c + 56), __cargar64(estado))
    __guardar64(c + 64, __cargar64(estado + 8))
    __guardar64(c + 88, __cargar64(estado + 16))
    __guardar64(c + 128, __cargar64(estado + 32))
    __guardar64(c + 136, __cargar64(estado + 40))
    __guardar64(c + 216, __cargar64(estado + 48))
    __guardar64(c + 232, __cargar64(estado + 56))
    __guardar64(c + 240, __cargar64(estado + 64))
    __guardar64(c + 248, __cargar64(estado + 72))
    si (__cargar64(c + 336) != 0) { __guardar64(__cargar64(c + 336), __cargar64(estado + 80)) }
    __guardar64(c + 360, __cargar64(estado + 88))
    mem_liberar(estado)
    retornar 0
}

// (p1, p2: tipo, ...): tipo → nombres de los parámetros.
funcion parametros(c, nombres) {
    __guardar64(c + 344, vec_nuevo())
    requerir(c, "(")
    si (ver(c, ")") == 0) {
        parametro(c, nombres)
        mientras (tomar(c, ",")) { parametro(c, nombres) }
    }
    requerir(c, ")")
    __guardar64(c + 352, saltar_tipo(c))
    retornar nombres
}

// nombre [: tipo] [= valor por defecto]
funcion parametro(c, nombres) {
    si (ver(c, ".") y str_igual(tok_siguiente_lexema(c), ".")) {
        requerir(c, ".")
        requerir(c, ".")
        requerir(c, ".")
    }
    // comptime T: T llega como el nombre del tipo (texto).
    si (ver(c, "comptime") y tok_tipo_en(c, 1) == 1) { avanzar(c) }
    sea nombre = requerir_ident(c)
    vec_agregar(nombres, nombre)
    vec_agregar(__cargar64(c + 344), saltar_tipo(c))
    si (tomar(c, "=")) {
        sea d = mem_reservar(16)
        __guardar64(d, nombre)
        __guardar64(d + 8, __cargar64(c + 8))
        vec_agregar(__cargar64(c + 280), d)
        __guardar64(c + 8, fin_valor_defecto(__cargar64(c), __cargar64(c + 8)))
    }
    retornar 0
}

// Dentro de la función: un parámetro que llegó nulo toma su valor por defecto.
funcion aplicar_defectos(c) {
    sea pendientes = __cargar64(c + 280)
    si (vec_largo(pendientes) == 0) { retornar 0 }
    __guardar64(c + 280, vec_nuevo())
    sea posicion = __cargar64(c + 8)
    sea i = 0
    mientras (i < vec_largo(pendientes)) {
        sea d = vec_obtener(pendientes, i)
        sea a = variable(c, __cargar64(d))
        sea listo = nueva_etiqueta(c)
        cargar_var(c, a)
        op_saltar_si_no_cero(c, listo)
        __guardar64(c + 8, __cargar64(d + 8))
        expresion(c)
        guardar_var(c, a)
        definir_etiqueta(c, listo)
        i = i + 1
    }
    __guardar64(c + 8, posicion)
    retornar 0
}

funcion saltar_por_encima(c) {
    sea etiqueta = nueva_etiqueta(c)
    op_saltar(c, etiqueta)
    retornar etiqueta
}

// funcion nombre(p1, p2: tipo, ...): tipo { ... }
// Se emite en línea dentro del programa principal, saltándola con un jmp.
funcion definicion_funcion(c) {
    requerir_ident(c)
    saltar_genericos(c)
    sea indice = __cargar64(c + 152)
    sea f = vec_obtener(__cargar64(c + 144), indice)
    __guardar64(c + 152, indice + 1)
    // --release, segunda pasada: una función inalcanzable no se emite.
    sea alcanzables = __cargar64(c + 416)
    si (alcanzables != 0) {
        si (__cargar8(alcanzables + indice) == 0) {
            saltar_definicion(c)
            retornar 0
        }
    }
    sea previa = __cargar64(c + 400)
    __guardar64(c + 400, indice)
    definicion_funcion_cuerpo(c, f)
    __guardar64(c + 400, previa)
    retornar 0
}

// Salta "(…)[: tipo] { … }" sin generar código.
funcion saltar_definicion(c) {
    mientras (ver(c, "{") == 0) {
        si (tok_tipo(c) == 5) { error_en(c, "falta '{'") }
        si (ver(c, "(")) {
            sea p = 0
            sea seguir = 1
            mientras (seguir) {
                si (ver(c, "(")) { p = p + 1 }
                si (ver(c, ")")) { p = p - 1 }
                avanzar(c)
                si (p == 0) { seguir = 0 }
            }
        } sino { avanzar(c) }
    }
    sea nivel = 0
    sea seguir_b = 1
    mientras (seguir_b) {
        si (ver(c, "{")) { nivel = nivel + 1 }
        si (ver(c, "}")) { nivel = nivel - 1 }
        avanzar(c)
        si (nivel == 0) { seguir_b = 0 }
    }
    retornar 0
}

funcion definicion_funcion_cuerpo(c, f) {
    sea saltar = saltar_por_encima(c)
    sea nombres = parametros(c, vec_nuevo())
    sea estado = abrir_funcion(c, __cargar64(f + 8), nombres)
    vec_liberar(nombres)
    aplicar_defectos(c)
    bloque(c)
    cerrar_funcion(c, estado)
    definir_etiqueta(c, saltar)
    retornar 0
}

funcion comillas(nombre) {
    sea r = str_nuevo(str_largo(nombre) + 2)
    str_agregar_byte(r, 34)
    str_agregar(r, nombre)
    str_agregar_byte(r, 34)
    retornar r
}

// rax ← caja de texto del lenguaje / texto del runtime con ese contenido.
funcion cargar_caja(c, nombre) {
    op_direccion(c, 1, literal_caja(c, comillas(nombre)))
    retornar 0
}

funcion cargar_texto_crudo(c, nombre) {
    op_direccion(c, 1, literal(c, comillas(nombre)))
    retornar 0
}

funcion llamar_etiqueta(c, etiqueta, n) {
    op_llamar(c, etiqueta)
    si (n > 0) {
        op_liberar_pila(c, n * 8)
    }
    retornar 0
}

funcion un_nombre(nombre) {
    sea v = vec_nuevo()
    vec_agregar(v, nombre)
    retornar v
}

// Palabra de datos que apunta a otro desplazamiento de datos o a código.
funcion dato_puntero(c, destino) {
    sea datos = ctx_datos(c)
    sea p = mem_reservar(16)
    __guardar64(p, str_largo(datos))
    __guardar64(p + 8, destino)
    vec_agregar(__cargar64(c + 112), p)
    bytes_le(datos, 0, 8)
    retornar 0
}

funcion dato_etiqueta(c, etiqueta) {
    sea datos = ctx_datos(c)
    sea p = mem_reservar(16)
    __guardar64(p, str_largo(datos))
    __guardar64(p + 8, etiqueta)
    vec_agregar(__cargar64(c + 176), p)
    bytes_le(datos, 0, 8)
    retornar 0
}

// Registro de clase en datos (lo lee runtime/dyn.cfv):
// [nombre][padre o 0][n métodos]([nombre][código][aridad])*
funcion emitir_registro_clase(c, k) {
    sea nombre = literal(c, comillas(__cargar64(k)))
    sea padre = 0 - 1
    si (__cargar64(k + 8) != 0) { padre = literal(c, comillas(__cargar64(k + 8))) }
    sea metodos = __cargar64(k + 16)
    sea nombres = vec_nuevo()
    sea i = 0
    mientras (i < vec_largo(metodos)) {
        vec_agregar(nombres, literal(c, comillas(__cargar64(vec_obtener(metodos, i)))))
        i = i + 1
    }
    sea datos = ctx_datos(c)
    mientras (str_largo(datos) % 8 != 0) { str_agregar_byte(datos, 0) }
    vec_agregar(__cargar64(c + 184), str_largo(datos))
    dato_puntero(c, nombre)
    si (padre < 0) { bytes_le(datos, 0, 8) } sino { dato_puntero(c, padre) }
    bytes_le(datos, vec_largo(metodos), 8)
    i = 0
    mientras (i < vec_largo(metodos)) {
        sea m = vec_obtener(metodos, i)
        dato_puntero(c, vec_obtener(nombres, i))
        dato_etiqueta(c, __cargar64(m + 8))
        bytes_le(datos, __cargar64(m + 16), 8)
        i = i + 1
    }
    vec_liberar(nombres)
    retornar 0
}

// Inicializador de un campo: esto["campo"] = valor (o nulo).
funcion inicializador_campo(c, k, nombre, con_valor) {
    sea etiqueta = nueva_etiqueta(c)
    vec_agregar(__cargar64(k + 56), etiqueta)
    sea estado = abrir_funcion(c, etiqueta, un_nombre("esto"))
    cargar_var(c, variable(c, "esto"))
    empujar(c)
    cargar_caja(c, nombre)
    empujar(c)
    si (con_valor) { expresion(c) } sino { cargar_inmediato(c, 0) }
    empujar(c)
    fijar_indice_rapido(c)
    cerrar_funcion(c, estado)
    retornar 0
}

funcion definicion_clase(c) {
    tomar(c, "abstracto")
    si (tomar(c, "interfaz")) {
        // Las interfaces describen firmas; no generan código.
        requerir_ident(c)
        mientras (ver(c, "{") == 0) { avanzar(c) }
        sea nivel = 0
        sea seguir = 1
        mientras (seguir) {
            si (ver(c, "{")) { nivel = nivel + 1 }
            si (ver(c, "}")) { nivel = nivel - 1 }
            si (tok_tipo(c) == 5) { error_en(c, "falta '}' en la interfaz") }
            avanzar(c)
            si (nivel == 0) { seguir = 0 }
        }
        retornar 0
    }
    si (tomar(c, "estructura") == 0) { requerir(c, "clase") }
    sea nombre = requerir_ident(c)
    sea k = buscar_clase(c, nombre)
    mientras (ver(c, "{") == 0) { avanzar(c) }
    requerir(c, "{")
    sea saltar = saltar_por_encima(c)
    sea clase_previa = __cargar64(c + 168)
    __guardar64(c + 168, k)
    mientras (ver(c, "}") == 0) {
        si (tok_tipo(c) == 5) { error_en(c, "falta '}' en la clase") }
        mientras (tomar(c, "privado") o tomar(c, "publico") o tomar(c, "estatico")) { }
        si (tomar(c, "sea") o tomar(c, "campo")) {
            sea campo = requerir_ident(c)
            saltar_tipo(c)
            inicializador_campo(c, k, campo, tomar(c, "="))
            tomar(c, ";")
        } sino {
            si (tomar(c, "funcion") o tomar(c, "metodo")) {
                requerir_ident(c)
                sea m = vec_obtener(__cargar64(k + 16), __cargar64(k + 64))
                __guardar64(k + 64, __cargar64(k + 64) + 1)
                sea nombres = parametros(c, un_nombre("esto"))
                sea estado = abrir_funcion(c, __cargar64(m + 8), nombres)
                vec_liberar(nombres)
                aplicar_defectos(c)
                bloque(c)
                cerrar_funcion(c, estado)
            } sino {
                si (__cargar64(k + 48) y tok_tipo(c) == 1) {
                    sea campo = requerir_ident(c)
                    requerir(c, ":")
                    requerir_ident(c)
                    inicializador_campo(c, k, campo, 0)
                    tomar(c, ";")
                    tomar(c, ",")
                } sino {
                    error_en(c, "miembro de clase inválido")
                }
            }
        }
    }
    requerir(c, "}")
    // Inicialización de campos: primero los del padre.
    sea estado = abrir_funcion(c, __cargar64(k + 40), un_nombre("esto"))
    sea esto = __cargar64(variable(c, "esto") + 8)
    si (__cargar64(k + 8) != 0) {
        sea padre = buscar_clase(c, __cargar64(k + 8))
        si (padre == 0) { error_en(c, str_concatenar("clase padre desconocida: ", __cargar64(k + 8))) }
        cargar_local(c, esto)
        empujar(c)
        llamar_etiqueta(c, __cargar64(padre + 40), 1)
    }
    sea inits = __cargar64(k + 56)
    sea i = 0
    mientras (i < vec_largo(inits)) {
        cargar_local(c, esto)
        empujar(c)
        llamar_etiqueta(c, vec_obtener(inits, i), 1)
        i = i + 1
    }
    cerrar_funcion(c, estado)
    // Constructor: Nombre(args) crea el mapa, inicializa campos y llama a
    // "constructor" (propio o heredado); una estructura asigna por posición.
    sea n = __cargar64(buscar_funcion(c, nombre) + 16)
    sea ocultos = vec_nuevo()
    i = 0
    mientras (i < n) {
        vec_agregar(ocultos, str_nuevo(0))
        i = i + 1
    }
    estado = abrir_funcion(c, __cargar64(k + 32), ocultos)
    sea objeto = declarar_local(c, str_nuevo(0))
    llamar_runtime(c, "dyn_mapa_nuevo", 0)
    guardar_local(c, objeto)
    cargar_local(c, objeto)
    empujar(c)
    cargar_caja(c, "__clase")
    empujar(c)
    cargar_caja(c, nombre)
    empujar(c)
    fijar_indice_rapido(c)
    cargar_local(c, objeto)
    empujar(c)
    llamar_etiqueta(c, __cargar64(k + 40), 1)
    sea ctor = metodo_en_cadena(c, k, "constructor")
    si (ctor != 0) {
        cargar_local(c, objeto)
        empujar(c)
        i = 0
        mientras (i < n) {
            cargar_local(c, 16 + (n - 1 - i) * 8)
            empujar(c)
            i = i + 1
        }
        llamar_etiqueta(c, __cargar64(ctor + 8), n + 1)
    } sino {
        sea campos = __cargar64(k + 24)
        i = 0
        mientras (i < n y i < vec_largo(campos)) {
            cargar_local(c, objeto)
            empujar(c)
            cargar_caja(c, vec_obtener(campos, i))
            empujar(c)
            cargar_local(c, 16 + (n - 1 - i) * 8)
            empujar(c)
            fijar_indice_rapido(c)
            i = i + 1
        }
    }
    cargar_local(c, objeto)
    epilogo(c)
    cerrar_funcion(c, estado)
    vec_liberar(ocultos)
    emitir_registro_clase(c, k)
    __guardar64(c + 168, clase_previa)
    definir_etiqueta(c, saltar)
    retornar 0
}

// Tabla de todas las clases: [n][registro]*  (al final de los datos).
funcion emitir_tabla_clases(c) {
    sea datos = ctx_datos(c)
    mientras (str_largo(datos) % 8 != 0) { str_agregar_byte(datos, 0) }
    __guardar64(c + 192, str_largo(datos))
    sea registros = __cargar64(c + 184)
    bytes_le(datos, vec_largo(registros), 8)
    sea i = 0
    mientras (i < vec_largo(registros)) {
        dato_puntero(c, vec_obtener(registros, i))
        i = i + 1
    }
    // Después de la tabla: cuántas variables globales hay (raíces del GC).
    bytes_le(datos, vec_largo(__cargar64(c + 224)), 8)
    retornar 0
}

// Salta un grupo balanceado que empieza en j ("(" o "{"); devuelve el
// índice siguiente al cierre.
funcion saltar_grupo(toks, j, abre, cierra) {
    sea nivel = 0
    mientras (j < vec_largo(toks)) {
        sea t = vec_obtener(toks, j)
        si (__cargar64(t) == 5) { retornar j }
        si (es_simbolo(t, abre)) { nivel = nivel + 1 }
        si (es_simbolo(t, cierra)) {
            nivel = nivel - 1
            si (nivel == 0) { retornar j + 1 }
        }
        j = j + 1
    }
    retornar j
}

// ¿Hay funciones anónimas en el nivel superior del programa (fuera de las
// funciones con nombre)? Solo entonces las variables de los bucles del
// programa principal necesitan celdas (para capturarlas por iteración).
funcion programa_necesita_celdas(c) {
    sea toks = __cargar64(c)
    sea n = vec_largo(toks)
    sea j = 0
    mientras (j < n) {
        sea t = vec_obtener(toks, j)
        si (__cargar64(t) == 5) { retornar 0 }
        si (__cargar64(t) == 1 y str_igual(__cargar64(t + 8), "funcion")) {
            si (j + 1 < n y es_simbolo(vec_obtener(toks, j + 1), "(")) { retornar 1 }
            // Con nombre: parámetros y cuerpo enteros fuera.
            sea k = j + 1
            mientras (k < n y es_simbolo(vec_obtener(toks, k), "(") == 0 y __cargar64(vec_obtener(toks, k)) != 5) { k = k + 1 }
            k = saltar_grupo(toks, k, "(", ")")
            mientras (k < n y es_simbolo(vec_obtener(toks, k), "{") == 0 y __cargar64(vec_obtener(toks, k)) != 5) { k = k + 1 }
            j = saltar_grupo(toks, k, "{", "}")
        } sino { j = j + 1 }
    }
    retornar 0
}

funcion compilar(c) {
    registrar_funciones(c)
    // (El flujo empieza con el runtime en modo tipado: no depende del modo.)
    __guardar64(__cargar64(c + 216) + 8, programa_necesita_celdas(c))
    sea principal = nueva_etiqueta(c)
    // --lib (global 40 del compilador: 1 archivo .a, 2 objeto .o): sin
    // punto de entrada; las envolturas C llaman al programa principal.
    sea biblioteca = mem_global(40)
    si (biblioteca == 0) { op_inicio(c, principal) }
    definir_etiqueta(c, principal)
    sea marco = prologo(c)
    si (__cargar64(c + 200) y buscar_funcion(c, "dyn_fijar_ingles") != 0) {
        llamar_runtime(c, "dyn_fijar_ingles", 0)
    }
    // Programas del lenguaje (no --lib): recolector de basura.
    si (biblioteca == 0 y buscar_funcion(c, "dyn_gc_iniciar") != 0) {
        llamar_runtime(c, "dyn_gc_iniciar", 0)
    }
    mientras (tok_tipo(c) != 5) {
        si (ver(c, "funcion") y tok_tipo_en(c, 1) == 1) {
            avanzar(c)
            definicion_funcion(c)
        } sino {
            sentencia(c)
        }
    }
    cargar_inmediato(c, 0)
    epilogo(c)
    cerrar_marco(c, marco)
    si (__cargar64(c + 312) >= 0) {
        definir_etiqueta(c, __cargar64(c + 312))
        op_trampolin_hilo(c)
    }
    si (biblioteca) { __guardar64(c + 320, emitir_envolturas(c, principal)) }
    emitir_tabla_clases(c)
    retornar 0
}

// ── Enlazado y ELF ────────────────────────────────────────────────────────

// Tablas de enlace dinámico al final de los datos. Devuelve un registro
// [interp][largo interp][dynamic][entradas dynamic] (desplazamientos en datos).
funcion tablas_dinamicas(c, base, inicio_datos) {
    sea datos = ctx_datos(c)
    sea externas = __cargar64(c + 256)
    sea r = mem_reservar(32)
    // Intérprete.
    __guardar64(r, str_largo(datos))
    sea interprete = "/lib64/ld-linux-x86-64.so.2"
    si (es_arm64(c)) { interprete = "/lib/ld-linux-aarch64.so.1" }
    str_agregar(datos, interprete)
    str_agregar_byte(datos, 0)
    __guardar64(r + 8, str_largo(interprete) + 1)
    // Cadenas: libc.so.6 y los símbolos dlopen y dlsym; cada función
    // externa se resuelve con ellos en su primer uso.
    sea cadenas = str_nuevo(64)
    str_agregar_byte(cadenas, 0)
    sea nombres_bib = vec_nuevo()
    vec_agregar(nombres_bib, str_largo(cadenas))
    str_agregar(cadenas, "libc.so.6")
    str_agregar_byte(cadenas, 0)
    sea simbolos = vec_nuevo()
    vec_agregar(simbolos, "dlopen")
    vec_agregar(simbolos, "dlsym")
    sea nombres_sim = vec_nuevo()
    sea i = 0
    mientras (i < vec_largo(simbolos)) {
        vec_agregar(nombres_sim, str_largo(cadenas))
        str_agregar(cadenas, vec_obtener(simbolos, i))
        str_agregar_byte(cadenas, 0)
        i = i + 1
    }
    sea dir = base + inicio_datos
    sea strtab = str_largo(datos)
    str_agregar(datos, cadenas)
    mientras (str_largo(datos) % 8 != 0) { str_agregar_byte(datos, 0) }
    sea symtab = str_largo(datos)
    bytes_le(datos, 0, 24)
    i = 0
    mientras (i < vec_largo(simbolos)) {
        bytes_le(datos, vec_obtener(nombres_sim, i), 4)
        bytes_le(datos, 34, 1)                                 // STB_WEAK | STT_FUNC
        bytes_le(datos, 0, 1)
        bytes_le(datos, 0, 2)
        bytes_le(datos, 0, 8)
        bytes_le(datos, 0, 8)
        i = i + 1
    }
    // Tabla hash mínima: un balde, cadena vacía.
    sea hash = str_largo(datos)
    sea nsimbolos = vec_largo(simbolos) + 1
    bytes_le(datos, 1, 4)
    bytes_le(datos, nsimbolos, 4)
    bytes_le(datos, 0, 4)
    bytes_le(datos, 0, 4 * nsimbolos)
    mientras (str_largo(datos) % 8 != 0) { str_agregar_byte(datos, 0) }
    // Relocaciones R_X86_64_GLOB_DAT hacia las casillas de dlopen y dlsym.
    sea rela = str_largo(datos)
    i = 0
    mientras (i < vec_largo(simbolos)) {
        bytes_le(datos, dir + __cargar64(c + 272) + i * 8, 8)
        sea tipo_reubicacion = 6                               // R_X86_64_GLOB_DAT
        si (es_arm64(c)) { tipo_reubicacion = 1025 }           // R_AARCH64_GLOB_DAT
        bytes_le(datos, __o_bits(__desplazar_izq(i + 1, 32), tipo_reubicacion), 8)
        bytes_le(datos, 0, 8)
        i = i + 1
    }
    sea relasz = str_largo(datos) - rela
    // Sección dinámica.
    sea dinamica = str_largo(datos)
    i = 0
    mientras (i < vec_largo(nombres_bib)) {
        bytes_le(datos, 1, 8)                                  // DT_NEEDED
        bytes_le(datos, vec_obtener(nombres_bib, i), 8)
        i = i + 1
    }
    bytes_le(datos, 4, 8)  bytes_le(datos, dir + hash, 8)      // DT_HASH
    bytes_le(datos, 5, 8)  bytes_le(datos, dir + strtab, 8)    // DT_STRTAB
    bytes_le(datos, 6, 8)  bytes_le(datos, dir + symtab, 8)    // DT_SYMTAB
    bytes_le(datos, 7, 8)  bytes_le(datos, dir + rela, 8)      // DT_RELA
    bytes_le(datos, 8, 8)  bytes_le(datos, relasz, 8)          // DT_RELASZ
    bytes_le(datos, 9, 8)  bytes_le(datos, 24, 8)              // DT_RELAENT
    bytes_le(datos, 10, 8) bytes_le(datos, str_largo(cadenas), 8)  // DT_STRSZ
    bytes_le(datos, 11, 8) bytes_le(datos, 24, 8)              // DT_SYMENT
    bytes_le(datos, 24, 8) bytes_le(datos, 0, 8)               // DT_BIND_NOW
    bytes_le(datos, 0, 8)  bytes_le(datos, 0, 8)               // DT_NULL
    __guardar64(r + 16, dinamica)
    __guardar64(r + 24, (str_largo(datos) - dinamica) / 16)
    retornar r
}

funcion encabezado_programa(elf, tipo, banderas, desplazamiento, direccion, tam_archivo, tam_memoria, alineacion) {
    bytes_le(elf, tipo, 4)
    bytes_le(elf, banderas, 4)
    bytes_le(elf, desplazamiento, 8)
    bytes_le(elf, direccion, 8)
    bytes_le(elf, direccion, 8)
    bytes_le(elf, tam_archivo, 8)
    bytes_le(elf, tam_memoria, 8)
    bytes_le(elf, alineacion, 8)
    retornar 0
}

// Aplica los arreglos de código y datos con las direcciones finales.
funcion aplicar_arreglos(c, va_codigo, va_datos, va_globales, iat) {
    sea codigo = ctx_codigo(c)
    sea datos = ctx_datos(c)
    sea etiquetas = __cargar64(c + 40)
    sea arreglos = __cargar64(c + 32)
    sea i = 0
    mientras (i < vec_largo(arreglos)) {
        sea a = vec_obtener(arreglos, i)
        sea posicion = __cargar64(a)
        sea tipo = __cargar64(a + 8)
        sea valor = __cargar64(a + 16)
        si (tipo == 0) {
            sea destino = vec_obtener(etiquetas, valor)
            si (destino < 0) { rt_panico("etiqueta sin definir") }
            parchear32(codigo, posicion, destino - (posicion + 4))
        }
        si (tipo == 1) { parchear32(codigo, posicion, va_datos + valor) }
        si (tipo == 2) { parchear32(codigo, posicion, va_globales + valor) }
        si (tipo == 3) { parchear32(codigo, posicion, va_datos + __cargar64(c + 192)) }
        si (tipo == 4) {
            sea direccion = vec_obtener(etiquetas, valor)
            si (direccion < 0) { rt_panico("etiqueta sin definir") }
            parchear32(codigo, posicion, va_codigo + direccion)
        }
        si (tipo == 5) { parchear32(codigo, posicion, vec_obtener(iat, valor)) }
        si (tipo >= 10) {
            sea destino = 0
            si (tipo == 10 o tipo == 24) {
                destino = vec_obtener(etiquetas, valor)
                si (destino < 0) { rt_panico("etiqueta sin definir") }
                destino = va_codigo + destino
            }
            si (tipo == 21) { destino = va_datos + valor }
            si (tipo == 22) { destino = va_globales + valor }
            si (tipo == 23) { destino = va_datos + __cargar64(c + 192) }
            si (tipo == 25) { destino = vec_obtener(iat, valor) }
            a64_aplicar(codigo, posicion, tipo, va_codigo + posicion, destino)
        }
        i = i + 1
    }
    sea reubicaciones = __cargar64(c + 80)
    i = 0
    mientras (i < vec_largo(reubicaciones)) {
        sea campo = vec_obtener(reubicaciones, i)
        parchear64(datos, campo, va_datos + campo + 16)
        i = i + 1
    }
    sea a_codigo = __cargar64(c + 176)
    i = 0
    mientras (i < vec_largo(a_codigo)) {
        sea p = vec_obtener(a_codigo, i)
        parchear64(datos, __cargar64(p), va_codigo + vec_obtener(etiquetas, __cargar64(p + 8)))
        i = i + 1
    }
    sea punteros = __cargar64(c + 112)
    i = 0
    mientras (i < vec_largo(punteros)) {
        sea p = vec_obtener(punteros, i)
        parchear64(datos, __cargar64(p), va_datos + __cargar64(p + 8))
        i = i + 1
    }
    retornar 0
}

// CFORGE_MAPA=archivo: "dirección nombre" de cada función (para perfilar
// con valgrind, perf o un depurador).
funcion escribir_mapa(c, base) {
    sea ruta = sys_variable_entorno("CFORGE_MAPA")
    si (ruta == 0) { retornar 0 }
    sea r = str_nuevo(65536)
    sea todas = __cargar64(c + 144)
    sea i = 0
    mientras (i < vec_largo(todas)) {
        sea f = vec_obtener(todas, i)
        sea pos = vec_obtener(__cargar64(c + 40), __cargar64(f + 8))
        si (pos >= 0) {
            sea dir = base + pos
            sea k = 28
            mientras (k >= 0) {
                sea d = __y_bits(__desplazar_der(dir, k), 15)
                si (d < 10) { str_agregar_byte(r, 48 + d) } sino { str_agregar_byte(r, 87 + d) }
                k = k - 4
            }
            str_agregar_byte(r, 32)
            str_agregar(r, __cargar64(f))
            str_agregar_byte(r, 10)
        }
        i = i + 1
    }
    archivo_escribir(ruta, r)
    retornar 0
}

funcion empaquetar(c) {
    // Los formatos usan desplazamientos de 32 bits (rel32, RVA de PE,
    // campos de Mach-O y de la firma): por encima de 1 GiB de código y datos
    // se desbordarían, así que se rechaza antes de escribir cabeceras.
    si (str_largo(ctx_codigo(c)) + str_largo(ctx_datos(c)) > 1073741824) {
        rt_panico("programa demasiado grande: más de 1 GiB de código y datos")
    }
    si (mem_global(40) != 0) {
        sea objeto = empaquetar_objeto(c, __cargar64(c + 320))
        si (mem_global(40) == 2) { retornar objeto }
        retornar empaquetar_archivo(objeto, __cargar64(c + 320))
    }
    si (es_windows(c)) { retornar empaquetar_pe(c) }
    si (es_macos(c)) { retornar empaquetar_macho(c) }
    si (es_wasm(c)) { retornar empaquetar_wasm(c) }
    sea base = 4194304
    sea codigo = ctx_codigo(c)
    sea datos = ctx_datos(c)
    sea dinamico_elf = vec_largo(__cargar64(c + 256)) > 0
    // Encabezado ELF + encabezados de programa (1 estático, 3 dinámico).
    sea cabecera = 120
    si (dinamico_elf) { cabecera = 232 }
    sea inicio_datos = cabecera + str_largo(codigo)
    mientras (inicio_datos % 16 != 0) { inicio_datos = inicio_datos + 1 }
    sea tablas = 0
    si (dinamico_elf) { tablas = tablas_dinamicas(c, base, inicio_datos) }
    sea fin_datos = inicio_datos + str_largo(datos)
    sea inicio_globales = fin_datos
    mientras (inicio_globales % 16 != 0) { inicio_globales = inicio_globales + 1 }
    aplicar_arreglos(c, base + cabecera, base + inicio_datos, base + inicio_globales, vec_nuevo())
    escribir_mapa(c, base + cabecera)
    sea memoria = inicio_globales + 512 + vec_largo(__cargar64(c + 224)) * 8
    sea elf = str_nuevo(fin_datos + 16)
    bytes_le(elf, 1179403647, 4)                               // \x7fELF
    bytes_le(elf, 2, 1)
    bytes_le(elf, 1, 1)
    bytes_le(elf, 1, 1)
    bytes_le(elf, 0, 9)
    bytes_le(elf, 2, 2)                                        // ET_EXEC
    si (es_arm64(c)) { bytes_le(elf, 183, 2) } sino { bytes_le(elf, 62, 2) }   // AArch64 / x86-64
    bytes_le(elf, 1, 4)
    bytes_le(elf, base + cabecera, 8)                          // entrada
    bytes_le(elf, 64, 8)
    bytes_le(elf, 0, 8)
    bytes_le(elf, 0, 4)
    bytes_le(elf, 64, 2)
    bytes_le(elf, 56, 2)
    si (dinamico_elf) { bytes_le(elf, 3, 2) } sino { bytes_le(elf, 1, 2) }
    bytes_le(elf, 0, 6)
    si (dinamico_elf) {
        sea interp = inicio_datos + __cargar64(tablas)
        encabezado_programa(elf, 3, 4, interp, base + interp, __cargar64(tablas + 8), __cargar64(tablas + 8), 1)
    }
    encabezado_programa(elf, 1, 7, 0, base, fin_datos, memoria, 4096)       // PT_LOAD RWX
    si (dinamico_elf) {
        sea dinamica = inicio_datos + __cargar64(tablas + 16)
        sea tam = __cargar64(tablas + 24) * 16
        encabezado_programa(elf, 2, 6, dinamica, base + dinamica, tam, tam, 8)
    }
    str_agregar(elf, codigo)
    mientras (str_largo(elf) < inicio_datos) { str_agregar_byte(elf, 0) }
    str_agregar(elf, datos)
    retornar elf
}

funcion alinear(n, a) {
    si (a <= 0 o n < 0 o n > 4294967296) { rt_panico("alinear: tamaño fuera de rango") }
    retornar (n + a - 1) / a * a
}

// ── Windows: ejecutable PE32+ (x86-64) ────────────────────────────────────
// Una sola sección .text (RWX) en RVA 0x1000: código, datos, tablas de
// importación y, sin ocupar archivo, las globales. ImageBase fija 0x400000
// sin relocaciones (las direcciones absolutas de 32 bits son válidas).
funcion empaquetar_pe(c) {
    sea base = 4194304
    sea rva_seccion = 4096
    sea codigo = ctx_codigo(c)
    sea datos = ctx_datos(c)
    sea inicio_datos = alinear(str_largo(codigo), 16)          // dentro de la sección
    mientras (str_largo(datos) % 8 != 0) { str_agregar_byte(datos, 0) }
    // Tablas de importación al final de los datos, agrupadas por DLL.
    sea imps = __cargar64(c + 304)
    sea dlls = vec_nuevo()
    sea i = 0
    mientras (i < vec_largo(imps)) {
        si (contiene_texto(dlls, __cargar64(vec_obtener(imps, i))) == 0) { vec_agregar(dlls, __cargar64(vec_obtener(imps, i))) }
        i = i + 1
    }
    sea rva_datos = rva_seccion + inicio_datos
    // Nombres (hint + nombre) y nombres de DLL.
    sea nombre_rva = vec_nuevo()
    i = 0
    mientras (i < vec_largo(imps)) {
        mientras (str_largo(datos) % 2 != 0) { str_agregar_byte(datos, 0) }
        vec_agregar(nombre_rva, rva_datos + str_largo(datos))
        bytes_le(datos, 0, 2)
        str_agregar(datos, __cargar64(vec_obtener(imps, i) + 8))
        str_agregar_byte(datos, 0)
        i = i + 1
    }
    sea dll_rva = vec_nuevo()
    i = 0
    mientras (i < vec_largo(dlls)) {
        vec_agregar(dll_rva, rva_datos + str_largo(datos))
        str_agregar(datos, vec_obtener(dlls, i))
        str_agregar_byte(datos, 0)
        i = i + 1
    }
    mientras (str_largo(datos) % 8 != 0) { str_agregar_byte(datos, 0) }
    // ILT e IAT por DLL (las IAT contiguas).
    sea iat = vec_nuevo()
    i = 0
    mientras (i < vec_largo(imps)) {
        vec_agregar(iat, 0)
        i = i + 1
    }
    sea ilt_rva = vec_nuevo()
    sea iat_rva = vec_nuevo()
    sea d = 0
    mientras (d < vec_largo(dlls)) {
        vec_agregar(ilt_rva, rva_datos + str_largo(datos))
        i = 0
        mientras (i < vec_largo(imps)) {
            si (str_igual(__cargar64(vec_obtener(imps, i)), vec_obtener(dlls, d))) { bytes_le(datos, vec_obtener(nombre_rva, i), 8) }
            i = i + 1
        }
        bytes_le(datos, 0, 8)
        d = d + 1
    }
    sea inicio_iat = rva_datos + str_largo(datos)
    d = 0
    mientras (d < vec_largo(dlls)) {
        vec_agregar(iat_rva, rva_datos + str_largo(datos))
        i = 0
        mientras (i < vec_largo(imps)) {
            si (str_igual(__cargar64(vec_obtener(imps, i)), vec_obtener(dlls, d))) {
                vec_fijar(iat, i, base + rva_datos + str_largo(datos))
                bytes_le(datos, vec_obtener(nombre_rva, i), 8)
            }
            i = i + 1
        }
        bytes_le(datos, 0, 8)
        d = d + 1
    }
    sea fin_iat = rva_datos + str_largo(datos)
    sea descriptores = rva_datos + str_largo(datos)
    d = 0
    mientras (d < vec_largo(dlls)) {
        bytes_le(datos, vec_obtener(ilt_rva, d), 4)            // OriginalFirstThunk
        bytes_le(datos, 0, 4)
        bytes_le(datos, 0, 4)
        bytes_le(datos, vec_obtener(dll_rva, d), 4)            // Name
        bytes_le(datos, vec_obtener(iat_rva, d), 4)            // FirstThunk
        d = d + 1
    }
    bytes_le(datos, 0, 20)
    sea tam_descriptores = (vec_largo(dlls) + 1) * 20
    sea fin_datos = inicio_datos + str_largo(datos)
    sea inicio_globales = alinear(fin_datos, 16)
    sea tam_virtual = inicio_globales + 512 + vec_largo(__cargar64(c + 224)) * 8
    aplicar_arreglos(c, base + rva_seccion, base + rva_datos, base + rva_seccion + inicio_globales, iat)
    sea tam_crudo = alinear(fin_datos, 512)
    sea tam_imagen = alinear(rva_seccion + tam_virtual, 4096)
    sea pe = str_nuevo(512 + tam_crudo)
    // Encabezado DOS.
    bytes_le(pe, 23117, 2)                                     // "MZ"
    bytes_le(pe, 0, 58)
    bytes_le(pe, 64, 4)                                        // e_lfanew
    bytes_le(pe, 17744, 4)                                     // "PE\0\0"
    // Encabezado COFF.
    bytes_le(pe, 34404, 2)                                     // AMD64
    bytes_le(pe, 1, 2)                                         // 1 sección
    bytes_le(pe, 0, 12)
    bytes_le(pe, 240, 2)                                       // tamaño del opcional
    bytes_le(pe, 35, 2)                                        // RELOCS_STRIPPED | EXECUTABLE | LARGE_ADDRESS_AWARE
    // Encabezado opcional PE32+.
    bytes_le(pe, 523, 2)
    bytes_le(pe, 0, 2)
    bytes_le(pe, tam_crudo, 4)                                 // SizeOfCode
    bytes_le(pe, 0, 8)
    bytes_le(pe, rva_seccion, 4)                               // AddressOfEntryPoint
    bytes_le(pe, rva_seccion, 4)                               // BaseOfCode
    bytes_le(pe, base, 8)                                      // ImageBase
    bytes_le(pe, 4096, 4)
    bytes_le(pe, 512, 4)
    bytes_le(pe, 6, 2)
    bytes_le(pe, 0, 2)
    bytes_le(pe, 0, 4)
    bytes_le(pe, 6, 2)
    bytes_le(pe, 0, 2)
    bytes_le(pe, 0, 4)
    bytes_le(pe, tam_imagen, 4)
    bytes_le(pe, 512, 4)                                       // SizeOfHeaders
    bytes_le(pe, 0, 4)
    bytes_le(pe, 3, 2)                                         // consola
    bytes_le(pe, 0, 2)
    bytes_le(pe, 67108864, 8)                                  // pila: 64 MiB reservados
    bytes_le(pe, 1048576, 8)
    bytes_le(pe, 1048576, 8)
    bytes_le(pe, 4096, 8)
    bytes_le(pe, 0, 4)
    bytes_le(pe, 16, 4)
    i = 0
    mientras (i < 16) {
        si (i == 1) {
            bytes_le(pe, descriptores, 4)
            bytes_le(pe, tam_descriptores, 4)
        } sino {
            si (i == 12) {
                bytes_le(pe, inicio_iat, 4)
                bytes_le(pe, fin_iat - inicio_iat, 4)
            } sino {
                bytes_le(pe, 0, 8)
            }
        }
        i = i + 1
    }
    // Encabezado de sección.
    str_agregar(pe, ".text")
    bytes_le(pe, 0, 3)
    bytes_le(pe, tam_virtual, 4)
    bytes_le(pe, rva_seccion, 4)
    bytes_le(pe, tam_crudo, 4)
    bytes_le(pe, 512, 4)
    bytes_le(pe, 0, 12)
    bytes_le(pe, 3758096480, 4)                                // CODE | INITIALIZED | EXECUTE | READ | WRITE
    mientras (str_largo(pe) < 512) { str_agregar_byte(pe, 0) }
    str_agregar(pe, codigo)
    mientras (str_largo(pe) < 512 + inicio_datos) { str_agregar_byte(pe, 0) }
    str_agregar(pe, datos)
    mientras (str_largo(pe) < 512 + tam_crudo) { str_agregar_byte(pe, 0) }
    retornar pe
}

// ── macOS: ejecutable Mach-O x86-64 ───────────────────────────────────────
// __PAGEZERO, __TEXT (encabezado y código, r-x), __DATA (datos, punteros de
// libSystem y globales, rw-) y __LINKEDIT (instrucciones de enlace de dyld).
// Se carga en 0x400000 (sin PIE); dyld llena los punteros de las funciones
// de /usr/lib/libSystem.B.dylib y llama a la entrada (LC_MAIN).

funcion uleb128(s, valor) {
    sea seguir = 1
    mientras (seguir) {
        sea b = __y_bits(valor, 127)
        valor = __desplazar_der(valor, 7)
        si (valor != 0) { str_agregar_byte(s, __o_bits(b, 128)) } sino {
            str_agregar_byte(s, b)
            seguir = 0
        }
    }
    retornar 0
}

funcion nombre_de_16(s, nombre) {
    str_agregar(s, nombre)
    bytes_le(s, 0, 16 - str_largo(nombre))
    retornar 0
}

funcion comando_segmento(s, nombre, vmaddr, vmsize, fileoff, filesize, maxprot, initprot, nsects) {
    bytes_le(s, 25, 4)                                         // LC_SEGMENT_64
    bytes_le(s, 72 + 80 * nsects, 4)
    nombre_de_16(s, nombre)
    bytes_le(s, vmaddr, 8)
    bytes_le(s, vmsize, 8)
    bytes_le(s, fileoff, 8)
    bytes_le(s, filesize, 8)
    bytes_le(s, maxprot, 4)
    bytes_le(s, initprot, 4)
    bytes_le(s, nsects, 4)
    bytes_le(s, 0, 4)
    retornar 0
}

funcion seccion_macho(s, nombre, segmento, addr, tam, offset, alineacion, banderas) {
    nombre_de_16(s, nombre)
    nombre_de_16(s, segmento)
    bytes_le(s, addr, 8)
    bytes_le(s, tam, 8)
    bytes_le(s, offset, 4)
    bytes_le(s, alineacion, 4)
    bytes_le(s, 0, 8)
    bytes_le(s, banderas, 4)
    bytes_le(s, 0, 12)
    retornar 0
}

funcion empaquetar_macho(c) {
    // x86-64: carga fija en 0x400000, páginas de 4 KiB, sin firma.
    // ARM64: PIE en 0x100000000 (dyld reubica los punteros de datos),
    // páginas de 16 KiB y firma ad-hoc obligatoria (LC_CODE_SIGNATURE).
    sea arm = es_arm64(c)
    sea base = 4194304
    sea pagina = 4096
    si (arm) {
        base = 4294967296
        pagina = 16384
    }
    sea codigo = ctx_codigo(c)
    sea datos = ctx_datos(c)
    sea tam_comandos = 72 + 152 + 152 + 72 + 48 + 24 + 80 + 32 + 24 + 56 + 24
    si (arm) { tam_comandos = tam_comandos + 16 }
    sea inicio_codigo = alinear(32 + tam_comandos, 16)
    sea tam_texto = alinear(inicio_codigo + str_largo(codigo), pagina)
    // Punteros de libSystem (los llena dyld) al final de los datos.
    mientras (str_largo(datos) % 8 != 0) { str_agregar_byte(datos, 0) }
    sea imps = __cargar64(c + 304)
    sea va_datos = base + tam_texto
    sea got = vec_nuevo()
    sea enlaces = str_nuevo(256)
    str_agregar_byte(enlaces, 17)                              // SET_DYLIB_ORDINAL_IMM 1
    str_agregar_byte(enlaces, 81)                              // SET_TYPE_IMM POINTER
    sea i = 0
    mientras (i < vec_largo(imps)) {
        sea desplazamiento = str_largo(datos)
        vec_agregar(got, va_datos + desplazamiento)
        bytes_le(datos, 0, 8)
        str_agregar_byte(enlaces, 64)                          // SET_SYMBOL_TRAILING_FLAGS_IMM
        str_agregar_byte(enlaces, 95)                          // "_" + nombre
        str_agregar(enlaces, __cargar64(vec_obtener(imps, i) + 8))
        str_agregar_byte(enlaces, 0)
        str_agregar_byte(enlaces, 114)                         // SET_SEGMENT_AND_OFFSET_ULEB (segmento 2)
        uleb128(enlaces, desplazamiento)
        str_agregar_byte(enlaces, 144)                         // DO_BIND
        i = i + 1
    }
    str_agregar_byte(enlaces, 0)                               // DONE
    mientras (str_largo(enlaces) % 8 != 0) { str_agregar_byte(enlaces, 0) }
    // PIE: cada puntero absoluto de los datos se reubica al cargar.
    sea rebase = str_nuevo(64)
    si (arm) {
        str_agregar_byte(rebase, 17)                           // REBASE SET_TYPE_IMM POINTER
        reubicaciones_macho(c, rebase)
        str_agregar_byte(rebase, 0)                            // DONE
        mientras (str_largo(rebase) % 8 != 0) { str_agregar_byte(rebase, 0) }
    }
    sea tam_datos_archivo = alinear(str_largo(datos), pagina)
    sea inicio_globales = alinear(str_largo(datos), 16)
    sea tam_datos_memoria = alinear(inicio_globales + 512 + vec_largo(__cargar64(c + 224)) * 8, pagina)
    aplicar_arreglos(c, base + inicio_codigo, va_datos, va_datos + inicio_globales, got)
    sea inicio_enlace = tam_texto + tam_datos_archivo
    sea inicio_bind = inicio_enlace + str_largo(rebase)
    sea tabla_cadenas = inicio_bind + str_largo(enlaces)
    sea tam_enlace = str_largo(rebase) + str_largo(enlaces) + 8
    sea inicio_firma = alinear(tabla_cadenas + 8, 16)
    sea tam_firma = 0
    si (arm) {
        tam_firma = tamano_firma(inicio_firma)
        tam_enlace = inicio_firma + tam_firma - inicio_enlace
    }
    sea m = str_nuevo(inicio_enlace + tam_enlace + 64)
    // mach_header_64
    bytes_le(m, 4277009103, 4)                                 // MH_MAGIC_64
    si (arm) {
        bytes_le(m, 16777228, 4)                               // CPU_TYPE_ARM64
        bytes_le(m, 0, 4)
    } sino {
        bytes_le(m, 16777223, 4)                               // CPU_TYPE_X86_64
        bytes_le(m, 3, 4)
    }
    bytes_le(m, 2, 4)                                          // MH_EXECUTE
    si (arm) { bytes_le(m, 12, 4) } sino { bytes_le(m, 11, 4) }
    bytes_le(m, tam_comandos, 4)
    si (arm) { bytes_le(m, 2097285, 4) } sino { bytes_le(m, 133, 4) }   // NOUNDEFS | DYLDLINK | TWOLEVEL (| PIE)
    bytes_le(m, 0, 4)
    comando_segmento(m, "__PAGEZERO", 0, base, 0, 0, 0, 0, 0)
    comando_segmento(m, "__TEXT", base, tam_texto, 0, tam_texto, 5, 5, 1)
    seccion_macho(m, "__text", "__TEXT", base + inicio_codigo, str_largo(codigo), inicio_codigo, 4, 2147484672)
    comando_segmento(m, "__DATA", va_datos, tam_datos_memoria, tam_texto, tam_datos_archivo, 3, 3, 1)
    seccion_macho(m, "__data", "__DATA", va_datos, str_largo(datos), tam_texto, 3, 0)
    comando_segmento(m, "__LINKEDIT", va_datos + tam_datos_memoria, alinear(tam_enlace, pagina), inicio_enlace, tam_enlace, 1, 1, 0)
    bytes_le(m, 2147483682, 4)                                 // LC_DYLD_INFO_ONLY
    bytes_le(m, 48, 4)
    si (arm) {
        bytes_le(m, inicio_enlace, 4)                          // rebase
        bytes_le(m, str_largo(rebase), 4)
    } sino {
        bytes_le(m, 0, 8)
    }
    bytes_le(m, inicio_bind, 4)                                // bind
    bytes_le(m, str_largo(enlaces), 4)
    bytes_le(m, 0, 24)                                         // weak, lazy, export
    bytes_le(m, 2, 4)                                          // LC_SYMTAB
    bytes_le(m, 24, 4)
    bytes_le(m, tabla_cadenas, 4)
    bytes_le(m, 0, 4)
    bytes_le(m, tabla_cadenas, 4)
    bytes_le(m, 8, 4)
    bytes_le(m, 11, 4)                                         // LC_DYSYMTAB
    bytes_le(m, 80, 4)
    bytes_le(m, 0, 72)
    bytes_le(m, 14, 4)                                         // LC_LOAD_DYLINKER
    bytes_le(m, 32, 4)
    bytes_le(m, 12, 4)
    str_agregar(m, "/usr/lib/dyld")
    bytes_le(m, 0, 7)
    bytes_le(m, 2147483688, 4)                                 // LC_MAIN
    bytes_le(m, 24, 4)
    bytes_le(m, inicio_codigo, 8)                              // entryoff
    bytes_le(m, 67108864, 8)                                   // pila: 64 MiB
    bytes_le(m, 12, 4)                                         // LC_LOAD_DYLIB
    bytes_le(m, 56, 4)
    bytes_le(m, 24, 4)
    bytes_le(m, 2, 4)
    bytes_le(m, 85197824, 4)                                   // 1300.0.0
    bytes_le(m, 65536, 4)
    str_agregar(m, "/usr/lib/libSystem.B.dylib")
    bytes_le(m, 0, 6)
    bytes_le(m, 50, 4)                                         // LC_BUILD_VERSION
    bytes_le(m, 24, 4)
    bytes_le(m, plataforma_macho(c), 4)                        // 1 macOS · 2 iOS · 7 simulador
    si (es_ios(c)) {
        bytes_le(m, 917504, 4)                                 // minos 14.0
        bytes_le(m, 917504, 4)
    } sino {
    si (arm) {
        bytes_le(m, 720896, 4)                                 // minos 11.0
        bytes_le(m, 720896, 4)
    } sino {
        bytes_le(m, 659200, 4)                                 // minos 10.15
        bytes_le(m, 659200, 4)                                 // sdk 10.15
    }
    }
    bytes_le(m, 0, 4)
    si (arm) {
        bytes_le(m, 29, 4)                                     // LC_CODE_SIGNATURE
        bytes_le(m, 16, 4)
        bytes_le(m, inicio_firma, 4)
        bytes_le(m, tam_firma, 4)
    }
    mientras (str_largo(m) < inicio_codigo) { str_agregar_byte(m, 0) }
    str_agregar(m, codigo)
    mientras (str_largo(m) < tam_texto) { str_agregar_byte(m, 0) }
    str_agregar(m, datos)
    mientras (str_largo(m) < inicio_enlace) { str_agregar_byte(m, 0) }
    str_agregar(m, rebase)
    str_agregar(m, enlaces)
    bytes_le(m, 0, 8)                                          // tabla de cadenas vacía
    si (arm) {
        mientras (str_largo(m) < inicio_firma) { str_agregar_byte(m, 0) }
        firma_adhoc(m, inicio_firma, tam_texto)
    }
    retornar m
}

funcion plataforma_macho(c) {
    si (__cargar64(c + 296) == 5) { retornar 2 }
    si (__cargar64(c + 296) == 6) { retornar 7 }
    retornar 1
}

// Instrucciones de rebase de dyld para cada puntero absoluto de __DATA
// (segmento 2): textos literales, punteros entre datos y a código.
funcion reubicaciones_macho(c, r) {
    sea reubicaciones = __cargar64(c + 80)
    sea i = 0
    mientras (i < vec_largo(reubicaciones)) {
        rebase_en(r, vec_obtener(reubicaciones, i))
        i = i + 1
    }
    sea a_codigo = __cargar64(c + 176)
    i = 0
    mientras (i < vec_largo(a_codigo)) {
        rebase_en(r, __cargar64(vec_obtener(a_codigo, i)))
        i = i + 1
    }
    sea punteros = __cargar64(c + 112)
    i = 0
    mientras (i < vec_largo(punteros)) {
        rebase_en(r, __cargar64(vec_obtener(punteros, i)))
        i = i + 1
    }
    retornar 0
}

funcion rebase_en(r, desplazamiento) {
    str_agregar_byte(r, 34)                                    // SET_SEGMENT_AND_OFFSET_ULEB (segmento 2)
    uleb128(r, desplazamiento)
    str_agregar_byte(r, 81)                                    // DO_REBASE_IMM_TIMES 1
    retornar 0
}

// ── Firma de código ad-hoc (macOS ARM64) ──────────────────────────────────
// SuperBlob con un CodeDirectory (versión 0x20400, banderas adhoc |
// linker-signed) con el SHA-256 de cada página de 4 KiB del archivo hasta
// el inicio de la firma. El identificador es fijo para que la salida no
// dependa del nombre del archivo.

funcion bytes_be(s, valor, cantidad) {
    sea i = cantidad - 1
    mientras (i >= 0) {
        str_agregar_byte(s, __y_bits(__desplazar_der(valor, i * 8), 255))
        i = i - 1
    }
    retornar 0
}

funcion identificador_firma() { retornar "cforge" }

funcion tamano_firma(limite) {
    sea paginas = (limite + 4095) / 4096
    retornar 20 + 88 + str_largo(identificador_firma()) + 1 + paginas * 32
}

funcion firma_adhoc(m, limite, tam_texto) {
    sea paginas = (limite + 4095) / 4096
    sea ident = identificador_firma()
    sea tam_cd = 88 + str_largo(ident) + 1 + paginas * 32
    bytes_be(m, 4208856256, 4)                                 // CSMAGIC_EMBEDDED_SIGNATURE
    bytes_be(m, 20 + tam_cd, 4)
    bytes_be(m, 1, 4)
    bytes_be(m, 0, 4)                                          // CSSLOT_CODEDIRECTORY
    bytes_be(m, 20, 4)
    bytes_be(m, 4208856066, 4)                                 // CSMAGIC_CODEDIRECTORY
    bytes_be(m, tam_cd, 4)
    bytes_be(m, 132096, 4)                                     // versión 0x20400
    bytes_be(m, 131074, 4)                                     // CS_ADHOC | CS_LINKER_SIGNED
    bytes_be(m, 88 + str_largo(ident) + 1, 4)                  // hashOffset
    bytes_be(m, 88, 4)                                         // identOffset
    bytes_be(m, 0, 4)                                          // nSpecialSlots
    bytes_be(m, paginas, 4)                                    // nCodeSlots
    bytes_be(m, limite, 4)                                     // codeLimit
    str_agregar_byte(m, 32)                                    // hashSize
    str_agregar_byte(m, 2)                                     // SHA-256
    str_agregar_byte(m, 0)
    str_agregar_byte(m, 12)                                    // páginas de 4 KiB
    bytes_be(m, 0, 4)                                          // spare2
    bytes_be(m, 0, 4)                                          // scatterOffset
    bytes_be(m, 0, 4)                                          // teamOffset
    bytes_be(m, 0, 4)                                          // spare3
    bytes_be(m, 0, 8)                                          // codeLimit64
    bytes_be(m, 0, 8)                                          // execSegBase
    bytes_be(m, tam_texto, 8)                                  // execSegLimit
    bytes_be(m, 1, 8)                                          // CS_EXECSEG_MAIN_BINARY
    str_agregar(m, ident)
    str_agregar_byte(m, 0)
    sea k = sha256_constantes()
    sea i = 0
    mientras (i < paginas) {
        sea largo = 4096
        si ((i + 1) * 4096 > limite) { largo = limite - i * 4096 }
        str_agregar(m, sha256(m, i * 4096, largo, k))
        i = i + 1
    }
    vec_liberar(k)
    retornar 0
}

// ── SHA-256 (dialecto base; enteros de 64 bits con máscaras de 32) ────────

funcion sha256_constantes() {
    sea k = vec_nuevo()
    vec_agregar(k, 1116352408)
    vec_agregar(k, 1899447441)
    vec_agregar(k, 3049323471)
    vec_agregar(k, 3921009573)
    vec_agregar(k, 961987163)
    vec_agregar(k, 1508970993)
    vec_agregar(k, 2453635748)
    vec_agregar(k, 2870763221)
    vec_agregar(k, 3624381080)
    vec_agregar(k, 310598401)
    vec_agregar(k, 607225278)
    vec_agregar(k, 1426881987)
    vec_agregar(k, 1925078388)
    vec_agregar(k, 2162078206)
    vec_agregar(k, 2614888103)
    vec_agregar(k, 3248222580)
    vec_agregar(k, 3835390401)
    vec_agregar(k, 4022224774)
    vec_agregar(k, 264347078)
    vec_agregar(k, 604807628)
    vec_agregar(k, 770255983)
    vec_agregar(k, 1249150122)
    vec_agregar(k, 1555081692)
    vec_agregar(k, 1996064986)
    vec_agregar(k, 2554220882)
    vec_agregar(k, 2821834349)
    vec_agregar(k, 2952996808)
    vec_agregar(k, 3210313671)
    vec_agregar(k, 3336571891)
    vec_agregar(k, 3584528711)
    vec_agregar(k, 113926993)
    vec_agregar(k, 338241895)
    vec_agregar(k, 666307205)
    vec_agregar(k, 773529912)
    vec_agregar(k, 1294757372)
    vec_agregar(k, 1396182291)
    vec_agregar(k, 1695183700)
    vec_agregar(k, 1986661051)
    vec_agregar(k, 2177026350)
    vec_agregar(k, 2456956037)
    vec_agregar(k, 2730485921)
    vec_agregar(k, 2820302411)
    vec_agregar(k, 3259730800)
    vec_agregar(k, 3345764771)
    vec_agregar(k, 3516065817)
    vec_agregar(k, 3600352804)
    vec_agregar(k, 4094571909)
    vec_agregar(k, 275423344)
    vec_agregar(k, 430227734)
    vec_agregar(k, 506948616)
    vec_agregar(k, 659060556)
    vec_agregar(k, 883997877)
    vec_agregar(k, 958139571)
    vec_agregar(k, 1322822218)
    vec_agregar(k, 1537002063)
    vec_agregar(k, 1747873779)
    vec_agregar(k, 1955562222)
    vec_agregar(k, 2024104815)
    vec_agregar(k, 2227730452)
    vec_agregar(k, 2361852424)
    vec_agregar(k, 2428436474)
    vec_agregar(k, 2756734187)
    vec_agregar(k, 3204031479)
    vec_agregar(k, 3329325298)
    retornar k
}

funcion sha_rotr(x, n) {
    retornar __y_bits(__o_bits(__desplazar_der(x, n), __desplazar_izq(x, 32 - n)), 4294967295)
}

funcion sha_suma(a, b) { retornar __y_bits(a + b, 4294967295) }

// SHA-256 de los bytes [inicio, inicio + largo) de s: texto de 32 bytes.
funcion sha256(s, inicio, largo, k) {
    sea msg = str_nuevo(largo + 72)
    str_agregar(msg, str_rebanar(s, inicio, inicio + largo))
    str_agregar_byte(msg, 128)
    mientras (str_largo(msg) % 64 != 56) { str_agregar_byte(msg, 0) }
    bytes_be(msg, largo * 8, 8)
    sea h = mem_reservar(64)
    __guardar64(h + 0, 1779033703)
    __guardar64(h + 8, 3144134277)
    __guardar64(h + 16, 1013904242)
    __guardar64(h + 24, 2773480762)
    __guardar64(h + 32, 1359893119)
    __guardar64(h + 40, 2600822924)
    __guardar64(h + 48, 528734635)
    __guardar64(h + 56, 1541459225)
    sea w = mem_reservar(512)
    sea bloque = 0
    mientras (bloque < str_largo(msg)) {
        sea t = 0
        mientras (t < 16) {
            sea p = bloque + t * 4
            __guardar64(w + t * 8, str_byte(msg, p) * 16777216 + str_byte(msg, p + 1) * 65536 + str_byte(msg, p + 2) * 256 + str_byte(msg, p + 3))
            t = t + 1
        }
        mientras (t < 64) {
            sea w15 = __cargar64(w + (t - 15) * 8)
            sea w2 = __cargar64(w + (t - 2) * 8)
            sea s0 = __xo_bits(__xo_bits(sha_rotr(w15, 7), sha_rotr(w15, 18)), __desplazar_der(w15, 3))
            sea s1 = __xo_bits(__xo_bits(sha_rotr(w2, 17), sha_rotr(w2, 19)), __desplazar_der(w2, 10))
            __guardar64(w + t * 8, __y_bits(__cargar64(w + (t - 16) * 8) + s0 + __cargar64(w + (t - 7) * 8) + s1, 4294967295))
            t = t + 1
        }
        sea a = __cargar64(h)
        sea b = __cargar64(h + 8)
        sea cc = __cargar64(h + 16)
        sea d = __cargar64(h + 24)
        sea e = __cargar64(h + 32)
        sea f = __cargar64(h + 40)
        sea g = __cargar64(h + 48)
        sea hh = __cargar64(h + 56)
        t = 0
        mientras (t < 64) {
            sea S1 = __xo_bits(__xo_bits(sha_rotr(e, 6), sha_rotr(e, 11)), sha_rotr(e, 25))
            sea ch = __xo_bits(__y_bits(e, f), __y_bits(__xo_bits(e, 4294967295), g))
            sea t1 = __y_bits(hh + S1 + ch + vec_obtener(k, t) + __cargar64(w + t * 8), 4294967295)
            sea S0 = __xo_bits(__xo_bits(sha_rotr(a, 2), sha_rotr(a, 13)), sha_rotr(a, 22))
            sea may = __xo_bits(__xo_bits(__y_bits(a, b), __y_bits(a, cc)), __y_bits(b, cc))
            sea t2 = sha_suma(S0, may)
            hh = g
            g = f
            f = e
            e = sha_suma(d, t1)
            d = cc
            cc = b
            b = a
            a = sha_suma(t1, t2)
            t = t + 1
        }
        __guardar64(h, sha_suma(__cargar64(h), a))
        __guardar64(h + 8, sha_suma(__cargar64(h + 8), b))
        __guardar64(h + 16, sha_suma(__cargar64(h + 16), cc))
        __guardar64(h + 24, sha_suma(__cargar64(h + 24), d))
        __guardar64(h + 32, sha_suma(__cargar64(h + 32), e))
        __guardar64(h + 40, sha_suma(__cargar64(h + 40), f))
        __guardar64(h + 48, sha_suma(__cargar64(h + 48), g))
        __guardar64(h + 56, sha_suma(__cargar64(h + 56), hh))
        bloque = bloque + 64
    }
    sea r = str_nuevo(32)
    sea i = 0
    mientras (i < 8) {
        bytes_be(r, __cargar64(h + i * 8), 4)
        i = i + 1
    }
    mem_liberar(w)
    mem_liberar(h)
    str_liberar(msg)
    retornar r
}

// ── Programa ──────────────────────────────────────────────────────────────
//
// cforge-self -o salida [--stdlib DIR] archivos... [--puente archivos...]
//             [--dinamico archivos...] [--nativo archivos...]
//
// --nativo   (por defecto) dialecto nativo: enteros de 64 bits
// --puente   runtime del lenguaje escrito en dialecto nativo (runtime/dyn.cfv)
// --dinamico lenguaje C-Forge completo; resuelve importar "x" desde --stdlib

funcion uso() {
    rt_panico("uso: cforge-self -o salida [--stdlib DIR] archivo.cfv [--puente|--dinamico|--nativo archivos...]")
    retornar 0
}

funcion contar_lineas(s) {
    sea n = 0
    sea i = 0
    sea d = str_datos(s)
    sea largo = str_largo(s)
    mientras (i < largo) {
        si (__cargar8(d + i) == 10) { n = n + 1 }
        i = i + 1
    }
    retornar n
}

// Agrega un archivo a la fuente y anota en qué línea global empieza.
funcion agregar_fuente(fuente, modo, texto, nombre, archivos) {
    sea registro = mem_reservar(16)
    __guardar64(registro, contar_lineas(fuente) + 3)
    __guardar64(registro + 8, nombre)
    vec_agregar(archivos, registro)
    str_agregar(fuente, "\n__dialecto ")
    str_agregar(fuente, str_desde_entero(modo))
    str_agregar_byte(fuente, 10)
    str_agregar(fuente, texto)
    str_agregar_byte(fuente, 10)
    retornar 0
}

// Ruta de la biblioteca para importar "mapa" / "stdlib/mapa.cfv".
funcion ruta_importacion(stdlib, nombre) {
    sea n = nombre
    si (str_largo(n) > 7 y str_igual(str_rebanar(n, 0, 7), "stdlib/")) {
        n = str_rebanar(n, 7, str_largo(n))
    }
    sea r = str_concatenar(stdlib, "/")
    str_agregar(r, n)
    si (str_largo(n) < 4 o str_igual(str_rebanar(n, str_largo(n) - 4, str_largo(n)), ".cfv") == 0) {
        str_agregar(r, ".cfv")
    }
    retornar r
}

// Primero junto al archivo que importa; si no, en la biblioteca estándar.
funcion ruta_importacion_desde(stdlib, importador, nombre) {
    sea i = str_largo(importador)
    mientras (i > 0 y str_byte(importador, i - 1) != 47) { i = i - 1 }
    sea local = 0
    si (i == 0) { local = str_rebanar(ruta_importacion(".", nombre), 2, str_largo(ruta_importacion(".", nombre))) } sino { local = ruta_importacion(str_rebanar(importador, 0, i - 1), nombre) }
    // Un archivo no se importa a sí mismo (p. ej. json.cfv con importar "json").
    si (str_igual(local, importador)) { retornar ruta_importacion(stdlib, nombre) }
    sea fd = sys_abrir(str_c(local), sys_abrir_lectura(), 0)
    si (fd >= 0) {
        sys_cerrar(fd)
        retornar local
    }
    sea paquete = ruta_paquete(nombre)
    si (paquete != 0) { retornar paquete }
    retornar ruta_importacion(stdlib, nombre)
}

// Paquetes del proyecto (global 36, los registra el CLI desde cforge.toml):
// [alias][directorio][archivo principal]. "alias" → su archivo principal;
// "alias/modulo" → directorio/modulo.cfv.
funcion ruta_paquete(nombre) {
    sea paquetes = mem_global(36)
    si (paquetes == 0) { retornar 0 }
    sea corte = 0
    mientras (corte < str_largo(nombre) y str_byte(nombre, corte) != 47) { corte = corte + 1 }
    sea alias = str_rebanar(nombre, 0, corte)
    sea i = 0
    mientras (i < vec_largo(paquetes)) {
        sea p = vec_obtener(paquetes, i)
        si (str_igual(__cargar64(p), alias)) {
            sea r = str_concatenar(__cargar64(p + 8), "/")
            si (corte == str_largo(nombre)) {
                str_agregar(r, __cargar64(p + 16))
                retornar r
            }
            retornar ruta_importacion(__cargar64(p + 8), str_rebanar(nombre, corte + 1, str_largo(nombre)))
        }
        i = i + 1
    }
    retornar 0
}

funcion contiene_texto(lista, texto) {
    sea i = 0
    mientras (i < vec_largo(lista)) {
        si (str_igual(vec_obtener(lista, i), texto)) { retornar 1 }
        i = i + 1
    }
    retornar 0
}

// Agrega un archivo dinámico precedido por sus importaciones (cada módulo una
// sola vez, en profundidad), así las globales de un módulo existen antes de
// que el archivo que lo importa empiece a ejecutarse.
funcion agregar_con_importaciones(fuente, stdlib, texto, nombre, vistas, archivos) {
    sea tokens = tokenizar(texto)
    sea i = 0
    mientras (i + 1 < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, i)
        sea u = vec_obtener(tokens, i + 1)
        si (__cargar64(t) == 1 y __cargar64(u) == 3 y (str_igual(__cargar64(t + 8), "importar") o str_igual(__cargar64(t + 8), "import")) y tras_punto(tokens, i) == 0) {
            sea ruta = ruta_importacion_desde(stdlib, nombre, decodificar_literal(__cargar64(u + 8)))
            si (contiene_texto(vistas, ruta) == 0) {
                vec_agregar(vistas, ruta)
                agregar_con_importaciones(fuente, stdlib, archivo_leer(ruta), ruta, vistas, archivos)
            }
        }
        i = i + 1
    }
    agregar_fuente(fuente, 2, texto, nombre, archivos)
    retornar 0
}

// Compila la fuente concatenada y devuelve el ejecutable ELF.
funcion compilar_programa(fuente, archivos, puntaje) {
    sea tokens = expandir_comptime(traducir_ingles(tokenizar(fuente)), archivos)
    sea alcanzables = 0
    // --release (global 19): primera pasada para saber qué funciones se usan.
    si (mem_global(19) != 0 y mem_global(40) == 0) {
        sea previo = ctx_nuevo(tokens)
        __guardar64(previo + 296, mem_global(33))
        __guardar64(previo + 208, archivos)
        si (puntaje > 0) { __guardar64(previo + 200, 1) }
        __guardar64(previo + 408, vec_nuevo())
        sea total = 0
        sea k = 0
        mientras (k < vec_largo(tokens)) {
            si (es_simbolo(vec_obtener(tokens, k), "funcion") o (__cargar64(vec_obtener(tokens, k)) == 1 y str_igual(lexema_en(tokens, k), "funcion"))) { total = total + 1 }
            k = k + 1
        }
        k = 0
        mientras (k <= total + 1) {
            vec_agregar(__cargar64(previo + 408), vec_nuevo())
            k = k + 1
        }
        compilar(previo)
        alcanzables = funciones_alcanzables(previo)
    }
    sea contexto = ctx_nuevo(tokens)
    // Plataforma de destino (global 33): 0 Linux ELF · 1 Windows PE64.
    __guardar64(contexto + 296, mem_global(33))
    __guardar64(contexto + 208, archivos)
    si (puntaje > 0) { __guardar64(contexto + 200, 1) }
    __guardar64(contexto + 416, alcanzables)
    compilar(contexto)
    retornar empaquetar(contexto)
}

// ── comptime ──────────────────────────────────────────────────────────────
// comptime(expr) y comptime { … retornar v } se ejecutan al compilar: el
// compilador escribe un programa con las funciones, clases y constantes del
// usuario más la expresión, lo ejecuta (cforge run, en la máquina que compila)
// y pone en su lugar el literal que devuelve (nulo, booleano, número, texto,
// lista o mapa). Funciona igual al compilar para otra plataforma.

funcion es_comptime(tokens, i) {
    sea t = vec_obtener(tokens, i)
    si (__cargar64(t) != 1 o str_igual(__cargar64(t + 8), "comptime") == 0) { retornar 0 }
    si (i + 1 >= vec_largo(tokens)) { retornar 0 }
    sea sig = vec_obtener(tokens, i + 1)
    retornar es_simbolo(sig, "(") o es_simbolo(sig, "{")
}

funcion expandir_comptime(tokens, archivos) {
    sea modo = 0
    sea i = 0
    mientras (i < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, i)
        si (__cargar64(t) == 1 y str_igual(__cargar64(t + 8), "__dialecto")) { modo = numero_literal(lexema_en(tokens, i + 1)) }
        si (modo == 2 y es_comptime(tokens, i)) { tokens = evaluar_comptime(tokens, i, archivos) }
        i = i + 1
    }
    retornar tokens
}

// Índice del cierre que corresponde a la apertura en j.
funcion cierre_de(tokens, j) {
    sea nivel = 0
    mientras (j < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, j)
        si (__cargar64(t) == 4) {
            sea l = __cargar64(t + 8)
            si (str_igual(l, "(") o str_igual(l, "[") o str_igual(l, "{")) { nivel = nivel + 1 }
            si (str_igual(l, ")") o str_igual(l, "]") o str_igual(l, "}")) {
                nivel = nivel - 1
                si (nivel == 0) { retornar j }
            }
        }
        si (__cargar64(t) == 5) { retornar j }
        j = j + 1
    }
    retornar j
}

// Fin (exclusivo) de la sentencia de nivel superior que empieza en a: el
// primer token fuera de paréntesis y llaves en una línea nueva.
funcion fin_sentencia_superior(tokens, a) {
    sea nivel = 0
    sea j = a
    mientras (j < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, j)
        si (__cargar64(t) == 5) { retornar j }
        si (j > a y nivel == 0 y __cargar64(t + 16) != __cargar64(vec_obtener(tokens, j - 1) + 16)) { retornar j }
        si (__cargar64(t) == 1 y str_igual(__cargar64(t + 8), "__dialecto")) { si (j > a) { retornar j } }
        si (__cargar64(t) == 4) {
            sea l = __cargar64(t + 8)
            si (str_igual(l, "(") o str_igual(l, "[") o str_igual(l, "{")) { nivel = nivel + 1 }
            si (str_igual(l, ")") o str_igual(l, "]") o str_igual(l, "}")) { nivel = nivel - 1 }
        }
        j = j + 1
    }
    retornar j
}

// Copia los tokens [a, b) como texto; un comptime pendiente se ejecuta ahí
// mismo (el programa auxiliar ya corre al compilar).
funcion comptime_texto(s, tokens, a, b) {
    sea j = a
    mientras (j < b) {
        sea t = vec_obtener(tokens, j)
        si (j > a y __cargar64(t + 16) != __cargar64(vec_obtener(tokens, j - 1) + 16)) { str_agregar_byte(s, 10) } sino { str_agregar_byte(s, 32) }
        si (es_comptime(tokens, j)) {
            si (es_simbolo(vec_obtener(tokens, j + 1), "{")) {
                sea m = cierre_de(tokens, j + 1)
                str_agregar(s, "comptime_ejecutar(funcion() ")
                comptime_texto(s, tokens, j + 1, m + 1)
                str_agregar(s, ")")
                j = m + 1
            } sino {
                j = j + 1
            }
        } sino {
            si (__cargar64(t) != 5) { str_agregar(s, __cargar64(t + 8)) }
            j = j + 1
        }
    }
    retornar 0
}

funcion evaluar_comptime(tokens, i, archivos) {
    sea abre = i + 1
    sea cierra = cierre_de(tokens, abre)
    sea es_bloque = es_simbolo(vec_obtener(tokens, abre), "{")
    sea linea = __cargar64(vec_obtener(tokens, i) + 16)
    sea s = str_nuevo(65536)
    // Definiciones del programa (dialecto 2): funciones, clases, extern,
    // atributos y las constantes "sea" anteriores al comptime.
    sea modo = 0
    sea a = 0
    mientras (a < vec_largo(tokens)) {
        sea t = vec_obtener(tokens, a)
        si (__cargar64(t) == 5) { a = vec_largo(tokens) } sino {
            si (__cargar64(t) == 1 y str_igual(__cargar64(t + 8), "__dialecto")) {
                modo = numero_literal(lexema_en(tokens, a + 1))
                a = a + 2
            } sino {
                sea b = fin_sentencia_superior(tokens, a)
                si (b <= a) { b = a + 1 }
                si (modo == 2) {
                    sea l = __cargar64(t + 8)
                    sea definicion = str_igual(l, "funcion") o str_igual(l, "clase") o str_igual(l, "extern") o str_igual(l, "#")
                    si (str_igual(l, "sea") y b <= i) { definicion = 1 }
                    si (definicion) {
                        comptime_texto(s, tokens, a, b)
                        str_agregar_byte(s, 10)
                    }
                }
                a = b
            }
        }
    }
    sea base = str_concatenar(sys_ruta_temporal(), "cforge-comptime-")
    str_agregar(base, str_desde_entero(sys_proceso_id()))
    str_agregar(base, "-")
    str_agregar(base, str_desde_entero(i))
    sea programa = str_concatenar(base, ".cfv")
    sea resultado = str_concatenar(base, ".txt")
    // En el literal del programa auxiliar, "/" también vale en Windows.
    sea ruta_literal = str_nuevo(str_largo(resultado))
    sea q = 0
    mientras (q < str_largo(resultado)) {
        si (str_byte(resultado, q) == 92) { str_agregar_byte(ruta_literal, 47) } sino { str_agregar_byte(ruta_literal, str_byte(resultado, q)) }
        q = q + 1
    }
    si (es_bloque) {
        str_agregar(s, "\nfuncion comptime_valor__() ")
        comptime_texto(s, tokens, abre, cierra + 1)
        str_agregar(s, "\nescribir_archivo(")
        str_agregar(s, comillas(ruta_literal))
        str_agregar(s, ", comptime_literal(comptime_valor__()))\n")
    } sino {
        str_agregar(s, "\nescribir_archivo(")
        str_agregar(s, comillas(ruta_literal))
        str_agregar(s, ", comptime_literal(")
        comptime_texto(s, tokens, abre + 1, cierra)
        str_agregar(s, "))\n")
    }
    archivo_escribir(programa, s)
    archivo_escribir(resultado, "")
    sea args = vec_nuevo()
    vec_agregar(args, "run")
    vec_agregar(args, programa)
    sea codigo = sys_ejecutar_programa(sys_ruta_ejecutable(), args)
    sea literal = archivo_leer(resultado)
    sys_borrar(str_c(programa))
    sys_borrar(str_c(resultado))
    si (codigo != 0 o str_largo(literal) == 0) {
        sea donde = ctx_nuevo(tokens)
        __guardar64(donde + 208, archivos)
        sea m = ubicacion(donde, linea)
        str_agregar(m, ": comptime: la evaluación al compilar falló")
        rt_panico(m)
    }
    // Reemplazo: tokens[0, i) + literal + tokens(cierra, fin].
    sea nuevos = vec_nuevo()
    sea k = 0
    mientras (k < i) {
        vec_agregar(nuevos, vec_obtener(tokens, k))
        k = k + 1
    }
    sea lit = tokenizar(literal)
    k = 0
    vec_agregar(nuevos, token_nuevo(4, "(", linea))
    mientras (k < vec_largo(lit)) {
        sea u = vec_obtener(lit, k)
        si (__cargar64(u) != 5) {
            __guardar64(u + 16, linea)
            vec_agregar(nuevos, u)
        }
        k = k + 1
    }
    vec_agregar(nuevos, token_nuevo(4, ")", linea))
    k = cierra + 1
    mientras (k < vec_largo(tokens)) {
        vec_agregar(nuevos, vec_obtener(tokens, k))
        k = k + 1
    }
    retornar nuevos
}

// Funciones alcanzables desde el programa principal (1 byte por función).
funcion funciones_alcanzables(c) {
    sea n = vec_largo(__cargar64(c + 144))
    sea marca = mem_reservar(n + 1)
    mem_llenar(marca, 0, n + 1)
    sea refs = __cargar64(c + 408)
    sea pendientes = vec_nuevo()
    // WebAssembly: las funciones del programa se pueden llamar desde
    // JavaScript (cforge.llamar), así que todas son raíces.
    si (es_wasm(c)) {
        sea k = 0
        mientras (k < n) {
            si (__cargar64(vec_obtener(__cargar64(c + 144), k) + 24) == 2) { vec_agregar(pendientes, k) }
            k = k + 1
        }
    }
    sea raiz = vec_obtener(refs, 0)
    sea i = 0
    mientras (i < vec_largo(raiz)) {
        vec_agregar(pendientes, vec_obtener(raiz, i))
        i = i + 1
    }
    mientras (vec_largo(pendientes) > 0) {
        sea f = vec_quitar_ultimo(pendientes)
        si (f >= 0 y f < n y __cargar8(marca + f) == 0) {
            __guardar8(marca + f, 1)
            si (f + 1 < vec_largo(refs)) {
                sea usa = vec_obtener(refs, f + 1)
                sea j = 0
                mientras (j < vec_largo(usa)) {
                    vec_agregar(pendientes, vec_obtener(usa, j))
                    j = j + 1
                }
            }
        }
    }
    retornar marca
}

funcion escribir_ejecutable(salida, ejecutable) {
    archivo_escribir(salida, ejecutable)
    sys_permisos(str_c(salida), 493)
    retornar 0
}

// Modo de bajo nivel (arranque): -o salida [--stdlib DIR] archivos...
// con --nativo/--puente/--lenguaje/--dinamico antes de cada grupo.
funcion cli_bajo_nivel() {
    si (rt_argc() < 4) { uso() }
    si (str_igual(rt_argumento(1), "-o") == 0) { uso() }
    sea salida = rt_argumento(2)
    sea fuente = str_nuevo(1048576)
    sea stdlib = "stdlib"
    sea modo = 0
    sea vistas = vec_nuevo()
    sea archivos = vec_nuevo()
    sea puntaje = 0
    sea indice = 3
    mientras (indice < rt_argc()) {
        sea argumento = rt_argumento(indice)
        si (str_igual(argumento, "--stdlib")) {
            indice = indice + 1
            stdlib = rt_argumento(indice)
        } sino {
        si (str_igual(argumento, "--target")) {
            indice = indice + 1
            mem_fijar_global(33, numero_plataforma(rt_argumento(indice)))
        } sino {
            sea nuevo_modo = modo_de_opcion(argumento)
            si (nuevo_modo >= 0) {
                modo = nuevo_modo
            } sino {
                sea texto = archivo_leer(argumento)
                si (modo == 2) {
                    puntaje = puntaje + puntaje_ingles(tokenizar(texto))
                    agregar_con_importaciones(fuente, stdlib, texto, argumento, vistas, archivos)
                } sino {
                    agregar_fuente(fuente, modo, texto, argumento, archivos)
                }
            }
        }
        }
        indice = indice + 1
    }
    sea ejecutable = compilar_programa(fuente, archivos, puntaje)
    escribir_ejecutable(salida, ejecutable)
    sea mensaje = str_concatenar("C-Forge (autoalojado) creó: ", salida)
    str_agregar(mensaje, " (")
    str_agregar(mensaje, str_desde_entero(str_largo(ejecutable)))
    str_agregar(mensaje, " bytes)")
    mostrar(mensaje)
    retornar 0
}

// linux → 0 · windows → 1 · macos → 2 · macos-arm64 → 3 · linux-arm64 → 4
funcion numero_plataforma(nombre) {
    si (str_igual(nombre, "windows") o str_igual(nombre, "win64")) { retornar 1 }
    si (str_igual(nombre, "macos") o str_igual(nombre, "macos-x64") o str_igual(nombre, "darwin")) { retornar 2 }
    si (str_igual(nombre, "macos-arm64") o str_igual(nombre, "macos-aarch64")) { retornar 3 }
    si (str_igual(nombre, "linux-arm64") o str_igual(nombre, "linux-aarch64")) { retornar 4 }
    si (str_igual(nombre, "ios-arm64") o str_igual(nombre, "ios")) { retornar 5 }
    si (str_igual(nombre, "ios-sim-arm64") o str_igual(nombre, "ios-simulator")) { retornar 6 }
    si (str_igual(nombre, "linux") o str_igual(nombre, "linux-x64")) { retornar 0 }
    si (str_igual(nombre, "wasm") o str_igual(nombre, "wasm32") o str_igual(nombre, "web")) { retornar 7 }
    rt_panico(str_concatenar("plataforma desconocida: ", str_concatenar(nombre, " (linux, linux-arm64, windows, macos, macos-arm64, ios-arm64, ios-sim-arm64)")))
    retornar 0
}

funcion modo_de_opcion(argumento) {
    si (str_igual(argumento, "--nativo")) { retornar 0 }
    si (str_igual(argumento, "--puente")) { retornar 1 }
    si (str_igual(argumento, "--dinamico")) { retornar 2 }
    si (str_igual(argumento, "--lenguaje")) { retornar 3 }
    retornar 0 - 1
}
