// bootstrap/nativo/cforge_cli.cfv — el comando cforge, 100 % C-Forge.
//
// Compila el programa a un ejecutable nativo (ELF x86-64) con el compilador
// autoalojado y el runtime incrustado (embebido.cfv), y lo ejecuta.
//
//   cforge archivo.cfv [args]        compila y ejecuta
//   cforge run archivo.cfv [args]    igual
//   cforge build archivo.cfv [-o s]  genera el ejecutable
//   cforge check archivo.cfv         verifica que compila
//   cforge --version | --help
//   cforge -o salida archivos...     modo de bajo nivel (arranque)

funcion cli_ayuda() {
    mostrar(str_concatenar("C-Forge ", version_cforge()))
    mostrar("Sitio:   https://c-forge.org")
    mostrar("")
    mostrar("Uso:")
    mostrar("  cforge archivo.cfv [args]        Compilar y ejecutar un programa")
    mostrar("  cforge run archivo.cfv [args]    Compilar y ejecutar un programa")
    mostrar("  cforge build archivo.cfv [-o s] [--target linux|windows|macos]")
    mostrar("                                   Compilar a un ejecutable nativo")
    mostrar("  cforge check archivo.cfv         Verificar que el programa compila")
    mostrar("  cforge --version                 Mostrar versión")
    mostrar("  cforge --help                    Mostrar esta ayuda")
    mostrar("")
    mostrar("Compilador autoalojado: escrito en C-Forge, sin C++ ni libc.")
    retornar 0
}

funcion termina_en(s, sufijo) {
    si (str_largo(s) < str_largo(sufijo)) { retornar 0 }
    retornar str_igual(str_rebanar(s, str_largo(s) - str_largo(sufijo), str_largo(s)), sufijo)
}

funcion empieza_con(s, prefijo) {
    si (str_largo(s) < str_largo(prefijo)) { retornar 0 }
    retornar str_igual(str_rebanar(s, 0, str_largo(prefijo)), prefijo)
}

funcion existe_ruta(ruta) {
    sea fd = sys_abrir(str_c(ruta), sys_abrir_lectura(), 0)
    si (fd < 0) { retornar 0 }
    sys_cerrar(fd)
    retornar 1
}


// Biblioteca estándar: $CFORGE_STDLIB, o junto al ejecutable
// (bin/../lib/cforge/stdlib como instala install.sh, o ./stdlib).
funcion ruta_stdlib() {
    sea desde_entorno = sys_variable_entorno("CFORGE_STDLIB")
    si (desde_entorno != 0) { retornar desde_entorno }
    sea exe = sys_ruta_ejecutable()
    si (exe != 0) {
        sea i = str_largo(exe)
        mientras (i > 0 y str_byte(exe, i - 1) != 47 y str_byte(exe, i - 1) != 92) { i = i - 1 }
        sea dir = str_rebanar(exe, 0, i)
        sea candidatos = vec_nuevo()
        vec_agregar(candidatos, str_concatenar(dir, "stdlib"))
        vec_agregar(candidatos, str_concatenar(dir, "../lib/cforge/stdlib"))
        vec_agregar(candidatos, str_concatenar(dir, "../stdlib"))
        vec_agregar(candidatos, str_concatenar(dir, "../../stdlib"))
        sea k = 0
        mientras (k < vec_largo(candidatos)) {
            si (existe_ruta(vec_obtener(candidatos, k))) { retornar vec_obtener(candidatos, k) }
            k = k + 1
        }
    }
    retornar "stdlib"
}

// Plataforma de destino (global 33): 0 Linux · 1 Windows · 2 macOS.
funcion destino_windows() { retornar mem_global(33) == 1 }

// sys_linux*.cfv, sys_windows*.cfv y sys_macos*.cfv según la plataforma.
funcion modulo_de_plataforma(nombre) {
    si (contiene_prefijo(nombre, "sys_windows")) { retornar mem_global(33) == 1 }
    si (contiene_prefijo(nombre, "sys_macos")) { retornar mem_global(33) == 2 o mem_global(33) == 3 }
    si (contiene_prefijo(nombre, "sys_linux_arm64")) { retornar mem_global(33) == 4 }
    si (contiene_prefijo(nombre, "sys_linux")) { retornar mem_global(33) == 0 }
    retornar 1
}

// "runtime/sdl.cfv" → "sdl_"
funcion prefijo_modulo(nombre) {
    sea i = str_largo(nombre)
    mientras (i > 0 y str_byte(nombre, i - 1) != 47) { i = i - 1 }
    sea base = str_rebanar(nombre, i, str_largo(nombre) - 4)
    retornar str_concatenar(base, "_")
}

funcion contiene_prefijo(s, prefijo) {
    sea i = 0
    mientras (i + str_largo(prefijo) <= str_largo(s)) {
        si (str_byte(s, i) == str_byte(prefijo, 0)) {
            si (str_igual(str_rebanar(s, i, i + str_largo(prefijo)), prefijo)) { retornar 1 }
        }
        i = i + 1
    }
    retornar 0
}

// Compila un programa del lenguaje con el runtime incrustado.
funcion compilar_archivo(ruta) {
    si (existe_ruta(ruta) == 0) { rt_panico(str_concatenar("no existe el archivo: ", ruta)) }
    mem_fijar_global(30, 1)
    sea fuente = str_nuevo(262144)
    sea archivos = vec_nuevo()
    sea i = 0
    mientras (i < runtime_cantidad()) {
        si (runtime_modo(i) != 4 y modulo_de_plataforma(runtime_nombre(i))) { agregar_fuente(fuente, runtime_modo(i), runtime_fuente(i), runtime_nombre(i), archivos) }
        i = i + 1
    }
    sea inicio_programa = str_largo(fuente)
    sea texto = archivo_leer(ruta)
    sea puntaje = puntaje_ingles(tokenizar(texto))
    agregar_con_importaciones(fuente, ruta_stdlib(), texto, ruta, vec_nuevo(), archivos)
    // Módulos opcionales: runtime/sdl.cfv si el programa usa "sdl_".
    sea programa = str_rebanar(fuente, inicio_programa, str_largo(fuente))
    i = 0
    mientras (i < runtime_cantidad()) {
        si (runtime_modo(i) == 4 y contiene_prefijo(programa, prefijo_modulo(runtime_nombre(i)))) {
            agregar_fuente(fuente, 3, runtime_fuente(i), runtime_nombre(i), archivos)
        }
        i = i + 1
    }
    retornar compilar_programa(fuente, archivos, puntaje)
}

// Compila, ejecuta con los argumentos desde "desde" y sale con su código.
funcion ejecutar(ruta, desde) {
    sea ejecutable = compilar_archivo(ruta)
    sea temporal = str_concatenar(sys_ruta_temporal(), str_concatenar("cforge-run-", str_desde_entero(sys_proceso_id())))
    si (sys_es_windows()) { str_agregar(temporal, ".exe") }
    escribir_ejecutable(temporal, ejecutable)
    sea argumentos = vec_nuevo()
    sea i = desde
    mientras (i < rt_argc()) {
        vec_agregar(argumentos, rt_argumento(i))
        i = i + 1
    }
    sea codigo = sys_ejecutar_programa(temporal, argumentos)
    sys_borrar(str_c(temporal))
    si (codigo < 0) { rt_panico(str_concatenar("no se pudo ejecutar ", temporal)) }
    sys_salir(codigo)
    retornar 0
}

funcion construir(ruta, salida) {
    si (salida == 0) {
        salida = ruta
        si (termina_en(ruta, ".cfv")) { salida = str_rebanar(ruta, 0, str_largo(ruta) - 4) }
        si (destino_windows()) { salida = str_concatenar(salida, ".exe") }
    }
    sea ejecutable = compilar_archivo(ruta)
    escribir_ejecutable(salida, ejecutable)
    sea m = str_concatenar("✓ ", salida)
    str_agregar(m, " (")
    str_agregar(m, str_desde_entero(str_largo(ejecutable)))
    str_agregar(m, " bytes)")
    mostrar(m)
    retornar 0
}

funcion fijar_destino(nombre) {
    mem_fijar_global(33, numero_plataforma(nombre))
    retornar 0
}

funcion requerir_archivo(i) {
    si (rt_argc() <= i) {
        cli_ayuda()
        sys_salir(2)
    }
    retornar rt_argumento(i)
}

si (sys_es_windows()) { mem_fijar_global(33, 1) }
si (str_igual(sys_nombre_plataforma(), "macOS x86-64")) { mem_fijar_global(33, 2) }
si (str_igual(sys_nombre_plataforma(), "macOS ARM64")) { mem_fijar_global(33, 3) }
si (str_igual(sys_nombre_plataforma(), "Linux ARM64")) { mem_fijar_global(33, 4) }
si (rt_argc() < 2) {
    cli_ayuda()
    sys_salir(0)
}
sea orden = rt_argumento(1)
si (str_igual(orden, "-o")) {
    cli_bajo_nivel()
} sino {
    si (str_igual(orden, "--version") o str_igual(orden, "-v") o str_igual(orden, "version")) {
        mostrar(str_concatenar(str_concatenar(str_concatenar("C-Forge ", version_cforge()), " (compilador nativo autoalojado, "), str_concatenar(sys_nombre_plataforma(), ")")))
    } sino {
        si (str_igual(orden, "--help") o str_igual(orden, "-h") o str_igual(orden, "help") o str_igual(orden, "ayuda")) {
            cli_ayuda()
        } sino {
            si (str_igual(orden, "run")) {
                ejecutar(requerir_archivo(2), 3)
            } sino {
                si (str_igual(orden, "build")) {
                    // cforge build archivo.cfv [-o salida] [--target linux|windows]
                    sea salida = 0
                    sea k = 3
                    mientras (k < rt_argc()) {
                        si (str_igual(rt_argumento(k), "-o") y k + 1 < rt_argc()) {
                            salida = rt_argumento(k + 1)
                            k = k + 1
                        }
                        si (str_igual(rt_argumento(k), "--target") y k + 1 < rt_argc()) {
                            fijar_destino(rt_argumento(k + 1))
                            k = k + 1
                        }
                        k = k + 1
                    }
                    construir(requerir_archivo(2), salida)
                } sino {
                    si (str_igual(orden, "check")) {
                        compilar_archivo(requerir_archivo(2))
                        mostrar(str_concatenar("✓ sin errores: ", rt_argumento(2)))
                    } sino {
                        si (termina_en(orden, ".cfv") o existe_ruta(orden)) {
                            ejecutar(orden, 2)
                        } sino {
                            rt_panico(str_concatenar("orden desconocida: ", str_concatenar(orden, " (usa cforge --help)")))
                        }
                    }
                }
            }
        }
    }
}
