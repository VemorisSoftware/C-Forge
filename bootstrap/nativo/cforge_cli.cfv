// bootstrap/nativo/cforge_cli.cfv — el comando cforge, 100 % C-Forge.
//
// Compila el programa a un ejecutable nativo (ELF x86-64) con el compilador
// autoalojado y el runtime incrustado (embebido.cfv), y lo ejecuta.
//
//   cforge archivo.cfv [args]        compila y ejecuta
//   cforge run archivo.cfv [args]    igual
//   cforge build archivo.cfv [-o s]  genera el ejecutable
//   cforge check archivo.cfv         verifica que compila
//   cforge init / add / remove / install   proyectos y paquetes (paquetes.cfv)
//   cforge fmt [--check] [rutas]     formatea el código (formato.cfv)
//   cforge --version | --help
//   cforge -o salida archivos...     modo de bajo nivel (arranque)

funcion cli_ayuda() {
    mostrar(str_concatenar("C-Forge ", version_cforge()))
    mostrar("Sitio:   https://c-forge.org")
    mostrar("")
    mostrar("Uso:")
    mostrar("  cforge archivo.cfv [args]        Compilar y ejecutar un programa")
    mostrar("  cforge run archivo.cfv [args]    Compilar y ejecutar un programa")
    mostrar("  cforge build archivo.cfv [-o s] [--target T]")
    mostrar("                                   Compilar a un ejecutable nativo")
    mostrar("                                   T: linux, linux-arm64, windows, macos, macos-arm64,")
    mostrar("                                      ios-arm64, ios-sim-arm64")
    mostrar("  cforge build archivo.cfv --lib [-o libx.a | x.o] [--target T]")
    mostrar("                                   Biblioteca estática + cabecera C (.h) de las")
    mostrar("                                   funciones #[Exportar] (Xcode, Swift, C)")
    mostrar("  cforge check archivo.cfv         Verificar que el programa compila")
    mostrar("  cforge test archivo.cfv [--coverage]  Ejecutar pruebas (y cobertura de líneas)")
    mostrar("  cforge doc archivo|carpeta [-o x.md|x.html]  Documentación desde los comentarios ///")
    mostrar("  cforge bindgen cabecera.h [--lib nombre] [-o m.cfv]  Módulo C-Forge desde una cabecera C")
    mostrar("  cforge bindgen geo.hpp --lib geo [--fuentes a.cpp]    Librería C++ → importar \"cpp:geo\"")
    mostrar("  cforge bindgen rust:crate[@versión]                    Crate de Rust → importar \"rust:crate\"")
    mostrar("")
    mostrar("Proyectos y paquetes (cforge.toml):")
    mostrar("  cforge init [nombre]             Crear un proyecto (también: cforge new nombre)")
    mostrar("  cforge add usuario/repo[@ref] [--como alias]")
    mostrar("                                   Agregar una dependencia de GitHub")
    mostrar("  cforge remove alias              Quitar una dependencia")
    mostrar("  cforge install                   Descargar las dependencias (cforge.lock)")
    mostrar("  cforge run | build | check       Sin archivo: el principal del proyecto")
    mostrar("")
    mostrar("Herramientas:")
    mostrar("  cforge fmt [--check] [rutas]     Formatear el código (.cfv)")
    mostrar("  cforge build --release a.cfv     Ejecutable sin el código que no usa")
    mostrar("  cforge build a.cfv --target wasm WebAssembly: a.wasm + a.mjs (navegador y Node)")
    mostrar("  cforge repl                      Consola interactiva (:salir para terminar)")
    mostrar("  cforge lsp                       Servidor de lenguaje (LSP) por stdio")
    mostrar("  cforge xcode-init [X.xcodeproj]  Integrar C-Forge en un proyecto de Xcode")
    mostrar("  cforge doctor                    Revisar la instalación")
    mostrar("  cforge --version                 Mostrar versión")
    mostrar("  cforge --help                    Mostrar esta ayuda")
    mostrar("")
    mostrar("Compilador autoalojado: escrito en C-Forge, sin C++ ni libc.")
    retornar 0
}

// ── Bienvenida: Forge, la mascota de C-Forge, en la terminal ─────────────────
//
// "cforge" sin argumentos muestra a Forge (el cuadrado naranja de c-forge.org)
// con los comandos para empezar. Sin color si NO_COLOR o CFORGE_SIMPLE están
// definidas, si TERM falta o es "dumb", o en Windows.

funcion bienvenida_con_color() {
    si (sys_es_windows()) { retornar 0 }
    si (sys_variable_entorno("NO_COLOR") != 0) { retornar 0 }
    si (sys_variable_entorno("CFORGE_SIMPLE") != 0) { retornar 0 }
    sea t = sys_variable_entorno("TERM")
    si (t == 0) { retornar 0 }
    si (str_largo(t) == 0 o str_igual(t, "dumb")) { retornar 0 }
    retornar 1
}

funcion bv_esc(r, codigo) {
    str_agregar_byte(r, 27)
    str_agregar(r, "[")
    str_agregar(r, codigo)
    str_agregar(r, "m")
    retornar r
}

funcion bv_verdadero_color() {
    sea c = sys_variable_entorno("COLORTERM")
    si (c == 0) { retornar 0 }
    retornar str_igual(c, "truecolor") o str_igual(c, "24bit")
}

// Color de una celda de Forge: O naranja, W blanco, D oscuro.
funcion bv_color(c, fondo) {
    sea tc = bv_verdadero_color()
    si (c == 79) {
        si (tc) { si (fondo) { retornar "48;2;255;106;50" } retornar "38;2;255;106;50" }
        si (fondo) { retornar "48;5;202" }
        retornar "38;5;202"
    }
    si (c == 87) {
        si (tc) { si (fondo) { retornar "48;2;255;255;255" } retornar "38;2;255;255;255" }
        si (fondo) { retornar "48;5;231" }
        retornar "38;5;231"
    }
    si (tc) { si (fondo) { retornar "48;2;24;24;24" } retornar "38;2;24;24;24" }
    si (fondo) { retornar "48;5;234" }
    retornar "38;5;234"
}

// Dos filas de la rejilla → una línea de medios bloques (▀ ▄).
funcion bv_fila(r, a, b) {
    str_agregar(r, "  ")
    sea x = 0
    mientras (x < str_largo(a)) {
        sea ca = str_byte(a, x)
        sea cb = str_byte(b, x)
        si (ca == 46 y cb == 46) {
            str_agregar(r, " ")
        } sino {
            si (ca == 46) {
                bv_esc(r, bv_color(cb, 0))
                str_agregar(r, "▄")
            } sino {
                si (cb == 46) {
                    bv_esc(r, bv_color(ca, 0))
                } sino {
                    bv_esc(r, str_concatenar(str_concatenar(bv_color(ca, 0), ";"), bv_color(cb, 1)))
                }
                str_agregar(r, "▀")
            }
            bv_esc(r, "0")
        }
        x = x + 1
    }
    retornar r
}

funcion bv_texto(r, estilo, texto) {
    si (str_largo(estilo) > 0) { bv_esc(r, estilo) }
    str_agregar(r, texto)
    si (str_largo(estilo) > 0) { bv_esc(r, "0") }
    retornar r
}

funcion bv_naranja() {
    si (bv_verdadero_color()) { retornar "1;38;2;255;106;50" }
    retornar "1;38;5;202"
}

funcion bv_comando(r, comando, relleno, descripcion) {
    str_agregar(r, "    ")
    bv_texto(r, bv_naranja(), "❯ ")
    bv_texto(r, "1", comando)
    str_agregar(r, relleno)
    bv_texto(r, "2", descripcion)
    str_agregar(r, "\n")
    retornar r
}

funcion cli_bienvenida() {
    si (bienvenida_con_color() == 0) { retornar cli_ayuda() }
    sea filas = vec_nuevo()
    vec_agregar(filas, ".OOOOOOOOOOOO.")
    vec_agregar(filas, "OOOOOOOOOOOOOO")
    vec_agregar(filas, "OOWWWWOOWWWWOO")
    vec_agregar(filas, "OODDWWOODDWWOO")
    vec_agregar(filas, "OODDWWOODDWWOO")
    vec_agregar(filas, "OOWWWWOOWWWWOO")
    vec_agregar(filas, "OOOOOOOOOOOOOO")
    vec_agregar(filas, "OOOODOOOODOOOO")
    vec_agregar(filas, "OOOOODDDDOOOOO")
    vec_agregar(filas, "OOOOOOOOOOOOOO")
    vec_agregar(filas, ".OOOOOOOOOOOO.")
    vec_agregar(filas, "..............")
    sea r = str_nuevo(4096)
    str_agregar(r, "\n")
    sea k = 0
    mientras (k < 12) {
        bv_fila(r, vec_obtener(filas, k), vec_obtener(filas, k + 1))
        str_agregar(r, "   ")
        si (k == 2) {
            bv_texto(r, bv_naranja(), "C-Forge")
            bv_texto(r, "2", str_concatenar(" v", version_cforge()))
        }
        si (k == 4) { str_agregar(r, str_concatenar("Compilador nativo · ", sys_nombre_plataforma())) }
        si (k == 6) { bv_texto(r, "2", "c-forge.org · Vemoris Software") }
        str_agregar(r, "\n")
        k = k + 2
    }
    str_agregar(r, "\n")
    bv_texto(r, "2", "  Empieza:")
    str_agregar(r, "\n")
    bv_comando(r, "cforge hola.cfv", "        ", "Ejecutar un programa")
    bv_comando(r, "cforge init mi_app", "     ", "Crear un proyecto")
    bv_comando(r, "cforge repl", "            ", "Consola interactiva")
    bv_comando(r, "cforge doctor", "          ", "Revisar la instalación")
    bv_comando(r, "cforge --help", "          ", "Todos los comandos")
    str_agregar(r, "\n")
    sys_escribir(1, str_datos(r), str_largo(r))
    retornar 0
}

funcion termina_en(s, sufijo) {
    si (str_largo(s) < str_largo(sufijo)) { retornar 0 }
    retornar str_igual(str_rebanar(s, str_largo(s) - str_largo(sufijo), str_largo(s)), sufijo)
}

funcion empieza_con(s, prefijo) {
    si (str_largo(s) < str_largo(prefijo)) { retornar 0 }
    retornar str_igual(str_rebanar(s, 0, str_largo(prefijo)), prefijo)
}

funcion existe_ruta(ruta) {
    sea fd = sys_abrir(str_c(ruta), sys_abrir_lectura(), 0)
    si (fd < 0) { retornar 0 }
    sys_cerrar(fd)
    retornar 1
}


// Biblioteca estándar: $CFORGE_STDLIB, o junto al ejecutable
// (bin/../lib/cforge/stdlib como instala install.sh, o ./stdlib).
funcion ruta_stdlib() {
    sea desde_entorno = sys_variable_entorno("CFORGE_STDLIB")
    si (desde_entorno != 0) { retornar desde_entorno }
    sea exe = sys_ruta_ejecutable()
    si (exe != 0) {
        sea i = str_largo(exe)
        mientras (i > 0 y str_byte(exe, i - 1) != 47 y str_byte(exe, i - 1) != 92) { i = i - 1 }
        sea dir = str_rebanar(exe, 0, i)
        sea candidatos = vec_nuevo()
        vec_agregar(candidatos, str_concatenar(dir, "stdlib"))
        vec_agregar(candidatos, str_concatenar(dir, "../lib/cforge/stdlib"))
        vec_agregar(candidatos, str_concatenar(dir, "../stdlib"))
        vec_agregar(candidatos, str_concatenar(dir, "../../stdlib"))
        sea k = 0
        mientras (k < vec_largo(candidatos)) {
            si (existe_ruta(vec_obtener(candidatos, k))) { retornar vec_obtener(candidatos, k) }
            k = k + 1
        }
    }
    retornar "stdlib"
}

// Plataforma de destino (global 33): 0 Linux · 1 Windows · 2 macOS.
funcion destino_windows() { retornar mem_global(33) == 1 }

// sys_linux*.cfv, sys_windows*.cfv y sys_macos*.cfv según la plataforma.
funcion modulo_de_plataforma(nombre) {
    si (contiene_prefijo(nombre, "sys_windows")) { retornar mem_global(33) == 1 }
    si (contiene_prefijo(nombre, "sys_macos")) { retornar es_darwin_numero(mem_global(33)) }
    si (contiene_prefijo(nombre, "sys_linux_arm64")) { retornar mem_global(33) == 4 }
    // WebAssembly usa los módulos de Linux x86-64 (el cargador emula sus llamadas).
    si (contiene_prefijo(nombre, "sys_linux")) { retornar mem_global(33) == 0 o mem_global(33) == 7 }
    retornar 1
}

// "runtime/sdl.cfv" → "sdl_"
funcion prefijo_modulo(nombre) {
    sea i = str_largo(nombre)
    mientras (i > 0 y str_byte(nombre, i - 1) != 47) { i = i - 1 }
    sea base = str_rebanar(nombre, i, str_largo(nombre) - 4)
    retornar str_concatenar(base, "_")
}

funcion contiene_prefijo(s, prefijo) {
    sea i = 0
    mientras (i + str_largo(prefijo) <= str_largo(s)) {
        si (str_byte(s, i) == str_byte(prefijo, 0)) {
            si (str_igual(str_rebanar(s, i, i + str_largo(prefijo)), prefijo)) { retornar 1 }
        }
        i = i + 1
    }
    retornar 0
}

// Compila un programa del lenguaje con el runtime incrustado.
funcion compilar_archivo(ruta) {
    // global 38: contenido alternativo (el texto sin guardar del editor).
    sea contenido = mem_global(38)
    si (contenido == 0 y existe_ruta(ruta) == 0) { rt_panico(str_concatenar("no existe el archivo: ", ruta)) }
    mem_fijar_global(30, 1)
    preparar_paquetes(ruta)
    sea fuente = str_nuevo(262144)
    sea archivos = vec_nuevo()
    sea i = 0
    mientras (i < runtime_cantidad()) {
        si (runtime_modo(i) <= 3 y modulo_de_plataforma(runtime_nombre(i))) { agregar_fuente(fuente, runtime_modo(i), runtime_fuente(i), runtime_nombre(i), archivos) }
        i = i + 1
    }
    sea inicio_programa = str_largo(fuente)
    sea texto = 0
    si (contenido != 0) { texto = archivo_leer(contenido) } sino { texto = archivo_leer(ruta) }
    sea puntaje = puntaje_ingles(tokenizar(texto))
    agregar_con_importaciones(fuente, ruta_stdlib(), texto, ruta, vec_nuevo(), archivos)
    // Módulos opcionales: runtime/sdl.cfv si el programa usa "sdl_".
    sea programa = str_rebanar(fuente, inicio_programa, str_largo(fuente))
    i = 0
    mientras (i < runtime_cantidad()) {
        si (runtime_modo(i) == 4 y contiene_prefijo(programa, prefijo_modulo(runtime_nombre(i)))) {
            agregar_fuente(fuente, 3, runtime_fuente(i), runtime_nombre(i), archivos)
        }
        i = i + 1
    }
    retornar compilar_programa(fuente, archivos, puntaje)
}

// Compila, ejecuta con los argumentos desde "desde" y sale con su código.
funcion ejecutar(ruta, desde) {
    sea ejecutable = compilar_archivo(ruta)
    sea temporal = str_concatenar(sys_ruta_temporal(), str_concatenar("cforge-run-", str_desde_entero(sys_proceso_id())))
    si (sys_es_windows()) { str_agregar(temporal, ".exe") }
    escribir_ejecutable(temporal, ejecutable)
    sea argumentos = vec_nuevo()
    sea i = desde
    mientras (i < rt_argc()) {
        vec_agregar(argumentos, rt_argumento(i))
        i = i + 1
    }
    sea codigo = sys_ejecutar_programa(temporal, argumentos)
    sys_borrar(str_c(temporal))
    si (codigo < 0) { rt_panico(str_concatenar("no se pudo ejecutar ", temporal)) }
    sys_salir(codigo)
    retornar 0
}

funcion tiene_argumento(a) {
    sea i = 2
    mientras (i < rt_argc()) {
        si (str_igual(rt_argumento(i), a)) { retornar 1 }
        i = i + 1
    }
    retornar 0
}

// ── cforge bindgen ────────────────────────────────────────────────────────
// Ejecuta stdlib/bindgen.cfv (escrito en C-Forge) sobre la cabecera.

funcion literal_cfv(s) {
    sea r = str_nuevo(str_largo(s) + 8)
    str_agregar_byte(r, 34)
    sea i = 0
    mientras (i < str_largo(s)) {
        si (str_byte(s, i) == 92 o str_byte(s, i) == 34) { str_agregar_byte(r, 92) }
        str_agregar_byte(r, str_byte(s, i))
        i = i + 1
    }
    str_agregar_byte(r, 34)
    retornar r
}

funcion valor_de_opcion(nombre) {
    sea i = 2
    mientras (i + 1 < rt_argc()) {
        si (str_igual(rt_argumento(i), nombre)) { retornar rt_argumento(i + 1) }
        i = i + 1
    }
    retornar 0
}

// C++ (.hpp, .hh, .hxx o --cpp) y crates de Rust (rust:crate) van a
// stdlib/puente.cfv con todos los argumentos.
funcion es_puente(cabecera) {
    si (str_largo(cabecera) > 5 y str_igual(str_rebanar(cabecera, 0, 5), "rust:")) { retornar 1 }
    si (termina_en(cabecera, ".hpp") o termina_en(cabecera, ".hh") o termina_en(cabecera, ".hxx") o termina_en(cabecera, ".h++")) { retornar 1 }
    retornar tiene_argumento("--cpp")
}

funcion orden_puente() {
    sea programa = str_nuevo(512)
    str_agregar(programa, "importar \"puente\"\npuente_cli([")
    sea i = 2
    mientras (i < rt_argc()) {
        si (i > 2) { str_agregar(programa, ", ") }
        str_agregar(programa, literal_cfv(rt_argumento(i)))
        i = i + 1
    }
    str_agregar(programa, "])\n")
    sea temporal = str_concatenar(sys_ruta_temporal(), str_concatenar("cforge-puente-", str_concatenar(str_desde_entero(sys_proceso_id()), ".cfv")))
    str_agregar(programa, "eliminar_archivo(")
    str_agregar(programa, literal_cfv(temporal))
    str_agregar(programa, ")\n")
    archivo_escribir(temporal, programa)
    ejecutar(temporal, rt_argc())
    retornar 0
}

funcion orden_bindgen(cabecera) {
    si (es_puente(cabecera)) { retornar orden_puente() }
    si (existe_ruta(cabecera) == 0) { rt_panico(str_concatenar("cforge bindgen: no existe ", cabecera)) }
    sea base = nombre_de(cabecera)
    si (termina_en(base, ".h")) { base = str_rebanar(base, 0, str_largo(base) - 2) }
    sea lib = valor_de_opcion("--lib")
    si (lib == 0) { lib = base }
    sea salida = valor_de_opcion("-o")
    si (salida == 0) { salida = str_concatenar(base, ".cfv") }
    sea programa = str_nuevo(512)
    str_agregar(programa, "importar \"bindgen\"\nsea m = bindgen_archivo(")
    str_agregar(programa, literal_cfv(cabecera))
    str_agregar(programa, ", ")
    str_agregar(programa, literal_cfv(lib))
    str_agregar(programa, ")\nescribir_archivo(")
    str_agregar(programa, literal_cfv(salida))
    str_agregar(programa, ", m)\nmostrar(\"✓ \" + ")
    str_agregar(programa, literal_cfv(salida))
    str_agregar(programa, " + \": \" + texto_dividir(m, \"\\n\")[1])\n")
    sea temporal = str_concatenar(sys_ruta_temporal(), str_concatenar("cforge-bindgen-", str_concatenar(str_desde_entero(sys_proceso_id()), ".cfv")))
    // El programa borra su propia fuente temporal (ejecutar no vuelve).
    str_agregar(programa, "eliminar_archivo(")
    str_agregar(programa, literal_cfv(temporal))
    str_agregar(programa, ")\n")
    archivo_escribir(temporal, programa)
    ejecutar(temporal, rt_argc())
    retornar 0
}

// ── cforge doc ────────────────────────────────────────────────────────────
// Documentación desde los comentarios "///" (y "/// @doc") que preceden a
// funcion, async funcion y clase; el bloque de "//" del principio del
// archivo es su introducción. Markdown por defecto; HTML si la salida
// termina en .html. Las funciones que empiezan con "_" son privadas.

funcion doc_recortar(s) {
    sea i = 0
    sea j = str_largo(s)
    mientras (i < j y (str_byte(s, i) == 32 o str_byte(s, i) == 9)) { i = i + 1 }
    mientras (j > i y (str_byte(s, j - 1) == 32 o str_byte(s, j - 1) == 9 o str_byte(s, j - 1) == 13)) { j = j - 1 }
    retornar str_rebanar(s, i, j)
}

funcion doc_empieza(s, p) { retornar str_largo(s) >= str_largo(p) y str_igual(str_rebanar(s, 0, str_largo(p)), p) }

funcion doc_html(s) {
    sea r = str_nuevo(str_largo(s) + 16)
    sea i = 0
    mientras (i < str_largo(s)) {
        sea b = str_byte(s, i)
        si (b == 60) { str_agregar(r, "&lt;") } sino {
            si (b == 62) { str_agregar(r, "&gt;") } sino {
                si (b == 38) { str_agregar(r, "&amp;") } sino { str_agregar_byte(r, b) }
            }
        }
        i = i + 1
    }
    retornar r
}

// Documentación de un archivo: agrega a md (Markdown) y html.
funcion doc_archivo(ruta, md, html) {
    sea lineas = vec_nuevo()
    sea texto = archivo_leer(ruta)
    sea inicio = 0
    sea p = 0
    mientras (p <= str_largo(texto)) {
        si (p == str_largo(texto) o str_byte(texto, p) == 10) {
            vec_agregar(lineas, str_rebanar(texto, inicio, p))
            inicio = p + 1
        }
        p = p + 1
    }
    str_agregar(md, "# ")
    str_agregar(md, nombre_de(ruta))
    str_agregar(md, "\n\n")
    str_agregar(html, "<h1>")
    str_agregar(html, doc_html(nombre_de(ruta)))
    str_agregar(html, "</h1>\n")
    // Introducción: el bloque inicial de "//" (sin la primera línea si solo
    // repite la ruta del archivo).
    sea k = 0
    sea intro = str_nuevo(64)
    mientras (k < vec_largo(lineas) y doc_empieza(doc_recortar(vec_obtener(lineas, k)), "//") y doc_empieza(doc_recortar(vec_obtener(lineas, k)), "///") == 0) {
        sea l = doc_recortar(str_rebanar(doc_recortar(vec_obtener(lineas, k)), 2, str_largo(doc_recortar(vec_obtener(lineas, k)))))
        str_agregar(intro, l)
        str_agregar(intro, "\n")
        k = k + 1
    }
    si (str_largo(intro) > 0) {
        str_agregar(md, intro)
        str_agregar(md, "\n")
        str_agregar(html, "<pre class=\"intro\">")
        str_agregar(html, doc_html(intro))
        str_agregar(html, "</pre>\n")
    }
    sea comentario = str_nuevo(64)
    sea total = 0
    mientras (k < vec_largo(lineas)) {
        sea l = doc_recortar(vec_obtener(lineas, k))
        si (doc_empieza(l, "///")) {
            sea t = doc_recortar(str_rebanar(l, 3, str_largo(l)))
            si (doc_empieza(t, "@doc ")) { t = doc_recortar(str_rebanar(t, 5, str_largo(t))) }
            str_agregar(comentario, t)
            str_agregar(comentario, "\n")
        } sino {
            sea firma = 0
            si (doc_empieza(l, "funcion ") o doc_empieza(l, "async funcion ") o doc_empieza(l, "asincrona funcion ") o doc_empieza(l, "clase ")) {
                sea llave = posicion_de(l, 123)
                firma = l
                si (llave > 0) { firma = doc_recortar(str_rebanar(l, 0, llave)) }
                sea nombre_inicio = posicion_de(firma, 32) + 1
                si (doc_empieza(firma, "async ") o doc_empieza(firma, "asincrona ")) { nombre_inicio = posicion_de(str_rebanar(firma, nombre_inicio, str_largo(firma)), 32) + nombre_inicio + 1 }
                si (nombre_inicio < str_largo(firma) y str_byte(firma, nombre_inicio) == 95) { firma = 0 }
            }
            si (firma != 0) {
                str_agregar(md, "## `")
                str_agregar(md, firma)
                str_agregar(md, "`\n\n")
                str_agregar(html, "<h2><code>")
                str_agregar(html, doc_html(firma))
                str_agregar(html, "</code></h2>\n")
                si (str_largo(comentario) > 0) {
                    str_agregar(md, comentario)
                    str_agregar(md, "\n")
                    str_agregar(html, "<p>")
                    str_agregar(html, doc_html(comentario))
                    str_agregar(html, "</p>\n")
                }
                total = total + 1
            }
            si (str_largo(l) > 0) { __guardar64(comentario, 0) }
        }
        k = k + 1
    }
    retornar total
}

funcion orden_doc(entrada, salida) {
    sea archivos = vec_nuevo()
    sea nombres = sys_listar(entrada)
    si (nombres != 0) {
        sea i = 0
        mientras (i < vec_largo(nombres)) {
            sea n = vec_obtener(nombres, i)
            si (termina_en(n, ".cfv")) { vec_agregar(archivos, unir_ruta(entrada, n)) }
            i = i + 1
        }
        // Orden alfabético (inserción).
        i = 1
        mientras (i < vec_largo(archivos)) {
            sea x = vec_obtener(archivos, i)
            sea j = i - 1
            sea seguir = 1
            mientras (seguir) {
                si (j < 0) { seguir = 0 } sino {
                    si (pq_texto_menor(x, vec_obtener(archivos, j))) {
                        vec_fijar(archivos, j + 1, vec_obtener(archivos, j))
                        j = j - 1
                    } sino { seguir = 0 }
                }
            }
            vec_fijar(archivos, j + 1, x)
            i = i + 1
        }
    } sino {
        si (existe_ruta(entrada) == 0) { rt_panico(str_concatenar("cforge doc: no existe ", entrada)) }
        vec_agregar(archivos, entrada)
    }
    sea md = str_nuevo(4096)
    sea html = str_nuevo(4096)
    str_agregar(html, "<!DOCTYPE html>\n<html lang=\"es\"><head><meta charset=\"utf-8\"><title>Documentación C-Forge</title>\n<style>body{font-family:system-ui,sans-serif;max-width:860px;margin:2rem auto;padding:0 1rem;line-height:1.55;color:#1d1d1f}h1{border-bottom:1px solid #ddd;padding-bottom:.3rem;margin-top:2.5rem}h2{font-size:1.05rem;margin:1.6rem 0 .4rem}code{background:#f4f4f6;padding:.1rem .35rem;border-radius:4px}p,pre{white-space:pre-wrap}pre.intro{color:#555;font-family:inherit}</style></head><body>\n")
    sea total = 0
    sea i = 0
    mientras (i < vec_largo(archivos)) {
        total = total + doc_archivo(vec_obtener(archivos, i), md, html)
        i = i + 1
    }
    str_agregar(html, "</body></html>\n")
    sea resumen = str_concatenar("✓ ", str_desde_entero(total))
    str_agregar(resumen, " elemento(s) documentado(s) en ")
    str_agregar(resumen, str_desde_entero(vec_largo(archivos)))
    str_agregar(resumen, " archivo(s)")
    si (salida == 0) {
        rt_escribir_texto(1, md)
    } sino {
        si (termina_en(salida, ".html")) { archivo_escribir(salida, html) } sino { archivo_escribir(salida, md) }
        mostrar(str_concatenar(str_concatenar(resumen, " → "), salida))
    }
    retornar 0
}

// ── cforge test --coverage ────────────────────────────────────────────────
// El compilador instrumenta cada línea con sentencias del archivo (global
// 55: líneas instrumentadas); el programa vuelca sus conteos al terminar
// (también si una prueba falla) y aquí se cruzan.
funcion ejecutar_con_cobertura(ruta) {
    sea lineas = vec_nuevo()
    mem_fijar_global(55, lineas)
    sea temporal = str_concatenar(sys_ruta_temporal(), str_concatenar("cforge-test-", str_desde_entero(sys_proceso_id())))
    sea conteos = str_concatenar(temporal, ".cobertura")
    sea info = mem_reservar(16)
    __guardar64(info, ruta)
    __guardar64(info + 8, conteos)
    mem_fijar_global(58, info)
    sea ejecutable = compilar_archivo(ruta)
    si (sys_es_windows()) { str_agregar(temporal, ".exe") }
    escribir_ejecutable(temporal, ejecutable)
    sea argumentos = vec_nuevo()
    sea i = 3
    mientras (i < rt_argc()) {
        si (str_igual(rt_argumento(i), "--coverage") == 0 y str_igual(rt_argumento(i), "--cobertura") == 0) { vec_agregar(argumentos, rt_argumento(i)) }
        i = i + 1
    }
    sea codigo = sys_ejecutar_programa(temporal, argumentos)
    sys_borrar(str_c(temporal))
    si (codigo < 0) { rt_panico(str_concatenar("no se pudo ejecutar ", temporal)) }
    // Líneas instrumentadas (sin repetir) y conteos.
    sea maximo = 0
    i = 0
    mientras (i < vec_largo(lineas)) {
        si (vec_obtener(lineas, i) > maximo) { maximo = vec_obtener(lineas, i) }
        i = i + 1
    }
    sea marcas = mem_reservar(maximo * 8 + 16)
    mem_llenar(marcas, 0, maximo * 8 + 16)
    i = 0
    mientras (i < vec_largo(lineas)) {
        __guardar64(marcas + vec_obtener(lineas, i) * 8, 1)
        i = i + 1
    }
    si (existe_ruta(conteos)) {
        sea texto = archivo_leer(conteos)
        sys_borrar(str_c(conteos))
        sea p = 0
        mientras (p < str_largo(texto)) {
            sea n = 0
            mientras (p < str_largo(texto) y str_byte(texto, p) >= 48 y str_byte(texto, p) <= 57) {
                n = n * 10 + str_byte(texto, p) - 48
                p = p + 1
            }
            si (n > 0 y n <= maximo y __cargar64(marcas + n * 8) == 1) { __guardar64(marcas + n * 8, 2) }
            mientras (p < str_largo(texto) y str_byte(texto, p) != 10) { p = p + 1 }
            p = p + 1
        }
    }
    sea total = 0
    sea cubiertas = 0
    sea faltan = str_nuevo(64)
    sea n = 1
    mientras (n <= maximo) {
        sea m = __cargar64(marcas + n * 8)
        si (m > 0) {
            total = total + 1
            si (m == 2) { cubiertas = cubiertas + 1 } sino {
                si (str_largo(faltan) > 0) { str_agregar(faltan, ", ") }
                str_agregar(faltan, str_desde_entero(n))
            }
        }
        n = n + 1
    }
    sea m = str_concatenar("cobertura de ", ruta)
    str_agregar(m, ": ")
    str_agregar(m, str_desde_entero(cubiertas))
    str_agregar(m, "/")
    str_agregar(m, str_desde_entero(total))
    str_agregar(m, " líneas (")
    sea milesimas = 1000
    si (total > 0) { milesimas = cubiertas * 1000 / total }
    str_agregar(m, str_desde_entero(milesimas / 10))
    str_agregar(m, ".")
    str_agregar(m, str_desde_entero(milesimas % 10))
    str_agregar(m, " %)")
    mostrar(m)
    si (str_largo(faltan) > 0) { mostrar(str_concatenar("  sin ejecutar: ", faltan)) }
    sys_salir(codigo)
    retornar 0
}

// ── cforge repl ───────────────────────────────────────────────────────────
// Cada entrada se valida con "cforge check" (subproceso silencioso) y luego
// se ejecuta el programa acumulado; el runtime omite las líneas que ya se
// mostraron (repl_preparar). Una expresión suelta muestra su valor.

// Línea de stdin sin el salto (0 al terminar la entrada).
funcion repl_leer_linea() {
    sea r = str_nuevo(128)
    sea b = mem_reservar(8)
    sea leidos = 0
    sea seguir = 1
    mientras (seguir) {
        sea n = sys_leer(0, b, 1)
        si (n <= 0) {
            seguir = 0
            si (leidos == 0) {
                mem_liberar(b)
                retornar 0
            }
        } sino {
            leidos = leidos + 1
            sea c = __cargar8(b)
            si (c == 10) { seguir = 0 } sino { si (c != 13) { str_agregar_byte(r, c) } }
        }
    }
    mem_liberar(b)
    retornar r
}

// Paréntesis, corchetes y llaves abiertos (fuera de textos y comentarios).
funcion repl_abiertos(s) {
    sea n = 0
    sea i = 0
    mientras (i < str_largo(s)) {
        sea c = str_byte(s, i)
        si (c == 34) {
            i = i + 1
            mientras (i < str_largo(s) y str_byte(s, i) != 34) {
                si (str_byte(s, i) == 92) { i = i + 1 }
                i = i + 1
            }
        } sino {
            si (c == 47 y i + 1 < str_largo(s) y str_byte(s, i + 1) == 47) {
                mientras (i < str_largo(s) y str_byte(s, i) != 10) { i = i + 1 }
            } sino {
                si (c == 40 o c == 91 o c == 123) { n = n + 1 }
                si (c == 41 o c == 93 o c == 125) { n = n - 1 }
            }
        }
        i = i + 1
    }
    retornar n
}

funcion repl_empieza(s, palabra) {
    si (str_largo(s) < str_largo(palabra)) { retornar 0 }
    si (str_igual(str_rebanar(s, 0, str_largo(palabra)), palabra) == 0) { retornar 0 }
    si (str_largo(s) == str_largo(palabra)) { retornar 1 }
    sea c = str_byte(s, str_largo(palabra))
    retornar es_identificador(c) == 0
}

// ¿Es una declaración o sentencia (no se envuelve como expresión)?
funcion repl_es_sentencia(s) {
    sea i = 0
    mientras (i < str_largo(s) y es_espacio(str_byte(s, i))) { i = i + 1 }
    sea t = str_rebanar(s, i, str_largo(s))
    sea palabras = "sea let var constante const funcion function fn clase class estructura struct interfaz interface importar import extern si if mientras while para for intentar try retornar return lanzar throw"
    sea inicio = 0
    sea k = 0
    mientras (k <= str_largo(palabras)) {
        si (k == str_largo(palabras) o str_byte(palabras, k) == 32) {
            si (repl_empieza(t, str_rebanar(palabras, inicio, k))) { retornar 1 }
            inicio = k + 1
        }
        k = k + 1
    }
    retornar 0
}

funcion repl_buscar(s, aguja, desde) {
    sea i = desde
    mientras (i + str_largo(aguja) <= str_largo(s)) {
        si (str_igual(str_rebanar(s, i, i + str_largo(aguja)), aguja)) { retornar i }
        i = i + 1
    }
    retornar 0 - 1
}

// Texto como literal del lenguaje (rutas de Windows con "\").
funcion repl_literal(s) {
    sea r = str_nuevo(str_largo(s) + 8)
    str_agregar_byte(r, 34)
    sea i = 0
    mientras (i < str_largo(s)) {
        sea c = str_byte(s, i)
        si (c == 92 o c == 34) { str_agregar_byte(r, 92) }
        str_agregar_byte(r, c)
        i = i + 1
    }
    str_agregar_byte(r, 34)
    retornar r
}

// Escribe el programa (historia + entrada) y lo revisa; 0 si compila, si
// no, el mensaje de error.
funcion repl_revisar(exe, ruta, diag, encabezado, historia, entrada) {
    sea p = str_concatenar(encabezado, historia)
    str_agregar(p, entrada)
    str_agregar(p, "\n")
    archivo_escribir(ruta, p)
    archivo_escribir(diag, "")
    sea args = vec_nuevo()
    vec_agregar(args, "check")
    vec_agregar(args, ruta)
    vec_agregar(args, "--diagnosticos")
    vec_agregar(args, diag)
    vec_agregar(args, "--silencioso")
    si (sys_ejecutar_programa(exe, args) == 0) { retornar 0 }
    sea m = archivo_leer(diag)
    si (str_largo(m) == 0) { m = "error al compilar" }
    retornar m
}

funcion orden_repl() {
    sea exe = sys_ruta_ejecutable()
    si (exe == 0) { rt_panico("repl: no se encontró el ejecutable de cforge") }
    sea base = str_concatenar(sys_ruta_temporal(), str_concatenar("cforge-repl-", str_desde_entero(sys_proceso_id())))
    sea ruta = str_concatenar(base, ".cfv")
    sea diag = str_concatenar(base, ".diag")
    sea conteo = str_concatenar(base, ".n")
    sea historia = str_nuevo(4096)
    sea mostradas = 0
    rt_escribir_texto(1, str_concatenar(str_concatenar("C-Forge ", version_cforge()), " — repl (:salir para terminar, :programa, :limpiar)\n"))
    sea seguir = 1
    mientras (seguir) {
        rt_escribir_texto(1, "cforge> ")
        sea entrada = repl_leer_linea()
        si (entrada == 0) {
            seguir = 0
            rt_escribir_texto(1, "\n")
        } sino {
            mientras (repl_abiertos(entrada) > 0 y entrada != 0) {
                rt_escribir_texto(1, "   ...> ")
                sea mas = repl_leer_linea()
                si (mas == 0) {
                    entrada = 0
                } sino {
                    str_agregar_byte(entrada, 10)
                    str_agregar(entrada, mas)
                }
            }
        }
        si (entrada == 0) {
            seguir = 0
        } sino {
            sea limpia = entrada
            sea i = 0
            mientras (i < str_largo(limpia) y es_espacio(str_byte(limpia, i))) { i = i + 1 }
            limpia = str_rebanar(limpia, i, str_largo(limpia))
            si (str_igual(limpia, ":salir") o str_igual(limpia, ":q") o str_igual(limpia, "salir()") o str_igual(limpia, "exit()")) {
                seguir = 0
            } sino {
                si (str_igual(limpia, ":programa")) {
                    rt_escribir_texto(1, historia)
                } sino {
                    si (str_igual(limpia, ":limpiar")) {
                        historia = str_nuevo(4096)
                        mostradas = 0
                    } sino {
                        si (str_largo(limpia) > 0) {
                            sea encabezado = str_concatenar("repl_preparar(", str_desde_entero(mostradas))
                            str_agregar(encabezado, ", ")
                            str_agregar(encabezado, repl_literal(conteo))
                            str_agregar(encabezado, ")\n")
                            sea candidata = entrada
                            sea error = 1
                            si (repl_es_sentencia(entrada) == 0) {
                                candidata = str_concatenar("repl_valor(", entrada)
                                str_agregar(candidata, ")")
                                error = repl_revisar(exe, ruta, diag, encabezado, historia, candidata)
                                si (error != 0) { candidata = entrada }
                            }
                            si (error != 0) { error = repl_revisar(exe, ruta, diag, encabezado, historia, candidata) }
                            si (error != 0) {
                                // "/tmp/cforge-repl-N.cfv:12: mensaje" → "mensaje"
                                sea p = repl_buscar(error, ".cfv:", 0)
                                si (p >= 0) {
                                    sea q = repl_buscar(error, ": ", p + 5)
                                    si (q >= 0) { error = str_rebanar(error, q + 2, str_largo(error)) }
                                }
                                rt_escribir_texto(2, str_concatenar(str_concatenar("error: ", error), "\n"))
                            } sino {
                                sea args = vec_nuevo()
                                vec_agregar(args, ruta)
                                si (sys_ejecutar_programa(exe, args) == 0) {
                                    str_agregar(historia, candidata)
                                    str_agregar(historia, "\n")
                                    sea n = archivo_leer(conteo)
                                    mostradas = numero_literal(n)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    sys_borrar(str_c(ruta))
    sys_borrar(str_c(diag))
    sys_borrar(str_c(conteo))
    retornar 0
}

funcion construir(ruta, salida) {
    si (mem_global(40) != 0) { retornar construir_biblioteca(ruta, salida) }
    si (salida == 0) {
        salida = ruta
        si (termina_en(ruta, ".cfv")) { salida = str_rebanar(ruta, 0, str_largo(ruta) - 4) }
        si (destino_windows()) { salida = str_concatenar(salida, ".exe") }
    }
    si (mem_global(33) == 7) { retornar construir_wasm(ruta, salida) }
    sea ejecutable = compilar_archivo(ruta)
    escribir_ejecutable(salida, ejecutable)
    sea m = str_concatenar("✓ ", salida)
    str_agregar(m, " (")
    str_agregar(m, str_desde_entero(str_largo(ejecutable)))
    str_agregar(m, " bytes)")
    mostrar(m)
    retornar 0
}

// Texto de un recurso incrustado (make embebido --recurso).
funcion recurso_embebido(nombre) {
    sea i = 0
    mientras (i < runtime_cantidad()) {
        si (runtime_modo(i) == 5 y str_igual(runtime_nombre(i), nombre)) { retornar runtime_fuente(i) }
        i = i + 1
    }
    rt_panico(str_concatenar("falta el recurso incrustado ", nombre))
    retornar 0
}

// cforge build archivo.cfv --target wasm [-o app]: app.wasm, el cargador
// app.mjs (navegador y Node.js) y sus tipos app.d.ts.
funcion construir_wasm(ruta, salida) {
    si (termina_en(salida, ".wasm")) { salida = str_rebanar(salida, 0, str_largo(salida) - 5) }
    si (termina_en(salida, ".mjs")) { salida = str_rebanar(salida, 0, str_largo(salida) - 4) }
    si (termina_en(salida, ".js")) { salida = str_rebanar(salida, 0, str_largo(salida) - 3) }
    sea modulo = compilar_archivo(ruta)
    sea ruta_wasm = str_concatenar(salida, ".wasm")
    archivo_escribir(ruta_wasm, modulo)
    sea cargador = str_nuevo(32768)
    str_agregar(cargador, mem_global(41))
    str_agregar(cargador, "const WASM = \"./")
    str_agregar(cargador, nombre_de(ruta_wasm))
    str_agregar(cargador, "\";\n")
    str_agregar(cargador, recurso_embebido("runtime/wasm_cargador.js"))
    sea ruta_js = str_concatenar(salida, ".mjs")
    archivo_escribir(ruta_js, cargador)
    sea tipos = str_nuevo(2048)
    str_agregar(tipos, "// Generado por cforge build --target wasm.\n")
    str_agregar(tipos, "export interface ProgramaCForge {\n  codigo: number;\n  memoria: WebAssembly.Memory;\n  funciones: string[];\n  llamar(nombre: string, entero?: number): number | bigint;\n}\n")
    str_agregar(tipos, "export interface OpcionesCForge {\n  js?: Record<string, (...args: any[]) => any>;\n  modulos?: Record<string, Record<string, (...args: any[]) => any>>;\n  argumentos?: string[];\n  web?: boolean;\n  wasm?: BufferSource;\n  escribir?: (fd: number, texto: string) => void;\n}\n")
    str_agregar(tipos, "export function iniciar(opciones?: OpcionesCForge): Promise<ProgramaCForge>;\n")
    archivo_escribir(str_concatenar(salida, ".d.ts"), tipos)
    // --html: una página mínima que carga el programa (no pisa una existente).
    sea ruta_html = str_concatenar(salida, ".html")
    si (tiene_argumento("--html") y existe_ruta(ruta_html) == 0) {
        sea h = str_nuevo(512)
        str_agregar(h, "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>")
        str_agregar(h, nombre_de(salida))
        str_agregar(h, "</title>\n</head>\n<body>\n  <script type=\"module\">\n    import { iniciar } from \"./")
        str_agregar(h, nombre_de(ruta_js))
        str_agregar(h, "\";\n    iniciar();\n  </script>\n</body>\n</html>\n")
        archivo_escribir(ruta_html, h)
    }
    sea m = str_concatenar("✓ ", ruta_wasm)
    str_agregar(m, " (")
    str_agregar(m, str_desde_entero(str_largo(modulo)))
    str_agregar(m, " bytes) + ")
    str_agregar(m, ruta_js)
    str_agregar(m, " + ")
    str_agregar(m, str_concatenar(salida, ".d.ts"))
    mostrar(m)
    retornar 0
}

// cforge build archivo.cfv --lib [-o libnombre.a | nombre.o]: biblioteca
// estática (o objeto) y su cabecera C nombre.h junto a la salida.
funcion construir_biblioteca(ruta, salida) {
    sea base = nombre_de(ruta)
    si (termina_en(base, ".cfv")) { base = str_rebanar(base, 0, str_largo(base) - 4) }
    si (salida == 0) { salida = str_concatenar(str_concatenar("lib", base), ".a") }
    si (termina_en(salida, ".o")) { mem_fijar_global(40, 2) }
    si (mem_global(33) == 0 o mem_global(33) == 1 o mem_global(33) == 2 o mem_global(33) == 4) {
        si (str_igual(sys_nombre_plataforma(), "macOS ARM64")) { mem_fijar_global(33, 3) } sino { rt_panico("--lib necesita --target macos-arm64, ios-arm64 o ios-sim-arm64") }
    }
    sea binario = compilar_archivo(ruta)
    archivo_escribir(salida, binario)
    sea nombre_h = nombre_de(salida)
    si (termina_en(nombre_h, ".a") o termina_en(nombre_h, ".o")) { nombre_h = str_rebanar(nombre_h, 0, str_largo(nombre_h) - 2) }
    si (empieza_con(nombre_h, "lib")) { nombre_h = str_rebanar(nombre_h, 3, str_largo(nombre_h)) }
    sea cabecera = unir_ruta(directorio_de(salida), str_concatenar(nombre_h, ".h"))
    archivo_escribir(cabecera, mem_global(41))
    sea m = str_concatenar("✓ ", salida)
    str_agregar(m, " + ")
    str_agregar(m, cabecera)
    mostrar(m)
    retornar 0
}

funcion fijar_destino(nombre) {
    mem_fijar_global(33, numero_plataforma(nombre))
    retornar 0
}

funcion requerir_archivo(i) {
    si (rt_argc() <= i o empieza_con(rt_argumento(i), "-")) {
        sea p = principal_proyecto()
        si (p != 0) { retornar p }
    }
    si (rt_argc() <= i o empieza_con(rt_argumento(i), "-")) {
        cli_ayuda()
        sys_salir(2)
    }
    retornar rt_argumento(i)
}

si (sys_es_windows()) { mem_fijar_global(33, 1) }
si (str_igual(sys_nombre_plataforma(), "macOS x86-64")) { mem_fijar_global(33, 2) }
si (str_igual(sys_nombre_plataforma(), "macOS ARM64")) { mem_fijar_global(33, 3) }
si (str_igual(sys_nombre_plataforma(), "Linux ARM64")) { mem_fijar_global(33, 4) }
si (rt_argc() < 2) {
    cli_bienvenida()
    sys_salir(0)
}
sea orden = rt_argumento(1)
si (str_igual(orden, "-o")) {
    cli_bajo_nivel()
} sino {
    si (str_igual(orden, "--version") o str_igual(orden, "-v") o str_igual(orden, "version")) {
        mostrar(str_concatenar(str_concatenar(str_concatenar("C-Forge ", version_cforge()), " (compilador nativo autoalojado, "), str_concatenar(sys_nombre_plataforma(), ")")))
    } sino {
        si (str_igual(orden, "--help") o str_igual(orden, "-h") o str_igual(orden, "help") o str_igual(orden, "ayuda")) {
            cli_ayuda()
        } sino {
            si (str_igual(orden, "doctor")) {
                orden_doctor()
            } sino {
            si (str_igual(orden, "init") o str_igual(orden, "new")) {
                si (rt_argc() > 2) { orden_init(rt_argumento(2)) } sino { orden_init(0) }
            } sino {
            si (str_igual(orden, "add")) {
                si (rt_argc() < 3) { rt_panico("uso: cforge add usuario/repo[@ref] [--como alias]") }
                sea alias = 0
                si (rt_argc() > 4 y (str_igual(rt_argumento(3), "--como") o str_igual(rt_argumento(3), "--as"))) { alias = rt_argumento(4) }
                orden_add(rt_argumento(2), alias)
            } sino {
            si (str_igual(orden, "remove") o str_igual(orden, "rm")) {
                si (rt_argc() < 3) { rt_panico("uso: cforge remove alias") }
                orden_remove(rt_argumento(2))
            } sino {
            si (str_igual(orden, "install")) {
                orden_install()
            } sino {
            si (str_igual(orden, "repl")) {
                orden_repl()
            } sino {
            si (str_igual(orden, "fmt")) {
                orden_fmt(2)
            } sino {
            si (str_igual(orden, "lsp")) {
                orden_lsp()
            } sino {
            si (str_igual(orden, "xcode-init")) {
                si (rt_argc() > 2) { orden_xcode_init(rt_argumento(2)) } sino { orden_xcode_init(0) }
            } sino {
            si (str_igual(orden, "bindgen")) {
                // cforge bindgen cabecera.h [--lib nombre] [-o modulo.cfv]
                si (rt_argc() < 3) { rt_panico("uso: cforge bindgen cabecera.h [--lib nombre] [-o modulo.cfv]") }
                orden_bindgen(rt_argumento(2))
            } sino {
            si (str_igual(orden, "doc")) {
                // cforge doc archivo.cfv|carpeta [-o salida.md|salida.html]
                si (rt_argc() < 3) { rt_panico("uso: cforge doc archivo.cfv|carpeta [-o salida.md|salida.html]") }
                sea salida = 0
                si (rt_argc() > 4 y str_igual(rt_argumento(3), "-o")) { salida = rt_argumento(4) }
                orden_doc(rt_argumento(2), salida)
            } sino {
            si (str_igual(orden, "test")) {
                // cforge test archivo.cfv [--coverage]: ejecuta las pruebas
                // (código 0 = aprobadas) y, con --coverage, informa qué
                // líneas del archivo se ejecutaron.
                si (tiene_argumento("--coverage") o tiene_argumento("--cobertura")) {
                    ejecutar_con_cobertura(requerir_archivo(2))
                } sino {
                    ejecutar(requerir_archivo(2), 3)
                }
            } sino {
            si (str_igual(orden, "run")) {
                ejecutar(requerir_archivo(2), 3)
            } sino {
                si (str_igual(orden, "build")) {
                    // cforge build archivo.cfv [-o salida] [--target linux|windows]
                    sea salida = 0
                    sea k = 2
                    mientras (k < rt_argc()) {
                        si (str_igual(rt_argumento(k), "-o") y k + 1 < rt_argc()) {
                            salida = rt_argumento(k + 1)
                            k = k + 1
                        }
                        si (str_igual(rt_argumento(k), "--lib")) { mem_fijar_global(40, 1) }
                        // --release: sin el código que el programa no usa (global 19).
                        si (str_igual(rt_argumento(k), "--release")) { mem_fijar_global(19, 1) }
                        si (str_igual(rt_argumento(k), "--target") y k + 1 < rt_argc()) {
                            fijar_destino(rt_argumento(k + 1))
                            k = k + 1
                        }
                        k = k + 1
                    }
                    construir(requerir_archivo(2), salida)
                } sino {
                    si (str_igual(orden, "check")) {
                        // cforge check archivo [--contenido texto.cfv] [--diagnosticos salida]
                        sea revisado = requerir_archivo(2)
                        sea q = 3
                        mientras (q + 1 < rt_argc()) {
                            si (str_igual(rt_argumento(q), "--contenido")) { mem_fijar_global(38, rt_argumento(q + 1)) }
                            si (str_igual(rt_argumento(q), "--diagnosticos")) {
                                mem_fijar_global(37, rt_argumento(q + 1))
                                mem_fijar_global(39, 1)
                            }
                            q = q + 1
                        }
                        sea silencioso = 0
                        q = 3
                        mientras (q < rt_argc()) {
                            si (str_igual(rt_argumento(q), "--silencioso")) { silencioso = 1 }
                            q = q + 1
                        }
                        compilar_archivo(revisado)
                        si (silencioso == 0) { mostrar(str_concatenar("✓ sin errores: ", revisado)) }
                    } sino {
                        si (termina_en(orden, ".cfv") o existe_ruta(orden)) {
                            ejecutar(orden, 2)
                        } sino {
                            rt_panico(str_concatenar("orden desconocida: ", str_concatenar(orden, " (usa cforge --help)")))
                        }
                    }
                }
            }
            }
            }
            }
            }
            }
            }
            }
            }
            }
            }
            }
            }
        }
    }
}
