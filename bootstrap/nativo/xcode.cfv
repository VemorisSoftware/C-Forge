// bootstrap/nativo/xcode.cfv — cforge xcode-init: integra C-Forge en un
// proyecto de Xcode (SwiftUI / UIKit / AppKit).
//
//   cforge xcode-init [Proyecto.xcodeproj]
//
// · Agrega a cada target una regla de compilación (PBXBuildRule) para
//   *.cfv: al compilar (Cmd + B / Cmd + R) ejecuta
//   "cforge build archivo.cfv --lib" para la plataforma activa (iphoneos →
//   ios-arm64, iphonesimulator → ios-sim-arm64, macosx → macos-arm64) y
//   Xcode enlaza el objeto resultante.
// · Crea CForge/ con las cabeceras C de las funciones #[Exportar] y
//   CForge-Bridging-Header.h, y configura SWIFT_OBJC_BRIDGING_HEADER y
//   HEADER_SEARCH_PATHS (si el proyecto no los tiene ya).
// · Escribe CForge/CForge.xclangspec (resaltado de sintaxis para Xcode).

funcion script_regla_xcode() {
    sea s = str_nuevo(1024)
    str_agregar(s, "export PATH=\\\"$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.cforge/bin\\\"\\n")
    str_agregar(s, "case \\\"$PLATFORM_NAME\\\" in\\n  iphoneos) DESTINO=ios-arm64 ;;\\n  iphonesimulator) DESTINO=ios-sim-arm64 ;;\\n  *) DESTINO=macos-arm64 ;;\\nesac\\n")
    str_agregar(s, "if [ \\\"$CURRENT_ARCH\\\" != arm64 ]; then echo \\\"error: C-Forge compila para arm64 (ajusta ARCHS o ONLY_ACTIVE_ARCH)\\\"; exit 1; fi\\n")
    str_agregar(s, "cforge build \\\"$INPUT_FILE_PATH\\\" --lib --target \\\"$DESTINO\\\" -o \\\"$DERIVED_FILE_DIR/$INPUT_FILE_BASE.o\\\"\\n")
    str_agregar(s, "mkdir -p \\\"$SRCROOT/CForge\\\" && cp \\\"$DERIVED_FILE_DIR/$INPUT_FILE_BASE.h\\\" \\\"$SRCROOT/CForge/\\\"\\n")
    retornar s
}

funcion regla_xcode(id) {
    sea r = str_nuevo(1024)
    str_agregar(r, "\\t\\t")
    str_agregar(r, id)
    str_agregar(r, " /* PBXBuildRule (C-Forge) */ = {\\n")
    str_agregar(r, "\\t\\t\\tisa = PBXBuildRule;\\n")
    str_agregar(r, "\\t\\t\\tcompilerSpec = com.apple.compilers.proxy.script;\\n")
    str_agregar(r, "\\t\\t\\tfilePatterns = \"*.cfv\";\\n")
    str_agregar(r, "\\t\\t\\tfileType = pattern.proxy;\\n")
    str_agregar(r, "\\t\\t\\tinputFiles = (\\n\\t\\t\\t);\\n")
    str_agregar(r, "\\t\\t\\tisEditable = 1;\\n")
    str_agregar(r, "\\t\\t\\tname = \"C-Forge (.cfv)\";\\n")
    str_agregar(r, "\\t\\t\\toutputFiles = (\\n\\t\\t\\t\\t\"$(DERIVED_FILE_DIR)/$(INPUT_FILE_BASE).o\",\\n\\t\\t\\t);\\n")
    str_agregar(r, "\\t\\t\\tscript = \"")
    str_agregar(r, script_regla_xcode())
    str_agregar(r, "\";\\n\\t\\t};\\n")
    retornar sin_escapes_xcode(r)
}

// Las funciones de este archivo escriben \\t y \\n literales (para que el
// texto del script quede escapado dentro del pbxproj); aquí se convierten
// los de la estructura (fuera de script = "...") en tabuladores y saltos.
funcion sin_escapes_xcode(s) {
    sea r = str_nuevo(str_largo(s))
    sea en_script = 0
    sea i = 0
    mientras (i < str_largo(s)) {
        si (en_script == 0 y i + 9 <= str_largo(s) y str_igual(str_rebanar(s, i, i + 9), "script = ")) { en_script = 1 }
        si (en_script == 1 y i + 3 <= str_largo(s) y str_igual(str_rebanar(s, i, i + 3), "\";\\")) { en_script = 2 }
        si (en_script != 1 y str_byte(s, i) == 92 y i + 1 < str_largo(s) y (str_byte(s, i + 1) == 116 o str_byte(s, i + 1) == 110)) {
            si (str_byte(s, i + 1) == 116) { str_agregar_byte(r, 9) } sino { str_agregar_byte(r, 10) }
            i = i + 2
        } sino {
            str_agregar_byte(r, str_byte(s, i))
            i = i + 1
        }
    }
    retornar r
}

// Inserta texto después de la primera aparición de marca desde la posición.
funcion insertar_tras(s, marca, desde, texto) {
    sea p = buscar_desde(s, marca, desde)
    si (p < 0) { retornar s }
    sea fin = p + str_largo(marca)
    sea r = str_rebanar(s, 0, fin)
    str_agregar(r, texto)
    str_agregar(r, str_rebanar(s, fin, str_largo(s)))
    retornar r
}

funcion buscar_desde(s, aguja, desde) {
    sea i = desde
    mientras (i + str_largo(aguja) <= str_largo(s)) {
        si (str_byte(s, i) == str_byte(aguja, 0) y str_igual(str_rebanar(s, i, i + str_largo(aguja)), aguja)) { retornar i }
        i = i + 1
    }
    retornar 0 - 1
}

// Agrega la regla a cada PBXNativeTarget y los ajustes de cabeceras.
funcion parchear_pbxproj(texto, id) {
    si (buscar_desde(texto, "PBXBuildRule (C-Forge)", 0) >= 0) { retornar 0 }
    sea t = insertar_tras(texto, "objects = {\n", 0, str_concatenar("\n/* Begin PBXBuildRule section (C-Forge) */\n", str_concatenar(regla_xcode(id), "/* End PBXBuildRule section (C-Forge) */\n")))
    sea referencia = str_concatenar(str_concatenar("\n\t\t\t\t", id), " /* PBXBuildRule (C-Forge) */,")
    sea desde = 0
    sea seguir = 1
    mientras (seguir) {
        sea p = buscar_desde(t, "isa = PBXNativeTarget;", desde)
        si (p < 0) { seguir = 0 } sino {
            sea q = buscar_desde(t, "buildRules = (", p)
            si (q < 0) { seguir = 0 } sino {
                t = insertar_tras(t, "buildRules = (", q, referencia)
                desde = q + 20
            }
        }
    }
    // Ajustes de cada configuración (sin pisar los existentes).
    desde = 0
    seguir = 1
    mientras (seguir) {
        sea p = buscar_desde(t, "buildSettings = {", desde)
        si (p < 0) { seguir = 0 } sino {
            sea fin = buscar_desde(t, "};", p)
            sea bloque = str_rebanar(t, p, fin)
            sea extra = str_nuevo(256)
            si (buscar_desde(bloque, "SWIFT_OBJC_BRIDGING_HEADER", 0) < 0) { str_agregar(extra, "\n\t\t\t\tSWIFT_OBJC_BRIDGING_HEADER = \"CForge/CForge-Bridging-Header.h\";") }
            si (buscar_desde(bloque, "HEADER_SEARCH_PATHS", 0) < 0) { str_agregar(extra, "\n\t\t\t\tHEADER_SEARCH_PATHS = (\n\t\t\t\t\t\"$(inherited)\",\n\t\t\t\t\t\"$(SRCROOT)/CForge\",\n\t\t\t\t);") }
            t = insertar_tras(t, "buildSettings = {", p, extra)
            desde = p + 17 + str_largo(extra)
        }
    }
    retornar t
}

funcion xclangspec() {
    sea s = str_nuevo(4096)
    str_agregar(s, "// CForge.xclangspec — resaltado de sintaxis de C-Forge (.cfv) para Xcode.\n")
    str_agregar(s, "// Generado por cforge xcode-init. Copia a ~/Library/Developer/Xcode/Specifications/\n(\n")
    str_agregar(s, "    {\n        Identifier = \"xcode.lang.cforge.identifier\";\n        Syntax = {\n            StartChars = \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_\";\n            Chars = \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_\";\n            Words = (\n")
    sea claves = palabras_clave()
    sea i = 0
    mientras (i < vec_largo(claves)) {
        str_agregar(s, "                \"")
        str_agregar(s, vec_obtener(claves, i))
        str_agregar(s, "\",\n")
        i = i + 1
    }
    str_agregar(s, "            );\n            Type = \"xcode.syntax.keyword\";\n            AltType = \"xcode.syntax.identifier\";\n        };\n    },\n")
    str_agregar(s, "    {\n        Identifier = \"xcode.lang.cforge\";\n        Description = \"C-Forge\";\n        BasedOn = \"xcode.lang.simpleColoring\";\n        IncludeInMenu = YES;\n        Name = \"C-Forge\";\n        Syntax = {\n            Tokenizer = \"xcode.lang.cforge.lexer\";\n            IncludeRules = ( );\n            Type = \"xcode.syntax.plain\";\n        };\n    },\n")
    str_agregar(s, "    {\n        Identifier = \"xcode.lang.cforge.lexer\";\n        Syntax = {\n            IncludeRules = (\n                \"xcode.lang.comment.singleline\",\n                \"xcode.lang.string\",\n                \"xcode.lang.cforge.identifier\",\n                \"xcode.lang.number\",\n            );\n        };\n    },\n)\n")
    retornar s
}

funcion buscar_xcodeproj(dir) {
    sea nombres = sys_listar(dir)
    si (nombres == 0) { retornar 0 }
    sea i = 0
    mientras (i < vec_largo(nombres)) {
        si (termina_en(vec_obtener(nombres, i), ".xcodeproj")) { retornar unir_ruta(dir, vec_obtener(nombres, i)) }
        i = i + 1
    }
    retornar 0
}

funcion contiene_exportar(ruta) {
    retornar buscar_desde(archivo_leer(ruta), "#[Exportar]", 0) >= 0 o buscar_desde(archivo_leer(ruta), "#[export]", 0) >= 0
}

funcion orden_xcode_init(argumento) {
    sea proyecto = argumento
    si (proyecto == 0) { proyecto = buscar_xcodeproj(".") }
    si (proyecto == 0) { rt_panico("no hay un .xcodeproj aquí (cforge xcode-init Proyecto.xcodeproj)") }
    sea pbx = unir_ruta(proyecto, "project.pbxproj")
    si (existe_ruta(pbx) == 0) { rt_panico(str_concatenar("no existe ", pbx)) }
    sea raiz = directorio_de(proyecto)
    sea nuevo = parchear_pbxproj(archivo_leer(pbx), "CF0FC0DE00000000C0F0E001")
    si (nuevo == 0) {
        mostrar("✓ el proyecto ya tenía la regla de C-Forge")
    } sino {
        archivo_escribir(pbx, nuevo)
        mostrar(str_concatenar("✓ regla de compilación *.cfv agregada a ", pbx))
    }
    // CForge/: cabeceras de los .cfv con #[Exportar] y cabecera puente.
    sea dir = unir_ruta(raiz, "CForge")
    crear_directorios(dir)
    sea archivos = vec_nuevo()
    archivos_cfv(raiz, archivos)
    sea puente = str_nuevo(512)
    str_agregar(puente, "// CForge-Bridging-Header.h — generado por cforge xcode-init.\n// Funciones de C-Forge (#[Exportar]) visibles desde Swift.\n")
    sea i = 0
    mientras (i < vec_largo(archivos)) {
        sea a = vec_obtener(archivos, i)
        si (contiene_exportar(a)) {
            sea base = nombre_de(a)
            base = str_rebanar(base, 0, str_largo(base) - 4)
            mem_fijar_global(33, 3)
            mem_fijar_global(40, 2)
            construir_biblioteca(a, unir_ruta(dir, str_concatenar(base, ".o")))
            sys_borrar(str_c(unir_ruta(dir, str_concatenar(base, ".o"))))
            str_agregar(puente, "#include \"")
            str_agregar(puente, base)
            str_agregar(puente, ".h\"\n")
        }
        i = i + 1
    }
    archivo_escribir(unir_ruta(dir, "CForge-Bridging-Header.h"), puente)
    archivo_escribir(unir_ruta(dir, "CForge.xclangspec"), xclangspec())
    mostrar(str_concatenar("✓ ", unir_ruta(dir, "CForge-Bridging-Header.h")))
    mostrar("")
    mostrar("Agrega tus .cfv al target (fase Compile Sources) y presiona Cmd + R.")
    mostrar("Resaltado de sintaxis en Xcode (no oficial para lenguajes de terceros):")
    mostrar("  mkdir -p ~/Library/Developer/Xcode/Specifications")
    mostrar(str_concatenar(str_concatenar("  cp ", unir_ruta(dir, "CForge.xclangspec")), " ~/Library/Developer/Xcode/Specifications/"))
    retornar 0
}
