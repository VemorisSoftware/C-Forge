// bootstrap/nativo/lexer.cfv — lexer de C-Forge en el dialecto nativo.
// Mismas reglas que bootstrap/core_lexer.cfv (verificado en make nativo-check).
// Token: [tipo][lexema][línea]. Tipos: 1 IDENT, 2 NUMBER, 3 STRING, 4 SYMBOL, 5 EOF.

funcion es_espacio(c) { retornar c == 32 o c == 9 o c == 13 }
funcion es_digito(c) { retornar c >= 48 y c <= 57 }
funcion es_letra(c) { retornar (c >= 97 y c <= 122) o (c >= 65 y c <= 90) o c == 95 }
funcion es_identificador(c) { retornar es_letra(c) o es_digito(c) }

funcion token_nuevo(tipo, lexema, linea) {
    sea t = mem_reservar(24)
    __guardar64(t, tipo)
    __guardar64(t + 8, lexema)
    __guardar64(t + 16, linea)
    retornar t
}

funcion nombre_tipo(tipo) {
    si (tipo == 1) { retornar "IDENT" }
    si (tipo == 2) { retornar "NUMBER" }
    si (tipo == 3) { retornar "STRING" }
    si (tipo == 4) { retornar "SYMBOL" }
    retornar "EOF"
}

funcion tokenizar(fuente) {
    sea tokens = vec_nuevo()
    sea n = str_largo(fuente)
    sea pos = 0
    sea linea = 1
    mientras (pos < n) {
        sea c = str_byte(fuente, pos)
        si (c == 10) {
            linea = linea + 1
            pos = pos + 1
        } sino {
            si (es_espacio(c)) {
                pos = pos + 1
            } sino {
                si (c == 47 y pos + 1 < n y str_byte(fuente, pos + 1) == 47) {
                    mientras (pos < n y str_byte(fuente, pos) != 10) { pos = pos + 1 }
                } sino {
                    si (es_letra(c)) {
                        sea inicio = pos
                        mientras (pos < n y es_identificador(str_byte(fuente, pos))) { pos = pos + 1 }
                        vec_agregar(tokens, token_nuevo(1, str_rebanar(fuente, inicio, pos), linea))
                    } sino {
                        si (es_digito(c)) {
                            sea inicio = pos
                            mientras (pos < n y es_digito(str_byte(fuente, pos))) { pos = pos + 1 }
                            // Exponente: 1e5, 2E-3, 4e+2 (solo si sigue un dígito).
                            si (pos + 1 < n y (str_byte(fuente, pos) == 101 o str_byte(fuente, pos) == 69)) {
                                sea k = pos + 1
                                si (str_byte(fuente, k) == 43 o str_byte(fuente, k) == 45) { k = k + 1 }
                                si (k < n y es_digito(str_byte(fuente, k))) {
                                    pos = k
                                    mientras (pos < n y es_digito(str_byte(fuente, pos))) { pos = pos + 1 }
                                }
                            }
                            vec_agregar(tokens, token_nuevo(2, str_rebanar(fuente, inicio, pos), linea))
                        } sino {
                            si (c == 34) {
                                sea linea_texto = linea
                                sea inicio = pos
                                pos = pos + 1
                                sea cerrado = 0
                                mientras (pos < n y cerrado == 0) {
                                    sea parte = str_byte(fuente, pos)
                                    pos = pos + 1
                                    si (parte == 92 y pos < n) {
                                        pos = pos + 1
                                    } sino {
                                        si (parte == 34) {
                                            cerrado = 1
                                        } sino {
                                            si (parte == 10) { linea = linea + 1 }
                                        }
                                    }
                                }
                                si (cerrado == 0) { rt_panico("texto sin cerrar") }
                                vec_agregar(tokens, token_nuevo(3, str_rebanar(fuente, inicio, pos), linea_texto))
                            } sino {
                                sea inicio = pos
                                pos = pos + 1
                                si (pos < n) {
                                    sea d = str_byte(fuente, pos)
                                    si (d == 61 y (c == 61 o c == 33 o c == 62 o c == 60)) { pos = pos + 1 }
                                }
                                vec_agregar(tokens, token_nuevo(4, str_rebanar(fuente, inicio, pos), linea))
                            }
                        }
                    }
                }
            }
        }
    }
    vec_agregar(tokens, token_nuevo(5, str_nuevo(0), linea))
    retornar tokens
}
