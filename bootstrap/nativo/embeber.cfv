// bootstrap/nativo/embeber.cfv — incrusta el runtime en el cforge oficial.
//
// Uso: embeber salida.cfv VERSION [--nativo|--puente|--lenguaje|--opcional|--recurso] archivos...
// Los --recurso (p. ej. el cargador JavaScript de WebAssembly) no son código
// del lenguaje: el CLI los usa tal cual.
// Los módulos --opcional (p. ej. runtime/sdl.cfv) se agregan solo si el
// programa usa sus funciones (prefijo del nombre del archivo + "_").
// Genera funciones con el texto de cada archivo, su nombre y su modo, para
// que cforge compile programas sin depender de archivos externos.

funcion escapar(r, s) {
    sea i = 0
    mientras (i < str_largo(s)) {
        sea b = str_byte(s, i)
        si (b == 92) { str_agregar(r, "\\\\") } sino {
            si (b == 34) { str_agregar(r, "\\\"") } sino {
                si (b == 10) { str_agregar(r, "\\n") } sino {
                    si (b == 13) { str_agregar(r, "\\r") } sino { str_agregar_byte(r, b) }
                }
            }
        }
        i = i + 1
    }
    retornar 0
}

si (rt_argc() < 4) { rt_panico("uso: embeber salida.cfv VERSION [--nativo|--puente|--lenguaje] archivos...") }
sea salida = rt_argumento(1)
sea r = str_nuevo(262144)
str_agregar(r, "// Generado por bootstrap/nativo/embeber.cfv (make embebido). No editar.\n\n")
str_agregar(r, "funcion version_cforge() { retornar \"")
str_agregar(r, rt_argumento(2))
str_agregar(r, "\" }\n\n")
sea nombres = vec_nuevo()
sea modos = vec_nuevo()
sea modo = 0
sea i = 3
mientras (i < rt_argc()) {
    sea a = rt_argumento(i)
    si (str_igual(a, "--nativo")) { modo = 0 } sino {
        si (str_igual(a, "--puente")) { modo = 1 } sino {
            si (str_igual(a, "--lenguaje")) { modo = 3 } sino {
                si (str_igual(a, "--opcional")) { modo = 4 } sino {
                si (str_igual(a, "--recurso")) { modo = 5 } sino {
                    vec_agregar(nombres, a)
                    vec_agregar(modos, modo)
                }
                }
            }
        }
    }
    i = i + 1
}
str_agregar(r, "funcion runtime_cantidad() { retornar ")
str_agregar(r, str_desde_entero(vec_largo(nombres)))
str_agregar(r, " }\n\nfuncion runtime_modo(i) {\n")
i = 0
mientras (i < vec_largo(nombres)) {
    str_agregar(r, "    si (i == ")
    str_agregar(r, str_desde_entero(i))
    str_agregar(r, ") { retornar ")
    str_agregar(r, str_desde_entero(vec_obtener(modos, i)))
    str_agregar(r, " }\n")
    i = i + 1
}
str_agregar(r, "    retornar 0\n}\n\nfuncion runtime_nombre(i) {\n")
i = 0
mientras (i < vec_largo(nombres)) {
    str_agregar(r, "    si (i == ")
    str_agregar(r, str_desde_entero(i))
    str_agregar(r, ") { retornar \"")
    escapar(r, vec_obtener(nombres, i))
    str_agregar(r, "\" }\n")
    i = i + 1
}
str_agregar(r, "    retornar \"\"\n}\n\nfuncion runtime_fuente(i) {\n")
i = 0
mientras (i < vec_largo(nombres)) {
    str_agregar(r, "    si (i == ")
    str_agregar(r, str_desde_entero(i))
    str_agregar(r, ") { retornar \"")
    escapar(r, archivo_leer(vec_obtener(nombres, i)))
    str_agregar(r, "\" }\n")
    i = i + 1
}
str_agregar(r, "    retornar \"\"\n}\n")
archivo_escribir(salida, r)
mostrar(str_concatenar("embebido: ", salida))
