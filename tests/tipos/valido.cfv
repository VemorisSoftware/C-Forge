// Programa con tipos anotados e inferidos que el verificador acepta.
funcion area(ancho: numero, alto: numero): numero { retornar ancho * alto }
funcion saludo(nombre: texto): texto { retornar "hola " + nombre }
funcion primeros(l: lista, n: entero): lista {
    sea r: lista = []
    sea i: entero = 0
    mientras (i < n y i < longitud(l)) {
        r.agregar(l[i])
        i += 1
    }
    retornar r
}
sea total = area(2, 3.5)
sea x = 5
x = "ahora texto"
sea opcional: texto = nulo
sea m = {"a": 1}
afirmar(total == 7, "área")
afirmar(saludo("Ana") == "hola Ana", "saludo")
afirmar(primeros([1, 2, 3], 2) == [1, 2] o longitud(primeros([1, 2, 3], 2)) == 2, "primeros")
afirmar(m["a"] - 1 == 0, "mapa")
afirmar(x + "!" == "ahora texto!", "variable reasignada sin anotación")
mostrar("[OK] tipos")
