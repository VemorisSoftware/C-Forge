/// Signo de x como texto.
funcion signo(x) {
    si (x > 0) {
        retornar "positivo"
    }
    si (x < 0) {
        retornar "negativo"
    }
    retornar "cero"
}
funcion _privada() { retornar 1 }
/// Espera y devuelve el doble.
async funcion doble(x) { retornar x * 2 }
afirmar(signo(5) == "positivo", "pos")
afirmar(signo(0) == "cero", "cero")
mostrar("[OK]")
