// Paquetes npm desde C-Forge (WebAssembly).
extern "npm:lodash" funcion kebabCase(t: texto): texto
extern "npm:lodash" funcion capitalize(t: texto): texto
extern "npm:camelcase" funcion camel(t: texto): texto como "default"
mostrar(kebabCase("Hola Mundo desde CForge"))
mostrar(capitalize("vemoris"))
mostrar(camel("foo-bar_baz"))
