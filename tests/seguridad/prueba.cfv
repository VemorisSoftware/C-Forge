// tests/seguridad — entradas hostiles: imágenes con cabeceras falsas,
// bombas de compresión, JPEG con bandas inválidas, fuentes dañadas,
// lecturas fuera de rango y borrado de secretos. Todo debe terminar en un
// error capturable, nunca en una caída.
importar "imagen"
importar "fuente"

funcion falla(que, f) {
    intentar {
        f()
        mostrar(que + ": NO falló")
    } capturar (e) { mostrar(que + ": " + e) }
}

funcion be32(n) { retornar bytes_entero(n, 4, 0) }
funcion bloque(tipo, datos) { retornar be32(longitud(datos)) + tipo + datos + be32(crc32(tipo + datos)) }
funcion png(ancho, alto, idat) {
    sea firma = char_de(137) + "PNG" + char_de(13) + char_de(10) + char_de(26) + char_de(10)
    sea ihdr = be32(ancho) + be32(alto) + char_de(8) + char_de(6) + char_de(0) + char_de(0) + char_de(0)
    retornar firma + bloque("IHDR", ihdr) + bloque("IDAT", idat) + bloque("IEND", "")
}

// PNG 1×1 cuyo IDAT se expande a 1 MB: se corta al tamaño esperado.
falla("png bomba", funcion() { png_decodificar(png(1, 1, zlib_comprimir(texto_repetir(char_de(0), 1000000), 9))) })
falla("png 65535×65535", funcion() { png_decodificar(png(65535, 65535, zlib_comprimir("x", 6))) })
falla("png 0×5", funcion() { png_decodificar(png(0, 5, zlib_comprimir("x", 6))) })
mostrar("png válido: " + png_decodificar(png(1, 1, zlib_comprimir(char_de(0) + char_de(1) + char_de(2) + char_de(3) + char_de(4), 6)))[0])

// zlib con límite propio y por defecto.
sea z = zlib_comprimir(texto_repetir("a", 100000), 9)
falla("zlib con límite 1000", funcion() { zlib_descomprimir(z, 1000) })
mostrar("zlib con límite suficiente: " + longitud(zlib_descomprimir(z, 100000)))
falla("límite negativo", funcion() { zlib_descomprimir(z, 0 - 5) })

// JPEG con SOF gigante y progresivo con Se = 200.
sea sof = char_de(255) + char_de(216) + char_de(255) + char_de(192) + char_de(0) + char_de(17) + char_de(8) + char_de(255) + char_de(255) + char_de(255) + char_de(255) + char_de(3) + char_de(1) + char_de(34) + char_de(0) + char_de(2) + char_de(17) + char_de(1) + char_de(3) + char_de(17) + char_de(1) + char_de(255) + char_de(217)
falla("jpeg 65535×65535", funcion() { jpeg_decodificar(sof) })
sea prog = leer_archivo("../graficos/datos/jprog.jpg")
sea p = bytes_buscar(prog, char_de(255) + char_de(218), 0)
sea ns = byte_en(prog, p + 4)
sea malo = subtexto(prog, 0, p + 6 + 2 * ns) + char_de(200) + subtexto(prog, p + 7 + 2 * ns, longitud(prog))
falla("jpeg Se = 200", funcion() { jpeg_decodificar(malo) })

// BMP con dimensiones de 31 bits.
sea bmp = "BM" + texto_repetir(char_de(0), 8) + bytes_entero(54, 4, 1) + bytes_entero(40, 4, 1) + bytes_entero(2147483647, 4, 1) + bytes_entero(2147483647, 4, 1) + bytes_entero(1, 2, 1) + bytes_entero(24, 2, 1) + texto_repetir(char_de(0), 24)
falla("bmp gigante", funcion() { bmp_decodificar(bmp) })

// Fuente con el directorio de tablas apuntando fuera del archivo.
sea ttf = leer_archivo("../graficos/datos/DejaVuSans-latin.ttf")
falla("ttf tabla fuera", funcion() { fuente_desde_bytes(subtexto(ttf, 0, 12) + subtexto(ttf, 12, 20) + bytes_entero(99999999, 4, 0) + subtexto(ttf, 24, longitud(ttf))) })
falla("ttf truncada", funcion() { lienzo_texto(lienzo_crear(10, 10), fuente_desde_bytes(subtexto(ttf, 0, 2000)), "A", 0, 0, 10, [0, 0, 0]) })

// Lecturas fuera de rango: errores capturables, no pánicos.
falla("byte_en fuera", funcion() { byte_en("abc", 7) })
falla("byte_en negativo", funcion() { byte_en("abc", 0 - 1) })

// Búferes de píxeles con aritmética saturada: el producto que desborda se
// rechaza antes de multiplicar (nunca un búfer chico).
falla("zbuffer desbordado", funcion() { lienzo_zbuffer(3037000500, 3037000500) })
falla("lienzo desbordado", funcion() { lienzo_nuevo_buffer(4294967296, 4294967297) })
falla("lienzo negativo", funcion() { lienzo_nuevo_buffer(0 - 1, 10) })
falla("pcm enorme", funcion() { pcm_silencio(9007199254740991) })

// Secretos: se borran en el montículo; los literales no se tocan.
sea clave = bytes_aleatorios(32)
mostrar("borrar clave: " + borrar_texto(clave) + " " + (clave == texto_repetir(char_de(0), 32)))
mostrar("borrar literal: " + borrar_texto("literal"))
mostrar("[OK] entradas hostiles rechazadas sin caídas")
