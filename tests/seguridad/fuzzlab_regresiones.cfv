// tests/seguridad — regresiones del Fuzz Lab (reporte del commit 415b896).
// Cada caso debe terminar rápido y con un error capturable o un resultado,
// nunca colgarse ni cerrar el proceso.
importar "xml"
importar "markdown"

funcion falla(que, f) {
    intentar {
        f()
        mostrar(que + ": NO falló")
    } capturar (e) { mostrar(que + ": " + e) }
}

// Bug 1: "<![" sin "CDATA[" (y cualquier <! desconocido) colgaba el analizador.
falla("xml <![#CDATA[", funcion() { xml_analizar("<a><![#CDATA[x]]></a>") })
falla("xml <!x>", funcion() { xml_analizar("<a><!x></a>") })
mostrar("xml CDATA válido: " + xml_analizar("<a><![CDATA[ok]]></a>")["hijos"][0])

// Bug 2: Markdown cuadrático. Con 100.000 caracteres antes tardaba horas;
// ahora es lineal (si vuelve a ser cuadrático, esta prueba no termina).
sea entradas = [
    texto_repetir(">", 100000) + " x",
    texto_repetir("[", 100000) + " x",
    texto_repetir("](", 50000) + " x",
    texto_repetir("[](", 30000) + ")",
    texto_repetir("`", 100000),
    texto_repetir("**", 50000) + "x"
]
sea total = 0
para e en entradas { total = total + longitud(markdown_html(e)) }
mostrar("markdown hostil procesado: " + (total > 0))
mostrar("markdown normal: " + markdown_html("**hola** [c](http://x.com/(b))"))

// Bug 3: recursión profunda → error capturable (antes SIGSEGV).
funcion rec(n) {
    si (n <= 0) { retornar 0 }
    retornar 1 + rec(n - 1)
}
falla("recursión infinita", funcion() { rec(100000000) })
mostrar("recursión de 20000: " + rec(20000))
sea t = tarea(funcion() {
    sea r = "no"
    intentar { rec(100000000) } capturar (e) { r = e }
    retornar r
})
mostrar("en un hilo: " + aguardar(t))
mostrar("[OK] regresiones del Fuzz Lab")
