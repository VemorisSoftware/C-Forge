// tests/sql — PostgreSQL y MySQL/MariaDB con los clientes nativos.
// Uso: cforge tests/sql/prueba.cfv <puerto_pg> <puerto_mysql>
// (usuario cforge, clave "secreto"; bases "postgres" y "prueba").
importar "postgres"
importar "mysql"

sea args = argumentos()

// ── PostgreSQL (SCRAM-SHA-256, protocolo extendido) ──
sea pg = pg_conectar({"host": "127.0.0.1", "puerto": a_numero(args[0]), "usuario": "cforge", "clave": "secreto", "base": "postgres"})
pg_consultar(pg, "DROP TABLE IF EXISTS productos")
pg_consultar(pg, "CREATE TABLE productos (id serial PRIMARY KEY, nombre text NOT NULL, precio numeric(8,2), activo boolean, nota text)")
mostrar("pg insertadas: " + pg_ejecutar(pg, "INSERT INTO productos (nombre, precio, activo, nota) VALUES ($1, $2, $3, $4), ($5, $6, $7, $8)", ["té ñandú", 2.5, verdadero, nulo, "café'; DROP TABLE productos; --", 10, falso, "x"]))
sea r = pg_consultar(pg, "SELECT id, nombre, precio, activo, nota FROM productos WHERE precio > $1 ORDER BY id", [1])
mostrar("pg columnas: " + r["columnas"])
para f in r["filas"] { mostrar("pg fila: " + f) }
mostrar("pg comando: " + r["comando"])
mostrar("pg actualizadas: " + pg_ejecutar(pg, "UPDATE productos SET precio = precio * 2"))
mostrar("pg suma: " + pg_consultar(pg, "SELECT sum(precio) AS s FROM productos")["filas"][0]["s"])
intentar { pg_consultar(pg, "SELECT * FROM no_existe") } capturar (e) { mostrar(e) }
mostrar("pg sigue: " + pg_consultar(pg, "SELECT 40 + 2 AS n")["filas"][0]["n"])
pg_consultar(pg, "DROP TABLE productos")
pg_cerrar(pg)
intentar { pg_conectar({"host": "127.0.0.1", "puerto": a_numero(args[0]), "usuario": "cforge", "clave": "mala", "base": "postgres"}) } capturar (e) { mostrar(e) }

// ── MySQL / MariaDB ──
sea my = mysql_conectar({"host": "127.0.0.1", "puerto": a_numero(args[1]), "usuario": "cforge", "clave": "secreto", "base": "prueba"})
mysql_consultar(my, "DROP TABLE IF EXISTS productos")
mysql_consultar(my, "CREATE TABLE productos (id INT AUTO_INCREMENT PRIMARY KEY, nombre VARCHAR(100) NOT NULL, precio DECIMAL(8,2), activo BOOLEAN, nota TEXT) CHARACTER SET utf8mb4")
mostrar("my insertadas: " + mysql_ejecutar(my, "INSERT INTO productos (nombre, precio, activo, nota) VALUES (?, ?, ?, ?), (?, ?, ?, ?)", ["té ñandú", 2.5, verdadero, nulo, "café'; DROP TABLE productos; -- \\ \"x\"", 10, falso, "¿?"]))
sea m = mysql_consultar(my, "SELECT id, nombre, precio, activo, nota FROM productos WHERE precio > ? ORDER BY id", [1])
mostrar("my columnas: " + m["columnas"])
para f in m["filas"] { mostrar("my fila: " + f) }
mostrar("my último id: " + mysql_consultar(my, "INSERT INTO productos (nombre) VALUES ('z')")["ultimo_id"])
mostrar("my cuenta: " + mysql_consultar(my, "SELECT COUNT(*) AS n FROM productos")["filas"][0]["n"])
intentar { mysql_consultar(my, "SELECT * FROM no_existe") } capturar (e) { mostrar(e) }
mysql_consultar(my, "DROP TABLE productos")
mysql_cerrar(my)
intentar { mysql_conectar({"host": "127.0.0.1", "puerto": a_numero(args[1]), "usuario": "cforge", "clave": "mala"}) } capturar (e) { mostrar("my rechazo: " + (texto_indice(e, "1045") > 0)) }
