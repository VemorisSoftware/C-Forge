// tests/red — red, redis y tls contra servidores locales (servidores.py).
importar "red"
importar "redis"

sea puertos = json_parsear(leer_archivo(argumentos()[0]))
sea base = "http://127.0.0.1:" + puertos["http"]

// HTTP
sea r = http_solicitud("GET", base + "/hola?x=1", {})
mostrar("http estado: " + r["estado"])
mostrar("http cuerpo: " + r["cuerpo"])
mostrar("http cabecera: " + r["cabeceras"]["x-prueba"])
mostrar("redirección: " + http_get("http://localhost:" + puertos["http"] + "/redir"))
mostrar("chunked: " + http_get(base + "/chunked"))
mostrar("grande: " + longitud(http_get(base + "/grande")))
sea p = http_solicitud("POST", base + "/api", {"cuerpo": "dato ñ", "tipo": "text/plain", "cabeceras": {"X-Token": "abc"}})
mostrar("post: " + p["estado"] + " " + p["cuerpo"])

// UDP
sea u = udp_crear(0)
udp_enviar(u, "127.0.0.1", puertos["udp"], "ping")
sea m = nulo
sea intentos = 0
mientras (m == nulo y intentos < 400) {
    m = udp_recibir(u)
    si (m == nulo) { dormir(5) }
    intentos += 1
}
mostrar("udp: " + m["datos"] + " desde " + m["origen"])
udp_cerrar(u)

// Redis (RESP)
sea c = redis_conectar("127.0.0.1", puertos["redis"])
mostrar("redis ping: " + redis_cmd(c, ["PING"]))
redis_set(c, "lenguaje", "C-Forge")
mostrar("redis get: " + redis_cmd(c, ["GET", "lenguaje"]))
mostrar("redis incr: " + redis_cmd(c, ["INCR", "n"]) + " " + redis_cmd(c, ["INCR", "n"]))

// Nombres
mostrar("resolver: " + red_resolver("localhost"))
intentar { http_get("http://127.0.0.1:1/") } capturar (e) { mostrar("sin servidor: " + e) }

// HTTPS: con la CA de prueba (Linux/macOS: SSL_CERT_FILE) responde; sin
// confiar en ella, el certificado se rechaza.
sea url_tls = "https://localhost:" + puertos["https"] + "/seguro"
si (argumentos()[1] == "confiar") {
    mostrar("https: " + http_get(url_tls))
} sino {
    intentar { http_get(url_tls) } capturar (e) { mostrar("https rechazado: " + texto_contiene(a_texto(e), "tls:")) }
}
