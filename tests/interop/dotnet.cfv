importar "dotnet"
dotnet_iniciar()
sea sumar = dotnet_funcion("bin/Calc.dll", "Calc, Calc", "Sumar")
mostrar(dotnet_llamar(sumar, [40, 2]))
mostrar(dotnet_llamar(dotnet_funcion("bin/Calc.dll", "Calc, Calc", "Factorial"), [20]))
mostrar(dotnet_llamar_texto(dotnet_funcion("bin/Calc.dll", "Calc, Calc", "Saludo"), ["Javier"]))
intentar { dotnet_funcion("bin/Calc.dll", "Calc, Calc", "NoExiste") } capturar (e) { mostrar("capturado: " + e) }
