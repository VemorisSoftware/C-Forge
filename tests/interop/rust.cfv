// Crate de Rust (rust/inventario) usado desde C-Forge tras: cforge bindgen rust:rust/inventario
importar "rust:inventario"
sea p = inventario_Producto_new("café", 4.5, 10)
mostrar([inventario_Producto_total(p), inventario_Producto_texto(p), inventario_Producto_nombre(p), inventario_Producto_stock(p)])
mostrar(inventario_Producto_vender(p, 3))
intentar { inventario_Producto_vender(p, 99) } capturar (e) { mostrar("error: " + e) }
sea d = inventario_Producto_con_descuento(p, 10)
mostrar([inventario_Producto_precio(d), inventario_Producto_precio(p)])
sea b = inventario_Bodega_new()
inventario_Bodega_agregar(b, p)
inventario_Bodega_agregar(b, inventario_Producto_new("té", 3, 20))
mostrar([inventario_Bodega_len(b), inventario_Bodega_nombres(b), inventario_Bodega_precios(b), inventario_Bodega_valor_total(b)])
mostrar(inventario_Producto_stock(inventario_Bodega_buscar(b, "té")))
mostrar(inventario_Bodega_buscar(b, "nada"))
mostrar([inventario_suma([1, 2, 3, 40]), inventario_promedio([1, 2, 4]), inventario_promedio([]), inventario_mayusculas(["ñu", "ab"]), inventario_primera_letra("ñandú"), inventario_es_primo(97), inventario_texto_invertir("hola")])
intentar { inventario_dividir(1, 0) } capturar (e) { mostrar("error: " + e) }
mostrar(inventario_dividir(9, 2))
inventario_Producto_liberar(d)
inventario_Bodega_liberar(b)
mostrar("fin")
