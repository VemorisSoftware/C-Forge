// Librería C++ (cpp/geo.hpp) usada desde C-Forge tras: cforge bindgen cpp/geo.hpp --fuentes cpp/geo.cpp
importar "cpp:geo"
sea p = geo_Punto_nuevo_2(3, 4)
sea q = geo_Punto_origen()
mostrar(geo_Punto_distancia(p, q))
geo_Punto_mover(p, 1, 1)
mostrar(geo_Punto_texto(p))
sea s = geo_Punto_sumar(p, p)
mostrar(geo_Punto_x(s))
sea pol = geo_Poligono_nuevo("triángulo")
geo_Poligono_agregar(pol, q)
geo_Poligono_agregar(pol, geo_Punto_nuevo_2(3, 0))
geo_Poligono_agregar(pol, geo_Punto_nuevo_2(3, 4))
mostrar([geo_Poligono_lados(pol), geo_Poligono_perimetro(pol), geo_Poligono_xs(pol), geo_Poligono_nombre(pol)])
mostrar(geo_Punto_y(geo_Poligono_vertice(pol, 2)))
mostrar([geo_area_circulo(1), geo_sumar(2, 3), geo_sumar_2(2, 3), geo_factorial(20), geo_mitad(5), geo_es_par(10)])
mostrar([geo_saludar("Javier"), geo_promedio([1, 2, 3.5]), geo_rango(2, 6), geo_partir("a,b,,c", ","), geo_unir(["x", "y", "z"], "-")])
mostrar(geo_convertir(10, 0, 1))
intentar { geo_raiz_segura(-1) } capturar (e) { mostrar("error: " + e) }
intentar { geo_Poligono_vertice(pol, 9) } capturar (e) { mostrar("error: " + e) }
intentar { geo_promedio([]) } capturar (e) { mostrar("error: " + e) }
geo_Punto_liberar(p)
geo_Poligono_liberar(pol)
mostrar("fin")
