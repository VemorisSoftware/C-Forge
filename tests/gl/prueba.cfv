// tests/gl — OpenGL 3.3 core real: shaders, VBO, profundidad y lectura de
// píxeles (en CI: Mesa llvmpipe sobre Xvfb).
importar "gl"

sea v = gl_ventana("C-Forge gl", 64, 64)
sea gl = gl_iniciar(v)
sea sz = gl3d_tamanio_dibujable(v["id"])
mostrar("dibujable: " + sz["ancho"] + "x" + sz["alto"])

// Fondo y profundidad
gl_limpiar(10, 20, 200)
mostrar("fondo: " + gl3d_leer_pixel(1, 1))

// Triángulo con colores por vértice (MVP identidad)
sea prog = gl_programa_basico()
sea tri = gl_malla_triangulo()
gl_limpiar(0, 0, 0)
gl_dibujar_malla_simple(prog, tri)
sea centro = gl3d_leer_pixel(sz["ancho"] / 2, sz["alto"] / 2)
mostrar("triángulo pinta el centro: " + (centro[0] + centro[1] + centro[2] > 100))
mostrar("esquina sigue negra: " + gl3d_leer_pixel(1, sz["alto"] - 2))

// Cubo rojo con perspectiva y traslación: el centro queda rojo
sea cubo = gl_malla_cubo(1.0, 0.0, 0.0)
sea mvp = mat4_trasladar(mat4_perspectiva(60, 1, 0.1, 100), 0, 0, 0 - 2)
gl_limpiar(0, 0, 0)
gl_dibujar_malla(prog, cubo, mvp)
sea c = gl3d_leer_pixel(sz["ancho"] / 2, sz["alto"] / 2)
mostrar("cubo: rojo=" + (c[0] > 150) + " verde=" + c[1] + " azul=" + c[2])
mostrar("error GL: " + gl3d_error())

// Errores de compilación de shaders con su registro
intentar { gl3d_shader("vertex", "esto no es GLSL") } capturar (e) { mostrar("shader inválido: " + texto_empieza_con(a_texto(e), "gl3d_shader error:")) }

mostrar("matriz: " + redondear(mat4_perspectiva(90, 1, 1, 3)[0], 4))
gl_mostrar(v)
gl_cerrar(gl)

// Modelo iluminado con textura (mallas de modelo.cfv): igual que el render
// por software de graficos.cfv.
importar "graficos"
importar "modelo"
sea v2 = gl_ventana("C-Forge gl 2", 64, 64)
sea gl2 = gl_iniciar(v2)
sea prog2 = gl_programa_iluminado()
sea malla = gl_malla_desde(malla_cubo(1.2))
sea textura = gl_textura(imagen_nueva(2, 2, [0, 255, 0]), falso)
sea cam = camara3d([0, 0, 3], [0, 0, 0], 60)
gl_limpiar(0, 0, 0)
gl_dibujar_modelo(prog2, malla, camara_matriz(cam, 1), m4_identidad(), [255, 255, 255], textura, [0, 0, 0 - 1], 0.2)
sea foto = gl_capturar(gl2)
sea l = lienzo_crear(64, 64)
lienzo_limpiar(l, [0, 0, 0])
lienzo_malla(l, malla_cubo(1.2), m4_identidad(), cam, {"textura": imagen_nueva(2, 2, [0, 255, 0]), "luz": [0, 0, 0 - 1], "ambiente": 0.2})
mostrar("textura en GPU: " + imagen_pixel(foto, 32, 32) + " software: " + imagen_pixel(l, 32, 32))
mostrar("borde negro: " + imagen_pixel(foto, 1, 1) + " error GL: " + gl3d_error())
gl_cerrar(gl2)
