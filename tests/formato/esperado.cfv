// Programa desordenado

funcion sumar(a, b) {
    retornar a+b
}
sea total=sumar(1, 2)
si (total>2) {
    mostrar("total: {total}")
} sino {
    mostrar("poco")
}
sea mensaje = "hola " +
    "mundo"
sea lista = [
    1, 2,
    3
]
sea texto = "varias
   lineas   
intactas"
mientras (total < 5) {   // comentario   alineado
    total = total + 1
}
