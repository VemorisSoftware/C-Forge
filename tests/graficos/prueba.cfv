// tests/graficos — imágenes, compresión, fuentes, render 2D/3D y audio en
// C-Forge puro. La salida es idéntica en Linux, macOS, Windows (x86-64 y
// ARM64): todo el rasterizado y la mezcla usan aritmética entera propia.
// Uso: cforge tests/graficos/prueba.cfv [carpeta donde guardar el render]
importar "json"
importar "graficos"
importar "fuente"
importar "modelo"
importar "audio"

sea dir_datos = "tests/graficos/datos/"
si (existe_archivo(dir_datos + "rgba.png") == falso) { dir_datos = "datos/" }
funcion huella(t) { retornar subtexto(hex_de_bytes(sha256_bytes(t)), 0, 16) }

// ── PNG y BMP: idénticos a libpng/PIL (16 bits con redondeo exacto) ──
sea esperados = json_parsear("{\"rgba.png\": \"8c76f3f34a610c3d07e13c90b074fd035e14bdf756eacc415c77dfabcbad9d2d\", \"rgb.png\": \"e1bcc3eb5a61738f5fdb10473effed854223e1ffcda7305875a7987d86bf1393\", \"gris.png\": \"41b5d132703208ac61da02e66b163041dda6273f4c3e595ca4def594fe3044fb\", \"grisa.png\": \"203a1979d13cd2a24bca69fd8da095d4f9be60fca14ea7f218ba1c74c48780fc\", \"paleta.png\": \"8b0aee9f1634ab38784543dd62bfd630f69d3aab1063ddea62a34b2d23158fce\", \"bits1.png\": \"57382f798642855da33b74e1aa4a43e6f56a3be333d8052cc94d136d1f5cd6dd\", \"pal4.png\": \"ab35864aed3a7c7555f83a459d410ed66d2ec233c75fe2b9790a604e6074071d\", \"paltrns.png\": \"3d0d6242cae1f4d50ce4a147f7e77604a0227b91a739b7e59f2772be1eb6d83f\", \"rgb24.bmp\": \"e1bcc3eb5a61738f5fdb10473effed854223e1ffcda7305875a7987d86bf1393\", \"rgba16_adam7.png\": \"478275601e864285597b619bd66729e3d2b68a32c96447b086050a40da2bfee5\", \"gris2_adam7.png\": \"5a594da640c3a26de3db69f45ef33952a00e3c1d92d4bab0b9b64deea32ef992\"}")
para nombre en ordenar(claves(esperados), funcion(a, b) { si (a < b) { retornar 0 - 1 } retornar 1 }) {
    sea img = imagen_cargar(dir_datos + nombre)
    mostrar(nombre + " " + img["ancho"] + "x" + img["alto"] + " " + (hex_de_bytes(sha256_bytes(img["pixeles"])) == esperados[nombre]))
}

// ── JPEG: comparado con libjpeg (error medio y máximo por canal) ──
para nombre en ["j444", "j420", "jprog", "jgris", "jrst", "jcmyk"] {
    sea a = imagen_cargar(dir_datos + nombre + ".jpg")
    sea b = imagen_cargar(dir_datos + nombre + "_ref.png")
    sea suma = 0
    sea peor = 0
    sea i = 0
    mientras (i < longitud(a["pixeles"])) {
        sea d = absoluto(byte_en(a["pixeles"], i) - byte_en(b["pixeles"], i))
        suma = suma + d
        si (d > peor) { peor = d }
        i = i + 1
    }
    sea medio = suma / longitud(a["pixeles"])
    mostrar(nombre + ".jpg " + a["ancho"] + "x" + a["alto"] + " como libjpeg: " + (medio < 1 y peor <= 8) + " " + huella(a["pixeles"]))
}

// ── zlib, gzip y deflate ──
sea datos = leer_archivo(dir_datos + "datos.bin")
mostrar("zlib de Python: " + (zlib_descomprimir(leer_archivo(dir_datos + "datos.z")) == datos))
mostrar("gzip de Python: " + (gzip_descomprimir(leer_archivo(dir_datos + "datos.gz")) == datos))
para nivel en [0, 1, 6, 9] {
    sea z = zlib_comprimir(datos, nivel)
    mostrar("nivel " + nivel + ": " + longitud(datos) + " → " + longitud(z) + " ida y vuelta " + (zlib_descomprimir(z) == datos))
}
mostrar("gzip ida y vuelta: " + (gzip_descomprimir(gzip_comprimir(datos, 6)) == datos) + " vacío: " + (inflar(deflar("", 6)) == ""))
mostrar("crc32: " + crc32("123456789") + " adler32: " + adler32("Wikipedia"))
sea original = imagen_cargar(dir_datos + "rgba.png")
sea png = imagen_codificar_png(original)
mostrar("png propio: " + (imagen_decodificar(png)["pixeles"] == original["pixeles"]) + " " + longitud(png) + " bytes")
intentar { png_decodificar(subtexto(png, 0, 40)) } capturar (e) { mostrar("png truncado: " + e) }
intentar { jpeg_decodificar("no es jpeg") } capturar (e) { mostrar("jpeg inválido: " + e) }

// ── Fuente TrueType (DejaVu Sans, subconjunto latino) ──
sea f = fuente_cargar(dir_datos + "DejaVuSans-latin.ttf")
mostrar("ttf: " + f["unidades"] + " unidades, " + f["glifos"] + " glifos, glifo de ñ " + fuente_glifo(f, 241))
sea m = texto_medir(f, "Hola, C-Forge", 32)
mostrar("medida: " + redondear(m["ancho"]) + "x" + redondear(m["alto"]))

// ── Escena 2D + 3D ──
sea l = lienzo_crear(256, 192)
lienzo_limpiar(l, [18, 22, 38])
lienzo_rectangulo(l, 8, 8, 64, 40, [200, 50, 60])
lienzo_rectangulo(l, 40.5, 28.25, 64, 40, [60, 200, 90, 140])
lienzo_circulo(l, 150, 40, 30, [255, 170, 0])
lienzo_circulo_borde(l, 150, 40, 36, 3, [255, 255, 255, 180])
lienzo_rectangulo_redondeado(l, 196, 10, 52, 36, 9, color_hex("#8a2be2"))
lienzo_linea(l, 6, 186, 250, 120, [0, 200, 255], 2.5)
lienzo_poligono_relleno(l, [[200, 60], [250, 90], [215, 110]], [255, 255, 255, 200])
lienzo_imagen(l, original, 10, 60, {"ancho": 74, "alto": 46, "suave": verdadero})
lienzo_imagen(l, original, 90, 60, {"alfa": 128, "tinte": [255, 128, 128]})
sea cam = camara3d([2.4, 1.8, 3.2], [0, 0.2, 0], 50)
sea damero = imagen_nueva(8, 8)
para y en rango(8) { para x en rango(8) { si ((x + y) % 2 == 0) { imagen_fijar_pixel(damero, x, y, [240, 240, 240]) } sino { imagen_fijar_pixel(damero, x, y, [200, 40, 40]) } } }
sea tris = lienzo_malla(l, malla_plano(4, 4, 2), m4_traslacion(0, 0 - 0.8, 0), cam, {"color": [90, 110, 140]})
tris = tris + lienzo_malla(l, malla_cubo(1.1), m4_mul(m4_traslacion(0 - 0.4, 0, 0), m4_rotacion_y(30)), cam, {"textura": damero, "suave": falso})
tris = tris + lienzo_malla(l, malla_esfera(0.45, 20, 12), m4_traslacion(1, 0 - 0.3, 0.5), cam, {"color": [80, 160, 255]})
sea obj = obj_parsear("# tetraedro\nv 0 1 0\nv -0.5 0 0.5\nv 0.5 0 0.5\nv 0 0 -0.5\nf 1 2 3\nf 1 3 4\nf 1 4 2\nf 2 4 3\n")
tris = tris + lienzo_malla(l, obj, m4_traslacion(0.9, 0.3, 0 - 0.6), cam, {"color": [120, 230, 120], "alambre": [0, 0, 0]})
lienzo_texto(l, f, "C-Forge: ¡ñandú!", 8, 160, 18, [255, 255, 255])
lienzo_texto(l, nulo, "6x12 OK", 190, 176, 12, [255, 230, 120])
mostrar("triángulos: " + tris + " (OBJ: " + longitud(obj["indices"]) / 3 + " caras)")
mostrar("píxel cubo: " + imagen_pixel(l, 118, 118) + " fondo: " + imagen_pixel(l, 250, 4))
mostrar("render: " + huella(l["pixeles"]))
si (longitud(argumentos()) > 0) { lienzo_guardar(l, argumentos()[0] + "/graficos.png") }

// ── Audio ──
sea tono = sonido_tono(441, 50, 44100, "seno", 0.5)
mostrar("tono: " + sonido_cuadros(tono) + " cuadros, muestra 25 = " + pcm_muestra(tono["pcm"], 25))
sea wav = sonido_a_wav(tono)
mostrar("wav: " + longitud(wav) + " bytes, ida y vuelta " + (sonido_desde_wav(wav)["pcm"] == tono["pcm"]))
audio_registrar_sonido("tono", tono, "sfx")
audio_registrar_sonido("grave", sonido_tono(220, 30, 22050, "cuadrada", 0.3), "sfx")
audio_reproducir("tono", {"volumen": 1, "pan": 0 - 1})
audio_reproducir("grave", {"volumen": 0.5, "pitch": 1.5, "loop": verdadero})
sea pcm = mezclador_generar(2205)
mostrar("mezcla: izq " + pcm_muestra(pcm, 400) + " der " + pcm_muestra(pcm, 401) + " canales " + audio_canales_activos())
sea resto = mezclador_generar(2205)
mostrar("tras 100 ms: " + audio_canales_activos() + " canal (el bucle sigue) " + huella(pcm + resto))
audio_parar_todo()
mostrar("[OK] gráficos, imágenes, fuentes y audio")
