// Biblioteca de ejemplo para Xcode.
sea saludos = 0

#[Exportar]
funcion doble(x: numero): numero {
    retornar x * 2
}

#[Exportar]
funcion sumar(a: entero, b: entero): entero {
    retornar a + b
}

#[Exportar]
funcion saludo(nombre: texto): texto {
    saludos = saludos + 1
    retornar "Hola, {nombre} (#{saludos})"
}

#[Exportar]
funcion es_par(n: entero): booleano {
    retornar n % 2 == 0
}
