// tests/apple/objc.cfv — puente con Objective-C (stdlib/apple.cfv) en macOS.
importar "apple"

sea s = ns_texto("hola C-Forge")
mostrar(objc_enviar(s, "length"))
mostrar(texto_de_ns(objc_enviar(s, "uppercaseString")))
mostrar(texto_de_ns(objc_enviar(s, "stringByAppendingString:", " ✓")))
sea partes = lista_de_ns(objc_enviar(s, "componentsSeparatedByString:", " "))
mostrar(longitud(partes))
mostrar(texto_de_ns(partes[1]))
sea info = objc_enviar(objc_clase("NSProcessInfo"), "processInfo")
mostrar(objc_enviar(info, "processorCount") > 0)
mostrar(objc_enviar_doble(info, "systemUptime") > 0.0)
mostrar(texto_de_ns(objc_enviar(objc_clase("NSNumber"), "numberWithInt:", 42)))
