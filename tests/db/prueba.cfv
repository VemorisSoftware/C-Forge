// tests/db — SQLite con la biblioteca del sistema (stdlib/sqlite.cfv y db.cfv).
importar "db"

sea db = db_conectar(":memory:")
db_migrar(db, "CREATE TABLE usuarios (id INTEGER PRIMARY KEY, nombre TEXT, email TEXT UNIQUE, edad INTEGER, saldo REAL)")
db_insertar(db, "usuarios", {"nombre": "Ana", "email": "ana@ejemplo.com", "edad": 31, "saldo": 1234.5})
db_insertar(db, "usuarios", {"nombre": "Beto ñandú", "email": "beto@ejemplo.com", "edad": 25, "saldo": 0.1})
db_insertar(db, "usuarios", {"nombre": "Carla", "email": "carla@ejemplo.com", "edad": 40, "saldo": 0 - 7})
mostrar("último id: " + db_ultimo_id(db))
mostrar("todos: " + db_todos(db, "usuarios"))
mostrar("por id: " + db_por_id(db, "usuarios", 2))
mostrar("donde: " + db_donde(db, "usuarios", "edad", 40))
mostrar("actualizar: " + db_actualizar(db, "usuarios", 1, {"edad": 32}))
mostrar("tras actualizar: " + db_por_id(db, "usuarios", 1)["edad"])
mostrar("contar: " + db_contar(db, "usuarios"))
mostrar("paginar: " + db_paginar(db, "usuarios", 2, 2))
mostrar("parámetros: " + db_consulta_p(db, "SELECT nombre FROM usuarios WHERE edad > ? AND saldo < ?", [30, 2000.25]))
mostrar("nulo: " + db_consulta_p(db, "SELECT ? AS a, ? AS b, ? AS c", [nulo, verdadero, "x"]))
intentar { db_insertar(db, "usuarios", {"nombre": "Otra", "email": "ana@ejemplo.com"}) } capturar (e) { mostrar("único: " + e) }
intentar { db_consulta(db, "SELECT * FROM no_existe") } capturar (e) { mostrar("error: " + e) }
intentar {
    db_en_transaccion(db, funcion() {
        db_eliminar(db, "usuarios", 1)
        lanzar "falla a propósito"
    })
} capturar (e) { mostrar("transacción revertida: " + e) }
mostrar("siguen: " + db_contar(db, "usuarios"))
db_en_transaccion(db, funcion() { retornar db_eliminar(db, "usuarios", 3) })
mostrar("tras confirmar: " + db_contar(db, "usuarios"))
db_desconectar(db)

// En archivo: los datos persisten al reabrir.
sea ruta = "cforge-prueba-db.sqlite"
sea a = db_conectar(ruta)
db_ejecutar(a, "DROP TABLE IF EXISTS notas; CREATE TABLE notas (t TEXT)")
db_consulta_p(a, "INSERT INTO notas VALUES (?)", ["persistente"])
db_cerrar(a)
sea b = db_conectar(ruta)
mostrar("archivo: " + db_consulta(b, "SELECT t FROM notas")[0]["t"])
db_cerrar(b)
