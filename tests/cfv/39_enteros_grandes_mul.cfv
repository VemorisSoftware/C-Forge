// Multiplicación de enteros grandes: resultados exactos en todos los
// tamaños (escolar, Karatsuba y NTT) y tiempos razonables.

funcion ms(f) {
    sea t0 = reloj_ms()
    f()
    retornar reloj_ms() - t0
}

// Identidades exactas en distintos tamaños (1 a 40000 cifras de 10^9).
para d en [1, 3, 47, 48, 100, 1499, 1500, 1600, 5000, 40000] {
    sea x = potencia(10, 9 * d) - 12345
    afirmar(x * x == potencia(10, 18 * d) - 2 * 12345 * potencia(10, 9 * d) + 12345 * 12345, "cuadrado de 10^(9·" + d + ") - 12345")
    sea y = potencia(10, 9 * d) - 999999999
    sea z = potencia(10, 9 * d + 7) - 1
    afirmar(y * z == potencia(10, 18 * d + 7) - potencia(10, 9 * d) - 999999999 * potencia(10, 9 * d + 7) + 999999999, "producto desbalanceado " + d)
}

// Signos y operandos de largos muy distintos.
afirmar(-potencia(2, 30000) * potencia(5, 30000) == -potencia(10, 30000), "signo")
afirmar(potencia(3, 200000) * 0 == 0, "por cero")
afirmar(potencia(7, 50000) * potencia(7, 3) == potencia(7, 50003), "largos distintos")
afirmar(potencia(12345678901234567, 400) % 1000000007 == 228473166, "potencia modular de referencia")

// Valor conocido: últimos dígitos y largo.
sea t = a_texto(potencia(99999999999999999999, 3000) * potencia(123456789, 777))
afirmar(longitud(t) == 66288, "largo del producto")
afirmar(subtexto(t, longitud(t) - 30, longitud(t)) == "055696176015210713439202474229", "cifras finales")

// Tiempo: 2 millones de cifras en pocos segundos.
sea largo = 0
sea tiempo = ms(funcion() { largo = longitud(a_texto(potencia(99999999999999999999, 100000))) })
afirmar(largo == 2000000, "largo de la potencia grande")
afirmar(tiempo < 10000, "potencia grande en tiempo razonable (" + tiempo + " ms)")

// Tope de tamaño con error claro.
sea mensaje = ""
intentar { potencia(2, 20000000) } capturar (e) { mensaje = e }
afirmar(texto_contiene(mensaje, "4 millones de cifras"), "tope de potencia")

mostrar("[OK] multiplicación de enteros grandes")
