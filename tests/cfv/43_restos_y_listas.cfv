// Resto por constantes, listas que crecen mucho y lista_repetir: mismos
// resultados que la vía general, con signos y valores extremos.

// % con divisor literal frente al mismo divisor en una variable.
sea divisores = [3, 5, 6, 7, 9, 10, 11, 12, 13, 25, 100, 641, 1000, 65537, 999999, 1000000007, 2147483647]
sea valores = [0, 1, -1, 2, -2, 6, -6, 7, -7, 100, -100, 12345678901, -12345678901,
    4611686018427387903, -4611686018427387904, 4611686018427387902, -4611686018427387903,
    99999999999999, -99999999999999, 99999999999999999999, -99999999999999999999, 7.5, -7.5]
para x en valores {
    afirmar(x % 3 == x % divisores[0], "% 3 de " + x)
    afirmar(x % 5 == x % divisores[1], "% 5 de " + x)
    afirmar(x % 6 == x % divisores[2], "% 6 de " + x)
    afirmar(x % 7 == x % divisores[3], "% 7 de " + x)
    afirmar(x % 9 == x % divisores[4], "% 9 de " + x)
    afirmar(x % 10 == x % divisores[5], "% 10 de " + x)
    afirmar(x % 11 == x % divisores[6], "% 11 de " + x)
    afirmar(x % 12 == x % divisores[7], "% 12 de " + x)
    afirmar(x % 13 == x % divisores[8], "% 13 de " + x)
    afirmar(x % 25 == x % divisores[9], "% 25 de " + x)
    afirmar(x % 100 == x % divisores[10], "% 100 de " + x)
    afirmar(x % 641 == x % divisores[11], "% 641 de " + x)
    afirmar(x % 1000 == x % divisores[12], "% 1000 de " + x)
    afirmar(x % 65537 == x % divisores[13], "% 65537 de " + x)
    afirmar(x % 999999 == x % divisores[14], "% 999999 de " + x)
    afirmar(x % 1000000007 == x % divisores[15], "% 1000000007 de " + x)
    afirmar(x % 2147483647 == x % divisores[16], "% 2147483647 de " + x)
}
afirmar([-7 % 3, 7 % -3, -7 % 7, -8 % 7, 8 % 7] == [-1, 1, 0, -1, 1], "signo del resto")
sea s = 12345
sea bien = verdadero
para i en rango(0, 20000) {
    s = (s * 1103515245 + 12345) % 4611686018427387903
    sea y = s - 2305843009213693951
    si (y % 7 != y % divisores[3] o y % 1000000007 != y % divisores[15] o y % 13 != y % divisores[8]) { bien = falso }
}
afirmar(bien, "restos de valores al azar")

// .agregar en línea: listas, valores de todo tipo y crecimiento grande.
sea l = []
sea i = 0
mientras (i < 3000000) {
    l.agregar(i)
    i += 1
}
afirmar(longitud(l) == 3000000 y l[0] == 0 y l[2999999] == 2999999 y l[1234567] == 1234567, "lista grande")
sea suma = 0
para v en l { suma = suma + v }
afirmar(suma == 4499998500000, "suma de la lista grande")
sea mezcla = []
mezcla.agregar("a")
mezcla.agregar(nulo)
mezcla.agregar([1])
mezcla.agregar({"k": 2})
mezcla.agregar(1.5)
mezcla.agregar(99999999999999999999)
afirmar(mezcla == ["a", nulo, [1], {"k": 2}, 1.5, 99999999999999999999], "valores de todo tipo")
sea fallo = falso
intentar { sea n = 5 n.agregar(1) } capturar (e) { fallo = verdadero }
afirmar(fallo, "agregar a un número da error")

// Una clase con su propio método agregar sigue usándolo.
clase Bolsa {
    sea cosas
    funcion constructor() { esto.cosas = [] }
    funcion agregar(x) { esto.cosas.agregar(x * 2) retornar 0 }
}
sea b = Bolsa()
b.agregar(21)
afirmar(b.cosas == [42], "método agregar de una clase")

// lista_repetir.
afirmar(lista_repetir(7, 3) == [7, 7, 7], "lista_repetir")
afirmar(lista_repetir("x", 0) == [], "lista_repetir vacía")
sea grande = lista_repetir(0, 2000001)
grande[2000000] = 1
grande.agregar(2)
afirmar(longitud(grande) == 2000002 y grande[2000000] == 1 y grande[2000001] == 2, "lista_repetir grande")

// La variable de un ciclo "para" no tapa otra del mismo nombre después.
para k en rango(0, 3) { }
sea k = 10
k += 1
afirmar(k == 11, "variable después de un para")
sea total = 0
para k2 en [1, 2, 3] { total = total + k2 }
afirmar(total == 6, "para normal")

mostrar("[OK] restos y listas")
