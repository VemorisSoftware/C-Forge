// async funcion / await (también asincrona / aguardar) sobre tareas.
funcion igual(a, b, que) { afirmar(a == b, que + ": " + a + " != " + b) }

async funcion cuadrado(x) { retornar x * x }
async funcion falla(m) { lanzar m }
async funcion suma_de(lista) {
    sea tareas = []
    para v en lista { tareas.agregar(cuadrado(v)) }
    sea total = 0
    para t en tareas { total = total + await t }
    retornar total
}
asincrona funcion saludo(n) { retornar "hola " + n }

igual(await suma_de([1, 2, 3, 4]), 30, "await de tareas anidadas")
igual(aguardar saludo("ana"), "hola ana", "asincrona / aguardar")
igual(await 5, 5, "await de un valor que no es tarea")
sea capturado = ""
intentar { await falla("se rompió") } capturar (e) { capturado = e }
igual(capturado, "se rompió", "el error de la tarea se relanza")
sea t = cuadrado(9)
igual(tipo(t), "mapa", "llamar devuelve una tarea")
igual(await t, 81, "await después")
async funcion devuelve_ok(x) { retornar Ok(x) }
igual(coincidir await devuelve_ok(7) { Ok(v) => v, _ => 0 }, 7, "await + coincidir")
mostrar("[OK] async / await")
