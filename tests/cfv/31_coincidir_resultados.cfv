// Resultado<T, E> y Opcion<T> de primera clase: Ok/Error, Alguno/Ninguno,
// el operador ? y coincidir (match).
funcion igual(a, b, que) { afirmar(a == b, que + ": " + a + " != " + b) }

funcion dividir(a, b) {
    si (b == 0) { retornar Error("división por cero") }
    retornar Ok(a / b)
}
funcion mas_uno(a, b) {
    sea q = dividir(a, b)?
    retornar Ok(q + 1)
}
funcion buscar(lista, x) {
    para v en lista { si (v == x) { retornar Alguno(v) } }
    retornar Ninguno
}
funcion primero_par(lista) {
    sea v = buscar(lista, 4)?
    retornar Alguno(v * 10)
}
funcion describir(r) {
    retornar coincidir r {
        Ok(v) => "ok " + v,
        Error(e) => "error: " + e,
        Alguno(v) => "alguno " + v,
        Ninguno => "ninguno",
        _ => "otro"
    }
}

igual(describir(dividir(10, 2)), "ok 5", "Ok")
igual(describir(dividir(1, 0)), "error: división por cero", "Error")
igual(describir(mas_uno(8, 2)), "ok 5", "? con Ok")
igual(describir(mas_uno(8, 0)), "error: división por cero", "? propaga Error")
igual(describir(buscar([1, 2], 2)), "alguno 2", "Alguno")
igual(describir(buscar([1, 2], 9)), "ninguno", "Ninguno")
igual(describir(primero_par([4])), "alguno 40", "? con Alguno")
igual(describir(primero_par([1])), "ninguno", "? propaga Ninguno")
igual(describir(42), "otro", "comodín")

// Patrones de valor, comodines y bloques.
sea vistos = []
para x en [1, "hola", 7, nulo, verdadero] {
    vistos.agregar(coincidir x { 1 => "uno", "hola" => "saludo", nulo => "nulo", verdadero => "sí", _ => "otro" })
}
igual(unir(vistos, ","), "uno,saludo,otro,nulo,sí", "patrones de valor")
sea contador = 0
coincidir Ok(3) {
    Ok(n) => { contador = contador + n }
    Error(_) => { contador = 0 - 1 }
}
igual(contador, 3, "rama con bloque")
igual(coincidir Alguno(1) { Alguno(_) => "sí", Ninguno => "no" }, "sí", "variable descartada")
igual(coincidir 5 { 1 => "a" }, nulo, "sin rama: nulo")

// Dentro de cierres y con ligaduras que no se filtran.
sea doble = funcion(r) { retornar coincidir r { Ok(n) => n * 2, _ => 0 - 1 } }
igual(doble(Ok(21)), 42, "en un cierre")
igual(doble(Error("x")), 0 - 1, "en un cierre (error)")
sea n = 100
coincidir Ok(1) { Ok(n) => { igual(n, 1, "ligadura local") } }
igual(n, 100, "la ligadura no pisa la variable de afuera")
mostrar("[OK] coincidir, Ok/Error, Alguno/Ninguno y ?")
