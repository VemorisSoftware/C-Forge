// FFI con C: llamadas a libc y libm con extern.
extern "libc" funcion strlen(s: texto): largo
extern "libm" funcion cos(x: numero): numero
extern "libm" funcion pow(base: numero, exp: numero): numero
extern "libc" funcion abs(n: entero): entero

afirmar(strlen("C-Forge") == 7, "strlen debe medir 7")
afirmar(cos(0) == 1, "cos(0) debe ser 1")
afirmar(pow(2, 10) == 1024, "pow(2, 10) debe ser 1024")
afirmar(abs(-42) == 42, "abs(-42) debe ser 42")

intentar {
    extern "libc" funcion funcion_que_no_existe_cforge(): entero
    afirmar(falso, "debió fallar")
} capturar (e) {
    afirmar(contiene(e, "funcion_que_no_existe_cforge"), "el error debe nombrar el símbolo")
}

// Más argumentos que registros (System V: 6 enteros y 8 flotantes; ARM64: 8 y 8):
// el resto va por la pila. Solo en Linux: sprintf es variádica, y en macOS
// ARM64 y Windows las variádicas siguen otras reglas.
si (sys_info()["sistema"] == "linux") {
    extern "libc" funcion snprintf(buf: puntero, n: largo, fmt: texto, a: largo, b: largo, c: largo, d: largo, e: largo, f: largo, g: largo, h: largo, i: largo): entero
    extern "libc" funcion sprintf(buf: puntero, fmt: texto, a: numero, b: numero, c: numero, d: numero, e: numero, f: numero, g: numero, h: numero, i: numero, j: numero, k: largo, l: largo, m: largo, n: largo, p: largo): entero
    sea buf = c_reservar(512)
    afirmar(snprintf(buf, 512, "%ld %ld %ld %ld %ld %ld %ld %ld %ld", 1, 2, 3, 4, 5, 6, 7, 8, 9) == 17, "snprintf con 12 argumentos")
    afirmar(c_texto(buf) == "1 2 3 4 5 6 7 8 9", "enteros por la pila: " + c_texto(buf))
    sprintf(buf, "%g %g %g %g %g %g %g %g %g %g|%ld %ld %ld %ld %ld", 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5, 9.5, 10.5, 11, 12, 13, 14, 15)
    afirmar(c_texto(buf) == "1.5 2.5 3.5 4.5 5.5 6.5 7.5 8.5 9.5 10.5|11 12 13 14 15", "flotantes y enteros por la pila: " + c_texto(buf))
    c_liberar(buf)
}

mostrar("[OK] extern C")
