// Criptografía en C-Forge puro: corre en Linux, macOS y Windows.
importar "crypto"
afirmar(sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "SHA-256 de abc")
afirmar(hmac_sha256("clave", "mensaje") == "17e8847a84636888af5a7abe0910e50a0fa28d6f1d3591a175e6e01fcf80b412", "HMAC-SHA256")
sea c = aes_cifrar("mi clave", "Hola, C-Forge ñandú con más de dieciséis bytes")
afirmar(aes_descifrar("mi clave", c) == "Hola, C-Forge ñandú con más de dieciséis bytes", "AES ida y vuelta")
// Vector generado con: openssl enc -aes-256-cbc -K sha256("mi clave") -iv 000102...0f
sea ossl = "000102030405060708090a0b0c0d0e0f:2b545b7db2a194d702a094982c5c69b2744f3727878899fc9c3dbc732050f594"
afirmar(aes_descifrar("mi clave", ossl) == "compatible con OpenSSL", "descifra un vector de OpenSSL")
sea fallo = falso
intentar { aes_descifrar("otra clave", c) } capturar (e) { fallo = verdadero }
afirmar(fallo, "AES con otra clave falla")
afirmar(longitud(crypto_rand_bytes(16)) == 32, "16 bytes aleatorios en hex")
afirmar(crypto_rand_bytes(8) != crypto_rand_bytes(8), "bytes aleatorios distintos")
mostrar("[OK] crypto")
