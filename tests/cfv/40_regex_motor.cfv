// Motor de expresiones regulares: semántica de primera alternativa (como
// Perl/Python), cuantificadores perezosos y tiempo lineal en el texto.
importar "regex"

funcion ms(f) {
    sea t0 = reloj_ms()
    f()
    retornar reloj_ms() - t0
}

// Resultados de referencia (iguales a Python re.search / re.findall).
afirmar(regex_buscar("(.*a){3}", "xaxaxax") == "xaxaxa", "grupos que retroceden")
afirmar(regex_buscar("(a|ab)(c|bcd)", "abcd") == "abcd", "primera alternativa con retroceso")
afirmar(regex_buscar("a+?", "aaa") == "a", "perezoso +?")
afirmar(regex_buscar("a*?b", "aab") == "aab", "perezoso *?")
afirmar(regex_buscar("<.+?>", "<a><b>") == "<a>", "perezoso entre marcas")
afirmar(regex_buscar("<.+>", "<a><b>") == "<a><b>", "codicioso entre marcas")
afirmar(regex_buscar("x{2,3}", "xxxxx") == "xxx", "repetición acotada")
afirmar(regex_buscar("^b", "ab") == nulo, "ancla de inicio")
afirmar(regex_buscar("b$", "abb") == "b", "ancla de fin")
afirmar(regex_buscar("[^a-c]+", "abcxyzabc") == "xyz", "conjunto negado")
afirmar(regex_buscar("\\d+\\.\\d+", "v 12.50 usd") == "12.50", "clases \\d")
afirmar(regex_buscar("([^a]??|b)+c", "bbc") == "bbc", "bucle que no consume")
afirmar(longitud(regex_buscar_todos("a*", "aa!")) == 3, "coincidencias vacías")
afirmar(regex_buscar_todos("[0-9]+", "a1b22c333") == ["1", "22", "333"], "buscar todos")
afirmar(regex_reemplazar("o+", "foo boo", "0") == "f0 b0", "reemplazar")
afirmar(regex_dividir(" +", "a  b   c") == ["a", "b", "c"], "dividir")
afirmar(regex_coincidir("^[a-z]+@[a-z]+[.][a-z]+$", "ana@vemoris.cl"), "coincidir")
afirmar(es_email("javier@vemoris.cl"), "es_email")

// Patrones con muchas formas de repartir el texto: responden al instante.
sea casos = [
    ["a*r*a*r*a*r*a*r*a*r*a*r*a*r*a*r*" + caracter(192) + "a*r*", texto_repetir("a", 40) + "!"],
    ["a*r*a*r*a*r*a*r*a*r*a*r*", texto_repetir("a", 40) + "!"],
    ["(a+)+$", texto_repetir("a", 40) + "!"],
    ["(a|a)*$", texto_repetir("a", 40) + "!"],
    ["(.*a){20}", texto_repetir("a", 40) + "!"],
    ["(a*)*b", texto_repetir("a", 5000)],
    ["(x+x+)+y", texto_repetir("x", 3000)],
]
para c en casos {
    sea t = ms(funcion() { regex_buscar_todos(c[0], c[1]) })
    afirmar(t < 3000, "patrón " + subtexto(c[0], 0, 12) + " en tiempo lineal (" + t + " ms)")
}
afirmar(regex_buscar("(.*a){20}", texto_repetir("a", 40) + "!") == texto_repetir("a", 40), "(.*a){20}")
afirmar(regex_buscar("(a+)+$", texto_repetir("a", 40) + "!") == nulo, "(a+)+$ sin coincidencia")

// Patrón demasiado grande: error capturable.
sea grande = falso
intentar { regex_buscar("(((a{100}){100}){100})", "a") } capturar (e) { grande = verdadero }
afirmar(grande, "patrón demasiado grande")

mostrar("[OK] motor de expresiones regulares")
