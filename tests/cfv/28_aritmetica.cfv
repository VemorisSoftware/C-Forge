// Rutas rápidas de enteros (en línea) frente a la semántica del runtime.
funcion igual(a, b, que) { afirmar(a == b, que + ": " + a + " != " + b) }
sea a = 0 - 7
sea b = 3
igual(a + b, 0 - 4, "suma negativa")
igual(a - b, 0 - 10, "resta")
igual(a * b, 0 - 21, "producto negativo")
igual(a * a, 49, "producto de negativos")
igual(a % b, 0 - 1, "módulo con dividendo negativo")
igual(7 % (0 - 3), 1, "módulo con divisor negativo")
igual(a % 2, 0 - 1, "módulo literal")
igual(a * 4, 0 - 28, "producto literal")
igual(a - 1, 0 - 8, "resta literal")
igual(100000 * 100000, 10000000000, "producto grande")
afirmar(a < b y b > a y a <= 0 - 7 y a >= 0 - 7 y a != b y no (a == b), "comparaciones")
afirmar(a < 0 y 5 > 4 y b == 3 y b != 4, "comparaciones con literal")
// Mezcla con flotantes y textos: el runtime.
igual(a + 0.5, 0 - 6.5, "entero + flotante")
igual(1.5 * 2, 3, "flotante · entero")
igual(2.5 % 2, 0.5, "módulo flotante")
afirmar(1.5 < 2 y 2 > 1.5, "comparación mixta")
igual("n=" + 3, "n=3", "texto + entero")
igual(longitud([1] + [2]), 2, "lista + lista")
afirmar("a" < "b", "comparación de textos")
igual(7 / 2, 3.5, "división")
igual(8 / 2, 4, "división exacta")
sea fallo = falso
intentar { mostrar(5 % 0) } capturar (e) { fallo = verdadero }
afirmar(fallo, "módulo por cero lanza error")
fallo = falso
sea cero = 0
intentar { mostrar(5 % cero) } capturar (e) { fallo = verdadero }
afirmar(fallo, "módulo por variable cero lanza error")
// Enteros probados (variables que solo reciben enteros).
sea suma = 0
sea i = 0
mientras (i < 1000) {
    si (i % 3 == 0 o i % 5 == 0) { suma = suma + i }
    i = i + 1
}
igual(suma, 233168, "Project Euler 1")
sea j = 10
j -= 3
j += 1
igual(j * j, 64, "asignación compuesta")
mostrar("[OK] aritmética")
