// Modo turbo con listas locales, parámetros sin tipo y funciones anónimas:
// los mismos resultados que el modo dinámico en todas las plataformas.

// Criba con agregar (bytes) y con lista_repetir.
funcion criba(n) {
    sea marca = []
    sea i = 0
    mientras (i <= n) { marca.agregar(0) i += 1 }
    sea cuenta = 0
    sea p = 2
    mientras (p <= n) {
        si (marca[p] == 0) {
            cuenta += 1
            sea m = p * p
            mientras (m <= n) { marca[m] = 1 m = m + p }
        }
        p += 1
    }
    retornar cuenta
}

funcion criba2(n) {
    sea marca = lista_repetir(0, n + 1)
    sea cuenta = 0
    sea p = 2
    mientras (p <= n) {
        si (marca[p] == 0) {
            cuenta += 1
            sea m = p * p
            mientras (m <= n) { marca[m] = 1 m = m + p }
        }
        p += 1
    }
    retornar cuenta
}

// Ordenar: aleatorios, negativos, cortos, de 64 bits completos y en el sitio.
funcion prueba_orden(n, semilla, modulo, desplazar) {
    sea l = []
    sea x = semilla
    sea i = 0
    sea suma = 0
    mientras (i < n) {
        x = (x * 1103515245 + 12345) % 2147483648
        sea v = x % modulo - desplazar
        l.agregar(v)
        suma = suma + v
        i += 1
    }
    sea o = ordenar(l)
    sea malos = 0
    sea s2 = 0
    i = 0
    mientras (i < n) {
        s2 = s2 + o[i]
        si (i > 0) { si (o[i - 1] > o[i]) { malos += 1 } }
        i += 1
    }
    si (s2 != suma) { retornar 0 - 1 }
    retornar malos * 1000000 + longitud(o)
}

funcion extremos(n) {
    sea l = []
    sea i = 0
    mientras (i < n) {
        si (i % 2 == 0) { l.agregar(4000000000000000000 - i) } sino { l.agregar(0 - 4000000000000000000 + i) }
        i += 1
    }
    sea o = ordenar(l)
    sea malos = 0
    i = 1
    mientras (i < n) {
        si (o[i - 1] > o[i]) { malos += 1 }
        i += 1
    }
    retornar malos * 1000 + o[0] % 1000
}

funcion en_sitio(n) {
    sea l = []
    sea i = n
    mientras (i > 0) { l.agregar(i * 3 % 1000) i -= 1 }
    retornar longitud(ordenar(l))
}

// Elementos de 64 bits que se salen de los enteros chicos.
funcion grandes() {
    sea l = lista_repetir(4611686018427387903, 3)
    l[1] = l[0] + 1
    retornar l[1] - l[0]
}

// Índices fuera de rango: el mismo error que siempre.
funcion fuera(n) {
    sea l = lista_repetir(7, n)
    retornar l[n]
}

// Restos por potencias de dos (con signo del dividendo).
funcion restos(x) { retornar x % 8 * 1000000000000 + x % 2147483648 * 1000 + x % (0 - 4) }

// Parámetros sin tipo y asignaciones compuestas.
funcion acumula(n) {
    sea s = 0
    sea i = 0
    mientras (i < n) {
        s += i
        s -= 1
        s *= 1
        i += 1
    }
    retornar s
}

// Llenado de una vez: el contador queda donde lo dejaría el ciclo.
funcion llenado(a, b) {
    sea l = []
    sea i = a
    mientras (i < b) { l.agregar(300) i += 1 }
    sea j = a
    mientras (j <= b) { l.agregar(1) j += 1 }
    retornar longitud(l) * 1000000 + i * 1000 + j
}

// Recursión desenrollada un nivel (la llamada que no es de cola, en línea).
funcion fib(n) {
    si (n < 2) { retornar n }
    retornar fib(n - 1) + fib(n - 2)
}
funcion trib(n) {
    si (n < 3) { retornar n * 2 - 1 }
    retornar trib(n - 1) + n % 5 + trib(n - 3) + 0 - 1
}
funcion trib2(n) {
    si (n < 3) { retornar n * 2 - 1 }
    retornar trib2(n - 1) + n % 5 + trib2(n - 3)
}
afirmar(fib(25) == 75025, "fib")
afirmar(fib(0 - 3) == 0 - 3, "fib negativo")
afirmar(trib(30) == 158435, "trib")
afirmar(trib2(30) == 216859, "trib con términos")

afirmar(llenado(3, 10) == 15010011, "llenado")
afirmar(llenado(10, 3) == 10010, "llenado vacío")
afirmar(criba(100000) == 9592, "criba")
afirmar(criba2(100000) == 9592, "criba con lista_repetir")
afirmar(prueba_orden(200000, 1, 2147483648, 0) == 200000, "ordenar 200k")
afirmar(prueba_orden(1000, 7, 10, 5) == 1000, "ordenar con repetidos y negativos")
afirmar(prueba_orden(50, 3, 100, 50) == 50, "ordenar corta")
afirmar(prueba_orden(0, 1, 5, 0) == 0, "ordenar vacía")
afirmar(extremos(1000) == 0 - 999, "ordenar extremos de 64 bits")
afirmar(en_sitio(5000) == 5000, "ordenar en el sitio")
afirmar(grandes() == 1, "elementos grandes")
sea mensaje = ""
intentar { fuera(3) } capturar (e) { mensaje = e }
afirmar(texto_contiene(mensaje, "índice"), "índice fuera de rango")
afirmar(restos(0 - 7) == 0 - 7000000007003, "restos negativos")
afirmar(restos(9) == 1000000009001, "restos")
afirmar(acumula(1000) == 498500, "asignaciones compuestas")
afirmar(acumula(1.5) == 0 - 1, "argumento decimal")
// Funciones anónimas: también van en turbo.
sea f = funcion(n) {
    sea s = 0
    sea i = 0
    mientras (i < n) { s = s + i % 7 i += 1 }
    retornar s
}
afirmar(f(1000000) == 2999997, "anónima")
afirmar(f(2.5) == 3, "anónima con decimal")

mostrar("[OK] turbo con listas")
