// Enteros sin límite: los resultados son exactos aunque no quepan en 64 bits.

// Desborde de la ruta rápida (+ - *) en ambos sentidos.
sea max = 4611686018427387903
afirmar(a_texto(max + 1) == "4611686018427387904", "max + 1")
afirmar(a_texto(-max - 2) == "-4611686018427387905", "min - 1")
afirmar(a_texto(max * max) == "21267647932558653957237540927630737409", "max * max")
afirmar(a_texto(max - (0 - max)) == "9223372036854775806", "resta que desborda")

// Literales grandes en el código.
sea g = 123456789012345678901234567890
afirmar(a_texto(g) == "123456789012345678901234567890", "literal grande")
afirmar(a_texto(9223372036854775807 + 1) == "9223372036854775808", "literal de 64 bits")
afirmar(a_texto(g * g) == "15241578753238836750495351562536198787501905199875019052100", "g * g")

// Factorial y potencias exactas.
sea f = 1
para i en rango(1, 31) { f = f * i }
afirmar(a_texto(f) == "265252859812191058636308480000000", "30!")
afirmar(a_texto(potencia(2, 100)) == "1267650600228229401496703205376", "2^100")
afirmar(potencia(3, 200) / potencia(3, 198) == 9, "división exacta de grandes")

// División, resto y cociente (truncados, como con enteros chicos).
afirmar(f % 1000000007 == 109361473, "resto")
afirmar(a_texto(cociente(f, 7)) == "37893265687455865519472640000000", "cociente")
afirmar(a_texto(cociente(-f, 7)) == "-37893265687455865519472640000000", "cociente negativo")
afirmar((-f) % 7 == 0, "resto de negativo")

// Vuelve a entero chico cuando cabe.
afirmar(f - f + 5 == 5, "vuelve a chico")
afirmar(g - g == 0, "cero")
afirmar((max + 1) - 1 == max, "ida y vuelta")

// Comparaciones e igualdad.
afirmar(f > max y -f < 0 - max, "comparaciones")
afirmar(g == 123456789012345678901234567890, "igualdad entre grandes")
afirmar(g != g + 1, "distinto")
afirmar([g, 1] == [123456789012345678901234567890, 1], "en listas")
afirmar(maximo(g, f) == f y minimo(g, f) == g, "maximo y minimo")
afirmar(absoluto(-g) == g, "absoluto")
afirmar(tipo_de(g) == "numero", "tipo")

// Texto ↔ número.
afirmar(a_numero("123456789012345678901234567890") == g, "a_numero")
afirmar(a_texto(-g) == "-123456789012345678901234567890", "negativo")

// Mezcla con decimales: el resultado es decimal.
afirmar(g / 2 == 61728394506172839450617283945, "mitad exacta")
afirmar(tipo_de(g * 0.5) == "numero", "decimal")

// Operaciones de bits: usan los 64 bits bajos (el código de hash y cifrado
// que multiplica y luego enmascara sigue dando lo mismo).
afirmar(bits_y(g, 255) == 210, "bits_y con entero grande")
afirmar(bits_y(g, 4294967295) == 1312754386, "máscara de 32 bits")
sea h = 2166136261
para i en rango(0, 20) { h = bits_y(h * 16777619, 4294967295) }
afirmar(h < 4294967296 y h >= 0, "hash de 32 bits")

mostrar("[OK] enteros sin límite")
