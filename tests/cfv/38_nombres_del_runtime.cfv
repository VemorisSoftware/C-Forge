// Una función del programa con el nombre de una del runtime no cambia lo que
// hace el runtime por dentro (antes, por ejemplo, cr_hex cambiaba los HMAC).

funcion cr_hex(s) { retornar "del programa" }
funcion es_blanco(b) { retornar verdadero }
funcion absoluto(x) { retornar "mio" }

// El programa usa las suyas…
afirmar(cr_hex("x") == "del programa", "la del programa para el programa")
afirmar(absoluto(-3) == "mio", "un nombre público también se puede redefinir")

// …y el runtime las suyas.
afirmar(longitud(hmac_sha512("a", "b")) == 128, "hmac_sha512 intacto")
afirmar(cfv_sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256 intacto")
afirmar(texto_recortar("  hola  ") == "hola", "texto_recortar intacto")
afirmar(potencia(2, 10) == 1024, "potencia no usa el absoluto del programa")

mostrar("[OK] nombres del runtime")
