// Sintaxis bilingüe: palabras clave en inglés como alias del español.
function factorial(n) {
    if (n <= 1) { return 1 }
    return n * factorial(n - 1)
}
let result = factorial(6)
assert(result == 720, "factorial en inglés")
assert(result == 720, "ok")
let total = 0
for x in [1, 2, 3] { total = total + x }
print(total)
try { throw "boom" } catch (e) { print("caught: " + e) }
class Box {
    let value = 0
    function constructor(v) { this.value = v }
}
let b = Box(7)
print(b.value)
print(true and not false)
let m = {"in": 1}
print(m["in"])
assert(total == 6, "for/in en inglés")
assert(b.value == 7, "class/this en inglés")
assert(m["in"] == 1, "las claves de texto no se traducen")
let lista = [3, 1]
append(lista, 2)
assert(length(lista) == 3, "append/length en inglés")
assert(upper("ok") == "OK", "upper en inglés")
assert(to_number("4") * 2 == 8, "to_number en inglés")
mostrar("[OK] sintaxis bilingüe")
