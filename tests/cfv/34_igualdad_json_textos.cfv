// Igualdad por contenido, JSON nativo e interpolación que no se dispara sin querer.
importar "json"

// == compara listas y mapas por contenido.
afirmar([1, [2, 3], {"x": [4]}] == [1, [2, 3], {"x": [4]}], "listas anidadas iguales")
afirmar([] == [] y {} == {}, "vacíos iguales")
afirmar({"a": 1, "b": 2} == {"b": 2, "a": 1}, "el orden de las claves no importa")
afirmar([1, 2] != [2, 1], "el orden de la lista sí importa")
afirmar({"a": 1} != {"a": 1, "b": 2}, "claves de más")
afirmar([1] == [1.0], "números iguales")
sea m = {"a": 1}
quitar_clave(m, "a")
afirmar(m == {}, "mapa vaciado")
sea l = [1, 2]
afirmar(es_mismo(l, l) y no es_mismo(l, [1, 2]), "es_mismo es identidad")
afirmar(lista_contiene([[1], [2]], [2]), "lista_contiene por contenido")
sea ciclo = [1]
ciclo.agregar(ciclo)
afirmar(ciclo == ciclo, "un ciclo es igual a sí mismo")
clase Punto { funcion constructor(x) { esto.x = x } }
afirmar(Punto(1) != Punto(1), "objetos de clase por identidad")
coincidir ([1, 2]) {
    [1, 2] => { afirmar(verdadero, "") }
    _ => { afirmar(falso, "coincidir con una lista literal") }
}

// JSON.
sea t = "\{\"a\": [1, -2, 3.5, 1e3, -0.25e-2], \"b\": \"h\\\"o\\nla \\u00f1 \\ud83d\\ude00 \\/\", \"c\": \{\}, \"d\": [], \"e\": true, \"f\": null}"
sea v = json_parsear(t)
afirmar(v["b"] == "h\"o\nla ñ 😀 /", "escapes y pares sustitutos")
afirmar(v["a"] == [1, -2, 3.5, 1000, -0.0025], "números")
afirmar(json_parsear(json_serializar(v)) == v, "ida y vuelta")
afirmar(json_serializar(0.1) == "0.1" y json_serializar(1 / 3) == "0.3333333333333333", "el número más corto que vuelve igual")
afirmar(json_parsear(json_serializar(12345678901234567890.0)) == 12345678901234567890.0, "17 cifras cuando hacen falta")
afirmar(json_bonito({"x": [1], "y": {}}) == "\{\n  \"x\": [\n    1\n  ],\n  \"y\": \{\}\n}", "json_bonito")
para mal en ["", "[1,]", "\{\"a\" 1}", "[1 2]", "tru", "01x", "\"abc", "-", "1.", "\"\\q\"", "[1] x", "\{\"a\":1,}"] {
    sea fallo = falso
    intentar { json_parsear(mal) } capturar (e) { fallo = texto_empieza_con(e, "json_parsear:") }
    afirmar(fallo, "debió rechazar " + mal)
}
sea hondo = texto_repetir("[", 10000) + texto_repetir("]", 10000)
sea fallo_hondo = falso
intentar { json_parsear(hondo) } capturar (e) { fallo_hondo = texto_contiene(e, "anidamiento") }
afirmar(fallo_hondo, "anidamiento sin límite")
sea grande = []
para i en lista_rango(0, 20000) { grande.agregar({"id": i, "nombre": "n" + i, "x": i / 7}) }
sea texto_grande = json_serializar(grande)
afirmar(json_parsear(texto_grande) == grande, "20 000 objetos")

// Interpolación: solo con nombres conocidos.
sea x = 5
funcion doble(n) { retornar n * 2 }
afirmar("a {x} {doble(x)} {(x + 1)} {longitud(l)}" == "a 5 10 6 2", "interpolación normal")
afirmar("{Binding Nombre}" == "\{Binding Nombre\}", "XAML literal")
afirmar("{B29F-CA47}" == "\{B29F-CA47\}", "GUID literal")
afirmar("<b>{desconocida}</b>" == "<b>\{desconocida\}</b>", "nombre desconocido literal")
afirmar("{x}{nada}" == "5\{nada\}", "mezcla")
funcion saludo() {
    sea quien = "Ana"
    retornar "hola {quien}"
}
afirmar(saludo() == "hola Ana", "variable local")

// Sistema real.
sea so = sys_info()["sistema"]
afirmar(so == "linux" o so == "macos" o so == "windows", "sistema: " + so)

mostrar("[OK] igualdad, JSON y textos")
