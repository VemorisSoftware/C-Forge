// Los errores de archivos se pueden capturar con intentar/capturar
// (antes terminaban el programa aunque hubiera un manejador).
sea leido = "no"
intentar {
    leido = leer_archivo("/ruta/que/no/existe/cforge.json")
} capturar (e) {
    leido = "capturado"
    afirmar(texto_indice(e, "no se pudo abrir") >= 0, "mensaje de lectura")
}
afirmar(leido == "capturado", "leer_archivo inexistente debe ser capturable")

sea escrito = "no"
intentar {
    escribir_archivo("/ruta/que/no/existe/salida.txt", "x")
} capturar (e) {
    escrito = "capturado"
    afirmar(texto_indice(e, "no se pudo escribir") >= 0, "mensaje de escritura")
}
afirmar(escrito == "capturado", "escribir_archivo sin carpeta debe ser capturable")

// Dentro de una función, el manejador también funciona.
funcion leer_o(ruta, defecto) {
    intentar {
        retornar leer_archivo(ruta)
    } capturar (e) {
        retornar defecto
    }
}
afirmar(leer_o("/no/existe", "vacio") == "vacio", "capturar dentro de función")

mostrar("[OK] errores de archivos")
