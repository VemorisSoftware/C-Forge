// Literales de 4.2: interpolación estricta y notación científica.
sea nombre = "Ana"
sea n = 3
afirmar("hola {nombre}" == "hola Ana", "interpolación de un identificador")
afirmar("{n + 1} y {(n * 2)}" == "4 y 6", "interpolación de expresiones")
afirmar(longitud("{\"a\": 1}") == 8, "JSON queda literal")
afirmar(texto_contiene("main() {\n  x;\n}", "{"), "llave de bloque (GLSL) queda literal")
afirmar("{{nombre}}" == "\{\{nombre}}", "llave doble queda literal (plantillas)")
afirmar("{{{n}}}" == "\{\{\{n}}}", "llave triple queda literal")
afirmar("\{{n}" == "\{3", "\\{ seguido de interpolación")
afirmar(longitud("*.{cfv,txt}") == 11 y "{maximo(1, n)}" == "3", "coma de glob literal; coma dentro de paréntesis interpola")
afirmar(longitud("a{color:red}") == 12 y longitud("{a: 1, b: 2}") == 12, "CSS y objetos JS quedan literales")
afirmar("{ x } {} {1}" == "\{ x } \{} \{1}", "llaves sin identificador quedan literales")
afirmar(1e5 == 100000, "1e5")
// Literales decimales con un solo redondeo (antes 123.456 o 1e300 podían
// quedar a 1 ulp) y subnormales que se pueden mostrar.
afirmar(123.456 == 123456 / 1000.0, "123.456 exacto")
afirmar(0.3 == 3 / 10.0, "0.3 exacto")
afirmar(1.5e-5 == 15 / 1000000.0, "1.5e-5 exacto")
afirmar(9007199254740993.0 == 9007199254740992.0, "2^53 + 1 redondea a par")
afirmar(a_texto(5e-324) == "4.94066e-324", "subnormal mínimo")
afirmar(a_texto(1e-310) == "1e-310", "subnormal")
afirmar(1e400 > 1e308, "desborde a infinito")
afirmar(1e-400 == 0, "por debajo de los subnormales")
afirmar(a_numero("2.5e1") == 25 y a_numero("1E-5") == 0.00001 y a_numero("+4") == 4, "a_numero con exponente y signo")
afirmar(a_numero("123.456") == 123.456 y a_numero("1e300") == 1e300, "a_numero redondea igual que los literales")
afirmar(a_numero("12345678901234567890123") == 12345678901234567890123.0, "a_numero con muchas cifras")
afirmar(2.5e-3 == 0.0025, "2.5e-3")
afirmar(1E3 + 1 == 1001, "1E3")
afirmar(4e+2 == 400, "4e+2")
afirmar(1e-40 > 0 y 1e-40 < 1e-39, "1e-40 no es cero")
afirmar(c_f32(1e-40) == 71362, "1e-40 como float")
mostrar("[OK] literales")
