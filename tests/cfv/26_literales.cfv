// Literales de 4.2: interpolación estricta y notación científica.
sea nombre = "Ana"
sea n = 3
afirmar("hola {nombre}" == "hola Ana", "interpolación de un identificador")
afirmar("{n + 1} y {(n * 2)}" == "4 y 6", "interpolación de expresiones")
afirmar(longitud("{\"a\": 1}") == 8, "JSON queda literal")
afirmar(texto_contiene("main() {\n  x;\n}", "{"), "llave de bloque (GLSL) queda literal")
afirmar("{ x } {} {1}" == "\{ x } \{} \{1}", "llaves sin identificador quedan literales")
afirmar(1e5 == 100000, "1e5")
afirmar(2.5e-3 == 0.0025, "2.5e-3")
afirmar(1E3 + 1 == 1001, "1E3")
afirmar(4e+2 == 400, "4e+2")
afirmar(1e-40 > 0 y 1e-40 < 1e-39, "1e-40 no es cero")
afirmar(c_f32(1e-40) == 71362, "1e-40 como float")
mostrar("[OK] literales")
