// Concatenación de textos: sumas en bucle en tiempo lineal sin que los
// textos anteriores cambien.

funcion ms(f) {
    sea t0 = reloj_ms()
    f()
    retornar reloj_ms() - t0
}

// Ramas desde un mismo prefijo: cada texto conserva su contenido.
sea base = texto_repetir("x", 40)
sea a = base + "A"
sea b = base + "B"
sea c = a + "1"
sea d = a + "2"
afirmar(a == base + "A" y b == base + "B", "ramas desde un prefijo")
afirmar(c == base + "A1" y d == base + "A2", "ramas desde un texto sumado")
afirmar(longitud(a) == 41 y longitud(c) == 42, "largos")

// Un texto guardado no ve lo que se suma después.
sea t = ""
para i en rango(0, 1000) { t = t + i }
sea copia = t
t += "fin"
afirmar(longitud(copia) + 3 == longitud(t), "copia intacta")
afirmar(texto_termina_con(copia, "999") y texto_termina_con(t, "fin"), "finales")

// Valores que no son texto a la derecha.
afirmar(base + 5 == base + "5", "número")
afirmar(base + nulo == base + "nulo", "nulo")
afirmar(base + [1, 2] == base + "[1, 2]", "lista")
afirmar("v" + verdadero == "vverdadero", "booleano")

// Rutas armadas por suma siguen funcionando con el sistema.
sea ruta = "/tmp/cforge-prueba-concat-" + texto_repetir("z", 40)
escribir_archivo(ruta + "a", "hola")
afirmar(existe_archivo(ruta + "a") y no existe_archivo(ruta + "b"), "rutas")
afirmar(leer_archivo(ruta + "a") == "hola", "leer por ruta sumada")
eliminar_archivo(ruta + "a")

// Tiempo: 100 mil sumas.
sea s = ""
sea tiempo = ms(funcion() {
    para i en rango(0, 100000) { s = s + "ab" }
})
afirmar(longitud(s) == 200000, "largo final")
sea u = ""
sea tiempo2 = ms(funcion() {
    para i en rango(0, 100000) { u += "ab" }
})
afirmar(u == s, "+= igual a +")
afirmar(tiempo < 2000 y tiempo2 < 2000, "sumas en tiempo lineal (" + tiempo + " ms, " + tiempo2 + " ms)")

mostrar("[OK] concatenación de textos")
