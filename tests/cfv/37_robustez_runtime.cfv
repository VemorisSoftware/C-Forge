// Robustez del runtime: entradas raras dan errores capturables, nunca un
// cierre del programa, un cuelgue ni un resultado corrupto.

funcion falla(f) {
    sea fallo = falso
    intentar { f() } capturar (e) { fallo = verdadero }
    retornar fallo
}

// Errores capturables (antes terminaban el programa).
afirmar(falla(funcion() { quitar_ultimo([]) }), "quitar_ultimo de lista vacía")
afirmar(falla(funcion() { bytes_entero(1, -1, 0) }), "bytes_entero con ancho negativo")
afirmar(falla(funcion() { bytes_entero(1, "x", 0) }), "bytes_entero con ancho no entero")

// Sin cuelgues con valores enormes.
afirmar(falla(funcion() { rango(5, 0, 0) }), "rango con paso 0")
afirmar(falla(funcion() { rango(0, 99999999999999999999) }), "rango gigante")
afirmar(falla(funcion() { lista_repetir(1, 99999999999999999999) }), "lista_repetir gigante")
afirmar(falla(funcion() { texto_repetir("ab", 4611686018427387903) }), "texto_repetir gigante")
afirmar(falla(funcion() { potencia(10, 4611686018427387903) }), "potencia con demasiadas cifras")
afirmar(falla(funcion() { pbkdf2_sha256("c", "s", 4611686018427387903, 32) }), "pbkdf2 con iteraciones absurdas")
afirmar(a_texto(exponencial(4611686018427387903)) == "inf", "exponencial enorme es infinito")
afirmar(redondear(1.5, 4611686018427387903) == 1.5, "redondear con muchos decimales")

// Bytes más allá de 64 bits: extensión del signo.
afirmar(bytes_entero(-1, 10, 0) == bytes_entero(-1, 2, 0) + bytes_entero(-1, 8, 0), "signo en anchos grandes")
afirmar(bytes_entero(1, 10, 0) == bytes_entero(0, 2, 0) + bytes_entero(1, 8, 0), "ceros en anchos grandes")

// Conexiones y funciones externas: un número cualquiera no se acepta como
// identificador (antes leía memoria ajena).
afirmar(falla(funcion() { tls_enviar(12345, "x") }), "tls_enviar con un número")
afirmar(falla(funcion() { tls_cerrar(nulo) }), "tls_cerrar con nulo")
afirmar(falla(funcion() { tls_version(0) }), "tls_version con 0")
afirmar(falla(funcion() { dotnet_llamar(4096, []) }), "dotnet_llamar con un número")

mostrar("[OK] robustez del runtime")
