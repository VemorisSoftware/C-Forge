sea info = sys_info()

afirmar(longitud(info["sistema"]) > 0, "el nombre del sistema debe existir")
afirmar(longitud(info["cpu"]) > 0, "la arquitectura debe existir")
// El sistema real, no siempre "linux".
sea esperado = "linux"
si (existe_archivo("/System/Library/CoreServices")) { esperado = "macos" }
si ((variable_entorno("OS") ?? "") == "Windows_NT") { esperado = "windows" }
afirmar(info["sistema"] == esperado, "sistema: " + info["sistema"] + " en vez de " + esperado)
afirmar(info["cpu"] == "x86_64" o info["cpu"] == "arm64", "cpu desconocida: " + info["cpu"])
afirmar(longitud(info["plataforma"]) > 0, "plataforma")
afirmar(info["nucleos"] >= 1, "debe existir al menos una CPU")
afirmar(ruta_extension("programa.cfv") == ".cfv", "extensión de ruta incorrecta")
afirmar(ruta_nombre("/tmp/programa.cfv") == "programa.cfv", "nombre de ruta incorrecto")

mostrar("[OK] sistema")
