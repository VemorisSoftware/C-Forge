// ordenar: estable, correcto con números, textos y listas mixtas, y rápido.

funcion ms(f) {
    sea t0 = reloj_ms()
    f()
    retornar reloj_ms() - t0
}

sea semilla = 12345
funcion azar() {
    semilla = (semilla * 1103515245 + 12345) % 2147483648
    retornar semilla
}

// Orden natural de enteros (incluidos los extremos y los grandes).
afirmar(ordenar([5, 4, 3, 2, 1, 0, -1]) == [-1, 0, 1, 2, 3, 4, 5], "enteros")
afirmar(ordenar([4611686018427387903, -4611686018427387904, 0]) == [-4611686018427387904, 0, 4611686018427387903], "extremos")
afirmar(ordenar([3, 99999999999999999999, -99999999999999999999, 2.5]) == [-99999999999999999999, 2.5, 3, 99999999999999999999], "grandes y flotantes")
afirmar(ordenar(["pera", "Manzana", "uva", "pera"]) == ["Manzana", "pera", "pera", "uva"], "textos")
afirmar(ordenar([]) == [], "vacía")
afirmar(ordenar([7]) == [7], "un elemento")

// La lista original no cambia.
sea orig = [3, 1, 2]
sea o = ordenar(orig)
afirmar(orig == [3, 1, 2] y o == [1, 2, 3], "no modifica la original")

// Listas mixtas: orden total por tipo, sin error.
sea m = ordenar([3, "b", nulo, [2], {}, 1.5, verdadero, "a", falso])
afirmar(m[0] == nulo y m[1] == falso y m[2] == verdadero, "mixta: nulo y booleanos primero")
afirmar(m[3] == 1.5 y m[4] == 3 y m[5] == "a" y m[6] == "b", "mixta: números y luego textos")
afirmar(longitud(m) == 9, "mixta: largo")

// Estabilidad con función de comparación y en el orden natural.
sea pares = []
para i en rango(0, 5000) { pares.agregar([azar() % 50, i]) }
sea r = ordenar(pares, funcion(a, b) { retornar a[0] - b[0] })
sea estable = verdadero
para i en rango(1, longitud(r)) {
    si (r[i - 1][0] > r[i][0] o (r[i - 1][0] == r[i][0] y r[i - 1][1] > r[i][1])) { estable = falso }
}
afirmar(estable, "estable con función")
afirmar(ordenar([5, 3, 9, 1], funcion(a, b) { retornar b - a }) == [9, 5, 3, 1], "orden inverso con función")

// Tiempo: 200 mil enteros.
sea l = []
para i en rango(0, 200000) { l.agregar(azar()) }
sea ordenada = nulo
sea tiempo = ms(funcion() { ordenada = ordenar(l) })
sea bien = verdadero
para i en rango(1, longitud(ordenada)) { si (ordenada[i - 1] > ordenada[i]) { bien = falso } }
afirmar(bien y longitud(ordenada) == 200000, "200 mil ordenados")
afirmar(tiempo < 2000, "ordenar 200 mil en tiempo razonable (" + tiempo + " ms)")

mostrar("[OK] ordenar estable")
