// Las funciones del programa tienen prioridad sobre las integradas
// con el mismo nombre (antes 'dividir' llamaba a texto_dividir).
funcion dividir(a, b) {
    retornar a / b
}

funcion contiene(lista, valor) {
    retornar "propia"
}

afirmar(dividir(10, 4) == 2.5, "dividir debe usar la función del programa")
afirmar(contiene([1], 1) == "propia", "contiene debe usar la función del programa")

mostrar("[OK] funciones propias")
