// Parámetros anotados: se comprueban una vez al entrar y, si el cuerpo solo
// les reasigna enteros, sus operaciones se emiten sin volver a comprobarlos.
funcion igual(a, b, que) { afirmar(a == b, que + ": " + a + " != " + b) }

funcion es_primo(n: entero): booleano {
    si (n < 2) { retornar falso }
    sea d: entero = 2
    mientras (d * d <= n) {
        si (n % d == 0) { retornar falso }
        d = d + 1
    }
    retornar verdadero
}
sea primos = 0
para i en rango(2000) { si (es_primo(i)) { primos = primos + 1 } }
igual(primos, 303, "primos < 2000")

funcion ops(a: entero, b: entero) {
    retornar [a + b, a - b, a * b, a % b, a < b, a <= b, a > b, a >= b, a == b, a != b]
}
igual(unir(ops(0 - 7, 3), ","), "-4,-10,-21,-1,verdadero,verdadero,falso,falso,falso,verdadero", "operaciones con negativos")
igual(unir(ops(7, 0 - 3), ","), "4,10,-21,1,falso,falso,verdadero,verdadero,falso,verdadero", "divisor negativo")

// Con valor por defecto: se comprueba después de aplicarlo.
funcion potencia(b: entero, e: entero = 2) {
    sea r = 1
    sea i = 0
    mientras (i < e) {
        r = r * b
        i = i + 1
    }
    retornar r
}
igual(potencia(3), 9, "defecto")
igual(potencia(2, 10), 1024, "argumento")

// Reasignado con algo que no es entero: sigue funcionando (sin probarlo).
funcion mitades(n: entero) {
    sea pasos = 0
    mientras (n > 1) {
        n = n / 2
        pasos = pasos + 1
    }
    retornar pasos
}
igual(mitades(10), 4, "reasignación no entera")

// Error de tipos limpio y capturable al entrar (los literales con el tipo
// equivocado ya los rechaza cforge check antes de ejecutar).
funcion opaco(v) { retornar v }
sea mensaje = ""
intentar { es_primo(opaco(2.5)) } capturar (e) { mensaje = e }
igual(mensaje, "error de tipos: el parámetro n espera entero y recibe numero", "decimal rechazado")
intentar { ops(opaco([1]), 2) } capturar (e) { mensaje = e }
igual(mensaje, "error de tipos: el parámetro a espera entero y recibe lista", "lista rechazada")
// decimal / numero no se comprueban en ejecución (la stdlib los usa
// también para identificadores): solo el verificador de cforge check.
funcion area(r: decimal) { retornar r * r }
igual(area(2), 4, "decimal acepta enteros")
igual(area(1.5), 2.25, "decimal")

// En cierres y métodos.
sea triple = funcion(x: entero) { retornar x * 3 }
igual(triple(14), 42, "cierre")
intentar { triple(opaco("a")) } capturar (e) { mensaje = e }
igual(mensaje, "error de tipos: el parámetro x espera entero y recibe texto", "cierre rechazado")
clase Contador {
    funcion constructor() { esto.total = 0 }
    funcion sumar(k: entero) { esto.total = esto.total + k * 2 }
}
sea c = Contador()
c.sumar(5)
c.sumar(0 - 1)
igual(c.total, 8, "método")
mostrar("[OK] parámetros tipados probados")
