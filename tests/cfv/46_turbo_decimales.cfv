// Modo turbo con decimales, listas como parámetros y funciones chicas en
// línea: los mismos resultados que el modo dinámico en todas las plataformas.

funcion suma(l) {
    sea s = 0
    sea i = 0
    mientras (i < longitud(l)) { s = s + l[i] i += 1 }
    retornar s
}
funcion doblar(l) {
    sea i = 0
    mientras (i < longitud(l)) { l[i] = l[i] * 2 i += 1 }
    retornar 0
}
funcion empujar(l, n) {
    sea i = 0
    mientras (i < n) { l.agregar(i) i += 1 }
    retornar longitud(l)
}
funcion fsuma(l) {
    sea s = 0.0
    sea i = 0
    mientras (i < longitud(l)) { s = s + l[i] i += 1 }
    retornar s
}
funcion escalar(l, k) {
    sea i = 0
    mientras (i < longitud(l)) { l[i] = l[i] * k + 0.5 i += 1 }
    retornar 0
}
funcion muchos(a, b, c, d, e, f, g, h, k) { retornar a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * f + 7 * g + 8 * h + 9 * k }
funcion copiar(a, b) {
    sea i = 0
    mientras (i < longitud(a)) { b[i] = a[i] + 1 i += 1 }
    retornar 0
}
funcion por_uno_y_medio(l, v, n) {
    sea i = 0
    mientras (i < n) { l[i] = v[i] * 1.5 i += 1 }
    retornar 0
}
funcion inverso(i, j) { retornar 1.0 / ((i + j) * (i + j + 1) / 2 + i + 1) }
funcion producto(v, n) {
    sea s = 0.0
    sea i = 0
    mientras (i < n) {
        sea j = 0
        mientras (j < n) { s = s + inverso(i, j) * v[j] j += 1 }
        i += 1
    }
    retornar s
}
funcion distancias(x, y, n) {
    sea t = 0.0
    sea i = 0
    mientras (i < n) {
        sea j = i + 1
        mientras (j < n) {
            sea dx = x[i] - x[j]
            sea dy = y[i] - y[j]
            t = t + raiz(dx * dx + dy * dy)
            j += 1
        }
        i += 1
    }
    retornar t
}
funcion grande(l) {
    sea s = 0.0
    sea i = 0
    mientras (i < longitud(l)) { s = s + l[i] * l[i] i += 1 }
    retornar s
}

sea a = [1, 2, 3, 4]
afirmar(suma(a) == 10, "suma de lista")
doblar(a)
afirmar(a == [2, 4, 6, 8], "lista escrita")
afirmar(empujar(a, 3) == 7, "agregar a un parámetro")
afirmar(a == [2, 4, 6, 8, 0, 1, 2], "lista crecida")
afirmar(suma([1, "x"]) == "1x", "elemento que no es número")
sea f = [0.5, 1.25, 2.0]
afirmar(fsuma(f) == 3.75, "suma decimal")
escalar(f, 2.0)
afirmar(f == [1.5, 3, 4.5], "escalar")
escalar(f, 3)
afirmar(f == [5, 9.5, 14], "escalar por entero")
afirmar(muchos(1, 2, 3, 4, 5, 6, 7, 8, 9) == 285, "nueve parámetros")
afirmar(muchos(1, 2, 3, 4, 5, 6, 7, 8, 9.5) == 289.5, "nueve parámetros con decimal")
sea x = [1, 2, 3]
copiar(x, x)
afirmar(x == [2, 3, 4], "la misma lista dos veces")
sea y = [0, 0, 0]
copiar(x, y)
afirmar(y == [3, 4, 5], "dos listas")
sea z = lista_repetir(0.0, 3)
por_uno_y_medio(z, [1, 2.5, 4], 3)
afirmar(z == [1.5, 3.75, 6], "lista mixta")
afirmar(fsuma([1, 2, 3]) == 6, "lista de enteros como decimales")
afirmar(fsuma([]) == 0, "lista vacía")
sea v = lista_repetir(1.0, 50)
afirmar(redondear(producto(v, 50), 9) == 8.322066805, "en línea")
afirmar(redondear(distancias([0.0, 3.0, 0.0], [0.0, 4.0, 1.5], 3), 9) == redondear(5 + 1.5 + raiz(9 + 6.25), 9), "raíces")
// enteros grandes: mismos resultados que la dinámica (exactos)
afirmar(grande([4503599627370497, 1]) == 4503599627370497 * 4503599627370497 + 1, "enteros grandes")
afirmar(grande([94906267, 1]) == 94906267 * 94906267 + 1, "producto grande")
sea mensaje = ""
intentar { suma(5) } capturar (e) { mensaje = e }
afirmar(texto_contiene(mensaje, "longitud"), "no es lista")

// x += k justo después de una división (modo dinámico)
sea q = 9
q = q / 3
sea cuenta = 0
cuenta += 1
afirmar(cuenta == 1, "+= tras una división")
funcion tras_division(n) {
    sea s = 0
    sea i = 0
    mientras (i < n) {
        s = s / 6
        i += 1
    }
    retornar i
}
afirmar(tras_division(4) == 4, "ciclo con división y +=")

mostrar("[OK] turbo con decimales")
