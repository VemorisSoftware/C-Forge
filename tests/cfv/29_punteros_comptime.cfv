// Punteros seguros (*T nunca nulo, ?T se comprueba antes de usarlo),
// comptime (ejecución al compilar) y genéricos comptime T.
funcion igual(a, b, que) { afirmar(a == b, que + ": " + a + " != " + b) }

clase Nodo {
    funcion constructor(valor) {
        esto.valor = valor
        esto.siguiente = nulo
    }
}

funcion buscar(inicio: *Nodo, x: entero): ?*Nodo {
    sea n: ?*Nodo = inicio
    mientras (n != nulo) {
        si (n) |nodo| {
            si (nodo.valor == x) { retornar nodo }
            n = nodo.siguiente
        }
    }
    retornar nulo
}

funcion valor_de(n: *Nodo): entero { retornar n.valor }

sea a: *Nodo = Nodo(1)
a.siguiente = Nodo(2)
a.siguiente.siguiente = Nodo(3)
sea r = buscar(a, 3)
sea visto = 0
si (r) |nodo| { visto = valor_de(nodo) }
igual(visto, 3, "desempaque")
si (r != nulo) { igual(r.valor, 3, "estrechamiento con != nulo") }
sea q: ?*Nodo = buscar(a, 9)
sea rama = "si"
si (q) |n| { rama = "no" } sino { rama = "sino" }
igual(rama, "sino", "opcional nulo")

funcion fib(n) {
    si (n < 2) { retornar n }
    retornar fib(n - 1) + fib(n - 2)
}
funcion cuadrados(n) {
    sea r = []
    para i en rango(n) { r.agregar(i * i) }
    retornar r
}
sea N = 6
igual(comptime(fib(25)), 75025, "comptime con recursión")
igual(longitud(comptime(cuadrados(N))), 6, "comptime con una constante")
igual(comptime(cuadrados(N))[5], 25, "lista calculada al compilar")
sea config = comptime {
    sea m = {"nombre": "C-Forge", "version": 42, "pi": 2.5, "ok": verdadero, "nada": nulo}
    m["texto"] = "a\{b}\n\"c\"\\"
    retornar m
}
igual(config["nombre"], "C-Forge", "mapa: texto")
igual(config["version"] + 1, 43, "mapa: entero")
igual(config["pi"] * 2, 5, "mapa: flotante")
afirmar(config["ok"] y config["nada"] == nulo, "mapa: booleano y nulo")
igual(config["texto"], "a\{b}\n\"c\"\\", "escapes del literal")

funcion maximo(comptime T, x: T, y: T): T {
    si (x > y) { retornar x }
    retornar y
}
sea m: entero = maximo(entero, 4, 9)
igual(m, 9, "comptime T con enteros")
igual(maximo(texto, "pera", "kiwi"), "pera", "comptime T con textos")
funcion nombre_de(comptime T) { retornar T }
igual(nombre_de(numero), "numero", "T es el nombre del tipo")

mostrar("[OK] punteros seguros, comptime y genéricos comptime T")
