// Funciones con parámetros y resultado i64 (compiladas con registros en
// x86-64): exactamente los mismos resultados que el modo dinámico, también
// cuando un valor se sale de i64 o llega un argumento que no es entero.

funcion fib(n: i64): i64 {
    si (n < 2) { retornar n }
    retornar fib(n - 1) + fib(n - 2)
}

funcion mcd(a: i64, b: i64): i64 {
    mientras (b != 0) {
        sea t: i64 = a % b
        a = b
        b = t
    }
    retornar a
}

// Más variables que registros: algunas viven en el marco.
funcion muchas(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64): i64 {
    sea x = a + b * c - d
    sea y = (e - f) * (a + 1)
    sea z = x * 2 + y % 7
    sea w = z - 3
    retornar x + y + z + w + mcd(a + 100, b + 60)
}

funcion bucles(n: i64): i64 {
    sea s = 0
    sea i = 0
    mientras (i < n) {
        i += 1
        si (i % 3 == 0) { continuar }
        si (i > 50 y i % 2 == 0 o i == 7) { s -= i } sino si (no (i < 10)) { s += i * 2 } sino { s += 1 }
        si (s > 100000) { romper }
    }
    retornar s
}

funcion restos(a: i64, b: i64): i64 {
    retornar a % b + a % 7 + a % 1000000007 + a % 8 + a % 1 + (0 - a) % 13
}

funcion grande(n: i64): i64 { retornar n * 1000000000 }
funcion neg(n: i64): i64 { retornar -n + -(n - 5) }
funcion profunda(n: i64): i64 {
    si (n == 0) { retornar 0 }
    retornar profunda(n - 1) + 1
}

// Una que no es turbo (usa mostrar) sigue igual.
funcion con_texto(n: i64): i64 {
    mostrar("n = " + n)
    retornar n
}

afirmar([fib(20), mcd(1071, 462), mcd(0 - 48, 18), muchas(3, 4, 5, 6, 7, 8), bucles(1000), bucles(10)] == [6765, 21, 6, 71, 101088, 18], "resultados")
afirmar([restos(12345, 97), restos(0 - 12345, 97), restos(0 - 9, 4), neg(10)] == [12368, 0 - 12368, 0 - 4, 0 - 15], "restos y negativos")
afirmar([grande(1000000000), grande(0 - 3)] == [1000000000000000000, 0 - 3000000000], "productos grandes")
afirmar(restos(4611686018427387903, 3) == 145586008, "extremo de 62 bits")
afirmar(con_texto(5) == 5, "función no turbo")

sea f = fib
afirmar(f(15) == 610, "como valor")

// Fuera de i64: el resultado es el entero grande de siempre.
afirmar(grande(9000000000000) == 9000000000000000000000, "desborde da entero grande")
afirmar(mcd(7540113804746346429, 4660046610375530309) == 1, "valores grandes de i64")
sea mensaje = ""
intentar { restos(5, 0) } capturar (e) { mensaje = e }
afirmar(texto_contiene(mensaje, "división por cero"), "división por cero")
// Argumentos que no son enteros chicos: como en el modo dinámico.
afirmar(fib(1.5) == 1.5, "decimal")
mensaje = ""
intentar { mcd("x", 2) } capturar (e) { mensaje = e }
afirmar(mensaje != "", "texto da el mismo error que siempre")
afirmar(profunda(10000) == 10000, "recursión")

// Rapidez: 100 millones de vueltas en poco tiempo.
funcion suma(n: i64): i64 {
    sea s: i64 = 0
    sea i: i64 = 0
    mientras (i < n) {
        s = s + i % 7
        i = i + 1
    }
    retornar s
}
sea t0 = reloj_ms()
afirmar(suma(100000000) == 299999995, "suma")
afirmar(reloj_ms() - t0 < 5000, "bucle i64 rápido (" + (reloj_ms() - t0) + " ms)")

mostrar("[OK] funciones i64")
