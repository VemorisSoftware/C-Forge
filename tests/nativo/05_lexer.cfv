// Prueba: el lexer nativo escribe sus tokens ("TIPO lexema línea").
sea fuente = archivo_leer(rt_argumento(1))
sea tokens = tokenizar(fuente)
sea salida = str_nuevo(0)
sea i = 0
mientras (i < vec_largo(tokens)) {
    sea t = vec_obtener(tokens, i)
    str_agregar(salida, nombre_tipo(__cargar64(t)))
    str_agregar_byte(salida, 32)
    str_agregar(salida, __cargar64(t + 8))
    str_agregar_byte(salida, 32)
    str_agregar(salida, str_desde_entero(__cargar64(t + 16)))
    str_agregar_byte(salida, 10)
    i = i + 1
}
archivo_escribir(rt_argumento(2), salida)
mostrar(str_concatenar("tokens: ", str_desde_entero(vec_largo(tokens))))
