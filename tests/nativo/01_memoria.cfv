// Gestor de memoria: reservar, liberar y reutilizar bloques.
sea a = mem_reservar(100)
mem_llenar(a, 7, 100)
si (__cargar8(a + 99) != 7) { rt_panico("llenado incorrecto") }
mem_liberar(a)
sea b = mem_reservar(100)
si (b != a) { rt_panico("la lista libre no reutilizó el bloque") }
sea grande = mem_reservar(1000000)
mem_llenar(grande, 1, 1000000)
mem_liberar(grande)
sea i = 0
mientras (i < 100000) {
    sea p = mem_reservar(48)
    mem_liberar(p)
    i = i + 1
}
mem_liberar(b)
si (mem_en_uso() != 0) { rt_panico("quedó memoria en uso") }
mostrar("[OK] memoria")
