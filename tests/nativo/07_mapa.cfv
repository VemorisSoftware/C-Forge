// runtime/map.cfv: 100 000 claves, crecimiento, lápidas y orden de inserción.
funcion clave(i) { retornar str_concatenar("k", str_desde_entero(i)) }

sea m = map_nuevo()
sea n = 100000
sea i = 0
mientras (i < n) {
    map_fijar(m, clave(i), i * 3)
    i = i + 1
}
mostrar(str_concatenar("tamaño: ", str_desde_entero(map_tamano(m))))
sea errores = 0
i = 0
mientras (i < n) {
    si (map_obtener(m, clave(i)) != i * 3) { errores = errores + 1 }
    i = i + 1
}
i = 0
mientras (i < n) {
    map_quitar(m, clave(i))
    i = i + 2
}
i = 0
mientras (i < n) {
    sea esta = map_tiene(m, clave(i))
    si (i % 2 == 0 y esta) { errores = errores + 1 }
    si (i % 2 == 1 y esta == 0) { errores = errores + 1 }
    i = i + 1
}
map_fijar(m, "k1", 7)
si (map_obtener_o(m, "nada", 0 - 5) != 0 - 5) { errores = errores + 1 }
mostrar(str_concatenar("tras borrar: ", str_desde_entero(map_tamano(m))))
mostrar(str_concatenar("k1 = ", str_desde_entero(map_obtener(m, "k1"))))
sea ks = map_claves(m)
mostrar(str_concatenar("primera clave: ", vec_obtener(ks, 0)))
mostrar(str_concatenar("errores: ", str_desde_entero(errores)))
