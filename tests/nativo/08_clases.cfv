// Clases del lenguaje completo compiladas por cforge_self.
// La salida esperada es la del intérprete de referencia.

interfaz Hablante { hablar() }

clase Animal implementa Hablante {
    sea nombre = "sin nombre"
    sea patas = 4
    privado sea secreto = 7

    funcion constructor(n) { esto.nombre = n }
    funcion hablar() { retornar esto.nombre + " hace ruido" }
    funcion describir() { retornar esto.hablar() + " (" + esto.patas + " patas)" }
}

clase Perro extiende Animal {
    sea trucos = []
    funcion hablar() { retornar esto.nombre + " ladra" }
    funcion aprender(truco) {
        esto.trucos.agregar(truco)
        retornar esto
    }
}

clase Pato extiende Animal {
    funcion constructor(n) {
        esto.nombre = n
        esto.patas = 2
    }
    funcion hablar() { retornar super.hablar() + " (cuac)" }
}

estructura Punto { x: numero y: numero }

clase Cuenta {
    sea saldo = 0
    sea movimientos = {"depositos": 0}
    funcion depositar(monto) {
        esto.saldo += monto
        esto.movimientos["depositos"] += 1
    }
}

sea animales = [Animal("gato"), Perro("rex"), Pato("donald")]
para a en animales { mostrar(a.describir()) }

sea p = Perro("fido")
p.aprender("sentarse").aprender("rodar")
mostrar(p.trucos)
mostrar(longitud(p.trucos))
p.edad = 3
mostrar(p.edad + 1)
mostrar(p)

sea q = Punto(3, 4)
mostrar(q.x * q.x + q.y * q.y)
q.x = 10
mostrar(q)

sea c = Cuenta()
c.depositar(50)
c.depositar(25)
mostrar(c.saldo)
mostrar(c.movimientos)

sea d = Pato("lucas")
mostrar(d.hablar())
mostrar(d.patas)

class Box {
    let value = 0
    function constructor(v) { this.value = v }
    function doubled() { return this.value * 2 }
}
let b = Box(21)
print(b.doubled())
