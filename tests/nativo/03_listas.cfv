// Listas dinámicas que crecen.
sea v = vec_nuevo()
sea i = 0
mientras (i < 100000) {
    vec_agregar(v, i * 2)
    i = i + 1
}
si (vec_largo(v) != 100000) { rt_panico("largo incorrecto") }
si (vec_obtener(v, 99999) != 199998) { rt_panico("valor incorrecto") }
vec_fijar(v, 0, 7)
si (vec_quitar_ultimo(v) != 199998) { rt_panico("quitar incorrecto") }
mostrar(str_desde_entero(vec_obtener(v, 0) + vec_largo(v)))
mostrar("[OK] listas")
