// Hilos nativos (clone), mutex y canales (futex), errores propagados por esperar.
sea canal = canal_nuevo(2)
sea m = mutex_crear()
sea total = {"n": 0}
sea trabajadores = []
para id en rango(4) {
    trabajadores.agregar(tarea(funcion() {
        sea i = 0
        mientras (i < 1000) {
            mutex_bloquear(m)
            total["n"] = total["n"] + 1
            mutex_desbloquear(m)
            i += 1
        }
        canal_enviar(canal, "hilo listo")
        retornar id * 10
    }))
}
sea recibidos = 0
mientras (recibidos < 4) {
    canal_recibir(canal)
    recibidos += 1
}
sea resultados = []
para t en trabajadores { resultados.agregar(esperar(t)) }
mostrar(resultados)
mostrar(total["n"])
sea falla = tarea(funcion() { lanzar "explotó en el hilo" })
intentar { esperar(falla, 1000) } capturar (e) { mostrar("capturado: " + e) }
