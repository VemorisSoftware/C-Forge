// Listas y mapas del lenguaje completo compilados por cforge_self (sin intérprete).
// La salida esperada es la del intérprete de referencia.

funcion cuadrados(n) {
    sea r = []
    para i en lista_rango(0, n) { r.agregar(i * i) }
    retornar r
}

funcion contar_palabras(texto) {
    sea conteo = {}
    sea actual = ""
    para letra en texto + " " {
        si (letra == " ") {
            si (longitud(actual) > 0) {
                si (tiene_clave(conteo, actual)) {
                    conteo[actual] = conteo[actual] + 1
                } sino {
                    conteo[actual] = 1
                }
            }
            actual = ""
        } sino {
            actual = actual + letra
        }
    }
    retornar conteo
}

sea l = [3, 1, 4, 1, 5]
mostrar(l)
mostrar(longitud(l))
l[0] = 9
agregar(l, 2)
mostrar(l)
mostrar(l[2] + l[4])
mostrar(cuadrados(6))

sea m = {"nombre": "C-Forge", "version": 3, "nativo": verdadero}
mostrar(m)
m["version"] = m["version"] + 1
m["lista"] = [1, [2, 3], {"x": nulo}]
mostrar(m["lista"][1][0])
mostrar(m)
mostrar(claves(m))
mostrar(contar_palabras("el sol y el mar y el cielo"))

sea anidado = [[1, 2], [3, 4]]
anidado[1][0] = 30
mostrar(anidado)

sea total = 0
sea i = 0
mientras (verdadero) {
    i += 1
    si (i > 10) { romper }
    si (i % 2 == 0) { continuar }
    total += i
}
mostrar(total)

para x en [10, 20, 30] {
    si (x == 20) { continuar }
    mostrar("x = " + x)
}

mostrar(7 / 2)
mostrar(6 / 2)
mostrar(1 + 2.5)
mostrar(0.1 + 0.2)
mostrar(-7 % 3)
mostrar(10 / 4 * 2)
mostrar(piso(3.7))
mostrar(a_numero("41") + 1)
mostrar("hola"[1])
mostrar("b" < "c")
mostrar(1 == "1")
mostrar([1, 2] == [1, 2])
mostrar(no falso y verdadero)
mostrar(lista_contiene(l, 5))

sea nota = 72
si (nota >= 90) {
    mostrar("A")
} sino si (nota >= 70) {
    mostrar("B")
} sino {
    mostrar("C")
}
