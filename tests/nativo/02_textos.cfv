// Textos dinámicos: crecer, concatenar, rebanar, comparar y convertir.
sea s = str_nuevo(0)
sea i = 0
mientras (i < 1000) {
    str_agregar_byte(s, 97 + i % 26)
    i = i + 1
}
si (str_largo(s) != 1000) { rt_panico("largo incorrecto") }
si (str_igual(str_rebanar(s, 0, 3), "abc") == 0) { rt_panico("rebanar incorrecto") }
sea saludo = str_concatenar("Hola, ", "C-Forge")
mostrar(saludo)
mostrar(str_desde_entero(0))
mostrar(str_desde_entero(-12345))
mostrar(str_desde_entero(9007199254))
mostrar(str_desde_f64(f64_desde_fraccion(7, 2)))
mostrar(str_desde_f64(f64_desde_fraccion(1, 3)))
mostrar(str_desde_f64(f64_desde_fraccion(-305, 100)))
mostrar(str_desde_f64(f64_desde_entero(42)))
mostrar(str_desde_f64(__f64_div(f64_desde_entero(1), f64_desde_entero(0))))
mostrar("[OK] textos")
