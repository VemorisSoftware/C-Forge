// Prueba de fuego: lee un .cfv, separa líneas en una lista, procesa texto,
// calcula un promedio decimal y escribe un archivo. Todo sin libc.
sea entrada = rt_argumento(1)
sea salida = rt_argumento(2)
sea contenido = archivo_leer(entrada)
sea lineas = vec_nuevo()
sea actual = str_nuevo(0)
sea i = 0
mientras (i < str_largo(contenido)) {
    sea b = str_byte(contenido, i)
    si (b == 10) {
        vec_agregar(lineas, actual)
        actual = str_nuevo(0)
    } sino {
        str_agregar_byte(actual, b)
    }
    i = i + 1
}
si (str_largo(actual) > 0) { vec_agregar(lineas, actual) }
sea reporte = str_nuevo(0)
sea total = 0
sea n = 0
mientras (n < vec_largo(lineas)) {
    sea linea = vec_obtener(lineas, n)
    str_agregar(reporte, str_desde_entero(n + 1))
    str_agregar(reporte, ": ")
    str_agregar(reporte, linea)
    str_agregar(reporte, " (")
    str_agregar(reporte, str_desde_entero(str_largo(linea)))
    str_agregar(reporte, ")\n")
    total = total + str_largo(linea)
    n = n + 1
}
str_agregar(reporte, "promedio: ")
str_agregar(reporte, str_desde_f64(f64_desde_fraccion(total, vec_largo(lineas))))
str_agregar(reporte, "\n")
archivo_escribir(salida, reporte)
mostrar(str_concatenar("lineas: ", str_desde_entero(vec_largo(lineas))))
