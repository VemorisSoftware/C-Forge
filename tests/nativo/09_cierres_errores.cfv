// Funciones anónimas, globales y manejo de errores compilados por cforge_self.
// La salida esperada es la del intérprete de referencia.

sea prefijo = "> "

funcion contador() {
    sea n = 0
    retornar funcion() {
        n = n + 1
        retornar n
    }
}

funcion componer(f, g) {
    retornar funcion(x) { retornar f(g(x)) }
}

funcion doble(x) { retornar x * 2 }

funcion dividir_seguro(a, b) {
    intentar {
        retornar a / b
    } capturar (e) {
        retornar "error capturado"
    }
}

funcion validar(edad) {
    si (edad < 0) { lanzar "edad negativa" }
    retornar edad
}

sea c1 = contador()
sea c2 = contador()
c1()
c1()
mostrar(prefijo + c1())
mostrar(prefijo + c2())

sea mas_uno = funcion(x) { retornar x + 1 }
sea f = componer(doble, mas_uno)
mostrar(f(20))

sea fib = funcion(n) {
    si (n < 2) { retornar n }
    retornar fib(n - 1) + fib(n - 2)
}
mostrar(fib(20))

funcion acumuladores() {
    sea total = 0
    sea sumar = funcion(x) { total = total + x }
    sea leer = funcion() { retornar total }
    sumar(5)
    sumar(7)
    retornar leer()
}
mostrar(acumuladores())

mostrar(mapear([1, 2, 3], funcion(x) { retornar x * x }))
mostrar(filtrar([1, 2, 3, 4, 5, 6], funcion(x) { retornar x % 2 == 0 }))

mostrar(dividir_seguro(10, 4))
mostrar(dividir_seguro(1, 0))

intentar {
    validar(5)
    validar(-1)
    mostrar("no llega")
} capturar (e) {
    mostrar("capturado: " + e)
}

intentar {
    sea x = [1, 2][5]
} capturar (e) {
    mostrar("índice: " + e)
}

sea pasos = []
intentar {
    pasos.agregar("intento")
    lanzar {"codigo": 42}
} capturar (e) {
    pasos.agregar("captura " + e)
} finalmente {
    pasos.agregar("final")
}
mostrar(pasos)

sea vueltas = 0
mientras (verdadero) {
    intentar {
        vueltas = vueltas + 1
        si (vueltas == 3) { romper }
    } capturar (e) {
        mostrar("no debería pasar")
    }
}
mostrar(vueltas)

intentar {
    lanzar "afuera"
} capturar (e) {
    mostrar("la pila de manejadores quedó limpia: " + e)
}

sea opcional = nulo
mostrar(opcional ?? "por defecto")
mostrar(0 ?? "cero no es nulo")
