// extern nativo: el ejecutable se enlaza dinámicamente con libc y libm
// (PT_INTERP, PT_DYNAMIC, GOT) sin gcc ni ld.
extern "libc" funcion strlen(s: texto): largo
extern "libc" funcion atoi(s: texto): entero
extern "libc" funcion abs(n: entero): entero
extern "libc" funcion toupper(c: entero): entero
extern "libc" funcion write(fd: entero, s: texto, n: largo): largo
extern "libc" funcion strstr(pajar: texto, aguja: texto): texto
extern "libm" funcion sqrt(x: numero): numero
extern "libm" funcion pow(base: numero, exponente: numero): numero
extern "libm" funcion fmax(a: numero, b: numero): numero
extern "libm" funcion hypot(a: numero, b: numero): numero

mostrar(strlen("C-Forge sin C++"))
mostrar(atoi("2026") + 1)
mostrar(abs(-42))
mostrar(caracter(toupper(99)))
write(1, "write() de libc\n", 16)
mostrar(strstr("lenguaje C-Forge", "C-F"))
mostrar(strstr("abc", "z"))
mostrar(sqrt(2))
mostrar(pow(2, 10))
mostrar(fmax(1.5, -3))
mostrar(hypot(3, 4))

intentar {
    extern "libc" funcion simbolo_que_no_existe_cforge(): entero
    mostrar("no debería llegar")
} capturar (e) {
    mostrar(e)
}
