// tests/memoria/arena_llena.cfv — regresión: con una arena de 64 MiB llena
// del todo, limpiar su mapa de marcas no debe pisar el primer bloque de la
// arena vecina (antes se escribía un byte de más y el barrido se descarrilaba).
sea vivos = []
sea i = 0
mientras (i < 900000) {
    vivos.agregar("dato " + i)
    i = i + 1
}
// Basura temporal para forzar varias recolecciones con las arenas llenas.
sea j = 0
mientras (j < 300000) {
    sea t = texto_dividir("a b c " + j, " ")
    j = j + 1
}
sea k = 0
sea bien = 1
mientras (k < 900000) {
    si (vivos[k] != "dato " + k) { bien = 0 }
    k = k + 1
}
sea m = memoria_estadisticas()
afirmar(m["recolecciones"] > 0, "hubo recolecciones")
afirmar(bien == 1, "los datos vivos siguen intactos")
mostrar("[OK] memoria: arenas llenas sin corrupción")
