// tests/memoria — el recolector mantiene acotada la memoria de un programa
// largo: 2 millones de iteraciones creando textos y listas temporales
// (sin recolector: ~1,7 GB).
sea vivos = []
sea i = 0
mientras (i < 2000000) {
    sea t = "solicitud " + i + " /api/usuarios"
    sea partes = texto_dividir(t, " ")
    si (i % 100000 == 0) { vivos.agregar(partes[1]) }     // datos que sí se conservan
    i = i + 1
}
sea m = memoria_estadisticas()
afirmar(m["recolector"], "el recolector está activo")
afirmar(m["recolecciones"] > 10, "hubo recolecciones")
afirmar(m["arena"] < 50000000, "arena < 50 MB: " + m["arena"])
afirmar(longitud(vivos) == 20 y vivos[19] == "1900000", "lo que sigue en uso no se libera")
mostrar("[OK] memoria: 2 M iteraciones con arena < 50 MB")
