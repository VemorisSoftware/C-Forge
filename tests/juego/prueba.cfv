// tests/juego — física 2D/3D, colisiones, entrada y partículas. Resultados
// deterministas (mismos números en todas las plataformas).
importar "fisica2d"
importar "fisica3d"
importar "colision"
importar "input"
importar "particulas"

funcion r2(v) { retornar redondear(v * 100) / 100 }

// ── Física 2D: pila de cajas, rampa, contactos y raycast ──
sea mundo = f2d_mundo_crear(0, 0 - 10)
sea choques = 0
mundo["al_chocar"] = funcion(a, b, k) { choques = choques + 1 }
sea suelo = f2d_cuerpo_crear(0, 0, 0, "estatico")
f2d_agregar_shape(suelo, shape_caja(40, 1))
f2d_agregar_cuerpo(mundo, suelo)
sea pila = []
para i en rango(4) {
    sea c = f2d_cuerpo_crear(0, 1 + i * 1.02, 1)
    c["friccion"] = 0.6
    c["rebote"] = 0
    f2d_agregar_shape(c, shape_caja(1, 1))
    f2d_agregar_cuerpo(mundo, c)
    agregar(pila, c)
}
sea rampa = f2d_cuerpo_crear(10, 0.5, 0, "estatico")
f2d_agregar_shape(rampa, shape_poligono([[0 - 4, 0], [4, 0], [0 - 4, 3]]))
f2d_agregar_cuerpo(mundo, rampa)
sea bola = f2d_cuerpo_crear(7, 4.5, 1)
f2d_agregar_shape(bola, shape_circulo(0.5))
f2d_agregar_cuerpo(mundo, bola)
para i en rango(180) { f2d_paso(mundo, 1 / 60) }
para c en pila { mostrar("caja: y " + r2(c["pos"]["y"]) + " giro " + (absoluto(c["angulo"]) < 0.05)) }
mostrar("bola: rodó a x " + r2(bola["pos"]["x"]) + ", rodando sin deslizar " + (absoluto(bola["vel"]["x"] + bola["vel_angular"] * 0.5) < 0.1))
mostrar("contactos en el último paso: " + longitud(mundo["contactos"]) + ", avisos " + (choques > 0))
sea rayo = f2d_raycast(mundo, vec2(0, 20), vec2(0, 0 - 1), 100)
mostrar("rayo 2D: golpea la caja de arriba " + (rayo["cuerpo"]["id"] == pila[3]["id"]) + " a " + r2(rayo["distancia"]) + " normal " + r2(rayo["normal"]["y"]))
mostrar("rayo 2D al vacío: " + f2d_raycast(mundo, vec2(0, 20), vec2(0, 1), 100))
intentar { shape_poligono([[0, 0], [2, 0], [1, 0.2], [1, 2]]) } capturar (e) { mostrar(e) }
// Círculo contra círculo: conservación del momento en choque elástico.
sea m2 = f2d_mundo_crear(0, 0)
sea a = f2d_cuerpo_crear(0, 0, 1)
sea b = f2d_cuerpo_crear(3, 0, 1)
a["rebote"] = 1
b["rebote"] = 1
f2d_agregar_shape(a, shape_circulo(0.5))
f2d_agregar_shape(b, shape_circulo(0.5))
a["vel"]["x"] = 4
f2d_agregar_cuerpo(m2, a)
f2d_agregar_cuerpo(m2, b)
para i en rango(60) { f2d_paso(m2, 1 / 60) }
mostrar("choque elástico: va " + r2(a["vel"]["x"]) + " vb " + r2(b["vel"]["x"]) + " momento " + r2(a["vel"]["x"] + b["vel"]["x"]))

// ── Física 3D ──
sea m3 = f3d_mundo_crear()
sea piso3 = f3d_cuerpo_crear(0, 0, 0, 0)
f3d_agregar_forma(piso3, forma_plano(0, 1, 0, 0))
f3d_agregar_cuerpo(m3, piso3)
sea esfera = f3d_cuerpo_crear(0, 5, 0, 1)
esfera["rebote"] = 0.5
f3d_agregar_forma(esfera, forma_esfera(0.5))
f3d_agregar_cuerpo(m3, esfera)
sea caja1 = f3d_cuerpo_crear(3, 0.6, 0, 1)
f3d_agregar_forma(caja1, forma_caja(1, 1, 1))
f3d_agregar_cuerpo(m3, caja1)
sea caja2 = f3d_cuerpo_crear(3, 2, 0, 1)
f3d_agregar_forma(caja2, forma_caja(1, 1, 1))
f3d_agregar_cuerpo(m3, caja2)
sea deslizante = f3d_cuerpo_crear(0 - 3, 0.5, 0, 1)
f3d_agregar_forma(deslizante, forma_caja(1, 1, 1))
deslizante["vel"]["x"] = 0 - 3
f3d_agregar_cuerpo(m3, deslizante)
sea alto_max = 0
para i en rango(240) {
    f3d_paso(m3, 1 / 60)
    si (i > 70) { alto_max = maximo(alto_max, esfera["transform"]["pos"]["y"]) }
}
mostrar("esfera: reposa en y " + r2(esfera["transform"]["pos"]["y"]) + ", rebote máx " + r2(alto_max))
mostrar("cajas apiladas: y " + r2(caja1["transform"]["pos"]["y"]) + " y " + r2(caja2["transform"]["pos"]["y"]))
mostrar("caja con fricción: frenó en x " + r2(deslizante["transform"]["pos"]["x"]) + " vx " + r2(deslizante["vel"]["x"]))
sea r3 = f3d_raycast(vec3(3, 10, 0), vec3(0, 0 - 1, 0), m3["cuerpos"])
mostrar("rayo 3D: caja de arriba " + (r3["cuerpo"]["id"] == caja2["id"]) + " a " + r2(r3["distancia"]))

// ── Colisiones geométricas y quadtree ──
mostrar("rect-rect: " + col_rect_rect(col_rect(0, 0, 10, 10), col_rect(5, 5, 10, 10)) + " " + col_rect_rect(col_rect(0, 0, 10, 10), col_rect(20, 0, 5, 5)))
mostrar("punto en polígono: " + col_punto_en_poligono(1, 1, [{"x": 0, "y": 0}, {"x": 4, "y": 0}, {"x": 0, "y": 4}]))
sea qt = quadtree_crear(0, 0, 100, 100, 5, 4)
para i en rango(40) { quadtree_insertar(qt, i, (i * 37) % 100, (i * 53) % 100, 2, 2) }
mostrar("quadtree: " + longitud(quadtree_consultar(qt, 0, 0, 50, 50)) + " objetos en el cuadrante")

// ── Entrada ──
input_mapear("saltar", [44])
input_tecla_presionar(44)
mostrar("acción saltar: " + input_accion("saltar") + ", recién presionada " + input_recien_presionada(44))
input_actualizar()
mostrar("tras actualizar: recién " + input_recien_presionada(44) + ", sigue presionada " + input_presionada(44))
input_tecla_soltar(44)
mostrar("soltada: " + input_presionada(44) + ", recién soltada " + input_recien_soltada(44))

// ── Partículas ──
sea em = emisor_crear(0, 0, {"tasa": 0, "vida_min": 0.5, "vida_max": 0.5})
emisor_rafaga(em, 30)
mostrar("partículas: " + emisor_contar(em))
para i en rango(60) { emisor_actualizar(em, 1 / 60) }
mostrar("tras 1 s (vida 0,5 s): " + emisor_contar(em))
mostrar("[OK] física, colisiones, entrada y partículas")
