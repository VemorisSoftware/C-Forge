// tests/sdl — ventana SDL2 real (driver dummy o Xvfb), lienzo y texto de
// C-Forge subidos como texturas, imágenes sin SDL_image y audio por el
// dispositivo de SDL (driver "disk" en CI: se verifica lo que sale).
importar "juego"
importar "audio"

sea j = motor_crear("C-Forge SDL", 160, 120, 60)
sea l = lienzo_crear(160, 120)
lienzo_limpiar(l, [10, 20, 30])
lienzo_circulo(l, 80, 60, 30, [250, 200, 0])
motor_limpiar(j, 0, 0, 0)
motor_dibujar_lienzo(j, l)
motor_texto(j, fuente_basica(), "SDL", 4, 4, 12, [255, 255, 255])
sea cap = motor_capturar(j)
mostrar("lienzo en pantalla: " + imagen_pixel(cap, 80, 60) + " " + imagen_pixel(cap, 150, 110))
sea claros = 0
para y en rango(16) { para x en rango(20) { si (imagen_pixel(cap, 4 + x, 4 + y)[0] > 200) { claros = claros + 1 } } }
mostrar("texto dibujado: " + (claros > 10))
sea img = imagen_nueva(4, 4, [255, 0, 0])
escribir_archivo("cforge-sdl-prueba.png", imagen_codificar_png(img))
sea tex = motor_textura(j, "cforge-sdl-prueba.png")
motor_dibujar(j, tex, 0, 0, 40, 40)
mostrar("textura PNG sin SDL_image: " + imagen_pixel(motor_capturar(j), 10, 10))
eliminar_archivo("cforge-sdl-prueba.png")
motor_presentar(j)

// Audio real: 200 ms de tono por el dispositivo.
audio_iniciar(44100, 50)
audio_registrar_sonido("la", sonido_tono(440, 200), "sfx")
audio_reproducir("la", {"volumen": 1})
sea fin = reloj_ms() + 600
mientras (reloj_ms() < fin) {
    audio_actualizar(0.01)
    dormir(5)
}
mostrar("audio terminado: " + (audio_canales_activos() == 0))
audio_cerrar()
motor_cerrar(j)
mostrar("[OK] SDL: ventana, texturas, texto y audio")
