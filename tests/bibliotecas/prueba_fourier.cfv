importar "fourier"
funcion cerca(a, b, tol, q) { afirmar(absoluto(a - b) < tol, q + ": " + a + " != " + b) }
// Referencia: numpy.fft.fft([1, 2, 3, 4, 5]).
sea x = fourier_fft([1, 2, 3, 4, 5])
cerca(x[0][0], 15, 0.0000001, "DC")
cerca(x[1][0], -2.5, 0.0000001, "re[1]")
cerca(x[1][1], 3.4409548011779334, 0.0000001, "im[1]")
cerca(x[2][1], 0.8122992405822659, 0.0000001, "im[2]")
sea y = fourier_ifft(x)
sea i = 0
mientras (i < 5) { cerca(y[i][0], i + 1, 0.0000001, "inversa " + i)  i = i + 1 }
sea z = fourier_fft([[0, 1], [1, 0], [0, -1]])
cerca(z[0][0], 1, 0.0000001, "complejos de largo 3")
sea p2 = fourier_fft([1, 0, 0, 0, 0, 0, 0, 0])
cerca(p2[5][0], 1, 0.0000001, "potencia de 2")
cerca(fourier_dominante(fourier_tono(440, 8000, 0.5), 8000), 440, 0.5, "440 Hz")
cerca(fourier_dominante(fourier_tono(1234.5, 22050, 0.3), 22050), 1234.5, 1, "1234.5 Hz")
sea mezcla = []
sea a = fourier_tono(50, 1000, 1)
sea b = fourier_tono(200, 1000, 1, 0.5)
i = 0
mientras (i < longitud(a)) { mezcla.agregar(a[i] + b[i])  i = i + 1 }
sea e = fourier_espectro(mezcla, 1000)
cerca(e["magnitudes"][50], 1, 0.01, "amplitud del 50 Hz")
cerca(e["magnitudes"][200], 0.5, 0.01, "amplitud del 200 Hz")
cerca(e["frecuencias"][200], 200, 0.0000001, "eje de frecuencias")
sea bajo = fourier_filtrar(mezcla, 1000, 100, "bajo")
cerca(fourier_espectro(bajo, 1000)["magnitudes"][200], 0, 0.000001, "pasa bajos quita 200 Hz")
cerca(fourier_espectro(bajo, 1000)["magnitudes"][50], 1, 0.01, "pasa bajos deja 50 Hz")
sea c = fourier_convolucion([1, 2, 3], [0, 1, 0.5])
afirmar(("" + c) == "[0, 1, 2.5, 4, 1.5]", "convolución " + c)
sea r = fourier_correlacion([0, 0, 1, 2, 0], [1, 2])
afirmar(r[3] == 5, "correlación encuentra el patrón: " + r)
sea w = fourier_ventana("hann", 5)
cerca(w[0], 0, 0.0000001, "Hann en el borde")
cerca(w[2], 1, 0.0000001, "Hann al centro")
sea sg = fourier_espectrograma(mezcla, 1000, 256, 128)
afirmar(longitud(sg) == 6 y longitud(sg[0]["magnitudes"]) == 129, "espectrograma")
mostrar("[OK] fourier")
