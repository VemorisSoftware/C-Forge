importar "nodos"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea traza = []
nodos_clase("Rastro", {
    "_entrar_arbol": funcion(yo) { traza.agregar("entra " + yo["nombre"]) },
    "_listo": funcion(yo) { traza.agregar("listo " + yo["nombre"]) },
    "_salir_arbol": funcion(yo) { traza.agregar("sale " + yo["nombre"]) }
})
nodos_clase("Jugador", {"base": "Rastro",
    "_proceso": funcion(yo, dt) { yo["props"]["x"] = yo["props"]["x"] + 60 * dt },
    "_fisica": funcion(yo, dt) { yo["props"]["pasos"] = yo["props"]["pasos"] + 1 },
    "_entrada": funcion(yo, ev) {
        si (ev == "saltar") {
            yo["props"]["saltos"] = yo["props"]["saltos"] + 1
            retornar verdadero
        }
        retornar falso
    },
    "danar": funcion(yo, cuanto) { yo["props"]["vida"] = yo["props"]["vida"] - cuanto }
})
sea raiz_escena = nodos_nuevo("Raiz", "Rastro", nulo)
sea nivel = nodos_nuevo("Nivel", "Rastro", nulo)
nodos_agregar_hijo(raiz_escena, nivel)
sea j = nodos_nuevo("Jugador", "Jugador", {"x": 0, "pasos": 0, "saltos": 0, "vida": 10})
nodos_agregar_hijo(nivel, j)
sea arbol = nodos_arbol(raiz_escena, nulo)
igual(traza, ["entra Raiz", "entra Nivel", "entra Jugador", "listo Jugador", "listo Nivel", "listo Raiz"], "orden de Godot")
igual([nodos_ruta(j), nodos_obtener(j, "../../Nivel")["nombre"], nodos_obtener(raiz_escena, "/Raiz/Nivel/Jugador")["id"] == j["id"], nodos_obtener(raiz_escena, "Nivel/Nada"), nodos_es(j, "Rastro")], ["/Raiz/Nivel/Jugador", "Nivel", verdadero, nulo, verdadero], "rutas y clases")
sea otro = nodos_agregar_hijo(nivel, nodos_nuevo("Jugador", "Nodo", nulo))
igual(otro["nombre"], "Jugador2", "nombres únicos")
// Cuadros: física a 60 Hz fija y proceso con delta.
nodos_cuadro(arbol, 0.05)
igual([j["props"]["pasos"], abs(j["props"]["x"] - 3) < 0.000001], [3, verdadero], "cuadro")
// Señales: método, función, una vez, diferida y argumentos ligados.
sea recibido = []
nodos_conectar(nivel, "golpe", [j, "danar"], nulo)
nodos_conectar(nivel, "golpe", funcion(c, quien) { recibido.agregar([c, quien]) }, {"ligados": ["trampa"]})
nodos_conectar(nivel, "una", funcion() { recibido.agregar("una") }, {"una_vez": verdadero})
nodos_conectar(nivel, "tarde", funcion() { recibido.agregar("diferida") }, {"diferida": verdadero})
nodos_emitir(nivel, "golpe", [3])
nodos_emitir(nivel, "una", [])
nodos_emitir(nivel, "una", [])
nodos_emitir(nivel, "tarde", [])
igual([j["props"]["vida"], recibido], [7, [[3, "trampa"], "una"]], "señales")
nodos_cuadro(arbol, 0)
igual(recibido[2], "diferida", "diferida al final del cuadro")
sea err = nulo
intentar { nodos_conectar(nivel, "golpe", [j, "danar"], nulo) } capturar (e) { err = e }
igual(err, "nodos: la señal golpe ya está conectada a ese destino", "conexión única")
// Grupos.
nodos_agregar_grupo(j, "enemigos_de_la_lava")
nodos_llamar_grupo(arbol, "enemigos_de_la_lava", "danar", [2])
igual([j["props"]["vida"], longitud(nodos_grupo(arbol, "enemigos_de_la_lava"))], [5, 1], "grupos")
// Entrada: el jugador la maneja.
igual(nodos_entrada(arbol, "saltar")["nombre"], "Jugador", "entrada")
igual(nodos_entrada(arbol, "nada"), nulo, "entrada sin manejar")
// Pausa: el jugador se detiene; un nodo "siempre" sigue.
nodos_pausar(arbol, verdadero)
sea antes = j["props"]["x"]
nodos_cuadro(arbol, 0.1)
igual(j["props"]["x"], antes, "pausa")
nodos_modo_pausa(nivel, "siempre")
nodos_cuadro(arbol, 0.1)
igual(j["props"]["x"] > antes, verdadero, "modo siempre se hereda")
nodos_pausar(arbol, falso)
// Temporizador.
sea t = nodos_temporizador("Reloj", 0.5, falso, verdadero)
sea toques = [0]
nodos_conectar(t, "tiempo_cumplido", funcion() { toques[0] = toques[0] + 1 }, nulo)
nodos_agregar_hijo(raiz_escena, t)
nodos_cuadro(arbol, 0.3)
nodos_cuadro(arbol, 0.3)
nodos_cuadro(arbol, 0.5)
igual(toques[0], 2, "temporizador")
// Liberar diferido y salir del árbol.
traza = []
nodos_liberar(nivel)
igual(nodos_obtener(raiz_escena, "Nivel") != nulo, verdadero, "aún no se libera")
nodos_cuadro(arbol, 0)
igual([nodos_obtener(raiz_escena, "Nivel"), traza, longitud(nodos_grupo(arbol, "enemigos_de_la_lava"))], [nulo, ["sale Jugador", "sale Nivel"], 0], "liberar")
// 2D y escenas empaquetadas.
sea a = nodos_nuevo("A", "Nodo2D", {"x": 10, "y": 0, "rotacion": 1.5707963267948966, "escala": 2})
sea b = nodos_agregar_hijo(a, nodos_nuevo("B", "Nodo2D", {"x": 5, "y": 0}))
sea g = nodos_global(b)
igual([redondear(g["x"]), redondear(g["y"]), g["escala"]], [10, 10, 2], "transformación global")
sea pq = nodos_empaquetar(a)
sea copia1 = nodos_instanciar(pq)
sea copia2 = nodos_instanciar(pq)
copia1["props"]["x"] = 99
igual([nodos_contar(copia2), copia2["props"]["x"], copia2["id"] != copia1["id"]], [2, 10, verdadero], "instanciar")
igual(nodos_imprimir(a), "A (Nodo2D)\n  B (Nodo2D)", "imprimir")
mostrar("[OK] nodos")
