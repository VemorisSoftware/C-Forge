importar "calco"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea fila = {"id": 7, "estado": "pagado", "monto": 12990, "cliente": {"nombre": "Ana", "rut": "1-9"}, "items": [{"sku": "A1", "cant": 2}, {"sku": "B2", "cant": 1}], "direccion": {}}
sea dto = calco_mapear(fila, {
    "nombre": "cliente.nombre",
    "total": {"de": "monto", "convertir": funcion(v) { retornar v / 100 }},
    "pais": {"de": "direccion.pais", "defecto": "CL"},
    "resumen": funcion(o) { retornar o["id"] + ": " + o["estado"] },
    "envio.primer_sku": "items.0.sku",
    "ultimo": "items.-1.sku",
    "lineas": {"de": "items", "lista": {"codigo": "sku", "n": "cant"}},
    "cli": {"de": "cliente", "objeto": {"r": "rut"}},
    "nada": "x.y.z",
    "fuera": "items.9.sku"
})
igual(dto, {"cli": {"r": "1-9"}, "envio": {"primer_sku": "A1"}, "lineas": [{"codigo": "A1", "n": 2}, {"codigo": "B2", "n": 1}], "nombre": "Ana", "pais": "CL", "resumen": "7: pagado", "total": 129.9, "ultimo": "B2"}, "mapear")
igual(calco_lista([{"a": 1}, {"a": 2}], {"b": "a"}), [{"b": 1}, {"b": 2}], "lista")
igual(calco_obtener(fila, "cliente.nombre.x"), nulo, "ruta en texto")
igual(calco_aplanar({"a": {"b": 1, "c": {"d": 2}}, "e": [1], "f": {}}), {"a.b": 1, "a.c.d": 2, "e": [1], "f": {}}, "aplanar")
igual(calco_desaplanar({"a.b": 1, "a.c": 2, "d": 3}), {"a": {"b": 1, "c": 2}, "d": 3}, "desaplanar")
igual(calco_mezclar({"a": {"x": 1, "y": 2}, "l": [1]}, {"a": {"y": 3}, "l": [2], "n": nulo}), {"a": {"x": 1, "y": 3}, "l": [2], "n": nulo}, "mezclar")
igual(calco_elegir(fila, ["id", "cliente.rut", "no"]), {"cliente": {"rut": "1-9"}, "id": 7}, "elegir")
igual(calco_omitir(fila, ["items", "cliente", "direccion"]), {"estado": "pagado", "id": 7, "monto": 12990}, "omitir")
igual(calco_mapear({"p": 5}, {"x": {"from": "p", "convert": funcion(v) { retornar v * 2 }}, "y": {"from": "q", "default": 0}}), {"x": 10, "y": 0}, "reglas en inglés")
sea m = ""
intentar { calco_mapear(fila, {"x": 5}) } capturar (e) { m = e }
igual(m, "calco: regla inválida (numero)", "regla inválida")
mostrar("[OK] calco")
