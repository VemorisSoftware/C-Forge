importar "depura"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Contra debugpy 1.8 (adaptador por TCP) se probó: initialize, launch,
// puntos con y sin condición, configurationDone, stackTrace, scopes y
// variables locales, evaluate (y su error), next, continue, la salida del
// programa y exited. Aquí, con el adaptador simulado.
igual(depura_codificar({"seq": 1}), "Content-Length: 9\r\n\r\n" + json_texto({"seq": 1}), "cabecera")
sea programa = [[1, {}], [2, {"x": 0}], [3, {"x": 0, "y": 0}], [2, {"x": 1}], [3, {"x": 1, "y": 1}], [2, {"x": 2}], [3, {"x": 2, "y": 4}], [5, {"total": 5}]]
sea sim = depura_simulado("/app.py", programa)
sea c = depura_conectar(nulo, nulo, {"transporte": sim["transporte"]})
igual(depura_inicializar(c, nulo)["supportsConditionalBreakpoints"], verdadero, "initialize")
sea l = depura_enviar(c, "launch", {"program": "/app.py"})
depura_esperar_evento(c, "initialized", nulo)
sea bps = depura_puntos(c, "/app.py", [{"line": 3, "condition": "x == 1"}, 9])
igual([bps[0]["verified"], bps[1]["verified"]], [verdadero, falso], "puntos")
depura_configuracion_lista(c)
depura_respuesta(c, l)
sea p = depura_esperar_evento(c, "stopped", nulo)
igual(p["reason"], "breakpoint", "parada")
sea hilo = depura_hilos(c)[0]["id"]
sea m = depura_pila(c, hilo)[0]
igual([m["line"], depura_locales(c, m["id"])], [3, {"x": "1", "y": "1"}], "pila y locales")
igual(depura_evaluar(c, "y", m["id"], nulo)["result"], "1", "evaluar")
sea err = nulo
intentar { depura_evaluar(c, "z", m["id"], nulo) } capturar (e) { err = depura_error_texto(e) }
igual(err, "evaluate: NameError: z", "error al evaluar")
sea m2 = depura_paso(c, hilo, "siguiente")
igual([m2["line"], depura_locales(c, m2["id"])], [2, {"x": "2"}], "paso")
depura_continuar(c, hilo)
igual(depura_esperar_evento(c, "exited", nulo)["exitCode"], 0, "terminó")
igual(depura_salida(c, "stdout"), "fin\n", "salida")
// Eventos que llegan antes quedan en la cola.
igual(depura_esperar_evento(c, "process", nulo)["name"], "/app.py", "evento en cola")
// Lanzar un programa que no existe.
sea sim2 = depura_simulado("/app.py", programa)
sea c2 = depura_conectar(nulo, nulo, {"transporte": sim2["transporte"]})
depura_inicializar(c2, nulo)
err = nulo
intentar { depura_pedir(c2, "launch", {"program": "/otro.py"}) } capturar (e) { err = depura_error_texto(e) }
igual(err, "launch: no existe /otro.py", "launch fallido")
depura_desconectar(c, verdadero)
mostrar("[OK] depura")
