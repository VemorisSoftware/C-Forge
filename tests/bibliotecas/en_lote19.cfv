// English aliases for batch 19.
importar "embeddb"
importar "wasm"
importar "suricata"
importar "zeromq"
importar "nats"
importar "base64"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// embeddb
sea path = "/tmp/cforge_embeddb_en.db"
si (existe_archivo(path)) { escribir_archivo(path, "") }
sea db = embeddb_open(path, nulo)
embeddb_update(db, funcion(tx) {
    embeddb_put(tx, "users", "a1", "Ann")
    embeddb_put(tx, "users", "a2", "Bob")
    embeddb_put(tx, "users", "b1", "Cy")
})
eq(embeddb_view(db, funcion(tx) { retornar [embeddb_get(tx, "users", "a2"), embeddb_count(tx, "users"), longitud(embeddb_range(tx, "users", {"prefix": "a"}))] }), ["Bob", 3, 2], "embeddb")
eq(embeddb_stats(db)["pages"] > 0, verdadero, "stats")
embeddb_close(db)
// wasm
sea inst = wasm_instantiate(base64_decodificar("AGFzbQEAAAABBwFgAn9/AX8DAgEABwcBA2FkZAAACgkBBwAgACABags="), nulo)
eq([wasm_call(inst, "add", [40, 2]), wasm_exports(inst)["add"]], [42, "funcion"], "wasm")
// suricata
eq(pcap_read(pcap_write([{"t": 1, "datos": "xyz"}], 1))[0]["datos"], "xyz", "pcap")
sea eng = suricata_engine("alert tcp any any -> any 80 (msg:" + caracter(34) + "t" + caracter(34) + "; content:" + caracter(34) + "abc" + caracter(34) + "; sid:7;)", nulo)
eq(longitud(eng["reglas"]), 1, "engine")
// zeromq
sea p = zmq_pipe()
sea req = zmq_socket("REQ", p[0], nulo)
sea rep = zmq_socket("REP", p[1], {"server": verdadero})
zmq_send(req, "ping")
eq(zmq_recv(rep), ["ping"], "zmq")
// nats
sea srv = nats_memory(nulo)
sea a = nats_connect(nulo, {"transport": srv["transporte"]()})
sea b = nats_connect(nulo, {"transport": srv["transporte"]()})
nats_subscribe(b, "q.*", {"queue": "w"})
nats_publish(a, "q.x", "hi", {"K": "v"}, nulo)
sea m = nats_next(b)
eq([m["subject"], m["data"], m["headers"]["K"], nats_match("a.>", "a.b.c")], ["q.x", "hi", "v", verdadero], "nats")
mostrar("[OK] en_lote19")
