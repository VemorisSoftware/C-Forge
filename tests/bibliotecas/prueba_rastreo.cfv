importar "rastreo"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
igual([rastreo_coincide("src/**/prueba_*.{cfv,txt}", "src/a/b/prueba_x.cfv"), rastreo_coincide("src/**/prueba_*.cfv", "src/prueba_x.cfv"), rastreo_coincide("*.cfv", "a/b.cfv"), rastreo_coincide("**/*.cfv", "a/b.cfv"), rastreo_coincide("[a-c]?.txt", "b1.txt"), rastreo_coincide("[!a]*", "abc"), rastreo_coincide("*", ".oculto"), rastreo_coincide(".*", ".oculto"), rastreo_coincide("a[*]b", "a*b"), rastreo_coincide("{x,y{1,2}}.md", "y2.md")], [verdadero, verdadero, falso, verdadero, verdadero, falso, falso, verdadero, verdadero, verdadero], "patrones")
igual(rastreo_filtrar(["a.cfv", "b.txt", "c/d.cfv"], "**/*.cfv"), ["a.cfv", "c/d.cfv"], "filtrar")
sea base = "/tmp/cforge-rastreo"
sea crear = funcion(ruta) { escribir_archivo(base + "/" + ruta, "x") }
// Arma un árbol con archivos (las carpetas se crean al escribir).
para c en ["/src/sub", "/.git", "/node_modules/x"] { afirmar(crear_carpeta(base + c), "crear_carpeta " + c) }
para f en ["a.cfv", "b.txt", "src/c.cfv", "src/sub/prueba_d.cfv", ".git/config", "node_modules/x/e.cfv", ".oculto.cfv"] { crear(f) }
igual(rastreo_buscar(base, "**/*.cfv", {"ignorar": ["node_modules"]}), [base + "/a.cfv", base + "/src/c.cfv", base + "/src/sub/prueba_d.cfv"], "buscar recursivo ignorando")
igual(rastreo_buscar(base, "*.{cfv,txt}"), [base + "/a.cfv", base + "/b.txt"], "llaves")
igual(rastreo_buscar(base, ".*"), [base + "/.oculto.cfv"], "ocultos explícitos")
sea r = rastreo_recorrer(base, {"ignorar": ["node_modules"], "profundidad": 2})
sea rutas = []
para e en r { rutas.agregar(subcadena(e["ruta"], longitud(base) + 1, longitud(e["ruta"])) + ":" + e["profundidad"]) }
igual(rutas, ["a.cfv:1", "b.txt:1", "src:1", "src/c.cfv:2", "src/sub:2"], "recorrer con profundidad")
igual([listar_carpeta(base + "/b.txt"), es_carpeta(base + "/src"), es_carpeta("/no/existe")], [nulo, verdadero, falso], "listar y es_carpeta")
igual(ordenar(listar_carpeta(base + "/src"), funcion(a, b) { si (a < b) { retornar -1 }  retornar 1 }), ["c.cfv", "sub"], "listar sin . ni ..")
sea m = ""
intentar { rastreo_recorrer(base + "/a.cfv") } capturar (e) { m = e }
igual(m, "rastreo: no es una carpeta: " + base + "/a.cfv", "no es carpeta")
mostrar("[OK] rastreo")
