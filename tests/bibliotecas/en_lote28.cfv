// English names for lote 28.
importar "libp2p"
importar "code_analysis"
importar "jolt"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea a = libp2p_node({"seed": bytes_de_hex("0101010101010101010101010101010101010101010101010101010101010101"), "agent": "a"})
eq(libp2p_peer_id(a), "12D3KooWK99VoVxNE7XzyBwXEzW7xhK7Gpv85r9F3V3fyKSUKPH5", "libp2p_peer_id")
eq(hex_de_bytes(multiaddr_to_bytes("/ip4/127.0.0.1/tcp/4001")), "047f000001060fa1", "multiaddr_to_bytes")
sea b = libp2p_node({"agent": "b"})
libp2p_handle(b, "/echo/1.0.0", funcion(req, peer) { retornar "echo:" + req })
sea ca = libp2p_connection(a, "iniciador", nulo)
sea cb = libp2p_connection(b, "respondedor", nulo)
funcion pump(x, y) {
    sea i = 0
    mientras (i < 20) {
        libp2p_feed(y, libp2p_take_output(x))
        libp2p_feed(x, libp2p_take_output(y))
        i = i + 1
    }
}
pump(ca, cb)
afirmar(libp2p_is_ready(ca), "libp2p_is_ready")
sea s = libp2p_open_stream(ca, "/echo/1.0.0")
libp2p_stream_write(ca, s, "hi")
libp2p_stream_close(ca, s)
pump(ca, cb)
eq(libp2p_stream_read(ca, s)["data"], "echo:hi", "request/response")
sea s2 = libp2p_open_stream(ca, "/ipfs/id/1.0.0")
pump(ca, cb)
eq(libp2p_identify_decode(libp2p_stream_read(ca, s2)["data"])["agent"], "b", "identify")
eq(libp2p_events(ca)[0]["type"], "connected", "libp2p_events")
// code_analysis
sea src = "function twice(n) { return n * 2 }\nlet x = twice(1, 2)\nprint(y_)\n"
sea ds = analysis_diagnostics(src, nulo)
eq([ds[0]["code"], ds[0]["severity"], ds[1]["code"]], ["CF007", "error", "CF002"], "analysis_diagnostics")
eq(analysis_definition(src, 2, 9, nulo)["line"], 1, "analysis_definition")
eq(analysis_hover(src, 2, 9, nulo)["signature"], "funcion twice(n)", "analysis_hover")
eq(analysis_symbols(src)[0]["name"], "twice", "analysis_symbols")
eq(analysis_rename(src, 1, 10, "doble", nulo), "function doble(n) { return n * 2 }\nlet x = doble(1, 2)\nprint(y_)\n", "analysis_rename")
eq(analysis_tokens("let a")[0]["kind"], "clave", "analysis_tokens")
// jolt
sea jw = jolt_world({"gravity": [0, -9.81, 0]})
jolt_body(jw, {"shape": jolt_plane([0, 1, 0], 0)})
sea jb = jolt_body(jw, {"shape": jolt_box([0.5, 0.5, 0.5]), "position": [0, 2, 0], "friction": 0.8})
sea jr = jolt_body(jw, {"shape": jolt_sphere(0.2), "type": "static", "position": [5, 5, 5]})
sea ji = 0
mientras (ji < 120) {
    jolt_step(jw, 1 / 60)
    ji = ji + 1
}
afirmar(absoluto(jolt_position(jw, jb)[1] - 0.5) < 0.02, "jolt_step")
sea jhit = jolt_raycast(jw, [0, 5, 0], [0, -1, 0], 10, nulo)
eq([jhit["body"], absoluto(jhit["distance"] - 4) < 0.02], [jb, verdadero], "jolt_raycast")
eq(jolt_overlap_sphere(jw, [5, 5, 5], 0.1), [jr], "jolt_overlap_sphere")
mostrar("[OK] en_lote28")
