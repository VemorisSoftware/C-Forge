importar "ensayo"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea orden = []
ensayo_describir("carrito", funcion() {
    ensayo_antes_de_todo(funcion() { orden.agregar("antes_todo") })
    ensayo_antes_de_cada(funcion() { orden.agregar("antes") })
    ensayo_despues_de_cada(funcion() { orden.agregar("despues") })
    ensayo_prueba("suma", funcion() { ensayo_igual(1 + 2, 3) })
    ensayo_prueba("falla con diferencia", funcion() { ensayo_igual({"a": 1, "b": [1, 2]}, {"a": 1, "b": [1, 3]}) })
    ensayo_saltar("saltada", funcion() { lanzar "no debería correr" })
    ensayo_pendiente("por hacer")
    ensayo_describir("anidado", funcion() {
        ensayo_prueba("cerca", funcion() { ensayo_cerca(0.1 + 0.2, 0.3, 5) })
    })
})
ensayo_cada([[1, 1, 2], [2, 3, 5]], "%0 + %1 = %2", funcion(c) { ensayo_igual(c[0] + c[1], c[2]) })
sea r = ensayo_correr({"silencioso": verdadero, "lanzar": falso})
igual([longitud(r["pasaron"]), longitud(r["fallaron"]), longitud(r["saltadas"]), longitud(r["pendientes"])], [4, 1, 1, 1], "resumen")
igual(r["fallaron"][0]["nombre"], "carrito › falla con diferencia", "nombre completo")
afirmar(texto_indice(r["fallaron"][0]["error"], "-     3") >= 0 y texto_indice(r["fallaron"][0]["error"], "+     2") >= 0, "diferencia legible")
igual(orden, ["antes_todo", "antes", "despues", "antes", "despues", "antes", "despues"], "ganchos")
igual(r["pasaron"][2]["nombre"], "1 + 1 = 2", "tabla de casos")
// solo: corre únicamente lo marcado.
ensayo_prueba("normal", funcion() { })
ensayo_solo("elegida", funcion() { })
sea r2 = ensayo_correr({"silencioso": verdadero})
igual([longitud(r2["pasaron"]), r2["pasaron"][0]["nombre"], longitud(r2["saltadas"])], [1, "elegida", 1], "solo")
// Expectativas.
ensayo_coincide({"a": 1, "b": {"c": 2, "d": 3}}, {"b": {"c": 2}})
ensayo_contiene([1, {"x": 2}], {"x": 2})
ensayo_contiene("hola mundo", "mundo")
igual(ensayo_lanza(funcion() { lanzar "boom: algo" }, "boom"), "boom: algo", "lanza")
ensayo_lanza(funcion() { ensayo_lanza(funcion() { }, nulo) }, "se esperaba un error")
ensayo_lanza(funcion() { ensayo_coincide({"a": 1}, {"a": 2}) }, "no coincide")
// Mocks y espías.
sea m = ensayo_mock(2, funcion(args) { retornar args[0] * args[1] })
igual(m["f"](3, 4), 12, "implementación")
ensayo_mock_devolver_una_vez(m, 99)
igual([m["f"](1, 1), m["f"](2, 5)], [99, 10], "una vez")
ensayo_mock_devolver(m, 0)
igual(m["f"](7, 7), 0, "devolver")
ensayo_llamado(m, 4)
ensayo_llamado_con(m, [2, 5])
ensayo_ultima_llamada(m, [7, 7])
ensayo_mock_lanzar_una_vez(m, "falló la red")
ensayo_lanza(funcion() { m["f"](1, 2) }, "falló la red")
sea servicio = {"sumar": funcion(x) { retornar x + 1 }}
sea esp = ensayo_espiar(servicio, "sumar", 1)
igual([servicio["sumar"](1), esp["llamadas"]], [2, [[1]]], "espía")
ensayo_restaurar(esp)
servicio["sumar"](5)
igual(longitud(esp["llamadas"]), 1, "restaurado")
// Reloj falso.
sea reloj = ensayo_reloj(1000)
sea hechos = []
reloj["programar"](50, funcion() { hechos.agregar("a") })
reloj["programar"](10, funcion() { hechos.agregar("b") })
reloj["avanzar"](20)
igual([hechos, reloj["ahora"](), reloj["pendientes"]()], [["b"], 1020, 1], "reloj")
reloj["avanzar"](100)
igual(hechos, ["b", "a"], "reloj completo")
// Instantáneas.
sea ruta = "/tmp/cforge_ensayo_snap.json"
si (existe_archivo(ruta)) { escribir_archivo(ruta, "{}") }
ensayo_archivo_instantaneas(ruta)
ensayo_instantanea({"usuario": "ana", "roles": ["admin"]}, "perfil")
ensayo_archivo_instantaneas(ruta)
ensayo_instantanea({"usuario": "ana", "roles": ["admin"]}, "perfil")
ensayo_lanza(funcion() { ensayo_instantanea({"usuario": "leo"}, "perfil") }, "no coincide")
mostrar("[OK] ensayo")
