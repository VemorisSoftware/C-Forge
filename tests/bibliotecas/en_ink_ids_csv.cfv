// Written in English: keywords and library names.
import "ink"
import "ids"
import "csv"
function same(a, b, what) { assert(a == b, what + ": [" + a + "] != [" + b + "]") }
let E = caracter(27) + "["
ink_use(true)
same(ink_red("hi"), E + "31mhi" + E + "39m", "ink_red")
same(ink_strip(ink_bold(ink_green("ok"))), "ok", "ink_strip")
same(ink_length(ink_hex("#00ff00", "abc")), 3, "ink_length")
let u = id_uuid4()
assert(id_is_uuid(u), "id_is_uuid")
same(id_uuid_version(id_uuid7()), 7, "id_uuid_version")
same(length(id_ulid()), 26, "id_ulid")
same(length(id_nanoid(12)), 12, "id_nanoid")
let rows = csv_read("name,age\nAna,30\n")
same(rows[1][0], "Ana", "csv_read")
same(csv_records("name,age\nAna,30\n")[0]["age"], "30", "csv_records")
same(csv_write([["a", "b,c"]]), "a,\"b,c\"\r\n", "csv_write")
same(csv_write_safe([["=SUM(A1)"]]), "'=SUM(A1)\r\n", "csv_write_safe")
print("[OK] ink, ids, csv in English")
