// Pruebas de trazo (vectores al estilo Vello). La referencia
// datos/trazo-ref.png es trazo-ref.svg dibujado con librsvg (rsvg-convert).
importar "trazo"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion cerca(a, b, tol, q) { afirmar(absoluto(a - b) <= tol, q + ": " + a + " vs " + b) }
funcion suma(l) {
    sea s = 0
    para v en l { s = s + v }
    retornar s
}

// Cobertura analítica: el área sale exacta.
sea c = trazo_camino()
trazo_rectangulo(c, 2.25, 3.5, 10.5, 4.25)
cerca(suma(trazo_cobertura(c, 40, 20, nulo)), 44.625, 0.0001, "área de un rectángulo fraccionario")
sea c2 = trazo_camino()
trazo_rectangulo(c2, -5, -3, 30, 40)
cerca(suma(trazo_cobertura(c2, 40, 40, nulo)), 25 * 37, 0.0001, "recorte en los bordes")
sea c3 = trazo_camino()
trazo_circulo(c3, 20.3, 20.1, 15)
cerca(suma(trazo_cobertura(c3, 48, 48, nulo)), 3.141592653589793 * 225, 3, "área del círculo")
// Mosaicos de 16×16: un cuadrado grande atraviesa varios.
sea c4 = trazo_camino()
trazo_rectangulo(c4, 3.5, 3.5, 50, 50)
sea cob = trazo_cobertura(c4, 64, 64, nulo)
cerca(suma(cob), 2500, 0.0001, "cuadrado en varios mosaicos")
eq([cob[30 * 64 + 30], cob[3 * 64 + 10], cob[3 * 64 + 3], cob[60 * 64 + 60]], [1, 0.5, 0.25, 0], "coberturas parciales")
// Regla par-impar: el pentagrama tiene hueco y nonzero no.
sea estrella = trazo_camino_svg("M30 5 L42 40 L8 18 L52 18 L18 40 Z")
eq(trazo_cobertura(estrella, 64, 64, {"regla": "evenodd"})[25 * 64 + 30], 0, "evenodd: centro vacío")
eq(trazo_cobertura(estrella, 64, 64, nulo)[25 * 64 + 30], 1, "nonzero: centro lleno")
// Caminos SVG relativos y abreviados equivalen a los absolutos.
sea s1 = trazo_camino_svg("M10 10 h 20 v 20 H 10 z")
sea s2 = trazo_camino_svg("M10,10 L30,10 L30,30 L10,30 Z")
eq(trazo_cobertura(s1, 40, 40, nulo), trazo_cobertura(s2, 40, 40, nulo), "SVG relativo")
cerca(suma(trazo_cobertura(trazo_camino_svg("M0 0 Q 20 40 40 0 T 80 0"), 80, 40, nulo)), 2 / 3 * 40 * 20, 2, "cuadráticas con T (la segunda sale del lienzo)")

// Comparación con librsvg: casi todos los píxeles coinciden.
sea e = trazo_escena()
trazo_rellenar(e, trazo_camino_svg("M30 5 L42 40 L8 18 L52 18 L18 40 Z"), "#c02040", nulo)
trazo_rellenar(e, trazo_camino_svg("M90 5 L102 40 L68 18 L112 18 L78 40 Z"), "#2040c0", {"regla": "evenodd"})
sea ci = trazo_camino()
trazo_circulo(ci, 30.5, 70.25, 18.3)
trazo_rellenar(e, ci, "#20a060", nulo)
sea rr = trazo_camino()
trazo_rectangulo_redondeado(rr, 64.5, 52.5, 50, 34, 9)
trazo_rellenar(e, rr, [224, 160, 0, 178.5], nulo)
trazo_trazar(e, trazo_camino_svg("M10 100 L40 120 L70 98"), "#303030", {"grosor": 7})
trazo_trazar(e, trazo_camino_svg("M80 100 L100 122 L120 100"), "#a040a0", {"grosor": 6, "union": "round", "extremo": "round"})
trazo_trazar(e, trazo_camino_svg("M60 60 C 70 20, 110 110, 120 60"), "#0090d0", {"grosor": 3, "union": "bevel"})
sea img = trazo_renderizar(e, 128, 128, {"fondo": "#ffffff"})
sea ref = imagen_cargar("tests/bibliotecas/datos/trazo-ref.png")
sea total = 0
sea grandes = 0
sea y = 0
mientras (y < 128) {
    sea x = 0
    mientras (x < 128) {
        sea a = imagen_pixel(img, x, y)
        sea b = imagen_pixel(ref, x, y)
        sea d = maximo(absoluto(a[0] - b[0]), maximo(absoluto(a[1] - b[1]), absoluto(a[2] - b[2])))
        total = total + d
        si (d > 32) { grandes = grandes + 1 }
        x = x + 1
    }
    y = y + 1
}
afirmar(total / (128 * 128) < 0.6, "diferencia media con librsvg: " + total / (128 * 128))
afirmar(grandes <= 6, "píxeles muy distintos: " + grandes)

// Trazos: grosor exacto de una línea horizontal con extremos butt y square.
sea h = trazo_camino_svg("M10 20 L50 20")
sea et = trazo_escena()
trazo_trazar(et, h, "#000000", {"grosor": 4})
sea it = trazo_renderizar(et, 64, 40, nulo)
eq([imagen_pixel(it, 30, 18)[3], imagen_pixel(it, 30, 21)[3], imagen_pixel(it, 30, 22)[3], imagen_pixel(it, 9, 20)[3], imagen_pixel(it, 50, 20)[3]], [255, 255, 0, 0, 0], "butt")
sea es = trazo_escena()
trazo_trazar(es, h, "#000000", {"grosor": 4, "extremo": "square"})
sea is = trazo_renderizar(es, 64, 40, nulo)
eq([imagen_pixel(is, 8, 20)[3], imagen_pixel(is, 51, 20)[3], imagen_pixel(is, 7, 20)[3]], [255, 255, 0], "square")
// Guiones: 10 encendido, 10 apagado.
sea eg = trazo_escena()
trazo_trazar(eg, h, "#000000", {"grosor": 2, "guiones": [10, 10]})
sea ig = trazo_renderizar(eg, 64, 40, nulo)
eq([imagen_pixel(ig, 15, 20)[3], imagen_pixel(ig, 25, 20)[3], imagen_pixel(ig, 35, 20)[3], imagen_pixel(ig, 45, 20)[3]], [255, 0, 255, 0], "guiones")
// Un trazo que se cruza a sí mismo no deja huecos.
sea ocho = trazo_camino_svg("M10 10 L40 40 L40 10 L10 40 Z")
sea eo = trazo_escena()
trazo_trazar(eo, ocho, "#000000", {"grosor": 6})
eq(imagen_pixel(trazo_renderizar(eo, 50, 50, nulo), 25, 25)[3], 255, "cruce del trazo")
// Anillo cerrado: hueco por dentro.
sea anillo = trazo_camino()
trazo_circulo(anillo, 25, 25, 15)
sea ea = trazo_escena()
trazo_trazar(ea, anillo, "#000000", {"grosor": 4})
sea ia = trazo_renderizar(ea, 50, 50, nulo)
eq([imagen_pixel(ia, 25, 25)[3], imagen_pixel(ia, 40, 25)[3], imagen_pixel(ia, 25, 9)[3]], [0, 255, 255], "anillo")

// Degradados.
sea cuadro = trazo_camino()
trazo_rectangulo(cuadro, 0, 0, 100, 10)
funcion rojo_en(pincel, x) {
    sea eg2 = trazo_escena()
    trazo_rellenar(eg2, cuadro, pincel, nulo)
    retornar imagen_pixel(trazo_renderizar(eg2, 100, 10, nulo), x, 5)[0]
}
sea lin = trazo_lineal(0, 0, 50, 0, [[0, "#000000"], [1, "#ff0000"]], nulo)
eq([rojo_en(lin, 0), rojo_en(lin, 24), rojo_en(lin, 49), rojo_en(lin, 80)], [3, 125, 252, 255], "lineal pad")
eq(rojo_en(trazo_lineal(0, 0, 50, 0, [[0, "#000000"], [1, "#ff0000"]], "repeat"), 74), 125, "lineal repeat")
eq(rojo_en(trazo_lineal(0, 0, 50, 0, [[0, "#000000"], [1, "#ff0000"]], "reflect"), 74), 130, "lineal reflect")
eq([rojo_en(trazo_radial(0, 5, 0, 0, 5, 40, [[0, "#ff0000"], [1, "#000000"]], nulo), 19), rojo_en(trazo_radial(0, 5, 0, 0, 5, 40, [[0, "#ff0000"], [1, "#000000"]], nulo), 60)], [131, 0], "radial")
sea con = trazo_conico(50, 5, 0, 6.283185307179586, [[0, "#000000"], [1, "#ff0000"]], nulo)
afirmar(rojo_en(con, 90) < 20 y rojo_en(con, 10) > 110 y rojo_en(con, 10) < 140, "cónico")
eq(trazo_color("#12345678"), [0.033218, 0.0959631, 0.158708, 0.470588], "color con alfa (premultiplicado)")

// Capas: recorte, opacidad y mezcla.
sea ec = trazo_escena()
trazo_rellenar(ec, cuadro, [200, 100, 50], nulo)
sea mitad = trazo_camino()
trazo_rectangulo(mitad, 0, 0, 50, 10)
trazo_abrir_capa(ec, mitad, {"mezcla": "multiply"})
trazo_rellenar(ec, cuadro, [128, 255, 0], nulo)
trazo_cerrar_capa(ec)
sea ic = trazo_renderizar(ec, 100, 10, nulo)
eq([imagen_pixel(ic, 25, 5), imagen_pixel(ic, 75, 5)], [[100, 100, 0, 255], [200, 100, 50, 255]], "multiply recortado")
funcion mezcla(modo, abajo, arriba) {
    sea em = trazo_escena()
    trazo_rellenar(em, cuadro, abajo, nulo)
    trazo_abrir_capa(em, nulo, {"mezcla": modo})
    trazo_rellenar(em, cuadro, arriba, nulo)
    trazo_cerrar_capa(em)
    retornar imagen_pixel(trazo_renderizar(em, 100, 10, nulo), 50, 5)
}
eq(mezcla("screen", [100, 100, 100], [100, 200, 0]), [161, 222, 100, 255], "screen")
eq(mezcla("difference", [200, 50, 100], [100, 200, 100]), [100, 150, 0, 255], "difference")
eq(mezcla("darken", [200, 50, 100], [100, 200, 100]), [100, 50, 100, 255], "darken")
eq(mezcla("overlay", [64, 192, 128], [128, 128, 128]), [64, 192, 128, 255], "overlay neutro")
sea ealfa = trazo_escena()
trazo_abrir_capa(ealfa, nulo, {"alfa": 0.5})
trazo_rellenar(ealfa, cuadro, "#ff0000", nulo)
trazo_cerrar_capa(ealfa)
eq(imagen_pixel(trazo_renderizar(ealfa, 100, 10, nulo), 50, 5), [255, 0, 0, 128], "opacidad de capa")

// Transformaciones y fragmentos anexados.
sea frag = trazo_escena()
sea cuad = trazo_camino()
trazo_rectangulo(cuad, 0, 0, 10, 10)
trazo_rellenar(frag, cuad, "#00ff00", nulo)
sea ef = trazo_escena()
trazo_anexar(ef, frag, trazo_traslacion(20, 5))
trazo_anexar(ef, frag, trazo_componer(trazo_traslacion(60, 5), trazo_escala(2, 1)))
eq(trazo_tamano(ef), 2, "anexar")
sea iff = trazo_renderizar(ef, 100, 20, nulo)
eq([imagen_pixel(iff, 19, 10)[3], imagen_pixel(iff, 20, 10)[3], imagen_pixel(iff, 29, 10)[3], imagen_pixel(iff, 30, 10)[3], imagen_pixel(iff, 79, 10)[3], imagen_pixel(iff, 80, 10)[3]], [0, 255, 255, 0, 255, 0], "transformaciones")
sea rot = trazo_escena()
trazo_rellenar(rot, cuad, "#000000", {"transformacion": trazo_componer(trazo_traslacion(20, 20), trazo_rotacion(0.7853981633974483))})
sea ir = trazo_renderizar(rot, 40, 40, nulo)
eq([imagen_pixel(ir, 20, 26)[3], imagen_pixel(ir, 26, 20)[3]], [255, 0], "rotación")
// Trazo con transformación no uniforme: el grosor se escala con ella.
sea ens = trazo_escena()
trazo_trazar(ens, trazo_camino_svg("M0 10 L50 10"), "#000000", {"grosor": 2, "transformacion": trazo_escala(1, 3)})
sea ins = trazo_renderizar(ens, 60, 60, nulo)
eq([imagen_pixel(ins, 20, 27)[3], imagen_pixel(ins, 20, 32)[3], imagen_pixel(ins, 20, 33)[3]], [255, 255, 0], "grosor transformado")
afirmar(img["estadisticas"]["mosaicos"] > 0, "estadísticas")
mostrar("[OK] trazo")
