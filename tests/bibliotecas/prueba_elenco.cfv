importar "elenco"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea m = elenco_mundo()
sea e1 = elenco_crear(m, {"pos": {"x": 0}, "vel": {"x": 2}})
sea e2 = elenco_crear(m, {"pos": {"x": 10}})
sea e3 = elenco_crear(m, {"pos": {"x": 5}, "vel": {"x": -1}, "congelado": verdadero})
igual([e1, e2, e3], [1, 2, 3], "ids")
igual(elenco_consultar(m, ["pos", "vel"]), [1, 3], "consulta")
igual(elenco_consultar(m, ["pos", "vel"], ["congelado"]), [1], "consulta con exclusión")
igual(elenco_consultar(m, ["nada"]), [], "componente inexistente")
sea orden = []
elenco_sistema(m, "mover", ["pos", "vel"], funcion(m, e, c, dt) { c["pos"]["x"] = c["pos"]["x"] + c["vel"]["x"] * dt  orden.agregar("mover" + e) }, ["congelado"])
elenco_sistema(m, "limpiar", ["pos"], funcion(m, e, c, dt) {
    orden.agregar("limpiar" + e)
    si (c["pos"]["x"] > 9) { elenco_destruir(m, e)  elenco_emitir(m, "fuera", e) }
})
elenco_sistema(m, "contar", ["pos"], funcion(m, e, c, dt) {
    elenco_recurso(m, "vistos", (elenco_recurso(m, "vistos") ?? 0) + 1)
    si (e == 3) { elenco_recurso(m, "eventos", elenco_eventos(m, "fuera")) }
})
elenco_paso(m, 2)
igual(orden, ["mover1", "limpiar1", "limpiar2", "limpiar3"], "orden de sistemas")
igual(elenco_obtener(m, e1, "pos"), {"x": 4}, "movió")
igual(elenco_obtener(m, e3, "pos"), {"x": 5}, "congelado no se mueve")
igual(elenco_recurso(m, "vistos"), 3, "destruir es diferido (el sistema siguiente aún la ve)")
igual(elenco_recurso(m, "eventos"), [2], "eventos del paso")
igual([elenco_vive(m, e2), elenco_cantidad(m), elenco_consultar(m, ["pos"])], [falso, 2, [1, 3]], "destruida al final del paso")
igual(elenco_eventos(m, "fuera"), [], "eventos se limpian")
elenco_quitar(m, e3, "congelado")
elenco_activar(m, "limpiar", falso)
elenco_paso(m, 1)
igual([elenco_obtener(m, e1, "pos")["x"], elenco_obtener(m, e3, "pos")["x"], elenco_tiene(m, e3, "congelado")], [6, 4, falso], "quitar componente y desactivar sistema")
elenco_destruir(m, e1)
igual(elenco_vive(m, e1), falso, "destruir fuera del paso es inmediato")
sea x = ""
intentar { elenco_poner(m, e1, "pos", {}) } capturar (e) { x = e }
igual(x, "elenco: la entidad 1 no existe", "entidad muerta")
mostrar("[OK] elenco")
