// Lote 38 en inglés: llamacpp, mujoco y gstreamer.
importar "llamacpp"
importar "mujoco"
importar "gstreamer"
importar "json"

sea e = json_parsear(leer_archivo("tests/bibliotecas/datos/oraculo/esperado.json"))
sea m = llama_model_load("tests/bibliotecas/datos/oraculo/mini.gguf")
afirmar(llama_model_info(m)["layers"] > 0, "llama_model_info")
sea g = llama_generate(m, "hola mundo", {"max_tokens": 6})
afirmar(g["tokens"] == e["greedy"], "llama_generate")
afirmar(tiene_clave(g, "stop_reason"), "stop_reason")

sea s = mj_load_xml("<mujoco><worldbody><body pos=\"0 0 1\"><joint axis=\"0 1 0\"/><geom type=\"sphere\" size=\"0.1\" pos=\"0 0 -0.5\" mass=\"1\"/></body></worldbody></mujoco>")
mj_set(s, "qpos", [0.3])
mj_set(s, "qfrc_applied", [0.1])
para i en lista_rango(0, 10) { mj_step(s) }
afirmar(absoluto(mj_state(s)["time"] - 0.02) < 1e-12, "mj_state")
afirmar(absoluto(mj_bodies(s)[0]["mass"] - 1) < 1e-12, "mj_bodies")

sea r = gst_launch("audiotestsrc num-buffers=2 ! audio/x-raw,rate=8000 ! level ! appsink name=out")
afirmar(r["state"] == "eos" y longitud(r["sinks"]["out"]) == 2, "gst_launch")
afirmar(r["messages"][0]["source"] == "level", "messages")
mostrar("[OK] en_lote38")
