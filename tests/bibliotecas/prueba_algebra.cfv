importar "algebra"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion cerca(a, b, q) { afirmar(algebra_casi_igual(a, b, 1e-7), q + ": [" + a + "] != [" + b + "]") }
// Valores de referencia calculados con NumPy y SciPy.
sea a = [[4, -2, 1], [3, 6, -4], [2, 1, 8]]
cerca(algebra_resolver(a, [12, -25, 32]), [1, -2, 4], "resolver")
cerca([algebra_determinante(a)], [263], "determinante")
cerca(algebra_mul(a, algebra_inversa(a)), algebra_identidad(3), "inversa")
sea lu = algebra_lu(a)
igual(lu["p"], [0, 1, 2], "pivoteo")
cerca(algebra_propios_simetrica([[2, 1, 0], [1, 3, 1], [0, 1, 4]])["valores"], [1.2679491924311228, 3, 4.732050807568877], "propios simétrica")
sea ev = algebra_propios([[0, -1], [1, 0]])
cerca([ev[0][0], ev[0][1], ev[1][0], ev[1][1]], [0, -1, 0, 1], "propios complejos")
cerca(algebra_propios([[2, 0, 0], [0, 3, 4], [0, 4, 9]])[2], [11, 0], "propios generales")
sea b = [[1, 2], [3, 4], [5, 6]]
cerca(algebra_svd(b)["s"], [9.525518091565107, 0.5143005806586441], "SVD")
cerca(algebra_pseudoinversa(b), [[-1.3333333333333333, -0.3333333333333333, 0.6666666666666666], [1.0833333333333333, 0.3333333333333333, -0.4166666666666667]], "pseudoinversa")
cerca(algebra_minimos_cuadrados(b, [1, 2, 2]), [-0.6666666666666666, 0.9166666666666666], "mínimos cuadrados")
cerca(algebra_cholesky([[4, 12, -16], [12, 37, -43], [-16, -43, 98]]), [[2, 0, 0], [6, 1, 0], [-8, 5, 3]], "Cholesky")
sea qr = algebra_qr(b)
cerca(algebra_mul(qr["q"], qr["r"]), b, "QR")
cerca(algebra_mul(algebra_transpuesta(qr["q"]), qr["q"]), algebra_identidad(3), "Q ortogonal")
cerca(algebra_exp(algebra_escalar([[0, -1], [1, 0]], 3.141592653589793 / 2)), [[0, -1], [1, 0]], "exponencial")
igual([algebra_rango([[1, 2, 3], [2, 4, 6], [1, 0, 1]]), longitud(algebra_nucleo([[1, 2, 3], [2, 4, 6], [1, 0, 1]]))], [2, 1], "rango y núcleo")
cerca([algebra_norma([3, 4]), algebra_norma([[1, 2], [3, 4]], 1), algebra_norma([[1, 2], [3, 4]], "inf"), algebra_traza(a)], [5, 6, 7, 18], "normas")
sea singular = falso
intentar { algebra_resolver([[1, 2], [2, 4]], [1, 2]) } capturar (e) { singular = verdadero }
igual(singular, verdadero, "singular")
mostrar("[OK] algebra")
