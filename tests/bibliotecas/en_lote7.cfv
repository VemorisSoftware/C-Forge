// Written in English.
import "totp"
import "metrics"
import "parser"
import "tilemap"
import "dialogue"
import "geo"
import "bench"
import "paseto"
function same(a, b, what) { assert(("" + a) == ("" + b), what + ": [" + a + "] != [" + b + "]") }
let secret = totp_base32("12345678901234567890")
same(totp_code(secret, 59000, 30, 8), "94287082", "totp")
same(totp_verify(secret, totp_code(secret, 59000), 1, 59000), true, "totp_verify")
let reg = metrics_registry()
let c = metrics_counter(reg, "jobs_total", "Jobs")
metrics_inc(c)
assert(texto_indice(metrics_render(reg), "jobs_total 1") >= 0, "metrics")
let digits = parser_map(parser_regex("[0-9]+"), function(t) { return a_numero(t) })
same(parser_parse(parser_sep_by(digits, parser_symbol(","), 1), "1, 2,3"), [1, 2, 3], "parser")
let map = tilemap_new(3, 1, 10)
tilemap_layer_text(map, "walls", "..#", {"#": 1})
let box = tilemap_move(map, "walls", {"x": 0, "y": 0, "width": 5, "height": 5}, 50, 0)
same([box["x"], box["hit_x"]], [15, true], "tilemap_move")
let d = dialogue_load("=== start\nBob: Hi {{name}}\n* [Bye] -> FIN", {"name": "Ann"})
let step = dialogue_step(d)
same([step["lines"][0]["speaker"], step["lines"][0]["text"], step["options"][0]["text"]], ["Bob", "Hi Ann", "Bye"], "dialogue")
assert(abs(geo_distance([48.8566, 2.3522], [51.5074, -0.1278]) - 343.56) < 0.5, "geo")
let b = bench_run("noop", function() { let x = 1 }, {"samples": 3, "target_ms": 2, "warmup_ms": 2})
same(b["samples"], 3, "bench")
assert(texto_empieza_con(bench_report(b), "noop: "), "bench_report")
let keys = paseto_keys()
let tok = paseto_sign(keys["secreta"], {"sub": "ann"}, {"expires_in": 60, "issuer": "me"})
same(paseto_verify(keys["publica"], tok, {"issuer": "me"})["sub"], "ann", "paseto")
print("[OK] lote 7 in English")
