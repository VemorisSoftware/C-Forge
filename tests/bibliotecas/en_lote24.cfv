// English aliases for batch 24.
importar "gizmo3d"
importar "shader"
importar "hypermedia"
importar "input_sim"
importar "wireguard"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// gizmo3d
sea view = gizmo_look_at([0, 0, 10], [0, 0, 0], [0, 1, 0])
sea proj = gizmo_perspective(60, 800 / 600, 0.1, 100)
sea g = gizmo_new({"mode": "translate", "size": 100})
gizmo_set_camera(g, view, proj, 800, 600, 0, 0)
sea I = gizmo_identity()
eq(gizmo_hover(g, I, 460, 302), {"mode": "translate", "part": "x"}, "gizmo_hover")
gizmo_mouse(g, I, 450, 300, verdadero)
sea r = gizmo_mouse(g, I, 500, 300, verdadero)
eq([r["active"], r["part"], r["matrix"][12] > 0.9, r["matrix"][13]], [verdadero, "x", verdadero, 0], "gizmo_mouse")
gizmo_mouse(g, I, 0, 0, falso)
eq(gizmo_is_using(g), falso, "released")
sea d = gizmo_decompose(gizmo_compose([1, 2, 3], [0, 0, 90], [1, 1, 1]))
eq([d["translation"], redondear(d["rotation"][2])], [[1, 2, 3], 90], "decompose")
// shader
sea src = "@fragment fn main() -> @location(0) vec4<f32> { return vec4<f32>(1.0, 0.5, 0.0, 1.0); }"
eq(shader_validate(src), [], "shader_validate")
eq(shader_entry_points(src)[0]["stage"], "fragment", "entry points")
afirmar(contiene(shader_translate(src, "glsl", nulo), "layout(location = 0) out vec4 _sb_out0;"), "glsl")
afirmar(contiene(shader_translate(src, "hlsl", nulo), "SV_Target0"), "hlsl")
afirmar(contiene(shader_translate(src, "msl", nulo), "[[color(0)]]"), "msl")
eq(shader_validate("fn f() { let a = b; }")[0]["line"], 1, "error line")
// hypermedia
eq(hx_is_request({"cabeceras": {"HX-Request": "true"}}), verdadero, "hx_is_request")
sea hr = hx_response("<p>hi</p>", {"trigger": "saved", "push_url": "/next"})
eq([hr["status"], hr["headers"]["HX-Trigger"], hr["headers"]["HX-Push-Url"]], [200, "saved", "/next"], "hx_response")
afirmar(contiene(hx_http(hr), "HX-Trigger: saved"), "hx_http")
eq(hx_attrs({"get": "/x", "target": "#r"}), "hx-get=" + caracter(34) + "/x" + caracter(34) + " hx-target=" + caracter(34) + "#r" + caracter(34), "hx_attrs")
eq(hx_request_info({"cabeceras": {"HX-Trigger": "btn"}})["trigger"], "btn", "hx_request_info")
// input_sim
eq([input_key_name("escape"), input_key_name("F12"), input_key_name("pageup")], ["Escape", "F12", "Prior"], "input_key_name")
// wireguard
sea ka = wg_keypair(nulo)
sea kb = wg_keypair(nulo)
sea wa = wg_new(ka["private"], kb["public_b64"], nulo)
sea wb = wg_new(kb["private"], ka["public"], nulo)
sea pkt = wg_udp_packet("10.0.0.1", "10.0.0.2", 1, 2, "hi")
sea step1 = wg_receive(wb, wg_encrypt(wa, pkt)[0], nulo)
sea step2 = wg_receive(wa, step1["send"][0], nulo)
eq([step1["event"], step2["event"], wg_receive(wb, step2["send"][0], nulo)["packets"]], ["session", "session", [pkt]], "wireguard handshake")
eq(wg_status(wa)["session"], verdadero, "wg_status")
mostrar("[OK] en_lote24")
