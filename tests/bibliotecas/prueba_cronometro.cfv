importar "cronometro"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea e = cronometro_estadistica("x", [1, 2, 3, 4, 100], 10)
igual([e["media_ms"], e["mediana_ms"], e["min_ms"], e["max_ms"], e["atipicos"], e["vueltas"], e["ops_por_s"]], [22, 3, 1, 100, 1, 10, 1000 / 22], "estadística")
sea r = cronometro_medir("suma", funcion() {
    sea s = 0
    sea i = 0
    mientras (i < 50) { s = s + i  i = i + 1 }
}, {"muestras": 5, "objetivo_ms": 5, "calentamiento_ms": 5})
igual(r["muestras"], 5, "muestras")
afirmar(r["media_ms"] > 0 y r["vueltas"] >= 1, "midió")
afirmar(r["ic95_ms"][0] <= r["media_ms"] y r["media_ms"] <= r["ic95_ms"][1], "intervalo de confianza")
afirmar(texto_empieza_con(cronometro_texto(r), "suma: "), cronometro_texto(r))
sea c = cronometro_comparar(funcion() { sea x = 1 }, funcion() {
    sea s = 0
    sea i = 0
    mientras (i < 2000) { s = s + i  i = i + 1 }
}, {"muestras": 5, "objetivo_ms": 5, "calentamiento_ms": 5})
igual(c["rapida"], "a", "comparar")
afirmar(c["veces"] > 5, "mucho más rápida: " + c["veces"])
mostrar("[OK] cronometro")
