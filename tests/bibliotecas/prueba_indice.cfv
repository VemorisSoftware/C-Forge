importar "indice"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion ids(r) {
    sea l = []
    para x en r { l.agregar(x["id"]) }
    retornar l
}
igual(indice_terminos("Las CANCIONES del Álbum, luces y raíces"), ["cancion", "album", "luz", "raiz"], "términos")
sea i = indice_nuevo({"campos": {"titulo": 3, "cuerpo": 1}})
indice_agregar(i, "p1", {"titulo": "Canción nueva", "cuerpo": "El álbum sale en marzo con canciones inéditas"})
indice_agregar(i, "p2", {"titulo": "Gira 2027", "cuerpo": "Fechas de conciertos y álbumes en vivo"})
indice_agregar(i, "p3", {"titulo": "Entrevista", "cuerpo": "Habla de su proceso creativo en marzo"})
indice_agregar(i, "p4", {"titulo": "Álbum", "cuerpo": "Portada"})
igual(ids(indice_buscar(i, "album")), ["p4", "p2", "p1"], "título pesa más y documentos cortos primero")
igual(ids(indice_buscar(i, "ALBUMES marzo")), ["p4", "p1", "p3", "p2"], "plural, mayúsculas y tildes")
igual(ids(indice_buscar(i, "album marzo", {"todos": verdadero})), ["p1"], "todos los términos")
igual(ids(indice_buscar(i, "album -marzo")), ["p4", "p2"], "exclusión")
igual(ids(indice_buscar(i, "canc", {"prefijo": verdadero})), ["p1"], "prefijo")
igual(ids(indice_buscar(i, "gira concierto")), ["p2"], "otro documento")
igual(ids(indice_buscar(i, "el de y")), [], "solo palabras vacías")
igual(ids(indice_buscar(i, "album", {"limite": 1})), ["p4"], "límite")
igual(indice_resaltar(i, "p1", "cuerpo", "album marzo"), "El <mark>álbum</mark> sale en <mark>marzo</mark> con canciones inéditas", "resaltar")
indice_agregar(i, "p4", {"titulo": "Portada", "cuerpo": "Diseño"})
igual(ids(indice_buscar(i, "album")), ["p2", "p1"], "reemplazo")
igual(indice_quitar(i, "p1"), verdadero, "quitar")
igual([ids(indice_buscar(i, "cancion")), indice_tamano(i), indice_quitar(i, "zz")], [[], 3, falso], "ya no está")
indice_guardar(i, "/tmp/cforge-indice.json")
igual(ids(indice_buscar(indice_cargar("/tmp/cforge-indice.json"), "marzo")), ["p3"], "guardar y cargar")
eliminar_archivo("/tmp/cforge-indice.json")
sea en = indice_nuevo()
indice_agregar(en, 1, "Running shoes for the city")
indice_agregar(en, 2, "The best boxes")
igual(ids(indice_buscar(en, "shoe")), ["1"], "inglés sin campos")
igual(ids(indice_buscar(en, "the")), [], "stopword en inglés")
mostrar("[OK] indice")
