importar "semilla"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
igual(hex_de_bytes(semilla_ripemd160("abc")), "8eb208f7e05d987a9b044a8e98c6b087f15a0bfc", "RIPEMD-160")
sea f = "abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"
igual(semilla_desde_entropia(bytes_de_hex("00000000000000000000000000000000")), f, "entropía → frase")
igual(hex_de_bytes(semilla_a_entropia(f)), "00000000000000000000000000000000", "frase → entropía")
// Vector de Trezor (BIP-39).
sea s = semilla_a_semilla(f, "TREZOR")
igual(hex_de_bytes(s), "c55257c360c07c72029aebc1b53c05ed0362ada38ead3e3e9efa3708e53495531f09a6987599d18264c1e1c92f2cf141630c7a3c4ab7c81b2f001698e7463b04", "semilla con contraseña")
igual(semilla_extendida(semilla_maestra(s)), "xprv9s21ZrQH143K3h3fDYiay8mocZ3afhfULfb5GX8kCBdno77K4HiA15Tg23wpbeF1pLfs1c5SPmYHrEpTuuRhxMwvKDwqdKiGJS9XFKzUsAF", "xprv maestra")
// Primeras direcciones de "abandon … about" (BIP-44/84/86).
sea m = semilla_maestra(semilla_a_semilla(f, ""))
igual(semilla_direccion(semilla_derivar(m, "m/84'/0'/0'/0/0"), "p2wpkh"), "bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyu", "BIP-84")
igual(semilla_direccion(semilla_derivar(m, "m/44'/0'/0'/0/0"), "p2pkh"), "1LqBGSKuX5yYUonjxT5qGfpUsXKYYWeabA", "BIP-44")
igual(semilla_direccion(semilla_derivar(m, "m/86'/0'/0'/0/0"), "p2tr"), "bc1p5cyxnuxmeuwuvkwfem96lqzszd02n6xdcjrs20cac6yqjjwudpxqkedrcr", "BIP-86 Taproot")
// Derivar solo con la pública da lo mismo.
sea cuenta = semilla_derivar(m, "m/84'/0'/0'")
sea xpub = semilla_extendida(cuenta, verdadero)
igual(hex_de_bytes(semilla_derivar(semilla_de_extendida(xpub), "0/0")["publica"]), hex_de_bytes(semilla_derivar(cuenta, "0/0")["publica"]), "xpub deriva igual")
sea fallo = ""
intentar { semilla_hija(semilla_de_extendida(xpub), 2147483648) } capturar (e) { fallo = e }
igual(fallo, "semilla: no se puede derivar una hija endurecida desde una clave pública", "endurecida sin privada")
// Español, igual que python-mnemonic (NFKD).
sea es = semilla_desde_entropia(bytes_de_hex("7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f7f"), "es")
igual(es, "ligero vista talar yogur venta queso yacer trozo ligero vista talar yogur venta queso yacer trozo ligero vista talar yogur venta queso yacer teatro", "frase en español")
igual(hex_de_bytes(semilla_a_semilla(es, "ñandú")), "e8838638ff4eac8a820a54105c5bc6bb3ee3dea1984583490f8ee40aeb7f400caaadf16e7bee34077730763239f59eb77471b5c305c93b5777fbd12f8c600278", "semilla en español con ñ")
igual(semilla_valida("abaco abaco abaco abaco abaco abaco abaco abaco abaco abaco abaco abierto", "es"), verdadero, "acepta sin tildes")
igual(semilla_valida(texto_reemplazar(f, "about", "abandon")), falso, "checksum inválido")
igual(semilla_base58(bytes_de_hex("0000287fb4cd")), "11233QC4", "base58 con ceros")
igual(hex_de_bytes(semilla_de_segwit("bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyu")["programa"]), "c0cebcd6c3d3ca8c75dc5ec62ebe55330ef910e2", "decodificar bech32")
intentar { semilla_de_segwit("bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyv") } capturar (e) { fallo = e }
igual(fallo, "semilla: checksum bech32 inválido", "bech32 alterado")
igual(semilla_wif(semilla_derivar(m, "m/84'/0'/0'/0/0")), "KyZpNDKnfs94vbrwhJneDi77V6jF64PWPF8x5cdJb8ifgg2DUc9d", "WIF")
mostrar("[OK] semilla")
