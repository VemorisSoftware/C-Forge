importar "latido"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Temporizadores en orden, repetidos y detenidos; próximos e inactivos.
sea b = latido_bucle()
sea orden = []
latido_temporizador(b, 30, 0, funcion(t) { orden.agregar("30") })
latido_temporizador(b, 10, 0, funcion(t) { orden.agregar("10") })
latido_temporizador(b, 10, 0, funcion(t) { orden.agregar("10b") })
sea veces = [0]
latido_temporizador(b, 5, 5, funcion(t) {
    veces[0] = veces[0] + 1
    si (veces[0] == 3) { latido_detener(t) }
})
latido_proximo(b, funcion() { orden.agregar("proximo") })
sea vueltas_inactivo = [0]
latido_inactivo(b, funcion(h) {
    vueltas_inactivo[0] = vueltas_inactivo[0] + 1
    si (vueltas_inactivo[0] == 3) { latido_detener(h) }
})
sea t0 = tiempo_ms()
igual(latido_correr(b, nulo), falso, "terminó")
igual([orden, veces[0], vueltas_inactivo[0], tiempo_ms() - t0 >= 29], [["proximo", "10", "10b", "30"], 3, 3, verdadero], "temporizadores")
// Sin referencia: no mantiene vivo el bucle.
sea b2 = latido_bucle()
sea nunca = latido_temporizador(b2, 100000, 0, funcion(t) { lanzar "no debería correr" })
latido_sin_ref(nunca)
igual(latido_correr(b2, nulo), falso, "sin ref")
// Tubo: escribir y leer hasta el final.
sea b3 = latido_bucle()
sea p = latido_tubo(b3)
sea leido = []
latido_leer(p[0], funcion(s, d) {
    si (d == nulo) {
        leido.agregar("<fin>")
        latido_cerrar(s, nulo)
    } sino { leido.agregar(d) }
})
sea escrito = [falso]
latido_escribir(p[1], "hola ", nulo)
latido_escribir(p[1], "mundo", funcion(s) { escrito[0] = verdadero })
latido_terminar(p[1], nulo)
latido_correr(b3, nulo)
igual([unir(leido, ""), escrito[0]], ["hola mundo<fin>", verdadero], "tubo")
// TCP: servidor de eco y cliente en el mismo bucle.
sea b4 = latido_bucle()
sea srv = latido_tcp_servidor(b4, "127.0.0.1", 0, funcion(c) {
    latido_leer(c, funcion(s, d) {
        si (d == nulo) {
            latido_cerrar(s, nulo)
            latido_cerrar_servidor(srv)
        } sino { latido_escribir(s, texto_mayusculas(d), nulo) }
    })
})
sea puerto = latido_puerto(srv)
igual(puerto > 0, verdadero, "puerto libre")
sea respuesta = []
latido_tcp_conectar(b4, "127.0.0.1", puerto, funcion(c, err) {
    igual(err, nulo, "conectar")
    latido_leer(c, funcion(s, d) {
        si (d == nulo) { latido_cerrar(s, nulo) } sino {
            respuesta.agregar(d)
            si (unir(respuesta, "") == "ECO DESDE LATIDO") { latido_terminar(s, nulo) }
        }
    })
    latido_escribir(c, "eco desde ", nulo)
    latido_escribir(c, "latido", nulo)
})
sea guardia = latido_temporizador(b4, 5000, 0, funcion(t) { lanzar "el eco tardó demasiado" })
latido_sin_ref(guardia)
latido_correr(b4, nulo)
igual(unir(respuesta, ""), "ECO DESDE LATIDO", "eco TCP")
// Conexión rechazada.
sea b5 = latido_bucle()
sea error = [nulo]
latido_tcp_conectar(b5, "127.0.0.1", 1, funcion(c, err) { error[0] = err })
latido_correr(b5, nulo)
igual(texto_empieza_con("" + error[0], "no se pudo conectar"), verdadero, "rechazada")
// Trabajo encadenado.
sea b6 = latido_bucle()
sea res = []
latido_trabajo(b6, funcion() { retornar 6 * 7 }, funcion(e, v) { res.agregar(v) })
latido_trabajo(b6, funcion() { lanzar "falló" }, funcion(e, v) { res.agregar(e) })
latido_correr(b6, nulo)
igual(res, [42, "falló"], "trabajo")
mostrar("[OK] latido")
