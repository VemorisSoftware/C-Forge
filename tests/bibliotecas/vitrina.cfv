importar "vitrina"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ":\n" + a + "\n!=\n" + b) }
igual(vitrina_tabla(["Producto", "Precio"], [["Café", 2500], ["Té", 18]], {"titulo": "Menú"}), unir([
    "        Menú",
    "╭──────────┬────────╮",
    "│ Producto │ Precio │",
    "├──────────┼────────┤",
    "│ Café     │   2500 │",
    "│ Té       │     18 │",
    "╰──────────┴────────╯"], "\n"), "tabla")
igual(vitrina_tabla(["a", "b"], [["xyz", nulo]], {"borde": "ascii", "alinear": ["centro", "der"]}), "+-----+---+\n| a   | b |\n+-----+---+\n| xyz |   |\n+-----+---+", "ascii")
igual(vitrina_tabla(["n"], [["a\nb"]], {"borde": "doble"}), "╔═════╗\n║ n   ║\n╠═════╣\n║ a b ║\n╚═════╝", "salto de línea aplanado")
igual(vitrina_panel("Listo ✓\nsegunda línea", "Estado"), "╭─ Estado ──────╮\n│ Listo ✓       │\n│ segunda línea │\n╰───────────────╯", "panel")
igual(vitrina_panel("x", nulo, "simple"), "┌───┐\n│ x │\n└───┘", "panel simple")
igual(vitrina_arbol({"nombre": "src", "hijos": [{"nombre": "app", "hijos": ["a.cfv", "b.cfv"]}, "main.cfv"]}), "src\n├── app\n│   ├── a.cfv\n│   └── b.cfv\n└── main.cfv", "árbol")
sea e = caracter(27)
igual([vitrina_ancho("ñandú"), vitrina_ancho(e + "[31mrojo" + e + "[0m"), vitrina_ancho("🚀x"), vitrina_ancho("日本")], [5, 4, 3, 4], "anchos")
sea m = ""
intentar { vitrina_tabla(["a", "b"], [["1"]]) } capturar (x) { m = x }
igual(m, "vitrina: la fila tiene 1 celdas y hay 2 columnas", "fila corta")
mostrar("[OK] vitrina")
