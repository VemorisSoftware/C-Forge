importar "mosaico"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea m = mosaico_nuevo(6, 4, 16)
mosaico_capa_texto(m, "muros", "######\n#....#\n#..#.#\n######", {"#": 1})
igual([mosaico_tile(m, "muros", 0, 0), mosaico_tile(m, "muros", 1, 1), mosaico_tile(m, "muros", 99, 0)], [1, 0, 0], "tiles")
igual([mosaico_solido(m, "muros", 40, 40), mosaico_solido(m, "muros", 52, 36), mosaico_solido(m, "muros", -5, 10)], [falso, verdadero, verdadero], "sólidos (fuera = sólido)")
igual([mosaico_celda(m, 33, 17), mosaico_pixel(m, 2, 1)], [[2, 1], [32, 16]], "celda y píxel")
sea c = mosaico_mover(m, "muros", {"x": 20, "y": 20, "ancho": 8, "alto": 8}, 100, 0)
igual([c["x"], c["y"], c["choco_x"], c["choco_y"]], [72, 20, verdadero, falso], "choca a la derecha")
c = mosaico_mover(m, "muros", {"x": 20, "y": 20, "ancho": 8, "alto": 8}, -100, 50)
igual([c["x"], c["y"], c["choco_x"], c["choco_y"]], [16, 40, verdadero, verdadero], "choca en dos ejes")
c = mosaico_mover(m, "muros", {"x": 20, "y": 20, "ancho": 8, "alto": 8}, 5, 3)
igual([c["x"], c["y"], c["choco_x"]], [25, 23, falso], "movimiento libre")
igual(mosaico_camino(m, "muros", [1, 1], [4, 2]), [[1, 1], [2, 1], [3, 1], [4, 1], [4, 2]], "A*")
igual(mosaico_camino(m, "muros", [1, 1], [3, 2]), nulo, "sin camino")
igual(mosaico_visibles(m, {"x": 10, "y": 10, "ancho": 40, "alto": 20}), [0, 0, 3, 1], "visibles")
sea tiled = "{\"width\": 3, \"height\": 2, \"tilewidth\": 8, \"tileheight\": 8, \"properties\": [{\"name\": \"musica\", \"value\": \"bosque\"}], \"layers\": [{\"type\": \"tilelayer\", \"name\": \"suelo\", \"data\": [1, 2, 3, 2147483652, 0, 6]}, {\"type\": \"objectgroup\", \"name\": \"entidades\", \"objects\": [{\"id\": 1, \"name\": \"jugador\", \"type\": \"heroe\", \"x\": 8, \"y\": 4, \"properties\": [{\"name\": \"vida\", \"value\": 3}]}, {\"id\": 2, \"name\": \"cofre\", \"x\": 16, \"y\": 8}]}]}"
sea t = mosaico_desde_tiled(tiled)
igual([mosaico_tile(t, "suelo", 0, 1), mosaico_tile(t, "suelo", 2, 1), t["propiedades"]["musica"]], [4, 6, "bosque"], "Tiled (sin banderas de volteo)")
sea j = mosaico_objetos(t, "entidades", "jugador")
igual([longitud(j), j[0]["x"], j[0]["vida"], longitud(mosaico_objetos(t, "entidades", "heroe")), longitud(mosaico_objetos(t, "entidades"))], [1, 8, 3, 1, 2], "objetos")
mosaico_poner(m, "muros", 3, 2, 0)
igual(longitud(mosaico_camino(m, "muros", [1, 1], [3, 2])), 4, "poner abre camino")
sea x = ""
intentar { mosaico_capa(m, "mala", [1, 2]) } capturar (e) { x = e }
igual(x, "mosaico: la capa mala debe tener 24 tiles", "tamaño de capa")
mostrar("[OK] mosaico")
