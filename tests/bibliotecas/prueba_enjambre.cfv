importar "enjambre"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
igual(enjambre_hilos() >= 1, verdadero, "hilos")
sea n = []
sea i = 0
mientras (i < 1000) {
    n.agregar((i * 7919) % 1000)
    i = i + 1
}
// Mismos resultados que en secuencia, con varios repartos.
para h en [1, 2, 3, 8] {
    sea op = {"hilos": h}
    igual(enjambre_mapear(n, funcion(x) { retornar x * x }, op), mapear(n, funcion(x) { retornar x * x }), "mapear con " + h)
    igual(enjambre_filtrar(n, funcion(x) { retornar x % 3 == 0 }, op), filtrar(n, funcion(x) { retornar x % 3 == 0 }), "filtrar con " + h)
    igual(enjambre_reducir(n, 0, funcion(a, x) { retornar a + x }, nulo, op), 499500, "reducir con " + h)
    igual(enjambre_contar(n, funcion(x) { retornar x < 10 }, op), 10, "contar con " + h)
}
igual(enjambre_suma(n), 499500, "suma")
igual(enjambre_extremos(n), [0, 999], "extremos")
igual(enjambre_buscar_indice(n, funcion(x) { retornar x == 500 }, nulo), 500 * 1, "buscar índice")
igual([enjambre_alguno(n, funcion(x) { retornar x > 998 }, nulo), enjambre_todos(n, funcion(x) { retornar x >= 0 }, nulo), enjambre_buscar(n, funcion(x) { retornar x > 2000 }, nulo)], [verdadero, verdadero, nulo], "alguno, todos y buscar")
igual(enjambre_rango(5, 10, funcion(k) { retornar k * 10 }, nulo), [50, 60, 70, 80, 90], "rango")
igual(enjambre_mapear_indice(["a", "b"], funcion(x, k) { retornar x + k }, nulo), ["a0", "b1"], "con índice")
// Ordenar: igual que ordenar() y estable.
sea o = enjambre_ordenar(n, nulo, {"hilos": 4})
sea ok = verdadero
i = 1
mientras (i < longitud(o)) {
    si (o[i - 1] > o[i]) { ok = falso }
    i = i + 1
}
igual([longitud(o), ok, o[0], o[999]], [1000, verdadero, 0, 999], "ordenar")
sea pares = [[2, "a"], [1, "b"], [2, "c"], [1, "d"], [0, "e"], [2, "f"]]
igual(enjambre_ordenar(pares, funcion(a, b) { retornar a[0] - b[0] }, {"hilos": 3}), [[0, "e"], [1, "b"], [1, "d"], [2, "a"], [2, "c"], [2, "f"]], "estable")
// Unir y todas.
igual(enjambre_unir(funcion() { retornar 6 * 7 }, funcion() { retornar "listo" }), [42, "listo"], "unir")
igual(enjambre_todas([funcion() { retornar 1 }, funcion() { retornar 2 }, funcion() { retornar 3 }]), [1, 2, 3], "todas")
// Un error en un hilo llega al que llama.
sea err = nulo
intentar { enjambre_mapear(n, funcion(x) {
    si (x == 777) { lanzar "falló en 777" }
    retornar x
}, {"hilos": 4}) } capturar (e) { err = "" + e }
igual(err, "falló en 777", "errores")
igual(enjambre_mapear([], funcion(x) { retornar x }, nulo), [], "vacía")
// Muchas tareas cortas: esperar no debe quedarse colgada si la tarea
// termina justo mientras se empieza a esperar.
sea ronda = 0
mientras (ronda < 200) {
    igual(enjambre_mapear([1, 2, 3, 4, 5, 6, 7, 8], funcion(x) { retornar x + 1 }, {"hilos": 8, "trozo": 1}), [2, 3, 4, 5, 6, 7, 8, 9], "ronda")
    ronda = ronda + 1
}
mostrar("[OK] enjambre")
