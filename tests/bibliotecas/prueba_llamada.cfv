importar "llamada"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea e = llamada_esquema("syntax = \"proto3\";\npackage demo.v1;\n// Comentario\nenum Color { ROJO = 0; VERDE = 1; AZUL = 2; }\nmessage Punto { double x = 1; float y = 2; }\nmessage Pedido {\n  int32 id = 1;\n  string cliente = 2;\n  repeated int64 montos = 3;\n  map<string, int32> stock = 4;\n  Color color = 5;\n  repeated Punto ruta = 6;\n  oneof pago { string tarjeta = 7; bool efectivo = 8; }\n  sint64 delta = 9;\n  uint64 grande = 10;\n  fixed32 f32 = 11;\n  sfixed64 sf64 = 12;\n  bytes crudo = 13;\n  optional int32 opcional = 14;\n  message Item { string sku = 1; }\n  Item item = 15;\n  repeated string etiquetas = 16;\n}\nservice Tienda { rpc Crear (Pedido) returns (Pedido); rpc Mirar (stream Pedido) returns (stream Punto) {} }\n")
sea v = {"id": -7, "cliente": "Ana ñ", "montos": [1, -2, "9007199254740993"], "stock": {"a": 3, "b": -1}, "color": "AZUL", "ruta": [{"x": 1.5, "y": -2.25}, {"x": -1e-300, "y": 3.4e38}], "tarjeta": "4242", "delta": "-12345678901", "grande": "18446744073709551615", "f32": 4000000000, "sf64": -5, "crudo": bytes_de_hex("00ff"), "opcional": 0, "item": {"sku": "Z9"}, "etiquetas": ["x", "y"]}
// Bytes generados por protoc + python (google.protobuf).
sea esperado = ""
igual(hex_de_bytes(llamada_codificar(e, "Pedido", v)), esperado, "codificar igual que protoc")
sea d = llamada_decodificar(e, "Pedido", bytes_de_hex(esperado))
igual([d["id"], d["cliente"], d["montos"], d["stock"], d["color"], d["tarjeta"], d["delta"], d["grande"], d["f32"], d["sf64"], hex_de_bytes(d["crudo"]), d["opcional"], d["item"]["sku"], d["etiquetas"]], [-7, "Ana ñ", [1, -2, "9007199254740993"], {"a": 3, "b": -1}, "AZUL", "4242", "-12345678901", "18446744073709551615", 4000000000, -5, "00ff", 0, "Z9", ["x", "y"]], "decodificar")
igual([d["ruta"][0]["x"], d["ruta"][0]["y"], d["ruta"][1]["x"]], [1.5, -2.25, -1e-300], "double y float")
igual(llamada_decodificar(e, "Pedido", "")["cliente"], "", "valores por defecto de proto3")
igual(hex_de_bytes(llamada_codificar(e, "Pedido", {"id": 0, "cliente": ""})), "", "proto3 no escribe ceros")
igual(hex_de_bytes(llamada_codificar(e, "Pedido.Item", {"sku": "a"})), "0a0161", "mensaje anidado por nombre")
sea p = llamada_peticion(e, "Tienda", "Crear", {"id": 1})
igual([p["ruta"], hex_de_bytes(p["cuerpo"]), p["salida"]], ["/demo.v1.Tienda/Crear", "00000000020801", "Pedido"], "petición gRPC")
igual(llamada_marcos(llamada_marco("ab") + llamada_marco("")), ["ab", ""], "marcos gRPC")
igual(llamada_estado({"grpc-status": "5", "grpc-message": "no%20existe"}), {"codigo": 5, "mensaje": "no existe", "nombre": "NOT_FOUND"}, "estado gRPC")
sea m = ""
intentar { llamada_codificar(e, "Pedido", {"nada": 1}) } capturar (x) { m = x }
igual(m, "llamada: Pedido no tiene el campo nada", "campo desconocido")
intentar { llamada_codificar(e, "Pedido", {"color": "MORADO"}) } capturar (x) { m = x }
igual(m, "llamada: valor de enum desconocido MORADO", "enum desconocido")
mostrar("[OK] llamada")
