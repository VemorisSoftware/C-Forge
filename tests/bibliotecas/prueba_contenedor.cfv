importar "contenedor"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Contra dockerd 29 se probaron: ping, versión, crear/iniciar/esperar/logs,
// puertos publicados, exec con código de salida, copiar dentro y fuera,
// top, build desde un mapa de archivos, redes y errores 404.
igual(contenedor_respuesta_http("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nhola\r\n6;x=1\r\n mundo\r\n0\r\n\r\n")["cuerpo"], "hola mundo", "chunked")
igual(contenedor_respuesta_http("HTTP/1.0 404 No\r\nContent-Length: 3\r\nX-A: b\r\n\r\nabcdef")["cuerpo"], "abc", "content-length")
sea mx = contenedor_multiplexar([[1, "uno\n"], [2, "err\n"], [1, "dos\n"]])
sea d0 = contenedor_demultiplexar(mx)
igual([d0["stdout"], d0["stderr"], longitud(d0["tramas"])], ["uno\ndos\n", "err\n", 3], "multiplexado")
igual(contenedor_demultiplexar("texto con tty")["stdout"], "texto con tty", "tty")
sea cfg = contenedor_config({"imagen": "x", "cmd": "echo hi", "env": {"A": "1"}, "puertos": {"80": 0, "53/udp": 5353}, "volumenes": {"/h": "/c"}, "red": "r1", "alias": ["web"], "memoria": 1048576, "cpus": 0.5, "salud": {"cmd": "true"}})
igual([cfg["Cmd"], cfg["Env"], claves(cfg["ExposedPorts"]), cfg["HostConfig"]["PortBindings"]["53/udp"][0]["HostPort"], cfg["HostConfig"]["PortBindings"]["80/tcp"][0]["HostPort"], cfg["HostConfig"]["Binds"], cfg["HostConfig"]["NanoCpus"], cfg["NetworkingConfig"]["EndpointsConfig"]["r1"]["Aliases"], cfg["Healthcheck"]["Test"]], [["/bin/sh", "-c", "echo hi"], ["A=1"], ["53/udp", "80/tcp"], "5353", "", ["/h:/c"], 500000000, ["web"], ["CMD-SHELL", "true"]], "config")
// Motor simulado.
sea sim = contenedor_simulado()
sea d = contenedor_cliente(nulo, {"transporte": sim["transporte"], "version": "1.43"})
igual([contenedor_ping(d), contenedor_version(d)["ApiVersion"]], [verdadero, "1.43"], "ping y versión")
sea id = contenedor_crear(d, {"imagen": "cforge/mini:1", "cmd": "echo hola", "nombre": "prueba", "etiquetas": {"a": "b"}})
igual(sim["estado"]["peticiones"][longitud(sim["estado"]["peticiones"]) - 1], "POST /v1.43/containers/create?name=prueba", "ruta con versión")
contenedor_iniciar(d, id)
igual([contenedor_esperar(d, id), contenedor_logs(d, id, nulo)["stdout"]], [0, "hola\n"], "esperar y logs")
sea f = contenedor_crear(d, {"imagen": "cforge/mini:1", "cmd": "falla 7"})
contenedor_iniciar(d, f)
igual([contenedor_esperar(d, f), contenedor_logs(d, f, nulo)["stderr"], contenedor_estado(d, f)["estado"]], [7, "error\n", "exited"], "código de salida")
sea s = contenedor_crear(d, {"imagen": "cforge/mini:1", "cmd": "sleep 9", "puertos": {"6379/tcp": 0, "80": 8080}})
contenedor_iniciar(d, s)
igual([contenedor_puerto(d, s, "6379/tcp"), contenedor_puerto(d, s, 80)], [32769, 8080], "puertos")
igual(contenedor_ejecutar(d, s, "ls /", nulo), {"codigo": 0, "stderr": "", "stdout": "salida de ls /\n"}, "exec")
igual(contenedor_ejecutar(d, s, ["falla"], nulo)["codigo"], 3, "exec que falla")
igual([longitud(contenedor_listar(d, verdadero, nulo)), longitud(contenedor_listar(d, verdadero, {"label": ["a=b"]}))], [3, 1], "listar")
sea err = nulo
intentar { contenedor_borrar(d, s, nulo, nulo) } capturar (e) { err = contenedor_error_texto(e) }
igual(err, "HTTP 409: container is running", "borrar corriendo")
contenedor_borrar(d, s, verdadero, nulo)
err = nulo
intentar { contenedor_crear(d, {"imagen": "no/existe"}) } capturar (e) { err = e }
igual([err["estado"], err["mensaje"]], [404, "No such image: no/existe"], "imagen inexistente")
err = nulo
intentar { contenedor_inspeccionar(d, "zz") } capturar (e) { err = contenedor_error_texto(e) }
igual(err, "HTTP 404: No such container: zz", "inspeccionar inexistente")
mostrar("[OK] contenedor")
