importar "multitud"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea m = multitud_nueva()
sea i = 0
mientras (i < 12) {
    multitud_agregar(m, (i % 4) * 12, piso(i / 4) * 12, {"destino": [300 + (i % 4) * 20, 200 + piso(i / 4) * 20], "velocidad_max": 80})
    i = i + 1
}
multitud_obstaculo(m, 150, 100, 30)
sea minima = 999
sea paso = 0
mientras (paso < 900 y multitud_llegaron(m) == falso) {
    multitud_paso(m, 1 / 30)
    minima = minimo(minima, multitud_distancia_minima(m))
    para a en multitud_agentes(m) {
        sea dx = a["x"] - 150
        sea dy = a["y"] - 100
        afirmar(raiz(dx * dx + dy * dy) >= 35 - 0.001, "nadie atraviesa el obstáculo")
    }
    paso = paso + 1
}
igual(multitud_llegaron(m), verdadero, "todos llegan")
afirmar(minima > 9, "no se superponen: " + minima)
// Bandada sin destino: termina alineada.
sea b = multitud_nueva({"radio_vecinos": 200, "limites": [0, 0, 1000, 1000]})
i = 0
mientras (i < 10) {
    multitud_agregar(b, 400 + i * 15, 400 + (i % 3) * 15, {"vx": 20 + i * 3, "vy": 10 - i * 2, "velocidad_max": 40})
    i = i + 1
}
paso = 0
mientras (paso < 300) { multitud_paso(b, 1 / 30)  paso = paso + 1 }
sea vx = []
para a en multitud_agentes(b) { vx.agregar(a["vx"]) }
sea lo = vx[0]
sea hi = vx[0]
para v en vx { lo = minimo(lo, v)  hi = maximo(hi, v) }
afirmar(hi - lo < 10, "bandada alineada: " + lo + " … " + hi)
para a en multitud_agentes(b) { afirmar(a["x"] >= 0 y a["x"] <= 1000 y a["y"] >= 0 y a["y"] <= 1000, "dentro de los límites") }
mostrar("[OK] multitud")
