// English names for lote 27.
importar "rustls"
importar "quinn"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea ca = rustls_issue(["Test CA"], {"ca": verdadero, "key": rustls_new_key("P-256")})
sea leaf = rustls_issue(["localhost"], {"issuer": {"certificate": ca["der"], "key": ca["key"]}})
sea cert = rustls_certificate(leaf["der"])
eq([cert["subject"]["CN"], cert["issuer"]["CN"], cert["is_ca"], cert["signature_algorithm"]], ["localhost", "Test CA", falso, "ecdsa_sha256"], "rustls_certificate")
sea s = rustls_server({"chain": [leaf["der"]], "key": leaf["key"], "alpn": ["h2"]})
sea c = rustls_client("localhost", {"roots": ca["pem"], "alpn": ["h2"]})
sea n = 0
mientras ((rustls_is_ready(c) == falso o rustls_is_ready(s) == falso) y n < 10) {
    rustls_feed(s, rustls_take_output(c))
    rustls_feed(c, rustls_take_output(s))
    n = n + 1
}
eq([rustls_info(c)["alpn"], rustls_info(c)["state"], rustls_info(c)["certificates"][0]["names"]], ["h2", "conectado", ["localhost"]], "rustls_info")
rustls_write(c, "ping")
rustls_feed(s, rustls_take_output(c))
eq(rustls_read(s), "ping", "rustls_write/read")
eq(rustls_read_key(leaf["key_pem"])["type"], "ed25519", "rustls_read_key")
// quinn
eq(hex_de_bytes(quic_initial_keys(bytes_de_hex("8394c8f03e515708"))["client"]["key"]), "1f369613dd76d5467730efcbe3b1a22d", "quic_initial_keys")
sea qc = quic_client("localhost", {"roots": ca["pem"]})
sea qs = quic_server({"chain": [leaf["der"]], "key": leaf["key"]})
sea id = nulo
sea resp = nulo
sea t = 0
mientras (t < 3000) {
    para dg en quic_poll_transmit(qc, t) { quic_receive(qs, dg, t) }
    h3_serve_requests(qs, funcion(req) { retornar {"status": 200, "body": "hello " + req["path"]} })
    para dg en quic_poll_transmit(qs, t) { quic_receive(qc, dg, t) }
    si (quic_is_connected(qc) y id == nulo) { id = h3_request(qc, "GET", "localhost", "/en", [], nulo) }
    si (id != nulo) {
        resp = h3_response(qc, id)
        si (resp["fin"]) { romper }
    }
    t = t + 100
}
eq([resp["status"], resp["body"]], [200, "hello /en"], "h3_request/h3_response")
afirmar(longitud(quic_events(qc)) > 0, "quic_events")
mostrar("[OK] en_lote27")
