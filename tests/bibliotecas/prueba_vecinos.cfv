importar "vecinos"
importar "base64"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Respuesta mDNS armada con dnslib (Python): PTR, SRV, TXT, A y AAAA.
sea PY = base64_decodificar("AACFAAAAAAMAAAACBV9odHRwBF90Y3AFbG9jYWwAAAwAAQAAEZQAEA1XZWIgZGUgUHJ1ZWJhwAzAKAAhgAEAAAB4ABYAAAAAH5AIc2Vydmlkb3IFbG9jYWwAwCgAEIABAAARlAAUDHBhdGg9L2luaWNpbwZzZWd1cm8Ic2Vydmlkb3LAFwABgAEAAAB4AAQKAAAHwHoAHIABAAAAeAAQIAENuAAAAAAAAAAAAAAABw==")
sea d = vecinos_decodificar(PY)
igual([d["respuesta"], longitud(d["respuestas"]), longitud(d["adicionales"])], [verdadero, 3, 2], "secciones")
igual([d["respuestas"][1]["flush"], d["respuestas"][1]["datos"]["puerto"], d["adicionales"][1]["datos"]], [verdadero, 8080, "2001:db8::7"], "registros")
sea s = vecinos_reunir([d], "_http._tcp.local.")
igual([s[0]["instancia"], s[0]["equipo"], s[0]["puerto"], s[0]["direcciones"], s[0]["txt"]["path"], s[0]["txt"]["seguro"]], ["Web de Prueba", "servidor.local.", 8080, ["10.0.0.7", "2001:db8::7"], "/inicio", verdadero], "reunir")
// Anuncio propio (dnslib y python-zeroconf lo leen igual) y compresión de nombres.
sea sv = vecinos_servicio({"instancia": "Impresora de Ana", "tipo": "_ipp._tcp", "puerto": 631, "equipo": "ana-pc.local", "direcciones": ["192.168.1.20", "fe80::1:2"], "txt": {"rp": "printers/ana", "color": verdadero}})
sea an = vecinos_anuncio(sv, falso)
sea da = vecinos_decodificar(an)
igual([longitud(da["respuestas"]), da["respuestas"][0]["datos"], da["respuestas"][4]["datos"], da["respuestas"][2]["datos"]["rp"]], [5, "Impresora de Ana._ipp._tcp.local.", "fe80::1:2", "printers/ana"], "anuncio")
igual(longitud(an) < 200, verdadero, "nombres comprimidos")
igual(vecinos_decodificar(vecinos_anuncio(sv, verdadero))["respuestas"][1]["ttl"], 0, "despedida")
// Nombres con puntos y barras dentro de una etiqueta.
sea raro = vecinos_servicio({"instancia": "Sala 1.b", "tipo": "_http._tcp", "puerto": 80})
igual(vecinos_reunir([vecinos_decodificar(vecinos_anuncio(raro, falso))], nulo)[0]["instancia"], "Sala 1.b", "punto escapado")
// Responder preguntas.
sea q = vecinos_pregunta("_ipp._tcp.local.", "PTR", 99)
igual(vecinos_decodificar(q)["preguntas"][0], {"clase": 1, "nombre": "_ipp._tcp.local.", "tipo": "PTR", "unicast": falso}, "pregunta")
sea r = vecinos_decodificar(vecinos_responder([sv], q))
igual([r["id"], r["respuestas"][0]["tipo"], longitud(r["adicionales"])], [99, "PTR", 4], "respuesta PTR")
igual(vecinos_decodificar(vecinos_responder([sv], vecinos_pregunta("ana-pc.local.", "A", 1)))["respuestas"][0]["datos"], "192.168.1.20", "respuesta A")
igual(vecinos_decodificar(vecinos_responder([sv], vecinos_pregunta("_services._dns-sd._udp.local.", "PTR", 1)))["respuestas"][0]["datos"], "_ipp._tcp.local.", "enumerar tipos")
igual(vecinos_responder([sv], vecinos_pregunta("_otro._tcp.local.", "PTR", 1)), nulo, "sin respuesta")
igual(vecinos_responder([sv], an), nulo, "no responde respuestas")
// Por la red (unicast en loopback): pregunta, respuesta y lectura.
sea srv = udp_crear(53537)
sea cli = udp_crear(0)
udp_enviar(cli, "127.0.0.1", 53537, q)
sea llega = nulo
sea intentos = 0
mientras (llega == nulo y intentos < 200) {
    llega = udp_recibir(srv)
    si (llega == nulo) { dormir(5) }
    intentos = intentos + 1
}
udp_enviar(srv, llega["origen"], llega["puerto"], vecinos_responder([sv], llega["datos"]))
sea vuelta = nulo
intentos = 0
mientras (vuelta == nulo y intentos < 200) {
    vuelta = udp_recibir(cli)
    si (vuelta == nulo) { dormir(5) }
    intentos = intentos + 1
}
sea halla = vecinos_reunir([vecinos_decodificar(vuelta["datos"])], "_ipp._tcp.local.")
igual([halla[0]["instancia"], halla[0]["puerto"], halla[0]["direcciones"][0]], ["Impresora de Ana", 631, "192.168.1.20"], "por la red")
udp_cerrar(srv)
udp_cerrar(cli)
mostrar("[OK] vecinos")
