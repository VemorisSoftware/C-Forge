importar "sensor"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
igual(hex_de_bytes(sensor_paquete_conectar({"id": "abc", "mantener": 60})), "100f00044d5154540402003c0003616263", "CONNECT 3.1.1")
igual(hex_de_bytes(sensor_paquete_publicar("a/b", "hola", {"qos": 1, "id": 10})), "320b0003612f62000a686f6c61", "PUBLISH qos 1")
sea c = sensor_leer_paquete(sensor_paquete_conectar({"id": "x", "usuario": "u", "clave": "p", "voluntad": {"topico": "w", "mensaje": "adios", "qos": 1, "retener": verdadero}}))
igual([c["tipo"], c["id"], c["usuario"], c["clave"], c["voluntad"]["mensaje"], c["voluntad"]["qos"], c["voluntad"]["retener"]], ["CONNECT", "x", "u", "p", "adios", 1, verdadero], "leer CONNECT")
sea largo = ""
sea i = 0
mientras (i < 300) { largo = largo + "z"  i = i + 1 }
sea pl = sensor_paquete_publicar("t", largo)
igual([hex_de_bytes(subcadena(pl, 0, 3)), sensor_leer_paquete(pl)["mensaje"] == largo], ["30af02", verdadero], "largo restante de 2 bytes")
igual([sensor_coincide("casa/+/temp", "casa/sala/temp"), sensor_coincide("casa/#", "casa"), sensor_coincide("casa/#", "casa/a/b"), sensor_coincide("+/x", "$SYS/x"), sensor_coincide("casa/+", "casa/a/b"), sensor_coincide("#", "a"), sensor_coincide("$SYS/#", "$SYS/uptime")], [verdadero, verdadero, verdadero, falso, falso, verdadero, verdadero], "comodines")
sea m = ""
intentar { sensor_validar_filtro("casa/#/x") } capturar (e) { m = e }
igual(m, "sensor: # solo puede ir solo y al final (casa/#/x)", "filtro inválido")
// Flujo partido en pedazos.
sea flujo = sensor_paquete_ping() + sensor_paquete_publicar("t", "xyz")
sea s = sensor_separar(subcadena(flujo, 0, 4))
igual([longitud(s["paquetes"]), hex_de_bytes(s["resto"])], [1, "3006"], "separar con resto")
// Dos clientes por el mini broker.
sea br = sensor_broker()
sea buzones = {"a": [], "b": []}
sea entradas = {}
sea clientes = {}
para id en ["a", "b"] {
    sea idc = id
    clientes[idc] = sensor_cliente({"id": idc, "enviar": funcion(bts) { entradas[idc](bts) }, "voluntad": {"topico": "estado/" + idc, "mensaje": "caido", "retener": verdadero}})
    entradas[idc] = sensor_broker_conexion(br, funcion(bts) { para ev en sensor_recibir(clientes[idc], bts) { buzones[idc].agregar(ev) } })
    sensor_conectar(clientes[idc])
}
sensor_publicar(clientes["a"], "casa/sala/temp", "20", {"retener": verdadero})
sensor_suscribir(clientes["b"], "casa/+/temp", 1)
sensor_publicar(clientes["a"], "casa/cocina/temp", "25", {"qos": 1})
sensor_publicar(clientes["a"], "casa/cocina/temp", "26", {"qos": 2})
sensor_broker_caida(br, "a")
sensor_suscribir(clientes["b"], "estado/#", 0)
sea msgs = []
para ev en buzones["b"] { si (ev["tipo"] == "mensaje") { msgs.agregar(ev["topico"] + "=" + ev["mensaje"]) } }
igual(msgs, ["casa/sala/temp=20", "casa/cocina/temp=25", "casa/cocina/temp=26", "estado/a=caido"], "retenido, qos 1, qos 2 y última voluntad")
igual([longitud(buzones["a"]), sensor_pendientes(clientes["a"])], [3, 0], "acuses de qos 1 y 2")
// Reintento con DUP si no llega el acuse.
sea enviados = []
sea reloj = [0]
sea cl = sensor_cliente({"id": "r", "enviar": funcion(b) { enviados.agregar(b) }, "reloj": funcion() { retornar reloj[0] }, "reintento_ms": 1000})
sensor_publicar(cl, "t", "x", {"qos": 1})
reloj[0] = 1500
sensor_tic(cl)
igual([longitud(enviados), sensor_leer_paquete(enviados[1])["dup"]], [2, verdadero], "reenvío con DUP")
mostrar("[OK] sensor")
