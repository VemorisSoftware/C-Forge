// Written in English.
import "mailer"
import "dataformat"
import "dapper"
import "vitest"
import "tailwind"
import "trpc"
import "sysinfo"
import "notify"
import "sqlite"
import "molde"
import "json"
function same(a, b, what) { assert(("" + a) == ("" + b), what + ": [" + a + "] != [" + b + "]") }
let key = {"tipo": "ed25519", "privada": bytes_de_hex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")}
key["publica"] = ed25519_publica(key["privada"])
let msg = mailer_message_en({"from": "ann@x.io", "to": ["bob@y.io"], "subject": "Hi", "text": "Hello", "date_ms": 0})
same(msg["recipients"], ["bob@y.io"], "mailer message")
let signed = dkim_sign(msg["data"], {"domain": "x.io", "selector": "s1", "key": key})
same(dkim_verify(signed, key)["valid"], true, "dkim")
same(smtp_data(".hi"), "..hi\r\n.\r\n", "smtp")
same(jsonpath({"a": [{"b": 1}, {"b": 2}]}, "$.a[?@.b > 1].b"), [2], "jsonpath")
same(json_patch({"a": 1}, [{"op": "add", "path": "/b", "value": 2}]), {"a": 1, "b": 2}, "json patch")
same(json_schema_validate({"type": "integer"}, "x")["valid"], false, "json schema")
same(json_parsear(data_convert("a: 1\n", "yaml", "json")), {"a": 1}, "convert")
let db = db_abrir(":memory:")
db_ejecutar(db, "CREATE TABLE t (id INTEGER PRIMARY KEY, first_name TEXT)")
dapper_insert(db, "t", {"first_name": "Ann"})
same(dapper_query(db, "SELECT * FROM t WHERE id IN @ids", {"ids": [1]}, {"names": "camel"})[0]["firstName"], "Ann", "dapper")
same(dapper_scalar(db, "SELECT count(*) FROM t", {}), 1, "dapper scalar")
describe("math", function() {
    it("adds", function() { expect_equal(1 + 1, 2) })
    it("fails", function() { expect_equal(1, 2) })
})
let results = run_tests({"silent": true, "throw": false})
same([length(results["passed"]), length(results["failed"])], [1, 1], "vitest")
let m = mock_fn(1, null)
mock_return_value(m, 7)
same(m["f"](3), 7, "mock")
expect_called_with(m, [3])
same(length(mock_calls(m)), 1, "mock calls")
let css = tailwind_css(["p-4"], {"root": false, "properties": false})
same(contains(css, "padding: calc(var(--spacing) * 4);"), true, "tailwind")
same(tw_merge("p-2 p-4"), "p-4", "tw merge")
let router = trpc_router({"hello": trpc_query(molde_registro({"name": "texto"}), function(input, ctx) { return "Hello " + input["name"] })})
let res = trpc_handle_en(router, {"method": "GET", "path": "/trpc/hello?input=%7B%22name%22%3A%22Ann%22%7D"}, null)
same([res["status"], json_parsear(res["body"])["result"]["data"]], [200, "Hello Ann"], "trpc")
same(contains(trpc_typescript(router, "AppRouter"), "hello"), true, "trpc types")
same(system_memory()["total"] > 0, true, "sysinfo")
same(system_process(system_pid())["pid"], system_pid(), "process")
same(notify_glob_match("*.log", "a.log"), true, "glob")
let dir = "/tmp/cforge_notify_" + tiempo_ms()
crear_carpeta(dir)
let w = watcher_new({"mode": "polling", "interval_ms": 30})
watcher_add(w, dir)
dormir(20)
escribir_archivo(dir + "/a.txt", "x")
let ev = watcher_events(w, 2000)
same([length(ev) > 0, ev[0]["kind"]], [true, "created"], "notify")
print("[OK] en_lote15")
