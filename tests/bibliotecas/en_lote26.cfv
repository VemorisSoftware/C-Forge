// English names for lote 26.
importar "imgui"
importar "nuklear"
importar "gpio"
importar "mp3"
importar "vorbis"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion frame(ctx, io, s) {
    imgui_new_frame(ctx, io)
    si (imgui_begin(ctx, "Hello", {"x": 10, "y": 10, "width": 200, "height": 150, "no_resize": verdadero})) {
        si (imgui_button(ctx, "Add", {"width": 60})) { s["n"] = s["n"] + 1 }
        s["v"] = imgui_slider(ctx, "value", s["v"], 0, 1, {"decimals": 2})
        s["t"] = imgui_input_text(ctx, "name", s["t"], {"max": 4})
    }
    imgui_end(ctx)
    retornar imgui_render(ctx)
}
sea ctx = imgui_context({"style": "light"})
sea s = {"n": 0, "v": 0.5, "t": ""}
frame(ctx, {"mouse": [0, 0]}, s)
eq(ctx["estilo"]["texto"], [0, 0, 0, 255], "light style")
sea r = imgui_item_rect(ctx)
frame(ctx, {"mouse": [40, 45]}, s)
frame(ctx, {"mouse": [40, 45], "buttons": [verdadero, falso, falso]}, s)
frame(ctx, {"mouse": [40, 45]}, s)
eq(s["n"], 1, "imgui_button")
frame(ctx, {"mouse": [r[0] + 5, r[1] + 5]}, s)
frame(ctx, {"mouse": [r[0] + 5, r[1] + 5], "buttons": [verdadero, falso, falso]}, s)
frame(ctx, {"mouse": [r[0] + 5, r[1] + 5], "text": "abcdef"}, s)
frame(ctx, {"mouse": [r[0] + 5, r[1] + 5], "keys": ["backspace"]}, s)
eq(s["t"], "abc", "imgui_input_text")
afirmar(imgui_wants_keyboard(ctx), "imgui_wants_keyboard")
eq(imgui_render_image(ctx, 50, 50)["ancho"], 50, "imgui_render_image")
// nuklear
sea nk = nk_context(nulo)
sea hits = [0]
funcion nkf(nk, io, hits) {
    nk_input(nk, io)
    si (nk_begin(nk, "Demo", [0, 0, 200, 120], ["border", "title"])) {
        nk_layout_row_static(nk, 24, 80, 1)
        si (nk_button_label(nk, "button")) { hits[0] = hits[0] + 1 }
        nk_label(nk, "right", "right")
    }
    nk_end(nk)
    retornar nk_commands(nk)
}
nkf(nk, {"mouse": [20, 35]}, hits)
nkf(nk, {"mouse": [20, 35], "buttons": [verdadero, falso, falso]}, hits)
nkf(nk, {"mouse": [20, 35]}, hits)
eq(hits[0], 1, "nk_button_label")
// gpio
sea chip = gpio_simulated(8, nulo)
sea btn = gpio_request(chip, 3, {"mode": "input", "bias": "up", "edges": "falling"})
eq(gpio_read(btn), 1, "gpio_read")
gpio_sim_drive(chip, 3, 0, nulo)
eq(gpio_events(btn, 0)[0]["edge"], "falling", "gpio_events")
eq(gpio_line_info(chip, 3)["bias"], "up", "gpio_line_info")
sea out = gpio_request(chip, 1, {"mode": "output", "value": 1, "active_low": verdadero})
eq(gpio_sim_level(chip, 1), 0, "active_low")
sea bus = i2c_simulated()
i2c_sim_device(bus, 32, nulo)
i2c_write_register(bus, 32, 5, "xy")
eq([i2c_scan(bus), i2c_read_register(bus, 32, 5, 2)], [[32], "xy"], "i2c")
eq(spi_transfers(spi_simulated(nulo), [{"tx": "a"}, {"rx_len": 2}])[1], char_de(0) + char_de(0), "spi_transfers")
// mp3
sea m3 = leer_archivo("tests/bibliotecas/datos/mezcla-m25_8.mp3")
afirmar(mp3_is_mp3(m3), "mp3_is_mp3")
sea md = mp3_metadata(m3)
eq([md["version"], md["rate"], md["mode"], md["samples"]], ["MPEG-2.5", 8000, "mono", 4000], "mp3_metadata")
eq(longitud(mp3_decode(m3, {"max_ms": 250})["c"][0]), 2000, "mp3_decode")
// vorbis
sea og = leer_archivo("tests/bibliotecas/datos/mezcla-v_mono44.ogg")
afirmar(vorbis_is_vorbis(og), "vorbis_is_vorbis")
sea vm = vorbis_metadata(og)
eq([vm["rate"], vm["channels"], vm["samples"]], [44100, 1, 22050], "vorbis_metadata")
eq(longitud(vorbis_decode(og, {"max_ms": 50})["c"][0]), 2205, "vorbis_decode")
eq(ogg_packets(og)[0]["last"], falso, "ogg_packets")
mostrar("[OK] en_lote26")
