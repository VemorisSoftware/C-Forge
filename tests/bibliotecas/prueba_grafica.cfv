importar "grafica"
importar "xml"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
igual([grafica_marcas(0, 87, 5), grafica_marcas(-3.2, 7.9, 5), grafica_marcas(0.001, 0.0047, 4), grafica_marcas(5, 5)], [[0, 20, 40, 60, 80, 100], [-5, -2.5, 0, 2.5, 5, 7.5, 10], [0, 0.001, 0.002, 0.003, 0.004, 0.005], [5, 5.25, 5.5, 5.75, 6, 6.25]], "marcas redondas")
sea l = grafica_lineas(["Ene", "Feb", "Mar", "Abr"], [{"nombre": "Ventas <script>", "valores": [120, 180, nulo, 150]}, {"nombre": "Meta", "valores": [100, 120, 140, 160]}], {"titulo": "Ventas & más", "area": verdadero})
sea d = xml_analizar(l)
igual(d["nombre"], "svg", "SVG válido")
igual(longitud(xml_buscar(d, "polyline")), 3, "nulo corta la línea")
afirmar(texto_indice(l, "<script>") < 0 y texto_indice(l, "Ventas &lt;script&gt;") >= 0 y texto_indice(l, "Ventas &amp; más") >= 0, "texto escapado")
sea b = grafica_barras(["Q1", "Q2", "Q3"], [{"nombre": "A", "valores": [3, 5, 2]}, {"nombre": "B", "valores": [1, 2, 4]}], {"apiladas": verdadero})
igual(longitud(xml_buscar(xml_analizar(b), "rect")), 1 + 6 + 2, "barras apiladas (fondo + 6 barras + leyenda)")
sea t = grafica_torta(["Café", "Té", "Mate"], [60, 30, 10], {"dona": verdadero})
igual(longitud(xml_buscar(xml_analizar(t), "path")), 3, "tres porciones")
afirmar(texto_indice(t, "Café (60 %)") >= 0, "porcentajes")
igual(longitud(xml_buscar(xml_analizar(grafica_torta(["Todo"], [5])), "circle")), 1, "100 % es un círculo")
sea s = grafica_dispersion([{"nombre": "x", "puntos": [[1, 2], [2, 4.1], [3, 5.9]]}])
igual(longitud(xml_buscar(xml_analizar(s), "circle")), 3, "dispersión")
igual(xml_analizar(grafica_mini([1, 3, 2, 5]))["nombre"], "svg", "mini")
sea m = ""
intentar { grafica_torta(["a"], [-1]) } capturar (e) { m = e }
igual(m, "grafica: la torta no admite valores negativos", "torta negativa")
mostrar("[OK] grafica")
