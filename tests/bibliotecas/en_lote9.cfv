// Written in English.
import "fft"
import "envelope"
import "iso8583"
import "hcl"
import "crowd"
import "chart"
import "secrets"
import "errors"
import "glob"
function same(a, b, what) { assert(("" + a) == ("" + b), what + ": [" + a + "] != [" + b + "]") }
assert(abs(fft_dominant(fft_tone(440, 8000, 0.25), 8000) - 440) < 1, "fft")
same(fft_spectrum([1, 0, 0, 0], 4)["frequencies"], [0, 1, 2], "fft_spectrum")
let keys = envelope_keys()
same(envelope_decrypt(envelope_encrypt("hi", [keys["public"]]), keys["secret"]), "hi", "envelope")
let msg = iso8583_unpack(iso8583_pack("0200", {"11": "1"}))
same([msg["mti"], msg["fields"]["11"], iso8583_response_text("51")], ["0200", "000001", "insufficient funds"], "iso8583")
same(hcl_parse("app \"x\" { port = 80 }")["app"]["x"]["port"], 80, "hcl")
let c = crowd_new()
crowd_add(c, 0, 0, {"target": [10, 0], "max_speed": 50})
let i = 0
while (i < 120) { crowd_step(c, 1 / 30)  i = i + 1 }
same(crowd_arrived(c), true, "crowd")
assert(texto_indice(chart_line(["a", "b"], [{"name": "S", "values": [1, 2]}], {"title": "T"}), ">T</text>") >= 0, "chart")
let key = secrets_key()
same(secrets_decrypt_json(secrets_encrypt_json({"pw": "x"}, key), key)["pw"], "x", "secrets")
let rep = errors_new({"environment": "prod", "release": "2.0"})
errors_report(rep, "boom")
same(errors_events(rep)[0]["version"], "2.0", "errors")
same([glob_match("**/*.cfv", "a/b.cfv"), glob_match("*.{md,txt}", "x.md")], [true, true], "glob")
same(is_dir("/tmp"), true, "is_dir")
print("[OK] lote 9 in English")
