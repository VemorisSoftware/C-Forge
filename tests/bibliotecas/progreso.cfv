importar "progreso"
funcion igual(a, b, q) { afirmar(a == b, q + ": [" + a + "] != [" + b + "]") }
sea p = progreso_nuevo(10, "Copiando")
p["salida"] = falso
p["ancho"] = 10
progreso_avanzar(p, 4)
afirmar(texto_empieza_con(progreso_linea(p), "Copiando [████░░░░░░] 40% 4/10 "), progreso_linea(p))
progreso_avanzar(p, 20)
afirmar(texto_empieza_con(progreso_linea(p), "Copiando [██████████] 100% 24/10 "), "tope al 100 %")
sea q = progreso_nuevo(0)
q["salida"] = falso
afirmar(texto_empieza_con(progreso_linea(q), "[░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░] 0% 0/0"), "total cero")
mostrar("[OK] progreso")
