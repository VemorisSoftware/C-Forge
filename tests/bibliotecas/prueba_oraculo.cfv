// Pruebas de oraculo. datos/oraculo/mini.gguf es un LLaMA diminuto escrito
// con la biblioteca gguf de llama.cpp (pesos F32, F16, Q8_0 y Q4_0, GQA con
// 4 cabezas y 2 de KV); esperado.json trae los logits y la generación
// codiciosa calculados con NumPy siguiendo la arquitectura "llama".
importar "oraculo"
importar "json"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

sea D = "tests/bibliotecas/datos/oraculo/"
sea e = json_parsear(leer_archivo(D + "esperado.json"))
sea m = oraculo_cargar(D + "mini.gguf")
eq(oraculo_info(m), {"arquitectura": "llama", "cabezas": 4, "cabezas_kv": 2, "capas": 2, "contexto": 64, "embedding": 32, "nombre": "mini-llama de prueba", "vocabulario": 286}, "info")
sea toks = oraculo_tokenizar(m, "hola mundo", nulo)
eq(toks, e["prompt"], "tokenizar con fusiones de SentencePiece")
para i en lista_rango(0, longitud(toks)) {
    sea l = oraculo_evaluar(m, toks[i])
    para k en lista_rango(0, longitud(l)) { afirmar(absoluto(l[k] - e["logits"][i][k]) < 1e-6, "logit " + i + "/" + k) }
}
sea g = oraculo_generar(m, "hola mundo", {"max_tokens": 6})
eq([g["tokens"], g["fin"]], [e["greedy"], "largo"], "generación codiciosa")
eq(oraculo_texto(m, oraculo_tokenizar(m, "hola cforge ñ!", falso)), "hola cforge ñ!", "ida y vuelta con respaldo por bytes")
sea a = oraculo_completar(m, "el", {"max_tokens": 5, "temperatura": 0.8, "semilla": 3})
eq(oraculo_completar(m, "el", {"max_tokens": 5, "temperatura": 0.8, "semilla": 3}), a, "muestreo reproducible con semilla")
sea gg = oraculo_gguf(leer_archivo(D + "mini.gguf"))
eq([gg["version"], gg["tensores"]["blk.0.attn_v.weight"]["tipo"], gg["tensores"]["blk.0.attn_q.weight"]["tipo"], gg["tensores"]["token_embd.weight"]["dims"]], [3, "Q4_0", "Q8_0", [32, 286]], "metadatos GGUF")
sea error = ""
intentar { oraculo_desde_bytes("GGML") } capturar (x) { error = x }
afirmar(texto_contiene(error, "no es un archivo GGUF"), "archivo inválido")
mostrar("[OK] oraculo")
