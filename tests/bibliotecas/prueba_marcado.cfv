importar "marcado"
funcion igual(a, b, q) { afirmar(a == b, q + ":\n[" + a + "]\n!=\n[" + b + "]") }
igual(marcado_html("# Título *bonito*"), "<h1>Título <em>bonito</em></h1>\n", "título")
igual(marcado_html("Hola **mundo** y `x < y`"), "<p>Hola <strong>mundo</strong> y <code>x &lt; y</code></p>\n", "en línea")
igual(marcado_html("- a\n- b\n\n1. uno\n2. dos"), "<ul>\n<li>a</li>\n<li>b</li>\n</ul>\n<ol>\n<li>uno</li>\n<li>dos</li>\n</ol>\n", "listas")
igual(marcado_html("```js\nif (a < b) {}\n```"), "<pre><code class=\"language-js\">if (a &lt; b) {}</code></pre>\n", "bloque de código")
igual(marcado_html("> cita **fuerte**"), "<blockquote>\n<p>cita <strong>fuerte</strong></p>\n</blockquote>\n", "cita")
igual(marcado_html("[sitio](https://c-forge.org) ![logo](a.png)"), "<p><a href=\"https://c-forge.org\">sitio</a> <img src=\"a.png\" alt=\"logo\"></p>\n", "enlace e imagen")
igual(marcado_html("línea uno  \nlínea dos"), "<p>línea uno<br>\nlínea dos</p>\n", "salto forzado")
igual(marcado_html("a\n\n---\n\nb"), "<p>a</p>\n<hr>\n<p>b</p>\n", "línea horizontal")
igual(marcado_html("~~no~~ \\*literal\\*"), "<p><del>no</del> *literal*</p>\n", "tachado y escape")
// Seguridad: sin HTML crudo ni enlaces peligrosos.
igual(marcado_html("<script>alert(1)</script>"), "<p>&lt;script&gt;alert(1)&lt;/script&gt;</p>\n", "HTML escapado")
igual(marcado_html("[x](javascript:alert(1))"), "<p><a href=\"#\">x</a></p>\n", "javascript: neutralizado")
igual(marcado_html("[x]( JavaScript:alert(1))"), "<p><a href=\"#\">x</a></p>\n", "mayúsculas y espacios")
igual(marcado_html("[x](data:text/html,<b>)"), "<p><a href=\"#\">x</a></p>\n", "data: neutralizado")
igual(marcado_html("![a\" onerror=\"x](i.png)"), "<p><img src=\"i.png\" alt=\"a&quot; onerror=&quot;x\"></p>\n", "atributo escapado")
mostrar("[OK] marcado")
