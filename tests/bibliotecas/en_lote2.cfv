// Written in English.
import "markdown"
import "cli"
import "logger"
import "resilience"
import "template"
function same(a, b, what) { assert(a == b, what + ": [" + a + "] != [" + b + "]") }
same(markdown_html("**hi**"), "<p><strong>hi</strong></p>\n", "markdown_html")
let o = cli_new("app", "Demo")
cli_flag(o, "verbose", "v", "More output")
cli_positional(o, "file", "Input", true)
let a = cli_parse(o, ["-v", "in.txt"])
same(a["verbose"], true, "cli_parse flag")
same(a["file"], "in.txt", "cli_parse positional")
let log = logger_to_list(logger_new("debug", "text"))
logger_warn(log, "disk", {"free": 5})
same(logger_records(log)[0], "WARN disk free=5", "logger_warn")
let tries = [0]
same(retry(function() { tries[0] = tries[0] + 1 if (tries[0] < 2) { throw "x" } return "done" }, 3, 1, 2), "done", "retry")
let b = breaker_new(1, 1000)
try { breaker_call(b, function() { throw "down" }) } catch (e) { }
same(breaker_state(b), "open", "breaker_state")
let j = logger_to_list(logger_new("info", "json"))
logger_error(j, "boom", {"code": 7})
assert(texto_indice(logger_records(j)[0], "\"level\":\"error\"") >= 0, logger_records(j)[0])
same(template_render("{{#each xs}}{{.}},{{/each}}", {"xs": [1, 2]}), "1,2,", "template_render")
print("[OK] lote 2 in English")
