importar "malla_geo"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion orden_tri(ts) {
    sea r = []
    para t en ts { r.agregar(ordenar(t, funcion(a, b) { retornar a - b })) }
    retornar ordenar(r, funcion(a, b) {
        si (a[0] != b[0]) { retornar a[0] - b[0] }
        si (a[1] != b[1]) { retornar a[1] - b[1] }
        retornar a[2] - b[2]
    })
}
sea P = [[0, 0], [4, 0], [2, 3], [2, 1], [0, 4], [4, 4]]
// Igual que scipy.spatial.Delaunay.
igual(orden_tri(malla_delaunay(P)), [[0, 1, 3], [0, 3, 4], [1, 3, 5], [2, 3, 4], [2, 3, 5], [2, 4, 5]], "Delaunay")
igual(longitud(malla_aristas(malla_delaunay(P))), 11, "aristas")
sea v = malla_voronoi(P, [-1, -1, 5, 5])
sea s = 0
para c en v { s = s + malla_area(c) }
igual(redondear(s, 6), 36, "Voronoi cubre la caja")
igual(malla_area(v[3]), 6, "celda central")
igual(orden_tri(malla_triangular([[0, 0], [4, 0], [4, 4], [2, 2], [0, 4]])), [[0, 1, 3], [0, 3, 4], [1, 2, 3]], "triangular por orejas")
igual(longitud(malla_triangular([[0, 4], [2, 2], [4, 4], [4, 0], [0, 0]])), 3, "horario también")
igual(malla_recortar([[0, 0], [4, 0], [4, 4], [0, 4]], [[2, -1], [6, 2], [2, 5]]), [[2, 0], [3.33333, 0], [4, 0.5], [4, 3.5], [3.33333, 4], [2, 4]], "Sutherland–Hodgman")
igual([malla_interseccion([0, 0], [4, 4], [0, 4], [4, 0]), malla_interseccion([0, 0], [1, 1], [2, 0], [3, 1])], [[2, 2], nulo], "intersección de segmentos")
igual(malla_circulo_minimo([[0, 0], [2, 0], [1, 1], [1, -1], [0.5, 0.2]]), {"centro": [1, 0], "radio": 1}, "círculo mínimo")
igual(malla_circulo_minimo([[0, 0], [4, 0], [2, 3]])["centro"], [2, 0.833333], "círculo por 3 puntos")
igual(malla_par_cercano([[0, 0], [5, 5], [1, 1], [5.2, 5.1], [9, 0]]), {"distancia": 0.223607, "i": 1, "j": 3}, "par más cercano")
igual([malla_es_convexo([[0, 0], [4, 0], [4, 4], [2, 2], [0, 4]]), malla_es_convexo([[0, 0], [1, 0], [0, 1]])], [falso, verdadero], "convexo")
igual(malla_interpolar([[0, 0], [1, 0], [0, 1]], [0, 10, 20], [[0, 1, 2]], [0.25, 0.25]), 7.5, "interpolación baricéntrica")
igual(malla_localizar([[0, 0], [1, 0], [0, 1]], [[0, 1, 2]], [5, 5]), -1, "fuera de la triangulación")
igual(malla_circuncentro([0, 0], [1, 1], [2, 2]), nulo, "colineales")
sea m = ""
intentar { malla_triangular([[0, 0], [2, 2], [2, 0], [0, 2]]) } capturar (e) { m = e }
igual(m, "malla_geo: el polígono no es simple (se cruza) o tiene puntos repetidos", "polígono que se cruza")
mostrar("[OK] malla_geo")
