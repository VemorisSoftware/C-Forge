importar "xml"
funcion igual(a, b, q) { afirmar(a == b, q + ": [" + a + "] != [" + b + "]") }
sea doc = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!-- catálogo -->\n<catalogo moneda='CLP'>\n  <libro id=\"7\" etiqueta=\"a &amp; b\"><titulo>Hola &amp; adi&#243;s &#x20AC;</titulo><precio>9990</precio></libro>\n  <libro id=\"8\"><titulo><![CDATA[<b>crudo</b>]]></titulo><vacio/></libro>\n</catalogo>"
sea r = xml_analizar(doc)
igual(r["nombre"], "catalogo", "raíz")
igual(r["atributos"]["moneda"], "CLP", "comillas simples")
sea libros = xml_buscar(r, "libro")
igual(longitud(libros), 2, "buscar")
igual(libros[0]["atributos"]["etiqueta"], "a & b", "entidad en atributo")
igual(xml_contenido(xml_hijo(libros[0], "titulo")), "Hola & adiós €", "entidades numéricas")
igual(xml_contenido(xml_hijo(libros[1], "titulo")), "<b>crudo</b>", "CDATA")
igual(xml_hijo(libros[0], "nada"), nulo, "hijo faltante")
igual(xml_texto(libros[0]), "<libro etiqueta=\"a &amp; b\" id=\"7\"><titulo>Hola &amp; adiós €</titulo><precio>9990</precio></libro>", "escribir")
igual(xml_texto(xml_analizar(xml_texto(r))), xml_texto(r), "ida y vuelta")
igual(xml_texto(xml_nodo("a", {"x": "\"<"}, ["1 < 2", xml_nodo("b")]), 2), "<a x=\"&quot;&lt;\">\n  1 &lt; 2\n  <b/>\n</a>", "nodo nuevo con sangría")
// Seguridad y errores
sea casos = [
    ["<!DOCTYPE x [<!ENTITY a \"b\">]><x>&a;</x>", "xml: DOCTYPE/ENTITY no permitidos (posición 0)"],
    ["<a><b></a>", "xml: se cerró a pero estaba abierto b (posición 9)"],
    ["<a>&desconocida;</a>", "xml: entidad desconocida &desconocida; (posición 16)"],
    ["<a x=\"1\" x=\"2\"/>", "xml: atributo repetido x (posición 14)"],
    ["<a></a><b/>", "xml: contenido después de la raíz (posición 7)"],
    ["<a>&#0;</a>", "xml: código inválido (posición 7)"],
    ["<a x=1/>", "xml: el atributo x va entre comillas (posición 5)"],
    ["<a>", "xml: falta </a> (posición 3)"]
]
para c en casos {
    sea m = ""
    intentar { xml_analizar(c[0]) } capturar (e) { m = e }
    igual(m, c[1], c[0])
}
sea hondo = texto_repetir("<a>", 300) + texto_repetir("</a>", 300)
sea m2 = ""
intentar { xml_analizar(hondo) } capturar (e) { m2 = e }
afirmar(texto_empieza_con(m2, "xml: anidamiento excesivo"), m2)
// Nombres en inglés en el mismo módulo
igual(xml_text(xml_child(xml_parse("<a><b>hi</b></a>"), "b")), "hi", "english")
mostrar("[OK] xml")
