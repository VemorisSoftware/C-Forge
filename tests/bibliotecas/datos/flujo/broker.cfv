// Broker de flujo para las pruebas: escucha en el puerto dado hasta que
// aparezca el archivo de fin (o 30 s).
importar "flujo"
sea args = argumentos()
sea puerto = a_numero(args[longitud(args) - 2])
sea fin = args[longitud(args) - 1]
sea b = flujo_broker({"particiones": 3})
flujo_broker_servir(b, "127.0.0.1", puerto, funcion() { retornar existe_archivo(fin) }, 30000)
