<Window xmlns='https://github.com/avaloniaui' Title='Tareas' Width='360' Height='420'>
  <Window.Styles>
    <Style Selector='TextBlock.titulo'><Setter Property='FontSize' Value='18'/><Setter Property='Foreground' Value='#1a237e'/></Style>
    <Style Selector='StackPanel.acciones > Button'><Setter Property='Background' Value='#2e7d32'/><Setter Property='Foreground' Value='White'/></Style>
  </Window.Styles>
  <DockPanel Margin='10'>
    <TextBlock DockPanel.Dock='Top' Classes='titulo' Text='Mis tareas'/>
    <TextBlock DockPanel.Dock='Bottom' Name='resumen' Text='{Binding Resumen}'/>
    <StackPanel Spacing='8'>
      <Grid ColumnDefinitions='*,Auto' >
        <TextBox Grid.Column='0' Name='nueva' Text='{Binding Nombre}' Watermark='Nueva tarea'>
          <TextBox.KeyBindings><KeyBinding Gesture='Enter' Command='{Binding Agregar}'/></TextBox.KeyBindings>
        </TextBox>
        <StackPanel Grid.Column='1' Classes='acciones' Orientation='Horizontal'>
          <Button Name='agregar' Content='Agregar' Command='{Binding Agregar}' IsEnabled='{Binding PuedeAgregar}'/>
        </StackPanel>
      </Grid>
      <ItemsControl ItemsSource='{Binding Tareas}' Spacing='4'>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation='Horizontal' Spacing='6'>
              <CheckBox Content='{Binding Titulo}' IsChecked='{Binding Hecha}'/>
              <Button Content='x' Command='{Binding $parent[ItemsControl].DataContext.Borrar}' CommandParameter='{Binding}'/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Separator/>
      <ToggleSwitch Content='Modo oscuro' IsChecked='{Binding Oscuro}'/>
      <TextBlock Text='{Binding Volumen, StringFormat="Volumen: {0:F1}"}' />
      <Slider Name='vol' Minimum='0' Maximum='100' Value='{Binding Volumen}'/>
      <ComboBox Name='pais' ItemsSource='{Binding Paises}' SelectedItem='{Binding Pais}' PlaceholderText='País'/>
      <StackPanel Orientation='Horizontal' Spacing='12'>
        <RadioButton GroupName='plan' Content='Básico' IsChecked='{Binding EsBasico}'/>
        <RadioButton GroupName='plan' Content='Pro' IsChecked='{Binding EsPro}'/>
      </StackPanel>
      <TextBlock Text='Solo pro' IsVisible='{Binding EsPro}'/>
    </StackPanel>
  </DockPanel>
</Window>
