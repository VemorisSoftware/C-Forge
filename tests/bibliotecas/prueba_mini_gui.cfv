// Pruebas de mini_gui (al estilo de Nuklear).
importar "mini_gui"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion donde(L, t) {
    para c en L { si (c["t"] == "texto" y c["texto"] == t) { retornar [c["x"] + 2, c["y"] + 2] } }
    lanzar "no está: " + t
}
funcion ui(ctx, ent, e) {
    mini_entrada(ctx, ent)
    si (mini_comenzar(ctx, "Demo", [10, 10, 230, 250], ["borde", "movible", "escalable", "minimizable", "titulo"])) {
        mini_fila_estatica(ctx, 24, 80, 2)
        si (mini_boton(ctx, "botón")) { e["n"] = e["n"] + 1 }
        mini_etiqueta(ctx, "n=" + e["n"], "derecha")
        mini_fila_dinamica(ctx, 24, 2)
        si (mini_opcion(ctx, "fácil", e["dif"] == 0)) { e["dif"] = 0 }
        si (mini_opcion(ctx, "difícil", e["dif"] == 1)) { e["dif"] = 1 }
        mini_fila(ctx, 24, [50, 1])
        mini_etiqueta(ctx, "Vol", "izquierda")
        e["vol"] = mini_deslizador(ctx, 0, e["vol"], 10, 2)
        mini_fila_dinamica(ctx, 24, 1)
        e["p"] = mini_propiedad(ctx, "Edad", 0, e["p"], 100, 10, 1)
        e["prog"] = mini_progreso(ctx, e["prog"], 100, verdadero)
        e["c"] = mini_casilla(ctx, "ok", e["c"])
        e["t"] = mini_editar(ctx, e["t"], 8)
        e["i"] = mini_combo(ctx, ["rojo", "verde"], e["i"])
    }
    mini_terminar(ctx)
    retornar mini_comandos(ctx)
}
funcion clic(ctx, e, p) {
    ui(ctx, {"raton": p}, e)
    ui(ctx, {"raton": p, "botones": [verdadero, falso, falso]}, e)
    retornar ui(ctx, {"raton": p}, e)
}
sea ctx = mini_contexto(nulo)
sea e = {"n": 0, "dif": 0, "vol": 4, "p": 20, "prog": 0, "c": falso, "t": "", "i": 0}
sea L = ui(ctx, {"raton": [0, 0]}, e)
// Fila estática: el botón mide 80.
sea b = nulo
para c en L { si (c["t"] == "rect" y c["r"][2] == 80) { b = c["r"] } }
afirmar(b != nulo, "botón de 80")
// Etiqueta a la derecha de su celda.
sea pn = donde(L, "n=0")
eq(pn[0] - 2 + 18, b[0] + 80 + 4 + 80, "alineada a la derecha")
clic(ctx, e, donde(L, "botón"))
eq(e["n"], 1, "botón")
clic(ctx, e, donde(L, "difícil"))
eq(e["dif"], 1, "opción")
// Propiedad: flecha derecha suma el paso, izquierda resta.
sea pe = donde(L, "Edad: 20")
sea fila = nulo
para c en L { si (c["t"] == "rect" y c["r"][1] <= pe[1] y c["r"][1] + c["r"][3] > pe[1] y c["r"][2] > 150) { fila = c["r"] } }
clic(ctx, e, [fila[0] + fila[2] - 5, fila[1] + 5])
eq(e["p"], 30, "propiedad +")
clic(ctx, e, [fila[0] + 5, fila[1] + 5])
clic(ctx, e, [fila[0] + 5, fila[1] + 5])
eq(e["p"], 10, "propiedad −")
// Arrastre del centro.
sea mx = fila[0] + piso(fila[2] / 2)
ui(ctx, {"raton": [mx, fila[1] + 5], "botones": [verdadero, falso, falso]}, e)
ui(ctx, {"raton": [mx + 25, fila[1] + 5], "botones": [verdadero, falso, falso]}, e)
ui(ctx, {"raton": [mx + 25, fila[1] + 5]}, e)
eq(e["p"], 35, "propiedad arrastrada")
// Deslizador con paso 2.
sea L2 = ui(ctx, {"raton": [0, 0]}, e)
sea pv = donde(L2, "4")
ui(ctx, {"raton": [pv[0] + 30, pv[1]], "botones": [verdadero, falso, falso]}, e)
ui(ctx, {"raton": [pv[0] + 30, pv[1]]}, e)
eq(e["vol"] % 2, 0, "paso de 2")
afirmar(e["vol"] > 4, "subió " + e["vol"])
// Progreso modificable: arrastrar al final.
sea L3 = ui(ctx, {"raton": [0, 0]}, e)
sea pk = donde(L3, "ok")
sea py = pk[1] - 24 - 4
ui(ctx, {"raton": [30, py], "botones": [verdadero, falso, falso]}, e)
ui(ctx, {"raton": [400, py], "botones": [verdadero, falso, falso]}, e)
ui(ctx, {"raton": [400, py]}, e)
eq(e["prog"], 100, "progreso")
clic(ctx, e, pk)
eq(e["c"], verdadero, "casilla")
// Edición con máximo de 8 caracteres.
clic(ctx, e, [pk[0], pk[1] + 28])
ui(ctx, {"raton": [pk[0], pk[1] + 28], "texto": "C-Forge rocks"}, e)
eq(e["t"], "C-Forge ", "máximo de caracteres")
// Ventana movible.
ui(ctx, {"raton": [120, 15], "botones": [verdadero, falso, falso]}, e)
ui(ctx, {"raton": [130, 25], "botones": [verdadero, falso, falso]}, e)
ui(ctx, {"raton": [130, 25]}, e)
eq([ctx["ventanas"]["Demo"]["x"], ctx["ventanas"]["Demo"]["y"]], [20, 20], "movida")
// Ventana fija (sin "movible") y sin título.
sea c2 = mini_contexto(nulo)
mini_entrada(c2, {"raton": [50, 50], "botones": [verdadero, falso, falso]})
mini_comenzar(c2, "Fija", [0, 0, 100, 100], ["borde"])
mini_terminar(c2)
mini_comandos(c2)
mini_entrada(c2, {"raton": [80, 80], "botones": [verdadero, falso, falso]})
mini_comenzar(c2, "Fija", [0, 0, 100, 100], ["borde"])
mini_terminar(c2)
sea img = mini_imagen(c2, 120, 120)
eq([c2["ventanas"]["Fija"]["x"], c2["ventanas"]["Fija"]["y"]], [0, 0], "no se mueve")
eq(imagen_pixel(img, 110, 110)[0], 48, "fondo de mini_imagen")
mostrar("[OK] mini_gui")
