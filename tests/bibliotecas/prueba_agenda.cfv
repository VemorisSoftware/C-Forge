importar "agenda"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Regla POSIX (funciona sin base de zonas): Chile continental.
sea cl = agenda_zona_posix("<-04>4<-03>,M9.1.6/24,M4.1.6/24")
igual(agenda_formato(cl, 1763769600000), "2025-11-21T21:00:00-03:00", "verano en Chile")
igual(agenda_formato(cl, 1750000000000), "2025-06-15T11:06:40-04:00", "invierno en Chile")
// Salto de primavera: las 00:30 del 6 de sept. de 2026 no existen.
igual(agenda_desde_local(cl, 2026, 9, 6, 0, 30, 0), 1788669000000, "hora inexistente avanza")
igual([agenda_desde_local(cl, 2026, 4, 4, 23, 30, 0), agenda_desde_local(cl, 2026, 4, 4, 23, 30, 0, "ultima")], [1775356200000, 1775359800000], "hora repetida")
sea a = agenda_cron("30 23 * * *", cl)
igual(agenda_proximas(a, 1775250000000, 3), [1775269800000, 1775356200000, 1775446200000], "cron corre una vez en la hora repetida")
sea l = agenda_local(cl, 1763769600000)
igual([l["anio"], l["mes"], l["dia"], l["hora"], l["dia_semana"], l["abrev"], l["verano"]], [2025, 11, 21, 21, 5, "-03", verdadero], "campos locales")
igual(agenda_formato(agenda_zona("UTC-03:30"), 0), "1969-12-31T20:30:00-03:30", "desfase fijo")
igual(agenda_formato(agenda_zona("UTC"), 0), "1970-01-01T00:00:00Z", "UTC")
sea us = agenda_zona_posix("EST5EDT,M3.2.0,M11.1.0")
igual(agenda_formato(us, 1772900000000), "2026-03-07T11:13:20-05:00", "EST")
igual(agenda_formato(us, 1773100000000), "2026-03-09T19:46:40-04:00", "EDT")
// Con la base de zonas del sistema (Linux y macOS), contra Python zoneinfo.
si (existe_archivo("/usr/share/zoneinfo/America/Santiago")) {
    sea z = agenda_zona("America/Santiago")
    igual([agenda_formato(z, 1763769600000), agenda_formato(z, 2510000000000)], ["2025-11-21T21:00:00-03:00", "2049-07-15T18:13:20-04:00"], "TZif + regla futura")
    igual(agenda_en("Europe/Madrid", 1750000000000), "2025-06-15T17:06:40+02:00", "Madrid")
    igual(agenda_en("Asia/Kolkata", 0), "1970-01-01T05:30:00+05:30", "Kolkata")
    sea ny = agenda_cron("0 9 * * 1-5", "America/New_York")
    igual(agenda_proximas(ny, 1772900000000, 2), [1773061200000, 1773147600000], "cron después del cambio de hora")
}
sea m = ""
intentar { agenda_zona("../../etc/passwd") } capturar (e) { m = e }
igual(m, "agenda: nombre de zona inválido ../../etc/passwd", "sin rutas raras")
mostrar("[OK] agenda")
