importar "cobro"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea reloj = [1000000]
sea c = cobro_con_reloj(cobro_nuevo(60), funcion() { retornar reloj[0] })
sea n = [0]
sea f = funcion() { n[0] = n[0] + 1  retornar {"id": "p" + n[0]} }
igual([cobro_idempotente(c, "clave-12345", "{}", f), cobro_idempotente(c, "clave-12345", "{}", f), n[0]], [{"id": "p1"}, {"id": "p1"}, 1], "no cobra dos veces")
sea m = ""
intentar { cobro_idempotente(c, "clave-12345", "{\"x\":1}", f) } capturar (e) { m = e }
igual(m, "cobro: la clave de idempotencia ya se usó con otro cuerpo", "otro cuerpo")
intentar { cobro_idempotente(c, "corta", "{}", f) } capturar (e) { m = e }
igual(m, "cobro: falta una clave de idempotencia válida (8 a 255 caracteres)", "clave corta")
sea falla = funcion() { lanzar "tarjeta rechazada" }
intentar { cobro_idempotente(c, "clave-falla", "{}", falla) } capturar (e) { m = e }
igual(m, "tarjeta rechazada", "propaga el error")
intentar { cobro_idempotente(c, "clave-falla", "{}", f) } capturar (e) { m = e }
igual([m, n[0]], ["tarjeta rechazada", 1], "repite el mismo error sin reintentar")
reloj[0] = reloj[0] + 61000
igual(cobro_idempotente(c, "clave-12345", "{}", f), {"id": "p2"}, "la clave vence")
igual(longitud(cobro_clave()), 32, "clave nueva")
sea cuerpo = "{\"tipo\":\"pago.capturado\",\"monto\":9990}"
sea firma = cobro_firmar_webhook("whsec_abc", cuerpo, 1763683200000)
igual(firma, "t=1763683200,v1=" + hmac_sha256("whsec_abc", "1763683200." + cuerpo), "firma HMAC")
igual(cobro_verificar_webhook("whsec_abc", cuerpo, firma, 300, 1763683250000)["monto"], 9990, "verificar y leer JSON")
igual(cobro_verificar_webhook("whsec_abc", cuerpo, firma + ",v1=otra", 300, 1763683250000)["tipo"], "pago.capturado", "varias firmas (rotación)")
para caso en [
    ["whsec_abc", cuerpo, firma, 1763684200000, "cobro: webhook fuera de tiempo (posible repetición)"],
    ["whsec_otro", cuerpo, firma, 1763683200000, "cobro: firma de webhook inválida"],
    ["whsec_abc", cuerpo + " ", firma, 1763683200000, "cobro: firma de webhook inválida"],
    ["whsec_abc", cuerpo, "v1=abc", 1763683200000, "cobro: cabecera de firma mal formada"]
] {
    sea mm = ""
    intentar { cobro_verificar_webhook(caso[0], caso[1], caso[2], 300, caso[3]) } capturar (e) { mm = e }
    igual(mm, caso[4], caso[4])
}
sea p = cobro_pago(1234500, "clp")
igual([p["moneda"], p["estado"]], ["CLP", "pendiente"], "pago nuevo")
cobro_cambiar(p, "autorizado")
cobro_cambiar(p, "capturado")
cobro_reembolsar(p, 500)
cobro_reembolsar(p)
igual([p["estado"], p["reembolsado"]], ["reembolsado", 1234500], "reembolsos")
intentar { cobro_reembolsar(p, 1) } capturar (e) { m = e }
igual(m, "cobro: monto de reembolso inválido (quedan 0)", "no reembolsa de más")
intentar { cobro_cambiar(p, "pendiente") } capturar (e) { m = e }
igual(m, "cobro: no se puede pasar de reembolsado a pendiente", "transición inválida")
intentar { cobro_pago(19.99, "USD") } capturar (e) { m = e }
igual(m, "cobro: el monto debe ser un entero positivo en la unidad mínima", "montos enteros")
igual([cobro_formato(1234500, "CLP"), cobro_formato(1999, "USD"), cobro_formato(-50, "EUR"), cobro_formato(7, "usd")], ["$1.234.500", "US$19,99", "-€0,50", "US$0,07"], "formato")
mostrar("[OK] cobro")
