// English names for lote 30.
importar "webrtc"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea a = webrtc_peer({"ip": "10.1.0.1"})
sea b = webrtc_peer({"ip": "10.1.0.2"})
webrtc_add_local_candidate(a, "10.1.0.1", 5001)
webrtc_add_local_candidate(b, "10.1.0.2", 5002)
webrtc_set_answer(a, webrtc_create_answer(b, webrtc_create_offer(a)))
sea ch = webrtc_create_data_channel(a, "chat", {"unordered": falso})
sea t = 0
sea got = nulo
sea opened = falso
mientras (t < 20000 y got == nulo) {
    t = t + 50
    webrtc_tick(a, t)
    webrtc_tick(b, t)
    para x en webrtc_output(a) { webrtc_input(b, x[0], "10.1.0.1", 5001, t) }
    para x en webrtc_output(b) { webrtc_input(a, x[0], "10.1.0.2", 5002, t) }
    para e en webrtc_events(a) { si (e["type"] == "open") { opened = verdadero } }
    si (opened y got == nulo) {
        webrtc_send(a, ch, "hi")
        opened = falso
    }
    para e en webrtc_events(b) { si (e["type"] == "message") { got = [e["data"], e["binary"], e["channel"]] } }
}
eq([webrtc_is_connected(a), got], [verdadero, ["hi", falso, 1]], "webrtc data channel")
eq(webrtc_rtp_parse(webrtc_rtp_build({"pt": 0, "seq": 1, "ts": 2, "ssrc": 3, "carga": "x"}))["payload"], "x", "webrtc_rtp_parse")
eq(webrtc_is_stun(webrtc_stun_build(1, bytes_aleatorios(12), [], nulo)), verdadero, "webrtc_stun_build")
eq(longitud(webrtc_fingerprint(webrtc_certificate()["der"])), 95, "webrtc_fingerprint")
mostrar("[OK] en_lote30")
