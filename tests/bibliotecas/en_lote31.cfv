// English names for lote 31.
importar "wgpu"
importar "tauri"
importar "windows"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea dev = wgpu_request_device(wgpu_request_adapter(nulo))
sea vb = wgpu_create_buffer(dev, {"usage": ["vertex"], "contents": [-1, -1, 3, -1, -1, 3]})
sea pipe = wgpu_create_render_pipeline(dev, {"attributes": [{"name": "pos", "components": 2, "offset": 0}], "stride": 2, "cull_mode": "back", "blend": "alpha",
    "vertex": funcion(v, r, i) { retornar {"position": [v["pos"][0], v["pos"][1], 0, 1]} },
    "fragment": funcion(f, r) { retornar r["tint"] }})
sea tex = wgpu_create_texture(dev, {"width": 4, "height": 4, "format": "rgba8"})
sea enc = wgpu_create_command_encoder(dev)
sea pass = wgpu_begin_render_pass(enc, {"color": tex, "clear": [0, 0, 0, 1]})
wgpu_set_pipeline(pass, pipe)
wgpu_set_bind_group(pass, 0, wgpu_create_bind_group(dev, {"tint": [1, 0, 0, 0.5]}))
wgpu_set_vertex_buffer(pass, 0, vb)
wgpu_draw(pass, 3, 1, 0, 0)
wgpu_end_pass(pass)
wgpu_submit(dev, [wgpu_finish(enc)])
eq(wgpu_texel(tex, 2, 2), [0.5, 0, 0, 1], "wgpu render + alpha blend")
sea buf = wgpu_create_buffer(dev, {"size": 4, "usage": ["storage"]})
sea cp = wgpu_create_compute_pipeline(dev, {"workgroup_size": [2, 1, 1], "compute": funcion(id, r) { r["b"]["datos"][id[0]] = id[0] * id[0] }})
enc = wgpu_create_command_encoder(dev)
sea c = wgpu_begin_compute_pass(enc)
wgpu_set_pipeline(c, cp)
wgpu_set_bind_group(c, 0, wgpu_create_bind_group(dev, {"b": buf}))
wgpu_dispatch_workgroups(c, 2, 1, 1)
wgpu_submit(dev, [wgpu_finish(enc)])
eq(wgpu_read_buffer(dev, buf), [0, 1, 4, 9], "wgpu compute")
eq(wgpu_sample(tex, wgpu_create_sampler(dev, {"filter": "nearest", "address_mode": "repeat"}), [1.6, 0.6]), [0.5, 0, 0, 1], "wgpu sampler")
// tauri
sea app = tauri_app({"title": "T", "frontend": {"index.html": "<html><head></head></html>"}, "state": {"n": 1}})
tauri_command(app, "greet", funcion(a, ap) { retornar "Hello, " + a["name"] })
app["puerto"] = 9
sea r = tauri_handle_request(app, {"metodo": "POST", "ruta": "/" + app["token"] + "/__ipc", "cabeceras": {"host": "127.0.0.1:9", "x-cristal": app["token"]},
    "cuerpo": "\{\"cmd\":\"greet\",\"args\":\{\"name\":\"Ana\"}}"})
eq(r["cuerpo"], "\{\"ok\":true,\"valor\":\"Hello, Ana\"}", "tauri invoke")
sea port = tauri_serve(app, 0)
afirmar(texto_contiene(tauri_url(app), ":" + port + "/"), "tauri_url")
tauri_close(app)
// windows
eq(windows_from_utf16(windows_to_utf16("héllo")), "héllo", "windows utf16")
eq(windows_guid_to_string(windows_guid_from_string("6B29FC40-CA47-1067-B31D-00DD010662DA")), "\{6B29FC40-CA47-1067-B31D-00DD010662DA}", "windows guid")
eq(windows_hresult_info(windows_hresult_from_win32(5))["name"], "E_ACCESSDENIED", "windows hresult")
sea pe = windows_parse_pe(leer_archivo("tests/bibliotecas/datos/ventanas-mini.pe"))
eq([pe["machine"], pe["imports"]["USER32.dll"], pe["exports"][1]["name"]], ["x64", ["MessageBoxW"], "Sumar"], "windows_parse_pe")
eq(windows_parse_reg_file("[HKEY_CURRENT_USER\\A]\n\"x\"=dword:00000010\n")["HKEY_CURRENT_USER\\A"]["x"]["datos"], 16, "windows reg")
mostrar("[OK] en_lote31")
