importar "astro"
funcion cerca(a, b, tol, q) { afirmar(absoluto(a - b) < tol, q + ": " + a + " != " + b) }
cerca(astro_juliano(946728000000), 2451545, 0.0000001, "J2000.0")
cerca(astro_desde_juliano(2451545), 946728000000, 1, "juliano de vuelta")
// Santiago, 21-11-2025: salida ≈ 09:30 UTC, puesta ≈ 23:30 UTC (±3 min).
sea base = 1763683200000
sea s = astro_sol(-33.45, -70.67, base)
cerca((s["salida_ms"] - base) / 60000, 570, 3, "salida en Santiago")
cerca((s["puesta_ms"] - base) / 60000, 1409, 3, "puesta en Santiago")
cerca(s["duracion_h"], 14, 0.2, "día de 14 h")
afirmar(s["alba_civil_ms"] < s["salida_ms"] y s["alba_nautica_ms"] < s["alba_civil_ms"], "crepúsculos")
cerca(s["mediodia_ms"], (s["salida_ms"] + s["puesta_ms"]) / 2, 120000, "mediodía al centro")
// Ecuador en equinoccio ≈ 12 h; Tromsø en junio = sol de medianoche.
cerca(astro_sol(0, 0, 1742515200000)["duracion_h"], 12.1, 0.15, "equinoccio en el ecuador")
sea polar = astro_sol(69.65, 18.96, 1750464000000)
afirmar(polar["salida_ms"] == nulo y polar["duracion_h"] == 24, "sol de medianoche")
sea p = astro_posicion_sol(-33.45, -70.67, s["mediodia_ms"])
cerca(p["altura"], s["altura_maxima"], 0.3, "altura al mediodía")
afirmar(p["acimut"] < 5 o p["acimut"] > 355, "al mediodía el sol está al norte (hemisferio sur)")
// Luna nueva del 20-11-2025 06:47 UTC y llena del 5-11-2025 13:19 UTC.
afirmar(astro_luna(1763621220000)["iluminacion"] < 0.01, "luna nueva")
afirmar(astro_luna(1762348740000)["iluminacion"] > 0.99, "luna llena")
afirmar(astro_luna(1762348740000)["nombre"] == "luna llena", astro_luna(1762348740000)["nombre"])
afirmar(astro_estacion(-33.45, base) == "primavera" y astro_estacion(40, base) == "otoño", "estaciones por hemisferio")
afirmar(astro_estacion(-33.45, 1767225600000) == "verano", "verano en el sur en enero")
cerca(astro_sideral(946728000000), 280.46061837, 0.000001, "hora sideral en J2000")
mostrar("[OK] astro")
