importar "recolecta"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Casos del RFC 3986 §5.4.
sea b = "http://a/b/c/d;p?q"
para par en [["g:h", "g:h"], ["g", "http://a/b/c/g"], ["./g", "http://a/b/c/g"], ["g/", "http://a/b/c/g/"], ["/g", "http://a/g"], ["//g", "http://g"], ["?y", "http://a/b/c/d;p?y"], ["g?y", "http://a/b/c/g?y"], ["#s", "http://a/b/c/d;p?q#s"], ["g#s", "http://a/b/c/g#s"], [";x", "http://a/b/c/;x"], ["", "http://a/b/c/d;p?q"], [".", "http://a/b/c/"], ["./", "http://a/b/c/"], ["..", "http://a/b/"], ["../", "http://a/b/"], ["../g", "http://a/b/g"], ["../..", "http://a/"], ["../../g", "http://a/g"], ["../../../g", "http://a/g"], ["/./g", "http://a/g"], ["/../g", "http://a/g"], ["g.", "http://a/b/c/g."], ["g..", "http://a/b/c/g.."], ["./../g", "http://a/b/g"], ["./g/.", "http://a/b/c/g/"], ["g/./h", "http://a/b/c/g/h"], ["g/../h", "http://a/b/c/h"], ["g;x=1/./y", "http://a/b/c/g;x=1/y"], ["g;x=1/../y", "http://a/b/c/y"]] {
    sea r = recolecta_resolver(b, par[0])
    igual(r, par[1], "RFC 3986: " + par[0])
}
// Sitio de mentira.
sea paginas = {
    "https://tienda.cl/robots.txt": "User-agent: *\nDisallow: /privado\nAllow: /privado/publico\nCrawl-delay: 0\n",
    "https://tienda.cl/": "<html><body><a href=\"/productos\">P</a> <a href=\"privado/x\">X</a> <a href=\"https://otro.cl/\">O</a><form action=\"/login\" method=\"post\"><input type=\"hidden\" name=\"csrf\" value=\"tok123\"><input name=\"usuario\"><input type=\"password\" name=\"clave\"><input type=\"checkbox\" name=\"recordar\" value=\"1\" checked><select name=\"pais\"><option value=\"ar\">AR</option><option value=\"cl\" selected>CL</option></select><button type=\"submit\" name=\"entrar\" value=\"si\">Entrar</button></form></body></html>",
    "https://tienda.cl/productos": "<html><a href=\"productos?p=2#top\">sig</a><a href=\"/\">inicio</a></html>",
    "https://tienda.cl/productos?p=2": "<html>fin</html>"
}
sea pedidos = []
sea falso_tr = funcion(m, u, cab, cuerpo) {
    pedidos.agregar(m + " " + u + " cookie=" + (cab["Cookie"] ?? ""))
    si (u == "https://tienda.cl/login") { retornar {"estado": 302, "cabeceras": {"location": "/cuenta"}, "cuerpo": "", "set_cookie": ["sesion=abc; Path=/; HttpOnly; Secure", "tema=oscuro; Max-Age=60"]} }
    si (u == "https://tienda.cl/cuenta") { retornar {"estado": 200, "cabeceras": {"content-type": "text/html"}, "cuerpo": "<html><h1>Hola " + (cab["Cookie"] ?? "") + "</h1></html>", "set_cookie": []} }
    si (tiene_clave(paginas, u)) {
        sea t = "text/html"
        si (texto_termina_con(u, ".txt")) { t = "text/plain" }
        retornar {"estado": 200, "cabeceras": {"content-type": t}, "cuerpo": paginas[u], "set_cookie": []}
    }
    retornar {"estado": 404, "cabeceras": {}, "cuerpo": "", "set_cookie": []}
}
sea s = recolecta_sesion({"transporte": falso_tr, "agente": "PruebaBot"})
sea p = recolecta_get(s, "https://tienda.cl/")
sea f = recolecta_formularios(p)[0]
igual([f["accion"], f["metodo"], f["campos"], f["botones"]], ["https://tienda.cl/login", "POST", [["csrf", "tok123"], ["usuario", ""], ["clave", ""], ["recordar", "1"], ["pais", "cl"]], [["entrar", "si"]]], "leer formulario")
sea r = recolecta_enviar(s, f, {"usuario": "ana", "clave": "secreta"}, "entrar")
igual([r["url"], r["estado"]], ["https://tienda.cl/cuenta", 200], "redirección 302 tras POST")
igual([recolecta_cookies_para(s, "https://tienda.cl/x"), recolecta_cookies_para(s, "http://tienda.cl/x"), recolecta_cookies_para(s, "https://otra.cl/")], ["sesion=abc; tema=oscuro", "tema=oscuro", ""], "cookies por esquema y dominio")
igual(pedidos, ["GET https://tienda.cl/ cookie=", "POST https://tienda.cl/login cookie=", "GET https://tienda.cl/cuenta cookie=sesion=abc; tema=oscuro"], "secuencia de pedidos")
igual(recolecta_enlaces(p), ["https://tienda.cl/productos", "https://tienda.cl/privado/x", "https://otro.cl/"], "enlaces absolutos")
sea rb = recolecta_robots(paginas["https://tienda.cl/robots.txt"], "PruebaBot")
igual([recolecta_permitido(rb, "/privado/a"), recolecta_permitido(rb, "/privado/publico/b"), recolecta_permitido(rb, "https://tienda.cl/otra")], [falso, verdadero, verdadero], "robots: Allow más específico")
sea s2 = recolecta_sesion({"transporte": falso_tr})
igual(recolecta_rastrear(s2, "https://tienda.cl/", {"max_paginas": 10}), ["https://tienda.cl/", "https://tienda.cl/productos", "https://tienda.cl/productos?p=2"], "rastreo respeta robots y el host")
igual(recolecta_sitemap("<urlset><url><loc>https://a.cl/1</loc><lastmod>2026-01-01</lastmod></url><url><loc>https://a.cl/2</loc></url></urlset>")[0]["url"], "https://a.cl/1", "sitemap")
igual([recolecta_fecha_http("Wed, 21 Oct 2015 07:28:00 GMT"), recolecta_fecha_http("Sunday, 06-Nov-94 08:49:37 GMT")], [1445412480000, 784111777000], "fechas HTTP (RFC 1123 y 850)")
sea r2 = recolecta_robots("User-agent: *\nDisallow: /*.pdf$\nDisallow: /tmp/\nUser-agent: googlebot\nDisallow: /\n", "MiBot")
igual([recolecta_permitido(r2, "/a.pdf"), recolecta_permitido(r2, "/a.pdf?x"), recolecta_permitido(r2, "/tmp/x"), recolecta_permitido(recolecta_robots("User-agent: *\nDisallow: /*.pdf$\nUser-agent: googlebot\nDisallow: /\n", "Googlebot/2.1"), "/x")], [falso, verdadero, falso, falso], "robots: comodines y grupo por agente")
sea s3 = recolecta_sesion({"transporte": falso_tr})
igual(recolecta_guardar_cookie(s3, "https://tienda.cl/", "x=1; Domain=cl"), nulo, "no acepta cookies de un TLD")
igual(recolecta_guardar_cookie(s3, "http://tienda.cl/", "s=1; Secure"), nulo, "Secure solo por https")
recolecta_guardar_cookie(s3, "https://a.tienda.cl/app/x", "y=2; Domain=tienda.cl; Path=/app")
igual([recolecta_cookies_para(s3, "https://b.tienda.cl/app/z"), recolecta_cookies_para(s3, "https://b.tienda.cl/apple")], ["y=2", ""], "dominio padre y ruta")
mostrar("[OK] recolecta")
