importar "mezcla"
importar "base64"
importar "audio"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// FLAC hechos con ffmpeg (LPC, estéreo y 24 bits). El MD5 es el de las
// muestras del WAV original, calculado con hashlib de Python.
sea F16 = base64_decodificar("")
sea F24 = base64_decodificar("")
sea i16 = mezcla_flac_info(F16)
igual([i16["tasa"], i16["canales"], i16["bits"], i16["muestras"], i16["etiquetas"]["TITLE"]], [44100, 2, 16, 2500, "Prueba"], "info")
sea s16 = mezcla_flac_decodificar(F16, nulo)
igual(mezcla_md5_muestras(s16["muestras"], 16), "e3ab1e22a0d2f6639d8d5efbf5495bcd", "16 bits estéreo")
igual(mezcla_flac_verificar(F24)["calculado"], "9261921764afa44e55bb4c6839b9832e", "24 bits")
igual(mezcla_flac_verificar(F16)["valido"], verdadero, "md5 de streaminfo")
// CRC: un byte cambiado se detecta.
sea pd = longitud(F16) - 700
sea roto = subcadena(F16, 0, pd) + bytes_entero(bits_xo(byte_en(F16, pd), 1), 1, 0) + subcadena(F16, pd + 1, longitud(F16))
sea error = ""
intentar { mezcla_flac_decodificar(roto, nulo) } capturar (e) { error = "" + e }
igual(texto_indice(error, "flac") >= 0, verdadero, "dato dañado")
// Codificador propio: ida y vuelta sin pérdida (ffmpeg también lo abre igual).
sea f = mezcla_flac_codificar({"tasa": 44100, "bits": 16, "muestras": s16["muestras"]}, {"bloque": 1024, "etiquetas": {"ARTIST": "C-Forge"}})
sea v = mezcla_flac_verificar(f)
igual([v["valido"], v["calculado"], mezcla_flac_info(f)["etiquetas"]["ARTIST"]], [verdadero, "e3ab1e22a0d2f6639d8d5efbf5495bcd", "C-Forge"], "codificar 16")
igual(longitud(f) < 2500 * 4, verdadero, "comprime")
sea s24 = mezcla_flac_decodificar(F24, nulo)
igual(mezcla_flac_verificar(mezcla_flac_codificar({"tasa": 48000, "bits": 24, "muestras": s24["muestras"]}, nulo))["calculado"], "9261921764afa44e55bb4c6839b9832e", "codificar 24")
igual(mezcla_flac_decodificar(mezcla_flac_codificar(sonido_tono(440, 30, 8000), nulo), nulo)["canales"], 1, "desde pcm")
// Mezclador.
sea a = mezcla_desde_muestras([[0.5, 0.5, 0.5, 0.5]], 4)
sea b = mezcla_desde_muestras([[0.25, 0.25]], 4)
sea m = mezcla_mezclar([a, {"fuente": b, "inicio_ms": 500}], {"canales": 1})
igual(m["c"][0], [0.5, 0.5, 0.75, 0.75], "mezcla con inicio")
igual(mezcla_concatenar([a, b])["c"][0], [0.5, 0.5, 0.5, 0.5, 0.25, 0.25], "concatenar")
igual(mezcla_fundido(a, 1000, nulo)["c"][0], [0, 0.125, 0.25, 0.375], "fundido de entrada")
igual(mezcla_fundido(a, nulo, 1000)["c"][0], [0.5, 0.375, 0.25, 0.125], "fundido de salida")
igual(mezcla_recortar(mezcla_concatenar([a, b]), 500, 1250)["c"][0], [0.5, 0.5, 0.25], "recortar")
igual(mezcla_remuestrear(mezcla_desde_muestras([[0, 1, 0, 1]], 2), 4)["c"][0], [0, 0.5, 1, 0.5, 0, 0.5, 1, 1], "remuestrear")
igual(mezcla_velocidad(mezcla_desde_muestras([[0, 1, 2, 3, 4, 5]], 6), 2)["c"][0], [0, 2, 4], "velocidad")
sea p = mezcla_panear(a, 1)
igual([p["c"][0][0] < 0.0001, p["c"][1][0]], [verdadero, 0.5], "paneo")
igual(redondear(mezcla_db(a, 0 - 6.0206)["c"][0][0] * 1000), 250, "decibelios")
igual(mezcla_normalizar(b, 1)["c"][0], [1, 1], "normalizar")
igual(mezcla_mezclar([a, a, a], {"normalizar": verdadero, "canales": 1})["c"][0][0], 1, "mezcla normalizada")
igual(mezcla_cuadros(mezcla_repetir(b, 3)), 6, "repetir")
igual(mezcla_cuadros(mezcla_retrasar(b, 500)), 4, "retrasar")
igual(redondear(mezcla_rms(a) * 100), 50, "rms")
// WAV y vuelta.
sea w = mezcla_wav(mezcla_mezclar([a], {"canales": 2}))
sea r = mezcla_abrir(w)
igual([r["canales"], mezcla_cuadros(r), redondear(r["c"][1][0] * 100)], [2, 4, 50], "wav")
igual(mezcla_cuadros(mezcla_abrir(F16)), 2500, "abrir flac")
mostrar("[OK] mezcla")
