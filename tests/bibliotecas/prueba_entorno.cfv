importar "entorno"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Contra dockerd 29 (con una imagen local con redis-server) se probaron:
// entorno_con con memoria_rapida por el puerto publicado, grupos en una red
// con alias, fallos tempranos, esperas por comando, tiempo agotado y la
// limpieza por etiqueta de sesión. Aquí, sobre el motor simulado.
sea sim = contenedor_simulado()
entorno_cliente(contenedor_cliente(nulo, {"transporte": sim["transporte"]}))
igual(longitud(entorno_sesion()), 12, "sesión")
sea r = entorno_con(entorno_contenedor("cforge/mini:1", {"cmd": "echo listo para servir", "esperar": entorno_esperar_log("listo", 1), "puertos": [6379]}), funcion(e) {
    sea c = sim["estado"]["contenedores"][e["id"]]["cfg"]
    retornar [c["Labels"]["cforge.entorno.sesion"] == entorno_sesion(), entorno_puerto(e, 6379), entorno_direccion(e, 6379), entorno_logs(e)]
})
igual(r, [verdadero, 32769, "127.0.0.1:32769", "listo para servir\n"], "entorno_con")
igual(longitud(claves(sim["estado"]["contenedores"])), 0, "se borró")
// Si fn lanza, igual se borra.
sea err = nulo
intentar { entorno_con(entorno_contenedor("cforge/mini:1", {"cmd": "echo ok", "esperar": entorno_esperar_log("ok", 1)}), funcion(e) { lanzar "fallo de la prueba" }) } capturar (x) { err = x }
igual([err, longitud(claves(sim["estado"]["contenedores"]))], ["fallo de la prueba", 0], "limpia al fallar")
// Termina antes de estar listo.
err = nulo
intentar { entorno_iniciar(entorno_contenedor("cforge/mini:1", {"cmd": "falla 4", "esperar": entorno_esperar_log("nunca", 1)})) } capturar (x) { err = x }
igual(texto_empieza_con(err, "entorno: el contenedor terminó antes de estar listo (código 4)"), verdadero, "falla temprana")
// Espera por comando y combinada; ejecutar.
sea e = entorno_iniciar(entorno_contenedor("cforge/mini:1", {"cmd": "sleep 9", "esperar": entorno_esperar_todas([entorno_esperar_comando("test -f /listo")])}))
igual(entorno_ejecutar(e, "cat /x")["stdout"], "salida de cat /x\n", "ejecutar")
// Imagen ausente sin bajar.
err = nulo
intentar { entorno_iniciar(entorno_contenedor("no/hay", {"bajar": falso})) } capturar (x) { err = x }
igual(err, "entorno: falta la imagen no/hay", "sin imagen")
// Recetas.
sea rd = entorno_redis(nulo)
igual([rd["imagen"], rd["puertos"], rd["esperar"]["texto"]], ["redis:7-alpine", [6379], "Ready to accept connections"], "receta redis")
igual(entorno_postgres({"imagen": "postgres:15"})["imagen"], "postgres:15", "receta con imagen propia")
igual(entorno_limpiar(entorno_sesion()), 1, "limpiar")
mostrar("[OK] entorno")
