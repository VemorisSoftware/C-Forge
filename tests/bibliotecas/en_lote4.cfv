// Written in English.
import "msgpack"
import "css"
import "multipart"
import "queue"
import "mapper"
import "openapi"
import "schema"
import "scrape"
import "ndarray"
import "json"
function same(a, b, what) { assert(("" + a) == ("" + b), what + ": [" + a + "] != [" + b + "]") }
same(msgpack_decode(msgpack_encode({"a": [1, 2.5, "x"]})), {"a": [1, 2.5, "x"]}, "msgpack")
same(css_minify("a { color : #ffffff }"), "a{color:#fff}", "css")
let form = multipart_build([{"name": "file", "filename": "a.txt", "data": "hi"}])
let parts = multipart_parse(form["body"], form["content_type"])
same(parts[0]["filename"] + ":" + parts[0]["data"], "a.txt:hi", "multipart")
let clock = [0]
let q = queue_with_clock(queue_new(), function() { return clock[0] })
let seen = []
queue_add(q, "job", 1, {"priority": 1, "attempts": 1})
queue_add(q, "job", 2, {"priority": 9, "delay_ms": 0})
queue_process(q, {"job": function(x) { seen.agregar(x) }})
same(seen, [2, 1], "queue priority")
same(queue_status(q), {"done": 2, "failed": 0, "pending": 0, "ready": 0}, "queue_status")
same(mapper_map({"a": {"b": 3}}, {"x": "a.b", "y": {"from": "a.c", "default": 0}}), {"x": 3, "y": 0}, "mapper")
let api = openapi_new("Shop", "1.0.0")
openapi_route(api, "DELETE", "/items/:id", {"summary": "Delete", "responses": {"204": null}})
let doc = json_parsear(openapi_json(api))
let key = "/items/" + caracter(123) + "id" + caracter(125)
same(doc["paths"][key]["delete"]["summary"], "Delete", "openapi summary")
same(doc["paths"][key]["delete"]["responses"]["204"]["description"], "No Content", "openapi english reason")
let page = scrape_load("<ul><li class=a>one<li>two</ul>")
same(scrape_extract(page, "li"), ["one", "two"], "scrape")
same(scrape_text(scrape_first(page, "li.a")), "one", "scrape_first")
same(ndarray_to_list(ndarray_dot(ndarray_from([[1, 2], [3, 4]]), ndarray_eye(2))), [[1, 2], [3, 4]], "ndarray")
print("[OK] lote 4 in English")
