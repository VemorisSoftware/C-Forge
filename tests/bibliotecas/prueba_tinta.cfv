importar "tinta"
funcion igual(a, b, q) { afirmar(a == b, q + ": [" + a + "] != [" + b + "]") }
sea E = caracter(27) + "["
tinta_usar(verdadero)
igual(tinta_rojo("hola"), E + "31mhola" + E + "39m", "rojo")
igual(tinta_negrita(tinta_verde("ok")), E + "1m" + E + "32mok" + E + "39m" + E + "22m", "anidado")
igual(tinta_rojo("a" + tinta_azul("b") + "c"), E + "31ma" + E + "34mb" + E + "39m" + E + "31mc" + E + "39m", "reabre el color de afuera")
igual(tinta_rgb(255, 300, 0 - 5, "x"), E + "38;2;255;255;0mx" + E + "39m", "rgb acotado")
igual(tinta_hex("#ff8800", "x"), E + "38;2;255;136;0mx" + E + "39m", "hex")
igual(tinta_quitar(tinta_negrita(tinta_rojo("hola")) + " mundo"), "hola mundo", "quitar")
igual(tinta_largo(tinta_cian("12345")), 5, "largo visible")
tinta_usar(falso)
igual(tinta_rojo("plano"), "plano", "sin colores")
igual(tinta_rojo(42), "42", "números")
mostrar("[OK] tinta")
