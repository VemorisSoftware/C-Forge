importar "empaca"
funcion j(t) { retornar texto_reemplazar(texto_reemplazar(t, "«", caracter(123)), "»", caracter(125)) }
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion tiene(t, s0, q) {
    sea s = j(s0)
    afirmar(texto_indice(t, s) >= 0, q + ": falta [" + s + "]")
}
funcion no_tiene(t, s0, q) {
    sea s = j(s0)
    afirmar(texto_indice(t, s) < 0, q + ": sobra [" + s + "]")
}
// Proyecto en memoria (el mismo, en disco, corre en Node con la misma salida que sin empaquetar).
sea fs = {
    "/p/src/main.js": "import saludar, « VERSION as V » from \"saludo\";\nimport * as mates from \"@org/mates\";\nimport « sumar, contador, incrementar » from \"./util/mates.js\";\nimport datos from \"./datos.json\";\nimport \"./efecto.js\";\nconst viejo = require(\"./viejo.cjs\");\nexport « sumar »;\nexport * from \"./util/mates.js\";\nexport default function principal() « return \"listo\"; »\nconst o = « contador, V: 1 »;\nconst re = /\\/\\*no es comentario\\*\\//g;\nconsole.log(saludar(\"Ana\"), V, mates.doble(21), sumar(2, 3), datos.nombre, o.contador, `$«sumar(1, 2)» /* no */`);\nimport(\"./tarde.js\").then(m => m.tarde());\nconsole.log(process.env.NODE_ENV);\n",
    "/p/src/util/mates.js": "export let contador = 0;\nexport function incrementar() « contador++; »\nexport const sumar = (a, b) => a + b, restar = (a, b) => a - b;\nexport class Punto «»\n",
    "/p/src/datos.json": "«\"nombre\": \"Datos\"»",
    "/p/src/efecto.js": "console.log(\"efecto\");",
    "/p/src/viejo.cjs": "module.exports = « valor: require(\"./util/mates.js\").sumar(1, 1) »;",
    "/p/src/tarde.js": "export function tarde() « return 1; »",
    "/p/node_modules/saludo/package.json": "«\"name\": \"saludo\", \"exports\": «\".\": «\"import\": \"./lib/esm.js\", \"require\": \"./lib/cjs.js\"»»»",
    "/p/node_modules/saludo/lib/esm.js": "export default function saludar(n) « return \"Hola \" + n; »\nexport const VERSION = \"1.2.3\";",
    "/p/node_modules/@org/mates/package.json": "«\"name\": \"@org/mates\", \"main\": \"index.js\"»",
    "/p/node_modules/@org/mates/index.js": "exports.doble = function (x) « return x * 2; »;"
}
para k en claves(fs) { fs[k] = j(fs[k]) }
// Resolución.
igual(empaca_resolver("/p/src/main.js", "./util/mates", {"archivos": fs}), "/p/src/util/mates.js", "extensión implícita")
igual(empaca_resolver("/p/src/util/mates.js", "saludo", {"archivos": fs}), "/p/node_modules/saludo/lib/esm.js", "exports condicionales")
igual(empaca_resolver("/p/src/main.js", "@org/mates", {"archivos": fs}), "/p/node_modules/@org/mates/index.js", "paquete con ámbito")
igual(empaca_resolver("/p/src/main.js", "nada", {"archivos": fs}), nulo, "no existe")
igual(empaca_resolver("/p/src/main.js", "~/datos.json", {"archivos": fs, "alias": {"~": "/p/src"}}), "/p/src/datos.json", "alias")
// Construcción.
sea r = empaca_construir({"entrada": "/p/src/main.js", "archivos": fs, "formato": "iife", "nombre_global": "App", "define": {"process.env.NODE_ENV": "\"production\""}})
igual(longitud(r["modulos"]), 8, "módulos")
igual(r["advertencias"], [], "sin advertencias")
sea c = r["codigo"]
tiene(c, "var App = (function () «", "iife con nombre")
tiene(c, "module.exports = «\"nombre\": \"Datos\"»;", "json")
tiene(c, "console.log(\"production\");", "define")
tiene(c, "const o = « contador: __imp3[\"contador\"], V: 1 »;", "enlace vivo en objeto abreviado")
tiene(c, "__imp3[\"sumar\"](2, 3)", "enlace vivo")
tiene(c, "__estrella(exports, __requerir(\"./util/mates.js\"));", "export *")
tiene(c, "Promise.resolve().then(() => __requerir(\"./tarde.js\"))", "import dinámico")
tiene(c, "const re = /\\/\\*no es comentario\\*\\//g;", "regex intacta")
tiene(c, "`$«__imp3[\"sumar\"](1, 2)» /* no */`", "plantilla")
no_tiene(c, "import ", "sin import")
// Formatos.
sea esm = empaca_construir({"entrada": "/p/src/main.js", "archivos": fs, "formato": "esm"})["codigo"]
tiene(esm, "export var restar = __salida[\"restar\"];", "esm sigue export *")
tiene(empaca_construir({"entrada": "/p/src/main.js", "archivos": fs, "formato": "cjs"})["codigo"], "module.exports = __requerir_id(0);", "cjs")
sea ext = empaca_construir({"entrada": "/p/src/main.js", "archivos": fs, "externos": ["saludo"]})
igual(longitud(ext["modulos"]), 7, "externos")
// Compactar respeta textos, plantillas y regex.
sea js = j("// comentario\nconst a = \"// no\" + '/* tampoco */';   /* fuera */\nconst b = `  $«a»  `;\n\n\nconst r = /a\\/b/; const c = x - -1;\n/*! licencia */\n")
igual(empaca_compactar(js), j("const a=\"// no\"+'/* tampoco */';\nconst b=`  $«a»  `;\nconst r=/a\\/b/;const c=x- -1;\n/*! licencia */\n"), "compactar")
igual(empaca_grafo({"entrada": "/p/src/viejo.cjs", "archivos": fs}), {"/p/src/util/mates.js": [], "/p/src/viejo.cjs": ["/p/src/util/mates.js"]}, "grafo")
mostrar("[OK] empaca")
