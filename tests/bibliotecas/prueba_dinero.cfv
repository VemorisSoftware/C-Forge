importar "dinero"
funcion igual(a, b, q) { afirmar(a == b, q + ": [" + a + "] != [" + b + "]") }
funcion t(x) { retornar dinero_texto(x) }
igual(t(dinero_sumar("0.1", "0.2")), "0.3", "0.1 + 0.2 exacto")
afirmar(dinero_igual(dinero_sumar("0.1", "0.2"), "0.30"), "0.30 == 0.3")
igual(t(dinero_restar("10", "0.01")), "9.99", "resta")
igual(t(dinero_por("19.99", "3")), "59.97", "multiplicación")
igual(t(dinero_por("-1.5", "2.25")), "-3.375", "negativos")
igual(t(dinero_redondear("2.345", 2, "par")), "2.34", "bancario hacia el par")
igual(t(dinero_redondear("2.355", 2, "par")), "2.36", "bancario")
igual(t(dinero_redondear("2.345", 2, "arriba")), "2.35", "mitad arriba")
igual(t(dinero_redondear("-2.345", 2, "arriba")), "-2.35", "negativo arriba")
igual(t(dinero_redondear("5", 2)), "5.00", "agrega decimales")
igual(t(dinero_dividir("10", "3", 2)), "3.33", "división")
igual(t(dinero_dividir("-10", "4", 2)), "-2.50", "división negativa")
igual(t(dinero_dividir("1", "8", 3)), "0.125", "división exacta")
sea partes = dinero_repartir("100", 3, 2)
igual(t(partes[0]) + " " + t(partes[1]) + " " + t(partes[2]), "33.34 33.33 33.33", "reparto exacto")
igual(dinero_comparar("1.10", "1.1"), 0, "comparar igual")
igual(dinero_comparar("-1", "0.5"), 0 - 1, "comparar menor")
igual(dinero_formato("1234567.5", 2, ".", ","), "1.234.567,50", "formato chileno")
igual(dinero_formato("-1000", 0, ","), "-1,000", "formato negativo")
igual(t(dinero(".5")), "0.5", "sin entero")
sea m = ""
intentar { dinero("12a") } capturar (e) { m = e }
afirmar(texto_empieza_con(m, "dinero: monto inválido"), "inválido")
intentar { dinero_dividir("1", "0") } capturar (e) { m = e }
igual(m, "dinero: división por cero", "división por cero")
intentar { dinero("99999999999999999") } capturar (e) { m = e }
afirmar(texto_indice(m, "desbordamiento") >= 0, "desbordamiento")
mostrar("[OK] dinero")
