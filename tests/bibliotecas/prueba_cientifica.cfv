// Pruebas de cientifica. Los valores de referencia salen de SciPy 1.18.
importar "cientifica"
funcion cerca(a, b, tol, q) {
    sea e = absoluto(a - b)
    si (b != 0) { e = e / absoluto(b) }
    afirmar(e <= tol, q + ": " + a + " vs " + b + " (error relativo " + e + ")")
}
sea casos = [
    ["gamma(0.5)", cientifica_gamma(0.5), 1.7724538509055159, 1e-14],
    ["gamma(-2.5)", cientifica_gamma(-2.5), -0.9453087204829419, 1e-14],
    ["gamma(1e-5)", cientifica_gamma(0.00001), 99999.42279422554, 1e-14],
    ["gamma(33.3)", cientifica_gamma(33.3), 7.487577596522633e+35, 1e-13],
    ["gamma(5)", cientifica_gamma(5), 24, 0],
    ["lgamma(100)", cientifica_lgamma(100), 359.1342053695754, 1e-14],
    ["lgamma(1e5)", cientifica_lgamma(100000), 1051287.7089736569, 1e-14],
    ["lgamma(0.0025)", cientifica_lgamma(0.0025), 5.990026642114524, 1e-14],
    ["beta(2,3)", cientifica_beta(2, 3), 1 / 12, 1e-14],
    ["erf(0.1)", cientifica_erf(0.1), 0.1124629160182849, 1e-14],
    ["erf(-0.7)", cientifica_erf(-0.7), -0.6778011938374183, 1e-14],
    ["erf(2.4)", cientifica_erf(2.4), 0.999311486103355, 1e-14],
    ["erf(3.5)", cientifica_erf(3.5), 0.9999992569016276, 1e-14],
    ["erfc(1)", cientifica_erfc(1), 0.15729920705028516, 1e-14],
    ["erfc(2.6)", cientifica_erfc(2.6), 0.000236034416529349, 1e-14],
    ["erfc(5)", cientifica_erfc(5), 1.5374597944280347e-12, 1e-14],
    ["erfc(10)", cientifica_erfc(10), 2.0884875837625446e-45, 1e-14],
    ["P(2,1)", cientifica_gamma_inc(2, 1), 0.2642411176571153, 1e-14],
    ["P(0.5,3)", cientifica_gamma_inc(0.5, 3), 0.9856941215645704, 1e-14],
    ["P(10,12)", cientifica_gamma_inc(10, 12), 0.7576078383294875, 1e-14],
    ["P(30,20)", cientifica_gamma_inc(30, 20), 0.021818217525557418, 1e-13],
    ["I(2,3,0.4)", cientifica_beta_inc(2, 3, 0.4), 0.5247999999999999, 1e-14],
    ["I(0.5,0.5,0.1)", cientifica_beta_inc(0.5, 0.5, 0.1), 0.20483276469913345, 1e-14],
    ["I(10,4,0.8)", cientifica_beta_inc(10, 4, 0.8), 0.7473243095040001, 1e-14],
    ["psi(1)", cientifica_digamma(1), -0.5772156649015329, 1e-14],
    ["psi(0.3)", cientifica_digamma(0.3), -3.502524222200133, 1e-14],
    ["psi(7.5)", cientifica_digamma(7.5), 1.9467574842460866, 1e-14],
    ["psi(-0.5)", cientifica_digamma(-0.5), 0.03648997397857651, 1e-13],
    ["zeta(2)", cientifica_zeta(2), 1.6449340668482264, 1e-13],
    ["zeta(3)", cientifica_zeta(3), 1.2020569031595942, 1e-13],
    ["zeta(1.5)", cientifica_zeta(1.5), 2.612375348685488, 1e-13],
    ["J0(1)", cientifica_bessel_j0(1), 0.7651976865579665, 1e-14],
    ["J0(5)", cientifica_bessel_j0(5), -0.1775967713143383, 1e-14],
    ["J0(11.9)", cientifica_bessel_j0(11.9), 0.02504944169958965, 1e-10],
    ["J0(12.1)", cientifica_bessel_j0(12.1), 0.06966677360680731, 1e-10],
    ["J0(30)", cientifica_bessel_j0(30), -0.08636798358104023, 1e-13],
    ["J0(100)", cientifica_bessel_j0(100), 0.019985850304223115, 1e-13],
    ["J1(1)", cientifica_bessel_j1(1), 0.44005058574493355, 1e-14],
    ["J1(15)", cientifica_bessel_j1(15), 0.20510403861352283, 1e-13],
    ["J1(-1)", cientifica_bessel_j1(-1), -0.44005058574493355, 1e-14],
    ["Y0(0.5)", cientifica_bessel_y0(0.5), -0.4445187335067066, 1e-14],
    ["Y0(5)", cientifica_bessel_y0(5), -0.30851762524903303, 1e-13],
    ["Y0(20)", cientifica_bessel_y0(20), 0.06264059680938384, 1e-13],
    ["Y1(2)", cientifica_bessel_y1(2), -0.10703243154093756, 1e-14],
    ["Y1(13)", cientifica_bessel_y1(13), -0.2100814084206936, 1e-12],
    ["Y1(50)", cientifica_bessel_y1(50), -0.05679566856201487, 1e-13],
    ["J2(1)", cientifica_bessel_jn(2, 1), 0.1149034849319005, 1e-14],
    ["J5(3)", cientifica_bessel_jn(5, 3), 0.043028434877047585, 1e-13],
    ["J10(2)", cientifica_bessel_jn(10, 2), 2.5153862827167347e-07, 1e-13],
    ["J3(20)", cientifica_bessel_jn(3, 20), -0.09890139456044958, 1e-13],
    ["Y2(1)", cientifica_bessel_yn(2, 1), -1.6506826068162548, 1e-14],
    ["Y4(10)", cientifica_bessel_yn(4, 10), -0.14494951186809382, 1e-12],
    ["K(0.5)", cientifica_eliptica_k(0.5), 1.8540746773013719, 1e-14],
    ["K(0.9)", cientifica_eliptica_k(0.9), 2.5780921133481733, 1e-14],
    ["E(0)", cientifica_eliptica_e(0), 1.5707963267948966, 1e-14],
    ["E(0.9)", cientifica_eliptica_e(0.9), 1.1047747327040733, 1e-14]
]
para c en casos { cerca(c[1], c[2], c[3], c[0]) }
sea error = ""
intentar { cientifica_gamma(-3) } capturar (e) { error = "" + e }
afirmar(texto_contiene(error, "polo"), "polo de gamma")

// Integración.
sea inf = cientifica_infinito()
cerca(cientifica_integrar(funcion(x) { retornar exponencial(0 - x * x) }, 0 - inf, inf, nulo), 1.7724538509055159, 1e-13, "∫ e^(−x²) en toda la recta")
cerca(cientifica_integrar(funcion(x) { si (x == 0) { retornar 1 } retornar seno(x) / x }, 0, 50, nulo), 1.5516170724859364, 1e-13, "∫ sen(x)/x")
cerca(cientifica_integrar(funcion(x) { retornar 1 / raiz(x) }, 0, 1, nulo), 2, 1e-9, "singularidad integrable")
cerca(cientifica_integrar(funcion(x) { retornar exponencial(0 - x) }, 0, inf, nulo), 1, 1e-13, "∫ e^(−x) hasta infinito")
cerca(cientifica_integrar(funcion(x) { retornar potencia(x, 12) }, 0, 1, nulo), 1 / 13, 1e-14, "polinomio (Gauss-Kronrod exacto)")
sea d = cientifica_integrar(funcion(x) { retornar coseno(x) }, 0, 1, {"detalle": verdadero})
afirmar(d["evaluaciones"] == 15 y d["error"] < 1e-10, "detalle de la integración")
cerca(cientifica_derivada(funcion(x) { retornar seno(x) }, 1, nulo), coseno(1), 1e-12, "derivada")

// EDO.
sea r = cientifica_edo(funcion(t, v) { retornar [v[0] * (1.5 - v[1]), v[1] * (-3 + v[0])] }, 0, [1, 1], 10, {"rtol": 1e-10, "atol": 1e-12})
sea ultimo = r["y"][longitud(r["y"]) - 1]
cerca(ultimo[0], 1.0263447675738302, 1e-9, "Lotka-Volterra x (vs solve_ivp)")
cerca(ultimo[1], 0.9096910779906076, 1e-9, "Lotka-Volterra y")
afirmar(r["pasos"] > 50, "pasos adaptativos")
sea dec = cientifica_edo(funcion(t, v) { retornar 0 - 2 * v }, 0, 1, 3, {"puntos": [0.5, 1, 2, 3]})
eq_lista(dec["t"], [0.5, 1, 2, 3])
funcion eq_lista(a, b) { afirmar(("" + a) == ("" + b), "lista: " + a) }
cerca(dec["y"][1], exponencial(-2), 1e-6, "salida densa en t = 1")
cerca(dec["y"][3], exponencial(-6), 1e-6, "salida densa en t = 3")
sea osc = cientifica_rk4(funcion(t, v) { retornar [v[1], 0 - v[0]] }, 0, [1, 0], 3.141592653589793, 1000)
cerca(osc["y"][1000][0], -1, 1e-10, "RK4: oscilador medio período")
cerca(cientifica_rk4(funcion(t, v) { retornar v }, 0, 1, 1, 100)["y"][100], 2.718281828459045, 1e-9, "RK4 escalar")

// Raíces, mínimos e interpolación.
cerca(cientifica_raiz(funcion(x) { retornar coseno(x) - x }, 0, 1, nulo), 0.7390851332151607, 1e-14, "Brent: cos(x) = x")
cerca(cientifica_raiz(funcion(x) { retornar x * x * x - 2 * x - 5 }, 2, 3, nulo), 2.0945514815423265, 1e-14, "Brent: x³ − 2x − 5")
error = ""
intentar { cientifica_raiz(funcion(x) { retornar x * x + 1 }, -1, 1, nulo) } capturar (e) { error = "" + e }
afirmar(texto_contiene(error, "signos distintos"), "raíz sin cambio de signo")
sea mn = cientifica_minimo(funcion(x) { retornar (x - 2) * (x - 2) + 1 }, 0, 5, nulo)
cerca(mn["x"], 2, 1e-8, "mínimo")
cerca(mn["valor"], 1, 1e-14, "valor del mínimo")
cerca(cientifica_minimo(funcion(x) { retornar seno(x) }, 3, 6, nulo)["x"], 3 * 3.141592653589793 / 2, 1e-8, "mínimo del seno")
cerca(cientifica_interpolar([0, 1, 3], [0, 10, 30], 2), 20, 0, "interpolación lineal")
sea xs = []
sea ys = []
sea i = 0
mientras (i <= 20) {
    xs.agregar(i * 0.1 * 3.141592653589793)
    ys.agregar(seno(i * 0.1 * 3.141592653589793))
    i = i + 1
}
sea sp = cientifica_spline(xs, ys)
cerca(cientifica_spline_valor(sp, 1.0, nulo), seno(1.0), 1e-4, "spline cúbico")
cerca(cientifica_spline_valor(sp, 1.0, verdadero), coseno(1.0), 1e-3, "derivada del spline")
mostrar("[OK] cientifica")
