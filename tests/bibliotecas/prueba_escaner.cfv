// Pruebas de escaner. pagina.png es una página sintética con 8 renglones e
// iluminación despareja; rotada_±N.png es la misma girada con Pillow;
// esperado.json trae los umbrales de Sauvola de scikit-image (ventana 15,
// k 0.2, r 128).
importar "escaner"
importar "json"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

sea D = "tests/bibliotecas/datos/escaner/"
sea e = json_parsear(leer_archivo(D + "esperado.json"))
funcion cargar(n) { retornar vision_gris(vision_desde_imagen(imagen_cargar(D + n))) }
sea g = cargar("pagina.png")
sea t = escaner_sauvola_umbral(g, 15, 0.2, 128)
para i en lista_rango(0, longitud(t)) { afirmar(absoluto(t[i] - e["sauvola"][i]) < 1e-9, "umbral de Sauvola " + i) }
sea b = escaner_sauvola(g, 15, 0.2, 128)
sea bits = []
para v en b["datos"] { bits.agregar(si(v == 255, 1, 0)) }
eq(bits, e["binaria"], "binarización de Sauvola")
eq(escaner_renglones(b, 3), [[15, 21], [27, 33], [39, 45], [51, 57], [63, 69], [75, 81], [87, 93], [99, 105]], "renglones")
eq(escaner_caja_contenido(b), [12, 15, 138, 91], "caja del contenido")
eq(longitud(escaner_bloques(b, 25, 3)), 8, "un bloque por renglón")
sea rec = escaner_recortar_margenes(g, b, 2)
eq([rec["columnas"], rec["filas"]], [142, 95], "recortar márgenes")
para par en [["rotada_+3.png", 3], ["rotada_-2.png", -2], ["pagina.png", 0]] {
    sea r = escaner_inclinacion(escaner_sauvola(cargar(par[0]), 15, 0.2, 128), 7, 0.25)
    afirmar(absoluto(r["angulo"] - par[1]) <= 0.2 y r["confianza"] > 2, "inclinación de " + par[0] + ": " + r)
}
sea derecha = escaner_enderezar(cargar("rotada_+3.png"), 7)
sea resto = escaner_inclinacion(escaner_sauvola(derecha["imagen"], 15, 0.2, 128), 7, 0.25)
afirmar(absoluto(resto["angulo"]) <= 0.3, "enderezada: " + resto)
// Morfología binaria: abrir con 1 × 1 no cambia; cerrar une huecos chicos.
eq(escaner_abrir(b, 1, 1)["datos"] == b["datos"], verdadero, "apertura neutra")
sea puntos = {"filas": 1, "columnas": 7, "canales": 1, "datos": [0, 255, 0, 255, 255, 255, 0]}
eq(escaner_cerrar(puntos, 1, 3)["datos"], [0, 0, 0, 255, 255, 255, 0], "cierre horizontal")
eq(escaner_rotar(puntos, 0)["datos"], puntos["datos"], "rotar 0°")
mostrar("[OK] escaner")
