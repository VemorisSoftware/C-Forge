importar "flex"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion cajas(n) {
    sea r = []
    para h en n["hijos"] { r.agregar([redondear(h["caja"]["x"], 2), redondear(h["caja"]["y"], 2), redondear(h["caja"]["ancho"], 2), redondear(h["caja"]["alto"], 2)]) }
    retornar r
}
sea r = flex_nodo({"direccion": "fila", "espacio": 10, "relleno": 8}, [flex_nodo({"ancho": 100}), flex_nodo({"crecer": 1}), flex_nodo({"crecer": 2, "alto": 40, "alinear_propio": "centro"})])
flex_calcular(r, 500, 200)
igual(cajas(r), [[8, 8, 100, 184], [118, 8, 121.33, 184], [249.33, 80, 242.67, 40]], "fila con crecer, gap, relleno y estirar")
sea c = flex_nodo({"direction": "column", "justify": "space-between", "align": "center"}, [flex_nodo({"width": 50, "height": 20}), flex_nodo({"width": 80, "height": 20})])
flex_calcular(c, 200, 100)
igual(cajas(c), [[75, 0, 50, 20], [60, 80, 80, 20]], "columna, entre y centro (en inglés)")
para j en [["inicio", [[0, 0], [30, 0]]], ["fin", [[40, 0], [70, 0]]], ["centro", [[20, 0], [50, 0]]], ["alrededor", [[10, 0], [60, 0]]], ["uniforme", [[13.33, 0], [56.67, 0]]]] {
    sea n = flex_nodo({"direccion": "fila", "justificar": j[0], "alinear": "inicio"}, [flex_nodo({"ancho": 30, "alto": 10}), flex_nodo({"ancho": 30, "alto": 10})])
    flex_calcular(n, 100, 50)
    sea xy = []
    para k en cajas(n) { xy.agregar([k[0], k[1]]) }
    igual(xy, j[1], "justificar " + j[0])
}
sea w = flex_nodo({"direccion": "fila", "envolver": verdadero, "espacio": 5}, [flex_nodo({"ancho": 60, "alto": 10}), flex_nodo({"ancho": 60, "alto": 20}), flex_nodo({"ancho": 60, "alto": 10})])
flex_calcular(w, 130, 100)
igual(cajas(w), [[0, 0, 60, 10], [65, 0, 60, 20], [0, 25, 60, 10]], "envolver")
sea a = flex_nodo({}, [flex_nodo({"posicion": "absoluta", "derecha": 10, "abajo": 10, "ancho": 20, "alto": 20}), flex_nodo({"alto": 300})])
flex_calcular(a, 100, 100)
igual(cajas(a), [[70, 70, 20, 20], [0, 0, 100, 100]], "absoluta y encoger")
sea s = flex_nodo({"direccion": "fila"}, [flex_nodo({"ancho": 80, "encoger": 0}), flex_nodo({"ancho": 80})])
flex_calcular(s, 100, 10)
igual(cajas(s), [[0, 0, 80, 10], [80, 0, 20, 10]], "encoger 0 no se achica")
sea mx = flex_nodo({"direccion": "fila"}, [flex_nodo({"crecer": 1, "max_ancho": 30}), flex_nodo({"crecer": 1})])
flex_calcular(mx, 100, 10)
igual(cajas(mx)[0][2], 30, "max_ancho")
sea m = flex_nodo({"direccion": "fila", "alinear": "inicio"}, [flex_nodo({"ancho": 10, "alto": 10, "margen": [5, 0, 0, 7]})])
flex_calcular(m, 100, 100)
igual(cajas(m), [[7, 5, 10, 10]], "márgenes")
sea inv = flex_nodo({"direccion": "fila-inversa"}, [flex_nodo({"ancho": 10}), flex_nodo({"ancho": 20})])
flex_calcular(inv, 100, 10)
igual(cajas(inv), [[90, 0, 10, 10], [70, 0, 20, 10]], "fila inversa")
sea anidado = flex_nodo({"direccion": "columna", "relleno": 10}, [flex_nodo({"direccion": "fila", "alto": 50}, [flex_nodo({"crecer": 1}), flex_nodo({"ancho": 20})])])
flex_calcular(anidado, 200, 200)
igual(cajas(anidado["hijos"][0]), [[10, 10, 160, 50], [170, 10, 20, 50]], "anidado")
igual(longitud(flex_cajas(anidado)), 4, "cajas planas")
mostrar("[OK] flex")
