importar "clave"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Valores calculados con la librería bcrypt de Python y argon2-cffi.
sea b1 = "$2b$04$C6UzMDM.H6dfI/f/IKxGhu5jGGg8GiSxW4h6LfgyvpBFCRspLoW.."
igual([clave_verificar("Contraseña segura", b1), clave_verificar("Contraseña segurA", b1)], [verdadero, falso], "bcrypt")
sea b72 = "$2b$04$C6UzMDM.H6dfI/f/IKxGhujdAitT8MlmARL19ar/Fq4pVkBFfs4J6"
sea cien = ""
sea i = 0
mientras (i < 100) { cien = cien + "a"  i = i + 1 }
igual(clave_verificar(cien, b72), verdadero, "bcrypt trunca a 72 bytes")
sea nuevo = clave_bcrypt("hola", 4, nulo)
igual([longitud(nuevo), subcadena(nuevo, 0, 7), clave_verificar("hola", nuevo)], [60, "$2b$04$", verdadero], "bcrypt nuevo")
// RFC 7914, vector 1.
igual(hex_de_bytes(clave_scrypt("", "", 16, 1, 1, 64)), "77d6576238657b203b19ca42c18a0497f16b4844e3074ae8dfdffa3fede21442fcd0069ded0948f8326a753a0fc81f17e8d3e0fb2e0d3628cf35e20c38d18906", "scrypt RFC 7914")
sea s = clave_hash("x", {"algoritmo": "scrypt", "n": 16, "r": 1, "p": 1})
igual([clave_verificar("x", s), clave_verificar("y", s), clave_info(s)["n"]], [verdadero, falso, 16], "scrypt PHC")
igual(clave_verificar("pw", "$argon2id$v=19$m=64,t=2,p=1$c2FsdHNhbHRzYWx0c2FsdA$ZiKhRxbsh6piq+csIQRH7dInep3JHbqhNPCbCCL+LY0"), verdadero, "Argon2id de argon2-cffi")
sea a = clave_hash("pw", {"t": 1, "m": 64})
igual([clave_verificar("pw", a), clave_info(a)["m"], clave_rehacer(a), clave_rehacer(a, {"t": 1, "m": 64})], [verdadero, 64, verdadero, falso], "Argon2id")
sea p = clave_hash("pw", {"algoritmo": "pbkdf2_sha256", "iteraciones": 1000})
igual([clave_verificar("pw", p), clave_rehacer(p, {"algoritmo": "pbkdf2_sha256"})], [verdadero, verdadero], "PBKDF2")
igual(clave_verificar("pw", "basura"), falso, "formato inválido")
igual(clave_rehacer(b1, {"algoritmo": "argon2id"}), verdadero, "migrar de algoritmo")
igual(clave_fuerza("password123")["nivel"], 0, "contraseña común")
igual(clave_fuerza("Tr0ub4dor&3-caballo-bateria")["nivel"], 4, "contraseña fuerte")
mostrar("[OK] clave")
