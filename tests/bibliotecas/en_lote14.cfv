// Written in English.
import "password"
import "config"
import "cache"
import "graph"
import "navmesh"
import "tokenizers"
import "linalg"
import "quaternion"
function same(a, b, what) { assert(("" + a) == ("" + b), what + ": [" + a + "] != [" + b + "]") }
let h = bcrypt_hash("secret", 4, null)
same([password_verify("secret", h), password_verify("nope", h), password_info(h)["cost"]], [true, false, 4], "bcrypt")
let a = hash_password("pw", {"algorithm": "scrypt", "n": 16, "r": 1, "p": 1})
same([password_verify("pw", a), password_needs_rehash(a, {"algorithm": "scrypt"})], [true, true], "scrypt")
let t = toml_parse("[server]\nport = 8080\nhosts = [\"a\", \"b\"]\n")
same([t["server"]["port"], t["server"]["hosts"]], [8080, ["a", "b"]], "toml")
let y = yaml_parse("base: &b {x: 1}\nprod:\n  <<: *b\n  y: 2\n")
same([y["prod"]["x"], y["prod"]["y"]], [1, 2], "yaml")
same(toml_parse(toml_stringify(t))["server"]["port"], 8080, "toml round trip")
same(config_get(config_merge({"a": {"b": 1}}, {"a": {"c": 2}}), "a.c", 0), 2, "config")
let c = cache_new({"max": 2})
cache_put(c, "a", 1)
cache_put(c, "b", 2)
cache_get_if_present(c, "a")
cache_put(c, "c", 3)
same([cache_keys(c), cache_stats(c)["hits"]], [["a", "c"], 1], "cache")
let ms = multiset_new(["x", "y", "x"])
same(multiset_most_common(ms, 1), [["x", 2]], "multiset")
let g = graph_new(false)
graph_add_edge(g, "a", "b", 2)
graph_add_edge(g, "b", "c", 3)
graph_add_edge(g, "a", "c", 10)
let p = graph_dijkstra(g, "a", "c")
same([p["distance"], p["path"]], [5, ["a", "b", "c"]], "dijkstra")
same(graph_min_spanning_tree(g)["weight"], 5, "mst")
let grid = grid_new(["...", ".#.", "..."])
same(grid_astar(grid, [0, 0], [2, 2])["cost"], 4, "grid astar")
let mesh = navmesh_from_polygon([[0, 0], [10, 0], [10, 10], [7, 10], [7, 3], [3, 3], [3, 10], [0, 10]])
same(navmesh_find_path(mesh, [1, 9], [9, 9])["path"], [[1, 9], [3, 3], [7, 3], [9, 9]], "navmesh")
let tok = bpe_train(["low lower lowest", "new newer newest"], {"vocab_size": 270, "min_frequency": 1})
let enc = tokenizer_encode(tok, "lowest newer")
same(tokenizer_decode(tok, enc["ids"]), "lowest newer", "tokenizer")
same(length(enc["tokens"]) < 12, true, "bpe merges")
same(mat_solve([[2, 1], [1, 3]], [3, 5]), [0.8, 1.4], "solve")
same(mat_eigh([[2, 0], [0, 1]])["values"], [1, 2], "eigh")
let q = quat_from_axis_angle([0, 0, 1], 90, "degrees")
same(quat_allclose(quat_rotate(q, [1, 0, 0]), [0, 1, 0], 1e-9), true, "quaternion")
same(quat_allclose(quat_to_euler(q, "xyz", "degrees"), [0, 0, 90], 1e-9), true, "euler")
same(quat_allclose(mat4_decompose(mat4_trs([1, 2, 3], q, [1, 1, 1]))["translation"], [1, 2, 3], 1e-9), true, "mat4")
print("[OK] en_lote14")
