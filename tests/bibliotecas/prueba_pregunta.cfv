importar "pregunta"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
pregunta_simular(["", "Ana", "x", "s", "", "abc", "200", "42", "9", "pro", "", "1, 3,3", "rojo", "azul"])
igual(pregunta_texto("Nombre", {"requerido": verdadero}), "Ana", "requerido")
igual(pregunta_confirmar("¿Sigo?", falso), verdadero, "confirmar tras inválido")
igual(pregunta_confirmar("¿Otra?", falso), falso, "Enter = defecto")
igual(pregunta_numero("Edad", 0, 120), 42, "número en rango")
igual(pregunta_elegir("Plan", ["Básico", "Pro"]), 1, "elegir por texto")
igual(pregunta_elegir("Plan", ["Básico", "Pro"], 0), 0, "elegir con defecto")
igual(pregunta_varias("Extras", ["a", "b", "c"]), [0, 2], "varias sin repetir")
igual(pregunta_texto("Color", {"validar": funcion(t) { si (t == "rojo") { retornar "rojo no" }  retornar nulo }}), "azul", "validador")
sea s = pregunta_salida()
igual(s[0] + "|" + s[1], "Nombre |✗ Este dato es obligatorio.", "mensaje de obligatorio")
afirmar(texto_indice(unir(s, "\n"), "✗ Debe ser como máximo 120.") >= 0, "mensaje de máximo")
afirmar(texto_indice(unir(s, "\n"), "> 1) Básico") >= 0, "marca el defecto")
afirmar(texto_indice(unir(s, "\n"), "✗ rojo no") >= 0, "mensaje del validador")
pregunta_simular(["3"])
igual(pregunta_texto("x", {"defecto": "y"}), "3", "defecto no pisa respuesta")
sea m = ""
intentar { pregunta_texto("x") } capturar (e) { m = e }
igual(m, "pregunta: se acabaron las respuestas simuladas", "fin de la simulación")
pregunta_idioma("en")
pregunta_simular(["maybe", "y"])
igual(pregunta_confirmar("Go?"), verdadero, "inglés")
igual(pregunta_salida()[1], "✗ Answer y or n.", "mensaje en inglés")
pregunta_idioma("es")
mostrar("[OK] pregunta")
