importar "grafo_api"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea g = grafo_esquema("type Libro { id: ID! titulo: String! autor: Autor anio: Int }\ntype Autor { nombre: String! libros: [Libro!]! }\ninput Filtro { minimo: Int = 0 }\ntype Query { libros(filtro: Filtro): [Libro!]! libro(id: ID!): Libro }\ntype Mutation { crear(titulo: String!): Libro! }")
sea ana = {"nombre": "Ana"}
sea LIB = [{"id": "1", "titulo": "Rayuela", "anio": 1963, "autor": ana}, {"id": "2", "titulo": "Ficciones", "anio": 1944, "autor": nulo}]
ana["libros"] = [LIB[0]]
sea R = {"Query": {
    "libros": funcion(p, a, c, i) {
        sea m = 0
        si ((a["filtro"] ?? nulo) != nulo) { m = a["filtro"]["minimo"] }
        sea l = []
        para b en LIB { si (b["anio"] >= m) { l.agregar(b) } }
        retornar l
    },
    "libro": funcion(p, a, c, i) { para b en LIB { si (b["id"] == a["id"]) { retornar b } }  retornar nulo }
}, "Mutation": {"crear": funcion(p, a, c, i) { retornar {"id": "9", "titulo": a["titulo"]} }}}
igual(grafo_json(g, R, "{ libros { titulo autor { nombre } } }", nulo, nulo, nulo), "{\"data\":{\"libros\":[{\"titulo\":\"Rayuela\",\"autor\":{\"nombre\":\"Ana\"}},{\"titulo\":\"Ficciones\",\"autor\":null}]}}", "consulta anidada")
igual(grafo_json(g, R, "query Q($m: Int) { libros(filtro: {minimo: $m}) { ...F } } fragment F on Libro { id }", {"m": 1950}, nulo, nulo), "{\"data\":{\"libros\":[{\"id\":\"1\"}]}}", "variables y fragmentos")
igual(grafo_json(g, R, "query($s: Boolean!) { libro(id: \"1\") { titulo anio @skip(if: $s) } }", {"s": verdadero}, nulo, nulo), "{\"data\":{\"libro\":{\"titulo\":\"Rayuela\"}}}", "@skip")
igual(grafo_json(g, R, "mutation { crear(titulo: \"Nuevo\") { id titulo } }", nulo, nulo, nulo), "{\"data\":{\"crear\":{\"id\":\"9\",\"titulo\":\"Nuevo\"}}}", "mutación")
sea err = grafo_ejecutar(g, R, "{ libro { titulo } }", nulo, nulo, nulo)
afirmar(longitud(err["errores"] ?? err["errors"]) > 0, "falta argumento obligatorio")
igual(grafo_json(g, R, "{ __type(name: \"Autor\") { name kind } }", nulo, nulo, nulo), "{\"data\":{\"__type\":{\"name\":\"Autor\",\"kind\":\"OBJECT\"}}}", "introspección")
mostrar("[OK] grafo_api")
