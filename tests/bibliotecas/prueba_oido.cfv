// Pruebas de oido. datos/oido/mini.bin es un Whisper diminuto en el formato
// ggml de whisper.cpp (pesos al azar, vocabulario multilingüe de 51865,
// F32 y F16); esperado.json sale de una implementación de referencia en
// NumPy de la arquitectura de Whisper y de su espectrograma log-mel.
importar "oido"
importar "json"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

sea e = json_parsear(leer_archivo("tests/bibliotecas/datos/oido/esperado.json"))
sea m = oido_cargar("tests/bibliotecas/datos/oido/mini.bin")
sea info = oido_info(m)
eq([info["n_vocab"], info["n_mels"], info["n_audio_ctx"], info["multilingue"], info["eot"], info["sot"]], [51865, 80, 50, verdadero, 50257, 50258], "info")

// Filtros de Slaney propios contra los del modelo.
sea fil = oido_filtros_mel(80)
sea mx = 0
para i en lista_rango(0, 80) {
    para j en lista_rango(0, 201) { mx = maximo(mx, absoluto(fil[i][j] - m["filtros"][i][j])) }
}
afirmar(mx < 1e-7, "filtros mel " + mx)

sea a = oido_audio_wav(leer_archivo("tests/bibliotecas/datos/oido/tono.wav"))
eq(longitud(a), 12800, "muestras")
sea mel = oido_mel(a, m["filtros"], nulo)
eq([longitud(mel), longitud(mel[0])], [80, 3000], "forma del mel")
para s en e["mel_muestras"] {
    si (s[1] < 3000) { afirmar(absoluto(mel[s[0]][s[1]] - s[2]) < 1e-12, "mel " + s[0] + "," + s[1]) }
}

sea cod = oido_codificar(m, mel)
eq(longitud(cod), 50, "posiciones del codificador")
sea idx = [0, 7, 49]
para i en lista_rango(0, 3) {
    para c en lista_rango(0, 8) { afirmar(absoluto(cod[idx[i]][c] - e["encoder"][i][c]) < 1e-10, "codificador") }
}
sea lg = oido_decodificar(m, oido_estado(m, cod), m["sot"])
sea ids = [0, 100, 50257, 50259, 50262]
para i en lista_rango(0, 5) { afirmar(absoluto(lg[ids[i]] - e["logits_sot"][i]) < 1e-10, "logits " + ids[i]) }

sea d = oido_detectar_idioma(m, a)
eq(d["idioma"], oido_idiomas()[e["idioma"]], "idioma detectado")
sea suma = 0.0
para k en claves(d["probabilidades"]) { suma = suma + d["probabilidades"][k] }
afirmar(absoluto(suma - 1) < 1e-12, "probabilidades")

sea r = oido_transcribir(m, a, {"idioma": "es", "max_tokens": 10})
eq(r["tokens"], e["tokens"], "voraz")
sea t = oido_transcribir(m, a, {"idioma": "es", "max_tokens": 8, "temperatura": 1.0, "semilla": 42})
eq(t["tokens"], e["tokens_temp"], "con temperatura")
eq(oido_texto(m, [256, 257, 50257]), "hola mundo", "texto")
sea error = ""
intentar { oido_transcribir(m, a, {"idioma": "xx"}) } capturar (x) { error = x }
afirmar(texto_contiene(error, "idioma desconocido"), "idioma desconocido")
mostrar("[OK] oido")
