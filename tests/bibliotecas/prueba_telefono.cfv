importar "telefono"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion e(t, p) { retornar telefono_analizar(t, p)["e164"] }
igual([e("9 1234 5678", "CL"), e("+56 9 1234 5678"), e("56912345678", "cl"), e("0056912345678"), e("(2) 2345 6789", "CL")], ["+56912345678", "+56912345678", "+56912345678", "+56912345678", "+56223456789"], "Chile")
igual(telefono_analizar("9 1234 5678", "CL")["tipo"], "movil", "móvil")
igual(telefono_analizar("2 2345 6789", "CL")["tipo"], "fijo", "fijo")
igual(telefono_formatear(telefono_analizar("912345678", "CL")), "+56 9 1234 5678", "formato internacional")
igual(telefono_formatear(telefono_analizar("912345678", "CL"), verdadero), "9 1234 5678", "formato nacional")
igual([e("612 345 678", "ES"), e("+1 202-555-0143"), e("300 123 4567", "CO"), e("55 1234 5678", "MX"), e("987 654 321", "PE"), e("+54 9 11 2345 6789")], ["+34612345678", "+12025550143", "+573001234567", "+525512345678", "+51987654321", "+5491123456789"], "otros países")
igual([telefono_valido("123", "CL"), telefono_valido("+999 123", nulo), telefono_valido("12345678", "CL"), telefono_valido("1234567890", "US"), telefono_valido("912345678")], [falso, falso, falso, falso, falso], "inválidos")
igual(telefono_analizar("912345678")["error"], "falta el país", "sin país")
igual(telefono_enlace(telefono_analizar("9 1234 5678", "CL"), "whatsapp"), "https://wa.me/56912345678", "WhatsApp")
igual(telefono_enlace(telefono_analizar("9 1234 5678", "CL")), "tel:+56912345678", "tel")
sea m = ""
intentar { telefono_analizar("1", "ZZ") } capturar (x) { m = x }
igual(m, "telefono: país no soportado ZZ", "país no soportado")
mostrar("[OK] telefono")
