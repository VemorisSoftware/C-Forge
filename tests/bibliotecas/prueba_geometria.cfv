importar "geometria"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion cerca(a, b, tol, q) { afirmar(absoluto(a - b) < tol, q + ": " + a + " != " + b) }
// París → Londres ≈ 343.5 km (referencia de Movable Type).
cerca(geometria_distancia([48.8566, 2.3522], [51.5074, -0.1278]), 343.56, 0.5, "haversine")
cerca(geometria_distancia([0, 0], [0, 180]), 20015.1, 1, "medio meridiano")
cerca(geometria_rumbo([0, 0], [1, 0]), 0, 0.000001, "norte")
cerca(geometria_rumbo([0, 0], [0, 1]), 90, 0.000001, "este")
sea dest = geometria_destino([-33.4489, -70.6693], 100, 45)
cerca(geometria_distancia([-33.4489, -70.6693], dest), 100, 0.001, "destino a 100 km")
cerca(geometria_rumbo([-33.4489, -70.6693], dest), 45, 0.01, "rumbo al destino")
sea mid = geometria_punto_medio([0, 0], [0, 10])
cerca(mid[1], 5, 0.000001, "punto medio")
sea cuadro = [[0, 0], [4, 0], [4, 4], [0, 4]]
igual([geometria_dentro([2, 2], cuadro), geometria_dentro([5, 2], cuadro), geometria_dentro([4, 2], cuadro), geometria_dentro([0, 0], cuadro)], [verdadero, falso, verdadero, verdadero], "punto en polígono (bordes dentro)")
sea u = [[0, 0], [6, 0], [6, 6], [4, 6], [4, 2], [2, 2], [2, 6], [0, 6]]
igual([geometria_dentro([3, 4], u), geometria_dentro([1, 4], u)], [falso, verdadero], "polígono cóncavo")
igual([geometria_area(cuadro), geometria_centroide(cuadro), geometria_area(u)], [16, [2, 2], 28], "área y centroide")
cerca(geometria_area_geo([[0, 0], [0, 1], [1, 1], [1, 0]]) / 1000000, 12364, 60, "1° × 1° en el ecuador ≈ 12 364 km²")
igual(geometria_caja([[1, 5], [-2, 3], [4, 0]]), [-2, 0, 4, 5], "caja")
igual(geometria_largo([[0, 0], [3, 4], [3, 10]]), 11, "largo plano")
igual(geometria_simplificar([[0, 0], [1, 0.1], [2, -0.1], [3, 5], [4, 6], [5, 7], [6, 8.1], [7, 9], [8, 9], [9, 9]], 1), [[0, 0], [2, -0.1], [3, 5], [7, 9], [9, 9]], "Douglas–Peucker")
igual(geometria_envolvente([[0, 0], [1, 1], [2, 2], [2, 0], [2, 4], [3, 3], [0, 4], [1, 2]]), [[0, 0], [2, 0], [3, 3], [2, 4], [0, 4]], "envolvente convexa")
cerca(geometria_distancia_linea([2, 3], [[0, 0], [4, 0]]), 3, 0.0000001, "distancia a línea")
sea gj = geometria_geojson("poligono", [[-33, -70], [-33, -71], [-34, -71]], {"zona": "x"})
igual(gj["geometry"]["coordinates"][0], [[-70, -33], [-71, -33], [-71, -34], [-70, -33]], "GeoJSON lon/lat y anillo cerrado")
mostrar("[OK] geometria")
