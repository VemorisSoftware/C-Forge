// Pruebas de teclado. Con X11 (DISPLAY puesto) mueve el ratón de verdad;
// el envío de teclas y clics se comprobó aparte con Xvfb y una ventana que
// registra los eventos (texto "Hola, mundo! ñ€", botones y rueda).
importar "teclado"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
eq([teclado_nombre_tecla("enter"), teclado_nombre_tecla("Ctrl"), teclado_nombre_tecla("f5"), teclado_nombre_tecla("a"), teclado_nombre_tecla("avpag")],
    ["Return", "Control_L", "F5", "a", "Next"], "nombres")
eq(_tc_codigos("añ€😀"), [97, 241, 8364, 128512], "UTF-8")
sea d = variable_entorno("DISPLAY")
si (d != nulo y d != "" y existe_archivo("/proc/meminfo")) {
    sea t = nulo
    intentar { t = teclado_nuevo(nulo) } capturar (e) { t = nulo }
    si (t != nulo) {
        sea p = teclado_pantalla(t)
        afirmar(p[0] > 0 y p[1] > 0, "pantalla")
        teclado_mover(t, 20, 30)
        eq(teclado_posicion(t), [20, 30], "mover")
        teclado_mover_relativo(t, 5, 5)
        eq(teclado_posicion(t), [25, 35], "relativo")
        teclado_pulsar(t, "shift")
        eq(claves(t["abiertas"]), ["shift"], "tecla abajo")
        teclado_cerrar(t)
        eq(claves(t["abiertas"]), [], "cerrar suelta todo")
    }
}
mostrar("[OK] teclado")
