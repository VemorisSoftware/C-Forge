importar "documento"
importar "imagen"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Anchos según las métricas AFM de Adobe Core14.
igual([documento_ancho("Hola", "Helvetica", 10), documento_ancho("Hola", "Courier", 10), documento_ancho("WWW", "Times-Bold", 12)], [20.56, 24, 36], "anchos")
sea d = documento_nuevo({"tamano": "A4", "titulo": "Informe ñandú", "autor": "Vemoris"})
documento_pagina(d)
documento_texto(d, 72, 72, "Hola, Ñuñoa — “comillas” €100", {"fuente": "Helvetica-Bold", "tamano": 18})
documento_texto(d, 72, 110, "Segunda línea", {"fuente": "Times", "cursiva": verdadero, "color": "#336699"})
documento_texto(d, 297.64, 140, "Centrado (con paréntesis) y \\ barra", {"alinear": "centro", "subrayado": verdadero})
documento_linea(d, 72, 170, 523, 170, {"grosor": 0.5, "guiones": [3, 2]})
documento_rect(d, 72, 190, 200, 60, {"relleno": "#eeeeff", "borde": "#3333aa", "radio": 8})
documento_circulo(d, 400, 220, 30, {"relleno": "#ffcc00"})
documento_enlace(d, 72, 190, 200, 60, "https://c-forge.org")
documento_imagen(d, imagen_codificar_png(imagen_nueva(4, 3, [255, 0, 0, 128])), 72, 270, 80)
documento_pagina(d, "carta")
documento_texto(d, 72, 72, "Página dos", {"fuente": "Courier"})
igual([documento_paginas(d), documento_ancho_pagina(d), documento_alto(d)], [2, 612, 792], "páginas")
sea b = documento_bytes(d)
afirmar(texto_empieza_con(b, "%PDF-1."), "cabecera PDF")
sea l = documento_leer(b)
igual([l["paginas"], l["titulo"], l["autor"]], [2, "Informe ñandú", "Vemoris"], "metadatos")
igual(l["texto"][0], "Hola, Ñuñoa — “comillas” €100\nSegunda línea\nCentrado (con paréntesis) y \\ barra", "texto extraído")
igual(l["texto"][1], "Página dos", "segunda página")
sea sin = documento_nuevo({"comprimir": falso})
documento_pagina(sin)
documento_texto(sin, 10, 10, "abc")
afirmar(texto_indice(documento_bytes(sin), "(abc) Tj") > 0, "sin comprimir")
mostrar("[OK] documento")
