// Written in English.
import "stats"
import "autograd"
import "trees"
import "hybrid"
import "serde"
import "bio"
import "logging"
import "dataframe"
import "pivot"
function same(a, b, what) { assert(("" + a) == ("" + b), what + ": [" + a + "] != [" + b + "]") }
let w = stats_ttest_ind([5.1, 4.9, 5.6, 5.8, 6.0, 5.4, 5.2], [6.2, 6.4, 5.9, 6.8, 6.1, 6.6])
assert(abs(w["t"] + 4.485326) < 0.00001 and abs(w["df"] - 10.999931) < 0.00001, "stats_ttest_ind")
same(round(stats_normal_ppf(0.975), 4), 1.96, "stats_normal_ppf")
same(stats_f_oneway([[1, 2, 3], [2, 3, 4], [5, 6, 7]])["df_between"], 2, "stats_f_oneway")
let x = autograd_value(3)
let y = autograd_mul(x, x)
autograd_backward(y)
same([autograd_data(y), autograd_grad(x)], [9, 6], "autograd")
let X = [[1, 1], [1.2, 0.8], [5, 5], [5.2, 4.9]]
let tree = trees_decision_tree(X, ["a", "a", "b", "b"], {"max_depth": 3})
same(trees_predict(tree, [[1, 0.9], [5, 5.1]]), ["a", "b"], "trees")
same(trees_predict(trees_random_forest(X, ["a", "a", "b", "b"], {"n_estimators": 9, "seed": 1}), [[5, 5]]), ["b"], "random forest")
let h = hybrid_new(2, {"fields": {"text": 1}})
hybrid_add(h, "x", {"text": "red apple"}, [1, 0], {})
hybrid_add(h, "z", {"text": "blue sky"}, [0, 1], {})
let hits = hybrid_search(h, "apple", [1, 0], {"k": 2, "alpha": 0.5, "mode": "weighted"})
same([hits[0]["id"], hits[0]["source"]], ["x", "both"], "hybrid")
let User = serde_struct({"user_name": "string", "age": serde_default("int", 0)}, {"rename": "camel"})
same(serde_to_json(User, serde_from_json(User, "{\"userName\": \"ana\"}")), "{\"age\":0,\"userName\":\"ana\"}", "serde")
same(serde_validate(User, {"user_name": 3})["ok"], false, "serde_validate")
same(bio_translate("ATGGCCTGA"), "MA*", "bio_translate")
same(bio_read_fasta(">s1 one\nACGT\n")[0]["sequence"], "ACGT", "bio_read_fasta")
same(bio_align("GATTACA", "GCATGCU", {"match": 1, "mismatch": -1, "gap": -1})["score"], 0, "bio_align")
same(bio_write_fasta_en([{"id": "s", "sequence": "AC"}]), ">s\nAC\n", "bio_write_fasta_en")
let mem = logging_memory(5, {"pattern": "%nivel %nombre %mensaje"})
logging_configure({"level": "warn", "sinks": [mem]})
let log = logging_get_logger("api")
logging_info(log, "hidden")
logging_warn(log, "shown")
same(logging_lines(mem), ["aviso api shown"], "logging")
logging_reset()
let t = df_from_records([{"k": "a", "m": "x", "v": 1}, {"k": "a", "m": "y", "v": 2}, {"k": "b", "m": "x", "v": 3}])
same(df_rows(pivot_table(t, "k", "m", "v", "sum", 0)), [{"k": "a", "x": 1, "y": 2}, {"k": "b", "x": 3, "y": 0}], "pivot_table")
same(df_column(pivot_rolling(t, "v", 2, "sum", "s"), "s"), [null, 3, 5], "pivot_rolling")
print("[OK] lote 10 in English")
