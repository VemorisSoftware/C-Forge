importar "mensaje_bancario"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea m = mensaje_bancario_armar("0200", {"2": "4111111111111111", "3": "000000", "4": 12990, "11": "123", "41": "TERM01", "49": "152"})
igual(m, "0200" + "7020000000808000" + "164111111111111111" + "000000" + "000000012990" + "000123" + "TERM01  " + "152", "armado (mapa primario)")
sea r = mensaje_bancario_leer(m)
igual([r["mti"], r["campos"]["2"], r["campos"]["4"], r["campos"]["11"], r["campos"]["41"]], ["0200", "4111111111111111", "000000012990", "000123", "TERM01"], "lectura")
sea s = mensaje_bancario_armar("0800", {"7": "1121103000", "11": "1", "70": "301"})
afirmar(subcadena(s, 4, 5) == "8", "mapa secundario: bit 1 encendido")
igual(mensaje_bancario_leer(s)["campos"]["70"], "301", "campo 70")
sea t = mensaje_bancario_texto(r)
afirmar(texto_indice(t, "411111******1111") >= 0 y texto_indice(t, "4111111111111111") < 0, "PAN enmascarado")
sea rta = mensaje_bancario_leer(mensaje_bancario_armar("0210", {"11": "123", "38": "A1B2C3", "39": "51"}))
afirmar(texto_indice(mensaje_bancario_texto(rta), "fondos insuficientes") >= 0, "código de respuesta")
igual([mensaje_bancario_respuesta_mti("0200"), mensaje_bancario_respuesta_mti("0800"), mensaje_bancario_enmascarar("5500000000000004")], ["0210", "0810", "550000******0004"], "utilidades")
igual([mensaje_bancario_luhn("4111111111111111"), mensaje_bancario_luhn("4111111111111112"), mensaje_bancario_luhn("79927398713"), mensaje_bancario_luhn("abc")], [verdadero, falso, falso, falso], "Luhn")
mensaje_bancario_definir({"62": ["ans", "lll", 999, "Privado del emisor"]})
igual(mensaje_bancario_leer(mensaje_bancario_armar("0100", {"62": "xyz"}))["campos"]["62"], "xyz", "campo definido por el usuario")
para caso en [
    [funcion() { mensaje_bancario_armar("0200", {"4": "12a"}) }, "mensaje_bancario: el campo 4 solo admite dígitos"],
    [funcion() { mensaje_bancario_armar("0200", {"41": "DEMASIADO_LARGO"}) }, "mensaje_bancario: el campo 41 mide 8"],
    [funcion() { mensaje_bancario_armar("0200", {"2": texto_repetir("1", 20)}) }, "mensaje_bancario: el campo 2 admite hasta 19 caracteres"],
    [funcion() { mensaje_bancario_armar("0200", {"99": "1"}) }, "mensaje_bancario: el campo 99 no está definido (usa mensaje_bancario_definir)"],
    [funcion() { mensaje_bancario_leer(subcadena(m, 0, longitud(m) - 2)) }, "mensaje_bancario: mensaje truncado en el campo 49"],
    [funcion() { mensaje_bancario_leer(m + "X") }, "mensaje_bancario: sobran 1 caracteres"],
    [funcion() { mensaje_bancario_leer("0200" + "4000000000000000" + "99" + "1234") }, "mensaje_bancario: el campo 2 declara 99 (máximo 19)"]
] {
    sea mm = ""
    intentar { caso[0]() } capturar (e) { mm = e }
    igual(mm, caso[1], caso[1])
}
mostrar("[OK] mensaje_bancario")
