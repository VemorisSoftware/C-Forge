importar "carga3d"
importar "base64"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion r4(x) { retornar redondear(x * 10000) / 10000 }
// GLB exportado por trimesh: caja trasladada y cilindro rotado y escalado.
// Los valores esperados (vértices, límites, área y volumen) son de trimesh.
sea GLB = base64_decodificar("")
sea m = carga3d_gltf(GLB, nulo)
igual([longitud(m["mallas"]), longitud(m["nodos"]), m["generador"]], [2, 2, "https://github.com/mikedh/trimesh"], "estructura")
sea a = carga3d_aplanar(m, nulo)
sea p = a["posiciones"]
sea mn = [1e9, 1e9, 1e9]
sea mx = [-1e9, -1e9, -1e9]
sea k = 0
mientras (k < longitud(p)) {
    sea j = 0
    mientras (j < 3) {
        mn[j] = minimo(mn[j], p[k + j])
        mx[j] = maximo(mx[j], p[k + j])
        j = j + 1
    }
    k = k + 3
}
funcion medidas(pp, ind) {
    sea area = 0
    sea vol = 0
    sea i = 0
    mientras (i < longitud(ind)) {
        sea A = [pp[ind[i] * 3], pp[ind[i] * 3 + 1], pp[ind[i] * 3 + 2]]
        sea B = [pp[ind[i + 1] * 3], pp[ind[i + 1] * 3 + 1], pp[ind[i + 1] * 3 + 2]]
        sea C = [pp[ind[i + 2] * 3], pp[ind[i + 2] * 3 + 1], pp[ind[i + 2] * 3 + 2]]
        sea u = [B[0] - A[0], B[1] - A[1], B[2] - A[2]]
        sea v = [C[0] - A[0], C[1] - A[1], C[2] - A[2]]
        sea cr = [u[1] * v[2] - u[2] * v[1], u[2] * v[0] - u[0] * v[2], u[0] * v[1] - u[1] * v[0]]
        area = area + raiz(cr[0] * cr[0] + cr[1] * cr[1] + cr[2] * cr[2]) / 2
        vol = vol + (A[0] * (B[1] * C[2] - B[2] * C[1]) - A[1] * (B[0] * C[2] - B[2] * C[0]) + A[2] * (B[0] * C[1] - B[1] * C[0])) / 6
        i = i + 3
    }
    retornar [r4(area), r4(vol)]
}
igual([longitud(p) / 3, longitud(a["indices"]) / 3], [26, 44], "vértices y caras")
igual([r4(mn[0]), mn[1], r4(mn[2]), mx], [-2.0533, -1, -4.1739, [5.5, 2, 1.5]], "límites del mundo")
igual(medidas(p, a["indices"]), [52.1486, 17.3137], "área y volumen")
// glTF con datos base64, tira de triángulos, colores normalizados, accesor
// disperso, escala negativa (espejo), material y animación.
sea t = carga3d_gltf("{\"asset\": {\"version\": \"2.0\"}, \"scene\": 0, \"scenes\": [{\"nodes\": [0]}], \"nodes\": [{\"name\": \"padre\", \"translation\": [0, 0, 5], \"children\": [1]}, {\"name\": \"hijo\", \"mesh\": 0, \"scale\": [1, -1, 1]}], \"meshes\": [{\"name\": \"tira\", \"primitives\": [{\"attributes\": {\"POSITION\": 0, \"COLOR_0\": 1}, \"mode\": 5, \"material\": 0}]}], \"materials\": [{\"name\": \"rojo\", \"pbrMetallicRoughness\": {\"baseColorFactor\": [1, 0, 0, 1], \"metallicFactor\": 0.5}, \"doubleSided\": true}], \"buffers\": [{\"byteLength\": 112, \"uri\": \"data:application/octet-stream;base64,AAAAAAAAAAAAAAAAAACAPwAAAAAAAAAAAAAAAAAAgD8AAAAAAACAPwAAgD8AAAAA/wAA/wD/AP8AAP//////AAMAAAAAAABAAAAAQAAAAAAAAAAAAACAPwAAAAAAAAAAAAAAAAAAIEEAAAAAAAAAAA==\"}], \"bufferViews\": [{\"buffer\": 0, \"byteOffset\": 0, \"byteLength\": 48}, {\"buffer\": 0, \"byteOffset\": 48, \"byteLength\": 16}, {\"buffer\": 0, \"byteOffset\": 64, \"byteLength\": 2}, {\"buffer\": 0, \"byteOffset\": 68, \"byteLength\": 12}, {\"buffer\": 0, \"byteOffset\": 80, \"byteLength\": 8}, {\"buffer\": 0, \"byteOffset\": 88, \"byteLength\": 24}], \"accessors\": [{\"bufferView\": 0, \"componentType\": 5126, \"count\": 4, \"type\": \"VEC3\", \"min\": [0, 0, 0], \"max\": [2, 2, 0], \"sparse\": {\"count\": 1, \"indices\": {\"bufferView\": 2, \"componentType\": 5123}, \"values\": {\"bufferView\": 3}}}, {\"bufferView\": 1, \"componentType\": 5121, \"normalized\": true, \"count\": 4, \"type\": \"VEC4\"}, {\"bufferView\": 4, \"componentType\": 5126, \"count\": 2, \"type\": \"SCALAR\", \"min\": [0], \"max\": [1]}, {\"bufferView\": 5, \"componentType\": 5126, \"count\": 2, \"type\": \"VEC3\"}], \"animations\": [{\"name\": \"mover\", \"samplers\": [{\"input\": 2, \"output\": 3}], \"channels\": [{\"sampler\": 0, \"target\": {\"node\": 0, \"path\": \"translation\"}}]}]}", nulo)
sea pr = t["mallas"][0]["primitivas"][0]
igual([pr["modo"], pr["malla"]["indices"], longitud(pr["malla"]["posiciones"])], [5, [0, 1, 2, 2, 1, 3], 12], "tira")
igual([pr["malla"]["posiciones"][9], pr["malla"]["posiciones"][10]], [2, 2], "disperso")
igual([pr["atributos"]["COLOR_0"][1], pr["atributos"]["COLOR_0"][3][3]], [[0, 1, 0, 1], 0], "normalizado")
igual([t["materiales"][0]["nombre"], t["materiales"][0]["metalico"], t["materiales"][0]["rugosidad"], t["materiales"][0]["doble_cara"]], ["rojo", 0.5, 1, verdadero], "material")
sea ta = carga3d_aplanar(t, nulo)
igual([ta["posiciones"][3], ta["posiciones"][4], ta["posiciones"][5], ta["posiciones"][10]], [1, 0, 5, -2], "transformación jerárquica")
igual([ta["indices"][1], ta["indices"][2]], [2, 1], "espejo invierte el orden")
igual(medidas(ta["posiciones"], ta["indices"])[0], 2, "área de la tira")
igual(carga3d_muestrear(t, 0, 0, 0.25), [2.5, 0, 0], "animación lineal")
igual(carga3d_muestrear(t, 0, 0, 5), [10, 0, 0], "animación después del final")
// Exportar a GLB y volver a leer (el validador oficial de Khronos da 0 errores).
sea g = carga3d_glb([{"malla": a, "nombre": "todo", "material": {"color_base": [1, 0, 0, 1]}}, {"malla": malla_cubo(1), "nombre": "cubo", "traslacion": [0, 10, 0]}], nulo)
igual(subcadena(g, 0, 4), "glTF", "cabecera glb")
sea v = carga3d_gltf(g, nulo)
sea va = carga3d_aplanar(v, nulo)
igual([longitud(va["indices"]) / 3, v["materiales"][0]["color_base"], v["nodos"][1]["mundo"][13]], [56, [1, 0, 0, 1], 10], "ida y vuelta")
igual(medidas(v["mallas"][0]["primitivas"][0]["malla"]["posiciones"], v["mallas"][0]["primitivas"][0]["malla"]["indices"]), [52.1486, 17.3137], "medidas tras exportar")
// Matriz TRS: rotación de 90° en Z.
sea mz = carga3d_matriz_nodo({"rotation": [0, 0, 0.7071067811865476, 0.7071067811865476], "translation": [1, 2, 3]})
igual([r4(mz[0]), r4(mz[1]), r4(mz[4]), mz[12], mz[14]], [0, 1, -1, 1, 3], "TRS")
mostrar("[OK] carga3d")
