importar "molde"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea Item = molde_registro({"sku": "texto", "cantidad": "entero"})
sea Pago = molde_union("tipo", {"tarjeta": {"ultimos4": "texto"}, "transferencia": {"banco": "texto"}})
sea Pedido = molde_registro({"id": "entero", "cliente_nombre": "texto", "items": molde_lista(Item), "nota": molde_opcional("texto"), "estado": molde_defecto(molde_enum(["nuevo", "pagado"]), "nuevo"), "pago": molde_opcional(Pago), "interno": molde_campo("texto", {"omitir": verdadero})}, {"renombrar": "camel"})
sea j = "{\"id\": 1, \"clienteNombre\": \"Ana\", \"items\": [{\"sku\": \"A1\", \"cantidad\": 2}], \"pago\": {\"tipo\": \"tarjeta\", \"ultimos4\": \"4242\"}}"
sea p = molde_desde_json(Pedido, j)
igual([p["cliente_nombre"], p["estado"], p["nota"], p["items"][0]["cantidad"], p["pago"]["ultimos4"]], ["Ana", "nuevo", nulo, 2, "4242"], "desde JSON con renombre y defecto")
igual(molde_a_json(Pedido, p), "{\"clienteNombre\":\"Ana\",\"estado\":\"nuevo\",\"id\":1,\"items\":[{\"cantidad\":2,\"sku\":\"A1\"}],\"nota\":null,\"pago\":{\"tipo\":\"tarjeta\",\"ultimos4\":\"4242\"}}", "a JSON omite el campo interno")
igual(molde_validar(Pedido, {"id": 1, "cliente_nombre": "x", "items": [{"sku": "a", "cantidad": 1.5}]}), {"error": "molde: items[0].cantidad: se esperaba entero", "ok": falso}, "error con ruta")
igual(molde_validar(Pedido, {"id": 1, "cliente_nombre": "x", "items": [], "estado": "borrado"})["error"], "molde: estado: valor no permitido borrado", "enum")
igual([molde_renombrar("cliente_nombre", "pascal"), molde_renombrar("clienteNombre", "kebab"), molde_renombrar("HTTPCode", "snake"), molde_renombrar("mi campo", "mayusculas")], ["ClienteNombre", "cliente-nombre", "http_code", "MI_CAMPO"], "estilos de nombre")
sea Fila = molde_registro({"nombre": "texto", "edad": "entero", "activo": "booleano", "tags": molde_lista("texto")})
sea csv = molde_a_csv(Fila, [{"nombre": "Ana, la jefa", "edad": 30, "activo": verdadero, "tags": ["a", "b"]}, {"nombre": "Luis \"L\"", "edad": 25, "activo": falso, "tags": []}])
igual(csv, "activo,edad,nombre,tags\ntrue,30,\"Ana, la jefa\",\"[\"\"a\"\",\"\"b\"\"]\"\nfalse,25,\"Luis \"\"L\"\"\",[]\n", "a CSV")
sea vuelta = molde_desde_csv(Fila, csv)
igual([vuelta[0]["nombre"], vuelta[0]["edad"], vuelta[0]["activo"], vuelta[0]["tags"], vuelta[1]["nombre"]], ["Ana, la jefa", 30, verdadero, ["a", "b"], "Luis \"L\""], "desde CSV")
sea m = ""
intentar { molde_desde_csv(Fila, "nombre,edad,activo,tags\nAna,treinta,si,[]\n") } capturar (e) { m = e }
igual(m, "molde: fila 2.edad: se esperaba número, llegó \"treinta\"", "CSV con número inválido")
sea Q = molde_registro({"q": "texto", "pagina": molde_defecto("entero", 1), "filtro": molde_lista("texto")})
sea qs = molde_a_query(Q, {"q": "año nuevo & más", "pagina": 2, "filtro": ["a", "b"]})
igual(qs, "filtro=a&filtro=b&pagina=2&q=a%C3%B1o%20nuevo%20%26%20m%C3%A1s", "a query string")
igual(molde_desde_query(Q, "?" + qs), {"filtro": ["a", "b"], "pagina": 2, "q": "año nuevo & más"}, "desde query string")
igual(molde_desde_query(Q, "q=x+y"), {"filtro": [], "pagina": 1, "q": "x y"}, "query con defectos")
igual(molde_desde_binario(Item, molde_a_binario(Item, {"sku": "Z", "cantidad": 9})), {"cantidad": 9, "sku": "Z"}, "binario ida y vuelta")
sea V2 = molde_registro({"nombre_completo": "texto", "version": "entero"})
igual(molde_migrar(V2, {"nombre": "Ana", "apellido": "Pérez"}, [funcion(d) { retornar {"nombre_completo": d["nombre"] + " " + d["apellido"]} }]), {"nombre_completo": "Ana Pérez", "version": 2}, "migración de versión")
intentar { molde_desde_dato(molde_registro({"a": "entero"}, {"estricto": verdadero}), {"a": 1, "b": 2}) } capturar (e) { m = e }
igual(m, "molde: b: campo desconocido", "estricto")
sea Al = molde_registro({"correo": molde_campo("texto", {"alias": ["email", "mail"]})})
igual(molde_desde_dato(Al, {"mail": "a@b.c"}), {"correo": "a@b.c"}, "alias de campo")
sea Fecha = molde_propio("fecha", funcion(v) { retornar v["d"] + "/" + v["m"] }, funcion(t) {
    sea p = texto_dividir(t, "/")
    retornar {"d": a_numero(p[0]), "m": a_numero(p[1])}
})
igual(molde_a_dato(molde_registro({"f": Fecha}), {"f": {"d": 3, "m": 4}}), {"f": "3/4"}, "tipo propio")
igual(molde_desde_json(molde_mapa("entero"), "{\"a\": 1}"), {"a": 1}, "mapa")
intentar { molde_desde_json(Item, "{mal") } capturar (e) { m = e }
afirmar(texto_empieza_con(m, "molde: JSON inválido"), "JSON inválido")
mostrar("[OK] molde")
