importar "estilos"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea LL = caracter(123)
sea RR = caracter(125)
funcion regla(sel, decls) {
    sea r = sel + " " + LL + "\n"
    para d en decls { r = r + "  " + d + ";\n" }
    retornar r + RR + "\n"
}
// Las reglas coinciden con las de Tailwind CSS v4 (comparadas en 198 utilidades).
igual(estilos_css(["p-4"], {"raiz": falso}), regla(".p-4", ["padding: calc(var(--spacing) * 4)"]), "p-4")
igual(estilos_css(["-mt-1"], {"raiz": falso}), regla(".-mt-1", ["margin-top: calc(var(--spacing) * -1)"]), "negativo")
igual(estilos_css(["w-1/2"], {"raiz": falso}), regla(".w-1\\/2", ["width: calc(1 / 2 * 100%)"]), "fracción")
igual(estilos_css(["w-[37px]"], {"raiz": falso}), regla(".w-\\[37px\\]", ["width: 37px"]), "arbitrario")
igual(estilos_css(["!p-2"], {"raiz": falso}), regla(".\\!p-2", ["padding: calc(var(--spacing) * 2) !important"]), "importante")
igual(estilos_css(["2xl:p-4"], {"raiz": falso}), "@media (width >= 96rem) " + LL + "\n  .\\32 xl\\:p-4 " + LL + "\n    padding: calc(var(--spacing) * 4);\n  " + RR + "\n" + RR + "\n", "punto de quiebre y escapado")
igual(estilos_css(["hover:underline"], {"raiz": falso}), "@media (hover: hover) " + LL + "\n  .hover\\:underline:hover " + LL + "\n    text-decoration-line: underline;\n  " + RR + "\n" + RR + "\n", "hover")
sea css = estilos_css("<a class=\"text-red-500 bg-sky-700/50 rounded-lg\">")
afirmar(texto_indice(css, "color: var(--color-red-500);") >= 0, "color")
afirmar(texto_indice(css, "background-color: color-mix(in oklab, var(--color-sky-700) 50%, transparent);") >= 0, "opacidad")
afirmar(texto_indice(css, "--color-red-500: oklch(63.7% 0.237 25.331);") >= 0, "variables del tema")
afirmar(texto_indice(css, "--radius-lg: 0.5rem;") >= 0, "radio")
igual(estilos_clases("<div class=\"p-4 md:flex\" data-x='w-[calc(100%_-_1rem)]'>"), ["div", "class", "p-4", "md:flex", "data-x", "w-[calc(100%_-_1rem)]"], "extraer clases")
igual(estilos_desconocidas(["p-4", "colr-red", "md:flex"]), ["colr-red"], "desconocidas")
igual(estilos_css(["grupo:p-4"]), "\n", "variante desconocida")
sea tema = estilos_css(["bg-marca"], {"tema": {"color-marca": "#0a2540"}})
afirmar(texto_indice(tema, "--color-marca: #0a2540;") >= 0, "tema propio")
igual(estilos_tema("breakpoint-md"), "48rem", "tema")
// Unir como tailwind-merge (resultados iguales a la librería en 18 casos).
igual(estilos_unir("px-2 py-1 bg-red-500 hover:bg-dark-red p-3 bg-[#B91C1C]"), "hover:bg-dark-red p-3 bg-[#B91C1C]", "unir")
igual(estilos_unir(["p-4 px-2", {"text-red-500": verdadero, "hidden": falso}]), "p-4 px-2 text-red-500", "unir con condiciones")
igual(estilos_unir("text-lg text-red-500 text-sm"), "text-red-500 text-sm", "tamaño y color")
igual(estilos_unir("md:p-2 p-4 md:p-8"), "p-4 md:p-8", "variantes")
mostrar("[OK] estilos")
