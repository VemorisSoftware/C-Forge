importar "ident"
funcion igual(a, b, q) { afirmar(a == b, q + ": [" + a + "] != [" + b + "]") }
sea u = ident_uuid4()
afirmar(ident_es_uuid(u), "uuid4 bien formado")
igual(ident_version_uuid(u), 4, "versión 4")
afirmar(texto_indice("89ab", subcadena(u, 19, 20)) >= 0, "variante RFC")
afirmar(ident_uuid4() != u, "únicos")
sea antes = cfv_fecha_ahora_ms()
sea v7 = ident_uuid7()
igual(ident_version_uuid(v7), 7, "versión 7")
afirmar(absoluto(ident_uuid7_ms(v7) - antes) < 5000, "tiempo del uuid7")
dormir(3)
afirmar(ident_uuid7() > v7, "uuid7 ordenable")
sea l = ident_ulid()
igual(longitud(l), 26, "ulid largo")
afirmar(absoluto(ident_ulid_ms(l) - antes) < 5000, "tiempo del ulid")
dormir(3)
afirmar(ident_ulid() > l, "ulid ordenable")
igual(longitud(ident_nanoid()), 21, "nanoid por defecto")
igual(longitud(ident_nanoid(8)), 8, "nanoid largo")
sea vistos = {}
para i en rango(2000) { vistos[ident_nanoid(10)] = 1 }
igual(longitud(vistos), 2000, "sin choques")
afirmar(ident_es_uuid("123e4567-e89b-12d3-a456-426614174000"), "uuid válido")
afirmar(ident_es_uuid("123e4567e89b12d3a456426614174000") == falso, "sin guiones")
afirmar(ident_es_uuid("123e4567-e89b-12d3-a456-42661417400g") == falso, "carácter inválido")
sea m = ""
intentar { ident_nanoid(0) } capturar (e) { m = e }
afirmar(m != "", "nanoid 0 rechazado")
mostrar("[OK] ident")
