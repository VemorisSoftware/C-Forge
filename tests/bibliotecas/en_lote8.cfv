// Written in English.
import "tracing"
import "payments"
import "science"
import "symbolic"
import "astronomy"
import "archive"
import "xlsx"
import "read_xlsx"
function same(a, b, what) { assert(("" + a) == ("" + b), what + ": [" + a + "] != [" + b + "]") }
let tr = tracing_new("api")
tracing_span(tr, "work", function(s) { tracing_attribute(s, "k", 1) })
same(tracing_spans(tr)[0]["nombre"], "work", "tracing")
let p = payments_charge(1000, "usd")
payments_transition(p, "captured")
same(payments_status(p), "captured", "payments")
same(payments_format(1999, "USD"), "US$19,99", "payments_format")
let m = science_minimize(function(v) { return (v[0] - 2) * (v[0] - 2) }, [0])
assert(abs(m["x"][0] - 2) < 0.0001, "science_minimize")
same(symbolic_str(symbolic_diff(symbolic_parse("x^3"), "x")), "3*x^2", "symbolic")
let sun = astronomy_sun_times(-33.45, -70.67, 1763683200000)
assert(sun["day_hours"] > 13 and sun["day_hours"] < 15, "astronomy")
same(astronomy_season(-33.45, 1767225600000), "summer", "astronomy_season")
let zip = archive_zip([{"name": "a.txt", "data": "hi"}])
same(archive_read_zip(zip)[0]["data"], "hi", "archive")
let wb = xlsx_workbook()
xlsx_rows(xlsx_add_sheet(wb, "S"), [["n", "when"], [1, {"date_ms": 0}]], {"header": true})
let book = read_xlsx_open(xlsx_bytes(wb))
same(read_xlsx_rows(book, "S", {"dates_ms": true})[1], [1, 0], "xlsx round trip")
print("[OK] lote 8 in English")
