importar "entidades"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea m = entidades_mundo()
sea log = []
entidades_al(m, "poner", "vel", funcion(m, e, d) { log.agregar("+vel " + e) })
entidades_al(m, "quitar", "vel", funcion(m, e, d) { log.agregar("-vel " + e) })
sea a = entidades_crear(m, {"pos": {"x": 0, "y": 0}, "vel": {"x": 1, "y": 2}})
sea b = entidades_crear(m, {"pos": {"x": 5, "y": 5}})
sea c = entidades_crear(m, {"pos": {"x": 9, "y": 9}, "vel": {"x": -1, "y": 0}, "congelado": {}})
entidades_sistema(m, "mover", ["pos", "vel"], funcion(m, e, cs, dt) {
    cs["pos"]["x"] = cs["pos"]["x"] + cs["vel"]["x"] * dt
    si (cs["pos"]["x"] >= 2) {
        entidades_emitir(m, "llego", e)
        entidades_destruir(m, e)
        entidades_crear(m, {"pos": {"x": 100, "y": 0}, "nuevo": {}})
    }
}, {"sin": ["congelado"]})
entidades_sistema(m, "contar", [], funcion(m, e, cs, dt) { entidades_recurso(m, "llegadas", (entidades_recurso(m, "llegadas") ?? 0) + longitud(entidades_eventos(m, "llego"))) }, {"fase": -1})
entidades_paso(m, 1)
igual([entidades_obtener(m, a, "pos"), entidades_cantidad(m)], [{"x": 1, "y": 0}, 3], "sistema con exclusión")
entidades_paso(m, 1)
igual([entidades_viva(m, a), entidades_cantidad(m), longitud(entidades_consultar(m, ["nuevo"]))], [falso, 3, 1], "destruir y crear diferidos")
entidades_paso(m, 1)
igual(entidades_recurso(m, "llegadas"), 1, "eventos al cuadro siguiente")
igual(log, ["+vel " + a, "+vel " + c, "-vel " + a], "señales")
sea d = entidades_crear(m, {"x": {}})
igual([entidades_viva(m, a), entidades_viva(m, d), entidades_obtener(m, a, "x"), d != a], [falso, verdadero, nulo, verdadero], "generaciones: el id viejo no revive")
igual([entidades_cuantas(m, "pos"), entidades_tiene(m, c, "congelado")], [3, verdadero], "conteos")
entidades_quitar(m, c, "congelado")
igual(entidades_tiene(m, c, "congelado"), falso, "quitar componente")
sea m2 = entidades_cargar(entidades_mundo(), entidades_guardar(m))
igual([entidades_cantidad(m2), entidades_componentes(m2, c)], [entidades_cantidad(m), entidades_componentes(m, c)], "guardar y cargar")
sea w = entidades_mundo()
sea i = 0
mientras (i < 200) { entidades_crear(w, {"p": {"x": i}, "v": {"x": 1}})  i = i + 1 }
igual(entidades_cada(w, ["p", "v"], funcion(e, cs) { cs[0]["x"] = cs[0]["x"] + cs[1]["x"] }), 200, "vista recorre todas")
entidades_ordenar(w, "p", funcion(x, z) { retornar z["x"] - x["x"] })
igual(entidades_consultar(w, ["p"])[0][1]["p"]["x"], 200, "ordenar el componente")
sea m3 = ""
intentar { entidades_poner(w, 12345, "x", 1) } capturar (e) { m3 = e }
igual(m3, "entidades: la entidad 12345 no existe (¿ya se destruyó?)", "entidad inexistente")
mostrar("[OK] entidades")
