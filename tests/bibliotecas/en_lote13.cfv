// Written in English.
import "graphql"
import "fastapi"
import "orm"
import "pdf"
import "typeset"
import "mailbox"
import "raft"
import "fulltext"
import "molde"
import "json"
function same(a, b, what) { assert(("" + a) == ("" + b), what + ": [" + a + "] != [" + b + "]") }
let g = graphql_schema("type Query { hello(name: String!): String! }")
same(graphql_json(g, {"Query": {"hello": function(p, a, c, i) { return "Hello " + a["name"] }}}, "{ hello(name: \"Ann\") }", null, null, null), "{\"data\":{\"hello\":\"Hello Ann\"}}", "graphql")
let app = fastapi_new({"title": "Books"})
fastapi_get(app, "/books/:id", {"params": {"id": "entero"}}, function(req) { return {"id": req["parametros"]["id"]} })
let res = fastapi_handle(app, {"method": "GET", "path": "/books/7"})
same([res["status"], json_parsear(res["body"])["id"]], [200, 7], "fastapi")
same(fastapi_handle(app, {"method": "GET", "path": "/books/x"})["status"], 422, "fastapi 422")
same(fastapi_openapi(app)["info"]["title"], "Books", "openapi")
let users = orm_table("users", {"id": orm_column("entero", {"primary": true, "autoincrement": true}), "name": orm_column("texto", {"unique": true})})
same(orm_sql(orm_select(users, {"where": orm_and([orm_gt("id", 1), orm_like("name", "A%")]), "limit": 5}), "postgres")["sql"], "SELECT * FROM \"users\" WHERE (\"id\" > $1) AND (\"name\" LIKE $2) LIMIT 5", "orm")
let doc = pdf_new({"title": "Report"})
pdf_add_page(doc)
pdf_text(doc, 72, 72, "Hello PDF", {"bold": true})
let info = pdf_read(pdf_bytes(doc))
same([info["pages"], info["title"], info["text"][0]], [1, "Report", "Hello PDF"], "pdf")
same(pdf_text_width("Hola", "Helvetica", 10), 20.56, "pdf width")
let t = typeset_new({"footer": "Page %p of %t"})
typeset_markdown(t, "# Title\n\nSome **bold** text.")
same(pdf_read(typeset_pdf(t))["pages"], 1, "typeset")
let mail = mail_parse(mail_build({"from": {"name": "Ann", "email": "ann@x.io"}, "to": ["bob@y.io"], "subject": "Hi", "text": "Hello"}))
same([mail["subject"], mail["from"][0]["email"]], ["Hi", "ann@x.io"], "mailbox")
same(imap_search(imap_response("* SEARCH 4 9\r\nA1 OK\r\n", "A1")), [4, 9], "imap")
let net = raft_network(["a", "b", "c"], {"seed": 5})
raft_network_run(net, 1000)
let leader = raft_network_leader(net)
raft_propose(raft_nodes(net)[leader], "x")
raft_network_run(net, 300)
same(raft_committed(raft_nodes(net)["b"]), ["x"], "raft")
same(raft_status(raft_nodes(net)[leader])["role"], "lider", "raft status")
let idx = fulltext_new({"language": "en", "fields": {"title": 2, "body": 1}})
fulltext_add(idx, "1", {"title": "Running tips", "body": "How runners train"})
fulltext_add(idx, "2", {"title": "Cooking", "body": "Bread recipes"})
let hits = fulltext_search(idx, "runer", {"typos": 1})
same([hits["total"], hits["hits"][0]["id"]], [1, "1"], "fulltext")
same(levenshtein("flaw", "lawn"), 2, "levenshtein")
print("[OK] en_lote13")
