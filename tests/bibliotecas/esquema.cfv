importar "esquema"
funcion igual(a, b, q) { afirmar(a == b, q + ": [" + a + "] != [" + b + "]") }
sea u = esquema_objeto({
    "nombre": esquema_max(esquema_min(esquema_texto(), 2), 20),
    "correo": esquema_correo(esquema_texto()),
    "edad": esquema_opcional(esquema_max(esquema_min(esquema_entero(), 0), 130)),
    "rol": esquema_defecto(esquema_uno_de(esquema_texto(), ["admin", "usuario"]), "usuario"),
    "tags": esquema_max(esquema_lista(esquema_texto()), 3),
    "cp": esquema_opcional(esquema_patron(esquema_texto(), "[0-9]+")),
    "activo": esquema_opcional(esquema_booleano())
})
sea r = esquema_validar(u, {"nombre": "Ana", "correo": "ana@x.cl", "tags": ["a"], "sobra": 1, "cp": "8320000"})
igual(r["ok"], verdadero, "válido")
igual(r["valor"]["rol"], "usuario", "valor por defecto")
igual(tiene_clave(r["valor"], "sobra"), falso, "descarta claves no declaradas")
sea m = esquema_validar(esquema_estricto(u), {"nombre": "A", "correo": "malo@", "edad": 1.5, "rol": "jefe", "tags": ["a", 2], "x": 1, "cp": "12a", "activo": "si"})
igual(m["ok"], falso, "inválido")
sea codigos = []
para e en m["errores"] { codigos.agregar(e["ruta"] + "=" + e["codigo"]) }
igual(unir(codigos, " "), "activo=tipo correo=correo cp=patron edad=entero nombre=muy_corto rol=opcion tags.1=tipo x=desconocido", "errores con ruta")
igual(esquema_validar(u, {"correo": "a@b.cl", "nombre": "Bo", "tags": []})["ok"], verdadero, "opcionales ausentes")
igual(esquema_validar(u, {"correo": "a@b.cl", "nombre": "Bo"})["errores"][0]["ruta"] + " " + esquema_validar(u, {"correo": "a@b.cl", "nombre": "Bo"})["errores"][0]["codigo"], "tags requerido", "requerido")
igual(esquema_validar(u, nulo)["errores"][0]["ruta"], "(raíz)", "raíz")
igual(esquema_validar(esquema_numero(), "3")["errores"][0]["codigo"], "tipo", "sin conversión implícita")
igual(esquema_validar(esquema_min(esquema_numero(), 1), 0)["errores"][0]["mensaje"], "debe ser al menos 1", "mínimo numérico")
igual(esquema_validar(esquema_max(esquema_lista(esquema_entero()), 1), [1, 2])["errores"][0]["mensaje"], "debe tener como máximo 1 elementos", "máximo de lista")
// Anidado
sea pedido = esquema_objeto({"cliente": esquema_objeto({"rut": esquema_patron(esquema_texto(), "[0-9]+-[0-9kK]")}), "items": esquema_min(esquema_lista(esquema_objeto({"cant": esquema_min(esquema_entero(), 1)})), 1)})
sea p = esquema_validar(pedido, {"cliente": {"rut": "12345678-k"}, "items": [{"cant": 2}, {"cant": 0}]})
igual(p["errores"][0]["ruta"], "items.1.cant", "ruta anidada")
igual(esquema_analizar(esquema_texto(), "hola"), "hola", "analizar ok")
sea e2 = ""
intentar { esquema_analizar(pedido, {"cliente": {"rut": "x"}, "items": [{"cant": 1}]}) } capturar (e) { e2 = e }
igual(e2, "cliente.rut: no tiene el formato esperado", "analizar lanza")
// Correos
para c en ["a@b", "@b.cl", "a b@c.cl", "a@b.", "a@@b.cl", "a@.cl"] { igual(esquema_validar(esquema_correo(esquema_texto()), c)["ok"], falso, "correo " + c) }
igual(esquema_validar(esquema_correo(esquema_texto()), "nombre.apellido+x@sub.dominio.cl")["ok"], verdadero, "correo largo")
mostrar("[OK] esquema")
