importar "consenso"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea red = consenso_red(["a", "b", "c", "d", "e"], {"semilla": 7})
consenso_red_avanzar(red, 1000)
sea l = consenso_red_lider(red)
afirmar(l != nulo, "hay líder")
sea i = 0
mientras (i < 5) { consenso_proponer(red["nodos"][l], i)  i = i + 1 }
consenso_red_avanzar(red, 300)
para id en red["ids"] { igual(consenso_aplicados(red["nodos"][id]), [0, 1, 2, 3, 4], "replicado en " + id) }
// El líder queda en minoría: lo que proponga no se confirma.
sea otros = []
para id en red["ids"] { si (id != l) { otros.agregar(id) } }
consenso_red_particion(red, [l, otros[0]], [otros[1], otros[2], otros[3]], verdadero)
consenso_proponer(red["nodos"][l], "perdido")
consenso_red_avanzar(red, 1500)
sea l2 = consenso_red_lider(red)
afirmar(l2 != l y red["nodos"][l2]["termino"] > red["nodos"][l]["termino"], "nuevo líder en la mayoría")
consenso_proponer(red["nodos"][l2], "mayoria")
consenso_red_avanzar(red, 300)
consenso_red_particion(red, [l, otros[0]], [otros[1], otros[2], otros[3]], falso)
consenso_red_avanzar(red, 1500)
para id en red["ids"] { igual(consenso_aplicados(red["nodos"][id]), [0, 1, 2, 3, 4, "mayoria"], "converge " + id) }
igual(consenso_aplicar(red["nodos"]["a"]), [0, 1, 2, 3, 4, "mayoria"], "aplicar")
igual(consenso_aplicar(red["nodos"]["a"]), [], "aplicar no repite")
// Con 20% de pérdidas y un nodo caído.
sea r2 = consenso_red(["x", "y", "z"], {"semilla": 3, "perdida": 0.2})
consenso_red_avanzar(r2, 2000)
i = 0
mientras (i < 10) {
    sea ld = consenso_red_lider(r2)
    si (ld != nulo) { intentar { consenso_proponer(r2["nodos"][ld], i) } capturar (e) { } }
    consenso_red_avanzar(r2, 200)
    i = i + 1
}
consenso_red_avanzar(r2, 3000)
igual(consenso_aplicados(r2["nodos"]["x"]), consenso_aplicados(r2["nodos"]["z"]), "mismos datos con pérdidas")
sea seguidor = nulo
para id en r2["ids"] { si (id != consenso_red_lider(r2)) { seguidor = id } }
sea lanzo = falso
intentar { consenso_proponer(r2["nodos"][seguidor], 1) } capturar (e) { lanzo = verdadero }
afirmar(lanzo, "sólo el líder propone")
mostrar("[OK] consenso")
