importar "archivador"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea grande = texto_repetir("hola mundo ", 500)
sea binario = bytes_de_hex("00ff10802a")
sea z = archivador_zip([{"nombre": "hola.txt", "datos": "Hola"}, {"nombre": "dir/grande.txt", "datos": grande, "fecha_ms": 1763683200000}, {"nombre": "ñandú.bin", "datos": binario}, {"nombre": "vacio.txt", "datos": ""}])
sea l = archivador_leer_zip(z)
igual(longitud(l), 4, "cuatro entradas")
igual([l[0]["nombre"], l[0]["datos"], l[1]["tamano"], l[1]["comprimido"] < 200, l[2]["datos"] == binario, l[3]["datos"]], ["hola.txt", "Hola", 5500, verdadero, verdadero, ""], "ida y vuelta (deflate y guardado)")
igual(archivador_zip_archivo(z, "dir/grande.txt") == grande, verdadero, "una entrada")
igual(archivador_zip_archivo(z, "no.txt"), nulo, "entrada inexistente")
igual(longitud(archivador_leer_zip(archivador_zip([{"nombre": "a", "datos": grande}], falso))[0]["datos"]), 5500, "sin comprimir")
// Seguridad
igual([archivador_ruta_segura("a/b.txt"), archivador_ruta_segura("../x"), archivador_ruta_segura("a/../../x"), archivador_ruta_segura("/etc/passwd"), archivador_ruta_segura("C:\\x"), archivador_ruta_segura("a\\..\\..\\x")], [verdadero, falso, falso, falso, falso, falso], "rutas seguras")
sea m = ""
intentar { archivador_zip([{"nombre": "../malo", "datos": "x"}]) } capturar (e) { m = e }
igual(m, "archivador: ruta insegura ../malo", "no crea zip slip")
// ZIP malicioso: reemplaza el nombre por ../ en el directorio central.
sea malo = texto_reemplazar(archivador_zip([{"nombre": "xx/a.txt", "datos": "x"}]), "xx/a.txt", "../a.txt")
intentar { archivador_leer_zip(malo) } capturar (e) { m = e }
igual(m, "archivador: ruta insegura en el ZIP: ../a.txt", "no lee zip slip")
// CRC alterado
sea z2 = archivador_zip([{"nombre": "c.txt", "datos": "contenido"}], falso)
sea p = bytes_buscar(z2, "contenido", 0)
sea z3 = subcadena(z2, 0, p) + "Contenido" + subcadena(z2, p + 9, longitud(z2))
intentar { archivador_leer_zip(z3) } capturar (e) { m = e }
igual(m, "archivador: CRC incorrecto en c.txt", "CRC")
// Bomba: 20 MB de ceros comprimidos.
sea bomba = archivador_zip([{"nombre": "ceros", "datos": texto_repetir(bytes_entero(0, 1, 0), 20000000)}])
intentar { archivador_leer_zip(bomba, {"max_total": 1000000}) } capturar (e) { m = e }
igual(m, "archivador: el contenido supera 1000000 bytes", "límite total")
intentar { archivador_leer_zip(bomba) } capturar (e) { m = e }
igual(m, "archivador: razón de compresión sospechosa en ceros", "razón de compresión")
intentar { archivador_leer_zip("no soy un zip") } capturar (e) { m = e }
igual(m, "archivador: no es un ZIP (falta el directorio central)", "no es zip")
intentar { archivador_leer_zip(subcadena(z, 0, 100) + subcadena(z, longitud(z) - 120, longitud(z))) } capturar (e) { m = e }
afirmar(texto_empieza_con(m, "archivador: ZIP"), "truncado: " + m)
// TAR
sea largo = texto_repetir("carpeta/", 15) + "archivo.txt"
sea t = archivador_tar([{"nombre": "a.txt", "datos": "AAA"}, {"nombre": "b/c.txt", "datos": grande}, {"nombre": largo, "datos": "x"}])
igual(longitud(t) % 512, 0, "bloques de 512")
sea lt = archivador_leer_tar(t)
igual([lt[0]["nombre"], lt[0]["datos"], lt[1]["tamano"], lt[2]["nombre"] == largo], ["a.txt", "AAA", 5500, verdadero], "TAR ida y vuelta (con prefijo ustar)")
sea t2 = subcadena(t, 0, 10) + "X" + subcadena(t, 11, longitud(t))
intentar { archivador_leer_tar(t2) } capturar (e) { m = e }
igual(m, "archivador: TAR dañado (suma de cabecera)", "suma TAR")
mostrar("[OK] archivador")
