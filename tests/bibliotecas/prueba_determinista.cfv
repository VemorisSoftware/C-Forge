importar "determinista"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion cerca(a, b, tol, q) { afirmar(abs(a - b) <= tol, q + ": " + a + " no está cerca de " + b) }
// Matemática en punto fijo.
cerca(det_real(det_seno(det_fijo(0.5))), 0.4794255, 0.0002, "seno")
cerca(det_real(det_coseno(det_fijo(1))), 0.5403023, 0.0002, "coseno")
cerca(det_real(det_seno(det_fijo(-2))), -0.9092974, 0.0002, "seno negativo")
cerca(det_real(det_raiz(det_fijo(2))), 1.4142136, 0.0001, "raíz")
igual([det_fijo(1.5), det_real(98304)], [98304, 1.5], "conversión")
funcion escena() {
    sea m = det_mundo({"gravedad": [0, -10]})
    det_caja(m, {"x": 0, "y": -1, "ancho": 20, "alto": 2, "tipo": "estatico"})
    det_circulo(m, {"x": 0, "y": 5, "radio": 0.5, "restitucion": 0.2})
    det_caja(m, {"x": 2, "y": 3, "ancho": 1, "alto": 1, "angulo": 0.3})
    sea i = 0
    mientras (i < 3) {
        det_caja(m, {"x": -3, "y": 0.5 + i, "ancho": 1, "alto": 1})
        i = i + 1
    }
    retornar m
}
sea m = escena()
det_pasos(m, 150)
// Reposo: la bola, la caja girada (que queda plana) y la pila.
cerca(det_posicion(m, 2)[1], 0.5, 0.03, "bola en el suelo")
cerca(det_posicion(m, 3)[1], 0.5, 0.03, "caja en el suelo")
cerca(det_angulo(m, 3), 0, 0.02, "caja plana")
cerca(det_posicion(m, 6)[1], 2.5, 0.06, "pila de tres")
cerca(det_posicion(m, 6)[0], -3, 0.05, "pila derecha")
// Reproducible: mismo resultado y misma suma en otra corrida (y en
// cualquier máquina: la suma esperada es la de Linux x86-64).
sea m2 = escena()
det_pasos(m2, 150)
igual(det_suma(m2), det_suma(m), "misma corrida")
igual(det_suma(m), 1214848946, "suma conocida")
// Rollback: capturar, avanzar, restaurar y volver a avanzar da lo mismo.
sea cap = det_captura(m)
det_pasos(m, 20)
sea s1 = det_suma(m)
det_restaurar(m, cap)
det_pasos(m, 20)
igual(det_suma(m), s1, "rollback")
// Impulso y sensores.
sea w = det_mundo({"gravedad": [0, 0]})
sea a = det_circulo(w, {"x": 0, "y": 0, "radio": 0.5, "masa": 2})
sea zona = det_caja(w, {"x": 3, "y": 0, "ancho": 1, "alto": 1, "tipo": "estatico", "sensor": verdadero})
det_impulso(w, a, 4, 0)
cerca(det_velocidad(w, a)[0], 2, 0.001, "impulso = Δv · masa")
sea tocado = falso
sea i = 0
mientras (i < 120) {
    para par en det_paso(w) { si (par[0] == a y par[1] == zona) { tocado = verdadero } }
    i = i + 1
}
igual([tocado, det_posicion(w, a)[0] > 3], [verdadero, verdadero], "sensor atravesable")
// Choque de frente entre dos círculos con rebote total: intercambian velocidad.
sea c = det_mundo({"gravedad": [0, 0]})
sea p1 = det_circulo(c, {"x": -2, "y": 0, "radio": 0.5, "restitucion": 1, "friccion": 0, "vel": [2, 0]})
sea p2 = det_circulo(c, {"x": 2, "y": 0, "radio": 0.5, "restitucion": 1, "friccion": 0, "vel": [-2, 0]})
det_pasos(c, 90)
cerca(det_velocidad(c, p1)[0], -2, 0.05, "rebote 1")
cerca(det_velocidad(c, p2)[0], 2, 0.05, "rebote 2")
mostrar("[OK] determinista")
