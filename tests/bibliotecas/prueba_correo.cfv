importar "correo"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Clave RSA de 1024 bits sólo para esta prueba y mensajes firmados con dkimpy.
sea N = "be93e1782920f9c369fdeedb34978da193d0fe77388bddb218bd6fd55291cb3351a449a87603d1392569cc4e7d18d99957c28c663e666208e184b954c4e52543f2b791fed7a45a09dd0655e4d7aa522ce3592c604efe30b50c8c24809768ca4183b727248f438b38a00b9fc2b61f1633fd3f208df3c984aea2145d380e8484db"
sea E = "010001"
sea D = "6d093edef8e91cfd690f1831e28d334356c7245021d2242d596a4929cbec0e4e764f80b51990658c44939b88ec99e32590c8867b99080adef9e86e00ca0630a30a8feb544f9c6e8e417b6a21e10191f9984dd892df7741c731571bfb1ec1575c831c4451a631c7ca8a77b17959b8ed27b86fd06719c5c2b04a63d14b167a9d81"
sea MSG_RSA = "DKIM-Signature: v=1; a=rsa-sha256; c=relaxed/simple; d=vemoris.cl;\r\n i=@vemoris.cl; q=dns/txt; s=s1; t=1795337444; h=from : to : subject :\r\n date; bh=8Mk93OGybf5xznNvP5TiV8XNXIR4oSrKzTAnFTaL+SQ=;\r\n b=LZMOivUlNoMqTklRAFb8Fudi0aTRXkID1oZrqv46PWonfuH80FgWpT1sT2x+iEtCzEVSX\r\n I8Q5yVFthXVay4xAxNlSPhKhHGmMTvhknFCcRSC+Eum4Wqm2meGBoYNf7CUoHx+S357knV2\r\n xodRtkZhscxJdSQemagJyRxJhTwd2bM=\r\nFrom: Ana <ana@vemoris.cl>\r\nTo: leo@x.cl\r\nSubject: Prueba  de   DKIM\r\nDate: Sun, 22 Nov 2026 10:00:00 +0000\r\n\r\nHola  Leo,\r\nprueba.\r\n"
sea MSG_ED = "DKIM-Signature: v=1; a=ed25519-sha256; c=relaxed/simple; d=vemoris.cl;\r\n i=@vemoris.cl; q=dns/txt; s=s2; t=1795337444; h=from : to : subject;\r\n bh=8Mk93OGybf5xznNvP5TiV8XNXIR4oSrKzTAnFTaL+SQ=;\r\n b=MtDw0ju9CK8LysEVGX94DCvWEEoT41ILaSvK6VmjDdKd6zWQKD1FADkU/tj8QbZyEB1zS\r\n oD7rEvdNH2lnqQXAA==\r\nFrom: Ana <ana@vemoris.cl>\r\nTo: leo@x.cl\r\nSubject: Prueba  de   DKIM\r\nDate: Sun, 22 Nov 2026 10:00:00 +0000\r\n\r\nHola  Leo,\r\nprueba.\r\n"
sea rsa = {"tipo": "rsa", "n": bytes_de_hex(N), "e": bytes_de_hex(E), "d": bytes_de_hex(D)}
sea rsa_pub = {"tipo": "rsa", "n": rsa["n"], "e": rsa["e"]}
// Clave Ed25519 del RFC 8032 (vector 1).
sea ed = {"tipo": "ed25519", "privada": bytes_de_hex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")}
ed["publica"] = ed25519_publica(ed["privada"])
igual(hex_de_bytes(ed["publica"]), "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a", "clave Ed25519")
// RSA con Montgomery: (m^e)^d = m.
sea m = bytes_de_hex("0102030405")
sea ida = correo_rsa_potencia(correo_rsa_potencia(m, rsa["e"], rsa["n"]), rsa["d"], rsa["n"])
igual([longitud(ida), hex_de_bytes(subcadena(ida, 123, 128))], [128, hex_de_bytes(m)], "RSA ida y vuelta")
// Firmas hechas por dkimpy.
igual(correo_dkim_verificar(MSG_RSA, rsa_pub)["valida"], verdadero, "verificar RSA de dkimpy")
igual(correo_dkim_verificar(MSG_ED, "v=DKIM1; k=ed25519; p=11qYAYKxCrfVS/7TyWQHOg7hcvPapiMlrwIaaPcHURo=")["valida"], verdadero, "verificar Ed25519 de dkimpy")
igual(correo_dkim_verificar(texto_reemplazar(MSG_RSA, "prueba.", "otra."), rsa_pub)["motivo"], "el cuerpo cambió (bh no coincide)", "cuerpo alterado")
igual(correo_dkim_verificar(texto_reemplazar(MSG_RSA, "To: leo@x.cl", "To: eva@x.cl"), rsa_pub)["valida"], falso, "cabecera alterada")
// Firmar y verificar.
sea msg = correo_mensaje({"de": {"nombre": "Javier Ábrigo", "correo": "j@vemoris.cl"}, "para": ["ana@x.cl", "leo@x.cl"], "cco": ["oculto@x.cl"], "asunto": "Informe ñ", "texto": "Hola\n.línea con punto", "fecha_ms": 1795352400000})
igual([msg["de"], msg["destinatarios"]], ["j@vemoris.cl", ["ana@x.cl", "leo@x.cl", "oculto@x.cl"]], "sobre")
afirmar(texto_indice(msg["datos"], "oculto") < 0, "cco no va en las cabeceras")
afirmar(texto_indice(msg["datos"], "Date: Sun, 22 Nov 2026 13:00:00 +0000") >= 0, "fecha")
sea f1 = correo_dkim_firmar(msg, {"dominio": "vemoris.cl", "selector": "s1", "clave": rsa})
sea f2 = correo_dkim_firmar(msg, {"dominio": "vemoris.cl", "selector": "s2", "clave": ed, "canonicalizacion": "simple/simple"})
igual([correo_dkim_verificar(f1, rsa_pub)["valida"], correo_dkim_verificar(f2, ed)["valida"]], [verdadero, verdadero], "firmar")
afirmar(texto_empieza_con(correo_dkim_registro(ed), "v=DKIM1; k=ed25519; p=11qYAYKxCrfVS"), "registro DNS")
// SMTP.
igual(correo_smtp_datos(".a\n..b\nc"), "..a\r\n...b\r\nc\r\n.\r\n", "escapar puntos")
sea rs = correo_smtp_respuestas("250-hola\r\n250-PIPELINING\r\n250 AUTH PLAIN\r\n354 adelante\r\n")
igual([longitud(rs), rs[0]["lineas"], rs[1]["codigo"]], [2, ["hola", "PIPELINING", "AUTH PLAIN"], 354], "respuestas")
sea cmds = correo_smtp_comandos({"usuario": "u", "clave": "c"}, msg)
igual([cmds[1], cmds[2], longitud(cmds)], ["AUTH PLAIN AHUAYw==\r\n", "MAIL FROM:<j@vemoris.cl>\r\n", 9], "comandos")
mostrar("[OK] correo")
