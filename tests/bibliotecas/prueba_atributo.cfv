// Pruebas de atributo (interactividad por atributos al estilo htmx). El
// runtime de JavaScript se probó aparte con jsdom (16 casos).
importar "atributo"
importar "web"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea js = atributo_js()
afirmar(longitud(js) > 10000, "runtime")
afirmar(contiene(js, "window.htmx = api;") y contiene(js, "hx-swap-oob"), "contenido del runtime")
afirmar(texto_empieza_con(atributo_script(), "<script>(function ()"), "script")
// Atributos escapados.
eq(atributo_attrs({"get": "/buscar?q=a&b", "objetivo": "#res", "intercambio": "outerHTML"}), "hx-get=" + caracter(34) + "/buscar?q=a&amp;b" + caracter(34) + " hx-swap=" + caracter(34) + "outerHTML" + caracter(34) + " hx-target=" + caracter(34) + "#res" + caracter(34), "attrs")
sea v = atributo_attrs({"valores": {"id": 3}, "impulsar": verdadero, "en:click": "alert('x')"})
afirmar(contiene(v, "hx-vals=" + caracter(34) + "{&quot;id&quot;: 3}" + caracter(34)) o contiene(v, "&quot;id&quot;"), "vals en json escapado")
afirmar(contiene(v, "hx-boost=" + caracter(34) + "true" + caracter(34)), "boost")
afirmar(contiene(v, "hx-on:click=" + caracter(34) + "alert(&#39;x&#39;)" + caracter(34)), "hx-on")
eq(atributo_escapar("<a href=" + caracter(34) + "x" + caracter(34) + ">"), "&lt;a href=&quot;x&quot;&gt;", "escapar")
eq(atributo_elemento("button", {"post": "/n"}, "+1", {"class": "b"}), "<button class=" + caracter(34) + "b" + caracter(34) + " hx-post=" + caracter(34) + "/n" + caracter(34) + ">+1</button>", "elemento")
eq(atributo_oob("aviso", "listo", nulo, nulo), "<div id=" + caracter(34) + "aviso" + caracter(34) + " hx-swap-oob=" + caracter(34) + "true" + caracter(34) + ">listo</div>", "fuera de banda")
// Petición.
sea sol = {"cabeceras": {"hx-request": "true", "HX-Target": "res", "hx-trigger": "b1", "HX-Boosted": "true"}}
eq(atributo_es_peticion(sol), verdadero, "es petición")
eq(atributo_es_peticion({"cabeceras": {}}), falso, "no es petición")
sea info = atributo_info(sol)
eq([info["objetivo"], info["disparador"], info["impulsado"], info["url_actual"]], ["res", "b1", verdadero, nulo], "info")
// Respuesta.
sea r = atributo_respuesta("<b>ok</b>", {"disparar": {"guardado": {"id": 5}}, "empujar_url": "/a", "refrescar": verdadero, "redirigir": "/x\r\nSet-Cookie: malo=1"})
eq(r["cabeceras"]["HX-Trigger"], "{" + caracter(34) + "guardado" + caracter(34) + ":{" + caracter(34) + "id" + caracter(34) + ":5}}", "disparar con datos")
eq([r["cabeceras"]["HX-Push-Url"], r["cabeceras"]["HX-Refresh"], r["estado"]], ["/a", "true", 200], "cabeceras")
eq(r["cabeceras"]["HX-Redirect"], "/x Set-Cookie: malo=1", "sin inyección de cabeceras")
eq(atributo_respuesta("", {"disparar": ["a", "b"], "estado": 286})["cabeceras"]["HX-Trigger"], "a, b", "lista de eventos")
sea http = atributo_http(atributo_respuesta("ñ", {"estado": 286}))
afirmar(texto_empieza_con(http, "HTTP/1.1 286 Stop Polling"), "estado 286")
afirmar(contiene(http, "Content-Length: 2"), "largo en bytes")
// Con un servidor de verdad.
sea puerto = 18000 + aleatorio_entero(0, 999)
sea srv = web_escuchar(puerto)
sea cli = tarea(funcion() {
    sea s = net_conectar("127.0.0.1", puerto)
    net_enviar(s, "GET /contar HTTP/1.1\r\nHost: x\r\nHX-Request: true\r\nHX-Trigger: boton\r\n\r\n")
    sea t = net_recibir_todo(s)
    net_cerrar(s)
    retornar t
})
sea q = web_solicitud(srv)
eq([q["ruta"], atributo_es_peticion(q), atributo_info(q)["disparador"]], ["/contar", verdadero, "boton"], "petición real")
atributo_enviar(q, atributo_respuesta("<span>1</span>", {"disparar": "contado", "reobjetivo": "#n"}))
sea resp = esperar(cli, 5000)
afirmar(contiene(resp, "HX-Trigger: contado"), "HX-Trigger enviado")
afirmar(contiene(resp, "HX-Retarget: #n"), "HX-Retarget enviado")
afirmar(texto_termina_con(resp, "<span>1</span>"), "cuerpo")
servidor_http_cerrar(srv)
mostrar("[OK] atributo")
