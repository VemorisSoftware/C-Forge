importar "ciencia"
funcion cerca(a, b, tol, q) { afirmar(absoluto(a - b) < tol, q + ": " + a + " != " + b) }
sea r = ciencia_minimizar(funcion(p) { retornar (p[0] - 3) * (p[0] - 3) + (p[1] + 1) * (p[1] + 1) }, [0, 0])
cerca(r["x"][0], 3, 0.00001, "paraboloide x")
cerca(r["x"][1], -1, 0.00001, "paraboloide y")
sea rb = ciencia_minimizar(funcion(p) { retornar 100 * potencia(p[1] - p[0] * p[0], 2) + potencia(1 - p[0], 2) }, [-1.2, 1])
cerca(rb["x"][0], 1, 0.0001, "Rosenbrock")
cerca(ciencia_minimo_1d(funcion(x) { retornar (x - 2) * (x - 2) + 1 }, 0, 5), 2, 0.000001, "sección dorada")
sea g = ciencia_gradiente(funcion(p) { retornar p[0] * p[0] + 3 * p[1] }, [2, 5])
cerca(g[0], 4, 0.0001, "gradiente x")
cerca(g[1], 3, 0.0001, "gradiente y")
sea x = ciencia_resolver([[2, 1, -1], [-3, -1, 2], [-2, 1, 2]], [8, -11, -3])
cerca(x[0], 2, 0.0000001, "Gauss x")
cerca(x[1], 3, 0.0000001, "Gauss y")
cerca(x[2], -1, 0.0000001, "Gauss z")
sea xs = [0, 1, 2, 3, 4, 5]
sea ys = []
para v en xs { ys.agregar(2 * exponencial(0.5 * v)) }
sea aj = ciencia_ajustar(funcion(t, p) { retornar p[0] * exponencial(p[1] * t) }, xs, ys, [1, 0.1])
cerca(aj["p"][0], 2, 0.000001, "ajuste a")
cerca(aj["p"][1], 0.5, 0.000001, "ajuste b")
cerca(ciencia_interpolar([0, 10, 20], [0, 100, 150], 15), 125, 0.0000001, "lineal")
cerca(ciencia_interpolar([0, 10], [0, 100], 12), 120, 0.0000001, "extrapola")
sea s = ciencia_spline([0, 1, 2, 3], [0, 1, 0, 1])
cerca(ciencia_evaluar_spline(s, 1), 1, 0.0000001, "spline pasa por los nodos")
cerca(ciencia_evaluar_spline(s, 1.5), 0.5, 0.0000001, "spline simétrico")
sea s2 = ciencia_spline([0, 1, 2, 3, 4], [0, 1, 4, 9, 16])
cerca(ciencia_evaluar_spline(s2, 2.5), 6.25, 0.05, "spline ≈ x²")
sea e = ciencia_edo(funcion(t, y) { retornar y }, 1, 0, 1, 50)
cerca(e[50][1], exponencial(1), 0.0000001, "RK4 y' = y")
sea osc = ciencia_edo(funcion(t, y) { retornar [y[1], 0 - y[0]] }, [0, 1], 0, pi(), 200)
cerca(osc[200][1][0], 0, 0.000001, "oscilador seno(π)")
sea m = ""
intentar { ciencia_resolver([[1, 2], [2, 4]], [1, 2]) } capturar (x2) { m = x2 }
afirmar(m == "ciencia: sistema singular", m)
mostrar("[OK] ciencia")
