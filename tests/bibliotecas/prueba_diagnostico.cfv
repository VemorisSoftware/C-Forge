importar "diagnostico"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ":\n" + a + "\n!=\n" + b) }
sea fuente = "[servidor]\nhost = \"0.0.0.0\"\npuerto = \"8080\"\nmodo = prod\n"
sea d = diagnostico_nuevo("error", "tipo incompatible", "config.toml", fuente, "E012")
sea p = texto_indice(fuente, "\"8080\"")
diagnostico_marca(d, p, p + 6, "se esperaba un número")
diagnostico_marca(d, texto_indice(fuente, "puerto"), texto_indice(fuente, "puerto") + 6, "en esta clave")
diagnostico_marca_linea(d, 4, 8, 4, "valor sin comillas")
diagnostico_ayuda(d, "quita las comillas: puerto = 8080")
diagnostico_nota(d, "ver docs/config.md")
igual(diagnostico_texto(d), unir([
    "error[E012]: tipo incompatible",
    "  ╭─[config.toml:3:10]",
    "3 │ puerto = \"8080\"",
    "  · ──┬───   ──┬───",
    "  ·   │        ╰── se esperaba un número",
    "  ·   ╰── en esta clave",
    "4 │ modo = prod",
    "  ·        ─┬──",
    "  ·         ╰── valor sin comillas",
    "  ╰─",
    "  ayuda: quita las comillas: puerto = 8080",
    "  nota: ver docs/config.md"], "\n"), "diagnóstico completo")
igual(diagnostico_linea_columna(fuente, p), [3, 10], "línea y columna")
igual(diagnostico_posicion(fuente, 3, 10), p, "posición")
igual(diagnostico_linea_columna("ñandú = 1", 9), [1, 8], "columnas con tildes")
sea simple = diagnostico_nuevo("aviso", "variable sin usar")
igual(diagnostico_texto(simple), "aviso: variable sin usar", "sin fuente")
afirmar(texto_indice(diagnostico_texto(d, verdadero), caracter(27) + "[31;1m") >= 0, "color")
mostrar("[OK] diagnostico")
