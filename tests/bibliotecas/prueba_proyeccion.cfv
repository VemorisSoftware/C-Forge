// Pruebas de proyeccion. Referencias de pyproj 3.8 (PROJ 9.8).
importar "proyeccion"
funcion cerca(a, b, tol, q) { afirmar(absoluto(a - b) <= tol, q + ": " + a + " vs " + b + " (dif " + absoluto(a - b) + ")") }
funcion cerca2(p, x, yv, tol, q) {
    cerca(p[0], x, tol, q + " x")
    cerca(p[1], yv, tol, q + " y")
}
sea stgo = [-70.6483, -33.4569]
cerca2(proyeccion_transformar("EPSG:4326", "EPSG:3857", stgo), -7864532.78141043, -3956108.0192938815, 0.000001, "Web Mercator")
cerca2(proyeccion_transformar("EPSG:4326", "EPSG:3395", stgo), -7864532.78141043, -3932552.399666974, 0.0001, "Mercator elipsoidal")
cerca2(proyeccion_transformar("EPSG:4326", "EPSG:32719", stgo), 346812.85391860554, 6296844.224608017, 0.0001, "UTM 19S")
cerca2(proyeccion_transformar("EPSG:4326", "EPSG:32633", [15, 60]), 500000.0000000009, 6651411.190362714, 0.0001, "UTM 33N")
cerca2(proyeccion_transformar("EPSG:4326", "EPSG:32619", [-75, 10]), -158712.84769773379, 1111418.0328835275, 0.0001, "UTM fuera de su zona")
sea ecef = proyeccion_transformar("EPSG:4326", "EPSG:4978", [-70.6483, -33.4569, 520])
cerca2(ecef, 1765232.5705105173, -5026169.361150841, 0.0001, "ECEF")
cerca(ecef[2], -3496633.71060394, 0.0001, "ECEF z")
sea geo = proyeccion_transformar("EPSG:4978", "EPSG:4326", [1756000, -4981000, -3496000])
cerca2(geo, -70.58042515544624, -33.68048812406249, 0.0000000001, "ECEF a geográficas")
cerca(geo[2], -37886.33280092664, 0.0001, "altura")
cerca2(proyeccion_transformar("EPSG:4326", "+proj=lcc +lat_1=33 +lat_2=45 +lat_0=23 +lon_0=-96 +x_0=0 +y_0=0 +ellps=GRS80 +units=m", [-75, 35]),
    1894366.8236551178, 1564695.5628335548, 0.0001, "Lambert cónica 2SP")
// Ida y vuelta.
para crs en ["EPSG:3857", "EPSG:3395", "EPSG:32719", "EPSG:5361", "+proj=lcc +lat_1=-35 +lat_0=-33 +lon_0=-71 +ellps=WGS84", "+proj=tmerc +lat_0=-30 +lon_0=-72 +k_0=0.9996 +x_0=500000 +y_0=10000000 +ellps=intl", "EPSG:4087"] {
    // Con altura (en 2D se pierde la altura elipsoidal al cambiar de elipsoide, igual que en PROJ).
    sea ida = proyeccion_transformar("EPSG:4326", crs, [stgo[0], stgo[1], 0])
    cerca2(proyeccion_transformar(crs, "EPSG:4326", ida), stgo[0], stgo[1], 0.000000001, "ida y vuelta " + crs)
}
// Cambio de datum: PSAD56 / UTM 19S (Helmert) se mueve unos cientos de metros.
sea psad = proyeccion_transformar("EPSG:4326", "EPSG:24879", stgo)
sea wgs = proyeccion_transformar("EPSG:4326", "EPSG:32719", stgo)
sea dif = raiz((psad[0] - wgs[0]) * (psad[0] - wgs[0]) + (psad[1] - wgs[1]) * (psad[1] - wgs[1]))
afirmar(dif > 100 y dif < 600, "desplazamiento de datum PSAD56: " + dif)
cerca2(psad, 347013.93904676265, 6297163.928280875, 0.01, "PSAD56 igual a PROJ con el mismo towgs84")
cerca2(proyeccion_transformar("EPSG:24879", "EPSG:4326", psad), stgo[0], stgo[1], 0.000001, "vuelta desde PSAD56 (2D)")
cerca2(proyeccion_helmert([1000, 2000, 3000], [1, 2, 3, 0, 0, 0, 0]), 1001, 2002, 0.000001, "Helmert traslación")
// Zonas UTM.
sea z = proyeccion_zona_utm(stgo)
afirmar(z["zona"] == 19 y z["sur"] y z["epsg"] == 32719, "zona de Santiago")
afirmar(proyeccion_zona_utm([5, 60])["zona"] == 32, "excepción de Noruega")
afirmar(proyeccion_zona_utm([15, 78])["zona"] == 33, "excepción de Svalbard")
// Geodésicas (WGS84).
sea gi = proyeccion_geodesica_inversa(stgo, [-58.3816, -34.6037], nulo)
cerca(gi["distancia"], 1139253.493415099, 0.001, "distancia Santiago–Buenos Aires")
cerca(gi["rumbo_1"], 99.82400484192176, 0.0000001, "rumbo inicial")
cerca(gi["rumbo_2"], -87.05930543722019 + 180, 0.0000001, "rumbo final")
sea gd = proyeccion_geodesica_directa(stgo, 45, 1000000, nulo)
cerca2(gd["punto"], -63.543099853039465, -26.872628639150275, 0.000000001, "problema directo")
cerca(gd["rumbo"], -138.57964409539125 + 180, 0.0000001, "rumbo en el destino")
eq_dist(proyeccion_geodesica_inversa([10, 20], [10, 20], nulo)["distancia"])
funcion eq_dist(d) { afirmar(d == 0, "mismo punto") }
sea error = ""
intentar { proyeccion_transformar("EPSG:4326", "EPSG:99999", stgo) } capturar (e) { error = "" + e }
afirmar(texto_contiene(error, "no incluido"), "EPSG desconocido")
afirmar(proyeccion_elipsoide("GRS80")["f"] != proyeccion_elipsoide("WGS84")["f"], "elipsoides")
mostrar("[OK] proyeccion")
