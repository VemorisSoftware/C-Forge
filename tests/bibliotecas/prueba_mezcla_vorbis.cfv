// Pruebas del decodificador Ogg Vorbis (comparado con ffmpeg/libvorbis).
importar "mezcla"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea refs = {}
para l en texto_dividir(texto_recortar(leer_archivo("tests/bibliotecas/datos/mezcla-vorbis-ref.txt")), "\n") {
    sea p = texto_dividir(l, " ")
    refs[p[0]] = {"n": a_numero(p[1]), "d": bytes_de_hex(p[2])}
}
// Cada 31 muestras de ffmpeg (que recorta el final distinto: se compara lo común).
funcion comparar(nombre, s, refs) {
    sea r = refs[nombre]
    sea nc = s["canales"]
    sea n = minimo(r["n"], longitud(s["c"][0]))
    sea maxd = 0
    sea k = 0
    sea i = 0
    mientras (i < n) {
        sea c = 0
        mientras (c < nc) {
            sea v = bytes_leer_entero(r["d"], k * 2, 2, 1)
            si (v >= 32768) { v = v - 65536 }
            maxd = maximo(maxd, absoluto(redondear(s["c"][c][i] * 32767) - v))
            k = k + 1
            c = c + 1
        }
        i = i + 31
    }
    afirmar(maxd <= 1, nombre + ": diferencia " + maxd)
}
sea d1 = leer_archivo("tests/bibliotecas/datos/mezcla-v_st44.ogg")
afirmar(vorbis_es(d1), "es vorbis")
afirmar(vorbis_es(leer_archivo("tests/bibliotecas/datos/mezcla-ms44.mp3")) == falso, "un mp3 no es vorbis")
sea inf = vorbis_info(d1)
eq([inf["tasa"], inf["canales"], inf["muestras"], inf["duracion_ms"], inf["etiquetas"]["title"], inf["etiquetas"]["artist"]], [44100, 2, 17640, 400, "Prueba", "CForge"], "info y etiquetas")
sea s1 = vorbis_decodificar(d1, nulo)
eq(longitud(s1["c"][0]), 17640, "largo exacto por el gránulo")
comparar("v_st44", s1, refs)
// 22 kHz con transitorios (bloques cortos y largos mezclados).
comparar("v_clk22", vorbis_decodificar(leer_archivo("tests/bibliotecas/datos/mezcla-v_clk22.ogg"), nulo), refs)
// Mono, abierto por mezcla_abrir.
sea s3 = mezcla_abrir(leer_archivo("tests/bibliotecas/datos/mezcla-v_mono44.ogg"))
eq([s3["canales"], longitud(s3["c"][0])], [1, 22050], "mezcla_abrir")
comparar("v_mono44", s3, refs)
eq(longitud(vorbis_decodificar(d1, {"max_ms": 100})["c"][0]), 4410, "max_ms")
// Paquetes Ogg.
sea pq = ogg_paquetes(d1)
eq([subtexto(pq[0]["datos"], 1, 7), byte_en(pq[1]["datos"], 0), byte_en(pq[2]["datos"], 0)], ["vorbis", 3, 5], "paquetes de cabecera")
afirmar(pq[longitud(pq) - 1]["ultimo"], "última página")
// Mezcla de un Vorbis con un MP3.
sea mp3 = mezcla_abrir(leer_archivo("tests/bibliotecas/datos/mezcla-ms44.mp3"))
sea m = mezcla_mezclar([mezcla_ganancia(s1, 0.5), mezcla_ganancia(mp3, 0.5)], nulo)
eq(mezcla_cuadros(m), 17640, "mezcla de formatos")
sea mal = falso
intentar { vorbis_decodificar("OggS" + "x", nulo) } capturar (e) { mal = contiene(e, "vorbis") }
afirmar(mal, "error claro")
mostrar("[OK] mezcla_vorbis")
