importar "regla"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea v = regla_validador()
regla_campo(v, "correo", ["requerido", "correo"], "Correo")
regla_campo(v, "edad", ["numero", ["entre", 18, 120]])
regla_campo(v, "clave", ["requerido", ["largo_min", 8], ["cumple", funcion(x, d) { retornar texto_indice(x, " ") < 0 }, "sin espacios"]])
regla_campo(v, "repetir", [["igual_a", "clave", "la clave"]])
regla_campo(v, "rut", ["rut"])
regla_campo(v, "plan", [["uno_de", ["básico", "pro"]]])
regla_campo(v, "codigo", [["patron", "[A-Z]{3}[0-9]{2}", "formato AAA00"]])
regla_campo(v, "web", ["url"])
igual(regla_validar(v, {"correo": "a@b.cl", "edad": 30, "clave": "secreta123", "repetir": "secreta123", "rut": "12.345.678-5", "plan": "pro", "codigo": "ABC12"}), {"errores": {}, "ok": verdadero}, "válido")
sea r = regla_validar(v, {"correo": "malo", "edad": 10, "clave": "a b", "repetir": "x", "rut": "12.345.678-9", "plan": "gold", "codigo": "abc", "web": "ftp://x"})
igual(r["ok"], falso, "inválido")
igual(regla_mensajes(v, r), ["Correo: no es un correo válido", "edad: debe estar entre 18 y 120", "clave: debe tener al menos 8 caracteres", "clave: sin espacios", "repetir: debe coincidir con la clave", "rut: no es un RUT válido", "plan: debe ser uno de: básico, pro", "codigo: formato AAA00", "web: no es una URL válida"], "mensajes")
igual(regla_validar(v, {"clave": "12345678"})["errores"], {"correo": ["es obligatorio"]}, "opcionales vacíos no se revisan")
igual(regla_validar(v, {"correo": "  ", "clave": "12345678"})["errores"]["correo"], ["es obligatorio"], "solo espacios = vacío")
igual([regla_rut_valido("12345678-5"), regla_rut_valido("123456785"), regla_rut_valido("6-k"), regla_rut_valido("6-K"), regla_rut_valido("11.111.111-1"), regla_rut_valido("1-1"), regla_rut_valido("abc")], [verdadero, verdadero, verdadero, verdadero, verdadero, falso, falso], "RUT")
sea en = regla_validador("en")
regla_campo(en, "email", ["required", "email"])
regla_campo(en, "age", ["integer", ["min", 18]])
igual(regla_mensajes(en, regla_validar(en, {"age": 3.5})), ["email: is required", "age: must be a whole number", "age: must be at least 18"], "inglés")
sea m = ""
intentar { regla_campo(v, "x", ["inventada"]) } capturar (e) { m = e }
igual(m, "regla: regla desconocida inventada", "regla desconocida")
sea w = regla_validador()
regla_campo(w, "n", [["cumple", funcion(x, d) { lanzar "boom" }, "falló"]])
igual(regla_validar(w, {"n": 1})["errores"]["n"], ["falló"], "una regla que lanza cuenta como inválida")
mostrar("[OK] regla")
