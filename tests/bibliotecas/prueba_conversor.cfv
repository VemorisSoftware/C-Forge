importar "conversor"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ":\n[" + a + "]\n!=\n[" + b + "]") }
funcion html(md) { retornar conversor_convertir(md, "markdown", "html", {"ids": falso}) }
// Salidas iguales a markdown-it (CommonMark + tablas + tachado).
igual(html("# Uno\n\n## Dos ##\n\nTexto"), "<h1>Uno</h1>\n<h2>Dos</h2>\n<p>Texto</p>\n", "títulos")
igual(html("Hola *mundo* y **negrita** y ***ambos***"), "<p>Hola <em>mundo</em> y <strong>negrita</strong> y <em><strong>ambos</strong></em></p>\n", "énfasis")
igual(html("a_b_c y _énfasis_ aquí"), "<p>a_b_c y <em>énfasis</em> aquí</p>\n", "guion bajo")
igual(html("`código` y ``a ` b``"), "<p><code>código</code> y <code>a ` b</code></p>\n", "código")
igual(html("[ref][r] y [r]\n\n[r]: http://r.cl \"T\""), "<p><a href=\"http://r.cl\" title=\"T\">ref</a> y <a href=\"http://r.cl\" title=\"T\">r</a></p>\n", "referencias")
igual(html("línea uno  \nlínea dos\\\ntres"), "<p>línea uno<br />\nlínea dos<br />\ntres</p>\n", "saltos")
igual(html("- a\n  - b\n  - c\n- d"), "<ul>\n<li>a\n<ul>\n<li>b</li>\n<li>c</li>\n</ul>\n</li>\n<li>d</li>\n</ul>\n", "listas anidadas")
igual(html("- a\n\n- b"), "<ul>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n</li>\n</ul>\n", "lista suelta")
igual(html("Título\n======\n\nSub\n---"), "<h1>Título</h1>\n<h2>Sub</h2>\n", "setext")
igual(html("10. diez\n11. once"), "<ol start=\"10\">\n<li>diez</li>\n<li>once</li>\n</ol>\n", "inicio")
igual(html("a & b < c > d \"q\""), "<p>a &amp; b &lt; c &gt; d &quot;q&quot;</p>\n", "escape")
igual(html("- [ ] tarea\n- [x] hecha"), "<ul>\n<li><input type=\"checkbox\" disabled=\"\" /> tarea</li>\n<li><input type=\"checkbox\" checked=\"\" disabled=\"\" /> hecha</li>\n</ul>\n", "tareas GFM")
// Otros escritores.
sea md = "---\ntitle: Informe\nauthor: Ana\n---\n# Inicio\n\nUn **dato** y `x_1` con 50% & más.\n\n## Detalle\n\n| a | b |\n|:--|--:|\n| 1 | 22 |\n\n1. uno\n2. dos\n"
sea doc = conversor_leer(md, "markdown")
igual(doc["meta"]["title"], "Informe", "metadatos")
sea tex = conversor_escribir(conversor_leer(md, "md"), "latex", {"documento": verdadero})
sea LL = caracter(123)
sea LR = caracter(125)
igual([texto_indice(tex, "\\title" + LL + "Informe" + LR) > 0, texto_indice(tex, "\\textbf" + LL + "dato" + LR + " y \\texttt" + LL + "x\\_1" + LR + " con 50\\% \\& más.") > 0, texto_indice(tex, "\\begin" + LL + "tabular" + LR + LL + "lr" + LR) > 0], [verdadero, verdadero, verdadero], "latex")
igual(conversor_convertir(md, "markdown", "texto", {"numerar": verdadero}), "1 INICIO\n\nUn dato y x_1 con 50% & más.\n\n1.1 Detalle\n-----------\n\na   b\n-  --\n1  22\n\n1. uno\n2. dos\n", "texto")
igual(conversor_convertir("# Hola\n\n- a\n- b\n", "markdown", "rst", nulo), "Hola\n====\n\n- a\n- b\n", "rst")
igual(conversor_convertir("## Hola\n\n*x* y **y**\n", "markdown", "asciidoc", nulo), "=== Hola\n\n_x_ y *y*\n", "asciidoc")
// Índice e ids únicos.
sea ind = conversor_indice(conversor_leer("# Año nuevo\n\n## Uno\n\n## Uno\n", "markdown"), 3)
igual([ind[0]["id"], ind[1]["id"], ind[2]["id"]], ["año-nuevo", "uno", "uno-1"], "ids")
// HTML → markdown y vuelta.
sea h = "<html><head><title>T</title></head><body><h1>Hola</h1><p>Un <b>x</b> &amp; <a href='u'>y</a><br>z</p><ul><li>a<li>b</ul><pre><code class='language-js'>x = 1\n</code></pre><table><tr><th align=right>n</th></tr><tr><td>5</td></tr></table></body></html>"
igual(conversor_convertir(h, "html", "markdown", nulo), "# Hola\n\nUn **x** & [y](u)\\\nz\n\n- a\n- b\n\n```js\nx = 1\n```\n\n| n |\n|---:|\n| 5 |\n", "html a markdown")
igual(conversor_leer(h, "html")["meta"]["title"], "T", "título html")
// Ida y vuelta markdown → markdown estable.
sea casos = ["- a\n  - b\n- c", "1. a\n2. b\n\n3) c", "> cita\n\n```\nx\n\ny\n```", "| a | b |\n|---|:-:|\n| 1 | 2 |", "[x](http://a \"t\") ![i](p.png)"]
para c en casos { igual(html(conversor_convertir(c, "markdown", "markdown", nulo)), html(c), "ida y vuelta " + c) }
// Filtro: sube un nivel los títulos y quita imágenes.
sea f = conversor_filtrar(conversor_leer("## A\n\n![x](y) texto", "markdown"), funcion(n) {
    si (n["t"] == "titulo") { n["nivel"] = n["nivel"] - 1 }
    si (n["t"] == "imagen") { retornar [] }
    retornar nulo
})
igual(conversor_escribir(f, "markdown", nulo), "# A\n\n texto\n", "filtro")
igual(conversor_texto_de(conversor_leer("# T\n\nhola *mundo*", "md")), "T\n\nhola mundo", "texto de")
mostrar("[OK] conversor")
