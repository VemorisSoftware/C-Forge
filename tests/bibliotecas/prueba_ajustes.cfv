importar "ajustes"
importar "json"
sea LL = "$" + caracter(123)
sea RR = caracter(125)
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion falla(f, parte, q) {
    sea msg = ""
    intentar { f() } capturar (e) { msg = e }
    afirmar(texto_indice(msg, parte) >= 0, q + ": " + msg)
}
// TOML (resultados comparados con tomllib de Python).
sea t = ajustes_toml("title = \"TOML\"\n[owner]\ndob = 1979-05-27T07:32:00-08:00\n[database]\nports = [ 8000, 8001 ]\ntemp = { cpu = 79.5, case = 72.0 }\n[servers.alpha]\nip = \"10.0.0.1\"\n[[productos]]\nnombre = \"Martillo\"\n[[productos]]\nnombre = \"Clavo\"\n")
igual(json_texto(t), "{\"database\":{\"ports\":[8000,8001],\"temp\":{\"case\":72,\"cpu\":79.5}},\"owner\":{\"dob\":\"1979-05-27T07:32:00-08:00\"},\"productos\":[{\"nombre\":\"Martillo\"},{\"nombre\":\"Clavo\"}],\"servers\":{\"alpha\":{\"ip\":\"10.0.0.1\"}},\"title\":\"TOML\"}", "TOML completo")
sea n = ajustes_toml("a = 0xDEAD_BEEF\nb = 0o755\nc = 0b1010\nd = 1_000\ne = -2E-2\nf = 224_617.445_991_228\ng = \"\\u00E9\\t\"\nh = '''\nx\\y'''\ni = \"\"\"\\\n   uno \\\n   dos\"\"\"")
igual([n["a"], n["b"], n["c"], n["d"], n["e"], n["f"], n["g"], n["h"], n["i"]], [3735928559, 493, 10, 1000, -0.02, 224617.445991228, "é\t", "x\\y", "uno dos"], "números y textos")
igual(ajustes_toml("x = 07:32:00", {"fechas": "tipadas"})["x"]["tipo"], "hora", "fechas tipadas")
falla(funcion() { ajustes_toml("a = 1\na = 2") }, "clave duplicada 'a' (línea 2, columna 1)", "duplicada")
falla(funcion() { ajustes_toml("[t]\n[t]") }, "ya se definió", "tabla repetida")
falla(funcion() { ajustes_toml("x = 01") }, "ceros a la izquierda", "ceros")
falla(funcion() { ajustes_toml("x = {a=1,}") }, "coma final", "coma final")
falla(funcion() { ajustes_toml("x = 2000-02-30") }, "fecha u hora inválida", "fecha imposible")
falla(funcion() { ajustes_toml("[[a]]\n[a]") }, "arreglo de tablas", "arreglo de tablas")
igual(json_texto(ajustes_toml(ajustes_a_toml(t))), json_texto(t), "TOML ida y vuelta")
igual(ajustes_a_toml({"a": 1, "b": {"c": [1, 2], "d": {"e": "x y"}}}), "a = 1\n\n[b]\nc = [1, 2]\n\n[b.d]\ne = \"x y\"\n", "escribir TOML")
// YAML 1.2 (resultados comparados con ruamel.yaml).
sea y = ajustes_yaml("# config\nnombre: Vemoris\nversion: 1.2\nvacio:\nlista:\n  - uno\n  - 2\nmapa: {a: 1, b: [x, y], \"c d\": 'it''s'}\nsi: yes\noctal: 0o17\ninf: .inf\n")
igual(json_texto(y), "{\"inf\":" + json_texto(1e308 * 10) + ",\"lista\":[\"uno\",2],\"mapa\":{\"a\":1,\"b\":[\"x\",\"y\"],\"c d\":\"it's\"},\"nombre\":\"Vemoris\",\"octal\":15,\"si\":\"yes\",\"vacio\":null,\"version\":1.2}", "YAML básico")
sea anc = ajustes_yaml("base: &b\n  host: localhost\n  puerto: 5432\nprod:\n  <<: *b\n  host: db.prod\n")
igual([anc["prod"]["host"], anc["prod"]["puerto"]], ["db.prod", 5432], "anclas y <<")
sea bl = ajustes_yaml("literal: |\n  uno\n  dos\nplegado: >\n  esto es\n  una frase\n\n  otro\nsin: |-\n  abc\n")
igual([bl["literal"], bl["plegado"], bl["sin"]], ["uno\ndos\n", "esto es una frase\notro\n", "abc"], "bloques")
sea sec = ajustes_yaml("- a\n- - b\n  - c\n- d: 1\n  e: 2\n-\n- [1, {x: 2}]\n")
igual(json_texto(sec), "[\"a\",[\"b\",\"c\"],{\"d\":1,\"e\":2},null,[1,{\"x\":2}]]", "secuencias")
igual(longitud(ajustes_yaml_todos("---\na: 1\n---\nb: 2\n...\n")), 2, "varios documentos")
falla(funcion() { ajustes_yaml("a: 1\na: 2") }, "clave duplicada", "YAML duplicada")
falla(funcion() { ajustes_yaml("a:\n  b: 1\n c: 2") }, "sangría inesperada", "sangría")
falla(funcion() { ajustes_yaml("a: *nada") }, "alias desconocido", "alias")
sea raro = {"n": nulo, "t": "yes", "u": "a: b", "v": "línea\notra\n", "w": [], "x": {"y": [{"z": 1}, 2]}, "num": "12"}
igual(json_texto(ajustes_yaml(ajustes_a_yaml(raro))), json_texto(raro), "YAML ida y vuelta")
// Utilidades.
igual(json_texto(ajustes_mezclar({"a": {"b": 1, "c": 2}, "d": 1}, {"a": {"c": 3}})), "{\"a\":{\"b\":1,\"c\":3},\"d\":1}", "mezclar")
igual(ajustes_entorno({"url": "postgres://" + LL + "USUARIO:-ana" + RR + "@" + LL + "HOST" + RR + "/db"}, {"HOST": "db.cl"})["url"], "postgres://ana@db.cl/db", "variables")
falla(funcion() { ajustes_entorno(LL + "FALTA" + RR, {}) }, "falta la variable", "variable faltante")
escribir_archivo("/tmp/cforge_ajustes_a.toml", "[servidor]\npuerto = 80\nhost = \"" + LL + "HOST:-0.0.0.0" + RR + "\"\n")
escribir_archivo("/tmp/cforge_ajustes_b.yaml", "servidor:\n  puerto: 8080\n")
sea c = ajustes_cargar(["/tmp/cforge_ajustes_a.toml", "/tmp/cforge_ajustes_b.yaml", "/tmp/no_existe.yaml"], {"entorno": verdadero, "variables": {}, "opcional": verdadero})
igual([ajustes_obtener(c, "servidor.puerto", 0), ajustes_obtener(c, "servidor.host", ""), ajustes_obtener(c, "x.y", "def")], [8080, "0.0.0.0", "def"], "cargar y obtener")
mostrar("[OK] ajustes")
