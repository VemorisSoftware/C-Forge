// Pruebas de tuberia: descripción gst-launch, audio (WAV verificable con el
// módulo wave de Python), level, conversión y remuestreo, video y PNG.
importar "tuberia"
importar "imagen"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

sea d = tuberia_analizar("audiotestsrc freq=440 wave=square num-buffers=2 ! audio/x-raw,rate=8000,channels=2 ! filesink location=\"a b.raw\"")
eq(longitud(d), 3, "elementos")
eq(d[0]["props"]["wave"], "square", "texto")
eq(d[0]["props"]["freq"], 440, "número")
eq(d[1]["elemento"], "capsfilter", "caps")
eq(d[1]["props"]["caps"]["rate"], 8000, "rate")
eq(d[2]["props"]["location"], "a b.raw", "comillas")
eq(tuberia_analizar("videotestsrc ! video/x-raw,framerate=30/2 ! fakesink")[1]["props"]["caps"]["framerate"], 15, "framerate")

// Seno 440 Hz a 16 kHz, volumen 0.5 → 0.4 de amplitud.
sea dir = "/tmp"
sea r = tuberia_lanzar("audiotestsrc freq=440 num-buffers=4 samplesperbuffer=400 ! audio/x-raw,rate=16000,channels=1 ! volume volume=0.5 ! level ! wavenc ! filesink location=" + dir + "/cforge_tub_la.wav")
eq(r["estado"], "eos", "eos")
eq(longitud(r["mensajes"]), 5, "4 level + eos")
afirmar(absoluto(r["mensajes"][0]["rms"][0] - -10.969100130080564) < 1e-9, "rms dB")
afirmar(absoluto(r["mensajes"][0]["pico"][0] - -7.958800173440752) < 1e-9, "pico dB")
sea wav = leer_archivo(dir + "/cforge_tub_la.wav")
eq(longitud(wav), 44 + 3200, "tamaño WAV")
eq(subtexto(wav, 0, 4) + subtexto(wav, 8, 16), "RIFFWAVEfmt ", "cabecera")
eq(bytes_leer_entero(wav, 24, 4, 1), 16000, "rate en cabecera")
sea ok = verdadero
para i en lista_rango(0, 1600) {
    sea v = bytes_leer_entero(wav, 44 + 2 * i, 2, 1)
    si (v >= 32768) { v = v - 65536 }
    sea ref = 0.4 * seno(2 * 3.141592653589793 * 440 * i / 16000) * 32767
    si (absoluto(v - ref) > 0.5) { ok = falso }
}
afirmar(ok, "muestras del seno")

// Lectura, mono → estéreo y 16 kHz → 8 kHz.
sea r2 = tuberia_lanzar("filesrc location=" + dir + "/cforge_tub_la.wav ! wavparse ! audioconvert ! audio/x-raw,channels=2 ! audioresample ! audio/x-raw,rate=8000 ! appsink name=s")
eq(r2["estado"], "eos", "eos 2")
sea b = r2["sumideros"]["s"][0]
eq([b["rate"], b["channels"], longitud(b["datos"][0])], [8000, 2, 800], "remuestreo")
afirmar(absoluto(b["datos"][1][3] - 0.4 * seno(2 * 3.141592653589793 * 440 * 6 / 16000)) < 1e-4, "muestra remuestreada")

// Video: barras SMPTE volteadas a PNG.
sea r3 = tuberia_lanzar("videotestsrc pattern=smpte num-buffers=2 ! video/x-raw,width=70,height=20,framerate=10/1 ! videoflip method=horizontal-flip ! pngenc ! multifilesink location=" + dir + "/cforge_tub_f%05d.png")
eq(r3["estado"], "eos", "eos 3")
sea img = imagen_decodificar(leer_archivo(dir + "/cforge_tub_f00001.png"))
eq([img["ancho"], img["alto"]], [70, 20], "tamaño PNG")
eq(imagen_pixel(img, 0, 0), [0, 0, 192, 255], "barra azul a la izquierda")
eq(imagen_pixel(img, 69, 19), [192, 192, 192, 255], "barra gris a la derecha")
sea v = tuberia_lanzar("videotestsrc pattern=checkers-8 ! video/x-raw,width=16,height=16 ! appsink")
eq(imagen_pixel(v["sumideros"]["appsink"][0]["imagen"], 8, 0), [0, 0, 0, 255], "damero")

// Errores.
sea neg = tuberia_lanzar("audiotestsrc num-buffers=1 ! audio/x-raw,rate=8000 ! video/x-raw ! fakesink")
eq(neg["estado"], "error", "caps incompatibles")
afirmar(texto_contiene(neg["error"], "incompatibles"), neg["error"])
sea error = ""
intentar { tuberia_lanzar("fakesrc ! fakesink") } capturar (x) { error = x }
afirmar(texto_contiene(error, "desconocido"), "elemento desconocido")
afirmar(lista_contiene(tuberia_elementos(), "wavenc"), "elementos")
mostrar("[OK] tuberia")
