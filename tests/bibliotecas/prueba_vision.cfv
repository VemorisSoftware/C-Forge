// Pruebas de vision. datos/vision/esperado.json sale de OpenCV 5.0 (cv2)
// sobre escena.png: color, umbrales, filtros, Canny, morfología,
// componentes, contornos, momentos, integral, histograma, plantillas y
// redimensionado. Todo es idéntico salvo el gaussiano con σ > 0 (OpenCV
// cuantiza el núcleo a punto fijo): diferencia máxima de 1.
importar "vision"
importar "json"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion casi(a, b, tol, q) {
    eq(longitud(a), longitud(b), q + " (largo)")
    para i en lista_rango(0, longitud(a)) { afirmar(absoluto(a[i] - b[i]) <= tol, q + "[" + i + "]: " + a[i] + " vs " + b[i]) }
}

sea D = "tests/bibliotecas/datos/vision/"
sea e = json_parsear(leer_archivo(D + "esperado.json"))
sea m = vision_desde_imagen(imagen_cargar(D + "escena.png"))
sea g = vision_gris(m)
eq(g["datos"], e["gris"], "gris")
eq(vision_hsv(m)["datos"], e["hsv"], "hsv")
sea o = vision_umbral(g, 0, 255, "otsu")
eq(o["umbral"], e["otsu"], "umbral de Otsu")
eq(o["imagen"]["datos"], e["otsu_img"], "binarización de Otsu")
eq(vision_umbral(g, 120, 255, "truncar")["imagen"]["datos"], e["umbral_trunc"], "truncar")
eq(vision_umbral_adaptativo(g, 255, 11, 2, falso)["datos"], e["adaptativo"], "umbral adaptativo")
eq(vision_caja(g, 5, nulo)["datos"], e["caja5"], "caja")
eq(vision_gauss(g, 5, 0)["datos"], e["gauss5"], "gauss 5 × 5")
casi(vision_gauss(g, 7, 2.0)["datos"], e["gauss7s2"], 1, "gauss σ = 2")
eq(vision_mediana(g, 5)["datos"], e["mediana5"], "mediana")
eq(vision_sobel(g, 1, 0)["datos"], e["sobelx"], "Sobel x")
eq(vision_sobel(g, 0, 1)["datos"], e["sobely"], "Sobel y")
eq(vision_laplaciano(g)["datos"], e["laplaciano"], "Laplaciano")
eq(vision_canny(g, 60, 140)["datos"], e["canny"], "Canny")
sea b = o["imagen"]
eq(vision_erosion(b, 3)["datos"], e["erosion"], "erosión")
eq(vision_dilatacion(b, 3)["datos"], e["dilatacion"], "dilatación")
eq(vision_apertura(b, 3)["datos"], e["apertura"], "apertura")
eq(vision_cierre(b, 3)["datos"], e["cierre"], "cierre")
eq(vision_gradiente_morfologico(g, 3)["datos"], e["gradiente"], "gradiente")
sea cc = vision_componentes(b, 8)
eq(cc["estadisticas"], e["comp_stats"], "estadísticas de componentes")
eq(cc["etiquetas"]["datos"], e["comp_lab"], "etiquetas")
casi(cc["centroides"][1], e["comp_cent"][1], 1e-9, "centroide")
sea cs = []
para c en vision_contornos(b) {
    sea inf = vision_contorno_info(c)
    cs.agregar([inf["caja"], longitud(c), inf["area"]])
}
cs = ordenar(cs, funcion(p, q) { retornar si(("" + p) < ("" + q), -1, 1) })
sea ec = ordenar(e["contornos"], funcion(p, q) { retornar si(("" + p) < ("" + q), -1, 1) })
eq(cs, ec, "contornos")
sea mo = vision_momentos(g)
para k en claves(e["momentos"]) { afirmar(absoluto(mo[k] - e["momentos"][k]) <= 1e-6 * absoluto(e["momentos"][k]) + 1e-6, "momento " + k) }
eq(vision_integral(g)["datos"], e["integral"], "integral")
eq(vision_ecualizar(g)["datos"], e["ecualizar"], "ecualizar")
sea tpl = vision_matriz(12, 14, 1, 0)
para f en lista_rango(0, 12) {
    para c en lista_rango(0, 14) { tpl["datos"][f * 14 + c] = g["datos"][(20 + f) * 64 + 38 + c] }
}
para mt en ["sqdiff", "ccorr_normed", "ccoeff_normed"] {
    sea r = vision_buscar_plantilla(g, tpl, mt)
    eq(r["mejor"], e["tpl_" + mt][0], "plantilla " + mt)
    afirmar(absoluto(r["valor"] - e["tpl_" + mt][1]) < 1e-6, "valor de plantilla " + mt)
}
eq(vision_redimensionar(m, 16, 12, "area")["datos"], e["area"], "redimensionar por área")
eq(vision_redimensionar(m, 21, 17, "cercano")["datos"], e["cercano"], "redimensionar al más cercano")
sea img = vision_a_imagen(g)
eq([img["ancho"], img["alto"], byte_en(img["pixeles"], 0) == g["datos"][0]], [64, 48, verdadero], "vuelta a imagen")
mostrar("[OK] vision")
