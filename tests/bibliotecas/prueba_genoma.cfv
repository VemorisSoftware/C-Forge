importar "genoma"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea f = genoma_fasta(">sec1 primera\nATGGCC\natt gta\n; comentario\n>sec2\nGGGCCC\n")
igual([f[0]["id"], f[0]["descripcion"], f[0]["secuencia"], f[1]["secuencia"]], ["sec1", "primera", "ATGGCCATTGTA", "GGGCCC"], "leer FASTA")
igual(genoma_escribir_fasta(f, 4), ">sec1 primera\nATGG\nCCAT\nTGTA\n>sec2\nGGGC\nCC\n", "escribir FASTA")
igual(genoma_fastq("@r1 x\nACGT\n+\nII#I\n")[0]["calidad"], [40, 40, 2, 40], "FASTQ Phred+33")
igual(genoma_complemento_reverso("ATGCRN"), "NYGCAT", "complemento reverso con IUPAC")
igual(redondear(genoma_gc("GGCCAT"), 4), 0.6667, "contenido GC")
// Igual que Biopython: Seq(...).translate()
igual(genoma_traducir("ATGGCCATTGTAATGGGCCGCTGAAAGGGTGCCCGATAG"), "MAIVMGR*KGAR*", "traducir")
igual(genoma_traducir("ATGGCCATTGTAATGGGCCGCTGAAAG", verdadero), "MAIVMGR", "traducir hasta la parada")
igual(genoma_traducir("AUGUUUNNN"), "MFX", "ARN y codón ambiguo")
igual(genoma_marcos("ATGGCCATTGTAATGGG")["-1"], "PITMA", "marco -1")
sea o = genoma_orfs("CCATGAAATTTGGGTAACC" + "TTACCCAAATTTCATGG", 3)
igual([o[0]["hebra"], o[0]["inicio"], o[0]["fin"], o[0]["proteina"], o[1]["hebra"], o[1]["inicio"]], ["+", 2, 17, "MKFG", "-", 19], "ORFs en ambas hebras")
igual(genoma_kmeros("ATATAT", 2), {"AT": 3, "TA": 2}, "k-meros")
igual(genoma_buscar("GAATTCGAGTTC", "GARTTC"), [0, 6], "motivo IUPAC")
sea g = genoma_alinear("GATTACA", "GCATGCU")
igual([g["a"], g["b"], g["puntaje"]], ["G-ATTACA", "GCA-TGCU", 0], "Needleman–Wunsch")
sea l = genoma_alinear("TGTTACGG", "GGTTGACTA", {"local": verdadero, "coincide": 3, "distinto": -3, "hueco": -2})
igual([l["a"], l["b"], l["puntaje"]], ["GTT-AC", "GTTGAC", 13], "Smith–Waterman")
igual(redondear(genoma_peso_proteina("MA"), 2), 220.28, "peso de proteína")
sea m = ""
intentar { genoma_fasta("ATG\n") } capturar (e) { m = e }
igual(m, "genoma: el FASTA debe empezar con '>'", "FASTA sin cabecera")
intentar { genoma_fastq("@a\nAC\n+\nI\n") } capturar (e) { m = e }
igual(m, "genoma: la calidad no mide lo mismo que la secuencia en @a", "FASTQ mal medido")
mostrar("[OK] genoma")
