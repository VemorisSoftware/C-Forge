// Pruebas de territorio. Los Shapefile de datos/territorio-* los armó pyshp
// y los WKB de referencia salen de Shapely 2.2.
importar "territorio"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

// Leer Shapefile (polígono con hueco, multipolígono, atributos UTF-8, fecha, lógico).
sea c = territorio_leer_shp("tests/bibliotecas/datos/territorio-comunas")
eq([c["tipo_shp"], longitud(c["entidades"]), c["campos"][2]], [5, 2, {"decimales": 4, "largo": 12, "nombre": "AREA", "tipo": "F"}], "cabecera y campos")
afirmar(texto_empieza_con(c["prj"], "GEOGCS[\"GCS_WGS_1984\""), "prj")
sea e0 = c["entidades"][0]
eq(e0["atributos"], {"AREA": 16.9, "CAPITAL": verdadero, "FUNDADA": "1894-12-21", "NOMBRE": "Ñuñoa", "POBLACION": 208237}, "atributos")
eq(e0["geometria"], {"coordenadas": [[[0, 0], [0, 10], [10, 10], [10, 0], [0, 0]], [[2, 2], [4, 2], [4, 4], [2, 4], [2, 2]]], "tipo": "Polygon"}, "polígono con hueco")
eq(c["entidades"][1]["geometria"]["tipo"], "MultiPolygon", "multipolígono")
eq([territorio_area(e0["geometria"]), territorio_area(c["entidades"][1]["geometria"])], [96, 50], "áreas")
eq([territorio_contiene(e0["geometria"], [1, 1]), territorio_contiene(e0["geometria"], [3, 3]), territorio_contiene(c["entidades"][1]["geometria"], [32, 2])], [verdadero, falso, verdadero], "contiene (con hueco)")
eq(territorio_limites(c), [0, 0, 35, 10], "límites de la capa")
sea rutas = territorio_leer_shp("tests/bibliotecas/datos/territorio-rutas")
eq(rutas["entidades"][0]["geometria"], {"coordenadas": [[0, 0, 1], [1, 1, 2], [2, 0, 3]], "tipo": "LineString"}, "línea con Z")
eq(rutas["entidades"][1]["geometria"]["tipo"], "MultiLineString", "varias partes")
sea pts = territorio_leer_shp("tests/bibliotecas/datos/territorio-puntos.shp")
eq([pts["entidades"][0]["geometria"]["coordenadas"], pts["entidades"][1]["atributos"]["N"], pts["entidades"][2]["geometria"]], [[-70.65, -33.45], "Valparaí", nulo], "puntos y geometría nula")

// Escribir y volver a leer (pyshp también lee estos archivos).
sea base = (variable_entorno("TMPDIR") ?? "/tmp")
si (base == "") { base = "/tmp" }
sea salida = base + "/territorio-" + hex_de_bytes(bytes_aleatorios(5))
territorio_escribir_shp(c, salida)
sea c2 = territorio_leer_shp(salida)
eq(json_texto(c2["entidades"]), json_texto(c["entidades"]), "ida y vuelta del Shapefile")
eq(c2["prj"], c["prj"], "prj copiado")
eq(texto_recortar(leer_archivo(salida + ".cpg")), "UTF-8", "cpg")
// Orientación: un exterior antihorario se guarda horario y vuelve igual de área.
sea nueva = territorio_capa([{"nombre": "nombre_largo_de_campo", "tipo": "C", "largo": 5}, {"nombre": "x", "tipo": "F", "decimales": 2}], nulo)
territorio_agregar(nueva, {"tipo": "Polygon", "coordenadas": [[[0, 0], [4, 0], [4, 4], [0, 4], [0, 0]]]}, {"nombre_largo_de_campo": "ñandú", "x": 3.14159})
territorio_escribir_shp(nueva, salida + "b")
sea leida = territorio_leer_shp(salida + "b")
eq([territorio_area(leida["entidades"][0]["geometria"]), leida["entidades"][0]["atributos"]], [16, {"nombre_lar": "ñand", "x": 3.14}], "orientación, nombres de 10 letras y textos cortados sin partir UTF-8")

// WKT y WKB.
sea casos = [
    ["POINT (1 2)", "0101000000000000000000f03f0000000000000040"],
    ["LINESTRING (0 0, 1 1, 2 0)", "01020000000300000000000000000000000000000000000000000000000000f03f000000000000f03f00000000000000400000000000000000"],
    ["MULTIPOINT ((1 2), (3 4))", "0104000000020000000101000000000000000000f03f0000000000000040010100000000000000000008400000000000001040"],
    ["POINT Z (1 2 3)", "0101000080000000000000f03f00000000000000400000000000000840"],
    ["GEOMETRYCOLLECTION (POINT (1 2), LINESTRING (0 0, 1 1))", "0107000000020000000101000000000000000000f03f000000000000004001020000000200000000000000000000000000000000000000000000000000f03f000000000000f03f"]
]
para k en casos {
    sea g = territorio_de_wkt(k[0])
    eq(territorio_a_wkt(g), k[0], "WKT " + k[0])
    eq(hex_de_bytes(territorio_a_wkb(g, falso)), k[1], "WKB " + k[0])
    eq(territorio_a_wkt(territorio_de_wkb(bytes_de_hex(k[1]))), k[0], "de WKB " + k[0])
}
// La Z de WKB ISO es 1000 + tipo; la de EWKB/GEOS, el bit alto (la que se escribe).
eq(territorio_a_wkt(territorio_de_wkb(bytes_de_hex("01e9030000000000000000f03f00000000000000400000000000000840"))), "POINT Z (1 2 3)", "WKB ISO con Z")
eq(hex_de_bytes(territorio_a_wkb(territorio_de_wkt("POINT (1 2)"), verdadero)), "00000000013ff00000000000004000000000000000", "WKB big endian")
eq(territorio_a_wkt(territorio_de_wkb(bytes_de_hex("00000000013ff00000000000004000000000000000"))), "POINT (1 2)", "de WKB big endian")
sea poli = "POLYGON ((0 0, 10 0, 10 10, 0 10, 0 0), (2 2, 2 4, 4 4, 4 2, 2 2))"
eq(territorio_a_wkt(territorio_de_wkb(territorio_a_wkb(territorio_de_wkt(poli), falso))), poli, "polígono por WKB")
eq(territorio_a_wkt(territorio_de_wkt("MULTIPOINT (1 2, 3 4)")), "MULTIPOINT ((1 2), (3 4))", "MULTIPOINT sin paréntesis internos")
eq(territorio_a_wkt(territorio_de_wkt("LINESTRING (0.5 -1.25, 1e3 2)")), "LINESTRING (0.5 -1.25, 1000 2)", "decimales y exponentes")
eq(territorio_de_wkt("POLYGON EMPTY")["coordenadas"], [], "EMPTY")

// GeoJSON y reproyección.
sea gj = territorio_a_geojson(c)
afirmar(texto_contiene(gj, "\"type\":\"FeatureCollection\"") y texto_contiene(gj, "\"Ñuñoa\""), "a GeoJSON")
sea c3 = territorio_de_geojson(gj)
eq(json_texto(c3["entidades"]), json_texto(c["entidades"]), "GeoJSON ida y vuelta")
eq(territorio_de_geojson("\{\"type\":\"Point\",\"coordinates\":[1,2]}")["entidades"][0]["geometria"], {"coordenadas": [1, 2], "tipo": "Point"}, "geometría suelta")
sea web = territorio_reproyectar(pts, "EPSG:4326", "EPSG:3857")
afirmar(absoluto(web["entidades"][0]["geometria"]["coordenadas"][0] - 6378137 * (-70.65) * 3.141592653589793 / 180) < 0.001, "reproyectar a Web Mercator")
eq(longitud(territorio_filtrar(pts, funcion(e) { retornar e["geometria"] != nulo })["entidades"]), 2, "filtrar")
sistema_borrar_vw(salida)
funcion sistema_borrar_vw(s) {
    para ext en [".shp", ".shx", ".dbf", ".cpg", ".prj", "b.shp", "b.shx", "b.dbf", "b.cpg"] { intentar { eliminar_archivo(s + ext) } capturar (e) { } }
}
mostrar("[OK] territorio")
