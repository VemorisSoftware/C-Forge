importar "compacta"
importar "base64"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Comprimidos con las librerías zstandard, lz4, cramjam y gzip de Python.
sea Z19 = base64_decodificar("")
sea Z1 = base64_decodificar("")
sea L4 = base64_decodificar("")
sea SN = base64_decodificar("")
sea GZ = base64_decodificar("")
sea partes = []
sea i = 0
mientras (i < 200) {
    partes.agregar("línea " + i + ": el veloz murciélago hindú comía feliz cardillo y kiwi " + ((i * i) % 97) + "\n")
    i = i + 1
}
sea ORIG = unir(partes, "")
igual(longitud(ORIG), 14256, "texto original")
igual(compacta_zstd_descomprimir(Z19) == ORIG, verdadero, "zstd nivel 19 (Huffman y FSE)")
igual(compacta_zstd_descomprimir(Z1) == ORIG, verdadero, "zstd nivel 1 con suma")
igual(compacta_zstd_tamano(Z19), 14256, "tamaño declarado")
igual(compacta_lz4_descomprimir(L4) == ORIG, verdadero, "lz4")
igual(compacta_snappy_descomprimir(SN) == ORIG, verdadero, "snappy")
igual(compacta_gunzip(GZ) == ORIG, verdadero, "gzip")
// Ida y vuelta (los resultados también los abren las librerías de Python).
para t en ["", "a", ORIG, "xyz" + ORIG + ORIG] {
    igual(compacta_zstd_descomprimir(compacta_zstd_comprimir(t)) == t, verdadero, "zstd propio")
    igual(compacta_lz4_descomprimir(compacta_lz4_comprimir(t)) == t, verdadero, "lz4 propio")
    igual(compacta_snappy_descomprimir(compacta_snappy_comprimir(t)) == t, verdadero, "snappy propio")
    igual(compacta_gunzip(compacta_gzip(t)) == t, verdadero, "gzip propio")
}
afirmar(longitud(compacta_lz4_comprimir(ORIG)) < longitud(ORIG) / 4, "lz4 comprime")
afirmar(longitud(compacta_snappy_comprimir(ORIG)) < longitud(ORIG) / 4, "snappy comprime")
sea rep = ""
i = 0
mientras (i < 1000) { rep = rep + "z"  i = i + 1 }
afirmar(longitud(compacta_zstd_comprimir(rep)) < 30, "zstd RLE")
igual([compacta_crc32(ORIG), compacta_adler32(ORIG)], [1074144725, 1712095420], "CRC-32 y Adler-32")
igual([compacta_xxh32(""), compacta_xxh32("hola mundo"), compacta_xxh32("abcdefghijklmnopqrstuvwxyz0123456789")], [46947589, 948480564, 1118732365], "XXH32")
sea malo = falso
intentar { compacta_zstd_descomprimir("no es zstd") } capturar (e) { malo = verdadero }
igual(malo, verdadero, "datos inválidos")
sea grande = falso
intentar { compacta_zstd_descomprimir(Z19, {"maximo": 1000}) } capturar (e) { grande = verdadero }
igual(grande, verdadero, "límite de salida")
mostrar("[OK] compacta")
