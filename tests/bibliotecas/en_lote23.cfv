// English aliases for batch 23.
importar "parallel"
importar "asyncrt"
importar "pipeline"
importar "canvasobjects"
importar "lottie"
importar "iouring"
importar "skeleton2d"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// parallel
eq(par_map([1, 2, 3, 4], funcion(x) { retornar x * 10 }, {"threads": 2}), [10, 20, 30, 40], "par_map")
eq([par_sum([1, 2, 3]), par_sort([3, 1, 2], nulo, nulo), par_join(funcion() { retornar "a" }, funcion() { retornar "b" })], [6, [1, 2, 3], ["a", "b"]], "parallel")
// asyncrt
sea h = rt_spawn(funcion() { retornar 5 })
eq(rt_join(h, 2000), 5, "rt_join")
sea ch = rt_channel(0)
rt_spawn(funcion() { rt_send(ch, "msg") })
eq(rt_recv(ch, 2000), "msg", "rt_recv")
eq(rt_timeout(funcion() {
    hilo_dormir(200)
    retornar 1
}, 10)["ok"], falso, "rt_timeout")
// pipeline
sea c = pipe_embedded([["lines", pipe_line_decoder(100)], ["up", pipe_handler({"read": funcion(ctx, m) { pipe_write(ctx, texto_mayusculas(m)) }})]])
pipe_embedded_write_inbound(c, "abc\ndef\n")
eq(pipe_embedded_read(c)["outbound"], ["ABC", "DEF"], "pipeline")
// canvasobjects
sea pz = fab_canvas(200, 100)
sea r = fab_add(pz, fab_rect({"left": 10, "top": 10, "width": 50, "height": 20, "fill": "#ff0000", "name": "r"}))
eq([fab_bounding_box(r), fab_find_target(pz, 20, 20)["nombre"]], [[10, 10, 60, 30], "r"], "canvasobjects")
fab_mouse(pz, "down", 20, 20, nulo)
fab_mouse(pz, "move", 40, 50, nulo)
fab_mouse(pz, "up", 40, 50, nulo)
eq(fab_bounding_box(r), [30, 40, 80, 60], "drag")
// lottie
sea a = lottie_load(json_texto({"fr": 24, "ip": 0, "op": 48, "w": 10, "h": 10, "layers": []}))
eq([lottie_info(a)["frames"], lottie_info(a)["seconds"]], [48, 2], "lottie")
eq(lottie_value({"a": 1, "k": [{"t": 0, "s": [0], "i": {"x": [1], "y": [1]}, "o": {"x": [0], "y": [0]}}, {"t": 4, "s": [8]}]}, 2), [4], "lottie_value")
// iouring
si (uring_available()) {
    sea ring = uring_new(8)
    uring_nop(ring, "x")
    eq(uring_wait(ring, 1)[0]["user_data"], "x", "uring_wait")
    uring_write_file("/tmp/cforge_en_uring.txt", "hello")
    eq(uring_read_file("/tmp/cforge_en_uring.txt", nulo), "hello", "uring_read_file")
    eliminar_archivo("/tmp/cforge_en_uring.txt")
    uring_destroy(ring)
}
// skeleton2d
sea sk = skel_load({"skeleton": {"spine": "4.1"}, "bones": [{"name": "root"}, {"name": "arm", "parent": "root", "rotation": 90, "length": 10}, {"name": "hand", "parent": "arm", "x": 10}],
    "slots": [], "skins": [], "animations": {"wave": {"bones": {"arm": {"rotate": [{"time": 0}, {"time": 1, "value": -90}]}}}}})
eq([skel_animations(sk), skel_duration(sk, "wave")], [["wave"], 1], "skeleton2d")
sea st = skel_state(sk)
skel_state_set(st, 0, "wave", falso)
skel_state_update(st, 1)
skel_state_apply(st)
sea hb = skel_bone(sk, "hand")
eq([redondear(hb["x"]), redondear(hb["y"]), skel_state_track(st, 0)["animation"]], [10, 0, "wave"], "skel_state")
mostrar("[OK] en_lote23")
