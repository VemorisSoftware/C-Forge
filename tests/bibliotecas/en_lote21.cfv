// English aliases for batch 21.
importar "vectorgfx"
importar "vad"
importar "shaping"
importar "eventloop"
importar "dap"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// vectorgfx
sea c = vgfx_new("png", 20, 20, {"background": "#ffffff"})
vgfx_rect(c, 0, 0, 10, 10)
vgfx_color(c, "#ff0000")
vgfx_fill(c)
vgfx_move_to(c, 0, 15)
vgfx_line_to(c, 20, 15)
vgfx_cap(c, "square")
vgfx_line_width(c, 2)
vgfx_color(c, "#0000ff")
vgfx_stroke(c)
eq([imagen_pixel(vgfx_canvas(c), 5, 5), imagen_pixel(vgfx_canvas(c), 10, 15)], [[255, 0, 0, 255], [0, 0, 255, 255]], "vectorgfx")
sea s = vgfx_new("svg", 10, 10, nulo)
vgfx_circle(s, 5, 5, 4)
vgfx_fill(s)
eq(contiene(vgfx_finish(s), "<path d="), verdadero, "svg")
// vad
sea v = vad_new(3)
sea silencio = ""
sea i = 0
mientras (i < 160) {
    silencio = silencio + caracter(0) + caracter(0)
    i = i + 1
}
eq([vad_valid_frame(8000, 160), vad_is_speech(v, silencio, 8000)], [verdadero, falso], "vad")
// shaping
sea f = shaping_font(leer_archivo("tests/bibliotecas/datos/DejaVuSans-grafia.ttf"))
sea g = shaping_shape(f, "fi AV", {"features": {"kern": falso}})
eq([longitud(g), g[0]["glyph"], g[3]["x_advance"]], [4, 124, 1401], "shaping")
// eventloop
sea b = loop_new()
sea orden = []
loop_timer(b, 5, 0, funcion(t) { orden.agregar("timer") })
loop_next_tick(b, funcion() { orden.agregar("tick") })
loop_run(b, nulo)
eq(orden, ["tick", "timer"], "eventloop")
// dap
sea sim = dap_mock("/a.py", [[1, {"x": 1}], [2, {"x": 2}]])
sea d = dap_connect(nulo, nulo, {"transport": sim["transporte"]})
dap_initialize(d, nulo)
sea l = dap_send(d, "launch", {"program": "/a.py"})
dap_wait_event(d, "initialized", nulo)
dap_set_breakpoints(d, "/a.py", [2])
dap_configuration_done(d)
dap_response(d, l)
dap_wait_event(d, "stopped", nulo)
eq(dap_locals(d, dap_stack(d, 1)[0]["id"]), {"x": "2"}, "dap")
mostrar("[OK] en_lote21")
