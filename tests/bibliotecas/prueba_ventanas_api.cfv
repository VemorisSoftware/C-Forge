// Pruebas de ventanas_api. Lo de formatos corre en cualquier sistema; lo de
// Win32, solo en Windows (el CI de Windows corre este archivo).
importar "ventanas_api"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

// UTF-16 con pares sustitutos.
eq(hex_de_bytes(ventanas_utf16("Añ😀")), "4100f1003dd800de0000", "UTF-16LE")
eq(ventanas_desde_utf16(ventanas_utf16("Añ😀 ok")), "Añ😀 ok", "ida y vuelta")
eq(ventanas_desde_utf16(bytes_de_hex("41003dd84200")), "A" + caracter(65533) + "B", "sustituto suelto")
// GUID.
sea g = ventanas_guid_bytes("\{6B29FC40-CA47-1067-B31D-00DD010662DA}")
eq(hex_de_bytes(g), "40fc296b47ca6710b31d00dd010662da", "GUID a bytes (orden de Windows)")
eq(ventanas_guid_texto(g), "\{6B29FC40-CA47-1067-B31D-00DD010662DA}", "GUID a texto")
sea nuevo = ventanas_guid_nuevo()
eq([longitud(nuevo), subtexto(nuevo, 15, 16)], [38, "4"], "GUID v4")
afirmar(texto_contiene("89AB", subtexto(nuevo, 20, 21)), "variante RFC 4122")
// HRESULT.
eq(ventanas_hresult_de_win32(5), 2147942405, "HRESULT_FROM_WIN32")
sea h = ventanas_hresult(-2147024891)
eq([h["hex"], h["falla"], h["facilidad"], h["codigo"], h["nombre"]], ["0x80070005", verdadero, 7, 5, "E_ACCESSDENIED"], "HRESULT negativo")
eq(ventanas_hresult(ventanas_hresult_de_win32(2))["texto"], "El sistema no puede encontrar el archivo especificado.", "texto de error Win32")
eq(ventanas_hresult(0)["nombre"], "S_OK", "S_OK")
// FILETIME.
eq(ventanas_ms_a_filetime(0), 116444736000000000, "época Unix en FILETIME")
eq(ventanas_filetime_a_ms(133500000000000000), 1705526400000, "FILETIME a ms")

// Archivos .reg.
sea reg = "Windows Registry Editor Version 5.00\r\n\r\n[HKEY_CURRENT_USER\\Software\\Prueba]\r\n@=\"por defecto\"\r\n\"Nombre\"=\"C-Forge \\\"5\\\" en C:\\\\Programas\"\r\n\"Veces\"=dword:0000002a\r\n\"Grande\"=hex(b):00,10,00,00,00,00,00,00\r\n\"Datos\"=hex:de,ad,\\\r\n  be,ef\r\n\"Ruta\"=hex(2):25,00,54,00,45,00,4d,00,50,00,25,00,00,00\r\n\"Lista\"=hex(7):61,00,00,00,62,00,63,00,00,00,00,00\r\n\"Viejo\"=-\r\n\r\n[-HKEY_CURRENT_USER\\Software\\Basura]\r\n"
sea r = ventanas_reg_leer(reg)
sea k = r["HKEY_CURRENT_USER\\Software\\Prueba"]
eq(k["@"]["datos"], "por defecto", "valor por defecto")
eq(k["Nombre"]["datos"], "C-Forge \"5\" en C:\\Programas", "REG_SZ con escapes")
eq([k["Veces"]["tipo"], k["Veces"]["datos"]], ["REG_DWORD", 42], "DWORD")
eq(k["Grande"]["datos"], 4096, "QWORD")
eq(hex_de_bytes(k["Datos"]["datos"]), "deadbeef", "binario con continuación de línea")
eq([k["Ruta"]["tipo"], k["Ruta"]["datos"]], ["REG_EXPAND_SZ", "%TEMP%"], "EXPAND_SZ")
eq(k["Lista"]["datos"], ["a", "bc"], "MULTI_SZ")
eq(k["Viejo"]["borrar"], verdadero, "valor a borrar")
eq(r["HKEY_CURRENT_USER\\Software\\Basura"]["borrar"], verdadero, "clave a borrar")
sea r2 = ventanas_reg_leer(ventanas_reg_escribir(r))
eq(json_texto(r2), json_texto(r), "escribir y volver a leer")
// regedit guarda en UTF-16 con BOM.
eq(ventanas_reg_leer(char_de(255) + char_de(254) + subtexto(ventanas_utf16("Windows Registry Editor Version 5.00\r\n[HKEY_LOCAL_MACHINE\\X]\r\n\"a\"=\"ñ\"\r\n"), 0, 200))["HKEY_LOCAL_MACHINE\\X"]["a"]["datos"], "ñ", "UTF-16 con BOM")

// PE: una DLL mínima armada a mano (objdump la lee igual).
sea pe = ventanas_pe_leer(leer_archivo("tests/bibliotecas/datos/ventanas-mini.dll"))
eq([pe["maquina"], pe["64bits"], pe["dll"], pe["subsistema"], pe["base"], pe["punto_entrada"], pe["fecha"]], ["x64", verdadero, verdadero, "gui", 6442450944, 4099, 1700000000], "cabeceras PE")
eq([pe["secciones"][0]["nombre"], pe["secciones"][1]["nombre"], pe["secciones"][1]["va"]], [".text", ".rdata", 8192], "secciones")
eq(pe["importaciones"], {"KERNEL32.dll": ["GetTickCount", "Sleep"], "USER32.dll": ["MessageBoxW"]}, "importaciones")
eq([pe["nombre_dll"], pe["exportaciones"][0]["nombre"], pe["exportaciones"][1]["nombre"], pe["exportaciones"][1]["rva"]], ["mini.dll", "Restar", "Sumar", 4099], "exportaciones")
sea fallo = ""
intentar { ventanas_pe_leer("no es un pe") } capturar (e) { fallo = "" + e }
afirmar(texto_contiene(fallo, "falta MZ"), "no es PE")
// El propio cforge.exe, si está compilado.
si (existe_archivo("dist-windows/cforge.exe")) {
    sea exe = ventanas_pe_leer(leer_archivo("dist-windows/cforge.exe"))
    eq([exe["maquina"], exe["dll"], exe["subsistema"]], ["x64", falso, "consola"], "cforge.exe")
    afirmar(tiene_clave(exe["importaciones"], "KERNEL32.dll") o tiene_clave(exe["importaciones"], "kernel32.dll"), "cforge.exe importa kernel32")
}

// Win32 (solo en Windows).
si (ventanas_es_windows()) {
    afirmar(longitud(ventanas_nombre_equipo()) > 0, "nombre del equipo")
    afirmar(longitud(ventanas_nombre_usuario()) > 0, "nombre del usuario")
    afirmar(ventanas_version()["mayor"] >= 10, "versión")
    afirmar(ventanas_memoria()["total"] > 0, "memoria")
    afirmar(ventanas_info_sistema()["procesadores"] >= 1, "procesadores")
    afirmar(ventanas_tiempo_encendido() > 0, "tiempo encendido")
    afirmar(texto_termina_con(texto_minusculas(ventanas_ruta_ejecutable()), ".exe"), "ruta del ejecutable")
    afirmar(ventanas_existe(ventanas_ruta_ejecutable()), "existe")
    afirmar(ventanas_carpeta("perfil") != nulo, "carpeta del perfil")
    afirmar(ventanas_fijar_entorno("CFORGE_PRUEBA_Ñ", "valor ñ 😀"), "fijar entorno")
    eq(ventanas_entorno("CFORGE_PRUEBA_Ñ"), "valor ñ 😀", "entorno Unicode")
    ventanas_fijar_entorno("CFORGE_PRUEBA_Ñ", nulo)
    eq(ventanas_entorno("CFORGE_PRUEBA_Ñ"), nulo, "borrar entorno")
    sea sub = "Software\\C-Forge\\Prueba " + ventanas_guid_nuevo()
    ventanas_registro_escribir("HKCU", sub, "Texto", "hola ñ", nulo)
    ventanas_registro_escribir("HKCU", sub, "Numero", 42, nulo)
    ventanas_registro_escribir("HKCU", sub, "Lista", ["a", "b"], nulo)
    ventanas_registro_escribir("HKCU", sub, "Grande", 5000000000, "REG_QWORD")
    eq([ventanas_registro_leer("HKCU", sub, "Texto"), ventanas_registro_leer("HKCU", sub, "Numero"), ventanas_registro_leer("HKCU", sub, "Lista"), ventanas_registro_leer("HKCU", sub, "Grande")],
        ["hola ñ", 42, ["a", "b"], 5000000000], "registro")
    eq(ordenar(ventanas_registro_listar("HKCU", sub)["valores"]), ["Grande", "Lista", "Numero", "Texto"], "listar valores")
    afirmar(ventanas_registro_borrar("HKCU", sub, "Texto"), "borrar valor")
    eq(ventanas_registro_leer("HKCU", sub, "Texto"), nulo, "valor borrado")
    para v en ["Numero", "Lista", "Grande"] { ventanas_registro_borrar("HKCU", sub, v) }
    afirmar(ventanas_registro_borrar("HKCU", sub, nulo), "borrar clave")
    eq(ventanas_registro_leer("HKCU", sub, "Numero"), nulo, "clave borrada")
    sea inst = ventanas_instancia_unica("cforge-prueba-" + ventanas_guid_nuevo())
    afirmar(inst["primera"], "instancia única")
    ventanas_soltar_instancia(inst)
    afirmar(ventanas_metrica("ancho_pantalla") >= 0, "métrica")
    afirmar(longitud(ventanas_texto_error(2)) > 0, "FormatMessage")
    mostrar("  (Win32 probado)")
}
mostrar("[OK] ventanas_api")
