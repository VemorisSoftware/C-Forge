importar "simbolo"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion s(t) { retornar simbolo_texto(simbolo_leer(t)) }
funcion d(t) { retornar simbolo_texto(simbolo_derivar(simbolo_leer(t), "x")) }
igual([s("2x + 3x - x"), s("x * x * x"), s("x/x"), s("0 * y + 1 * z"), s("2^3 + 1"), s("-x - -x"), s("a/b/c"), s("exp(ln(x))"), s("x^-1"), s("3 - 5"), s("(x^2)^3"), s("x + y - x")], ["4*x", "x^3", "1", "z", "9", "0", "a/(b*c)", "x", "1/x", "-2", "x^6", "y"], "simplificar")
igual([d("x^2 * sen(x) + 3*x"), d("exp(2*x)"), d("ln(x^2 + 1)"), d("1/x"), d("x^x"), d("cos(3x)"), d("tan(x)"), d("5"), d("y*x")], ["2*x*sen(x) + x^2*cos(x) + 3", "2*exp(2*x)", "2*x/(x^2 + 1)", "-1/x^2", "x^x*(ln(x) + 1)", "-3*sen(3*x)", "1/cos(x)^2", "0", "y"], "derivadas")
igual(simbolo_texto(simbolo_derivar(simbolo_leer("x^3"), "x", 2)), "6*x", "segunda derivada")
sea e = simbolo_leer("x^2 * sen(x) + 3*x")
afirmar(absoluto(simbolo_evaluar(e, {"x": 2}) - (4 * seno(2) + 6)) < 0.0000001, "evaluar")
afirmar(absoluto(simbolo_evaluar(simbolo_leer("2pi"), {}) - 2 * pi()) < 0.0000001, "constantes")
igual(simbolo_latex(e), "x^{2} \\sin(x) + 3 x", "LaTeX")
igual(simbolo_latex(simbolo_leer("1/(x+1) + raiz(x)")), "\\frac\{1}\{x + 1} + \\sqrt\{x}", "LaTeX fracción y raíz")
igual(simbolo_variables(simbolo_leer("a*x + b*y + pi")), ["a", "b", "x", "y"], "variables")
igual(simbolo_texto(simbolo_sustituir(simbolo_leer("x^2 + y"), {"x": "t + 1", "y": 3})), "(t + 1)^2 + 3", "sustituir")
igual(simbolo_texto(simbolo_sustituir(simbolo_leer("x^2 + y"), {"x": 2, "y": 3})), "7", "sustituir números")
afirmar(absoluto(simbolo_integrar(simbolo_leer("x^2"), "x", 0, 3) - 9) < 0.000001, "integral")
// Derivada simbólica = derivada numérica en varios puntos.
sea f = simbolo_leer("sen(x^2) * exp(-x) + ln(x)")
sea df = simbolo_derivar(f, "x")
para x0 en [0.5, 1, 2.3] {
    sea h = 0.000001
    sea num = (simbolo_evaluar(f, {"x": x0 + h}) - simbolo_evaluar(f, {"x": x0 - h})) / (2 * h)
    afirmar(absoluto(simbolo_evaluar(df, {"x": x0}) - num) < 0.00001, "derivada en " + x0)
}
para malo en [["2 * (x + 1", "simbolo: falta ')'"], ["2 # 3", "simbolo: carácter inesperado '#' en la posición 3"], ["", "simbolo: expresión vacía"], ["2 +", "simbolo: la expresión termina antes de tiempo"], ["x )", "simbolo: sobra ')'"]] {
    sea m = ""
    intentar { simbolo_leer(malo[0]) } capturar (x) { m = x }
    igual(m, malo[1], malo[1])
}
sea m = ""
intentar { simbolo_evaluar(simbolo_leer("x + y"), {"x": 1}) } capturar (x) { m = x }
igual(m, "simbolo: falta el valor de y", "falta variable")
mostrar("[OK] simbolo")
