// English aliases for batch 20.
importar "redisx"
importar "httpclient"
importar "dbus"
importar "docker"
importar "testcontainers"
importar "signalr"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// redisx
eq(redisx_slot("foo"), 12182, "slot")
sea sim = redisx_simulated(["10.0.0.1:1", "10.0.0.2:2"])
sea cl = redisx_cluster(["10.0.0.1:1"], {"transport": sim["transporte"]})
redisx_mset(cl, {"a": "1", "b": "2", "foo": "3"})
eq(redisx_mget(cl, ["foo", "a", "zz"]), ["3", "1", nulo], "mget")
eq(redisx_pipeline(cl, [["INCR", "n"], ["INCR", "n"]]), [1, 2], "pipeline")
// httpclient
sea mock = httpclient_mock({"GET /api/x": {"estado": 200, "cabeceras": {"Content-Type": "application/json"}, "cuerpo": "[1,2]"}})
sea api = httpclient_create({"base_url": "http://h/api", "adapter": mock["adaptador"], "headers": {"X-A": "1"}})
sea r = httpclient_get(api, "/x", {"params": {"q": "a b"}})
eq([r["status"], r["data"], mock["historial"][0]["url"]], [200, [1, 2], "http://h/api/x?q=a%20b"], "httpclient")
// dbus
eq(dbus_types("a«sv»i"), ["a" + caracter(123) + "sv" + caracter(125), "i"], "types")
eq(dbus_plain(dbus_unmarshal("su", dbus_marshal("su", ["hi", 7]), verdadero)), ["hi", 7], "marshal")
sea t = dbus_pipe()
sea s = dbus_connect(nulo, {"transport": t[1], "p2p": verdadero})
sea c = dbus_connect(nulo, {"transport": t[0], "p2p": verdadero})
t[0]["al_vaciar"] = funcion() { dbus_process_pending(s) }
dbus_export(s, "/o", "a.B", {"Dup": {"entrada": "s", "salida": "s", "fn": funcion(a, m) { retornar a[0] + a[0] }}}, nulo, nulo)
eq(dbus_call(c, nulo, "/o", "a.B", "Dup", "s", ["ab"]), ["abab"], "dbus call")
// docker
sea dm = docker_mock()
sea d = docker_client(nulo, {"transport": dm["transporte"]})
sea id = docker_create(d, {"image": "cforge/mini:1", "cmd": "echo hi", "labels": {"k": "v"}})
docker_start(d, id)
eq([docker_wait(d, id), docker_logs(d, id, nulo)["stdout"], docker_state(d, id)["status"]], [0, "hi\n", "exited"], "docker")
sea sv = docker_create(d, {"image": "cforge/mini:1", "cmd": "sleep 1", "ports": {"80": 0}})
docker_start(d, sv)
eq([docker_exec(d, sv, "ls", nulo)["exit_code"], docker_port(d, sv, 80)], [0, 32769], "exec y port")
// testcontainers
tc_client(docker_client(nulo, {"transport": dm["transporte"]}))
eq(tc_with(tc_container("cforge/mini:1", {"cmd": "echo ready", "wait": tc_wait_log("ready", 1)}), funcion(e) { retornar tc_logs(e) }), "ready\n", "tc_with")
// signalr
sea h = signalr_memory_hub({"Add": funcion(a, ctx) { retornar a[0] + a[1] }})
sea sc = signalr_connect("http://x/hub", {"transport": h["transporte"]})
eq(signalr_invoke(sc, "Add", [2, 3]), 5, "signalr")
mostrar("[OK] en_lote20")
