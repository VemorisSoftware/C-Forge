// Pruebas de revelado. datos/revelado/esperado.json sale de Pillow 12 y
// SciPy: remuestreo (5 núcleos, para achicar y agrandar), gris, geometría,
// autocontraste, ecualización, gauss, enfoque, convolución y alfa.
importar "revelado"
importar "json"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

sea D = "tests/bibliotecas/datos/revelado/"
sea e = json_parsear(leer_archivo(D + "esperado.json"))
sea base = revelado_cargar(D + "base.png")
funcion banda(img, desde, cuantas) {
    sea p = img["pixeles"]
    sea partes = []
    sea i = 0
    mientras (i < longitud(p)) {
        partes.agregar(subtexto(p, i + desde, i + desde + cuantas))
        i = i + 4
    }
    retornar hex_de_bytes(unir(partes, ""))
}
funcion rgb(img) { retornar banda(img, 0, 3) }

para k en ["nearest", "bilinear", "bicubic", "lanczos", "box"] {
    eq(rgb(revelado_redimensionar(base, 15, 11, k)), e["red_" + k + "_abajo"], "achicar " + k)
    eq(rgb(revelado_redimensionar(base, 53, 40, k)), e["red_" + k + "_arriba"], "agrandar " + k)
}
eq(banda(revelado_gris(base), 0, 1), e["gris"], "gris")
eq(rgb(revelado_rotar(base, 90)), e["rot90"], "rotar 90")
eq(rgb(revelado_rotar(base, 270)), e["rot270"], "rotar 270")
eq(rgb(revelado_rotar(base, -180)), e["rot180"], "rotar 180")
eq(rgb(revelado_voltear(base, "horizontal")), e["espejo"], "espejo")
eq(rgb(revelado_voltear(base, "vertical")), e["vertical"], "vertical")
eq(rgb(revelado_recortar(base, 5, 3, 20, 17)), e["recorte"], "recortar")
eq(rgb(revelado_incrustar(revelado_recortar(base, 0, 0, 20, 20), 40, 30, 50, 40, [255, 0, 0, 255])), e["incrustar"], "incrustar")
eq(rgb(revelado_negativo(base)), e["negativo"], "negativo")
sea tb = []
para v en lista_rango(0, 256) { tb.agregar(40 + cociente(v, 2)) }
sea plana = revelado_tabla(base, tb)
eq(rgb(revelado_autocontraste(plana)), e["autocontraste"], "autocontraste")
eq(rgb(revelado_ecualizar(plana)), e["ecualizar"], "ecualizar")
eq(rgb(revelado_desenfocar(base, 1.5)), e["gauss15"], "gauss")
eq(rgb(revelado_enfocar(base, 1.0, 0.8)), e["enfocar"], "máscara de enfoque")
eq(rgb(revelado_convolucion(base, [[0, -1, 0], [-1, 5, -1], [0, -1, 0]], 1, 0)), e["conv"], "convolución")
eq(hex_de_bytes(revelado_componer(imagen_nueva(37, 29, [10, 200, 30, 255]), revelado_cargar(D + "alfa.png"), 0, 0)["pixeles"]), e["componer"], "composición alfa")

// Miniatura, mosaico, estadísticas y JPEG.
sea m = revelado_miniatura(base, 20, 20, nulo)
eq([m["ancho"], m["alto"]], [20, 16], "miniatura conserva la proporción")
sea mos = revelado_mosaico([m, m, m], 2, nulo)
eq([mos["ancho"], mos["alto"]], [40, 32], "mosaico")
sea est = revelado_estadisticas(imagen_nueva(4, 4, [10, 20, 30, 255]))
eq([est[0]["min"], est[1]["max"], est[2]["media"], est[3]["desviacion"]], [10, 20, 30, 0], "estadísticas")
eq(revelado_histograma(revelado_umbral(base, 128))[0][255] + revelado_histograma(revelado_umbral(base, 128))[0][0], 37 * 29, "umbral")
para sub en ["4:4:4", "4:2:0"] {
    sea j = revelado_a_bytes(base, "jpeg", {"calidad": 90, "submuestreo": sub})
    sea d = revelado_desde_bytes(j)
    sea suma = 0
    para i en lista_rango(0, 37 * 29 * 4) {
        si (i % 4 != 3) { suma = suma + potencia(byte_en(d["pixeles"], i) - byte_en(base["pixeles"], i), 2) }
    }
    sea psnr = 10 * logaritmo(255 * 255 / (suma / (37 * 29 * 3))) / logaritmo(10)
    // Pillow con la misma calidad: 30.4 dB (4:4:4) y 17.7 dB (4:2:0) en esta imagen.
    afirmar(psnr > si(sub == "4:4:4", 30, 17.5), "JPEG " + sub + ": PSNR " + psnr)
}
mostrar("[OK] revelado")
