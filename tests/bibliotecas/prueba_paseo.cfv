importar "paseo"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Vector oficial 4-S-1 de PASETO.
sea pub = bytes_de_hex("1eb9dbbbbc047c03fd70604e0071f0987e16b28b757225c11f00415d0e20b1a2")
sea oficial = "v4.public.eyJkYXRhIjoidGhpcyBpcyBhIHNpZ25lZCBtZXNzYWdlIiwiZXhwIjoiMjAyMi0wMS0wMVQwMDowMDowMCswMDowMCJ9bg_XBBzds8lTZShVlwwKSgeKpLT3yukTw6JUz3W4h_ExsQV-P0V54zemZDcAxFaSeef1QlXEFtkqxT1ciiQEDA"
igual(paseo_verificar(pub, oficial, {"ahora_ms": 1600000000000}), {"data": "this is a signed message", "exp": "2022-01-01T00:00:00+00:00"}, "vector oficial")
sea m = ""
intentar { paseo_verificar(pub, oficial) } capturar (e) { m = e }
igual(m, "paseo: el token venció", "vector oficial vencido hoy")
sea par = paseo_claves()
igual(paseo_clave_de_texto(paseo_clave_texto(par["publica"])), par["publica"], "clave en texto")
sea t0 = 1763683200000
sea t = paseo_firmar(par["secreta"], {"sub": "ana", "rol": "admin"}, {"expira_s": 60, "emisor": "vemoris", "audiencia": "api", "pie": "kid:1", "ahora_ms": t0})
afirmar(texto_empieza_con(t, "v4.public."), "prefijo")
sea d = paseo_verificar(par["publica"], t, {"emisor": "vemoris", "audiencia": "api", "ahora_ms": t0 + 30000})
igual([d["sub"], d["rol"], d["iat"], d["exp"]], ["ana", "admin", "2025-11-21T00:00:00Z", "2025-11-21T00:01:00Z"], "datos y fechas")
igual(paseo_pie(t), "kid:1", "pie")
para caso en [
    [par["publica"], t, {"ahora_ms": t0 + 61000}, "paseo: el token venció"],
    [par["publica"], t, {"ahora_ms": t0 + 61000, "tolerancia_s": 5}, ""],
    [par["publica"], t, {"ahora_ms": t0, "emisor": "otro"}, "paseo: emisor incorrecto"],
    [par["publica"], t, {"ahora_ms": t0, "audiencia": "web"}, "paseo: audiencia incorrecta"],
    [paseo_claves()["publica"], t, {"ahora_ms": t0}, "paseo: firma inválida"],
    [par["publica"], texto_reemplazar(t, ".a2lkOjE", ".a2lkOjI"), {"ahora_ms": t0}, "paseo: firma inválida"],
    [par["publica"], "v3.public.xx", {}, "paseo: solo se aceptan tokens v4.public"],
    [par["publica"], "v4.public.!!", {}, "paseo: token mal formado"],
    [par["publica"], "v4.public.YQ", {}, "paseo: token mal formado"]
] {
    sea mm = ""
    intentar { paseo_verificar(caso[0], caso[1], caso[2]) } capturar (e) { mm = e }
    igual(mm, caso[3], caso[3])
}
// Cambiar un byte del cuerpo invalida la firma.
sea cuerpo = subcadena(t, 10, 20)
sea otro = subcadena(t, 0, 10) + texto_reemplazar(cuerpo, subcadena(cuerpo, 3, 4), "Z") + subcadena(t, 20, longitud(t))
si (otro != t) {
    sea mm = ""
    intentar { paseo_verificar(par["publica"], otro, {"ahora_ms": t0}) } capturar (e) { mm = e }
    afirmar(mm != "", "manipulación detectada")
}
sea nb = paseo_firmar(par["secreta"], {"nbf": "2030-01-01T00:00:00Z"}, {"ahora_ms": t0, "expira_s": nulo})
intentar { paseo_verificar(par["publica"], nb, {"ahora_ms": t0}) } capturar (e) { m = e }
igual(m, "paseo: el token aún no es válido", "nbf")
mostrar("[OK] paseo")
