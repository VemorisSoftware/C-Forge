importar "interruptor"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea f = interruptor_nuevo()
interruptor_definir(f, "pago", {"porcentaje": 20, "reglas": [{"atributo": "pais", "en": ["CL"]}]})
interruptor_definir(f, "boton", {"variantes": {"azul": 50, "verde": 50}})
interruptor_definir(f, "beta", {"porcentaje": 0, "usuarios": ["vip"]})
interruptor_definir(f, "apagada", {"activo": falso})
interruptor_definir(f, "mayores", {"reglas": [{"atributo": "edad", "mayor": 17}]})
sea dentro = 0
sea azul = 0
sea i = 0
mientras (i < 2000) {
    si (interruptor_activo(f, "pago", {"id": "u" + i, "pais": "CL"})) { dentro = dentro + 1 }
    si (interruptor_variante(f, "boton", {"id": "u" + i}) == "azul") { azul = azul + 1 }
    i = i + 1
}
afirmar(dentro > 320 y dentro < 480, "≈20 %: " + dentro)
afirmar(azul > 900 y azul < 1100, "≈50 %: " + azul)
igual(interruptor_activo(f, "pago", {"id": "u7", "pais": "CL"}), interruptor_activo(f, "pago", {"id": "u7", "pais": "CL"}), "estable")
igual(interruptor_variante(f, "boton", {"id": "x"}), interruptor_variante(f, "boton", {"id": "x"}), "variante estable")
igual(interruptor_activo(f, "pago", {"id": "u1", "pais": "AR"}), falso, "regla por país")
igual([interruptor_activo(f, "beta", {"id": "vip"}), interruptor_activo(f, "beta", {"id": "otro"})], [verdadero, falso], "lista de usuarios")
igual([interruptor_activo(f, "apagada", {"id": 1}), interruptor_activo(f, "nada", {"id": 1}), interruptor_variante(f, "nada", {"id": 1})], [falso, falso, "control"], "apagadas")
igual([interruptor_activo(f, "mayores", {"edad": 30}), interruptor_activo(f, "mayores", {"edad": 12}), interruptor_activo(f, "mayores", {})], [verdadero, falso, falso], "regla mayor")
interruptor_forzar(f, "apagada", verdadero)
interruptor_forzar(f, "boton", "verde")
igual([interruptor_activo(f, "apagada"), interruptor_variante(f, "boton", {"id": "cualquiera"})], [verdadero, "verde"], "forzar")
sea j = interruptor_desde_json("{\"x\": {\"porcentaje\": 100}}")
igual(interruptor_activo(j, "x", {"id": 1}), verdadero, "desde JSON")
afirmar(interruptor_cubeta("a", "b") >= 0 y interruptor_cubeta("a", "b") < 10000, "cubeta")
mostrar("[OK] interruptor")
