// Pruebas de sintaxis. datos/sintaxis/esperado.json sale de py-tree-sitter
// 0.25 con tree-sitter-python y tree-sitter-json: S-expresión y los 560
// nodos (bytes y filas/columnas) de programa.py, casos sueltos, errores y
// las capturas de 10 consultas.
importar "sintaxis"
importar "json"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

sea D = "tests/bibliotecas/datos/sintaxis/"
sea e = json_parsear(leer_archivo(D + "esperado.json"))
sea a = sintaxis_analizar(leer_archivo(D + "programa.py"), "python")
eq(a["tiene_error"], falso, "sin errores")
eq(sintaxis_sexp(a), e["python"]["sexp"], "S-expresión de programa.py")
sea nodos = []
_sx_preorden(a["raiz"], funcion(n) { nodos.agregar([n["tipo"], n["inicio"], n["fin"], n["punto_inicio"], n["punto_fin"]]) })
eq(nodos, e["python"]["nodos"], "posiciones de todos los nodos")
eq(sintaxis_sexp(sintaxis_analizar(e["json"]["fuente"], "json")), e["json"]["sexp"], "JSON")
para c en e["casos"] { eq(sintaxis_sexp(sintaxis_analizar(c[0], "python")), c[1], "caso " + c[0]) }
para c en e["errores"] { eq(sintaxis_analizar(c[0], "python")["tiene_error"], c[1], "error en " + c[0]) }
para c en e["consultas"] {
    sea caps = []
    para x en sintaxis_consulta(a, c["q"]) { caps.agregar([x["nombre"], x["nodo"]["inicio"], x["nodo"]["fin"]]) }
    eq(caps, c["capturas"], "consulta " + c["q"])
}

// API de navegación.
sea b = sintaxis_analizar("def suma(a, b):\n    return a + b\n", "python")
sea f = sintaxis_buscar(b, "function_definition")[0]
eq(sintaxis_texto(b, sintaxis_hijo(f, "name")), "suma", "hijo por campo")
eq(longitud(sintaxis_hijo(f, "parameters")["hijos"]), 2, "parámetros")
sea n = sintaxis_nodo_en(b, 27, 28)
eq([n["tipo"], sintaxis_texto(b, n), n["punto_inicio"]], ["identifier", "a", [1, 11]], "nodo en un byte")
eq(sintaxis_consulta(b, "(binary_operator left: (identifier) @i right: (identifier) @d)")[1]["texto"], "b", "texto de captura")
sea mal = sintaxis_analizar("x = = 1\n", "python")
eq([mal["tiene_error"], sintaxis_sexp(mal), texto_contiene(mal["error"], "byte 4")], [verdadero, "(ERROR)", verdadero], "árbol con error")
mostrar("[OK] sintaxis")
