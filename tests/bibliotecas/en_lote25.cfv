// English aliases for batch 25.
importar "jit_asm"
importar "ebpf"
importar "ssa_ir"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea f = jit_function(2, "int", "int")
jit_return(f, jit_op_en(f, "add", jit_op_en(f, "mul", jit_arg(f, 0), jit_arg(f, 1)), jit_iconst(f, 1)))
eq(hex_de_bytes(subtexto(jit_machine_code(f, "arm64"), 0, 4)), "fd7bbfa9", "arm64 code")
si (existe_archivo("/proc/cpuinfo") y contiene(leer_archivo("/proc/cpuinfo"), "vendor_id")) {
    sea h = jit_finalize(f, nulo)
    eq(jit_call(h, [6, 7]), 43, "jit_call")
    eq(jit_call(jit_compile_expr("x > 1.5 ? x * 2.0 : 0.0", ["x"], "float"), [2.0]), 4, "expr")
}
// ebpf
sea bp = ebpf_assemble("mov r0, 6\nmul r0, 7\nexit")
eq([ebpf_verify(bp, nulo), ebpf_run(bp, nulo, nulo)["r0"], ebpf_disassemble(bp)], [[], 42, "mov r0, 6\nmul r0, 7\nexit"], "ebpf")
sea em = ebpf_map("array", 4, 8, 2)
eq(ebpf_map_update(em, bytes_entero(1, 4, 1), bytes_entero(5, 8, 1)), 0, "ebpf_map_update")
eq(ebpf_load_elf(leer_archivo("tests/bibliotecas/datos/nucleo-contar.o"))["license"], "GPL", "ebpf_load_elf")
// ssa_ir
sea ir = ir_parse("func @f(%a: i64) -> i64 {\nentry:\n  %x = add i64 %a, 0\n  %y = mul i64 %x, 1\n  ret i64 %y\n}\n")
eq(ir_verify(ir), [], "ir_verify")
sea ch = ir_optimize(ir, {"passes": ["fold", "dce"]})
eq([ch["fold"] > 0, ir_print(ir), ir_interpret(ir, "f", [41])], [verdadero, "func @f(%a: i64) -> i64 {\nentry:\n  ret i64 %a\n}\n", 41], "ir_optimize")
mostrar("[OK] en_lote25")
