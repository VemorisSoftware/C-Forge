importar "gradiente"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion cerca(a, b, q) { afirmar(absoluto(a - b) < 0.001, q + ": " + a + " != " + b) }
sea x = gradiente_valor(2)
sea y = gradiente_suma(gradiente_mul(x, x), gradiente_mul(3, x))
gradiente_atras(y)
igual([y["v"], x["grad"]], [10, 7], "x² + 3x en 2")
// El ejemplo de micrograd (valores de PyTorch).
sea a = gradiente_valor(-4)
sea b = gradiente_valor(2)
sea c = gradiente_suma(a, b)
sea d = gradiente_suma(gradiente_mul(a, b), gradiente_pot(b, 3))
c = gradiente_suma(c, gradiente_suma(c, 1))
c = gradiente_suma(c, gradiente_suma(gradiente_suma(1, c), gradiente_mul(-1, a)))
d = gradiente_suma(d, gradiente_suma(gradiente_mul(d, 2), gradiente_relu(gradiente_suma(b, a))))
d = gradiente_suma(d, gradiente_suma(gradiente_mul(3, d), gradiente_relu(gradiente_resta(b, a))))
sea e = gradiente_resta(c, d)
sea f = gradiente_pot(e, 2)
sea g = gradiente_div(f, 2)
g = gradiente_suma(g, gradiente_div(10, f))
gradiente_atras(g)
cerca(g["v"], 24.7041, "micrograd g")
cerca(a["grad"], 138.8338, "micrograd a.grad")
cerca(b["grad"], 645.5773, "micrograd b.grad")
// Gradiente numérico vs. analítico.
sea q = gradiente_valor(0.7)
sea s = gradiente_mul(gradiente_tanh(q), gradiente_exp(gradiente_sigmoide(q)))
gradiente_atras(s)
sea num = gradiente_numerico(funcion(v) { sea u = exponencial(2 * v[0])  retornar ((u - 1) / (u + 1)) * exponencial(1 / (1 + exponencial(-v[0]))) }, [0.7])
cerca(q["grad"], num[0], "numérico = analítico")
// XOR con Adam y salida sigmoide.
sea X = [[0, 0], [0, 1], [1, 0], [1, 1]]
sea Y = [0, 1, 1, 0]
sea red = gradiente_red([2, 8, 1], "tanh", 3, "sigmoide")
sea p = gradiente_entrenar(red, X, Y, {"epocas": 300, "tasa": 0.05})
afirmar(p[longitud(p) - 1] < 0.01, "XOR aprende")
igual([redondear(gradiente_predecir(red, [0, 0])), redondear(gradiente_predecir(red, [0, 1])), redondear(gradiente_predecir(red, [1, 0])), redondear(gradiente_predecir(red, [1, 1]))], [0, 1, 1, 0], "XOR predice")
sea r2 = gradiente_red([2, 4, 1], "relu", 1)
sea ps = gradiente_entrenar(r2, X, Y, {"epocas": 20, "tasa": 0.05, "optimizador": "sgd"})
afirmar(ps[longitud(ps) - 1] <= ps[0], "SGD no sube")
igual(longitud(gradiente_parametros(gradiente_red([3, 5, 2], "tanh", 1))), 3 * 5 + 5 + 5 * 2 + 2, "cantidad de parámetros")
mostrar("[OK] gradiente")
