// Written in English.
import "validator"
import "rbac"
import "flags"
import "phone"
import "ta"
import "quant"
import "noise"
import "diagnostics"
function same(a, b, what) { assert(("" + a) == ("" + b), what + ": [" + a + "] != [" + b + "]") }
let v = validator_new()
validator_field(v, "email", ["required", "email"])
let r = validator_check(v, {"email": "nope"})
same(r["errors"]["email"], ["is not a valid email"], "validator")
same(validator_messages(v, r), ["email: is not a valid email"], "validator_messages")
let acl = rbac_new()
rbac_role(acl, "admin", ["user"])
rbac_allow(acl, "user", "posts/*", "read")
rbac_assign(acl, "ann", "admin")
same(rbac_can(acl, "ann", "posts/1", "read"), true, "rbac")
let f = flags_new()
flags_define(f, "dark", {"percentage": 50, "rules": [{"attribute": "plan", "in": ["pro"]}]})
same(flags_enabled(f, "dark", {"id": "1", "plan": "free"}), false, "flags rules")
flags_define(f, "dark", {"percentage": 100})
same(flags_enabled(f, "dark", {"id": "1"}), true, "flags")
same(phone_parse("+1 202 555 0143")["e164"], "+12025550143", "phone")
same(ta_sma([1, 2, 3], 2), [null, 1.5, 2.5], "ta_sma")
same(ta_atr([{"high": 2, "low": 1, "close": 1.5}, {"high": 3, "low": 2, "close": 2.5}], 1), [null, 1.5], "ta_atr english candles")
assert(abs(quant_black_scholes("call", 100, 100, 1, 0.05, 0.2)["price"] - 10.4506) < 0.0001, "quant")
same(quant_bond_duration(0.05, 0.05, 1)["modified"] > 0, true, "quant_bond_duration")
let n = noise_new(7)
same(noise_perlin(n, 0, 0), 0, "noise")
let d = diagnostic_new("error", "bad", "f.txt", "abc")
diagnostic_label(d, 1, 2, "here")
assert(texto_indice(diagnostic_render(d), "╰── here") >= 0, "diagnostics")
print("[OK] lote 6 in English")
