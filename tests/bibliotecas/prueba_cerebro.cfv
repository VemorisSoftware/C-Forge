// Pruebas de cerebro. datos/cerebro/*.onnx y esperado.json salen de onnx +
// ONNX Runtime 1.29: un MLP, una CNN (Conv con grupos y relleno asimétrico,
// BatchNorm, pooling) y un grafo tipo transformer (LayerNorm, atención,
// GELU con Erf, Slice, Gather, reducciones, Where, Cast, ArgMax…).
importar "cerebro"
importar "json"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

sea D = "tests/bibliotecas/datos/cerebro/"
para c en json_parsear(leer_archivo(D + "esperado.json")) {
    sea m = cerebro_cargar(D + c["modelo"] + ".onnx")
    sea ent = {}
    para k en claves(c["entradas"]) { ent[k] = cerebro_tensor(c["entradas"][k]["forma"], c["entradas"][k]["datos"]) }
    sea r = cerebro_ejecutar(m, ent, nulo)
    para k en claves(c["salidas"]) {
        sea s = c["salidas"][k]
        eq(r[k]["forma"], s["forma"], c["modelo"] + " " + k + " forma")
        para i en lista_rango(0, longitud(s["datos"])) {
            sea v = r[k]["datos"][i]
            si (v == verdadero) { v = 1 }
            si (v == falso) { v = 0 }
            afirmar(absoluto(v - s["datos"][i]) <= 1e-5 * maximo(1, absoluto(s["datos"][i])), c["modelo"] + " " + k + "[" + i + "]: " + v + " vs " + s["datos"][i])
        }
    }
}
sea mlp = cerebro_cargar(D + "mlp.onnx")
eq(cerebro_entradas(mlp), [{"forma": [3, 8], "nombre": "x", "tipo": "float32"}], "entradas sin los pesos")
eq(cerebro_salidas(mlp)[0]["nombre"], "y", "salidas")
eq(mlp["opset"], 17, "opset")
sea error = ""
intentar { cerebro_ejecutar(mlp, {}, nulo) } capturar (e) { error = e }
afirmar(texto_contiene(error, "falta la entrada x"), "entrada faltante")
error = ""
intentar { cerebro_tensor([2, 2], [1, 2, 3]) } capturar (e) { error = e }
afirmar(texto_contiene(error, "pide 4"), "tensor mal formado")
mostrar("[OK] cerebro")
