importar "api_rapida"
importar "molde"
importar "json"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea Libro = molde_registro({"id": "entero", "titulo": "texto", "anio": molde_opcional("entero")})
sea Nuevo = molde_registro({"titulo": "texto", "anio": molde_opcional("entero")})
sea app = api_nueva({"titulo": "Biblioteca", "version": "1.0"})
api_esquema(app, "Libro", Libro)
api_esquema(app, "NuevoLibro", Nuevo)
sea db = [{"id": 1, "titulo": "Rayuela", "anio": 1963}]
api_get(app, "/libros/:id", {"parametros": {"id": "entero"}, "respuesta": Libro}, funcion(req) {
    para b en db { si (b["id"] == req["parametros"]["id"]) { retornar b } }
    lanzar api_error(404, "No existe el libro")
})
api_post(app, "/libros", {"cuerpo": Nuevo, "respuesta": Libro, "estado": 201, "seguridad": verdadero}, funcion(req) {
    sea n = {"id": longitud(db) + 1, "titulo": req["cuerpo"]["titulo"], "anio": req["cuerpo"]["anio"]}
    db.agregar(n)
    retornar n
})
api_bearer(app, funcion(t) { si (t == "secreto") { retornar {"nombre": "admin"} }  retornar nulo })
sea r = api_manejar(app, {"metodo": "GET", "ruta": "/libros/1"})
igual([r["estado"], json_parsear(r["cuerpo"])["titulo"]], [200, "Rayuela"], "GET con parámetro")
r = api_manejar(app, {"metodo": "GET", "ruta": "/libros/xx"})
igual([r["estado"], json_parsear(r["cuerpo"])["detail"][0]["loc"]], [422, ["path", "id"]], "422 al validar")
igual(api_manejar(app, {"metodo": "GET", "ruta": "/libros/9"})["estado"], 404, "error propio")
igual(api_manejar(app, {"metodo": "POST", "ruta": "/libros", "cuerpo": "{\"titulo\": \"F\"}"})["estado"], 401, "sin token")
r = api_manejar(app, {"metodo": "POST", "ruta": "/libros", "cabeceras": {"Authorization": "Bearer secreto"}, "cuerpo": "{\"titulo\": \"Ficciones\", \"anio\": 1944}"})
igual([r["estado"], json_parsear(r["cuerpo"])["id"]], [201, 2], "POST autenticado")
igual(api_manejar(app, {"metodo": "DELETE", "ruta": "/libros/1"})["estado"], 405, "método no permitido")
igual(api_manejar(app, {"metodo": "GET", "ruta": "/nada"})["estado"], 404, "ruta inexistente")
sea oa = api_openapi(app)
igual([oa["openapi"], oa["info"]["title"]], ["3.1.0", "Biblioteca"], "OpenAPI")
afirmar(tiene_clave(oa["paths"], "/libros/" + caracter(123) + "id" + caracter(125)), "ruta en OpenAPI")
afirmar(texto_indice(api_docs_html(app), "swagger") >= 0, "página de docs")
mostrar("[OK] api_rapida")
