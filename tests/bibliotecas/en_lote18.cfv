// English aliases for batch 18.
importar "columnar"
importar "bundler"
importar "meshopt"
importar "texcompress"
importar "amqp"
importar "kubernetes"
importar "discovery"
importar "modelo"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// columnar
sea t = columnar_table({"id": [1, 2, nulo], "name": ["a", "b", "c"]}, {"id": "int32", "name": "utf8"}, ["id", "name"])
eq(columnar_rows(parquet_read(parquet_write(t, {"compression": "zstd"}), nulo)), columnar_rows(t), "parquet")
eq(columnar_rows(arrow_read(arrow_stream(t))), columnar_rows(t), "arrow")
eq(columnar_schema(t)[1]["type"], "utf8", "schema")
// bundler
sea r = bundler_build({"entry": "/m.js", "files": {"/m.js": "import x from \"./x.js\"; console.log(x);", "/x.js": "export default 5;"}})
eq([r["modules"], r["warnings"]], [["/m.js", "/x.js"], []], "bundle")
// meshopt
sea m = meshopt_optimize(malla_cubo(1))
eq([meshopt_triangle_count(m), meshopt_half(1)], [12, 15360], "meshopt")
// texcompress
sea img = {"ancho": 4, "alto": 4, "pixeles": bytes_entero(4278190335, 4, 0) + bytes_entero(4278190335, 4, 0) + bytes_entero(4278190335, 4, 0) + bytes_entero(4278190335, 4, 0) + bytes_entero(4278190335, 4, 0) + bytes_entero(4278190335, 4, 0) + bytes_entero(4278190335, 4, 0) + bytes_entero(4278190335, 4, 0) + bytes_entero(4278190335, 4, 0) + bytes_entero(4278190335, 4, 0) + bytes_entero(4278190335, 4, 0) + bytes_entero(4278190335, 4, 0) + bytes_entero(4278190335, 4, 0) + bytes_entero(4278190335, 4, 0) + bytes_entero(4278190335, 4, 0) + bytes_entero(4278190335, 4, 0)}
eq(texture_psnr(img, texture_decompress(texture_compress(img, "bc1"), "bc1", 4, 4, nulo), falso) > 40, verdadero, "texcompress")
eq(texture_dds_read(texture_dds(img, "bc1", falso))["format"], "bc1", "dds")
// amqp
eq(amqp_read_method(amqp_method("basic.ack", {"delivery_tag": 9}))["delivery_tag"], 9, "amqp")
eq(amqp_read_header(amqp_header(3, {"content_type": "text/plain"}))["body_size"], 3, "amqp header")
// kubernetes
eq(k8s_path("apps/v1", "Deployment", "prod", "web", nulo), "/apis/apps/v1/namespaces/prod/deployments/web", "k8s path")
eq(k8s_plural("Policy"), "policies", "k8s plural")
// discovery
eq(etcd_prefix_end("/a/"), "/a0", "etcd")
eq(discovery_pick([{"id": "a", "sano": falso}, {"id": "b", "sano": verdadero}], "primera", nulo)["id"], "b", "pick")
mostrar("[OK] en_lote18")
