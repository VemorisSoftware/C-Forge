importar "reloj"
funcion igual(a, b, q) { afirmar(a == b, q + ": [" + a + "] != [" + b + "]") }
// 2025-11-21 00:00 UTC (viernes)
sea base = 1763683200000
funcion sig(expr) {
    sea c = reloj_cron(expr)
    retornar reloj_formato(c, reloj_siguiente(c, base))
}
igual(reloj_formato(reloj_cron("* * * * *"), base), "2025-11-21 00:00", "formato")
igual(sig("* * * * *"), "2025-11-21 00:01", "estrictamente después")
igual(sig("*/15 9-18 * * lun-vie"), "2025-11-21 09:00", "horario de oficina")
igual(sig("0 9 * * sab"), "2025-11-22 09:00", "sábado")
igual(sig("0 9 * * 7"), "2025-11-23 09:00", "7 = domingo")
igual(sig("0 9 * * sun"), "2025-11-23 09:00", "sun")
igual(sig("0 0 29 2 *"), "2028-02-29 00:00", "29 de febrero")
igual(sig("@mensual"), "2025-12-01 00:00", "@mensual")
igual(sig("@yearly"), "2026-01-01 00:00", "@yearly")
igual(sig("@hora"), "2025-11-21 01:00", "@hora")
igual(sig("30 8 13 * vie"), "2025-11-21 08:30", "día o día de semana")
igual(sig("5,10 */6 1-7 ene,jul *"), "2026-01-01 00:05", "listas, pasos y nombres")
igual(sig("0 12 31 * *"), "2025-12-31 12:00", "meses de 31")
igual(sig("10-50/20 3 * * *"), "2025-11-21 03:10", "rango con paso")
sea l = []
sea c = reloj_cron("0 0 * * *")
para t en reloj_proximas(c, base, 3) { l.agregar(reloj_formato(c, t)) }
igual(unir(l, ","), "2025-11-22 00:00,2025-11-23 00:00,2025-11-24 00:00", "próximas")
igual(reloj_coincide(reloj_cron("*/15 9-18 * * lun-vie"), base + 9 * 3600000 + 15 * 60000), verdadero, "coincide")
igual(reloj_coincide(reloj_cron("*/15 9-18 * * lun-vie"), base + 9 * 3600000 + 16 * 60000), falso, "no coincide")
// Desfase: Chile UTC-3
sea cl = reloj_cron("0 9 * * *", 0 - 180)
igual(reloj_siguiente(cl, base), base + 12 * 3600000, "9:00 local = 12:00 UTC")
igual(reloj_formato(cl, base + 12 * 3600000), "2025-11-21 09:00", "formato local")
// Años bisiestos y siglos: recorre 400 años de 1 de marzo
sea cm = reloj_cron("0 0 1 3 *")
sea tt = 0
sea k = 0
mientras (k < 3) { tt = reloj_siguiente(cm, tt)  k = k + 1 }
igual(reloj_formato(cm, tt), "1972-03-01 00:00", "1970 en adelante")
igual(reloj_formato(cm, reloj_siguiente(cm, 4102444800000)), "2100-03-01 00:00", "2100 no es bisiesto")
para malo en [["61 * * * *", "reloj: fuera de rango en minuto: 61"], ["* * *", "reloj: se esperaban 5 campos (minuto hora día mes día-semana)"], ["*/0 * * * *", "reloj: paso 0 en minuto"], ["* * * xyz *", "reloj: valor inválido en mes: xyz"], ["* 5-2 * * *", "reloj: fuera de rango en hora: 5-2"]] {
    sea m = ""
    intentar { reloj_cron(malo[0]) } capturar (e) { m = e }
    igual(m, malo[1], malo[0])
}
sea m = ""
intentar { reloj_siguiente(reloj_cron("0 0 31 2 *"), base) } capturar (e) { m = e }
igual(m, "reloj: la expresión nunca ocurre (p. ej. 31 de febrero)", "imposible")
mostrar("[OK] reloj")
