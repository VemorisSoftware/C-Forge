importar "cadena"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
igual(hex_de_bytes(cadena_keccak("")), "c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470", "keccak vacío")
igual(hex_de_bytes(cadena_keccak("abc")), "4e03657aea45a94fc7d47ba826c8d667c0d1e6e33a64a036ec44f58fa12d6c45", "keccak abc")
sea largo = ""
sea i = 0
mientras (i < 200) { largo = largo + "a"  i = i + 1 }
igual(hex_de_bytes(cadena_keccak(largo)), "96ea54061def936c4be90b518992fdc6f12f535068a256229aca54267b4d084d", "keccak de varios bloques")
sea priv = bytes_de_hex("4646464646464646464646464646464646464646464646464646464646464646")
igual(cadena_direccion(priv), "0x9d8A62f656a8d1615C1294fd71e9CFb3E4855A4F", "dirección con checksum")
igual([cadena_direccion_valida("0x9d8A62f656a8d1615C1294fd71e9CFb3E4855A4F"), cadena_direccion_valida("0x9d8a62f656a8d1615C1294fd71e9CFb3E4855A4F"), cadena_direccion_valida("0x9d8a62f656a8d1615c1294fd71e9cfb3e4855a4f")], [verdadero, falso, verdadero], "EIP-55")
// Ejemplo de EIP-155.
igual(cadena_firmar_tx(priv, {"tipo": 0, "cadena": 1, "nonce": 9, "precio_gas": "20000000000", "gas": 21000, "para": "0x3535353535353535353535353535353535353535", "valor": cadena_wei("1", "ether")})["crudo"], "0xf86c098504a817c800825208943535353535353535353535353535353535353535880de0b6b3a76400008025a028ef61340bd939bc2195fe537567866003e1a15d3c71ff63e1590620aa636276a067cbe9d8997f761aecb703304b3800ccf555c9f3dc64214b297fb1966a3b6d83", "transacción EIP-155")
// Igual que eth_account (EIP-1559).
sea t2 = cadena_firmar_tx(priv, {"tipo": 2, "cadena": 1, "nonce": 0, "para": "0x3535353535353535353535353535353535353535", "valor": "1000000000000000", "gas": 21000, "max_fee": cadena_wei("30", "gwei"), "max_prioridad": cadena_wei("1", "gwei")})
igual([t2["crudo"], t2["hash"]], ["0x02f8720180843b9aca008506fc23ac0082520894353535353535353535353535353535353535353587038d7ea4c6800080c080a0a9047639d1bb3a029b9a12146c35360f43fd065dfa27c727b160c81e308e9805a07fd2d58b4c1e62354bc057008576531a843c4de868e4b244fc060ca294dcb15c", "0x484670b5787521d8ff43cd45da37b34b90c1c30606c1e28d840992f4ca575d12"], "transacción EIP-1559")
sea firma = cadena_firmar_mensaje(priv, "hola")
igual(firma, "0xb6304746a46f9ae1a302ca4ca0da136b93503880a19fa61783e34eb4af101a9d22e0bd861b88ba4b65e492a6557e2c7d9bf93e1c478d26278fc0121fa99823ff1c", "personal_sign")
igual(cadena_recuperar("hola", firma), "0x9d8A62f656a8d1615C1294fd71e9CFb3E4855A4F", "recuperar firmante")
igual([cadena_wei("1.5"), cadena_formatear("1500000000000000000"), cadena_formatear("123", "gwei"), cadena_wei("30", "gwei")], ["1500000000000000000", "1.5", "0.000000123", "30000000000"], "unidades")
igual(cadena_abi_llamada("transfer(address,uint256)", ["0x3535353535353535353535353535353535353535", "1000000"]), "0xa9059cbb000000000000000000000000353535353535353535353535353535353535353500000000000000000000000000000000000000000000000000000000000f4240", "transfer")
igual(hex_de_bytes(cadena_selector("baz(uint32,bool)")), "cdcd77c0", "selector")
igual(cadena_topico("Transfer(address,address,uint256)"), "0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef", "tópico de evento")
// Ejemplo de la documentación de Solidity.
sea tipos = ["uint256", "uint32[]", "bytes10", "bytes"]
sea enc = cadena_abi(tipos, ["291", ["1110", "1929"], "1234567890", "Hello, world!"])
igual(hex_de_bytes(enc), "", "ABI dinámico")
sea t5 = ["uint256", "uint32[]", "bytes10", "bytes", "int8", "(address,bool)", "string[]"]
igual(cadena_abi_decodificar(t5, cadena_abi(t5, ["291", ["1110", "1929"], "1234567890", "Hello, world!", "-5", ["0x3535353535353535353535353535353535353535", verdadero], ["a", "bc"]])), ["291", ["1110", "1929"], "0x31323334353637383930", "0x48656c6c6f2c20776f726c6421", "-5", ["0x3535353535353535353535353535353535353535", verdadero], ["a", "bc"]], "ABI ida y vuelta")
igual(cadena_bytes_entero(cadena_entero_bytes("115792089237316195423570985008687907853269984665640564039457584007913129639935")), "115792089237316195423570985008687907853269984665640564039457584007913129639935", "uint256 máximo exacto")
igual(cadena_direccion_contrato("0x6ac7ea33f8831ea9dcc53393aaa88b25a785dbf0", 0), "0xcd234A471b72ba2F1Ccf0A70FCABA648a5eeCD8d", "dirección de contrato")
igual([hex_de_bytes(cadena_rlp(["cat", "dog"])), cadena_de_rlp(cadena_rlp(["cat", ["dog", ""]]))], ["c88363617483646f67", ["cat", ["dog", ""]]], "RLP")
sea m = ""
intentar { cadena_firmar_tx(priv, {"gas": 1}) } capturar (e) { m = e }
igual(m, "cadena: falta el chain id (\"cadena\"): 1 = mainnet", "exige chain id")
mostrar("[OK] cadena")
