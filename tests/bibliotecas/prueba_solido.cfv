// Pruebas de solido (física 3D de cuerpos rígidos).
importar "solido"
funcion cerca(a, b, tol, q) { afirmar(absoluto(a - b) <= tol, q + ": " + a + " vs " + b) }
funcion pasos(m, n) {
    sea i = 0
    mientras (i < n) {
        solido_paso(m, 1 / 60)
        i = i + 1
    }
}

// Esfera sobre el piso: queda apoyada y se duerme.
sea m = solido_mundo(nulo)
sea piso = solido_cuerpo(m, {"forma": solido_plano([0, 1, 0], 0)})
sea e = solido_cuerpo(m, {"forma": solido_esfera(0.5), "posicion": [0, 3, 0]})
pasos(m, 180)
cerca(solido_posicion(m, e)[1], 0.5, 0.01, "esfera apoyada")
afirmar(solido_dormido(m, e), "se duerme")
// Un impulso la despierta.
solido_poner_velocidad(m, e, [0, 5, 0], nulo)
afirmar(solido_dormido(m, e) == falso, "despierta")
pasos(m, 5)
afirmar(solido_posicion(m, e)[1] > 0.6, "salta")

// Pila de cajas estable.
sea m2 = solido_mundo(nulo)
solido_cuerpo(m2, {"forma": solido_plano([0, 1, 0], 0)})
sea cajas = []
sea k = 0
mientras (k < 4) {
    cajas.agregar(solido_cuerpo(m2, {"forma": solido_caja([0.5, 0.5, 0.5]), "posicion": [0, 0.5 + k, 0]}))
    k = k + 1
}
pasos(m2, 240)
k = 0
mientras (k < 4) {
    sea p = solido_posicion(m2, cajas[k])
    cerca(p[1], 0.5 + k, 0.02, "altura de la caja " + k)
    cerca(p[0], 0, 0.02, "sin deslizarse " + k)
    k = k + 1
}
afirmar(solido_dormido(m2, cajas[3]), "la pila se duerme")

// Rebote con restitución 0,8 desde 2 m: sube cerca de 0,8² · 2.
sea m3 = solido_mundo({"dormir": falso})
solido_cuerpo(m3, {"forma": solido_plano([0, 1, 0], 0), "restitucion": 0.8})
sea pelota = solido_cuerpo(m3, {"forma": solido_esfera(0.25), "posicion": [0, 2.25, 0], "restitucion": 0.8, "amortiguacion": 0})
sea reboto = falso
sea maximo_y = 0
sea i = 0
mientras (i < 150) {
    solido_paso(m3, 1 / 120)
    sea vy = solido_velocidad(m3, pelota)[1]
    si (vy > 0) { reboto = verdadero }
    si (reboto) { maximo_y = maximo(maximo_y, solido_posicion(m3, pelota)[1] - 0.25) }
    i = i + 1
}
cerca(maximo_y, 0.64 * 2, 0.3, "altura del rebote")

// Choque elástico de dos esferas iguales: intercambian velocidades.
sea m4 = solido_mundo({"gravedad": [0, 0, 0], "dormir": falso})
sea a = solido_cuerpo(m4, {"forma": solido_esfera(0.5), "posicion": [-2, 0, 0], "velocidad": [2, 0, 0], "restitucion": 1, "amortiguacion": 0})
sea b = solido_cuerpo(m4, {"forma": solido_esfera(0.5), "posicion": [0, 0, 0], "restitucion": 1, "amortiguacion": 0})
pasos(m4, 90)
cerca(solido_velocidad(m4, a)[0], 0, 0.15, "la primera se detiene")
cerca(solido_velocidad(m4, b)[0], 2, 0.15, "la segunda sale con 2 m/s")

// Rampa de 20°: con mucha fricción se queda, con poca se desliza.
funcion rampa(mu) {
    sea mm = solido_mundo({"dormir": falso})
    sea ang = 20 * 3.141592653589793 / 180
    sea q = solido_cuaternion([0, 0, 1], ang)
    solido_cuerpo(mm, {"forma": solido_caja([5, 0.2, 2]), "tipo": "estatico", "rotacion": q, "friccion": mu})
    // Normal de la rampa y punto sobre ella.
    sea nx = 0 - seno(ang)
    sea ny = coseno(ang)
    sea c = solido_cuerpo(mm, {"forma": solido_caja([0.3, 0.3, 0.3]), "rotacion": q, "posicion": [nx * 0.51, ny * 0.51, 0], "friccion": mu})
    sea x0 = solido_posicion(mm, c)
    pasos(mm, 90)
    sea x1 = solido_posicion(mm, c)
    retornar raiz((x1[0] - x0[0]) * (x1[0] - x0[0]) + (x1[1] - x0[1]) * (x1[1] - x0[1]))
}
afirmar(rampa(0.9) < 0.05, "con fricción no se mueve")
afirmar(rampa(0.05) > 0.5, "sin fricción se desliza")

// Péndulo con una barra de 2 m: período 2π·√(L/g).
sea m5 = solido_mundo({"dormir": falso})
sea ancla = solido_cuerpo(m5, {"forma": solido_esfera(0.05), "tipo": "estatico", "posicion": [0, 3, 0]})
sea masa = solido_cuerpo(m5, {"forma": solido_esfera(0.1), "posicion": [0.2, 1.01, 0], "amortiguacion": 0})
solido_distancia(m5, ancla, masa, [0, 3, 0], [0.2, 1.01, 0], nulo)
sea cruces = []
sea anterior = solido_posicion(m5, masa)[0]
i = 0
mientras (i < 480) {
    solido_paso(m5, 1 / 120)
    sea x = solido_posicion(m5, masa)[0]
    si (anterior > 0 y x <= 0) { cruces.agregar(i / 120) }
    anterior = x
    i = i + 1
}
afirmar(longitud(cruces) >= 2, "oscila")
cerca(cruces[1] - cruces[0], 2 * 3.141592653589793 * raiz(2 / 9.81), 0.08, "período del péndulo")
sea dist = solido_posicion(m5, masa)
cerca(raiz(dist[0] * dist[0] + (dist[1] - 3) * (dist[1] - 3) + dist[2] * dist[2]), 2, 0.03, "la barra mantiene el largo")

// Bisagra vertical con límite de 0,5 rad.
sea m6 = solido_mundo({"gravedad": [0, 0, 0], "dormir": falso})
sea poste = solido_cuerpo(m6, {"forma": solido_caja([0.05, 1, 0.05]), "tipo": "estatico", "posicion": [0, 1, 0]})
sea puerta = solido_cuerpo(m6, {"forma": solido_caja([0.5, 1, 0.05]), "posicion": [0.55, 1, 0]})
sea bis = solido_bisagra(m6, poste, puerta, [0.05, 1, 0], [0, 1, 0], {"max": 0.5})
solido_impulso(m6, puerta, [0, 0, -300], [1, 1, 0])
pasos(m6, 60)
sea w = solido_velocidad_angular(m6, puerta)
cerca(w[0], 0, 0.05, "sin giro en X")
cerca(w[2], 0, 0.05, "sin giro en Z")
afirmar(solido_angulo(m6, bis) <= 0.65, "respeta el límite: " + solido_angulo(m6, bis))
afirmar(solido_angulo(m6, bis) > 0.3, "giró")

// Unión fija: dos cajas caen juntas.
sea m7 = solido_mundo(nulo)
solido_cuerpo(m7, {"forma": solido_plano([0, 1, 0], 0)})
sea c1 = solido_cuerpo(m7, {"forma": solido_caja([0.25, 0.25, 0.25]), "posicion": [0, 2, 0]})
sea c2 = solido_cuerpo(m7, {"forma": solido_caja([0.25, 0.25, 0.25]), "posicion": [0.5, 2, 0]})
solido_fija(m7, c1, c2)
pasos(m7, 120)
sea p1 = solido_posicion(m7, c1)
sea p2 = solido_posicion(m7, c2)
cerca(p2[0] - p1[0], 0.5, 0.03, "siguen juntas")
cerca(p1[1], 0.25, 0.03, "apoyadas")

// Cápsula de pie y caja girada que cae plana.
sea m8 = solido_mundo(nulo)
solido_cuerpo(m8, {"forma": solido_plano([0, 1, 0], 0)})
sea cap = solido_cuerpo(m8, {"forma": solido_capsula(0.3, 0.5), "posicion": [-3, 2, 0], "amortiguacion_angular": 1})
sea girada = solido_cuerpo(m8, {"forma": solido_caja([0.5, 0.5, 0.5]), "posicion": [3, 2, 0], "rotacion": solido_cuaternion([1, 1, 0], 0.3)})
pasos(m8, 240)
afirmar(solido_posicion(m8, cap)[1] < 0.85 y solido_posicion(m8, cap)[1] > 0.25, "cápsula apoyada: " + solido_posicion(m8, cap)[1])
cerca(solido_posicion(m8, girada)[1], 0.5, 0.03, "caja plana")

// Rayo y consulta por esfera.
sea golpe = solido_rayo(m2, [0, 10, 0], [0, -1, 0], 100, nulo)
eq_rayo(golpe, cajas[3])
funcion eq_rayo(golpe, id) {
    afirmar(golpe != nulo y golpe["cuerpo"] == id, "el rayo pega en la caja de arriba")
    cerca(golpe["distancia"], 6, 0.03, "distancia del rayo")
    cerca(golpe["normal"][1], 1, 0.01, "normal hacia arriba")
}
afirmar(solido_rayo(m2, [5, 10, 0], [0, 1, 0], 100, nulo) == nulo, "rayo que no pega")
sea toca = solido_superpuestos(m2, [0, 0.5, 0], 0.6)
afirmar(contiene(toca, cajas[0]) y contiene(toca, cajas[3]) == falso, "superpuestos")

// Islas: dos montones separados.
sea m9 = solido_mundo({"dormir": falso})
solido_cuerpo(m9, {"forma": solido_plano([0, 1, 0], 0)})
solido_cuerpo(m9, {"forma": solido_caja([0.5, 0.5, 0.5]), "posicion": [-5, 0.5, 0]})
solido_cuerpo(m9, {"forma": solido_caja([0.5, 0.5, 0.5]), "posicion": [-5, 1.5, 0]})
solido_cuerpo(m9, {"forma": solido_caja([0.5, 0.5, 0.5]), "posicion": [5, 0.5, 0]})
solido_cuerpo(m9, {"forma": solido_caja([0.5, 0.5, 0.5]), "posicion": [5, 1.5, 0]})
pasos(m9, 3)
afirmar(longitud(solido_islas(m9)) == 2, "dos islas")

// Un cuerpo cinemático empuja a una esfera.
sea m10 = solido_mundo({"gravedad": [0, 0, 0], "dormir": falso})
sea pala = solido_cuerpo(m10, {"forma": solido_caja([0.2, 1, 1]), "tipo": "cinematico", "posicion": [-1, 0, 0], "velocidad": [1, 0, 0]})
sea bola = solido_cuerpo(m10, {"forma": solido_esfera(0.5), "posicion": [0, 0, 0]})
pasos(m10, 60)
afirmar(solido_posicion(m10, bola)[0] > 0.5, "empujada")
cerca(solido_posicion(m10, pala)[0], 0, 0.02, "el cinemático sigue su velocidad")
mostrar("[OK] solido")
