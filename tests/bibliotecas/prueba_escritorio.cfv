// Pruebas de escritorio (XAML + estilos + enlaces al estilo Avalonia).
importar "escritorio"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

// App de tareas (datos/escritorio-tareas.axaml).
sea cambios = []
sea modelo = {
    "Nombre": "", "Tareas": [], "Oscuro": falso, "Volumen": 30, "Pais": nulo, "EsBasico": verdadero, "EsPro": falso,
    "Paises": ["Chile", "Peru", "Mexico"],
    "PuedeAgregar": funcion(m) { retornar m["Nombre"] != "" },
    "Agregar": funcion(m, p) {
        si (m["Nombre"] != "") {
            m["Tareas"].agregar({"Titulo": m["Nombre"], "Hecha": falso})
            m["Nombre"] = ""
        }
    },
    "Borrar": funcion(m, t) {
        sea r = []
        para x en m["Tareas"] { si (x != t) { r.agregar(x) } }
        m["Tareas"] = r
    },
    "Resumen": funcion(m) {
        sea n = 0
        para x en m["Tareas"] { si (x["Hecha"]) { n = n + 1 } }
        retornar "" + n + " de " + longitud(m["Tareas"]) + " hechas"
    },
    "AlCambiar": funcion(m, prop) { cambios.agregar(prop) }
}
sea v = escritorio_ventana(leer_archivo("tests/bibliotecas/datos/escritorio-tareas.axaml"), modelo)
escritorio_simular(v)
// Botón deshabilitado por enlace (IsEnabled) hasta que haya texto.
escritorio_clic_en(v, "agregar")
eq(longitud(modelo["Tareas"]), 0, "IsEnabled enlazado")
escritorio_clic_en(v, "Nueva tarea")
escritorio_escribir(v, "pan")
eq(modelo["Nombre"], "pan", "TextBox de dos vías")
escritorio_clic_en(v, "agregar")
escritorio_clic_en(v, "Nueva tarea")
escritorio_escribir(v, "leche")
escritorio_tecla(v, "enter", nulo)
eq([modelo["Tareas"][0]["Titulo"], modelo["Tareas"][1]["Titulo"], modelo["Nombre"]], ["pan", "leche", ""], "Command y KeyBinding Enter")
afirmar(contiene(cambios, "Nombre"), "AlCambiar avisa")
// Plantillas: la casilla escribe en el elemento; el botón usa $parent.
escritorio_clic_en(v, "pan")
eq(modelo["Tareas"][0]["Hecha"], verdadero, "IsChecked en la plantilla")
eq(escritorio_buscar(v, "1 de 2 hechas") != nulo, verdadero, "propiedad calculada")
sea rx = escritorio_buscar(v, "leche")
escritorio_clic(v, rx[0] + rx[2] + 20, rx[1] + rx[3] / 2)
eq(longitud(modelo["Tareas"]), 1, "CommandParameter='\{Binding}' con $parent[ItemsControl]")
// StringFormat, Slider, ComboBox, ToggleSwitch y RadioButton con grupo.
afirmar(escritorio_buscar(v, "Volumen: 30.0") != nulo, "StringFormat \{0:F1}")
sea rs = escritorio_buscar(v, "vol")
escritorio_clic(v, rs[0] + 7 + (rs[2] - 14) * 0.75, rs[1] + 5)
afirmar(modelo["Volumen"] > 74 y modelo["Volumen"] < 76, "Slider: " + modelo["Volumen"])
escritorio_clic_en(v, "pais")
sea rp = escritorio_buscar(v, "pais")
escritorio_clic(v, rp[0] + 4, rp[1] + rp[3] + (12 * 1.3 + 8) + 3)
eq(modelo["Pais"], "Peru", "ComboBox SelectedItem")
escritorio_clic_en(v, "Modo oscuro")
eq(modelo["Oscuro"], verdadero, "ToggleSwitch")
eq(escritorio_buscar(v, "Solo pro"), nulo, "IsVisible falso")
escritorio_clic_en(v, "Pro")
eq([modelo["EsBasico"], modelo["EsPro"]], [falso, verdadero], "RadioButton desmarca al resto del grupo")
afirmar(escritorio_buscar(v, "Solo pro") != nulo, "IsVisible verdadero")
// DockPanel: arriba el título, abajo el resumen.
eq(escritorio_buscar(v, "Mis tareas")[1], 10, "Dock Top")
sea rr = escritorio_buscar(v, "resumen")
cerca_fin(rr[1] + rr[3], 410)
funcion cerca_fin(a, b) { afirmar(absoluto(a - b) < 1, "Dock Bottom: " + a) }
// Estilos: clase en TextBlock y selector hijo (StackPanel.acciones > Button).
sea l = lienzo_crear(360, 420)
escritorio_dibujar(v, l)
sea ra = escritorio_buscar(v, "agregar")
eq(imagen_pixel(l, piso(ra[0] + 3), piso(ra[1] + ra[3] / 2)), [46, 125, 50, 255], "Background por estilo")
sea azul = falso
sea rt = escritorio_buscar(v, "Mis tareas")
afirmar(rt[3] > 20, "FontSize por estilo")
sea x = piso(rt[0])
mientras (x < rt[0] + rt[2]) {
    sea yy = piso(rt[1])
    mientras (yy < rt[1] + rt[3]) {
        sea px = imagen_pixel(l, x, yy)
        si (px[2] > px[0] + 60 y px[0] < 100) { azul = verdadero }
        yy = yy + 1
    }
    x = x + 1
}
afirmar(azul, "Foreground por estilo")

// Grid, Border, :disabled, ListBox, tema oscuro y Margin.
sea m2 = {"Elegido": nulo, "Frutas": ["manzana", "pera", "uva"], "Listo": falso, "Enviar": funcion(m, p) { m["Listo"] = verdadero }, "Activo": falso}
sea x2 = "<Window Width='300' Height='200' RequestedThemeVariant='Dark' Background='#202020'>"
x2 = x2 + "<Window.Styles><Style Selector='Button:disabled'><Setter Property='Background' Value='#ff0000'/></Style></Window.Styles>"
x2 = x2 + "<Grid RowDefinitions='Auto,*,40' ColumnDefinitions='100,*' Margin='10,5'>"
x2 = x2 + "<Border Grid.Row='0' Grid.ColumnSpan='2' Name='cab' Background='#AA112233' Padding='4' CornerRadius='3'><TextBlock>Cabecera</TextBlock></Border>"
x2 = x2 + "<ListBox Grid.Row='1' Grid.Column='0' Name='lista' ItemsSource='\{Binding Frutas}' SelectedItem='\{Binding Elegido}'/>"
x2 = x2 + "<TextBlock Grid.Row='1' Grid.Column='1' Name='elegido' Text='\{Binding Elegido, StringFormat=Fruta: \{0}}' HorizontalAlignment='Center'/>"
x2 = x2 + "<Button Grid.Row='2' Grid.Column='1' Name='enviar' Content='Enviar' Command='\{Binding Enviar}' IsEnabled='\{Binding !Listo}'/>"
x2 = x2 + "</Grid></Window>"
sea v2 = escritorio_ventana(x2, m2)
escritorio_simular(v2)
eq(escritorio_buscar(v2, "cab"), [10, 5, 280, 23.6], "Grid: fila Auto y ColumnSpan")
sea rl = escritorio_buscar(v2, "lista")
eq([rl[0], rl[2]], [10, 100], "columna fija")
escritorio_clic_en(v2, "pera")
eq(m2["Elegido"], "pera", "ListBox SelectedItem")
afirmar(escritorio_buscar(v2, "Fruta: pera") != nulo, "StringFormat sin comillas")
sea re = escritorio_buscar(v2, "elegido")
afirmar(re[0] > 110 + 40, "HorizontalAlignment=Center")
escritorio_clic_en(v2, "enviar")
eq(m2["Listo"], verdadero, "comando")
sea l2 = lienzo_crear(300, 200)
escritorio_dibujar(v2, l2)
sea rb = escritorio_buscar(v2, "enviar")
eq(imagen_pixel(l2, piso(rb[0] + 3), piso(rb[1] + rb[3] / 2)), [255, 0, 0, 255], "estilo :disabled con \{Binding !Listo}")
eq(imagen_pixel(l2, 299, 199), [32, 32, 32, 255], "Background de la ventana")
sea pc = imagen_pixel(l2, 12, 8)
afirmar(pc[2] > pc[0] y pc[3] == 255, "Border #AARRGGBB")
eq(escritorio_color("#80ff0000"), [255, 0, 0, 128], "colores ARGB")
eq(escritorio_color("SteelBlue"), [70, 130, 180, 255], "colores con nombre")
// Errores claros.
sea error = ""
intentar { escritorio_ventana("<Window><Foo/></Window>", {})["app"]["vista"]({}) } capturar (e) { error = "" + e }
afirmar(texto_contiene(error, "control no soportado <Foo>"), "error: " + error)
mostrar("[OK] escritorio")
