// Lote 37 en inglés: opencv, libwebp y leptonica.
importar "opencv"
importar "libwebp"
importar "leptonica"

sea m = cv_from_image(imagen_cargar("tests/bibliotecas/datos/vision/escena.png"))
sea t = cv_threshold(cv_gray(m), 0, 255, "otsu")
afirmar(t["threshold"] == 128, "cv_threshold")
afirmar(longitud(cv_connected_components(t["image"], 8)["stats"]) == 4, "cv_connected_components")
sea w = webp_encode_lossless(imagen_nueva(3, 2, [1, 2, 3, 255]))
afirmar(webp_get_info(w)["width"] == 3 y webp_decode(w)["pixeles"] == imagen_nueva(3, 2, [1, 2, 3, 255])["pixeles"], "webp")
sea g = cv_gray(cv_from_image(imagen_cargar("tests/bibliotecas/datos/escaner/rotada_+3.png")))
sea s = pix_find_skew(pix_sauvola(g, 15, 0.2, 128), 7, 0.25)
afirmar(absoluto(s["angle"] - 3) <= 0.2, "pix_find_skew")
mostrar("[OK] en_lote37")
