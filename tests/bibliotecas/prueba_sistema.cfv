importar "sistema"
// Los valores cambian de una máquina a otra: se revisa forma y coherencia
// (en Linux los números coinciden con psutil).
sea info = sistema_info()
afirmar(info["so"] == "linux" o info["so"] == "macos", "sistema operativo")
afirmar(tipo(info["nucleo"]) == "texto" y longitud(info["nucleo"]) > 0, "núcleo")
sea c = sistema_cpu()
afirmar(c["nucleos"] >= 1 y longitud(c["carga"]) == 3, "cpu")
sea m = sistema_memoria()
afirmar(m["total"] > 0 y m["disponible"] >= 0 y m["disponible"] <= m["total"] y m["usada"] == m["total"] - m["disponible"], "memoria")
afirmar(m["porcentaje"] >= 0 y m["porcentaje"] <= 100, "porcentaje de memoria")
sea raiz_ = sistema_espacio("/")
afirmar(raiz_["total"] > 0 y raiz_["libre"] <= raiz_["total"], "espacio en /")
afirmar(longitud(sistema_discos()) >= 1, "discos")
afirmar(tipo(sistema_red()) == "mapa", "red")
sea yo = sistema_proceso(sistema_pid())
afirmar(yo != nulo y yo["memoria"] > 0 y yo["pid"] == sistema_pid(), "este proceso")
afirmar(sistema_proceso(999999999) == nulo, "proceso inexistente")
sea ps = sistema_procesos()
afirmar(longitud(ps) >= 1, "procesos")
sea uso = sistema_uso_cpu(50)
afirmar(uso["total"] == nulo o (uso["total"] >= 0 y uso["total"] <= 100), "uso de cpu")
afirmar(tipo(sistema_temperaturas()) == "lista", "temperaturas")
afirmar(texto_indice(sistema_comando("echo hola"), "hola") >= 0, "comando")
afirmar(texto_indice(sistema_resumen(), "núcleos") > 0, "resumen")
mostrar("[OK] sistema")
