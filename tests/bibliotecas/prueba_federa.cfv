importar "federa"
importar "json"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Tokens y JWKS generados con PyJWT + cryptography (RSA 2048 y Ed25519).
