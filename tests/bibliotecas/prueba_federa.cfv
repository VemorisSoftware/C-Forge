sea op = {"jwks": jwks, "emisor": "https://idp.example", "audiencia": "cliente1", "nonce": "n0nce", "ahora_ms": 1763769600000, "secreto": "secreto-largo-de-prueba-123456789"}
igual(federa_validar_id_token(T["rs256"], op)["email"], "a@b.c", "RS256 con JWKS")
igual(federa_validar_id_token(T["rs512"], op)["sub"], "u1", "RS512")
igual(federa_validar_id_token(T["eddsa"], op)["sub"], "u1", "EdDSA (Ed25519)")
igual(federa_validar_id_token(T["hs256"], op)["sub"], "u1", "HS256")
sea casos = [["vencido", "federa: el token venció"], ["otro_aud", "federa: el token no es para esta audiencia"], ["alterado", "federa: firma inválida"], ["none", "federa: algoritmo no permitido: none"]]
para c en casos {
    sea m = ""
    intentar { federa_validar_id_token(T[c[0]], op) } capturar (e) { m = e }
    igual(m, c[1], c[0])
}
sea m = ""
op["nonce"] = "otro"
intentar { federa_validar_id_token(T["rs256"], op) } capturar (e) { m = e }
igual(m, "federa: el nonce no coincide (posible repetición)", "nonce")
op["nonce"] = "n0nce"
op["emisor"] = "https://malo.example"
intentar { federa_validar_id_token(T["rs256"], op) } capturar (e) { m = e }
igual(m, "federa: emisor inesperado https://idp.example", "emisor")
sea solo_rs = {"jwks": jwks, "algoritmos": ["RS256"]}
intentar { federa_verificar_firma(T["hs256"], solo_rs) } capturar (e) { m = e }
igual(m, "federa: algoritmo no permitido: HS256", "lista de algoritmos")
igual(federa_jwt(T["rs256"])["cabecera"]["kid"], "r1", "separar el JWT")
sea p = federa_pkce()
igual([longitud(p["verificador"]), federa_b64url(sha256_bytes(p["verificador"])) == p["desafio"], p["metodo"]], [64, verdadero, "S256"], "PKCE")
afirmar(federa_aleatorio() != federa_aleatorio(), "aleatorio")
igual(federa_url_autorizacion({"autorizacion": "https://idp.example/auth", "cliente": "c 1", "redireccion": "https://app/cb?x=1", "alcance": "openid email", "estado": "abc", "desafio": "XYZ", "nonce": "n"}), "https://idp.example/auth?response_type=code&client_id=c%201&redirect_uri=https%3A%2F%2Fapp%2Fcb%3Fx%3D1&scope=openid%20email&state=abc&nonce=n&code_challenge=XYZ&code_challenge_method=S256", "URL de autorización")
intentar { federa_url_autorizacion({"autorizacion": "http://idp.example/auth", "estado": "x"}) } capturar (e) { m = e }
igual(m, "federa: la URL de autorización debe ser https", "exige https")
igual(federa_callback("/cb?code=4%2F0Ab&state=abc", "abc"), {"codigo": "4/0Ab", "estado": "abc"}, "callback")
intentar { federa_callback("?code=x&state=zzz", "abc") } capturar (e) { m = e }
igual(m, "federa: el state no coincide (posible CSRF)", "state distinto")
intentar { federa_callback("?error=access_denied&error_description=no+quiso", "abc") } capturar (e) { m = e }
igual(m, "federa: el proveedor respondió access_denied: no quiso", "error del proveedor")
igual(federa_cuerpo_canje({"cliente": "c1", "redireccion": "https://app/cb"}, "co de", "ver"), "grant_type=authorization_code&code=co%20de&redirect_uri=https%3A%2F%2Fapp%2Fcb&client_id=c1&code_verifier=ver", "cuerpo del canje")
sea tk = federa_respuesta_token("{\"access_token\": \"at\", \"expires_in\": 3600, \"refresh_token\": \"rt\"}", 1000)
igual([tk["acceso"], tk["refresco"], tk["vence_ms"], federa_por_vencer(tk, 3550000), federa_por_vencer(tk, 1000)], ["at", "rt", 3601000, verdadero, falso], "respuesta del token")
sea desc = federa_descubrimiento("{\"issuer\": \"https://idp.example\", \"authorization_endpoint\": \"https://idp.example/a\", \"token_endpoint\": \"https://idp.example/t\", \"jwks_uri\": \"https://idp.example/k\"}")
igual([desc["emisor"], desc["token"]], ["https://idp.example", "https://idp.example/t"], "descubrimiento")
mostrar("[OK] federa")
