importar "grafos"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Valores comparados con NetworkX.
sea g = grafos_nuevo(falso)
para e en [["a", "b", 7], ["a", "c", 9], ["a", "f", 14], ["b", "c", 10], ["b", "d", 15], ["c", "d", 11], ["c", "f", 2], ["d", "e", 6], ["e", "f", 9]] { grafos_arista(g, e[0], e[1], e[2]) }
sea r = grafos_dijkstra(g, "a", "e")
igual([r["distancia"], r["camino"]], [20, ["a", "c", "f", "e"]], "Dijkstra")
igual(grafos_dijkstra(g, "a")["distancias"]["d"], 20, "todas las distancias")
igual(grafos_bellman_ford(g, "a")["distancias"]["e"], 20, "Bellman-Ford")
igual(grafos_floyd_warshall(g)["b"]["f"], 12, "Floyd-Warshall")
sea ks = []
para x en grafos_k_caminos(g, "a", "e", 3) { ks.agregar(x["distancia"]) }
igual(ks, [20, 23, 26], "k caminos (Yen)")
igual(grafos_arbol_minimo(g)["peso"], 33, "árbol mínimo")
igual(grafos_flujo_maximo(g, "a", "e")["flujo"], 15, "flujo máximo")
igual(grafos_bfs(g, "a"), ["a", "b", "c", "f", "d", "e"], "BFS")
igual(grafos_dfs(g, "a"), ["a", "b", "c", "d", "e", "f"], "DFS")
// Dirigido: orden topológico, ciclos, componentes fuertes.
sea d = grafos_nuevo(verdadero)
para e en [["ropa", "zapatos"], ["calcetines", "zapatos"], ["pantalón", "zapatos"], ["pantalón", "cinturón"], ["camisa", "cinturón"], ["camisa", "corbata"], ["corbata", "chaqueta"], ["cinturón", "chaqueta"]] { grafos_arista(d, e[0], e[1]) }
sea topo = grafos_topologico(d)
sea pos = {}
sea i = 0
para n en topo { pos[n] = i  i = i + 1 }
afirmar(pos["camisa"] < pos["corbata"] y pos["corbata"] < pos["chaqueta"] y pos["pantalón"] < pos["zapatos"], "topológico")
igual(grafos_tiene_ciclo(d), falso, "sin ciclo")
grafos_arista(d, "chaqueta", "camisa")
igual(grafos_tiene_ciclo(d), verdadero, "con ciclo")
sea fc = grafos_fuertemente_conexas(d)
sea grande = 0
para c en fc { grande = maximo(grande, longitud(c)) }
igual(grande, 4, "componentes fuertes")
// Bellman-Ford con pesos negativos y ciclo negativo.
sea ng = grafos_nuevo(verdadero)
grafos_arista(ng, "s", "a", 4)
grafos_arista(ng, "s", "b", 5)
grafos_arista(ng, "b", "a", -3)
igual(grafos_bellman_ford(ng, "s")["distancias"]["a"], 2, "pesos negativos")
grafos_arista(ng, "a", "b", 1)
sea neg = falso
intentar { grafos_bellman_ford(ng, "s") } capturar (e) { neg = verdadero }
igual(neg, verdadero, "ciclo negativo")
// Puentes, articulaciones, componentes, coloreo, emparejamiento.
sea p = grafos_nuevo(falso)
para e en [[1, 2], [2, 3], [3, 1], [3, 4], [4, 5], [5, 6], [6, 4], [7, 8]] { grafos_arista(p, e[0], e[1]) }
sea pa = grafos_puentes(p)
igual([pa["puentes"], pa["articulaciones"], longitud(grafos_componentes(p))], [[["3", "4"], ["7", "8"]], ["3", "4"], 2], "puentes")
sea col = grafos_colorear(p)
sea ok = verdadero
para e en grafos_aristas(p) { si (col[e["desde"]] == col[e["hasta"]]) { ok = falso } }
afirmar(ok, "coloreo válido")
sea b = grafos_nuevo(falso)
para e en [["ana", "python"], ["ana", "rust"], ["leo", "python"], ["sol", "rust"], ["sol", "go"]] { grafos_arista(b, e[0], e[1]) }
igual(longitud(claves(grafos_emparejamiento(b, ["ana", "leo", "sol"]))), 3, "emparejamiento")
// PageRank, intermediación, camino euleriano, DOT.
sea w = grafos_nuevo(verdadero)
para e en [["a", "b"], ["b", "c"], ["c", "a"], ["a", "c"]] { grafos_arista(w, e[0], e[1]) }
sea pr = grafos_pagerank(w)
afirmar(absoluto(pr["a"] - 0.3878) < 0.001 y absoluto(pr["a"] + pr["b"] + pr["c"] - 1) < 1e-9, "PageRank")
sea camino = grafos_nuevo(falso)
para e en [["a", "b"], ["b", "c"], ["c", "d"]] { grafos_arista(camino, e[0], e[1]) }
igual(redondear(grafos_intermediacion(camino, verdadero)["b"], 4), 0.6667, "intermediación")
igual(grafos_euleriano(camino), ["a", "b", "c", "d"], "euleriano")
igual(grafos_dot(camino), "graph \"G\" " + caracter(123) + "\n  \"a\";\n  \"b\";\n  \"c\";\n  \"d\";\n  \"a\" -- \"b\";\n  \"b\" -- \"c\";\n  \"c\" -- \"d\";\n" + caracter(125) + "\n", "DOT")
mostrar("[OK] grafos")
