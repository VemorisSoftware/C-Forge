importar "columnas"
importar "base64"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Archivos escritos por pyarrow: Parquet con zstd (páginas v1 y diccionario),
// Parquet con snappy y páginas v2, y flujo IPC de Arrow.
sea esperado = [{"id": 1, "nombre": "Ana", "ok": verdadero, "ts": 1, "x": 0.5}, {"id": nulo, "nombre": "Luis", "ok": nulo, "ts": nulo, "x": -1.25}, {"id": 3, "nombre": nulo, "ok": falso, "ts": 2, "x": nulo}]
para par en [["", "parquet v1"], ["", "parquet v2"], ["", "arrow"]] {
    sea d = base64_decodificar(par[0])
    sea t = nulo
    si (par[1] == "arrow") { t = columnas_arrow_leer(d) } sino { t = columnas_parquet_leer(d, nulo) }
    igual(columnas_filas(t), esperado, par[1])
    igual(columnas_esquema(t), [{"nombre": "id", "tipo": "int64"}, {"nombre": "nombre", "tipo": "utf8"}, {"nombre": "x", "tipo": "float32"}, {"nombre": "ok", "tipo": "bool"}, {"nombre": "ts", "tipo": "timestamp_ms"}], "esquema " + par[1])
}
igual(columnas_parquet_info(base64_decodificar(""))["filas"], 3, "info")
igual(columnas_parquet_leer(base64_decodificar(""), {"columnas": ["nombre"]})["columnas"][0]["valores"], ["Ana", "Luis", nulo], "solo una columna")
// Escribir y volver a leer (pyarrow también lee estos archivos y obtiene lo mismo).
sea t = columnas_tabla({"id": [1, 2, 3, nulo, 5], "peq": [-1, 2, nulo, 127, -128], "u16": [0, 65535, 3, 4, nulo], "x": [1.5, nulo, -2.25, 3, 1e10], "f": [0.5, 1, nulo, -3.5, 2],
    "nombre": ["Ana", nulo, "Luis", "Ana", "ñandú"], "ok": [verdadero, falso, nulo, verdadero, verdadero], "dia": [19723, nulo, 1, 11016, -1], "ts": [0, 1700000000000000, nulo, -1, 5],
    "bin": [bytes_entero(1, 2, 0), "", nulo, "xyz", bytes_entero(255, 1, 0)]},
    {"id": "int64", "peq": "int8", "u16": "uint16", "x": "float64", "f": "float32", "nombre": "utf8", "ok": "bool", "dia": "date32", "ts": "timestamp_us", "bin": "binary"},
    ["id", "peq", "u16", "x", "f", "nombre", "ok", "dia", "ts", "bin"])
t["meta"] = {"autor": "c-forge"}
para c en ["snappy", "gzip", "zstd", "ninguna", "lz4"] {
    sea u = columnas_parquet_leer(columnas_parquet_escribir(t, {"compresion": c, "filas_por_grupo": 2}), nulo)
    igual([columnas_filas(u), u["meta"]], [columnas_filas(t), {"autor": "c-forge"}], "parquet " + c)
}
igual(columnas_filas(columnas_arrow_leer(columnas_arrow_flujo(t))), columnas_filas(t), "arrow flujo")
sea arch = columnas_arrow_archivo(t)
igual([subcadena(arch, 0, 6), columnas_esquema(columnas_arrow_leer(arch))[8]["tipo"], columnas_arrow_leer(arch)["meta"]["autor"]], ["ARROW1", "timestamp_us", "c-forge"], "arrow archivo")
// Diccionario: muchos valores repetidos.
sea v = []
sea n = []
sea i = 0
mientras (i < 300) {
    v.agregar(["rojo", "verde", "azul"][i % 3])
    si (i % 7 == 0) { n.agregar(nulo) } sino { n.agregar(i * 3) }
    i = i + 1
}
sea td = columnas_tabla({"color": v, "num": n}, {"color": "utf8", "num": "int32"}, ["color", "num"])
sea dd = columnas_parquet_escribir(td, nulo)
sea ud = columnas_parquet_leer(dd, nulo)
igual([columnas_columna(ud, "color")[298], columnas_columna(ud, "num")[7], columnas_columna(ud, "num")[8], longitud(dd) < 1500], ["verde", nulo, 24, verdadero], "diccionario")
// Utilidades de tablas.
sea f = columnas_desde_filas([{"a": 1, "b": "x"}, {"a": 2}], nulo, nulo)
igual([columnas_esquema(f), columnas_columna(f, "b")], [[{"nombre": "a", "tipo": "int64"}, {"nombre": "b", "tipo": "utf8"}], ["x", nulo]], "desde filas")
igual(columnas_filas(columnas_filtrar(t, funcion(r) { retornar r["ok"] == verdadero }))[2]["nombre"], "ñandú", "filtrar")
igual(columnas_esquema(columnas_seleccionar(t, ["x", "id"])), [{"nombre": "x", "tipo": "float64"}, {"nombre": "id", "tipo": "int64"}], "seleccionar")
igual(columnas_parquet_leer(columnas_parquet_escribir(columnas_tabla({"a": []}, {"a": "int32"}, nulo), nulo), nulo)["filas"], 0, "tabla vacía")
mostrar("[OK] columnas")
