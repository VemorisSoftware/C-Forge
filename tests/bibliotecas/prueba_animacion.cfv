importar "animacion"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion cerca(a, b, q) { afirmar(abs(a - b) < 0.01, q + ": " + a + " != " + b) }
// Con python-lottie se armaron animaciones (rectángulo que se mueve y
// gira, elipse con trazo que se desvanece, camino Bézier con degradado,
// estrella girando, capa animada); sus SVG rasterizados con rsvg-convert
// difieren de los PNG de animacion en menos de 0.2/255 de media.
// Propiedades animadas: lineal, con curva y con retención.
sea lineal = {"a": 1, "k": [{"t": 0, "s": [0, 0], "i": {"x": [1], "y": [1]}, "o": {"x": [0], "y": [0]}}, {"t": 10, "s": [100, 50]}]}
igual([animacion_valor(lineal, 0), animacion_valor(lineal, 5), animacion_valor(lineal, 10), animacion_valor(lineal, 20)], [[0, 0], [50, 25], [100, 50], [100, 50]], "lineal")
sea suave = {"a": 1, "k": [{"t": 0, "s": [0], "i": {"x": [0.58], "y": [1]}, "o": {"x": [0.42], "y": [0]}}, {"t": 10, "s": [100]}]}
sea v = animacion_valor(suave, 2)[0]
igual([v > 0, v < 20, animacion_valor(suave, 5)[0]], [verdadero, verdadero, 50], "ease-in-out")
sea ret = {"a": 1, "k": [{"t": 0, "s": [1], "h": 1}, {"t": 5, "s": [2], "h": 1}, {"t": 10, "s": [3]}]}
igual([animacion_valor(ret, 4), animacion_valor(ret, 6), animacion_valor(ret, 11)], [[1], [2], [3]], "retención")
igual(animacion_valor({"a": 0, "k": 7}, 3), 7, "estático")
// Una animación pequeña: un cuadrado azul que va de x=20 a x=140 y un
// círculo rojo con opacidad que baja de 100 a 0.
sea Q = caracter(34)
sea j = {"v": "5.7.0", "fr": 30, "ip": 0, "op": 30, "w": 200, "h": 100, "layers": [
    {"ty": 4, "ind": 1, "ip": 0, "op": 30, "st": 0, "ks": {"p": {"a": 1, "k": [{"t": 0, "s": [20, 50], "i": {"x": [1], "y": [1]}, "o": {"x": [0], "y": [0]}}, {"t": 30, "s": [140, 50]}]}},
     "shapes": [{"ty": "gr", "it": [{"ty": "rc", "p": {"a": 0, "k": [20, 0]}, "s": {"a": 0, "k": [40, 40]}, "r": {"a": 0, "k": 0}}, {"ty": "fl", "c": {"a": 0, "k": [0, 0, 1, 1]}, "o": {"a": 0, "k": 100}}, {"ty": "tr", "p": {"a": 0, "k": [0, 0]}}]}]},
    {"ty": 4, "ind": 2, "ip": 0, "op": 30, "st": 0, "ks": {"o": {"a": 1, "k": [{"t": 0, "s": [100], "i": {"x": [1], "y": [1]}, "o": {"x": [0], "y": [0]}}, {"t": 30, "s": [0]}]}},
     "shapes": [{"ty": "el", "p": {"a": 0, "k": [170, 20]}, "s": {"a": 0, "k": [20, 20]}}, {"ty": "fl", "c": {"a": 0, "k": [1, 0, 0, 1]}, "o": {"a": 0, "k": 100}}]}
]}
sea a = animacion_cargar(json_texto(j))
igual([animacion_info(a)["cuadros"], animacion_info(a)["segundos"], animacion_info(a)["capas"]], [30, 1, 2], "info")
funcion px(f, x, y) {
    sea c = vector_nuevo("png", 200, 100, {"fondo": "#ffffff"})
    animacion_dibujar(a, c, f)
    retornar imagen_pixel(vector_lienzo(c), x, y)
}
igual([px(0, 40, 50), px(0, 100, 50), px(15, 100, 50), px(15, 40, 50)], [[0, 0, 255, 255], [255, 255, 255, 255], [0, 0, 255, 255], [255, 255, 255, 255]], "movimiento")
igual([px(0, 170, 20), px(15, 170, 20)[1] > 120, px(29, 170, 20)[1] > 240], [[255, 0, 0, 255], verdadero, verdadero], "opacidad")
sea svg = animacion_cuadro(a, 0, "svg", nulo)
igual([contiene(svg, "<svg"), contiene(svg, "#0000ff"), contiene(svg, "#ff0000")], [verdadero, verdadero, verdadero], "SVG")
igual(subcadena(animacion_cuadro(a, 10, "png", {"escala": 0.5}), 1, 4), "PNG", "PNG")
mostrar("[OK] animacion")
