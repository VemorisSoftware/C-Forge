importar "ruido"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea r = ruido_nuevo(1234)
igual(ruido_perlin(r, 0, 0), 0, "Perlin vale 0 en la grilla")
igual(ruido_perlin(r, 3, 7, 2), 0, "Perlin 3D en la grilla")
igual(ruido_perlin(ruido_nuevo(1234), 3.3, 4.4), ruido_perlin(r, 3.3, 4.4), "determinista")
afirmar(ruido_perlin(ruido_nuevo(1), 3.3, 4.4) != ruido_perlin(ruido_nuevo(2), 3.3, 4.4), "semillas distintas")
sea lo = 9
sea hi = -9
sea suma = 0
sea i = 0
mientras (i < 3000) {
    sea x = i * 0.1371
    sea y_ = i * 0.0713
    para v en [ruido_perlin(r, x, y_), ruido_simplex(r, x, y_), ruido_valor(r, x, y_), ruido_perlin(r, x, y_, i * 0.01), ruido_fractal(r, x, y_)] {
        lo = minimo(lo, v)
        hi = maximo(hi, v)
        suma = suma + v
    }
    sea c = ruido_celular(r, x, y_)
    afirmar(c >= 0 y c <= 1, "celular en rango")
    i = i + 1
}
afirmar(lo >= -1.05 y hi <= 1.05, "rango ±1: " + lo + " " + hi)
afirmar(hi - lo > 0.8, "varía lo suficiente")
afirmar(absoluto(suma / 15000) < 0.1, "media cercana a 0")
// Continuidad: puntos muy cercanos dan valores cercanos.
afirmar(absoluto(ruido_perlin(r, 1.5, 2.5) - ruido_perlin(r, 1.5001, 2.5)) < 0.001, "continuo")
sea m = ruido_mapa(r, 16, 4, 0.1, {"octavas": 3, "tipo": "crestas"})
igual([longitud(m), longitud(m[0])], [4, 16], "mapa")
para f en m { para v en f { afirmar(v >= 0 y v <= 1, "mapa 0…1") } }
igual(longitud(texto_dividir(ruido_ascii(m), "\n")), 4, "ascii")
afirmar(ruido_fractal(r, 0.3, 0.3, {"tipo": "turbulento", "base": "simplex"}) != ruido_fractal(r, 0.3, 0.3), "variantes de fractal")
mostrar("[OK] ruido")
