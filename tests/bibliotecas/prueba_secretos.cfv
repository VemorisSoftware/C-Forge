importar "secretos"
importar "json"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea k = secretos_clave()
sea datos = {"db": {"clave": "s3cr3t", "puerto": 5432, "ssl": verdadero}, "lista": ["a", nulo], "nombre": "app"}
sea c = secretos_cifrar_json(datos, k, ["nombre"])
afirmar(texto_indice(c, "s3cr3t") < 0, "el secreto no queda en claro")
sea crudo = json_parsear(c)
igual([crudo["nombre"], secretos_es_cifrado(crudo["db"]["clave"]), secretos_es_cifrado(crudo["db"]["puerto"])], ["app", verdadero, verdadero], "claves legibles, valores cifrados")
igual(secretos_descifrar_json(c, k), datos, "ida y vuelta con tipos")
// Mover un valor cifrado a otro campo no funciona (atado a la ruta).
sea mov = json_parsear(c)
mov["db"]["puerto"] = mov["db"]["clave"]
sea sin = {}
para x en claves(mov) { si (x != "_secretos") { sin[x] = mov[x] } }
mov["_secretos"]["huella"] = hmac_sha256(bytes_de_hex(subcadena(k, 9, 73)), json_texto(sin))
sea m = ""
intentar { secretos_descifrar_json(json_texto(mov), k) } capturar (e) { m = e }
igual(m, "secretos: no se pudo descifrar /db/puerto (clave incorrecta o valor movido/alterado)", "ruta atada")
intentar { secretos_descifrar_json(c, secretos_clave()) } capturar (e) { m = e }
igual(m, "secretos: clave incorrecta o archivo modificado (la huella no coincide)", "clave incorrecta")
intentar { secretos_descifrar_json(texto_reemplazar(c, "\"app\"", "\"otra\""), k) } capturar (e) { m = e }
igual(m, "secretos: clave incorrecta o archivo modificado (la huella no coincide)", "campo en claro protegido por la huella")
sea env = secretos_cifrar_env("# config\nAPI_KEY=\"abc 123\"\nMODO=prod\n", k, ["MODO"])
afirmar(texto_indice(env, "# config") >= 0 y texto_indice(env, "MODO=prod") >= 0 y texto_indice(env, "abc 123") < 0, ".env cifrado")
igual(secretos_descifrar_env(env, k), {"API_KEY": "abc 123", "MODO": "prod"}, ".env descifrado")
igual(secretos_cifrar_env(env, k, ["MODO"]), env, "no cifra dos veces")
sea k2 = secretos_clave()
igual(secretos_descifrar_json(secretos_rotar_json(c, k, k2), k2), datos, "rotar clave")
intentar { secretos_cifrar_json({}, "mala") } capturar (e) { m = e }
igual(m, "secretos: clave inválida (usa secretos_clave())", "clave mal formada")
mostrar("[OK] secretos")
