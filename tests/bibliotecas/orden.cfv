importar "orden"
funcion igual(a, b, q) { afirmar(a == b, q + ": [" + a + "] != [" + b + "]") }
funcion nueva() {
    sea o = orden_nuevo("copiar", "Copia archivos")
    orden_bandera(o, "verboso", "v", "Muestra detalles")
    orden_opcion(o, "nivel", "n", "Nivel", "6")
    orden_opcion(o, "clave", nulo, "Clave", nulo, verdadero)
    orden_posicional(o, "origen", "Origen", verdadero)
    orden_posicional(o, "destino", "Destino")
    retornar o
}
sea a = orden_analizar(nueva(), ["-v", "--nivel=9", "--clave", "s3cr3t", "a.txt", "b.txt"])
igual(a["verboso"], verdadero, "bandera corta")
igual(a["nivel"], "9", "opción con =")
igual(a["clave"], "s3cr3t", "opción separada")
igual(a["origen"] + "→" + a["destino"], "a.txt→b.txt", "posicionales")
sea b = orden_analizar(nueva(), ["--clave", "x", "-n", "1", "a", "--", "-v", "--raro"])
igual(b["nivel"], "1", "opción corta")
igual(b["verboso"], falso, "defecto de la bandera")
igual(unir(b["resto"], " "), "-v --raro", "resto tras --")
igual(orden_analizar(nueva(), ["--ayuda"])["ayuda"], verdadero, "ayuda")
sea m = ""
intentar { orden_analizar(nueva(), ["--clave", "x"]) } capturar (e) { m = e }
igual(m, "copiar: falta <origen>", "posicional requerido")
intentar { orden_analizar(nueva(), ["a"]) } capturar (e) { m = e }
igual(m, "copiar: falta --clave", "opción requerida")
intentar { orden_analizar(nueva(), ["--clave", "x", "--raro", "a"]) } capturar (e) { m = e }
igual(m, "copiar: opción desconocida --raro", "desconocida")
intentar { orden_analizar(nueva(), ["--clave"]) } capturar (e) { m = e }
igual(m, "copiar: falta el valor de --clave", "sin valor")
intentar { orden_analizar(nueva(), ["--clave", "x", "a", "b", "c"]) } capturar (e) { m = e }
igual(m, "copiar: argumento de más: c", "de más")
intentar { orden_analizar(nueva(), ["--verboso=si"]) } capturar (e) { m = e }
igual(m, "copiar: --verboso no lleva valor", "bandera con valor")
sea ayuda = orden_ayuda(nueva())
afirmar(texto_empieza_con(ayuda, "uso: copiar [opciones] <origen> [destino]"), ayuda)
afirmar(texto_indice(ayuda, "-n, --nivel <valor>") >= 0 y texto_indice(ayuda, "(por defecto: 6)") >= 0, "ayuda de opciones")
mostrar("[OK] orden")
