// Written in English.
import "qrcode"
import "hexgrid"
import "geometry2d"
import "unicode_en"
import "schedule"
import "sqlfiles"
import "entities"
import "oidc"
function same(a, b, what) { assert(("" + a) == ("" + b), what + ": [" + a + "] != [" + b + "]") }
let q = qr_create("HELLO", {"level": "Q"})
same([q["version"], q["n"]], [1, 21], "qr_create")
assert(contains(qr_to_svg(q, {"module": 4, "border": 2}), "<svg"), "qr_to_svg")
same(barcode_ean13("400638133393")["texto"], "4006381333931", "barcode_ean13")
let cell = hex_cell(51.5007, -0.1246, 9)
same(hex_distance(cell, hex_neighbors(cell)[0]), 1, "hexgrid")
same(length(hex_disk(cell, 1)), 7, "hex_disk")
same(geom_min_enclosing_circle([[0, 0], [2, 0]]), {"center": [1, 0], "radius": 1}, "geometry2d")
same(length(geom_delaunay([[0, 0], [1, 0], [0, 1], [1, 1]])), 2, "geom_delaunay")
same([unicode_upper("straße"), unicode_strip_accents("Crème brûlée"), unicode_width("日本")], ["STRASSE", "Creme brulee", 4], "unicode_en")
same(unicode_sort(["b", "a10", "a2"], {"numeric": true}), ["a2", "a10", "b"], "unicode_sort")
let ny = tz_from_posix("EST5EDT,M3.2.0,M11.1.0")
same(tz_format(ny, 1773100000000), "2026-03-09T19:46:40-04:00", "tz_format")
same(tz_offset(ny, 1773100000000)["dst"], true, "tz_offset")
same(schedule_upcoming(schedule_cron("0 9 * * 1", ny), 1772900000000, 1), [1773061200000], "schedule")
let db = sql_new()
sql_register(db, "t", [{"k": "a", "v": 1}, {"k": "b", "v": 2}, {"k": "a", "v": 3}])
same(sql_query(db, "SELECT k, SUM(v) AS s FROM t GROUP BY k ORDER BY s DESC")["rows"], [{"k": "a", "s": 4}, {"k": "b", "s": 2}], "sqlfiles")
same(sql_scalar(db, "SELECT COUNT(*) FROM t WHERE v > ?", [1]), 2, "sql_scalar")
let w = entities_world()
let e = entities_create(w, {"hp": {"v": 10}})
entities_system(w, "hurt", ["hp"], function(w, e, c, dt) { c["hp"]["v"] = c["hp"]["v"] - 1 })
entities_step(w, 1)
same(entities_get(w, e, "hp")["v"], 9, "entities")
let p = oidc_pkce()
same(oidc_b64url(sha256_bytes(p["verifier"])), p["challenge"], "oidc_pkce")
let url = oidc_authorization_url({"authorization_endpoint": "https://idp/auth", "client_id": "x", "redirect_uri": "https://app/cb", "state": "s1", "code_challenge": p["challenge"]})
assert(contains(url, "code_challenge_method=S256"), "oidc_authorization_url")
same(oidc_callback("?code=c&state=s1", "s1")["code"], "c", "oidc_callback")
let tok = oidc_parse_token_response("{\"access_token\": \"a\", \"expires_in\": 10}", 0)
same([tok["access_token"], oidc_needs_refresh(tok, 0, 60)], ["a", true], "oidc tokens")
print("[OK] lote 11 in English")
