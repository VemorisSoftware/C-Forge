importar "idiomas"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea i = idiomas_nuevo({
    "es": {"saludo": "Hola, {{nombre}}", "carrito": {"items_cero": "Carrito vacío", "items_uno": "1 producto", "items_otro": "{{cuenta}} productos"}, "solo_es": "sí"},
    "en": {"saludo": "Hi, {{ nombre }}", "carrito": {"items_zero": "Empty cart", "items_one": "1 item", "items_other": "{{count}} items"}, "solo_en": "only"}
}, "es", "en")
igual(idiomas_t(i, "saludo", {"nombre": "Ana"}), "Hola, Ana", "variable")
igual(idiomas_t(i, "carrito.items", {"cuenta": 0}), "Carrito vacío", "plural cero")
igual(idiomas_t(i, "carrito.items", {"cuenta": 1}), "1 producto", "plural uno")
igual(idiomas_t(i, "carrito.items", {"cuenta": 7}), "7 productos", "plural otro")
igual(idiomas_t(i, "solo_en"), "only", "idioma de respaldo")
igual(idiomas_t(i, "no.existe"), "no.existe", "clave faltante")
igual(idiomas_t(i, "carrito"), "carrito", "no devuelve mapas")
igual([idiomas_existe(i, "saludo"), idiomas_existe(i, "zzz")], [verdadero, falso], "existe")
idiomas_cambiar(i, "en")
igual(idiomas_actual(i), "en", "actual")
igual(idiomas_t(i, "saludo", {"nombre": "Bo"}), "Hi, Bo", "con espacios")
igual(idiomas_t(i, "carrito.items", {"count": 2}), "2 items", "count")
igual(idiomas_t(i, "carrito.items", {"cuenta": 1}), "1 item", "cuenta en inglés")
igual(idiomas_numero(i, 1234567.456, 2), "1,234,567.46", "número en inglés")
idiomas_agregar(i, "pt", {"saludo": "Olá, {{nombre}}"})
idiomas_cambiar(i, "pt")
igual(idiomas_t(i, "saludo", {"nombre": "Rui"}), "Olá, Rui", "idioma agregado")
idiomas_agregar(i, "es", {"carrito": {"total": "Total"}})
idiomas_cambiar(i, "es")
igual(idiomas_t(i, "carrito.total") + "|" + idiomas_t(i, "carrito.items", {"cuenta": 3}), "Total|3 productos", "mezcla sin perder")
igual(idiomas_numero(i, 1234567.456, 2), "1.234.567,46", "número en español")
igual(idiomas_numero(i, -1000.05, 1), "-1.000,1", "negativo")
igual(idiomas_numero(i, 999), "999", "sin miles")
igual(idiomas_numero(i, 0.5, 2), "0,50", "ceros")
igual(idiomas_t(i, "saludo", {"nombre": "<b>"}), "Hola, <b>", "texto tal cual")
sea m = ""
intentar { idiomas_cambiar(i, "fr") } capturar (e) { m = e }
igual(m, "idiomas: no hay textos para fr", "idioma inexistente")
mostrar("[OK] idiomas")
