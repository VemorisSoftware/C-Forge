importar "sobre"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea a = sobre_claves()
sea b = sobre_claves()
afirmar(texto_empieza_con(a["publica"], "sobre1") y texto_empieza_con(a["secreta"], "SOBRE-SECRETA-"), "formato de claves")
igual(sobre_publica_de(a["secreta"]), a["publica"], "pública desde la secreta")
sea grande = texto_repetir("datos ", 30000) + bytes_de_hex("00ff")
sea s = sobre_cifrar(grande, [a["publica"], b["publica"]])
igual([sobre_descifrar(s, a["secreta"]) == grande, sobre_descifrar(s, b["secreta"]) == grande], [verdadero, verdadero], "dos destinatarios, varios bloques")
afirmar(sobre_cifrar("x", [a["publica"]]) != sobre_cifrar("x", [a["publica"]]), "no determinista")
igual(sobre_descifrar(sobre_cifrar("", [a["publica"]]), a["secreta"]), "", "vacío")
sea exacto = texto_repetir("z", 65536)
igual(sobre_descifrar(sobre_cifrar(exacto, [a["publica"]]), a["secreta"]) == exacto, verdadero, "exactamente un bloque")
sea c = sobre_cifrar_clave("hola mundo", "frase larga y secreta", 1000)
igual(sobre_descifrar_clave(c, "frase larga y secreta"), "hola mundo", "con contraseña")
igual(sobre_descifrar(sobre_desarmar(sobre_armar(s)), a["secreta"]) == grande, verdadero, "armado en texto")
// El último byte cambiado tiene que ser distinto del que había (1 en 256 era igual).
sea otro_final = "X"
si (subcadena(s, longitud(s) - 1, longitud(s)) == "X") { otro_final = "Y" }
para caso en [
    [funcion() { sobre_descifrar(s, sobre_claves()["secreta"]) }, "sobre: esta clave no es destinataria del sobre"],
    [funcion() { sobre_descifrar(subcadena(s, 0, longitud(s) - 70000), a["secreta"]) }, "sobre: datos alterados o clave incorrecta"],
    [funcion() { sobre_descifrar(subcadena(s, 0, longitud(s) - 1) + otro_final, a["secreta"]) }, "sobre: datos alterados o clave incorrecta"],
    [funcion() { sobre_descifrar(texto_reemplazar(s, "-> x25519 ", "-> x25519  "), a["secreta"]) }, "sobre: esta clave no es destinataria del sobre"],
    [funcion() { sobre_descifrar_clave(c, "otra frase mala") }, "sobre: contraseña incorrecta"],
    [funcion() { sobre_descifrar("hola", a["secreta"]) }, "sobre: no es un sobre cforge-sobre/1"],
    [funcion() { sobre_cifrar("x", []) }, "sobre: falta al menos un destinatario"],
    [funcion() { sobre_cifrar_clave("x", "corta") }, "sobre: la contraseña debe tener al menos 8 caracteres"],
    [funcion() { sobre_descifrar(s, "mala") }, "sobre: clave secreta inválida"]
] {
    sea m = ""
    intentar { caso[0]() } capturar (e) { m = e }
    igual(m, caso[1], caso[1])
}
// Cabecera alterada (se agrega un destinatario falso) → la MAC lo detecta.
sea partes = texto_dividir(s, "\n")
sea falso_ = partes[0] + "\n" + partes[1] + "\n-> x25519 AAAA BBBB\n" + subcadena(s, longitud(partes[0]) + longitud(partes[1]) + 2, longitud(s))
sea m = ""
intentar { sobre_descifrar(falso_, a["secreta"]) } capturar (e) { m = e }
igual(m, "sobre: cabecera alterada", "MAC de cabecera")
mostrar("[OK] sobre")
