importar "paquete_bin"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion hx(v) { retornar hex_de_bytes(paquete_codificar(v)) }
// Vectores de la especificación de MessagePack (y de msgpack-python).
igual(hx(0), "00", "fixint")
igual(hx(127), "7f", "fixint máximo")
igual(hx(128), "cc80", "uint8")
igual(hx(65535), "cdffff", "uint16")
igual(hx(65536), "ce00010000", "uint32")
igual(hx(4294967296), "cf0000000100000000", "uint64")
igual(hx(-1), "ff", "fixint negativo")
igual(hx(-33), "d0df", "int8")
igual(hx(-129), "d1ff7f", "int16")
igual(hx(-32769), "d2ffff7fff", "int32")
igual(hx(-2147483649), "d3ffffffff7fffffff", "int64")
igual(hx(1.5), "cb3ff8000000000000", "float64")
igual(hx(0.1), "cb3fb999999999999a", "0.1")
igual(hx(-0.1), "cbbfb999999999999a", "-0.1")
igual(hx(1e300), "cb7e37e43c8800759c", "1e300")
igual(hx(5e-324), "cb0000000000000001", "subnormal")
igual(hx(nulo) + hx(falso) + hx(verdadero), "c0c2c3", "nulo y booleanos")
igual(hx("hola"), "a4686f6c61", "fixstr")
igual(hx("ñ"), "a2c3b1", "UTF-8")
igual(subcadena(hx(texto_repetir("x", 40)), 0, 4), "d928", "str8")
igual(subcadena(hx(texto_repetir("x", 300)), 0, 6), "da012c", "str16")
igual(hx([1, [2, "a"]]), "92019202a161", "listas")
igual(hx({"a": 1}), "81a16101", "mapa")
// Ida y vuelta
sea datos = {"id": 7, "precio": 9.5, "tags": ["a", "b"], "nada": nulo, "si": verdadero, "neg": -40000, "grande": 9007199254740991, "pi": 3.141592653589793, "lista": texto_dividir(texto_repetir("x,", 20), ",")}
igual(paquete_decodificar(paquete_codificar(datos)), datos, "ida y vuelta")
igual(hx(paquete_decodificar(bytes_de_hex("cb400921fb54442d18"))), "cb400921fb54442d18", "float exacto")
igual(paquete_decodificar(bytes_de_hex("ca3fc00000")), 1.5, "float32")
igual(paquete_decodificar(bytes_de_hex("c403616263")), "abc", "bin8")
// Mensajes hostiles
para c en [["dd7fffffff", "paquete_bin: datos truncados (posición 5)"], ["c1", "paquete_bin: tipo no soportado 0xc1 (posición 0)"], ["0102", "paquete_bin: sobran 1 bytes"], ["db00000010616263", "paquete_bin: datos truncados (posición 5)"], ["df7fffffff", "paquete_bin: datos truncados (posición 5)"]] {
    sea m = ""
    intentar { paquete_decodificar(bytes_de_hex(c[0])) } capturar (e) { m = e }
    igual(m, c[1], c[0])
}
sea hondo = bytes_de_hex(texto_repetir("91", 200) + "00")
sea m = ""
intentar { paquete_decodificar(hondo) } capturar (e) { m = e }
igual(m, "paquete_bin: anidamiento excesivo", "pila")
mostrar("[OK] paquete_bin")
