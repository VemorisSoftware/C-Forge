importar "codigo_qr"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion filas(q) {
    sea l = []
    para fila en q["m"] {
        sea s = ""
        para c en fila { si (c) { s = s + "1" } sino { s = s + "0" } }
        l.agregar(s)
    }
    retornar l
}
// Matriz idéntica a la de python-qrcode con la misma versión y máscara.
sea q = qr_crear("HOLA MUNDO", {"nivel": "M", "mascara": 6, "subir_nivel": falso})
igual([q["version"], q["nivel"], q["modo"], q["n"]], [1, "M", "alfanumerico", 21], "versión 1 alfanumérica")
igual(filas(q)[0], "111111101011001111111", "fila 0")
igual(filas(q)[8], "100111111011010010111", "fila 8 (formato)")
igual(filas(q)[20], "111111101000110100010", "fila 20")
sea n = qr_crear("01234567890123", {"nivel": "H", "mascara": 1, "subir_nivel": falso})
igual([n["version"], n["modo"], filas(n)[10]], [1, "numerico", "110010110001011110100"], "numérico")
sea u = qr_crear("https://c-forge.org/ñandú", {"nivel": "L", "subir_nivel": falso})
igual([u["version"], u["modo"]], [2, "bytes"], "UTF-8 en bytes")
igual(qr_crear("https://c-forge.org/ñandú")["nivel"], "Q", "sube el nivel si cabe")
sea g = ""
sea i = 0
mientras (i < 85) { g = g + "Lorem ipsum " + i + ". "  i = i + 1 }
sea grande = qr_crear(g, {"nivel": "Q", "subir_nivel": falso})
igual([grande["version"], grande["n"]], [36, 161], "versión grande con info de versión")
sea svg = qr_svg(qr_crear("hola"), {"modulo": 8})
afirmar(texto_empieza_con(svg, "<svg") y texto_indice(svg, "viewBox=\"0 0 29 29\"") >= 0, "SVG con zona tranquila")
igual(longitud(texto_dividir(qr_texto(qr_crear("hola")), "\n")), 13, "texto en medios bloques")
sea bs = caracter(92)
igual(qr_wifi("Casa;1", "cla:ve"), "WIFI:T:WPA;S:Casa" + bs + ";1;P:cla" + bs + ":ve;;", "QR de WiFi escapado")
igual(barras_ean13("780123456789")["texto"], "7801234567894", "EAN-13 con dígito verificador")
igual(longitud(barras_ean13("7801234567894")["barras"]), 95, "EAN-13 mide 95 módulos")
igual(barras_upca("03600029145")["texto"], "036000291452", "UPC-A")
igual(barras_code128("ABC-1234567890")["valores"], [104, 33, 34, 35, 13, 99, 12, 34, 56, 78, 90, 24], "Code 128 cambia a C para dígitos")
afirmar(texto_indice(barras_svg(barras_code128("C-Forge")), "<rect") >= 0, "barras en SVG")
sea m = ""
intentar { barras_ean13("7801234567890") } capturar (e) { m = e }
igual(m, "codigo_qr: dígito verificador incorrecto (debería ser 4)", "verificador incorrecto")
intentar { qr_crear("x", {"nivel": "Z"}) } capturar (e) { m = e }
igual(m, "codigo_qr: nivel desconocido Z (usa L, M, Q o H)", "nivel inválido")
mostrar("[OK] codigo_qr")
