importar "panal"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea c = panal_celda(-33.4489, -70.6693, 8)
igual(c, "8:-6319:-4395", "celda de Santiago")
sea ce = panal_centro(c)
afirmar(absoluto(ce[0] + 33.4489) < 0.01 y absoluto(ce[1] + 70.6693) < 0.01, "el centro está cerca")
igual(panal_celda(ce[0], ce[1], 8), c, "el centro cae en su celda")
igual(redondear(panal_area_km2(8), 4), 0.7372, "área a resolución 8")
afirmar(absoluto(panal_area_km2(0) - 4250000) / 4250000 < 0.02, "área a resolución 0")
igual(longitud(panal_borde(c)), 7, "borde cerrado")
igual(longitud(panal_disco(c, 2)), 19, "disco de radio 2")
igual(longitud(panal_anillo(c, 3)), 18, "anillo de radio 3")
para v en panal_vecinos(c) { igual(panal_distancia(c, v), 1, "vecina a distancia 1") }
igual(panal_distancia(c, panal_anillo(c, 4)[7]), 4, "distancia en el anillo")
igual(panal_padre(c), "7:-2388:-1661", "padre")
igual(longitud(panal_hijos(c)), 7, "7 hijas")
// El antimeridiano no es una costura.
sea a = panal_celda(10, 179.99, 3)
sea b = panal_celda(10, -179.99, 3)
igual(a, b, "misma celda a ambos lados de 180°")
sea e = panal_celda(10, 178.5, 3)
sea w = panal_celda(10, -178.5, 3)
afirmar(panal_distancia(e, w) <= 2, "distancia rodeando el planeta")
sea r = panal_cubrir([[-33.40, -70.70], [-33.40, -70.60], [-33.50, -70.60], [-33.50, -70.70]], 8)
afirmar(longitud(r) > 120 y longitud(r) < 160, "cubrir un polígono")
igual(panal_agrupar([[0, 0], [0.0001, 0.0001], [10, 10]], 5), {"5:0:0": 2, "5:28:75": 1}, "agrupar puntos")
afirmar(texto_indice(panal_geojson([c], {c: 3}), "\"Polygon\"") >= 0, "GeoJSON")
igual(panal_plano_camino([0, 0], [3, 0], {"1,0": verdadero, "1,-1": verdadero}), [[0, 0], [0, 1], [1, 1], [2, 1], [3, 0]], "camino plano esquivando")
igual(panal_plano_linea([0, 0], [3, -3]), [[0, 0], [1, -1], [2, -2], [3, -3]], "línea plana")
igual(panal_plano_de_pixel(panal_plano_a_pixel([2, -1], 10)[0], panal_plano_a_pixel([2, -1], 10)[1], 10), [2, -1], "pixel ida y vuelta")
sea m = ""
intentar { panal_celda(0, 0, 16) } capturar (x) { m = x }
igual(m, "panal: la resolución va de 0 a 15", "resolución inválida")
mostrar("[OK] panal")
