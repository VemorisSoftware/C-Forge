// Written in English.
import "schema"
import "ratelimit"
import "helmet"
import "i18n"
import "faker"
import "xml"
import "cron"
import "rich"
function same(a, b, what) { assert(("" + a) == ("" + b), what + ": [" + a + "] != [" + b + "]") }
let user = schema_object({"name": schema_min(schema_string(), 2), "age": schema_optional(schema_int())})
let r = schema_validate(user, {"name": "A", "age": 2.5})
same(r["ok"], false, "schema_validate")
same(r["errors"][0]["path"] + ": " + r["errors"][0]["message"], "age: must be an integer", "english message")
same(r["errors"][1]["message"], "must have at least 2 characters", "english limit")
same(schema_parse(user, {"name": "Bo"})["name"], "Bo", "schema_parse")
let clock = [0]
let lim = ratelimit_with_clock(ratelimit_new(1, 1), function() { return clock[0] })
same([ratelimit_allow(lim, "k"), ratelimit_allow(lim, "k"), ratelimit_wait_ms(lim, "k")], [true, false, 1001], "ratelimit")
same(helmet_headers({"frames": "DENY", "referrer": "same-origin"})["X-Frame-Options"], "DENY", "helmet frames")
same(helmet_headers({"referrer": "same-origin"})["Referrer-Policy"], "same-origin", "helmet referrer")
let t = i18n_new({"en": {"cart_one": "1 item", "cart_other": "{{count}} items"}}, "en")
same(i18n_t(t, "cart", {"count": 4}), "4 items", "i18n_t")
same(i18n_number(t, 1234.5, 1), "1,234.5", "i18n_number")
let fk = faker_new(9, "en")
assert(texto_indice(faker_email(fk), "@example.") >= 0, "faker_email")
same(faker_rut_check_digit(12345678), "5", "faker_rut_check_digit")
same(xml_text(xml_child(xml_parse("<a><b>hi</b></a>"), "b")), "hi", "xml")
let c = cron_parse("@daily")
same(cron_format(c, cron_next(c, 1763683200000)), "2025-11-22 00:00", "cron_next")
same(rich_table(["k"], [[1]], {"border": "square", "title": null}), "┌───┐\n│ k │\n├───┤\n│ 1 │\n└───┘", "rich_table")
same(rich_tree({"name": "root", "children": ["leaf"]}), "root\n└── leaf", "rich_tree")
print("[OK] lote 3 in English")
