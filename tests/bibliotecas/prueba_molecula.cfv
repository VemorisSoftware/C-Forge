// Pruebas de molecula. datos/molecula-esperado.json sale de RDKit 2026.09:
// descriptores de 65 moléculas, conteos de subestructuras y SMILES
// aleatorios de la misma molécula (para el SMILES canónico).
importar "molecula"
importar "json"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

sea d = json_parsear(leer_archivo("tests/bibliotecas/datos/molecula-esperado.json"))
para e en d["moleculas"] {
    sea x = molecula_descriptores(molecula_leer(e["smiles"]))
    eq([x["formula"], redondear(x["peso"] * 1000) / 1000, redondear(x["masa_exacta"] * 10000) / 10000, x["atomos_pesados"], x["hidrogenos"], x["anillos"],
        x["anillos_aromaticos"], x["aceptores"], x["donadores"], x["rotables"], x["tpsa"], x["carga"]],
        [e["formula"], e["mw"], e["exacta"], e["pesados"], e["hs"], e["anillos"], e["aromaticos"], e["nho"], e["nhoh"], e["rotables"], e["tpsa"], e["carga"]], e["smiles"])
}
para s en d["subestructuras"] { eq(longitud(molecula_buscar(molecula_leer(s[1]), s[0])), s[2], s[0] + " en " + s[1]) }
para vs en d["variantes"] {
    sea c = molecula_smiles(molecula_leer(vs[0]))
    para s en vs { eq(molecula_smiles(molecula_leer(s)), c, "canónico de " + s) }
    eq(molecula_smiles(molecula_leer(c)), c, "canónico estable " + c)
}

// Kekulé y aromático dan lo mismo.
eq(molecula_smiles(molecula_leer("C1=CC2=CC=CC=C2N1")), molecula_smiles(molecula_leer("c1ccc2[nH]ccc2c1")), "indol")
eq(molecula_smiles(molecula_leer("OCC")), "CCO", "etanol")
eq(molecula_buscar(molecula_leer("CCO"), "CO"), [[1, 2]], "índices")
afirmar(molecula_contiene(molecula_leer("CC(=O)Oc1ccccc1C(=O)O"), "c1ccccc1"), "contiene benceno")
afirmar(molecula_contiene(molecula_leer("CCCC"), "c") == falso, "sin aromáticos")
eq(molecula_lipinski(molecula_leer("CC(=O)Oc1ccccc1C(=O)O")), {"cumple": verdadero, "violaciones": []}, "lipinski")
para malo en ["C1CC", "C(C", "CC)", "Xx", "[Qq]"] {
    sea error = ""
    intentar { molecula_leer(malo) } capturar (e) { error = e }
    afirmar(texto_empieza_con(error, "molecula:"), "error para " + malo)
}
mostrar("[OK] molecula")
