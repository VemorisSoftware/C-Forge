importar "consulta_archivos"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea c = consulta_nueva()
consulta_registrar_csv(c, "ventas", "region,producto,monto,fecha\nNorte,café,1200,2026-01-03\nSur,té,800,2026-01-04\nNorte,té,500,2026-02-01\nSur,café,,2026-02-02\nCentro,café,2000,2026-02-10\n")
consulta_registrar_json(c, "jefes", "{\"region\": \"Norte\", \"jefe\": \"Ana\"}\n{\"region\": \"Sur\", \"jefe\": \"Luis\"}\n")
sea r = consulta_sql(c, "SELECT region, SUM(monto) AS total, COUNT(*) n, COUNT(monto) AS con_monto FROM ventas GROUP BY region ORDER BY total DESC")
igual(r["columnas"], ["region", "total", "n", "con_monto"], "columnas")
igual(r["filas"], [{"con_monto": 1, "n": 1, "region": "Centro", "total": 2000}, {"con_monto": 2, "n": 2, "region": "Norte", "total": 1700}, {"con_monto": 1, "n": 2, "region": "Sur", "total": 800}], "GROUP BY y ORDER BY")
igual(consulta_sql(c, "SELECT v.producto, j.jefe FROM ventas v LEFT JOIN jefes j ON v.region = j.region WHERE v.monto > ? OR v.monto IS NULL ORDER BY 1, jefe", [600])["filas"], [{"jefe": "Ana", "producto": "café"}, {"jefe": "Luis", "producto": "café"}, {"jefe": nulo, "producto": "café"}, {"jefe": "Luis", "producto": "té"}], "LEFT JOIN con parámetro")
igual(consulta_sql(c, "SELECT DISTINCT producto FROM ventas WHERE producto LIKE 'c%' OR region IN ('Sur')")["filas"], [{"producto": "café"}, {"producto": "té"}], "DISTINCT, LIKE e IN")
igual(consulta_sql(c, "SELECT region, AVG(monto) prom FROM ventas GROUP BY region HAVING COUNT(*) > 1 ORDER BY region")["filas"], [{"prom": 850, "region": "Norte"}, {"prom": 800, "region": "Sur"}], "HAVING")
igual(consulta_sql(c, "SELECT UPPER(region) || '-' || producto AS clave, CASE WHEN monto >= 1000 THEN 'alto' ELSE 'bajo' END nivel FROM ventas WHERE fecha BETWEEN '2026-01-01' AND '2026-01-31'")["filas"], [{"clave": "NORTE-café", "nivel": "alto"}, {"clave": "SUR-té", "nivel": "bajo"}], "CASE, || y BETWEEN")
igual(consulta_sql(c, "SELECT * FROM ventas ORDER BY monto LIMIT 2 OFFSET 1")["filas"], [{"fecha": "2026-01-04", "monto": 800, "producto": "té", "region": "Sur"}, {"fecha": "2026-01-03", "monto": 1200, "producto": "café", "region": "Norte"}], "SELECT *, LIMIT y OFFSET")
igual(consulta_valor(c, "SELECT COUNT(DISTINCT region) FROM ventas"), 3, "COUNT DISTINCT")
igual(consulta_valor(c, "SELECT MAX(monto) - MIN(monto) FROM ventas WHERE region <> 'Centro'"), 700, "expresión con agregados")
igual(consulta_sql(c, "SELECT 1 + 2 * 3 AS x, ROUND(10 / 3, 2) AS y, COALESCE(NULL, 'z') z")["filas"], [{"x": 7, "y": 3.33, "z": "z"}], "sin FROM")
igual(consulta_sql(c, "SELECT region FROM ventas WHERE producto = ?", ["té' OR '1'='1"])["filas"], [], "los parámetros no se inyectan")
igual(consulta_valor(c, "select count(*) from VENTAS where not (monto < 1000) -- comentario"), 2, "minúsculas, NOT y comentarios")
sea m = ""
para caso en [["SELECT FROM ventas", "consulta: no esperaba 'from'"], ["SELECT x FROM nada", "consulta: no existe la tabla nada"], ["SELECT region FROM ventas WHERE SUM(monto) > 1", "consulta: no se puede usar un agregado en WHERE (usa HAVING)"], ["SELECT nope FROM ventas", "consulta: no existe la columna nope"], ["SELECT a FROM ventas; DROP TABLE x", "consulta: carácter inesperado ';'"]] {
    m = ""
    intentar { consulta_sql(c, caso[0]) } capturar (e) { m = e }
    igual(m, caso[1], caso[0])
}
afirmar(texto_indice(consulta_texto(r), "Centro") >= 0, "texto")
mostrar("[OK] consulta_archivos")
