importar "ligero"
importar "sqlite"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea db = db_abrir(":memory:")
db_ejecutar(db, "CREATE TABLE clientes (id INTEGER PRIMARY KEY, nombre_completo TEXT, activo INTEGER, extra TEXT)")
db_ejecutar(db, "CREATE TABLE pedidos (id INTEGER PRIMARY KEY, cliente_id INTEGER, total REAL)")
igual(ligero_preparar("SELECT * FROM t WHERE a = @a AND b IN @bs AND c = ':no' AND d::text = :d -- @comentario", {"a": 1, "bs": [2, 3], "d": verdadero}), {"params": [1, 2, 3, 1], "sql": "SELECT * FROM t WHERE a = ? AND b IN (?, ?) AND c = ':no' AND d::text = ? -- @comentario"}, "preparar")
sea id1 = ligero_insertar(db, "clientes", {"nombre_completo": "Ana Pérez", "activo": verdadero, "extra": {"vip": verdadero}})
sea id2 = ligero_insertar(db, "clientes", {"nombre_completo": "Leo Díaz", "activo": falso, "extra": nulo})
igual([id1, id2], [1, 2], "insertar")
igual(ligero_ejecutar_lote(db, "INSERT INTO pedidos (cliente_id, total) VALUES (@c, @t)", [{"c": 1, "t": 10.5}, {"c": 1, "t": 20}, {"c": 2, "t": 5}]), 3, "lote")
sea r = ligero_consultar(db, "SELECT * FROM clientes WHERE id IN @ids ORDER BY id", {"ids": [1, 2]}, {"nombres": "camel", "tipos": {"activo": "booleano", "extra": "json"}})
igual([r[0]["nombreCompleto"], r[0]["activo"], r[0]["extra"]["vip"], r[1]["activo"]], ["Ana Pérez", verdadero, verdadero, falso], "consultar con mapeo")
igual(ligero_escalar(db, "SELECT sum(total) FROM pedidos WHERE cliente_id = @c", {"c": 1}), 30.5, "escalar")
igual(ligero_consultar(db, "SELECT * FROM clientes WHERE id IN @ids", {"ids": []}), [], "lista vacía")
igual(ligero_unico(db, "SELECT nombre_completo FROM clientes WHERE id = :id", {"id": 2})["nombre_completo"], "Leo Díaz", "único")
sea fallo = falso
intentar { ligero_unico(db, "SELECT * FROM clientes", {}) } capturar (e) { fallo = verdadero }
igual(fallo, verdadero, "único con varias filas")
// Mapeo múltiple: pedido + cliente, partiendo en la segunda columna "id".
sea pc = ligero_multi(db, "SELECT p.*, c.id, c.nombre_completo FROM pedidos p JOIN clientes c ON c.id = p.cliente_id ORDER BY p.id", {}, "id", funcion(o) {
    sea p = o[0]
    p["cliente"] = o[1]
    retornar p
})
igual([longitud(pc), pc[0]["cliente"]["nombre_completo"], pc[2]["cliente"]["id"]], [3, "Ana Pérez", 2], "multi")
// 1-a-N: clientes con sus pedidos.
sea cs = ligero_multi(db, "SELECT c.id, c.nombre_completo, p.id, p.total FROM clientes c LEFT JOIN pedidos p ON p.cliente_id = c.id ORDER BY c.id, p.id", {}, "id", funcion(o) {
    si (tiene_clave(o[0], "pedidos") == falso) { o[0]["pedidos"] = [] }
    si (o[1] != nulo) { o[0]["pedidos"].agregar(o[1]) }
    retornar o[0]
}, {"agrupar": verdadero})
igual([longitud(cs), longitud(cs[0]["pedidos"]), longitud(cs[1]["pedidos"])], [2, 2, 1], "uno a muchos")
sea vs = ligero_varias(db, "SELECT count(*) AS n FROM clientes; SELECT count(*) AS n FROM pedidos WHERE total > @min", {"min": 6})
igual([vs[0][0]["n"], vs[1][0]["n"]], [2, 2], "varias consultas")
igual(ligero_actualizar(db, "clientes", {"id": 2, "nombre_completo": "Leo D.", "activo": verdadero}), verdadero, "actualizar")
igual(ligero_obtener(db, "clientes", 2)["nombre_completo"], "Leo D.", "obtener")
igual([ligero_borrar(db, "clientes", 2), longitud(ligero_todos(db, "clientes"))], [verdadero, 1], "borrar")
sea malo = falso
intentar { ligero_insertar(db, "clientes; DROP TABLE x", {"a": 1}) } capturar (e) { malo = verdadero }
igual(malo, verdadero, "nombre hostil")
sea falta = falso
intentar { ligero_consultar(db, "SELECT @x", {}) } capturar (e) { falta = verdadero }
igual(falta, verdadero, "parámetro faltante")
mostrar("[OK] ligero")
