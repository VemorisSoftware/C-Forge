// Pruebas de blas. Referencias de NumPy 2 (LAPACK).
importar "blas"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion cerca_v(a, b, tol, q) {
    afirmar(longitud(a) == longitud(b), q + ": largos distintos")
    sea i = 0
    mientras (i < longitud(a)) {
        afirmar(absoluto(a[i] - b[i]) <= tol * maximo(1, absoluto(b[i])), q + ": " + a + " vs " + b)
        i = i + 1
    }
}
funcion cerca_m(A, B, tol, q) {
    sea i = 0
    mientras (i < longitud(A)) {
        cerca_v(A[i], B[i], tol, q + " fila " + i)
        i = i + 1
    }
}

// Nivel 1.
eq(blas_punto([1, 2, 3], [4, 5, 6]), 32, "punto")
eq(blas_axpy(2, [1, 2], [10, 20]), [12, 24], "axpy")
eq(blas_escalar(3, [1, -2]), [3, -6], "escalar")
eq(blas_norma2([3, 4]), 5, "norma2")
afirmar(blas_norma2([1e200, 1e200]) > 1.4e200, "norma2 sin desborde")
eq([blas_asum([1, -2, 3]), blas_iamax([1, -7, 3])], [6, 1], "asum e iamax")
// Niveles 2 y 3.
sea A2 = [[1, 2], [3, 4]]
eq(blas_gemv(1, A2, [1, 1], 0, nulo, falso), [3, 7], "gemv")
eq(blas_gemv(2, A2, [1, 1], 1, [1, 1], verdadero), [9, 13], "gemv traspuesta con beta")
eq(blas_gemm(1, A2, [[5, 6], [7, 8]], 0, nulo, falso, falso), [[19, 22], [43, 50]], "gemm")
eq(blas_gemm(1, A2, A2, 1, blas_identidad(2), verdadero, falso), [[11, 14], [14, 21]], "gemm Aᵀ·A + I")
eq(blas_mul([[1, 2, 3]], [[1], [2], [3]]), [[14]], "producto 1×3 · 3×1")
sea error = ""
intentar { blas_mul([[1, 2]], [[1, 2]]) } capturar (e) { error = "" + e }
afirmar(texto_contiene(error, "dimensiones incompatibles"), "dimensiones")
eq(blas_traspuesta([[1, 2, 3]]), [[1], [2], [3]], "traspuesta")

// LU, solución, determinante e inversa.
sea A = [[4, -2, 1, 3], [3, 6, -4, 2], [2, 1, 8, -5], [1, -3, 2, 7]]
sea b = [1, 2, 3, 4]
cerca_v(blas_resolver(A, b), [-0.0991535671100362, 0.6499395405078598, 0.7285368802902056, 0.6559854897218863], 1e-13, "resolver")
afirmar(absoluto(blas_det(A) - 1654) < 1e-9, "det")
cerca_m(blas_mul(A, blas_inversa(A)), blas_identidad(4), 1e-13, "A·A⁻¹ = I")
cerca_m(blas_resolver(A, [[1, 0], [0, 1], [0, 0], [0, 0]]), [[blas_inversa(A)[0][0], blas_inversa(A)[0][1]], [blas_inversa(A)[1][0], blas_inversa(A)[1][1]],
    [blas_inversa(A)[2][0], blas_inversa(A)[2][1]], [blas_inversa(A)[3][0], blas_inversa(A)[3][1]]], 1e-13, "varios lados derechos")
eq(blas_det([[1, 2], [2, 4]]), 0, "singular")
error = ""
intentar { blas_resolver([[1, 2], [2, 4]], [1, 1]) } capturar (e) { error = "" + e }
afirmar(texto_contiene(error, "singular"), "error de singular")
eq(blas_det([[0, 1], [1, 0]]), -1, "signo del pivoteo")

// Cholesky.
sea S = [[4, 1, 2], [1, 5, 3], [2, 3, 6]]
cerca_m(blas_cholesky(S), [[2, 0, 0], [0.5, 2.179449471770337, 0], [1, 1.1470786693528088, 1.9194297398747862]], 1e-14, "Cholesky")
error = ""
intentar { blas_cholesky([[1, 2], [2, 1]]) } capturar (e) { error = "" + e }
afirmar(texto_contiene(error, "definida positiva"), "no definida positiva")

// QR y mínimos cuadrados.
sea M = [[1, 2], [3, 4], [5, 6], [7, 8.5]]
sea qr = blas_qr(M)
cerca_m(blas_mul(qr["q"], qr["r"]), M, 1e-13, "Q·R = A")
cerca_m(blas_gemm(1, qr["q"], qr["q"], 0, nulo, verdadero, falso), blas_identidad(2), 1e-14, "QᵀQ = I")
eq(qr["r"][1][0], 0, "R triangular")
cerca_v(blas_minimos_cuadrados(M, [1, 2.1, 2.9, 4.2]), [-0.09629629629629466, 0.5728395061728382], 1e-12, "mínimos cuadrados")

// Propios, SVD, rango, condición y pseudoinversa.
sea p = blas_propios_simetrica(S)
cerca_v(p["valores"], [2.1943971674224088, 3.3867701566075477, 9.418832675970037], 1e-13, "valores propios")
sea k = 0
mientras (k < 3) {
    sea v = [p["vectores"][0][k], p["vectores"][1][k], p["vectores"][2][k]]
    cerca_v(blas_gemv(1, S, v, 0, nulo, falso), blas_escalar(p["valores"][k], v), 1e-12, "S·v = λ·v")
    k = k + 1
}
sea sv = blas_svd(M)
cerca_v(sv["s"], [14.55896266592789, 0.535356042384853], 1e-13, "valores singulares")
sea US = [[sv["u"][0][0] * sv["s"][0], sv["u"][0][1] * sv["s"][1]], [sv["u"][1][0] * sv["s"][0], sv["u"][1][1] * sv["s"][1]],
    [sv["u"][2][0] * sv["s"][0], sv["u"][2][1] * sv["s"][1]], [sv["u"][3][0] * sv["s"][0], sv["u"][3][1] * sv["s"][1]]]
cerca_m(blas_gemm(1, US, sv["v"], 0, nulo, falso, verdadero), M, 1e-13, "U·S·Vᵀ = A")
cerca_v(blas_svd(blas_traspuesta(M))["s"], [14.55896266592789, 0.535356042384853], 1e-13, "SVD de una matriz ancha")
eq([blas_rango(M, nulo), blas_rango([[1, 2], [2, 4], [3, 6]], nulo)], [2, 1], "rango")
afirmar(absoluto(blas_condicion(A) - 4.315532054551433) < 1e-12, "condición")
cerca_m(blas_pseudoinversa(M), [[-1.2962962962962918, -0.4814814814814772, 0.333333333333332, 0.2962962962962944],
    [1.0617283950617245, 0.41975308641974945, -0.22222222222222104, -0.1728395061728379]], 1e-12, "pseudoinversa")
mostrar("[OK] blas")
