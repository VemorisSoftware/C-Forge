importar "unicode"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
igual(unicode_mayusculas("ñandú straße ǆ"), "ÑANDÚ STRASSE Ǆ", "mayúsculas completas")
igual(unicode_minusculas("ÑANDÚ ЁЖИК"), "ñandú ёжик", "minúsculas")
igual(unicode_puntos(unicode_minusculas("ΟΔΟΣ")), [959, 948, 959, 962], "sigma final")
igual(unicode_titulo("hola señor ñandú"), "Hola Señor Ñandú", "título")
sea comb = unicode_texto([99, 97, 102, 101, 769])
igual([unicode_nfc(comb) == "café", unicode_largo(unicode_nfd("café")), unicode_es_nfc("café"), unicode_es_nfc(comb)], [verdadero, 5, verdadero, falso], "NFC y NFD")
igual(unicode_nfc(unicode_nfd("Ệ ǖ ḱ 한국어 ᾤ")), "Ệ ǖ ḱ 한국어 ᾤ", "ida y vuelta")
igual(unicode_puntos(unicode_nfd("ǖ")), [117, 776, 772], "descomposición completa")
igual(unicode_puntos(unicode_nfc(unicode_texto([97, 803, 770]))), [7853], "orden canónico de marcas")
igual(unicode_sin_acentos("Ñuñoa, São Paulo, Łódź, Ærø"), "Nunoa, Sao Paulo, Lodz, AEro", "sin acentos")
igual(unicode_slug("¡Año Nuevo en Ñuñoa! (2026)"), "ano-nuevo-en-nunoa-2026", "slug")
igual(unicode_slug("Hola Mundo", "_"), "hola_mundo", "slug con separador")
igual(unicode_grafemas(comb + "👍🏽🇨🇱🇦🇷👨‍👩‍👧x"), ["c", "a", "f", unicode_texto([101, 769]), "👍🏽", "🇨🇱", "🇦🇷", "👨‍👩‍👧", "x"], "grafemas")
igual([unicode_ancho("日本語abc"), unicode_ancho("👍🏽x"), unicode_ancho(comb)], [9, 3, 4], "ancho en terminal")
igual(unicode_cortar("日本語のテキスト", 7), "日本語…", "cortar por ancho")
igual(unicode_invertir("añ👍🏽o"), "o👍🏽ña", "invertir por grafemas")
igual(unicode_rellenar("日本", 6, "centro") + "|", " 日本 |", "rellenar por ancho")
igual(unicode_ordenar(["oso", "ñu", "nube", "Ñandú", "archivo 10", "archivo 2", "Árbol", "arbol", "zeta", "éxito", "exito"], {"idioma": "es"}), ["arbol", "Árbol", "archivo 2", "archivo 10", "exito", "éxito", "nube", "Ñandú", "ñu", "oso", "zeta"], "orden en español")
igual(unicode_ordenar(["b", "A", "a", "B"]), ["a", "A", "b", "B"], "minúscula antes que mayúscula")
igual([unicode_comparar("ñ", "o", {"idioma": "es"}), unicode_comparar("niño", "nino"), unicode_comparar("a", "a")], [-1, 1, 0], "comparar")
igual([unicode_iguales_sin_caso("Straße", "STRASSE"), unicode_plegar("ÀB")], [verdadero, "àb"], "plegado de caso")
igual(unicode_puntos("ñ€" + bytes_de_hex("ff")), [241, 8364, 65533], "UTF-8 inválido → U+FFFD")
mostrar("[OK] unicode")
