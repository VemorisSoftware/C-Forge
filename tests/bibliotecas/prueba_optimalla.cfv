importar "optimalla"
importar "modelo"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Contra meshoptimizer (Python), con una icoesfera de 5120 triángulos: el
// remapeo y el orden de fetch salen idénticos; el ACMR queda en 0,708
// contra 0,694; y al simplificar al 25 % el error máximo es 0,0104 contra
// 0,011, cerrada (sin agujeros) igual que meshoptimizer.
sea e = malla_esfera(1, 24, 16)
// Desindexa: cada triángulo con sus propios vértices.
sea plana = malla_nueva()
para i en e["indices"] {
    plana["posiciones"].agregar(e["posiciones"][i * 3])
    plana["posiciones"].agregar(e["posiciones"][i * 3 + 1])
    plana["posiciones"].agregar(e["posiciones"][i * 3 + 2])
}
sea k = 0
mientras (k < longitud(e["indices"])) {
    plana["indices"].agregar(k)
    k = k + 1
}
sea r = optimalla_remapeo(plana)
sea n_pos = {}
k = 0
mientras (k < longitud(e["posiciones"])) {
    n_pos["" + e["posiciones"][k] + "," + e["posiciones"][k + 1] + "," + e["posiciones"][k + 2]] = verdadero
    k = k + 3
}
igual(r["vertices"], longitud(claves(n_pos)), "vértices únicos")
sea m = optimalla_remapear(plana, r)
igual([longitud(m["indices"]), longitud(m["posiciones"]) / 3], [longitud(e["indices"]), r["vertices"]], "remapear")
// Caché.
sea antes = optimalla_cache_analizar(m["indices"], r["vertices"], 16)
sea revuelta = []
// Orden malo a propósito: triángulos intercalados de lejos.
sea nt = longitud(m["indices"]) / 3
sea t = 0
mientras (t < nt) {
    sea u = (t * 97) % nt
    revuelta.agregar(m["indices"][u * 3])
    revuelta.agregar(m["indices"][u * 3 + 1])
    revuelta.agregar(m["indices"][u * 3 + 2])
    t = t + 1
}
sea mala = optimalla_cache_analizar(revuelta, r["vertices"], 16)
sea buena = optimalla_cache_analizar(optimalla_cache(revuelta, r["vertices"]), r["vertices"], 16)
igual([mala["acmr"] > 2, buena["acmr"] < 0.8], [verdadero, verdadero], "acmr")
igual(longitud(optimalla_cache(revuelta, r["vertices"])), longitud(revuelta), "conserva triángulos")
// Fetch: los vértices quedan en orden de primer uso.
sea f = optimalla_fetch({"posiciones": m["posiciones"], "normales": [], "uvs": [], "indices": revuelta})
igual([f["indices"][0], f["indices"][1], f["indices"][2]], [0, 1, 2], "fetch")
sea o = optimalla_optimizar(plana)
igual([longitud(o["posiciones"]) / 3, optimalla_cache_analizar(o["indices"], longitud(o["posiciones"]) / 3, 16)["acmr"] < 0.8], [r["vertices"], verdadero], "optimizar")
// Simplificar y comprobar que queda cerrada (cada arista en dos triángulos).
funcion cerrada(mm) {
    sea c = {}
    sea i = 0
    mientras (i < longitud(mm["indices"])) {
        sea tri = [mm["indices"][i], mm["indices"][i + 1], mm["indices"][i + 2]]
        para par en [[tri[0], tri[1]], [tri[1], tri[2]], [tri[2], tri[0]]] {
            sea kk = "" + minimo(par[0], par[1]) + "_" + maximo(par[0], par[1])
            c[kk] = (c[kk] ?? 0) + 1
        }
        i = i + 3
    }
    para kk en claves(c) { si (c[kk] != 2) { retornar falso } }
    retornar verdadero
}
igual(cerrada(o), verdadero, "esfera cerrada")
sea s = optimalla_simplificar(o, 0.25, 0.05, nulo)
igual([longitud(s["indices"]) <= longitud(o["indices"]) / 4, longitud(s["indices"]) > longitud(o["indices"]) / 5, cerrada(s), s["error"] < 0.05], [verdadero, verdadero, verdadero, verdadero], "simplificar")
igual(optimalla_triangulos(optimalla_simplificar(o, 0.25, 0.000001, nulo)), optimalla_triangulos(o), "error máximo frena")
sea cadena = optimalla_lod(o, [1, 0.5, 0.1], 0.2)
igual([optimalla_triangulos(cadena[0]) > optimalla_triangulos(cadena[1]), optimalla_triangulos(cadena[1]) > optimalla_triangulos(cadena[2])], [verdadero, verdadero], "lod")
// Plano con borde: el borde se conserva.
sea pl = malla_plano(2, 2, 8)
sea sp = optimalla_simplificar(pl, 0.1, 0.01, {"bloquear_bordes": verdadero})
sea caja = optimalla_caja(sp)
igual([caja["min"][0], caja["max"][0], caja["min"][2], caja["max"][2]], [-1, 1, -1, 1], "borde")
// Utilidades.
igual([optimalla_media(1), optimalla_media(-2), optimalla_media(0.5), optimalla_media(65504), optimalla_media(0), optimalla_media(100000)], [15360, 49152, 14336, 31743, 0, 31744], "flotante medio")
igual([optimalla_snorm(1, 8), optimalla_snorm(-1, 8), optimalla_unorm(0.5, 8), optimalla_snorm(0.5, 16)], [127, -127, 128, 16384], "snorm y unorm")
sea esf = optimalla_esfera(e)
igual([esf["radio"] >= 0.999, esf["radio"] < 1.1], [verdadero, verdadero], "esfera envolvente")
mostrar("[OK] optimalla")
