importar "serie"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion hex(t) {
    sea r = []
    sea i = 0
    mientras (i < longitud(t)) {
        sea b = byte_en(t, i)
        r.agregar(subcadena("0123456789ABCDEF", piso(b / 16), piso(b / 16) + 1) + subcadena("0123456789ABCDEF", b % 16, b % 16 + 1))
        i = i + 1
    }
    retornar unir(r, " ")
}
funcion b(l) {
    sea r = []
    para x en l { r.agregar(bytes_entero(x, 1, 0)) }
    retornar unir(r, "")
}
// Modbus RTU: tramas conocidas de la especificación y de herramientas comunes.
igual(hex(serie_modbus_peticion(1, 3, 0, 10)), "01 03 00 00 00 0A C5 CD", "leer registros")
igual(hex(serie_modbus_peticion(17, 6, 1, 3)), "11 06 00 01 00 03 9A 9B", "escribir registro")
igual(hex(serie_modbus_peticion(1, 5, 172, verdadero)), "01 05 00 AC FF 00 4C 1B", "escribir bobina")
igual(hex(serie_modbus_peticion(17, 15, 19, [1, 0, 1, 1, 0, 0, 1, 1, 1, 0])), "11 0F 00 13 00 0A 02 CD 01 BF 0B", "bobinas")
igual(serie_crc_modbus("123456789"), 19255, "crc modbus")
funcion con_crc(t) {
    sea c = serie_crc_modbus(t)
    retornar t + b([c % 256, piso(c / 256)])
}
igual(serie_modbus_respuesta(con_crc(b([1, 3, 4, 0, 10, 1, 2])), nulo)["valores"], [10, 258], "respuesta registros")
igual(serie_modbus_respuesta(con_crc(b([17, 1, 1, 5])), 4)["valores"], [verdadero, falso, verdadero, falso], "respuesta bobinas")
igual(serie_modbus_respuesta(con_crc(b([1, 131, 2])), nulo)["error"], 2, "excepción")
sea malo = ""
intentar { serie_modbus_respuesta(b([1, 3, 2, 0, 1, 0, 0]), nulo) } capturar (e) { malo = "" + e }
igual(malo, "modbus: CRC inválido", "crc malo")
// SLIP y COBS (vectores del RFC 1055 y de la publicación de COBS).
igual(hex(serie_slip_codificar(b([1, 192, 2, 219, 3]))), "01 DB DC 02 DB DD 03 C0", "slip")
igual(hex(serie_slip_decodificar(b([1, 219, 220, 2, 219, 221, 3]))), "01 C0 02 DB 03", "slip vuelta")
igual(hex(serie_cobs_codificar(b([0]), falso)), "01 01", "cobs 00")
igual(hex(serie_cobs_codificar(b([0, 0]), falso)), "01 01 01", "cobs 00 00")
igual(hex(serie_cobs_codificar(b([17, 34, 0, 51]), falso)), "03 11 22 02 33", "cobs 11 22 00 33")
igual(hex(serie_cobs_codificar(b([17, 0, 0, 0]), falso)), "02 11 01 01 01", "cobs 11 00 00 00")
sea largo = []
sea i = 1
mientras (i <= 254) {
    largo.agregar(i)
    i = i + 1
}
igual(longitud(serie_cobs_codificar(b(largo), falso)), 255, "cobs 254 bytes")
igual(serie_cobs_decodificar(serie_cobs_codificar(b(largo), verdadero)) == b(largo), verdadero, "cobs vuelta")
// Analizadores con datos que llegan en pedazos.
sea a = serie_analizador("delimitador", {"delimitador": "\r\n"})
igual([serie_alimentar(a, "hola\r"), serie_alimentar(a, "\nmundo\r\nx")], [[], ["hola", "mundo"]], "líneas")
sea l = serie_analizador("longitud", {"longitud": 3})
igual(serie_alimentar(l, "abcdefg"), ["abc", "def"], "longitud fija")
sea ie = serie_analizador("inicio_fin", {"inicio": "<", "fin": ">"})
igual([serie_alimentar(ie, "ruido<a"), serie_alimentar(ie, "1>x<b2>")], [[], ["a1", "b2"]], "inicio y fin")
sea sl = serie_analizador("slip", nulo)
igual(serie_alimentar(sl, serie_slip_codificar("uno") + serie_slip_codificar(b([192]))), ["uno", b([192])], "slip analizador")
sea co = serie_analizador("cobs", nulo)
igual(serie_alimentar(co, serie_cobs_codificar(b([0, 5]), verdadero) + serie_cobs_codificar("z", verdadero)), [b([0, 5]), "z"], "cobs analizador")
// Configuración de c_cflag (Linux): 8N1, 7E1 y 8O2 con RTS/CTS.
sea kl = {"CSIZE": 48, "CS5": 0, "CS6": 16, "CS7": 32, "CS8": 48, "CSTOPB": 64, "CREAD": 128, "PARENB": 256, "PARODD": 512, "CLOCAL": 2048, "CRTSCTS": 2147483648, "CMSPAR": 1073741824}
igual(serie_cflag(0, nulo, kl), 48 + 128 + 2048, "8N1")
igual(serie_cflag(48 + 64, {"datos": 7, "paridad": "par"}, kl), 32 + 256 + 128 + 2048, "7E1")
igual(serie_cflag(0, {"paridad": "impar", "parada": 2, "rtscts": verdadero}, kl), 48 + 64 + 256 + 512 + 2147483648 + 128 + 2048, "8O2")
// Puerto real: par de pseudo terminales (como un Arduino conectado).
si (existe_archivo("/dev/ptmx")) {
    sea par = serie_pty()
    sea p = serie_abrir(par["esclavo"], {"velocidad": 115200})
    serie_escribir(par["maestro"], "T=21.5\nH=40\n")
    igual([serie_leer_linea(p, 1000, nulo), serie_leer_linea(p, 1000, nulo)], ["T=21.5", "H=40"], "leer líneas")
    igual(serie_leer_linea(p, 50, nulo), nulo, "tiempo vencido")
    serie_escribir(p, b([0, 1, 2, 255]) + "ok")
    igual(hex(serie_leer_exacto(par["maestro"], 6, 1000)), "00 01 02 FF 6F 6B", "binario")
    // Esclavo Modbus simulado en el otro extremo.
    serie_escribir(par["maestro"], con_crc(b([1, 3, 4, 0, 7, 0, 9])))
    sea resp = serie_modbus(p, 1, 3, 0, 2, {"descartar": falso})
    igual(resp["valores"], [7, 9], "modbus por el puerto")
    igual(hex(serie_leer(par["maestro"])), "01 03 00 00 00 02 C4 0B", "petición enviada")
    serie_cerrar(p)
    serie_cerrar(par["maestro"])
}
igual(tipo(serie_listar()), "lista", "listar")
igual(serie_codigo_velocidad(115200) > 0, verdadero, "velocidad")
mostrar("[OK] serie")
