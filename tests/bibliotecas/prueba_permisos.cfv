importar "permisos"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea p = permisos_nuevo()
permisos_rol(p, "editor", ["lector"])
permisos_rol(p, "admin", ["editor"])
permisos_rol(p, "ciclo", ["admin", "ciclo"])
permisos_permitir(p, "lector", "articulos/*", "leer")
permisos_permitir(p, "editor", "articulos/*", "*")
permisos_denegar(p, "editor", "articulos/*", "borrar", funcion(u, r) { retornar tipo(r) == "mapa" y r["bloqueado"] == verdadero })
permisos_permitir(p, "autor", "articulos/*", "editar", funcion(u, r) { retornar tipo(u) == "mapa" y tipo(r) == "mapa" y r["autor"] == u["id"] })
permisos_permitir(p, "pepe", "facturas", "ver")
permisos_asignar(p, "ana", "admin")
permisos_asignar(p, "luis", "lector")
permisos_asignar(p, "eva", "autor")
permisos_asignar(p, "zoe", "editor", "empresaA")
permisos_asignar(p, "loop", "ciclo")
igual([permisos_puede(p, "ana", "articulos/1", "borrar"), permisos_puede(p, "luis", "articulos/1", "borrar"), permisos_puede(p, "luis", "articulos/1", "leer"), permisos_puede(p, "luis", "usuarios", "leer")], [verdadero, falso, verdadero, falso], "herencia y comodines")
igual(permisos_puede(p, "ana", {"tipo": "articulos/1", "bloqueado": verdadero}, "borrar"), falso, "denegar gana")
igual([permisos_puede(p, {"id": "eva"}, {"tipo": "articulos/9", "autor": "eva"}, "editar"), permisos_puede(p, {"id": "eva"}, {"tipo": "articulos/9", "autor": "ana"}, "editar"), permisos_puede(p, "eva", "articulos/9", "editar")], [verdadero, falso, falso], "condición ABAC")
igual([permisos_puede(p, "zoe", "articulos/1", "editar", "empresaA"), permisos_puede(p, "zoe", "articulos/1", "editar", "empresaB")], [verdadero, falso], "dominios")
igual(permisos_roles(p, "ana"), ["ana", "admin", "editor", "lector"], "roles efectivos")
igual(permisos_puede(p, "loop", "articulos/1", "leer"), verdadero, "herencia circular no cuelga")
igual(permisos_puede(p, "pepe", "facturas", "ver"), verdadero, "regla directa al sujeto")
permisos_revocar(p, "ana", "admin")
igual(permisos_puede(p, "ana", "articulos/1", "leer"), falso, "revocar")
sea m = ""
intentar { permisos_exigir(p, "luis", "articulos/1", "borrar") } capturar (e) { m = e }
igual(m, "permisos: luis no puede borrar en articulos/1", "exigir")
mostrar("[OK] permisos")
