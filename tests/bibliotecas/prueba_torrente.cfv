importar "torrente"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Decodificador de líneas con datos partidos.
sea c = torrente_embebido([["lineas", torrente_lineas(100)]])
torrente_embebido_entrar(c, "hola\r\nmun")
torrente_embebido_entrar(c, "do\nfin")
igual(torrente_embebido_leer(c)["entrada"], ["hola", "mundo"], "líneas")
// Línea demasiado larga: el error llega al final de la tubería.
sea largo = ""
sea i = 0
mientras (i < 120) {
    largo = largo + "x"
    i = i + 1
}
torrente_embebido_entrar(c, largo)
igual(torrente_embebido_leer(c)["eventos"], [{"error": "torrente: línea demasiado larga"}], "límite de línea")
// Campo de largo (2 bytes big endian) y prefijo de largo de salida.
sea f = torrente_embebido([["tramas", torrente_campo_largo(1000, 0, 2, 0, 2, 0)], ["prefijo", torrente_prefijo_largo(2)]])
sea a = bytes_entero(3, 2, 0) + "abc" + bytes_entero(2, 2, 0)
torrente_embebido_entrar(f, subcadena(a, 0, 4))
torrente_embebido_entrar(f, subcadena(a, 4, longitud(a)) + "xy")
torrente_embebido_salir(f, "ok")
sea r = torrente_embebido_leer(f)
igual([r["entrada"], r["salida"]], [["abc", "xy"], [bytes_entero(2, 2, 0) + "ok"]], "campo de largo")
// Delimitador y largo fijo.
sea dd = torrente_embebido([["d", torrente_delimitador("||", 50)]])
torrente_embebido_entrar(dd, "a||bb||c")
igual(torrente_embebido_leer(dd)["entrada"], ["a", "bb"], "delimitador")
sea fx = torrente_embebido([["f", torrente_largo_fijo(3)]])
torrente_embebido_entrar(fx, "abcdefg")
igual(torrente_embebido_leer(fx)["entrada"], ["abc", "def"], "largo fijo")
// JSON por líneas y un manejador de negocio que responde.
sea orden = []
sea j = torrente_embebido([["lineas", torrente_lineas(1000)], ["json", torrente_json(verdadero)], ["negocio", {
    "activo": funcion(ctx) {
        orden.agregar("activo")
        torrente_pasar_evento(ctx, "activo")
    },
    "leer": funcion(ctx, msg) {
        orden.agregar("leer")
        torrente_escribir(ctx, {"eco": msg["n"] * 2})
    },
    "inactivo": funcion(ctx) { orden.agregar("inactivo") }
}]])
torrente_embebido_entrar(j, json_texto({"n": 21}) + "\n")
torrente_embebido_fin(j)
r = torrente_embebido_leer(j)
igual([r["salida"], orden], [[json_texto({"eco": 42}) + "\n"], ["activo", "leer", "inactivo"]], "JSON y eventos")
igual(torrente_nombres(j), ["lineas", "json", "negocio", "__fin"], "nombres")
torrente_quitar(j, "json")
igual(torrente_nombres(j), ["lineas", "negocio", "__fin"], "quitar")
// Un error en un manejador va al siguiente que tenga "error".
sea e = torrente_embebido([["malo", {"leer": funcion(ctx, msg) { lanzar "falló " + msg }}]])
torrente_embebido_entrar(e, "x")
igual(torrente_embebido_leer(e)["eventos"], [{"error": "falló x"}], "errores")
// TCP de verdad: servidor de eco por líneas y cliente, en el mismo bucle.
sea b = latido_bucle()
sea srv = torrente_servidor(b, "127.0.0.1", 0, funcion(canal) {
    torrente_agregar(canal, "lineas", torrente_lineas(1000))
    torrente_agregar(canal, "eco", {"leer": funcion(ctx, msg) {
        si (msg == "adios") { torrente_cerrar(ctx) } sino { torrente_escribir(ctx, texto_mayusculas(msg) + "\n") }
    }})
})
sea recibido = []
torrente_cliente(b, "127.0.0.1", latido_puerto(srv), funcion(canal) {
    torrente_agregar(canal, "lineas", torrente_lineas(1000))
    torrente_agregar(canal, "cli", {
        "activo": funcion(ctx) { torrente_escribir(ctx, "hola\nmundo\nadios\n") },
        "leer": funcion(ctx, msg) { recibido.agregar(msg) },
        "inactivo": funcion(ctx) {
            recibido.agregar("<cerrado>")
            latido_cerrar_servidor(srv)
        }
    })
}, nulo)
sea guardia = latido_temporizador(b, 5000, 0, funcion(t) { lanzar "el eco tardó demasiado" })
latido_sin_ref(guardia)
latido_correr(b, nulo)
igual(recibido, ["HOLA", "MUNDO", "<cerrado>"], "TCP")
mostrar("[OK] torrente")
