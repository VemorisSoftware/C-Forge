importar "numerica"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion cerca(a, b, q) { afirmar(absoluto(a - b) < 0.000001, q + ": " + a + " != " + b) }
sea d = [2, 4, 4, 4, 5, 5, 7, 9]
igual([numerica_media(d), numerica_mediana(d), numerica_moda(d)], [5, 4.5, [4]], "centrales")
igual([numerica_varianza(d, verdadero), numerica_desviacion(d, verdadero)], [4, 2], "población")
cerca(numerica_varianza(d), 32 / 7, "muestral")
igual([numerica_percentil([1, 2, 3, 4], 90), numerica_percentil([1, 2, 3, 4], 0), numerica_percentil([1, 2, 3, 4], 100), numerica_percentil([7], 50)], [3.7, 1, 4, 7], "percentiles como NumPy")
igual(numerica_moda([1, 2, 2, 3, 3]), [2, 3], "moda con empate")
cerca(numerica_suma([0.1, 0.2, 0.3, 0.4]), 1, "suma compensada")
sea grande = []
sea i = 0
mientras (i < 10000) { grande.agregar(0.1)  i = i + 1 }
cerca(numerica_suma(grande), 1000, "10000 × 0.1 sin deriva")
sea r = numerica_regresion([1, 2, 3, 4], [3, 5, 7, 9])
igual([r["pendiente"], r["intercepto"], r["r2"]], [2, 1, 1], "regresión exacta")
cerca(numerica_correlacion([1, 2, 3, 4], [2, 4, 5, 9]), 0.9647638, "Pearson")
igual(numerica_correlacion([1, 2, 3], [3, 2, 1]), -1, "correlación negativa")
cerca(numerica_covarianza([1, 2, 3], [1, 2, 3]), 1, "covarianza")
igual(numerica_estandarizar([1, 1, 1]), [0, 0, 0], "z constante")
igual(numerica_histograma([1, 2, 2, 3, 9], 4), {"bordes": [1, 3, 5, 7, 9], "cuentas": [3, 1, 0, 1]}, "histograma")
igual(numerica_fft([1, 0, 0, 0]), [[1, 0], [1, 0], [1, 0], [1, 0]], "FFT del impulso")
sea x = numerica_fft([1, 2, 3, 4])
cerca(x[0][0], 10, "FFT componente continua")
cerca(x[1][0], -2, "FFT re[1]")
cerca(x[1][1], 2, "FFT im[1]")
cerca(x[2][0], -2, "FFT re[2]")
sea y = numerica_ifft(x)
i = 0
mientras (i < 4) { cerca(y[i][0], i + 1, "inversa " + i)  cerca(y[i][1], 0, "inversa im " + i)  i = i + 1 }
sea esp = numerica_espectro(numerica_rellenar([0, 1, 0, -1, 0, 1, 0]))
igual(longitud(esp), 8, "rellenar a potencia de 2")
cerca(numerica_integrar(funcion(t) { retornar t * t }, 0, 3), 9, "Simpson")
cerca(numerica_integrar(funcion(t) { retornar seno(t) }, 0, pi()), 2, "∫ seno")
cerca(numerica_raiz(funcion(t) { retornar t * t - 2 }, 0, 2), raiz(2), "raíz de 2")
cerca(numerica_derivada(funcion(t) { retornar t * t * t }, 2), 12, "derivada")
sea s = numerica_resumen(d)
igual([s["n"], s["min"], s["q1"], s["mediana"], s["q3"], s["max"]], [8, 2, 4, 4.5, 5.5, 9], "resumen")
para malo en [[funcion() { numerica_media([]) }, "numerica: la media necesita al menos un dato"], [funcion() { numerica_fft([1, 2, 3]) }, "numerica: la FFT necesita un largo potencia de 2 (usa numerica_rellenar)"], [funcion() { numerica_raiz(funcion(t) { retornar t * t + 1 }, 0, 1) }, "numerica: f(a) y f(b) deben tener signos opuestos"], [funcion() { numerica_regresion([1, 1], [1, 2]) }, "numerica: todos los x son iguales"]] {
    sea m = ""
    intentar { malo[0]() } capturar (e) { m = e }
    igual(m, malo[1], malo[1])
}
mostrar("[OK] numerica")
