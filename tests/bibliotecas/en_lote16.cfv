// English aliases for batch 16.
importar "compress"
importar "tui"
importar "logpipe"
importar "reverseproxy"
importar "workflow"
importar "docconvert"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// compress
sea data = "hello hello hello hello hello world"
eq((zstd_decompress(zstd_compress(data), nulo)), "hello hello hello hello hello world", "zstd")
eq((lz4_decompress(lz4_compress(data))), "hello hello hello hello hello world", "lz4")
eq((snappy_decompress(snappy_compress(data))), "hello hello hello hello hello world", "snappy")
eq((gunzip(gzip(data, 6), nulo)), "hello hello hello hello hello world", "gzip")
eq(crc32("123456789", nulo), 3421780262, "crc32")
// tui
sea b = tui_buffer(10, 3)
tui_block(b, tui_area(b), {"title": "Hi"})
eq(tui_text(b)[0], "┌Hi──────┐", "tui block")
// logpipe
eq(parse_logfmt("a=1 b=\"x y\"")["b"], "x y", "logfmt")
// reverseproxy
sea px = reverseproxy_new({"upstreams": {"api": {"servers": ["http://a", "http://b"]}}, "routes": [{"prefix": "/api", "upstream": "api", "strip_prefix": verdadero}]})
sea tr = funcion(m, url, o) { retornar {"estado": 200, "cuerpo": url, "cabeceras": {}} }
eq(reverseproxy_handle(px, {"metodo": "GET", "ruta": "/api/x", "cabeceras": {}}, tr)["cuerpo"], "http://a/x", "proxy")
eq(reverseproxy_status(px)["metrics"]["requests"], 1, "proxy status")
// workflow
sea w = workflow_engine({"clock": funcion() { retornar 0 }})
workflow_register(w, "greet", funcion(ctx, name) {
    sea who = workflow_wait_signal(ctx, "name", nulo)
    retornar workflow_activity(ctx, "say", funcion(n) { retornar "hi " + n }, [who])
})
eq(workflow_start(w, "greet", "g1", nulo)["status"], "esperando", "workflow waits")
eq(workflow_signal(w, "g1", "name", "Ana")["result"], "hi Ana", "workflow signal")
// docconvert
eq(docconvert("# Hi\n\n*a*", "markdown", "html", nulo), "<h1 id=\"hi\">Hi</h1>\n<p><em>a</em></p>\n", "docconvert")
eq(docconvert_toc(docconvert_read("# A\n\n## B", "md"), 2)[1]["level"], 2, "toc")
mostrar("[OK] en_lote16")
