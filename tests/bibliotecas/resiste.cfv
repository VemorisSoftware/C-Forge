importar "resiste"
funcion igual(a, b, q) { afirmar(a == b, q + ": [" + a + "] != [" + b + "]") }
sea intentos = [0]
sea r = resiste_reintentar(funcion() {
    intentos[0] = intentos[0] + 1
    si (intentos[0] < 3) { lanzar "caído" }
    retornar "ok"
}, 5, 1, 2)
igual(r + " " + intentos[0], "ok 3", "reintenta hasta lograrlo")
sea m = ""
intentos[0] = 0
intentar { resiste_reintentar(funcion() { intentos[0] = intentos[0] + 1 lanzar "siempre" }, 3, 1, 2) } capturar (e) { m = e }
igual(m + " " + intentos[0], "siempre 3", "relanza el último error")
sea c = resiste_cortacircuitos(2, 60)
sea falla = funcion() { lanzar "abajo" }
intentar { resiste_llamar(c, falla) } capturar (e) { m = e }
igual(resiste_estado(c), "cerrado", "una falla no abre")
intentar { resiste_llamar(c, falla) } capturar (e) { m = e }
igual(resiste_estado(c), "abierto", "abre en el umbral")
intentar { resiste_llamar(c, funcion() { retornar 1 }) } capturar (e) { m = e }
igual(m, "resiste: circuito abierto", "rechaza al instante")
dormir(80)
igual(resiste_estado(c), "semiabierto", "semiabierto tras enfriar")
intentar { resiste_llamar(c, falla) } capturar (e) { m = e }
igual(resiste_estado(c), "abierto", "la prueba falla: abre de nuevo")
dormir(80)
igual(resiste_llamar(c, funcion() { retornar "vuelve" }), "vuelve", "la prueba sale bien")
igual(resiste_estado(c), "cerrado", "se cierra")
mostrar("[OK] resiste")
