importar "plantilla"
funcion igual(a, b, q) { afirmar(a == b, q + ": [" + a + "] != [" + b + "]") }
funcion p(t, d) { retornar plantilla_render(t, d) }
igual(p("<h1>{{ titulo }}</h1>", {"titulo": "Hola"}), "<h1>Hola</h1>", "valor")
igual(p("{{ u.nombre }}", {"u": {"nombre": "Ana"}}), "Ana", "ruta con puntos")
igual(p("{{ x }}", {"x": "<script>'\"&"}), "&lt;script&gt;&#39;&quot;&amp;", "escape XSS")
igual(p("{{{ x }}}", {"x": "<b>ok</b>"}), "<b>ok</b>", "sin escapar")
igual(p("{{ falta }}!", {}), "!", "faltante vacío")
igual(p("{{#si activo}}sí{{sino}}no{{/si}}", {"activo": verdadero}), "sí", "si")
igual(p("{{#si activo}}sí{{sino}}no{{/si}}", {"activo": falso}), "no", "sino")
igual(p("{{#si l}}hay{{/si}}", {"l": []}), "", "lista vacía es falsa")
igual(p("<ul>{{#cada items}}<li>{{@indice}}:{{.}}</li>{{/cada}}</ul>", {"items": ["a", "b"]}), "<ul><li>0:a</li><li>1:b</li></ul>", "cada")
igual(p("{{#cada gente}}{{nombre}} de {{ciudad}};{{/cada}}", {"ciudad": "Santiago", "gente": [{"nombre": "Ana"}, {"nombre": "Luis"}]}), "Ana de Santiago;Luis de Santiago;", "contexto de afuera")
igual(p("{{#cada a}}[{{#cada .}}{{.}}{{/cada}}]{{/cada}}", {"a": [[1, 2], [3]]}), "[12][3]", "anidado")
igual(p("{{#if ok}}{{#each xs}}{{.}}{{/each}}{{else}}x{{/if}}", {"ok": verdadero, "xs": [1, 2]}), "12", "palabras en inglés")
sea m = ""
intentar { p("{{#si x}}sin cierre", {}) } capturar (e) { m = e }
igual(m, "plantilla: falta {{/si}}", "error de cierre")
igual(p("{{titulo}}|{{{html}}}", {"titulo": "<a>", "html": "<b>"}), "&lt;a&gt;|<b>", "sin espacios")
mostrar("[OK] plantilla")
