importar "derivados"
funcion cerca(a, b, tol, q) { afirmar(absoluto(a - b) < tol, q + ": " + a + " != " + b) }
// Valores de referencia de Hull / scipy.
sea c = derivados_black_scholes("call", 100, 100, 1, 0.05, 0.2)
cerca(c["precio"], 10.450583572, 0.000001, "call")
cerca(c["delta"], 0.636830651, 0.000001, "delta")
cerca(c["gamma"], 0.018762017, 0.000001, "gamma")
cerca(c["vega"], 37.524034, 0.00001, "vega")
sea p = derivados_black_scholes("put", 100, 100, 1, 0.05, 0.2)
cerca(p["precio"], 5.573526022, 0.000001, "put")
cerca(c["precio"] - p["precio"], 100 - 100 * exponencial(-0.05), 0.0000001, "paridad put-call")
cerca(derivados_black_scholes("call", 42, 40, 0.5, 0.1, 0.2)["precio"], 4.759422, 0.00001, "ejemplo de Hull")
cerca(derivados_vol_implicita("call", c["precio"], 100, 100, 1, 0.05), 0.2, 0.0000001, "volatilidad implícita")
cerca(derivados_black_scholes("put", 100, 90, 0.5, 0.03, derivados_vol_implicita("put", 2, 100, 90, 0.5, 0.03))["precio"], 2, 0.000001, "vol implícita fuera del dinero")
cerca(derivados_binomial("call", 100, 100, 1, 0.05, 0.2, 500), c["precio"], 0.01, "binomial converge a BS")
afirmar(derivados_binomial("put", 100, 100, 1, 0.05, 0.2, 300, verdadero) > p["precio"], "put americana vale más")
cerca(derivados_black_scholes("call", 120, 100, 0, 0.05, 0.2)["precio"], 20, 0.0000001, "vencida")
cerca(derivados_normal_cdf(1.96), 0.9750021048517795, 0.0000000001, "N(1.96)")
cerca(derivados_normal_cdf(-3), 0.0013498980316301, 0.0000000001, "N(-3)")
cerca(derivados_tir([-1000, 300, 400, 500]), 0.0889633947, 0.0000001, "TIR")
cerca(derivados_van(0.1, [-1000, 300, 400, 500]), -21.036814, 0.00001, "VAN")
cerca(derivados_bono_precio(0.05, 0.05, 10), 100, 0.0000001, "bono a la par")
cerca(derivados_bono_precio(0.06, 0.05, 5, 2), 104.376032, 0.00001, "bono semestral")
cerca(derivados_bono_rendimiento(derivados_bono_precio(0.04, 0.07, 8), 0.04, 8), 0.07, 0.0000001, "rendimiento")
sea d = derivados_bono_duracion(0.05, 0.05, 10)
cerca(d["macaulay"], 8.107822, 0.00001, "duración de Macaulay")
cerca(d["modificada"], d["macaulay"] / 1.05, 0.0000001, "modificada")
cerca(derivados_cuota(10000000, 0.12, 36), 332143.098, 0.01, "cuota")
sea t = derivados_amortizacion(1000, 0.12, 12)
cerca(t[11]["saldo"], 0, 0.0000001, "amortiza todo")
cerca(t[0]["interes"], 10, 0.0000001, "interés del primer mes")
cerca(derivados_valor_futuro(1000, 0.05, 10, 100), 2886.68388, 0.0001, "valor futuro")
sea m = ""
intentar { derivados_tir([100, 200]) } capturar (e) { m = e }
afirmar(m == "derivados: la TIR no existe (los flujos no cambian de signo)", m)
intentar { derivados_black_scholes("swap", 1, 1, 1, 0, 0.1) } capturar (e) { m = e }
afirmar(m == "derivados: tipo \"call\" o \"put\"", m)
mostrar("[OK] derivados")
