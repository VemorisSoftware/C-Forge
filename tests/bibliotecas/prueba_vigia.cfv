importar "vigia"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
igual([vigia_coincide("*.tmp", "a.tmp"), vigia_coincide("*.tmp", "a.txt"), vigia_coincide("n?de", "node"), vigia_coincide(".git", ".git")], [verdadero, falso, verdadero, verdadero], "patrones")
sea e = vigia_estado("/tmp")
igual(e["carpeta"], verdadero, "estado de carpeta")
funcion tipos(evs) {
    sea r = []
    para x en evs {
        sea partes = texto_dividir(x["ruta"], "/")
        sea t = x["tipo"] + ":" + partes[longitud(partes) - 1]
        si (x["tipo"] == "renombrado") {
            sea d = texto_dividir(x["desde"], "/")
            t = t + "<" + d[longitud(d) - 1]
        }
        r.agregar(t)
    }
    retornar ordenar(r, funcion(a, b) { si (a < b) { retornar -1 }  retornar 1 })
}
para modo en ["sondeo", "auto"] {
    sea dir = "/tmp/cforge_vigia_" + modo + "_" + tiempo_ms()
    crear_carpeta(dir)
    crear_carpeta(dir + "/sub")
    escribir_archivo(dir + "/viejo.txt", "v")
    sea v = vigia_nuevo({"modo": modo, "ignorar": ["*.tmp"], "intervalo_ms": 30, "rebote_ms": 60})
    vigia_agregar(v, dir)
    // Sondeo: la fecha tiene resolución de ns, pero se espera un poco.
    dormir(20)
    escribir_archivo(dir + "/nuevo.txt", "hola")
    escribir_archivo(dir + "/sub/hondo.txt", "x")
    escribir_archivo(dir + "/basura.tmp", "x")
    sea ev = vigia_eventos(v, 2000)
    sea t = tipos(ev)
    afirmar(texto_indice("" + t, "creado:nuevo.txt") >= 0 y texto_indice("" + t, "creado:hondo.txt") >= 0, modo + " creados: " + t)
    afirmar(texto_indice("" + t, "basura") < 0, modo + " ignorados")
    dormir(20)
    escribir_archivo(dir + "/viejo.txt", "cambiado")
    t = tipos(vigia_eventos(v, 2000))
    afirmar(texto_indice("" + t, "modificado:viejo.txt") >= 0, modo + " modificado: " + t)
    eliminar_archivo(dir + "/nuevo.txt")
    t = tipos(vigia_eventos(v, 2000))
    afirmar(texto_indice("" + t, "borrado:nuevo.txt") >= 0, modo + " borrado: " + t)
    igual(vigia_eventos(v, 0), [], modo + " sin cambios")
    vigia_cerrar(v)
}
mostrar("[OK] vigia")
