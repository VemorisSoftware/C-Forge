importar "css"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
igual(css_minificar("/* c */ a { color : #FFFFFF ; margin: 0px 0.5em ; }"), "a{color:#fff;margin:0 .5em}", "básico")
igual(css_minificar("a  >  b , c ~ d + e { x: 1 }"), "a>b,c~d+e{x:1}", "combinadores")
igual(css_minificar("div :first-child { a: b }"), "div :first-child{a:b}", "descendiente con pseudo")
igual(css_minificar("a:hover { a: b }"), "a:hover{a:b}", "pseudo pegada")
igual(css_minificar("a { width: calc(100% - 2px + 1em) }"), "a{width:calc(100% - 2px + 1em)}", "calc conserva espacios")
igual(css_minificar("a { content: \"a ; b /* no */\" }"), "a{content:\"a ; b /* no */\"}", "textos intactos")
igual(css_minificar("a { background: url( \"x y.png\" ) }"), "a{background:url(\"x y.png\")}", "url con comillas")
igual(css_minificar("@media (max-width: 600px) { .y { padding : 0em } }"), "@media (max-width:600px){.y{padding:0}}", "@media")
igual(css_minificar("@media screen and (min-width: 1px) { a { b: c } }"), "@media screen and (min-width:1px){a{b:c}}", "and (…)")
igual(css_minificar(".x{} .y { } a { b: c;; }"), "a{b:c}", "reglas vacías y ;;")
igual(css_minificar("a { color: #AbCdEf; c: #aabbcc; d: -0.5px }"), "a{color:#abcdef;c:#abc;d:-.5px}", "colores y decimales")
sea r = css_analizar("@charset \"utf-8\";\na, b { color: red; background: url(x.png) }\n@media screen { .y { padding: 0 } }\n@font-face { font-family: X; src: url(\"x;y.woff\") }")
igual(longitud(r), 4, "cuatro reglas")
igual(r[0]["arroba"] + " " + r[0]["valor"], "charset \"utf-8\"", "@charset")
igual(r[1]["selector"], "a, b", "selector")
igual(r[1]["declaraciones"], [["color", "red"], ["background", "url(x.png)"]], "declaraciones")
igual(r[2]["reglas"][0]["selector"], ".y", "anidado en @media")
igual(r[3]["declaraciones"][1], ["src", "url(\"x;y.woff\")"], "; dentro de texto")
igual(css_valor(r, "a, b", "color"), "red", "css_valor")
igual(css_texto(css_analizar("a{b:c}")), "a {\n  b: c;\n}", "texto")
igual(css_minificar(css_texto(r)), css_minificar(css_texto(css_analizar(css_minificar(css_texto(r))))), "estable")
igual(css_minify("a { b : c }"), "a{b:c}", "english")
mostrar("[OK] css")
