// Pruebas de robotica. datos/robotica/esperado.json sale de MuJoCo 4.0:
// péndulo, péndulo doble con orientaciones y anclas, y un brazo con
// cilindro, cápsula, elipsoide, <inertial>, amortiguamiento, resorte y
// articulación deslizante; con Euler y RK4, 300 pasos y fuerzas aplicadas.
importar "robotica"
importar "json"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

sea e = json_parsear(leer_archivo("tests/bibliotecas/datos/robotica/esperado.json"))
para k en claves(e) {
    sea c = e[k]
    sea s = robotica_cargar_xml(c["xml"])
    para i en lista_rango(0, longitud(c["masas"])) { afirmar(absoluto(robotica_cuerpos(s)[i]["masa"] - c["masas"][i]) < 1e-12, k + " masa " + i) }
    robotica_fijar(s, "qpos", c["qpos0"])
    robotica_fijar(s, "qvel", c["qvel0"])
    robotica_fijar(s, "fuerza", c["fuerza"])
    para paso en lista_rango(0, 300) {
        robotica_paso(s)
        si ((paso + 1) % 100 == 0) {
            sea r = c["tray"][cociente(paso + 1, 100) - 1]
            para i en lista_rango(0, longitud(r["qpos"])) {
                afirmar(absoluto(s["qpos"][i] - r["qpos"][i]) < 1e-9 y absoluto(s["qvel"][i] - r["qvel"][i]) < 1e-9, k + " paso " + (paso + 1) + " dof " + i)
            }
        }
    }
}

// Conservación de la energía con RK4 sin amortiguamiento.
sea p = robotica_cargar_xml("<mujoco><option timestep=\"0.001\" integrator=\"RK4\"/><worldbody><body pos=\"0 0 1\"><joint name=\"j\" axis=\"0 1 0\"/><geom type=\"sphere\" size=\"0.1\" pos=\"0 0 -0.5\" mass=\"1\"/></body></worldbody></mujoco>")
eq(robotica_articulaciones(p), ["j"], "articulaciones")
robotica_fijar(p, "qpos", [1.2])
sea e0 = robotica_energia(p)
para i en lista_rango(0, 500) { robotica_paso(p) }
sea e1 = robotica_energia(p)
afirmar(absoluto((e1["potencial"] + e1["cinetica"]) - (e0["potencial"] + e0["cinetica"])) < 1e-9, "energía conservada")
afirmar(absoluto(robotica_estado(p)["tiempo"] - 0.5) < 1e-12, "tiempo")
sea cm = robotica_posiciones(p)[0]
afirmar(absoluto(cm[0] * cm[0] + (cm[2] - 1) * (cm[2] - 1) - 0.25) < 1e-12, "el centro de masa sigue en el círculo")
sea error = ""
intentar { robotica_cargar_xml("<mujoco><worldbody><body><joint type=\"ball\"/><geom size=\"0.1\"/></body></worldbody></mujoco>") } capturar (x) { error = x }
afirmar(texto_contiene(error, "no soportada"), "articulación esférica no soportada")
mostrar("[OK] robotica")
