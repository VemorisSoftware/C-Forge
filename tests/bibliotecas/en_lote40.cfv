// Lote 40 en inglés: hidapi, libusb y kafka.
importar "hidapi"
importar "libusb"
importar "kafka"

sea raton = [5, 1, 9, 2, 161, 1, 9, 1, 161, 0, 5, 9, 25, 1, 41, 3, 21, 0, 37, 1, 149, 3, 117, 1, 129, 2, 149, 1, 117, 5, 129, 1, 5, 1, 9, 48, 9, 49, 9, 56, 21, 129, 37, 127, 117, 8, 149, 3, 129, 6, 192, 192]
sea d = hid_parse_report_descriptor(raton)
afirmar(longitud(d["fields"]) == 7 y d["fields"][4]["name"] == "X" y d["fields"][4]["logical_min"] == -127, "hid_parse_report_descriptor")
sea v = hid_report_values(mando_analizar_descriptor(raton), [5, 255, 3, 250])
afirmar(v["X"] == -1 y v["Wheel"] == -6 y v["Button 1"] == 1, "hid_report_values")

sea u = libusb_parse_descriptors(leer_archivo("tests/bibliotecas/datos/usb/descriptores.bin"))
afirmar(u["configurations"][0]["interfaces"][1]["altsettings"][0]["endpoints"][0]["max_packet_size"] == 512, "libusb_parse_descriptors")
afirmar(libusb_decode_string_descriptor(leer_archivo("tests/bibliotecas/datos/usb/texto.bin")) == "Señal ✓ 🚀", "libusb_decode_string_descriptor")

sea c = kafka_connect_local(kafka_broker({"partitions": 2}))
sea p = kafka_producer(c, nulo)
kafka_send_record(p, "orders", {"value": "one", "key": "a", "headers": [["h", "1"]]})
afirmar(kafka_flush(p)[0]["topic"] == "orders", "kafka_flush")
sea r = kafka_poll(kafka_consumer(c, ["orders"], {"from": "earliest"}), 0)
afirmar(r[0]["value"] == "one" y r[0]["key"] == "a" y r[0]["partition"] == kafka_partition_for_key("a", 2), "kafka_poll")
mostrar("[OK] en_lote40")
