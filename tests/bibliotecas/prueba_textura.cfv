importar "textura"
importar "base64"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Bloques al azar decodificados con texture2ddecoder (Python): el resultado
// coincide byte a byte (MD5 de los canales que usa cada formato).
sea AZ = base64_decodificar("TyQamogyMnxMWdIyyvz18bB0xpV1s4BF8qMdw4UtCUWjERF4xhF6GdOn7FkiY3o0+PUlbi1vVe6ScmGd9IG+gQ==")
sea AZ16 = base64_decodificar("TyQamogyMnxMWdIyyvz18bB0xpV1s4BF8qMdw4UtCUWjERF4xhF6GdOn7FkiY3o0+PUlbi1vVe6ScmGd9IG+ge6vuF2jrQk36p1KjEAXJXXCD/283F1qmtr/dtIe4spB5KTxpODPp2ASOQ2Lpssg6vsH5qY+Nt+e1z9b50kk7As=")
funcion canales(img, cs) {
    sea r = []
    sea i = 0
    mientras (i < img["ancho"] * img["alto"]) {
        para c en cs { r.agregar(bytes_entero(byte_en(img["pixeles"], i * 4 + c), 1, 0)) }
        i = i + 1
    }
    retornar unir(r, "")
}
igual(md5(textura_descomprimir(AZ, "etc1", 16, 8, nulo)["pixeles"]), "8a564bbf1d4394c27e867d6c42e19827", "etc1")
igual(md5(canales(textura_descomprimir(AZ, "bc4", 16, 8, nulo), [0])), "9e4163c59fdf8e3c5603e1df24cc88cf", "bc4")
igual(md5(canales(textura_descomprimir(AZ16, "bc5", 16, 8, nulo), [0, 1])), "6bb26b31b5b1e0ac18c20040f28d3b7d", "bc5")
// Imagen de prueba: degradados, ruido y alfa a cuadros.
sea w = 32
sea h = 24
sea partes = []
sea yy = 0
mientras (yy < h) {
    sea x = 0
    mientras (x < w) {
        sea ruido = (x * 7 + yy * 13) % 11 - 5
        sea a = 255
        si ((piso(x / 8) + piso(yy / 8)) % 2 == 1) { a = minimo(255, x * 8) }
        partes.agregar(bytes_entero(maximo(0, minimo(255, x * 8 + ruido)), 1, 0) + bytes_entero(maximo(0, minimo(255, yy * 10 + ruido)), 1, 0) + bytes_entero((x + yy) * 4 % 256, 1, 0) + bytes_entero(a, 1, 0))
        x = x + 1
    }
    yy = yy + 1
}
sea img = {"ancho": w, "alto": h, "pixeles": unir(partes, "")}
para par en [["bc1", 30, 8], ["bc3", 30, 16], ["etc1", 25, 8]] {
    sea c = textura_comprimir(img, par[0])
    sea d = textura_descomprimir(c, par[0], w, h, nulo)
    igual([longitud(c), textura_psnr(img, d, falso) > par[1]], [w * h / 16 * par[2], verdadero], par[0] + " calidad")
}
// BC3 guarda el alfa con BC4.
sea d3 = textura_descomprimir(textura_comprimir(img, "bc3"), "bc3", w, h, nulo)
sea err_alfa = 0
sea i = 0
mientras (i < w * h) {
    err_alfa = maximo(err_alfa, absoluto(byte_en(img["pixeles"], i * 4 + 3) - byte_en(d3["pixeles"], i * 4 + 3)))
    i = i + 1
}
igual(err_alfa <= 20, verdadero, "alfa bc3")
// BC1 con transparencia: alfa 0 donde era < 128.
sea trans = {"ancho": 4, "alto": 4, "pixeles": ""}
sea tp = []
i = 0
mientras (i < 16) {
    si (i % 2 == 0) { tp.agregar(bytes_entero(200, 1, 0) + bytes_entero(30, 1, 0) + bytes_entero(30, 1, 0) + bytes_entero(255, 1, 0)) } sino { tp.agregar(bytes_entero(0, 4, 0)) }
    i = i + 1
}
trans["pixeles"] = unir(tp, "")
sea dt = textura_descomprimir(textura_comprimir(trans, "bc1a"), "bc1a", 4, 4, nulo)
igual([byte_en(dt["pixeles"], 3), byte_en(dt["pixeles"], 7), absoluto(byte_en(dt["pixeles"], 0) - 200) < 8], [255, 0, verdadero], "bc1 transparente")
// Canal único: BC4 casi sin pérdida en un degradado.
sea d4 = textura_descomprimir(textura_comprimir(img, "bc4"), "bc4", w, h, nulo)
sea e4 = 0
i = 0
mientras (i < w * h) {
    e4 = maximo(e4, absoluto(byte_en(img["pixeles"], i * 4) - byte_en(d4["pixeles"], i * 4)))
    i = i + 1
}
igual(e4 <= 6, verdadero, "bc4")
// Mipmaps y contenedores (Pillow abre el DDS).
sea mips = textura_mipmaps(img)
igual([longitud(mips), mips[1]["ancho"], mips[5]["ancho"], mips[5]["alto"]], [6, 16, 1, 1], "mipmaps")
sea dds = textura_dds(img, "bc3", verdadero)
sea ld = textura_dds_leer(dds)
igual([subcadena(dds, 0, 4), ld["formato"], longitud(ld["niveles"]), ld["niveles"][2]["ancho"], textura_psnr(img, ld["niveles"][0], falso) > 30], ["DDS ", "bc3", 6, 8, verdadero], "dds")
sea ktx = textura_ktx(img, "etc1", verdadero)
sea lk = textura_ktx_leer(ktx)
igual([lk["formato"], longitud(lk["niveles"]), lk["niveles"][1]["alto"], textura_psnr(img, lk["niveles"][0], falso) > 25], ["etc1", 6, 12, verdadero], "ktx")
mostrar("[OK] textura")
