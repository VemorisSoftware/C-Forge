// English aliases for batch 17.
importar "audio3d"
importar "mixer"
importar "serialport"
importar "kvstore"
importar "flatbuffers"
importar "gltf"
importar "zeroconf"
importar "portmap"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// audio3d
eq(audio3d_attenuation("inversa_limitada", 4, 1, 100, 1), 0.25, "attenuation")
sea ctx = audio3d_context({"rate": 8000})
sea src = audio3d_source(ctx, [0.5, 0.5], {"position": [3, 0, 0], "ref_distance": 3})
eq(redondear(audio3d_compute(ctx, src)["right"] * 100), 100, "pan right")
// mixer
sea a = mixer_from_samples([[0.5, 0.5]], 2)
eq(mixer_concat([a, a])["c"][0], [0.5, 0.5, 0.5, 0.5], "concat")
sea f = flac_encode({"tasa": 8000, "bits": 16, "muestras": [[1, 2, 3, 4]]}, nulo)
eq(flac_decode(f, nulo)["samples"], [[1, 2, 3, 4]], "flac")
// serialport
eq(modbus_crc("123456789"), 19255, "modbus crc")
eq(cobs_decode(cobs_encode("a" + bytes_entero(0, 1, 0) + "b", verdadero)), "a" + bytes_entero(0, 1, 0) + "b", "cobs")
// kvstore
sea dir = "/tmp/cforge_kv_en"
kvstore_destroy(dir)
sea db = kvstore_open(dir, nulo)
kvstore_put(db, "k", "v")
eq([kvstore_get(db, "k", nulo), kvstore_range(db, {"prefix": "k"})], ["v", [["k", "v"]]], "kvstore")
kvstore_close(db)
kvstore_destroy(dir)
// flatbuffers
sea s = flatbuffers_schema("table P { x: int; n: string; } root_type P;")
eq(flatbuffers_decode(s, flatbuffers_encode(s, {"x": 7, "n": "hi"}, nulo), nulo), {"n": "hi", "x": 7}, "flatbuffers")
// gltf
sea g = gltf_parse(gltf_export_glb([{"malla": malla_cubo(1), "nombre": "cube"}], nulo), nulo)
eq(longitud(gltf_flatten(g, nulo)["indices"]), 36, "gltf")
// zeroconf
sea sv = zeroconf_service({"instancia": "Web", "tipo": "_http._tcp", "puerto": 80, "direcciones": ["10.0.0.1"]})
eq(zeroconf_collect([dns_decode(zeroconf_announce(sv, falso))], nulo)[0]["port"], 80, "zeroconf")
// portmap
eq(natpmp_response(bytes_entero(0, 1, 0) + bytes_entero(128, 1, 0) + bytes_entero(0, 6, 0) + bytes_entero(4278190081, 4, 0))["ip"], "255.0.0.1", "natpmp")
mostrar("[OK] en_lote17")
