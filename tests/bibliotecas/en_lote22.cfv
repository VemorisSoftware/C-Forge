// English aliases for batch 22.
importar "browser"
importar "dbmapper"
importar "fixedphysics"
importar "meshio"
importar "scenetree"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// browser
sea sim = browser_mock({"https://a.test/": {"titulo": "A", "dom": {"h1": "Hi"}}})
sea nav = browser_connect(nulo, {"transport": sim["transporte"]})
sea p = browser_new_page(nav)
page_goto(p, "https://a.test/")
eq([page_title(p), page_inner_text(p, "h1"), page_console(p)[0]["text"]], ["A", "Hi", "cargó https://a.test/"], "browser")
// dbmapper
sea orm = mapper_open(":memory:")
mapper_model(orm, "Item", {"campos": {"name": {"tipo": "texto", "requerido": verdadero}, "qty": {"tipo": "entero", "defecto": 1}}})
mapper_migrate(orm)
mapper_create(orm, "Item", {"name": "pen"})
mapper_create(orm, "Item", {"name": "cup", "qty": 3})
eq([mapper_count(mapper_where(mapper_query(orm, "Item"), "qty", ">", 1)), mapper_aggregate(mapper_query(orm, "Item"), "suma", "qty")], [1, 4], "dbmapper")
eq(mapper_history(orm)[0]["description"], "crear tabla items", "history")
// fixedphysics
sea w = fp_world_new({"gravity": [0, -10]})
fp_add_box(w, {"x": 0, "y": -1, "width": 10, "height": 2, "type": "static"})
sea b = fp_add_circle(w, {"x": 0, "y": 2, "radius": 0.5})
fp_steps(w, 90)
eq(abs(fp_position(w, b)[1] - 0.5) < 0.05, verdadero, "fixedphysics")
// meshio
sea c = malla_cubo(1)
c["uvs"] = []
c["normales"] = []
sea m = meshio_load_bytes(meshio_export(meshio_join_vertices(c, 0), "stl", nulo), {"join": verdadero})
sea med = meshio_measure(m)
eq([med["vertices"], med["triangles"], med["watertight"]], [8, 12, verdadero], "meshio")
// scenetree
sea root = scene_node("Root", "Nodo", nulo)
sea t = scene_tree(root, nulo)
sea hijo = scene_add_child(root, scene_node("Child", "Nodo", nulo))
sea got = []
scene_connect(hijo, "ping", funcion(x) { got.agregar(x) }, {"one_shot": verdadero})
scene_emit(hijo, "ping", [1])
scene_emit(hijo, "ping", [2])
eq([scene_path(hijo), got], ["/Root/Child", [1]], "scenetree")
mostrar("[OK] en_lote22")
