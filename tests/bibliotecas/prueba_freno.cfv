importar "freno"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea t = [0]
sea f = freno_con_reloj(freno_nuevo(3, 2), funcion() { retornar t[0] })
igual([freno_permitir(f, "ip1"), freno_permitir(f, "ip1"), freno_permitir(f, "ip1"), freno_permitir(f, "ip1")], [verdadero, verdadero, verdadero, falso], "ráfaga")
igual(freno_restante(f, "ip1"), 0, "sin fichas")
igual(freno_espera_ms(f, "ip1"), 501, "espera")
igual(freno_permitir(f, "ip2"), verdadero, "claves independientes")
t[0] = 500
igual(freno_permitir(f, "ip1"), verdadero, "recarga 2/s")
igual(freno_permitir(f, "ip1"), falso, "otra vez vacío")
t[0] = 10000
igual(freno_restante(f, "ip1"), 3, "tope en la capacidad")
igual(freno_permitir(f, "ip1", 3), verdadero, "costo 3")
igual(freno_permitir(f, "ip1", 1), falso, "costo agotado")
sea h = freno_cabeceras(f, "ip1")
igual(h["RateLimit-Limit"] + " " + h["RateLimit-Remaining"] + " " + h["Retry-After"], "3 0 1", "cabeceras")
igual(tiene_clave(freno_cabeceras(f, "nueva"), "Retry-After"), falso, "sin Retry-After si hay fichas")
// Rotar claves no hace crecer la memoria: las llenas se olvidan.
sea i = 0
mientras (i < 3000) { freno_permitir(f, "rot" + i)  t[0] = t[0] + 2000  i = i + 1 }
afirmar(longitud(claves(f["cubetas"])) < 1100, "limpieza de cubetas: " + longitud(claves(f["cubetas"])))
sea m = ""
intentar { freno_nuevo(0, 1) } capturar (e) { m = e }
igual(m, "freno: capacidad >= 1 y por_segundo > 0", "validación")
mostrar("[OK] freno")
