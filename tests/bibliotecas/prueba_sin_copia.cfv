importar "sin_copia"
importar "base64"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea e = sin_copia_esquema("// Esquema de prueba\nnamespace Juego;\nenum Color : byte { Rojo = 0, Verde, Azul = 2 }\nstruct Vec3 { x: float; y: float; z: float; }\ntable Arma { nombre: string; dano: short; }\nunion Equipo { Arma }\ntable Monstruo {\n  pos: Vec3;\n  mana: short = 150;\n  hp: short = 100;\n  nombre: string;\n  amigable: bool = false (deprecated);\n  inventario: [ubyte];\n  color: Color = Azul;\n  armas: [Arma];\n  equipado: Equipo;\n  ruta: [Vec3];\n  nums: [long];\n  precision: double;\n}\nroot_type Monstruo;\nfile_identifier \"MONS\";\n")
igual([e["raiz"], e["identificador"], e["espacio"]], ["Monstruo", "MONS", "Juego"], "esquema")
igual(e["tipos"]["Vec3"]["tam"], 12, "tamaño de struct")
// Búfer hecho con la biblioteca oficial de FlatBuffers para Python.
sea PY = base64_decodificar("")
igual(sin_copia_identificador(PY), "MONS", "identificador")
sea m = sin_copia_raiz(e, PY, nulo)
igual([sin_copia_campo(m, "nombre"), sin_copia_campo(m, "mana"), sin_copia_campo(m, "hp"), sin_copia_campo(m, "color")], ["Orco ñandú", 300, 100, "Verde"], "campos perezosos")
igual([sin_copia_tiene(m, "hp"), sin_copia_tiene(m, "mana")], [falso, verdadero], "presencia")
igual(sin_copia_campo(m, "pos"), {"x": 1, "y": 2, "z": 3}, "struct")
sea armas = sin_copia_campo(m, "armas")
igual([sin_copia_largo(armas), sin_copia_campo(sin_copia_elemento(armas, 1), "nombre")], [2, "Hacha"], "vector de tablas")
igual([sin_copia_campo(m, "equipado_type"), sin_copia_campo(sin_copia_campo(m, "equipado"), "dano")], ["Arma", 5], "unión")
igual(sin_copia_a_mapa(sin_copia_campo(m, "nums")), [1, -2, 1099511627776], "vector de long")
igual(redondear(sin_copia_campo(m, "precision") * 1000000), 3141593, "double")
igual(sin_copia_a_mapa(sin_copia_campo(m, "inventario")) == bytes_entero(0, 1, 0) + bytes_entero(1, 1, 0) + bytes_entero(2, 1, 0) + bytes_entero(3, 1, 0) + bytes_entero(4, 1, 0) + bytes_entero(5, 1, 0) + bytes_entero(6, 1, 0) + bytes_entero(7, 1, 0) + bytes_entero(8, 1, 0) + bytes_entero(9, 1, 0), verdadero, "vector de bytes")
// Ida y vuelta (la biblioteca de Python lee este búfer igual).
sea valor = {"pos": {"x": 1, "y": 2, "z": 3}, "mana": 300, "hp": 100, "nombre": "Orco ñandú", "inventario": "0123456789", "color": "Verde",
    "armas": [{"nombre": "Espada", "dano": 3}, {"nombre": "Hacha", "dano": 5}], "equipado_type": "Arma", "equipado": {"nombre": "Hacha", "dano": 5},
    "ruta": [{"x": 1, "y": 2, "z": 3}, {"x": 4, "y": 5.5, "z": 0 - 6}], "nums": [1, 0 - 2, 1099511627776], "precision": 0.1}
sea b = sin_copia_codificar(e, valor, nulo)
sea d = sin_copia_decodificar(e, b, nulo)
igual([d["nombre"], d["armas"][1]["dano"], d["ruta"][1], d["nums"], d["precision"], d["inventario"], d["equipado"]["nombre"]], ["Orco ñandú", 5, {"x": 4, "y": 5.5, "z": -6}, [1, -2, 1099511627776], 0.1, "0123456789", "Hacha"], "ida y vuelta")
igual(tiene_clave(d, "hp"), verdadero, "valor por defecto al leer")
igual(sin_copia_tiene(sin_copia_raiz(e, b, nulo), "hp"), falso, "el valor por defecto no se guarda")
igual(longitud(b) % 8, 0, "alineado")
// Arreglos fijos en structs, tablas vacías y otra raíz.
sea e2 = sin_copia_esquema("struct M { v: [float:4]; id: ubyte; } table T { m: M; l: [M]; } table Vacia {} root_type T;")
igual(e2["tipos"]["M"]["tam"], 20, "tamaño con arreglo fijo")
sea t2 = sin_copia_decodificar(e2, sin_copia_codificar(e2, {"m": {"v": [1, 2, 3, 4], "id": 7}, "l": [{"v": [0.5, 0, 0, 0], "id": 1}]}, nulo), nulo)
igual([t2["m"]["v"], t2["l"][0]["v"][0], t2["l"][0]["id"]], [[1, 2, 3, 4], 0.5, 1], "arreglo fijo")
igual(sin_copia_decodificar(e2, sin_copia_codificar(e2, {}, "Vacia"), "Vacia"), {}, "tabla vacía")
mostrar("[OK] sin_copia")
