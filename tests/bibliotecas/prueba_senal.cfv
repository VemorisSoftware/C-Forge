importar "senal"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Contra un hub de ASP.NET Core 8 se probaron: negociación, invocaciones
// (número, texto, objeto), Clients.All, grupos, HubException, método
// inexistente, flujos IAsyncEnumerable con cancelación y dos clientes.
sea RS = caracter(30)
igual(senal_saludo(), json_texto({"protocol": "json", "version": 1}) + RS, "saludo")
igual(longitud(senal_decodificar(senal_codificar({"type": 6}) + senal_codificar({"type": 1, "target": "x"}))), 2, "varios mensajes por bloque")
sea h = senal_hub_memoria({
    "Sumar": funcion(a, ctx) { retornar a[0] + a[1] },
    "Difundir": funcion(a, ctx) { ctx["todos"]("Mensaje", a) },
    "Otros": funcion(a, ctx) { ctx["otros"]("Mensaje", a) },
    "Entrar": funcion(a, ctx) {
        ctx["unir"](a[0])
        ctx["grupo"](a[0], "DelGrupo", [a[0], ctx["id"]])
    },
    "Fallar": funcion(a, ctx) { lanzar "algo salió mal" },
    "Contar": funcion(a, ctx) {
        sea l = []
        sea i = 0
        mientras (i < a[0]) {
            l.agregar(i)
            i = i + 1
        }
        retornar l
    },
    "Preguntar": funcion(a, ctx) { ctx["llamador"]("Pregunta", ["¿?"]) },
    "Echar": funcion(a, ctx) { ctx["cerrar"]("adiós", a[0]) }
})
sea c = senal_conectar("http://x/chat", {"transporte": h["transporte"]})
igual([c["estado"], c["id"]], ["conectado", "con1"], "conectar")
sea rec = []
senal_en(c, "mensaje", funcion(a) { rec.agregar(a) })
igual([senal_invocar(c, "Sumar", [40, 2]), senal_invocar(c, "Difundir", ["a", "b"])], [42, nulo], "invocar")
senal_invocar(c, "Difundir", ["x", "y"])
igual(rec, [["a", "b"], ["x", "y"]], "manejadores sin importar mayúsculas")
sea d = senal_conectar("http://x/chat", {"transporte": h["transporte"]})
senal_enviar(d, "Otros", ["de d"])
igual(senal_esperar(c, "Mensaje"), ["de d"], "otros")
senal_enviar(c, "Entrar", ["g"])
igual(senal_esperar(c, "DelGrupo"), ["g", "con1"], "grupo")
sea errs = []
para m en ["Fallar", "NoExiste"] { intentar { senal_invocar(c, m, []) } capturar (e) { errs.agregar(e) } }
igual(errs, ["senal: An unexpected error occurred invoking 'Fallar' on the server. HubException: algo salió mal", "senal: Failed to invoke 'NoExiste' due to an error on the server. HubException: Method does not exist."], "errores")
igual(senal_flujo(c, "Contar", [4]), [0, 1, 2, 3], "flujo")
igual(senal_flujo_cada(c, "Contar", [10], funcion(x) { retornar x < 1 }), 2, "cancelar flujo")
// El servidor pide un resultado al cliente (client results).
senal_en(c, "Pregunta", funcion(a) { retornar "respuesta" })
senal_enviar(c, "Preguntar", [])
igual(senal_esperar(c, "Pregunta"), ["¿?"], "pregunta")
// Cierre del servidor sin reconexión.
sea eventos = []
senal_al(d, "cerrada", funcion(e) { eventos.agregar(["cerrada", e]) })
sea err = nulo
intentar { senal_invocar(d, "Echar", [falso]) } capturar (e) { err = e }
igual([err, eventos, d["estado"]], ["senal: el servidor cerró la conexión: adiós", [["cerrada", "el servidor cerró la conexión: adiós"]], "desconectado"], "cierre del servidor")
// Reconexión automática: la conexión se cae y vuelve.
sea esperas = []
sea r = senal_conectar("http://x/chat", {"transporte": h["transporte"], "reconectar": verdadero, "dormir": funcion(ms) { esperas.agregar(ms) }})
senal_al(r, "reconectando", funcion(e) { eventos.agregar(["reconectando", e]) })
senal_al(r, "reconectada", funcion(id) { eventos.agregar(["reconectada", id]) })
r["t"]["cerrar"]()
igual(senal_invocar(r, "Sumar", [1, 2]), 3, "invocar tras reconectar")
igual([esperas, eventos[1], eventos[2][0]], [[0], ["reconectando", "senal: conexión cerrada"], "reconectada"], "eventos de reconexión")
// Saludo rechazado.
h["hub"]["rechazar"] = "versión no soportada"
err = nulo
intentar { senal_conectar("http://x/chat", {"transporte": h["transporte"]}) } capturar (e) { err = e }
igual(err, "senal: saludo rechazado: versión no soportada", "saludo rechazado")
mostrar("[OK] senal")
