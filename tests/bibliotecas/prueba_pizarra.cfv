importar "pizarra"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion cerca(a, b, q) { afirmar(abs(a - b) < 0.001, q + ": " + a + " != " + b) }
sea pz = pizarra_nueva(400, 300)
sea eventos = []
para ev en ["agregado", "seleccionado", "moviendo", "escalando", "girando", "modificado"] {
    pizarra_al(pz, ev, funcion(ob) { eventos.agregar(ev + ":" + (ob["nombre"] ?? ob["tipo"])) })
}
sea r = pizarra_agregar(pz, pizarra_rect({"nombre": "caja", "izq": 100, "arriba": 50, "ancho": 80, "alto": 40, "relleno": "#3366cc", "trazo": "#000000", "grosor": 2}))
sea c = pizarra_agregar(pz, pizarra_circulo({"nombre": "bola", "izq": 300, "arriba": 200, "radio": 20, "origen_x": "centro", "origen_y": "centro", "relleno": "#cc3300"}))
// Geometría y detección.
igual([pizarra_caja(r), pizarra_caja(c)], [[100, 50, 180, 90], [280, 180, 320, 220]], "cajas")
igual([pizarra_contiene(r, 101, 51), pizarra_contiene(r, 99.5, 60), pizarra_contiene(r, 98, 60), pizarra_contiene(c, 300, 200), pizarra_contiene(c, 316, 216)], [verdadero, verdadero, falso, verdadero, falso], "contiene (con trazo)")
r["angulo"] = 90
sea e = pizarra_esquinas(r)
cerca(e[1][0], 100, "esquina girada x")
cerca(e[1][1], 130, "esquina girada y")
igual([pizarra_contiene(r, 80, 70), pizarra_contiene(r, 150, 70)], [verdadero, falso], "contiene girado")
r["angulo"] = 0
// Capas: lo de arriba gana.
sea t = pizarra_agregar(pz, pizarra_rect({"nombre": "tapa", "izq": 150, "arriba": 60, "ancho": 50, "alto": 50, "relleno": "#00aa00"}))
igual(pizarra_objeto_en(pz, 160, 70)["nombre"], "tapa", "arriba gana")
pizarra_al_fondo(pz, t)
igual(pizarra_objeto_en(pz, 160, 70)["nombre"], "caja", "al fondo")
// Arrastrar.
eventos = []
pizarra_raton(pz, "bajar", 110, 60, nulo)
pizarra_raton(pz, "mover", 130, 90, nulo)
pizarra_raton(pz, "subir", 130, 90, nulo)
igual([r["izq"], r["arriba"], eventos], [120, 80, ["seleccionado:caja", "moviendo:caja", "modificado:caja"]], "arrastrar")
// Escalar desde la esquina inferior derecha: la superior izquierda queda fija.
sea m = pizarra_manijas(r)
pizarra_raton(pz, "bajar", m["bd"][0], m["bd"][1], nulo)
pizarra_raton(pz, "mover", 280, 160, nulo)
pizarra_raton(pz, "subir", 280, 160, nulo)
igual([r["izq"], r["arriba"], r["escala_x"], r["escala_y"]], [120, 80, 2, 2], "escalar")
// Girar 90° alrededor del centro con la manija de giro.
sea cen = [200, 120]
m = pizarra_manijas(r)
pizarra_raton(pz, "bajar", m["giro"][0], m["giro"][1], nulo)
pizarra_raton(pz, "mover", cen[0] + 100, cen[1], {"ajuste": 15})
pizarra_raton(pz, "subir", cen[0] + 100, cen[1], nulo)
igual(r["angulo"], 90, "girar")
sea caja2 = pizarra_caja(r)
cerca((caja2[0] + caja2[2]) / 2, 200, "centro fijo x")
cerca((caja2[1] + caja2[3]) / 2, 120, "centro fijo y")
// Deshacer y rehacer.
pizarra_deshacer(pz)
igual(pizarra_obtener(pz, "caja")["angulo"], 0, "deshacer")
pizarra_rehacer(pz)
igual(pizarra_obtener(pz, "caja")["angulo"], 90, "rehacer")
// Grupo, polígono, línea y texto.
sea g = pizarra_grupo([pizarra_rect({"izq": 10, "arriba": 10, "ancho": 10, "alto": 10}), pizarra_rect({"izq": 30, "arriba": 10, "ancho": 10, "alto": 10})], {"nombre": "grupo"})
pizarra_agregar(pz, g)
igual([g["izq"], g["ancho"], pizarra_contiene(g, 15, 15), pizarra_contiene(g, 25, 15)], [10, 30, verdadero, falso], "grupo")
sea tri = pizarra_agregar(pz, pizarra_poligono([[0, 250], [50, 250], [25, 290]], {"nombre": "tri"}))
igual([pizarra_contiene(tri, 25, 260), pizarra_contiene(tri, 2, 288)], [verdadero, falso], "polígono")
sea l = pizarra_agregar(pz, pizarra_linea(300, 10, 390, 40, {"grosor": 4}))
igual([pizarra_contiene(l, 345, 25), pizarra_contiene(l, 345, 40)], [verdadero, falso], "línea")
pizarra_agregar(pz, pizarra_texto("Hola", {"izq": 200, "arriba": 250, "tam": 20}))
// JSON de ida y vuelta.
sea j = pizarra_a_json(pz)
sea pz2 = pizarra_desde_json(j)
igual([longitud(pz2["objetos"]), pizarra_obtener(pz2, "caja")["escala_x"], pizarra_a_json(pz2) == j], [7, 2, verdadero], "JSON")
// Exportar.
sea svg = pizarra_exportar(pz, "svg", verdadero)
igual([contiene(svg, "<svg"), contiene(svg, ">Hola</text>"), contiene(svg, "#3366cc")], [verdadero, verdadero, verdadero], "SVG")
sea png = pizarra_exportar(pz, "png", falso)
igual(subcadena(png, 1, 4), "PNG", "PNG")
mostrar("[OK] pizarra")
