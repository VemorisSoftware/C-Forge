importar "gramatica"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea num = gramatica_numero()
sea expr = gramatica_recursivo(funcion(e) {
    sea atomo = gramatica_alternativa([num, gramatica_entre(gramatica_simbolo("("), e, gramatica_simbolo(")"))])
    retornar gramatica_operadores(atomo, [[["+", funcion(a, b) { retornar a + b }], ["-", funcion(a, b) { retornar a - b }]], [["*", funcion(a, b) { retornar a * b }], ["/", funcion(a, b) { retornar a / b }]]])
})
igual([gramatica_analizar(expr, "1 + 2 * 3"), gramatica_analizar(expr, "(1 + 2) * 3 - 4 / 2"), gramatica_analizar(expr, " 2.5e1 "), gramatica_analizar(expr, "10 - 3 - 2")], [7, 7, 25, 5], "calculadora con precedencia y asociatividad")
sea m = ""
intentar { gramatica_analizar(expr, "1 + \n 2 * ) 3") } capturar (x) { m = x }
igual(m, "gramatica: línea 2, columna 6: se esperaba un número o \"(\" y hay \") 3\"", "error con posición")
intentar { gramatica_analizar(expr, "1 2") } capturar (x) { m = x }
igual(m, "gramatica: línea 1, columna 3: se esperaba fin del texto y hay \"2\"", "basura al final")
sea valor = gramatica_recursivo(funcion(v) {
    sea par = gramatica_mapear(gramatica_secuencia([gramatica_cadena(), gramatica_simbolo(":"), v]), funcion(x) { retornar [x[0], x[2]] })
    sea objeto = gramatica_mapear(gramatica_entre(gramatica_simbolo(caracter(123)), gramatica_separados(par, gramatica_simbolo(","), 0), gramatica_simbolo(caracter(125))), funcion(pares) {
        sea o = {}
        para p en pares { o[p[0]] = p[1] }
        retornar o
    })
    sea lista = gramatica_entre(gramatica_simbolo("["), gramatica_separados(v, gramatica_simbolo(","), 0), gramatica_simbolo("]"))
    sea constante = gramatica_mapear(gramatica_alternativa([gramatica_simbolo("true"), gramatica_simbolo("false"), gramatica_simbolo("null")]), funcion(t) {
        si (t == "true") { retornar verdadero }
        si (t == "false") { retornar falso }
        retornar nulo
    })
    retornar gramatica_alternativa([objeto, lista, gramatica_cadena(), num, constante])
})
igual(gramatica_analizar(valor, "{\"a\": [1, 2.5, \"x\\\"y\"], \"b\": {\"c\": true, \"d\": null}}"), {"a": [1, 2.5, "x\"y"], "b": {"c": verdadero, "d": nulo}}, "mini JSON")
igual(gramatica_analizar(gramatica_muchos(gramatica_identificador(), 1), "uno dos_2 tres"), ["uno", "dos_2", "tres"], "muchos")
igual(gramatica_analizar(gramatica_secuencia([gramatica_simbolo("a"), gramatica_opcional(gramatica_simbolo("b"), "-"), gramatica_simbolo("c")]), "a c"), ["a", "-", "c"], "opcional")
intentar { gramatica_analizar(gramatica_muchos(gramatica_simbolo("x"), 1), "y") } capturar (x) { m = x }
igual(m, "gramatica: línea 1, columna 1: se esperaba \"x\" y hay \"y\"", "muchos con mínimo")
mostrar("[OK] gramatica")
