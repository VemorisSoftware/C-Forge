importar "correo_rapido"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Contra nats-server 2.10.22 se probaron pub/sub con comodines, HPUB con
// cabeceras, grupos de cola y el 503 sin respondedores. Aquí, en memoria.
igual([correo_coincide("a.*", "a.b"), correo_coincide("a.*", "a.b.c"), correo_coincide("a.>", "a.b.c"), correo_coincide("a.>", "a"), correo_coincide("*.b", "x.b")], [verdadero, falso, verdadero, falso, verdadero], "comodines")
igual(correo_pub("x", "hola", nulo, nulo), "PUB x 4\r\nhola\r\n", "PUB")
igual(correo_pub("x", "hi", "r", {"A": "1"}), "HPUB x r 18 20\r\nNATS/1.0\r\nA: 1\r\n\r\nhi\r\n", "HPUB")
sea h = correo_leer_cabeceras("NATS/1.0 503\r\nA: 1\r\nA: 2\r\nB: x\r\n\r\n")
igual([h["estado"], h["cabeceras"]["A"], h["cabeceras"]["B"]], [503, [1, 2], "x"], "leer cabeceras")
igual(correo_leer_cabeceras(correo_cabeceras({"K": "v"}, nulo))["cabeceras"]["K"], "v", "ida y vuelta")
sea srv = correo_memoria(nulo)
sea a = correo_conectar(nulo, {"transporte": srv["transporte"]()})
sea b = correo_conectar(nulo, {"transporte": srv["transporte"]()})
igual(a["info"]["server_id"], "MEMORIA", "INFO")
correo_suscribir(b, "pedidos.*", nulo)
correo_publicar(a, "pedidos.nuevo", "id=1", nulo, nulo)
correo_publicar(a, "pedidos.nuevo.x", "no", nulo, nulo)
correo_publicar(a, "pedidos.otro", "id=2", {"Prioridad": "alta"}, nulo)
sea m1 = correo_siguiente(b)
sea m2 = correo_siguiente(b)
igual([m1["asunto"], m1["datos"], m2["datos"], m2["cabeceras"]["Prioridad"]], ["pedidos.nuevo", "id=1", "id=2", "alta"], "pub/sub")
// Grupo de cola: se reparte entre dos suscriptores.
sea c = correo_conectar(nulo, {"transporte": srv["transporte"]()})
correo_suscribir(b, "tareas", {"cola": "q"})
correo_suscribir(c, "tareas", {"cola": "q"})
correo_publicar(a, "tareas", "1", nulo, nulo)
correo_publicar(a, "tareas", "2", nulo, nulo)
igual([correo_siguiente(b)["datos"], correo_siguiente(c)["datos"]], ["1", "2"], "cola")
// Petición/respuesta: c responde.
correo_suscribir(c, "eco", nulo)
correo_publicar(a, "eco", "hola", nulo, "_INBOX.x.1")
sea p = correo_siguiente(c)
igual(p["responder"], "_INBOX.x.1", "responder")
sea err = ""
intentar { correo_pedir(a, "nadie", "x", nulo) } capturar (e) { err = "" + e }
igual(err, "nats: nadie responde en nadie", "503")
// Máximo: UNSUB automático.
sea d = correo_conectar(nulo, {"transporte": srv["transporte"]()})
correo_suscribir(d, "uno", {"maximo": 1})
correo_publicar(a, "uno", "a", nulo, nulo)
correo_publicar(a, "uno", "b", nulo, nulo)
correo_publicar(a, "fin", "", nulo, nulo)
igual(correo_siguiente(d)["datos"], "a", "maximo")
igual(longitud(claves(d["subs"])), 0, "baja automática")
// Autenticación.
sea s2 = correo_memoria({"usuario": "ana", "clave": "s3"})
sea ok = correo_conectar("nats://ana:s3@x:1", {"transporte": s2["transporte"]()})
igual(ok["abierta"], verdadero, "auth ok")
err = ""
intentar { correo_conectar("nats://ana:mal@x:1", {"transporte": s2["transporte"]()}) } capturar (e) { err = "" + e }
igual(err, "nats: Authorization Violation", "auth mal")
correo_cerrar(a)
mostrar("[OK] correo_rapido")
