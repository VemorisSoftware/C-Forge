// Lote 35 en inglés: unicorn, libssh2 y duckdb.
importar "unicorn"
importar "libssh2"
importar "duckdb"
importar "capstone"

sea uc = uc_open("x86_64")
uc_mem_map(uc, 4096, 4096)
sea codigo = ks_asm("mov rax, 6\nimul rax, rax, 7", "x86_64", 4096)
uc_mem_write(uc, 4096, codigo)
afirmar(uc_emu_start(uc, 4096, 4096 + longitud(codigo), 0)["reason"] == "fin", "uc_emu_start")
afirmar(uc_reg_read(uc, "rax") == 42 y uc_reg_read_hex(uc, "rax") == "0x2a", "uc_reg_read")

sea k = ssh_generate_key("yo", bytes_de_hex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"))
afirmar(texto_empieza_con(k["public"], "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAOhB7/z"), "ssh_generate_key")
afirmar(ssh_load_key(k["private"])["comment"] == "yo", "ssh_load_key")

sea db = duckdb_connect()
duckdb_execute(db, "CREATE TABLE t AS SELECT * FROM range(10)")
sea r = duckdb_query(db, "SELECT sum(range) AS s FROM t", nulo)
afirmar(r["columns"] == ["s"] y r["rows"] == [[45]], "duckdb_query")
afirmar(texto_reemplazar(duckdb_to_csv(r), "\r", "") == "s\n45\n", "duckdb_to_csv")
afirmar(duckdb_fetchone(db, "SELECT count(*) FROM t WHERE range > ?", [6]) == 3, "duckdb_fetchone")
mostrar("[OK] en_lote35")
