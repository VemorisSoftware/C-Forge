importar "marea"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Tareas, límite de tiempo y carreras.
sea h = marea_lanzar(funcion() { retornar 6 * 7 })
igual(marea_esperar(h, 2000), 42, "esperar")
sea lenta = marea_lanzar(funcion() {
    hilo_dormir(300)
    retornar "tarde"
})
sea err = nulo
intentar { marea_esperar(lenta, 20) } capturar (e) { err = e }
igual([err, marea_termino(lenta)], ["marea: tiempo agotado", falso], "tiempo agotado")
igual(marea_esperar(lenta, nulo), "tarde", "luego termina")
igual(marea_con_limite(funcion() {
    hilo_dormir(200)
    retornar 1
}, 10)["ok"], falso, "con límite")
sea r = marea_carrera([marea_lanzar(funcion() {
    hilo_dormir(200)
    retornar "lenta"
}), marea_lanzar(funcion() { retornar "rápida" })], 2000)
igual(r, [1, "rápida"], "carrera")
igual(marea_unir_todas([marea_lanzar(funcion() { retornar 1 }), marea_lanzar(funcion() { retornar 2 })]), [1, 2], "unir todas")
err = nulo
intentar { marea_unir_todas([marea_lanzar(funcion() { lanzar "boom" })]) } capturar (e) { err = e }
igual(err, "boom", "error de una tarea")
// Conjunto: se recogen en orden de término.
sea cj = marea_conjunto()
marea_conjunto_lanzar(cj, funcion() {
    hilo_dormir(120)
    retornar "a"
})
marea_conjunto_lanzar(cj, funcion() { retornar "b" })
marea_conjunto_lanzar(cj, funcion() { lanzar "c falló" })
sea vistos = []
sea s = marea_conjunto_siguiente(cj, 3000)
mientras (s != nulo) {
    si (s["error"] != nulo) { vistos.agregar("error " + s["id"]) } sino { vistos.agregar(s["valor"]) }
    s = marea_conjunto_siguiente(cj, 3000)
}
igual([longitud(vistos), vistos[longitud(vistos) - 1]], [3, "a"], "conjunto")
// Canales: productor y consumidor, límite y selección.
sea c = marea_canal(4)
sea prod = marea_lanzar(funcion() {
    sea i = 0
    mientras (i < 20) {
        marea_enviar(c, i)
        i = i + 1
    }
    marea_cerrar(c)
    retornar i
})
sea suma = 0
sea fin = falso
mientras (fin == falso) {
    intentar { suma = suma + marea_recibir(c, 2000) } capturar (e) {
        igual(e, "marea: canal cerrado", "cierre")
        fin = verdadero
    }
}
igual([suma, marea_esperar(prod, 1000)], [190, 20], "productor y consumidor")
sea vacio = marea_canal(0)
err = nulo
intentar { marea_recibir(vacio, 15) } capturar (e) { err = e }
igual(err, "marea: tiempo agotado", "recibir con límite")
sea c1 = marea_canal(0)
sea c2 = marea_canal(0)
marea_lanzar(funcion() {
    hilo_dormir(30)
    marea_enviar(c2, "por el 2")
})
igual(marea_seleccionar([c1, c2], 2000), [1, "por el 2"], "seleccionar")
// Difusión y vigía.
sea d = marea_difusion()
sea s1 = marea_suscribir(d)
sea s2 = marea_suscribir(d)
igual(marea_difundir(d, "a todos"), 2, "difundir")
igual([marea_recibir(s1, 100), marea_recibir(s2, 100)], ["a todos", "a todos"], "suscriptores")
sea w = marea_vigia("inicio")
marea_lanzar(funcion() {
    hilo_dormir(20)
    marea_vigia_poner(w, "cambió")
})
igual(marea_vigia_esperar(w, 0, 2000), [1, "cambió"], "vigía")
// Semáforo: nunca más de 2 a la vez.
sea sem = marea_semaforo(2)
sea dentro = marea_contador(0)
sea maximo_visto = marea_contador(0)
sea mx = mutex_crear()
sea hs = []
sea i = 0
mientras (i < 6) {
    hs.agregar(marea_lanzar(funcion() {
        retornar marea_con_permiso(sem, funcion() {
            sea n = marea_sumar(dentro, 1)
            marea_con_mutex(mx, funcion() { si (n > marea_valor(maximo_visto)) { marea_sumar(maximo_visto, n - marea_valor(maximo_visto)) } })
            hilo_dormir(15)
            marea_sumar(dentro, -1)
            retornar n
        })
    }))
    i = i + 1
}
marea_unir_todas(hs)
igual([marea_valor(maximo_visto) <= 2, marea_disponibles(sem)], [verdadero, 2], "semáforo")
// Barrera de 3.
sea b = marea_barrera(3)
sea ultimos = marea_contador(0)
sea bh = []
i = 0
mientras (i < 3) {
    bh.agregar(marea_lanzar(funcion() { si (marea_barrera_esperar(b)) { marea_sumar(ultimos, 1) } }))
    i = i + 1
}
marea_unir_todas(bh)
igual(marea_valor(ultimos), 1, "barrera")
// Intervalo con cancelación.
sea ficha = marea_ficha()
sea ticks = marea_contador(0)
sea iv = marea_intervalo(10, funcion(k) { marea_sumar(ticks, 1) }, nulo, ficha)
hilo_dormir(80)
marea_cancelar(ficha, nulo)
sea vueltas = marea_esperar(iv, 2000)
igual([vueltas >= 3, vueltas == marea_valor(ticks)], [verdadero, verdadero], "intervalo")
igual(marea_dormir(1000, ficha), falso, "dormir cancelable")
mostrar("[OK] marea")
