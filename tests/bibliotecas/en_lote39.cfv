// Lote 39 en inglés: tesseract, whispercpp y portaudio.
importar "tesseract"
importar "whispercpp"
importar "portaudio"
importar "json"

sea m = tess_model(fuente_cargar("tests/graficos/datos/DejaVuSans-latin.ttf"), {"alphabet": "HolaMund"})
afirmar(tess_image_to_string(imagen_cargar("tests/bibliotecas/datos/lector/titulo40.png"), m) != "", "tess_image_to_string")
sea d = tess_image_to_data(imagen_cargar("tests/bibliotecas/datos/lector/titulo40.png"), tess_model(fuente_cargar("tests/graficos/datos/DejaVuSans-latin.ttf"), nulo))
afirmar(d[0]["text"] == "Hola" y longitud(d[0]["box"]) == 4 y d[1]["line"] == 0, "tess_image_to_data")

sea e = json_parsear(leer_archivo("tests/bibliotecas/datos/oido/esperado.json"))
sea w = whisper_init_from_file("tests/bibliotecas/datos/oido/mini.bin")
afirmar(whisper_model_info(w)["multilingual"], "whisper_model_info")
sea r = whisper_full(w, whisper_pcm_from_wav(leer_archivo("tests/bibliotecas/datos/oido/tono.wav")), {"language": "es", "max_tokens": 3})
afirmar(r["tokens"] == [e["tokens"][0], e["tokens"][1], e["tokens"][2]] y r["language"] == "es", "whisper_full")

pa_initialize()
sea vistos = []
sea s = pa_open_stream({"input": {"device": "Bucle", "channels": 1}, "output": {"device": "Bucle", "channels": 1}, "sample_rate": 1000, "frames_per_buffer": 2,
    "callback": funcion(entrada, cuadros, info) {
        vistos.agregar(entrada)
        retornar {"output": [0.5, 0.25], "status": si(longitud(vistos) == 2, "complete", "continue")}
    }})
pa_start_stream(s)
pa_process_stream(s, 1)
afirmar(vistos == [[0, 0], [0.5, 0.25]] y pa_is_stream_stopped(s), "pa_open_stream")
afirmar(pa_get_stream_info(s)["sample_rate"] == 1000, "pa_get_stream_info")
pa_close_stream(s)
pa_terminate()
mostrar("[OK] en_lote39")
