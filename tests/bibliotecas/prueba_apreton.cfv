importar "apreton"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Mensajes esperados generados con la biblioteca noiseprotocol de Python.
sea esp = {"NN": {"msgs": ["13be4feaeaf204c7fd3358fc9c00721881d174278128227ec674f37f7fe97b6d756e6f", "57db4b359f23ae5e146e4e2512056704722506348c150c14753d0c933d04d421b6c1fd20ce2780ff8cc554e2f91b81e7f69647"], "t": "166424a122cd8750183b3ddff7f9362e99567a97526908606c8907350be480", "h": "14fbfc37df5dc46ae5bcf3f5d4b0b58f95bf4a65fdfb7122d3c166b694dfd154"}, "XX": {"msgs": ["13be4feaeaf204c7fd3358fc9c00721881d174278128227ec674f37f7fe97b6d756e6f", "57db4b359f23ae5e146e4e2512056704722506348c150c14753d0c933d04d4216cfabedefbbecfb65ac0bfbab8f649d0f631f43e7f83e98ef8ee0b267ad589f6af76380a735f5a1e772499980246ccf2ce39ce8657f6c632f19aed29cd0f07ac36ef1e", "785f2435feb75934bf39c1c31ea2a20a01498c69b35440c431daa35bb1e13b7eabec3e6b35ebaa5dad9e43fa0a850ff3925016c88bb1eaf1078466f3e0b3cae283408ab9"], "t": "c4a4438f84f021241f0d9b19b138653f55a83f238004bb0074318858732083", "h": "79151ad6a552f043d2fc3aadda66d2523f48d416d2659308fa759a6f6fff04ac"}, "IK": {"msgs": ["13be4feaeaf204c7fd3358fc9c00721881d174278128227ec674f37f7fe97b6d3eba7c6b6ed4cde18849f011da3a5e69e8a2d6c662004bcfd4882a169d775124416735bb4cb358fef12defd156c72ec60121c57a437d2d72f73338c3bb6c714e5e74b6", "57db4b359f23ae5e146e4e2512056704722506348c150c14753d0c933d04d4213dd40c1858a636e14d5dda8188a91164d1fb46"], "t": "b3aae25da30b32f96b1433c747a96eb1de3142b5241916e0d99fb51cf6183f", "h": "9700c9521248fb4c9db34b78cca7e14e1fbc85f88389a64ef7230743ef73f15c"}, "KK": {"msgs": ["13be4feaeaf204c7fd3358fc9c00721881d174278128227ec674f37f7fe97b6d040762697cea72a59fef7f2f086777e7533a34", "57db4b359f23ae5e146e4e2512056704722506348c150c14753d0c933d04d42110723b13f9841aec38bfc73ea53cf4a59181c9"], "t": "5b8308e5f6c72bd79c59da16c51be7d28626502a54e596525c8190bc22d254", "h": "21962c9e7b909982116a9361b443be22ecf35f1dfd3d4d74ab285d7e9497b049"}, "XXb": {"msgs": ["13be4feaeaf204c7fd3358fc9c00721881d174278128227ec674f37f7fe97b6d756e6f", "57db4b359f23ae5e146e4e2512056704722506348c150c14753d0c933d04d42197da1ac92100b2b3cc0262b16a53fede6d120b8cf5cc0e5a5c2aae55c90755f5231d4d2ee611b3c3cb7301eb2bb032620e0998f7bb6855c176452be9a71369f5483cf7", "90fb3c4620bccdb3153f45e317db5d25ef6a4da67b650a979bcb86595f67b7f8f5bea259d31ec2d8a4d6b94d016fb3f1eefbaf2ac9c295344e57a3289fa29d69cdf20f9e"], "t": "331222068da1296ac7156b1e1b34c17d9fb4b04c4718f226a87d6d750f23c9", "h": "13c44284b61dbe71487dac8588da5495c8c4782ebe8b2f05875b24fabaaf73604a3002bdcd1cd12319ee4aba1b9abf747bc94303155e556a2e40967e02becb07"}}
sea si_ = bytes_de_hex("0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20")
sea sr = bytes_de_hex("2122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f40")
sea ei = bytes_de_hex("0707070707070707070707070707070707070707070707070707070707070707")
sea er = bytes_de_hex("0909090909090909090909090909090909090909090909090909090909090909")
para caso en [["NN", "NN", "SHA256"], ["XX", "XX", "SHA256"], ["IK", "IK", "SHA256"], ["KK", "KK", "SHA256"], ["XXb", "XX", "BLAKE2b"]] {
    sea A = apreton_nuevo(caso[1], verdadero, {"estatica": apreton_claves(si_), "remota": x25519_base(sr), "prologo": "pro", "efimera": ei, "hash": caso[2]})
    sea B = apreton_nuevo(caso[1], falso, {"estatica": apreton_claves(sr), "remota": x25519_base(si_), "prologo": "pro", "efimera": er, "hash": caso[2]})
    sea cargas = ["uno", "dos", "tres"]
    sea k = 0
    mientras (apreton_listo(A) == falso) {
        sea m = ""
        si (k % 2 == 0) {
            m = apreton_escribir(A, cargas[k])
            igual(apreton_leer(B, m), cargas[k], caso[0] + " carga " + k)
        } sino {
            m = apreton_escribir(B, cargas[k])
            igual(apreton_leer(A, m), cargas[k], caso[0] + " carga " + k)
        }
        igual(hex_de_bytes(m), esp[caso[0]]["msgs"][k], caso[0] + " mensaje " + k)
        k = k + 1
    }
    igual(apreton_listo(B), verdadero, caso[0] + " ambos terminan")
    igual(hex_de_bytes(apreton_hash(A)), esp[caso[0]]["h"], caso[0] + " hash del canal")
    sea ta = apreton_transporte(A)
    sea tb = apreton_transporte(B)
    sea c = apreton_cifrar(ta, "hola transporte")
    igual(hex_de_bytes(c), esp[caso[0]]["t"], caso[0] + " transporte")
    igual(apreton_descifrar(tb, c), "hola transporte", caso[0] + " descifrar")
    igual(apreton_descifrar(ta, apreton_cifrar(tb, "vuelta")), "vuelta", caso[0] + " al revés")
}
// XX revela la estática del iniciador al respondedor.
sea A = apreton_nuevo("Noise_XX_25519_ChaChaPoly_SHA256", verdadero, {"estatica": apreton_claves(si_)})
sea B = apreton_nuevo("XX", falso, {"estatica": apreton_claves(sr)})
apreton_leer(B, apreton_escribir(A, ""))
apreton_leer(A, apreton_escribir(B, ""))
apreton_leer(B, apreton_escribir(A, ""))
igual(hex_de_bytes(apreton_remota(B)), hex_de_bytes(x25519_base(si_)), "estática remota")
sea ta = apreton_transporte(A)
sea tb = apreton_transporte(B)
sea c1 = apreton_cifrar(ta, "uno")
sea c2 = apreton_cifrar(ta, "dos")
sea m = ""
intentar { apreton_descifrar(tb, c2) } capturar (e) { m = e }
igual(m, "apreton: mensaje alterado o fuera de orden", "orden de nonces")
apreton_rekey(ta, "enviar")
apreton_rekey(tb, "recibir")
intentar { apreton_escribir(A, "x") } capturar (e) { m = e }
igual(m, "apreton: el apretón ya terminó; usa apreton_transporte", "no escribe tras terminar")
intentar { apreton_nuevo("ZZ", verdadero) } capturar (e) { m = e }
igual(m, "apreton: patrón desconocido ZZ", "patrón desconocido")
mostrar("[OK] apreton")
