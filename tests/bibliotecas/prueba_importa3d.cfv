importar "importa3d"
importar "archivador"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion cerca(a, b, q) { afirmar(abs(a - b) < 0.0001, q + ": " + a + " != " + b) }
// Contra trimesh 5.2: una icosfera y una caja exportadas por trimesh en STL
// (binario y ASCII), PLY (binario y ASCII), OFF, OBJ, GLB y 3MF dan los
// mismos vértices, triángulos, área, volumen y cierre; y lo que exporta
// importa3d (STL, PLY, OBJ, OFF) trimesh lo lee igual.
funcion cubo_simple(t) {
    sea c = malla_cubo(t)
    c["uvs"] = []
    c["normales"] = []
    c["colores"] = []
    retornar importa3d_unir(c, 0)
}
sea cubo = cubo_simple(2)
sea med = importa3d_medidas(cubo)
igual([med["vertices"], med["triangulos"], med["cerrada"]], [8, 12, verdadero], "cubo unido")
cerca(med["area"], 24, "área")
cerca(abs(med["volumen"]), 8, "volumen")
// Ida y vuelta por todos los formatos.
para f en ["stl", "stl_ascii", "ply", "ply_ascii", "obj", "off"] {
    sea datos = importa3d_exportar(cubo, f, nulo)
    sea m = importa3d_desde(datos, {"unir": verdadero})
    sea md = importa3d_medidas(m)
    igual([m["formato"], md["vertices"], md["triangulos"], md["cerrada"]], [texto_dividir(f, "_")[0], 8, 12, verdadero], "ida y vuelta " + f)
    cerca(md["volumen"], med["volumen"], "volumen " + f)
}
// PLY ASCII con colores y cuadriláteros (se triangulan).
sea ply = "ply\nformat ascii 1.0\nelement vertex 4\nproperty float x\nproperty float y\nproperty float z\nproperty uchar red\nproperty uchar green\nproperty uchar blue\nelement face 1\nproperty list uchar int vertex_indices\nend_header\n0 0 0 255 0 0\n1 0 0 0 255 0\n1 1 0 0 0 255\n0 1 0 255 255 255\n4 0 1 2 3\n"
sea mp = importa3d_desde(ply, nulo)
igual([mp["indices"], subcadena("" + mp["colores"], 0, 12)], [[0, 1, 2, 0, 2, 3], "[1, 0, 0, 1,"], "PLY con colores")
// PLY binario big endian.
funcion f32be(v) {
    si (v == 0) { retornar bytes_entero(0, 4, 0) }
    retornar bytes_entero(1065353216, 4, 0)
}
sea plyb = "ply\nformat binary_big_endian 1.0\nelement vertex 3\nproperty float x\nproperty float y\nproperty float z\nelement face 1\nproperty list uchar ushort vertex_indices\nend_header\n" + f32be(0) + f32be(0) + f32be(0) + f32be(1) + f32be(0) + f32be(0) + f32be(0) + f32be(1) + f32be(0) + caracter(3) + bytes_entero(0, 2, 0) + bytes_entero(1, 2, 0) + bytes_entero(2, 2, 0)
sea mb = importa3d_desde(plyb, nulo)
igual([mb["posiciones"], mb["indices"]], [[0, 0, 0, 1, 0, 0, 0, 1, 0], [0, 1, 2]], "PLY big endian")
// OFF con comentarios y un cuadrado.
sea off = importa3d_desde("OFF # comentario\n4 1 0\n0 0 0\n2 0 0\n2 2 0\n0 2 0\n4 0 1 2 3\n", nulo)
cerca(importa3d_medidas(off)["area"], 4, "OFF")
// 3MF armado en memoria.
sea Q = caracter(34)
sea xml = "<?xml version=" + Q + "1.0" + Q + "?><model><resources><object id=" + Q + "1" + Q + "><mesh><vertices><vertex x=" + Q + "0" + Q + " y=" + Q + "0" + Q + " z=" + Q + "0" + Q + "/><vertex x=" + Q + "1" + Q + " y=" + Q + "0" + Q + " z=" + Q + "0" + Q + "/><vertex x=" + Q + "0" + Q + " y=" + Q + "1" + Q + " z=" + Q + "0" + Q + "/></vertices><triangles><triangle v1=" + Q + "0" + Q + " v2=" + Q + "1" + Q + " v3=" + Q + "2" + Q + "/></triangles></mesh></object></resources></model>"
sea m3 = importa3d_desde(archivador_zip([{"nombre": "3D/3dmodel.model", "datos": xml}], verdadero), nulo)
igual([m3["formato"], m3["indices"]], ["3mf", [0, 1, 2]], "3MF")
// Procesos: limpiar, invertir, normales y normalizar.
sea d = malla_nueva()
d["colores"] = []
d["posiciones"] = [0, 0, 0, 1, 0, 0, 0, 1, 0, 2, 0, 0]
d["indices"] = [0, 1, 2, 0, 1, 3]
igual(importa3d_limpiar(d)["indices"], [0, 1, 2], "degenerados")
importa3d_invertir(d)
igual(d["indices"], [0, 2, 1], "invertir")
sea pl = importa3d_normales_planas(d)
igual(subcadena("" + pl["normales"], 0, 9), "[0, 0, -1", "normales planas")
sea c2 = cubo_simple(2)
importa3d_normalizar(c2, verdadero, 10)
igual(importa3d_medidas(c2)["tamano"], [10, 10, 10], "normalizar")
igual([importa3d_formato("solid x\nfacet normal", nulo), importa3d_formato("x", "a.PLY"), importa3d_formato("v 1 2 3", nulo)], ["stl", "ply", "obj"], "detectar")
mostrar("[OK] importa3d")
