importar "vector"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// La misma escena (degradados lineal y radial, rectángulo redondeado
// rotado con transparencia, trazos con inglete, extremos redondos y
// guiones, recorte y un camino SVG) se dibujó en PNG, SVG y PDF; las dos
// últimas se rasterizaron con rsvg-convert y pdftoppm y difieren de la PNG
// propia en menos de 1/255 de media. El texto se comparó con pdftotext.
igual([vector_rgba("#f00"), vector_rgba("#00ff0080"), vector_rgba([1, 0, 0])], [[1, 0, 0, 1], [0, 1, 0, 128 / 255], [1, 0, 0, 1]], "colores")
// SVG.
sea s = vector_nuevo("svg", 100, 50, nulo)
vector_rectangulo(s, 10, 10, 30, 20)
vector_color(s, "#3366cc")
vector_rellenar(s)
vector_trasladar(s, 50, 0)
vector_mover(s, 0, 0)
vector_linea(s, 10, 10)
vector_grosor(s, 2)
vector_guiones(s, [3, 1], 0)
vector_trazar(s)
sea svg = vector_terminar(s)
igual(contiene(svg, "<path d=" + caracter(34) + "M10 10L40 10L40 30L10 30Z" + caracter(34) + " fill=" + caracter(34) + "#3366cc" + caracter(34) + "/>"), verdadero, "svg relleno")
igual(contiene(svg, "M50 0L60 10"), verdadero, "svg transformado")
igual(contiene(svg, "stroke-dasharray=" + caracter(34) + "3 1" + caracter(34)), verdadero, "svg guiones")
// Caminos SVG relativos y arcos como curvas.
sea p = vector_nuevo("svg", 10, 10, nulo)
vector_camino_svg(p, "m1 1 h3 v3 h-3 z M5,5 q2 0 2 2 t2 2")
igual(vector_camino_d(p), "M1 1L4 1L4 4L1 4ZM5 5C6.333 5 7 5.667 7 7C7 8.333 7.667 9 9 9", "camino svg")
vector_nuevo_camino(p)
vector_arco(p, 0, 0, 10, 0, 3.141592653589793 / 2, falso)
igual(vector_camino_d(p), "M10 0C10 5.523 5.523 10 0 10", "arco")
// PDF: estructura e índice de objetos válidos.
sea d = vector_nuevo("pdf", 100, 100, nulo)
vector_rectangulo(d, 0, 0, 50, 50)
vector_degradado_lineal(d, 0, 0, 50, 0, [[0, "#ff0000"], [0.5, "#00ff00"], [1, "#0000ff"]])
vector_rellenar(d)
vector_color(d, [0, 0, 0, 0.5])
vector_texto(d, 10, 80, "Año (1)", nulo)
vector_pagina(d)
vector_circulo(d, 50, 50, 20)
vector_rellenar(d)
sea pdf = vector_terminar(d)
sea sx = texto_indice(pdf, "startxref\n")
sea ofs = a_numero(texto_dividir(subcadena(pdf, sx + 10, longitud(pdf)), "\n")[0])
igual(subcadena(pdf, ofs, ofs + 4), "xref", "startxref")
igual([contiene(pdf, "/Count 2"), contiene(pdf, "/ShadingType 2"), contiene(pdf, "/FunctionType 3"), contiene(pdf, "/ca 0.5"), contiene(pdf, "(A" + bytes_entero(241, 1, 0) + "o \\(1\\)) Tj")], [verdadero, verdadero, verdadero, verdadero, verdadero], "pdf contenido")
// Cada objeto empieza donde dice el xref.
sea filas = texto_dividir(subcadena(pdf, ofs, longitud(pdf)), "\n")
sea ok = verdadero
sea k = 3
mientras (k < 3 + 5) {
    sea o = a_numero(subcadena(filas[k], 0, 10))
    si (subcadena(pdf, o, o + longitud("" + (k - 2) + " 0 obj")) != (k - 2) + " 0 obj") { ok = falso }
    k = k + 1
}
igual(ok, verdadero, "xref")
// PNG: píxeles.
funcion px(c, x, y) { retornar imagen_pixel(vector_lienzo(c), x, y) }
sea g = vector_nuevo("png", 60, 40, {"fondo": "#ffffff"})
vector_rectangulo(g, 0, 0, 40, 10)
vector_degradado_lineal(g, 0, 0, 40, 0, [[0, "#000000"], [1, "#ffffff"]])
vector_rellenar(g)
igual([px(g, 0, 5)[0] < 10, abs(px(g, 20, 5)[0] - 130) < 6, px(g, 39, 5)[0] > 245], [verdadero, verdadero, verdadero], "degradado lineal")
vector_mover(g, 5, 25)
vector_linea(g, 35, 25)
vector_color(g, "#ff0000")
vector_grosor(g, 6)
vector_extremo(g, "cuadrado")
vector_trazar(g)
igual([px(g, 20, 25), px(g, 3, 25), px(g, 20, 29)], [[255, 0, 0, 255], [255, 0, 0, 255], [255, 255, 255, 255]], "trazo con extremo cuadrado")
// Recorte: solo dentro del círculo.
vector_guardar(g)
vector_circulo(g, 50, 30, 5)
vector_recortar(g)
vector_rectangulo(g, 40, 20, 20, 20)
vector_color(g, "#0000ff")
vector_rellenar(g)
vector_restaurar(g)
igual([px(g, 50, 30), px(g, 42, 22)], [[0, 0, 255, 255], [255, 255, 255, 255]], "recorte")
// Par-impar: el centro de dos cuadrados anidados queda vacío.
vector_regla(g, "par_impar")
vector_rectangulo(g, 42, 2, 16, 16)
vector_rectangulo(g, 46, 6, 8, 8)
vector_color(g, "#00aa00")
vector_rellenar(g)
igual([px(g, 44, 10), px(g, 50, 10)], [[0, 170, 0, 255], [255, 255, 255, 255]], "par-impar")
igual(subcadena(vector_terminar(g), 1, 4), "PNG", "png")
mostrar("[OK] vector")
