importar "huesped"
importar "base64"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Módulo escrito en WAT y compilado con wasmtime (Python); los resultados
// esperados son los que da Wasmtime al ejecutarlo.
sea WASM = base64_decodificar("")
sea BENCH = base64_decodificar("AGFzbQEAAAABBgFgAX8BfwMDAgAABQMBAAEHFQMDbWVtAgADZmliAAAFY3JpYmEAAQpzAhwAIABBAkgEfyAABSAAQQFrEAAgAEECaxAAagsLVAEDf0ECIQECQANAIAEgAE8NASABLQAARQRAIANBAWohAyABIAFsIQICQANAIAIgAE8NASACQQE6AAAgAiABaiECDAALCwsgAUEBaiEBDAALCyADCwA2BG5hbWUBBgEAA2ZpYgIPAQEEAAFuAQFpAgFqAwFjAxYBAQQAA2ZpbgEDZXh0AwJmMgQDaW50")
funcion norm(v) {
    si (tipo(v) == "lista") {
        sea r = []
        para x en v { r.agregar(norm(x)) }
        retornar r
    }
    si (tipo(v) != "texto" y v != nulo y (("" + v) == "nan" o ("" + v) == "-nan")) { retornar "NaN" }
    retornar v
}
funcion parecido(a, b) {
    si (tipo(a) == "lista") {
        si (tipo(b) != "lista" o longitud(a) != longitud(b)) { retornar falso }
        sea i = 0
        mientras (i < longitud(a)) {
            si (parecido(a[i], b[i]) == falso) { retornar falso }
            i = i + 1
        }
        retornar verdadero
    }
    si (tipo(a) == "texto" o tipo(b) == "texto" o a == nulo o b == nulo) { retornar ("" + a) == ("" + b) }
    si (a == b) { retornar verdadero }
    retornar absoluto(a - b) <= 1e-12 * maximo(1, absoluto(b))
}
sea logs = []
sea inst = huesped_instanciar(WASM, {"env": {"log": funcion(x) { logs.agregar(x) }, "suma64": funcion(a, b) { retornar a + b }}})
funcion caso(nombre, args, esperado) {
    sea r = norm(huesped_llamar(inst, nombre, args))
    afirmar(parecido(r, esperado), nombre + " " + args + ": [" + r + "] != [" + esperado + "]")
}
caso("fact", [10], 3628800)
caso("indirecta", [0, 21], 42)
caso("indirecta", [2, 6], 720)
caso("fib64", [90], "2880067194370816120")
caso("aritmetica32", [-123456789, 7], [-864197523, -17636684, -1, -964507, -672053147])
caso("aritmetica32", [2000000000, 3], [1705032704, 666666666, 2, 250000000, 250000000])
caso("aritmetica64", ["-9000000000000000000", 7], ["-7659767778871345152", -1285714285714285714, 0, -70312500000000000, "-8301867430007799743", 0])
caso("aritmetica64", [123456789012345, -3], [-370370367037035, -41152263004115, 123456789012345, 0, "2305858441312320495", 17])
caso("flotantes", [2.5, 7.25], [1.5811388300841898, 2.4166667461395264, 2.0, 2, 7, 7.349999904632568])
caso("flotantes", [-1e+300, -2.75], ["NaN", -0.9166666865348816, -1e+300, -2147483648, -2, -2.6500000953674316])
caso("reinterpretar", [-0.1, 1.5], ["-4631501856787818086", 1069547520])
caso("memoria", [-200], [56, 4294967294, 65535, 1])
caso("llamar_host", [7], 9000000000)
caso("contador", [], 1)
caso("tabla_br", [0], 10)
caso("tabla_br", [1], 20)
caso("tabla_br", [9], 30)
caso("extsigno", [200, 4294967295], [-56, -1])
caso("copiar", [], 1634496328)
igual([huesped_global(inst, "g64"), logs, huesped_paginas(inst)], [-1234567890123, [7], 2], "global, importación y memory.grow")
igual(huesped_texto_c(inst, 16), "Hola, wasm", "segmento de datos")
igual(huesped_exportaciones(inst)["mem"], "memoria", "exportaciones")
sea err = ""
intentar { huesped_llamar(inst, "dividir", [1, 0]) } capturar (e) { err = "" + e }
igual(err, "wasm: trampa: división entera por cero", "trampa")
// i64 en texto y vuelta.
igual([huesped_i64_texto(huesped_i64("-9223372036854775808"), verdadero), huesped_i64_texto(huesped_i64("18446744073709551615"), falso)], ["-9223372036854775808", "18446744073709551615"], "i64 texto")
sea b = huesped_instanciar(BENCH, nulo)
igual([huesped_llamar(b, "fib", [15]), huesped_llamar(b, "criba", [10000])], [610, 1229], "recursión y bucles")
mostrar("[OK] huesped")
