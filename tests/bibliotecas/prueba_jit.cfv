// Pruebas de jit. En Linux x86-64 ejecuta el código; en las demás
// plataformas revisa el código generado. El código ARM64 se comprobó aparte
// desensamblándolo con llvm-mc.
importar "jit"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion bucle() {
    sea f = jit_funcion(1, "entero", nulo)
    sea acc = jit_variable(f, "entero")
    sea i = jit_variable(f, "entero")
    jit_poner(f, acc, jit_constante(f, 0))
    jit_poner(f, i, jit_constante(f, 1))
    sea cab = jit_bloque(f)
    sea cuerpo = jit_bloque(f)
    sea fin = jit_bloque(f)
    jit_saltar(f, cab)
    jit_ir(f, cab)
    jit_saltar_si(f, jit_comparar(f, "menor_igual", jit_leer(f, i), jit_param(f, 0)), cuerpo, fin)
    jit_ir(f, cuerpo)
    jit_poner(f, acc, jit_op(f, "suma", jit_leer(f, acc), jit_leer(f, i)))
    jit_poner(f, i, jit_op(f, "suma", jit_leer(f, i), jit_constante(f, 1)))
    jit_saltar(f, cab)
    jit_ir(f, fin)
    jit_retornar(f, jit_leer(f, acc))
    retornar f
}
// Reales: ida y vuelta de bits.
para x en [0, 1, -1.5, 3.141592653589793, 1e300, -2.5e-310, 123456789.125] { eq(_jt_real_de_bytes(_jt_real_bytes(x)), x, "bits de " + x) }
eq(hex_de_bytes(_jt_real_bytes(1.0)), "000000000000f03f", "1.0")
eq(hex_de_bytes(_jt_real_bytes(-2.0)), "00000000000000c0", "-2.0")
// Código ARM64 (prólogo y epílogo conocidos).
sea arm = jit_codigo(bucle(), "arm64")
eq(hex_de_bytes(subtexto(arm, 0, 12)), "fd7bbfa9fd030091ffc301d1", "prólogo ARM64")
eq(hex_de_bytes(subtexto(arm, longitud(arm) - 12, longitud(arm))), "bf030091fd7bc1a8c0035fd6", "epílogo ARM64")
eq(hex_de_bytes(subtexto(jit_codigo(bucle(), "x86_64"), 0, 4)), "554889e5", "prólogo x86-64")
// Errores.
sea g = jit_funcion(1, "entero", nulo)
sea err = ""
intentar { jit_codigo(g, "x86_64") } capturar (e) { err = "" + e }
afirmar(contiene(err, "no termina"), "bloque sin cerrar")
intentar { jit_op(g, "suma", jit_param(g, 0), jit_real(g, 1.0)) } capturar (e) { err = "" + e }
afirmar(contiene(err, "tipos distintos"), "tipos")
sea x86_linux = existe_archivo("/proc/cpuinfo") y contiene(leer_archivo("/proc/cpuinfo"), "vendor_id")
si (x86_linux) {
    sea h = jit_compilar(bucle(), nulo)
    eq([jit_llamar(h, [10]), jit_llamar(h, [100000]), jit_llamar(h, [0])], [55, 5000050000, 0], "bucle")
    jit_liberar(h)
    sea e = jit_expresion("a % b + (a / b) * 100 + (c > 2 ? 1000 : 0)", ["a", "b", "c"], nulo)
    eq([jit_llamar(e, [17, 5, 3]), jit_llamar(e, [17, 0, 1]), jit_llamar(e, [-17, 5, 1])], [1302, 0, -302], "expresión entera")
    sea bits = jit_expresion("(a << 4 | b & 15) ^ ~0 >> 60", ["a", "b"], nulo)
    eq(jit_llamar(bits, [3, 255]), bits_xo(bits_o(48, 15), -1), "bits")
    sea r = jit_expresion("sqrt(x * x + y * y) / 2.0", ["x", "y"], "real")
    eq(jit_llamar(r, [3.0, 4.0]), 2.5, "real")
    sea mezcla = jit_expresion("max(a, 2.5) + min(a, -1) + abs(-3) + entero(7.9)", ["a"], nulo)
    eq(jit_llamar(mezcla, [1]), 2.5 + -1 + 3 + 7, "mezcla")
    sea cmp = jit_expresion("(x < y) + (x <= y) * 2 + (x > y) * 4 + (x >= y) * 8 + (x == y) * 16 + (x != y) * 32", ["x", "y"], "real")
    eq([jit_llamar(cmp, [1.0, 2.0]), jit_llamar(cmp, [2.0, 2.0]), jit_llamar(cmp, [3.0, 2.0])], [35, 26, 44], "comparaciones reales")
    sea nan = jit_expresion("(z / z < 1.0) + (z / z >= 1.0) * 4 + (z / z != z / z) * 2 + (z / z == z / z) * 8", ["z"], "real")
    eq(jit_llamar(nan, [0.0]), 2, "NaN")
    sea extremos = jit_expresion("a / b + a % b", ["a", "b"], nulo)
    eq(jit_llamar(extremos, [-4611686018427387904, -1]), 4611686018427387904 * 1, "sin trampa con -1")
    sea neg = jit_expresion("-x + abs(y) + !z", ["x", "y", "z"], nulo)
    eq(jit_llamar(neg, [5, -7, 0]), 3, "unarias")
    sea seis = jit_expresion("a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6", ["a", "b", "c", "d", "e", "f"], nulo)
    eq(jit_llamar(seis, [1, 1, 1, 1, 1, 1]), 21, "seis parámetros")
}
mostrar("[OK] jit")
