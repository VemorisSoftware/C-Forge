// English names for lote 32.
importar "gsl"
importar "openblas"
importar "proj"
importar "libgit2"
importar "gdal"
funcion cerca(a, b, tol, q) { afirmar(absoluto(a - b) <= tol, q + ": " + a + " vs " + b) }
cerca(gsl_gamma(0.5), 1.7724538509055159, 1e-14, "gsl_gamma")
cerca(gsl_erfc(5), 1.5374597944280347e-12, 1e-26, "gsl_erfc")
cerca(gsl_bessel_J0(5), -0.1775967713143383, 1e-14, "gsl_bessel_J0")
cerca(gsl_integration_qag(funcion(x) { retornar exponencial(0 - x) }, 0, gsl_inf(), {"tolerance": 1e-12}), 1, 1e-12, "gsl_integration_qag")
cerca(gsl_root_brent(funcion(x) { retornar coseno(x) - x }, 0, 1, nulo), 0.7390851332151607, 1e-14, "gsl_root_brent")
sea sol = gsl_ode_solve(funcion(t, v) { retornar 0 - v }, 0, 1, 1, {"rtol": 1e-10, "atol": 1e-12})
cerca(sol["y"][longitud(sol["y"]) - 1], exponencial(-1), 1e-9, "gsl_odeiv")
afirmar(sol["steps"] > 0, "steps")
cerca(gsl_min_brent(funcion(x) { retornar (x - 1) * (x - 1) }, -3, 3, nulo)["value"], 0, 1e-12, "gsl_min_brent")
afirmar(("" + openblas_dgemm(1, [[1, 2], [3, 4]], [[5, 6], [7, 8]], 0, nulo, falso, falso)) == "[[19, 22], [43, 50]]", "openblas_dgemm")
cerca(openblas_det([[4, 3], [6, 3]]), -6, 1e-12, "openblas_det")
cerca(openblas_dgesv([[2, 1], [1, 3]], [3, 5])[1], 1.4, 1e-14, "openblas_dgesv")
cerca(openblas_dsyev([[2, 1], [1, 2]])["values"][1], 3, 1e-13, "openblas_dsyev")
cerca(openblas_dgesvd([[3, 0], [0, 4]])["s"][0], 4, 1e-13, "openblas_dgesvd")
sea u = proj_transform("EPSG:4326", "EPSG:32719", [-70.6483, -33.4569])
cerca(u[0], 346812.85391860554, 0.0001, "proj_transform")
afirmar(proj_utm_zone([-70.6, -33.4])["zone"] == 19, "proj_utm_zone")
cerca(proj_geod_inverse([-70.6483, -33.4569], [-58.3816, -34.6037], nulo)["distance"], 1139253.493415099, 0.001, "proj_geod_inverse")
// libgit2
sea gdir = (variable_entorno("TMPDIR") ?? "/tmp") + "/cforge-libgit2-" + hex_de_bytes(bytes_aleatorios(6))
sea repo = git_repository_init(gdir, "main")
sea c = git_commit_create(repo, {"a.txt": "hola\n"}, "first", {"author": {"name": "Ann", "email": "ann@x.io", "time": 1700000000}})
afirmar(git_revparse(repo, "HEAD") == c, "git_revparse")
sea cm = git_commit_lookup(repo, "main")
afirmar(cm["author"]["name"] == "Ann" y cm["message"] == "first\n" y longitud(cm["parents"]) == 0, "git_commit_lookup")
afirmar(git_file_at(repo, "HEAD", "a.txt") == "hola\n", "git_file_at")
afirmar(git_hash_blob("hola\n") == "5c1b14949828006ed75a3e8858957f86a2f7e2eb", "git_hash_blob")
afirmar(git_log(repo, "HEAD", 5)[0]["committer"]["email"] == "ann@x.io", "git_log")
afirmar(git_current_branch(repo) == "main", "git_current_branch")
// gdal
sea layer = gdal_read_shapefile("tests/bibliotecas/datos/territorio-comunas")
afirmar(gdal_area(layer["entidades"][0]["geometria"]) == 96, "gdal_area")
afirmar(gdal_to_wkt(gdal_from_wkb(gdal_to_wkb(gdal_from_wkt("POINT (1 2)"), falso))) == "POINT (1 2)", "gdal wkt/wkb")
afirmar(gdal_contains(gdal_from_wkt("POLYGON ((0 0, 4 0, 4 4, 0 4, 0 0))"), [1, 1]), "gdal_contains")
afirmar(texto_contiene(gdal_to_geojson(layer), "FeatureCollection"), "gdal_to_geojson")
mostrar("[OK] en_lote32")
