// Pruebas de panel (GUI de modo inmediato).
importar "panel"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

funcion ui(ctx, ent, e) {
    panel_cuadro(ctx, ent)
    e["visible"] = panel_ventana(ctx, "Demo", {"x": 20, "y": 20, "ancho": 260, "alto": 220})
    si (e["visible"]) {
        panel_texto(ctx, "Hola C-Forge")
        si (panel_boton(ctx, "Sumar", nulo)) { e["n"] = e["n"] + 1 }
        panel_ayuda(ctx, "suma uno")
        panel_misma_linea(ctx, nulo)
        panel_texto(ctx, "n = " + e["n"])
        e["c"] = panel_casilla(ctx, "Activo", e["c"])
        e["v"] = panel_deslizador(ctx, "vol", e["v"], 0, 10, {"decimales": 1})
        e["t"] = panel_entrada_texto(ctx, "nombre", e["t"], nulo)
        si (panel_texto_confirmado(ctx)) { e["ok"] = e["t"] }
        e["i"] = panel_combo(ctx, "modo", e["i"], ["uno", "dos", "tres"])
        panel_progreso(ctx, 0.4, nulo)
    }
    panel_fin_ventana(ctx)
    panel_ventana(ctx, "Otra", {"x": 200, "y": 150, "ancho": 150, "alto": 90})
    si (panel_cabecera(ctx, "Más", nulo)) {
        si (panel_arbol(ctx, "raíz", nulo)) {
            si (panel_seleccionable(ctx, "hoja", e["sel"])) { e["sel"] = e["sel"] == falso }
            panel_fin_arbol(ctx)
        }
    }
    panel_fin_ventana(ctx)
    retornar panel_terminar(ctx)
}

// Un clic: apretar y soltar en el mismo lugar.
funcion clic(ctx, e, x, py) {
    ui(ctx, {"raton": [x, py]}, e)
    ui(ctx, {"raton": [x, py], "botones": [verdadero, falso, falso]}, e)
    retornar ui(ctx, {"raton": [x, py]}, e)
}

sea ctx = panel_contexto(nulo)
sea e = {"n": 0, "c": falso, "v": 5, "t": "ab", "i": 0, "sel": falso, "ok": nulo}
sea L = ui(ctx, {"raton": [0, 0]}, e)
afirmar(longitud(L) > 20, "comandos")
// Botón.
clic(ctx, e, 40, 70)
eq(e["n"], 1, "clic en el botón")
// Apretar en el botón y soltar afuera no cuenta.
ui(ctx, {"raton": [40, 70], "botones": [verdadero, falso, falso]}, e)
ui(ctx, {"raton": [10, 250]}, e)
eq(e["n"], 1, "soltar afuera")
// Ayuda emergente.
sea L2 = ui(ctx, {"raton": [40, 70]}, e)
sea hay = falso
para c en L2 { si (c["t"] == "texto" y c["texto"] == "suma uno") { hay = verdadero } }
afirmar(hay, "ayuda emergente")
afirmar(panel_quiere_raton(ctx), "quiere el ratón")
// Casilla.
clic(ctx, e, 35, 95)
eq(e["c"], verdadero, "casilla")
// Deslizador: apretar y arrastrar.
ui(ctx, {"raton": [30, 120], "botones": [verdadero, falso, falso]}, e)
eq(e["v"], 0, "deslizador al inicio")
ui(ctx, {"raton": [500, 120], "botones": [verdadero, falso, falso]}, e)
eq(e["v"], 10, "deslizador al final")
ui(ctx, {"raton": [107, 120], "botones": [verdadero, falso, falso]}, e)
afirmar(e["v"] > 4.5 y e["v"] < 5.5, "deslizador al medio " + e["v"])
ui(ctx, {"raton": [107, 120]}, e)
// Texto: clic al final, escribir, borrar y moverse.
clic(ctx, e, 150, 145)
afirmar(panel_quiere_teclado(ctx), "foco de teclado")
ui(ctx, {"raton": [150, 145], "texto": "cñ"}, e)
eq(e["t"], "abcñ", "escribir")
ui(ctx, {"raton": [150, 145], "teclas": ["retroceso", "izquierda", "izquierda"]}, e)
ui(ctx, {"raton": [150, 145], "texto": "X"}, e)
eq(e["t"], "aXbc", "insertar en el medio")
ui(ctx, {"raton": [150, 145], "teclas": ["inicio", "suprimir", "fin"], "texto": "!"}, e)
eq(e["t"], "Xbc!", "inicio, suprimir y fin")
ui(ctx, {"raton": [150, 145], "teclas": ["intro"]}, e)
eq(e["ok"], "Xbc!", "intro confirma")
clic(ctx, e, 10, 250)
afirmar(panel_quiere_teclado(ctx) == falso, "clic afuera quita el foco")
ui(ctx, {"raton": [10, 250], "texto": "zz"}, e)
eq(e["t"], "Xbc!", "sin foco no escribe")
// Combo: abrir y elegir.
clic(ctx, e, 100, 165)
afirmar(ctx["popup"] != nulo, "combo abierto")
clic(ctx, e, 60, 181 + 14 * 2 + 4)
eq(e["i"], 2, "combo elige 'tres'")
afirmar(ctx["popup"] == nulo, "combo cerrado")
// Mover la ventana desde el título.
ui(ctx, {"raton": [150, 25], "botones": [verdadero, falso, falso]}, e)
ui(ctx, {"raton": [170, 45], "botones": [verdadero, falso, falso]}, e)
ui(ctx, {"raton": [170, 45]}, e)
eq([ctx["ventanas"]["Demo"]["x"], ctx["ventanas"]["Demo"]["y"]], [40, 40], "mover")
// Volver a su lugar.
ui(ctx, {"raton": [170, 45], "botones": [verdadero, falso, falso]}, e)
ui(ctx, {"raton": [150, 25], "botones": [verdadero, falso, falso]}, e)
ui(ctx, {"raton": [150, 25]}, e)
// Orden: al moverla, "Demo" quedó encima; un clic en "Otra" la sube.
eq(ctx["orden"], ["Otra", "Demo"], "al frente al moverla")
clic(ctx, e, 300, 230)
eq(ctx["orden"], ["Demo", "Otra"], "otra al frente")
clic(ctx, e, 100, 200)
eq(ctx["orden"], ["Otra", "Demo"], "demo al frente")
clic(ctx, e, 300, 230)
// Cabecera, árbol y seleccionable en "Otra".
clic(ctx, e, 260, 180)
eq(ctx["estado"]["Otra/Más"], verdadero, "cabecera abierta")
clic(ctx, e, 260, 202)
eq(ctx["estado"]["Otra/raíz"], verdadero, "árbol abierto")
clic(ctx, e, 260, 225)
eq(e["sel"], verdadero, "seleccionable")
// Plegar.
clic(ctx, e, 30, 30)
eq(e["visible"], falso, "plegada")
eq(ctx["ventanas"]["Demo"]["rect"][3], 20, "solo el título")
clic(ctx, e, 30, 30)
eq(e["visible"], verdadero, "desplegada")
// Cambiar de tamaño desde la esquina.
ui(ctx, {"raton": [275, 236], "botones": [verdadero, falso, falso]}, e)
ui(ctx, {"raton": [295, 256], "botones": [verdadero, falso, falso]}, e)
ui(ctx, {"raton": [295, 256]}, e)
eq([ctx["ventanas"]["Demo"]["ancho"], ctx["ventanas"]["Demo"]["alto"]], [280, 240], "tamaño")

// Desplazamiento con la rueda, filas y otros elementos.
sea c2 = panel_contexto({"estilo": "claro"})
sea s = {"k": 0, "fila": nulo, "lista": 1, "tab": 0, "col": [10, 20, 30], "d": 3}
funcion ui2(ctx, ent, s) {
    panel_cuadro(ctx, ent)
    panel_ventana(ctx, "Larga", {"x": 0, "y": 0, "ancho": 200, "alto": 120})
    s["tab"] = panel_pestanas(ctx, "tabs", ["A", "B"], s["tab"])
    panel_fila(ctx, 20, [0.5, 0.5])
    si (panel_boton(ctx, "izq", nulo)) { s["k"] = s["k"] - 1 }
    si (panel_boton(ctx, "der", nulo)) { s["k"] = s["k"] + 1 }
    panel_fila(ctx, nulo, nulo)
    s["lista"] = panel_lista(ctx, "##l", s["lista"], ["a", "b", "c", "d", "e"], 3)
    s["d"] = panel_arrastrar(ctx, "drag", s["d"], {"minimo": 0, "maximo": 9})
    s["col"] = panel_color(ctx, "color", s["col"])
    sea f = panel_tabla(ctx, "t", ["nombre", "edad"], [["ana", 30], ["luis", 41], ["eva", 25]], {"seleccion": s["fila"] ?? -1})
    si (f != nulo) { s["fila"] = f }
    panel_separador(ctx)
    panel_texto(ctx, "fin")
    panel_fin_ventana(ctx)
    retornar panel_terminar(ctx)
}
funcion donde(L, t) {
    para c en L { si (c["t"] == "texto" y c["texto"] == t) { retornar [c["x"] + 2, c["y"] + 2] } }
    lanzar "no está: " + t
}
funcion clic2(ctx, s, x, py) {
    ui2(ctx, {"raton": [x, py]}, s)
    ui2(ctx, {"raton": [x, py], "botones": [verdadero, falso, falso]}, s)
    retornar ui2(ctx, {"raton": [x, py]}, s)
}
ui2(c2, {"raton": [0, 0]}, s)
sea w = c2["ventanas"]["Larga"]
afirmar(w["contenido"] > 100, "contenido largo " + w["contenido"])
// Filas: dos botones lado a lado.
sea L3 = ui2(c2, {"raton": [0, 0]}, s)
sea xs = []
para c en L3 { si (c["t"] == "texto" y (c["texto"] == "izq" o c["texto"] == "der")) { xs.agregar(c["y"]) } }
eq(longitud(xs), 2, "dos botones")
eq(xs[0], xs[1], "en la misma fila")
sea pd = donde(L3, "der")
clic2(c2, s, pd[0], pd[1])
eq(s["k"], 1, "botón derecho de la fila")
// Pestañas.
sea pb = donde(L3, "B")
clic2(c2, s, pb[0], pb[1])
eq(s["tab"], 1, "pestaña B")
// Lista.
sea pc = donde(L3, "c")
clic2(c2, s, pc[0], pc[1])
eq(s["lista"], 2, "lista")
// Arrastrar.
ui2(c2, {"raton": [180, 40], "rueda": -1}, s)
sea pa = donde(ui2(c2, {"raton": [180, 40]}, s), "3")
ui2(c2, {"raton": pa, "botones": [verdadero, falso, falso]}, s)
ui2(c2, {"raton": [pa[0] + 4, pa[1]], "botones": [verdadero, falso, falso]}, s)
ui2(c2, {"raton": [pa[0] + 4, pa[1]]}, s)
eq(s["d"], 7, "arrastrar")
// Rueda.
ui2(c2, {"raton": [100, 100], "rueda": -1}, s)
afirmar(c2["ventanas"]["Larga"]["scroll"] > 0, "rueda")
ui2(c2, {"raton": [100, 100], "rueda": -50}, s)
sea wl = c2["ventanas"]["Larga"]
eq(wl["scroll"], wl["contenido"] - (120 - 20 - 16), "rueda hasta el fondo")
ui2(c2, {"raton": [100, 100], "rueda": 50}, s)
eq(c2["ventanas"]["Larga"]["scroll"], 0, "rueda arriba")

// Dibujo: píxeles del título y del fondo.
sea c3 = panel_contexto(nulo)
panel_cuadro(c3, {"raton": [0, 0]})
panel_ventana(c3, "V", {"x": 10, "y": 10, "ancho": 100, "alto": 60})
panel_boton(c3, "Ok", nulo)
panel_fin_ventana(c3)
sea img = panel_imagen(c3, 130, 90, [0, 0, 0, 255])
sea pt = imagen_pixel(img, 80, 15)
eq([pt[0], pt[1], pt[2]], [41, 74, 122], "título")
sea pf = imagen_pixel(img, 60, 60)
eq([pf[0], pf[1], pf[2]], [14, 14, 14], "fondo")
eq(imagen_pixel(img, 120, 80)[0], 0, "afuera")
mostrar("[OK] panel")
