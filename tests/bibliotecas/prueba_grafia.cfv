importar "grafia"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Contra uharfbuzz (HarfBuzz 10) con DejaVu Sans, Liberation Serif,
// FreeSerif, Carlito y Caladea Italic y 15 textos (ligaduras, kerning,
// marcas sobre bases y sobre marcas, composición y descomposición de
// acentos, griego, cirílico): los 45 casos dan los mismos glifos, grupos,
// avances y desplazamientos. Aquí, con un subconjunto de DejaVu Sans que
// conserva GSUB, GPOS y GDEF, y resultados sacados de uharfbuzz.
sea f = grafia_fuente(leer_archivo("tests/bibliotecas/datos/DejaVuSans-grafia.ttf"))
funcion moldear(t, rasgos) {
    sea r = []
    para g en grafia_moldear(f, t, {"rasgos": rasgos}) { r.agregar([g["glifo"], g["cluster"], g["avance_x"], g["desplaz_x"], g["desplaz_y"]]) }
    retornar r
}
igual(moldear("office AVA To", nulo), [[63, 0, 1253, 0, 0], [126, 1, 1980, 0, 0], [51, 4, 1126, 0, 0], [53, 5, 1260, 0, 0], [1, 6, 651, 0, 0], [21, 7, 1270, 0, 0], [42, 8, 1270, 0, 0], [21, 9, 1401, 0, 0], [1, 10, 651, 0, 0], [40, 11, 903, 0, 0], [63, 12, 1253, 0, 0]], "ligadura y kerning")
igual(moldear("l'été à Ñuñoa", nulo), [[60, 0, 569, 0, 0], [3, 1, 563, 0, 0], [90, 2, 1260, 0, 0], [68, 3, 803, 0, 0], [90, 4, 1260, 0, 0], [1, 5, 651, 0, 0], [85, 6, 1255, 0, 0], [1, 7, 651, 0, 0], [83, 8, 1532, 0, 0], [69, 9, 1298, 0, 0], [93, 10, 1298, 0, 0], [63, 11, 1253, 0, 0], [49, 12, 1255, 0, 0]], "precompuestos")
igual(moldear("e" + caracter(769) + " o" + caracter(770) + caracter(803) + " q" + caracter(769) + " ǖ", nulo), [[90, 0, 1260, 0, 0], [1, 2, 651, 0, 0], [115, 3, 1253, 0, 0], [1, 6, 651, 0, 0], [65, 7, 1300, 0, 0], [105, 7, 0, -165, 0], [1, 9, 651, 0, 0], [99, 10, 1298, 0, 0]], "composición y marcas")
igual(moldear("office AVA", {"liga": falso, "kern": falso}), [[63, 0, 1253, 0, 0], [54, 1, 721, 0, 0], [54, 2, 721, 0, 0], [57, 3, 569, 0, 0], [51, 4, 1126, 0, 0], [53, 5, 1260, 0, 0], [1, 6, 651, 0, 0], [21, 7, 1401, 0, 0], [42, 8, 1401, 0, 0], [21, 9, 1401, 0, 0]], "sin ligaduras ni kerning")
igual([f["upem"], grafia_glifo(f, 65), grafia_avance(f, 21), grafia_clase_glifo(f, 105)], [2048, 21, 1401, 3], "métricas")
igual(grafia_ancho(f, "AVA", nulo), 3941, "ancho")
igual(contiene("" + grafia_rasgos(f)["GPOS"], "kern"), verdadero, "rasgos")
mostrar("[OK] grafia")
