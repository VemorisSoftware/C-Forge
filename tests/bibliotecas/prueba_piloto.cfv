importar "piloto"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Contra Google Chrome 153 sin ventana se probó: lanzar y cerrar, pestañas,
// ir a una página y esperar la carga, interceptar /api con una respuesta
// propia, esperar condiciones y selectores, textos, clic real, escribir,
// Enter en un formulario, consola, promesas, errores de JavaScript, captura
// PNG de un elemento (100×50 con su color exacto), PDF, cookies y errores
// de red. Aquí, con el navegador simulado.
sea sim = piloto_simulado({
    "https://ejemplo.test/": {"titulo": "Inicio", "dom": {"h1": "Hola", "#pie": "C-Forge"}},
    "https://ejemplo.test/otra": {"titulo": "Otra", "dom": {}}
})
sea nav = piloto_conectar(nulo, {"transporte": sim["transporte"]})
igual(piloto_version(nav)["product"], "Simulado/1.0", "versión")
sea p = piloto_pagina(nav)
igual([p["target"], p["sesion"]], ["T1", "S1"], "pestaña")
piloto_ir(p, "https://ejemplo.test/")
igual([piloto_titulo(p), piloto_url(p), piloto_texto(p, "h1"), piloto_texto(p, "#pie")], ["Inicio", "https://ejemplo.test/", "Hola", "C-Forge"], "página")
igual(piloto_consola(p), [{"texto": "cargó https://ejemplo.test/", "tipo": "log"}], "consola")
igual(piloto_evaluar(p, "1 + 1"), 2, "evaluar")
sea err = nulo
intentar { piloto_evaluar(p, "lanzar()") } capturar (e) { err = e }
igual(err, "piloto: error de JavaScript: ReferenceError: lanzar is not defined", "error de JS")
err = nulo
intentar { piloto_ir(p, "https://no.existe/") } capturar (e) { err = e }
igual(err, "piloto: no se pudo abrir https://no.existe/ (net::ERR_NAME_NOT_RESOLVED)", "error de red")
igual(piloto_captura(p, nulo), "PNG simulado", "captura")
piloto_fijar_cookie(p, "sesion", "abc", "https://ejemplo.test/")
igual(piloto_cookies(p)[0]["value"], "abc", "cookies")
err = nulo
intentar { piloto_cdp(nav, "Fail.metodo", nulo, nulo) } capturar (e) { err = e }
igual(err, "piloto: Fail.metodo: 'Fail.metodo' wasn't found", "error del protocolo")
igual(contiene("" + sim["estado"]["enviados"], "Page.enable"), verdadero, "dominios activados")
piloto_cerrar(p)
piloto_cerrar_navegador(nav)
mostrar("[OK] piloto")
