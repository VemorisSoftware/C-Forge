// Pruebas de nativa (GUI reactiva al estilo Iced), sin ventana.
importar "nativa"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

// Contador: los botones mandan mensajes y la vista se rehace.
sea app = nativa_app({
    "estado": {"cuenta": 0},
    "actualizar": funcion(e, m) {
        si (m == "mas") { e["cuenta"] = e["cuenta"] + 1 }
        si (m == "menos") { e["cuenta"] = e["cuenta"] - 1 }
    },
    "vista": funcion(e) {
        sea menos = "menos"
        si (e["cuenta"] <= 0) { menos = nulo }
        retornar nativa_columna([
            nativa_texto("" + e["cuenta"], {"id": "valor"}),
            nativa_fila([nativa_boton("-", menos, nulo), nativa_boton("+", "mas", nulo)], {"espacio": 4})
        ], {"relleno": 10, "espacio": 6})
    }
})
nativa_simular(app, 200, 100)
nativa_clic_en(app, "-")
eq(nativa_estado(app)["cuenta"], 0, "botón deshabilitado")
nativa_clic_en(app, "+")
nativa_clic_en(app, "+")
nativa_clic_en(app, "-")
eq(nativa_estado(app)["cuenta"], 1, "contador")
// Presionar en un botón y soltar afuera no cuenta.
sea rb = nativa_buscar(app, "+")
nativa_presionar(app, rb[0] + 2, rb[1] + 2)
nativa_soltar(app, 150, 90)
eq(nativa_estado(app)["cuenta"], 1, "soltar afuera")

// Disposición flex: porciones, espacio, relleno y alineación.
funcion caja(id, ancho, alto) { retornar nativa_contenedor(nativa_espacio(nulo, nulo), {"id": id, "ancho": ancho, "alto": alto}) }
sea lay = nativa_app({"estado": {}, "actualizar": funcion(e, m) {}, "vista": funcion(e) {
    retornar nativa_columna([
        nativa_fila([caja("a", "llenar", 20), caja("b", {"porcion": 2}, 20), caja("c", 40, 20)], {"espacio": 10}),
        nativa_fila([caja("d", 30, 10), caja("e", 30, 30)], {"alinear": "centro", "ancho": "llenar"}),
        caja("f", "llenar", "llenar"),
        nativa_contenedor(caja("g", 20, 20), {"ancho": "llenar", "alto": 40, "centrar_x": verdadero, "centrar_y": verdadero, "id": "h"})
    ], {"relleno": [10, 20], "espacio": 5})
}})
nativa_simular(lay, 400, 300)
eq(nativa_buscar(lay, "a"), [20, 10, 100, 20], "llenar = porción 1")
eq(nativa_buscar(lay, "b"), [130, 10, 200, 20], "porción 2")
eq(nativa_buscar(lay, "c"), [340, 10, 40, 20], "ancho fijo")
eq(nativa_buscar(lay, "d"), [20, 45, 30, 10], "alineación centrada en la fila")
eq(nativa_buscar(lay, "e"), [50, 35, 30, 30], "el más alto define la fila")
eq(nativa_buscar(lay, "f"), [20, 70, 360, 175], "llenar en la columna")
eq(nativa_buscar(lay, "g"), [190, 260, 20, 20], "contenedor centrado")

// Texto que se ajusta al ancho.
sea txt = nativa_app({"estado": {}, "actualizar": funcion(e, m) {}, "vista": funcion(e) {
    retornar nativa_columna([nativa_texto("uno dos tres cuatro cinco seis", {"id": "t"}), nativa_texto("fin", nulo)], {"ancho": 80})
}})
nativa_simular(txt, 300, 200)
sea rt = nativa_buscar(txt, "t")
afirmar(rt[2] <= 80 y rt[3] > 30, "texto en varias líneas: " + rt)
eq(nativa_buscar(txt, "fin")[1], rt[3], "lo siguiente va debajo")

// Formulario: entrada con cursor y selección, Tab, Enter, casilla, radio,
// interruptor, deslizador y selector.
sea form = nativa_app({
    "estado": {"nombre": "", "clave": "", "acepto": falso, "plan": "basico", "oscuro": falso, "volumen": 0, "pais": nulo, "enviado": 0},
    "actualizar": funcion(e, m) {
        si (m == "enviar") { e["enviado"] = e["enviado"] + 1 } sino { e[m[0]] = m[1] }
    },
    "vista": funcion(e) {
        retornar nativa_columna([
            nativa_entrada("Nombre", e["nombre"], funcion(v) { retornar ["nombre", v] }, {"al_enviar": "enviar"}),
            nativa_entrada("Clave", e["clave"], funcion(v) { retornar ["clave", v] }, {"secreto": verdadero}),
            nativa_casilla("Acepto", e["acepto"], funcion(v) { retornar ["acepto", v] }),
            nativa_fila([nativa_radio("Básico", "basico", e["plan"], funcion(v) { retornar ["plan", v] }), nativa_radio("Pro", "pro", e["plan"], funcion(v) { retornar ["plan", v] })], {"espacio": 20}),
            nativa_interruptor("Oscuro", e["oscuro"], funcion(v) { retornar ["oscuro", v] }),
            nativa_deslizador(0, 10, e["volumen"], funcion(v) { retornar ["volumen", v] }, {"id": "vol", "paso": 1}),
            nativa_selector(["Chile", "Perú", "México"], e["pais"], funcion(v) { retornar ["pais", v] }, {"id": "pais"}),
            nativa_progreso(0, 10, e["volumen"], nulo)
        ], {"relleno": 10, "espacio": 8})
    }
})
nativa_simular(form, 300, 400)
nativa_clic_en(form, "Nombre")
nativa_escribir(form, "Hola mundo")
nativa_tecla(form, "inicio", nulo)
nativa_tecla(form, "derecha", verdadero)
nativa_tecla(form, "derecha", verdadero)
eq(nativa_seleccion(form), [0, 2], "selección con mayúsculas")
nativa_escribir(form, "Ch")
eq(nativa_estado(form)["nombre"], "Chla mundo", "escribir reemplaza la selección")
nativa_tecla(form, "fin", nulo)
nativa_tecla(form, "borrar", nulo)
nativa_tecla(form, "borrar", nulo)
nativa_tecla(form, "inicio", nulo)
nativa_tecla(form, "suprimir", nulo)
eq(nativa_estado(form)["nombre"], "hla mun", "borrar y suprimir")
nativa_tecla(form, "enter", nulo)
eq(nativa_estado(form)["enviado"], 1, "enter envía")
// Clic en medio del texto pone el cursor ahí.
sea re = nativa_buscar(form, "Nombre")
nativa_clic(form, re[0] + 6 + 3 * 6 + 1, re[1] + 5)
nativa_escribir(form, "-")
eq(nativa_estado(form)["nombre"], "hla- mun", "cursor por clic")
nativa_tecla(form, "tab", nulo)
nativa_escribir(form, "ñandú")
eq(nativa_estado(form)["clave"], "ñandú", "tab a la otra entrada (UTF-8)")
nativa_tecla(form, "borrar", nulo)
eq(nativa_estado(form)["clave"], "ñand", "borrar un carácter UTF-8")
nativa_clic_en(form, "Acepto")
nativa_clic_en(form, "Pro")
nativa_clic_en(form, "Oscuro")
eq([nativa_estado(form)["acepto"], nativa_estado(form)["plan"], nativa_estado(form)["oscuro"]], [verdadero, "pro", verdadero], "casilla, radio e interruptor")
nativa_clic_en(form, "Pro")
eq(nativa_estado(form)["plan"], "pro", "radio ya elegido")
// Deslizador: clic y arrastre.
sea rv = nativa_buscar(form, "vol")
nativa_presionar(form, rv[0] + 7 + (rv[2] - 14) * 0.31, rv[1] + 5)
eq(nativa_estado(form)["volumen"], 3, "clic en el deslizador (con paso)")
nativa_mover(form, rv[0] + rv[2] + 50, rv[1] + 5)
nativa_soltar(form, rv[0] + rv[2] + 50, rv[1] + 5)
eq(nativa_estado(form)["volumen"], 10, "arrastre hasta el tope")
// Selector desplegable.
nativa_clic_en(form, "pais")
sea rp = nativa_buscar(form, "pais")
nativa_clic(form, rp[0] + 4, rp[1] + rp[3] + (12 * 1.3 + 8) * 2 + 3)
eq(nativa_estado(form)["pais"], "México", "selector")
nativa_clic_en(form, "pais")
nativa_tecla(form, "escape", nulo)
nativa_clic(form, rp[0] + 4, rp[1] + rp[3] + 3)
eq(nativa_estado(form)["pais"], "México", "escape cierra la lista")

// Desplazamiento: la rueda mueve el contenido y los clics siguen bien.
sea lista = nativa_app({"estado": {"elegido": nulo}, "actualizar": funcion(e, m) { e["elegido"] = m }, "vista": funcion(e) {
    sea filas = []
    sea i = 0
    mientras (i < 30) {
        filas.agregar(nativa_boton("Fila " + i, i, {"ancho": "llenar", "id": "f" + i}))
        i = i + 1
    }
    retornar nativa_desplazable(nativa_columna(filas, {"espacio": 2}), {"alto": 100, "id": "scroll"})
}})
nativa_simular(lista, 200, 300)
sea antes = nativa_buscar(lista, "f10")
nativa_mover(lista, 50, 50)
nativa_rueda(lista, 5)
sea despues = nativa_buscar(lista, "f10")
eq(antes[1] - despues[1], 100, "rueda desplaza 100 px")
nativa_clic(lista, 50, 5)
eq(nativa_estado(lista)["elegido"], 3, "clic en la fila desplazada")
nativa_clic(lista, 50, 150)
eq(nativa_estado(lista)["elegido"], 3, "lo que queda fuera del área no recibe clics")
nativa_mover(lista, 50, 50)
nativa_rueda(lista, 1000)
afirmar(nativa_buscar(lista, "f29")[1] + nativa_buscar(lista, "f29")[3] <= 101, "no se pasa del final")

// Suscripciones de tiempo.
sea reloj = nativa_app({"estado": {"tics": 0}, "actualizar": funcion(e, m) { e["tics"] = e["tics"] + 1 }, "vista": funcion(e) { retornar nativa_texto("" + e["tics"], nulo) },
    "suscripciones": funcion(e) { retornar [{"cada": 250, "mensaje": "tic"}] }})
nativa_simular(reloj, 100, 50)
nativa_avanzar(reloj, 600)
nativa_avanzar(reloj, 400)
eq(nativa_estado(reloj)["tics"], 4, "suscripción cada 250 ms")
// actualizar puede devolver un estado nuevo.
sea inm = nativa_app({"estado": 1, "actualizar": funcion(e, m) { retornar e * 2 }, "vista": funcion(e) { retornar nativa_texto("" + e, nulo) }})
nativa_simular(inm, 100, 50)
nativa_enviar(inm, "x")
nativa_enviar(inm, "x")
eq(nativa_estado(inm), 4, "estado inmutable")

// Dibujo: fondo del tema, botón primario y texto.
sea l = lienzo_crear(200, 100)
nativa_dibujar(app, l)
eq(imagen_pixel(l, 199, 99), [255, 255, 255, 255], "fondo claro")
sea rmas = nativa_buscar(app, "+")
eq(imagen_pixel(l, piso(rmas[0] - 5), piso(rmas[1] + rmas[3] / 2)), [94, 124, 226, 255], "botón primario")
sea oscuro = nativa_app({"estado": {}, "actualizar": funcion(e, m) {}, "vista": funcion(e) { retornar nativa_texto("hola", nulo) }, "tema": "oscuro"})
nativa_simular(oscuro, 50, 20)
sea l2 = lienzo_crear(50, 20)
nativa_dibujar(oscuro, l2)
eq(imagen_pixel(l2, 49, 19), [32, 34, 37, 255], "fondo oscuro")
sea hay_texto = falso
sea x = 0
mientras (x < 30) {
    si (imagen_pixel(l2, x, 6)[0] > 150) { hay_texto = verdadero }
    x = x + 1
}
afirmar(hay_texto, "el texto se dibuja")
eq(longitud(nativa_comandos(form)) > 10, verdadero, "comandos")
// Rejilla: columnas Auto y *, filas auto, 2* y 40 px, con tramos.
funcion celda_llena(id) { retornar nativa_contenedor(nativa_espacio(nulo, nulo), {"id": id, "ancho": "llenar", "alto": "llenar"}) }
sea rej = nativa_app({"estado": {}, "actualizar": funcion(e, m) {}, "vista": funcion(e) {
    retornar nativa_rejilla([
        nativa_celda(nativa_texto("Etiqueta larga", {"id": "et"}), 0, 0, 1, 1),
        nativa_celda(celda_llena("c01"), 0, 1, 1, 1),
        nativa_celda(celda_llena("c10"), 1, 0, 1, 2),
        nativa_celda(celda_llena("c20"), 2, 0, 1, 1),
        nativa_celda(celda_llena("c21"), 2, 1, 1, 1)
    ], {"columnas": "Auto,*", "filas": ["auto", "2*", 40], "espacio": 4})
}})
nativa_simular(rej, 300, 200)
eq([nativa_buscar(rej, "c01"), nativa_buscar(rej, "c10"), nativa_buscar(rej, "c20"), nativa_buscar(rej, "c21")],
    [[88, 0, 212, 15.6], [0, 19.6, 300, 136.4], [0, 160, 84, 40], [88, 160, 212, 40]], "rejilla")
mostrar("[OK] nativa")
