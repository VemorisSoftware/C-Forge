// Written in English, mixing both languages in one program.
import "money"
import "progress"
import "dinero"
function same(a, b, what) { assert(a == b, what + ": [" + a + "] != [" + b + "]") }
same(money_text(money_add("0.1", "0.2")), "0.3", "money_add")
same(money_text(money_multiply("19.99", "3")), "59.97", "money_multiply")
same(money_text(money_round("2.345", 2, "even")), "2.34", "round even")
same(money_text(money_round("2.345", 2, "up")), "2.35", "round up")
same(money_text(money_divide("10", "3", 2)), "3.33", "money_divide")
let parts = money_allocate("100", 3, 2)
same(money_text(parts[0]), "33.34", "money_allocate")
same(money_format("1234567.5", 2, ",", "."), "1,234,567.50", "money_format")
assert(money_equals("1.10", "1.1"), "money_equals")
same(money_compare("2", "10"), 0 - 1, "money_compare")
same(dinero_texto(money("5.5")), "5.5", "both languages together")
let p = progress_new(4, "Copy")
p["salida"] = false
p["ancho"] = 4
progress_advance(p, 2)
assert(texto_empieza_con(progress_line(p), "Copy [██░░] 50% 2/4"), progress_line(p))
print("[OK] money and progress in English")
