importar "cosecha"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea html = "<!DOCTYPE html><html><head><title>Noticias &amp; más</title><script>if (a < b) { x = '</p>' }</script><style>p > a { color: red }</style></head><body>\n<!-- comentario <p>falso</p> -->\n<article class=\"noticia destacada\" id=n1><h2><a href=\"/a?x=1&amp;y=2\">Uno</a></h2><p>Primer <b>párrafo<p>segundo&nbsp;&#8364;</article>\n<article class=noticia data-id='2'><h2><a href='/b' title=Dos>Dos</a></h2><ul><li>a<li>b<li class=\"ultimo x\">c</ul></article><img src=x.png alt=\"una &quot;foto&quot;\"><br/><table><tr><td>1<td>2<tr><td>3</table><p>fin</div></body></html>"
sea d = cosecha_cargar(html)
igual(cosecha_texto(cosecha_primero(d, "title")), "Noticias & más", "title con entidad")
igual(cosecha_extraer(d, "article.noticia > h2 a[href]", "href"), ["/a?x=1&y=2", "/b"], "hijo y atributo")
igual(cosecha_extraer(d, "article.destacada p"), ["Primer párrafo", "segundo €"], "<p> sin cerrar")
igual(cosecha_extraer(d, "li:first-child, li.ultimo"), ["a", "c"], "grupos")
igual(cosecha_extraer(d, "li + li"), ["b", "c"], "hermano adyacente")
igual(cosecha_extraer(d, "li:first-child ~ li"), ["b", "c"], "hermanos")
igual(cosecha_extraer(d, "li:not(.ultimo)"), ["a", "b"], ":not")
igual(cosecha_extraer(d, "li:nth-child(odd)"), ["a", "c"], "nth-child(odd)")
igual(cosecha_extraer(d, "td:nth-child(2)"), ["2"], "celdas sin cerrar")
igual(longitud(cosecha_buscar(d, "tr")), 2, "filas")
igual(cosecha_attr(cosecha_primero(d, "img[src$=png]"), "alt"), "una \"foto\"", "atributo con entidades")
igual(cosecha_extraer(d, "[data-id='2'] a", "title"), ["Dos"], "atributo entre comillas")
igual(cosecha_extraer(d, "a[href^=\"/a\"]"), ["Uno"], "^=")
igual(cosecha_extraer(d, "a[href*=b]"), ["Dos"], "*=")
igual(cosecha_extraer(d, "li[class~=x]"), ["c"], "~=")
igual(cosecha_extraer(d, "#n1 > h2 > a"), ["Uno"], "#id")
igual(cosecha_extraer(d, "body > p"), ["fin"], "</div> suelto se ignora")
igual(longitud(cosecha_buscar(d, "p")), 3, "comentarios y scripts no crean nodos")
igual(cosecha_texto(cosecha_primero(d, "head")), "Noticias & más", "texto sin script ni style")
igual(cosecha_html(cosecha_primero(d, "#n1 h2")), "<h2><a href=\"/a?x=1&amp;y=2\">Uno</a></h2>", "html escapado")
igual(cosecha_padre(cosecha_primero(d, "h2"))["nombre"], "article", "padre")
afirmar(longitud(a_texto(cosecha_primero(d, "h2"))) < 400, "mostrar un nodo no entra en ciclo")
igual(cosecha_primero(d, "video"), nulo, "sin coincidencias")
igual(cosecha_texto(cosecha_cargar("<p>a<b>b")), "ab", "HTML truncado")
igual(cosecha_texto(cosecha_cargar("1 < 2 & 3 > 2")), "1 < 2 & 3 > 2", "texto suelto")
sea m = ""
intentar { cosecha_buscar(d, "a:hover") } capturar (e) { m = e }
igual(m, "cosecha: pseudo-clase no soportada :hover", "pseudo desconocida")
mostrar("[OK] cosecha")
