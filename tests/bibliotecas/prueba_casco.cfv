importar "casco"
funcion igual(a, b, q) { afirmar(a == b, q + ": [" + a + "] != [" + b + "]") }
sea h = casco_cabeceras()
igual(h["X-Content-Type-Options"], "nosniff", "nosniff")
igual(h["X-Frame-Options"], "SAMEORIGIN", "marcos")
igual(h["Strict-Transport-Security"], "max-age=31536000; includeSubDomains", "HSTS")
igual(h["Referrer-Policy"], "no-referrer", "referer")
igual(h["X-XSS-Protection"], "0", "filtro XSS heredado apagado")
afirmar(texto_indice(h["Content-Security-Policy"], "object-src 'none'") >= 0, h["Content-Security-Policy"])
afirmar(texto_indice(h["Content-Security-Policy"], "upgrade-insecure-requests") >= 0, "upgrade")
sea p = casco_cabeceras({"hsts": falso, "marcos": "DENY", "csp": {"script-src": ["'self'", "https://cdn.c-forge.org"], "upgrade-insecure-requests": falso}, "extra": {"X-Servidor": "C-Forge"}})
igual(tiene_clave(p, "Strict-Transport-Security"), falso, "sin HSTS")
igual(p["X-Frame-Options"], "DENY", "DENY")
igual(p["X-Servidor"], "C-Forge", "extra")
afirmar(texto_indice(p["Content-Security-Policy"], "script-src 'self' https://cdn.c-forge.org;") >= 0, "directiva reemplazada")
igual(texto_indice(p["Content-Security-Policy"], "upgrade"), 0 - 1, "directiva quitada")
igual(tiene_clave(casco_cabeceras({"csp": falso}), "Content-Security-Policy"), falso, "sin CSP")
igual(casco_csp({"default-src": "'none'", "base-uri": falso, "font-src": falso, "form-action": falso, "frame-ancestors": falso, "img-src": falso, "object-src": falso, "script-src": falso, "script-src-attr": falso, "style-src": falso, "upgrade-insecure-requests": falso}), "default-src 'none'", "CSP mínima")
igual(casco_texto({"A": "1", "B": "dos"}), "A: 1\r\nB: dos\r\n", "texto")
sea m = ""
intentar { casco_texto({"X": "a\r\nSet-Cookie: robo=1"}) } capturar (e) { m = e }
igual(m, "casco: salto de línea en la cabecera X", "inyección de cabeceras")
afirmar(longitud(casco_nonce()) == 24 y casco_nonce() != casco_nonce(), "nonce")
mostrar("[OK] casco")
