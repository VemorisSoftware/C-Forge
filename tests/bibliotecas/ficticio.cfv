importar "ficticio"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea a = ficticio_nuevo(42, "es")
sea b = ficticio_nuevo(42, "es")
igual(ficticio_persona(a), ficticio_persona(b), "misma semilla, mismos datos")
afirmar(ficticio_nombre_completo(ficticio_nuevo(1)) != ficticio_nombre_completo(ficticio_nuevo(2)), "semillas distintas")
igual([ficticio_dv(30686957), ficticio_dv(19587715), ficticio_dv(12345678), ficticio_dv(11111111), ficticio_dv(6)], ["4", "7", "5", "1", "K"], "dígito verificador")
sea f = ficticio_nuevo(7, "es")
sea i = 0
mientras (i < 200) {
    sea n = ficticio_entero(f, 3, 5)
    afirmar(n >= 3 y n <= 5, "rango " + n)
    sea rut = ficticio_rut(f)
    sea partes = texto_dividir(rut, "-")
    igual(ficticio_dv(a_numero(texto_reemplazar(partes[0], ".", ""))), partes[1], "RUT válido " + rut)
    sea c = ficticio_correo(f)
    afirmar(texto_indice(c, " ") < 0 y texto_indice(c, "á") < 0 y texto_indice(c, "ñ") < 0, "correo ASCII " + c)
    afirmar(texto_termina_con(c, "@ejemplo.cl") o texto_termina_con(c, "@example.com") o texto_termina_con(c, "@example.org"), "dominio reservado " + c)
    sea u = ficticio_uuid(f)
    afirmar(longitud(u) == 36 y subcadena(u, 14, 15) == "4" y texto_indice("89ab", subcadena(u, 19, 20)) >= 0, "uuid v4 " + u)
    i = i + 1
}
afirmar(texto_empieza_con(ficticio_telefono(f), "+56 9 "), "teléfono chileno")
sea o = ficticio_oracion(f, 5)
igual(longitud(texto_dividir(o, " ")), 5, "palabras")
afirmar(texto_termina_con(o, "."), "punto final")
sea e = ficticio_nuevo(3, "en")
afirmar(texto_empieza_con(ficticio_telefono(e), "+1 555 "), "phone")
igual(tiene_clave(ficticio_persona(e), "rut"), falso, "sin RUT en inglés")
igual(ficticio_elegir(f, ["solo"]), "solo", "elegir")
sea m = ""
intentar { ficticio_nuevo(1, "fr") } capturar (x) { m = x }
igual(m, "ficticio: idioma \"es\" o \"en\"", "idioma")
mostrar("[OK] ficticio")
