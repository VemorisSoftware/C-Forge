// Pruebas de formato_web. datos/webp/*.webp salen de Pillow 12 (libwebp)
// en modo sin pérdida con métodos 0, 3, 4 y 6 (predictor, transformación
// de color, resta de verde, paleta empaquetada, caché de colores y códigos
// por bloques); esperado.json tiene sus píxeles RGBA.
importar "formato_web"
importar "json"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

sea D = "tests/bibliotecas/datos/webp/"
sea e = json_parsear(leer_archivo(D + "esperado.json"))
para k en claves(e) { eq(hex_de_bytes(webp_decodificar(leer_archivo(D + k))["pixeles"]), e[k], "decodificar " + k) }
eq(webp_info(leer_archivo(D + "ruido.webp")), {"alto": 17, "ancho": 23, "sin_perdida": verdadero}, "info")

// Ida y vuelta con el codificador propio (Pillow también lo lee igual).
sea base = imagen_cargar(D + "rgba.png")
sea w = webp_codificar(base)
eq(subtexto(w, 0, 4) + subtexto(w, 8, 16), "RIFFWEBPVP8L", "contenedor")
eq(webp_decodificar(w)["pixeles"] == base["pixeles"], verdadero, "ida y vuelta RGBA")
para color en [[0, 0, 0, 255], [10, 200, 30, 0]] {
    sea plana = imagen_nueva(7, 5, color)
    eq(webp_decodificar(webp_codificar(plana))["pixeles"] == plana["pixeles"], verdadero, "imagen de un color " + color)
}
sea error = ""
intentar { webp_decodificar("RIFF" + bytes_entero(4, 4, 1) + "WEBPVP8 " + bytes_entero(0, 4, 1)) } capturar (x) { error = x }
afirmar(texto_contiene(error, "con pérdida"), "VP8 con pérdida: " + error)
mostrar("[OK] formato_web")
