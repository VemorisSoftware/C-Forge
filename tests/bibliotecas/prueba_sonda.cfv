// Pruebas de sonda. Las capturas de datos/sonda-* las escribió Scapy 2.8
// (pcap, pcapng y pcap con nanosegundos).
importar "sonda"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

// Archivos.
sea c = sonda_leer("tests/bibliotecas/datos/sonda-mezcla.pcap")
sea cn = sonda_leer("tests/bibliotecas/datos/sonda-mezcla.pcapng")
sea nano = sonda_leer("tests/bibliotecas/datos/sonda-nano.pcap")
eq([c["formato"], c["enlace"], longitud(c["paquetes"]), c["paquetes"][0]["ts_ns"]], ["pcap", 1, 10, 1700000000123456000], "pcap")
eq([cn["formato"], longitud(cn["paquetes"]), cn["paquetes"][9]["ts_ns"]], ["pcapng", 10, 1700000009123456000], "pcapng")
eq([nano["nano"], longitud(nano["paquetes"])], [verdadero, 3], "pcap en nanosegundos")
sea i = 0
mientras (i < 10) {
    afirmar(c["paquetes"][i]["datos"] == cn["paquetes"][i]["datos"], "mismos datos en pcap y pcapng (" + i + ")")
    i = i + 1
}

// Decodificación.
sea resumenes = []
para p en c["paquetes"] { resumenes.agregar(sonda_decodificar(p["datos"], c["enlace"])["resumen"]) }
eq(resumenes, ["TCP 10.0.0.1:51515 → 93.184.216.34:443 [SYN] sec=1000 largo=0", "TCP 93.184.216.34:443 → 10.0.0.1:51515 [SYN,ACK] sec=5000 largo=0",
    "DNS consulta A ejemplo.cl (10.0.0.1 → 8.8.8.8)", "DNS respuesta A ejemplo.cl → www.ejemplo.cl, 200.1.2.3, 2001:db8::7 (8.8.8.8 → 10.0.0.1)",
    "ICMP eco pedido 10.0.0.1 → 10.0.0.2", "ARP ¿quién tiene 10.0.0.254? pregunta 10.0.0.1", "TCP [2001:db8::1]:1234 → [2001:db8::1:0:0:2]:80 [PSH,ACK] sec=0 largo=18",
    "ICMPv6 eco pedido fe80::1 → ff02::1", "UDP 192.168.1.10:5000 → 192.168.1.20:5001 largo=10", "UDP [2001:db8::5]:7 → [2001:db8::6]:7 largo=3"], "resúmenes")
sea d0 = sonda_decodificar(c["paquetes"][0]["datos"], 1)
eq([d0["ethernet"]["origen"], d0["ipv4"]["ttl"], d0["ipv4"]["id"], d0["ipv4"]["no_fragmentar"], d0["ipv4"]["suma_valida"], d0["tcp"]["suma_valida"]],
    ["00:11:22:33:44:55", 63, 4242, verdadero, verdadero, verdadero], "IPv4 y TCP")
eq(d0["tcp"]["opciones"], {"escala_ventana": 7, "marca_tiempo": [123, 0], "mss": 1460, "sack_permitido": verdadero}, "opciones TCP")
sea vl = sonda_decodificar(c["paquetes"][8]["datos"], 1)
eq([vl["vlan"]["id"], vl["vlan"]["prioridad"], vl["udp"]["suma_valida"], vl["carga"]], [100, 3, verdadero, "xxxxxxxxxx"], "VLAN")
sea ex = sonda_decodificar(c["paquetes"][9]["datos"], 1)
eq([ex["ipv6"]["extensiones"], ex["udp"]["suma_valida"], ex["carga"]], [[0], verdadero, "eco"], "IPv6 con cabecera de extensión")
eq([sonda_decodificar(c["paquetes"][7]["datos"], 1)["icmpv6"]["suma_valida"], sonda_decodificar(c["paquetes"][4]["datos"], 1)["icmp"]["secuencia"]], [verdadero, 3], "ICMP")
sea dns = sonda_decodificar(c["paquetes"][3]["datos"], 1)["dns"]
eq([dns["id"], longitud(dns["respuestas"]), dns["respuestas"][2]["tipo"], dns["respuestas"][1]["ttl"]], [4660, 3, "AAAA", 300], "DNS")
afirmar(sonda_decodificar(subtexto(c["paquetes"][0]["datos"], 0, 20), 1)["resumen"] != "", "paquete truncado sin fallar")

// Direcciones.
eq([sonda_ipv6_texto(sonda_ipv6_bytes("2001:DB8:0:0:0:0:2:1")), sonda_ipv6_texto(sonda_ipv6_bytes("::1")), sonda_ipv6_texto(sonda_ipv6_bytes("::")),
    sonda_ipv6_texto(sonda_ipv6_bytes("::ffff:192.0.2.1")), sonda_ipv6_texto(sonda_ipv6_bytes("1:0:0:2:0:0:0:3"))],
    ["2001:db8::2:1", "::1", "::", "::ffff:c000:201", "1:0:0:2::3"], "IPv6 (RFC 5952)")

// Filtros de tcpdump.
funcion cuantos(expr) { retornar longitud(sonda_filtrar(c, expr)) }
eq([cuantos("tcp"), cuantos("udp"), cuantos("icmp or icmp6"), cuantos("arp"), cuantos("ip6"), cuantos("vlan 100"), cuantos("")], [3, 4, 2, 1, 3, 1, 10], "protocolos")
eq([cuantos("port 53"), cuantos("tcp port 443"), cuantos("tcp and dst port 443"), cuantos("udp and not port 53"), cuantos("portrange 5000-5001")], [2, 2, 1, 2, 1], "puertos")
eq([cuantos("host 10.0.0.1"), cuantos("src host 10.0.0.1"), cuantos("dst 8.8.8.8"), cuantos("net 192.168.0.0/16"), cuantos("net 10"), cuantos("net 2001:db8::/32")], [6, 4, 1, 1, 6, 2], "direcciones")
eq([cuantos("ether host ff:ff:ff:ff:ff:ff"), cuantos("len > 100"), cuantos("less 50"), cuantos("(tcp or udp) && !ip6"), cuantos("ip and (port 443 or icmp)")], [1, 1, 2, 5, 3], "combinaciones")
sea fallo = ""
intentar { sonda_filtro("tcp port") } capturar (e) { fallo = e }
afirmar(texto_contiene(fallo, "sonda:"), "filtro incompleto")

// Construcción (idéntica a Scapy) y escritura.
sea armado = sonda_paquete({"ethernet": {"origen": "00:11:22:33:44:55", "destino": "66:77:88:99:aa:bb"}, "ipv4": {"origen": "93.184.216.34", "destino": "10.0.0.1", "id": 1},
    "tcp": {"puerto_origen": 443, "puerto_destino": 51515, "secuencia": 5000, "acuse": 1001, "banderas": ["SYN", "ACK"], "ventana": 8192}})
eq(hex_de_bytes(armado), hex_de_bytes(c["paquetes"][1]["datos"]), "TCP armado como Scapy")
sea eco = sonda_paquete({"ethernet": {"origen": "00:11:22:33:44:55", "destino": "66:77:88:99:aa:bb"}, "ipv4": {"origen": "10.0.0.1", "destino": "10.0.0.2", "id": 1},
    "icmp": {"tipo": 8, "id": 7, "secuencia": 3}, "carga": "hola"})
eq(hex_de_bytes(eco), hex_de_bytes(c["paquetes"][4]["datos"]), "ICMP armado como Scapy")
sea u6 = sonda_decodificar(sonda_paquete({"ethernet": {}, "vlan": {"id": 7}, "ipv6": {"origen": "fe80::1", "destino": "fe80::2"}, "udp": {"puerto_origen": 1, "puerto_destino": 2}, "carga": "abc"}), 1)
eq([u6["vlan"]["id"], u6["udp"]["suma_valida"], u6["carga"]], [7, verdadero, "abc"], "UDP sobre IPv6 armado")
para formato en ["pcap", "pcapng"] {
    para fino en [falso, verdadero] {
        sea otra = sonda_de_bytes(sonda_a_bytes(c, {"formato": formato, "nano": fino}))
        eq([otra["formato"], longitud(otra["paquetes"]), otra["paquetes"][5]["ts_ns"], otra["paquetes"][5]["datos"] == c["paquetes"][5]["datos"]],
            [formato, 10, 1700000005123456000, verdadero], "escribir " + formato + " nano=" + fino)
    }
}
sea est = sonda_estadisticas(c)
eq([est["paquetes"], est["bytes"], est["protocolos"]["tcp"], est["origenes"]["10.0.0.1"], est["duracion"]], [10, 749, 3, 4, 9], "estadísticas")

// Captura en vivo (solo Linux con permisos; en CI sin root se omite).
sea vivo = nulo
intentar { vivo = sonda_abrir("lo", {"filtro": "udp port 47123"}) } capturar (e) { vivo = nulo }
si (vivo != nulo) {
    sea u = udp_crear(0)
    udp_enviar(u, "127.0.0.1", 47123, "sonda en vivo")
    sea p = sonda_siguiente(vivo, 2000)
    udp_cerrar(u)
    sonda_cerrar(vivo)
    afirmar(p != nulo y p["decodificado"]["carga"] == "sonda en vivo", "captura en vivo en lo")
    mostrar("(captura en vivo probada)")
}
mostrar("[OK] sonda")
