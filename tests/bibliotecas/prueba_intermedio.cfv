// Pruebas de intermedio (SSA al estilo LLVM).
importar "intermedio"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea fact = "func @fact(%n: i64) -> i64 {
entrada:
  %acc = alloca i64
  %i = alloca i64
  store i64 1, %acc
  store i64 1, %i
  br cab
cab:
  %iv = load i64, %i
  %c = icmp sle i64 %iv, %n
  br %c, cuerpo, fin
cuerpo:
  %a = load i64, %acc
  %dos = add i64 1, 1
  %tres = mul i64 %dos, 0
  %x = mul i64 %a, %iv
  %y = add i64 %x, %tres
  store i64 %y, %acc
  %inv = mul i64 %n, 2
  %i2 = add i64 %iv, 1
  store i64 %i2, %i
  br cab
fin:
  %r = load i64, %acc
  ret i64 %r
}
"
sea m = intermedio_leer(fact)
eq(intermedio_verificar(m), [], "válido")
eq(intermedio_texto(intermedio_leer(intermedio_texto(m))), intermedio_texto(m), "texto de ida y vuelta")
eq([intermedio_ejecutar(m, "fact", [5]), intermedio_ejecutar(m, "fact", [10])], [120, 3628800], "intérprete")
sea antes = intermedio_tamano(m)
sea c = intermedio_optimizar(m, nulo)
eq(c["mem2reg"], 2, "mem2reg promovió dos variables")
eq(intermedio_verificar(m), [], "sigue válido")
eq([antes, intermedio_tamano(m)], [20, 9], "más chico")
eq([intermedio_ejecutar(m, "fact", [5]), intermedio_ejecutar(m, "fact", [10])], [120, 3628800], "mismo resultado")
afirmar(contiene(intermedio_texto(m), "phi i64 [1, entrada]"), "phis")
afirmar(contiene(intermedio_texto(m), "alloca") == falso y contiene(intermedio_texto(m), "%inv") == falso, "sin memoria ni código muerto")
// Saltos constantes y bloques inalcanzables.
sea m2 = intermedio_leer("func @f(%a: i64) -> i64 {
e:
  %c = icmp slt i64 3, 5
  br %c, si, no
si:
  %x = add i64 %a, 10
  br fin
no:
  %y = sub i64 %a, 10
  br fin
fin:
  %r = phi i64 [%x, si], [%y, no]
  ret i64 %r
}
")
intermedio_optimizar(m2, nulo)
eq(intermedio_texto(m2), "func @f(%a: i64) -> i64 {\ne:\n  %x = add i64 %a, 10\n  ret i64 %x\n}\n", "plegado y simplificado")
// Subexpresiones comunes e identidades.
sea m3 = intermedio_leer("func @g(%a: i64, %b: i64) -> i64 {
e:
  %p = mul i64 %a, %b
  %q = mul i64 %b, %a
  %s = add i64 %p, %q
  %z = sub i64 %s, %s
  %t = or i64 %s, %z
  %u = xor i64 %t, 0
  ret i64 %u
}
")
intermedio_optimizar(m3, nulo)
eq(intermedio_texto(m3), "func @g(%a: i64, %b: i64) -> i64 {\ne:\n  %p = mul i64 %a, %b\n  %s = add i64 %p, %p\n  ret i64 %s\n}\n", "cse e identidades")
eq(intermedio_ejecutar(m3, "g", [6, 7]), 84, "resultado de g")
// LICM: el invariante sale del bucle.
sea m4 = intermedio_leer("func @h(%n: i64, %k: i64) -> i64 {
e:
  br cab
cab:
  %i = phi i64 [0, e], [%i2, cuerpo]
  %s = phi i64 [0, e], [%s2, cuerpo]
  %c = icmp slt i64 %i, %n
  br %c, cuerpo, fin
cuerpo:
  %inv = mul i64 %k, %k
  %s2 = add i64 %s, %inv
  %i2 = add i64 %i, 1
  br cab
fin:
  ret i64 %s
}
")
eq(intermedio_licm(m4["funciones"][0]), 1, "licm")
afirmar(contiene(intermedio_texto(m4), "e:\n  %inv = mul i64 %k, %k\n  br cab"), "invariante en la entrada")
eq(intermedio_ejecutar(m4, "h", [4, 3]), 36, "h")
// Llamadas.
sea m5 = intermedio_leer("func @cuad(%x: i64) -> i64 {\ne:\n  %r = mul i64 %x, %x\n  ret i64 %r\n}\nfunc @suma(%a: i64, %b: i64) -> i64 {\ne:\n  %x = call i64 @cuad(%a)\n  %y = call i64 @cuad(%b)\n  %r = add i64 %x, %y\n  ret i64 %r\n}\n")
eq(intermedio_ejecutar(m5, "suma", [3, 4]), 25, "llamadas")
// Reales.
sea m6 = intermedio_leer("func @r(%x: f64) -> f64 {\ne:\n  %d = fmul f64 %x, 2.0\n  %c = fcmp ogt f64 %d, 5.0\n  %r = select f64 %c, %d, 0.5\n  ret f64 %r\n}\n")
eq([intermedio_ejecutar(m6, "r", [3.0]), intermedio_ejecutar(m6, "r", [1.0])], [6, 0.5], "reales")
// Verificador.
eq(intermedio_verificar(intermedio_leer("func @v() -> i64 {\ne:\n  %a = add i64 %b, 1\n  ret i64 %a\n}\n")), ["@v: %b no está definido"], "no definido")
eq(intermedio_verificar(intermedio_leer("func @v() -> i64 {\ne:\n  %a = add i64 1, 1\n}\n")), ["@v/e: el bloque no termina con br o ret"], "sin terminador")
eq(intermedio_verificar(intermedio_leer("func @v(%c: i1) -> i64 {\ne:\n  br %c, a, b\na:\n  %x = add i64 1, 2\n  br b\nb:\n  ret i64 %x\n}\n")), ["@v/b: la definición de %x no domina su uso"], "dominancia")
eq(intermedio_verificar(intermedio_leer("func @v() -> i64 {\ne:\n  br x\n}\n")), ["@v/e: salto a un bloque desconocido 'x'"], "bloque desconocido")
// A código máquina (Linux x86-64).
si (existe_archivo("/proc/cpuinfo") y contiene(leer_archivo("/proc/cpuinfo"), "vendor_id")) {
    sea h = intermedio_a_jit(m, "fact", nulo)
    eq([jit_llamar(h, [5]), jit_llamar(h, [20])], [120, 2432902008176640000], "jit")
    eq(jit_llamar(intermedio_a_jit(m4, "h", nulo), [4, 3]), 36, "jit con licm")
    eq(jit_llamar(intermedio_a_jit(m6, "r", nulo), [3.0]), 6, "jit con reales")
}
mostrar("[OK] intermedio")
