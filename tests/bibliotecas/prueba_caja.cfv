importar "caja"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea ahora = [0]
sea reloj = funcion() { retornar ahora[0] }
// LRU con límite: se desaloja la menos usada.
sea desalojadas = []
sea c = caja_cache({"maximo": 3, "reloj": reloj, "al_desalojar": funcion(k, v, causa) { desalojadas.agregar(k + ":" + causa) }})
caja_poner(c, "a", 1)
caja_poner(c, "b", 2)
caja_poner(c, "c", 3)
caja_si_esta(c, "a")
caja_poner(c, "d", 4)
igual([caja_claves(c), desalojadas], [["c", "a", "d"], ["b:tamano"]], "LRU")
// LFU: se desaloja la menos frecuente.
sea f = caja_cache({"maximo": 2, "politica": "lfu"})
caja_poner(f, "x", 1)
caja_poner(f, "y", 2)
caja_si_esta(f, "x")
caja_si_esta(f, "x")
caja_poner(f, "z", 3)
igual([caja_si_esta(f, "y"), caja_si_esta(f, "x")], [nulo, 1], "LFU")
// Vencimiento tras escribir y tras leer.
sea t = caja_cache({"vence_escritura_ms": 100, "reloj": reloj})
caja_poner(t, "k", "v")
ahora[0] = 99
igual(caja_si_esta(t, "k"), "v", "aún vigente")
ahora[0] = 100
igual(caja_si_esta(t, "k"), nulo, "vencido")
sea l = caja_cache({"vence_lectura_ms": 50, "reloj": reloj})
caja_poner(l, "k", 1)
ahora[0] = 140
caja_si_esta(l, "k")
ahora[0] = 180
igual(caja_si_esta(l, "k"), 1, "leer renueva")
// Carga automática, estadísticas y memo.
sea llamadas = [0]
sea carga = caja_cache({"cargar": funcion(k) { llamadas[0] = llamadas[0] + 1  retornar k * 2 }, "reloj": reloj})
igual([caja_obtener(carga, 21), caja_obtener(carga, 21), llamadas[0]], [42, 42, 1], "cargar una vez")
sea e = caja_estadisticas(carga)
igual([e["aciertos"], e["fallos"], e["cargas"], e["tasa"]], [1, 1, 1, 0.5], "estadísticas")
sea refresco = caja_cache({"refrescar_ms": 10, "reloj": reloj})
sea version = [1]
caja_obtener(refresco, "r", funcion(k) { retornar version[0] })
version[0] = 2
ahora[0] = ahora[0] + 10
igual(caja_obtener(refresco, "r", funcion(k) { retornar version[0] }), 2, "refresco")
sea fib = nulo
fib = caja_memo(funcion(n) { si (n < 2) { retornar n }  retornar fib(n - 1) + fib(n - 2) }, {})
igual(fib(80), 23416728348467685, "memo")
// Peso máximo.
sea p = caja_cache({"peso_maximo": 10, "peso": funcion(k, v) { retornar longitud(v) }})
caja_poner(p, "a", "12345")
caja_poner(p, "b", "123456")
igual([caja_cantidad(p), caja_peso(p), caja_claves(p)], [1, 6, ["b"]], "peso")
caja_invalidar_todo(p)
igual(caja_cantidad(p), 0, "invalidar")
// Multimapa, bimapa, multiconjunto y tabla.
sea mm = caja_multimapa()
caja_mm_poner(mm, "fruta", "manzana")
caja_mm_poner(mm, "fruta", "pera")
caja_mm_poner(mm, "verdura", "zanahoria")
caja_mm_quitar(mm, "fruta", "manzana")
igual([caja_mm_obtener(mm, "fruta"), caja_mm_cantidad(mm), caja_mm_obtener(caja_mm_invertir(mm), "pera")], [["pera"], 2, ["fruta"]], "multimapa")
sea bm = caja_bimapa()
caja_bm_poner(bm, "cl", "Chile")
caja_bm_poner(bm, "ar", "Argentina")
igual([caja_bm_clave(bm, "Chile"), caja_bm_valor(caja_bm_inverso(bm), "Argentina")], ["cl", "ar"], "bimapa")
sea dup = falso
intentar { caja_bm_poner(bm, "xx", "Chile") } capturar (er) { dup = verdadero }
igual(dup, verdadero, "bimapa sin repetidos")
sea mc = caja_multiconjunto(texto_dividir("a b a c b a", " "))
igual([caja_mc_contar(mc, "a"), caja_mc_total(mc), caja_mc_mas_comunes(mc, 2)], [3, 6, [["a", 3], ["b", 2]]], "multiconjunto")
sea tb = caja_tabla()
caja_tb_poner(tb, "ana", "lunes", 8)
caja_tb_poner(tb, "leo", "lunes", 6)
caja_tb_poner(tb, "ana", "martes", 4)
igual([caja_tb_obtener(tb, "ana", "martes"), caja_tb_columna(tb, "lunes")["leo"], caja_tb_filas(tb)], [4, 6, ["ana", "leo"]], "tabla")
// Rangos.
sea rg = caja_rangos()
caja_rg_agregar(rg, 1, 5)
caja_rg_agregar(rg, 10, 20)
caja_rg_agregar(rg, 5, 7)
caja_rg_quitar(rg, 12, 15)
igual([caja_rg_lista(rg), caja_rg_contiene(rg, 6), caja_rg_contiene(rg, 7), caja_rg_contiene(rg, 13)], [[[1, 7], [10, 12], [15, 20]], verdadero, falso, falso], "rangos")
igual(caja_rg_lista(caja_rg_complemento(rg, 0, 25)), [[0, 1], [7, 10], [12, 15], [20, 25]], "complemento")
// Bloom: sin falsos negativos y pocos falsos positivos.
sea bl = caja_bloom(500, 0.01)
sea i = 0
mientras (i < 500) { caja_bloom_agregar(bl, "id" + i)  i = i + 1 }
sea todos = verdadero
i = 0
mientras (i < 500) { si (caja_bloom_tal_vez(bl, "id" + i) == falso) { todos = falso }  i = i + 1 }
sea fp = 0
i = 0
mientras (i < 2000) { si (caja_bloom_tal_vez(bl, "otro" + i)) { fp = fp + 1 }  i = i + 1 }
afirmar(todos y fp < 60, "bloom: falsos positivos " + fp)
// Limitador de tasa.
sea lim = caja_limitador(2, 2, reloj)
igual([caja_permitir(lim), caja_permitir(lim), caja_permitir(lim), caja_espera_ms(lim)], [verdadero, verdadero, falso, 500], "limitador")
ahora[0] = ahora[0] + 500
igual(caja_permitir(lim), verdadero, "limitador recargado")
mostrar("[OK] caja")
