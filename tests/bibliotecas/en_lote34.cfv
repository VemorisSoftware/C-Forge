// Lote 34 en inglés: capstone, rdkit y clamav.
importar "capstone"
importar "rdkit"
importar "clamav"

sea d = cs_disasm_x86(bytes_de_hex("554889e5"), 4096)
afirmar(d[1]["text"] == "mov rbp, rsp" y d[1]["address"] == 4097 y d[1]["mnemonic"] == "mov", "cs_disasm_x86")
afirmar(hex_de_bytes(ks_asm("add x0, x1, #4\nret", "arm64", 0)) == "20100091c0035fd6", "ks_asm arm64")
afirmar(cs_disasm_arm64(ks_asm_arm64("ret", 0), 0)[0]["op_str"] == "", "cs_disasm_arm64")

sea m = mol_from_smiles("CC(=O)Oc1ccccc1C(=O)O")
afirmar(calc_mol_formula(m) == "C9H8O4" y calc_tpsa(m) == 63.6 y num_rotatable_bonds(m) == 3, "rdkit descriptores")
afirmar(mol_descriptors(m)["aromatic_rings"] == 1, "mol_descriptors")
afirmar(lipinski(m)["passes"], "lipinski")
afirmar(longitud(get_substruct_matches(m, "C(=O)O")) == 2 y has_substruct_match(m, "c1ccccc1"), "subestructuras")
afirmar(mol_to_smiles(mol_from_smiles("OCC")) == "CCO", "mol_to_smiles")

sea motor = clam_engine({"depth": 1})
clam_load(motor, "Test.Hola:0:*:686f6c61", "ndb")
afirmar(clam_signature_count(motor) == 2, "clam_signature_count")
afirmar(clam_scan(motor, "di hola") == ["Test.Hola"], "clam_scan")
afirmar(clam_scan_details(motor, "hola")[0]["signature"] == "Test.Hola", "clam_scan_details")
afirmar(clam_md5_signature("abc", "X") == "900150983cd24fb0d6963f7d28e17f72:3:X", "clam_md5_signature")
mostrar("[OK] en_lote34")
