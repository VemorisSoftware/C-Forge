// Pruebas de desarma. datos/desarma-vectores*.json: [instrucción, bytes de
// Keystone 0.9, texto de Capstone 5.0] para x86-64 y ARM64 en 0x1000.
importar "desarma"
importar "json"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

para archivo en ["desarma-vectores.json", "desarma-vectores2.json", "desarma-vectores3.json"] {
    sea v = json_parsear(leer_archivo("tests/bibliotecas/datos/" + archivo))
    para arq en ["x86", "a64"] {
        para f en v[arq] {
            sea b = bytes_de_hex(f[1])
            sea nombre = si(arq == "x86", "x86_64", "arm64")
            sea d = desarma(b, nombre, 4096)
            eq([longitud(d), d[0]["texto"]], [1, f[2]], arq + " desensamblar " + f[0])
            eq(hex_de_bytes(ensambla(f[2], nombre, 4096)), f[1], arq + " ensamblar " + f[2])
        }
    }
}

// Programas con etiquetas (saltos cortos y largos) y vuelta completa.
sea x = ensambla_x86("inicio:\n  xor eax, eax\nbucle:\n  inc eax\n  cmp eax, 10\n  jl bucle\n  call fin\n  ret\nfin:\n  ret", 4096)
eq(hex_de_bytes(x), "31c0ffc083f80a7cf9e801000000c3c3", "x86 con etiquetas")
eq(desarma_listado(x, "x86_64", 4096), "0x1000:  31c0  xor eax, eax\n0x1002:  ffc0  inc eax\n0x1004:  83f80a  cmp eax, 0xa\n0x1007:  7cf9  jl 0x1002\n0x1009:  e801000000  call 0x100f\n0x100e:  c3  ret\n0x100f:  c3  ret", "listado")
sea a = ensambla_arm64("mov x0, #0\nbucle:\n  add x0, x0, #1\n  cmp x0, #10\n  b.lt bucle\n  cbz x0, fin\n  ret\nfin:\n  ret", 0)
sea textos = []
para i en desarma_arm64(a, 0) { textos.agregar(i["texto"]) }
eq(textos, ["mov x0, #0", "add x0, x0, #1", "cmp x0, #0xa", "b.lt #4", "cbz x0, #0x18", "ret", "ret"], "ARM64 con etiquetas")
eq(desarma_x86(bytes_de_hex("06"), 0)[0]["texto"], ".byte 6", "byte desconocido")
sea fallo = ""
intentar { ensambla_x86("vfmadd231pd ymm0, ymm1, ymm2", 0) } capturar (e) { fallo = e }
afirmar(texto_contiene(fallo, "desarma:"), "instrucción no soportada")
mostrar("[OK] desarma")
