importar "centinela"
importar "base64"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Captura hecha con scapy: HTTP con recorrido de rutas, escaneo SSH,
// ping, DNS, TLS sobre IPv6 y SNMP con VLAN.
sea PCAP = base64_decodificar("")
sea pk = centinela_pcap(PCAP)
igual(longitud(pk), 15, "paquetes")
sea q = centinela_decodificar(pk[3]["datos"], pk[3]["enlace"])
igual([q["proto"], q["origen"], q["puerto_destino"], q["flags"], q["ttl"], texto_empieza_con(q["carga"], "GET /admin")], ["tcp", "192.168.1.10", 80, "PA", 64, verdadero], "tcp")
igual([centinela_decodificar(pk[1]["datos"], 1)["flags"], centinela_decodificar(pk[11]["datos"], 1)["itype"]], ["SA", 8], "flags e icmp")
sea v6 = centinela_decodificar(pk[13]["datos"], 1)
igual([v6["origen"], v6["destino"], v6["version"], v6["puerto_destino"]], ["2001:db8::1", "2001:db8::2", 6, 443], "ipv6")
igual([centinela_decodificar(pk[14]["datos"], 1)["vlan"], centinela_decodificar(pk[14]["datos"], 1)["puerto_destino"]], [42, 161], "vlan")
// Reglas en sintaxis de Suricata.
sea REGLAS = "
# comentario
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:\"Recorrido de rutas\"; flow:to_server,established; http.uri; content:\"../\"; sid:1001; rev:2; classtype:web-application-attack; priority:1;)
alert tcp any any -> $HOME_NET 80 (msg:\"sqlmap\"; flow:established,to_server; content:\"User-Agent|3a| sqlmap\"; nocase; sid:1002;)
alert tcp $HOME_NET 80 -> any any (msg:\"Fuga de passwd\"; flow:to_client; content:\"root:\"; depth:200; sid:1003;)
alert tcp any any -> $HOME_NET 22 (msg:\"Escaneo SSH\"; flags:S; threshold: type both, track by_src, count 5, seconds 60; sid:1004;)
alert icmp $HOME_NET any -> any any (msg:\"Ping saliente\"; itype:8; dsize:<64; sid:1005;)
alert udp any any -> any 53 (msg:\"DNS a dominio malo\"; content:\"|04|malo|07|example\"; sid:1006;)
alert tcp [2001:db8::1] any <> any 443 (msg:\"TLS ClientHello\"; content:\"|16 03|\"; offset:0; depth:2; sid:1007;)
alert udp !$HOME_NET any -> any 161 (msg:\"SNMP externo\"; sid:1008;)
alert udp any any -> any [161,162] (msg:\"SNMP public\"; content:\"public\"; sid:1009;)
alert tcp any any -> any 80 (msg:\"No debe saltar\"; content:\"GET\"; content:!\"HTTP/1.1\"; sid:1010;)
alert tcp any any -> any 80 (msg:\"URI por pcre\"; pcre:\"/passwd$/i\"; sid:1011;)
alert tcp any any -> any 80 (msg:\"Distancia\"; content:\"GET\"; content:\"Host\"; distance:0; within:60; sid:1012;)
"
sea m = centinela_motor(REGLAS, {"HOME_NET": "[10.0.0.0/8,192.168.0.0/16]", "EXTERNAL_NET": "any"})
igual(longitud(m["reglas"]), 12, "reglas")
igual(m["reglas"][0]["contenidos"][0]["buffer"], "http.uri", "buffer")
sea al = centinela_analizar(m, PCAP)
sea sids = []
para a en al { sids.agregar(a["sid"]) }
igual(sids, [1001, 1002, 1011, 1012, 1003, 1004, 1005, 1006, 1007, 1009], "alertas")
igual([al[0]["clase"], al[0]["prioridad"], al[5]["origen"]], ["web-application-attack", 1, "203.0.113.7"], "contexto")
igual(centinela_fast(al[0]), "[**] [1:1001:2] Recorrido de rutas [**] [Classification: web-application-attack] [Priority: 1] " + caracter(123) + "TCP" + caracter(125) + " 192.168.1.10:40000 -> 10.0.0.5:80", "fast.log")
igual(centinela_resumen(al)[0]["veces"], 1, "resumen")
// Escribir una captura y volver a leerla.
sea otra = centinela_pcap_escribir([{"t": 1.5, "datos": pk[11]["datos"]}], 1)
igual([longitud(centinela_pcap(otra)), centinela_pcap(otra)[0]["t"], centinela_decodificar(centinela_pcap(otra)[0]["datos"], 1)["destino"]], [1, 1.5, "8.8.8.8"], "pcap propio")
mostrar("[OK] centinela")
