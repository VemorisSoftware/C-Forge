importar "estadistica"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion cerca(a, b, q) { afirmar(absoluto(a - b) < 0.00001, q + ": " + a + " != " + b) }
// Valores de referencia calculados con SciPy.
sea a = [5.1, 4.9, 5.6, 5.8, 6.0, 5.4, 5.2]
sea b = [6.2, 6.4, 5.9, 6.8, 6.1, 6.6]
sea t1 = estadistica_t_una(a, 5)
cerca(t1["t"], 2.873479, "t una muestra")
cerca(t1["p"], 0.028298, "p una muestra")
igual(t1["gl"], 6, "gl una muestra")
sea w = estadistica_t_dos(a, b)
cerca(w["t"], -4.485326, "Welch t")
cerca(w["p"], 0.000923, "Welch p")
cerca(w["gl"], 10.999931, "Welch gl")
sea pr = estadistica_t_pareada([5.1, 4.9, 5.6, 5.8, 6.0, 5.4], b)
cerca(pr["t"], -3.884493, "pareada t")
cerca(pr["p"], 0.011589, "pareada p")
sea c = estadistica_chi2_tabla([[10, 20], [30, 25]])
cerca(c["chi2"], 3.505892, "chi2 tabla")
cerca(c["p"], 0.061151, "chi2 p")
igual(c["gl"], 1, "chi2 gl")
sea g = estadistica_chi2_ajuste([18, 22, 20, 40], [25, 25, 25, 25])
cerca(g["chi2"], 12.32, "bondad de ajuste")
cerca(g["p"], 0.006364, "bondad p")
sea an = estadistica_anova([[1, 2, 3], [2, 3, 4], [5, 6, 7]])
cerca(an["f"], 13, "ANOVA F")
cerca(an["p"], 0.006592, "ANOVA p")
igual([an["gl_entre"], an["gl_dentro"]], [2, 6], "ANOVA gl")
sea r = estadistica_correlacion([1, 2, 3, 4, 5], [2, 4, 5, 4, 5])
cerca(r["r"], 0.774597, "Pearson r")
cerca(r["p"], 0.124027, "Pearson p")
cerca(estadistica_normal_cdf(1.96), 0.975002, "normal cdf")
cerca(estadistica_normal_inv(0.975), 1.959964, "normal inversa")
cerca(estadistica_t_cdf(2, 5), 0.94903, "t cdf")
cerca(estadistica_t_inv(0.95, 10), 1.812461, "t inversa")
cerca(estadistica_chi2_cdf(3, 2), 0.77687, "chi2 cdf")
cerca(estadistica_f_cdf(2, 3, 10), 0.821993, "F cdf")
sea ic = estadistica_intervalo(a, 0.95)
cerca(ic[0], 5.063621, "intervalo inferior")
cerca(ic[1], 5.793522, "intervalo superior")
cerca(estadistica_ln_gamma(5), logaritmo(24), "ln gamma")
afirmar(estadistica_t_una([1, 2, 3], 2, "mayor")["p"] > 0.4, "cola mayor")
sea m = ""
intentar { estadistica_t_una([1], 0) } capturar (e) { m = e }
igual(m, "estadistica: se necesitan al menos 2 datos", "pocos datos")
mostrar("[OK] estadistica")
