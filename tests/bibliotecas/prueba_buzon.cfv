importar "buzon"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Contra libzmq (pyzmq) por TCP se probaron REQ↔REP en ambos sentidos,
// SUB←PUB, PUB→SUB, DEALER→ROUTER y PUSH→PULL. Aquí, sobre tubos en memoria.
igual([longitud(buzon_saludo(falso)), byte_en(buzon_saludo(falso), 0), byte_en(buzon_saludo(falso), 9), subcadena(buzon_saludo(falso), 12, 16), byte_en(buzon_saludo(verdadero), 32)], [64, 255, 127, "NULL", 1], "saludo")
igual(buzon_comando("READY", {"Socket-Type": "REQ"}), bytes_entero(4, 1, 0) + bytes_entero(25, 1, 0) + bytes_entero(5, 1, 0) + "READY" + bytes_entero(11, 1, 0) + "Socket-Type" + bytes_entero(3, 4, 0) + "REQ", "READY")
sea largo = ""
sea i = 0
mientras (i < 300) {
    largo = largo + "x"
    i = i + 1
}
igual([byte_en(buzon_mensaje(["a", "b"]), 0), byte_en(buzon_mensaje([largo]), 0), longitud(buzon_mensaje([largo]))], [1, 2, 309], "tramas")
// REQ ↔ REP.
sea t = buzon_tubo()
sea req = buzon_socket("REQ", t[0], nulo)
sea rep = buzon_socket("REP", t[1], {"servidor": verdadero})
buzon_enviar(req, ["hola", largo])
sea m = buzon_recibir(rep)
igual([m[0], longitud(m[1])], ["hola", 300], "REP recibe")
buzon_enviar(rep, "mundo")
igual(buzon_recibir(req), ["mundo"], "REQ recibe")
sea err = ""
intentar { buzon_recibir(req) } capturar (e) { err = "" + e }
igual(err, "buzon: REQ debe enviar antes de recibir", "estado de REQ")
// PUB → SUB con filtro.
sea t2 = buzon_tubo()
sea pub = buzon_socket("PUB", t2[0], {"servidor": verdadero})
sea sub = buzon_socket("SUB", t2[1], nulo)
buzon_suscribir(sub, "clima.")
// El SUB termina su apretón de manos (y manda la suscripción) al leer.
_bz_listo(sub, sub["peers"][0])
buzon_enviar(pub, ["deportes.futbol", "3-1"])
buzon_enviar(pub, ["clima.santiago", "soleado"])
igual(buzon_recibir(sub), ["clima.santiago", "soleado"], "PUB/SUB filtra")
// DEALER ↔ ROUTER con identidad.
sea t3 = buzon_tubo()
sea dealer = buzon_socket("DEALER", t3[0], {"identidad": "cli-1"})
sea router = buzon_socket("ROUTER", t3[1], {"servidor": verdadero})
buzon_enviar(dealer, ["pedido", "42"])
sea rm = buzon_recibir(router)
igual(rm, ["cli-1", "pedido", "42"], "ROUTER ve la identidad")
buzon_enviar(router, ["cli-1", "listo"])
igual(buzon_recibir(dealer), ["listo"], "ROUTER responde por identidad")
// PUSH → PULL.
sea t4 = buzon_tubo()
sea push = buzon_socket("PUSH", t4[0], nulo)
sea pull = buzon_socket("PULL", t4[1], {"servidor": verdadero})
buzon_enviar(push, "tarea 1")
buzon_enviar(push, ["tarea", "2"])
igual([buzon_recibir(pull), buzon_recibir(pull)], [["tarea 1"], ["tarea", "2"]], "PUSH/PULL")
// Tipos incompatibles.
sea t5 = buzon_tubo()
sea a = buzon_socket("PUSH", t5[0], nulo)
sea b = buzon_socket("SUB", t5[1], nulo)
err = ""
intentar { buzon_enviar(a, "x") } capturar (e) { err = "" + e }
igual(err, "buzon: PUSH no se conecta con SUB", "compatibilidad")
mostrar("[OK] buzon")
