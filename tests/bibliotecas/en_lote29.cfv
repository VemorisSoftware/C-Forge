// English names for lote 29.
importar "simdjson"
importar "vello"
importar "iced"
importar "avalonia"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea d = simdjson_open("{\"users\": [{\"id\": 1, \"name\": \"Ana\"}, {\"id\": 2}], \"ok\": true}")
eq(simdjson_at(d, "/users/0/name"), "Ana", "simdjson_at")
eq(simdjson_count(d, "/users"), 2, "simdjson_count")
eq(simdjson_keys(d, ""), ["users", "ok"], "simdjson_keys")
eq(simdjson_type(d, "/users"), "array", "simdjson_type")
eq(simdjson_exists(d, "/users/5"), falso, "simdjson_exists")
eq(simdjson_columns(d, "/users", ["id"]), [{"id": 1}, {"id": 2}], "simdjson_columns")
sea v = simdjson_validate("[1,]")
eq([v["valid"], v["line"], v["column"], v["message"]], [falso, 1, 4, "carácter inesperado"], "simdjson_validate")
eq(simdjson_parse("[1, \"x\"]"), [1, "x"], "simdjson_parse")
eq(simdjson_minify("[ 1 , 2 ]"), "[1,2]", "simdjson_minify")
eq(simdjson_ndjson("1\n2\n"), [1, 2], "simdjson_ndjson")
eq(simdjson_to_ndjson([1, 2]), "1\n2\n", "simdjson_to_ndjson")
// vello
sea sc = vello_scene()
sea pth = vello_path()
vello_rect(pth, 0, 0, 10, 10)
vello_fill(sc, pth, "#ff0000", nulo)
vello_push_layer(sc, nulo, {"blend": "multiply", "alpha": 1})
vello_stroke(sc, vello_path_from_svg("M0 5 L10 5"), "#00ff00", {"width": 2, "cap": "butt", "transform": vello_translate(0, 0)})
vello_pop_layer(sc)
sea img = vello_render(sc, 10, 10, {"background": "#ffffff"})
eq([imagen_pixel(img, 5, 1), imagen_pixel(img, 5, 5)], [[255, 0, 0, 255], [0, 0, 0, 255]], "vello_render")
eq(vello_scene_len(sc), 4, "vello_scene_len")
sea cv = vello_path()
vello_circle(cv, 5, 5, 3)
afirmar(absoluto(vello_coverage(cv, 10, 10, {"fill_rule": "evenodd"})[55] - 1) < 0.001, "vello_coverage")
// iced
sea ia = iced_application({"state": {"n": 0, "name": "", "on": falso, "ticks": 0},
    "update": funcion(st, msg) {
        si (msg == "inc") { st["n"] = st["n"] + 1 }
        si (msg == "tick") { st["ticks"] = st["ticks"] + 1 }
        si (tipo(msg) == "lista") { st[msg[0]] = msg[1] }
    },
    "view": funcion(st) {
        retornar iced_column([
            iced_row([iced_text("" + st["n"], {"id": "n"}), iced_button("Inc", "inc", {"style": "secondary", "width": "fill", "id": "b"})], {"spacing": 5, "align": "center"}),
            iced_text_input("Name", st["name"], funcion(v) { retornar ["name", v] }, nulo),
            iced_toggler("On", st["on"], funcion(v) { retornar ["on", v] })
        ], {"padding": 10, "spacing": 8})
    },
    "subscriptions": funcion(st) { retornar [{"every": 100, "message": "tick"}] },
    "theme": "dark"})
iced_simulate(ia, 200, 150)
iced_click_on(ia, "Inc")
iced_click_on(ia, "Name")
iced_type_text(ia, "abc")
iced_key(ia, "backspace", nulo)
iced_click_on(ia, "On")
iced_advance(ia, 250)
eq([iced_state(ia)["n"], iced_state(ia)["name"], iced_state(ia)["on"], iced_state(ia)["ticks"]], [1, "ab", verdadero, 2], "iced")
afirmar(iced_find(ia, "b")[2] > 100, "iced fill width")
// avalonia
sea vm = {"Name": "", "Greeting": "", "Greet": funcion(m, p) { m["Greeting"] = "Hi " + m["Name"] }, "seen": [],
    "OnPropertyChanged": funcion(m, p) { m["seen"].agregar(p) }}
sea ax = "<Window Width='240' Height='120'><StackPanel Margin='8' Spacing='6'>"
ax = ax + "<TextBox Name='name' Text='\{Binding Name}' Watermark='Name'/>"
ax = ax + "<Button Name='go' Content='Greet' Command='\{Binding Greet}'/>"
ax = ax + "<TextBlock Name='out' Text='\{Binding Greeting}'/></StackPanel></Window>"
sea aw = avalonia_window(ax, vm)
avalonia_simulate(aw)
avalonia_click_on(aw, "name")
avalonia_type_text(aw, "Ana")
avalonia_click_on(aw, "go")
eq([vm["Greeting"], vm["seen"], avalonia_find(aw, "Hi Ana") != nulo], ["Hi Ana", ["Name"], verdadero], "avalonia")
eq(avalonia_color("#ff0000"), [255, 0, 0, 255], "avalonia_color")
mostrar("[OK] en_lote29")
