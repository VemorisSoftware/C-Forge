importar "formatos"
importar "json"
funcion igual(a, b, q) { afirmar(json_texto(a) == json_texto(b), q + ": [" + json_texto(a) + "] != [" + json_texto(b) + "]") }
// Ejemplos del RFC 9535 (JSONPath).
sea doc = {"store": {"book": [
    {"category": "reference", "author": "Nigel Rees", "title": "Sayings of the Century", "price": 8.95},
    {"category": "fiction", "author": "Evelyn Waugh", "title": "Sword of Honour", "price": 12.99},
    {"category": "fiction", "author": "Herman Melville", "title": "Moby Dick", "isbn": "0-553-21311-3", "price": 8.99},
    {"category": "fiction", "author": "J. R. R. Tolkien", "title": "The Lord of the Rings", "isbn": "0-395-19395-8", "price": 22.99}],
  "bicycle": {"color": "red", "price": 399}}}
igual(formatos_jsonpath(doc, "$.store.book[*].author"), ["Nigel Rees", "Evelyn Waugh", "Herman Melville", "J. R. R. Tolkien"], "autores")
igual(longitud(formatos_jsonpath(doc, "$..author")), 4, "descendientes")
igual(formatos_jsonpath(doc, "$..book[2].title"), ["Moby Dick"], "índice")
igual(formatos_jsonpath(doc, "$..book[-1].title"), ["The Lord of the Rings"], "índice negativo")
igual(formatos_jsonpath(doc, "$..book[0,1].price"), [8.95, 12.99], "unión")
igual(formatos_jsonpath(doc, "$..book[:2].price"), [8.95, 12.99], "rebanada")
igual(formatos_jsonpath(doc, "$..book[::-2].price"), [22.99, 12.99], "rebanada inversa")
igual(formatos_jsonpath(doc, "$..book[?@.isbn].title"), ["Moby Dick", "The Lord of the Rings"], "filtro existe")
igual(formatos_jsonpath(doc, "$..book[?@.price < 10].title"), ["Sayings of the Century", "Moby Dick"], "filtro comparación")
igual(formatos_jsonpath(doc, "$..book[?@.category == 'fiction' && @.price > 20].author"), ["J. R. R. Tolkien"], "filtro compuesto")
igual(formatos_jsonpath(doc, "$..book[?match(@.author, 'H.*')].title"), ["Moby Dick"], "match")
igual(formatos_jsonpath(doc, "$..book[?length(@.title) > 15].price"), [8.95, 22.99], "length")
igual(formatos_jsonpath_rutas(doc, "$.store.bicycle.color")[0][1], "$['store']['bicycle']['color']", "ruta normalizada")
// JSON Pointer y Patch (comparados con la librería jsonpatch de Python).
sea d2 = {"a/b": 1, "m~n": 2, "lista": [1, 2, 3]}
igual([formatos_puntero(d2, "/a~1b"), formatos_puntero(d2, "/m~0n"), formatos_puntero(d2, "/lista/2")], [1, 2, 3], "puntero")
igual(formatos_parche(d2, [{"op": "add", "path": "/lista/0", "value": 0}, {"op": "remove", "path": "/a~1b"}, {"op": "move", "from": "/m~0n", "path": "/x"}, {"op": "copy", "from": "/x", "path": "/y"}, {"op": "replace", "path": "/lista/3", "value": 9}]), {"lista": [0, 1, 2, 9], "x": 2, "y": 2}, "parche")
sea fallo = falso
intentar { formatos_parche(d2, [{"op": "test", "path": "/lista/0", "value": 5}]) } capturar (e) { fallo = verdadero }
igual([fallo, d2["lista"]], [verdadero, [1, 2, 3]], "test falla sin cambiar el original")
sea a = {"n": 1, "l": [1, 2, 3], "o": {"x": 1, "y": 2}}
sea b = {"n": 2, "l": [1, 5], "o": {"x": 1, "z": 3}, "nuevo": nulo}
sea dif = formatos_diferencias(a, b)
igual(formatos_parche(a, dif), b, "diferencias")
igual(formatos_mezcla({"a": "b", "c": {"d": "e", "f": "g"}}, {"a": "z", "c": {"f": nulo}}), {"a": "z", "c": {"d": "e"}}, "merge patch (RFC 7386)")
igual(formatos_mezcla_diferencias({"a": 1, "b": 2}, {"a": 1, "c": 3}), {"b": nulo, "c": 3}, "merge patch inverso")
// JSON Schema (resultados iguales a jsonschema de Python en 81 casos).
sea esquema = {"$defs": {"pos": {"type": "integer", "minimum": 1}}, "type": "object", "properties": {"nombre": {"type": "string", "minLength": 1}, "edad": {"$ref": "#/$defs/pos"}, "correo": {"type": "string", "format": "email"}, "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": verdadero}}, "required": ["nombre"], "additionalProperties": falso}
igual(formatos_validar(esquema, {"nombre": "Ana", "edad": 30, "correo": "ana@x.cl", "tags": ["a", "b"]})["valido"], verdadero, "esquema válido")
sea r = formatos_validar(esquema, {"edad": 0, "correo": "malo", "tags": ["a", "a"], "extra": 1})
igual(longitud(r["errores"]), 5, "errores")
igual(formatos_validar({"oneOf": [{"type": "integer"}, {"minimum": 2}]}, 3)["valido"], falso, "oneOf")
igual(formatos_validar({"if": {"properties": {"pais": {"const": "CL"}}}, "then": {"required": ["rut"]}}, {"pais": "CL"})["valido"], falso, "if/then")
// Conversiones.
igual(json_parsear(formatos_convertir("a: 1\nb: [x, y]\n", "yaml", "json")), {"a": 1, "b": ["x", "y"]}, "yaml a json")
igual(formatos_leer(formatos_escribir({"s": {"p": 80}}, "toml"), "toml"), {"s": {"p": 80}}, "toml")
sea x = formatos_leer("<pedido id=\"7\"><item>a</item><item>b</item><total>3</total></pedido>", "xml")
igual(x, {"pedido": {"@id": "7", "item": ["a", "b"], "total": "3"}}, "xml a datos")
igual(formatos_leer(formatos_escribir(x, "xml"), "xml"), x, "xml ida y vuelta")
igual(formatos_leer(formatos_escribir([{"a": 1, "b": "x"}, {"a": 2, "b": "y"}], "csv"), "csv"), [{"a": "1", "b": "x"}, {"a": "2", "b": "y"}], "csv")
mostrar("[OK] formatos")
