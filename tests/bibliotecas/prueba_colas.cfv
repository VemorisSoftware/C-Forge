importar "colas"
importar "base64"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Tramas hechas con pamqp (Python): las nuestras salen idénticas byte a byte.
sea PY = {}
PY["start"] = "AQAAAAAAiwAKAAoACQAAAGYMY2FwYWJpbGl0aWVzRgAAAC4WY29uc3VtZXJfY2FuY2VsX25vdGlmeXQBEnB1Ymxpc2hlcl9jb25maXJtc3QBB3Byb2R1Y3RTAAAACFJhYmJpdE1RB3ZlcnNpb25TAAAABDMuMTIAAAAOUExBSU4gQU1RUExBSU4AAAAFZW5fVVPO"
PY["start_ok"] = "AQAAAAAAVwAKAAsAAAAzDGNhcGFiaWxpdGllc0YAAAANCmJhc2ljLm5hY2t0AQdwcm9kdWN0UwAAAAdDLUZvcmdlBVBMQUlOAAAADABndWVzdABndWVzdAVlbl9VU84="
PY["tune"] = "AQAAAAAADAAKAB4H/wACAAAAPM4="
PY["tune_ok"] = "AQAAAAAADAAKAB8H/wACAAAAPM4="
PY["open"] = "AQAAAAAACAAKACgBLwAAzg=="
PY["close"] = "AQAAAAAAEQAKADIAyAZhZGnDs3MAAAAAzg=="
PY["canal_open"] = "AQABAAAABgAUAAoBMM4="
PY["exchange_declare"] = "AQABAAAANgAoAAoAAAdldmVudG9zBXRvcGljAgAAAB0SYWx0ZXJuYXRlLWV4Y2hhbmdlUwAAAAVvdHJvc84="
PY["queue_declare"] = "AQABAAAANwAyAAoAAAZ0YXJlYXMCAAAAJQx4LW1heC1sZW5ndGhJAAAD6A14LW1lc3NhZ2UtdHRsSQAA6mDO"
PY["queue_declare_ok"] = "AQABAAAAEwAyAAsGdGFyZWFzAAAABQAAAAHO"
PY["queue_bind"] = "AQABAAAAJAAyABQAAAZ0YXJlYXMHZXZlbnRvcwl1c3VhcmlvLioAAAAAAM4="
PY["basic_qos"] = "AQABAAAACwA8AAoAAAAAAAoAzg=="
PY["basic_consume"] = "AQABAAAAFQA8ABQAAAZ0YXJlYXMCYzEEAAAAAM4="
PY["basic_publish"] = "AQABAAAAHQA8ACgAAAdldmVudG9zDXVzdWFyaW8ubnVldm8Bzg=="
PY["basic_deliver"] = "AQABAAAAJgA8ADwCYzEAAAAAAAAAKgEHZXZlbnRvcw11c3VhcmlvLm51ZXZvzg=="
PY["basic_ack"] = "AQABAAAADQA8AFAAAAAAAAAAKgHO"
PY["basic_nack"] = "AQABAAAADQA8AHgAAAAAAAAABwLO"
PY["basic_get_ok"] = "AQABAAAAGQA8AEcAAAAAAAAAAwAABnRhcmVhcwAAAALO"
PY["confirm_select"] = "AQABAAAABQBVAAoAzg=="
PY["cabecera"] = "AgABAAAAigA8AAAAAAAAAAAAC77IEGFwcGxpY2F0aW9uL2pzb24AAABGB2ludGVudG9JAAAAAgVsaXN0YUEAAAAPSQAAAAFTAAAAA2Rvc3QBBm9yaWdlblMAAAADd2ViBnByZWNpb2Q/+AAAAAAAAAIFA2FiYwpyZXNwdWVzdGFzA20tMQAAAABlk30lA2FwcM4="
PY["cuerpo"] = "AwABAAAAC3siaG9sYSI6IDF9zg=="
PY["latido"] = "CAAAAAAAAM4="
funcion py(n) { retornar base64_decodificar(PY[n]) }
igual(colas_trama(1, 0, colas_metodo("connection.start", {"version_major": 0, "version_minor": 9, "server_properties": {"capabilities": {"consumer_cancel_notify": verdadero, "publisher_confirms": verdadero}, "product": "RabbitMQ", "version": "3.12"}, "mechanisms": "PLAIN AMQPLAIN", "locales": "en_US"})) == py("start"), verdadero, "connection.start")
igual(colas_trama(1, 0, colas_metodo("connection.close", {"reply_code": 200, "reply_text": "adiós"})) == py("close"), verdadero, "connection.close")
igual(colas_trama(1, 1, colas_metodo("exchange.declare", {"exchange": "eventos", "exchange_type": "topic", "durable": verdadero, "arguments": {"alternate-exchange": "otros"}})) == py("exchange_declare"), verdadero, "exchange.declare")
igual(colas_trama(1, 1, colas_metodo("queue.declare", {"queue": "tareas", "durable": verdadero, "arguments": {"x-max-length": 1000, "x-message-ttl": 60000}})) == py("queue_declare"), verdadero, "queue.declare")
igual(colas_trama(1, 1, colas_metodo("basic.consume", {"queue": "tareas", "consumer_tag": "c1", "exclusive": verdadero})) == py("basic_consume"), verdadero, "basic.consume")
igual(colas_trama(1, 1, colas_metodo("basic.nack", {"delivery_tag": 7, "requeue": verdadero})) == py("basic_nack"), verdadero, "basic.nack")
sea props = {"content_type": "application/json", "headers": {"intento": 2, "lista": [1, "dos", verdadero], "origen": "web", "precio": 1.5}, "delivery_mode": 2, "priority": 5, "correlation_id": "abc", "reply_to": "respuestas", "message_id": "m-1", "timestamp": 1704164645, "app_id": "app"}
igual(colas_trama(2, 1, colas_cabecera(11, props)) == py("cabecera"), verdadero, "cabecera de contenido")
igual([colas_trama(3, 1, "{\"hola\": 1}") == py("cuerpo"), colas_trama(8, 0, "") == py("latido")], [verdadero, verdadero], "cuerpo y latido")
// Y decodificamos las de pamqp.
sea d = colas_leer_metodo(colas_leer_trama(py("basic_get_ok"), 0)[0]["contenido"])
igual([d["metodo"], d["delivery_tag"], d["routing_key"], d["message_count"], d["redelivered"]], ["basic.get_ok", 3, "tareas", 2, falso], "get_ok")
sea h = colas_leer_cabecera(colas_leer_trama(py("cabecera"), 0)[0]["contenido"])
igual([h["tam_cuerpo"], h["propiedades"]["headers"]["lista"], h["propiedades"]["headers"]["precio"], h["propiedades"]["timestamp"]], [11, [1, "dos", verdadero], 1.5, 1704164645], "cabecera leída")
// pamqp escribe "0" en el campo reservado de channel.open; se lee igual.
igual(colas_leer_metodo(colas_leer_trama(py("canal_open"), 0)[0]["contenido"])["metodo"], "channel.open", "channel.open")
// Tablas con tipos forzados.
igual(colas_leer_metodo(colas_metodo("queue.bind", {"queue": "q", "arguments": {"t": colas_valor("T", 99), "f": colas_valor("f", 0.5)}}))["arguments"]["f"], 0.5, "float")
// Cliente contra un servidor falso que habla AMQP con nuestras tramas.
sea srv = {"entrada": "", "salida": [], "colas": {}, "acks": [], "consumidores": {}, "confirmar": falso, "sec": 0, "pendiente": nulo, "cerrado": falso}
funcion responder(canal, nombre, args) { srv["salida"].agregar(colas_trama(1, canal, colas_metodo(nombre, args))) }
funcion entregar(canal, etiqueta, cola, m, num) {
    responder(canal, "basic.deliver", {"consumer_tag": etiqueta, "delivery_tag": num, "exchange": "", "routing_key": cola})
    srv["salida"].agregar(colas_trama(2, canal, colas_cabecera(longitud(m["cuerpo"]), m["props"])))
    srv["salida"].agregar(colas_trama(3, canal, m["cuerpo"]))
}
funcion procesar() {
    si (texto_empieza_con(srv["entrada"], "AMQP")) {
        srv["entrada"] = subcadena(srv["entrada"], 8, longitud(srv["entrada"]))
        responder(0, "connection.start", {"version_major": 0, "version_minor": 9, "server_properties": {"product": "Falso"}, "mechanisms": "PLAIN", "locales": "en_US"})
    }
    mientras (longitud(srv["entrada"]) >= 8) {
        sea n = bytes_leer_entero(srv["entrada"], 3, 4, 0)
        si (longitud(srv["entrada"]) < n + 8) { romper }
        sea tr = colas_leer_trama(srv["entrada"], 0)
        srv["entrada"] = subcadena(srv["entrada"], tr[1], longitud(srv["entrada"]))
        sea f = tr[0]
        sea ch = f["canal"]
        si (f["tipo"] == 2) {
            sea hc = colas_leer_cabecera(f["contenido"])
            srv["pendiente"]["props"] = hc["propiedades"]
            srv["pendiente"]["tam"] = hc["tam_cuerpo"]
        }
        sino si (f["tipo"] == 3) {
            sea m = srv["pendiente"]
            m["cuerpo"] = m["cuerpo"] + f["contenido"]
            sea completo = longitud(m["cuerpo"]) >= m["tam"]
            sea cola = m["clave"]
            si (tiene_clave(srv["colas"], cola) == falso) { srv["colas"][cola] = [] }
            si (completo) { srv["colas"][cola].agregar(m) }
            si (completo y srv["confirmar"]) {
                srv["sec"] = srv["sec"] + 1
                responder(ch, "basic.ack", {"delivery_tag": srv["sec"]})
            }
        } sino si (f["tipo"] == 1) {
            sea m = colas_leer_metodo(f["contenido"])
            sea nm = m["metodo"]
            si (nm == "connection.start_ok") {
                afirmar(m["response"] == bytes_entero(0, 1, 0) + "ana" + bytes_entero(0, 1, 0) + "secreta", "credenciales")
                responder(0, "connection.tune", {"channel_max": 10, "frame_max": 4096, "heartbeat": 30})
            }
            si (nm == "connection.open") {
                afirmar(m["virtual_host"] == "prod", "vhost")
                srv["salida"].agregar(colas_trama(8, 0, ""))
                responder(0, "connection.open_ok", {})
            }
            si (nm == "channel.open") { responder(ch, "channel.open_ok", {}) }
            si (nm == "confirm.select") {
                srv["confirmar"] = verdadero
                responder(ch, "confirm.select_ok", {})
            }
            si (nm == "exchange.declare") { responder(ch, "exchange.declare_ok", {}) }
            si (nm == "queue.declare") {
                sea q = m["queue"]
                si (q == "") { q = "amq.gen-1" }
                si (tiene_clave(srv["colas"], q) == falso) { srv["colas"][q] = [] }
                responder(ch, "queue.declare_ok", {"queue": q, "message_count": longitud(srv["colas"][q]), "consumer_count": 0})
            }
            si (nm == "queue.bind") { responder(ch, "queue.bind_ok", {}) }
            si (nm == "basic.qos") { responder(ch, "basic.qos_ok", {}) }
            si (nm == "basic.publish") { srv["pendiente"] = {"clave": m["routing_key"], "cuerpo": "", "props": {}} }
            si (nm == "basic.get") {
                sea l = srv["colas"][m["queue"]] ?? []
                si (longitud(l) == 0) { responder(ch, "basic.get_empty", {}) } sino {
                    sea x = l[0]
                    sea resto = []
                    sea k = 1
                    mientras (k < longitud(l)) {
                        resto.agregar(l[k])
                        k = k + 1
                    }
                    srv["colas"][m["queue"]] = resto
                    responder(ch, "basic.get_ok", {"delivery_tag": 100, "exchange": "", "routing_key": m["queue"], "message_count": longitud(resto)})
                    srv["salida"].agregar(colas_trama(2, ch, colas_cabecera(longitud(x["cuerpo"]), x["props"])))
                    // Cuerpo en dos tramas.
                    sea mitad = piso(longitud(x["cuerpo"]) / 2)
                    srv["salida"].agregar(colas_trama(3, ch, subcadena(x["cuerpo"], 0, mitad)))
                    srv["salida"].agregar(colas_trama(3, ch, subcadena(x["cuerpo"], mitad, longitud(x["cuerpo"]))))
                }
            }
            si (nm == "basic.consume") {
                responder(ch, "basic.consume_ok", {"consumer_tag": "ctag-1"})
                sea num = 1
                para x en srv["colas"][m["queue"]] ?? [] {
                    entregar(ch, "ctag-1", m["queue"], x, num)
                    num = num + 1
                }
                srv["colas"][m["queue"]] = []
            }
            si (nm == "basic.ack" o nm == "basic.nack" o nm == "basic.reject") { srv["acks"].agregar([nm, m["delivery_tag"]]) }
            si (nm == "channel.close") { responder(ch, "channel.close_ok", {}) }
            si (nm == "connection.close") {
                responder(0, "connection.close_ok", {})
                srv["cerrado"] = verdadero
            }
        }
    }
}
sea buf = [""]
sea transporte = {
    "enviar": funcion(d) {
        srv["entrada"] = srv["entrada"] + d
        procesar()
    },
    "recibir": funcion(n) {
        mientras (longitud(buf[0]) < n) {
            si (longitud(srv["salida"]) == 0) { lanzar "el servidor falso no tiene nada que mandar" }
            buf[0] = buf[0] + unir(srv["salida"], "")
            srv["salida"] = []
        }
        sea r = subcadena(buf[0], 0, n)
        buf[0] = subcadena(buf[0], n, longitud(buf[0]))
        retornar r
    }
}
sea c = colas_conectar("amqp://ana:secreta@rabbit:5672/prod", {"transporte": transporte})
igual([c["servidor"]["product"], c["frame_max"]], ["Falso", 4096], "apretón de manos")
sea ch = colas_canal(c)
colas_declarar_intercambio(ch, "eventos", "topic", {"durable": verdadero})
igual(colas_declarar_cola(ch, "", nulo)["queue"], "amq.gen-1", "cola anónima")
colas_declarar_cola(ch, "tareas", {"durable": verdadero})
colas_enlazar(ch, "tareas", "eventos", "usuario.*", nulo)
colas_confirmaciones(ch)
// Un cuerpo más grande que frame_max se parte en varias tramas.
sea grande = ""
sea i = 0
mientras (i < 1000) {
    grande = grande + "dato" + i + ";"
    i = i + 1
}
colas_publicar(ch, "", "tareas", grande, {"content_type": "text/plain", "headers": {"n": 1}}, nulo)
colas_publicar(ch, "", "tareas", "segundo", {"delivery_mode": 2}, nulo)
igual(colas_esperar_confirmaciones(ch), verdadero, "confirmaciones")
sea m1 = colas_obtener(ch, "tareas", nulo)
igual([m1["cuerpo"] == grande, m1["propiedades"]["headers"]["n"], m1["quedan"], m1["etiqueta"]], [verdadero, 1, 1, 100], "basic.get")
colas_ack(ch, m1["etiqueta"], nulo)
colas_publicar(ch, "", "tareas", "tercero", nulo, nulo)
colas_qos(ch, 5)
sea etiqueta = colas_consumir(ch, "tareas", nulo)
sea e1 = colas_siguiente(c)
sea e2 = colas_siguiente(c)
igual([etiqueta, e1["cuerpo"], e1["propiedades"]["delivery_mode"], e2["cuerpo"], e2["etiqueta"]], ["ctag-1", "segundo", 2, "tercero", 2], "consumir")
colas_nack(ch, e2["etiqueta"], nulo)
igual(colas_obtener(ch, "tareas", nulo), nulo, "cola vacía")
colas_cerrar_canal(ch)
colas_cerrar(c)
igual([srv["acks"], srv["cerrado"]], [[["basic.ack", 100], ["basic.nack", 2]], verdadero], "acks y cierre")
mostrar("[OK] colas")
