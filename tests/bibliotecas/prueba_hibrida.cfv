importar "hibrida"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion ids(l) {
    sea r = []
    para x en l { r.agregar(x["id"] + ":" + x["fuente"]) }
    retornar r
}
sea h = hibrida_nueva(3, {"campos": {"titulo": 2, "texto": 1}})
hibrida_agregar(h, "d1", {"titulo": "Pago con tarjeta", "texto": "cómo pagar con tarjeta de crédito"}, [1, 0, 0], {"idioma": "es"})
hibrida_agregar(h, "d2", {"titulo": "Devoluciones", "texto": "plazo para devolver un producto"}, [0, 1, 0], {"idioma": "es"})
hibrida_agregar(h, "d3", {"titulo": "Card payment", "texto": "pay with visa or mastercard"}, [0.9, 0.1, 0], {"idioma": "en"})
igual(ids(hibrida_buscar(h, "tarjeta", [1, 0, 0], {"k": 3})), ["d1:ambos", "d3:vector", "d2:vector"], "RRF combina texto y vectores")
igual(ids(hibrida_buscar(h, "tarjeta", [1, 0, 0], {"k": 3, "modo": "ponderado", "filtro": funcion(m) { retornar m["idioma"] == "es" }})), ["d1:ambos", "d2:vector"], "ponderado con filtro")
igual(ids(hibrida_buscar(h, "devolver", nulo, {"alfa": 0})), ["d2:texto"], "solo texto")
igual(ids(hibrida_buscar(h, nulo, [0, 0.2, 1], {"alfa": 1, "k": 1})), ["d2:vector"], "solo vectores")
hibrida_quitar(h, "d2")
igual(ids(hibrida_buscar(h, "devolver", [0, 1, 0], {"k": 5})), ["d3:vector", "d1:vector"], "quitar")
igual(hibrida_buscar(h, "visa", nulo, {"alfa": 0})[0]["doc"]["titulo"], "Card payment", "devuelve el documento")
igual(hibrida_trozos("a b c d e f g h i j", 4, 1), ["a b c d", "d e f g", "g h i j"], "trozos con solape")
sea m = ""
intentar { hibrida_trozos("a b", 2, 2) } capturar (e) { m = e }
igual(m, "hibrida: el solape debe ser menor que el tamaño", "solape inválido")
mostrar("[OK] hibrida")
