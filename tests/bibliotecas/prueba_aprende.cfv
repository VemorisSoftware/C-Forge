importar "aprende"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea X = [[1, 1], [1.2, 0.8], [0.9, 1.1], [5, 5], [5.2, 4.9], [4.8, 5.1], [9, 1], [9.1, 1.2], [8.8, 0.9]]
sea g = aprende_kmedias(X, 3, {"semilla": 7})
sea e = g["etiquetas"]
afirmar(e[0] == e[1] y e[1] == e[2] y e[3] == e[4] y e[4] == e[5] y e[6] == e[7] y e[7] == e[8], "grupos coherentes: " + e)
afirmar(e[0] != e[3] y e[3] != e[6] y e[0] != e[6], "tres grupos distintos")
igual(aprende_kmedias(X, 3, {"semilla": 7})["etiquetas"], e, "reproducible")
igual(aprende_predecir(g, [[9, 0.5]]), [e[6]], "kmedias predice")
afirmar(g["inercia"] < 0.5, "inercia baja")
sea m = aprende_lineal([[1, 2], [2, 1], [3, 4], [4, 3], [5, 5]], [9, 8, 19, 18, 26])
igual([redondear(m["intercepto"], 6), redondear(m["pesos"][0], 6), redondear(m["pesos"][1], 6)], [1, 2, 3], "lineal múltiple exacta")
igual(aprende_predecir(m, [[10, 10]]), [51], "predecir lineal")
sea Xl = [[1], [2], [3], [4], [6], [7], [8], [9]]
sea yl = [0, 0, 0, 0, 1, 1, 1, 1]
sea lg = aprende_logistica(Xl, yl)
igual(aprende_predecir(lg, [[2.5], [7.5]]), [0, 1], "logística")
igual(aprende_exactitud(yl, aprende_predecir(lg, Xl)), 1, "exactitud")
sea p = aprende_probabilidad(lg, [[1], [9]])
afirmar(p[0] < 0.1 y p[1] > 0.9, "probabilidades " + p)
sea kn = aprende_knn(X, ["a", "a", "a", "b", "b", "b", "c", "c", "c"], 3)
igual(aprende_predecir(kn, [[1, 1.3], [8, 2], [4, 4]]), ["a", "c", "b"], "knn")
sea d = aprende_dividir(X, [1, 2, 3, 4, 5, 6, 7, 8, 9], 0.33, 1)
igual([longitud(d["X_prueba"]), longitud(d["X_entrenamiento"])], [3, 6], "dividir")
igual(aprende_dividir(X, [1, 2, 3, 4, 5, 6, 7, 8, 9], 0.33, 1)["y_prueba"], d["y_prueba"], "dividir reproducible")
sea todos = []
para v en d["y_prueba"] { todos.agregar(v) }
para v en d["y_entrenamiento"] { todos.agregar(v) }
igual(ordenar(todos, funcion(a, b) { retornar a - b }), [1, 2, 3, 4, 5, 6, 7, 8, 9], "sin perder filas")
sea esc = aprende_escalador([[1, 10], [3, 10]])
igual(aprende_escalar(esc, [[2, 10]]), [[0, 0]], "escalar")
igual(aprende_confusion(["s", "n", "s", "s"], ["s", "s", "s", "n"]), {"etiquetas": ["n", "s"], "matriz": [[0, 1], [1, 2]]}, "confusión")
sea er = aprende_error([1, 2, 3], [1, 2, 3])
igual([er["ecm"], er["r2"]], [0, 1], "error perfecto")
para malo en [[funcion() { aprende_lineal([[1], [1]], [1, 2]) }, "aprende: columnas linealmente dependientes (sin solución única)"], [funcion() { aprende_logistica([[1]], [2]) }, "aprende: la logística necesita y con 0 y 1"], [funcion() { aprende_kmedias(X, 20) }, "aprende: k entre 1 y la cantidad de puntos"], [funcion() { aprende_lineal([[1, 2], [3]], [1, 2]) }, "aprende: todas las filas de X deben tener 2 columnas"]] {
    sea mm = ""
    intentar { malo[0]() } capturar (x) { mm = x }
    igual(mm, malo[1], malo[1])
}
mostrar("[OK] aprende")
