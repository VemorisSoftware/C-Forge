importar "bandeja"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
igual(bandeja_palabras("=?UTF-8?B?Q2Fmw6k=?= con =?ISO-8859-1?Q?le=F1a?="), "Café con leña", "RFC 2047")
igual(bandeja_qp("10=E2=82=AC y =\r\nfin", falso), "10€ y fin", "quoted-printable")
igual(bandeja_direcciones("\"Ana, la jefa\" <ana@x.cl>, leo@y.cl")[0]["nombre"], "Ana, la jefa", "direcciones")
igual(bandeja_fecha("Sun, 22 Nov 2026 10:00:00 -0300"), 1795352400000, "fecha")
sea armado = bandeja_armar({"de": {"nombre": "Javier Ábrigo", "correo": "j@vemoris.cl"}, "para": ["ana@x.cl"], "asunto": "Informe ñ", "texto": "Hola", "html": "<b>Hola</b>", "adjuntos": [{"nombre": "a.txt", "tipo": "text/plain", "datos": "contenido"}]})
sea m = bandeja_mime(armado)
igual([m["asunto"], m["de"][0]["nombre"], m["de"][0]["correo"], texto_recortar(m["texto"]), m["html"], m["adjuntos"][0]["nombre"], m["adjuntos"][0]["datos"]], ["Informe ñ", "Javier Ábrigo", "j@vemoris.cl", "Hola", "<b>Hola</b>", "a.txt", "contenido"], "armar y leer")
sea st = bandeja_imap_nueva()
igual(bandeja_imap_login(st, "ana@x.cl", "cla\"ve")["linea"], "A1 LOGIN \"ana@x.cl\" \"cla\\\"ve\"\r\n", "LOGIN")
sea resp = "* 1 FETCH (UID 42 FLAGS (\\Seen) RFC822.SIZE 120 BODY[HEADER.FIELDS (SUBJECT)] {17}\r\nSubject: Hola\r\n\r\n)\r\nA2 OK FETCH completed\r\n"
sea r = bandeja_imap_respuesta(resp, "A2")
igual(r["estado"], "OK", "estado IMAP")
sea f = bandeja_imap_fetch(r)
igual([f["1"]["UID"], f["1"]["FLAGS"], f["1"]["RFC822.SIZE"], f["1"]["BODY[HEADER.FIELDS (SUBJECT)]"]], [42, ["\\Seen"], 120, "Subject: Hola\r\n\r\n"], "FETCH con literal")
igual(bandeja_imap_search(bandeja_imap_respuesta("* SEARCH 2 84 882\r\nA3 OK done\r\n", "A3")), [2, 84, 882], "SEARCH")
igual(bandeja_imap_list(bandeja_imap_respuesta("* LIST (\\HasNoChildren) \"/\" \"INBOX\"\r\nA4 OK\r\n", "A4"))[0]["nombre"], "INBOX", "LIST")
igual(bandeja_pop3_multilinea("+OK\r\nSubject: x\r\n\r\n..punto\r\n.\r\n"), "Subject: x\r\n\r\n.punto", "POP3")
mostrar("[OK] bandeja")
