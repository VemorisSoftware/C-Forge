importar "vela"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea X = [[1, 1], [1.2, 0.8], [0.9, 1.1], [5, 5], [5.2, 4.9], [4.8, 5.1], [9, 1], [9.1, 1.2], [8.8, 0.9]]
sea y = ["a", "a", "a", "b", "b", "b", "c", "c", "c"]
sea t = vela_arbol(X, y)
igual(vela_predecir(t, [[1, 1.3], [8, 2], [4, 4]]), ["a", "c", "b"], "árbol clasifica")
igual(vela_texto(t, ["ancho", "alto"]), "ancho <= 3\n  → a (3)\nancho > 3\n  ancho <= 7\n    → b (3)\n  ancho > 7\n    → c (3)", "árbol legible")
igual(vela_importancia(t, 2), [1, 0], "importancia del árbol")
sea b = vela_bosque(X, y, {"arboles": 25, "semilla": 3})
igual(vela_predecir(b, [[1, 1.3], [8, 2], [4, 4]]), ["a", "c", "b"], "bosque vota")
sea b2 = vela_bosque(X, y, {"arboles": 25, "semilla": 3})
igual(vela_importancia(b, 2), vela_importancia(b2, 2), "bosque reproducible con semilla")
sea r = vela_arbol([[1], [2], [3], [4], [5], [6]], [1.1, 1.9, 3.2, 3.9, 5.1, 6.0], {"profundidad": 2})
igual(vela_predecir(r, [[1.2], [5.5]]), [1.5, 5.55], "árbol de regresión")
igual(vela_predecir(vela_arbol(X, y, {"profundidad": 0}), [[9, 1]]), ["a"], "profundidad 0 = mayoría")
igual(vela_predecir(vela_bayes(X, y), [[1, 1.3], [8, 2]]), ["a", "c"], "Naive Bayes gaussiano")
sea nb = vela_bayes_texto(["oferta gratis gana dinero", "gratis premio ya", "reunión mañana a las diez", "informe de ventas adjunto"], ["spam", "spam", "ok", "ok"])
igual(vela_predecir(nb, ["¡Dinero GRATIS!", "el informe de la reunión"]), ["spam", "ok"], "Naive Bayes de texto")
sea pu = vela_puntajes(nb, "gratis")
afirmar(pu["spam"] > pu["ok"], "puntajes")
sea m = ""
intentar { vela_arbol([[1]], [1, 2]) } capturar (e) { m = e }
igual(m, "vela: X e y deben tener el mismo largo (y no estar vacíos)", "largos distintos")
mostrar("[OK] vela")
