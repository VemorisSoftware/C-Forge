importar "extremo"
importar "molde"
sea Usuario = molde_registro({"id": "entero", "nombre": "texto", "correo": molde_opcional("texto")})
sea usuarios = [{"id": 1, "nombre": "Ana", "correo": "ana@x.cl"}]
sea auth = extremo_middleware(funcion(ctx, siguiente) {
    si (ctx["usuario"] == nulo) { lanzar extremo_error("UNAUTHORIZED", "Falta iniciar sesión") }
    retornar siguiente(ctx)
})
funcion router() {
    retornar extremo_enrutador({
        "saludar": extremo_consulta(molde_registro({"nombre": "texto"}), funcion(e, ctx) { retornar "Hola " + e["nombre"] }),
        "hora": extremo_consulta(nulo, funcion(e, ctx) { retornar 42 }),
        "usuario": extremo_enrutador({
            "obtener": extremo_consulta(molde_registro({"id": "entero"}), funcion(e, ctx) {
                para u en usuarios { si (u["id"] == e["id"]) { retornar u } }
                lanzar extremo_error("NOT_FOUND", "No existe el usuario " + e["id"])
            }, {"salida": Usuario}),
            "crear": extremo_mutacion(molde_registro({"nombre": "texto"}), funcion(e, ctx) {
                sea u = {"id": longitud(usuarios) + 1, "nombre": e["nombre"], "correo": nulo}
                usuarios.agregar(u)
                retornar u
            }, {"salida": Usuario, "middlewares": [auth]})
        })
    })
}
importar "json"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Probado también contra el cliente oficial @trpc/client v11 (httpLink y httpBatchLink).
sea app = router()
sea ctx = funcion(s) {
    sea u = nulo
    si (((s["cabeceras"] ?? {})["authorization"] ?? "") == "Bearer clave") { u = "admin" }
    retornar {"usuario": u}
}
funcion pedir(metodo, ruta, cuerpo, cab) {
    sea r = extremo_manejar(app, {"metodo": metodo, "ruta": ruta, "cuerpo": cuerpo ?? "", "cabeceras": cab ?? {}}, {"contexto": ctx})
    retornar [r["estado"], json_parsear(r["cuerpo"])]
}
igual(pedir("GET", "/trpc/saludar?input=%7B%22nombre%22%3A%22Leo%22%7D"), [200, {"result": {"data": "Hola Leo"}}], "consulta")
igual(pedir("GET", "/trpc/usuario.obtener?input=%7B%22id%22%3A1%7D")[1]["result"]["data"]["nombre"], "Ana", "anidado")
sea nf = pedir("GET", "/trpc/usuario.obtener?input=%7B%22id%22%3A9%7D")
igual([nf[0], nf[1]["error"]["code"], nf[1]["error"]["data"]["code"], nf[1]["error"]["data"]["path"]], [404, -32004, "NOT_FOUND", "usuario.obtener"], "error tRPC")
igual(pedir("GET", "/trpc/usuario.obtener?input=%7B%22id%22%3A%22x%22%7D")[1]["error"]["data"]["code"], "BAD_REQUEST", "validación")
igual(pedir("POST", "/trpc/usuario.crear", "{\"nombre\": \"Eva\"}")[0], 401, "middleware")
sea creado = pedir("POST", "/trpc/usuario.crear", "{\"nombre\": \"Eva\"}", {"authorization": "Bearer clave"})
igual([creado[0], creado[1]["result"]["data"]["id"]], [200, 2], "mutación")
igual(pedir("POST", "/trpc/saludar", "{}")[1]["error"]["data"]["code"], "METHOD_NOT_SUPPORTED", "consulta por POST")
igual(pedir("GET", "/trpc/nada")[1]["error"]["data"]["code"], "NOT_FOUND", "ruta inexistente")
sea lote = pedir("GET", "/trpc/saludar,hora,nada?batch=1&input=%7B%220%22%3A%7B%22nombre%22%3A%22A%22%7D%7D")
igual([lote[0], lote[1][0]["result"]["data"], lote[1][1]["result"]["data"], lote[1][2]["error"]["data"]["code"]], [207, "Hola A", 42, "NOT_FOUND"], "lote")
igual(extremo_llamar(app, "saludar", {"nombre": "Sol"}, {}), "Hola Sol", "llamar directo")
sea err = nulo
intentar { extremo_llamar(app, "usuario.crear", {"nombre": "X"}, {"usuario": nulo}) } capturar (e) { err = e }
igual(extremo_mensaje(err), "UNAUTHORIZED: Falta iniciar sesión", "error directo")
sea ts = extremo_tipos_ts(app, "AppRouter")
afirmar(texto_indice(ts, "obtener: " + caracter(123) + " type: \"query\"; input: " + caracter(123) + " id: number " + caracter(125) + "; output: " + caracter(123) + " correo?: string | null; id: number; nombre: string " + caracter(125) + " " + caracter(125)) >= 0, "tipos TS: " + ts)
afirmar(texto_indice(ts, "hora: " + caracter(123) + " type: \"query\"; input: void; output: unknown") >= 0, "tipos sin molde")
mostrar("[OK] extremo")
