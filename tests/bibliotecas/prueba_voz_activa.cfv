importar "voz_activa"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Contra py-webrtcvad, con ruido y tonos armónicos a 8, 16, 32 y 48 kHz,
// modos 0 y 3, cuadros de 10 y 30 ms: las decisiones coinciden todas.
// Aquí, una señal entera (ruido de un LCG y una sierra con envolvente) cuyas
// decisiones esperadas salieron de py-webrtcvad.
funcion senal(fs, n, ini, fin) {
    sea st = 12345
    sea per = piso(fs / 150)
    sea cuarto = piso(fs / 4)
    sea p = []
    sea i = 0
    mientras (i < n) {
        st = (st * 1103515245 + 12345) % 2147483648
        sea x = piso(st / 65536) % 401 - 200
        si (i >= ini y i < fin) {
            sea saw = piso((i % per) * 12000 / per) - 6000
            sea env = piso((i % cuarto) * 4 / cuarto) + 1
            x = x + piso(saw * env / 4)
        }
        si (x < 0) { x = x + 65536 }
        p.agregar(bytes_entero(x, 2, 1))
        i = i + 1
    }
    retornar unir(p, "")
}
funcion texto_de(l) {
    sea r = []
    para x en l { si (x) { r.agregar("1") } sino { r.agregar("0") } }
    retornar unir(r, "")
}
para caso en [[16000, 2, 20, "111100000000000111111111111111111111000000000"], [8000, 0, 30, "111100000011111111111111110000"], [32000, 3, 10, "111111100000000000000000000000111111111111111111111111111111111111111100000000000000000000"], [48000, 1, 10, "111111111100000000000000000000111111111111111111111111111111111111111111111100000000000000"]] {
    sea fs = caso[0]
    sea n = piso(fs * 0.9)
    sea pcm = senal(fs, n, piso(fs * 0.3), piso(fs * 0.6))
    igual(texto_de(voz_decisiones(voz_nuevo(caso[1]), pcm, fs, caso[2])), caso[3], "decisiones a " + fs)
}
igual([voz_cuadro_valido(16000, 320), voz_cuadro_valido(16000, 300), voz_cuadro_valido(44100, 441)], [verdadero, falso, falso], "cuadros válidos")
sea err = nulo
intentar { voz_nuevo(4) } capturar (e) { err = e }
igual(err, "vad: el modo va de 0 a 3", "modo inválido")
// Segmentos con relleno de 300 ms.
sea pcm = senal(16000, 16000 * 2, 8000, 20000)
sea segs = voz_segmentos(voz_nuevo(2), pcm, 16000, 30, 300)
igual(longitud(segs) >= 1, verdadero, "hay segmentos")
igual([segs[longitud(segs) - 1]["inicio_ms"] <= 600, segs[longitud(segs) - 1]["fin_ms"] >= 1200], [verdadero, verdadero], "segmento de voz")
mostrar("[OK] voz_activa")
