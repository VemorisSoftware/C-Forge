importar "cola"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea t = [0]
sea c = cola_con_reloj(cola_nueva(), funcion() { retornar t[0] })
sea hechos = []
sea m = {"a": funcion(d) { hechos.agregar(d) }, "falla": funcion(d) { lanzar "caído " + d }}
cola_agregar(c, "a", 1)
cola_agregar(c, "a", 2, {"prioridad": 5})
cola_agregar(c, "a", 3, {"retraso_ms": 100})
cola_agregar(c, "falla", 4, {"intentos": 3, "espera_ms": 50})
igual(cola_agregar(c, "a", 5, {"id": "único"}), "único", "id propio")
igual(cola_agregar(c, "a", 6, {"id": "único"}), "único", "sin duplicados")
cola_agregar(c, "otro", 7)
igual(cola_procesar(c, m), 5, "corre los listos")
igual(hechos, [2, 1, 5], "prioridad y orden")
igual(cola_estado(c), {"fallidos": 1, "hechos": 3, "listos": 0, "pendientes": 2}, "estado")
igual(c["fallidos"][0]["error"], "sin manejador para otro", "sin manejador")
t[0] = 50
cola_procesar(c, m)
igual(cola_estado(c)["pendientes"], 2, "reintento 1 programado a +100")
t[0] = 150
cola_procesar(c, m)
igual(hechos, [2, 1, 5, 3], "retrasado")
igual(cola_estado(c), {"fallidos": 2, "hechos": 4, "listos": 0, "pendientes": 0}, "agota intentos")
igual(c["fallidos"][1]["error"] + " " + c["fallidos"][1]["hechos"], "caído 4 3", "último error")
igual(cola_reintentar_fallidos(c), 2, "reintentar fallidos")
igual(cola_procesar(c, {"a": funcion(d) { }, "otro": funcion(d) { }, "falla": funcion(d) { }}), 2, "ahora salen bien")
cola_agregar(c, "a", {"x": [1, 2]}, {"retraso_ms": 10})
cola_guardar(c, "/tmp/cforge-cola-prueba.json")
sea c2 = cola_cargar("/tmp/cforge-cola-prueba.json")
igual(c2["pendientes"][0]["datos"], {"x": [1, 2]}, "guardar y cargar")
igual(cola_agregar(c2, "a", 0) != "1", verdadero, "ids siguen")
eliminar_archivo("/tmp/cforge-cola-prueba.json")
igual(cola_procesar(c2, m, 1) <= 1, verdadero, "límite")
mostrar("[OK] cola")
