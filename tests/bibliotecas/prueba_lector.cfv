// Pruebas de lector. Las páginas de datos/lector las dibuja Pillow con
// DejaVu Sans (20, 24, 28 y 40 px; texto oscuro, texto claro sobre fondo
// oscuro y una con desenfoque); Tesseract 5 lee bien tres de las cuatro
// (confunde la ü). Las cajas de esperado.json salen de Tesseract (tsv).
importar "lector"
importar "json"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

sea e = json_parsear(leer_archivo("tests/bibliotecas/datos/lector/esperado.json"))
sea m = lector_modelo(fuente_cargar("tests/graficos/datos/DejaVuSans-latin.ttf"), nulo)
afirmar(texto_contiene(lector_alfabeto(m), "¡¿") y texto_contiene(lector_alfabeto(m), "ñ"), "alfabeto")
para k en ["pagina20", "pagina28", "inverso24", "titulo40"] {
    eq(lector_texto(imagen_cargar("tests/bibliotecas/datos/lector/" + k + ".png"), m), e[k], k)
}

sea pal = lector_datos(imagen_cargar("tests/bibliotecas/datos/lector/titulo40.png"), m)
eq(longitud(pal), longitud(e["cajas_titulo40"]), "palabras")
para i en lista_rango(0, longitud(pal)) {
    sea t = e["cajas_titulo40"][i]
    eq(pal[i]["texto"], t[0], "palabra " + i)
    para j en lista_rango(0, 4) { afirmar(absoluto(pal[i]["caja"][j] - t[j + 1]) <= 2, "caja de " + t[0]) }
    afirmar(pal[i]["confianza"] > 60, "confianza de " + t[0])
}
eq([pal[0]["renglon"], pal[2]["renglon"]], [0, 1], "renglones")

// Binarización: la tinta es la clase minoritaria.
sea b = lector_binarizar(imagen_cargar("tests/bibliotecas/datos/lector/inverso24.png"))
sea tinta = 0
para v en b["tinta"] { tinta = tinta + v }
afirmar(tinta * 4 < longitud(b["tinta"]), "texto claro detectado como tinta")
eq(lector_texto(imagen_nueva(30, 20, [255, 255, 255, 255]), m), "", "página en blanco")
mostrar("[OK] lector")
