importar "fichas"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Tokenizadores mínimos exportados con la librería tokenizers de Hugging Face;
// los resultados esperados salen de esa misma librería.
sea WP = {"version": "1.0", "truncation": nulo, "padding": nulo, "added_tokens": [{"id": 0, "content": "[PAD]", "single_word": falso, "lstrip": falso, "rstrip": falso, "normalized": falso, "special": verdadero}, {"id": 1, "content": "[UNK]", "single_word": falso, "lstrip": falso, "rstrip": falso, "normalized": falso, "special": verdadero}, {"id": 2, "content": "[CLS]", "single_word": falso, "lstrip": falso, "rstrip": falso, "normalized": falso, "special": verdadero}, {"id": 3, "content": "[SEP]", "single_word": falso, "lstrip": falso, "rstrip": falso, "normalized": falso, "special": verdadero}], "normalizer": {"type": "BertNormalizer", "clean_text": verdadero, "handle_chinese_chars": verdadero, "strip_accents": nulo, "lowercase": verdadero}, "pre_tokenizer": {"type": "BertPreTokenizer"}, "post_processor": {"type": "TemplateProcessing", "single": [{"SpecialToken": {"id": "[CLS]", "type_id": 0}}, {"Sequence": {"id": "A", "type_id": 0}}, {"SpecialToken": {"id": "[SEP]", "type_id": 0}}], "pair": [{"SpecialToken": {"id": "[CLS]", "type_id": 0}}, {"Sequence": {"id": "A", "type_id": 0}}, {"SpecialToken": {"id": "[SEP]", "type_id": 0}}, {"Sequence": {"id": "B", "type_id": 1}}, {"SpecialToken": {"id": "[SEP]", "type_id": 1}}], "special_tokens": {"[CLS]": {"id": "[CLS]", "ids": [2], "tokens": ["[CLS]"]}, "[SEP]": {"id": "[SEP]", "ids": [3], "tokens": ["[SEP]"]}}}, "decoder": {"type": "WordPiece", "prefix": "##", "cleanup": verdadero}, "model": {"type": "WordPiece", "unk_token": "[UNK]", "continuing_subword_prefix": "##", "max_input_chars_per_word": 100, "vocab": {"[PAD]": 0, "[UNK]": 1, "[CLS]": 2, "[SEP]": 3, "hola": 4, "mundo": 5, "el": 6, "nino": 7, "##s": 8, "com": 9, "##io": 10, "##e": 11, "nand": 12, "##u": 13, "!": 14, "¿": 15, "?": 16, "jug": 17, "##ar": 18, "##ando": 19, "a": 20, "b": 21}}}
sea BPE = {"version": "1.0", "truncation": nulo, "padding": nulo, "added_tokens": [], "normalizer": nulo, "pre_tokenizer": {"type": "Whitespace"}, "post_processor": nulo, "decoder": nulo, "model": {"type": "BPE", "dropout": nulo, "unk_token": "<unk>", "continuing_subword_prefix": nulo, "end_of_word_suffix": nulo, "fuse_unk": falso, "byte_fallback": falso, "ignore_merges": falso, "vocab": {"<unk>": 0, "h": 1, "o": 2, "l": 3, "a": 4, "m": 5, "u": 6, "n": 7, "d": 8, "ho": 9, "la": 10, "hola": 11, "mu": 12, "nd": 13, "mund": 14, "mundo": 15}, "merges": [["h", "o"], ["l", "a"], ["ho", "la"], ["m", "u"], ["n", "d"], ["mu", "nd"], ["mund", "o"]]}}
sea wp = fichas_cargar(WP)
sea r = fichas_codificar(wp, "¡Hola, MUNDO! El niño comió ñandú")
igual([r["ids"], r["fichas"]], [[2, 1, 4, 1, 5, 14, 6, 7, 9, 10, 12, 13, 3], ["[CLS]", "[UNK]", "hola", "[UNK]", "mundo", "!", "el", "nino", "com", "##io", "nand", "##u", "[SEP]"]], "WordPiece")
igual(fichas_decodificar(wp, r["ids"]), "hola mundo! el nino comio nandu", "decodificar WordPiece")
igual(fichas_codificar(wp, "jugando xyz")["ids"], [2, 17, 19, 1, 3], "subpalabras")
sea par = fichas_codificar(wp, "hola", "mundo")
igual([par["ids"], par["tipos"]], [[2, 4, 3, 5, 3], [0, 0, 0, 1, 1]], "pares")
sea rel = fichas_codificar(wp, "hola", nulo, {"rellenar_hasta": 5})
igual([rel["ids"], rel["atencion"]], [[2, 4, 3, 0, 0], [1, 1, 1, 0, 0]], "relleno")
igual(fichas_codificar(wp, "hola mundo hola", nulo, {"largo_maximo": 3})["ids"], [2, 4, 5], "truncar")
sea bpe = fichas_cargar(BPE)
igual(fichas_codificar(bpe, "hola mundo")["ids"], [11, 15], "BPE")
igual(fichas_codificar(bpe, "holx mundial")["fichas"], ["ho", "l", "<unk>", "mund", "<unk>", "a", "l"], "BPE con desconocidas")
// BPE propio a nivel de bytes: nunca hay desconocidas y la vuelta es exacta.
sea corpus = ["el perro come", "el gato come", "los perros comen", "las gatas comen pescado", "¡ñandú! 🎉 emoji", "el perro y el gato"]
sea t = fichas_bpe_entrenar(corpus, {"vocabulario": 290, "min_frecuencia": 2})
afirmar(fichas_tamano_vocabulario(t) > 257, "vocabulario entrenado")
para s en ["el perro come pescado", "texto nuevo: 中文 😀", "<|endoftext|>fin"] {
    sea c = fichas_codificar(t, s)
    igual(fichas_decodificar(t, c["ids"], falso), s, "vuelta exacta")
}
igual(fichas_codificar(t, "<|endoftext|>")["ids"], [0], "token especial")
sea re = fichas_cargar(fichas_guardar(t))
igual(fichas_codificar(re, "el perro")["ids"], fichas_codificar(t, "el perro")["ids"], "guardar y cargar")
afirmar(longitud(fichas_codificar(t, "el perro come")["ids"]) < longitud("el perro come"), "comprime")
mostrar("[OK] fichas")
