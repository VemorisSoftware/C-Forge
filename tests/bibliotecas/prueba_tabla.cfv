importar "tabla"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea t = tabla_desde_csv("region,producto,monto,activo\nNorte,café,1200,true\nSur,té,800,false\nNorte,té,500,true\nSur,café,,true\nCentro,café,2000,false\n")
igual([tabla_nombres(t), tabla_largo(t)], [["region", "producto", "monto", "activo"], 5], "CSV")
igual(tabla_columna(t, "monto"), [1200, 800, 500, nulo, 2000], "números y nulos")
igual(tabla_columna(t, "activo"), [verdadero, falso, verdadero, verdadero, falso], "booleanos")
sea g = tabla_agrupar(t, ["region"], {"total": ["monto", "suma"], "n": ["monto", "cuenta"], "prod": ["producto", "unicos"], "media": ["monto", "media"], "max": ["monto", "max"]})
igual(tabla_filas(g), [{"max": 1200, "media": 850, "n": 2, "prod": 2, "region": "Norte", "total": 1700}, {"max": 800, "media": 800, "n": 1, "prod": 2, "region": "Sur", "total": 800}, {"max": 2000, "media": 2000, "n": 1, "prod": 1, "region": "Centro", "total": 2000}], "agrupar en orden de aparición")
igual(tabla_columna(tabla_ordenar(g, "total", verdadero), "region"), ["Centro", "Norte", "Sur"], "ordenar descendente")
igual(tabla_columna(tabla_ordenar(t, "monto"), "monto"), [500, 800, 1200, 2000, nulo], "nulos al final")
igual(tabla_columna(tabla_ordenar(t, ["producto", "monto"]), "monto"), [1200, 2000, nulo, 500, 800], "varias columnas, estable")
sea dos = tabla_agrupar(t, ["region", "producto"], {"n": ["monto", "cuenta"]})
igual(tabla_largo(dos), 5, "agrupar por dos columnas")
igual(tabla_columna(tabla_filtrar(t, funcion(f) { retornar f["activo"] }), "region"), ["Norte", "Norte", "Sur"], "filtrar")
sea j = tabla_de([{"region": "Norte", "jefe": "Ana"}, {"region": "Sur", "jefe": "Luis"}, {"region": "Sur", "jefe": "Eva"}])
igual(tabla_columna(tabla_unir(g, j, "region"), "jefe"), ["Ana", "Luis", "Eva"], "unión interna (uno a muchos)")
igual(tabla_columna(tabla_unir(g, j, "region", "izquierda"), "jefe"), ["Ana", "Luis", "Eva", nulo], "unión izquierda")
sea c = tabla_calcular(t, "iva", funcion(f) { si (f["monto"] == nulo) { retornar nulo }  retornar f["monto"] * 19 / 100 })
igual(tabla_columna(c, "iva"), [228, 152, 95, nulo, 380], "columna calculada")
igual(tabla_nombres(tabla_seleccionar(c, ["iva", "region"])), ["iva", "region"], "seleccionar")
igual(tabla_nombres(tabla_renombrar(t, {"monto": "total"})), ["region", "producto", "total", "activo"], "renombrar")
igual(tabla_largo(tabla_cabeza(t, 2)), 2, "cabeza")
sea d = tabla_filas(tabla_describir(t))
igual([longitud(d), d[0]["columna"], d[0]["n"], d[0]["nulos"], d[0]["media"], d[0]["min"], d[0]["max"]], [1, "monto", 4, 1, 1125, 500, 2000], "describir")
igual(tabla_csv(tabla_cabeza(t, 2)), "region,producto,monto,activo\r\nNorte,café,1200,verdadero\r\nSur,té,800,falso\r\n", "a CSV")
igual(tabla_csv(tabla_de([{"a": "=1+1"}]), ",", verdadero), "a\r\n'=1+1\r\n", "CSV seguro")
sea k = tabla_columnas({"x": [1, 2], "y": ["a", "b"]}, ["y", "x"])
igual(tabla_filas(k), [{"x": 1, "y": "a"}, {"x": 2, "y": "b"}], "desde columnas")
afirmar(texto_indice(tabla_texto(t, 2), "… 3 filas más") >= 0, "texto con límite")
sea m = ""
intentar { tabla_columna(t, "precio") } capturar (e) { m = e }
igual(m, "tabla: no existe la columna precio", "columna inexistente")
intentar { tabla_agrupar(t, ["region"], {"x": ["monto", "mediana"]}) } capturar (e) { m = e }
igual(m, "tabla: agregación desconocida mediana", "agregación desconocida")
mostrar("[OK] tabla")
