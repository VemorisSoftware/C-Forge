// Pruebas de tunel (WireGuard). La interoperabilidad se probó aparte con
// boringtun: como iniciador (con y sin psk, 5 paquetes de ida y vuelta) y
// como respondedor.
importar "tunel"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// BLAKE2s (RFC 7693) y HChaCha20 (draft-irtf-cfrg-xchacha).
eq(hex_de_bytes(tunel_blake2s("abc", 32, nulo)), "508c5e8c327c14e2e1a72ba34eeb452f37458b209ed63a294d999b4c86675982", "blake2s abc")
sea k = ""
sea i = 0
mientras (i < 32) {
    k = k + char_de(i)
    i = i + 1
}
eq(hex_de_bytes(tunel_blake2s("", 32, k)), "48a8997da407876b3d79c0d92325ad3b89cbb754d86ab71aee047ad345fd2c49", "blake2s con clave")
sea largo = ""
i = 0
mientras (i < 200) {
    largo = largo + char_de(i % 251)
    i = i + 1
}
eq(hex_de_bytes(tunel_blake2s(largo, 16, nulo)), "60e1aeb835cbdc82f24af34585a9df13", "blake2s varios bloques")
eq(hex_de_bytes(_tu_hchacha20(bytes_de_hex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"), bytes_de_hex("000000090000004a0000000031415927"))),
    "82413b4227b27bfed30e42508a877d73a0f9e4d58a74a853c12ec41326d3ecdc", "hchacha20")
sea n24 = bytes_aleatorios(24)
eq(tunel_xchacha_descifrar(k, n24, tunel_xchacha_cifrar(k, n24, "secreto", "ad"), "ad"), "secreto", "xchacha20-poly1305")
// Claves como las de wg.
sea a = tunel_claves(nulo)
sea b = tunel_claves(nulo)
eq([longitud(a["privada_b64"]), longitud(a["publica"])], [44, 32], "claves")
eq(tunel_claves(a["privada_b64"])["publica_b64"], a["publica_b64"], "desde base64")
// Apretón de manos y datos.
sea ta = tunel_nuevo(a["privada"], b["publica_b64"], {"keepalive": 25})
sea tb = tunel_nuevo(b["privada_b64"], a["publica"], nulo)
sea p1 = tunel_paquete_udp("10.0.0.1", "10.0.0.2", 1234, 53, "hola")
sea ini = tunel_cifrar(ta, p1)
eq([longitud(ini), longitud(ini[0]), bytes_leer_entero(ini[0], 0, 4, 1)], [1, 148, 1], "iniciación")
eq(tunel_estado(ta)["sesion"], falso, "aún sin sesión")
sea r1 = tunel_recibir(tb, ini[0], "1.2.3.4:5")
eq([r1["evento"], longitud(r1["enviar"][0]), r1["errores"]], ["sesion", 92, []], "respuesta")
// El respondedor espera el primer dato antes de mandar.
eq(longitud(tunel_cifrar(tb, "x")), 0, "respondedor espera")
sea r2 = tunel_recibir(ta, r1["enviar"][0], nulo)
eq([r2["evento"], longitud(r2["enviar"])], ["sesion", 1], "sesión del iniciador y paquete pendiente")
sea r3 = tunel_recibir(tb, r2["enviar"][0], nulo)
eq(r3["paquetes"], [p1], "llega el paquete (sin relleno)")
eq(longitud(r3["enviar"]), 1, "sale lo que esperaba el respondedor")
sea r4 = tunel_recibir(ta, r3["enviar"][0], nulo)
eq(longitud(r4["paquetes"][0]), 16, "dato con relleno a 16")
// De vuelta y repeticiones.
sea p2 = tunel_paquete_udp("10.0.0.2", "10.0.0.1", 53, 1234, "respuesta")
sea c2 = tunel_cifrar(tb, p2)[0]
eq(tunel_recibir(ta, c2, nulo)["paquetes"], [p2], "de vuelta")
eq(tunel_recibir(ta, c2, nulo)["errores"], ["paquete repetido"], "repetición")
sea malo = subtexto(c2, 0, 20) + char_de(bits_xo(byte_en(c2, 20), 1)) + subtexto(c2, 21, longitud(c2))
eq(tunel_recibir(ta, malo, nulo)["errores"], ["paquete que no se pudo descifrar"], "alterado")
// Desorden dentro de la ventana.
sea x1 = tunel_cifrar(ta, p1)[0]
sea x2 = tunel_cifrar(ta, p1)[0]
eq([longitud(tunel_recibir(tb, x2, nulo)["paquetes"]), longitud(tunel_recibir(tb, x1, nulo)["paquetes"])], [1, 1], "desordenados")
// Keepalive.
eq(tunel_recibir(tb, tunel_keepalive(ta, verdadero), nulo)["evento"], "keepalive", "keepalive")
eq(tunel_keepalive(ta, falso), nulo, "no hace falta todavía")
eq(tunel_estado(ta)["iniciador"], verdadero, "estado")
// La misma iniciación dos veces se rechaza.
eq(tunel_recibir(tb, ini[0], nulo)["errores"], ["iniciación repetida"], "iniciación repetida")
// Un par desconocido no pasa, ni un mac1 malo.
sea c = tunel_claves(nulo)
sea tc = tunel_nuevo(c["privada"], b["publica"], nulo)
eq(tunel_recibir(tb, tunel_iniciar(tc), nulo)["errores"], ["iniciación de un par desconocido"], "par desconocido")
sea i2 = tunel_iniciar(ta)
eq(tunel_recibir(tb, subtexto(i2, 0, 120) + "xxxx" + subtexto(i2, 124, 148), nulo), {"enviar": [], "errores": [], "evento": nulo, "paquetes": []}, "mac1 malo se ignora")
// PSK distinto: la respuesta no abre.
sea tp1 = tunel_nuevo(a["privada"], b["publica"], {"psk": bytes_aleatorios(32)})
sea tp2 = tunel_nuevo(b["privada"], a["publica"], {"psk": bytes_aleatorios(32)})
sea rp = tunel_recibir(tp2, tunel_iniciar(tp1), nulo)
eq(tunel_recibir(tp1, rp["enviar"][0], nulo)["errores"], ["respuesta que no se pudo descifrar"], "psk distinto")
// Bajo carga: primero cookie, luego pasa con mac2.
sea td = tunel_nuevo(b["privada"], a["publica"], nulo)
tunel_bajo_carga(td, verdadero)
sea te = tunel_nuevo(a["privada"], b["publica"], nulo)
sea rc = tunel_recibir(td, tunel_iniciar(te), "9.9.9.9:1")
eq([longitud(rc["enviar"]), longitud(rc["enviar"][0]), bytes_leer_entero(rc["enviar"][0], 0, 4, 1)], [1, 64, 3], "pide cookie")
eq(tunel_recibir(te, rc["enviar"][0], nulo)["evento"], "cookie", "cookie recibida")
eq(tunel_recibir(td, tunel_iniciar(te), "9.9.9.9:1")["evento"], "sesion", "con mac2 pasa")
mostrar("[OK] tunel")
