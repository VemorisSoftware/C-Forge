importar "json"
importar "bitacora"
funcion igual(a, b, q) { afirmar(a == b, q + ": [" + a + "] != [" + b + "]") }
sea b = bitacora_a_lista(bitacora_nueva("info", "texto"))
bitacora_depuracion(b, "no se ve")
bitacora_info(b, "pedido creado", {"id": 42})
bitacora_error(b, "falló", {"motivo": "sin saldo"})
igual(longitud(b["registros"]), 2, "filtra por nivel")
igual(b["registros"][0], "INFO \"pedido creado\" id=42", "texto")
igual(b["registros"][1], "ERROR falló motivo=\"sin saldo\"", "comillas cuando hace falta")
// Inyección de líneas: los saltos se escapan.
bitacora_aviso(b, "ok\nERROR falso", {"x": "a\nb"})
igual(b["registros"][2], "AVISO \"ok\\nERROR falso\" x=a\\nb", "sin inyección de líneas")
sea j = bitacora_a_lista(bitacora_nueva("depuracion", "json"))
sea hija = bitacora_con(j, {"peticion": "r-1"})
bitacora_info(hija, "hola", {"n": 1})
sea d = json_parsear(j["registros"][0])
igual(d["nivel"] + " " + d["mensaje"] + " " + d["peticion"] + " " + d["n"], "info hola r-1 1", "json con contexto")
afirmar(d["ts"] > 0, "marca de tiempo")
sea m = ""
intentar { bitacora_nueva("ruido") } capturar (e) { m = e }
igual(m, "bitacora: nivel desconocido ruido", "nivel inválido")
mostrar("[OK] bitacora")
