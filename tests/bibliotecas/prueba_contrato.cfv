importar "contrato"
importar "esquema"
importar "json"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea api = contrato_nuevo("Tienda", "2.1.0", "API de la tienda")
contrato_servidor(api, "https://api.ejemplo.cl")
sea prod = contrato_componente(api, "Producto", esquema_estricto(esquema_objeto({
    "sku": esquema_patron(esquema_texto(), "[A-Z]+[0-9]+"),
    "precio": esquema_min(esquema_entero(), 0),
    "estado": esquema_defecto(esquema_uno_de(esquema_texto(), ["activo", "pausado"]), "activo"),
    "correo": esquema_opcional(esquema_correo(esquema_texto())),
    "tags": esquema_opcional(esquema_max(esquema_lista(esquema_texto()), 5))
})))
contrato_seguridad(api, "jwt", "bearer")
contrato_ruta(api, "GET", "/productos/:id", {"resumen": "Un producto", "etiquetas": ["productos"], "respuestas": {"200": prod, "404": "No existe"}})
contrato_ruta(api, "POST", "/productos", {"cuerpo": prod, "seguridad": ["jwt"], "consulta": {"borrador": esquema_opcional(esquema_booleano())}, "respuestas": {"201": prod, "422": nulo}})
sea d = json_parsear(contrato_json(api))
igual(d["openapi"] + " " + d["info"]["title"] + " " + d["info"]["version"], "3.1.0 Tienda 2.1.0", "info")
igual(d["servers"][0]["url"], "https://api.ejemplo.cl", "servidor")
sea ruta_id = caracter(123) + "id" + caracter(125)
sea g = d["paths"]["/productos/" + ruta_id]["get"]
igual(g["parameters"][0], {"in": "path", "name": "id", "required": verdadero, "schema": {"type": "string"}}, ":id → parámetro de ruta")
igual(g["responses"]["200"]["content"]["application/json"]["schema"]["$ref"], "#/components/schemas/Producto", "$ref")
igual(g["responses"]["404"]["description"], "No existe", "descripción propia")
sea p = d["paths"]["/productos"]["post"]
igual(p["security"], [{"jwt": []}], "seguridad")
igual(p["parameters"][0]["required"], falso, "consulta opcional")
igual(p["responses"]["422"]["description"], "Datos inválidos", "motivo por defecto")
sea s = d["components"]["schemas"]["Producto"]
igual(s["required"], ["precio", "sku"], "requeridos (sin opcionales ni con defecto)")
igual(s["additionalProperties"], falso, "estricto")
igual(s["properties"]["sku"]["pattern"], "^([A-Z]+[0-9]+)$", "patrón anclado")
igual(s["properties"]["estado"], {"default": "activo", "enum": ["activo", "pausado"], "type": "string"}, "enum y default")
igual(s["properties"]["correo"]["format"], "email", "formato email")
igual(s["properties"]["tags"]["maxItems"], 5, "maxItems")
igual(d["components"]["securitySchemes"]["jwt"]["scheme"], "bearer", "bearer")
sea m = ""
intentar { contrato_ruta(api, "GET", "/productos/:id", {}) } capturar (e) { m = e }
igual(m, "contrato: GET /productos/:id ya está definida", "duplicada")
intentar { contrato_ruta(api, "FETCH", "/x", {}) } capturar (e) { m = e }
igual(m, "contrato: método inválido FETCH", "método")
mostrar("[OK] contrato")
