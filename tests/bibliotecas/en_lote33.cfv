// Lote 33 en inglés: libpcap, yara y libcurl.
importar "libpcap"
importar "yara"
importar "libcurl"

sea cap = pcap_load("tests/bibliotecas/datos/sonda-mezcla.pcap")
afirmar(longitud(pcap_filter(cap, "tcp port 443")) == 2, "pcap_filter")
afirmar(texto_empieza_con(pcap_decode(cap["paquetes"][0]["datos"], 1)["resumen"], "TCP 10.0.0.1:51515"), "pcap_decode")
afirmar(pcap_from_bytes(pcap_to_bytes(cap, {"format": "pcapng"}))["formato"] == "pcapng", "pcap_to_bytes con opciones en inglés")
sea rules = yara_compile("rule hola \{ strings: $a = \"hola\" nocase condition: $a }")
afirmar(yara_matching_rules(rules, "HOLA mundo") == ["hola"], "yara")
afirmar(yara_validate("rule \{") != nulo, "yara_validate")
afirmar(curl_get("data:,hello%20world", nulo)["cuerpo"] == "hello world", "curl_get data:")
afirmar(curl_parse_url("ftp://u:p@h:2121/x")["puerto"] == 2121, "curl_parse_url")
afirmar(curl_get("data:,abcdef", {"from": 2, "to": 3})["cuerpo"] == "abcdef", "data: no aplica rango")
mostrar("[OK] en_lote33")
