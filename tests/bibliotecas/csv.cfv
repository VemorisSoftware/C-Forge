importar "csv"
funcion igual(a, b, q) { afirmar(a == b, q + ": [" + a + "] != [" + b + "]") }
sea f = csv_leer("a,b,c\r\n1,\"dos, tres\",\"con \"\"comillas\"\"\"\n\"multi\nlínea\",,x\n")
igual(longitud(f), 3, "filas")
igual(f[1][1], "dos, tres", "coma dentro de comillas")
igual(f[1][2], "con \"comillas\"", "comillas escapadas")
igual(f[2][0], "multi\nlínea", "salto de línea dentro")
igual(f[2][1], "", "campo vacío")
igual(longitud(csv_leer("x,y")), 1, "sin salto final")
igual(csv_leer("a;b\n1;2", ";")[1][1], "2", "separador ;")
igual(csv_leer("a,\n")[0][1], "", "coma final")
sea r = csv_registros("nombre,edad\nAna,30\nLuis\n")
igual(r[0]["edad"], "30", "registros")
igual(r[1]["edad"], "", "columna faltante")
sea t = csv_escribir([["n", "nota"], ["Ana", "dijo \"hola\", chao"]])
igual(t, "n,nota\r\nAna,\"dijo \"\"hola\"\", chao\"\r\n", "escribir")
igual(csv_leer(t)[1][1], "dijo \"hola\", chao", "ida y vuelta")
igual(csv_escribir_seguro([["=1+1", "-2", "@x", "ok"]]), "'=1+1,'-2,'@x,ok\r\n", "fórmulas neutralizadas")
igual(csv_desde_registros([{"a": 1, "b": 2}], ["b", "a"]), "b,a\r\n2,1\r\n", "desde registros")
sea m = ""
intentar { csv_leer("\"abierto") } capturar (e) { m = e }
igual(m, "csv: comillas sin cerrar", "comillas sin cerrar")
mostrar("[OK] csv")
