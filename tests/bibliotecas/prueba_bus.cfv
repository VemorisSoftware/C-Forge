importar "bus"
importar "base64"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Contra dbus-daemon se probó: Hello, RequestName, ListNames, exportar un
// servicio llamado desde dbus-python (enteros, variantes, a{sv}, as, (sx)ay,
// errores, Properties Get/GetAll/Set, Introspect leído por dbus-python) y
// llamar a un servicio de dbus-python y recibir sus señales.
igual(bus_tipos("a«sv»(ix)aydb"), ["a" + caracter(123) + "sv" + caracter(125), "(ix)", "ay", "d", "b"], "tipos")
igual([bus_inferir(1), bus_inferir("x"), bus_inferir(1.5), bus_inferir(verdadero), bus_inferir([1, 2]), bus_inferir(["a", 1]), bus_inferir(10000000000)], ["i", "s", "d", "b", "ai", "av", "x"], "inferir")
// Bytes de referencia de jeepney (little y big endian).
sea LE = base64_decodificar("bAEAAVwAAAAHAAAAXAAAAAEBbwAKAAAAL29yZy94L09iagAAAAAAAAIBcwAHAAAAb3JnLnguSQADAXMABgAAAE1ldG9kbwAABgFzAAUAAABvcmcueAAAAAgBZwAOc2F7c3Z9KGl4KWF5ZGIAAAAAAAQAAABob2xhAAAAACIAAAABAAAAawABaQAAAAAFAAAAAQAAAHQAAXMAAAAAAQAAAHgAAAAAAAAA/v///wAAAAAAAAAAAAEAAAIAAAABAgAAAAAAAAAA+L8BAAAA")
sea BE = base64_decodificar("QgEAAQAAAFwAAAAHAAAAXAEBbwAAAAAKL29yZy94L09iagAAAAAAAAIBcwAAAAAHb3JnLnguSQADAXMAAAAABk1ldG9kbwAABgFzAAAAAAVvcmcueAAAAAgBZwAOc2F7c3Z9KGl4KWF5ZGIAAAAAAAAAAARob2xhAAAAAAAAACIAAAABawABaQAAAAAAAAAFAAAAAXQAAXMAAAAAAAAAAXgAAAAAAAAA/////gAAAAAAAAEAAAAAAAAAAAIBAgAAv/gAAAAAAAAAAAAB")
sea m = bus_mensaje({"tipo": "llamada", "serial": 7, "ruta": "/org/x/Obj", "interfaz": "org.x.I", "miembro": "Metodo", "destino": "org.x", "firma": "sa«sv»(ix)aydb", "cuerpo": ["hola", {"k": bus_variante("i", 5), "t": bus_variante("s", "x")}, [-2, 1099511627776], caracter(1) + caracter(2), -1.5, verdadero]})
igual(m == LE, verdadero, "codificar igual que jeepney")
igual(bus_largo_mensaje(subcadena(LE, 0, 16)), longitud(LE), "largo")
para d en [LE, BE] {
    sea r = bus_leer_mensaje(d)
    igual([r["tipo"], r["serial"], r["ruta"], r["interfaz"], r["miembro"], r["destino"], bus_simple(r["cuerpo"])], ["llamada", 7, "/org/x/Obj", "org.x.I", "Metodo", "org.x", ["hola", {"k": 5, "t": "x"}, [-2, 1099511627776], [1, 2], -1.5, verdadero]], "leer")
}
// Ida y vuelta de todos los tipos.
sea v = [255, -32768, 65535, -2147483648, 4294967295, -1000000000000, 3.0e-300, 0.1, "ñandú", "/a/b", "a«sv»", bus_variante("ad", [1.5, -2.25]), {"1": "a", "2": "b"}, [[1, "x"], [2, "y"]]]
sea f = "ynqiuxddsogva«is»a(is)"
igual(bus_simple(bus_decodificar(f, bus_codificar(f, v), verdadero)), bus_simple(v), "ida y vuelta")
igual(bus_regla({"tipo": "senal", "interfaz": "a.b", "arg0": "it's"}), "arg0='it'\\''s',interface='a.b',type='signal'", "regla")
// Punto a punto en memoria: un servicio y un cliente.
sea t = bus_tubo()
sea srv = bus_conectar(nulo, {"transporte": t[1], "p2p": verdadero})
sea cli = bus_conectar(nulo, {"transporte": t[0], "p2p": verdadero})
t[0]["al_vaciar"] = funcion() { bus_atender_pendientes(srv) }
sea cambios = []
bus_exportar(srv, "/calc", "org.cf.Calc", {
    "Sumar": {"entrada": "ii", "salida": "i", "fn": funcion(a, m) { retornar a[0] + a[1] }},
    "Partir": {"entrada": "s", "salida": "as", "fn": funcion(a, m) { retornar texto_dividir(a[0], ",") }},
    "Info": {"entrada": "", "salida": "a«sv»", "fn": funcion(a, m) { retornar {"n": 3, "ok": verdadero} }},
    "Fallar": {"entrada": "", "salida": "", "fn": funcion(a, m) { lanzar {"nombre": "org.cf.Error.Malo", "mensaje": "no"} }},
    "Romper": {"entrada": "", "salida": "", "fn": funcion(a, m) { lanzar "algo" }}
}, {"Version": {"firma": "s", "valor": "1.0"}, "Escala": {"firma": "d", "valor": 1.5, "escribible": verdadero, "al_cambiar": funcion(x) { cambios.agregar(x) }}}, {"Aviso": "su"})
bus_exportar(srv, "/calc/hijo", "org.cf.Hijo", nulo, nulo, nulo)
igual(bus_llamar(cli, nulo, "/calc", "org.cf.Calc", "Sumar", "ii", [40, 2]), [42], "llamar")
igual(bus_llamar(cli, nulo, "/calc", "org.cf.Calc", "Partir", "s", ["a,b"]), [["a", "b"]], "as")
igual(bus_simple(bus_llamar(cli, nulo, "/calc", nulo, "Info", "", [])), [{"n": 3, "ok": verdadero}], "sin interfaz")
sea errores = []
para c en [["Fallar", "", []], ["Romper", "", []], ["Sumar", "s", ["x"]], ["Nada", "", []]] {
    intentar { bus_llamar(cli, nulo, "/calc", "org.cf.Calc", c[0], c[1], c[2]) } capturar (e) { errores.agregar(e["nombre"]) }
}
intentar { bus_llamar(cli, nulo, "/nada", "a.b", "X", "", []) } capturar (e) { errores.agregar(e["nombre"]) }
igual(errores, ["org.cf.Error.Malo", "org.freedesktop.DBus.Error.Failed", "org.freedesktop.DBus.Error.InvalidArgs", "org.freedesktop.DBus.Error.UnknownMethod", "org.freedesktop.DBus.Error.UnknownObject"], "errores")
igual([bus_propiedad(cli, nulo, "/calc", "org.cf.Calc", "Version"), bus_propiedades(cli, nulo, "/calc", "org.cf.Calc")], ["1.0", {"Escala": 1.5, "Version": "1.0"}], "propiedades")
bus_llamar(cli, nulo, "/calc", "org.freedesktop.DBus.Properties", "Set", "ssv", ["org.cf.Calc", "Escala", bus_variante("d", 2.5)])
sea pc = bus_esperar_senal(cli, "org.freedesktop.DBus.Properties", "PropertiesChanged")
igual([cambios, bus_simple(pc["cuerpo"]), bus_propiedad(cli, nulo, "/calc", "org.cf.Calc", "Escala")], [[2.5], ["org.cf.Calc", {"Escala": 2.5}, []], 2.5], "Set y PropertiesChanged")
sea x = bus_llamar(cli, nulo, "/calc", "org.freedesktop.DBus.Introspectable", "Introspect", "", [])[0]
igual([contiene(x, "<method name=" + caracter(34) + "Sumar"), contiene(x, "<node name=" + caracter(34) + "hijo"), contiene(x, "access=" + caracter(34) + "readwrite")], [verdadero, verdadero, verdadero], "introspección")
igual(bus_llamar(cli, nulo, "/calc", "org.freedesktop.DBus.Peer", "Ping", "", []), [], "Ping")
bus_emitir(srv, "/calc", "org.cf.Calc", "Aviso", "su", ["hola", 7])
igual(bus_simple(bus_esperar_senal(cli, "org.cf.Calc", "Aviso")["cuerpo"]), ["hola", 7], "señal")
// Autenticación EXTERNAL contra un "daemon" falso.
sea t2 = bus_tubo()
sea guion = {"paso": 0}
t2[0]["al_vaciar"] = funcion() {
    sea d = t2[1]["recibir"](1)
    si (guion["paso"] == 0) {
        mientras (texto_termina_con(d, "\n") == falso) { d = d + t2[1]["recibir"](1) }
        igual(d, caracter(0) + "AUTH EXTERNAL 31303030\r\n", "AUTH")
        t2[1]["enviar"]("OK 1234abcd\r\n")
        guion["paso"] = 1
    } sino {
        mientras (texto_termina_con(d, "BEGIN\r\n") == falso) { d = d + t2[1]["recibir"](1) }
        sea cab = t2[1]["recibir"](16)
        sea h = bus_leer_mensaje(cab + t2[1]["recibir"](bus_largo_mensaje(cab) - 16))
        igual(h["miembro"], "Hello", "Hello")
        t2[1]["enviar"](bus_mensaje({"tipo": "retorno", "serial": 1, "responde_a": h["serial"], "firma": "s", "cuerpo": [":1.42"]}))
    }
}
sea c2 = bus_conectar(nulo, {"transporte": t2[0], "uid": 1000})
igual([c2["guid"], c2["nombre"]], ["1234abcd", ":1.42"], "conectar")
mostrar("[OK] bus")
