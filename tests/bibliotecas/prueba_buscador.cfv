importar "buscador"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea b = buscador_nuevo({"campos": {"titulo": 3, "cuerpo": 1}, "idioma": "es", "facetas": ["categoria"], "sinonimos": [["auto", "coche", "carro"]]})
buscador_agregar(b, "1", {"titulo": "Cómo correr un maratón", "cuerpo": "Consejos para corredores principiantes que quieren terminar su primera carrera larga.", "categoria": "deporte", "anio": 2024})
buscador_agregar(b, "2", {"titulo": "Recetas de cocina chilena", "cuerpo": "Empanadas de pino, pastel de choclo y cazuela.", "categoria": "cocina", "anio": 2023})
buscador_agregar(b, "3", {"titulo": "Mantención del auto", "cuerpo": "Revisa el aceite del coche antes de una carrera.", "categoria": "motor", "anio": 2025})
buscador_agregar(b, "4", {"titulo": "Entrenamiento de fuerza", "cuerpo": "Ejercicios para correr más rápido en la carrera.", "categoria": "deporte", "anio": 2025})
funcion ids(q, o) {
    sea r = []
    para x en buscador_buscar(b, q, o)["resultados"] { r.agregar(x["id"]) }
    retornar r
}
igual(ids("corredores", nulo), ["1"], "raíces")
igual(ids("maratnó", {"tolerancia": 2}), ["1"], "errores de tipeo")
igual(ids("carro", nulo), ["3"], "sinónimos")
igual(ids("\"primera carrera\"", nulo), ["1"], "frase")
igual(ids("carrera -coche", nulo), ["4", "1"], "excluir")
igual(ids("carrera categoria:deporte", nulo), ["4", "1"], "filtro por campo")
igual(ids("+carrera +aceite", nulo), ["3"], "obligatorios")
igual(ids("empan*", nulo), ["2"], "prefijo")
igual(ids("carrera", {"orden": ["anio", "asc"]}), ["1", "3", "4"], "orden por campo")
igual(ids("carrera", {"limite": 1, "desde": 1, "orden": ["anio", "asc"]}), ["3"], "paginación")
sea r = buscador_buscar(b, "carrera", {"resaltar": "cuerpo"})
igual([r["total"], r["facetas"]["categoria"]["deporte"], r["facetas"]["categoria"]["motor"]], [3, 2, 1], "facetas")
afirmar(texto_indice(r["resultados"][0]["fragmento"], "<mark>carrera.</mark>") >= 0, "fragmento")
igual(buscador_distancia("kitten", "sitting"), 3, "Levenshtein")
igual(buscador_sugerir(b, "corr", 2), ["corr", "corredor"], "sugerencias")
buscador_quitar(b, "1")
igual([buscador_cantidad(b), buscador_buscar(b, "corredores")["total"]], [3, 0], "quitar")
sea en = buscador_nuevo({"idioma": "en"})
buscador_agregar(en, "a", {"texto": "The runners were running quickly"})
igual(buscador_buscar(en, "run")["total"], 1, "inglés")
mostrar("[OK] buscador")
