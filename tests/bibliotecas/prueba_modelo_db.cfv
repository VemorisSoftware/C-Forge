importar "modelo_db"
importar "db"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea autores = modelo_tabla("autores", {"id": modelo_col("entero", {"primaria": verdadero, "auto": verdadero}), "nombre": modelo_col("texto", {"unico": verdadero})})
sea libros = modelo_tabla("libros", {"id": modelo_col("entero", {"primaria": verdadero, "auto": verdadero}), "titulo": modelo_col("texto"), "autor_id": modelo_col("entero", {"ref": "autores.id", "al_borrar": "cascade"}), "disponible": modelo_col("booleano", {"defecto": verdadero}), "datos": modelo_col("json", {"nulo": verdadero})}, [{"columnas": ["titulo"]}])
sea e1 = modelo_esquema([libros, autores])
sea q = modelo_select(libros, {"donde": modelo_y([modelo_igual("disponible", verdadero), modelo_o([modelo_como("titulo", "%a%"), modelo_en("id", [1, 2])])]), "orden": [["id", "desc"]], "limite": 10, "desde": 5})
igual(modelo_sql(q, "postgres")["sql"], "SELECT * FROM \"libros\" WHERE (\"disponible\" = $1) AND ((\"titulo\" LIKE $2) OR (\"id\" IN ($3, $4))) ORDER BY \"id\" DESC LIMIT 10 OFFSET 5", "SQL postgres")
igual(modelo_sql(q, "sqlite")["params"], [1, "%a%", 1, 2], "parámetros sqlite")
igual(modelo_sql(modelo_select(libros, {"columnas": ["libros.titulo", ["autores.nombre", "autor"]], "unir": [{"tabla": autores, "en": ["libros.autor_id", "autores.id"], "tipo": "left"}]}), "sqlite")["sql"], "SELECT \"libros\".\"titulo\", \"autores\".\"nombre\" AS \"autor\" FROM \"libros\" LEFT JOIN \"autores\" ON \"libros\".\"autor_id\" = \"autores\".\"id\"", "join")
afirmar(texto_indice(modelo_ddl(e1, "postgres")[0], "BIGSERIAL") > 0, "DDL postgres")
sea c = db_conectar(":memory:")
igual(longitud(modelo_migrar(c, e1)), 3, "migración inicial")
modelo_ejecutar(c, modelo_insert(autores, [{"nombre": "Cortázar"}, {"nombre": "Borges"}]))
modelo_ejecutar(c, modelo_insert(libros, [{"titulo": "Rayuela", "autor_id": 1, "disponible": verdadero, "datos": {"paginas": 600}}, {"titulo": "Ficciones", "autor_id": 2, "disponible": falso, "datos": nulo}]))
sea todos = modelo_todos(c, modelo_select(libros, {"orden": ["id"]}))
igual([todos[0]["datos"]["paginas"], todos[1]["disponible"]], [600, falso], "json y booleanos")
igual(modelo_todos(c, modelo_select(libros, {"columnas": ["libros.titulo", ["autores.nombre", "autor"]], "unir": [{"tabla": autores, "en": ["libros.autor_id", "autores.id"]}], "donde": modelo_igual("disponible", verdadero)}))[0]["autor"], "Cortázar", "consulta con join")
igual(modelo_ejecutar(c, modelo_update(libros, {"disponible": verdadero}, modelo_igual("titulo", "Ficciones")))["cambios"], 1, "update")
sea libros2 = modelo_tabla("libros", {"id": modelo_col("entero", {"primaria": verdadero, "auto": verdadero}), "titulo": modelo_col("texto"), "autor_id": modelo_col("entero", {"ref": "autores.id", "al_borrar": "cascade"}), "disponible": modelo_col("booleano", {"defecto": verdadero}), "anio": modelo_col("entero", {"nulo": verdadero})}, [{"columnas": ["titulo"]}])
sea e2 = modelo_esquema([libros2, autores])
afirmar(longitud(modelo_migrar(c, e2)) > 0, "migración con cambios")
sea t2 = modelo_todos(c, modelo_select(libros2, {"orden": ["id"]}))
igual([longitud(t2), tiene_clave(t2[0], "datos"), tiene_clave(t2[0], "anio")], [2, falso, verdadero], "datos conservados")
igual(longitud(modelo_migrar(c, e2)), 0, "sin cambios")
sea fallo = 0
para mal en [funcion() { modelo_sql(modelo_select(libros, {"donde": modelo_igual("titlo", 1)})) }, funcion() { modelo_delete(libros) }, funcion() { modelo_tabla("x; drop", {}) }] {
    intentar { mal() } capturar (e) { fallo = fallo + 1 }
}
igual(fallo, 3, "errores seguros")
mostrar("[OK] modelo_db")
