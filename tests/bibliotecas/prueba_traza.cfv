importar "traza"
importar "json"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea reloj = [1000]
sea t = traza_con_reloj(traza_nuevo("tienda"), funcion() { reloj[0] = reloj[0] + 5  retornar reloj[0] })
igual(traza_continuar(t, {"TraceParent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"}), verdadero, "continuar W3C")
sea cab = nulo
traza_span(t, "GET /pedidos", funcion(s) {
    traza_atributo(s, "http.method", "GET")
    cab = traza_propagar(t)
    traza_span(t, "db", funcion(s2) { traza_evento(s2, "fila", {"n": 3}, t) }, {"db.sistema": "sqlite"})
    intentar { traza_span(t, "pago", funcion(s3) { lanzar "rechazado" }) } capturar (e) { }
})
sea partes = texto_dividir(cab["traceparent"], "-")
igual([partes[0], partes[1], longitud(partes[2]), partes[3]], ["00", "4bf92f3577b34da6a3ce929d0e0e4736", 16, "01"], "propagar mantiene la traza")
sea spans = traza_spans(t)
igual(longitud(spans), 3, "tres spans")
sea raiz_ = spans[2]
igual([raiz_["nombre"], raiz_["padre"], raiz_["estado"], raiz_["atributos"]["http.method"]], ["GET /pedidos", "00f067aa0ba902b7", "ok", "GET"], "span raíz con padre remoto")
igual([spans[0]["padre"], spans[0]["atributos"]["db.sistema"], spans[0]["eventos"][0]["nombre"]], [raiz_["id"], "sqlite", "fila"], "hijo")
igual([spans[1]["estado"], spans[1]["mensaje"], spans[1]["eventos"][0]["nombre"]], ["error", "rechazado", "exception"], "error registrado")
igual(traza_texto(t), "GET /pedidos (35 ms)\n  db (10 ms)\n  pago (10 ms) ✗ rechazado", "árbol")
sea o = json_parsear(traza_otlp(t))
sea x = o["resourceSpans"][0]["scopeSpans"][0]["spans"]
igual([o["resourceSpans"][0]["resource"]["attributes"][0]["value"]["stringValue"], longitud(x), x[1]["status"]["code"], x[2]["parentSpanId"], x[0]["startTimeUnixNano"]], ["tienda", 3, 2, "00f067aa0ba902b7", "1010000000"], "OTLP")
igual([traza_continuar(traza_nuevo("x"), {"traceparent": "01-abc"}), traza_continuar(traza_nuevo("x"), {"traceparent": "00-" + texto_repetir("0", 32) + "-00f067aa0ba902b7-01"}), traza_continuar(traza_nuevo("x"), {})], [falso, falso, falso], "traceparent inválido")
sea nada = traza_nuevo("x", 0)
traza_span(nada, "a", funcion(s) { })
igual(longitud(traza_spans(nada)), 0, "muestreo 0")
mostrar("[OK] traza")
