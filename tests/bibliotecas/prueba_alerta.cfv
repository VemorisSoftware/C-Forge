importar "alerta"
importar "json"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea a = alerta_nueva({"entorno": "produccion", "version": "1.4.0", "max_migas": 2})
alerta_usuario(a, {"id": 7, "password": "x"})
alerta_etiqueta(a, "region", "cl")
alerta_miga(a, "uno")
alerta_miga(a, "dos")
alerta_miga(a, "tres", "http", {"url": "/pago", "authorization": "Bearer x"})
sea m = ""
intentar { alerta_capturar(a, funcion() { lanzar "pago 123 falló con tarjeta 4111111111111111" }, {"token": "abc", "pedido": 9}) } capturar (e) { m = e }
afirmar(texto_empieza_con(m, "pago 123"), "relanza el error original")
sea ev = alerta_eventos(a)[0]
igual(ev["mensaje"], "pago 123 falló con tarjeta [tarjeta filtrada]", "tarjeta filtrada")
igual(alerta_filtrar("a 4111 1111 1111 1111 b 5500000000000004."), "a 4111 1111 1111 1111 b [tarjeta filtrada].", "solo números de tarjeta seguidos")
igual([ev["extra"]["token"], ev["extra"]["pedido"], ev["usuario"]["password"], ev["usuario"]["id"]], ["[filtrado]", 9, "[filtrado]", 7], "datos sensibles filtrados")
igual([longitud(ev["migas"]), ev["migas"][0]["mensaje"], ev["migas"][1]["datos"]["authorization"]], [2, "dos", "[filtrado]"], "migas limitadas y filtradas")
igual([ev["entorno"], ev["version"], ev["etiquetas"]["region"], ev["nivel"]], ["produccion", "1.4.0", "cl", "error"], "contexto")
alerta_reportar(a, "pago 456 falló con tarjeta 5500000000000004")
alerta_reportar(a, "otro error", "aviso")
sea r = alerta_resumen(a)
igual([longitud(r), r[0]["veces"], r[1]["veces"]], [2, 2, 1], "agrupar por huella (sin números)")
igual(alerta_huella("usuario 12 no existe"), alerta_huella("usuario 98765 no existe"), "huella estable")
sea lim = alerta_nueva({"max_por_minuto": 3})
sea i = 0
mientras (i < 10) { alerta_reportar(lim, "x")  i = i + 1 }
igual(longitud(alerta_eventos(lim)), 3, "límite por minuto")
sea filtro = alerta_nueva({"antes_de_enviar": funcion(e) { si (texto_indice(e["mensaje"], "ignorar") >= 0) { retornar nulo }  retornar e }})
alerta_reportar(filtro, "ignorar esto")
alerta_reportar(filtro, "importante")
igual(longitud(alerta_eventos(filtro)), 1, "antes_de_enviar")
sea p = alerta_sentry(a, ev, "https://abc123@o1.ingest.sentry.io/42")
igual(p["url"], "https://o1.ingest.sentry.io/api/42/envelope/", "URL de Sentry")
afirmar(texto_indice(p["cabeceras"]["X-Sentry-Auth"], "sentry_key=abc123") >= 0, "autenticación")
sea lineas = texto_dividir(p["cuerpo"], "\n")
sea item = json_parsear(lineas[2])
igual([json_parsear(lineas[1])["type"], json_parsear(lineas[1])["length"], item["level"], item["release"], item["breadcrumbs"]["values"][1]["category"]], ["event", longitud(lineas[2]), "error", "1.4.0", "http"], "envelope")
alerta_guardar(a, "/tmp/cforge-alerta.jsonl")
igual(longitud(texto_dividir(texto_recortar(leer_archivo("/tmp/cforge-alerta.jsonl")), "\n")), 3, "guardar JSONL")
eliminar_archivo("/tmp/cforge-alerta.jsonl")
mostrar("[OK] alerta")
