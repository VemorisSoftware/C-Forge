// Pruebas de usb con descriptores armados byte a byte según la
// especificación USB 2.0/3.x (datos/usb): dispositivo compuesto con IAD,
// CDC ACM, HID, audio con alternativas e isocronía, compañero SuperSpeed,
// BOS y un texto UTF-16 con par sustituto. La enumeración usa un sysfs falso.
importar "usb"
importar "sistema"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

sea crudo = leer_archivo("tests/bibliotecas/datos/usb/descriptores.bin")
sea d = usb_analizar_descriptores(crudo)
eq([d["usb"], d["clase"], d["subclase"], d["protocolo"], d["max_paquete0"], usb_hex4(d["vendor_id"]), usb_hex4(d["product_id"]), d["i_producto"], d["num_configuraciones"]],
   ["2.10", 239, 2, 1, 64, "2e8a", "000a", 2, 1], "dispositivo")
eq(usb_nombre_clase(d["clase"]), "miscelánea", "clase")
sea c = d["configuraciones"][0]
eq([c["total"], c["num_interfaces"], c["valor"], c["autoalimentado"], c["despertar_remoto"], c["max_ma"]], [151, 4, 1, falso, verdadero, 500], "configuración")
eq(c["asociaciones"], [{"clase": 2, "i_funcion": 4, "num_interfaces": 2, "primera_interfaz": 0, "protocolo": 1, "subclase": 2}], "IAD")
eq(longitud(c["interfaces"]), 4, "interfaces")

sea cdc = c["interfaces"][0]["alternativas"][0]
eq([cdc["clase"], cdc["subclase"], cdc["i_interfaz"], longitud(cdc["extra"])], [2, 2, 4, 19], "CDC")
sea ex = usb_descriptores_extra(cdc["extra"])
eq([longitud(ex), ex[0]["tipo"], ex[0]["subtipo"], ex[3]["subtipo"]], [4, 36, 0, 6], "descriptores funcionales CDC")
eq([cdc["endpoints"][0]["direccion"], cdc["endpoints"][0]["tipo"], cdc["endpoints"][0]["entrada"], cdc["endpoints"][0]["intervalo"]], [129, "interrupcion", verdadero, 16], "notificación")

sea datos = c["interfaces"][1]["alternativas"][0]
eq([datos["endpoints"][0]["numero"], datos["endpoints"][0]["entrada"], datos["endpoints"][0]["max_paquete"], datos["endpoints"][1]["direccion"]], [2, falso, 512, 130], "bulk")
eq(datos["endpoints"][0]["compañero_ss"], {"atributos": 0, "bytes_por_intervalo": 0, "max_rafaga": 15}, "compañero SuperSpeed")

sea hid = c["interfaces"][2]["alternativas"][0]
sea hx = usb_descriptores_extra(hid["extra"])
eq(hx[0]["hid"], {"bcdHID": 273, "descriptores": [[34, 52]], "pais": 0}, "descriptor HID")
eq(hid["endpoints"][0]["max_paquete"], 4, "endpoint HID")

sea audio = c["interfaces"][3]
eq(longitud(audio["alternativas"]), 2, "alternativas de audio")
eq(longitud(audio["alternativas"][0]["endpoints"]), 0, "alternativa 0 sin ancho de banda")
sea iso = audio["alternativas"][1]["endpoints"][0]
eq([iso["tipo"], iso["max_paquete"], iso["transacciones_extra"], iso["refresco"], iso["sincronizacion"], longitud(iso["extra"])], ["isocrono", 192, 2, 0, 0, 11], "isócrono")
eq(usb_descriptores_extra(iso["extra"])[1]["tipo"], 255, "descriptor de fabricante")

sea bos = usb_descriptor_bos(leer_archivo("tests/bibliotecas/datos/usb/bos.bin"))
eq([bos["num_capacidades"], bos["capacidades"][0]["tipo"], bos["capacidades"][0]["lpm"], bos["capacidades"][1]["tipo"]], [2, 2, verdadero, 3], "BOS")
eq(usb_texto_descriptor(leer_archivo("tests/bibliotecas/datos/usb/texto.bin")), "Señal ✓ 🚀", "texto UTF-16")

eq(usb_paquete_setup(usb_tipo_peticion("entrada", "estandar", "dispositivo"), 6, 256, 0, 18), char_de(128) + char_de(6) + char_de(0) + char_de(1) + char_de(0) + char_de(0) + char_de(18) + char_de(0), "SETUP")
eq(usb_tipo_peticion("salida", "clase", "interfaz"), 33, "bmRequestType")

sea error = ""
intentar { usb_descriptor_configuracion(subtexto(crudo, 18, 60)) } capturar (x) { error = x }
afirmar(texto_contiene(error, "truncado"), "truncado")

// sysfs falso.
sea raiz = "/tmp/cforge_usb_sys"
sistema_comando("rm -rf " + raiz + " && mkdir -p " + raiz + "/1-1.4 " + raiz + "/1-1.4:1.0 " + raiz + "/usb1")
para par en [["idVendor", "2e8a"], ["idProduct", "000a"], ["busnum", "1"], ["devnum", "7"], ["product", "Pico"], ["manufacturer", "Raspberry Pi"], ["serial", "E6614"], ["speed", "12"], ["bDeviceClass", "ef"]] {
    escribir_archivo(raiz + "/1-1.4/" + par[0], par[1] + "\n")
}
escribir_archivo(raiz + "/1-1.4/descriptors", crudo)
escribir_archivo(raiz + "/usb1/idVendor", "1d6b\n")
escribir_archivo(raiz + "/usb1/idProduct", "0002\n")
usb_raices(raiz, "/tmp/cforge_usb_dev")
sea ds = usb_dispositivos()
eq(longitud(ds), 2, "dispositivos (sin interfaces)")
sea pico = ds[0]
eq([pico["nombre"], pico["bus"], pico["direccion"], pico["puertos"], pico["producto"], pico["serie"], pico["velocidad"], pico["clase"]], ["1-1.4", 1, 7, ["1", "4"], "Pico", "E6614", 12, 239], "pico")
eq(usb_analizar_descriptores(pico["descriptores"])["configuraciones"][0]["num_interfaces"], 4, "descriptores de sysfs")
error = ""
intentar { usb_abrir(11914, 10) } capturar (x) { error = x }
afirmar(texto_contiene(error, "/tmp/cforge_usb_dev/001/007"), "ruta de usbfs: " + error)
mostrar("[OK] usb")
