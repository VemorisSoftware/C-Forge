// Written in English.
import "search"
import "vectors"
import "numeric"
import "ml"
import "ecs"
import "prompt"
import "dataframe"
import "flexbox"
function same(a, b, what) { assert(("" + a) == ("" + b), what + ": [" + a + "] != [" + b + "]") }
let idx = search_new()
search_add(idx, "a", "Fast running shoes")
search_add(idx, "b", "Slow cooking recipes")
same(search_query(idx, "shoes")[0]["id"], "a", "search")
let v = vectors_new(2, "cosine")
vectors_add(v, "x", [1, 0])
vectors_add(v, "y", [0, 1])
same(vectors_search(v, [0.9, 0.1], 1)[0]["id"], "x", "vectors")
same(numeric_regression([1, 2, 3], [2, 4, 6])["slope"], 2, "numeric_regression")
same(numeric_summary([1, 2, 3])["median"], 2, "numeric_summary")
let km = ml_kmeans([[0, 0], [0, 1], [10, 10], [10, 11]], 2, {"seed": 3})
same(km["labels"][0] == km["labels"][1] and km["labels"][2] == km["labels"][3], true, "ml_kmeans")
same(longitud(ml_split([[1], [2], [3], [4]], [1, 2, 3, 4], 0.5, 1)["X_test"]), 2, "ml_split")
let w = ecs_world()
let e = ecs_spawn(w, {"hp": 3})
ecs_system(w, "hurt", ["hp"], function(w, e, c, dt) { ecs_insert(w, e, "hp", c["hp"] - 1) })
ecs_step(w, 1)
same(ecs_get(w, e, "hp"), 2, "ecs")
prompt_simulate(["", "n"])
same(prompt_confirm("Proceed?", true), true, "prompt default")
same(prompt_confirm("Again?"), false, "prompt no")
let df = df_from_records([{"k": "a", "v": 1}, {"k": "b", "v": 2}, {"k": "a", "v": 3}])
same(df_rows(df_group_by(df, ["k"], {"s": ["v", "sum"]})), [{"k": "a", "s": 4}, {"k": "b", "s": 2}], "dataframe")
let root = flexbox_node({"direction": "row"}, [flexbox_node({"grow": 1}), flexbox_node({"width": 10})])
flexbox_compute(root, 100, 20)
same(root["hijos"][0]["caja"]["ancho"], 90, "flexbox")
print("[OK] lote 5 in English")
