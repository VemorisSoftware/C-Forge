importar "subida"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
igual(subida_frontera("multipart/form-data; boundary=----abc123"), "----abc123", "frontera")
igual(subida_frontera("Multipart/Form-Data; charset=utf-8; boundary=\"x y\""), "x y", "frontera entre comillas")
// Cuerpo como lo manda un navegador.
sea cuerpo = "--XyZ\r\nContent-Disposition: form-data; name=\"titulo\"\r\n\r\nHola mundo\r\n--XyZ\r\nContent-Disposition: form-data; name=\"foto\"; filename=\"..\\..\\win.png\"\r\nContent-Type: image/png\r\n\r\n" + bytes_de_hex("89504e470d0a1a0a00") + "\r\n--XyZ\r\nContent-Disposition: form-data; name=\"doc\"; filename*=UTF-8''ma%C3%B1ana.txt\r\n\r\n--XyZ casi\r\n--XyZ--\r\n"
sea p = subida_analizar(cuerpo, "multipart/form-data; boundary=XyZ")
igual(longitud(p), 3, "tres partes")
igual(subida_campos(p), {"titulo": "Hola mundo"}, "campos")
sea a = subida_archivos(p)
igual(a[0]["archivo"] + " " + a[0]["tipo"] + " " + longitud(a[0]["datos"]), "..\\..\\win.png image/png 9", "binario intacto")
igual(hex_de_bytes(a[0]["datos"]), "89504e470d0a1a0a00", "bytes exactos")
igual(a[1]["archivo"], "mañana.txt", "filename* RFC 5987")
igual(a[1]["tipo"], "application/octet-stream", "tipo por defecto")
igual(a[1]["datos"], "--XyZ casi", "frontera parcial no corta")
igual(a[0]["filename"] + " " + a[0]["type"], a[0]["archivo"] + " " + a[0]["tipo"], "claves en inglés")
// Nombres seguros
igual(subida_nombre_seguro(a[0]["archivo"]), "win.png", "sin rutas de Windows")
igual(subida_nombre_seguro("../../etc/passwd"), "passwd", "sin ../")
igual(subida_nombre_seguro(".htaccess"), "htaccess", "sin ocultos")
igual(subida_nombre_seguro("CON.txt"), "_CON.txt", "reservado de Windows")
igual(subida_nombre_seguro("a<b>:\"|?*.txt"), "a_b______.txt", "caracteres reservados")
igual(subida_nombre_seguro("x" + bytes_entero(0, 1, 0) + "y.php"), "x_y.php", "byte nulo")
igual(subida_nombre_seguro("..."), "archivo", "nunca vacío")
// Ida y vuelta con subida_crear
sea c = subida_crear([{"nombre": "a", "datos": "1"}, {"name": "f", "filename": "x\"y.bin", "data": bytes_de_hex("00ff0d0a")}])
sea q = subida_analizar(c["cuerpo"], c["tipo"])
igual(q[0]["datos"] + "|" + q[1]["archivo"] + "|" + hex_de_bytes(q[1]["datos"]), "1|x\"y.bin|00ff0d0a", "crear y leer")
// Límites y basura
para caso en [
    [cuerpo, "text/plain", nulo, "subida: no es multipart"],
    [cuerpo, "multipart/form-data", nulo, "subida: falta boundary"],
    ["--XyZ\r\nsin fin", "multipart/form-data; boundary=XyZ", nulo, "subida: cabeceras de parte inválidas"],
    ["--XyZ\r\nA: b\r\n\r\ndatos", "multipart/form-data; boundary=XyZ", nulo, "subida: parte sin cerrar"],
    [cuerpo, "multipart/form-data; boundary=XyZ", {"max_partes": 2}, "subida: más de 2 partes"],
    [cuerpo, "multipart/form-data; boundary=XyZ", {"max_parte": 5}, "subida: una parte supera 5 bytes"],
    [cuerpo, "multipart/form-data; boundary=XyZ", {"max_total": 10}, "subida: el cuerpo supera 10 bytes"]
] {
    sea m = ""
    intentar { subida_analizar(caso[0], caso[1], caso[2]) } capturar (e) { m = e }
    igual(m, caso[3], caso[3])
}
mostrar("[OK] subida")
