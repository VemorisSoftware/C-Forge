importar "infra"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea t = unir([
    "# Servidores",
    "region = \"sa-east-1\"",
    "servidor \"web\" {",
    "  puerto = 8080   // HTTP",
    "  etiquetas = [\"api\", \"publico\",]",
    "  entorno = { MODO = \"prod\", \"x-y\": 2 }",
    "  activo = true",
    "  /* nota",
    "     de varias líneas */",
    "  url = \"https://$\{var.dominio}/api\"",
    "  literal = \"$$\{no}\"",
    "  script = <<-EOF",
    "    echo hola",
    "      echo mundo",
    "    EOF",
    "}",
    "servidor \"db\" { puerto = 5432 }",
    "red \"vpc\" \"principal\" { cidr = \"10.0.0.0/16\" }",
    "regla { a = 1 }",
    "regla { a = 2 }",
    "max = var.max",
    "decimal = -1.5e2"
], "\n")
sea c = infra_leer(t, {"var": {"dominio": "c-forge.org", "max": 10}})
igual([c["region"], c["servidor"]["web"]["puerto"], c["servidor"]["db"]["puerto"], c["servidor"]["web"]["etiquetas"]], ["sa-east-1", 8080, 5432, ["api", "publico"]], "bloques con etiqueta")
igual(c["servidor"]["web"]["entorno"], {"MODO": "prod", "x-y": 2}, "mapas")
igual([c["servidor"]["web"]["activo"], c["servidor"]["web"]["url"], c["servidor"]["web"]["literal"]], [verdadero, "https://c-forge.org/api", "$\{no}"], "interpolación y escape $$")
igual(c["servidor"]["web"]["script"], "echo hola\n  echo mundo\n", "heredoc con sangría recortada")
igual(c["red"]["vpc"]["principal"]["cidr"], "10.0.0.0/16", "dos etiquetas")
igual(c["regla"], [{"a": 1}, {"a": 2}], "bloques repetidos → lista")
igual([c["max"], c["decimal"]], [10, -150], "referencias y números")
sea ida = infra_texto({"nombre": "app", "puertos": [80, 443], "db": {"host": "x", "ssl": verdadero, "url": "$\{x}"}})
igual(infra_leer(ida), {"db": {"host": "x", "ssl": verdadero, "url": "$\{x}"}, "nombre": "app", "puertos": [80, 443]}, "escribir y volver a leer")
para caso en [
    ["a = 1\na = 2", "infra: línea 2, columna 4: atributo repetido a"],
    ["bloque {\n x = \"y\n}", "infra: línea 2, columna 8: salto de línea dentro de un texto (usa <<EOF)"],
    ["x = var.nada", "infra: línea 1, columna 5: valor desconocido var.nada"],
    ["b {\n x = 1\n", "infra: línea 3, columna 1: falta }"],
    ["}", "infra: línea 1, columna 1: } de más"],
    ["x = \"$\{nada}\"", "infra: línea 1, columna 14: variable desconocida nada"],
    ["b \"a\" { }\nb \"a\" { }", "infra: línea 2, columna 10: bloque repetido b a"]
] {
    sea m = ""
    intentar { infra_leer(caso[0]) } capturar (e) { m = e }
    igual(m, caso[1], caso[1])
}
mostrar("[OK] infra")
