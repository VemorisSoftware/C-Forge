importar "segundo_factor"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Vectores oficiales: RFC 6238 apéndice B (SHA-1) y RFC 4226 apéndice D.
sea s = segundo_factor_base32("12345678901234567890")
igual(s, "GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ", "Base32")
igual(segundo_factor_desde_base32(s), "12345678901234567890", "Base32 de vuelta")
igual(segundo_factor_desde_base32("jbsw y3dp-ehpk3pxp"), "Hello!" + bytes_de_hex("deadbeef"), "Base32 con espacios y minúsculas")
igual([segundo_factor_totp(s, 59000, 30, 8), segundo_factor_totp(s, 1111111109000, 30, 8), segundo_factor_totp(s, 1111111111000, 30, 8), segundo_factor_totp(s, 1234567890000, 30, 8), segundo_factor_totp(s, 2000000000000, 30, 8), segundo_factor_totp(s, 20000000000000, 30, 8)], ["94287082", "07081804", "14050471", "89005924", "69279037", "65353130"], "RFC 6238")
igual([segundo_factor_hotp(s, 0), segundo_factor_hotp(s, 1), segundo_factor_hotp(s, 2), segundo_factor_hotp(s, 3), segundo_factor_hotp(s, 9)], ["755224", "287082", "359152", "969429", "520489"], "RFC 4226")
sea t = 1234567890000
sea c = segundo_factor_totp(s, t)
igual([segundo_factor_verificar(s, c, 1, t), segundo_factor_verificar(s, c, 1, t + 30000), segundo_factor_verificar(s, c, 1, t - 30000), segundo_factor_verificar(s, c, 1, t + 90000), segundo_factor_verificar(s, c, 0, t + 30000)], [verdadero, verdadero, verdadero, falso, falso], "ventana")
igual(segundo_factor_verificar(s, "12345", 1, t), falso, "largo inválido")
igual(segundo_factor_verificar(s, subcadena(c, 0, 3) + " " + subcadena(c, 3, 6), 1, t), verdadero, "con espacio")
sea nuevo = segundo_factor_secreto()
igual(longitud(nuevo), 32, "secreto de 160 bits")
igual(longitud(segundo_factor_desde_base32(nuevo)), 20, "20 bytes")
afirmar(nuevo != segundo_factor_secreto(), "aleatorio")
igual(segundo_factor_uri("JBSWY3DPEHPK3PXP", "ana@vemoris.cl", "Vemoris Group"), "otpauth://totp/Vemoris%20Group:ana%40vemoris.cl?secret=JBSWY3DPEHPK3PXP&issuer=Vemoris%20Group&algorithm=SHA1&digits=6&period=30", "URI")
sea r = segundo_factor_respaldo(5)
igual(longitud(r), 5, "códigos de respaldo")
afirmar(longitud(r[0]) == 9 y subcadena(r[0], 4, 5) == "-", "formato de respaldo")
sea m = ""
intentar { segundo_factor_desde_base32("abc1") } capturar (e) { m = e }
igual(m, "segundo_factor: carácter inválido en Base32: 1", "Base32 inválido")
mostrar("[OK] segundo_factor")
