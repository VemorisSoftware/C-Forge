// Pruebas de rayo_json (JSON rápido bajo demanda).
importar "rayo_json"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

sea t = "{\"a\": [1, {\"b\\\"c\": \"x]}\"}, 3], \"z\": {\"k\": true, \"v\": null}, \"n~/m\": 5, \"vacio\": [], \"o\": {}}"
sea d = rayo_json_abrir(t)
eq(rayo_json_en(d, "/a/1/b\"c"), "x]}", "clave con comilla y texto con corchetes")
eq(rayo_json_en(d, "/a/2"), 3, "índice")
eq(rayo_json_en(d, ["a", 2]), 3, "puntero como lista")
eq(rayo_json_en(d, "/z/k"), verdadero, "booleano")
eq(rayo_json_en(d, "/n~0~1m"), 5, "escapes ~0 y ~1")
eq(rayo_json_en(d, "/no"), nulo, "clave que no está")
eq(rayo_json_en(d, "/a/9"), nulo, "índice fuera")
eq(rayo_json_en(d, "/a/01"), nulo, "índice con cero a la izquierda")
eq(rayo_json_en(d, "/vacio/0"), nulo, "lista vacía")
eq(rayo_json_existe(d, "/z/v"), verdadero, "existe aunque sea null")
eq(rayo_json_crudo(d, "/a"), "[1, {\"b\\\"c\": \"x]}\"}, 3]", "crudo")
eq(rayo_json_contar(d, "/a"), 3, "contar")
eq(rayo_json_contar(d, "/o"), 0, "contar vacío")
eq(rayo_json_claves(d, ""), ["a", "z", "n~/m", "vacio", "o"], "claves")
eq([rayo_json_tipo(d, "/a"), rayo_json_tipo(d, "/z"), rayo_json_tipo(d, "/a/0"), rayo_json_tipo(d, "/z/v"), rayo_json_tipo(d, "/a/1/b\"c")], ["lista", "objeto", "numero", "nulo", "texto"], "tipos")
sea z = rayo_json_sub(d, "/z")
eq(rayo_json_en(z, "/k"), verdadero, "sub-documento")
eq(json_serializar(rayo_json_valor(z)), "{\"k\":true,\"v\":null}", "valor del sub-documento")
// Recorrer y detenerse.
sea vistos = []
rayo_json_recorrer(d, "/a", funcion(k, s) {
    vistos.agregar(k)
    retornar k < 1
})
eq(vistos, [0, 1], "recorrer se detiene")
eq(rayo_json_columnas(rayo_json_abrir("{\"f\": [{\"id\": 1, \"n\": \"a\", \"x\": [1]}, {\"id\": 2, \"x\": 0}]}"), "/f", ["id", "n"]), [{"id": 1, "n": "a"}, {"id": 2, "n": nulo}], "columnas")
eq(rayo_json_indice("[\"[,\",{\"a\":1}]"), [0, 5, 6, 10, 12, 13], "índice estructural")

// Parser completo.
sea p = rayo_json_parsear("[\"a\\nb\\u00e9\\ud83d\\ude00\\\\\\/\", -12, 0, 1.5e2, -0.25, {\"\\u0041\": null, \"l\": [true, false]}]")
eq(p[0], "a\nbé😀\\/", "escapes y pares sustitutos")
eq([p[1], p[2], p[3], p[4]], [-12, 0, 150, -0.25], "números")
eq(json_serializar(p[5]), "{\"A\":null,\"l\":[true,false]}", "objeto")
eq(rayo_json_parsear("  7  "), 7, "valor suelto")

// Validación estricta.
funcion malo(txt, msg, linea, col) {
    sea r = rayo_json_validar(txt)
    afirmar(r["valido"] == falso, "debía fallar: " + txt)
    eq([r["mensaje"], r["linea"], r["columna"]], [msg, linea, col], "validar " + txt)
}
afirmar(rayo_json_validar("{\"a\": [1, 2.5e-3, \"é\", {}], \"b\": null}")["valido"], "válido")
malo("{\n  \"a\": [1, 2,]\n}", "carácter inesperado", 2, 14)
malo("[01]", "número con ceros a la izquierda", 1, 3)
malo("[1.]", "faltan decimales", 1, 4)
malo("{\"a\" 1}", "se esperaba ':'", 1, 6)
malo("[tru]", "literal inválido (¿true?)", 1, 2)
malo("\"a\\x\"", "escape inválido", 1, 3)
malo("\"a" + char_de(1) + "\"", "carácter de control dentro de un texto", 1, 3)
malo("[1] 2", "sobra texto después del valor", 1, 5)
malo("[\"" + char_de(192) + char_de(128) + "\"]", "UTF-8 inválido", 1, 3)
malo("[\"" + char_de(237) + char_de(160) + char_de(128) + "\"]", "UTF-8 inválido", 1, 3)
malo("{\"a\": [1, 2}", "se esperaba ',' o ']'", 1, 12)
malo("", "se esperaba un valor", 1, 1)
sea hondo = ""
sea i = 0
mientras (i < 1100) {
    hondo = hondo + "["
    i = i + 1
}
eq(rayo_json_validar(hondo)["mensaje"], "demasiada profundidad", "profundidad")
sea error = ""
intentar { rayo_json_parsear("{\n\"a\": }") } capturar (e) { error = "" + e }
afirmar(texto_contiene(error, "línea 2, columna 6"), "error con línea y columna: " + error)

// Minificar y NDJSON.
eq(rayo_json_minificar("{ \"a b\" : [ 1 ,\n 2 ] , \"c\":\"\\\" x \" }\n"), "{\"a b\":[1,2],\"c\":\"\\\" x \"}", "minificar")
eq(json_serializar(rayo_json_lineas("{\"x\":1}\n\n [2] \r\n\"t\"")), "[{\"x\":1},[2],\"t\"]", "lineas")
sea nums = []
rayo_json_lineas_recorrer("1\n2\n3\n", funcion(v, l) {
    nums.agregar([v, l])
    retornar v < 2
})
eq(nums, [[1, 1], [2, 2]], "lineas_recorrer se detiene")
error = ""
intentar { rayo_json_lineas("1\n[2,\n") } capturar (e) { error = "" + e }
afirmar(texto_contiene(error, "línea 2"), "error de NDJSON: " + error)
eq(rayo_json_a_lineas([{"a": 1}, [2]]), "{\"a\":1}\n[2]\n", "a_lineas")

// Documento grande: el acceso bajo demanda y el parser coinciden.
sea partes = []
i = 0
mientras (i < 2000) {
    partes.agregar("{\"id\": " + i + ", \"n\": \"u" + i + " \\\"x\\\" [y]\", \"t\": [\"a\", {\"k\": [1, 2]}], \"ok\": true}")
    i = i + 1
}
sea grande = "{\"filas\": [" + unir(partes, ", ") + "], \"fin\": \"ok\"}"
sea g = rayo_json_abrir(grande)
eq(rayo_json_en(g, "/fin"), "ok", "campo al final")
eq(rayo_json_en(g, "/filas/1999/n"), "u1999 \"x\" [y]", "campo del último")
eq(rayo_json_contar(g, "/filas"), 2000, "contar grande")
sea todo = rayo_json_parsear(grande)
afirmar(json_serializar(todo) == json_serializar(json_parsear(grande)), "igual que json_parsear")
sea mini = rayo_json_minificar(grande)
afirmar(longitud(mini) < longitud(grande) y bytes_buscar(mini, ", ", 0) < 0, "minificado sin espacios")
afirmar(json_serializar(rayo_json_parsear(mini)) == json_serializar(todo), "minificado equivalente")
mostrar("[OK] rayo_json")
