importar "tabla"
importar "planilla"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Valores de referencia comprobados con Pandas.
sea t = tabla_de([{"region": "norte", "mes": "ene", "monto": 10}, {"region": "norte", "mes": "feb", "monto": 20}, {"region": "sur", "mes": "ene", "monto": 5}, {"region": "sur", "mes": "ene", "monto": 7}, {"region": "norte", "mes": "ene", "monto": 1}])
sea p = planilla_pivote(t, "region", "mes", "monto", "suma", 0)
igual([p["columnas"], p["filas"]], [["region", "ene", "feb"], [{"ene": 11, "feb": 20, "region": "norte"}, {"ene": 12, "feb": 0, "region": "sur"}]], "pivote")
igual(planilla_derretir(p, ["region"], nulo, "mes", "monto")["filas"], [{"mes": "ene", "monto": 11, "region": "norte"}, {"mes": "feb", "monto": 20, "region": "norte"}, {"mes": "ene", "monto": 12, "region": "sur"}, {"mes": "feb", "monto": 0, "region": "sur"}], "derretir")
igual(planilla_cruzada(t, "region", "mes", verdadero)["filas"][2], {"ene": 4, "feb": 1, "region": "total", "total": 5}, "tabla cruzada con totales")
sea s = tabla_de([{"d": 1, "v": 10}, {"d": 2, "v": 12}, {"d": 3, "v": nulo}, {"d": 4, "v": 18}, {"d": 5, "v": 12}])
sea ff = planilla_rellenar(s, ["v"], "adelante")
igual(tabla_columna(ff, "v"), [10, 12, 12, 18, 12], "rellenar adelante")
igual(tabla_columna(planilla_rellenar(s, ["v"], "atras"), "v"), [10, 12, 18, 18, 12], "rellenar atrás")
igual(tabla_columna(planilla_rellenar(s, ["v"], "media"), "v"), [10, 12, 13, 18, 12], "rellenar con media")
igual(tabla_columna(planilla_movil(ff, "v", 3, "media", "m3"), "m3"), [nulo, nulo, 11.3333, 14, 14], "media móvil")
igual(tabla_columna(planilla_movil(ff, "v", 3, "max", "m", 1), "m"), [10, 12, 12, 18, 18], "móvil con min_filas")
igual(tabla_columna(planilla_acumulado(s, "v", "suma"), "v_acum"), [10, 22, 22, 40, 52], "acumulado")
igual(tabla_columna(planilla_cambio(s, "v"), "v_cambio"), [nulo, 0.2, nulo, nulo, -0.333333], "cambio porcentual")
igual(tabla_columna(planilla_desplazar(s, "v", 1), "v_desp"), [nulo, 10, 12, nulo, 18], "desplazar")
igual(tabla_columna(planilla_rango(s, "v", "r"), "r"), [1, 2.5, nulo, 4, 2.5], "rango promedio")
igual(tabla_columna(planilla_rango(s, "v", "r", verdadero, "denso"), "r"), [3, 2, nulo, 1, 2], "rango denso descendente")
igual(tabla_columna(planilla_rango(s, "v", "r", falso, "min"), "r"), [1, 2, nulo, 4, 2], "rango min")
sea g = planilla_agrupar(t, ["region"], {"med": ["monto", "mediana"], "sd": ["monto", "desv"], "q": ["monto", "q0.75"]})
igual(g["filas"], [{"med": 10, "q": 15, "region": "norte", "sd": 9.50438}, {"med": 6, "q": 6.5, "region": "sur", "sd": 1.41421}], "agrupar con mediana, desviación y cuantil")
igual(tabla_largo(planilla_sin_duplicados(t, ["region", "mes"])), 3, "sin duplicados")
igual(tabla_columna(planilla_porcentaje(t, "monto", "pct", "region"), "pct"), [0.322581, 0.645161, 0.416667, 0.583333, 0.0322581], "porcentaje por grupo")
igual([planilla_agregar([1, 2, 3, 4], "var"), planilla_agregar([2, 3, 4], "producto"), planilla_agregar([nulo, 1, 1, 2], "unicos")], [1.66667, 24, 2], "agregaciones sueltas")
sea m = ""
intentar { planilla_agregar([1], "moda") } capturar (e) { m = e }
igual(m, "planilla: agregación desconocida moda", "agregación desconocida")
mostrar("[OK] planilla")
