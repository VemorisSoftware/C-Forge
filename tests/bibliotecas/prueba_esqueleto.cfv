// Pruebas de esqueleto (formato de Spine).
importar "esqueleto"
importar "imagen"
importar "vector"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion cerca(a, b, q) { afirmar(abs(a - b) < 0.0001, q + ": " + a + " != " + b) }
funcion r4(x) { retornar redondear(x * 10000) / 10000 }

sea datos = {
    "skeleton": {"spine": "4.1.20", "width": 100, "height": 100},
    "bones": [
        {"name": "root"},
        {"name": "brazo", "parent": "root", "rotation": 90, "length": 50},
        {"name": "ante", "parent": "brazo", "x": 50, "length": 40},
        {"name": "fijo", "parent": "brazo", "x": 10, "transform": "onlyTranslation"},
        {"name": "meta", "parent": "root", "x": 60, "y": 30},
        {"name": "solo", "parent": "root", "x": -30, "length": 20},
        {"name": "meta1", "parent": "root", "x": -30, "y": 40}
    ],
    "slots": [
        {"name": "s_brazo", "bone": "brazo", "attachment": "caja"},
        {"name": "s_ante", "bone": "ante", "attachment": "malla", "color": "ff000080"},
        {"name": "s_col", "bone": "root", "attachment": "golpe"},
        {"name": "s_pto", "bone": "ante", "attachment": "mano"}
    ],
    "skins": [
        {"name": "default", "attachments": {
            "s_brazo": {"caja": {"x": 25, "width": 20, "height": 10, "rotation": -90}, "otra": {"width": 4, "height": 4}},
            "s_ante": {"malla": {"type": "mesh", "uvs": [0, 1, 0, 0, 1, 0], "triangles": [0, 1, 2], "hull": 3,
                "vertices": [1, 1, 0, 0, 1, 2, 1, 0, 0, 0.5, 2, 10, 0, 0.5, 1, 2, 0, 10, 1]}},
            "s_col": {"golpe": {"type": "boundingbox", "vertexCount": 4, "vertices": [-5, -5, 5, -5, 5, 5, -5, 5]}},
            "s_pto": {"mano": {"type": "point", "x": 40, "y": 0, "rotation": 90}}
        }},
        {"name": "rojo", "attachments": {"s_brazo": {"caja": {"x": 25, "width": 30, "height": 10, "rotation": -90, "color": "ff0000ff"}}}}
    ],
    "events": {"paso": {"int": 3, "string": "pie"}},
    "ik": [
        {"name": "ik2", "bones": ["brazo", "ante"], "target": "meta", "mix": 0, "order": 0},
        {"name": "ik1", "bones": ["solo"], "target": "meta1", "mix": 0, "order": 1}
    ],
    "animations": {
        "girar": {"bones": {"brazo": {"rotate": [{"time": 0, "value": 0}, {"time": 1, "value": 90}]}}},
        "suave": {"bones": {"brazo": {"rotate": [{"time": 0, "value": 0, "curve": [0.25, 0, 0.75, 100]}, {"time": 1, "value": 100}]},
                            "ante": {"translate": [{"time": 0, "curve": "stepped"}, {"time": 1, "x": 10, "y": 5}],
                                     "scale": [{"time": 0}, {"time": 2, "x": 3, "y": 1}]}}},
        "colores": {"slots": {"s_brazo": {"attachment": [{"time": 0.5, "name": "otra"}, {"time": 1, "name": null}],
                                           "rgba": [{"time": 0, "color": "ffffffff"}, {"time": 1, "color": "00000000"}]}},
                    "drawOrder": [{"time": 0.5, "offsets": [{"slot": "s_brazo", "offset": 2}]}]},
        "pasos": {"bones": {"root": {"translate": [{"time": 0}, {"time": 1, "x": 0}]}},
                  "events": [{"time": 0.25, "name": "paso"}, {"time": 0.75, "name": "paso", "string": "otro"}]},
        "alcanzar": {"ik": {"ik2": [{"time": 0, "mix": 1}]}}
    }
}
sea e = esqueleto_cargar(json_texto(datos))
// Pose inicial.
sea h = esqueleto_hueso(e, "ante")
eq([r4(h["x"]), r4(h["y"]), r4(h["rotacion"])], [0, 50, 90], "ante inicial")
eq([r4(esqueleto_hueso(e, "fijo")["x"]), r4(esqueleto_hueso(e, "fijo")["y"]), r4(esqueleto_hueso(e, "fijo")["rotacion"])], [0, 10, 0], "solo traslación")
eq(esqueleto_animaciones(e), ["alcanzar", "colores", "girar", "pasos", "suave"], "animaciones")
eq([esqueleto_duracion(e, "suave"), esqueleto_duracion(e, "pasos")], [2, 1], "duraciones")
// Rotación lineal.
esqueleto_aplicar(e, "girar", 0.5, falso, 1, nulo)
esqueleto_mundo(e)
h = esqueleto_hueso(e, "ante")
cerca(h["x"], 50 * coseno(135 * pi() / 180), "x a 135°")
cerca(h["y"], 50 * seno(135 * pi() / 180), "y a 135°")
// Con alfa a medias desde la pose inicial: 90 + 22.5.
esqueleto_pose_inicial(e)
esqueleto_aplicar(e, "girar", 0.5, falso, 0.5, nulo)
cerca(e["huesos"][1]["rot"], 112.5, "alfa")
// Bucle.
esqueleto_pose_inicial(e)
esqueleto_aplicar(e, "girar", 2.25, verdadero, 1, nulo)
cerca(e["huesos"][1]["rot"], 90 + 22.5, "bucle")
// Bezier simétrica: a la mitad vale la mitad, a un cuarto menos que lineal.
esqueleto_pose_inicial(e)
esqueleto_aplicar(e, "suave", 0.5, falso, 1, nulo)
cerca(e["huesos"][1]["rot"], 140, "bezier mitad")
eq([e["huesos"][2]["x"], e["huesos"][2]["y"]], [50, 0], "escalonada")
cerca(e["huesos"][2]["sx"], 1.5, "escala")
esqueleto_pose_inicial(e)
esqueleto_aplicar(e, "suave", 0.25, falso, 1, nulo)
afirmar(e["huesos"][1]["rot"] - 90 < 25 y e["huesos"][1]["rot"] - 90 > 0, "bezier cuarto")
esqueleto_aplicar(e, "suave", 1.5, falso, 1, nulo)
eq([e["huesos"][2]["x"], e["huesos"][2]["y"]], [60, 5], "traslación")
// Adjuntos, color y orden de dibujo.
esqueleto_pose_inicial(e)
esqueleto_aplicar(e, "colores", 0.6, falso, 1, nulo)
eq(e["ranuras"][0]["adjunto"], "otra", "adjunto")
cerca(e["ranuras"][0]["color"][0], 0.4, "color")
eq(e["orden"], [1, 2, 0, 3], "orden de dibujo")
esqueleto_aplicar(e, "colores", 1, falso, 1, nulo)
eq(e["ranuras"][0]["adjunto"], nulo, "sin adjunto")
esqueleto_pose_inicial(e)
eq([e["ranuras"][0]["adjunto"], e["orden"]], ["caja", [0, 1, 2, 3]], "pose inicial")
// Eventos con bucle.
sea evs = esqueleto_aplicar(e, "pasos", 2.3, verdadero, 1, 0.5)
eq(longitud(evs), 4, "eventos en el rango")
eq([evs[0]["texto"], evs[1]["texto"], evs[0]["entero"]], ["otro", "pie", 3], "datos del evento")
// Región: la caja de 20x10 girada -90 sobre un hueso a 90°.
esqueleto_pose_inicial(e)
esqueleto_mundo(e)
sea tris = esqueleto_triangulos(e, nulo)
eq(longitud(tris), 2, "dos dibujables")
sea v = []
para x en tris[0]["vertices"] { v.agregar(r4(x)) }
eq(v, [-10, 20, -10, 30, 10, 30, 10, 20], "esquinas de la región")
// Malla con pesos: v0 en el antebrazo, v1 mitad y mitad, v2 en el brazo.
v = []
para x en tris[1]["vertices"] { v.agregar(r4(x)) }
eq(v, [0, 0, 0, 30, -10, 50], "malla con pesos")
eq([tris[1]["color"][0], r4(tris[1]["color"][3])], [1, 0.502], "color de la ranura")
// Pieles.
eq(esqueleto_pieles(e), ["default", "rojo"], "pieles")
esqueleto_piel(e, "rojo")
eq(esqueleto_adjunto(e, "s_brazo", nulo)["ancho"], 30, "piel roja")
eq(esqueleto_adjunto(e, "s_ante", nulo)["tipo"], "mesh", "cae a default")
esqueleto_piel(e, nulo)
esqueleto_poner_adjunto(e, "s_brazo", "otra")
eq(esqueleto_triangulos(e, nulo)[0]["adjunto"], "otra", "poner adjunto")
sea fallo = falso
intentar { esqueleto_poner_adjunto(e, "s_brazo", "nada") } capturar (x) { fallo = verdadero }
eq(fallo, verdadero, "adjunto desconocido")
esqueleto_pose_inicial(e)
// Caja de colisión y punto.
eq([esqueleto_tocar(e, 1, 1), esqueleto_tocar(e, 7, 1)], ["golpe", nulo], "tocar")
sea p = esqueleto_punto(e, "s_pto", nulo)
eq([r4(p["x"]), r4(p["y"]), r4(p["rotacion"])], [0, 90, 180], "punto")
eq(esqueleto_limites(e), [-10, 0, 10, 50], "límites")
// IK de dos huesos: la punta del antebrazo llega al objetivo.
esqueleto_aplicar(e, "alcanzar", 0, falso, 1, nulo)
esqueleto_mundo(e)
sea an = e["huesos"][2]
cerca(an["wx"] + an["a"] * 40, 60, "ik2 x")
cerca(an["wy"] + an["c"] * 40, 30, "ik2 y")
// Doblar al otro lado deja el codo en el otro lado de la línea.
sea codo1 = an["wy"] * 60 - an["wx"] * 30
e["ik"][0]["dobla"] = -1
esqueleto_mundo(e)
an = e["huesos"][2]
cerca(an["wx"] + an["a"] * 40, 60, "ik2 doblado x")
afirmar((an["wy"] * 60 - an["wx"] * 30) * codo1 < 0, "codo del otro lado")
// IK de un hueso.
esqueleto_pose_inicial(e)
e["ik"][1]["mezcla"] = 1
esqueleto_mundo(e)
cerca(esqueleto_hueso(e, "solo")["rotacion"], 90, "ik1")
// Objetivo fuera de alcance: el brazo queda estirado hacia él.
esqueleto_pose_inicial(e)
esqueleto_mover_hueso(e, "meta", {"x": 300, "y": 0})
e["ik"][0]["mezcla"] = 1
esqueleto_mundo(e)
an = e["huesos"][2]
cerca(an["wy"], 0, "estirado y")
cerca(an["wx"] + an["a"] * 40, 90, "estirado x")
// Posición y escala del esqueleto.
esqueleto_pose_inicial(e)
esqueleto_posicion(e, 100, 0, 2, 2)
esqueleto_mundo(e)
eq([r4(esqueleto_hueso(e, "ante")["x"]), r4(esqueleto_hueso(e, "ante")["y"])], [100, 100], "posición")
sea ml = esqueleto_mundo_a_local(e, "brazo", 100, 100)
eq([r4(ml[0]), r4(ml[1])], [50, 0], "mundo a local")
esqueleto_posicion(e, 0, 0, 1, 1)
// Estado con mezcla, cola y eventos.
sea est = esqueleto_estado(e)
sea vistos = []
sea terminadas = []
est["al_evento"] = funcion(x) { vistos.agregar(x["texto"]) }
est["al_terminar"] = funcion(pista, nombre) { terminadas.agregar(nombre) }
esqueleto_estado_mezcla(est, "girar", "suave", 0.5)
esqueleto_estado_poner(est, 0, "girar", falso)
esqueleto_estado_actualizar(est, 0.5)
esqueleto_estado_aplicar(est)
cerca(e["huesos"][1]["rot"], 135, "estado")
esqueleto_estado_poner(est, 0, "suave", falso)
esqueleto_estado_actualizar(est, 0.25)
eq(esqueleto_estado_pista(est, 0)["mezclando_desde"], "girar", "mezclando")
esqueleto_estado_aplicar(est)
// girar en 0.75 da 157.5; suave en 0.25 da menos; mitad y mitad.
sea suave_cuarto = 0
esqueleto_pose_inicial(e)
esqueleto_aplicar(e, "suave", 0.25, falso, 1, nulo)
suave_cuarto = e["huesos"][1]["rot"]
esqueleto_estado_aplicar(est)
cerca(e["huesos"][1]["rot"], 157.5 + (suave_cuarto - 157.5) * 0.5, "mezcla cruzada")
esqueleto_estado_actualizar(est, 0.3)
eq(esqueleto_estado_pista(est, 0)["mezclando_desde"], nulo, "mezcla terminada")
esqueleto_estado_encolar(est, 0, "pasos", verdadero, nulo)
esqueleto_estado_actualizar(est, 1.5)
eq([esqueleto_estado_pista(est, 0)["animacion"], terminadas], ["pasos", ["suave"]], "cola")
esqueleto_estado_actualizar(est, 1.1)
eq(vistos, ["pie", "otro"], "eventos del estado")
// Pistas encima con alfa.
esqueleto_estado_quitar(est, 0)
esqueleto_estado_poner(est, 1, "girar", falso)
esqueleto_estado_alfa(est, 1, 0.5)
esqueleto_estado_actualizar(est, 1)
esqueleto_estado_aplicar(est)
cerca(e["huesos"][1]["rot"], 135, "alfa de la pista")
// Formato 3.8: "angle" y curvas normalizadas.
sea e3 = esqueleto_cargar({"skeleton": {"spine": "3.8.99"}, "bones": [{"name": "r"}, {"name": "b", "parent": "r"}], "slots": [],
    "skins": {"default": {}}, "animations": {"a": {"bones": {"b": {"rotate": [{"time": 0, "angle": 0, "curve": 0.25, "c2": 0, "c3": 0.75, "c4": 1}, {"time": 2, "angle": 60}]}}}}})
esqueleto_aplicar(e3, "a", 1, falso, 1, nulo)
cerca(e3["huesos"][1]["rot"], 30, "3.8 bezier")
// Atlas y dibujo con texturas.
sea atl = "\nheroe.png\nsize: 4,4\nformat: RGBA8888\nfilter: Linear,Linear\nrepeat: none\ncaja\n  bounds: 0,0,2,2\notra\n  rotate: true\n  xy: 2, 0\n  size: 2, 1\n  orig: 2, 1\n  offset: 0, 0\n  index: -1\n"
sea at = esqueleto_atlas(atl, funcion(n) { retornar imagen_nueva(4, 4, [0, 200, 0, 255]) })
eq([at["paginas"][0]["nombre"], at["paginas"][0]["ancho"], at["regiones"]["caja"]["u2"], at["regiones"]["otra"]["rotada"], at["regiones"]["otra"]["v2"]], ["heroe.png", 4, 0.5, verdadero, 0.5], "atlas")
esqueleto_pose_inicial(e)
esqueleto_mundo(e)
sea img = imagen_nueva(60, 60, [0, 0, 0, 0])
esqueleto_dibujar_imagen(e, at, img, {"x": 30, "y": 55})
// La caja ocupa x -10..10, y 20..30 → en pantalla x 20..40, y 25..35.
eq(imagen_pixel(img, 30, 30), [0, 200, 0, 255], "píxel de la caja")
eq(imagen_pixel(img, 5, 5)[3], 0, "fuera")
// La malla es roja semitransparente sobre verde: queda de color mezclado.
afirmar(imagen_pixel(img, 23, 15)[3] > 0, "malla dibujada")
sea lz = vector_nuevo("svg", 60, 60, nulo)
esqueleto_dibujar_vector(e, lz, {"x": 30, "y": 55, "huesos": verdadero})
afirmar(contiene(vector_terminar(lz), "<path"), "svg")
mostrar("[OK] esqueleto")
