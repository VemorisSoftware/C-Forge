importar "registro"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea mem = registro_memoria(3)
sea js = registro_memoria(10, {"formato": "json", "nivel": "aviso"})
registro_configurar({"nivel": "info", "niveles": {"app.db": "depuracion", "app.db.ruido": "error"}, "destinos": [mem, js], "reloj": funcion() { retornar 1763769600123 }})
sea db = registro_obtener("app.db")
sea web = registro_obtener("app.web")
igual([registro_nivel_de("app.db.x"), registro_nivel_de("app.dbx"), registro_nivel_de("app.db.ruido.y"), registro_nivel_de("otro")], ["depuracion", "info", "error", "info"], "niveles por jerarquía")
igual(registro_depuracion(db, "consulta", {"sql": "select 1", "ms": 3}), verdadero, "emite")
igual(registro_depuracion(web, "no se ve"), falso, "filtra por nivel")
registro_depuracion(registro_obtener("app.db.ruido"), "tampoco")
igual(registro_lineas(mem)[0], "2025-11-22 00:00:00.123 DEBUG app.db - consulta ms=3 sql=\"select 1\"", "formato por defecto")
registro_en_contexto({"peticion": "abc"}, funcion() { registro_aviso(registro_con(web, {"usuario": 7}), "lento\nlínea falsa") })
registro_error(db, "caída")
registro_info(db, "cuarto")
igual(registro_lineas(mem), ["2025-11-22 00:00:00.123 WARN  app.web - lento\\nlínea falsa peticion=abc usuario=7", "2025-11-22 00:00:00.123 ERROR app.db - caída", "2025-11-22 00:00:00.123 INFO  app.db - cuarto"], "memoria circular, contexto y escape")
igual(registro_lineas(js), ["{\"mensaje\":\"lento\\nlínea falsa\",\"nivel\":\"aviso\",\"nombre\":\"app.web\",\"peticion\":\"abc\",\"ts\":\"2025-11-22T00:00:00.123Z\",\"usuario\":7}", "{\"mensaje\":\"caída\",\"nivel\":\"error\",\"nombre\":\"app.db\",\"ts\":\"2025-11-22T00:00:00.123Z\"}"], "JSON con nivel mínimo por destino")
igual(registro_conteo(), {"aviso": 1, "depuracion": 1, "error": 1, "info": 1}, "conteo")
igual(registro_eventos(js)[1]["campos"], {}, "el contexto se quitó")
sea vistos = []
registro_configurar({"destinos": [registro_funcion(funcion(ev, linea) { vistos.agregar(ev["nivel"] + ":" + ev["mensaje"]) }, {"patron": "%nivel %mensaje"})], "reloj": funcion() { retornar 0 }})
registro_fatal(db, "fin")
igual(vistos, ["fatal:fin"], "destino propio")
sea mp = registro_memoria(5, {"patron": "[%fecha %hora] %nivel %nombre: %mensaje"})
registro_configurar({"destinos": [mp]})
registro_info(registro_obtener(), "hola")
igual(registro_lineas(mp), ["[1970-01-01 00:00:00] info raiz: hola"], "patrón propio")
sea ruta = "/tmp/cforge_prueba_registro.log"
escribir_archivo(ruta, "")
escribir_archivo(ruta + ".1", "")
escribir_archivo(ruta + ".2", "")
registro_configurar({"destinos": [registro_archivo(ruta, {"max_bytes": 120, "copias": 2, "patron": "%NIVEL %mensaje"})]})
sea i = 0
mientras (i < 12) { registro_info(db, "mensaje número " + i)  i = i + 1 }
igual(leer_archivo(ruta), "INFO  mensaje número 10\nINFO  mensaje número 11\n", "archivo activo")
afirmar(texto_indice(leer_archivo(ruta + ".1"), "número 9") >= 0, "copia 1")
afirmar(texto_indice(leer_archivo(ruta + ".2"), "número 0") >= 0, "copia 2")
sea m = ""
intentar { registro_configurar({"nivel": "ruidoso"}) } capturar (e) { m = e }
igual(m, "registro: nivel desconocido ruidoso", "nivel inválido")
registro_reiniciar()
igual(registro_nivel_de("app.db"), "info", "reiniciar")
mostrar("[OK] registro")
