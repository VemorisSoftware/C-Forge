importar "terminal"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ":\n" + a + "\n!=\n" + b) }
// Diseño.
sea z = terminal_dividir({"x": 0, "y": 0, "ancho": 100, "alto": 10}, "horizontal", [["largo", 10], ["porcentaje", 50], ["relleno"]])
igual([z[0]["ancho"], z[1]["ancho"], z[2]["ancho"], z[2]["x"]], [10, 50, 40, 60], "dividir")
sea z2 = terminal_dividir({"x": 0, "y": 0, "ancho": 30, "alto": 9}, "vertical", [["proporcion", 1, 3], ["relleno", 2], ["relleno", 1]], {"espacio": 0})
igual([z2[0]["alto"], z2[1]["alto"], z2[2]["alto"]], [3, 4, 2], "proporción y pesos")
sea z3 = terminal_dividir({"x": 0, "y": 0, "ancho": 20, "alto": 1}, "horizontal", [["max", 5], ["min", 3]])
igual([z3[0]["ancho"], z3[1]["ancho"]], [5, 15], "mínimo y máximo")
igual(terminal_centrar({"x": 0, "y": 0, "ancho": 20, "alto": 10}, 6, 2), {"alto": 2, "ancho": 6, "x": 7, "y": 4}, "centrar")
// Bloque y párrafo.
sea b = terminal_bufer(20, 5)
sea dentro = terminal_bloque(b, terminal_area(b), {"titulo": "Hola", "bordes": "redondeados", "titulo_alinear": "centro"})
terminal_parrafo(b, dentro, "El veloz murciélago hindú comía", {"ajustar": verdadero})
igual(terminal_texto(b), ["╭───────Hola───────╮", "│El veloz          │", "│murciélago hindú  │", "│comía             │", "╰──────────────────╯"], "bloque y párrafo")
// Lista con selección que se desplaza.
sea l = terminal_bufer(10, 3)
sea st = terminal_lista(l, terminal_area(l), ["uno", "dos", "tres", "cuatro", "cinco"], {"seleccion": 3, "desplazamiento": 0}, {"estilo_seleccion": {"invertido": verdadero}})
igual([terminal_texto(l), st["desplazamiento"]], [["  dos     ", "  tres    ", "> cuatro  "], 1], "lista")
igual(terminal_celda(l, 5, 2)["m"]["invertido"], verdadero, "selección pintada")
// Tabla, medidor, chispa, barras y pestañas.
sea t = terminal_bufer(20, 3)
terminal_tabla(t, terminal_area(t), [["ana", "30"], ["leo", "7"]], [["largo", 6], ["relleno"]], {"cabecera": ["nombre", "edad"]})
igual(terminal_texto(t), ["nombre edad         ", "ana    30           ", "leo    7            "], "tabla")
sea m = terminal_bufer(10, 1)
terminal_medidor(m, terminal_area(m), 0.5)
igual(terminal_texto(m), ["███50%    "], "medidor")
sea c = terminal_bufer(8, 1)
terminal_chispa(c, terminal_area(c), [0, 1, 2, 3, 4, 5, 6, 8])
igual(terminal_texto(c), [" ▁▂▃▄▅▆█"], "chispa")
sea p = terminal_bufer(20, 1)
terminal_pestanas(p, terminal_area(p), ["Inicio", "Ajustes"], 1)
igual([terminal_texto(p), terminal_celda(p, 9, 0)["m"]["invertido"]], [["Inicio │ Ajustes    "], verdadero], "pestañas")
sea br = terminal_bufer(7, 3)
terminal_barras(br, terminal_area(br), [["a", 2], ["b", 4]])
igual(terminal_texto(br), ["    ███", "███ ███", "a   b  "], "barras")
// Caracteres anchos.
sea w = terminal_bufer(6, 1)
terminal_escribir(w, 0, 0, "中文ab", nulo, nulo)
igual(terminal_texto(w), ["中文ab"], "anchos")
// ANSI y diferencias.
sea a1 = terminal_bufer(3, 1)
terminal_escribir(a1, 0, 0, "abc", {"fg": "rojo", "negrita": verdadero}, nulo)
sea esc = caracter(27)
igual(terminal_ansi(a1), esc + "[H" + esc + "[1;1H" + esc + "[0;1;31mabc" + esc + "[0m", "ansi")
sea a2 = terminal_bufer(3, 1)
terminal_escribir(a2, 0, 0, "abd", {"fg": "rojo", "negrita": verdadero}, nulo)
igual(terminal_diferencia(a1, a2), esc + "[1;3H" + esc + "[0;1;31md" + esc + "[0m", "diferencia")
igual(terminal_diferencia(a2, a2), "", "sin cambios")
igual(terminal_ansi(terminal_bufer(1, 1)) != "", verdadero, "vacío")
// Teclas.
igual([terminal_tecla(esc + "[A")["tecla"], terminal_tecla(esc + "[1;5C")["ctrl"], terminal_tecla(esc + "[15~")["tecla"], terminal_tecla(caracter(3))["tecla"], terminal_tecla(esc + "x")["alt"], terminal_tecla("ñ")["tecla"]], ["arriba", verdadero, "f5", "c", verdadero, "ñ"], "teclas")
mostrar("[OK] terminal")
