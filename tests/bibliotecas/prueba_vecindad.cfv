importar "vecindad"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion ids(r) {
    sea l = []
    para x en r { l.agregar(x["id"]) }
    retornar l
}
sea v = vecindad_nueva(3)
vecindad_agregar(v, "a", [1, 0, 0], {"l": "es"})
vecindad_agregar(v, "b", [0.9, 0.1, 0], {"l": "en"})
vecindad_agregar(v, "c", [0, 1, 0], {"l": "es"})
vecindad_agregar(v, "d", [0, 0, 5], {"l": "es"})
igual(ids(vecindad_buscar(v, [1, 0.05, 0], 2)), ["a", "b"], "coseno")
igual(ids(vecindad_buscar(v, [10, 0.5, 0], 2)), ["a", "b"], "coseno ignora la magnitud")
igual(ids(vecindad_buscar(v, [1, 0.05, 0], 2, funcion(m) { retornar m["l"] == "es" })), ["a", "c"], "filtro")
igual(redondear(vecindad_buscar(v, [0, 0, 1], 1)[0]["puntaje"], 6), 1, "puntaje 1")
igual(vecindad_buscar(v, [0, 0, 1], 1)[0]["meta"]["l"], "es", "meta")
igual(longitud(vecindad_buscar(v, [1, 1, 1], 10)), 4, "k mayor que el total")
vecindad_agregar(v, "a", [0, 0, 1], {"l": "es"})
igual(ids(vecindad_buscar(v, [0, 0, 1], 2)), ["a", "d"], "reemplazo")
sea e = vecindad_nueva(2, "euclidea")
vecindad_agregar(e, 1, [0, 0])
vecindad_agregar(e, 2, [3, 4])
vecindad_agregar(e, 3, [1, 1])
sea r = vecindad_buscar(e, [0, 0], 3)
igual(ids(r), ["1", "3", "2"], "euclídea: menor primero")
igual(r[2]["puntaje"], 5, "distancia 5")
vecindad_quitar(e, 3)
igual([vecindad_tamano(e), ids(vecindad_buscar(e, [0.9, 0.9], 1))], [2, ["1"]], "quitar")
sea p = vecindad_nueva(2, "punto")
vecindad_agregar(p, "x", [1, 0])
vecindad_agregar(p, "y", [3, 0])
igual(ids(vecindad_buscar(p, [1, 0], 1)), ["y"], "producto punto premia la magnitud")
igual(redondear(vecindad_coseno([1, 2], [2, 4]), 9), 1, "coseno paralelo")
vecindad_guardar(v, "/tmp/cforge-vec.json")
igual(ids(vecindad_buscar(vecindad_cargar("/tmp/cforge-vec.json"), [0, 1, 0], 1)), ["c"], "guardar y cargar")
eliminar_archivo("/tmp/cforge-vec.json")
para malo en [[funcion() { vecindad_agregar(v, "z", [1, 2]) }, "vecindad: se esperaba un vector de 3 números"], [funcion() { vecindad_agregar(v, "z", [0, 0, 0]) }, "vecindad: vector nulo (no tiene dirección)"], [funcion() { vecindad_nueva(2, "manhattan") }, "vecindad: métrica \"coseno\", \"euclidea\" o \"punto\""]] {
    sea m = ""
    intentar { malo[0]() } capturar (x) { m = x }
    igual(m, malo[1], malo[1])
}
mostrar("[OK] vecindad")
