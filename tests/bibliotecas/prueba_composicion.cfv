importar "composicion"
importar "documento"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea c = composicion_nueva({"tamano": "A4", "pie": "Página %p de %t", "encabezado": "Vemoris — Informe", "titulo": "Informe"})
composicion_markdown(c, "# Informe trimestral\n\nResumen con **negrita**, *cursiva* y `código`: ñandú.\n\n| Región | Ventas |\n|:--|--:|\n| Norte | 1.200 |\n| Sur | 980 |\n\n- Uno\n- Dos\n\n> Lo que viene ya existe.\n\n```\nsea x = 1\n```\n\n---\n\nFin.")
sea largo = ""
sea i = 0
mientras (i < 60) { largo = largo + "Texto de relleno para probar el corte de página y la justificación. "  i = i + 1 }
composicion_titulo(c, "Anexo", 2)
composicion_parrafo(c, largo)
sea filas = [["#", "Nombre"]]
i = 1
mientras (i <= 60) { filas.agregar(["" + i, "Cliente " + i])  i = i + 1 }
composicion_tabla(c, filas, {"anchos": [1, 4]})
sea l = documento_leer(composicion_pdf(c))
afirmar(l["paginas"] >= 3, "varias páginas")
igual(l["titulo"], "Informe", "título")
afirmar(texto_indice(l["texto"][0], "Informe trimestral") >= 0, "encabezado markdown")
afirmar(texto_indice(l["texto"][0], "Página 1 de " + l["paginas"]) >= 0, "pie con total")
afirmar(texto_indice(l["texto"][l["paginas"] - 1], "Nombre") >= 0, "cabecera de tabla repetida")
afirmar(texto_indice(l["texto"][l["paginas"] - 1], "Cliente 60") >= 0, "última fila")
mostrar("[OK] composicion")
