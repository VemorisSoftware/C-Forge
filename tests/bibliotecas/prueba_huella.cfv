// Pruebas de huella. datos/huella/esperado.json lo generó yara-python 4.5.4
// con las mismas reglas (datos/huella/reglas.yar) y muestras.
importar "huella"
importar "json"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
funcion orden_cadenas(a, b) {
    si (a[0] < b[0]) { retornar -1 }
    si (a[0] > b[0]) { retornar 1 }
    retornar a[1] - b[1]
}

// Mismas reglas, cadenas y desplazamientos que YARA.
sea base = "tests/bibliotecas/datos/huella/"
sea reglas = huella_compilar(leer_archivo(base + "reglas.yar"))
sea esperado = json_parsear(leer_archivo(base + "esperado.json"))
para k en claves(esperado) {
    sea mio = []
    para x en huella_escanear_archivo(reglas, base + k) {
        sea cs = []
        para c en x["cadenas"] { cs.agregar([c["id"], c["desplazamiento"], longitud(c["datos"])]) }
        mio.agregar([x["regla"], ordenar(cs, orden_cadenas)])
    }
    eq(json_serializar(mio), json_serializar(esperado[k]), "igual que YARA en " + k)
}
sea pe = huella_escanear_archivo(reglas, base + "pe.bin")[0]
eq([pe["etiquetas"], pe["meta"]], [["ejecutable", "windows"], {"activa": verdadero, "autor": "Vemoris", "version": 2}], "etiquetas y meta")

// Semántica de coincidencias (comprobada con YARA): solapadas, regex codiciosa
// desde cada posición, wide, fullword y xor.
funcion casos(regla, datos) {
    sea r = []
    para x en huella_escanear(huella_compilar(regla), datos) { para c en x["cadenas"] { r.agregar(c["desplazamiento"] + ":" + c["datos"]) } }
    retornar r
}
eq(casos("rule r \{ strings: $a = \"aa\" condition: $a }", "aaaa"), ["0:aa", "1:aa", "2:aa"], "solapadas")
eq(casos("rule r \{ strings: $a = /a+/ condition: $a }", "aaa"), ["0:aaa", "1:aa", "2:a"], "regex en cada posición")
eq(casos("rule r \{ strings: $a = /a.+?c/ condition: $a }", "abcbc"), ["0:abc"], "cuantificador perezoso")
eq(casos("rule r \{ strings: $a = \{ 61 ( 62 | 63 ) [1-2] 64 } condition: $a }", "abxd acxyd"), ["0:abxd", "5:acxyd"], "hexadecimal con saltos")
eq(casos("rule r \{ strings: $a = \"mal\" fullword condition: $a }", "malware mal-o (mal)"), ["8:mal", "15:mal"], "fullword")
eq(longitud(casos("rule r \{ strings: $a = \"Hola\" nocase wide condition: $a }", "h" + char_de(0) + "O" + char_de(0) + "l" + char_de(0) + "A" + char_de(0))), 1, "wide nocase")
eq(casos("rule r \{ strings: $a = \{ 4? ?A } condition: $a }", "JAZ"), ["1:AZ"], "nibbles")

// Errores con línea.
eq(huella_validar("rule ok \{ condition: true }"), nulo, "regla mínima")
afirmar(texto_contiene(huella_validar("rule a \{ condition: true }\nrule a \{ condition: true }"), "repetida"), "regla repetida")
afirmar(texto_contiene(huella_validar("rule b \{\n strings: $x = \"a\"\n condition: $y }") ?? "", "") , "validar devuelve texto")
sea e = ""
intentar { huella_escanear(huella_compilar("rule c \{ condition: desconocida }"), "x") } capturar (x) { e = x }
afirmar(texto_contiene(e, "desconocida"), "identificador desconocido")
afirmar(texto_contiene(huella_validar("rule d \{\n\n condition: (true }") ?? "", "línea 3"), "error con número de línea")
mostrar("[OK] huella")
