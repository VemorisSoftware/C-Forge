importar "hoja"
importar "lee_excel"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
igual([hoja_columna(0), hoja_columna(25), hoja_columna(26), hoja_columna(701), hoja_columna(702)], ["A", "Z", "AA", "ZZ", "AAA"], "columnas")
sea libro = hoja_libro()
sea h = hoja_agregar(libro, "Ventas")
hoja_filas(h, [["Producto", "Precio", "Cantidad", "Total", "Fecha", "Pagado"], ["Café <&>", 2500, 3, "=B2*C2", {"fecha_ms": 1763683200000}, verdadero], ["Té", 1800.5, 2, "=B3*C3", nulo, falso], [{"texto": "=no es fórmula"}, "  espacios  "]], {"cabecera": verdadero})
hoja_anchos(h, [20, 12])
hoja_filas(hoja_agregar(libro, "Resumen"), [["Total", "=SUM(Ventas!D2:D3)"]])
sea bytes = hoja_xlsx(libro)
afirmar(texto_empieza_con(bytes, "PK"), "es un ZIP")
sea l = lee_excel_abrir(bytes)
igual(lee_excel_hojas(l), ["Ventas", "Resumen"], "hojas")
sea f = lee_excel_filas(l, "Ventas", {"fechas_ms": verdadero})
igual(f[0], ["Producto", "Precio", "Cantidad", "Total", "Fecha", "Pagado"], "cabecera")
igual([f[1][0], f[1][1], f[1][2], f[1][3], f[1][4], f[1][5]], ["Café <&>", 2500, 3, nulo, 1763683200000, verdadero], "valores (fórmula sin calcular = nulo)")
igual([f[2][1], f[2][4], f[2][5], f[3][0], f[3][1]], [1800.5, nulo, falso, "=no es fórmula", "  espacios  "], "decimales, huecos y textos")
sea r = lee_excel_registros(l, 0)
igual([longitud(r), r[0]["Producto"], r[1]["Precio"]], [3, "Café <&>", 1800.5], "registros")
para malo en [[funcion() { hoja_agregar(libro, "ventas") }, "hoja: ya existe la hoja ventas"], [funcion() { hoja_agregar(libro, "a/b") }, "hoja: el nombre no puede tener /"], [funcion() { hoja_agregar(libro, texto_repetir("x", 32)) }, "hoja: el nombre debe tener entre 1 y 31 caracteres"], [funcion() { hoja_xlsx(hoja_libro()) }, "hoja: el libro no tiene hojas"], [funcion() { lee_excel_filas(l, "Nada") }, "lee_excel: no existe la hoja Nada"]] {
    sea m = ""
    intentar { malo[0]() } capturar (e) { m = e }
    igual(m, malo[1], malo[1])
}
mostrar("[OK] hoja y lee_excel")
