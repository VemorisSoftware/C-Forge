importar "dialogo"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea guion = unir([
    "// Tienda del pueblo",
    "=== inicio",
    "Ana: Hola, {{nombre}}.",
    "* [Saludar] -> saludo",
    "* (oro >= 10) [Comprar espada] ~ oro -= 10 ~ espada = verdadero -> tienda",
    "* (no espada) [Pedir fiado] -> fiado",
    "* [Irse] -> FIN",
    "=== saludo",
    "Ana: ¡Qué gusto! (visita {{visitas_saludo}})",
    "-> inicio",
    "=== tienda",
    "Ana: Te quedan {{oro}} monedas.",
    "~ compras += 1",
    "-> FIN",
    "=== fiado",
    "Ana: Ni lo sueñes.",
    "Se ríe."
], "\n")
sea d = dialogo_cargar(guion, {"oro": 12, "nombre": "Javier"})
sea p = dialogo_paso(d)
igual(p["lineas"], [{"quien": "Ana", "texto": "Hola, Javier."}], "primera línea")
igual(longitud(p["opciones"]), 4, "opciones con condición")
dialogo_elegir(d, 0)
p = dialogo_paso(d)
igual([p["lineas"][0]["texto"], p["lineas"][1]["texto"]], ["¡Qué gusto! (visita 1)", "Hola, Javier."], "salto y vuelta")
dialogo_elegir(d, 1)
p = dialogo_paso(d)
igual([p["lineas"][0]["texto"], p["fin"], dialogo_variable(d, "oro"), dialogo_variable(d, "espada"), dialogo_variable(d, "compras")], ["Te quedan 2 monedas.", verdadero, 2, verdadero, 1], "efectos y fin")
sea pobre = dialogo_cargar(guion, {"oro": 3, "nombre": "Bo"})
p = dialogo_paso(pobre)
igual(longitud(p["opciones"]), 3, "sin oro no aparece comprar")
igual(p["opciones"][1]["texto"], "Pedir fiado", "condición negada")
dialogo_elegir(pobre, 1)
p = dialogo_paso(pobre)
igual([p["lineas"][1]["quien"], p["lineas"][1]["texto"], p["fin"]], [nulo, "Se ríe.", verdadero], "narración y fin sin opciones")
igual(longitud(pobre["historial"]), 4, "historial")
para malo en [
    ["=== a\n-> b", "dialogo: el nodo b no existe (línea 2)"],
    ["hola", "dialogo: línea 1 fuera de un nodo (empieza con === nombre)"],
    ["=== a\n=== a", "dialogo: nodo repetido a (línea 2)"],
    ["=== a\n* Ir -> FIN", "dialogo: opción sin [texto] (línea 2)"]
] {
    sea m = ""
    intentar { dialogo_cargar(malo[0]) } capturar (e) { m = e }
    igual(m, malo[1], malo[1])
}
sea bucle = dialogo_cargar("=== a\n-> b\n=== b\n-> a")
sea m = ""
intentar { dialogo_paso(bucle) } capturar (e) { m = e }
igual(m, "dialogo: bucle infinito entre nodos", "bucle")
intentar { dialogo_elegir(d, 9) } capturar (e) { m = e }
igual(m, "dialogo: opción inválida 9", "opción inválida")
mostrar("[OK] dialogo")
