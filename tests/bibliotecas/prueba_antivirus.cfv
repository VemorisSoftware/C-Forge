// Pruebas de antivirus: firmas de los cuatro formatos, contenedores y
// carpetas. La cadena EICAR se arma en tiempo de ejecución para que el
// repositorio no la contenga.
importar "antivirus"
importar "archivador"
importar "compress"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }

sea eicar = bytes_de_hex("58354f2150254041505b345c505a58353428505e2937434329377d2445494341522d5354414e444152442d414e544956495255532d544553542d46494c452124482b482a")
sea base = antivirus_base()
eq(antivirus_cuantas(base), 1, "EICAR de serie")
eq(antivirus_escanear(base, eicar + "\r\n"), ["Eicar-Test-Signature"], "EICAR")
eq(antivirus_escanear(base, "xx" + eicar), [], "EICAR fuera del desplazamiento 0")
eq(antivirus_escanear(antivirus_base({"eicar": falso}), eicar), [], "sin EICAR")

// Hashes (.hdb / .hsb): MD5, SHA-1 y SHA-256 con tamaño o "*".
sea malo = "contenido malicioso de prueba"
eq(antivirus_firma_md5(malo, "Prueba.MD5"), cfv_md5(malo) + ":29:Prueba.MD5", "sigtool --md5")
eq(antivirus_cargar(base, antivirus_firma_md5(malo, "Prueba.MD5") + "\n# comentario\n\n" + hex_de_bytes(sha1_bytes("otro")) + ":*:Prueba.SHA1", "hdb"), 2, "carga hdb")
antivirus_cargar(base, antivirus_firma_sha256("tercero", "Prueba.SHA256") + "\n" + cfv_md5("talla") + ":99:Prueba.TamanoMalo", "hsb")
eq(antivirus_escanear(base, malo), ["Prueba.MD5"], "md5")
eq(antivirus_escanear(base, "otro"), ["Prueba.SHA1"], "sha1 con *")
eq(antivirus_escanear(base, "tercero"), ["Prueba.SHA256"], "sha256")
eq(antivirus_escanear(base, "talla"), [], "tamaño distinto")

// Hexadecimales (.ndb).
sea ndb = "Hex.Literal:0:*:686f6c61206d756e646f\n" +
    "Hex.Comodin:0:*:6162??64\n" +
    "Hex.Nibble:0:*:4a?7a?4b\n" +
    "Hex.Estrella:0:*:696e6963696f*66696e\n" +
    "Hex.Rango:0:*:41{2-3}42\n" +
    "Hex.Exacto:0:*:43{2}44\n" +
    "Hex.Alt:0:*:5a(30|31|32)5a\n" +
    "Hex.Neg:0:*:51!(30|31)51\n" +
    "Hex.Despl:0:4,2:58585858\n" +
    "Hex.Fin:0:EOF-3:454f46\n" +
    "Hex.PE:1:0:4d5a\n" +
    "Hex.Inicio:0:*:??77777777"
eq(antivirus_cargar(base, ndb, "ndb"), 12, "carga ndb")
sea casos = [["dice hola mundo", "Hex.Literal"], ["xxabZdyy", "Hex.Comodin"], ["Jg" + char_de(167) + "K", "Hex.Nibble"], ["inicio ... largo ... fin", "Hex.Estrella"],
    ["AxxB", "Hex.Rango"], ["AxxxB", "Hex.Rango"], ["CxxD", "Hex.Exacto"], ["Z1Z", "Hex.Alt"], ["Q9Q", "Hex.Neg"], ["....XXXX", "Hex.Despl"], ["......XXXX", "Hex.Despl"],
    ["algo al final EOF", "Hex.Fin"], ["MZ" + bytes_de_hex("9000"), "Hex.PE"], ["-wwww", "Hex.Inicio"]]
para c en casos { eq(antivirus_escanear(base, c[0]), [c[1]], "positivo " + c[1] + " en " + c[0]) }
sea negativos = ["hola mundial", "abd", "JgwK", "fin ... inicio", "AB", "AxB", "AxxxxB", "CxD", "Z3Z", "Q1Q", ".......XXXX", "EOF al principio", "ZM", "wwww"]
para n en negativos { eq(antivirus_escanear(base, n), [], "negativo " + n) }
eq(antivirus_detalle(base, "..dice hola mundo")[0], {"firma": "Hex.Literal", "tipo": "hex", "desplazamiento": 7}, "detalle")

// Lógicas (.ldb).
sea ldb = "Logica.Y;Engine:51-255,Target:0;0&1;636f6e656374;726f62617220636c617665\n" +
    "Logica.O;Target:0;(0|1)&2;616161;626262;636363\n" +
    "Logica.Cuenta;Target:0;0>2;7a7a7a\n" +
    "Logica.Exacta;Target:0;0=2;2a2a2a\n" +
    "Logica.Despl;Target:0;0;0:4d4d"
eq(antivirus_cargar(base, ldb, "ldb"), 5, "carga ldb")
eq(antivirus_escanear(base, "conecta y robar clave"), ["Logica.Y"], "y")
eq(antivirus_escanear(base, "conecta"), [], "y incompleto")
eq(antivirus_escanear(base, "bbb ccc"), ["Logica.O"], "o")
eq(antivirus_escanear(base, "aaa"), [], "o sin la 2")
eq(antivirus_escanear(base, "zzz zzz zzz"), ["Logica.Cuenta"], "cuenta > 2")
eq(antivirus_escanear(base, "zzz zzz"), [], "cuenta 2")
eq(antivirus_escanear(base, "*** ***"), ["Logica.Exacta"], "= 2")
eq(antivirus_escanear(base, "*** *** ***"), [], "= 2 con tres")
eq(antivirus_escanear(base, "MMxx"), ["Logica.Despl"], "subfirma con desplazamiento")
eq(antivirus_escanear(base, "xMMx"), [], "subfirma fuera del desplazamiento")

// Lista de ignorados (.ign2).
antivirus_cargar(base, "Hex.Alt", "ign2")
eq(antivirus_escanear(base, "Z1Z"), [], "ignorada")

// Contenedores: ZIP dentro de ZIP y GZIP.
sea interno = archivador_zip([{"nombre": "doc/leeme.txt", "datos": "hola"}, {"nombre": "virus.com", "datos": eicar}], verdadero)
sea externo = archivador_zip([{"nombre": "paquete.zip", "datos": interno}], falso)
eq(antivirus_detalle(base, externo), [{"firma": "Eicar-Test-Signature", "tipo": "hex", "desplazamiento": 0, "dentro": "paquete.zip/virus.com"}], "zip anidado")
eq(antivirus_escanear(base, gzip(malo, 6)), ["Prueba.MD5"], "gzip")
eq(antivirus_escanear(antivirus_base({"profundidad": 0}), gzip(eicar, 6)), [], "sin desempaquetar")

// Carpetas.
sea dir = "/tmp/cforge_prueba_antivirus"
crear_carpeta(dir)
crear_carpeta(dir + "/sub")
escribir_archivo(dir + "/limpio.txt", "nada que ver")
escribir_archivo(dir + "/eicar.com", eicar)
escribir_archivo(dir + "/sub/doc.zip", interno)
escribir_archivo(dir + "/firmas.ndb", "Archivo.Firma:0:*:666f6f626172")
eq(antivirus_cargar_archivo(base, dir + "/firmas.ndb"), 1, "cargar archivo de firmas")
escribir_archivo(dir + "/sub/foo.txt", "...foobar...")
sea res = antivirus_escanear_carpeta(base, dir, verdadero)
sea vistas = []
para x en res { vistas.agregar([texto_reemplazar(x["ruta"], dir + "/", ""), x["firmas"]]) }
eq(vistas, [["eicar.com", ["Eicar-Test-Signature"]], ["sub/doc.zip", ["Eicar-Test-Signature"]], ["sub/foo.txt", ["Archivo.Firma"]]], "carpeta")
eq(antivirus_resumen(antivirus_escanear_carpeta(base, dir, falso)), {"archivos": 5, "infectados": 3}, "resumen")
para f en ["limpio.txt", "eicar.com", "sub/doc.zip", "sub/foo.txt", "firmas.ndb"] { eliminar_archivo(dir + "/" + f) }

// Errores de carga con número de línea.
para mal en [["nombre:0:*:6g", "ndb"], ["x:0:*:41{2", "ndb"], ["x:0:*:(41|4243)", "ndb"], ["abc:1:x", "hdb"], ["X;Target:0;0&1;4141", "ldb"], ["X;Target:0;(0;4141", "ldb"]] {
    sea error = ""
    intentar { antivirus_cargar(antivirus_base(), "\n" + mal[0], mal[1]) } capturar (e) { error = e }
    afirmar(texto_empieza_con(error, "antivirus: línea 2"), "error para " + mal[0] + ": " + error)
}
mostrar("[OK] antivirus")
