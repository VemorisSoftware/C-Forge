importar "navegacion"
funcion igual(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
// Costos comparados con Dijkstra de NetworkX sobre la misma grilla.
sea m = navegacion_grilla([
    "..........",
    ".######...",
    "......#...",
    "####..#.##",
    "......#...",
    ".####.....",
    ".........."])
sea a4 = navegacion_astar(m, [0, 0], [9, 6])
sea a8 = navegacion_astar(m, [0, 0], [9, 6], {"diagonal": verdadero})
igual([a4["costo"], redondear(a8["costo"], 4)], [15, 13.8284], "A* 4 y 8 direcciones")
sea j = navegacion_jps(m, [0, 0], [9, 6], {"completo": verdadero})
igual([redondear(j["costo"], 4), longitud(j["camino"]), j["explorados"] < a8["explorados"]], [13.8284, longitud(a8["camino"]), verdadero], "JPS igual a A*")
// Sin cortar esquinas.
sea esquina = navegacion_grilla([".#", "#."])
igual(navegacion_astar(esquina, [0, 0], [1, 1], {"diagonal": verdadero}), nulo, "sin cortar esquinas")
// Costos por celda: el camino evita el pantano.
sea costos = navegacion_grilla([".....", ".999.", "....."])
igual(navegacion_astar(costos, [0, 1], [4, 1])["costo"], 6, "costos")
// Suavizado, línea de visión y mapa de flujo.
sea s = navegacion_suavizar(m, a8["camino"])
afirmar(longitud(s) < longitud(a8["camino"]) y navegacion_largo(s) <= a8["costo"] + 1e-6, "suavizado")
igual([navegacion_vision(m, [0, 0], [9, 0]), navegacion_vision(m, [0, 0], [0, 6])], [verdadero, falso], "visión")
sea f = navegacion_flujo(m, [9, 6])
igual(redondear(f["distancia"][0][0], 4), 13.8284, "flujo")
igual(navegacion_seguir_flujo(f, [0, 0])[longitud(navegacion_seguir_flujo(f, [0, 0])) - 1], [9, 6], "seguir flujo")
// NavMesh: una U; el camino dobla en las dos esquinas interiores.
sea nm = navegacion_malla_desde_poligono([[0, 0], [10, 0], [10, 10], [7, 10], [7, 3], [3, 3], [3, 10], [0, 10]])
sea r = navegacion_malla_camino(nm, [1, 9], [9, 9])
igual([r["camino"], redondear(r["largo"], 4)], [[[1, 9], [3, 3], [7, 3], [9, 9]], 16.6491], "embudo")
igual(navegacion_malla_camino(nm, [1, 1], [9, 1])["camino"], [[1, 1], [9, 1]], "línea recta")
igual([navegacion_poligono_en(nm, [5, 5]), navegacion_malla_camino(nm, [5, 5], [1, 1])], [-1, nulo], "fuera de la malla")
mostrar("[OK] navegacion")
