// Pruebas del decodificador MP3 (comparado con ffmpeg/libmp3lame).
importar "mezcla"
funcion eq(a, b, q) { afirmar(("" + a) == ("" + b), q + ": [" + a + "] != [" + b + "]") }
sea refs = {}
para l en texto_dividir(texto_recortar(leer_archivo("tests/bibliotecas/datos/mezcla-mp3-ref.txt")), "\n") {
    sea p = texto_dividir(l, " ")
    refs[p[0]] = {"n": a_numero(p[1]), "d": bytes_de_hex(p[2])}
}
// Cada 31 muestras de la salida de ffmpeg; se acepta 1 de diferencia (redondeo).
funcion comparar(nombre, s, refs) {
    sea r = refs[nombre]
    eq(longitud(s["c"][0]), r["n"], nombre + ": largo sin huecos")
    sea nc = s["canales"]
    sea maxd = 0
    sea k = 0
    sea i = 0
    mientras (i < r["n"]) {
        sea c = 0
        mientras (c < nc) {
            sea v = bytes_leer_entero(r["d"], k * 2, 2, 1)
            si (v >= 32768) { v = v - 65536 }
            maxd = maximo(maxd, absoluto(redondear(s["c"][c][i] * 32767) - v))
            k = k + 1
            c = c + 1
        }
        i = i + 31
    }
    afirmar(maxd <= 1, nombre + ": diferencia " + maxd)
}
// MPEG-1 44,1 kHz estéreo conjunto (medio/lado) con bloques cortos.
sea d1 = leer_archivo("tests/bibliotecas/datos/mezcla-ms44.mp3")
afirmar(mp3_es(d1), "es mp3")
sea inf = mp3_info(d1)
eq([inf["version"], inf["tasa"], inf["canales"], inf["modo"], inf["kbps"], inf["muestras"], inf["gapless"]], ["MPEG-1", 44100, 2, "estereo_conjunto", 96, 17640, verdadero], "info")
sea s1 = mp3_decodificar(d1, nulo)
comparar("ms44", s1, refs)
// MPEG-2 24 kHz VBR con muchos bloques cortos.
comparar("vbr24", mp3_decodificar(leer_archivo("tests/bibliotecas/datos/mezcla-vbr24.mp3"), nulo), refs)
// MPEG-2.5 8 kHz mono.
comparar("m25_8", mp3_decodificar(leer_archivo("tests/bibliotecas/datos/mezcla-m25_8.mp3"), nulo), refs)
// MPEG-2 22,05 kHz estéreo, abierto por mezcla_abrir.
sea s4 = mezcla_abrir(leer_archivo("tests/bibliotecas/datos/mezcla-lsf22.mp3"))
comparar("lsf22", s4, refs)
// Sin recorte: incluye el retardo del codificador.
afirmar(longitud(mp3_decodificar(d1, {"sin_recorte": verdadero})["c"][0]) > 17640, "sin recorte")
// Solo el principio.
eq(longitud(mp3_decodificar(d1, {"max_ms": 100})["c"][0]), 4410, "max_ms")
// Con ID3v2 adelante y basura entre tramas.
sea id3 = "ID3" + char_de(4) + char_de(0) + char_de(0) + char_de(0) + char_de(0) + char_de(0) + char_de(10) + "0123456789"
sea s5 = mp3_decodificar(id3 + d1, nulo)
eq(longitud(s5["c"][0]), 17640, "con ID3v2")
// Se mezcla y se guarda como cualquier otra fuente.
sea mono = mezcla_canales(s1, 1)
afirmar(mezcla_pico(mono) > 0.3 y mezcla_pico(mono) < 0.7, "pico " + mezcla_pico(mono))
eq(subtexto(mezcla_wav(mezcla_recortar(s1, 0, 50)), 0, 4), "RIFF", "a WAV")
sea mal = falso
intentar { mp3_decodificar("no es audio", nulo) } capturar (e) { mal = contiene(e, "mp3") }
afirmar(mal, "error claro")
mostrar("[OK] mezcla_mp3")
