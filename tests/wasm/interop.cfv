// tests/wasm — extern "js" y funciones de C-Forge llamadas desde JavaScript.
extern "js" funcion doble(x: numero): numero
extern "js" funcion saludo(nombre: texto): texto
extern "js" funcion avisar(codigo: entero, ok: booleano)
mostrar(doble(21))
mostrar(saludo("C-Forge"))
avisar(7, verdadero)
sea t = tarea(funcion() { retornar 6 * 7 })
mostrar(esperar(t))
funcion cuadrado(n) { retornar n * n }
funcion contar(n) {
    sea s = 0
    para i en rango(n) { s += i }
    retornar s
}
funcion falla(n) {
    sea l = [1, 2, 3]
    retornar l[n]
}
