// Prueba de stdlib/navegador.cfv: lienzo 2D avanzado y elementos por índice.
importar "navegador"
nav_lienzo("#c")
nav_relleno_lineal(0, 0, 0, 100, "0 #ff0000; 1 #0000ff")
nav_rellenar_rect(0, 0, 200, 100)
nav_guardar()
nav_ruta_nueva()
nav_ruta_arco(150, 50, 30, 0, pi() * 2, falso)
nav_recortar()
nav_relleno("#00ff00")
nav_rellenar_rect(0, 0, 200, 100)
nav_restaurar()
nav_ruta_nueva()
nav_ruta_rombo(40, 50, 10, 10)
nav_relleno("#ffffff")
nav_rellenar()
nav_alfa(1)
nav_grano(0.0, 0, 0, "overlay")
nav_texto("#n", "" + nav_cuantos(".r") + " " + nav_caja(".r", 1, "alto") + " " + nav_medio("(min-width: 1px)") + " " + nav_lienzo_alto())
nav_clase_n(".r", 1, "on", verdadero)
nav_estilo_n(".r", 0, "color", "rgb(1, 2, 3)")
