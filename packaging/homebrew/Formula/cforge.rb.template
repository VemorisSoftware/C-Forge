# Fórmula de Homebrew para C-Forge (100 % C-Forge: binarios oficiales, sin
# compilador C++). Al publicar una versión, reemplaza VERSION y cada
# SHA256_* con las sumas de SHA256SUMS del release.
class Cforge < Formula
  desc "Lenguaje de programación C-Forge (compilador nativo autoalojado)"
  homepage "https://c-forge.org"
  version "VERSION"
  license :cannot_represent

  on_macos do
    on_arm do
      url "https://github.com/VemorisSoftware/cforge/releases/download/vVERSION/cforge-VERSION-macos-arm64.tar.gz"
      sha256 "SHA256_MACOS_ARM64"
    end
    on_intel do
      url "https://github.com/VemorisSoftware/cforge/releases/download/vVERSION/cforge-VERSION-macos-x64.tar.gz"
      sha256 "SHA256_MACOS_X64"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/VemorisSoftware/cforge/releases/download/vVERSION/cforge-VERSION-linux-arm64.tar.gz"
      sha256 "SHA256_LINUX_ARM64"
    end
    on_intel do
      url "https://github.com/VemorisSoftware/cforge/releases/download/vVERSION/cforge-VERSION-linux-x64.tar.gz"
      sha256 "SHA256_LINUX_X64"
    end
  end

  def install
    bin.install "cforge"
    (lib/"cforge/stdlib").install Dir["stdlib/*.cfv"]
  end

  def caveats
    <<~EOS
      Biblioteca estándar: #{opt_lib}/cforge/stdlib
      (cforge la encuentra sola junto al ejecutable).
    EOS
  end

  test do
    (testpath/"hola.cfv").write 'mostrar("Homebrew C-Forge OK")'
    assert_match "C-Forge", shell_output("#{bin}/cforge --version")
    assert_match "Homebrew C-Forge OK", shell_output("#{bin}/cforge #{testpath}/hola.cfv")
  end
end
